    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e380db3f-47d6-358b-83dd-82a7a97ef589",
                    "sense_definition": "die Aufgaben einer abwesenden oder erkrankten Person zeitweise übernehmen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stellvertretung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Weil unsere Lehrerin krank ist, <w>vertritt</w> Herr Schmidt sie heute im Unterricht."
                        },
                        {
                            "text": "Kannst du mich während meines Urlaubs bei den wichtigsten Terminen <w>vertreten</w>?"
                        }
                    ],
                    "synonyms": [
                        "ersetzen"
                    ],
                    "common_phrases": [
                        "einen Kollegen vertreten",
                        "die Chefin vertreten"
                    ]
                },
                {
                    "sense_id": "a633796c-066f-3a11-b0a8-c4a415bc80ff",
                    "sense_definition": "die Interessen einer Person, Gruppe oder eines Staates öffentlich oder rechtlich wahrnehmen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "repraesentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Anwältin <w>vertritt</w> ihre Mandanten mit großem Erfolg vor Gericht."
                        },
                        {
                            "text": "Er hat unser Land bei den Olympischen Spielen sehr würdig <w>vertreten</w>."
                        }
                    ],
                    "synonyms": [
                        "repräsentieren"
                    ],
                    "common_phrases": [
                        "die Interessen vertreten",
                        "einen Mandanten vertreten"
                    ]
                },
                {
                    "sense_id": "d5b53d5a-de69-3133-9bd1-ef449af95b4d",
                    "sense_definition": "eine bestimmte Ansicht, Position oder Idee haben und für sie eintreten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "repraesentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der Diskussion <w>vertrat</w> er konsequent seinen eigenen Standpunkt."
                        },
                        {
                            "text": "Ich <w>vertrete</w> die Meinung, dass wir mehr für den Umweltschutz tun müssen."
                        }
                    ],
                    "common_phrases": [
                        "eine Meinung vertreten",
                        "einen Standpunkt vertreten",
                        "eine Position vertreten"
                    ]
                },
                {
                    "sense_id": "2e53652e-3bbe-3fe7-996e-1badcff2058b",
                    "sense_definition": "an einem Ort, in einer Gruppe oder auf einer Veranstaltung anwesend sein oder vorkommen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf der Messe sind viele internationale Unternehmen mit eigenen Ständen <w>vertreten</w>."
                        },
                        {
                            "text": "Frauen sind in den Führungsetagen dieser Branche leider noch immer zu wenig <w>vertreten</w>."
                        }
                    ],
                    "common_phrases": [
                        "stark vertreten sein",
                        "zahlreich vertreten sein"
                    ]
                },
                {
                    "sense_id": "ce70c6c7-4a0f-3d77-97e8-23be0cb9b11b",
                    "sense_definition": "nach einer längeren Zeit des Sitzens etwas spazieren gehen, um sich aufzulockern",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach der langen Autofahrt möchte ich mir kurz im Park die Füße <w>vertreten</w>."
                        },
                        {
                            "text": "In der Mittagspause sind wir spazieren gegangen, um uns etwas die Füße zu <w>vertreten</w>."
                        }
                    ],
                    "common_phrases": [
                        "sich die Füße vertreten"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "überwiegend in fester Wendung verwendet"
                        }
                    ]
                },
                {
                    "sense_id": "7a679093-d26f-394b-8585-aa6a28665912",
                    "sense_definition": "beim Gehen oder Laufen falsch auf den Fuß treten und sich dabei verletzen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf den unebenen Treppenstufen hat sie sich unglücklich den Fuß <w>vertreten</w>."
                        },
                        {
                            "text": "Beim Joggen im Wald habe ich mich <w>vertreten</w> und kann nun kaum noch auftreten."
                        }
                    ],
                    "synonyms": [
                        "verstauchen",
                        "umknicken"
                    ],
                    "common_phrases": [
                        "sich den Fuß vertreten"
                    ]
                }
            ]
        },
