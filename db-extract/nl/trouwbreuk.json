                    {
                        "translation_id": "2357518c-7a15-441a-9302-df54bde1e933",
                        "source_entry_id": "e1911d4f-2140-3a8a-a222-95913ab1be9f",
                        "source_sense_id": "b0aa8584-5569-3817-b84c-959fef1b352b",
