                "entry_id": "9f08a775-99aa-3598-b8bc-c1aa8d6087f5",
                "word": "lightsaber",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b5e3c956-45e1-4e25-bd0b-75b62e7b3e43",
                        "entry_id": "9f08a775-99aa-3598-b8bc-c1aa8d6087f5",
                        "tags": [
                            "plural"
                        ],
                        "form": "lightsabers"
