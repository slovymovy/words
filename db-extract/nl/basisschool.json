                ],
                "senses": [
                    {
                        "sense_id": "87a0701b-3eb5-3a21-9236-789b659872e2",
                        "entry_id": "6e618950-cda9-3b47-832e-d93ba1a3940b",
                        "glosses": [
                            "een school voor lager onderwijs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59b608d0-5ad2-4dbb-8159-931d47576ba7",
                                "sense_id": "87a0701b-3eb5-3a21-9236-789b659872e2",
                                "text": "Morgen zal hun zoontje voor het eerst naar de basisschool gaan."
                            },
                            {
                                "example_id": "acdc180a-378d-4b42-9cf6-d9113f152753",
                                "sense_id": "87a0701b-3eb5-3a21-9236-789b659872e2",
                                "text": "In de Baptistenkerk aan de Hoofdweg zijn deze woensdagmorgen de groepen 6, 7 en 8 van de basisscholen De Blokstoeke en De Fontein bijeen. Want het is Dankdag voor Gewas en Arbeid. En waar in grote delen van Nederland deze christelijke feestdag een vrijwel onbekend fenomeen is geworden, wordt er hier in Westerhaar volop aandacht aan besteed."
                            },
                            {
                                "example_id": "d5f303d2-cfbb-42e6-9350-de38ae27a345",
                                "sense_id": "87a0701b-3eb5-3a21-9236-789b659872e2",
                                "text": "De laatste keer dat ze een mode-show had gelopen, was op de basisschool."
                            },
                            {
                                "example_id": "5b1eed66-a748-4bbf-8e2f-725d2c998a8a",
                                "sense_id": "87a0701b-3eb5-3a21-9236-789b659872e2",
                                "text": "De basisschool waar ze werkte bevond zich een paar straten verderop en overdag, wanneer hij de klanten op het terras serveerde of de kou trotseerde voor een paar hijsjes, kon hij het infernale geschreeuw van de leerlingen horen (soms meende hij zelfs tussen al dat gekrijs de lach van Zaynab te herkennen)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "967fe7fc-e902-405a-b09e-e52069bf36ab",
                        "source_entry_id": "6e618950-cda9-3b47-832e-d93ba1a3940b",
                        "source_sense_id": "87a0701b-3eb5-3a21-9236-789b659872e2",
                        "source_sense_description": "een school voor lager onderwijs",
                        "target_lang_word": "Grundschule",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grundschule",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43267470-42a1-3d1d-8ce8-f45f918bb110",
                                        "entry_id": "2a507221-d0f8-30f4-8ace-a8b8a3a1f4c8",
                                        "glosses": [
                                            "Schule für Schüler der Klassen 1 bis 4 beziehungsweise 1 bis 6"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e0452f0-7d3f-47c7-a704-4c772423df10",
                                                "sense_id": "43267470-42a1-3d1d-8ce8-f45f918bb110",
                                                "text": "Er geht noch in die Grundschule."
                                            },
                                            {
                                                "example_id": "6e92b687-3ab7-4aff-b54f-b6997b5d7123",
                                                "sense_id": "43267470-42a1-3d1d-8ce8-f45f918bb110",
                                                "text": "„Mein Klassenlehrer in der Grundschule wollte mich auf die Sonderschule abschieben.“"
                                            },
                                            {
                                                "example_id": "f8e4e771-d711-4a93-ac1e-60f4b226a66b",
                                                "sense_id": "43267470-42a1-3d1d-8ce8-f45f918bb110",
                                                "text": "„Huxleys Vater war Mathematiklehrer gewesen und hatte ständig in der Klemme gesessen, weshalb er dem Sohn keine über zwei Jahre Grundschule hinausgehende Schulbildung finanzieren konnte.“"
                                            },
                                            {
                                                "example_id": "632006b1-73ef-4b25-bace-489e382350b7",
                                                "sense_id": "43267470-42a1-3d1d-8ce8-f45f918bb110",
                                                "text": "„Der erste Schnee war schon gefallen und wieder weggetaut, als die Grundschule des kleinen Viertels im Prenzlauer Berg eine »weltoffene Woche« ausrief.“"
                                            },
                                            {
                                                "example_id": "67448897-5d62-4015-a0d2-fd7949c48835",
                                                "sense_id": "43267470-42a1-3d1d-8ce8-f45f918bb110",
                                                "text": "Aus einer direkten Rede: „Und als ich noch zur Grundschule ging, hat sie dafür gesorgt, dass meine kleinen Geschwister und ich mittags was zum Essen hatten.“"
                                            },
                                            {
                                                "example_id": "c23edda6-59dd-4ca8-aa7f-e9962b82600d",
                                                "sense_id": "43267470-42a1-3d1d-8ce8-f45f918bb110",
                                                "text": "„Männer fehlen in Kindergärten, aber auch in Grundschulen, wo zu mehr als 85 Prozent Frauen unterrichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "377f8217-c951-4823-9961-964af98c9cd2",
                        "source_entry_id": "6e618950-cda9-3b47-832e-d93ba1a3940b",
