                        "examples": [
                            {
                                "example_id": "48d74a6e-5790-4136-9319-3796d980731f",
                                "sense_id": "ac4b7901-96be-39c6-9b04-16785df972f5",
                                "text": "Профессионалы полагают, что данная фотография - не более чем фотомонтаж."
                            }
                        ]
                    }
