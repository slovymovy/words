                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e9cf17e-81e1-457d-a490-036f1cfb3658",
                                "sense_id": "e14b0a33-1529-3644-828c-24cdc7f14c8c",
                                "text": "„Vier Jahrzehnte hatte diese Grenze nicht nur die politische Nation, sondern auch die Sprachnation geteilt.“"
                            },
                            {
                                "example_id": "623567f1-b37c-4ba4-b41c-69b08cb0fd2e",
                                "sense_id": "e14b0a33-1529-3644-828c-24cdc7f14c8c",
                                "text": "„Das Nationalitätenprinzip war in der Ideengeschichte Europas so ausschließlich an die Sprache gebunden, daß man mit gutem Grund die politischen Einigungsbewegungen als die Interessenvertretung von »Sprachnationen« (…) auffassen kann.“"
                            }
                        ],
