                ],
                "senses": [
                    {
                        "sense_id": "3b995485-6adb-3304-86ad-ec94b91d3167",
                        "entry_id": "c011ec9b-2c90-3e56-b017-cd1a106a5663",
                        "glosses": [
                            "Gesamtheit der Gegebenheiten, die ein Lebewesen umgeben"
                        ],
                        "tags": [
                            "plural",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "e3530185-7061-40f8-add8-9ead4bb6b97f",
                                "sense_id": "3b995485-6adb-3304-86ad-ec94b91d3167",
                                "text": "„Die extreme Armut in der zu Ende gehenden Monarchie, die schweren Lebensbedingungen der Arbeiterschaft, besonders der Frauen in den Ziegelfabriken und der Heimarbeiterinnen, veranlassen sie zu ihrem sozialpolitischen Engagement.“"
                            },
                            {
                                "example_id": "e298563e-bc81-4706-87c1-37f2b3130073",
                                "sense_id": "3b995485-6adb-3304-86ad-ec94b91d3167",
                                "text": "„In manchen Teilen der Biosphäre wimmelt es von Leben, weil dort die Lebensbedingungen beinahe ideal sind.“"
                            },
                            {
                                "example_id": "d17dcd26-88c8-44d3-bc93-ed0b03913054",
                                "sense_id": "3b995485-6adb-3304-86ad-ec94b91d3167",
                                "text": "„Daher war die Verbesserung ihrer Lebensbedingungen von essentieller Bedeutung, um die Stadt am Laufen zu halten.\""
                            },
                            {
                                "example_id": "52079fbb-39be-45d7-8490-d5e577646460",
                                "sense_id": "3b995485-6adb-3304-86ad-ec94b91d3167",
                                "text": "„Die Lebensbedingungen der Offiziersfamilien waren gut.“"
                            },
                            {
                                "example_id": "4f8d4def-9981-4c4e-b791-2b31123d6d9b",
                                "sense_id": "3b995485-6adb-3304-86ad-ec94b91d3167",
                                "text": "[Tschetschenien 1991:] „Moskau erkannte die Republik nicht an und verhängte eine Wirtschaftsblockade, um die Region zu destabilisieren. Die Lebensbedingungen verschlechterten sich rapide.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
