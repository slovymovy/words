                        "entry_id": "743c23bc-68c5-3b1f-ae6e-7d4dbac25100",
                        "glosses": [
                            "Twilight of morning or evening; the gloaming."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e845a49-682b-4d1f-9bdd-17fe87ade1f4",
                                "sense_id": "8f63d2bc-7ebc-338c-b627-107bee79f8ee",
                                "text": "When the faint glooming in the sky / First lightened into day"
                            },
                            {
                                "example_id": "6a35017a-3f91-498a-9e57-bdfcc6f4ddbb",
                                "sense_id": "8f63d2bc-7ebc-338c-b627-107bee79f8ee",
                                "text": "[T]he balmy glooming, crescent-lit, / Spread the light haze along the river-shores, / And in the hollows; […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "df24b493-d890-3463-b628-7c5ca957032b",
                        "entry_id": "743c23bc-68c5-3b1f-ae6e-7d4dbac25100",
                        "glosses": [
                            "Gloomy behaviour; melancholy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a66fe011-cd32-4147-8432-5670feaa9856",
                                "sense_id": "df24b493-d890-3463-b628-7c5ca957032b",
                                "text": "What devil, woman! pluck up your heart, and leave off all this glooming."
                            }
                        ]
                    }
