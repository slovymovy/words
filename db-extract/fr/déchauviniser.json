                "senses": [
                    {
                        "sense_id": "b596332c-3caf-3acc-bab5-2f16b3119bd3",
                        "entry_id": "7ace4207-d386-3a91-bd15-1c3f399f8f4e",
                        "glosses": [
                            "Faire perdre son caractère chauvin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee288d12-251f-4009-9c63-72f7f575f560",
                                "sense_id": "b596332c-3caf-3acc-bab5-2f16b3119bd3",
                                "text": "Pour enraciner l’idée européenne, on le constate, il est donc indispensable de commencer par « déchauviniser et détricoloriser » l’Alsace !"
                            },
                            {
                                "example_id": "259d13f5-7e34-4b6a-9000-1138bf2d8d7a",
                                "sense_id": "b596332c-3caf-3acc-bab5-2f16b3119bd3",
                                "text": "Parce que, aussi, l’industrie du vêtement a le plus grand intérêt, aujourd’hui, à se « déchauviniser », à penser européen et que, sans conteste, le bouillon de culture de la mode est toujours Paris."
                            }
                        ]
                    }
