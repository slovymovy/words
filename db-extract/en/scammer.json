    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c366a4b9-9ed0-3481-8ad9-9c782eabc4c6",
                "word": "scammer",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9d8bbc28-6750-43c4-bf7d-7d765621dbe7",
                        "entry_id": "c366a4b9-9ed0-3481-8ad9-9c782eabc4c6",
                        "tags": [
                            "plural"
                        ],
                        "form": "scammers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6960e3f4-391b-39bc-9e61-5f7bf112bd83",
                        "entry_id": "c366a4b9-9ed0-3481-8ad9-9c782eabc4c6",
                        "glosses": [
                            "A person who commits fraud by making dishonest scams and business deals: swindler, cheat, grifter."
                        ],
                        "tags": [
                            "common-gender",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "582b0329-6326-4705-a396-b17d2dcce0f3",
                                "sense_id": "6960e3f4-391b-39bc-9e61-5f7bf112bd83",
                                "text": "According to Netsafe, scammers send out a bunch of emails, hoping to snag a few gullible people, but simply deleting the offending email won’t do anything to impede the con."
                            },
                            {
                                "example_id": "3bd08ff6-1f4c-4ec4-9bdb-bfb81f1362fb",
                                "sense_id": "6960e3f4-391b-39bc-9e61-5f7bf112bd83",
                                "text": "TransPennine Express has removed all QR codes from its 71 car parks after scammers covered up a genuine code sticker with a false one and stole £13,000 from a woman's bank account."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a40bf85-75c4-48c0-a4e4-0caaf07673df",
                        "source_entry_id": "c366a4b9-9ed0-3481-8ad9-9c782eabc4c6",
                        "source_sense_id": "6960e3f4-391b-39bc-9e61-5f7bf112bd83",
                        "source_sense_description": "swindler, cheat",
                        "target_lang_word": "arnaqueur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arnaqueur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef778ba4-2da7-3a6c-86dc-16cfd618c16a",
                                        "entry_id": "f13c7ad4-834b-35be-9086-d0a5aba13e33",
                                        "glosses": [
                                            "Personne qui arnaque, qui a l’habitude d’arnaquer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccf5594f-bc8f-4589-9e8c-db35fae395db",
                                                "sense_id": "ef778ba4-2da7-3a6c-86dc-16cfd618c16a",
                                                "text": "Jérôme, mon nouveau voisin, est un arnaqueur professionnel d’une trentaine d’années."
                                            },
                                            {
                                                "example_id": "17302062-a80f-4a47-b2a7-d3a513357afb",
                                                "sense_id": "ef778ba4-2da7-3a6c-86dc-16cfd618c16a",
                                                "text": "Ses partisans d’aujourd’hui ne sont pas les premières victimes de cet arnaqueur professionnel qui n’a jamais eu d’autres intérêts que les siens."
                                            },
                                            {
                                                "example_id": "b91509e6-3a3d-4bb6-89dd-692568baab85",
                                                "sense_id": "ef778ba4-2da7-3a6c-86dc-16cfd618c16a",
                                                "text": "Inspirée du livre-enquête du journaliste de Mediapart Fabrice Arfi, la série raconte comment deux arnaqueurs de Belleville sont parvenus à mettre au point l’arnaque du siècle avec l’aide d’un trader des beaux quartiers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "arnaqueur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2f72f2e-5d5e-3aed-a9f8-e9b12731cf76",
                                        "entry_id": "ee3e2a74-98d3-3ad1-b926-d2c779cb35ee",
                                        "glosses": [
                                            "Qui arnaque, qui a l’habitude d’arnaquer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8d11587-8879-466b-8091-cb7333bd8a69",
                        "source_entry_id": "c366a4b9-9ed0-3481-8ad9-9c782eabc4c6",
