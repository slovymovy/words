                        "glosses": [
                            "Qui est éloigné, lointain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fbd7edf-7950-41f3-8af0-f6506f9afd16",
                                "sense_id": "9fe1f22c-a808-315a-ab8f-7e9b6fa589da",
                                "text": "Rapidement, Giselle gagna un appartement reculé, dont les fenêtres donnaient sur la route et elle poussa une porte."
                            },
                            {
                                "example_id": "403a6c90-151a-47c5-afab-e16e29df1fe8",
                                "sense_id": "9fe1f22c-a808-315a-ab8f-7e9b6fa589da",
                                "text": "Il loge dans le quartier de la ville le plus reculé."
                            },
                            {
                                "example_id": "dd6477b7-8e47-459b-bf39-dec49a45eb2f",
                                "sense_id": "9fe1f22c-a808-315a-ab8f-7e9b6fa589da",
                                "text": "Les régions les plus reculées."
                            },
                            {
                                "example_id": "b1c56fde-ef0e-49fb-aa4c-dbccc6f9c0c6",
                                "sense_id": "9fe1f22c-a808-315a-ab8f-7e9b6fa589da",
                                "text": "L’antiquité la plus reculée."
                            },
                            {
                                "example_id": "ece44eb6-d2e0-48fe-832f-528010850909",
                                "sense_id": "9fe1f22c-a808-315a-ab8f-7e9b6fa589da",
                                "text": "La postérité la plus reculée."
                            }
                        ]
                    }
