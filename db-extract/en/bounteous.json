                                        "glosses": [
                                            "hojně rozdávající; takový, který se rád dělí"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28f6729c-701a-4bfd-a635-59d3f98bc40a",
                                                "sense_id": "c61dea2b-7b67-365e-ac5b-86b80eb3658a",
                                                "text": "Pan Novák je neskutečně štědrý, pro děti z domova by se doslova rozdal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ef0e0f5-fc1e-326f-8229-76452bc41414",
                                        "entry_id": "4c573298-dd95-39cc-a932-3e8128a060a1",
                                        "glosses": [
                                            "hojný, bohatý"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "972b30be-5dd8-4512-96af-74070dd15e87",
                                                "sense_id": "4ef0e0f5-fc1e-326f-8229-76452bc41414",
                                                "text": "Tehdy to bylo naposledy, co se mi dostalo štědrého pohoštění."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "štědrý",
