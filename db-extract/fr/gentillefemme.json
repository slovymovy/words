                ],
                "senses": [
                    {
                        "sense_id": "791f5868-d707-3084-8d1f-5ae9e49d232a",
                        "entry_id": "6d6f30cd-59af-3c3a-bc1e-0681b5aa88d4",
                        "glosses": [
                            "Celle qui est de naissance noble."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "504624af-61d7-4250-bafa-f6fcd3545fcc",
                                "sense_id": "791f5868-d707-3084-8d1f-5ae9e49d232a",
                                "text": "Enquis s’il a connu demoiselle Magdeleine de Sery, femme dudit Hélie de Refuge, mère dudit Jean, et aïeule paternelle dudit Guillaume, a dit en avoir eu bonne connaissance, être gentillefemme, ayant vécu noblement avec ledit défunt Hélie, son mari, sans avoir fait acte dérogeant à sa noblesse, qui soit venu à sa connaissance, et a toujours vu et entendu qu’elle était issue de la maison de la Motte Saint-Cloud, maison noble et ancienne, et telle réputée par le pays."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f493803-6ea5-3bb7-ab2c-560d6bca317a",
                        "entry_id": "6d6f30cd-59af-3c3a-bc1e-0681b5aa88d4",
                        "glosses": [
                            "Femme qui, sans nécessairement être noble de naissance, a des sentiments, des manières nobles."
                        ],
                        "tags": [
                            "figuratively",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5338192b-3563-498c-9793-6df1fb2884a6",
                                "sense_id": "6f493803-6ea5-3bb7-ab2c-560d6bca317a",
                                "text": "De mon côté, monsieur, répondis-je ; je suis gentillefemme comme vous êtes gentilhomme ; tenez toutes vos promesses, et je tiendrai toutes les miennes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "645fd59c-17c6-425d-bcfb-6724ce64ae31",
                        "source_entry_id": "6d6f30cd-59af-3c3a-bc1e-0681b5aa88d4",
                        "target_lang_word": "gentlewoman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gentlewoman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "293a3db1-17b7-3b50-ab85-eb400ea85fb8",
                                        "entry_id": "3fc59dce-d969-3a25-ac2d-9e30adfaa356",
                                        "glosses": [
                                            "A woman of the nobility."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0b9cc98-7c2f-4414-addd-2261c20c5223",
                                                "sense_id": "293a3db1-17b7-3b50-ab85-eb400ea85fb8",
                                                "text": "Gentlewoman: Since his majesty went into the field, I have seen her rise from her bed, throw her night-gown upon[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4afe295c-97ab-3d59-ac5b-8322a2cfe106",
                                        "entry_id": "3fc59dce-d969-3a25-ac2d-9e30adfaa356",
                                        "glosses": [
                                            "A female member of a legislature, especially a female member of a House of Representatives."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc13dc1d-fe4f-4124-b722-affdf13ea185",
                                                "sense_id": "4afe295c-97ab-3d59-ac5b-8322a2cfe106",
                                                "text": "'The gentlewoman from California.' Or 'the gentlewoman from Texas.' Gentlewoman?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4152e9e4-7787-4c6c-90e1-27527a71e31c",
                        "source_entry_id": "6d6f30cd-59af-3c3a-bc1e-0681b5aa88d4",
                        "target_lang_word": "lady",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lady",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a4d4504-e149-3dfb-acb8-b03368a1d0a2",
                                        "entry_id": "2a6004b2-dc48-3772-926c-150fff8cb034",
                                        "glosses": [
                                            "The mistress of a household."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f6fff2a-84c3-370f-8271-60864f736cb3",
                                        "entry_id": "2a6004b2-dc48-3772-926c-150fff8cb034",
                                        "glosses": [
                                            "A woman of breeding or higher class, a woman of authority."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53e01ec6-1d8d-497d-903b-fedc3a290ee4",
                                                "sense_id": "9f6fff2a-84c3-370f-8271-60864f736cb3",
                                                "text": "\"I would like the dining room to be fully set by tonight; would you do so?\" \"Yes, my lady.\""
                                            },
                                            {
                                                "example_id": "1cf4147a-ceec-4a38-b94c-d3b4f8f5368c",
                                                "sense_id": "9f6fff2a-84c3-370f-8271-60864f736cb3",
                                                "text": "‘[…] I remember a lady coming to inspect St. Mary's Home where I was brought up and seeing us all in our lovely Elizabethan uniforms we were so proud of, and bursting into tears all over us because “it was wicked to dress us like charity children”.[…]’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a02de44-cc8e-3b9e-af43-b64fa01a0ab0",
                                        "entry_id": "2a6004b2-dc48-3772-926c-150fff8cb034",
                                        "glosses": [
                                            "The feminine of lord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d14831d-11f7-45b6-88f7-d6f20052f2f8",
                                                "sense_id": "4a02de44-cc8e-3b9e-af43-b64fa01a0ab0",
                                                "text": "Of all theſe bounds euen from this Line, to this, / With ſhadowie Forreſts, and with Champains rich’d / With plenteous Riuers, and wide-ſkirted Meades / We make thee Lady."
                                            },
                                            {
                                                "example_id": "dd978230-2401-4191-a449-88a3b39e4101",
                                                "sense_id": "4a02de44-cc8e-3b9e-af43-b64fa01a0ab0",
                                                "text": "’T was the proudest hall in the North Countree,\n And never its gates might opened be,\n Save to lord or lady of high decree[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5c79190-bb3f-3d58-b93e-3e9657d1efec",
                                        "entry_id": "2a6004b2-dc48-3772-926c-150fff8cb034",
                                        "glosses": [
                                            "A title for someone married to a lord or gentleman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47b8e837-1026-3d23-8eb2-25838e86ed46",
                                        "entry_id": "2a6004b2-dc48-3772-926c-150fff8cb034",
                                        "glosses": [
                                            "A title that can be used instead of the formal terms of marchioness, countess, viscountess, or baroness."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e2bb4ab-6c96-3d42-a15f-32ec58873f2b",
                                        "entry_id": "2a6004b2-dc48-3772-926c-150fff8cb034",
                                        "glosses": [
                                            "A woman: an adult female human."
                                        ],
                                        "tags": [
                                            "polite"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27c894be-3cce-494d-9ee2-fb429066e3ac",
                                                "sense_id": "6e2bb4ab-6c96-3d42-a15f-32ec58873f2b",
                                                "text": "Please direct this lady to the soft furnishings department."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8982d7bc-bdc3-3df4-a618-4079334b8c94",
                                        "entry_id": "2a6004b2-dc48-3772-926c-150fff8cb034",
                                        "glosses": [
                                            "A polite reference or form of address to women."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6831d065-816e-4d61-b972-35e8644fc825",
                                                "sense_id": "8982d7bc-bdc3-3df4-a618-4079334b8c94",
                                                "text": "Ladies and gentlemen, it is a pleasure to be here today. Follow me, ladies!"
                                            },
                                            {
                                                "example_id": "d34e166a-676c-4728-88ea-0e3c1c1539d6",
                                                "sense_id": "8982d7bc-bdc3-3df4-a618-4079334b8c94",
                                                "text": "The Celebrity, by arts unknown, induced Mrs. Judge Short and two other ladies to call at Mohair on a certain afternoon when Mr. Cooke was trying a trotter on the track. The three returned wondering and charmed with Mrs. Cooke; they were sure she had had no hand in the furnishing of that atrocious house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8870e72-6487-36d0-aa61-fb9bfd850ac8",
                                        "entry_id": "2a6004b2-dc48-3772-926c-150fff8cb034",
                                        "glosses": [
                                            "Used to address a female."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46736fe2-e78b-43cb-91f6-0ae6288b7974",
                                                "sense_id": "d8870e72-6487-36d0-aa61-fb9bfd850ac8",
                                                "text": "Hey, lady, move your car!"
                                            },
                                            {
                                                "example_id": "5d70a226-928a-4411-980a-acbec85305a7",
                                                "sense_id": "d8870e72-6487-36d0-aa61-fb9bfd850ac8",
                                                "text": "Hey, ladies, how are you doing?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "676579fd-8f8b-3f4c-90e6-807d380dd467",
                                        "entry_id": "2a6004b2-dc48-3772-926c-150fff8cb034",
                                        "glosses": [
                                            "A wife or girlfriend; a sweetheart."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0591991e-2e07-46a7-81f6-29e028ec9a71",
                                                "sense_id": "676579fd-8f8b-3f4c-90e6-807d380dd467",
                                                "text": "It is my Lady, O it is my Loue, O that ſhe knew ſhe were,\n She ſpeakes, yet ſhe ſayes nothing, what of that?"
                                            },
                                            {
                                                "example_id": "306afc61-7682-4c60-90cf-ac06cbe69833",
                                                "sense_id": "676579fd-8f8b-3f4c-90e6-807d380dd467",
                                                "text": "But nothing could now exceed my confusion upon seeing the gentleman and his lady enter"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e541824-07ea-38ab-974e-aebbee09059a",
                                        "entry_id": "2a6004b2-dc48-3772-926c-150fff8cb034",
                                        "glosses": [
                                            "A woman to whom the particular homage of a knight was paid; a woman to whom one is devoted or bound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7260921e-92cd-411c-a5da-fb622be49733",
                                                "sense_id": "8e541824-07ea-38ab-974e-aebbee09059a",
                                                "text": "The ſoldier here his waſted ſtore ſupplies,\n And takes new valor from the Ladies’ eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52d3737c-9709-35de-975a-5a66ddb3066d",
                                        "entry_id": "2a6004b2-dc48-3772-926c-150fff8cb034",
                                        "glosses": [
                                            "A queen (the playing card)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff788817-e235-33bb-8202-fcbe2f650678",
                                        "entry_id": "2a6004b2-dc48-3772-926c-150fff8cb034",
                                        "glosses": [
                                            "Who is a woman."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dc7ac5e-f9ee-4bb8-8f0b-b91086ad429c",
                                                "sense_id": "ff788817-e235-33bb-8202-fcbe2f650678",
                                                "text": "A lady doctor."
                                            },
                                            {
                                                "example_id": "f361c4fd-da29-47d1-b83c-b8aef6107fc6",
                                                "sense_id": "ff788817-e235-33bb-8202-fcbe2f650678",
                                                "text": "The recent disclosures caused one headmistress of a city college to arrange for sex instructions to be given by a lady doctor to various forms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bb16e93-a1c1-3038-9792-1e5ee4e28031",
                                        "entry_id": "2a6004b2-dc48-3772-926c-150fff8cb034",
                                        "glosses": [
                                            "Alternative form of Lady."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d091865e-0f6b-36bc-b5b2-0b35752f6b9d",
                                        "entry_id": "2a6004b2-dc48-3772-926c-150fff8cb034",
                                        "glosses": [
                                            "gastric mill, the triturating apparatus in the stomach of a lobster, consisting of calcareous plates; so called from a fancied resemblance to a seated female figure."
                                        ],
