                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ую́т",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bcb47301-1fff-3a0e-bdf7-1c2dc13cf0ba",
                                        "entry_id": "d891802c-735c-3d95-84ee-40d59eb773a2",
                                        "glosses": [
                                            "удобство, благоустроенность в домашней обстановке, в быту"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "599c297a-021f-42d7-b17d-e49cfef93160",
                                                "sense_id": "bcb47301-1fff-3a0e-bdf7-1c2dc13cf0ba",
                                                "text": "Мы осмотрелись: просторная чистая квартира — тишь, запах ладана и целебных трав, мирный обывательский уют."
                                            },
                                            {
                                                "example_id": "773a0b9d-18d0-4643-bdff-ea8aa73be369",
                                                "sense_id": "bcb47301-1fff-3a0e-bdf7-1c2dc13cf0ba",
                                                "text": "Есть особенный простодушный уют в таких комнатах с висячей лампой над обеденным столом, с её белым матовым абажуром, с оленьими рогами над картиной."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
