                        "examples": [
                            {
                                "example_id": "275a9043-3a8b-4639-aebd-fe3db03f647a",
                                "sense_id": "c61b4015-d743-3112-8484-261e91176b38",
                                "text": "❬…❭ А судя по тому, что с нами происходит, с нашим именем сейчас — то, что нас крутят по радио без нашего ведома, судя по тому попсу, в который мы погружаемся, в котором нас буквально просто топят, видимо, мы перестанем давать концертные выступления. ❬…❭ Посуди, весь наш андеграунд стал одной из частей массовой культуры, одной из граней официоза. ❬…❭"
                            }
                        ]
                    }
