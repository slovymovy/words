                        "entry_id": "e7971f03-5a28-373f-89db-0b63e379d28a",
                        "glosses": [
                            "Grand amusement."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5775458a-067d-48b2-a90e-f55f45efa673",
                                "sense_id": "fcdbe831-e27a-3200-9c90-00cb0b1a9dc3",
                                "text": "La Grande marrade"
                            },
                            {
                                "example_id": "8dcdba86-ad2f-4924-b192-b6f682ed6719",
                                "sense_id": "fcdbe831-e27a-3200-9c90-00cb0b1a9dc3",
                                "text": "Du ciné qui serait que du ciné, sans toute cette marrade et sans le vague espoir que tu vas peut-être aujourd’hui y trouver la paire de nichons de ta vie, ça serait pas du ciné. Ça serait, je sais pas, moi, comme regarder un film chez soi pour soi tout seul. Autant lire un bouquin, alors. Ça, oui, c’est le vrai plaisir du solitaire."
                            },
                            {
                                "example_id": "09dbad6b-d440-48fa-a1dd-e612b85c8f59",
                                "sense_id": "fcdbe831-e27a-3200-9c90-00cb0b1a9dc3",
                                "text": "La marrade alors redouble… gorge déployée… aux larmes, citoyens !"
                            }
                        ]
                    }
