                "senses": [
                    {
                        "sense_id": "edf17eef-a029-3a29-bbfb-bb89d62c9249",
                        "entry_id": "b2bb9092-7ce4-328b-8807-fb34f3b75c1b",
                        "glosses": [
                            "Éclairer excessivement ou plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e8628f0-bc90-4d10-84c4-8d4d438b3e34",
                                "sense_id": "edf17eef-a029-3a29-bbfb-bb89d62c9249",
                                "text": "Il était nécessaire de suréclairer pour obtenir une bonne ouverture de diaphragme indispensable si l’on veut garder une image suffisamment nette après gonflage en 35 millimètres."
                            },
                            {
                                "example_id": "a3952de7-30b8-4554-89a2-9e735b16173d",
                                "sense_id": "edf17eef-a029-3a29-bbfb-bb89d62c9249",
                                "text": "On n’est pas obligés de suréclairer, avec toujours les mêmes appareils bien entendu, ni de couvrir les trottoirs de pavés auto-bloquants toujours identiques aussi bien en Australie que dans la Creuse."
                            }
                        ]
                    }
