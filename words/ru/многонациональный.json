{
    "word_family": [
        "нация",
        "национальный",
        "национальность"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "54614b85-edb4-3a16-a2ac-8773c3dac834",
                    "sense_definition": "Состоящий из представителей многих наций или народов.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "multiethnic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Россия — это огромное <w>многонациональное</w> государство.",
                            "target_lang_translations": {
                                "de": "Russland ist ein riesiger <w>vielvölkischer</w> Staat."
                            }
                        },
                        {
                            "text": "В этом <w>многонациональном</w> городе живут люди разных культур.",
                            "target_lang_translations": {
                                "de": "In dieser <w>multiethnischen</w> Stadt leben Menschen verschiedener Kulturen."
                            }
                        }
                    ],
                    "synonyms": [
                        "полиэтнический"
                    ],
                    "common_phrases": [
                        "многонациональное государство",
                        "многонациональный народ"
                    ],
                    "target_lang_definitions": {
                        "de": "Aus Vertretern vieler Nationen oder Völker bestehend; multiethnisch."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "vielvölkisch",
                                "target_lang_sense_clarification": "bezieht sich oft auf Staaten oder Reiche mit vielen verschiedenen Völkern"
                            },
                            {
                                "target_lang_word": "multiethnisch",
                                "target_lang_sense_clarification": "bezieht sich auf die Zusammensetzung der Bevölkerung nach Ethnien"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19fd0e60-e977-3408-b15a-ee37cf74be06",
                    "sense_definition": "Охватывающий многие страны или имеющий представительства во многих странах.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "multinational",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Крупная <w>многонациональная</w> корпорация открыла новый офис.",
                            "target_lang_translations": {
                                "de": "Ein großer <w>multinationaler</w> Konzern hat ein neues Büro eröffnet."
                            }
                        },
                        {
                            "text": "Эта <w>многонациональная</w> компания работает по всему миру.",
                            "target_lang_translations": {
                                "de": "Dieses <w>multinationale</w> Unternehmen ist weltweit tätig."
                            }
                        }
                    ],
                    "synonyms": [
                        "международный"
                    ],
                    "common_phrases": [
                        "многонациональная корпорация",
                        "многонациональная компания"
                    ],
                    "target_lang_definitions": {
                        "de": "Viele Länder umfassend oder in vielen Ländern vertreten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "multinational",
                                "target_lang_sense_clarification": "bezieht sich auf Unternehmen oder Organisationen, die in mehreren Ländern tätig sind"
                            },
                            {
                                "target_lang_word": "international",
                                "target_lang_sense_clarification": "allgemeiner Begriff für grenzüberschreitende Aktivitäten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}