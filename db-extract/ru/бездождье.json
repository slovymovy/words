                                    {
                                        "sense_id": "4ef28f5a-8cbc-3af7-b518-20d054ace605",
                                        "entry_id": "8f4672e2-5825-39e6-b7f2-1076257a62e6",
                                        "glosses": [
                                            "Período seco de larga duración."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97224598-8b2e-43d3-a857-15af1a8d0520",
                                                "sense_id": "4ef28f5a-8cbc-3af7-b518-20d054ace605",
                                                "text": "En las zonas calientes y áridas, con sequía primaveral y estival, se tomará como norma plantar en otoño."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "77c7fe00-ff66-3276-9692-03e8abf90501",
                                        "entry_id": "8f4672e2-5825-39e6-b7f2-1076257a62e6",
                                        "glosses": [
                                            "Sed en la boca."
                                        ],
                                        "tags": [
                                            "Andalusia",
                                            "Colombia",
                                            "Murcia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcee5519-688a-4a1e-b1c7-da132ab48002",
                                                "sense_id": "77c7fe00-ff66-3276-9692-03e8abf90501",
                                                "text": "Tengo sequía... Le remojaron un trapo en una olla de boj... y él chupó con ganas."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
