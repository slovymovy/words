                    "frequency": "Low",
                    "semantic_group_id": "billetterie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le contrôleur a vérifié chaque <w>coupon</w> de vol avant l'embarquement des passagers."
                        },
                        {
                            "text": "Il nous a remis un <w>coupon</w> de loge pour assister à la représentation théâtrale."
