                ],
                "senses": [
                    {
                        "sense_id": "0e19dd84-ae5b-3ada-937c-5e36b3cec76b",
                        "entry_id": "6c2c4be5-f18c-3417-9bd3-4d4c367bb2ee",
                        "glosses": [
                            "The act of bringing something under the control of something else."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3af75815-d06f-3d6d-b722-152ee1732fdf",
                        "entry_id": "6c2c4be5-f18c-3417-9bd3-4d4c367bb2ee",
                        "glosses": [
                            "The state of being subjected."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ff53c4d2-0215-4087-a4c7-ef0ba3f86b8c",
                                "sense_id": "3af75815-d06f-3d6d-b722-152ee1732fdf",
                                "text": "Maſters commands come with a power reſiſtleſs / To ſuch as owe them abſolute ſubjection; / And for a life who will not change his purpoſe? / (So mutable are all the ways of men) / Yet this be ſure, in nothing to comply / Scandalous or forbidden in our Law."
                            },
                            {
                                "example_id": "85bde97a-7a53-4d33-83b1-99f7ff32180b",
                                "sense_id": "3af75815-d06f-3d6d-b722-152ee1732fdf",
                                "text": "The smallest incidents were to serve as pretexts for demonstrations of force and for demands for indemnities and reparations which increased China's subjection. For example, in 1876 China was constrained to sign the Conventions of Chih-fu (near Yen-tʻai, in north-eastern Shantung) with Great Britain after the murder of an English interpreter on the borders of Yunnan and Burma; the result was five new 'open ports' on top of the fifteen or so already existing."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6079567-3153-42ea-b22b-b40bce8a67a3",
                        "source_entry_id": "6c2c4be5-f18c-3417-9bd3-4d4c367bb2ee",
                        "source_sense_description": "act of bringing under control",
                        "target_lang_word": "soumission",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soumission",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6774ea2d-0ed1-3a6c-bae4-c94c14de0323",
                                        "entry_id": "40089d0d-a56b-3a7e-9fdb-d503f22ab38b",
                                        "glosses": [
                                            "Action de se soumettre, de se ranger sous l’autorité d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89947b63-e342-4fa4-919e-39b2981e86b6",
                                                "sense_id": "6774ea2d-0ed1-3a6c-bae4-c94c14de0323",
                                                "text": "C’est un phénomène remarquable que la grande liberté d’esprit qui a pu coexister en France avec la plus grande soumission politique, et rien n’est pourtant plus explicable."
                                            },
                                            {
                                                "example_id": "f0308a03-a65f-4425-b61f-9d48a6ff2f0c",
                                                "sense_id": "6774ea2d-0ed1-3a6c-bae4-c94c14de0323",
                                                "text": "Sur dix caïds des Beni Mtir, cinq sont venus faire la terguiba. Le général Moinier leur a accordé l’amân mais leur a donné l’ordre d’aller faire leur soumission au sultan à Fez."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40bfdb60-3908-3edc-ba40-bcd02b6c5d7f",
                                        "entry_id": "40089d0d-a56b-3a7e-9fdb-d503f22ab38b",
                                        "glosses": [
                                            "Principe spirituel d’acceptation totale et d’obéissance aveugle à une divinité ou aux valeurs constitutives d’une religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf4255c8-688d-4ec4-82a1-c424a82fbe08",
                                                "sense_id": "40bfdb60-3908-3edc-ba40-bcd02b6c5d7f",
                                                "text": "La soumission d’Abraham."
                                            },
                                            {
                                                "example_id": "483c26de-112c-406f-a807-f7e1a610d8bb",
                                                "sense_id": "40bfdb60-3908-3edc-ba40-bcd02b6c5d7f",
                                                "text": "Aujourd’hui, la source majeure du fanatisme est la religion, et son attitude, ironiquement fondée sur la doctrine de la soumission, est de plus en plus celle d’un mépris de l’humanité caractérisé par l’arrogance, l’intolérance et la violence, comme en une sorte de revanche inconsciente sur l’apprentissage qu’elle dut faire de ce principe spirituel de soumission."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3cd180e-1ab5-3d0c-b943-e106d5f8d100",
                                        "entry_id": "40089d0d-a56b-3a7e-9fdb-d503f22ab38b",
                                        "glosses": [
                                            "Disposition à obéir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e572dbd8-c56f-4fb1-814a-e9b54ccbe6f0",
                                                "sense_id": "d3cd180e-1ab5-3d0c-b943-e106d5f8d100",
                                                "text": "L’acquiescence active ou passive d'un vaste nombre d’Allemands au nazisme, la facile soumission de tous, sauf d’une brave et infime minorité, sont des faits d’une profonde signification historique."
                                            },
                                            {
                                                "example_id": "d5d29765-7989-40dd-88a7-f1e4befafdc4",
                                                "sense_id": "d3cd180e-1ab5-3d0c-b943-e106d5f8d100",
                                                "text": "Ces corps qui ont été contrôlés, consommés, relégués au silence, sont ce qui fonde l’expérience collective des femmes ; dans la marque de cette soumission obligée se loge, en somme, le nœud de leur expérience."
                                            },
                                            {
                                                "example_id": "45bf1873-e111-416c-8e8e-a3d2073be20a",
                                                "sense_id": "d3cd180e-1ab5-3d0c-b943-e106d5f8d100",
                                                "text": "Il a toujours été d’une parfaite soumission envers ses parents, à l’égard de ses supérieurs."
                                            },
                                            {
                                                "example_id": "52a167a0-9ddf-45f5-8ccf-bc4252b8bc0c",
                                                "sense_id": "d3cd180e-1ab5-3d0c-b943-e106d5f8d100",
                                                "text": "Avoir une complète soumission d’esprit pour les choses de la foi."
                                            },
                                            {
                                                "example_id": "7eeaa459-81cc-47e8-a7d1-65a333bc82f9",
                                                "sense_id": "d3cd180e-1ab5-3d0c-b943-e106d5f8d100",
                                                "text": "La Chine aussi a une doctrine, qui veut la soumission économique de l’UE à des fins politiques."
                                            },
                                            {
                                                "example_id": "ae1ffce9-a277-48c2-b2c8-d03a4730937f",
                                                "sense_id": "d3cd180e-1ab5-3d0c-b943-e106d5f8d100",
                                                "text": "Plus encore, par son style et sa défense du langage, le satiriste nous met en garde contre un phénomène qui requiert toute notre vigilance : « le fait que les soumissions et les conformismes ordinaires des situations ordinaires annoncent les soumissions extraordinaires des situations extraordinaires » (Bourdieu)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54051fe3-bda0-3ebc-b571-cc1bdfd82b9b",
                                        "entry_id": "40089d0d-a56b-3a7e-9fdb-d503f22ab38b",
                                        "glosses": [
                                            "Acte d’accepter ou de consentir à se mettre dans une situation de dominé ou dans un état d’objet sexuel."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "808f0ab7-8e4d-438b-a5e4-560f0da52126",
                                                "sense_id": "54051fe3-bda0-3ebc-b571-cc1bdfd82b9b",
                                                "text": "L’homme peut être un objet sexuel allant jusqu’à être réduit à l’état d’esclave sexuel par un gang bang de femmes. […]. Les hommes subissent alors une soumission et des humiliations plus ou moins poussées, passant par le bondage, le pony play, le footjob, la masturbation attaché, les fessées…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86db760e-c3e5-3e68-8427-449850f2fee6",
                                        "entry_id": "40089d0d-a56b-3a7e-9fdb-d503f22ab38b",
                                        "glosses": [
                                            "Démonstration respectueuse dont un inférieur usait à l’égard d’un supérieur pour lui faire satisfaction."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7629f84-8798-4e53-8890-3e76c6a6f805",
                                                "sense_id": "86db760e-c3e5-3e68-8427-449850f2fee6",
                                                "text": "Le roi reçut ses soumissions avec bonté. - Ils furent députés de la ville pour porter au roi les soumissions du peuple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4d46a7c-377c-3802-b6d7-4ef05978cedc",
                                        "entry_id": "40089d0d-a56b-3a7e-9fdb-d503f22ab38b",
                                        "glosses": [
                                            "Acte, d’un écrit par lequel on déclare faire une acquisition, ou se charger d’un ouvrage, d’une fourniture, d’une entreprise, à telles et telles conditions, dans un marché soumis à la concurrence."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdcbc38b-3132-4d87-a7dc-6de444a75b48",
                                                "sense_id": "f4d46a7c-377c-3802-b6d7-4ef05978cedc",
                                                "text": "À la date fixée, les soumissions étaient ouvertes en audience publique et le bien était adjugé provisoirement au soumissionnaire qui avait fait l’offre la plus élevée, si toutefois sa soumission dépassait la mise à prix ; puis la vente était renvoyée à quinzaine pour adjudication au feu des enchères."
                                            },
                                            {
                                                "example_id": "a32a248b-c10a-4195-89cd-d9e966c1a2d8",
                                                "sense_id": "f4d46a7c-377c-3802-b6d7-4ef05978cedc",
                                                "text": "Dès 1890 se développe l’offensive du béton et du béton armé dans les grandes soumissions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbc9e748-4bea-386f-b593-f4e4e8e986a5",
                                        "entry_id": "40089d0d-a56b-3a7e-9fdb-d503f22ab38b",
                                        "glosses": [
                                            "Dans l’ancienne administration, accepter le résultat d’un contrôle fiscal. référence nécessaire (résoudre le problème)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d081c4d9-5106-3d0f-9dfe-7e3a797b61b7",
                                        "entry_id": "40089d0d-a56b-3a7e-9fdb-d503f22ab38b",
                                        "glosses": [
                                            "Technique consistant à faire abandonner son adversaire paralysé, par exemple à la suite d’un étranglement ou d'une clé de bras."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6da3420e-f661-3bdd-aa8a-979f8b62f260",
                                        "entry_id": "40089d0d-a56b-3a7e-9fdb-d503f22ab38b",
                                        "glosses": [
                                            "Abréviation de soumission au régime forestier : acte par lequel une collectivité ou une personne morale soumet une parcelle au régime forestier."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "712dc67f-2831-4e0d-9278-99a280c6bea1",
                                                "sense_id": "6da3420e-f661-3bdd-aa8a-979f8b62f260",
                                                "text": "La décision positive de l’administration emportait alors de plein droit la soumission dès que l’acquisition était définitive."
                                            },
                                            {
                                                "example_id": "4054b718-7fa2-40fc-aab9-d7318f491d63",
                                                "sense_id": "6da3420e-f661-3bdd-aa8a-979f8b62f260",
                                                "text": "Pour les forêts appartenant à des sections de communes, la procédure de soumission implique la consultation de la commission syndicale, selon les termes de l’article L.2411-7 du code général des collectivités territoriales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4907592a-d679-494d-af27-f7593461c013",
                        "source_entry_id": "6c2c4be5-f18c-3417-9bd3-4d4c367bb2ee",
                        "source_sense_description": "act of bringing under control",
                        "target_lang_word": "Unterwerfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterwerfung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9011017-b8d9-3ce0-b6a3-2313ffea6656",
                                        "entry_id": "24347d59-94f7-3fc0-9fe5-fdd9ffb44ba2",
                                        "glosses": [
                                            "die Handlung, sich jemandem zu ergeben; Akzeptanz einer (Zwangs-)Herrschaft oder Macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffa36879-29ac-469c-8782-860838afbc60",
                                                "sense_id": "d9011017-b8d9-3ce0-b6a3-2313ffea6656",
                                                "text": "Jetzt aufzuhören, käme einer Unterwerfung gleich."
                                            },
                                            {
                                                "example_id": "d6ea7957-2918-4601-bbb5-3d23f1e90e8f",
                                                "sense_id": "d9011017-b8d9-3ce0-b6a3-2313ffea6656",
                                                "text": "„Er stieß weit nach Osten vor, plünderte und zerstörte seinerseits den Ring, nahm die Unterwerfung des Khagans entgegen und trieb die Scharen der Awaren, die sich nicht beugen wollten, zur Flucht über die Theiß nach Osten.“"
                                            },
                                            {
                                                "example_id": "14543a5a-c741-4bfa-95b1-2a2637fe95a7",
                                                "sense_id": "d9011017-b8d9-3ce0-b6a3-2313ffea6656",
                                                "text": "„Mein Alter und mein Status geben ihr die vernunftmäßig nachvollziehbare Erlaubnis, sich zu unterwerfen, und im Bett ist Unterwerfung kein unangenehmes Gefühl.“"
                                            },
                                            {
                                                "example_id": "d2132f10-9288-4725-b594-732938177116",
                                                "sense_id": "d9011017-b8d9-3ce0-b6a3-2313ffea6656",
                                                "text": "„Der Despotismus erhöht die Wollust, er sucht Unterwerfung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "99649efb-81d8-3667-9518-6387c7e81da7",
                                        "entry_id": "24347d59-94f7-3fc0-9fe5-fdd9ffb44ba2",
                                        "glosses": [
                                            "gewaltsame Aneignung eines Herrschaftsgebiets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd73cb14-9125-4243-b852-ff03df71f020",
                                                "sense_id": "99649efb-81d8-3667-9518-6387c7e81da7",
                                                "text": "Die Unterwerfung des besiegten Landes führte zu Protesten."
                                            },
                                            {
                                                "example_id": "c242b868-2d78-4dd2-be26-6b622f7f1e01",
                                                "sense_id": "99649efb-81d8-3667-9518-6387c7e81da7",
                                                "text": "„Nach der Unterwerfung der nördlichen Grenzvölker und dem Abkommen mit dem Partherkönig im Osten 20 v. Chr. schien der Friede des Reiches tatsächlich für immer gesichert.“"
                                            },
                                            {
                                                "example_id": "d8ce7107-af91-4dea-8fb3-9386c2fb25a7",
                                                "sense_id": "99649efb-81d8-3667-9518-6387c7e81da7",
                                                "text": "„Ihm steckten Erfahrungen in den Knochen, die er wenige Jahre zuvor bei der Unterwerfung der Kumanen gemacht hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
