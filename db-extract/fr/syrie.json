                                            {
                                                "example_id": "bae53dbf-4f69-4068-8be5-5b3b5c9c0169",
                                                "sense_id": "2fcf607f-4b46-3a16-a13b-25821744bf0b",
                                                "text": "Wir fahren nach Syrien."
                                            },
                                            {
                                                "example_id": "5b5b08c7-ded3-4b61-9551-9660ab0e757a",
                                                "sense_id": "2fcf607f-4b46-3a16-a13b-25821744bf0b",
                                                "text": "Damaskus ist die Hauptstadt von Syrien."
                                            },
                                            {
                                                "example_id": "0052b31b-d0bb-4f19-be96-f4e270303192",
                                                "sense_id": "2fcf607f-4b46-3a16-a13b-25821744bf0b",
                                                "text": "„Mit rund 185.000 Quadratkilometern ist Syrien ungefähr halb so groß wie Deutschland.“"
                                            },
                                            {
                                                "example_id": "42404890-5dbe-4dc4-b6bc-71881db83719",
                                                "sense_id": "2fcf607f-4b46-3a16-a13b-25821744bf0b",
                                                "text": "„Nicht alle Kampfparteien in Syrien verdienen am Drogenschmuggel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
