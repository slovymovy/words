                        "examples": [
                            {
                                "example_id": "a8e341ab-0929-4fcc-be45-695d7ab4bb5a",
                                "sense_id": "6e3ab13e-6196-3b51-b35f-1936da10db3e",
                                "text": "Ze ruimden vooral toiletpapier, sigarettenpeuken, blikjes, flessen en voedselverpakkingen op. Soms ook zelfs plastic driewielers, leren laarzen en een bierflesje met een dode muis erin."
                            },
                            {
                                "example_id": "1c4bc758-44b9-4f77-b21d-56f446b9876b",
                                "sense_id": "6e3ab13e-6196-3b51-b35f-1936da10db3e",
                                "text": "Ze hoort zijn schedel op het hout bonken en de zolen van zijn laarzen over de natuurstenen vloer schrapen als haar moeder haar roept om Carel en haar te helpen Geert naar bed te dragen."
                            }
                        ]
                    }
