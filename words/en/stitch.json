{
    "word_family": [
        "stitcher",
        "stitching",
        "unstitch",
        "backstitch",
        "overstitch"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf72ead7-c3cd-3d7e-b254-6967857fbee7",
                    "sense_definition": "A single pass of a needle in sewing; the loop or turn of the thread thus made.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sewing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She carefully made each <w>stitch</w> by hand to ensure the dress was perfect.",
                            "target_lang_translations": {
                                "ru": "Она тщательно делала каждый <w>стежок</w> вручную, чтобы платье было идеальным."
                            }
                        },
                        {
                            "text": "If you pull the thread too hard, you might break the <w>stitch</w> and ruin the seam.",
                            "target_lang_translations": {
                                "ru": "Если потянуть нитку слишком сильно, можно порвать <w>стежок</w> и испортить шов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "loose stitch",
                        "tight stitch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один проход иглы при шитье; петля или оборот нити, сделанные таким образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стежок",
                                "target_lang_sense_clarification": "отдельный элемент шва"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "555c536b-5c06-308e-84ca-6aec7ff10570",
                    "sense_definition": "A single turn of the thread round a needle in knitting; a link, or loop, of yarn.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "knitting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to drop a <w>stitch</w> while you are working on the sweater.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, чтобы не спустить <w>петлю</w>, пока работаете над свитером."
                            }
                        },
                        {
                            "text": "The pattern requires you to count every <w>stitch</w> in the row very carefully.",
                            "target_lang_translations": {
                                "ru": "Узор требует, чтобы вы очень внимательно считали каждую <w>петлю</w> в ряду."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drop a stitch",
                        "take up a stitch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один оборот нити вокруг спицы при вязании; петля пряжи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "петля",
                                "target_lang_sense_clarification": "в вязании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21d5e3f1-06f0-3093-9747-7bb486bd5c49",
                    "sense_definition": "An intense stabbing pain under the lower edge of the ribcage, brought on by exercise or laughing.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I've got a <w>stitch</w> in my side, so I'm going to have to stop and rest.",
                            "target_lang_translations": {
                                "ru": "У меня <w>закололо</w> в боку, так что мне придется остановиться и отдохнуть."
                            }
                        },
                        {
                            "text": "After running for fifteen minutes, I got a terrible <w>stitch</w> that made it hard to breathe.",
                            "target_lang_translations": {
                                "ru": "После пятнадцати минут бега у меня появилась ужасная <w>колика</w>, из-за которой стало трудно дышать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "get a stitch",
                        "stitch in the side"
                    ],
                    "target_lang_definitions": {
                        "ru": "Острая колющая боль в боку под ребрами, возникающая при физической нагрузке или смехе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колика",
                                "target_lang_sense_clarification": "острая боль в боку"
                            },
                            {
                                "target_lang_word": "резь",
                                "target_lang_sense_clarification": "острая режущая боль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "daa6bcf6-2cb0-333e-87e1-a8078dc97c12",
                    "sense_definition": "Any least part of a fabric or clothing; often used to refer to having no clothes on at all.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rain was so heavy that it managed to wet every <w>stitch</w> of my clothes.",
                            "target_lang_translations": {
                                "ru": "Дождь был таким сильным, что умудрился промочить каждую <w>нитку</w> моей одежды."
                            }
                        },
                        {
                            "text": "The poor child didn't have a <w>stitch</w> of clothing on when they found him.",
                            "target_lang_translations": {
                                "ru": "На бедном ребенке не было ни <w>нитки</w> одежды, когда его нашли."
                            }
                        }
                    ],
                    "common_phrases": [
                        "not a stitch",
                        "wet every stitch"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in negative constructions like 'not a stitch'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Малейшая часть ткани или одежды; часто используется для обозначения полного отсутствия одежды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нитка",
                                "target_lang_sense_clarification": "в значении 'ни единой нитки'"
                            },
                            {
                                "target_lang_word": "лоскут",
                                "target_lang_sense_clarification": "кусочек ткани"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e85e9f03-8165-326e-895d-47f024c32725",
                    "sense_definition": "An arrangement of stitches in sewing or knitting, or a specific method of stitching in a particular style.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "craft_technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a beautiful cross <w>stitch</w> to decorate the border of the tablecloth.",
                            "target_lang_translations": {
                                "ru": "Она использовала красивый <w>крестик</w> для украшения каймы скатерти."
                            }
                        },
                        {
                            "text": "The scarf was made using a complex herringbone <w>stitch</w> that gave it a thick texture.",
                            "target_lang_translations": {
                                "ru": "Шарф был выполнен сложным <w>швом</w> «елочка», который придал ему плотную текстуру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cross stitch",
                        "herringbone stitch",
                        "satin stitch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ расположения стежков при шитье или вязании, или определенный метод вышивания в определенном стиле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шов",
                                "target_lang_sense_clarification": "вид соединения или вышивки"
                            },
                            {
                                "target_lang_word": "стежок",
                                "target_lang_sense_clarification": "тип строчки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c377eea-917f-3332-84f8-d5e5a3cc0df2",
                    "sense_definition": "An incorporation of an existing video into a new one, resulting in a collaborative clip that shows the two videos in a sequence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her video went viral and received more <w>stitches</w> than she could count from other creators.",
                            "target_lang_translations": {
                                "ru": "Ее видео стало вирусным и получило больше <w>стичей</w> от других авторов, чем она могла сосчитать."
                            }
                        },
                        {
                            "text": "The <w>stitches</w> on TikTok nearly always end in agreement with the original creator's opinion.",
                            "target_lang_translations": {
                                "ru": "<w>Стичи</w> в TikTok почти всегда заканчиваются согласием с мнением автора оригинала."
                            }
                        }
                    ],
                    "common_phrases": [
                        "video stitch",
                        "tiktok stitch"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "specific to social media platforms like TikTok"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объединение существующего видео с новым, в результате чего получается совместный ролик, показывающий два видео последовательно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стич",
                                "target_lang_sense_clarification": "функция в TikTok"
                            },
                            {
                                "target_lang_word": "склейка",
                                "target_lang_sense_clarification": "совмещение видео"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05da1b91-f3d3-3235-8f63-b0494d9e6576",
                    "sense_definition": "A fastening, as of thread or wire, through the back of a book to connect the pages.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bookbinding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique book was falling apart because the original <w>stitch</w> in the binding had rotted away.",
                            "target_lang_translations": {
                                "ru": "Старинная книга разваливалась, потому что оригинальная <w>прошивка</w> в переплете сгнила."
                            }
                        },
                        {
                            "text": "Modern machines can apply a wire <w>stitch</w> to pamphlets much faster than a human can.",
                            "target_lang_translations": {
                                "ru": "Современные машины могут накладывать проволочный <w>стежок</w> на брошюры гораздо быстрее, чем человек."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wire stitch",
                        "saddle stitch"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in bookbinding"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрепление нитью или проволокой через корешок книги для соединения страниц."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прошивка",
                                "target_lang_sense_clarification": "в переплетном деле"
                            },
                            {
                                "target_lang_word": "скрепка",
                                "target_lang_sense_clarification": "проволочный стежок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f353b71-0046-343c-a6d3-08f210fe1d45",
                    "sense_definition": "A furrow or a ridge of land made by a plow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer began to plow down the wheat-<w>stitches</w> to level the ground for the next season.",
                            "target_lang_translations": {
                                "ru": "Фермер начал распахивать пшеничные <w>гряды</w>, чтобы выровнять землю для следующего сезона."
                            }
                        },
                        {
                            "text": "In some regions, farmers prefer making five <w>stitches</w> when they come to sow their seeds.",
                            "target_lang_translations": {
                                "ru": "В некоторых регионах фермеры предпочитают делать пять <w>борозд</w>, когда приступают к посеву семян."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wheat-stitch"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional agricultural term"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Борозда или гребень земли, сделанные плугом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "борозда",
                                "target_lang_sense_clarification": "след от плуга"
                            },
                            {
                                "target_lang_word": "гряда",
                                "target_lang_sense_clarification": "вспаханная полоса"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d30b3460-681f-31f1-800b-f2b98b9fa67f",
                    "sense_definition": "To sew, or unite or attach by stitches.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sewing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>stitch</w> the two pieces of fabric together to make the cushion cover.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>сшить</w> два куска ткани вместе, чтобы сделать чехол для подушки."
                            }
                        },
                        {
                            "text": "The doctor will <w>stitch</w> the wound to help it heal more quickly and safely.",
                            "target_lang_translations": {
                                "ru": "Врач <w>зашьет</w> рану, чтобы она зажила быстрее и безопаснее."
                            }
                        }
                    ],
                    "synonyms": [
                        "sew",
                        "stitch together"
                    ],
                    "common_phrases": [
                        "stitch up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шить, соединять или прикреплять с помощью стежков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шить",
                                "target_lang_sense_clarification": "соединять нитью"
                            },
                            {
                                "target_lang_word": "зашивать",
                                "target_lang_sense_clarification": "накладывать швы на рану"
                            },
                            {
                                "target_lang_word": "сшивать",
                                "target_lang_sense_clarification": "соединять края"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24730761-83f9-3663-a7c0-e7173f17909a",
                    "sense_definition": "To form stitches in; especially, to sew in such a manner as to show on the surface a continuous line of stitches.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sewing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tailor began to <w>stitch</w> a shirt bosom with very fine, decorative thread.",
                            "target_lang_translations": {
                                "ru": "Портной начал <w>прострачивать</w> манишку рубашки очень тонкой декоративной нитью."
                            }
                        },
                        {
                            "text": "You can <w>stitch</w> a pattern onto the pocket to give the jeans a unique look.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>вышить</w> узор на кармане, чтобы придать джинсам уникальный вид."
                            }
                        }
                    ],
                    "synonyms": [
                        "sew"
                    ],
                    "common_phrases": [
                        "stitch a pattern"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать стежки; особенно шить таким образом, чтобы на поверхности была видна непрерывная линия стежков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прострачивать",
                                "target_lang_sense_clarification": "делать строчку"
                            },
                            {
                                "target_lang_word": "вышивать",
                                "target_lang_sense_clarification": "создавать узор стежками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb76c2ec-f6ae-3228-b0e4-2d3e967ab289",
                    "sense_definition": "To combine two or more photographs of the same scene into a single image.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "digital_editing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I can use this software to <w>stitch</w> together a panorama from these five photos.",
                            "target_lang_translations": {
                                "ru": "Я могу использовать эту программу, чтобы <w>склеить</w> панораму из этих пяти фотографий."
                            }
                        },
                        {
                            "text": "The app will automatically <w>stitch</w> the images to create a seamless 360-degree view.",
                            "target_lang_translations": {
                                "ru": "Приложение автоматически <w>сошьет</w> изображения для создания бесшовного 360-градусного обзора."
                            }
                        }
                    ],
                    "synonyms": [
                        "stitch together"
                    ],
                    "common_phrases": [
                        "stitch images"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объединять две или более фотографии одной и той же сцены в одно изображение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склеивать",
                                "target_lang_sense_clarification": "объединять фото в панораму"
                            },
                            {
                                "target_lang_word": "сшивать",
                                "target_lang_sense_clarification": "в цифровой обработке изображений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f34478bf-5249-3f6a-ab90-b769c1511464",
                    "sense_definition": "To include, combine, or unite different elements into a single whole.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "unification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author managed to <w>stitch</w> various historical facts into a compelling narrative.",
                            "target_lang_translations": {
                                "ru": "Автору удалось <w>вплести</w> различные исторические факты в захватывающее повествование."
                            }
                        },
                        {
                            "text": "Effective conservation calls for <w>stitching</w> together the management of public and private lands.",
                            "target_lang_translations": {
                                "ru": "Эффективная охрана природы требует <w>объединения</w> управления государственными и частными землями."
                            }
                        }
                    ],
                    "synonyms": [
                        "stitch together"
                    ],
                    "common_phrases": [
                        "stitch into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Включать, комбинировать или объединять различные элементы в единое целое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связывать",
                                "target_lang_sense_clarification": "объединять разные части"
                            },
                            {
                                "target_lang_word": "состыковывать",
                                "target_lang_sense_clarification": "соединять элементы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bee96316-e532-327d-982c-058be94facda",
                    "sense_definition": "To incorporate an existing video into a new one, resulting in a collaborative clip.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I'm going to <w>stitch</w> this video when I have an update on the situation.",
                            "target_lang_translations": {
                                "ru": "Я <w>сделаю стич</w> на это видео, когда у меня будут новости по ситуации."
                            }
                        },
                        {
                            "text": "Users often <w>stitch</w> popular clips to add their own commentary or reactions.",
                            "target_lang_translations": {
                                "ru": "Пользователи часто <w>делают стичи</w> на популярные клипы, чтобы добавить свои комментарии или реакции."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stitch a video"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "specific to social media platforms"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Включать существующее видео в новое, создавая совместный клип."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать стич",
                                "target_lang_sense_clarification": "в соцсетях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4174447-87e9-3d70-9dc1-1dad76c6d2aa",
                    "sense_definition": "To weld together through a series of connecting or overlapping spot welds.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "industrial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can prevent warping by <w>stitching</w> your metal pieces together with small welds.",
                            "target_lang_translations": {
                                "ru": "Вы можете предотвратить деформацию, <w>соединяя</w> металлические детали небольшими сварными швами."
                            }
                        },
                        {
                            "text": "The technician decided to <w>stitch</w> the joint using a continuous technique for extra strength.",
