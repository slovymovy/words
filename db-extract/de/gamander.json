                "senses": [
                    {
                        "sense_id": "dc1525d9-a5dc-342e-9f1c-f1c4621338cc",
                        "entry_id": "19512da0-77e6-3f27-b514-ce1042ca2419",
                        "glosses": [
                            "Pflanzengattung in der Familie der Lippenblütler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "378f58f3-9cf9-482f-b77f-7ca6e15d8210",
                                "sense_id": "dc1525d9-a5dc-342e-9f1c-f1c4621338cc",
                                "text": "„Ihr Weg führte sie zwischen Gamander und Stechpalmen hindurch, dann über felsigen Grund, in den Bergspalten standen schwarze Bäume.“"
                            },
                            {
                                "example_id": "f51d9387-642c-4bfd-a1b6-6f774594e754",
                                "sense_id": "dc1525d9-a5dc-342e-9f1c-f1c4621338cc",
                                "text": "„Er stellte Bier her aus den Blättern des Gamander und gab es den Erntearbeitern anstelle von Apfelwein zu trinken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
