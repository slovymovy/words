                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba1b649e-c05d-4e53-9db7-eff7fef940ab",
                        "source_entry_id": "2acf9525-ca3f-3e00-b04d-80f1fdf0b11d",
                        "source_sense_id": "c3e32134-52ce-329c-8882-61e1a3cb9c99",
                        "target_lang_word": "veteran",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veteran",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ca68d47-b168-3ed3-9c94-6b040ded7b1a",
                                        "entry_id": "896a8f2b-2614-3d17-9da2-a731b8271d09",
                                        "glosses": [
                                            "A person with long experience of a particular activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dd6962c-f0ea-4e8c-a4ac-44b6ad018011",
                                                "sense_id": "3ca68d47-b168-3ed3-9c94-6b040ded7b1a",
                                                "text": "The company's new hires were nervous, but the veterans were self-assured because, as one summarized it, \"this isn't our first rodeo.\""
                                            },
                                            {
                                                "example_id": "7a2736c9-54a8-4a25-892f-5c1c7936e758",
                                                "sense_id": "3ca68d47-b168-3ed3-9c94-6b040ded7b1a",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers.[…]Much of their pleading is public-relations bluster. Clever financial ploys are what have made billionaires of the industry’s veterans. “Operational improvement” in a portfolio company has often meant little more than promising colossal bonuses to sitting chief executives if they meet ambitious growth targets. That model is still prevalent today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7aeb4480-a7ad-311c-b771-76a2561edae5",
                                        "entry_id": "896a8f2b-2614-3d17-9da2-a731b8271d09",
                                        "glosses": [
                                            "A person with long experience of a particular activity.",
                                            "A person who has served in the armed forces, especially an old soldier who has seen long service."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f708683-247f-4db5-bdc9-78239314f0f1",
                                                "sense_id": "7aeb4480-a7ad-311c-b771-76a2561edae5",
                                                "text": "We honor veterans and senior citizens with a ten percent discount."
                                            },
                                            {
                                                "example_id": "c0d99cc0-99fe-4379-85ae-e360bf4b170d",
                                                "sense_id": "7aeb4480-a7ad-311c-b771-76a2561edae5",
                                                "text": "For 55-year-old U.S. Army veteran Sae Joon Park, this was the hardest moment of his life. […] Park's story reflects both the challenges of life after combat and the perils that noncitizen veterans face if caught in the legal system — realities made harsher amid the Trump administration's push for record deportations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fea74acb-5e0d-38b0-b2da-4a27f012af9a",
                                        "entry_id": "896a8f2b-2614-3d17-9da2-a731b8271d09",
                                        "glosses": [
                                            "A group, animal, etc. with long experience of a particular activity."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f867a91e-bce5-496a-bae1-0cb2a8cded27",
                                                "sense_id": "fea74acb-5e0d-38b0-b2da-4a27f012af9a",
                                                "text": "Their mules were clearly veterans. They seemed to know what to do even better than the teenage farmhand who was driving the team."
                                            },
                                            {
                                                "example_id": "7b55569c-2460-4df0-8efe-134b6df4f047",
                                                "sense_id": "fea74acb-5e0d-38b0-b2da-4a27f012af9a",
                                                "text": "Most of the cars which we call \"veterans\" today were on view at the Motor Show of 1911."
                                            },
                                            {
                                                "example_id": "c558e9e9-443f-4bf0-8935-ce307e09159c",
                                                "sense_id": "fea74acb-5e0d-38b0-b2da-4a27f012af9a",
                                                "text": "The label has often collaborated with other designers, like Australian shoemaker Teva and American woolwear veteran Pendleton."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "veteran",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d43969b2-6081-3a4a-9bd8-5b9452dc51f6",
                                        "entry_id": "54378025-2dee-36e6-8d79-8ea40b075fef",
                                        "glosses": [
                                            "Having had long experience, practice, or service."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fcc55e5-c433-4046-a321-fadde51c31b8",
                                                "sense_id": "d43969b2-6081-3a4a-9bd8-5b9452dc51f6",
                                                "text": "The insinuating eloquence and delicate flattery of veteran diplomatists and courtiers."
                                            },
                                            {
                                                "example_id": "6504b35c-8de6-4053-ab5a-ca512f2c70ae",
                                                "sense_id": "d43969b2-6081-3a4a-9bd8-5b9452dc51f6",
                                                "text": "Nothing could be more business-like than the construction of the stout dams, and nothing more gently rural than the limpid lakes, with the grand old forest trees marshalled round their margins like a veteran army that had marched down to drink, only to be stricken motionless at the water’s edge."
                                            },
                                            {
                                                "example_id": "9b216132-a0ef-44b8-b50f-f41d665d5a28",
                                                "sense_id": "d43969b2-6081-3a4a-9bd8-5b9452dc51f6",
                                                "text": "“That was in Casco,” his wife contradicted immediately. She spoke in the unmistakable tones of a veteran contradictor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dcd539c-3b77-354e-9ef5-4340680f78ac",
                                        "entry_id": "54378025-2dee-36e6-8d79-8ea40b075fef",
                                        "glosses": [
                                            "Of or relating to former members of the military armed forces, especially those who served during wartime."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
