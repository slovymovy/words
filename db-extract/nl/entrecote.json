                                    {
                                        "sense_id": "98014e28-e6d4-3887-bb20-7370696fbef4",
                                        "entry_id": "d4738a82-46c8-3977-aad3-4a3d3d7a5af9",
                                        "glosses": [
                                            "Morceau de viande prélevé dans le même morceau que la côte de bœuf, mais désossé et coupé dans la tranche pour en réduire l'épaisseur."
                                        ],
                                        "tags": [
                                            "Boucherie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cbd17ff-df40-4a3f-b4e5-a773662068ef",
                                                "sense_id": "98014e28-e6d4-3887-bb20-7370696fbef4",
                                                "text": "Une entrecôte grillée, braisée."
                                            },
                                            {
                                                "example_id": "160a0866-4fb6-4ee4-a13d-397813502cc2",
                                                "sense_id": "98014e28-e6d4-3887-bb20-7370696fbef4",
                                                "text": "Cette entrecôte est très tendre."
                                            },
                                            {
                                                "example_id": "fd7bc452-b740-40f4-822b-978ddbd4900f",
                                                "sense_id": "98014e28-e6d4-3887-bb20-7370696fbef4",
                                                "text": "C’est pour pouvoir acheter l’entrecôte\nQui nourrira les chères têtes blondes\nQu’elle commit son initiale faute\nQui la rabaisse au rang du demi-monde"
                                            },
                                            {
                                                "example_id": "553270bc-3c4a-4515-8af8-7afb2332123b",
                                                "sense_id": "98014e28-e6d4-3887-bb20-7370696fbef4",
                                                "text": "– Laisse-moi déjà me taper la cloche, fait une voix parisienne, un petite entrecôte Bercy et un canon de beaujolais pour commencer."
                                            },
                                            {
                                                "example_id": "ea5d95bb-73d4-4a77-b289-3dc2e94e8b50",
                                                "sense_id": "98014e28-e6d4-3887-bb20-7370696fbef4",
                                                "text": "Le poulet faisait partie des menus de fête, un mets noble alors que le bifteck frites, l’entrecôte marchand de vin étaient des plats populaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
