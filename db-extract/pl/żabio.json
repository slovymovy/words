                        "cross_references": [
                            {
                                "target_word": "frogly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25827281-a953-3a33-9949-304c33b838f1",
                                        "entry_id": "b9efd4e7-657f-3709-8021-3f93f41c1b34",
                                        "glosses": [
                                            "Of, relating to, or characteristic of frogs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f09f6fff-28d5-489a-9a23-4a5c4946b729",
                                                "sense_id": "25827281-a953-3a33-9949-304c33b838f1",
                                                "text": "1877, \"The Centennial Frog\", The Centennial Frog, and Other Stories, publ. by Clazton, Remsen & Haffelfinger, page 14.\nLieutenant Frog's rich frogly voice / Husky grew with his great theme;"
                                            },
                                            {
                                                "example_id": "b9bd3569-a918-43a9-81d2-a96962a68d7f",
                                                "sense_id": "25827281-a953-3a33-9949-304c33b838f1",
                                                "text": "[…] and when at last they arrive at frogly maturity, they escape into the world through the mouth of their father."
                                            },
                                            {
                                                "example_id": "1bfae1b7-f428-43ed-a721-ab3133fbb2d4",
                                                "sense_id": "25827281-a953-3a33-9949-304c33b838f1",
                                                "text": "Yet as some of the verses show, Aristophanes knew a good deal of actual frogly habits."
                                            },
                                            {
                                                "example_id": "41ddccdf-e4a5-4387-9a67-f60a9cf134b3",
                                                "sense_id": "25827281-a953-3a33-9949-304c33b838f1",
                                                "text": "On those sacred nights you can rise in frogly glory to confront the villains who are poisoning my subjects."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "frogly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77c1c65b-92ee-3be8-85c1-03353e7c21b0",
                                        "entry_id": "15474030-8791-33e2-a29a-aed6b88b9aa6",
                                        "glosses": [
                                            "In a frog-like manner."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "nonce-word"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2d6e6f0-38bd-4900-9efc-98bcd3c4d2c3",
                                                "sense_id": "77c1c65b-92ee-3be8-85c1-03353e7c21b0",
                                                "text": "Toadly awesome!\" \"Not toadly,\" said Michael, laughing. \"Gorfman's a frog.\" \"It's frogly awesome,\" said Charu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab79747c-02fa-4dfe-b3be-9e0fa80a651a",
                        "source_entry_id": "983e1e7c-e32a-3a79-a7f7-1778098d8a87",
                        "source_sense_id": "34c2feff-c893-3762-bbd3-3277311d14c2",
                        "target_lang_word": "froglike",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "froglike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d8bcbc0-55cb-3f97-885c-eb7384b45d43",
                                        "entry_id": "7aa10e4b-9936-320e-af3a-072dbb1f12cf",
                                        "glosses": [
                                            "Similar to a frog (amphibian), or to a characteristic of a frog."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f611a338-20c6-454f-8b02-8939eba4f756",
                                                "sense_id": "9d8bcbc0-55cb-3f97-885c-eb7384b45d43",
                                                "text": "Though it was not far to Jamiltepec, once outside the village, the chauffeur and his little attendant lad began to get frightened, and to go frog-like with fear."
                                            },
                                            {
                                                "example_id": "bdf62b03-c19f-48bf-bf10-ca10de7e6e58",
                                                "sense_id": "9d8bcbc0-55cb-3f97-885c-eb7384b45d43",
                                                "text": "I have seen, too, a frog-like beast with protruding green eyes, which is simply a gaping mouth with a huge stomach behind it."
                                            },
                                            {
                                                "example_id": "dc5f35b6-16a5-456a-a678-52aa69aadb92",
                                                "sense_id": "9d8bcbc0-55cb-3f97-885c-eb7384b45d43",
                                                "text": "a froglike croak"
                                            },
                                            {
                                                "example_id": "c571946b-c1c9-4f5c-ad66-8d16c5e49c51",
                                                "sense_id": "9d8bcbc0-55cb-3f97-885c-eb7384b45d43",
                                                "text": "Parsons, Winston's fellow-tenant at Victory Mansions, was in fact threading his way across the room--a tubby, middle-sized man with fair hair and a froglike face."
                                            },
                                            {
                                                "example_id": "2e57594a-55a9-4f26-8f2f-e299431e35f6",
                                                "sense_id": "9d8bcbc0-55cb-3f97-885c-eb7384b45d43",
                                                "text": "It was the typical chatter of the moment when each woman was showing off her baby, held against her froglike belly."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "froglike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "073e766d-9488-30b6-b38a-efd0e25936dc",
                                        "entry_id": "4fbbaa71-5c8f-3f5e-9472-f20f1fab38f4",
                                        "glosses": [
                                            "In a froglike way"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "985c9ee5-ce2a-42b2-be9f-59d613cacd1b",
                                                "sense_id": "073e766d-9488-30b6-b38a-efd0e25936dc",
                                                "text": "to hop froglike"
                                            },
                                            {
                                                "example_id": "7f856d24-3ae8-4016-93fa-71ccd6de031c",
                                                "sense_id": "073e766d-9488-30b6-b38a-efd0e25936dc",
                                                "text": "In all our adventures I do not know that I have ever seen a more strange sight than this impassive and still dignified figure crouching frog-like upon the ground and goading to a wilder exhibition of passion the maddened hound, which ramped and raged in front of him, by all manner of ingenious and calculated cruelty."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
