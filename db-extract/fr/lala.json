                "senses": [
                    {
                        "sense_id": "ae89d8b6-b21d-3e86-b532-12845a4858af",
                        "entry_id": "f25a81af-4ab8-39db-b2be-a0cd1e5e8020",
                        "glosses": [
                            "Prénom malgache."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2feca66-45b1-4f38-8862-800edc1812a4",
                                "sense_id": "ae89d8b6-b21d-3e86-b532-12845a4858af",
                                "text": "Le mardi 28 mars 1962, Lala est née, envelopée dans son placenta. Ne sachant si ce nourrisson allait vivre ou mourir, sa mère lui a donné le nom de Lalanañahary, « Voie-de-Dieu »."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2e7b891-0142-3f39-9d54-2f9a74137f34",
                        "entry_id": "f25a81af-4ab8-39db-b2be-a0cd1e5e8020",
                        "glosses": [
                            "Prénom de Mauritanie."
                        ],
                        "tags": [
                            "information à préciser ou à vérifier"
                        ],
                        "examples": [
                            {
                                "example_id": "33eb9470-a864-409a-bab0-53691d4d2e56",
                                "sense_id": "f2e7b891-0142-3f39-9d54-2f9a74137f34",
                                "text": "D’une mère Aqzâzir et d’un père Hartâni (affranchi) de la tribu des Smâsîd, Lala est née à Atar, au début des années 1930, dans le quartier Camp d’Amérique."
                            }
                        ]
                    }
