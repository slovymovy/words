                            "past"
                        ],
                        "form": "зелене́вши"
                    },
                    {
                        "form_id": "90d3b231-9716-41cc-8a51-ec326abc3b67",
                        "entry_id": "9af122f2-9cd2-3bb7-925c-5400e07d59cb",
