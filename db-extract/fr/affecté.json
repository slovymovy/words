                                            {
                                                "example_id": "811c714c-9eff-4c28-b7a9-bf43b1d2943c",
                                                "sense_id": "3ba4cc1f-f429-3638-abc1-e76a3914a434",
                                                "text": "an affected equation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "207874c9-62c9-35bc-ba42-84d6ac614602",
                                        "entry_id": "6b564553-b30b-38b9-8cc5-82f10e68c36c",
                                        "glosses": [
                                            "Resulting from a mostly negative physical effect or transformation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
