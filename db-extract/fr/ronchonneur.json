                    }
                ],
                "senses": [
                    {
                        "sense_id": "8aef667f-9ed0-3a07-9f23-bb79aca15711",
                        "entry_id": "d5e112cc-be18-31e2-ae1f-61373a52dd9e",
                        "glosses": [
                            "Personne qui ronchonne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c71fb0c-8091-4ca7-9e79-99f8ec22b54d",
                                "sense_id": "8aef667f-9ed0-3a07-9f23-bb79aca15711",
                                "text": "Alceste (fort, courageux, en grec) : c’est un ronchonneur attendrissant, il voudrait que toute amitié soit assortie d’une sincérité limpide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7bcac0a3-e187-4b7b-9cf4-7fa13ec054bb",
                        "source_entry_id": "d5e112cc-be18-31e2-ae1f-61373a52dd9e",
                        "source_sense_id": "8aef667f-9ed0-3a07-9f23-bb79aca15711",
                        "target_lang_word": "Muffel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muffel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95ddaf27-ed45-3ecf-977d-881191c0ce02",
                                        "entry_id": "7c193268-9af5-3dca-b048-d1742fac9514",
                                        "glosses": [
                                            "jemand, der mürrisch, unfreundlich, ungesprächig, verdrießlich ist"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d4df579-96bd-41ab-bc5f-15379e834e75",
                                                "sense_id": "95ddaf27-ed45-3ecf-977d-881191c0ce02",
                                                "text": "„So wird der Vater gern als herrischer Muffel porträtiert, der mit dem Fuß das TV-Gerät einschaltet, breitbeinig davorsitzt und nach Bier brüllt.“"
                                            },
                                            {
                                                "example_id": "43df816f-2e20-41c0-ac30-d189067df5bb",
                                                "sense_id": "95ddaf27-ed45-3ecf-977d-881191c0ce02",
                                                "text": "„Er ist ewig unzufrieden, ein Muffel, Brausekopf und Tagträumer.“"
                                            },
                                            {
                                                "example_id": "de16c85a-f86b-42e1-8034-9586f06d3c90",
                                                "sense_id": "95ddaf27-ed45-3ecf-977d-881191c0ce02",
                                                "text": "„Den eingefleischten Muffeln können auch die kleinen Freuden des Lebens die schlechte Laune nicht verderben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7e1513aa-ddfe-3fa2-bca7-6d69c196a89d",
                                        "entry_id": "7c193268-9af5-3dca-b048-d1742fac9514",
                                        "glosses": [
                                            "jemand, der etwas (aus Abneigung, Desinteresse, Gleichgültigkeit) gar nicht oder nur ungern tut"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8ee8ed5-92ba-4cdc-bf55-2a4378b39904",
                                                "sense_id": "7e1513aa-ddfe-3fa2-bca7-6d69c196a89d",
                                                "text": "„Der Entschluß fiel den Krawatten-Herstellern um so leichter, da sie sich mit dem provozierenden Muffel ohnehin nie recht befreunden konnten.“"
                                            },
                                            {
                                                "example_id": "c4322d9a-7617-42b8-8ce8-e7cabca24022",
                                                "sense_id": "7e1513aa-ddfe-3fa2-bca7-6d69c196a89d",
                                                "text": "„Im Ortsgebiet ist die Situation besonders drastisch: Nur rund ein Viertel aller Lenker hält sich an die Anschnall-Pflicht. Viele ‚Muffel‘ verlassen sich auf ihren Airbag, der jedoch nur in Kombination mit dem Gurt Sicherheit bietet.“"
                                            },
                                            {
                                                "example_id": "7e34e12f-0571-47c0-b681-2cfffb5b9853",
                                                "sense_id": "7e1513aa-ddfe-3fa2-bca7-6d69c196a89d",
                                                "text": "„Für Muffel des jecken Treibens ist die Reise also perfekt als Alternative zu den tollen Tagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "575b4713-e8c8-3fd4-ac37-63a315a1c528",
                                        "entry_id": "7c193268-9af5-3dca-b048-d1742fac9514",
                                        "glosses": [
                                            "(bei Wiederkäuern) Maul samt dem Bereich um die Nasenlöcher"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4e6f6c4-107c-412e-b6de-369ddb4fea74",
                                                "sense_id": "575b4713-e8c8-3fd4-ac37-63a315a1c528",
                                                "text": "„Ein Merkmal des Elchs ist das große Oberteil des Mauls. Es wird Muffel genannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f8c37582-02ac-3cce-9cc7-9ca585600a0d",
                                        "entry_id": "7c193268-9af5-3dca-b048-d1742fac9514",
                                        "glosses": [
                                            "unbehaarter, eine Felderung aufweisender, durch die Schleimhaut gebildeter Bereich um die Nasenlöcher mancher Großsäuger"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Muffel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2472bf11-06e2-3a43-90f7-73adcb17c1ec",
                                        "entry_id": "23a0c91e-a6c5-329e-8c0a-3aafcc27f2a1",
                                        "glosses": [
                                            "hitzebeständiges, von außen beheiztes (mitunter verschließbares) Gefäß, das zum Einsatz in Öfen (Muffelöfen) insbesondere in Laboren kommt und dem Schutz vor Flammen, direkter Heizelementestrahlung, Gasen und Staub dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d46bff3-f728-4f71-bf03-a9ea741adc81",
                                                "sense_id": "2472bf11-06e2-3a43-90f7-73adcb17c1ec",
                                                "text": "„Iſt dieſes Einſetzen in die Muffel geſchehen, ſo wird in den ſchon vor dem Einſetzen gleich der Muffel und den Platten erwärmten Ofen vorſichtig angefeuert und mit Verſtärkung der Hitze fortgefahren, bis das Einſchmelzen der Farben in das Glas vor ſich geht.“"
                                            },
                                            {
                                                "example_id": "00391efa-a0f8-4f5c-99df-cd8697092e0c",
                                                "sense_id": "2472bf11-06e2-3a43-90f7-73adcb17c1ec",
                                                "text": "„Wegen der herkömmlichen Verfahrensweise – Destillationsverfahren in liegenden Muffeln – war die Zinkproduktion, so Preussag-Pressesprecher Wilfried Klewin, ‚nicht mehr wirtschaftlich‘.“"
                                            },
                                            {
                                                "example_id": "1569706f-65f2-4a9e-9e36-65b10991bbb8",
                                                "sense_id": "2472bf11-06e2-3a43-90f7-73adcb17c1ec",
                                                "text": "„Alembik, Aludel und Cucurbit finden sich zusammen mit anderem technischem Laborgerät in mehrfacher Ausführung. Schmelz- und Destillieröfen lassen sich ebenso nachweisen wie die dazugehörigen Muffeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Muffel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a18bdbc-565e-3fa8-8aa2-8a240994db63",
                                        "entry_id": "a2839722-5358-36bd-9cb1-d915ead69094",
                                        "glosses": [
                                            "(ursprünglich auf Korsika und Sardinien beheimatetes) braunes Wildschaf, dessen Männchen große, nach hinten gebogene und dessen Weibchen kurze, nach oben gerichtete Hörner besitzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c8efef7-aa44-4955-93e4-09a46203b5f1",
                                                "sense_id": "0a18bdbc-565e-3fa8-8aa2-8a240994db63",
                                                "text": "„Betrachtet man die Reisen der Jäger, rangieren Fahrten nach Polen und Ungarn (jeweils auf Rothirsch, Rehbock oder Wildschwein), Österreich (Gams), in die Russische Föderation (Rothirsch, Elch), nach Tschechien (Damhirsch, Muffel und Wildschwein) und Schottland (Hirsch) ganz oben in der Rangliste der Ziele.“"
                                            },
                                            {
                                                "example_id": "f94a354e-451c-41e2-b90b-1d2e9f787793",
                                                "sense_id": "0a18bdbc-565e-3fa8-8aa2-8a240994db63",
                                                "text": "„Ziel der Maßnahme ist auch zu verhindern, dass Wild mit diesen Lebensmitteln in Kontakt kommt, da auch das heimische Wild für die MKS empfänglich ist. Dies gilt für Schalenwild, wie Wildschwein, Reh, Muffel und Rotwild.“"
                                            },
                                            {
                                                "example_id": "32f26381-2e48-4a96-b02a-fe95a9b9d947",
                                                "sense_id": "0a18bdbc-565e-3fa8-8aa2-8a240994db63",
                                                "text": "„Er weiß, dass die Schäden in erster Linie auf das Konto des Rotwildes gehen, zum Teil aber auch auf das der Muffel.“"
                                            },
                                            {
                                                "example_id": "c7ce7265-4fef-4464-b054-b3273e99a35b",
                                                "sense_id": "0a18bdbc-565e-3fa8-8aa2-8a240994db63",
                                                "text": "„Im Fall der kleinen Ziege stellte sich dann übrigens schnell heraus, dass es sich in Wahrheit um ein junges Muffel handelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Muffel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce9c43b2-da76-330c-a324-4889b4b20b4a",
                                        "entry_id": "34303854-e1cc-3851-a24f-cf106c49d619",
                                        "glosses": [
                                            "kleiner Happen"
                                        ],
                                        "tags": [
                                            "Central German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cc86b91-6e92-41d5-ac9b-e6656e765114",
                                                "sense_id": "ce9c43b2-da76-330c-a324-4889b4b20b4a",
                                                "text": "„Wäje ihrm Gebiß kann die net mehr rischdisch abbeiße unn muß deshalb immer nach unn nach enn klaane Muffel verdrigge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
