                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "game_or_sport_name",
                    "examples": [
                        {
                            "text": "He decided to play the <w>KID</w> against his opponent's opening.",
                            "target_lang_translations": {
                                "ru": "Он решил разыграть <w>староиндийскую защиту</w> против дебюта соперника.",
                                "zh": "他决定用<w>古印度防御</w>来应对对手的开局。"
                            }
                        },
                        {
                            "text": "The <w>KID</w> is a popular defense among grandmasters.",
                            "target_lang_translations": {
                                "ru": "<w>Староиндийская защита</w> — популярная защита среди гроссмейстеров.",
                                "zh": "<w>古印度防御</w>是特级大师中很受欢迎的一种防守。"
                            }
