                            {
                                "example_id": "68ebae70-1306-4375-a9ce-83ddb92132fb",
                                "sense_id": "80cf92f5-8d03-351e-b4ef-fea9895eb04c",
                                "text": "Bij de opgraving vond men enige benen kammen."
                            }
                        ]
