                        "source_sense_id": "e137d97c-88f7-3676-9789-c1b83880fc92",
                        "source_sense_description": "der illegale Kauf und Verkauf von Betäubungsmitteln",
                        "target_lang_word": "narcotrafic",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "narcotrafic",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ca092e0-3607-32c3-bb7b-6e73788673bd",
                                        "entry_id": "f34a72a1-289d-3488-9f74-5e77407c71cf",
                                        "glosses": [
                                            "Trafic de drogue, trafic de stupéfiants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d39e40eb-c8fc-4cc3-bb72-f79c341603fe",
                                                "sense_id": "0ca092e0-3607-32c3-bb7b-6e73788673bd",
                                                "text": "Du trafiquant au consommateur, le narcotrafic tue. Overdoses, règlements de comptes, fusillades, enlèvements avec séquestration… Le trafic de stupéfiants draine dans son sillage des victimes toujours plus nombreuses et plus jeunes."
                                            },
                                            {
                                                "example_id": "087a7195-febc-4773-a001-1994c561c7a0",
                                                "sense_id": "0ca092e0-3607-32c3-bb7b-6e73788673bd",
                                                "text": "La récurrence des violences liées au narcotrafic met à mal Bart De Wever, qui presse le fédéral de mettre plus de moyens sur la table en matière de répression."
                                            },
                                            {
                                                "example_id": "e1410888-6516-4d60-8936-a7af1dfb61d6",
                                                "sense_id": "0ca092e0-3607-32c3-bb7b-6e73788673bd",
                                                "text": "Les présidents Castro au Honduras et Noboa en Équateur, pays en proie à la violence liée au narcotrafic, ont mis en avant l’exemple Bukele."
                                            },
                                            {
                                                "example_id": "36efe2fd-25e9-4c7a-a65e-3fde83102e1a",
                                                "sense_id": "0ca092e0-3607-32c3-bb7b-6e73788673bd",
                                                "text": "L’article 4 prévoit, à ce titre, de systématiser les enquêtes patrimoniales dans le cadre des investigations relatives au narcotrafic et, d’autre part, de créer une nouvelle procédure d’injonction pour richesse inexpliquée."
                                            },
                                            {
                                                "example_id": "86cd61de-29f9-4130-8759-ff0bdcdafb11",
                                                "sense_id": "0ca092e0-3607-32c3-bb7b-6e73788673bd",
                                                "text": "Ces insuffisances se révèlent dans l’utilisation récurrente, par des politiques, de termes erronés tels que monopole, pieuvre ou narcomafia pour évoquer le narcotrafic en France."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
