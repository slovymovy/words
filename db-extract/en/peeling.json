                                    {
                                        "sense_id": "5ffd71cd-b379-37d4-92c3-3d0b34a92956",
                                        "entry_id": "abd2a160-fcb3-3269-9c54-8de47913a166",
                                        "glosses": [
                                            "оболочка некоторых плодов, овощей, а также кожура семян"
                                        ],
                                        "tags": [],
