                "senses": [
                    {
                        "sense_id": "324b29b9-4237-3f9e-90d7-8e0d5168c4f6",
                        "entry_id": "64e27c12-70ca-3319-a0a5-56dad2e9d0cd",
                        "glosses": [
                            "system lin na żaglowcu oraz ruchomy osprzęt służący do ich obsługi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dd4c59b-23ee-4736-87fb-a943dc0ce009",
                                "sense_id": "324b29b9-4237-3f9e-90d7-8e0d5168c4f6",
                                "text": "Nawet śladu nie zostało, jarlu. Ot, kawałeczki takielunku, szmatki jakieś… Więcej nic."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "cedfb512-464d-3f47-8392-3f9b66a4ef18",
                        "entry_id": "64e27c12-70ca-3319-a0a5-56dad2e9d0cd",
                        "glosses": [
                            "wszystkie ruchome lub łatwo demontowalne przyrządy związane z napędem żaglowym"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "11828909-9178-3efa-8867-0c23c0dfd26c",
                        "entry_id": "64e27c12-70ca-3319-a0a5-56dad2e9d0cd",
                        "glosses": [
                            "wszystko powyżej linii pokładu łącznie z masztami; określa typ jednostki"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cef03eda-14e5-43c8-b403-ab588a52f8c9",
                        "source_entry_id": "64e27c12-70ca-3319-a0a5-56dad2e9d0cd",
                        "source_sense_id": "324b29b9-4237-3f9e-90d7-8e0d5168c4f6",
                        "target_lang_word": "rigging",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rigging",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57279318-5ec9-3311-b251-bbf46da4a54b",
                                        "entry_id": "9619aacd-fedd-367a-bdb5-cb4822afbb1c",
                                        "glosses": [
                                            "Dress; tackle; especially (nautical), the ropes, chains, etc., that support the masts and spars of a sailing vessel, and serve as purchases for adjusting the sails, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e53e8f71-aacc-49ec-8fa3-2f68478fadff",
                                                "sense_id": "57279318-5ec9-3311-b251-bbf46da4a54b",
                                                "text": "The moon was full and shone down on us through the masts and rigging of an old fishing wreck, which had been grounded just off the beach where we were sitting."
                                            },
                                            {
                                                "example_id": "84b540e5-e418-46e2-9e44-4d27fc06f415",
                                                "sense_id": "57279318-5ec9-3311-b251-bbf46da4a54b",
                                                "text": "For a time the apostis glowed like a forge; gradually it dimmed and went out, and our ship resumed a more conventional position, though the wind still screamed in the rigging and the clouds scudded under us like flecks of foam in a mill race."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "060a8924-f7df-3556-9900-c71256f92821",
                                        "entry_id": "9619aacd-fedd-367a-bdb5-cb4822afbb1c",
                                        "glosses": [
                                            "Similar supporting material used for construction work, or in film, theater, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f0330ba-7002-439d-84a4-306a627124f4",
                                                "sense_id": "060a8924-f7df-3556-9900-c71256f92821",
                                                "text": "[…]or even, daring, spent the night up some pole in a lineman's tent like caterpillars, swung among a web of telephone wires, living in the very copper rigging and secular miracle of communication, untroubled by the dumb voltages flickering their miles, the night long, in the thousands of unheard messages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86b32fba-8e52-32f5-83d6-2e379d39682d",
                                        "entry_id": "9619aacd-fedd-367a-bdb5-cb4822afbb1c",
                                        "glosses": [
                                            "The shiplike mechanical components and weaponry attached to a shipgirl."
                                        ],
                                        "tags": [
                                            "Japanese",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4efc6423-cb65-463a-9aa4-a941cc38dac8",
                                                "sense_id": "86b32fba-8e52-32f5-83d6-2e379d39682d",
                                                "text": "Max Factory presents a figma of Nagato Kai-II from \"Kantai Collection -KanColle-\"! Her rigging has been carefully recreated in figma form, featuring loads of articulation to create perfect poses!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rigging",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ab5e531-d613-3a2a-a81e-6ac36b41ecdf",
                                        "entry_id": "d5a40b5c-a570-3998-be80-4fbe41792dfb",
                                        "glosses": [
                                            "present participle and gerund of rig"
                                        ],
