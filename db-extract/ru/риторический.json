                        "examples": [
                            {
                                "example_id": "547153df-44f7-4215-9177-efda020e3fc4",
                                "sense_id": "b8a0d923-58f4-3f5e-8364-a0499bddc684",
                                "text": "Блестящая риторическая структура стиха (т.е. стих построен так, что он особенно красноречив.)"
