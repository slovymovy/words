                                "target_senses": [
                                    {
                                        "sense_id": "962d438f-2518-3096-b2b6-5a171cd35361",
                                        "entry_id": "5de64051-2889-3c63-8d48-49c000c502ce",
                                        "glosses": [
                                            "Personne qui souffre de paraplégie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bc6ff81-26d1-473a-bfc3-64622a30f2d1",
                                                "sense_id": "962d438f-2518-3096-b2b6-5a171cd35361",
                                                "text": "On parle de spasticité chez l’hémiplégique comme chez le paraplégique, aussi bien que dans l’infirmité motrice d’origine cérébrale, pour ne citer que les circonstances cliniques les plus fréquentes."
                                            },
                                            {
                                                "example_id": "1f260db6-b198-461f-98af-672880b528bd",
                                                "sense_id": "962d438f-2518-3096-b2b6-5a171cd35361",
                                                "text": "C’est le cas de Staff Benda Bilili, un groupe à découvrir ce soir lors de la rock n’ beat party. Il se compose de huit musiciens, cinq paraplégiques, trois valides."
                                            }
                                        ]
                                    }
                                ]
                            }
