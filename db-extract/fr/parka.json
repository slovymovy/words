        "fr-extract.jsonl": [
            {
                "entry_id": "102ac029-a005-36d9-9c14-83a20514594d",
                "word": "parka",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "30aae588-b28d-45de-9a29-390716c21466",
                        "entry_id": "102ac029-a005-36d9-9c14-83a20514594d",
                        "tags": [
                            "plural"
                        ],
                        "form": "parkas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "71005b36-5ff7-3a5f-888c-53181cb4154d",
                        "entry_id": "102ac029-a005-36d9-9c14-83a20514594d",
                        "glosses": [
                            "masculin ou féminin (l’usage hésite) Manteau court généralement matelassé, parfois fourré, en tissu imperméable et doté le plus souvent d'une capuche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3db9dd63-438a-41f0-935b-f04d2bf5b77a",
                                "sense_id": "71005b36-5ff7-3a5f-888c-53181cb4154d",
                                "text": "En 1969, l'armée française adopte la parka en remplacement de la capote."
                            },
                            {
                                "example_id": "88f12108-690f-465f-a729-c26664ef6382",
                                "sense_id": "71005b36-5ff7-3a5f-888c-53181cb4154d",
                                "text": "Sharon laissa tomber son parka sur le carrelage."
                            },
                            {
                                "example_id": "8ccf6f4c-f37e-4629-b6e9-dd838ab92ce1",
                                "sense_id": "71005b36-5ff7-3a5f-888c-53181cb4154d",
                                "text": "Il est vêtu d’une parka militaire dont la vue me rend souvent perplexe. Cet accoutrement n’est pas seulement une tenue de camouflage, l’équipement entend aussi user de l’intimidation et n’échappe pas à une fascination mortifère, un retour à la horde."
                            },
                            {
                                "example_id": "87a629fd-080c-4871-80c6-42bc9b14589c",
                                "sense_id": "71005b36-5ff7-3a5f-888c-53181cb4154d",
                                "text": "Face à cette abondance de bienveillance nous n'avons plus le choix. Le prochain rassemblement c'est promis on arrivera tous avec le survêtement, les crampons aux pieds sans oublier la parka si il pleut M. Larqué."
                            },
                            {
                                "example_id": "24e02e49-701d-451e-8326-fdb09e4676d7",
                                "sense_id": "71005b36-5ff7-3a5f-888c-53181cb4154d",
                                "text": "Alors que j'atteins Châtelet-sur-Sormonne, il commence à pleuvoir. Je m'arrête immédiatement pour enfiler ma parka et protéger mon sac à dos à l'aide d'une housse de protection."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3756f2b-d76e-3fff-9c67-5f122eb6655a",
                        "entry_id": "102ac029-a005-36d9-9c14-83a20514594d",
                        "glosses": [
                            "masculin (Québec) Manteau d’hiver long doublé à capuche elle-même rembourrée, utilisé lors de grands froids ou de séjours extérieurs prolongés en hiver."
                        ],
                        "tags": [],
                        "note": "il s’agit de l’acception générale de ce terme au Québec. La première acception décrite ci-dessus est très peu utilisée",
                        "examples": [
                            {
                                "example_id": "9ace94ff-91b6-40fc-b7fb-a0e680042c54",
                                "sense_id": "c3756f2b-d76e-3fff-9c67-5f122eb6655a",
                                "text": "L’homme était vêtu d’un parka kaki comme on en trouve seulement au pôle Nord, il buvait à grandes lampées de petits verres de grappa."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74c52886-d905-455e-b473-0df7e626dff0",
                        "source_entry_id": "102ac029-a005-36d9-9c14-83a20514594d",
                        "source_sense_id": "71005b36-5ff7-3a5f-888c-53181cb4154d",
                        "source_sense_description": "(Habillement) Manteau court généralement matelassé, parfois fourré, en tissu imperméable et doté le plus souvent d'une capuche.",
                        "target_lang_word": "parka",
