                        "cross_references": [
                            {
                                "target_word": "separateness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6fff55e3-89dc-3300-a018-b61d286ac3c7",
                                        "entry_id": "5e3a0f2e-13a3-3eae-a382-79c5f5eeeab4",
                                        "glosses": [
                                            "The property of being separate."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c272576-a056-46ad-a663-e9e4eba354de",
                                                "sense_id": "6fff55e3-89dc-3300-a018-b61d286ac3c7",
                                                "text": "In “The Liberation,” a 30‐yearold^([sic]) college teacher breaks out of the psychic loneliness of a smothering family into the redeeming sense of her separateness; she had been kept from the person she really was."
                                            },
                                            {
                                                "example_id": "01f9983a-4848-4617-a713-e02e6feff26a",
                                                "sense_id": "6fff55e3-89dc-3300-a018-b61d286ac3c7",
                                                "text": "A prideful sense of separateness prevails toward what Mrs. Moskowitz called “frenetic” Manhattan and “the hipper parts of Brooklyn.”"
                                            },
                                            {
                                                "example_id": "8b62af10-2f18-4667-8799-b1de24613c48",
                                                "sense_id": "6fff55e3-89dc-3300-a018-b61d286ac3c7",
                                                "text": "Professor Marty saw Americans retreating into “separatenesses” by choice, and he worried, with Reinhold Niebuhr, that “the chief source of man’s inhumanity to man seems to be the tribal limits of his sense of obligation to the other man.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
