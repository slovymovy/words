                ],
                "senses": [
                    {
                        "sense_id": "1f097de1-f173-3fc4-ab9b-f6b57c9a5376",
                        "entry_id": "11c8e570-6f1a-3cab-bb0b-41b9dc75b878",
                        "glosses": [
                            "The state or quality of being stern."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "59cd3455-2c1a-4360-8c71-abd573f927a5",
                                "sense_id": "1f097de1-f173-3fc4-ab9b-f6b57c9a5376",
                                "text": "There was the sternness of an old-fashioned Tour patron in his rebuke to the young Frenchman Pierre Rolland, the only one to ride away from the peloton and seize the opportunity for a lone attack before being absorbed back into the bunch, where he was received with coolness."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b833146-7d73-3ed9-950b-15894e80d6dc",
                        "entry_id": "11c8e570-6f1a-3cab-bb0b-41b9dc75b878",
                        "glosses": [
                            "The result or product of being stern."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5c85677-5386-4613-b511-6d248c39bffe",
                        "source_entry_id": "11c8e570-6f1a-3cab-bb0b-41b9dc75b878",
                        "source_sense_description": "state or quality of being stern",
                        "target_lang_word": "Strenge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Strenge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43f833d1-d0d8-38d0-ac57-8e5116a22bb4",
                                        "entry_id": "f8f8021f-86ee-3abd-9a03-dadd006d1294",
                                        "glosses": [
                                            "harte, kompromisslose Auslegung von Regeln oder Moralvorstellungen"
                                        ],
                                        "tags": [
                                            "Geisteshaltung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d32ff772-3db4-44ef-8999-98179c513453",
                                                "sense_id": "43f833d1-d0d8-38d0-ac57-8e5116a22bb4",
                                                "text": "Nie verstand sie die Strenge ihre Vaters, wenn sie ausserhalb des elterlichen Grundstücks spielen wollte."
                                            },
                                            {
                                                "example_id": "684cbaa7-6b39-4e59-a456-76b671aff81b",
                                                "sense_id": "43f833d1-d0d8-38d0-ac57-8e5116a22bb4",
                                                "text": "„Aber diese Strenge halte ich nicht lange aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9dfa5a1-1cf0-3bfd-9402-fad4ad6504da",
                                        "entry_id": "f8f8021f-86ee-3abd-9a03-dadd006d1294",
                                        "glosses": [
                                            "exakte Gestaltung ohne Schnörkel"
                                        ],
                                        "tags": [
                                            "von einem Stil"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c31cee5-0c95-4e5b-878b-061e60f4b611",
                                                "sense_id": "c9dfa5a1-1cf0-3bfd-9402-fad4ad6504da",
                                                "text": "Die brutalistische Architektur zeichnet sich durch ihre Strenge aus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4ca78439-1f94-331f-a554-977a12716746",
                                        "entry_id": "f8f8021f-86ee-3abd-9a03-dadd006d1294",
                                        "glosses": [
                                            "unangenehme Intensität"
                                        ],
                                        "tags": [
                                            "von einem Geruch oder Geschmack"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5a7deec-8b27-4e12-add9-ae49899c70f8",
                                                "sense_id": "4ca78439-1f94-331f-a554-977a12716746",
                                                "text": "An meinem ersten Tag als Tatortreiniger hielt ich die Strenge des Geruchs in der Wohnung der Toten kaum aus."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6a3ddda9-204a-35d7-8b86-8e0be0c29700",
                                        "entry_id": "f8f8021f-86ee-3abd-9a03-dadd006d1294",
                                        "glosses": [
                                            "unangenehme, harte Bedingungen"
                                        ],
                                        "tags": [
                                            "von einem Zeitabschnitt oder einer Jahreszeit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ac94171-d90c-4c83-8a0a-30dbe903a384",
                                                "sense_id": "6a3ddda9-204a-35d7-8b86-8e0be0c29700",
                                                "text": "Der Strenge des Winters hatten die Jungen der Fähe nur wenig entgegenzusetzen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b8cf4e2-721b-4d1e-b3a0-09bb802dd4e6",
                        "source_entry_id": "11c8e570-6f1a-3cab-bb0b-41b9dc75b878",
                        "source_sense_description": "state or quality of being stern",
                        "target_lang_word": "Härte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Härte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ab898e2-ffe2-36b2-93ff-5870e98ea80d",
                                        "entry_id": "ac8d724a-80f0-35ce-90be-f19abc5e88f2",
                                        "glosses": [
                                            "Qualität oder Grad der Eigenschaft, hart zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea25c512-84d9-455e-898b-0bfd2bf7d334",
                                                "sense_id": "6ab898e2-ffe2-36b2-93ff-5870e98ea80d",
                                                "text": "Stahl besitzt eine große Härte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "73ec56f5-576d-3e24-889b-d21b16aa66d5",
                                        "entry_id": "ac8d724a-80f0-35ce-90be-f19abc5e88f2",
                                        "glosses": [
                                            "Strenge"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc5fbc40-b78e-45e4-b3b1-39ea0d26e04f",
                                                "sense_id": "73ec56f5-576d-3e24-889b-d21b16aa66d5",
                                                "text": "Sie bekam die volle Härte des Gesetzes zu spüren."
                                            },
                                            {
                                                "example_id": "059673eb-501b-4dd5-8f21-d10c2871a7a1",
                                                "sense_id": "73ec56f5-576d-3e24-889b-d21b16aa66d5",
                                                "text": "„Er war vielmehr durchaus sehr beeindruckt von dem ganzen Getue um Männlichkeit und Härte.“"
                                            },
                                            {
                                                "example_id": "58231edb-a8ce-4e99-8596-8c77e440e72f",
                                                "sense_id": "73ec56f5-576d-3e24-889b-d21b16aa66d5",
                                                "text": "„Auch Licinius Crassus, Enkel des Triumvirn, bekam die Härte des Kaisers zu spüren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bf28f173-5f44-3467-ac48-90e53e4d1846",
                                        "entry_id": "ac8d724a-80f0-35ce-90be-f19abc5e88f2",
                                        "glosses": [
                                            "Stärke, Intensität, Heftigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "126f310d-9040-4b21-8a7f-4604884a219b",
                                                "sense_id": "bf28f173-5f44-3467-ac48-90e53e4d1846",
                                                "text": "Der Winter war in seiner ganzen Härte zu spüren."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b309686c-7480-3a33-8b21-43c7142bdbf8",
                                        "entry_id": "ac8d724a-80f0-35ce-90be-f19abc5e88f2",
                                        "glosses": [
                                            "Last, Schwierigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f15243ec-d06c-4500-a9c3-792f58eef601",
                                                "sense_id": "b309686c-7480-3a33-8b21-43c7142bdbf8",
                                                "text": "Nach § 574 des BGB haben Mieter einer Wohnung einen verbesserten Kündigungsschutz, falls die Kündigung wegen der Schwerbehinderung eine unzumutbare Härte bedeuten würde."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
