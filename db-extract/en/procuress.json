                        "form_id": "e2070a86-5ff8-4b7b-b3bf-06a99b0b2c79",
                        "entry_id": "692dbf96-b885-330b-ad58-e249e5a32f2a",
                        "tags": [
                            "plural"
                        ],
                        "form": "procuresses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "416472c7-d0bd-33cd-80ff-51f8fd88bff9",
                        "entry_id": "692dbf96-b885-330b-ad58-e249e5a32f2a",
                        "glosses": [
                            "A middlewoman: a woman who performs as a go-between, an intermediary."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f98557de-9b6d-39dd-ba35-677ef0cb355c",
                        "entry_id": "692dbf96-b885-330b-ad58-e249e5a32f2a",
                        "glosses": [
                            "A female procurer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0850a1e-0a3e-4d21-88a3-4a962c6a79de",
                                "sense_id": "f98557de-9b6d-39dd-ba35-677ef0cb355c",
                                "text": "The Spaniard, who will seduce any girl he can, is pitiless under like circumstances to his own womenkind; so there is much weeping, the girl is turned out of doors and falls readily into the hands of the procuress. In the brothels of Seville or of Madrid she finds at least a roof and bread to eat."
                            },
                            {
                                "example_id": "3f397b69-808f-4599-aaa8-4e50977fb16a",
                                "sense_id": "f98557de-9b6d-39dd-ba35-677ef0cb355c",
                                "text": "Old witches in the cities and country-side throve upon the sale of death spells and love philtres. They also made a trade of abortificants, and frequently practised the whiles of the procuress."
                            },
                            {
                                "example_id": "29561eb7-6406-405a-be78-a2d3092d0c52",
                                "sense_id": "f98557de-9b6d-39dd-ba35-677ef0cb355c",
                                "text": "Knox takes us through the lives of memorable seducers and their critics, in sometimes academic and sometimes rococo prose dappled with doges, coups de foudre, rakes, bawds, coquettes, coxcombs and procuresses — with guest appearances by members of the Frankfurt School sunning themselves in La Jolla."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bd38177-1967-4040-8b24-a63ca2f8477d",
                        "source_entry_id": "692dbf96-b885-330b-ad58-e249e5a32f2a",
                        "source_sense_description": "a middlewoman",
                        "target_lang_word": "koppelaarster",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "koppelaarster",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5ec4643f-8b61-37d1-89f3-71174eff23b3",
                                        "entry_id": "9a8bd608-8a36-340b-9db6-aabfa68c9cc0",
                                        "glosses": [
                                            "vrouw die een huwelijk arrangeert"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e334dd9f-dd2c-4329-ad52-c0c6c638a98b",
                                                "sense_id": "5ec4643f-8b61-37d1-89f3-71174eff23b3",
                                                "text": "Wat bent u toch een koppelaarster, ma tante."
                                            },
                                            {
                                                "example_id": "fd9b3264-7306-4d2e-8d42-981e6355b990",
                                                "sense_id": "5ec4643f-8b61-37d1-89f3-71174eff23b3",
                                                "text": "Geld voornaamste drijfveer De grote tragiek uit Bernhards leven, vindt de schrijfster, is de keuze die hij op zijn vijfentwintigste maakt. Van harte gesteund door zijn moeder, met een tante als koppelaarster weet hij een verpletterende indruk te maken op Juliana. Voor wie wanhopig een man werd gezocht."
                                            },
                                            {
                                                "example_id": "52887f84-95bc-4a01-988d-79bd0e33d66e",
                                                "sense_id": "5ec4643f-8b61-37d1-89f3-71174eff23b3",
                                                "text": "\"In de afgelopen twintig jaar is de markt voor mannen veel lastiger en competitiever geworden\", aldus professioneel koppelaarster Yoko Itamoto."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0e393c4-287e-3ec4-85c2-eaaf08022170",
                                        "entry_id": "9a8bd608-8a36-340b-9db6-aabfa68c9cc0",
                                        "glosses": [
                                            "vrouw die een bordeel houdt"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ace9f8b-2757-4afe-b330-be39e48fd8c1",
                        "source_entry_id": "692dbf96-b885-330b-ad58-e249e5a32f2a",
                        "source_sense_description": "a middlewoman",
                        "target_lang_word": "entremetteuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entremetteuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a3bd3ec-4f89-3081-90ae-7835d34c3e34",
                                        "entry_id": "bbe525ed-c8c3-3e42-aee1-bbc6e7c9aaf2",
                                        "glosses": [
                                            "Femme mettant en relation d’autres personnes qui souhaitent réaliser entre elles des opérations commerciales, une apporteuse d’affaires."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "654abe13-69d8-3c91-978c-2ab3da785254",
                                        "entry_id": "bbe525ed-c8c3-3e42-aee1-bbc6e7c9aaf2",
                                        "glosses": [
                                            "Femme qui facilite des intrigues galantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d34912b4-eaf9-40b3-9585-253956dae99a",
                                                "sense_id": "654abe13-69d8-3c91-978c-2ab3da785254",
                                                "text": "« Vous allez faire une petite place à côté de vous à M. de Forcheville. » « Dans l’obscurité ! maquerelle, entremetteuse ! ». « Entremetteuse », c’était le nom qu’il donnait aussi à la musique qui les convierait à se taire, à rêver ensemble, à se regarder, à se prendre la main."
                                            },
                                            {
                                                "example_id": "b5836f59-5971-4829-bb0b-02863466d08f",
                                                "sense_id": "654abe13-69d8-3c91-978c-2ab3da785254",
                                                "text": "Un jour pourtant, il revint tout heureux. Il avait trouvé une entremetteuse qui l’introduirait auprès de sa bien-aimée. Il se déguiserait en femme, et pénétrerait ainsi dans le harem."
                                            },
                                            {
                                                "example_id": "efd6084a-1f50-4ead-be28-4d593b618b74",
                                                "sense_id": "654abe13-69d8-3c91-978c-2ab3da785254",
                                                "text": "Entremetteuse, maquerelle, femme grivoise. La Célestine est un personnage qui appartient à la tradition de la littérature espagnole ; elle fascinait tellement Salvador Dali qu’il prétendait s’y identifier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4c5e12d-b998-4874-9cf3-c65a09932f4c",
                        "source_entry_id": "692dbf96-b885-330b-ad58-e249e5a32f2a",
                        "source_sense_description": "a middlewoman",
                        "target_lang_word": "apporteuse d'affaires",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c4e7f40b-3737-4707-af30-c24e6a7afcad",
                        "source_entry_id": "692dbf96-b885-330b-ad58-e249e5a32f2a",
                        "source_sense_description": "a middlewoman",
                        "target_lang_word": "Kupplerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kupplerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19cf10d2-ce0c-37f0-9d8c-fbb8b0d0ca97",
                                        "entry_id": "633889d8-6f2c-3292-ac88-6bac1d1c879c",
                                        "glosses": [
                                            "Herstellerin oder Vermittlerin von Kontakten zwischen Personen zwecks Heirat oder – oft bezahlter – sexueller Aktivitäten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f203904d-007b-42b2-8100-21737e696974",
                                                "sense_id": "19cf10d2-ce0c-37f0-9d8c-fbb8b0d0ca97",
                                                "text": "Sie hatte einen Ruf als Kupplerin und sorgte auf beiden Seiten für die Befriedigung der Bedürfnisse."
                                            },
                                            {
                                                "example_id": "825fff1f-6f14-4abc-99eb-e9fe97390dfe",
                                                "sense_id": "19cf10d2-ce0c-37f0-9d8c-fbb8b0d0ca97",
                                                "text": "„Seitdem er die dreißig überschritten hat, lassen ihm die Kupplerinnen keine Ruhe mehr.“"
                                            },
                                            {
                                                "example_id": "84e346cc-1c7b-4a20-9e9f-9859e932a61b",
                                                "sense_id": "19cf10d2-ce0c-37f0-9d8c-fbb8b0d0ca97",
                                                "text": "„Dafür erzählte ihm Schneeholdchen heimlich, wie in den vier Monaten seiner Abwesenheit seine Frau mit Simen Tjing in Beziehungen getreten und Jadeflöte die Kupplerin gewesen sei.“"
                                            },
                                            {
                                                "example_id": "2ab70961-26d4-4709-b3f4-2f1eed3c769a",
                                                "sense_id": "19cf10d2-ce0c-37f0-9d8c-fbb8b0d0ca97",
                                                "text": "„Da ihre Schönheit dahin war, blieb ihr nichts übrig, als Kupplerin zu werden, das war durchaus verständlich.“"
                                            },
                                            {
                                                "example_id": "25ffb70d-64ac-4e4d-adf6-a3bd35cba60b",
                                                "sense_id": "19cf10d2-ce0c-37f0-9d8c-fbb8b0d0ca97",
                                                "text": "„Die stadtbekannten Kupplerinnen erfüllten jeden Wunsch gutzahlender Klienten und schickten de Sade junge Mädchen nach Wunsch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
