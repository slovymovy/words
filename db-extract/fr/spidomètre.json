                        "examples": [
                            {
                                "example_id": "ad83223e-944d-4856-b7e9-0795ff526114",
                                "sense_id": "19c72b7d-8c47-387f-9447-edf9ba51f777",
                                "text": "Le spidomètre marquait 105."
                            },
                            {
                                "example_id": "d172e989-f375-4fbc-b48e-b0fdb4e08fda",
                                "sense_id": "19c72b7d-8c47-387f-9447-edf9ba51f777",
                                "text": "Je n'ai pas quitté des yeux le – comment appelles-tu ça, Bayard ? – le spidomètre."
                            },
                            {
                                "example_id": "e02d0646-c22a-4133-8ee2-191b1db62de2",
                                "sense_id": "19c72b7d-8c47-387f-9447-edf9ba51f777",
                                "text": "En quelques secondes l’aiguille du spidomètre avait dépassé les cent cinquante kilomètres-heure et il fut tenté de s'emparer du coupé pour regagner Paris."
                            },
                            {
                                "example_id": "9d409e3a-e769-47e5-ace9-252f1b20edbb",
                                "sense_id": "19c72b7d-8c47-387f-9447-edf9ba51f777",
                                "text": "Le reste, sauf, si l'on veut, le compas de relèvement, est à l'avenant, ou parfaitement dérisoire, comme le spidomètre (pour mesurer la vitesse), sans aucune précision, donc sans usage de loch, sans raison d'être hors de régate, et l'anémomètre, dont l'indication... dépend de l'endroit où on le place."
                            }
                        ]
                    }
