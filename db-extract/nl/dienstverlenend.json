                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac98e4ea-fe8d-48ef-8fb4-e2cd359b696f",
                                                "sense_id": "0a83bdd3-1026-3e33-8f53-e61028fbb5f6",
                                                "text": "the service"
                                            },
                                            {
                                                "example_id": "3a2623aa-e4db-4c3a-ac78-fe5e78614d3e",
                                                "sense_id": "0a83bdd3-1026-3e33-8f53-e61028fbb5f6",
