                "senses": [
                    {
                        "sense_id": "0282a29a-0d4e-33f5-8b38-8f9d2dbd7318",
                        "entry_id": "f4a6f96f-c2e4-3ebe-83de-9d8f50de2ee2",
                        "glosses": [
                            "To drive or ride on a snowmobile"
                        ],
                        "tags": [
                            "Canada",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "b4d03e35-0f89-4486-8a8e-ebf8b500d745",
                                "sense_id": "0282a29a-0d4e-33f5-8b38-8f9d2dbd7318",
                                "text": "On several evenings, after Glen had finished his work and returned to Resolute, we skidooed out to the Parcol and sat in wait for ‘Sea Biscuit’."
                            },
                            {
                                "example_id": "8448b7b0-1e1f-46aa-9401-24ccc4f43ad8",
                                "sense_id": "0282a29a-0d4e-33f5-8b38-8f9d2dbd7318",
                                "text": "Even skidooing on the farm in my younger years was not that much fun though I recall one time after a storm, I had gone skidooing and I hit some unexpected snow drifts that sent that skidoo flying into the air one minute and plummeting back down the next."
                            }
                        ]
                    }
