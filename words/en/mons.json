                    "frequency": "Low",
                    "semantic_group_id": "astronomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The massive volcano Olympus <w>mons</w> is the tallest mountain on the planet Mars.",
                            "target_lang_translations": {
                                "ru": "Массивный вулкан Олимп — это самая высокая <w>гора</w> на планете Марс."
                            }
