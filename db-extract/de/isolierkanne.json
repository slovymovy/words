                "senses": [
                    {
                        "sense_id": "fa98da58-8dbe-3cbf-80b1-03e92c7ae382",
                        "entry_id": "104b5e63-0470-3789-9884-6b58e81da32d",
                        "glosses": [
                            "mit einer Isolierschicht versehenes, verschließbares Gefäß, das die eingefüllte Flüssigkeit über längere Zeit warm oder kalt halten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1dba0f1-edad-4162-af94-3be41e07bede",
                                "sense_id": "fa98da58-8dbe-3cbf-80b1-03e92c7ae382",
                                "text": "„Für Filter-Kaffeemaschinen mit einer Isolierkanne soll der EU zufolge eine Wartezeit von fünf Minuten gelten.“"
                            },
                            {
                                "example_id": "414b124d-d57f-4b99-933c-e77fb5214983",
                                "sense_id": "fa98da58-8dbe-3cbf-80b1-03e92c7ae382",
                                "text": "„Diese muss sich seit Jahresbeginn nach einigen Minuten ausschalten, wenn sie mit einer Isolierkanne daherkommt.“"
                            },
                            {
                                "example_id": "2d534293-6f57-4f69-8e45-e3ba6ae67937",
                                "sense_id": "fa98da58-8dbe-3cbf-80b1-03e92c7ae382",
                                "text": "„Auf dem Kühlschrank steht die Isolierkanne, die sie sich vor drei Jahren gegönnt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
