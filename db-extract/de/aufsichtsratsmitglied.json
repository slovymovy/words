                "senses": [
                    {
                        "sense_id": "7e256279-1e6c-3240-b202-f0a177bd2f56",
                        "entry_id": "e4a46e23-ee37-3765-9d1b-a28dffa8e402",
                        "glosses": [
                            "Person, die Mitglied eines Aufsichtsrates ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5431f71-1eb3-43e1-b31b-9d983a6dadf7",
                                "sense_id": "7e256279-1e6c-3240-b202-f0a177bd2f56",
                                "text": "Die Aufsichtsratsmitglieder wurden vom Vorsitzenden ermahnt."
                            },
                            {
                                "example_id": "9495aa68-e4c8-4fcd-bee1-c1dcc72f6bd7",
                                "sense_id": "7e256279-1e6c-3240-b202-f0a177bd2f56",
                                "text": "„Ein Aufsichtsratsmitglied einer Aktiengesellschaft beispielsweise kann von der Hauptversammlung mit Dreiviertelmehrheit abgewählt werden.“"
                            },
                            {
                                "example_id": "727f98da-bbcb-457a-9cd2-248d9c2e51cc",
                                "sense_id": "7e256279-1e6c-3240-b202-f0a177bd2f56",
                                "text": "„Die FPÖ-Politiker Monika Forstinger und Norbert Gugerbauer wurden vom FPÖ-Infrastrukturminister als neue Aufsichtsratsmitglieder bei den ÖBB nominiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
