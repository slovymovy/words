                                        "note": "요, 조",
                                        "examples": [
                                            {
                                                "example_id": "f275248b-1bc2-4ed2-82fe-66281c4b32f3",
                                                "sense_id": "0da62400-1e43-3596-9612-928ef08a66db",
                                                "text": "고 녀석 참 귀엽게 생겼구나."
                                            },
                                            {
                                                "example_id": "a0072cb4-e815-460c-a4c1-31ccbc15dc54",
                                                "sense_id": "0da62400-1e43-3596-9612-928ef08a66db",
                                                "text": "고 어린 게 어떻게 알았을까?"
                                            },
                                            {
                                                "example_id": "4cfbbc2f-f5b3-43d2-972d-77c31fe1ace3",
                                                "sense_id": "0da62400-1e43-3596-9612-928ef08a66db",
                                                "text": "곧 갈 테니 고 근처에 가 있거라."
