                    {
                        "translation_id": "7da300ce-cbcb-451e-846e-85903d2a4a14",
                        "source_entry_id": "4a7e3a5c-6096-38ce-8855-f8477772b67c",
                        "source_sense_id": "df261c67-a44e-3704-9713-f56c0ea1bb3b",
                        "target_lang_word": "расстроенный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "расстроенный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "eb18a3a1-81e4-3731-b214-d26d67f5729b",
                                        "entry_id": "85caa0a1-c87f-31b8-b5d6-ff5a3e1cc7b6",
                                        "glosses": [
                                            "утративший правильность, четкость построения, беспорядочный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb1310f9-b795-4b83-932a-f2d6ef269b34",
                                                "sense_id": "eb18a3a1-81e4-3731-b214-d26d67f5729b",
                                                "text": "Впрочем, Ваше Императорское Величество Всемилостивейше согласиться изволите, что последствия сии нераздельно связаны с потерей Смоленска и с тем расстроенным состоянием войск, в котором я оные застал."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e732b49-ff4e-31bf-a1df-1bb22f9e4b42",
                                        "entry_id": "85caa0a1-c87f-31b8-b5d6-ff5a3e1cc7b6",
                                        "glosses": [
                                            "пришедший в упадок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "120f3eeb-e9dd-45a9-90cf-884aeaf34c06",
                                                "sense_id": "7e732b49-ff4e-31bf-a1df-1bb22f9e4b42",
                                                "text": "Дубровский с расстроенным состоянием принужден был выйти в отставку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "403edce9-5caf-359a-b545-7fe53cc34c29",
                                        "entry_id": "85caa0a1-c87f-31b8-b5d6-ff5a3e1cc7b6",
                                        "glosses": [
                                            "пришедший в ненормальное, болезненное состояние"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9291b505-77e4-47f0-b79f-a5d2955d9d99",
                                                "sense_id": "403edce9-5caf-359a-b545-7fe53cc34c29",
                                                "text": "Многие плакали, когда граф Каменский по расстроенному здоровью отказался от начальства и отправился в Петербург из Улеаборга."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a539106d-3db1-35fc-a7fc-2ddd53952b27",
                                        "entry_id": "85caa0a1-c87f-31b8-b5d6-ff5a3e1cc7b6",
                                        "glosses": [
                                            "с нарушенным музыкальным строем, ладом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9d7987b-08e0-427a-8079-1b1a1ea1817f",
                                                "sense_id": "a539106d-3db1-35fc-a7fc-2ddd53952b27",
                                                "text": "Ибо в комнате его стояло нечто вроде рояля, утлая прямострунка, до того расстроенная, что всё исполняемое на этом, с позволения сказать, инструменте казалось подобием гамелана."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebda1df8-c872-3c6d-9658-59113eb74520",
                                        "entry_id": "85caa0a1-c87f-31b8-b5d6-ff5a3e1cc7b6",
                                        "glosses": [
                                            "находящийся в расстройстве; огорчённый, опечаленный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b427159-eb46-4003-8cda-c9dcc9f4242a",
                                                "sense_id": "ebda1df8-c872-3c6d-9658-59113eb74520",
                                                "text": "Шутки отца моего над нею меня терзали. Вольдемар вышел бледный и расстроенный. Оба мы — он и я — должны быть сегодня у них в ложе."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "расстроенный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "68c14950-c22b-3042-99a0-827c6d81070c",
                                        "entry_id": "6a046617-f513-3f86-bf28-1fd2212a653e",
                                        "glosses": [
                                            "страд. прич. прош. вр. от расстроить"
                                        ],
                                        "tags": [
                                            "participle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d65d9eb5-779f-40a5-b9a8-c6fbbef55a11",
                                                "sense_id": "68c14950-c22b-3042-99a0-827c6d81070c",
                                                "text": "Получены точные аналитические выражения для параметров и комплексной частотной характеристики фильтра с расстроенной тройкой колебательных звеньев."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
