{
    "word_family": [
        "ten",
        "tenthly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0612027c-f2bf-3f1e-906e-90c4410a98eb",
                    "sense_definition": "The ordinal number coming after ninth in position or time.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ordinal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This is the <w>tenth</w> time I have visited this museum.",
                            "target_lang_translations": {
                                "ru": "Я посещаю этот музей уже в <w>десятый</w> раз.",
                                "zh": "这是我<w>第十</w>次参观这家博物馆。"
                            }
                        },
                        {
                            "text": "They are celebrating their <w>tenth</w> anniversary this weekend.",
                            "target_lang_translations": {
                                "ru": "В эти выходные они празднуют свою <w>десятую</w> годовщину.",
                                "zh": "他们这个周末要庆祝<w>十周年</w>纪念日。"
                            }
                        }
                    ],
                    "synonyms": [
                        "10th"
                    ],
                    "common_phrases": [
                        "tenth anniversary",
                        "tenth grade",
                        "tenth century"
                    ],
                    "target_lang_definitions": {
                        "ru": "Порядковое числительное, следующее за девятым по положению или времени.",
                        "zh": "在顺序或时间上排在第九之后的序数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "десятый",
                                "target_lang_sense_clarification": "порядковое числительное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "第十",
                                "target_lang_sense_clarification": "序数词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a45cee17-f3fd-36e5-b076-2b44f2811df1",
                    "sense_definition": "Constituting one of ten equal parts of a whole.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "fractional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers demanded a <w>tenth</w> share of the total profits.",
                            "target_lang_translations": {
                                "ru": "Рабочие потребовали <w>десятую</w> часть от общей прибыли.",
                                "zh": "工人们要求获得总利润的<w>十分之一</w>。"
                            }
                        },
                        {
                            "text": "A <w>tenth</w> part of the solution was added to the mixture.",
                            "target_lang_translations": {
                                "ru": "В смесь была добавлена <w>десятая</w> часть раствора.",
                                "zh": "混合物中加入了<w>十分之一</w>的溶液。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tenth part"
                    ],
                    "target_lang_definitions": {
                        "ru": "Составляющий одну из десяти равных частей целого.",
                        "zh": "构成整体十等份中的一份。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "десятый",
                                "target_lang_sense_clarification": "о доле или части"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "十分之一",
                                "target_lang_sense_clarification": "表示比例或份额"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7fdee01a-4815-3787-a600-8e49a13f5447",
                    "sense_definition": "One of ten equal parts of a whole; 1/10.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fractional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She donated one <w>tenth</w> of her salary to a local charity.",
                            "target_lang_translations": {
                                "ru": "Она пожертвовала одну <w>десятую</w> своей зарплаты местной благотворительной организации.",
                                "zh": "她把工资的<w>十分之一</w>捐给了当地的慈善机构。"
                            }
                        },
                        {
                            "text": "The runner lost the race by less than a <w>tenth</w> of a second.",
                            "target_lang_translations": {
                                "ru": "Бегун проиграл забег меньше чем на одну <w>десятую</w> секунды.",
