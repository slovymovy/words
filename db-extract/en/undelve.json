                        "glosses": [
                            "To reveal by delving; to dig up."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25a69530-b29c-4a24-85e4-9f629e0e45a7",
                                "sense_id": "6f71d340-20aa-3511-934c-9a5dd3002e4d",
                                "text": "I know were I to pierce that hide I would undelve intestine, bolus, bile, blood, paramecia — and yet the breathing animal body bears more, which now I crave."
                            },
                            {
                                "example_id": "94d2267a-a142-46f2-b5fb-aa7d11416c33",
                                "sense_id": "6f71d340-20aa-3511-934c-9a5dd3002e4d",
                                "text": "While undelving the conditions of the possibility of knowledge, rooted in the subjective cognitive apparatus (this critique is called 'transcendental'), he makes clear reason is not equipped to probe behind the surface of the mirror and face the transcendent, the Hintenwelt out of reach."
                            }
                        ]
                    }
