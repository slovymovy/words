                "senses": [
                    {
                        "sense_id": "b58d3a81-5563-36cb-bcf7-80dc43067f9b",
                        "entry_id": "3bdf19da-f1d0-365e-b864-ea245df37e27",
                        "glosses": [
                            "Religieuse exerçant une haute position dans un monastère, sous la direction de l’abbesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1bad94a-a5d2-44fa-9eef-dc804d280b94",
                                "sense_id": "b58d3a81-5563-36cb-bcf7-80dc43067f9b",
                                "text": "A la prévôte, la véritable directrice du chapitre des chanoinesses, appartenait le droit de convoquer le chapitre ; elle y présidait et y faisait les propositions, à l’exclusion de l’abbesse. Les plus anciennes prévôtes connues sont Mathilde, citée en 1096 et en 1126 ; Gerberge, citée en 1155 ; une seconde Mathilde, qui vivait en 1189, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac3560d2-1906-359c-8c5e-3106e65802c0",
                        "entry_id": "3bdf19da-f1d0-365e-b864-ea245df37e27",
                        "glosses": [
                            "Directrice d’un centre de formation des apprentis (CFA) chez les compagnons du devoir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61b7211c-4e46-4c98-8054-f0da1e866691",
                                "sense_id": "ac3560d2-1906-359c-8c5e-3106e65802c0",
                                "text": "Tarn : une prévôte de 23 ans à la tête de la Maison des Compagnons du Devoir à Albi"
                            }
                        ]
                    },
                    {
                        "sense_id": "f67c2aab-deb9-30fe-8018-f01d62b8103c",
                        "entry_id": "3bdf19da-f1d0-365e-b864-ea245df37e27",
                        "glosses": [
                            "Épouse d’un prévôt."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a51a131b-3379-495b-8ffa-bdf49c88b34e",
                                "sense_id": "f67c2aab-deb9-30fe-8018-f01d62b8103c",
                                "text": "Après la mort prématurée de Jean Fréart, il eut pour successeur Claude Barbe, seigneur de la Forterie qui, avant 163à, devint conseiller du roi, trésorier-général des finances de la généralité de Tours et fut remplacé dans la prévôté par Daniel Nepveu, le contemporain de Scarron, qui a prononcé son nom dans son livre et dont la femme « madame la prévôte » fut enterrée en l’église des Pères Cordeliers le 28 juin 1658."
                            }
                        ]
                    }
