        "fr-extract.jsonl": [
            {
                "entry_id": "8b4d7521-bfaa-3b3f-befd-c83bdb662201",
                "word": "judicieusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "83877409-f645-3968-bd18-96a950de2397",
                        "entry_id": "8b4d7521-bfaa-3b3f-befd-c83bdb662201",
                        "glosses": [
                            "D’une manière judicieuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3d8370b-e189-408b-937d-472775991c3a",
                                "sense_id": "83877409-f645-3968-bd18-96a950de2397",
                                "text": "Gérez très judicieusement votre temps."
                            },
                            {
                                "example_id": "f618f7c3-cb94-4e28-951c-86fc2d3e43f8",
                                "sense_id": "83877409-f645-3968-bd18-96a950de2397",
                                "text": "Que si la loi générale qu’on fit alors [faire une notice sur chaque académicien aussitôt après sa mort] eût été depuis aussi exactement observée qu’elle était judicieusement établie, je ne serais guère en peine pour vous parler des académiciens morts."
                            },
                            {
                                "example_id": "617c78f5-f376-469a-9d45-2deaff978094",
                                "sense_id": "83877409-f645-3968-bd18-96a950de2397",
                                "text": "Prenez le temps de réfléchir et de calculer judicieusement votre plan d’attaque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aba7d989-284b-46a9-aa9a-e458c95ede2a",
                        "source_entry_id": "8b4d7521-bfaa-3b3f-befd-c83bdb662201",
                        "source_sense_id": "83877409-f645-3968-bd18-96a950de2397",
                        "source_sense_description": "D’une manière judicieuse.",
                        "target_lang_word": "vernünftig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vernünftig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8abc57c5-89be-3e1b-b8eb-04b0b48f7940",
                                        "entry_id": "3657ab15-a295-365b-a004-22c98314100b",
                                        "glosses": [
                                            "seinen Verstand (die Vernunft) gebrauchend, statt sich von Emotionen leiten zu lassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86c545bc-46a2-4179-bc6b-173c08029f77",
                                                "sense_id": "8abc57c5-89be-3e1b-b8eb-04b0b48f7940",
                                                "text": "Hierbei bedarf es vernünftigen Handelns."
                                            },
                                            {
                                                "example_id": "81fba33e-1d5d-47be-8adc-f95f5a6433f0",
                                                "sense_id": "8abc57c5-89be-3e1b-b8eb-04b0b48f7940",
                                                "text": "„Die Deutschen verursachen fünfmal so viel CO2, wie es für das Klima vernünftig wäre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9d168e59-c50b-3695-9c4c-825db2eae303",
                                        "entry_id": "3657ab15-a295-365b-a004-22c98314100b",
                                        "glosses": [
                                            "gut oder angemessen handelnd, einsichtig sein und somit die Konsequenzen einer Handlung beachtend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cb937c2-4445-4e4e-9674-551a2a6f5464",
                                                "sense_id": "9d168e59-c50b-3695-9c4c-825db2eae303",
                                                "text": "Das ist eine vernünftige Entscheidung."
                                            },
                                            {
                                                "example_id": "b9681ab4-6e33-4b59-b1a2-b990e9545bbc",
                                                "sense_id": "9d168e59-c50b-3695-9c4c-825db2eae303",
                                                "text": "Sei doch vernünftig!"
                                            },
                                            {
                                                "example_id": "f4e72936-a9fd-4d38-8a0c-4ad17c06f0e6",
                                                "sense_id": "9d168e59-c50b-3695-9c4c-825db2eae303",
                                                "text": "Alleine ist er immer so vernünftig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2c679198-3f77-3ab1-9a96-ea79f5ca50da",
                                        "entry_id": "3657ab15-a295-365b-a004-22c98314100b",
                                        "glosses": [
                                            "gut, vollwertig"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31059b42-492d-4fed-b17f-9b24a4d86ef0",
                                                "sense_id": "2c679198-3f77-3ab1-9a96-ea79f5ca50da",
                                                "text": "Jetzt brauche ich ein vernünftiges Frühstück!"
                                            },
                                            {
                                                "example_id": "65e00e56-2619-4c34-8f86-c69620d78cc3",
                                                "sense_id": "2c679198-3f77-3ab1-9a96-ea79f5ca50da",
                                                "text": "Endlich gibt es wieder was Vernünftiges zu essen!"
                                            },
                                            {
                                                "example_id": "f108c0d6-4806-4930-8f21-01d85765df52",
                                                "sense_id": "2c679198-3f77-3ab1-9a96-ea79f5ca50da",
                                                "text": "Gibt es nichts Vernünftiges im Fernsehen?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
