                                "target_senses": [
                                    {
                                        "sense_id": "8ac0b1d4-c096-3e2a-8de0-f1f343418b23",
                                        "entry_id": "c48f4d53-1bc2-37ba-8595-1ff28e0cafbf",
                                        "glosses": [
                                            "A substance that does not transmit heat (thermal insulator), sound (acoustic insulator) or electricity (electrical insulator)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f1392a7-13be-38d8-a28a-76f98064306a",
                                        "entry_id": "c48f4d53-1bc2-37ba-8595-1ff28e0cafbf",
                                        "glosses": [
                                            "A non-conductive structure, coating or device that does not transmit sound, heat or electricity (see image)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c5076e8-2e12-43e4-b258-71453b5b338b",
                                                "sense_id": "2f1392a7-13be-38d8-a28a-76f98064306a",
                                                "text": "To isolate electrical wires from the pylons supporting them, one often uses glass insulators."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84ae2cda-ebb2-322b-86fe-9eaf2c6edbf2",
                                        "entry_id": "c48f4d53-1bc2-37ba-8595-1ff28e0cafbf",
                                        "glosses": [
                                            "A person who installs insulation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b20a1299-e402-4cb9-9797-3ad0d79b6b24",
                                                "sense_id": "84ae2cda-ebb2-322b-86fe-9eaf2c6edbf2",
                                                "text": "Alan Vasen worked as an insulator at this site from September 1968 through mid-April 1969. Mr. Vasen installed thousands of lineal feet of asbestos pipe covering and thousands of square feet of asbestos block insulation throughout the operating units of the Benicia refinery."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
