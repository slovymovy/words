                "senses": [
                    {
                        "sense_id": "2c19bdbd-9fa8-385e-b12b-020ea021b094",
                        "entry_id": "43f90246-eb9c-3009-83ad-de329ec46e4b",
                        "glosses": [
                            "Gesamtheit dessen, wovon sich ein Tier (seltener eine Person) ernährt/ernähren kann"
                        ],
                        "tags": [
                            "meist im Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "58bb3265-a849-44de-b1f3-a6ab32cb9e9c",
                                "sense_id": "2c19bdbd-9fa8-385e-b12b-020ea021b094",
                                "text": "„Durchaus vielgestaltig, wussten die Pterosaurier ein breites Nahrungsspektrum zu nutzen: Sie ernährten sich von Fleisch oder Pflanzen, fingen Insekten oder Fische, und manche filterten sogar – ähnlich wie Flamingos – winzige Beutetiere aus dem Wasser.“"
                            },
                            {
                                "example_id": "6049eaa1-178d-4bff-b528-a34e7905fa6d",
                                "sense_id": "2c19bdbd-9fa8-385e-b12b-020ea021b094",
                                "text": "„[…] Unsere Vorfahren verkrafteten trockene Zeiten mit harter Vegetation, indem sie häufiger Fleisch konsumierten. […] Die Überraschung lieferte Australopithecus africanus, weil er ein besonders breites Nahrungsspektrum aus Fleisch, Blättern und Früchten von Gehölzen zu sich nahm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
