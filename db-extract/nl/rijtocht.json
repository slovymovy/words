                        "examples": [
                            {
                                "example_id": "dc3b9fde-1852-4e41-88f4-6e9d6c2f1d46",
                                "sense_id": "651de25f-1f12-3ca4-a567-e01ba30eef27",
                                "text": "Ook de moeder van Thijs vindt het jammer dat de intocht op deze manier gevierd wordt. „Ze zijn nog tot 2013 met de wegen bezig in Nijverdal, dus ik denk dat we nog wel een paar jaar moeten wachten voor de rijtocht terugkomt.” Thijs maakt het allemaal niet zo veel uit, hij vindt het alleen maar geweldig dat Sinterklaas weer in Nederland is."
                            },
                            {
                                "example_id": "092eb7ef-5955-4916-a6f6-76e30bd9b5d8",
                                "sense_id": "651de25f-1f12-3ca4-a567-e01ba30eef27",
                                "text": "De bruid droeg een witte bruidsjurk met veel kant en een 4 meter lange sleep. In haar in een knoop gebonden haren droeg ze een tiara. Roxxette-zangeres Marie Frederiksson zong voor het paar een voor de trouwerij geschreven lied. Daarna werd het paar tijdens een rijtocht in een open koets door het centrum van Stockholm door ruim 100.000 mensen toegejuicht."
                            },
                            {
                                "example_id": "0ed36b8a-1aee-4683-a6a8-edb0737f36c9",
                                "sense_id": "651de25f-1f12-3ca4-a567-e01ba30eef27",
                                "text": "De gevaarlijke rijtocht vond plaats rond de Hogeluchtsweg. De auto liep flinke schade op en de automobilist is naar het ziekenhuis gebracht."
                            }
                        ]
                    }
