                "senses": [
                    {
                        "sense_id": "98871485-62c9-3064-9f7b-95a35a2e0d1d",
                        "entry_id": "f77f7c97-82bc-3310-b364-fbbe63c9b711",
                        "glosses": [
                            "Dialecte minnan, parlé dans la région de Chaoshan, à l'extrême est de la province de Guangdong en Chine."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b28b2e7-36e5-48bf-bbad-fdeb25bbf905",
                        "source_entry_id": "f77f7c97-82bc-3310-b364-fbbe63c9b711",
                        "source_sense_id": "98871485-62c9-3064-9f7b-95a35a2e0d1d",
                        "target_lang_word": "Teochew",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teochew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c2582bf-4d11-395c-8215-ec006e45115a",
                                        "entry_id": "c47f442f-9b92-3b4a-b09c-1ee44e6d8d56",
                                        "glosses": [
                                            "A variety of Southern Min Chinese, spoken in the Chaoshan region of eastern Guangdong and its diaspora."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cce5860-a278-4c4e-a9b8-d015d387d64c",
                                                "sense_id": "0c2582bf-4d11-395c-8215-ec006e45115a",
                                                "text": "[…] Lim Peng Siang, Low Kim Pong, Teo Sian Keng and Lee Choon Guan were leaders of Fukien dialect group; Lam Kim Seng, Chua Tse Yong were Teochew leaders; Loke Yew and Lam Wai Fong were Cantonese leaders."
                                            },
                                            {
                                                "example_id": "d67fd1c3-8c77-4dfe-94b6-dbe3c2c1fb54",
                                                "sense_id": "0c2582bf-4d11-395c-8215-ec006e45115a",
                                                "text": "'I do not speak English,' the young man said sanguinely in Malay, then said it again in Teochew, to test the white man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "971a52ff-5845-33d2-b015-1d4205a099f5",
                                        "entry_id": "c47f442f-9b92-3b4a-b09c-1ee44e6d8d56",
                                        "glosses": [
                                            "A city in the eastern part of China's Guangdong province, now more commonly called Chaozhou."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b874e95f-8b9f-4118-8459-eb07134cdf08",
                                                "sense_id": "971a52ff-5845-33d2-b015-1d4205a099f5",
                                                "text": "Fong Kai is a well known porcelain-producing center in eastern Kwangtung. It is only 8 li away from Teochow (Chaochow), and easily accessible."
                                            },
                                            {
                                                "example_id": "fc46ac80-eae1-4b73-9427-ca29f8867695",
                                                "sense_id": "971a52ff-5845-33d2-b015-1d4205a099f5",
                                                "text": "As mentioned previously (in Chapter II), the Huang Kang Uprising in Teochew (also known as the first Teochew Uprising) had been fermenting long before the formation of the T'ung Meng Hui."
                                            },
                                            {
                                                "example_id": "e1741d00-eb43-4330-8ecb-3d1c02aef305",
                                                "sense_id": "971a52ff-5845-33d2-b015-1d4205a099f5",
                                                "text": "\"I miss my family in Teochew. […] Returning to Teochew now is also not an option […]\""
                                            },
                                            {
                                                "example_id": "142652a8-a85e-46d4-b6fe-7ba58f8bcf34",
                                                "sense_id": "971a52ff-5845-33d2-b015-1d4205a099f5",
                                                "text": "It has been said that this dish was created by the court house chefs when the secretaries of the various civil departments in Teochew City did not want their officials to look uncivilised eating chicken with bones at formal events."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c57338f-60b9-3705-a808-0cc5e8810bb0",
                                        "entry_id": "c47f442f-9b92-3b4a-b09c-1ee44e6d8d56",
                                        "glosses": [
                                            "The Chaoshan region where Teochew is spoken."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d25a5cd2-12d3-4247-9893-93b7d1b507cb",
                                                "sense_id": "2c57338f-60b9-3705-a808-0cc5e8810bb0",
                                                "text": "In Fukien and the Teochew region of eastern Kwangtung there are places where every man in every village within a radius of twenty miles or more bears the same surname, the clan being virtually a small nation with its own territory."
                                            },
                                            {
                                                "example_id": "a27411dc-919d-4be0-ae4a-878c0d8c54fc",
                                                "sense_id": "2c57338f-60b9-3705-a808-0cc5e8810bb0",
                                                "text": "When they later moved down south to the Teochew region, their language developed into the Teochew dialect, whose tone is very similar to Minnan Huà."
                                            },
                                            {
                                                "example_id": "6438215c-9e96-47fb-98e7-434298fe8cb7",
                                                "sense_id": "2c57338f-60b9-3705-a808-0cc5e8810bb0",
                                                "text": "Mr and Mrs Chen were from the same town in the Chaoshan (Teochew) Region and spoke the same variety of Teochew dialect."
                                            },
                                            {
                                                "example_id": "7e71cbc7-dbaf-4cd7-a1ac-851b01d17c1c",
                                                "sense_id": "2c57338f-60b9-3705-a808-0cc5e8810bb0",
                                                "text": "Changlim in the Chaozhou (Teochew) region emerged as Amoy's rival for domination of the coastal trade."
                                            },
                                            {
                                                "example_id": "4faf17db-1b46-4d52-9a9a-4eb7efdf8331",
                                                "sense_id": "2c57338f-60b9-3705-a808-0cc5e8810bb0",
                                                "text": "While some Teochews came to Singapore from Dapo (also Dabu, or Hakka district), language differences led to Dapo being separated from the Teochew region, leaving only eight districts, although after the 19th century, the Chinese government further divided the 8 districts into 11."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Teochew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf6849b9-18d7-35e1-8296-28f7b7814f74",
                                        "entry_id": "a82b3522-3c99-3d6e-a4aa-249224b6f463",
                                        "glosses": [
                                            "A person of Chaoshan heritage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8434f3a5-8b87-461e-90d7-c03c0ad405ab",
                                                "sense_id": "cf6849b9-18d7-35e1-8296-28f7b7814f74",
                                                "text": "The founding of the Four Seas Communications Bank by the leading Teochew merchants in 1907 marked the heyday of Teochew economic strength. However, the inter-war years was a period of economic regression for the Teochews."
                                            },
                                            {
                                                "example_id": "bbfc8ead-82b1-4a39-8f19-59c64015511e",
                                                "sense_id": "cf6849b9-18d7-35e1-8296-28f7b7814f74",
                                                "text": "\"Yes! You are Teochew. Aiyah, don't you know, our people are known for being pirates, smugglers, and greate businessmen. [The Hong Kong billionaire] Li Ka-shing is Teochew, you know!\""
                                            },
                                            {
                                                "example_id": "54b108e3-84e6-4110-9d84-6df81c6c9a3d",
                                                "sense_id": "cf6849b9-18d7-35e1-8296-28f7b7814f74",
                                                "text": "However, the majority of Singaporean Teochews speak the Swatow (named after the main Teochew city in southeast China) variety."
                                            },
                                            {
                                                "example_id": "eec3506c-85dd-45a7-b8c1-52714795985f",
                                                "sense_id": "cf6849b9-18d7-35e1-8296-28f7b7814f74",
                                                "text": "They were followed by the Teochews, who arrived poor and dispossessed, but soon used their entrepreneurial skills in Bangkok to build their wealth."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Teochew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3140904a-1438-3f49-b4f0-c104834da0ae",
                                        "entry_id": "5bdff1c3-5607-357f-919b-87da2858abe7",
                                        "glosses": [
                                            "Relating to the Chaoshan region of China or its people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b7b6502-4ba9-4cfb-9c8f-09606ee4cd5f",
                                                "sense_id": "3140904a-1438-3f49-b4f0-c104834da0ae",
                                                "text": "[…] when Rev. Guthrie Gamble started the first company in the southern Chinese Teochew city of Swatow […]"
                                            },
                                            {
                                                "example_id": "80e042db-ce22-4f71-b32a-dad8f0e7a2f0",
                                                "sense_id": "3140904a-1438-3f49-b4f0-c104834da0ae",
                                                "text": "My grandfather, Mr Kua Kim Par, left the Teochew city of Chaozhou circa 1896 because of the political turmoil in China with the decline of the Qing Dynasty."
                                            },
                                            {
                                                "example_id": "16405d77-4cda-4569-9a05-382850ff5c16",
                                                "sense_id": "3140904a-1438-3f49-b4f0-c104834da0ae",
                                                "text": "Liang: So where do most members of your Jiazu live?\nChen: Chaozhou (Teochew city). Two thirds of the population live in Chaozhou. Err...three fourths, actually, because only my father, his brother and the sons of some relatives have left (Chaozhou) to work elsewhere."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
