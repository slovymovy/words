                        ],
                        "form": "die Arkaden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "92d8053a-477a-3e1a-bdb0-39866091e364",
                        "entry_id": "7c6e44d9-214a-313a-a1bc-397f8c4fe951",
                        "glosses": [
                            "ein Bogen, der von Säulen oder Pfeilern gestützt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c60c0ba8-fb97-4e10-a2ee-058e8fe93f14",
                                "sense_id": "92d8053a-477a-3e1a-bdb0-39866091e364",
                                "text": "„Die mittlere Arkade wurde nach französischer Art als Durchgang durch die gewöhnlich geschlossene Tür zum Klerikerchor verwendet.“"
                            },
                            {
                                "example_id": "5c4fab57-bac2-4ab4-8508-bcbf215cb391",
                                "sense_id": "92d8053a-477a-3e1a-bdb0-39866091e364",
                                "text": "„Unter einer Arkade stand eine sehr müde alte Frau und bot ein paar Wiesenblumen zum Verkauf an.“"
                            },
                            {
                                "example_id": "c1c50ea2-c27f-48ce-8ece-8d740e81fe07",
                                "sense_id": "92d8053a-477a-3e1a-bdb0-39866091e364",
                                "text": "„Ich wandte mich ab; er folgte mir und bat mich, ich möge doch in die gegenüberliegende Arkade gehen, dort würde er seine Maske abnehmen.“"
                            },
                            {
                                "example_id": "d97d9e87-ce9c-47ba-b94c-dce24b5877bf",
                                "sense_id": "92d8053a-477a-3e1a-bdb0-39866091e364",
                                "text": "„Sie gingen durch die Arkaden des Palais.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "934a3f3d-8110-3b0f-a6a8-cd4428183e1a",
                        "entry_id": "7c6e44d9-214a-313a-a1bc-397f8c4fe951",
                        "glosses": [
                            "eine Reihe von Bogen, die von Säulen und Pfeilern gestützt werden und unter denen man geschützt herlaufen kann"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "b15ee18f-e314-4fae-b1bc-cfa10ee1987d",
                                "sense_id": "934a3f3d-8110-3b0f-a6a8-cd4428183e1a",
                                "text": "Wir machen unter den Arkaden einen Einkaufsbummel."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
