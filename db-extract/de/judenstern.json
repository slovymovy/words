                                        "glosses": [
                                            "A cloth patch that Jews were ordered to sew on their outer garments to mark them as Jews in public, especially in Nazi-controlled states during the 1930s and 1940s."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbd4c43f-eba4-4248-bdbd-461313323575",
                                                "sense_id": "9b240654-150c-360a-8865-60ed6f449ed4",
                                                "text": "He might make us, like the Jews, wear yellow badges […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
