                "senses": [
                    {
                        "sense_id": "1fd6593b-1f00-3e57-9b71-d418013026bc",
                        "entry_id": "7ece5b8c-1514-3c8d-8a62-d89d6f7a37b9",
                        "glosses": [
                            "To add up incorrectly, arriving at a total that is too large."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3b288cf-a80a-495b-a479-bf6bbe592025",
                                "sense_id": "1fd6593b-1f00-3e57-9b71-d418013026bc",
                                "text": "In an account in the ledger, which has been ruled off as square, it is found that the credit side has been oversummed by £ 100."
                            },
                            {
                                "example_id": "1dc01d40-2259-4b72-9a8b-f0d6e57f7f92",
                                "sense_id": "1fd6593b-1f00-3e57-9b71-d418013026bc",
                                "text": "and in measure your measure you always oversum — and now I have now come to tell you that this is the last time that I shall never call again and you only want"
                            },
                            {
                                "example_id": "fe21fe91-281c-418f-835d-5a6e5c242f51",
                                "sense_id": "1fd6593b-1f00-3e57-9b71-d418013026bc",
                                "text": "Sometimes the totals are found to be short of the amounts entered in the Cash Book. In other cases, the sheets are found to be systematically oversummed; while again \"dummy\" mon may be inserted, or the calculations of the details of the pay may be overstated."
                            }
                        ]
                    }
