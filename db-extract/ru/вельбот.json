                        "cross_references": [
                            {
                                "target_word": "whaleboat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bdb9c130-d8ec-3967-9133-bb8a5df1fe8c",
                                        "entry_id": "5b0b764c-c24c-314c-8d4c-57facf86021a",
                                        "glosses": [
                                            "A long narrow rowing boat, formerly used in whaling, which is pointed at both ends so that it can move either forwards or backwards equally well."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "961acc9b-b991-4008-8533-2c1d37ab6912",
                                                "sense_id": "bdb9c130-d8ec-3967-9133-bb8a5df1fe8c",
                                                "text": "Before we had gone fifty yards we perceived that all hopes of getting further up the stream in the whale-boat were at an end, for not two hundred yards above where we had stopped were a succession of shallows and mudbanks, with not six inches of water over them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31ae7220-1f4f-3ad4-967f-d16be1fd56ba",
                                        "entry_id": "5b0b764c-c24c-314c-8d4c-57facf86021a",
                                        "glosses": [
                                            "A boat resembling this and carried on a warship or other ship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
