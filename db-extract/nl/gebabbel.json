        "nl-extract.jsonl": [
            {
                "entry_id": "864f824a-7008-3bff-bfca-71f1711bc40e",
                "word": "gebabbel",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "aa7fcb24-9dde-3ca8-b408-da443b9857c7",
                        "entry_id": "864f824a-7008-3bff-bfca-71f1711bc40e",
                        "glosses": [
                            "het praten over onbeduidende onderwerpen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6bffe25-56ab-4294-a09f-c8ad6b213044",
                                "sense_id": "aa7fcb24-9dde-3ca8-b408-da443b9857c7",
                                "text": "Het gezellige gebabbel van de kinderen op de achtergrond was zeer rustgevend."
                            },
                            {
                                "example_id": "55ab5181-6ede-4a59-a982-97c20f0fd5b4",
                                "sense_id": "aa7fcb24-9dde-3ca8-b408-da443b9857c7",
                                "text": "Ik ging in een hoekje zitten, uit de tocht, en keek naar de druppels die van mijn haarpunten gleden, terwijl ik verlangde naar onze warme haard en het gebabbel van mijn zuster."
                            }
                        ]
                    },
                    {
                        "sense_id": "b975e58b-d108-3408-8546-ecd8141fdaee",
                        "entry_id": "864f824a-7008-3bff-bfca-71f1711bc40e",
                        "glosses": [
                            "ongunstig over iemand praten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc927730-a4b8-4c1d-b59e-e438779a13f4",
                                "sense_id": "b975e58b-d108-3408-8546-ecd8141fdaee",
                                "text": "Het gebabbel over de buurvrouw die bij haar man was weggelopen was na enkele dagen weer voorbij, al snel had men weer een nieuw onderwerp om over te roddelen."
                            }
                        ]
                    }
                ],
