                ],
                "senses": [
                    {
                        "sense_id": "b88fd005-ce8b-37d0-8c8b-edb9c7e572ca",
                        "entry_id": "9fbf72f7-4b1f-3959-bc6f-1c3095456e0f",
                        "glosses": [
                            "Action de rembarquer, de se rembarquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23881c26-b64d-4b85-8ecd-463ec3bf55b2",
                                "sense_id": "b88fd005-ce8b-37d0-8c8b-edb9c7e572ca",
                                "text": "Toutes les polices, demandées pour le rembarquement de marchandises existantes dans les magasins d'entrepôt, paieront 2 piastres pour droit."
                            },
                            {
                                "example_id": "92262094-20ad-41fd-8c91-ac84e56b2069",
                                "sense_id": "b88fd005-ce8b-37d0-8c8b-edb9c7e572ca",
                                "text": "Un rembarquement des troupes de débarquement n’est possible que si la flotte de guerre possède suffisamment le commandement de la mer pour protéger efficacement le transport des troupes au delà de la mer."
                            },
                            {
                                "example_id": "a27dd4ed-8303-4a30-b128-dc6275d15d6c",
                                "sense_id": "b88fd005-ce8b-37d0-8c8b-edb9c7e572ca",
                                "text": "Ce lundi a lieu le débarquement d’une première partie de la force, puis mardi d’une seconde partie et le 17, se déroulera le rembarquement de la totalité de la force."
                            }
                        ]
                    }
                ],
