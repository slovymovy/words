                    "sense_definition": "To exist or be present; there is.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "dialectal_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Got</w> any milk left in the fridge?",
