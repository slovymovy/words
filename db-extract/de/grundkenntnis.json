                "senses": [
                    {
                        "sense_id": "fc0d8491-96ef-3d41-b90e-21948c29d03d",
                        "entry_id": "704004b5-868d-3c04-b7b5-2e408cd59d77",
                        "glosses": [
                            "grundlegendes Wissen über ein Thema"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "914eff44-008c-4f0c-ab85-352e6efb40bc",
                                "sense_id": "fc0d8491-96ef-3d41-b90e-21948c29d03d",
                                "text": "Der Bewerber hat Grundkenntnisse in vielen Gebieten."
                            },
                            {
                                "example_id": "4a925a7d-7ba6-4716-bb72-a009818b5021",
                                "sense_id": "fc0d8491-96ef-3d41-b90e-21948c29d03d",
                                "text": "„Vielleicht dient die kurze Rede Kants, die Grundkenntnisse in Rhetorik verrät, nur dem einzigen Zweck, den verwundeten Soldaten Lampe aufzurichten für die zweite Angriffswelle.“"
                            },
                            {
                                "example_id": "6c5b2451-edda-41b1-b117-691a0e717781",
                                "sense_id": "fc0d8491-96ef-3d41-b90e-21948c29d03d",
                                "text": "„Die kenntnisreichsten Mineralforscher des Erzgebirges wären schon über unsere schulischen Grundkenntnisse in Chemie und Physik, die es als naturwissenschaftliche Disziplinen zu ihrer Zeit noch gar nicht gab, erstaunt gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
