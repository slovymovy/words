                "senses": [
                    {
                        "sense_id": "dab28bfd-bdec-36b1-a041-a8cc303aad8f",
                        "entry_id": "6ce11c07-b0e3-3c0f-846b-009288a0ea62",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d890a54a-02b2-4b82-9d01-641da6326868",
                                "sense_id": "dab28bfd-bdec-36b1-a041-a8cc303aad8f",
                                "text": "Frau Hegle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a7783edc-0934-491f-bd1d-19843588d9bf",
                                "sense_id": "dab28bfd-bdec-36b1-a041-a8cc303aad8f",
                                "text": "Herr Hegle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "923fe5df-b562-4253-9fd0-0037cd23cf4c",
                                "sense_id": "dab28bfd-bdec-36b1-a041-a8cc303aad8f",
                                "text": "Die Hegles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "7213ec72-8301-40a0-a971-f59f8e5696d9",
                                "sense_id": "dab28bfd-bdec-36b1-a041-a8cc303aad8f",
                                "text": "Der Hegle trägt nie die Pullover, die die Hegle ihm strickt."
                            },
                            {
                                "example_id": "f6d8cc8d-7db2-4c97-b505-f59addfae812",
                                "sense_id": "dab28bfd-bdec-36b1-a041-a8cc303aad8f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hegle kommt, geht der Herr Hegle.“"
                            },
                            {
                                "example_id": "e4d5641d-7b22-499a-98ec-e0fbd9f6576b",
                                "sense_id": "dab28bfd-bdec-36b1-a041-a8cc303aad8f",
                                "text": "Hegle kommt und geht."
                            },
                            {
                                "example_id": "a124cda0-2e54-4ffa-a1f4-6dbbb5244453",
                                "sense_id": "dab28bfd-bdec-36b1-a041-a8cc303aad8f",
                                "text": "Hegles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
