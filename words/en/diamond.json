{
    "word_family": [
        "diamantine"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bc5df1ea-12c4-3c49-bf61-1c1a9b94ffb6",
                    "sense_definition": "A very hard, transparent precious stone made of pure carbon, often used in jewelry.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gem_mineral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wears a beautiful <w>diamond</w> on her finger.",
                            "target_lang_translations": {
                                "ru": "Она носит красивый <w>бриллиант</w> на пальце.",
                                "zh": "她的手指上戴着一颗漂亮的<w>钻石</w>。"
                            }
                        },
                        {
                            "text": "The dozen loose <w>diamonds</w> sparkled in the light.",
                            "target_lang_translations": {
                                "ru": "Дюжина незакрепленных <w>бриллиантов</w> сверкала на свету.",
                                "zh": "那十几颗散落的<w>钻石</w>在光线下闪闪发光。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sparkler",
                        "gem",
                        "gemstone"
                    ],
                    "common_phrases": [
                        "diamond ring",
                        "rough diamond",
                        "diamond necklace",
                        "diamond mine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Драгоценный камень из чистого углерода, самый твердый из известных минералов.",
                        "zh": "一种由纯碳构成的极硬、透明的珍贵宝石，常用于珠宝制作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бриллиант",
                                "target_lang_sense_clarification": "ограненный камень, используемый в украшениях"
                            },
                            {
                                "target_lang_word": "алмаз",
                                "target_lang_sense_clarification": "минерал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钻石",
                                "target_lang_sense_clarification": "用于珠宝的宝石"
                            },
                            {
                                "target_lang_word": "金刚石",
                                "target_lang_sense_clarification": "矿物学名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a263c3e9-552a-34d5-8fa6-1ee76ace60c9",
                    "sense_definition": "A figure with four straight sides of equal length forming two acute and two obtuse angles; a rhombus.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pattern on the sweater consists of red and blue <w>diamonds</w>.",
                            "target_lang_translations": {
                                "ru": "Узор на свитере состоит из красных и синих <w>ромбов</w>.",
                                "zh": "毛衣上的图案由红色和蓝色的<w>菱形</w>组成。"
                            }
                        },
                        {
                            "text": "I can see the <w>diamonds</w> on the snake's back.",
                            "target_lang_translations": {
                                "ru": "Я вижу <w>ромбы</w> на спине змеи.",
                                "zh": "我能看到蛇背上的<w>菱形</w>花纹。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rhomb",
                        "lozenge",
                        "rhombus"
                    ],
                    "common_phrases": [
                        "diamond shape",
                        "diamond pattern"
                    ],
                    "target_lang_definitions": {
                        "ru": "Геометрическая фигура с четырьмя равными сторонами; ромб.",
                        "zh": "一种四条边长度相等，形成两个锐角和两个钝角的几何图形；菱形。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ромб",
                                "target_lang_sense_clarification": "геометрическая фигура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "菱形",
                                "target_lang_sense_clarification": "几何图形"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2625a58-53c0-3ef0-be01-874413d5ea52",
                    "sense_definition": "A playing card of the suit marked with red diamond shapes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have only one <w>diamond</w> in my hand.",
                            "target_lang_translations": {
                                "ru": "У меня на руках только одна <w>бубна</w>.",
                                "zh": "我手里只有一张<w>方块</w>。"
                            }
                        },
                        {
                            "text": "He played the ten of <w>diamonds</w> to win the trick.",
                            "target_lang_translations": {
                                "ru": "Он пошел с десятки <w>бубен</w>, чтобы взять взятку.",
                                "zh": "他打出了一张<w>方块</w>十赢得了这一轮。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ace of diamonds",
                        "king of diamonds",
                        "queen of diamonds",
                        "jack of diamonds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Карточная масть, обозначаемая красными ромбами.",
                        "zh": "扑克牌中的一种花色，标记为红色菱形。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бубны",
                                "target_lang_sense_clarification": "масть"
                            },
                            {
                                "target_lang_word": "бубна",
                                "target_lang_sense_clarification": "карта этой масти"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "方块",
                                "target_lang_sense_clarification": "扑克牌花色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "201a8c80-93c9-30df-93eb-ffbf03589191",
                    "sense_definition": "The square area of a baseball field enclosed by the four bases; the infield.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "baseball",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teams met on the <w>diamond</w> to start the game.",
                            "target_lang_translations": {
                                "ru": "Команды встретились на <w>площадке</w>, чтобы начать игру.",
                                "zh": "两队在<w>内野</w>集合准备开始比赛。"
                            }
                        },
                        {
                            "text": "The groundskeepers prepared the <w>diamond</w> before the match.",
                            "target_lang_translations": {
                                "ru": "Смотрители подготовили <w>площадку</w> перед матчем.",
                                "zh": "场地管理员在比赛前整理了<w>内野</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "infield",
                        "baseball diamond",
                        "baseball field",
                        "ball field"
                    ],
                    "antonyms": [
                        "outfield"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутренняя часть бейсбольного поля, ограниченная четырьмя базами.",
                        "zh": "棒球场内由四个垒包围成的方形区域；内场。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бейсбольная площадка",
                                "target_lang_sense_clarification": "часть поля"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内野",
                                "target_lang_sense_clarification": "棒球场区域"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e1864dd2-0580-3863-86f3-5cfa621fe932",
                    "sense_definition": "Made of or containing diamond.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gem_mineral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave her <w>diamond</w> earrings for her birthday.",
                            "target_lang_translations": {
                                "ru": "Он подарил ей <w>бриллиантовые</w> серьги на день рождения.",
                                "zh": "他送了她一对<w>钻石</w>耳环作为生日礼物。"
                            }
                        },
                        {
                            "text": "The tool has a <w>diamond</w> tip for cutting glass.",
                            "target_lang_translations": {
                                "ru": "Инструмент имеет <w>алмазный</w> наконечник для резки стекла.",
                                "zh": "这个工具配有一个用于切割玻璃的<w>金刚石</w>刀头。"
                            }
                        }
                    ],
                    "synonyms": [
                        "diamantine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из алмаза или содержащий алмаз.",
                        "zh": "由钻石制成或含有钻石的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бриллиантовый",
                                "target_lang_sense_clarification": "сделанный из бриллиантов, об украшениях"
                            },
                            {
                                "target_lang_word": "алмазный",
                                "target_lang_sense_clarification": "технический или относящийся к минералу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钻石",
                                "target_lang_sense_clarification": "形容词，指材质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9398f04b-b14c-3e92-a357-61f5376de8a1",
                    "sense_definition": "Relating to a sixtieth anniversary.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anniversary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Today is their <w>diamond</w> wedding anniversary.",
                            "target_lang_translations": {
                                "ru": "Сегодня их <w>бриллиантовая</w> свадьба.",
                                "zh": "今天是他们的<w>钻石</w>婚纪念日。"
                            }
                        },
                        {
                            "text": "The queen celebrated her <w>diamond</w> jubilee after sixty years on the throne.",
                            "target_lang_translations": {
                                "ru": "Королева отпраздновала свой <w>бриллиантовый</w> юбилей после шестидесяти лет на троне.",
                                "zh": "女王在位六十年后庆祝了她的<w>钻石</w>禧年。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "diamond anniversary",
                        "diamond wedding",
                        "diamond jubilee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к шестидесятилетнему юбилею.",
                        "zh": "与六十周年纪念相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бриллиантовый",
                                "target_lang_sense_clarification": "о юбилее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钻石",
                                "target_lang_sense_clarification": "用于周年纪念"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6c1e8d1-98dd-3971-8f77-d7d58c44d79a",
                    "sense_definition": "First-rate; excellent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He's a <w>diamond</w> geezer who always helps his friends.",
                            "target_lang_translations": {
                                "ru": "Он <w>мировой</w> парень, который всегда помогает друзьям.",
                                "zh": "他是个<w>极好</w>的人，总是乐于帮助朋友。"
                            }
                        },
                        {
                            "text": "That idea is absolute <w>diamond</w>.",
                            "target_lang_translations": {
                                "ru": "Эта идея просто <w>блеск</w>.",
                                "zh": "那个主意真是<w>太棒了</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "diamond geezer"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличный, превосходный (сленг).",
                        "zh": "极好的；优秀的（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "золото",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "классный",
                                "target_lang_sense_clarification": "отличный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极好的",
                                "target_lang_sense_clarification": "形容事物"
                            },
                            {
                                "target_lang_word": "好人",
                                "target_lang_sense_clarification": "形容人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "949e1238-47e2-3bb9-836c-17c9ef655924",
                    "sense_definition": "A female given name from English of modern usage, from the name of the gem.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name_group",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My friend <w>Diamond</w> is coming to the party.",
                            "target_lang_translations": {
                                "ru": "Моя подруга <w>Даймонд</w> придет на вечеринку.",
                                "zh": "我的朋友<w>戴蒙德</w>要来参加聚会。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя.",
                        "zh": "现代英语女性名字，源自宝石名称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Даймонд",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戴蒙德",
                                "target_lang_sense_clarification": "人名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b62e3dc5-14d1-386f-be1d-f782314ee0af",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name_group",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Diamond</w> wrote a famous book about geography.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Даймонд</w> написал известную книгу по географии.",
                                "zh": "<w>戴蒙德</w>先生写了一本关于地理的著名书籍。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Даймонд",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戴蒙德",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2755b655-a08b-37b6-b570-ad7e91b06606",
                    "sense_definition": "A number of places in the United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name_group",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small town of <w>Diamond</w> during their road trip.",
                            "target_lang_translations": {
                                "ru": "Они посетили маленький городок <w>Даймонд</w> во время своего автопутешествия.",
                                "zh": "他们在公路旅行中参观了<w>戴蒙德</w>小镇。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название ряда населенных пунктов в США.",
                        "zh": "美国的一些地名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Даймонд",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戴蒙德",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "89dac947-5f60-3dfa-9116-d2896d8016f4",
                    "sense_definition": "To adorn with or as if with diamonds.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "adorn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The night sky was <w>diamonded</w> with bright stars.",
                            "target_lang_translations": {
                                "ru": "Ночное небо было <w>усыпано</w> яркими звездами.",
                                "zh": "夜空被明亮的星星<w>点缀</w>着。"
                            }
                        },
                        {
                            "text": "Morning dew <w>diamonded</w> the green grass.",
                            "target_lang_translations": {
                                "ru": "Утренняя роса <w>украсила алмазами</w> зеленую траву.",
                                "zh": "晨露<w>点缀</w>在绿草上。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Украшать алмазами или чем-то сверкающим, как алмазы.",
                        "zh": "用钻石或类似钻石的东西装饰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усыпать",
                                "target_lang_sense_clarification": "перен. покрывать множеством мелких объектов"
                            },
                            {
                                "target_lang_word": "украшать",
                                "target_lang_sense_clarification": "делать красивым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "点缀",
                                "target_lang_sense_clarification": "装饰"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}