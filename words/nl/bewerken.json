                            },
                            {
                                "target_lang_word": "modify",
                                "target_lang_sense_clarification": "to make changes to something"
                            },
                            {
                                "target_lang_word": "adjust",
                                "target_lang_sense_clarification": "to change slightly to make correct"
                            }
                        ]
