                "senses": [
                    {
                        "sense_id": "9e18d7c9-d292-37b2-9ee2-157e834d27b8",
                        "entry_id": "13f37d97-b88c-3465-b569-c5cd2d97b084",
                        "glosses": [
                            "Krankheit, bei der der Körper zu früh aufhört größer zu werden (zu wachsen) und somit die betreffende Person nur eine geringe Körpergröße erreicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f791a0c-019f-493f-8bfc-bea423bcb9d9",
                                "sense_id": "9e18d7c9-d292-37b2-9ee2-157e834d27b8",
                                "text": "„Außerdem gibt es bisher kaum Möglichkeiten, die Achondroplasie zu behandeln, weil sie – im Unterschied zu anderen Formen des Kleinwuchses – so gut wie nicht auf Wachstumshormone anspricht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d241fdc1-08f3-461a-8ec9-a3dfa7a73db5",
                        "source_entry_id": "13f37d97-b88c-3465-b569-c5cd2d97b084",
                        "source_sense_id": "9e18d7c9-d292-37b2-9ee2-157e834d27b8",
                        "target_lang_word": "dwarfism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dwarfism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "208cae06-a663-3b4d-a6ed-351f7ff15dcf",
                                        "entry_id": "9598e794-39b1-36bd-a836-55ff4ccb833a",
                                        "glosses": [
                                            "The condition of being a dwarf (person of short stature)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba989887-ca68-497e-944b-dacf0dc48d64",
                                                "sense_id": "208cae06-a663-3b4d-a6ed-351f7ff15dcf",
                                                "text": "Studies of disproportionate dwarfisms in animals have revealed the importance of core proteins an sulfation in the development of cartilage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81f7800b-5ce3-3451-914e-b833301638cc",
                                        "entry_id": "9598e794-39b1-36bd-a836-55ff4ccb833a",
                                        "glosses": [
                                            "The quality of being puny or inferior."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bed249b-153d-4788-a0b2-723b520fedaa",
                                                "sense_id": "81f7800b-5ce3-3451-914e-b833301638cc",
                                                "text": "Childish, childish to the core: that's why they're so good at nursing, they're arrested in a state of permanent intellectual dwarfism themselves!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c1eadc8-b06a-48c1-a1c8-2a3a02e05656",
                        "source_entry_id": "13f37d97-b88c-3465-b569-c5cd2d97b084",
