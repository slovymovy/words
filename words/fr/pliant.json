                {
                    "sense_id": "58015093-6058-3d86-8548-5f04b220461a",
                    "sense_definition": "Qualifie un objet ou un meuble conçu pour se replier afin de faciliter son rangement ou son transport.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "repliable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour le pique-nique au parc, nous avons emporté une table et deux chaises <w>pliantes</w>."
                        },
                        {
                            "text": "Il range toujours son vélo <w>pliant</w> dans le coffre avant de monter dans le train."
                        }
                    ],
                    "synonyms": [
                        "pliable"
                    ],
                    "common_phrases": [
                        "siège pliant",
                        "chaise pliante",
                        "lit pliant"
                    ]
                },
                {
                    "sense_id": "e2b7e854-e8d4-3079-9b0b-df0bedd9797a",
                    "sense_definition": "Qui est souple, flexible et facile à courber sans se casser.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "souple",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les branches de saule sont très <w>pliantes</w> et servent traditionnellement à fabriquer des paniers."
                        },
                        {
                            "text": "Cette longue tige métallique est assez <w>pliante</w> pour prendre la courbure voulue."
                        }
                    ],
                    "synonyms": [
                        "pliable"
                    ]
                },
                {
                    "sense_id": "c9b24f2f-c950-3da4-a405-0cc752674053",
                    "sense_definition": "Qui s'adapte aisément à la volonté des autres ou aux circonstances ; docile, accommodant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce à son caractère <w>pliant</w>, il évite souvent les conflits au sein du groupe."
                        },
                        {
                            "text": "Elle n'a pas un esprit très <w>pliant</w> et refuse de céder lors des négociations."
                        }
                    ],
                    "common_phrases": [
                        "caractère pliant",
                        "esprit pliant"
                    ]
                }
            ]
        },
