                                        "sense_id": "331ba65f-0146-39c1-8a6c-a6e47f6661c8",
                                        "entry_id": "0557f5b8-8bfd-3373-bcf0-a80c158b486a",
                                        "glosses": [
                                            "A portion of blotter acid."
                                        ],
