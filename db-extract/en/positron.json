{
    "word": "positron",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "bf408dc9-9416-3915-b86d-2318601a63ec",
                "word": "positron",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "78886834-d868-4c09-a6c8-a5ae639bd58b",
                        "entry_id": "bf408dc9-9416-3915-b86d-2318601a63ec",
                        "tags": [
                            "plural"
                        ],
                        "form": "positrons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1a7a847b-179d-32f7-9b51-045b9292e15f",
                        "entry_id": "bf408dc9-9416-3915-b86d-2318601a63ec",
                        "glosses": [
                            "The antimatter equivalent of an electron, having the same mass but a positive charge."
                        ],
                        "tags": [
                            "particle"
                        ],
                        "examples": [
                            {
                                "example_id": "c3c383d2-7c55-4706-a0d1-afbbccc2c487",
                                "sense_id": "1a7a847b-179d-32f7-9b51-045b9292e15f",
                                "text": "The notion of a positron weapon remains the stuff of science fiction."
                            },
                            {
                                "example_id": "ad108bf2-35ca-4491-8d04-2314891e33b4",
                                "sense_id": "1a7a847b-179d-32f7-9b51-045b9292e15f",
                                "text": "If these particles carry unit positive charge the curvatures and ionizations produced require the mass to be less than twenty times the electron mass. These particles will be called positrons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8cbfa449-7d8d-498b-a9f5-678eb3ce4fe2",
                        "source_entry_id": "bf408dc9-9416-3915-b86d-2318601a63ec",
                        "source_sense_id": "1a7a847b-179d-32f7-9b51-045b9292e15f",
                        "source_sense_description": "positron",
                        "target_lang_word": "pozitron",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pozitron",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "68b1c2ec-302f-37b5-8afe-ebfcf1bcd99f",
                                        "entry_id": "49ba1b32-fd29-3609-9a9d-92e83d2f52e4",
                                        "glosses": [
                                            "elementární částice s kladným elektrickým nábojem, spinem 1/2 a hmotností přibližně 9,11×10⁻³¹ kg, která patří mezi leptony"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "755c0e84-1d25-43a7-933d-52ac8f136c87",
                                                "sense_id": "68b1c2ec-302f-37b5-8afe-ebfcf1bcd99f",
                                                "text": "V roce 1932 objevil Carl David Anderson (1905–1991) při zkoumání kosmického záření pozitron, lehkou částici s kladným nábojem, která má hmotnost shodnou s elektronem. Objev pozitronu potvrdil teorii antičástic a dnes známe ke každé částici v přírodě odpovídající antičástici (antiproton, antineutron, antineutrina atd.)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f7c160f-a4ef-4f4e-816c-06f44117cc7d",
                        "source_entry_id": "bf408dc9-9416-3915-b86d-2318601a63ec",
                        "source_sense_id": "1a7a847b-179d-32f7-9b51-045b9292e15f",
                        "source_sense_description": "positron",
                        "target_lang_word": "positron",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "positron",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "edb0927c-407f-3681-8937-67fac5b143b6",
                                        "entry_id": "90820628-3ef7-31e2-aa2b-81aa0426c29d",
                                        "glosses": [
                                            "een positief deeltje dat het antideeltje van een elektron is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ef2a450-f06a-40f5-9ed7-5e87d5e175d2",
                                                "sense_id": "edb0927c-407f-3681-8937-67fac5b143b6",
                                                "text": "Sommige radioactieve isotopen zenden positronen uit."
                                            },
                                            {
                                                "example_id": "66e21867-aa2f-4bf1-9d4d-7a2e1e257758",
                                                "sense_id": "edb0927c-407f-3681-8937-67fac5b143b6",
                                                "text": "Recordbrekende antimaterie: Antimaterie is de tegenhanger van ‘gewone’ materie. Van elk elementair materiedeeltjestype bestaat een antimaterieversie die in veel opzichten erop lijkt, maar het spiegelbeeld is. Zo is het anti-elektron (of positron) net zo zwaar als het elektron maar heeft het een positieve lading in plaats van een negatieve."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cc02465-7949-47ab-8a02-3f2e6e58609f",
                        "source_entry_id": "bf408dc9-9416-3915-b86d-2318601a63ec",
                        "source_sense_id": "1a7a847b-179d-32f7-9b51-045b9292e15f",
                        "source_sense_description": "positron",
                        "target_lang_word": "positron",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "positron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59f71e04-3f5b-32e2-893a-ad52cdaa6d0f",
                                        "entry_id": "75a210eb-e020-38b1-be99-cd568dd3a6b6",
                                        "glosses": [
                                            "Antiparticule associée à l'électron."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85b3389f-acb4-464e-a945-adf5abaf3886",
                                                "sense_id": "59f71e04-3f5b-32e2-893a-ad52cdaa6d0f",
                                                "text": "Le positron fut la première antiparticule à être découverte, par Carl Anderson en 1932."
                                            },
                                            {
                                                "example_id": "ac198af8-bf15-4779-a760-14a750028290",
                                                "sense_id": "59f71e04-3f5b-32e2-893a-ad52cdaa6d0f",
                                                "text": "Plus récemment, une étude intrigante en tomographie par émission de positrons (PET) a rapporté une diminution de la liaison au récepteur 5-HT1A dans le raphé et dans l’hippocampeamygdale de patients déprimés, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35820551-fd75-44aa-92ab-8aaac705ded2",
                        "source_entry_id": "bf408dc9-9416-3915-b86d-2318601a63ec",
                        "source_sense_id": "1a7a847b-179d-32f7-9b51-045b9292e15f",
                        "source_sense_description": "positron",
                        "target_lang_word": "positon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "positon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3a4700f-087b-3de4-be8e-17718e090e56",
                                        "entry_id": "9e01d564-05be-3dd9-aa5f-91e4b6dc6c8c",
                                        "glosses": [
                                            "Antiparticule de l'électron."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9dbbcde-2a58-40c2-9542-881628e893f1",
                                                "sense_id": "d3a4700f-087b-3de4-be8e-17718e090e56",
                                                "text": "Les positons issus d'une lame d'aluminium irradié"
                                            },
                                            {
                                                "example_id": "970498a3-1dd8-4241-be3a-51ba32e02e46",
                                                "sense_id": "d3a4700f-087b-3de4-be8e-17718e090e56",
                                                "text": "[…] on a pu déceler l'existence de corpuscules d'électricité positive ayant la même masse que l'électron avec une charge électrique égale et de signe contraire, les électrons positifs ou positons. Quel est alors le véritable corpuscule élémentaire d'électricité positive ? Est-ce le proton ou le positon ?"
                                            },
                                            {
                                                "example_id": "1cebf97f-d1e0-484f-9202-83d679ece2f5",
                                                "sense_id": "d3a4700f-087b-3de4-be8e-17718e090e56",
                                                "text": "[…] ce qui suggère une symétrie complète entre l'électron positif ou '''positon '' et l'électron négatif ou négaton, qui auraient ainsi mêmes masses avec des charges égales et contraires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "203fe38f-d3cc-44ec-843f-779e3fa0322a",
                        "source_entry_id": "bf408dc9-9416-3915-b86d-2318601a63ec",
