                    {
                        "sense_id": "0d0871b4-44c6-3091-80cf-5eaf358ddfe7",
                        "entry_id": "50c31cbc-73ac-316c-8cec-1004f40368c1",
                        "glosses": [
                            "een koepel met meestal een vast machinegeweer of kanon, die het geschut en de schutter beschermt tegen de omgeving (vooral bij vliegtuigen) en/of projectielen (gepantserde schepen, voertuigen) en er tegelijkertijd voor zorgt dat het wapen gericht kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bb1defe-9f05-4e4d-bff2-01ee7d2fc23e",
                                "sense_id": "0d0871b4-44c6-3091-80cf-5eaf358ddfe7",
                                "text": "Een hoofd met koptelefoon stak boven de geschutskoepel uit."
                            },
                            {
                                "example_id": "ed3a27cf-41f4-4e66-bc7d-8a2487489252",
                                "sense_id": "0d0871b4-44c6-3091-80cf-5eaf358ddfe7",
                                "text": "Loegansk. Haar huis is kapotgeschoten. In de tuin bij de buren staat een tank van het Oekraïense leger, uitgebrand. De geschutskoepel ligt ernaast, als een deksel eraf geblazen."
                            }
                        ]
                    }
                ],
