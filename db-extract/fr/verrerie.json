        "fr-extract.jsonl": [
            {
                "entry_id": "9cca3ca5-9ed8-37dd-9156-bdce1d9e8959",
                "word": "verrerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4af56be0-22f6-4d15-baf5-be13ecc0da8f",
                        "entry_id": "9cca3ca5-9ed8-37dd-9156-bdce1d9e8959",
                        "tags": [
