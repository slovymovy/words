                ],
                "senses": [
                    {
                        "sense_id": "173424be-ce97-3564-bafa-078a722f638f",
                        "entry_id": "04086950-ae50-3a25-ae86-88ccb97823f0",
                        "glosses": [
                            "Any of a range of polymers containing amide (or peptide) repeat units; examples include proteins and nylon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0384441e-941b-42af-b39d-83f7e10144bd",
                                "sense_id": "173424be-ce97-3564-bafa-078a722f638f",
                                "text": "For eons, the debris has contained the same things — flecks from plant and animal carcasses, feces, mucus, dust, microbes, viruses — and transported the ocean’s carbon to be stored on the seafloor. Increasingly, however, marine snowfall is being infiltrated by microplastics: fibers and fragments of polyamide, polyethylene and polyethylene terephthalate. And this fauxfall appears to be altering our planet’s ancient cooling process."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f886d5bb-1f3a-4ff5-b527-e6affb634fd0",
                        "source_entry_id": "04086950-ae50-3a25-ae86-88ccb97823f0",
                        "source_sense_id": "173424be-ce97-3564-bafa-078a722f638f",
                        "source_sense_description": "polymer",
                        "target_lang_word": "polyamide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polyamide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9665ece8-2f4a-3aaa-b851-bd8c2ae612d8",
                                        "entry_id": "9b3f0097-8949-3c8d-a440-3ae5b6175773",
                                        "glosses": [
                                            "Polymère issu de la polycondensation par formation de groupements amides N-H-C=O, qui résultent de la réaction chimique d’un acide et d’une amine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76618e89-c184-451e-8bd6-3c5da8fedf91",
                                                "sense_id": "9665ece8-2f4a-3aaa-b851-bd8c2ae612d8",
                                                "text": "Le nylon est un polyamide."
                                            },
                                            {
                                                "example_id": "fc56542c-b2f5-472a-9cb0-9eba60f49724",
                                                "sense_id": "9665ece8-2f4a-3aaa-b851-bd8c2ae612d8",
                                                "text": "Les polypeptides sont des sortes de polyamides, issus de la polycondensation d'acides aminés."
                                            },
                                            {
                                                "example_id": "8096423f-ae88-497c-bad4-0f1e32235227",
                                                "sense_id": "9665ece8-2f4a-3aaa-b851-bd8c2ae612d8",
                                                "text": "Le polyamide est une fibre chimique synthétique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3453b0fd-5463-40df-89ff-ab211439f0b3",
                        "source_entry_id": "04086950-ae50-3a25-ae86-88ccb97823f0",
                        "source_sense_id": "173424be-ce97-3564-bafa-078a722f638f",
