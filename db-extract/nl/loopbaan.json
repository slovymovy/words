                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carrière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e7289bc-6258-39a7-84d1-0c404f0d73c8",
                                        "entry_id": "766c287d-63ab-3e3b-9c5f-3c3d3ebdda13",
                                        "glosses": [
                                            "Champ de courses : espace fermé de barrières et disposé pour toute sorte de courses, principalement pour les courses à cheval ou en char."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a71f19b8-8674-46d6-81a2-590f60b33505",
                                                "sense_id": "1e7289bc-6258-39a7-84d1-0c404f0d73c8",
                                                "text": "Le bout de la carrière."
                                            },
                                            {
                                                "example_id": "73d4159f-a0a3-4f14-a0cd-a1a1b17081f5",
                                                "sense_id": "1e7289bc-6258-39a7-84d1-0c404f0d73c8",
                                                "text": "Aller jusqu’au bout de la carrière."
                                            },
                                            {
                                                "example_id": "05865c01-ecdd-4c0e-bc93-bac84bb722ee",
                                                "sense_id": "1e7289bc-6258-39a7-84d1-0c404f0d73c8",
                                                "text": "Parcourir la carrière."
                                            },
                                            {
                                                "example_id": "8c421e6c-7f10-4ba4-9782-3fdaeff03166",
                                                "sense_id": "1e7289bc-6258-39a7-84d1-0c404f0d73c8",
                                                "text": "S’arrêter au milieu de la carrière."
                                            },
                                            {
                                                "example_id": "5efa4df4-c52e-4e42-8feb-d53c62c30085",
                                                "sense_id": "1e7289bc-6258-39a7-84d1-0c404f0d73c8",
                                                "text": "Pénétrer dans la carrière."
                                            },
                                            {
                                                "example_id": "41bb2874-5820-49b0-951f-ca1f368df074",
                                                "sense_id": "1e7289bc-6258-39a7-84d1-0c404f0d73c8",
                                                "text": "Ouvrir la carrière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bb7268e-90d9-3895-8c72-4a6bdc815317",
                                        "entry_id": "766c287d-63ab-3e3b-9c5f-3c3d3ebdda13",
                                        "glosses": [
                                            "L’étendue de terrain où l’on peut faire courir un cheval sans qu’il perde haleine."
                                        ],
                                        "tags": [
                                            "Manège"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df8fa62e-7f20-3db3-ab4c-e0838639b0ff",
                                        "entry_id": "766c287d-63ab-3e3b-9c5f-3c3d3ebdda13",
                                        "glosses": [
                                            "Espace de dimensions réduites."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56bb9c27-d9e0-48ad-88de-963ab15c6bc3",
                                                "sense_id": "df8fa62e-7f20-3db3-ab4c-e0838639b0ff",
                                                "text": "Certains affirmaient tout bêtement que Mme Roels lisait des romans d’un amour pâle et triste, d’impossibles rencontres et des confessions de pénitentes, aventures qui ne demandaient pour carrière que la surface d’un jardin de curé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baac6992-474a-3c2f-81c2-92b5d567a3fb",
                                        "entry_id": "766c287d-63ab-3e3b-9c5f-3c3d3ebdda13",
                                        "glosses": [
                                            "Le cours de la vie, le temps qu’on exerce un emploi ou une charge."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2799569a-8d04-4cd9-a2c0-00c981180892",
                                                "sense_id": "baac6992-474a-3c2f-81c2-92b5d567a3fb",
                                                "text": "Nous entrerons dans la carrière\nQuand nos aînés n’y seront plus ;\nNous y trouverons leur poussière\nEt la trace de leurs vertus."
                                            },
                                            {
                                                "example_id": "e2619083-7e1b-447d-8392-22bdcaab5830",
                                                "sense_id": "baac6992-474a-3c2f-81c2-92b5d567a3fb",
                                                "text": "Dans le cours de ma carrière, j’ai abordé beaucoup de sujets qui ne semblaient guère devoir entrer dans la spécialité d’un écrivain socialiste."
                                            },
                                            {
                                                "example_id": "7fe30c3f-9877-45dd-a217-7fe9ea11a14f",
                                                "sense_id": "baac6992-474a-3c2f-81c2-92b5d567a3fb",
                                                "text": "Que je le plains, pécheur, en ton heure dernière !\nLes maux les plus affreux sont amassés sur toi ;\nLe noir enfer, séjour rempli d’effroi,\nT’attend au bout de la carrière."
                                            },
                                            {
                                                "example_id": "c016cdc0-6df9-44ed-a683-db82f5614c4e",
                                                "sense_id": "baac6992-474a-3c2f-81c2-92b5d567a3fb",
                                                "text": "J’ai vu, dans ma longue carrière d’ingénieur acousticien, bien des matières excellentes conductrices du son, mais jamais je n’en rencontrerai une seule comparable, même de loin, à celle dont sont pétris les murs de l’hôtel Terminus à Marseille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a34d730f-fa10-3b96-8051-227248166ff7",
                                        "entry_id": "766c287d-63ab-3e3b-9c5f-3c3d3ebdda13",
                                        "glosses": [
                                            "Profession que l’on embrasse, études auxquelles on se livre ou entreprises où l’on s’engage."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b475a18-d010-4c02-a2ef-4e4c82043e68",
                                                "sense_id": "a34d730f-fa10-3b96-8051-227248166ff7",
                                                "text": "Un troisième ami de la maison, le principal du collège d’Arbois, M. Romanet, exerça une influence décisive sur la carrière de Louis Pasteur."
                                            },
                                            {
                                                "example_id": "66e78d85-86c9-4fa3-8c28-96104dd6d3d8",
                                                "sense_id": "a34d730f-fa10-3b96-8051-227248166ff7",
                                                "text": "Et je commence à haïr l’humanité. La haine, ce sera ma carrière à moi. Je vous servirai dans vos faiblesses et dans vos grandeurs. Vos amours ou votre politique, peu importe."
                                            },
                                            {
                                                "example_id": "fd66b85a-28dc-4353-a2ed-e3b2a6aeef4d",
                                                "sense_id": "a34d730f-fa10-3b96-8051-227248166ff7",
                                                "text": "[…] il me fallut examiner sérieusement quelle carrière je voulais embrasser. Le sens de cette expression m’échappait totalement. Pour moi, une carrière était un grand trou taillé dans une colline."
                                            },
                                            {
                                                "example_id": "26bb8773-1b86-4dbf-b403-ec21ee0c36ee",
                                                "sense_id": "a34d730f-fa10-3b96-8051-227248166ff7",
                                                "text": "Cet enchevêtrement de rendez-vous, d’obligations, de réceptions, de vernissages ? Sa carrière en dépendait et c’était autant d’occasions de se faire remarquer. « Ma carrière… » Elle n’avait que ce mot à la bouche !"
                                            },
                                            {
                                                "example_id": "b4756ff5-f52f-45e2-be19-230490ef0a75",
                                                "sense_id": "a34d730f-fa10-3b96-8051-227248166ff7",
                                                "text": "Pauvre Bill. En plus de la gêne occasionnée par la découverte que sa femme était une coureuse de jupons, il lui fallait limiter les dégâts sur sa propre carrière politique en campant sur une position ferme concernant les valeurs familiales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76418c4a-c5d6-3e23-a029-7c1878885307",
                                        "entry_id": "766c287d-63ab-3e3b-9c5f-3c3d3ebdda13",
                                        "glosses": [
                                            "La carrière diplomatique (souvent écrit avec une initiale majuscule)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ba5f567-c70a-4656-a673-8ba5d0428e55",
                                                "sense_id": "76418c4a-c5d6-3e23-a029-7c1878885307",
                                                "text": "Son fils Émile fit carrière dans la Carrière."
                                            },
                                            {
                                                "example_id": "029ff9b0-77e8-41de-a918-0053291b1fea",
                                                "sense_id": "76418c4a-c5d6-3e23-a029-7c1878885307",
                                                "text": "Georges\nJe serai peut-être un très bon électricien sans-filiste.\nJacquet\nÉlectricien sans-filiste ! - \"Et votre fils, mon cher ministre, à quoi se destine-t-il ? Au barreau ? À la Carrière ? À la politique ?\" - \"Non ! Il est électricien sans-filiste !\" - C'est délicieux, tu avoueras…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02f20aa8-f1cb-3e7a-b0df-e6bd4334f786",
                                        "entry_id": "766c287d-63ab-3e3b-9c5f-3c3d3ebdda13",
                                        "glosses": [
                                            "Le mouvement périodique des astres."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eadf8eb5-c6e4-4fcb-aa16-5645c61fb85c",
                                                "sense_id": "02f20aa8-f1cb-3e7a-b0df-e6bd4334f786",
                                                "text": "Le soleil commence, achève sa carrière."
                                            },
                                            {
                                                "example_id": "e37eba4f-7db0-49d9-9347-22f3e8facd17",
                                                "sense_id": "02f20aa8-f1cb-3e7a-b0df-e6bd4334f786",
                                                "text": "L’astre des nuits parcourt sa paisible carrière."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "carrière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ebff9e1e-194d-32ff-a9d6-e22c2009731b",
                                        "entry_id": "e0d4ab37-8b64-35e0-8376-b5ddee551c09",
                                        "glosses": [
                                            "Endroit d’où sont extraits des matériaux de construction (pierres, sable, minéraux non métalliques), par opposition aux mines. Elles peuvent être souterraines ou à ciel ouvert."
                                        ],
                                        "tags": [
                                            "Industrie minière"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49177bbd-7889-496b-a32e-72610f7853cc",
                                                "sense_id": "ebff9e1e-194d-32ff-a9d6-e22c2009731b",
                                                "text": "Nous ne pouvons quitter cette région sans nous arrêter un instant dans les célèbres carrières de Chevroches et d’Armes. Elles s’ouvrent l’une et l’autre dans la couche moyenne de l’étage bathonien."
                                            },
                                            {
                                                "example_id": "7c73733d-d4e3-49dc-99d4-692022ae5e79",
                                                "sense_id": "ebff9e1e-194d-32ff-a9d6-e22c2009731b",
                                                "text": "Ce sarcophage serait un invendu de la carrière voisine. Enfoncé dans le sol tout contre le mur du xiiᵉ siècle, il est assez endommagé."
                                            },
                                            {
                                                "example_id": "1a1382b2-9e68-4ef7-9733-d6380062e1ca",
                                                "sense_id": "ebff9e1e-194d-32ff-a9d6-e22c2009731b",
                                                "text": "Les gîtes de substances minérales ou fossiles renfermés dans le sein de la terre ou existant à la surface sont, relativement à leur régime légal, considérés comme mines ou comme carrières."
                                            },
                                            {
                                                "example_id": "53ff3cef-0179-493c-a142-996f55e79e0f",
                                                "sense_id": "ebff9e1e-194d-32ff-a9d6-e22c2009731b",
                                                "text": "Le parc, conçu pour l’Exposition universelle de 1878, a été construit sur une ancienne carrière de gypse. Jusqu’en 1860, cette ressource servait à bâtir les immeubles parisiens."
                                            },
                                            {
                                                "example_id": "1c980303-fa66-4c23-85eb-ecb7204c54c9",
                                                "sense_id": "ebff9e1e-194d-32ff-a9d6-e22c2009731b",
                                                "text": "Une carrière peut constituer un grave traumatisme pour un paysage, et il est légitime de s’entourer de toutes les précautions nécessaires avant d’en exploiter une."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f97cc1f-cbec-3560-a0d3-2ab76da7caf9",
                                        "entry_id": "e0d4ab37-8b64-35e0-8376-b5ddee551c09",
                                        "glosses": [
                                            "Nom donné aux décharges, dépotoirs, car elles furent souvent autrefois installées dans une ancienne carrière en vue de la combler. Même si les dépotoirs ont disparu, le terme est resté dans le langage courant. Jaille."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d14037a8-ac18-4c5b-bbe2-8a5caf6cb68c",
                                                "sense_id": "6f97cc1f-cbec-3560-a0d3-2ab76da7caf9",
                                                "text": "Ça ne marche plus du tout, c’est bon pour la carrière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0613dd0-2b11-32ac-9377-c62116973fac",
                                        "entry_id": "e0d4ab37-8b64-35e0-8376-b5ddee551c09",
                                        "glosses": [
                                            "Celle qui exploite une carrière ou qui travaille dans une carrière."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a35f0668-32a9-48a9-8fd5-7f37d67d97f8",
                                                "sense_id": "e0613dd0-2b11-32ac-9377-c62116973fac",
                                                "text": "Décès. — Rouville Delphine, femme Housset, 46 ans, ouvrière carrière, rue de l’Hospice, domiciliée à Saint-Victor-de-Réno."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "carrière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "560aee66-61b3-30fe-84bf-b04179411895",
                                        "entry_id": "9719ecc7-ff30-3f22-910b-f2c52541b123",
                                        "glosses": [
                                            "Quartier juif des villes méridionales de la France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dc641b9-1c13-48ca-a181-0b731b273057",
                                                "sense_id": "560aee66-61b3-30fe-84bf-b04179411895",
                                                "text": "Le Pape […] n’exigea plus le départ des juifs, mais il les obligea à se cantonner dans quatre villes (…) : Avignon, Carpentras, Cavaillon et l’Isle-sur-Sorgue. Dans ces quatre villes, ils étaient tenus d’habiter un quartier spécial appelé « Carrière », ce qui, en provençal signifie rue, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f3c752f-2b72-3aea-af89-5b70d79e214f",
                                        "entry_id": "9719ecc7-ff30-3f22-910b-f2c52541b123",
                                        "glosses": [
                                            "Communauté juive qui vivait dans ces quartiers."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5239c80d-6b30-4e1d-b24d-45ba17cb87b8",
                                                "sense_id": "3f3c752f-2b72-3aea-af89-5b70d79e214f",
