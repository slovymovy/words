                                "target_lang_sense_clarification": "einen niedrigen Preis habend"
                            },
                            {
                                "target_lang_word": "preiswert",
                                "target_lang_sense_clarification": "gutes Preis-Leistungs-Verhältnis"
                            },
                            {
                                "target_lang_word": "günstig",
                                "target_lang_sense_clarification": "vorteilhaft im Preis"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c8c26ec-1ac3-3f05-b983-26b916978ac2",
                    "sense_definition": "Oferujący towary po niskich cenach.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "cena",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kupiłam świeże podroby w <w>tanim</w> sklepie za rogiem.",
                            "target_lang_translations": {
                                "ru": "Я купила свежие субпродукты в <w>дешёвом</w> магазине за углом.",
                                "en": "I bought fresh offal at a <w>cheap</w> shop around the corner.",
                                "de": "Ich habe frische Innereien in einem <w>billigen</w> Laden um die Ecke gekauft."
                            }
                        },
                        {
                            "text": "Ta <w>tania</w> hurtownia przyciąga codziennie tłumy klientów.",
                            "target_lang_translations": {
                                "ru": "Этот <w>дешёвый</w> оптовый склад каждый день привлекает толпы клиентов.",
                                "en": "This <w>budget</w> wholesaler attracts crowds of customers every day.",
                                "de": "Dieser <w>preiswerte</w> Großhandel zieht täglich Scharen von Kunden an."
                            }
                        }
