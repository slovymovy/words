                "senses": [
                    {
                        "sense_id": "856bf7cb-08ee-355d-8783-63f12fbd8957",
                        "entry_id": "d80ea89c-76a0-3bbc-9354-4189b35ff9eb",
                        "glosses": [
                            "osoba lub instytucja zobowiązana do zwrotu długu (w formie pieniężnej lub rzeczowej) wierzycielowi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4bb92e1-590a-48e6-b1d4-afc8047fe831",
                                "sense_id": "856bf7cb-08ee-355d-8783-63f12fbd8957",
                                "text": "Jeśli dłużnicy nadal będą zalegać mi ze spłatami, to w końcu ja sam nie będę miał czym zapłacić rachunków."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e9f52925-53c7-33e7-884d-226c4f2e6cfa",
                        "entry_id": "d80ea89c-76a0-3bbc-9354-4189b35ff9eb",
                        "glosses": [
                            "osoba mająca wobec kogoś moralne zobowiązania"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "f1c2ed96-843b-4ff5-8494-a9e9696e8d92",
                                "sense_id": "e9f52925-53c7-33e7-884d-226c4f2e6cfa",
                                "text": "Dziękuję ci za pomoc, jestem twoim dłużnikiem."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18e31efd-e9e4-4a7c-b44a-746dd670ad0d",
