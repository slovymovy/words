                "senses": [
                    {
                        "sense_id": "4a5b6da9-8359-3647-8614-90ef8a2a0678",
                        "entry_id": "3e5e8707-4b73-36c9-85a0-3cd3add036db",
                        "glosses": [
                            "Chausser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1577de86-366f-465e-a843-e5d2838029f1",
                                "sense_id": "4a5b6da9-8359-3647-8614-90ef8a2a0678",
                                "text": "Le policier d’abord se rechaussa."
                            },
                            {
                                "example_id": "d27ef563-86cd-4d46-bb88-2612ee9ec278",
                                "sense_id": "4a5b6da9-8359-3647-8614-90ef8a2a0678",
                                "text": "Mes mains tremblaient si fort qu’en me rechaussant, j’ai cassé deux fois le lacet de mon soulier."
                            }
                        ]
                    },
                    {
                        "sense_id": "f342faaf-da8a-3176-be76-72cd3e3e6cca",
                        "entry_id": "3e5e8707-4b73-36c9-85a0-3cd3add036db",
                        "glosses": [
                            "Refaire le pied d’une vieille construction ou la fortifier avec de nouvelles pierres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "623ed703-7ee7-4210-bf48-d589abd27a2d",
                                "sense_id": "f342faaf-da8a-3176-be76-72cd3e3e6cca",
                                "text": "Rechausser un mur, une terrasse, un pilier."
                            }
                        ]
                    },
                    {
                        "sense_id": "dfdca64c-5637-38bf-89dd-a88f54c03d5b",
                        "entry_id": "3e5e8707-4b73-36c9-85a0-3cd3add036db",
                        "glosses": [
                            "Remettre de la terre au pied d'une plantation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d741f603-b6b1-44ef-aa8e-c064e9bae96c",
                                "sense_id": "dfdca64c-5637-38bf-89dd-a88f54c03d5b",
                                "text": "Nous devons faire remarquer qu’avant de pratiquer la taille, on a l’habitude de dégratter le pied des ceps avec les instruments ad hoc, ici en usage, de sorte que, dans les premières années de la plantation, les yeux sortant de la souche, au-dessous du niveau du champ, ne forment point de nodosités sur la tige, comme on serait tenté de le croire, et le sarment de la troisième année paraît réellement sortir de terre lorsque le cep est rechaussé."
                            }
                        ]
                    }
                ],
