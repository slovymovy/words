                    "sense_definition": "Diviser un objet ou une matière à l'aide d'un instrument tranchant.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il utilise un grand couteau pour <w>couper</w> le pain sur la table."
                        },
                        {
                            "text": "Elle <w>coupe</w> des morceaux de fromage pour préparer le dîner."
                        }
                    ],
                    "synonyms": [
