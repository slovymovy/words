                "senses": [
                    {
                        "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                        "entry_id": "9e5d04d4-98fc-3c5d-a402-e485abd59b56",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2ba11ba-c70c-49c2-a318-d9b10726750d",
                                "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                                "text": "Frau Adalbert träumt seit ihrer Kindheit von einer eigenen Zementfabrik."
                            },
                            {
                                "example_id": "97dc7857-b926-41b3-8c9c-2cde1ce11753",
                                "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                                "text": "Bei Adalberts von Gegenüber hängt stets eine Fahne von St. Pauli draußen."
                            },
                            {
                                "example_id": "44973173-c4c2-4050-b6ae-e178250a6a29",
                                "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                                "text": "Herr Adalbert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1507c723-ab9f-4e7e-92af-26e8383e9001",
                                "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                                "text": "Die Adalberts kommen heute aus Bonn."
                            },
                            {
                                "example_id": "f997d709-a556-4ec3-b7e7-5e45e0414338",
                                "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                                "text": "Der Adalbert trägt nie die Schals, die die Adalbert ihm strickt."
                            },
                            {
                                "example_id": "71fc1368-3311-4e69-8ec2-f5ac3cb6a351",
                                "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Adalbert kommt, geht der Herr Adalbert.“"
                            },
                            {
                                "example_id": "f7c92865-3d6e-44bb-8ef0-2dc7be7be25f",
                                "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                                "text": "Adalbert kommt und geht."
                            },
                            {
                                "example_id": "366d5a6d-7550-4c7f-a2f4-253bdb20f1ef",
                                "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                                "text": "Adalberts kamen, sahen und siegten."
                            },
                            {
                                "example_id": "fbcc617e-4cd8-4380-8db7-85d5cab98e56",
                                "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                                "text": "An verregneten Herbsttagen ist Familie Adalberts liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "a022ef13-72d0-4fb5-93d2-8ec360fc92eb",
                                "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Adalbert das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
