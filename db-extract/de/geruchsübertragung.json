                "senses": [
                    {
                        "sense_id": "7ab292fa-df7f-34d0-953e-8a8072133cb7",
                        "entry_id": "44be202f-483b-3ebb-833b-50b01e359480",
                        "glosses": [
                            "das Abgeben und Annehmen von Geruchsstoffen; übertragen von Geruch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca372db0-f572-4b64-bf71-f352440f3823",
                                "sense_id": "7ab292fa-df7f-34d0-953e-8a8072133cb7",
                                "text": "„Im Wärmetauscher bleiben Zu- und Abluft vollständig voneinander getrennt, sodass eine Geruchsübertragung ausgeschlossen ist.“"
                            },
                            {
                                "example_id": "95250c5b-145d-4ec4-9be7-d615341394fe",
                                "sense_id": "7ab292fa-df7f-34d0-953e-8a8072133cb7",
                                "text": "„Ein vielversprechender Lösungsansatz dazu liege in Rotationswärmetauschern, deren neue Möglichkeiten zur Vermeidung von Geruchsübertragung im Rahmen eines Forschungsprojekts der Uni Salzburg analysiert werden.“"
                            },
                            {
                                "example_id": "c9d20363-ca3f-4500-93d2-30644182ac91",
                                "sense_id": "7ab292fa-df7f-34d0-953e-8a8072133cb7",
                                "text": "„Sie behält dann einige Tage ihr typisches Aroma und ist vor Geruchsübertragung anderer Lebensmittel geschützt.“"
                            },
                            {
                                "example_id": "c18d32f5-7f86-40d8-88b7-a589e3b2d39b",
                                "sense_id": "7ab292fa-df7f-34d0-953e-8a8072133cb7",
                                "text": "„In anderen Sonderfällen soll die Geruchsübertragung zwischen Räumen untersucht werden.“"
                            },
                            {
                                "example_id": "5b3a0d5e-7d55-475b-bdd9-bc8dfdbb2a09",
                                "sense_id": "7ab292fa-df7f-34d0-953e-8a8072133cb7",
                                "text": "„Sie werden überall dort eingesetzt, wo die Trennung von zwei Luftströmen erforderlich ist, z. B. um eine Geruchsübertragung von Abluft in den Zuluftstrom zu vermeiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
