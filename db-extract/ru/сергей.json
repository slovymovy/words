                    },
                    {
                        "translation_id": "e71701b9-cd44-4a92-a766-a6390812f5be",
                        "source_entry_id": "bc4ae9f1-9623-31a6-b30c-d6ae61bcea90",
                        "source_sense_id": "7957085f-2e07-31ce-9dbc-f4c2fd0aebe2",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Serge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Serge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fe26fdc-00e6-3d46-b4f4-1fd238dcbb97",
                                        "entry_id": "ee3a5e8d-3cd9-3053-8012-1b67498e43e0",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b884f1a8-1a3d-458a-88e6-e2974d92453f",
                                                "sense_id": "1fe26fdc-00e6-3d46-b4f4-1fd238dcbb97",
                                                "text": "Sur les ondes de la radio de Radio-Canada, Serge Bouchard nous aura longtemps accompagnés de ses histoires fascinantes sur l’Amérique."
                                            },
                                            {
                                                "example_id": "df1b4b54-6177-461b-95e1-d700e4565b8d",
                                                "sense_id": "1fe26fdc-00e6-3d46-b4f4-1fd238dcbb97",
                                                "text": "Elle a coanimé en 1989 avec Serge Deslongchamps le tout premier bulletin d'informations de RDS, Sports 30, la première émission diffusée par ce réseau."
                                            },
                                            {
                                                "example_id": "7c743c49-dad2-44c1-8307-616df9feae35",
                                                "sense_id": "1fe26fdc-00e6-3d46-b4f4-1fd238dcbb97",
                                                "text": "Dans son ouvrage, Philippe Gasparini retrace le chemin tortueux de ce concept dont même l’initiateur du côté francophone, Serge Doubrovsky, a modifié la définition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
