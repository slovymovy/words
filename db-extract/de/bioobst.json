                "senses": [
                    {
                        "sense_id": "09d56ef2-65c3-3ea5-ba28-13119f0f5846",
                        "entry_id": "52e34f85-8aac-315d-8d23-61e2841af31e",
                        "glosses": [
                            "Obst, das aus ökologischer Landwirtschaft und umweltfreundlicher Herstellung stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df013789-e96f-4173-b2e8-944ef7b45186",
                                "sense_id": "09d56ef2-65c3-3ea5-ba28-13119f0f5846",
                                "text": "„Sie ist draußen auf der Straße, im Arm eine Papiertüte voll Bioobst und -gemüse, aus der oben Blumen herausragen.“"
                            },
                            {
                                "example_id": "a177c5a7-b0b3-4e22-9acc-14c541910963",
                                "sense_id": "09d56ef2-65c3-3ea5-ba28-13119f0f5846",
                                "text": "„Alle großen Lebensmittelketten, ob Giant oder Safeway, haben heute eigene Abteilungen für Biogemüse und Bioobst, die jedes Jahr mehr Raum einnehmen.“"
                            },
                            {
                                "example_id": "e86486aa-51c4-400e-9f03-9171d47eba90",
                                "sense_id": "09d56ef2-65c3-3ea5-ba28-13119f0f5846",
                                "text": "„Ihr Bioobst und Biogemüse war so gefragt, dass sie mit Leichtigkeit doppelt so viel verkaufen konnten wie momentan.“"
                            },
                            {
                                "example_id": "da54de6f-5a11-44e1-8147-2141acec9ff8",
                                "sense_id": "09d56ef2-65c3-3ea5-ba28-13119f0f5846",
                                "text": "„Seit Jahren stagniert der Anteil ökologischer Anbauflächen in Deutschland trotz boomender Nachfrage nach Bioobst und -gemüse.“"
                            },
                            {
                                "example_id": "20b313da-a3fd-4c43-b205-3d27a40fd1c2",
                                "sense_id": "09d56ef2-65c3-3ea5-ba28-13119f0f5846",
                                "text": "„Wieder anders sieht es bei frischem Bioobst, Biogemüse und Biotee aus: In 75 Prozent dieser Produkte waren gar keine Pestizide nachweisbar, dies war nur bei 16 Prozent der konventionellen Tees und Früchte der Fall.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
