{
    "word_family": [
        "prullaria",
        "prullenbak",
        "prullig"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e2b0bba4-1fa7-3674-a050-ae4e7d1a3145",
                    "sense_definition": "Een waardeloos of nutteloos voorwerp; prullaria of rommel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "waardeloos_voorwerp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik moet eens al die nutteloze <w>prullen</w> op zolder weggooien.",
                            "target_lang_translations": {
                                "en": "I really need to throw away all those useless <w>pieces of junk</w> in the attic.",
                                "ru": "Мне нужно как-нибудь выбросить весь этот бесполезный <w>хлам</w> с чердака."
                            }
                        },
                        {
                            "text": "Zij kocht een goedkope <w>prul</w> op de rommelmarkt die al snel kapotging.",
                            "target_lang_translations": {
                                "en": "She bought a cheap <w>trinket</w> at the flea market that broke very quickly.",
                                "ru": "Она купила на блошином рынке дешевую <w>безделушку</w>, которая быстро сломалась."
                            }
                        }
                    ],
                    "synonyms": [
                        "rommel",
                        "prullaria",
                        "snuisterij"
                    ],
                    "common_phrases": [
                        "nutteloze prullen",
                        "goedkope prul"
                    ],
                    "target_lang_definitions": {
                        "en": "A worthless or useless object; junk or trinkets.",
                        "ru": "Бесполезный или никчемный предмет; безделушка или хлам."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tat",
                                "target_lang_sense_clarification": "cheap, tasteless, useless goods"
                            },
                            {
                                "target_lang_word": "scrap",
                                "target_lang_sense_clarification": "discarded objects or junk"
                            },
                            {
                                "target_lang_word": "trinket",
                                "target_lang_sense_clarification": "a small ornament or item of little value"
                            },
                            {
                                "target_lang_word": "piece of junk",
                                "target_lang_sense_clarification": "a worthless object"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "безделушка",
                                "target_lang_sense_clarification": "дешевая, малоценная вещь"
                            },
                            {
                                "target_lang_word": "хлам",
                                "target_lang_sense_clarification": "ненужные вещи, барахло"
                            },
                            {
                                "target_lang_word": "дрянь",
                                "target_lang_sense_clarification": "некачественная вещь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fb06aee-e41e-307e-831c-222c287c1e54",
                    "sense_definition": "Een liefkozende benaming voor een klein kind, in het bijzonder een meisje.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "liefkozend_kind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kom eens hier, kleine <w>prul</w> van me.",
                            "target_lang_translations": {
                                "en": "Come here, my <w>little one</w>.",
                                "ru": "Иди-ка сюда, моя маленькая <w>крошка</w>."
                            }
                        },
                        {
                            "text": "Het kleine <w>prulletje</w> lag heerlijk te slapen in de wieg.",
                            "target_lang_translations": {
                                "en": "The tiny <w>tot</w> was sleeping wonderfully in the cradle.",
                                "ru": "Маленькая <w>кроха</w> сладко спала в колыбели."
                            }
                        }
                    ],
                    "synonyms": [
                        "kleintje",
                        "dreumes"
                    ],
                    "common_phrases": [
                        "kleine prul"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used affectionately"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An affectionate term for a small child, especially a little girl.",
                        "ru": "Ласковое обращение к маленькому ребенку, особенно к девочке."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tot",
                                "target_lang_sense_clarification": "a very young child"
                            },
                            {
                                "target_lang_word": "little one",
                                "target_lang_sense_clarification": "affectionate term for a child"
                            },
                            {
                                "target_lang_word": "rascal",
                                "target_lang_sense_clarification": "affectionate term for a small child"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "крошка",
                                "target_lang_sense_clarification": "ласково о маленьком ребенке"
                            },
                            {
                                "target_lang_word": "малышка",
                                "target_lang_sense_clarification": "ласковое обращение к девочке"
                            },
                            {
                                "target_lang_word": "карапуз",
                                "target_lang_sense_clarification": "о маленьком ребенке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b201619a-441e-3279-a251-dfe4ad0a231d",
                    "sense_definition": "Een waardeloze, onhandige of onaangename man; een loser.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "waardeloos_persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat een <w>prul</w> is die vent, hij kan ook werkelijk niets goed doen.",
                            "target_lang_translations": {
                                "en": "What a <w>loser</w> that guy is, he really can't do anything right.",
                                "ru": "Что за <w>ничтожество</w> этот парень, он действительно ничего не умеет делать нормально."
                            }
                        },
                        {
                            "text": "Iedereen vond hem een luie <w>prul</w> die nooit zijn verantwoordelijkheid nam.",
                            "target_lang_translations": {
                                "en": "Everyone thought he was a lazy <w>good-for-nothing</w> who never took responsibility.",
                                "ru": "Все считали его ленивым <w>неудачником</w>, который никогда не брал на себя ответственность."
                            }
                        }
                    ],
                    "synonyms": [
                        "loser",
                        "nietsnut",
                        "klungel"
                    ],
                    "common_phrases": [
                        "waardeloze prul"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "pejorative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A worthless, clumsy, or unpleasant man; a loser.",
                        "ru": "Никчемный, неуклюжий или неприятный мужчина; неудачник."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "loser",
                                "target_lang_sense_clarification": "a worthless or unsuccessful person"
                            },
                            {
                                "target_lang_word": "good-for-nothing",
                                "target_lang_sense_clarification": "a lazy or useless person"
                            },
                            {
                                "target_lang_word": "clump",
                                "target_lang_sense_clarification": "a clumsy or useless man"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ничтожество",
                                "target_lang_sense_clarification": "никчемный человек"
                            },
                            {
                                "target_lang_word": "неудачник",
                                "target_lang_sense_clarification": "человек, у которого ничего не получается"
                            },
                            {
                                "target_lang_word": "рохля",
                                "target_lang_sense_clarification": "неуклюжий, нерасторопный человек"
                            }
                        ]
                    }
                }
            ]
        }
    ]
