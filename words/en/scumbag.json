{
    "word_family": [
        "scum",
        "scummy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bce7f679-1e26-36f3-9d44-8415f68a5003",
                    "sense_definition": "A sleazy, disreputable, or despicable person who lacks moral principles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "despicable person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot believe that <w>scumbag</w> stole money from his own grandmother's purse.",
                            "target_lang_translations": {
                                "ru": "Не могу поверить, что этот <w>подонок</w> украл деньги из кошелька собственной бабушки."
                            }
                        },
                        {
                            "text": "The local <w>scumbag</w> was finally arrested after years of cheating people out of their savings.",
                            "target_lang_translations": {
                                "ru": "Местный <w>отморозок</w> был наконец арестован после того, как годами выманивал у людей их сбережения."
                            }
                        },
                        {
                            "text": "He is a total <w>scumbag</w> for leaving his team right before the championship game.",
                            "target_lang_translations": {
                                "ru": "Он просто конченая <w>гнида</w>, раз бросил свою команду прямо перед чемпионским матчем."
                            }
                        }
                    ],
                    "synonyms": [
                        "dirtbag",
                        "lowlife",
                        "sleazebag",
                        "scoundrel",
                        "bastard"
                    ],
                    "antonyms": [
                        "saint",
                        "gentleman"
                    ],
                    "common_phrases": [
                        "total scumbag",
                        "lying scumbag",
                        "absolute scumbag"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "highly informal and insulting"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подлый, заслуживающий презрения или беспринципный человек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подонок",
                                "target_lang_sense_clarification": "человек, вызывающий отвращение и презрение"
                            },
                            {
                                "target_lang_word": "гнида",
                                "target_lang_sense_clarification": "гадкий, ничтожный человек"
                            },
                            {
                                "target_lang_word": "отморозок",
                                "target_lang_sense_clarification": "человек без нравственных принципов"
                            },
                            {
                                "target_lang_word": "мразь",
                                "target_lang_sense_clarification": "крайне презрительное обозначение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0fcc39f-db06-349f-af5c-a77c262d23ff",
                    "sense_definition": "A slang term for a condom.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "contraception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some older dialects, a <w>scumbag</w> was simply another word for a rubber.",
                            "target_lang_translations": {
                                "ru": "В некоторых старых диалектах слово «<w>scumbag</w>» было просто еще одним названием презерватива."
                            }
                        },
                        {
                            "text": "He used the term <w>scumbag</w> to refer to a pro-phy-lac-tic during the conversation.",
                            "target_lang_translations": {
                                "ru": "В разговоре он использовал термин «<w>scumbag</w>» для обозначения средства контрацепции."
                            }
                        }
                    ],
                    "synonyms": [
                        "condom",
                        "rubber"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "vulgar and dated"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "this meaning is less common than the insult"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое название презерватива."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "презерватив",
                                "target_lang_sense_clarification": "основной термин"
                            },
                            {
                                "target_lang_word": "резинка",
                                "target_lang_sense_clarification": "разговорный сленг"
                            }
                        ]
                    }
                }
            ]
        }
    ]
