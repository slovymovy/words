                "senses": [
                    {
                        "sense_id": "fd7c7570-dce9-363a-9c9d-60dbabe318aa",
                        "entry_id": "29b6c59a-3b34-32ed-8f11-e4f5460a80d0",
                        "glosses": [
                            "Partie du plumage des oiseaux portée par le pouce et composée des rémiges bâtardes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b39ae35d-91be-4154-ac44-7a689a30324a",
                                "sense_id": "fd7c7570-dce9-363a-9c9d-60dbabe318aa",
                                "text": "Trois à cinq plumes roides , fort petites, taillées en lame et insérées au pouce, forment ce qu'on nomme aile bâtarde , aile fausse , aileron , alule ou fouet de l' aile."
                            }
                        ]
                    },
                    {
                        "sense_id": "d7386e17-37c3-3047-9e1d-6729c0e34d30",
                        "entry_id": "29b6c59a-3b34-32ed-8f11-e4f5460a80d0",
                        "glosses": [
                            "Lobe membraneux situé à la base de l'aile de certains diptères, du côté postérieur de l'aile, et qui est le plus interne des lobes (s'il y en a deux)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e4b630d-b6ec-4b43-9bdd-73c003df14db",
                                "sense_id": "d7386e17-37c3-3047-9e1d-6729c0e34d30",
                                "text": "A la base de l'aile les alules varient ; quant aux squames ou cueillerons ils sont toujours bien développés, ciliés, tout particulièrement les thoraciques. L' abdomen offre un nombre variable de segments visibles, de quatre à cinq chez les mâles ..."
                            }
                        ]
                    }
                ],
