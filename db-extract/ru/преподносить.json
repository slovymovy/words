                        "examples": [
                            {
                                "example_id": "1fd61d51-f6ab-439a-bfe6-ac3879f7a151",
                                "sense_id": "40a76bdb-68c1-3b8d-9259-71ee10f200e6",
                                "text": "Он преподно́сит ей кни́гу.",
                                "translation": "He is presenting a book to her. / He is presenting her with a book.",
                                "english": "He is presenting a book to her. / He is presenting her with a book."
                            },
                            {
                                "example_id": "ca6553fd-d0e6-4ce7-bf3c-5ccff61269c4",
                                "sense_id": "40a76bdb-68c1-3b8d-9259-71ee10f200e6",
                                "text": "преподноси́ть в гото́вом ви́де что́-либо кому́-либо",
                                "translation": "to hand something to someone on a plate",
                                "english": "to hand something to someone on a plate"
                            },
                            {
                                "example_id": "c161540c-787d-4efb-841e-4157c5df6e7d",
                                "sense_id": "40a76bdb-68c1-3b8d-9259-71ee10f200e6",
                                "text": "преподноси́ть сюрпри́з кому́-либо",
                                "translation": "to give someone a surprise",
                                "english": "to give someone a surprise"
                            }
                        ]
                    },
                    {
                        "sense_id": "e4d1e3ee-9284-3f43-bb3c-31f60da9baee",
