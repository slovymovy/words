                "senses": [
                    {
                        "sense_id": "d48b3ed2-977f-3d7b-bd96-5ea86d597c8a",
                        "entry_id": "82b37ee0-78ba-35d1-8159-d5901d3353b6",
                        "glosses": [
                            "Donner un caractère ancien à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5682b5e4-bb88-40e2-976d-80d9df92e453",
                                "sense_id": "d48b3ed2-977f-3d7b-bd96-5ea86d597c8a",
                                "text": "Et mon Rudolphe perso, que j’ai fini par ancienniser tellement j’en avais honte."
                            },
                            {
                                "example_id": "2ae7b154-60b1-485e-8f2d-2fc5725824b6",
                                "sense_id": "d48b3ed2-977f-3d7b-bd96-5ea86d597c8a",
                                "text": "Tu l’avais anciennisé alors et bien fait aparemment ^([sic : apparemment]) !"
                            },
                            {
                                "example_id": "77b4a1c5-aaf6-46ac-bbd8-c71fab20a877",
                                "sense_id": "d48b3ed2-977f-3d7b-bd96-5ea86d597c8a",
                                "text": "Et pourquoi ne dirions-nous pas : il faut nous africaniser à l’ancienne ou bien nous ancienniser à l’africaine ?"
                            }
                        ]
                    }
