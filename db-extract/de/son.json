                "senses": [
                    {
                        "sense_id": "c3dfcf60-b2dc-37f9-8e30-ada474a1d131",
                        "entry_id": "6b91eaf4-672c-37ce-936a-93f30b184209",
                        "glosses": [
                            "Sohn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09d56ed5-54f3-4709-8838-0fc627e0c8dc",
                                "sense_id": "c3dfcf60-b2dc-37f9-8e30-ada474a1d131",
                                "text": "„Were abir, daz der selbe irste geborn son von dirre wernde vor virfüre ane knabin-irbin eliche leie, so sal von crafft dis keisirlichis gesetzis recht stimme und gewalt der kure fallin uf den altirn brudir leie, der von warem fedirlichim stamme ist komen, und danach uff des seibin irstin geborn sone;“"
                            },
                            {
                                "example_id": "8407b7e6-3a10-47f4-ab32-89f64e2c120b",
                                "sense_id": "c3dfcf60-b2dc-37f9-8e30-ada474a1d131",
                                "text": "„Wer an den Son gleubet, der hat das ewige Leben, Wer dem Son nicht gleubet, der wird das Leben nicht sehen, Sondern der zorn Gottes bleibt vber jm.“"
                            },
                            {
                                "example_id": "2259428f-7739-450c-8e21-016a36dda4ec",
                                "sense_id": "c3dfcf60-b2dc-37f9-8e30-ada474a1d131",
                                "text": "„Mein Son / stee ab von dem Irrthumb vnd widerrüeffs / erhalt dein Jungs leben“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
