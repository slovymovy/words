                                        "entry_id": "77ae0838-a4a4-3607-b861-dc4ce9d461c5",
                                        "glosses": [
                                            "technische Vorrichtung mit Mikrofon und Lautsprecher (besonders in Autos beim Fahren), mit dessen Hilfe man telefonieren kann, ohne das Handy oder Telefon in die Hand nehmen zu müssen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "544a4d82-3cbc-4dd3-9a5d-5577115f10b4",
                                                "sense_id": "1a287ee0-d294-3200-8b22-4b39945127bb",
                                                "text": "Das Auto ist mit einer Freisprecheinrichtung ausgestattet."
                                            },
                                            {
                                                "example_id": "2a733032-cada-45f5-93f4-e64009b4c191",
                                                "sense_id": "1a287ee0-d294-3200-8b22-4b39945127bb",
                                                "text": "„Das Telefonieren mit Mobiltelefon ist dem Fahrer nur mittels Freisprecheinrichtung erlaubt.“"
                                            },
                                            {
                                                "example_id": "b6fc1f7e-5036-4812-98c6-86df1dee748a",
                                                "sense_id": "1a287ee0-d294-3200-8b22-4b39945127bb",
                                                "text": "„Dabei war ihr Helm so konzipiert, dass eine Freisprecheinrichtung im Innern eingebaut war und somit die Fahrgeräusche größtenteils dämpfte, die ihr energisches Motorrad von sich gab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
