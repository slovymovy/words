                            {
                                "example_id": "a80e5d8e-fa4f-40da-ac30-10997daa53c0",
                                "sense_id": "896c8ca3-09c9-3faa-9f78-2e7d50e4600d",
                                "text": "Zenonie, na kiedy przypadają twoje imieniny?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b809fa5b-09ec-4d92-83e1-8e503f4bf077",
                        "source_entry_id": "2b8979ab-e007-3302-bf2a-816e64cfa164",
                        "source_sense_id": "896c8ca3-09c9-3faa-9f78-2e7d50e4600d",
                        "target_lang_word": "Zeno",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeno",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "605c6b50-82c7-3de2-9d56-5fedb296410f",
                                        "entry_id": "4098af67-d5de-3fb9-bb4a-82fccf3e2620",
                                        "glosses": [
                                            "A male given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Zeno",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8d7e362-d331-3e00-a839-16f10e9b66c9",
                                        "entry_id": "3af2b9b6-f58d-3f19-926b-d79d22701fa9",
                                        "glosses": [
                                            "Requiring or involving an infinite number of intervals within a finite time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c21b1641-5854-40fe-8410-bf3ce8b10eed",
                                                "sense_id": "e8d7e362-d331-3e00-a839-16f10e9b66c9",
                                                "text": "It is therefore important to be able to determine if a model is Zeno and in applicable cases remove Zenoness."
                                            },
                                            {
                                                "example_id": "1061b038-e88b-4820-b65d-3966a7bde5db",
                                                "sense_id": "e8d7e362-d331-3e00-a839-16f10e9b66c9",
                                                "text": "While this system is not Zeno, it can nevertheless not be considered implementable; thus, the boundedness of activity seems to be a more appropriate abstract concept of implementability of a system with respect to the amount of activity in finite intervals of time."
                                            },
                                            {
                                                "example_id": "fdcfd26f-b7e6-40c4-bdad-dbc03e127e43",
                                                "sense_id": "e8d7e362-d331-3e00-a839-16f10e9b66c9",
                                                "text": "That is, it is necessary to check whether a run is Zeno so as to avoid presenting Zeno runs as counterexamples."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22a194ee-54f0-4c6d-8077-262591504e12",
