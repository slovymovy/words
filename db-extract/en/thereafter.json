                                "target_senses": [
                                    {
                                        "sense_id": "e02862c9-8c3d-3a7b-8f80-9aaee541fe71",
                                        "entry_id": "6e1ea09b-de09-38c3-851c-50e0625b253c",
                                        "glosses": [
                                            "Et venant ensuite, comme conséquence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "553b5513-ddc5-45b1-b28b-2412ae7d7378",
                                                "sense_id": "e02862c9-8c3d-3a7b-8f80-9aaee541fe71",
                                                "text": "Je demeurai avec eux jusqu’à ce qu’ils eussent amassé la quantité de poivre qu'ils voulurent; après quoi ils me firent embarquer sur le bâtiment qui les avait amenés, et nous nous rendîmes dans une autre île d'où ils étaient venus."
                                            },
                                            {
                                                "example_id": "5e49f872-4140-4d01-933d-d082760b51e0",
                                                "sense_id": "e02862c9-8c3d-3a7b-8f80-9aaee541fe71",
                                                "text": "Parpoil et Gaspard demeurèrent immobiles pendant une seconde, après quoi Gaspard tourna les talons et regrimpa l’escalier quatre à quatre."
                                            },
                                            {
                                                "example_id": "b3d21acc-877b-48e3-988f-8a7c4c9c8e8b",
                                                "sense_id": "e02862c9-8c3d-3a7b-8f80-9aaee541fe71",
                                                "text": "Monsieur Saito me présenta brièvement à l'assemblée. Après quoi il me demanda si j'aimais les défis"
                                            },
                                            {
                                                "example_id": "6e8193ef-92d3-42ac-aa46-c814f2b37f32",
                                                "sense_id": "e02862c9-8c3d-3a7b-8f80-9aaee541fe71",
                                                "text": "Je commençai par envoyer mon verre de whisky dans la figure du premier lieutenant, une claque du revers de la main dans la figure du second, après quoi, je m'assis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11ffd7f4-d7a0-4409-8b54-605ef600a581",
                        "source_entry_id": "e27b7ad0-b3d4-33d4-a9c4-0afb1ccb27ef",
                        "source_sense_id": "2253aa8d-a158-3942-b8e2-a7cb655683cd",
                        "source_sense_description": "after that",
                        "target_lang_word": "à la suite de quoi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
