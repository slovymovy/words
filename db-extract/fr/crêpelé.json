                        "sense_id": "b09939f7-23b4-3416-8351-1dc917112c8e",
                        "entry_id": "6ebbce99-21ea-3e1e-97ef-740c2e86e434",
                        "glosses": [
                            "Qui est frisé en boucles menues."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7d437c53-7b70-4633-a71f-592fddcc9b9e",
                                "sense_id": "b09939f7-23b4-3416-8351-1dc917112c8e",
                                "text": "Ses cheveux crêpelés aux nattes abondantes."
                            },
                            {
                                "example_id": "03ace814-2aca-4b70-9254-62b2c52e0126",
                                "sense_id": "b09939f7-23b4-3416-8351-1dc917112c8e",
                                "text": "D’autres pas, nets et vifs, sonnèrent sur les silex bossus. Un corsage lilas, un buisson de cheveux crêpelés, d’un rose de cuivre, éclairèrent le haut de la rue.\n « – Hou ! la rousse ! souffla le cadet. Hou ! la carotte ! »\nIl n’avait que quatorze ans, et voulait du mal aux « filles », qui l’éblouissaient d’une lumière trop crue."
                            },
                            {
                                "example_id": "9f269a0e-413c-4e97-973f-5ca9f90964b9",
                                "sense_id": "b09939f7-23b4-3416-8351-1dc917112c8e",
                                "text": "Les cheveux crêpelés à la mode du temps encadrent un visage dont les sombres yeux regardent devant soi, ou peut-être ne regardent pas, mais songent."
                            }
                        ]
                    }
