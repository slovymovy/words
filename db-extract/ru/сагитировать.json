                "translations": [
                    {
                        "translation_id": "b3f72f55-e145-40c5-be8b-897225dde6c1",
                        "source_entry_id": "b8598108-3ceb-37a1-82c4-6f80a6493632",
                        "source_sense_id": "d81d51a5-339d-3415-b806-f4c338a6f1c5",
                        "target_lang_word": "agitate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agitate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc118682-8d07-3045-9167-b954664ac8c7",
                                        "entry_id": "87589617-f8d1-3afe-9d87-e3fe570af456",
                                        "glosses": [
                                            "To disturb or excite; to perturb or stir up (a person)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18369527-cbdf-40c2-a6ba-13cd1385e8d0",
                                                "sense_id": "bc118682-8d07-3045-9167-b954664ac8c7",
                                                "text": "He was greatly agitated by the news."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5b43710-5cbe-35b2-a208-df1adcdc84ba",
                                        "entry_id": "87589617-f8d1-3afe-9d87-e3fe570af456",
                                        "glosses": [
                                            "To cause to move with a violent, irregular action; to shake."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb06785d-cc19-45fe-b860-ba79eb825632",
                                                "sense_id": "e5b43710-5cbe-35b2-a208-df1adcdc84ba",
                                                "text": "to agitate water in a vessel"
                                            },
                                            {
                                                "example_id": "b5ae829b-cf57-4f25-abf8-bd45695eebcb",
                                                "sense_id": "e5b43710-5cbe-35b2-a208-df1adcdc84ba",
                                                "text": "The wind agitates the sea."
                                            },
                                            {
                                                "example_id": "026b6301-d315-45a6-ae01-ac172e41c67b",
                                                "sense_id": "e5b43710-5cbe-35b2-a208-df1adcdc84ba",
                                                "text": "It was a dark and stormy night; the rain fell in torrents — except at occasional intervals, when it was checked by a violent gust of wind which swept up the streets (for it is in London that our scene lies), rattling along the housetops, and fiercely agitating the scanty flame of the lamps that struggled against the darkness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6608af2b-cd6d-3e4d-8f20-5d6024656ffa",
                                        "entry_id": "87589617-f8d1-3afe-9d87-e3fe570af456",
                                        "glosses": [
                                            "To participate in political agitation (sense 3)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "866d3561-2c45-4be2-b76a-1a4a9cc1e76b",
                                                "sense_id": "6608af2b-cd6d-3e4d-8f20-5d6024656ffa",
                                                "text": "NAMBLA is working to build a coalition of gay, lesbian, progressive and civil liberties groups to agitate against the increasing state attacks on gay men who associate with boys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76740686-b83f-3ae8-b8c7-cff45278ec07",
                                        "entry_id": "87589617-f8d1-3afe-9d87-e3fe570af456",
                                        "glosses": [
                                            "To set in motion; to actuate."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5e38b83-0fa5-33ad-b82d-69a096644661",
                                        "entry_id": "87589617-f8d1-3afe-9d87-e3fe570af456",
                                        "glosses": [
                                            "To discuss or debate."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e3280a6-1c14-49a3-9377-4e9d4eff7982",
                                                "sense_id": "a5e38b83-0fa5-33ad-b82d-69a096644661",
                                                "text": "Your speech at the time a bill for the regency was agitated now lies before me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7a048f7-231f-3bfa-a7f8-18a1f9d3fde2",
                                        "entry_id": "87589617-f8d1-3afe-9d87-e3fe570af456",
                                        "glosses": [
                                            "To mull over, or think deeply about; to consider, to devise."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e018b0d0-8a11-4fb4-9c2c-ab80384f07fd",
                                                "sense_id": "e7a048f7-231f-3bfa-a7f8-18a1f9d3fde2",
                                                "text": "Politicians agitate desperate designs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "678e32c9-931d-4c8b-b369-079cac943735",
                        "source_entry_id": "b8598108-3ceb-37a1-82c4-6f80a6493632",
                        "source_sense_id": "d81d51a5-339d-3415-b806-f4c338a6f1c5",
                        "target_lang_word": "persuade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "persuade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "108cf763-9258-3f49-969f-3fd1beb0b262",
                                        "entry_id": "083640a3-b615-30c2-b1e6-5c61cce86977",
                                        "glosses": [
                                            "To successfully convince (someone) to agree to, accept, or do something, usually through reasoning and verbal influence."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0254f825-ee4b-4778-b6df-c761ec899bf5",
                                                "sense_id": "108cf763-9258-3f49-969f-3fd1beb0b262",
                                                "text": "That salesman was able to persuade me into buying this bottle of lotion."
                                            },
                                            {
                                                "example_id": "c58ed8b3-6018-4d40-bc66-02ca5952df64",
                                                "sense_id": "108cf763-9258-3f49-969f-3fd1beb0b262",
                                                "text": "[VV]e are able with playne demonſtration to proue, and vvith reaſon to perſvvade that in tymes paſt our fayth vvas alike, that then vve preached thinges correſpondent vnto the forme of faith already published of vs, ſo that none in this behalfe can repyne or gaynesay vs."
                                            },
                                            {
                                                "example_id": "c95baee3-69e5-4104-90a9-88931a888c9e",
                                                "sense_id": "108cf763-9258-3f49-969f-3fd1beb0b262",
                                                "text": "We will persuade him, be it possible."
                                            },
                                            {
                                                "example_id": "c233eaf7-83c9-4e9a-bf7f-c32a641ceec7",
                                                "sense_id": "108cf763-9258-3f49-969f-3fd1beb0b262",
                                                "text": "The boy became volubly friendly and bubbling over with unexpected humour and high spirits. He tried to persuade Cicely to stay away from the ball-room for a fourth dance. Nobody would miss them, he explained."
                                            },
                                            {
                                                "example_id": "5cfbccc1-8796-43ae-abdf-f2c08bce004f",
                                                "sense_id": "108cf763-9258-3f49-969f-3fd1beb0b262",
                                                "text": "The most persistent tormentor was Alex Oxlade-Chamberlain, who scored a hat-trick in last month’s corresponding fixture in Iceland. His ability to run at defences is instantly striking, but it is his clever use of possession that has persuaded some shrewd judges that he is an even better prospect than Theo Walcott."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e310063-6181-3be0-8c60-5184a580dc13",
                                        "entry_id": "083640a3-b615-30c2-b1e6-5c61cce86977",
                                        "glosses": [
                                            "To convince of by argument, or by reasons offered or suggested from reflection, etc.; to cause to believe (something)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31d307c1-a50f-4bd4-af77-c12b4377bdfb",
                                                "sense_id": "9e310063-6181-3be0-8c60-5184a580dc13",
                                                "text": "But beloued, wee are perswaded better things of you, and things that accompany saluation, though we thus speake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2993a0f-a532-3c27-8623-9b008b80263e",
                                        "entry_id": "083640a3-b615-30c2-b1e6-5c61cce86977",
                                        "glosses": [
                                            "To urge, plead; to try to convince (someone to do something)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "regional",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f17c1da2-4fcf-4b99-a1ad-1d21c98e0bf4",
                                                "sense_id": "b2993a0f-a532-3c27-8623-9b008b80263e",
                                                "text": "[…] and hearken not vnto Hezekiah, when hee perswadeth you, saying, The Lord will deliuer vs."
                                            },
                                            {
                                                "example_id": "15629ce2-d5ae-47e4-b080-a23595c752dc",
                                                "sense_id": "b2993a0f-a532-3c27-8623-9b008b80263e",
                                                "text": "She did not go into the coffee-room, though repeatedly persuaded by Miss Woodley, but waited at the door till her carriage drew up."
                                            },
                                            {
                                                "example_id": "7de7b877-6385-4fe1-bf14-b60193ebcbff",
                                                "sense_id": "b2993a0f-a532-3c27-8623-9b008b80263e",
                                                "text": "He persuaded me to go home, but I refused."
                                            },
                                            {
                                                "example_id": "14685ac2-5747-4b52-87d7-c8508a1c119f",
                                                "sense_id": "b2993a0f-a532-3c27-8623-9b008b80263e",
                                                "text": "He did not persuade me long before I consented."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
