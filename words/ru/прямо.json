{
    "word_family": [
        "прямой",
        "прямота",
        "прямиком",
        "напрямик",
        "выпрямить",
        "спрямить",
        "прямолинейный"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "0fd81b36-5e91-3d27-8ed8-b2b59c840202",
                    "sense_definition": "В прямом направлении, ровно, не сворачивая в сторону.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Идите <w>прямо</w> по коридору, а потом поверните налево.",
                            "target_lang_translations": {
                                "en": "Go <w>straight</w> down the corridor, and then turn left.",
                                "zh": "沿着走廊<w>一直</w>走，然后向左转。"
                            }
                        },
                        {
                            "text": "Дорога шла <w>прямо</w> через густой лес.",
                            "target_lang_translations": {
                                "en": "The road went <w>straight</w> through the dense forest.",
                                "zh": "这条路<w>径直</w>穿过了茂密的森林。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ровно"
                    ],
                    "antonyms": [
                        "криво"
                    ],
                    "common_phrases": [
                        "иди прямо",
                        "смотреть прямо",
                        "сидеть прямо"
                    ],
                    "target_lang_definitions": {
                        "en": "In a straight line or direction; moving evenly without turning.",
                        "zh": "指在空间或方向上不弯曲、不偏离地移动。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "straight",
                                "target_lang_sense_clarification": "in a straight line"
                            },
                            {
                                "target_lang_word": "directly",
                                "target_lang_sense_clarification": "without changing direction"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一直",
                                "target_lang_sense_clarification": "表示方向不改变"
                            },
                            {
                                "target_lang_word": "径直",
                                "target_lang_sense_clarification": "直接向某处前进"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fc7447a-69c3-3f30-9ed2-300428fdf80d",
                    "sense_definition": "Указывает на точность места или времени; именно, как раз.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "particle_exact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мяч попал <w>прямо</w> в ворота.",
                            "target_lang_translations": {
                                "en": "The ball went <w>right</w> into the goal.",
                                "zh": "球<w>正好</w>进了球门。"
                            }
                        },
                        {
                            "text": "Мы встретились <w>прямо</w> перед входом в театр.",
                            "target_lang_translations": {
                                "en": "We met <w>right</w> in front of the theater entrance.",
                                "zh": "我们在剧院入口<w>正</w>前方见了面。"
                            }
                        }
                    ],
                    "synonyms": [
                        "именно",
                        "как раз",
                        "точно",
                        "ровно"
                    ],
                    "common_phrases": [
                        "прямо сейчас",
                        "прямо здесь",
                        "прямо в точку"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates precise location or time; exactly.",
                        "zh": "表示位置或时间上的精确性，即正好、恰好。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "right",
                                "target_lang_sense_clarification": "precisely (location or time)"
                            },
                            {
                                "target_lang_word": "straight",
                                "target_lang_sense_clarification": "directly (into/at)"
                            },
                            {
                                "target_lang_word": "exactly",
                                "target_lang_sense_clarification": "precisely"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正好",
                                "target_lang_sense_clarification": "恰好，精确地"
                            },
                            {
                                "target_lang_word": "直接",
                                "target_lang_sense_clarification": "无中间环节地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec8fca22-31c7-3ad7-ab5a-bc07896c8d35",
                    "sense_definition": "Непосредственно, без промежуточных остановок или посредников.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "directness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы отправились с вокзала <w>прямо</w> в гостиницу.",
                            "target_lang_translations": {
                                "en": "We went from the station <w>straight</w> to the hotel.",
                                "zh": "我们从火车站<w>直接</w>去了酒店。"
                            }
                        },
                        {
                            "text": "Он обратился с этим вопросом <w>прямо</w> к директору.",
                            "target_lang_translations": {
                                "en": "He took this question <w>straight</w> to the director.",
                                "zh": "他把这个问题<w>直接</w>提给了经理。"
                            }
                        }
                    ],
                    "synonyms": [
                        "непосредственно"
                    ],
                    "common_phrases": [
                        "прямо к делу",
                        "прямо с завода"
                    ],
                    "target_lang_definitions": {
                        "en": "Without stopping or using intermediaries; directly.",
                        "zh": "指不经过中间环节或停留，直接进行某事。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "straight",
                                "target_lang_sense_clarification": "without detour"
                            },
                            {
                                "target_lang_word": "directly",
                                "target_lang_sense_clarification": "without intermediaries"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "直接",
                                "target_lang_sense_clarification": "无中介地"
                            },
                            {
                                "target_lang_word": "径直",
                                "target_lang_sense_clarification": "不绕道地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1f53bf6-5c96-3c14-9221-3af1ae18fbc2",
                    "sense_definition": "Открыто, честно, без недомолвок и скрытых мыслей.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "honesty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Скажи мне <w>прямо</w>, что ты об этом думаешь.",
                            "target_lang_translations": {
                                "en": "Tell me <w>straight</w> what you think about this.",
                                "zh": "请<w>直率</w>地告诉我你的想法。"
                            }
                        },
                        {
                            "text": "Я ответил ему <w>прямо</w>, не пытаясь оправдаться.",
                            "target_lang_translations": {
                                "en": "I answered him <w>straight</w>, without trying to justify myself.",
                                "zh": "我<w>坦白</w>地回答了他，没有试图辩解。"
                            }
                        }
                    ],
                    "synonyms": [
                        "откровенно",
                        "честно"
                    ],
                    "antonyms": [
                        "уклончиво"
                    ],
                    "common_phrases": [
                        "говорить прямо",
                        "спросить прямо"
                    ],
                    "target_lang_definitions": {
                        "en": "Openly and honestly; without hiding anything.",
                        "zh": "指说话或做事坦率、诚实，不隐瞒。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "straight",
                                "target_lang_sense_clarification": "candidly"
                            },
                            {
                                "target_lang_word": "frankly",
                                "target_lang_sense_clarification": "openly"
                            },
                            {
                                "target_lang_word": "honestly",
                                "target_lang_sense_clarification": "truthfully"
                            },
                            {
                                "target_lang_word": "bluntly",
                                "target_lang_sense_clarification": "without politeness"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "直率",
                                "target_lang_sense_clarification": "坦诚地"
                            },
                            {
                                "target_lang_word": "坦白",
                                "target_lang_sense_clarification": "诚实地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e964c7d-0a88-3611-9e50-90bee90ff47f",
                    "sense_definition": "Выражает удивление или усиление качества; просто, настоящий, буквально.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты сегодня <w>прямо</w> сияешь от счастья!",
                            "target_lang_translations": {
                                "en": "You are <w>positively</w> glowing with happiness today!",
                                "zh": "你今天<w>简直</w>幸福得在发光！"
                            }
                        },
                        {
                            "text": "На улице <w>прямо</w> весна, хотя ещё февраль.",
                            "target_lang_translations": {
                                "en": "It's <w>just</w> like spring outside, even though it's still February.",
                                "zh": "外面<w>简直</w>像春天一样，尽管现在才二月。"
                            }
                        }
                    ],
                    "synonyms": [
                        "просто",
                        "буквально"
                    ],
                    "common_phrases": [
                        "ты прямо герой",
                        "прямо как ребенок"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to emphasize a quality or express surprise; simply, really.",
                        "zh": "用于加强语气，表示惊讶或强调某种特质，相当于“简直”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "just",
                                "target_lang_sense_clarification": "simply, absolutely"
                            },
                            {
                                "target_lang_word": "really",
                                "target_lang_sense_clarification": "truly, in fact"
                            },
                            {
                                "target_lang_word": "positively",
                                "target_lang_sense_clarification": "intensifier"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "简直",
                                "target_lang_sense_clarification": "强调程度"
                            },
                            {
                                "target_lang_word": "简直是",
                                "target_lang_sense_clarification": "用于比喻或强调"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "592b5b13-0fd5-3aa4-a317-8977b157d8a3",
                    "sense_definition": "Ироничное выражение несогласия или недоверия.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "irony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Он обещал всё вернуть завтра. — Ага, <w>прямо</w>! Я ему не верю.",
                            "target_lang_translations": {
                                "en": "— He promised to return everything tomorrow. — <w>Yeah right</w>! I don't believe him.",
                                "zh": "——他说明天会把一切都还回来。——<w>才怪</w>！我才不信他。"
                            }
                        },
                        {
                            "text": "— Я стану космонавтом. — Да <w>прямо</w>, сначала школу закончи.",
                            "target_lang_translations": {
                                "en": "— I'm going to be a cosmonaut. — <w>Yeah right</w>, finish school first.",
                                "zh": "——我要当宇航员。——<w>哪儿啊</w>，先读完书再说吧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "как же",
                        "конечно"
                    ],
                    "common_phrases": [
                        "да прямо",
                        "ага прямо"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An ironic expression of disbelief or disagreement.",
                        "zh": "反讽地表示不相信或不同意。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "yeah right",
                                "target_lang_sense_clarification": "sarcastic disbelief"
                            },
                            {
                                "target_lang_word": "as if",
                                "target_lang_sense_clarification": "sarcastic rejection"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哪儿啊",
                                "target_lang_sense_clarification": "反讽地表示否定"
                            },
                            {
                                "target_lang_word": "才怪",
                                "target_lang_sense_clarification": "表示不相信"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7dc6dfd5-f013-30c5-b5cb-58896d670115",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>прямой</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Её высказывание было <w>прямо</w> и не допускало возражений.",
                            "target_lang_translations": {
                                "en": "Her statement was <w>direct</w> and allowed for no objections.",
                                "zh": "她的发言很<w>直接</w>，不容反驳。"
                            }
                        },
                        {
                            "text": "Дерево выросло <w>прямо</w> и высоко.",
                            "target_lang_translations": {
                                "en": "The tree grew <w>straight</w> and tall.",
                                "zh": "这棵树长得又<w>直</w>又高。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short form of the adjective 'straight' or 'direct'.",
                        "zh": "形容词“直”的短尾形式，表示不弯曲或直接。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "direct",
                                "target_lang_sense_clarification": "straightforward"
                            },
                            {
                                "target_lang_word": "straight",
                                "target_lang_sense_clarification": "not crooked"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "直",
                                "target_lang_sense_clarification": "不弯曲的"
                            },
                            {
                                "target_lang_word": "直接",
                                "target_lang_sense_clarification": "坦率的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}