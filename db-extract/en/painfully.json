                        "target_lang_word": "schmerzhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schmerzhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a7fd1bb3-46ab-3bd8-8f09-c82514b3f84c",
                                        "entry_id": "53f3e4d4-7814-3162-a58a-e80cd99ce548",
                                        "glosses": [
                                            "Schmerzen bereitend, mit Schmerzen verbunden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90bdd63d-2b7b-4b55-969a-faf8f0889f53",
                                                "sense_id": "a7fd1bb3-46ab-3bd8-8f09-c82514b3f84c",
                                                "text": "Das Lecken an der Autobatterie bringt sehr schmerzhafte Verletzungen mit sich."
                                            },
                                            {
                                                "example_id": "4aaa97e2-431b-455e-964b-3acf498e99b2",
                                                "sense_id": "a7fd1bb3-46ab-3bd8-8f09-c82514b3f84c",
                                                "text": "Da die Rentnerin wochenlang im Bett gelegen hatte, bildeten sich schmerzhafte Geschwüre am Rücken und den Fersen."
                                            },
                                            {
                                                "example_id": "82c35f2d-d38e-4cd7-9a41-8c0b5226ea13",
                                                "sense_id": "a7fd1bb3-46ab-3bd8-8f09-c82514b3f84c",
                                                "text": "Die Steuerreform ist mit schmerzhaften Einschnitten für die Bevölkerung verbunden."
                                            },
                                            {
                                                "example_id": "54afba21-06dd-425d-b199-578e4d1f8a44",
                                                "sense_id": "a7fd1bb3-46ab-3bd8-8f09-c82514b3f84c",
                                                "text": "„Man muss kein Medizinexperte sein, um sagen zu können, dass diese Challenge nicht nur schmerzhaft, sondern äußerst gefährlich sein kann.“",
                                                "translation": "„Mit zwei Milliarden Euro Stückpreis wäre ein Verlust noch schmerzhafter als der von Russlands Fliegern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
