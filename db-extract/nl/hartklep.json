                        "entry_id": "4e3a2cd9-2e03-3fda-a0e5-f5b5afa37a84",
                        "glosses": [
                            "hartweefsel in de vorm van een vlies dat samengetrokken door een spiertje terugstromen van het verder gepompte bloed tegengaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50c226cd-69e5-4bcf-be94-9796c5691c27",
                                "sense_id": "b8de076c-12b9-3fb9-848a-26e69104fbe7",
                                "text": "Ik weet ongeveer wat er aan de hand is: een hartklep die niet goed sluit, dus ik neem nauwkeurig mijn pillen en meld mij ieder half jaar bij de poli cardiologie."
                            }
                        ]
                    },
                    {
                        "sense_id": "4abb46c4-0efd-319e-936b-72d318bf7e4c",
                        "entry_id": "4e3a2cd9-2e03-3fda-a0e5-f5b5afa37a84",
                        "glosses": [
                            "doorlaatbare afsluiting onderin een pomp die het terugstromen van de opgepompte vloeistof verhindert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11ea3b3b-08df-401a-a4f6-7611a92d1f13",
                                "sense_id": "4abb46c4-0efd-319e-936b-72d318bf7e4c",
                                "text": "De hartklep wordt omwikkeld met hennep en dat hennep werd vroeger met potvet ingesmeerd, zodat de klep goed sloot."
                            }
                        ]
                    }
                ],
