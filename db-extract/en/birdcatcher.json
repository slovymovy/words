                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "caaac284-c7b9-43a6-aabf-fa51d2b5502e",
                        "source_entry_id": "ce204c70-3f27-3338-b306-cb08b1d26ccc",
                        "source_sense_id": "d7d18b09-5596-3e22-bc97-dcd8bc216488",
