                                        "sense_id": "78129ac0-9b0c-3e2b-8756-fc4edfb68c94",
                                        "entry_id": "488dfe39-3bc3-3766-9506-fc87c437e3b5",
                                        "glosses": [
                                            "религ. согласно Библии, высший по чину ангел; у теологов — предпоследний чин в небесной иерархии"
                                        ],
                                        "tags": [],
