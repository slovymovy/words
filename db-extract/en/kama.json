    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "dcad1b75-a12b-394b-8b04-36e424e6a7d6",
                "word": "Kama",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "056e046c-f169-3a03-a783-f22df2f512ef",
                        "entry_id": "dcad1b75-a12b-394b-8b04-36e424e6a7d6",
                        "glosses": [
                            "A major river in Russia, the longest left tributary of the Volga."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfa18196-a26f-4e87-8796-0a52a0acf1aa",
                                "sense_id": "056e046c-f169-3a03-a783-f22df2f512ef",
                                "text": "It was led by Sen. Henry Javkson (D-Wash.), who referred at some length to an IBM computer and assorted other technology we have sold the Russians for use in their vast Kama River truck plant."
                            },
                            {
                                "example_id": "e4155618-f975-40a3-812d-9ab789f32b7d",
                                "sense_id": "056e046c-f169-3a03-a783-f22df2f512ef",
                                "text": "According to Ponomarev's calculations, the Kama in the 1890s annually supplied the Volga with up to 850000 logs, of which about 250000 came from the Chusovaya, about 250000 from the Vyatka and its tributaries, 150000 from the Belaya,[…]."
                            },
                            {
                                "example_id": "72b330f5-7196-4fbd-bdea-cafd49cb86bb",
                                "sense_id": "056e046c-f169-3a03-a783-f22df2f512ef",
                                "text": "He was ordered to seek out the rebels along the Kama and the Viatka."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "542d8147-bbf8-4af9-b81c-4a6dc536f579",
                        "source_entry_id": "dcad1b75-a12b-394b-8b04-36e424e6a7d6",
                        "source_sense_id": "056e046c-f169-3a03-a783-f22df2f512ef",
                        "source_sense_description": "river",
                        "target_lang_word": "Kama",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kama",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b77711d-581c-3904-a2f5-5cf3181ffd0f",
                                        "entry_id": "3d803d58-7a1a-32b2-a078-0b71f7e8e5d0",
                                        "glosses": [
                                            "Affluent gauche de la Volga."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4aac0842-17c3-48b0-a15e-c75eaef3003e",
                                                "sense_id": "3b77711d-581c-3904-a2f5-5cf3181ffd0f",
                                                "text": "La Kama [est une] grande rivière de l’empire Russien, qui a sa source au pays des Czeremisses, va se perdre après un long cours dans le Wolga, au royaume de Casan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db708e10-6482-46b1-b5fe-1a5f6f3671f2",
                        "source_entry_id": "dcad1b75-a12b-394b-8b04-36e424e6a7d6",
                        "source_sense_id": "056e046c-f169-3a03-a783-f22df2f512ef",
                        "source_sense_description": "river",
                        "target_lang_word": "Kama",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kama",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ebbf1e52-148f-30aa-80ac-2ff0fef0ed91",
                                        "entry_id": "a656cad6-3315-3539-84d3-332235a3f7cd",
                                        "glosses": [
                                            "Nebenfluss der Wolga in Russland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1783069-261b-4e89-833a-2292ad22d6c7",
                                                "sense_id": "ebbf1e52-148f-30aa-80ac-2ff0fef0ed91",
                                                "text": "„Die Stadt Perm am Fluss Kama selbst wurde im Jahr 1647 zum ersten Mal erwähnt, im 19. Jahrhundert war sie eine florierende Handelsstadt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "deb46d5d-f3be-400c-964b-3b5f5be6c5d0",
                        "source_entry_id": "dcad1b75-a12b-394b-8b04-36e424e6a7d6",
                        "source_sense_id": "056e046c-f169-3a03-a783-f22df2f512ef",
                        "source_sense_description": "river",
                        "target_lang_word": "Ка́ма",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ка́ма",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ab410b54-add2-3313-a27c-181f202c3b48",
                                        "entry_id": "b485d417-97dd-31e5-a753-07306d75a199",
                                        "glosses": [
                                            "река в России, Пермском крае, левый приток Волги"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29c7250f-b11d-4dc9-bf55-5435cc38c54e",
                                                "sense_id": "ab410b54-add2-3313-a27c-181f202c3b48",
                                                "text": "Пермь стоит на Каме."
                                            },
                                            {
                                                "example_id": "e83dacc9-a45c-47bd-912d-0df1553352b4",
                                                "sense_id": "ab410b54-add2-3313-a27c-181f202c3b48",
                                                "text": "На территории от Самарской Луки до нижней Камы складывается именьковская культура, последующая история населения которой не оставляет сомнений в принадлежности его к славянскому этносу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1273e13-d9e0-3f36-bea6-2167d93fe1e0",
                                        "entry_id": "b485d417-97dd-31e5-a753-07306d75a199",
                                        "glosses": [
                                            "река в России, левый приток Конды"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2217d529-e917-31c3-8431-62cc1d2bd00f",
                                        "entry_id": "b485d417-97dd-31e5-a753-07306d75a199",
                                        "glosses": [
                                            "река в России впадает в Камское озеро"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "227d2464-4b64-3e52-a494-40485dcd47f3",
                                        "entry_id": "b485d417-97dd-31e5-a753-07306d75a199",
                                        "glosses": [
                                            "название ряда посёлков, деревень и сёл в России"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a0c0f69-595e-41aa-9e0b-55f49b086bdb",
                                                "sense_id": "227d2464-4b64-3e52-a494-40485dcd47f3",
                                                "text": "Спасибо О. В. Чулкову (Истра Московской обл.), С. А. Поповой (Мурманск), В. К. Шумелкину (Иркутск), Н. Переверзевой (пос. Кама)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81831ea7-89ea-3214-9007-2a50434a495c",
                                        "entry_id": "b485d417-97dd-31e5-a753-07306d75a199",
                                        "glosses": [
                                            "торговая марка автомобильных шин"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc0d5dc5-4f52-412c-b8ef-90e7a266dc1a",
                                                "sense_id": "81831ea7-89ea-3214-9007-2a50434a495c",
                                                "text": "Свою «зубилу» под маленькую горочку я разгонял до 155 (дальше на моей Каме 205 очень страшно) ― участок МКАД от Щелковского до Алтуфьевского шоссе."
                                            },
                                            {
                                                "example_id": "c6a3374e-d50c-4b9b-bb88-c65deee4e0ac",
                                                "sense_id": "81831ea7-89ea-3214-9007-2a50434a495c",
                                                "text": "Шины «Кама-503» M+S, 175/70R13, шипованные, почти новые."
                                            },
                                            {
                                                "example_id": "a00a0a2d-078c-4f4b-9ad0-17b38f9fef9c",
                                                "sense_id": "81831ea7-89ea-3214-9007-2a50434a495c",
                                                "text": "«Кама» И-391 Производитель ― Нижнекамск"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c96ad78b-9b67-3e9e-b1b3-6e02de3ac276",
                                        "entry_id": "b485d417-97dd-31e5-a753-07306d75a199",
                                        "glosses": [
                                            "торговая марка велосипедов производства пермского завода «Велта»"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afdff3e9-69bd-47e5-89f4-9118ed54b73c",
                                                "sense_id": "c96ad78b-9b67-3e9e-b1b3-6e02de3ac276",
                                                "text": "Универсальный складной велосипед 113–613 Кама \"- индивидуальное транспортное средство — предназначен для передвижения по дорогам с улучшенным покрытием."
                                            },
                                            {
                                                "example_id": "59366a3c-de26-4b7a-b049-67dcc2aba0e3",
                                                "sense_id": "c96ad78b-9b67-3e9e-b1b3-6e02de3ac276",
                                                "text": "На перемене Тимошин подошел к Антону: ― А у меня новый велосипед «Кама»! ― Ну и радуйся до пенсии, ― уныло ответил Антон."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4260b491-6132-346b-83d3-84a887a130ad",
                                        "entry_id": "b485d417-97dd-31e5-a753-07306d75a199",
                                        "glosses": [
                                            "торговая марка насоса"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bef639d2-f2fd-4afe-a0cc-3e9622944c3b",
                                                "sense_id": "4260b491-6132-346b-83d3-84a887a130ad",
                                                "text": "На мостках устанавливали моторы ― «Каму» или «Агидель» ― качали воду для полива, для бани…"
                                            },
                                            {
                                                "example_id": "33a5f730-da32-4f8c-b746-237f57760b4e",
                                                "sense_id": "4260b491-6132-346b-83d3-84a887a130ad",
                                                "text": "Во всех дворах такое старье давно выкинули. «Кама» ли, «Агидель». Кнопку нажмешь ― потекла вода."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc0cedfe-008b-354e-bf82-9a3ac0655517",
                                        "entry_id": "b485d417-97dd-31e5-a753-07306d75a199",
                                        "glosses": [
                                            "торговая марка лодочного мотора"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dec7b048-c65f-4c79-a21a-8a735fd85dc3",
                                                "sense_id": "dc0cedfe-008b-354e-bf82-9a3ac0655517",
                                                "text": "Катамаран собственной конструкции был собран из двух четырехметровых резиновых баллонов, имел легкую палубу и двигался в основном с помощью мотора «Кама»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11170a7f-a19c-3cfc-a0b0-2193244dd41a",
                                        "entry_id": "b485d417-97dd-31e5-a753-07306d75a199",
                                        "glosses": [
                                            "вид кинжала"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d47c08dc-eba0-4546-a0d0-3e5a50c82be7",
                                                "sense_id": "11170a7f-a19c-3cfc-a0b0-2193244dd41a",
                                                "text": "― Мало ли что они говорят… Смотри, Павел, если обидишь ее… ― Исаев встал, подошел к застекленному шкафу, где хранились всякие сувениры и кубки за производственную деятельность от районных, городских и государственных организаций, а несколько ― призы аж международных выставок (стран СЭВ, естественно), достал оттуда кинжал, вынул из украшенных узорами ножен длинный клинок, узко заостренный, к концу сдержанно загнутый, вид имевший хищный, кровожадный. ― Кинжал «Кама», ― сказал Исаев. ― Родственники подарили на пятьдесят лет."
                                            },
                                            {
                                                "example_id": "8c3cc8a9-b708-4649-978d-3990d69c1ac3",
                                                "sense_id": "11170a7f-a19c-3cfc-a0b0-2193244dd41a",
                                                "text": "Голод и бессилие звали людей к оружию. Кама, серп с деревянной рукояткой Сёгун Ёсимаса долго оставался бездетным и потому усыновил монаха Ёсими, обещая сделать его сёгуном."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a41f5e98-b64c-314a-a671-fe38ed56097f",
                                        "entry_id": "b485d417-97dd-31e5-a753-07306d75a199",
                                        "glosses": [
                                            "спорт. слово, входящее в состав словосочетания, обозначающего стойку карате"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0615d92e-c741-439b-ae11-d6d17f07d645",
                                                "sense_id": "a41f5e98-b64c-314a-a671-fe38ed56097f",
                                                "text": "Положение Кама дачи позволяет из позиции Шизентай мгновенно уйти с линии атаки с проведением контратакующих действий, с последующим быстрым переходом в другую позицию."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ec953ac-d8e3-3e2d-af3d-59c39125fc45",
                                        "entry_id": "b485d417-97dd-31e5-a753-07306d75a199",
                                        "glosses": [
                                            "биол. тип вируса"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc8957e2-0898-48cd-8bf6-60b638904828",
                                                "sense_id": "9ec953ac-d8e3-3e2d-af3d-59c39125fc45",
                                                "text": "Новый вирус Кама (Flaviviridae, Flavivirus, антигенная группа Тюлений), изолированный из клещей Ixodes lividus"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Ка́ма",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "10faef70-4ab8-3e55-86e4-dfa9df33d101",
                                        "entry_id": "065f3445-29ba-3ae5-b340-bcf451b22e07",
                                        "glosses": [
                                            "имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51b0fcff-6d12-4d02-b1d4-e3230078538b",
                                                "sense_id": "10faef70-4ab8-3e55-86e4-dfa9df33d101",
                                                "text": "Чести носить нагрудный знак и тратить денежное вознаграждение в 3 тыс. долларов на сей раз удостоились режиссёр Кама Гинкас (номинация «Лучшая режиссура») и художник Сергей Бархин (номинация «Лучшее оформление спектакля») ― оба отмечены за «Даму с собачкой» в столичном ТЮЗе."
                                            },
                                            {
                                                "example_id": "3e43749a-bd17-4b28-bd98-501590187b29",
                                                "sense_id": "10faef70-4ab8-3e55-86e4-dfa9df33d101",
                                                "text": "― Не узнаю, ― сказал он, ― не взыщи. ― Я же сын Камы, ― сказал я. ― Вот оно что, ― вздохнул Кунта и добавил: ― А я слыхал, что ты в Москве пропал."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec23347d-b8e1-3546-b2f7-8113e2aa8148",
                                        "entry_id": "065f3445-29ba-3ae5-b340-bcf451b22e07",
                                        "glosses": [
                                            "кличка собаки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9faf1dc6-6924-4501-9afe-59a9bc2c1dd8",
                                                "sense_id": "ec23347d-b8e1-3546-b2f7-8113e2aa8148",
                                                "text": "Молодые гончие Ураган и Кама на привязи, а Найда бродит где хочет."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ed644ca-14ef-3654-b5aa-8dde5931e022",
                                        "entry_id": "065f3445-29ba-3ae5-b340-bcf451b22e07",
                                        "glosses": [
                                            "бог любви в индуизме"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8c621fb-5b5c-4e13-94c2-8296021f45e4",
                                                "sense_id": "7ed644ca-14ef-3654-b5aa-8dde5931e022",
                                                "text": "К слову, настоящая Кама Сутра очень интересная и познавательная вещь."
                                            },
                                            {
                                                "example_id": "25d9ae6b-4aaa-4aa5-acec-3000d0905bdd",
                                                "sense_id": "7ed644ca-14ef-3654-b5aa-8dde5931e022",
                                                "text": "Кама (левый приток Волги) ― в индуизме бог любви."
                                            },
                                            {
                                                "example_id": "2155e488-e846-4585-be10-3f0416a01868",
                                                "sense_id": "7ed644ca-14ef-3654-b5aa-8dde5931e022",
                                                "text": "Здесь и волшебные птицы Гаруды, и бог обезьян Хануман, и духи воздуха видьядхари (я не говорю уже про Раму и бога любви Каму)."
                                            },
                                            {
                                                "example_id": "8637d4d8-8c55-4d3c-b4e0-1b57e4399d41",
                                                "sense_id": "7ed644ca-14ef-3654-b5aa-8dde5931e022",
                                                "text": "В давние времена сила Рати и Камы, или, по-европейски, Астарты и Эроса, была гораздо больше."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "92dbf72c-8382-35c1-9da3-715772045c66",
                "word": "Kama",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ce77b508-4024-3416-b34a-d45824f588e2",
                        "entry_id": "92dbf72c-8382-35c1-9da3-715772045c66",
                        "glosses": [
                            "The Hindu god of love, Kamadeva"
                        ],
                        "tags": [
                            "Hinduism"
                        ],
                        "examples": [
                            {
                                "example_id": "d5e4d2ae-d595-4fbb-898b-5f6b64403ea3",
                                "sense_id": "ce77b508-4024-3416-b34a-d45824f588e2",
                                "text": "Fundamentally, the doctrine and technique of Kāma go back to primitive antiquity."
                            },
                            {
                                "example_id": "f9d25a0b-524a-4bc2-b430-bdb141f3c27f",
                                "sense_id": "ce77b508-4024-3416-b34a-d45824f588e2",
                                "text": "In Indian mythology, Kāma is the counterpart of Cupid."
                            },
                            {
                                "example_id": "c5a017a5-5db5-438d-bc7f-ff51c6a949d2",
                                "sense_id": "ce77b508-4024-3416-b34a-d45824f588e2",
                                "text": "On seeing Kāma annihilated there, the Devas and the groups of celestial damsels became frightened."
                            },
                            {
                                "example_id": "6ab581fc-5d40-4954-b138-d07577e8b853",
                                "sense_id": "ce77b508-4024-3416-b34a-d45824f588e2",
                                "text": "However, when Śiva saw the proud Kāma getting ready to let another arrow fly, he got angry."
                            }
                        ]
                    }
                ],
                "translations": [],
