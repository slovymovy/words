                                    },
                                    {
                                        "sense_id": "b9d11b1d-dfb0-398c-a65b-dfe499f3087c",
                                        "entry_id": "ccf90f7a-574f-39b0-ab6c-353bd5e77266",
                                        "glosses": [
                                            "Anything precious or valuable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b71300b-6916-4677-b19e-a80d99c4e8e1",
                                                "sense_id": "b9d11b1d-dfb0-398c-a65b-dfe499f3087c",
                                                "text": "Galveston was the jewel of Texas prior to the hurricane."
                                            },
                                            {
                                                "example_id": "58950538-ee5e-4214-860e-f8faf9261901",
                                                "sense_id": "b9d11b1d-dfb0-398c-a65b-dfe499f3087c",
                                                "text": "Wel, wel (Meander) thou art deepely read:\nAnd hauing thee, I haue a iewell ſure:\nGo on my Lord, and giue your charge I ſay,\nThy wit wil make vs Conquerors to day."
                                            },
                                            {
                                                "example_id": "9467e6bb-4a54-4be4-80dd-111482fd9c01",
                                                "sense_id": "b9d11b1d-dfb0-398c-a65b-dfe499f3087c",
                                                "text": "Had our prince,—\nJewel of children,—seen this hour, he had pair'd\nWell with this lord: there was not full a month\nBetween their births."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef421b70-9795-3802-ab64-4860d01fc92e",
                                        "entry_id": "ccf90f7a-574f-39b0-ab6c-353bd5e77266",
                                        "glosses": [
                                            "A bearing for a pivot in a watch, formed of a crystal or precious stone."
                                        ],
