                "senses": [
                    {
                        "sense_id": "4eac67d6-c339-3cf5-ba92-7b3aaab3418a",
                        "entry_id": "1a146de3-2b01-3ffb-8bc8-c8ab8b2a78a8",
                        "glosses": [
                            "diminutive of за́яц (zájac); (little) hare"
                        ],
                        "tags": [
                            "diminutive",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "9dbadd4b-268c-467f-80ab-94353997cd3f",
                                "sense_id": "4eac67d6-c339-3cf5-ba92-7b3aaab3418a",
                                "text": "Смотри́, како́й ма́ленький за́инька бежи́т!",
                                "translation": "Look, what a small hare running!",
                                "english": "Look, what a small hare running!"
                            },
                            {
                                "example_id": "d985f281-dd91-4775-ba59-c4f975089797",
                                "sense_id": "4eac67d6-c339-3cf5-ba92-7b3aaab3418a",
                                "text": "Се́ла лиса́ по-соба́чьему и за́иньку присе́сть пригласи́ла; и он но́жки под себя́ поджа́л.",
                                "translation": "Mikhail Saltykov-Shchedrin",
                                "english": "Mikhail Saltykov-Shchedrin"
                            }
                        ]
                    },
                    {
                        "sense_id": "844f3083-0b67-372f-b186-1afdee88a88c",
                        "entry_id": "1a146de3-2b01-3ffb-8bc8-c8ab8b2a78a8",
                        "glosses": [
                            "Used as a term of endearment, usually for a child or lover."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c120c70c-66d7-47c4-9417-fde10d82adc5",
                                "sense_id": "844f3083-0b67-372f-b186-1afdee88a88c",
                                "text": "За́инька моя́ люби́мая!",
                                "translation": "My beloved honeybunny!",
                                "english": "My beloved honeybunny!"
                            }
                        ]
                    }
                ],
