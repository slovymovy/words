        "fr-extract.jsonl": [
            {
                "entry_id": "7803e7e8-ff39-3749-b391-3600d9b22f96",
                "word": "préférablement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e1242058-975a-3252-a467-e645aeb52e32",
                        "entry_id": "7803e7e8-ff39-3749-b391-3600d9b22f96",
                        "glosses": [
                            "De préférence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a11aea0-a1d7-49fa-8383-1f8d8fc57be7",
                                "sense_id": "e1242058-975a-3252-a467-e645aeb52e32",
                                "text": "… — le droit à l'héritage, par primogéniture préférablement, parut d'un avantage si manifeste que l'ancien ordre social tendit toujours à généraliser cette institution. (H. G. Wells, Anticipations, 1901, traduction d’Henry-D. Davray et B. Kozakiewicz, Société du Mercure de France, Paris, 1904)"
                            },
                            {
                                "example_id": "ebb3cd77-cc6b-4a51-97e2-0bbd10ad32c9",
                                "sense_id": "e1242058-975a-3252-a467-e645aeb52e32",
                                "text": "Modeste commença par s’assurer la coopération de Françoise Cochet, […], que madame Mignon et madame Dumay prenaient en journée préférablement à toute autre, …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22169095-dfac-4649-b6c4-33457a3b70e1",
                        "source_entry_id": "7803e7e8-ff39-3749-b391-3600d9b22f96",
                        "source_sense_id": "e1242058-975a-3252-a467-e645aeb52e32",
                        "target_lang_word": "vorzugsweise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorzugsweise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "677af59e-68e6-3a0d-a227-7f9c610d88ac",
                                        "entry_id": "8e88a999-b52f-3bc3-b45c-779f4e6d5b04",
                                        "glosses": [
                                            "am liebsten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c77f05bb-23ae-4a0e-bdd4-0bdb43cbbbca",
                                                "sense_id": "677af59e-68e6-3a0d-a227-7f9c610d88ac",
                                                "text": "Obgleich ich mit dem Auto zur Arbeit fahren könnte, nehme ich vorzugsweise das Rad, um in dieser Morgensportübung zu mir zu finden."
                                            },
                                            {
                                                "example_id": "fd9cabad-2c23-43a6-b9b9-34f119f644e5",
                                                "sense_id": "677af59e-68e6-3a0d-a227-7f9c610d88ac",
                                                "text": "„Zu Ikea rückt man vorzugsweise paarweise an, um den Anblick der tausend anderen jungen Paare besser zu ertragen, die wahrscheinlich verliebt bis über beide Ohren über die notwendige Matratzengröße debattieren und darüber, ob sie nun das Bett Gutvik kaufen sollen oder doch eher den Narvik.“"
                                            },
                                            {
                                                "example_id": "23c68823-1647-4957-ab9f-b83dc0730f60",
                                                "sense_id": "677af59e-68e6-3a0d-a227-7f9c610d88ac",
                                                "text": "„Ich finde und habe immer gefunden, daß sich ein Buch gerade vorzugsweise zu einem freundschaftlichen Geschenk eignet. Man liest es oft, man kehrt oft dazu zurück, man nahet sich ihm aber nur in ausgewählten Momenten, braucht es nicht wie eine Tasse, ein Glas, einen Hausrath, so in jedem gleichgültigen Augenblick des Lebens, und erinnert sich so immer des Freundes im Augenblick eines würdigen Genusses.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbad186c-1697-49a8-9beb-e910d8b0cda2",
                        "source_entry_id": "7803e7e8-ff39-3749-b391-3600d9b22f96",
                        "source_sense_id": "e1242058-975a-3252-a467-e645aeb52e32",
                        "target_lang_word": "preferably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "preferably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0e3cb30-efb9-3cec-b9c4-baf1e5de5b7f",
                                        "entry_id": "8bd55a67-bbbc-39fd-9524-d6bdd8a4f25e",
                                        "glosses": [
                                            "In preference; by choice; in a preferable manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0be4a668-29df-47bc-a98d-28c04ac6317f",
                                                "sense_id": "b0e3cb30-efb9-3cec-b9c4-baf1e5de5b7f",
                                                "text": "The nondegerming system grinds corn, preferably white dent corn, into meal with little, if any, separation of germ."
                                            },
                                            {
                                                "example_id": "65e2f976-9730-4477-a761-b8bcc3dfa3a2",
                                                "sense_id": "b0e3cb30-efb9-3cec-b9c4-baf1e5de5b7f",
                                                "text": "He felt having a Micronesian navigator meant he needed a pureblooded Polynesian, preferably a Hawaiian, as captain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
