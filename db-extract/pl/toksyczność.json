                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a2980235-4ad6-33f2-9736-229c6e7ba066",
                                        "entry_id": "03c64c34-35c1-393c-af8b-72f7b625d993",
                                        "glosses": [
                                            "свойство по значению прилагательного ядовитый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eba3964-1f2e-41ae-ba87-68dbb6497031",
                                                "sense_id": "a2980235-4ad6-33f2-9736-229c6e7ba066",
                                                "text": "Он становился на сторону своих диффаматоров, досказывал им сам черты, которые могли бы усилить ядовитость их полемики, и только для себя он не находил никакого оправдания."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
