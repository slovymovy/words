                                    {
                                        "sense_id": "a8cac1d8-9d5d-3ff7-880e-88c8b1b1429c",
                                        "entry_id": "68d95db8-460e-3e1b-803b-734a3b26edaa",
                                        "glosses": [
                                            "pruh látky k ovinutí chodidel do obuvi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "211b89e7-2efa-4872-902c-591eac1744d7",
                                                "sense_id": "a8cac1d8-9d5d-3ff7-880e-88c8b1b1429c",
                                                "text": "Vydal prý také nějakou knihu, myslím že onucologii, totiž návod, jak nejpraktičtěji onuce na noze skládat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "222ffd30-5b68-30bf-a23a-5655243f31ca",
                                        "entry_id": "68d95db8-460e-3e1b-803b-734a3b26edaa",
                                        "glosses": [
                                            "hadr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "647cc948-81eb-42b0-b7f7-a276a3b4ad56",
                                                "sense_id": "222ffd30-5b68-30bf-a23a-5655243f31ca",
                                                "text": "Zde ležely střepy rozličné, onuce a jiné nepotřebné věci, což všecko dohromady nebylo příliš pěkné pro podívání."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8717701-7891-3db3-bd52-8e97be4c9dc3",
                                        "entry_id": "68d95db8-460e-3e1b-803b-734a3b26edaa",
                                        "glosses": [
                                            "bezvýznamný, nicotný člověk"
                                        ],
                                        "tags": [
                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72b37324-9ac6-4ff6-bb62-b4dc67b90772",
                                                "sense_id": "f8717701-7891-3db3-bd52-8e97be4c9dc3",
                                                "text": "Není-li u nás pro schopné lidi dost místa, pak promiňte, to nejsou schopní lidé, nýbrž onuce."
                                            }
                                        ]
                                    }
                                ]
                            },
