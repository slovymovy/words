                    {
                        "sense_id": "d9dc3e11-6474-3c42-9cf4-233f58dc181d",
                        "entry_id": "76090654-c6df-3273-b32f-81b4d9928745",
                        "glosses": [
                            "врач, специализирующийся в области урологии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bcb299c-57cd-4a56-b569-774e1abde27e",
                                "sense_id": "d9dc3e11-6474-3c42-9cf4-233f58dc181d",
                                "text": "Уролог торопился, его звали к тяжёлому пациенту."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c2719ca-1c1f-42be-8e73-2013b5b7464a",
                        "source_entry_id": "76090654-c6df-3273-b32f-81b4d9928745",
                        "source_sense_id": "d9dc3e11-6474-3c42-9cf4-233f58dc181d",
                        "target_lang_word": "urologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d590fdb3-e97b-3d2f-b8b4-5422927abab2",
                                        "entry_id": "220cf29b-9cd6-3837-903f-a0bbb16f430c",
                                        "glosses": [
                                            "A doctor of urology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "041f5a91-2c55-4b2f-9fe0-10b931370ff6",
                                                "sense_id": "d590fdb3-e97b-3d2f-b8b4-5422927abab2",
                                                "text": "Dr. Schirren: The members of this round table keep on speaking about urologists and gynecologists but you never mention andrologists."
                                            },
                                            {
                                                "example_id": "723786d3-9da2-4ec4-97e3-afebfc55e1e8",
                                                "sense_id": "d590fdb3-e97b-3d2f-b8b4-5422927abab2",
                                                "text": "In fact, at the Mayo Clinic in Rochester, Minn., so many men sign up for vasectomies during March Madness that appointments reach “max capacity,” said Dr. Tobias S. Kohler, a urologist and men’s health expert at the medical center who has observed this phenomenon ever since he was an attending physician a decade ago."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3f345c0-b771-4132-9b7d-3c8ba726e13a",
                        "source_entry_id": "76090654-c6df-3273-b32f-81b4d9928745",
