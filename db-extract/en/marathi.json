            {
                "entry_id": "ebb7d333-c248-3002-809d-ac8fc08bebfa",
                "word": "Marathi",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7d53b65b-3fbd-337f-9ab0-88030cdaef22",
                        "entry_id": "ebb7d333-c248-3002-809d-ac8fc08bebfa",
                        "glosses": [
                            "Pertaining to the state of Maharashtra, to the Marathi-speaking people from the state, or to the Marathi language."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3511d558-8780-4aef-a1ca-8153b917a4a0",
                                "sense_id": "7d53b65b-3fbd-337f-9ab0-88030cdaef22",
                                "text": "2022, Hrishikesh Sudhakar Ingle, Marathi Cinema, Cultural Space, and Liminality, Oxford University Press, unnumbered page,\nIn formulating the idea of a vernacular performative, the intention has been to situate Marathi filmmaking of the 1950s within a post-studio scenario."
                            },
                            {
                                "example_id": "93e91765-cdb8-4332-b56e-73ce128766d7",
                                "sense_id": "7d53b65b-3fbd-337f-9ab0-88030cdaef22",
                                "text": "For years now, local parties in Mumbai had campaigned for Marathi people to get preferential treatment – land, housing, jobs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e86e94a-7ed2-415d-91a0-b777cd2756a3",
                        "source_entry_id": "ebb7d333-c248-3002-809d-ac8fc08bebfa",
                        "source_sense_id": "7d53b65b-3fbd-337f-9ab0-88030cdaef22",
