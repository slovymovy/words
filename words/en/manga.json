                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farm specializes in raising the woolly <w>manga</w>.",
                            "target_lang_translations": {
                                "ru": "Ферма специализируется на разведении шерстистой <w>мангалицы</w>.",
                                "zh": "这个农场专门饲养长着卷毛的<w>曼加利察猪</w>。",
                                "es": "La granja se especializa en la cría de la <w>mangalica</w> lanuda."
                            }
                        },
                        {
                            "text": "We saw a <w>manga</w> grazing in the field.",
                            "target_lang_translations": {
                                "ru": "Мы видели <w>мангалицу</w>, пасущуюся на поле.",
                                "zh": "我们看见一头<w>曼加利察猪</w>在田野里吃草。",
                                "es": "Vimos una <w>mangalica</w> pastando en el campo."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свинья породы мангалица.",
                        "zh": "曼加利察猪，一种猪的品种。",
                        "es": "Cerdo de la raza Mangalica."
                    },
                    "translations": {
