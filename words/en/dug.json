                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the archaic poem, the mother offered her <w>dug</w> to the crying infant.",
                            "target_lang_translations": {
                                "ru": "В древней поэме мать предложила свою <w>грудь</w> плачущему младенцу.",
                                "de": "In dem archaischen Gedicht bot die Mutter dem weinenden Säugling ihre <w>Brust</w> an."
                            }
                        },
                        {
                            "text": "The old text described how the child drew milk from the nurse's <w>dug</w>.",
                            "target_lang_translations": {
                                "ru": "В старом тексте описывалось, как ребенок пил молоко из <w>груди</w> кормилицы.",
                                "de": "Der alte Text beschrieb, wie das Kind Milch aus der <w>Brust</w> der Amme trank."
                            }
                        }
                    ],
                    "synonyms": [
                        "breast",
                        "nipple",
                        "tit"
                    ],
