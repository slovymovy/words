                    "sense_id": "5b19cd4c-4076-319a-985c-39d8a2d8bcdf",
                    "sense_definition": "Serving to soothe distress, alleviate grief, or provide emotional reassurance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>comforting</w> words helped him relax after a stressful day.",
                            "target_lang_translations": {
                                "pl": "Jej <w>pocieszające</w> słowa pomogły mu się zrelaksować po stresującym dniu."
                            }
                        },
                        {
                            "text": "It was very <w>comforting</w> to hear a familiar voice on the phone.",
                            "target_lang_translations": {
                                "pl": "To było bardzo <w>pokrzepiające</w>, usłyszeć znajomy głos przez telefon."
                            }
                        }
                    ],
                    "synonyms": [
                        "consoling",
                        "reassuring",
                        "soothing"
                    ],
                    "antonyms": [
                        "distressing"
                    ],
                    "common_phrases": [
                        "comforting thought",
                        "comforting words"
                    ],
                    "target_lang_definitions": {
