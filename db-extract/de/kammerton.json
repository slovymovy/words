                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1141f011-35d7-4563-8766-7ba08d4a749e",
                        "source_entry_id": "12e53c81-5be9-313f-886a-27a0bf36c61d",
                        "source_sense_id": "30ef7574-0484-3fd5-9df8-e42dd2c996e0",
                        "source_sense_description": "Musik: der gemeinsame Ton, auf den die Instrumente einer Musikgruppe eingestimmt werden",
                        "target_lang_word": "ton",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dde8cc3a-fdb5-308b-ad5d-53abfc213554",
                                        "entry_id": "8e5ab0ac-f9cf-3129-9d89-fb74b4db79a3",
                                        "glosses": [
                                            "Déterminant possessif dont le possesseur est la deuxième personne du singulier et le possédé est masculin singulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4f07dce-c992-4ea4-bfe0-ad0201e9bbfe",
                                                "sense_id": "dde8cc3a-fdb5-308b-ad5d-53abfc213554",
                                                "text": "Je te suppose riche, mon cher Guillaume. Tu montes dans ta calèche de voyage; ton valet de chambre occupe le siége; on attelle deux chevaux de poste."
                                            },
                                            {
                                                "example_id": "ae0c31a6-b295-4d47-be89-498cc4ce5e8c",
                                                "sense_id": "dde8cc3a-fdb5-308b-ad5d-53abfc213554",
                                                "text": "N'oublie pas ton passeport."
                                            },
                                            {
                                                "example_id": "76519a0e-815a-4c6a-8175-96c0a60f9bcf",
                                                "sense_id": "dde8cc3a-fdb5-308b-ad5d-53abfc213554",
                                                "text": "As-tu pensé à prendre ton livre ?"
                                            },
                                            {
                                                "example_id": "28b827b7-4390-4a1e-b54a-b8f787a4956f",
                                                "sense_id": "dde8cc3a-fdb5-308b-ad5d-53abfc213554",
                                                "text": "Ton manteau est joli."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df443131-b24c-3e2c-9a4c-50a8ac9a6e94",
                                        "entry_id": "8e5ab0ac-f9cf-3129-9d89-fb74b4db79a3",
                                        "glosses": [
                                            "Déterminant possessif dont le possesseur est la deuxième personne du singulier et le possédé est féminin singulier. Forme supplétive de ta utilisée pour effectuer une liaison obligatoire avec le mot suivant qui commence par une voyelle ou un h muet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3159b744-e698-4065-bd05-c53546c83b1a",
                                                "sense_id": "df443131-b24c-3e2c-9a4c-50a8ac9a6e94",
                                                "text": "Une ville, ta ville ; une île, ton île ; une habitation, ton habitation."
                                            },
                                            {
                                                "example_id": "df0b9d88-579d-4f74-bea2-09aca2f2c663",
                                                "sense_id": "df443131-b24c-3e2c-9a4c-50a8ac9a6e94",
                                                "text": "Une maison, ta maison, ton immense maison."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1272ccf-e797-3767-aaff-0632adbf6724",
                                        "entry_id": "a7302a30-cc77-32c3-9ec8-e121bbb8abaf",
                                        "glosses": [
                                            "Son d’une certaine fréquence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3152041c-8888-42d9-a738-60921ed267a6",
                                                "sense_id": "f1272ccf-e797-3767-aaff-0632adbf6724",
                                                "text": "Sans prévenir, il se mit à chanter, opératiquement, dans le registre ténor et en italien, même si Kit savait parfaitement que Reef n'avait aucune oreille, et était incapable de chanter en entier For He's a Jolly Good Fellow sans changer de ton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c5d53b2-ac73-3da8-8d0a-fa57377f76c5",
                                        "entry_id": "a7302a30-cc77-32c3-9ec8-e121bbb8abaf",
                                        "glosses": [
                                            "Qualité de la voix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01ad329f-a33a-4f24-89be-e8a565d79712",
                                                "sense_id": "1c5d53b2-ac73-3da8-8d0a-fa57377f76c5",
                                                "text": "Caradou, le clairon, incorrigible espiègle, lance sur un ton de commandement : « L’ennemi est en fuite. […] »"
                                            },
                                            {
                                                "example_id": "62c51297-3667-4efa-8a63-3e9895f538cc",
                                                "sense_id": "1c5d53b2-ac73-3da8-8d0a-fa57377f76c5",
                                                "text": "— Une femme saine et forte comme sont ces Américaines vous fera oublier tout cela, répétait le docteur sur tous les tons."
                                            },
                                            {
                                                "example_id": "4cae30ec-233f-41f7-b2f6-df37d66bf390",
                                                "sense_id": "1c5d53b2-ac73-3da8-8d0a-fa57377f76c5",
                                                "text": "Non, laisse… Fous-nous la paix ! lui ordonna-t-elle d’un ton rogue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45a54e47-f572-3ff8-8bc8-2d7c26b0d330",
                                        "entry_id": "a7302a30-cc77-32c3-9ec8-e121bbb8abaf",
                                        "glosses": [
                                            "Espace composé de deux demi-tons qui se retrouve entre certaines notes consécutives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c94fe4af-2fb9-4f5c-9c9f-484c8b86634d",
                                                "sense_id": "45a54e47-f572-3ff8-8bc8-2d7c26b0d330",
                                                "text": "Il y a un ton entre do et ré, mais un demi-ton entre mi et fa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e73f8a8-d70a-33cd-ae36-b051c9200a64",
                                        "entry_id": "a7302a30-cc77-32c3-9ec8-e121bbb8abaf",
                                        "glosses": [
                                            "Gamme, nom de la première note de la gamme dont la musique est formée."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1da6aaaa-5f63-420f-a312-da89b9b9b66c",
                                                "sense_id": "2e73f8a8-d70a-33cd-ae36-b051c9200a64",
                                                "text": "Chacun d’ailleurs chantait dans un autre ton que son voisin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13342672-8269-3b57-94d8-1e4362851bb0",
                                        "entry_id": "a7302a30-cc77-32c3-9ec8-e121bbb8abaf",
                                        "glosses": [
                                            "Hauteur et modulation d’un son, typiquement d’une syllabe, comme trait phonologique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8d512ba-0ba1-39c7-97d9-32f25032040e",
                                        "entry_id": "a7302a30-cc77-32c3-9ec8-e121bbb8abaf",
                                        "glosses": [
                                            "Manière de s’exprimer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b14655f6-35d9-4697-80e0-45f556887aed",
                                                "sense_id": "a8d512ba-0ba1-39c7-97d9-32f25032040e",
                                                "text": "Bien qu’il n’eût pu comprendre un seul mot de ce qui avait été dit, Bert éprouva un choc en remarquant le ton qu’avait pris l’homme."
                                            },
                                            {
                                                "example_id": "bb15c215-cd72-4174-b36a-88caa753e364",
                                                "sense_id": "a8d512ba-0ba1-39c7-97d9-32f25032040e",
                                                "text": "Le ton péremptoire et l’expression allusive me glacèrent. J’eus le pressentiment d’une discussion immédiate et violente."
                                            },
                                            {
                                                "example_id": "198cd981-d577-4c7d-aa45-ceaa191d6966",
                                                "sense_id": "a8d512ba-0ba1-39c7-97d9-32f25032040e",
                                                "text": "Malgré sa corpulence excessive, l’autorité de M. Hector sur ses subordonnés n’est guère contestable. Il la doit surtout à sa placidité étudiée, au ton solennel et ampoulé qu’il affecte en s’exprimant […]"
                                            },
                                            {
                                                "example_id": "4f08680b-52d6-4031-b840-53a75e678261",
                                                "sense_id": "a8d512ba-0ba1-39c7-97d9-32f25032040e",
                                                "text": "Ce n'est pas pour ta pomme, Boutros, déclara-t-elle sur un ton de mépris et en traduisant son prénom en arabe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13b7ca84-b6ca-329a-98ba-cbc0a7c85b63",
                                        "entry_id": "a7302a30-cc77-32c3-9ec8-e121bbb8abaf",
                                        "glosses": [
                                            "Niveau de luminosité d’une couleur de base."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c46f74b-33f9-4ab4-aa3c-84c31bfd70be",
                                                "sense_id": "13b7ca84-b6ca-329a-98ba-cbc0a7c85b63",
                                                "text": "Dans un premier temps, les trois couleurs primaires permettent d’apprécier tel ou tel stimulus coloré. Mais quels sont les rapports réciproques de teinte, de ton, de saturation et de surface ?"
                                            },
                                            {
                                                "example_id": "52a0a4a8-1fe5-4c42-9b78-829111735983",
                                                "sense_id": "13b7ca84-b6ca-329a-98ba-cbc0a7c85b63",
                                                "text": "Différents tons de rouge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e6c6c69-9c6a-3816-b265-97da3e075780",
                                        "entry_id": "a7302a30-cc77-32c3-9ec8-e121bbb8abaf",
                                        "glosses": [
                                            "Caractère d’une couleur associé à la couleur qui produit sur l’œil une sensation lumineuse de niveau élevé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e9e35e4-3f8d-3f3c-936a-077e595fbc8b",
                                        "entry_id": "27beccfa-e13d-363e-9bce-a6b94b08081d",
                                        "glosses": [
                                            "Partie supérieure du mât."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9d2361f-7c03-44c4-bd7d-1572daa827a3",
                                                "sense_id": "8e9e35e4-3f8d-3f3c-936a-077e595fbc8b",
                                                "text": "Le grand mât de hune résista jusqu’à huit heures du matin ; mais alors, le jeu étonnant qu’il avait nous montrant l’impossibilité de le sauver et nous donnant lieu de craindre qu’il ne fît rompre le grand mât, nous coupâmes ces galhaubans de bas-bord. Peu après il rompit dans le chouquet du grand mât, dont il fit consentir le ton, et tomba à la mer du côté de tribord, entraînant dans sa chute la vergue du grand hunier."
                                            },
                                            {
                                                "example_id": "3fb2e0a5-1fa4-4115-8e7f-efc570ef4f5a",
                                                "sense_id": "8e9e35e4-3f8d-3f3c-936a-077e595fbc8b",
                                                "text": "Le bas mât s’était rompu dans sa chute au ras du ton, de telle sorte que la hune peut être facilement retirée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
