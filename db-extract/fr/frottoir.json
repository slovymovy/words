                    {
                        "sense_id": "3f250960-dc32-3fc4-874a-fe8d725ea898",
                        "entry_id": "531a31b4-60d7-3bb4-b573-98912fc54b4a",
                        "glosses": [
                            "Tissu de crin utilisé pour frotter les cordes musicales en boyau."
