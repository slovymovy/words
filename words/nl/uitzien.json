                    "sense_definition": "Met verlangen wachten op iets dat gaat gebeuren.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "anticipation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>zie</w> ernaar <w>uit</w> om samen aan de slag te gaan.",
                            "target_lang_translations": {
                                "en": "I <w>look forward to</w> getting started together.",
                                "ru": "Я <w>с нетерпением жду</w> начала нашей совместной работы.",
                                "it": "<w>Non vedo l'ora di</w> iniziare a lavorare insieme.",
                                "pl": "<w>Nie mogę się doczekać</w>, aż zaczniemy razem pracować.",
                                "de": "Ich <w>freue</w> mich darauf, gemeinsam anzufangen.",
