                    {
                        "sense_id": "9b2cecda-853e-3e34-9f79-e85eb406da0f",
                        "entry_id": "cf23138b-5a27-3f22-9348-6d41841a5b5f",
                        "glosses": [
                            "Action de tartiner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a504ec8-001d-468e-a231-ee14483bec8b",
                                "sense_id": "9b2cecda-853e-3e34-9f79-e85eb406da0f",
                                "text": "Ce tartinage pour vous expliquer qu’avant de mettre le panard sur la moquette, j’ai déjà procédé à une exploration minutieuse de la situation."
                            },
                            {
                                "example_id": "4c66ade4-efe5-4518-a2e0-acd0d913e852",
                                "sense_id": "9b2cecda-853e-3e34-9f79-e85eb406da0f",
                                "text": "Dans la procédure de tartinage par pellicule, les feuilles ne devant pas être recouvertes passent directement au-dessus de la tête de tartinage et sont envoyées vers le dispositif de formation de bloc, pendant que les autres se suivent, sans interruption, et passent sous la tête de tartinage. Le tartinage est déclenché par cellules photoélectriques. La crème s'écoule de la buse de tartinage et est écrasée par une lame de tartinage pour appliquer une bande de crème continue sur les feuilles de gaufrettes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1db91d50-c35c-4687-9cbb-cea0061b42d1",
                        "source_entry_id": "cf23138b-5a27-3f22-9348-6d41841a5b5f",
                        "source_sense_id": "9b2cecda-853e-3e34-9f79-e85eb406da0f",
                        "target_lang_word": "spreading",
