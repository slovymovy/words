                "senses": [
                    {
                        "sense_id": "1ff1ac96-22d1-35c4-9bdb-1ea7865c1eb8",
                        "entry_id": "8c7c94db-3389-3097-9725-998ca48255a5",
                        "glosses": [
                            "een honderdste deel, weergegeven met symbool %"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2be752d8-0f48-4915-9fb1-b8ce37ef23c3",
                                "sense_id": "1ff1ac96-22d1-35c4-9bdb-1ea7865c1eb8",
                                "text": "De olieprijs was weer een paar procent gestegen."
                            },
                            {
                                "example_id": "46d8dd03-d56b-4f42-b29e-05c5c77deba3",
                                "sense_id": "1ff1ac96-22d1-35c4-9bdb-1ea7865c1eb8",
                                "text": "Het is zeven kilometer klimmen naar 1148 meter en er zitten huiveringwekkende stijgingspercentages tussen, van boven de 20 procent. Het is de vierde keer dat de Tour de berg aandoet, na etappes in 2012, 2014 en 2017."
                            },
                            {
                                "example_id": "7fb29de6-4ed1-47a5-af80-48dc35a39402",
                                "sense_id": "1ff1ac96-22d1-35c4-9bdb-1ea7865c1eb8",
                                "text": "Hij was niet de enige: meer dan 65 procent van de hikers maakt de PCT niet helemaal af, voornamelijk vanwege blessures zoals ontstoken blaren, scheenbeenvliesontsteking, botbreuken, overbelasting en oververmoeidheid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89e208a9-d7e3-495f-8813-fa6c46ee5777",
                        "source_entry_id": "8c7c94db-3389-3097-9725-998ca48255a5",
                        "source_sense_id": "1ff1ac96-22d1-35c4-9bdb-1ea7865c1eb8",
