    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "00bddf56-f021-3b6e-9d01-0192ca349d67",
                    "sense_definition": "Небольшая, обычно недорогая вещь, служащая для украшения или мелкого подарка.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "item",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На полке стояла забавная фарфоровая <w>безделушка</w>, купленная на блошином рынке.",
                            "target_lang_translations": {
                                "en": "On the shelf stood an amusing porcelain <w>knick-knack</w> bought at a flea market."
                            }
                        },
                        {
                            "text": "Он любил привозить из каждой поездки милые сувенирные <w>безделушки</w> для друзей.",
                            "target_lang_translations": {
                                "en": "He loved bringing back cute souvenir <w>trinkets</w> for his friends from every trip."
                            }
                        }
                    ],
                    "synonyms": [
                        "безде́лка",
                        "безде́лица",
                        "финтифлю́шка"
                    ],
                    "common_phrases": [
                        "милая безделушка",
                        "сувенирная безделушка",
                        "фарфоровая безделушка"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A small, usually inexpensive decorative object or trinket used for decoration or as a small gift."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "knick-knack",
                                "target_lang_sense_clarification": "small ornament or decorative item"
                            },
                            {
                                "target_lang_word": "trinket",
                                "target_lang_sense_clarification": "small item of little value, often jewellery or ornament"
                            },
                            {
                                "target_lang_word": "bauble",
                                "target_lang_sense_clarification": "small, showy, inexpensive ornament"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0aa7237-f65a-3c82-997c-f154a4390c45",
                    "sense_definition": "Небольшое, лёгкое и неглубокое по содержанию произведение искусства или литературы.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Критик назвал новую пьесу автора приятной, но поверхностной <w>безделушкой</w>.",
                            "target_lang_translations": {
                                "en": "The critic called the author's new play a pleasant but superficial <w>trifle</w>."
                            }
                        },
                        {
                            "text": "Композитор сочинил эту музыкальную <w>безделушку</w> всего за один вечер.",
                            "target_lang_translations": {
                                "en": "The composer wrote this musical <w>bagatelle</w> in just a single evening."
                            }
                        }
                    ],
                    "synonyms": [
                        "безде́лка"
                    ],
                    "common_phrases": [
                        "музыкальная безделушка",
                        "литературная безделушка"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A short, light, and superficial work of art or literature; a bagatelle."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bagatelle",
                                "target_lang_sense_clarification": "short, unpretentious piece of music or literature"
                            },
                            {
                                "target_lang_word": "trifle",
                                "target_lang_sense_clarification": "light, insignificant creative work"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}