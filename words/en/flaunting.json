{
    "word_family": [
        "flaunt",
        "flaunter"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "47ba7477-dc1c-3dc5-8931-087f547e3c25",
                    "sense_definition": "Characterized by a showy or gaudy display intended to attract attention.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "showy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a <w>flaunting</w> tie that seemed designed to distract everyone in the room.",
                            "target_lang_translations": {
                                "zh": "他戴着一条<w>浮夸的</w>领带，似乎就是为了分散房间里所有人的注意力。"
                            }
                        },
                        {
                            "text": "The mansion was decorated in a <w>flaunting</w> style that lacked any sense of elegance.",
                            "target_lang_translations": {
                                "zh": "这座豪宅的装饰风格十分<w>浮夸</w>，毫无优雅可言。"
                            }
                        }
                    ],
                    "synonyms": [
                        "showy",
                        "gaudy",
                        "ostentatious",
                        "flamboyant"
                    ],
                    "antonyms": [
                        "modest",
                        "understated"
                    ],
                    "common_phrases": [
                        "flaunting style",
                        "flaunting display"
                    ],
                    "target_lang_definitions": {
                        "zh": "指以浮夸、炫耀的方式吸引他人注意的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "浮夸的",
                                "target_lang_sense_clarification": "形容风格或装饰过于华丽、不自然。"
                            },
                            {
                                "target_lang_word": "炫耀的",
                                "target_lang_sense_clarification": "形容带有刻意展示意图的。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "46236196-983c-3231-a1d9-723f298deb1f",
                    "sense_definition": "The act of displaying something in a bold or provocative way to attract attention.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "showy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>flaunting</w> of his wealth made his colleagues feel very uncomfortable.",
                            "target_lang_translations": {
                                "zh": "他不断地<w>炫耀</w>自己的财富，让同事们感到非常不自在。"
                            }
                        },
                        {
                            "text": "Such public <w>flaunting</w> of their success was seen as quite disrespectful by the community.",
                            "target_lang_translations": {
                                "zh": "这种在公共场合<w>炫耀</w>成功的行为被社区视为相当无礼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "parading",
                        "displaying",
                        "showing off"
                    ],
                    "common_phrases": [
                        "flaunting of wealth",
                        "flaunting of success"
                    ],
                    "target_lang_definitions": {
                        "zh": "指为了吸引注意而大胆或挑衅地展示某物的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "炫耀",
                                "target_lang_sense_clarification": "指公开展示财富或成就以引起关注。"
                            },
                            {
                                "target_lang_word": "卖弄",
                                "target_lang_sense_clarification": "指刻意展示自己的能力或所有物。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fd14b4ea-a0df-38e6-9cb5-e3a233e1f388",
                    "sense_definition": "The present participle and gerund of <w>flaunt</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "showy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>flaunting</w> her new jewelry to everyone she meets today.",
                            "target_lang_translations": {
                                "zh": "她今天见到谁都要<w>炫耀</w>一下她的新首饰。"
                            }
                        },
                        {
                            "text": "He was <w>flaunting</w> his expensive car by driving it slowly through the crowded street.",
                            "target_lang_translations": {
                                "zh": "他开着那辆昂贵的车在拥挤的街道上缓慢行驶，以此来<w>炫耀</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "parading",
                        "showing off",
                        "brandishing"
                    ],
                    "antonyms": [
                        "hiding",
                        "concealing"
                    ],
                    "common_phrases": [
                        "flaunting success",
                        "flaunting wealth"
                    ],
                    "target_lang_definitions": {
                        "zh": "指为了引起注意而大肆展示或炫耀某物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "炫耀",
                                "target_lang_sense_clarification": "指公开展示以求获得关注。"
                            },
                            {
                                "target_lang_word": "卖弄",
                                "target_lang_sense_clarification": "指以夸张的方式展示某物。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}