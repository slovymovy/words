                        "examples": [
                            {
                                "example_id": "88fe996d-d9ef-4ee6-8819-2bb5e4328478",
                                "sense_id": "bc58512e-2f21-3bfc-8f0a-5835cdc6ac22",
                                "text": "Według danych HUR, mikroukłady te są zwykle przeznaczone do celów cywilnych, ale Rosjanie używają ich do celów wojskowych.",
                                "translation": "According to HUR, these chips are usually intended for civilian purposes, but the Russians use them for military purposes.",
                                "english": "According to HUR, these chips are usually intended for civilian purposes, but the Russians use them for military purposes."
                            },
                            {
                                "example_id": "1453c3bd-32a9-44ab-b40f-44a9973b1c2b",
                                "sense_id": "bc58512e-2f21-3bfc-8f0a-5835cdc6ac22",
                                "text": "„Obecnie dobiega końca leczenie, potem odbędą się kontrole lekarzy” – powiedział anonimowy przedstawiciel HUR-u i dodał, że u kobiety zdiagnozowano uszkodzenie przez metale ciężkie.",
                                "translation": "“The treatment is currently coming to an end, then there will be check-ups with doctors,” said an anonymous HUR representative, adding that the woman had been diagnosed with heavy metal damage.",
                                "english": "“The treatment is currently coming to an end, then there will be check-ups with doctors,” said an anonymous HUR representative, adding that the woman had been diagnosed with heavy metal damage."
                            },
                            {
                                "example_id": "a5d61fae-fc06-433d-ad03-f75dfdd07590",
                                "sense_id": "bc58512e-2f21-3bfc-8f0a-5835cdc6ac22",
                                "text": "Według szacunków HUR liczba północnokoreańskich żołnierzy przerzuconych do Rosji wynosi obecnie ok. 12 tysięcy, w tym 500 oficerów, wśród których są trzej generałowie z Pjongjangu.",
                                "translation": "According to estimates from the HUR, the number of North Korean soldiers transferred to Russia currently stands at around 12,000, including 500 officers, with three generals from Pyongyang.",
                                "english": "According to estimates from the HUR, the number of North Korean soldiers transferred to Russia currently stands at around 12,000, including 500 officers, with three generals from Pyongyang."
                            }
