                ],
                "senses": [
                    {
                        "sense_id": "5abcf029-c98c-37d6-86a6-184699d09f91",
                        "entry_id": "f57615e2-cc34-3b0f-902c-e3b1d5557e4b",
                        "glosses": [
                            "Birnenfassung (E 27) mit kurzem Kabel zur Beleuchtung von Räumen vor der Montage von Beleuchtungskörpern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a384ff03-f8eb-4962-8c6f-c08999b372d6",
                                "sense_id": "5abcf029-c98c-37d6-86a6-184699d09f91",
                                "text": "„Die übliche Neonhelligkeit des Klassenraumes veränderten wir durch eine Bauarbeiterlampe und, wenn die Spielsituation es erlaubte, durch Kerzen.“"
                            },
                            {
                                "example_id": "a2a836ab-5f7c-4a4f-abdb-549e902db6d0",
                                "sense_id": "5abcf029-c98c-37d6-86a6-184699d09f91",
                                "text": "„Mit Taschenlampe im Mund, auf dem Wohnzimmerstuhl stehend mit einem Fasenprüfer in der Hand wurde sie also im Dunkeln abgebaut und nun hängt erst einmal eine ‚schöne‘ Bauarbeiterlampe an der Stelle, bis Anja eine neue Lampe ausgesucht hat (Bilder).“"
                            },
                            {
                                "example_id": "07b0847d-6445-479d-9eb2-2333afa628d4",
                                "sense_id": "5abcf029-c98c-37d6-86a6-184699d09f91",
                                "text": "„Im Saal standen zehn batteriebetriebene Bauarbeiterlampen, tauchten das leicht konkave Gewölbe in unwirklich anmutendes, fettgelbes Licht.“"
                            },
                            {
                                "example_id": "03aba0de-e865-4735-ab76-2527730938c7",
                                "sense_id": "5abcf029-c98c-37d6-86a6-184699d09f91",
                                "text": "„Nach der Arbeit joggen - das geht nicht mehr. Es sei denn, man bindet sich eine Bauarbeiterlampe um den Kopf, um seine Kräfte nicht mit Baumwurzeln und Wackersteinen zu messen.“"
                            },
                            {
                                "example_id": "68083311-7500-471f-9df1-5f437ebe1f28",
                                "sense_id": "5abcf029-c98c-37d6-86a6-184699d09f91",
                                "text": "„Also – sparen und viele Kerzen anzünden und eine Bauarbeiterlampe aufhängen oder doch lieber die Kompromissleuchte?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
