                "senses": [
                    {
                        "sense_id": "e980d666-70d0-368a-a759-0156c33e0f15",
                        "entry_id": "d65ffa12-5fe3-3629-b414-7d7ee8b150de",
                        "glosses": [
                            "оборачиваясь, смотреть назад"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de813add-d36d-4f20-afae-5a0e28a9dc62",
                                "sense_id": "e980d666-70d0-368a-a759-0156c33e0f15",
                                "text": "Люба шла несколько впереди и, рассказывая это, оглядывалась, и вид у неё был спокойный и весёлый."
                            }
                        ]
                    },
                    {
                        "sense_id": "588a3b0c-8116-34b7-81f5-68075a951a97",
                        "entry_id": "d65ffa12-5fe3-3629-b414-7d7ee8b150de",
                        "glosses": [
                            "перен. поступать осторожно, с оглядкой на кого-либо или на что-либо, с учётом чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cc17c10-28e4-4caf-bbf2-f713fe1eb936",
                                "sense_id": "588a3b0c-8116-34b7-81f5-68075a951a97",
                                "text": "Имеет ли право женщина поступить так, как ей хочется, не оглядываясь на нормы, не учитывая интересы мужа?"
                            }
                        ]
                    }
