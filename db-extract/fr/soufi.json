                ],
                "senses": [
                    {
                        "sense_id": "5e8ace9f-d8cd-3d09-8f2b-ad83e07dabc4",
                        "entry_id": "ccfd234c-5856-305d-8cf3-101537f32057",
                        "glosses": [
                            "Adepte du soufisme, mystique musulman."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08f6ada4-db92-493f-9e8c-16ec80b07790",
                                "sense_id": "5e8ace9f-d8cd-3d09-8f2b-ad83e07dabc4",
                                "text": "— Et depuis sept ans tu erres ainsi en habit de soufi ?"
                            },
                            {
                                "example_id": "1a1d0bee-99d1-43db-830a-b6a3bfe28fc5",
                                "sense_id": "5e8ace9f-d8cd-3d09-8f2b-ad83e07dabc4",
                                "text": "Il n’existe plus de communauté humaine, d’unité de civilisation qui s’inspire du mazdéisme de Zarathustra ; et nulle ne s’inspira jamais de la mystique des soufis, et pour cause."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b917c1cc-5837-4865-9a90-0237910d649a",
                        "source_entry_id": "ccfd234c-5856-305d-8cf3-101537f32057",
                        "source_sense_id": "5e8ace9f-d8cd-3d09-8f2b-ad83e07dabc4",
                        "target_lang_word": "Sufi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sufi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "794694ee-75db-3dae-ba24-bd41c6fdc181",
                                        "entry_id": "3d7681b5-0264-3f84-b1a0-0aa5d8c66381",
                                        "glosses": [
                                            "Anhänger, Vertreter einer mystischen Strömung im Islam (Sufismus, Sufitum)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "688fec97-7c0f-42d7-808a-b4339ccbcde2",
                                                "sense_id": "794694ee-75db-3dae-ba24-bd41c6fdc181",
                                                "text": "Der Drehtanz ist eine der ältesten Techniken der Sufis und eine der wirkungsvollsten."
                                            },
                                            {
                                                "example_id": "42f02ff1-f2fb-4dcc-bf5b-9c39e2c6dfeb",
                                                "sense_id": "794694ee-75db-3dae-ba24-bd41c6fdc181",
                                                "text": "„Kurz vorm Morgengrauen war ich noch einmal aufgewacht und hatte Schritte im stockdunklen Vakuum über meinem Kopf gehört, als ob ein Sufi enthemmt über die Dielen tanzte.“"
                                            },
                                            {
                                                "example_id": "0e4cfa8a-28d3-48f5-ac5c-52a0a8d01ce6",
                                                "sense_id": "794694ee-75db-3dae-ba24-bd41c6fdc181",
                                                "text": "„Für einen Sufi ist das Fremde (das Andere), etwa die Frau oder der Ausländer, kein bedrohlicher Feind. Im Gegenteil, die Sufis feiern die Verschiedenheit als faszinierende Erscheinungsform menschlicher Vielfalt.“"
                                            },
                                            {
                                                "example_id": "3b2cd63d-9193-4cfc-8e07-aedc0cf0b502",
                                                "sense_id": "794694ee-75db-3dae-ba24-bd41c6fdc181",
                                                "text": "„Für die Sufis war der Gedanke einer Versöhnung des Islam mit dem Hinduismus nichts Neues.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab67b8aa-e9fa-4488-9af6-65a47954bb20",
                        "source_entry_id": "ccfd234c-5856-305d-8cf3-101537f32057",
                        "source_sense_id": "5e8ace9f-d8cd-3d09-8f2b-ad83e07dabc4",
