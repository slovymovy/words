                "senses": [
                    {
                        "sense_id": "f4d75ff0-0693-33d8-bb6b-ed1c090cf4eb",
                        "entry_id": "e8f03774-8be0-31a6-9156-fb767e6aafd0",
                        "glosses": [
                            "An obstruction or occlusion of a blood vessel by an embolus, that is by a blood clot, air bubble or other matter that has been transported by the blood stream."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b384ba4c-09aa-3713-8938-728abdf15359",
                        "entry_id": "e8f03774-8be0-31a6-9156-fb767e6aafd0",
                        "glosses": [
                            "The insertion or intercalation of days into the calendar in order to correct the error arising from the difference between the civil year and the solar year."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bff569bb-636e-4f88-aab7-8d934fec3e14",
                                "sense_id": "b384ba4c-09aa-3713-8938-728abdf15359",
                                "text": "Authorities differ as to the manner in which the Arabs practised embolism: some say, they added a month to every third year; others, that they intercalated seven months in a period of nineteen years ; and others, nine months in twenty-four years."
                            }
                        ]
                    },
                    {
                        "sense_id": "1119cba0-987e-3624-bbdb-45bfe212dba5",
                        "entry_id": "e8f03774-8be0-31a6-9156-fb767e6aafd0",
                        "glosses": [
                            "An intercalated prayer for deliverance from evil coming after the Lord's Prayer."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0218397c-1e11-3c60-9670-2be0629a56af",
                        "entry_id": "e8f03774-8be0-31a6-9156-fb767e6aafd0",
                        "glosses": [
                            "The variable body of a liturgical preface, between the protocol and eschatocol, typically stating the motive for worship on a given day."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
