                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "059b1c30-398c-4094-b5f0-2b0ab79f67b1",
                        "entry_id": "79f0c361-3d95-3100-b56f-f665fcd0bc72",
