                                        "glosses": [
                                            "Orifice du rectum par lequel se termine l’intestin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6830535d-3811-4f33-877c-abf7fcca3889",
                                                "sense_id": "a5482da5-56fb-3f74-bf90-987b2dcc5d16",
                                                "text": "Avoir une fistule à l’anus."
                                            },
                                            {
                                                "example_id": "90f1784b-cfc4-407c-8cfb-c7ebe060af8a",
                                                "sense_id": "a5482da5-56fb-3f74-bf90-987b2dcc5d16",
                                                "text": "Lʼanus est un segment de 3 à 4 cm de long réunissant le rectum au périnée."
                                            },
                                            {
                                                "example_id": "98aad907-ddc6-4ed4-b9b6-74203976e7df",
                                                "sense_id": "a5482da5-56fb-3f74-bf90-987b2dcc5d16",
                                                "text": "Son cancer du rectum avait connu une aggravation subite, il avait des pertes de matière maintenant, avait-il annoncé avec une délectation masochiste, il allait falloir lui poser un anus artificiel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c82f647c-16c2-3077-a1d6-8d2736ec1060",
                                        "entry_id": "336484f6-0144-3a1a-b5d1-625661e111b4",
                                        "glosses": [
                                            "Dépression qu’offre assez souvent, en avant du sommet, la partie dorsale de la face externe d’une valve de coquille bivalve, quand on l’envisage sur les deux valves à la fois."
                                        ],
