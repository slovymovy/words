    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "af901e7e-1dd2-3555-ac7f-442b95787c52",
                    "sense_definition": "vooruitgang boeken of verder komen in een proces",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vooruitgang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Naarmate het verhaal <w>vordert</w> worden de personages steeds interessanter.",
                            "target_lang_translations": {
                                "en": "As the story <w>progresses</w>, the characters become increasingly interesting."
                            }
                        },
                        {
                            "text": "Het werk aan de nieuwe brug is die dag flink <w>gevorderd</w>.",
                            "target_lang_translations": {
                                "en": "Work on the new bridge <w>advanced</w> significantly that day."
                            }
                        }
                    ],
                    "synonyms": [
                        "vooruitgaan",
                        "opschieten",
                        "progressie maken"
                    ],
                    "antonyms": [
                        "stagneren",
                        "achteruitgaan"
                    ],
                    "common_phrases": [
                        "flink vorderen",
                        "gestaag vorderen"
                    ],
                    "target_lang_definitions": {
                        "en": "to make progress or move further along in a process"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "progress",
                                "target_lang_sense_clarification": "to move forward or develop"
                            },
                            {
                                "target_lang_word": "advance",
                                "target_lang_sense_clarification": "to move forward in space or time"
                            },
                            {
                                "target_lang_word": "proceed",
                                "target_lang_sense_clarification": "to continue with a course of action"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3a6019c-0517-3aed-8c8e-2603890365b4",
                    "sense_definition": "op een dwingende of officiële manier iets opeisen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opeisen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De huisbaas <w>vordert</w> het huurgeld dat al maanden niet betaald is.",
                            "target_lang_translations": {
                                "en": "The landlord is <w>demanding</w> the rent money that hasn't been paid for months."
                            }
                        },
                        {
                            "text": "Tijdens de oorlog werden alle radio's door de bezetter <w>gevorderd</w>.",
                            "target_lang_translations": {
                                "en": "During the war, all radios were <w>requisitioned</w> by the occupier."
                            }
                        }
                    ],
                    "synonyms": [
                        "opeisen",
                        "verlangen",
                        "claimen",
                        "requisitioneren"
                    ],
                    "antonyms": [
                        "afstaan",
                        "verlenen"
                    ],
                    "common_phrases": [
                        "betaling vorderen",
                        "schadevergoeding vorderen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in juridische of officiële context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to demand or claim something in a compelling or official manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "claim",
                                "target_lang_sense_clarification": "to demand ownership or compensation"
                            },
                            {
                                "target_lang_word": "demand",
                                "target_lang_sense_clarification": "to request forcefully or as a right"
                            },
                            {
                                "target_lang_word": "requisition",
                                "target_lang_sense_clarification": "to officially take or demand for use, especially by an army"
                            }
                        ]
                    }
                }
            ]
        }
    ]
