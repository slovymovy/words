        "de-extract.jsonl": [
            {
                "entry_id": "cbe23249-1c3d-3748-bf6b-7bcf143e4c07",
                "word": "malediction",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0378f3b1-de81-38cb-8861-a1447fdf123d",
                        "entry_id": "cbe23249-1c3d-3748-bf6b-7bcf143e4c07",
                        "glosses": [
                            "Fluch, Verwünschung"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73f84883-74e1-47c4-91e5-50c9ffb38c9b",
                        "source_entry_id": "cbe23249-1c3d-3748-bf6b-7bcf143e4c07",
                        "source_sense_id": "0378f3b1-de81-38cb-8861-a1447fdf123d",
                        "source_sense_description": "Fluch, Verwünschung",
                        "target_lang_word": "Fluch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fluch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb45c245-4c75-3347-a71a-04efe7d67050",
                                        "entry_id": "c4fb9321-db28-3d48-88f0-848b76895c02",
                                        "glosses": [
                                            "(im Zorn) gesagte Verwünschung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1f966e4-101d-42ec-b41c-3676af4ba634",
                                                "sense_id": "eb45c245-4c75-3347-a71a-04efe7d67050",
                                                "text": "Auf der Sache liegt von Anfang an ein Fluch."
                                            },
                                            {
                                                "example_id": "66fbdaca-4c94-4ed4-882b-03e4c5c5de79",
                                                "sense_id": "eb45c245-4c75-3347-a71a-04efe7d67050",
                                                "text": "„Generell aber hat der persönlich beleidigende Fluch die Oberhand über das Verfluchen gewonnen.“"
                                            },
                                            {
                                                "example_id": "e3db6819-c34d-4697-810a-8d884ca973ca",
                                                "sense_id": "eb45c245-4c75-3347-a71a-04efe7d67050",
                                                "text": "„Der Taxifahrer bremst ruckartig, wechselt die Spur und sendet durch den Rückspiegel Flüche an das Auto, das wir überholen.“"
                                            },
                                            {
                                                "example_id": "48e3b247-80e6-4d42-8e3b-26e8b8a4f301",
                                                "sense_id": "eb45c245-4c75-3347-a71a-04efe7d67050",
                                                "text": "„Satan starrte auf seinen leeren Monitor und ließ alle Flüche der Unterwelt hören.“"
                                            },
                                            {
                                                "example_id": "5afcfed7-f13f-4ca1-8d62-855687d608bd",
                                                "sense_id": "eb45c245-4c75-3347-a71a-04efe7d67050",
                                                "text": "„Sie kauert am Boden, eine weiße Eidechse, und zischt Flüche gegen mich, Beleidigungen, einen Strom von geflüsterten Fuhrmannsflüchen, Soldatenflüchen, Hurenflüchen, Flüchen, die ich nicht einmal alle kenne, Beleidigungen, die treffen wie Messer und Peitschenhiebe, Worte, die ich nie bei ihr vermutet hätte, Worte, auf die man nur mit den Fäusten antwortet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3e33249-d8e7-47f6-ad56-4eedc2fcb4e0",
                        "source_entry_id": "cbe23249-1c3d-3748-bf6b-7bcf143e4c07",
                        "source_sense_id": "0378f3b1-de81-38cb-8861-a1447fdf123d",
                        "source_sense_description": "Fluch, Verwünschung",
                        "target_lang_word": "Verwünschung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verwünschung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2edc2a32-2716-359c-8ec2-f4ea26683e06",
                                        "entry_id": "83e68bf7-bbd2-3cc8-b909-0301a5b9aed1",
                                        "glosses": [
                                            "Handlung, mit der jemand einem anderen Übles wünscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cecf828-5775-412f-8f22-1d418a583c08",
                                                "sense_id": "2edc2a32-2716-359c-8ec2-f4ea26683e06",
                                                "text": "„Die Tatsache, dass sie ihrem Sohn niemals verziehen hat, wiegt viel schwerer als das, was sie in ihrer Wut an Verwünschungen ausgestoßen hat.“"
                                            },
                                            {
                                                "example_id": "999f591d-8d85-47d5-b2f3-153f0da76a5b",
                                                "sense_id": "2edc2a32-2716-359c-8ec2-f4ea26683e06",
                                                "text": "„Tatsächlich sind solche Verwünschungen in unserem Kulturkreis aus der Mode gekommen, wohl hauptsächlich deshalb, weil wir nicht mehr daran glauben, dass uns jemand bei ihrer Umsetzung helfen kann.“"
                                            },
                                            {
                                                "example_id": "235ce6ae-9776-4936-9f3a-8f22ca78ee50",
                                                "sense_id": "2edc2a32-2716-359c-8ec2-f4ea26683e06",
                                                "text": "„Bereitwilligst verpflichtete ich mich hierzu mit den feierlichsten Fluchworten und Verwünschungen, die der Teufel und wir beide nur zu finden vermochten.“"
                                            },
                                            {
                                                "example_id": "a9b6b6a5-f9c1-429e-89b1-4ca95e0bfe46",
                                                "sense_id": "2edc2a32-2716-359c-8ec2-f4ea26683e06",
                                                "text": "„Max aber wußte, daß die Verwünschungen sich diesmal erfüllen würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
