                "senses": [
                    {
                        "sense_id": "2b7edd5d-37d8-3a02-897e-0a5e26df3cf4",
                        "entry_id": "1be1dcf0-1d38-3675-b5d1-b5aa8ea11456",
                        "glosses": [
                            "Prüfung, Examen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "698ddd1f-e0eb-428f-a424-70b0b0ce5777",
                                "sense_id": "2b7edd5d-37d8-3a02-897e-0a5e26df3cf4",
                                "text": "All students have to take an exam.",
                                "translation": "Alle Studenten müssen eine Prüfung machen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be381798-5611-48fb-b1e4-d8414eeaabe1",
                        "source_entry_id": "1be1dcf0-1d38-3675-b5d1-b5aa8ea11456",
                        "source_sense_id": "2b7edd5d-37d8-3a02-897e-0a5e26df3cf4",
                        "source_sense_description": "Prüfung, Examen",
                        "target_lang_word": "Prüfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prüfung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0f1355a-d24d-3e76-b8e2-b705afc46e77",
                                        "entry_id": "2c376bea-f50c-3762-b336-35c397f99739",
                                        "glosses": [
                                            "Handlung des Kontrollierens; das Nachschauen oder Testen, ob etwas funktioniert beziehungsweise in Ordnung ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f091846e-be20-497f-aa7d-78998cd317e4",
                                                "sense_id": "e0f1355a-d24d-3e76-b8e2-b705afc46e77",
                                                "text": "Wir äußern uns erst nach gründlicher Prüfung des Sachverhaltes."
                                            },
                                            {
                                                "example_id": "69136a2a-28b6-49d3-aa48-43859be77a06",
                                                "sense_id": "e0f1355a-d24d-3e76-b8e2-b705afc46e77",
                                                "text": "„Kluge Kapitalanleger lassen sich nicht nur bisherige Mietverträge zur Prüfung aushändigen, sondern lassen sich auch den regelmäßigen Mieteingang bescheinigen, indem sie z.B. Einsicht in die Kontoauszüge des Vorbesitzers bekommen.“"
                                            },
                                            {
                                                "example_id": "f60778c1-1f17-42fe-9f3d-3dd481372da6",
                                                "sense_id": "e0f1355a-d24d-3e76-b8e2-b705afc46e77",
                                                "text": "„Dann entschuldigte er sich und ließ mich allein, damit ich mit der Prüfung der Geschäftsbücher beginnen könne.“"
                                            },
                                            {
                                                "example_id": "ffa137e6-06a7-40fa-9b60-a602f42071e0",
                                                "sense_id": "e0f1355a-d24d-3e76-b8e2-b705afc46e77",
                                                "text": "„Seine Stimmung schien mir eher moros und bitter, — was nicht allein auf die furchtbaren Prüfungen, Opfer und Leiden zurückzuführen sein mochte, die der Krieg seinem Lande auferlegte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9664d232-e37b-3a9d-bc44-011d6af8bbf1",
                                        "entry_id": "2c376bea-f50c-3762-b336-35c397f99739",
                                        "glosses": [
                                            "meist offizielle Abfrage mündlich oder schriftlich in einem Fachgebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ca1e2b2-675c-4cee-8ace-3b5a47f4a802",
                                                "sense_id": "9664d232-e37b-3a9d-bc44-011d6af8bbf1",
                                                "text": "Morgen habe ich meine mündliche Prüfung."
                                            },
                                            {
                                                "example_id": "0e0cb66b-6760-48e8-bf4d-050460afc10f",
                                                "sense_id": "9664d232-e37b-3a9d-bc44-011d6af8bbf1",
                                                "text": "„Aber mit der Einführung einer Prüfung war das Problem noch nicht gelöst.“"
                                            },
                                            {
                                                "example_id": "014bcdfc-5e21-4644-be3c-85534def54c3",
                                                "sense_id": "9664d232-e37b-3a9d-bc44-011d6af8bbf1",
                                                "text": "„Verletzt er in der Prüfung den Nachbarzahn, fällt er durch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6d5d42d-4ebd-4682-b9e5-af5e2de2f1be",
                        "source_entry_id": "1be1dcf0-1d38-3675-b5d1-b5aa8ea11456",
                        "source_sense_id": "2b7edd5d-37d8-3a02-897e-0a5e26df3cf4",
                        "source_sense_description": "Prüfung, Examen",
                        "target_lang_word": "Examen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Examen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d366b130-d272-3456-a7ed-c59aab281d9b",
                                        "entry_id": "a6b52d86-6d61-361d-a7b3-daecb47f7484",
                                        "glosses": [
                                            "Prüfungen zum Abschluss einer Ausbildung oder eines bestimmten Abschnitts einer Ausbildung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84d885da-f7b4-4288-8579-40eff2e89b3c",
                                                "sense_id": "d366b130-d272-3456-a7ed-c59aab281d9b",
                                                "text": "Alle haben ihr Examen bestanden."
                                            },
                                            {
                                                "example_id": "82f6e15c-4e2f-4991-b18b-354eee2f1293",
                                                "sense_id": "d366b130-d272-3456-a7ed-c59aab281d9b",
                                                "text": "„Hoffmann besteht das Examen im Juni 1798.“"
                                            },
                                            {
                                                "example_id": "4c7c5e59-f685-47bd-82ec-a777eb64802e",
                                                "sense_id": "d366b130-d272-3456-a7ed-c59aab281d9b",
                                                "text": "„Seine Examina hatte er nur mit Unterstützung des höchsten Mafiachefs von Sizilien bestanden, der eigens nach Palermo gefahren war, um sich mit Tazas Professoren zu unterhalten.“"
                                            },
                                            {
                                                "example_id": "2d9f7ad1-3cc3-4443-a63a-1d8ff538d597",
                                                "sense_id": "d366b130-d272-3456-a7ed-c59aab281d9b",
                                                "text": "„Nach dem Examen ruhte er sich ein Jahr lang aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f626fb86-01f4-4c25-9ed2-0cf54e484dea",
                        "source_entry_id": "1be1dcf0-1d38-3675-b5d1-b5aa8ea11456",
                        "source_sense_id": "2b7edd5d-37d8-3a02-897e-0a5e26df3cf4",
                        "source_sense_description": "Prüfung, Examen",
                        "target_lang_word": "examen",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "examen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "672c13cb-c605-30bb-9e06-f60948ee8830",
                                        "entry_id": "b30a51d1-6286-3672-84ae-c605036ce46a",
                                        "glosses": [
                                            "Observation attentive, réfléchie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6f4dd1b-8cbc-449b-936a-fc6af6ec7f0e",
                                                "sense_id": "672c13cb-c605-30bb-9e06-f60948ee8830",
                                                "text": "C’est dans ce cas qu’une uro-IRM ou un uro-scanner, examens permettant de visualiser les voies urinaires, sont réellement utiles, pour effectuer la cartographie la plus précise possible avant d’opérer."
                                            },
                                            {
                                                "example_id": "e88f4588-dc25-4943-976d-1c6ca4ea9347",
                                                "sense_id": "672c13cb-c605-30bb-9e06-f60948ee8830",
                                                "text": "Soit les assauts du conquistador s'arrêtaient au seuil de la couche, soit, si la consommation avait lieu, se déchaînaient ensuite une succession interminable d’examens médicaux : sida, syphilis, gonocoque, staphylocoque et j'en passe..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3f3cc4d-bdfb-3530-bfde-e57fe3e64c8e",
                                        "entry_id": "b30a51d1-6286-3672-84ae-c605036ce46a",
                                        "glosses": [
                                            "Examen de conscience, introspection méditative effectuée dans un esprit religieux."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b445355a-ffc5-4187-981e-7aaa3df583b4",
                                                "sense_id": "f3f3cc4d-bdfb-3530-bfde-e57fe3e64c8e",
                                                "text": "Comme premier point de l'examen, Ignace propose l'action de grâce et ensuite de demander la lumière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33c54fe8-e418-39f1-9cd1-460655d34318",
                                        "entry_id": "b30a51d1-6286-3672-84ae-c605036ce46a",
                                        "glosses": [
                                            "Action de constater le degré d’instruction ou les aptitudes d’une personne par des épreuves écrites ou orales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaa260a9-41b0-401f-9730-3b2701f2bc2f",
                                                "sense_id": "33c54fe8-e418-39f1-9cd1-460655d34318",
                                                "text": "Examen oral, examen écrit, examen physique."
                                            },
                                            {
                                                "example_id": "ca8c2d8f-9d05-463c-8cfb-323e0a22b635",
                                                "sense_id": "33c54fe8-e418-39f1-9cd1-460655d34318",
                                                "text": "Passer un examen, se préparer à un examen, réussir un examen, rater un examen"
                                            },
                                            {
