                "senses": [
                    {
                        "sense_id": "9970a673-9493-3833-b285-2588df134acc",
                        "entry_id": "2d354204-fa0b-3672-957a-d1808ed1c00a",
                        "glosses": [
                            "Bestimmung durch sich selbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0d7bf7e-b100-4e07-9fdb-e7f0b73790a4",
                                "sense_id": "9970a673-9493-3833-b285-2588df134acc",
                                "text": "„Geldhäuser wie das der Fugger stiegen zu Montanunternehmen und dann zu Montanmonopolisten auf, während die in Eigenregie schürfenden und hüttenden Bergwerkler zu Lohnarbeitern absanken.“"
                            },
                            {
                                "example_id": "44016c4d-b569-4416-bddf-c101eb745b15",
                                "sense_id": "9970a673-9493-3833-b285-2588df134acc",
                                "text": "„Ben hatte in Eigenregie die Fährte des bislang verschollenen ersten Segments der Tabula Peutingeriana aufgenommen, nachdem eine Bemerkung dazu in einem Seminar zur mittelalterlichen Geschichte seine Neugier geweckt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
