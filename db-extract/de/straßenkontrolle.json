                                "example_id": "f6f64d21-ef5c-4a56-9746-9bf9a53e1dd8",
                                "sense_id": "8b5b7839-4b67-32f4-a959-382df9868e18",
                                "text": "Bei den letzten Straßenkontrollen fielen große Frostschäden auf."
                            },
                            {
                                "example_id": "c6022664-1fea-4ebe-9ca0-e588336705a9",
                                "sense_id": "8b5b7839-4b67-32f4-a959-382df9868e18",
                                "text": "„Straßenkontrollen im Rahmen der Verkehrssicherungspflicht sind für Kommunen als Straßenbaulastträger im Rahmen der öffentlich-rechtlichen Daseinsvorsorge zwingend notwendig.“"
                            }
                        ],
