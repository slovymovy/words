                                "target_senses": [
                                    {
                                        "sense_id": "4a27db26-4492-3308-9096-0012b5285913",
                                        "entry_id": "93d05393-5b8b-328b-b0a5-7d1e35076db6",
                                        "glosses": [
                                            "Realization or understanding of the significance and nature of events after they have occurred."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f32dd167-536d-4334-8622-45d958b33796",
                                                "sense_id": "4a27db26-4492-3308-9096-0012b5285913",
                                                "text": "You know what they say, hindsight is twenty-twenty."
                                            },
                                            {
                                                "example_id": "1f36bcd5-f89e-4b20-86b7-2d2bc411fce4",
                                                "sense_id": "4a27db26-4492-3308-9096-0012b5285913",
                                                "text": "In hindsight, I realize that I should have studied harder for the exam."
                                            },
                                            {
                                                "example_id": "070e1d91-b89a-42be-a70f-eefd95b57abe",
                                                "sense_id": "4a27db26-4492-3308-9096-0012b5285913",
                                                "text": "Hindsight is more easily acquired than foresight."
                                            }
                                        ]
                                    },
