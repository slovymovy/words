                "senses": [
                    {
                        "sense_id": "9c3f2bf8-4fae-32ce-838a-6d29e7870d57",
                        "entry_id": "a404e6fc-a63a-3af9-ab7a-e1e2881a4926",
                        "glosses": [
                            "Donner un caractère ultralibéral à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23d43ccf-2220-4710-b200-2e230922b304",
                                "sense_id": "9c3f2bf8-4fae-32ce-838a-6d29e7870d57",
                                "text": "Tout le monde l’a bien constaté lors de la loi dite El-Khomri qui tend à ultralibéraliser le marché du travail, ou à l’occasion de l’élargissement du travail le dimanche."
                            },
                            {
                                "example_id": "17887ba0-5b5b-49f6-a801-d0a2d07f67dd",
                                "sense_id": "9c3f2bf8-4fae-32ce-838a-6d29e7870d57",
                                "text": "Il faut donc tout libéraliser, je dirai même ultralibéraliser, hyperlibéraliser, pour en finir avec le tout-énergie !"
                            },
                            {
                                "example_id": "4241008e-98de-42eb-8cb4-7e0ed40e0d4d",
                                "sense_id": "9c3f2bf8-4fae-32ce-838a-6d29e7870d57",
                                "text": "En attendant, il remplit sa mission : ultralibéraliser le pays et le vendre par tranche à ses amis très riches !"
                            }
                        ]
                    }
