                    {
                        "sense_id": "71c76722-0781-336b-a956-704e35e377be",
                        "entry_id": "546adc2b-7fe5-3b9a-8c56-e8afa6cfeb7a",
                        "glosses": [
                            "Qualifie une isoglosse indo-européenne où la palatovélaire /ḱ/ s'est transformée en sibilante /s/."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "729cb088-4775-4e5e-be2d-9670c80fe789",
                                "sense_id": "71c76722-0781-336b-a956-704e35e377be",
                                "text": "Le processus de « satemisation » qui a causé la séparation entre les langues satem et centum a probablement commencé dès le IVe millénaire avant notre ère et la seule chose tenue pour sûre est que cette proto-langue doit avoir été divisée en différents dialectes sans rapports directs vers la fin du IIIe millénaire avant notre ère."
                            },
                            {
                                "example_id": "242af951-8649-4c35-8df8-7f9162ebc436",
                                "sense_id": "71c76722-0781-336b-a956-704e35e377be",
                                "text": "Le proto-slave ou slave commun, ancêtre du vieux slave et des langues slaves est issu de la branche satem de l'indo-européen commun."
                            }
                        ]
                    }
                ],
