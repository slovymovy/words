                "senses": [
                    {
                        "sense_id": "c670902b-9d02-3583-9b88-e3a5c8c9d00f",
                        "entry_id": "770d1ae4-dc6a-3f4c-8999-a9dec8c9b109",
                        "glosses": [
                            "Tag, an dem man arbeitet (zur Arbeit geht)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01bd84bc-b394-41b6-b6ad-8b75aae179d5",
                                "sense_id": "c670902b-9d02-3583-9b88-e3a5c8c9d00f",
                                "text": "Es war ein gewöhnlicher Arbeitstag."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "83b2f39e-ca2e-3ff2-99e3-0989e2f16c0f",
                        "entry_id": "770d1ae4-dc6a-3f4c-8999-a9dec8c9b109",
                        "glosses": [
                            "die Zeitspanne an einem Tag, in der gearbeitet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ab720ec-17a0-4d27-abc8-df8cee245221",
                                "sense_id": "83b2f39e-ca2e-3ff2-99e3-0989e2f16c0f",
                                "text": "„Aber er hatte in der Nacht wenig geschlafen und fühlte sich recht müde, und so wurde es ein wenig fruchtbarer Arbeitstag, und Fürst Andrej kam nicht recht von der Stelle, hatte immerfort etwas an seiner eigenen Arbeit auszusetzen, was übrigens häufig vorkam, und war recht froh, als er hörte, dass er Besuch bekam.“"
                            },
                            {
                                "example_id": "9852360a-47d1-4bf2-9dc1-c1b5d5da2d7c",
                                "sense_id": "83b2f39e-ca2e-3ff2-99e3-0989e2f16c0f",
                                "text": "„Högni schüttelte den Kopf, steckte sich eine Boulette in den Mund und berichtete als Nächstes, dass der Arbeitstag in Ordnung gewesen war.“"
                            },
                            {
                                "example_id": "4dd1f1fc-0907-4b10-a295-f65f531d0f96",
                                "sense_id": "83b2f39e-ca2e-3ff2-99e3-0989e2f16c0f",
                                "text": "„Schreiben müßte er, doch das Leben in Plock eignet sich kaum dazu, sofern er sich nach dem Arbeitstag noch der Musik widmen will.“"
                            },
                            {
                                "example_id": "1864d530-d40f-4021-b7f2-d0a5546ea481",
                                "sense_id": "83b2f39e-ca2e-3ff2-99e3-0989e2f16c0f",
                                "text": "„Hans und Kostas liebten diesen Moment am Ende eines harten Arbeitstages beide sehr.“"
                            },
                            {
                                "example_id": "1e04fbd4-bf66-4c51-9b96-2354e0b261d1",
                                "sense_id": "83b2f39e-ca2e-3ff2-99e3-0989e2f16c0f",
                                "text": "„Doch nun sah er, dass sie trotz aller Schläge, die ihnen das Leben versetzt hatte, trotz mühevoller Kämpfe und langer Arbeitstage an dm Ort lebten, den sie liebten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "196d5122-f990-421b-91ff-0135723c6506",
                        "source_entry_id": "770d1ae4-dc6a-3f4c-8999-a9dec8c9b109",
