                        "glosses": [
                            "Celui qui bazarde."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "5320ae92-c78f-45af-8e02-9ed8a4a13b20",
                                "sense_id": "057232bb-7636-3797-aaff-5f1c2675efea",
                                "text": "Enfin, il faut faire de l’argent; il reste encore quelques effets, et, bientôt, le marchand ambulant qu’on appelle ici bazardeur, est chargé de la dernière dépouille de celui qui sait mal diriger sa conduite."
                            },
                            {
                                "example_id": "1774e414-ac4c-4167-a109-13ddd57c7c0a",
                                "sense_id": "057232bb-7636-3797-aaff-5f1c2675efea",
                                "text": "Les journaux me comblent à l’époque de surnoms variés : le faux monnayeur, le charlatan monétaire, le bazardeur du franc, le jongleur du franc, le rongeur du franc…"
                            }
                        ]
                    },
                    {
                        "sense_id": "7fcd54eb-cf6a-39ae-99a6-af4d6a8525f6",
                        "entry_id": "9eb2895d-c0e6-3eaf-83a8-73977a530004",
                        "glosses": [
                            "Vendeur de bric-à-brac, camelot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43eae362-49b1-4804-b95d-9ff5a3c91594",
                                "sense_id": "7fcd54eb-cf6a-39ae-99a6-af4d6a8525f6",
                                "text": "Le bazardeur est soufflé ; elle se croit chez Fior, cette petite conasse."
                            }
                        ]
                    }
