                "senses": [
                    {
                        "sense_id": "f3ebc707-96c1-3625-8ac8-ae8198628b9a",
                        "entry_id": "cd14ab92-c739-3913-a2bf-879508883233",
                        "glosses": [
                            "Débarrasser des grumeaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48654e5c-9d67-4e23-96fe-ab738c6d0256",
                                "sense_id": "f3ebc707-96c1-3625-8ac8-ae8198628b9a",
                                "text": "Le vieux oing est aussi très-utile pour graisser le poitrail et les sabots des pieds des chevaux, et dégrumeler le pis des vaches."
                            },
                            {
                                "example_id": "a21d3885-f615-402c-9580-f0547aec3d10",
                                "sense_id": "f3ebc707-96c1-3625-8ac8-ae8198628b9a",
                                "text": "Voudroit-on dégrumeler le sang épanché ?"
                            },
                            {
                                "example_id": "041c2aa8-a671-4310-aa83-662930addbcf",
                                "sense_id": "f3ebc707-96c1-3625-8ac8-ae8198628b9a",
                                "text": "Quand je veux me dégrumeler la pensarde, me gymnastiquer le cerveau, c’est vers Apollinaire que je me tourne."
                            }
                        ]
                    }
