                        "examples": [
                            {
                                "example_id": "21723ae8-c454-409d-8dd4-375aec0d1a4e",
                                "sense_id": "660195a9-2145-3ac5-af5d-1406724328ea",
                                "text": "\"Als getrouwde mannen met een gezin tot priester gewijd mogen worden in het Amazonegebied, kan dat op den duur ook een oplossing zijn voor bijvoorbeeld Europa. Ook hier is immers een groot tekort aan priesters.\""
                            },
                            {
                                "example_id": "579b547c-2c13-4633-92e8-129876dc6e56",
                                "sense_id": "660195a9-2145-3ac5-af5d-1406724328ea",
                                "text": "De ontbossing in het Braziliaanse Amazonegebied is gestegen tot het hoogste niveau in twaalf jaar. Ruim 11.000 vierkante kilometer van het regenwoud is verloren gegaan tussen augustus 2019 en juli van dit jaar, blijkt uit cijfers van het Braziliaanse ruimteagentschap INPE. Dat is een stijging van 9,5 procent vergeleken met vorig jaar."
                            }
                        ]
