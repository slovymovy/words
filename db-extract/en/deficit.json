                "entry_id": "35450bd7-3f19-38d8-bb1a-0c1a096f9eea",
                "word": "deficit",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "45b8500c-3424-451e-92cc-cd898b92647e",
                        "entry_id": "35450bd7-3f19-38d8-bb1a-0c1a096f9eea",
