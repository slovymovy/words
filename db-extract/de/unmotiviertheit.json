                "senses": [
                    {
                        "sense_id": "1ccd2dcc-5e73-3bda-8d29-106dab73b38d",
                        "entry_id": "00c8aaf5-c852-3b1e-8317-92baafb99315",
                        "glosses": [
                            "das Fehlen von Motivation, innerem Antrieb zu etwas"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "7698889f-b8f2-4f8d-a77a-d85beeb5cff2",
                                "sense_id": "1ccd2dcc-5e73-3bda-8d29-106dab73b38d",
                                "text": "Die Unmotiviertheit der Leute bei Wahlen nimmt überhand."
                            },
                            {
                                "example_id": "f60f1a1f-8e1c-4799-b2e6-cbc19e961042",
                                "sense_id": "1ccd2dcc-5e73-3bda-8d29-106dab73b38d",
                                "text": "„Der internen Mitarbeiterinformation von ODS zufolge wurde die Handverpackung der CDs \"aufgrund der Unmotiviertheit der Mitarbeiter\" bereits vor über einem Jahr nach Polen verlegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fabfa52c-1899-36f6-bfde-032259cf7857",
                        "entry_id": "00c8aaf5-c852-3b1e-8317-92baafb99315",
                        "glosses": [
                            "Eigenschaft von Morphemen oder Wörtern, die mit ihrer Form keinen Aufschluss über ihre Bedeutung geben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "339ff9ef-f719-4259-b7c6-e15c08f46c05",
                                "sense_id": "fabfa52c-1899-36f6-bfde-032259cf7857",
                                "text": "Wörter wie „Salbader“ (Schwätzer) zeichnen sich durch Unmotiviertheit aus: Man kann aus den denkbaren Wortteilen „Sal“ + „bad“ + „er“ nicht auf die Bedeutung des Wortes schließen."
                            },
                            {
                                "example_id": "a902881a-f51e-4e40-8647-0ff8f340b7fe",
                                "sense_id": "fabfa52c-1899-36f6-bfde-032259cf7857",
                                "text": "Unmotiviertheit bedeutet in der Linguistik, dass ein Ausdruck in seiner Struktur undurchsichtig ist, d.h. man kann ihn nicht in Bestandteile zerlegen, die zur Bedeutung des Ganzen beitragen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
