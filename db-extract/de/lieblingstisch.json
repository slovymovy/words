                ],
                "senses": [
                    {
                        "sense_id": "70f724e2-c5f6-3e44-aa9e-e76fb3be47e8",
                        "entry_id": "a12b71c6-bf56-3356-a7b0-50bc03299b0b",
                        "glosses": [
                            "Tisch, den jemand am meisten mag, an dem jemand am liebsten sitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8938a848-ce0b-4599-b7c9-6be629125103",
                                "sense_id": "70f724e2-c5f6-3e44-aa9e-e76fb3be47e8",
                                "text": "„Hatte sie ihren Lieblingstisch mit Absicht gewählt?“"
                            },
                            {
                                "example_id": "7a871565-6be2-485b-956d-3c5508a625ba",
                                "sense_id": "70f724e2-c5f6-3e44-aa9e-e76fb3be47e8",
                                "text": "„Wenn eine der örtlichen Schildkröten hereinkommt, eine Hand um die Perlenkette an ihrem verwelkten Hals gekrallt, die alte Mrs. Burton oder Mrs. Seymour oder Mrs. Perry, und eine dieser dünnen gebräunten Sommerfrauen an ihrem seit 1865 persönlichen Lieblingstisch sitzen sieht und sagt: ›Misty, wie konntest du nur? Du weißt doch, dass ich dienstag- und donnerstagsmittags regelmäßig zum Essen komme. Also wirklich, Misty...‹, brauchst du gleich zwei Drinks.“"
                            },
                            {
                                "example_id": "5209736a-5301-4b5c-ac39-56c676e622a8",
                                "sense_id": "70f724e2-c5f6-3e44-aa9e-e76fb3be47e8",
                                "text": "„Sie begrüßte ihn namentlich und musterte die beiden anderen Männer kurz neugierig, so wie es auch die älteren Semester an einem der Tische taten, von Court jedoch nahm niemand Notiz, nicht mal sein Vater, als er nur einen Meter von ihm entfernt durchging zu seinem Lieblingstisch, einer Sitzecke ganz hinten.“"
                            },
                            {
                                "example_id": "00aebd13-f278-4c96-a27c-49463b7b1efa",
                                "sense_id": "70f724e2-c5f6-3e44-aa9e-e76fb3be47e8",
                                "text": "„Der Oberkellner des Ritz führte sie an Sir Davids Lieblingstisch, der in einer hinteren Ecke des Esszimmers lag und einen schönen Blick auf den Green Park bot.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
