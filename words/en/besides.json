                {
                    "sense_id": "4408860c-5ab7-3d1f-a27c-1a02973a4ef9",
                    "sense_definition": "As well; in addition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sem_addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave me some advice and money <w>besides</w>.",
                            "target_lang_translations": {
                                "ru": "Она дала мне совет и денег <w>вдобавок</w>.",
                                "zh": "她给了我一些建议，<w>另外</w>还给了我钱。",
                                "pl": "Dała mi radę i <w>dodatkowo</w> pieniądze.",
                                "fr": "Elle m'a donné des conseils et de l'argent <w>en plus</w>."
                            }
                        },
                        {
                            "text": "The house is large and beautiful, and cheap <w>besides</w>.",
                            "target_lang_translations": {
                                "ru": "Дом большой и красивый, и <w>к тому же</w> дешевый.",
                                "zh": "这房子又大又漂亮，<w>而且</w>很便宜。",
                                "pl": "Dom jest duży i piękny, a <w>poza tym</w> tani.",
                                "fr": "La maison est grande et belle, et <w>en plus</w> bon marché."
                            }
                        }
                    ],
                    "common_phrases": [
                        "and more besides"
                    ],
                    "target_lang_definitions": {
                        "ru": "Также; вдобавок.",
                        "zh": "也；另外。",
                        "pl": "Także; w dodatku.",
                        "fr": "Également ; en plus."
