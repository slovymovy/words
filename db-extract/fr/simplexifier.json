                "senses": [
                    {
                        "sense_id": "d45db03f-6ea8-36fc-8534-a9753ba370e7",
                        "entry_id": "d1b2980d-c8d0-3959-9103-68c58b1c9a78",
                        "glosses": [
                            "Rendre un système simplexe"
                        ],
                        "tags": [
                            "Ingénierie"
                        ],
                        "examples": [
                            {
                                "example_id": "319d9938-2cdc-4c0e-b28e-e80d51f3d63a",
                                "sense_id": "d45db03f-6ea8-36fc-8534-a9753ba370e7",
                                "text": "Il ajoute sa première valeur à la dite problématique par la compréhension qu’il en a et qu'il sait simplexifier."
                            },
                            {
                                "example_id": "6ccd2123-336b-4575-a3ce-97909b4cb7de",
                                "sense_id": "d45db03f-6ea8-36fc-8534-a9753ba370e7",
                                "text": "Troisième futur souhaitable, ce mercredi: celui d'une monde \"simplexifié\" ou comment rendre simple ce qui est complexe…"
                            },
                            {
                                "example_id": "422aa60b-0bcf-48cb-bc16-ea19b05ad8de",
                                "sense_id": "d45db03f-6ea8-36fc-8534-a9753ba370e7",
                                "text": "Ces expositions sont pensées comme des harmonies colorées qui voudraient simplexifier l'architecture végétale."
                            }
                        ]
                    }
