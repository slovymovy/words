                ],
                "translations": [
                    {
                        "translation_id": "1fcdd0bb-aa7b-4293-bd37-2c865f689bbc",
                        "source_entry_id": "698b9bdd-c571-3570-bd94-a3e48c1a09f3",
                        "source_sense_id": "7cec72aa-6e0c-324c-a029-da344c1626cd",
                        "target_lang_word": "alimentation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alimentation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25dea49d-7b42-3f7f-aba8-c5dc5ec99708",
                                        "entry_id": "4ad2e6ce-a590-3640-b2ad-65bc927325a1",
                                        "glosses": [
                                            "Action d’alimenter ou de s’alimenter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49ec423d-6de9-4fde-a55a-93c76b398989",
                                                "sense_id": "25dea49d-7b42-3f7f-aba8-c5dc5ec99708",
                                                "text": "L’alimentation a pour but de faire pénétrer dans l’organisme animal les matériaux nécessaires à la nutrition."
                                            },
                                            {
                                                "example_id": "5f9f676f-6f97-41be-aba6-170c57bca773",
                                                "sense_id": "25dea49d-7b42-3f7f-aba8-c5dc5ec99708",
                                                "text": "Naturellement, de tout l'hiver, le crapaud ne prend aucune nourriture. Une abondante alimentation estivale a entreposé dans son organisme quantité de matériaux nutritifs."
                                            },
                                            {
                                                "example_id": "0db147eb-8637-4dbf-b5ce-cc7cfaaf483e",
                                                "sense_id": "25dea49d-7b42-3f7f-aba8-c5dc5ec99708",
                                                "text": "[…]: l'abatage des animaux destinés à l’alimentation de la population se faisait encore en ville où chaque boucher possédait son écorcherie particulière; […]."
                                            },
                                            {
                                                "example_id": "36d330b8-2b73-4207-b6a6-ad5cf9c91a19",
                                                "sense_id": "25dea49d-7b42-3f7f-aba8-c5dc5ec99708",
                                                "text": "Par exemple, de la folle-avoine sera plus inacceptable dans une production de céréales destinée à la panification, que une céréale destinée à l’alimentation du bétail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fc614bc-497f-3093-9e75-5fce1be17d70",
                                        "entry_id": "4ad2e6ce-a590-3640-b2ad-65bc927325a1",
                                        "glosses": [
                                            "Magasin d'aliments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee94d778-6a19-44de-a26b-20bbf0674788",
                                                "sense_id": "2fc614bc-497f-3093-9e75-5fce1be17d70",
                                                "text": "Il y avait plusieurs cafés proches du sien, mais pas d'autre alimentation. … les belles épiceries d'avant-guerre campaient dans des baraquements jaunes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "161ab3d0-a3d9-3a3a-a6b8-768190ca5c20",
                                        "entry_id": "4ad2e6ce-a590-3640-b2ad-65bc927325a1",
                                        "glosses": [
                                            "Domaine de tout ce qui se rapporte à l’apport de nourriture permettant à un organisme vivant de fonctionner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2a343cb-8905-3390-ae12-0a4d2da8fdef",
                                        "entry_id": "4ad2e6ce-a590-3640-b2ad-65bc927325a1",
                                        "glosses": [
                                            "Système secondaire, qui assure l’apport d’éléments de base et d’énergie à un système principal qui dépend du premier pour son fonctionnement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c7cf2d4-312f-4b08-b71d-e65b3c48afd8",
                                                "sense_id": "b2a343cb-8905-3390-ae12-0a4d2da8fdef",
                                                "text": "— Les organes qui concourent à l'alimentation sont : Les cylindres alimentaires, les pressions, les guide-fils, les tambours entraîneurs d'ensouple et les supports d'ensouple."
                                            },
                                            {
                                                "example_id": "59287221-0e01-40c5-b04b-dca4c063fe74",
                                                "sense_id": "b2a343cb-8905-3390-ae12-0a4d2da8fdef",
                                                "text": "Le système d’alimentation en carburant d’un moteur."
                                            },
                                            {
                                                "example_id": "e899d998-1010-43e8-a676-cff5100faf80",
                                                "sense_id": "b2a343cb-8905-3390-ae12-0a4d2da8fdef",
                                                "text": "Les alimentations des microordinateurs utilisent depuis longtemps un système à découpage qui leur épargne les lourds transformateurs fonctionnant à cinquante hertz qui seraient, sinon, nécessaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5f1a30d-08e5-4b9f-92c3-214a72bea071",
                        "source_entry_id": "698b9bdd-c571-3570-bd94-a3e48c1a09f3",
                        "source_sense_id": "7cec72aa-6e0c-324c-a029-da344c1626cd",
                        "target_lang_word": "subsistance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subsistance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22ded971-648e-36d5-845b-8564a8ac1d16",
                                        "entry_id": "b0373a7f-ac13-3c9b-9c77-d2833bfcbf1e",
                                        "glosses": [
                                            "Nourriture et entretien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66a51229-4a8e-43a6-a054-2b71b760b461",
                                                "sense_id": "22ded971-648e-36d5-845b-8564a8ac1d16",
                                                "text": "Vendresse, Troyon, Verneuil sont en proie à la même misère. Corbeny n'est plus qu'un monceau de ruines où il ne reste aucune ressource pour la subsistance même des habitants."
                                            },
                                            {
                                                "example_id": "5fe35e77-5fda-4414-b5ce-b11f3f8d867b",
                                                "sense_id": "22ded971-648e-36d5-845b-8564a8ac1d16",
                                                "text": "Il travaille pour la subsistance de sa famille."
                                            },
                                            {
                                                "example_id": "775691fc-6991-41cf-b091-8aaac136f439",
                                                "sense_id": "22ded971-648e-36d5-845b-8564a8ac1d16",
                                                "text": "Il n’a aucun moyen de subsistance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4817ef93-7404-3d8e-9928-3aa96e7e0fef",
                                        "entry_id": "b0373a7f-ac13-3c9b-9c77-d2833bfcbf1e",
                                        "glosses": [
                                            "Mettre un homme en subsistance dans un régiment, Recueillir dans ce régiment un soldat isolé dont le corps est éloigné, le nourrir et lui donner la solde."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70391bcc-74ba-35bc-be7c-a5c12e88bc26",
                                        "entry_id": "b0373a7f-ac13-3c9b-9c77-d2833bfcbf1e",
                                        "glosses": [
                                            "Tout ce qui est nécessaire à la nourriture et à l’entretien d’une armée."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8befc2c5-044b-4442-aa83-099633cb4659",
                                                "sense_id": "70391bcc-74ba-35bc-be7c-a5c12e88bc26",
                                                "text": "Les subsistances, dans ce moment, inquiètent le gouvernement, elles inquiètent les gouvernés, elles inquiètent en particulier les fermiers ces derniers sont indécis sur le parti qu'ils doivent prendre pour la vente de leurs grains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d98e2955-4fbd-43c5-bc6e-ae56bf548865",
                        "source_entry_id": "698b9bdd-c571-3570-bd94-a3e48c1a09f3",
                        "source_sense_id": "7cec72aa-6e0c-324c-a029-da344c1626cd",
                        "target_lang_word": "entretien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entretien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5230f2f8-af04-3c0f-bc92-f7b835431a07",
                                        "entry_id": "1b80e0c5-4add-3715-ad73-28a867d4e255",
                                        "glosses": [
                                            "Maintenance ; ensemble des soins et dépenses qu'exigent le maintien de certaines choses en bon état."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c608d534-41b5-4606-87f6-580b80a7464f",
                                                "sense_id": "5230f2f8-af04-3c0f-bc92-f7b835431a07",
                                                "text": "Il m’est dit à chaque instant que l’un des grands soucis des autorités départementales, c’est l’entretien des routes, souvent emportées par des torrents, par les coulées de boue, par les éboulements, par des chutes de blocs."
                                            },
                                            {
                                                "example_id": "8854b007-d626-4b7a-811b-aa9d67417b3c",
                                                "sense_id": "5230f2f8-af04-3c0f-bc92-f7b835431a07",
                                                "text": "Les villes de l’intérieur n’étaient protégées que par des murailles en pisé flanquées de tours et de bastions dont l’entretien incombait, en principe, aux habous mais qui tombaient généralement en ruines."
                                            },
                                            {
                                                "example_id": "a36dd8aa-8525-4643-a41a-2d1660152a92",
                                                "sense_id": "5230f2f8-af04-3c0f-bc92-f7b835431a07",
                                                "text": "Entre le travail en usine, le ramendage des filets, l’entretien des vêtements de pêche, la tenue du foyer et les maternités, les femmes de Douarnenez sont des battantes avant la lettre !"
                                            },
                                            {
                                                "example_id": "e0712eda-56b2-412c-a2f7-68825a86c50b",
                                                "sense_id": "5230f2f8-af04-3c0f-bc92-f7b835431a07",
                                                "text": "Ainsi sur les 93 kilomètres de route nationale, seuls les 23 de la récente RN3 sont en excellent état ; les autres ne sont maintenus dans un état circulable qu’au prix d’un entretien lourd et dispendieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a7b4c67-b71e-3e66-8668-59c163826456",
                                        "entry_id": "1b80e0c5-4add-3715-ad73-28a867d4e255",
                                        "glosses": [
                                            "Ensemble des travaux de jardin ayant pour objet les soins apportés aux pelouses et aux végétaux et le nettoyage des massifs et des circulations."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4962b6d-817a-4dd3-b4a7-8264797bb296",
                                                "sense_id": "9a7b4c67-b71e-3e66-8668-59c163826456",
                                                "text": "Les biquettes se nourrissent des broussailles. Elles permettent l’entretien de la végétation de cette réserve naturelle."
                                            },
                                            {
                                                "example_id": "ac5f7313-08b3-4dc0-a60f-59341c14be48",
                                                "sense_id": "9a7b4c67-b71e-3e66-8668-59c163826456",
                                                "text": "Je fais appel à un jardinier pour l’entretien des espaces verts."
                                            },
                                            {
                                                "example_id": "9aee1ee7-cd2c-4835-a876-e16a3c50fb04",
                                                "sense_id": "9a7b4c67-b71e-3e66-8668-59c163826456",
                                                "text": "Les jardiniers font des travaux d’entretien et aussi de création (bassin, rocaille, plantations, gazons, dallages, allées, etc.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cda30a4a-8353-3ac9-a514-aea958837acf",
                                        "entry_id": "1b80e0c5-4add-3715-ad73-28a867d4e255",
                                        "glosses": [
                                            "Fait de maintenir sa santé, sa forme physique, ses capacités intellectuelles ou toute autre chose dans un certain état."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "238ad3f7-c820-4cb5-9e90-bcb072c168cb",
                                                "sense_id": "cda30a4a-8353-3ac9-a514-aea958837acf",
                                                "text": "Tous les matins il fait de la gymnastique d’entretien pour garder la forme."
                                            },
                                            {
                                                "example_id": "3a92ba51-2a77-4fa9-9337-6889cb59b70f",
                                                "sense_id": "cda30a4a-8353-3ac9-a514-aea958837acf",
                                                "text": "Lire ce magazine est excellent pour l’entretien de mes connaissances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e241d86b-3822-3c28-8086-909eb61e94c8",
                                        "entry_id": "1b80e0c5-4add-3715-ad73-28a867d4e255",
                                        "glosses": [
                                            "Ce qui est nécessaire pour la subsistance matérielle d’un individu ou d’un groupe et le fait de pourvoir à cette subsistance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9345a57b-9ba3-4576-968b-d5519827f4a6",
                                                "sense_id": "e241d86b-3822-3c28-8086-909eb61e94c8",
                                                "text": "Il n’épargne rien pour assurer l’entretien de ses enfants."
                                            },
                                            {
                                                "example_id": "18253e08-606d-4afd-b2c2-e8b6082a82f0",
                                                "sense_id": "e241d86b-3822-3c28-8086-909eb61e94c8",
                                                "text": "Il dépense tant pour l’entretien de sa femme !"
                                            },
                                            {
                                                "example_id": "2cfb3c8d-f644-4cd7-96fe-9d176138031b",
                                                "sense_id": "e241d86b-3822-3c28-8086-909eb61e94c8",
                                                "text": "L’entretien des fonctionnaires est à la charge du contribuable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c89942d9-56e3-36aa-9e1c-9eed771863a9",
                                        "entry_id": "1b80e0c5-4add-3715-ad73-28a867d4e255",
                                        "glosses": [
                                            "Action de s’entretenir avec une ou plusieurs personnes, discussion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc05557a-0ddd-43c6-9f26-0f9fefd214bf",
                                                "sense_id": "c89942d9-56e3-36aa-9e1c-9eed771863a9",
                                                "text": "Si l’on faisait une sérieuse attention à tout ce qui se dit de froid, de vain et de puéril, dans les entretiens ordinaires, l’on aurait honte de parler ou d’écouter."
                                            },
                                            {
                                                "example_id": "f3150b3b-4606-4a08-81d3-c6d7484835e3",
                                                "sense_id": "c89942d9-56e3-36aa-9e1c-9eed771863a9",
                                                "text": "Un correspondant du Daily Herald voulut interviewer Guimauve sur son système de socialisation des femmes, mais Guimauve se refusa à tout entretien. Il avait avalé sa langue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26cc1d76-90f5-3efd-a5e2-f1ad432ebf28",
                                        "entry_id": "1b80e0c5-4add-3715-ad73-28a867d4e255",
                                        "glosses": [
                                            "Ouvrage rédigé sous forme de dialogues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7f863c3-d488-4a60-956a-2a76b81dde39",
                                                "sense_id": "26cc1d76-90f5-3efd-a5e2-f1ad432ebf28",
                                                "text": "Les \"entretiens sur la pluralité des mondes habités\" de Fontenelle."
                                            },
                                            {
                                                "example_id": "c0400506-0ce4-4601-b721-ce25f6b854a6",
                                                "sense_id": "26cc1d76-90f5-3efd-a5e2-f1ad432ebf28",
                                                "text": "Les \"entretiens\" d’Érasme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8580b8ad-03de-340b-b3d9-0cdb5727d1f5",
                                        "entry_id": "1b80e0c5-4add-3715-ad73-28a867d4e255",
                                        "glosses": [
                                            "Colloque, symposium, réunion de spécialistes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45969176-5897-4747-b8f8-37fcba06b40f",
                                                "sense_id": "8580b8ad-03de-340b-b3d9-0cdb5727d1f5",
                                                "text": "Les entretiens de Bichat font régulièrement la une de l’actualité."
