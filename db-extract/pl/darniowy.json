                        "examples": [
                            {
                                "example_id": "853daa4a-6246-43d1-875f-d251b766d071",
                                "sense_id": "450e14b2-ae08-3d8b-840a-9e7c499decd4",
                                "text": "Wieża, zwana gichtą, służyła do wyciągania za pomocą ręcznego dźwigu wsadu – czyli darniowej rudy żelaza, węgla drzewnego i topników – na sporą wysokość, aby zasypać nim zbudowany w pobliżu cylindryczny wielki piec."
                            }
                        ],
