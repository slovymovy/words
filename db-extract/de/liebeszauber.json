                    {
                        "sense_id": "7473e985-d45d-3fc7-8f6f-abec39301c4c",
                        "entry_id": "03c09ef0-8055-3a1b-a1f0-516e1d7c4f14",
                        "glosses": [
                            "Zauber (magische Handlung, magischer Gegenstand), der jemanden verliebt machen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e215514-8062-4e3c-87fb-4fe0bb21830c",
                                "sense_id": "7473e985-d45d-3fc7-8f6f-abec39301c4c",
                                "text": "„Ich hoffe, daß der Leser mir gütigst glaubt, daß ich von keinem Liebeszauber etwas hielt und das Pergament nur zu meinem Spaß für einen halben Scudo gekauft hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a4d4a3bd-90a7-3fab-b1e0-abdbd2f7a3d9",
                        "entry_id": "03c09ef0-8055-3a1b-a1f0-516e1d7c4f14",
                        "glosses": [
                            "Verzauberung, die durch Liebe ausgelöst wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "911a350c-481b-4e89-944e-7821c35a47cd",
                                "sense_id": "a4d4a3bd-90a7-3fab-b1e0-abdbd2f7a3d9",
                                "text": "„Aber je länger Borkhausen guckte, um so klarer wurde ihm, daß um das Paar da drinnen kein Liebeszauber blühte. Sondern sie redeten kaum miteinander […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
