                "senses": [
                    {
                        "sense_id": "34bca756-5dcf-3602-831b-0d6b73bd0705",
                        "entry_id": "4a801d46-d5bd-3079-9fc0-4893851ddb82",
                        "glosses": [
                            "verteiltes oder vermischtes Auftreten von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54999957-5e43-4e20-884f-a9c4dc80b426",
                                "sense_id": "34bca756-5dcf-3602-831b-0d6b73bd0705",
                                "text": "„Mit zunehmendem Grade der Durchbewegung nimmt auch die Durchsetzung des Erzes mit Silikaten stark zu […].“"
                            },
                            {
                                "example_id": "dfb2fa60-0e83-46b0-8de2-898e265bdf43",
                                "sense_id": "34bca756-5dcf-3602-831b-0d6b73bd0705",
                                "text": "„Es ist gar nicht daran zu zweifeln, daß infolge der Durchsetzung des feuerfesten Steines mit dispersen eisele haltigen Stoffen Blasen auftreten.“"
                            },
                            {
                                "example_id": "e50f2e80-0b5b-4bdc-9b2c-2241e255596f",
                                "sense_id": "34bca756-5dcf-3602-831b-0d6b73bd0705",
                                "text": "„Das Gewebe zeigt beulenartige zusammenfließende entzündliche Durchsetzungen sowie grobe Blutungen.“"
                            },
                            {
                                "example_id": "22c8fba7-6665-4528-98f7-ccc5c1b72b1c",
                                "sense_id": "34bca756-5dcf-3602-831b-0d6b73bd0705",
                                "text": "„Mehrfache Durchsetzungen des Kammgranits durch Zweiglimmergranit schließt auch der Fußweg auf, der von Weier in nördlicher Richtung durch die Weinberge in den Wald führt […].“"
                            },
                            {
                                "example_id": "57cc4525-8a9f-489b-afc8-06a5195ad870",
                                "sense_id": "34bca756-5dcf-3602-831b-0d6b73bd0705",
                                "text": "„Eitrige Einschmelzungen und leukozytäre Durchsetzungen des Gewebes fehlen grundsätzlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
