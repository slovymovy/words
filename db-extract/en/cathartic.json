                                                "example_id": "fb990c76-54a9-4e91-aa89-1393c5aa8d68",
                                                "sense_id": "1d76aa29-2d59-3a77-b6cd-110359e03ff4",
                                                "text": "Bei Verstopfung benötigt man manchmal ein Abführmittel."
                                            },
                                            {
                                                "example_id": "c9fc7a04-bf6a-4181-a9be-491b9e90f850",
                                                "sense_id": "1d76aa29-2d59-3a77-b6cd-110359e03ff4",
                                                "text": "„Da sie sich auf niemand anders verließen, behandelten sie ihr Vieh selbst, gaben ihm Abführmittel und Klistiere.“"
                                            }
                                        ],
