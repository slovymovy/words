                        "glosses": [
                            "gebouw waarin gemeenteambtenaren werken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dbc3867-d47c-41c5-a594-cc56fc2e2d52",
                                "sense_id": "8b4fa354-4955-30ea-bd0e-a0c0ff121675",
                                "text": "In de gemeente wordt al maanden geruzied over waar de ambtenaren van de plaats moeten zitten. Er is een nieuw gemeentekantoor gekocht in Edam, het historische pand waar vroeger het Hoogheemraadschap zat. Volendammers willen daar echter niet naartoe, omdat ze in de eigen plaats willen blijven werken."
                            },
                            {
                                "example_id": "617b8bae-7ade-4b27-9599-6e3834ebe6b5",
                                "sense_id": "8b4fa354-4955-30ea-bd0e-a0c0ff121675",
                                "text": "Volgens de gemeente was er een gesprek op het gemeentekantoor aan vooraf gegaan. Daar kreeg de verdachte te horen dat er twijfels waren over zijn woonadres en dat er later op de dag een huisbezoek zou zijn."
                            }
                        ]
                    }
