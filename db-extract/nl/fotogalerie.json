                            {
                                "example_id": "d74ed2b3-d1da-463f-8965-ee72414c004e",
                                "sense_id": "57a20953-af4b-3c6e-8eb2-2989c3f44815",
                                "text": "\"Toch denk ik dat we het wel gaan overleven\", zegt directeur Erik de Jong. \"We zijn druk bezig om andere geldstromen binnen te harken. We willen bijvoorbeeld een fotogalerie beginnen waar foto's te koop zijn.\""
                            }
                        ]
