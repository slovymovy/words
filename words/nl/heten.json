                    "semantic_group_id": "meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat <w>heet</w> geluk hebben, want het had veel slechter kunnen aflopen.",
                            "target_lang_translations": {
                                "ru": "Это <w>называется</w> повезло, так как всё могло закончиться гораздо хуже.",
                                "en": "That <w>is called</w> being lucky, because it could have ended much worse.",
                                "pl": "To <w>nazywa się</w> mieć szczęście, bo mogło się to skończyć o wiele gorzej.",
                                "de": "Das <w>heißt</w> Glück haben, denn es hätte viel schlimmer ausgehen können.",
                                "fr": "Cela <w>s'appelle</w> avoir de la chance, car cela aurait pu bien plus mal se terminer.",
                                "it": "Questo si <w>chiama</w> avere fortuna, perché sarebbe potuta andare molto peggio.",
                                "cs": "Tomu se <w>říká</w> mít štěstí, protože to mohlo dopadnout mnohem hůř.",
                                "tr": "Buna şanslı olmak <w>denir</w>, çünkü çok daha kötü bitebilirdi.",
                                "es": "A eso se le <w>llama</w> tener suerte, porque podría haber terminado mucho peor."
                            }
                        },
                        {
                            "text": "Zonder te betalen weglopen <w>heet</w> diefstal.",
                            "target_lang_translations": {
                                "ru": "Уйти не заплатив <w>называется</w> кражей.",
                                "en": "Walking away without paying <w>is considered</w> theft.",
                                "pl": "Ucieczka bez płacenia <w>nazywa się</w> kradzieżą.",
                                "de": "Ohne zu bezahlen wegzulaufen, <w>heißt</w> Diebstahl.",
                                "fr": "Partir sans payer, cela <w>s'appelle</w> du vol.",
                                "it": "Andarsene senza pagare si <w>chiama</w> furto.",
                                "cs": "Odejít bez placení se <w>nazývá</w> krádež.",
                                "tr": "Ödemeden kaçıp gitmek hırsızlık <w>sayılır</w>.",
                                "es": "Irse sin pagar se <w>considera</w> un robo."
                            }
                        }
