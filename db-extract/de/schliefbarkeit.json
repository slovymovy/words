                        "examples": [
                            {
                                "example_id": "1a0e3ee3-3a3c-4ebf-b20d-e65d68cf84fb",
                                "sense_id": "ff396460-08ea-36ee-9595-ad2a19cfb860",
                                "text": "„Aus der Berechnung der zu bewältigenden Wassermassen ergibt sich die Dimension des Kanales und die mag man ungescheut und ohne Rücksicht auf Schliefbarkeit oder elementare Regen beibehalten.“"
                            },
                            {
                                "example_id": "7b6a3d6e-2dba-40a3-80f4-6aab5d3083fc",
                                "sense_id": "ff396460-08ea-36ee-9595-ad2a19cfb860",
                                "text": "„Es wäre allerdings thunlich gewesen die Muffen innerhalb der Röhren anzubrigen, es wurde aber die solidere Construction der leichteren Schliefbarkeit und der Wahrscheinlichkeit einer dadurch möglichen noch tieferen Abpressung gleich Anfangs vorgezogen, daher erstere Anfertigungsart fortan beybehalten werden mußte.“"
                            },
                            {
                                "example_id": "34310545-ba5e-4ce3-9576-8ae882cdc8c8",
                                "sense_id": "ff396460-08ea-36ee-9595-ad2a19cfb860",
                                "text": "„welche […] enger aneinander stehende Stehbolzen und Verankerungen erfordern, welche der Schliefbarkeit hinderlich werden.“"
                            }
                        ],
