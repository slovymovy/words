                        "entry_id": "524a7a8a-5f44-3eea-9cf3-83a01bb91141",
                        "glosses": [
                            "Marque de rouge à lèvres indélébile inventé dans les années 1920 par le chimiste Paul Baudecroux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b22bba44-aed2-4010-8188-424f8da467c6",
                                "sense_id": "d1126fe3-7d2e-309a-bdd3-6bd0e09052d3",
                                "text": "Elle n’employait pas, elle non plus, le rouge-baiser."
                            },
                            {
                                "example_id": "33e3c495-b1f8-4139-a01c-4f2c46e34696",
                                "sense_id": "d1126fe3-7d2e-309a-bdd3-6bd0e09052d3",
                                "text": "Il faut que je rachète du rouge-baiser."
                            },
                            {
                                "example_id": "e4b684fd-154b-4432-a8d3-4d87eae9ba3d",
                                "sense_id": "d1126fe3-7d2e-309a-bdd3-6bd0e09052d3",
                                "text": "Seules leurs lèvres prenaient contact, se reconnaissaient, coulaient l’une sur l’autre, mêlant le piment du tabac blond au sucre du rouge-baiser."
                            },
                            {
                                "example_id": "d554d2e9-ce8a-4895-9437-d56bd9c7c1bb",
                                "sense_id": "d1126fe3-7d2e-309a-bdd3-6bd0e09052d3",
                                "text": "Les paroles crépitent du rouge-baiser sensuel et altruiste de l’informatrice."
                            }
                        ]
                    }
