                                        "sense_id": "1285487f-543c-34f5-afa7-b550143d37f2",
                                        "entry_id": "b909ca3e-22e8-32bf-8577-21f9c0e113ae",
                                        "glosses": [
                                            "A music album headlined by one person who has previously produced music as part of a group or band."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "545f2621-2fe8-420d-8ff7-d151eef26f4e",
                                                "sense_id": "1285487f-543c-34f5-afa7-b550143d37f2",
                                                "text": "Technically, however, it wasn't a solo album because all four Beatles appeared on it\"."
                                            },
                                            {
                                                "example_id": "32d471ed-fc2c-4659-9926-12f546969114",
                                                "sense_id": "1285487f-543c-34f5-afa7-b550143d37f2",
                                                "text": "The new Gilmour-led Floyd sounds infinitely more 'Floydian' than Roger Waters' dirge-like solo albums."
                                            },
                                            {
                                                "example_id": "3146bdd1-99bb-4d8a-83da-ae3342aa97bf",
                                                "sense_id": "1285487f-543c-34f5-afa7-b550143d37f2",
                                                "text": "HOLLYWOOD: Margaret Whiting huddling with Capitol execs over her first solo album on which she will be backed by Frank De Vol."
                                            }
                                        ]
                                    }
                                ]
