                                                "sense_id": "bf4f973d-ed39-32f7-8f90-5338e5c99483",
                                                "text": "Das Design zeichnet sich durch eine einfache, strenge Linienführung aus."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0a49042f-254e-3d13-8d0e-d73d3de9f47e",
                                        "entry_id": "bae82eaf-fa33-3285-82e6-52c1130b499c",
                                        "glosses": [
                                            "intensiv und unangenehm"
                                        ],
                                        "tags": [
