                    },
                    {
                        "translation_id": "be5a8cac-2432-4b6d-8a6c-60b6992c13ea",
                        "source_entry_id": "354e72a5-0f60-33f3-a16e-d021ade17bfb",
                        "source_sense_description": "authoritative statement",
                        "target_lang_word": "Diktum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diktum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8d1c27f-6749-3f35-9d07-88f5ada9cd4c",
                                        "entry_id": "6d964703-ad93-337c-a383-732fc6cb38c7",
                                        "glosses": [
                                            "geistreicher, bedeutsamer Ausspruch"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d836c36-dbb6-4edb-8d9d-f263472796d7",
                                                "sense_id": "c8d1c27f-6749-3f35-9d07-88f5ada9cd4c",
                                                "text": "„Einstein war entsetzt über dieses Element des Zufalls, des Unvorhersagbaren in den grundlegenden Naturgesetzen und hat die Quantenmechanik nie wirklich akzeptiert. Seine Einstellung brachte er in seinem berühmten Diktum \"Der Herrgott würfelt nicht\" zum Ausdruck.“"
                                            },
                                            {
                                                "example_id": "a0e7c569-faf3-4132-88de-6a39352699e7",
                                                "sense_id": "c8d1c27f-6749-3f35-9d07-88f5ada9cd4c",
                                                "text": "„Das Diktum gilt noch immer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "da895702-0ff8-3bac-bd4f-d282c6f3064b",
                                        "entry_id": "6d964703-ad93-337c-a383-732fc6cb38c7",
                                        "glosses": [
                                            "Entscheid, Befehl"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c55dbf1-f29f-4068-ab24-d45b61eb8f14",
                                                "sense_id": "da895702-0ff8-3bac-bd4f-d282c6f3064b",
                                                "text": "„Mit seinem Diktum will Clinton die internationale Gemeinschaft zwingen, die Blockierer härter anzupacken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ce1ad88-4b2d-4048-8738-f6b23e9f86fc",
                        "source_entry_id": "354e72a5-0f60-33f3-a16e-d021ade17bfb",
