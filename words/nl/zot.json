{
    "word_family": [
        "zotheid",
        "zotternij",
        "zotweg"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "da314a39-f3c6-3273-a313-1f96ac343745",
                    "sense_definition": "niet goed bij zijn verstand; gek of krankzinnig",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zot_gek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij werd helemaal <w>zot</w> van al het lawaai in de straat.",
                            "target_lang_translations": {
                                "en": "He was driven completely <w>crazy</w> by all the noise in the street.",
                                "tr": "Sokaktaki tüm gürültüden neredeyse <w>çıldıracaktı</w>."
                            }
                        },
                        {
                            "text": "Ben je nu helemaal <w>zot</w> geworden om zoiets gevaarlijks te doen?",
                            "target_lang_translations": {
                                "en": "Have you gone completely <w>mad</w> to do something so dangerous?",
                                "tr": "Böyle tehlikeli bir şey yapacak kadar <w>delirdin</w> mi sen?"
                            }
                        }
                    ],
                    "synonyms": [
                        "gek",
                        "getikt",
                        "gestoord",
                        "dol"
                    ],
                    "common_phrases": [
                        "zot worden",
                        "zot zijn"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "vooral gebruikelijk in België"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "not in one's right mind; insane, mad, or crazy",
                        "tr": "Aklı başında olmayan; deli veya çıldırmış"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crazy",
                                "target_lang_sense_clarification": "insane, out of one's mind"
                            },
                            {
                                "target_lang_word": "mad",
                                "target_lang_sense_clarification": "insane or driven to distraction"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "deli",
                                "target_lang_sense_clarification": "akıl sağlığı yerinde olmayan"
                            },
                            {
                                "target_lang_word": "çıldırmış",
                                "target_lang_sense_clarification": "öfkeden veya stresten aklını yitirmiş"
                            },
                            {
                                "target_lang_word": "kaçık",
                                "target_lang_sense_clarification": "aklen dengesiz, tuhaf"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "204e25c2-bc2a-3796-a98e-86cce23ee6a7",
                    "sense_definition": "getuigend van een gebrek aan verstand of inzicht; dwaas",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zot_dwaas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat is echt een <w>zot</w> idee waar niemand mee akkoord zal gaan.",
                            "target_lang_translations": {
                                "en": "That is really a <w>crazy</w> idea that nobody will agree with.",
                                "tr": "Bu, kimsenin kabul etmeyeceği gerçekten <w>saçma</w> bir fikir."
                            }
                        },
                        {
                            "text": "Het zou een <w>zotte</w> beslissing zijn om nu plots te stoppen met studeren.",
                            "target_lang_translations": {
                                "en": "It would be a <w>foolish</w> decision to suddenly quit studying now.",
                                "tr": "Şimdi aniden okumayı bırakmak <w>aptalca</w> bir karar olurdu."
                            }
                        }
                    ],
                    "synonyms": [
                        "dwaas",
                        "dom",
                        "gek"
                    ],
                    "common_phrases": [
                        "een zot idee"
                    ],
                    "target_lang_definitions": {
                        "en": "showing a lack of good sense or judgment; foolish or silly",
                        "tr": "Akıl veya sağduyudan yoksun olan; saçma, aptalca"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crazy",
                                "target_lang_sense_clarification": "unwise, absurd, or impractical"
                            },
                            {
                                "target_lang_word": "foolish",
                                "target_lang_sense_clarification": "lacking good sense or judgment"
                            },
                            {
                                "target_lang_word": "silly",
                                "target_lang_sense_clarification": "ridiculous or unwise"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "saçma",
                                "target_lang_sense_clarification": "akla ve mantığa aykırı"
                            },
                            {
                                "target_lang_word": "çılgınca",
                                "target_lang_sense_clarification": "mantıksız, aşırı cüretkâr"
                            },
                            {
                                "target_lang_word": "aptalca",
                                "target_lang_sense_clarification": "mantıktan yoksun"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b32a603-4b03-346f-b2cb-315ae742ef7e",
                    "sense_definition": "sterk afwijkend van de normale verwachtingen, grappig of merkwaardig",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zot_dwaas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben gisteravond ontzettend gelachen om zijn <w>zotte</w> kuren.",
                            "target_lang_translations": {
                                "en": "We laughed so hard yesterday evening at his <w>wacky</w> antics.",
                                "tr": "Dün akşam onun <w>tuhaf</w> huylarına çok güldük."
                            }
                        },
                        {
                            "text": "Die film heeft een wel heel <w>zot</w> en bizar verhaal.",
                            "target_lang_translations": {
                                "en": "That film has a really <w>crazy</w> and bizarre story.",
                                "tr": "O filmin oldukça <w>garip</w> ve tuhaf bir hikâyesi var."
                            }
                        }
                    ],
                    "synonyms": [
                        "mal",
                        "raar",
                        "belachelijk",
                        "bespottelijk",
                        "ridicuul"
                    ],
                    "common_phrases": [
                        "zotte kuren"
                    ],
                    "target_lang_definitions": {
                        "en": "deviating greatly from normal expectations; funny, bizarre, or quirky",
                        "tr": "Normal beklentilerden oldukça uzak, komik veya tuhaf"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crazy",
                                "target_lang_sense_clarification": "wild, bizarre, or eccentric"
                            },
                            {
                                "target_lang_word": "bizarre",
                                "target_lang_sense_clarification": "very strange or unusual"
                            },
                            {
                                "target_lang_word": "wacky",
                                "target_lang_sense_clarification": "funny and eccentric"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tuhaf",
                                "target_lang_sense_clarification": "alışılmadık, acayip"
                            },
                            {
                                "target_lang_word": "garip",
                                "target_lang_sense_clarification": "şaşırtıcı, sıradışı"
                            },
                            {
                                "target_lang_word": "komik",
                                "target_lang_sense_clarification": "güldürücü ve tuhaf"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b296edc8-5ca3-3d9a-ba6d-7d98933de579",
                    "sense_definition": "iemand die zich dwaas, vreemd of belachelijk gedraagt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "persoon_dwaas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Luister niet naar hem, hij gedraagt zich gewoon als een <w>zot</w>.",
                            "target_lang_translations": {
                                "en": "Don't listen to him, he's just acting like a <w>fool</w>.",
                                "tr": "Ona kulak asma, sadece bir <w>deli</w> gibi davranıyor."
                            }
                        },
                        {
                            "text": "Tijdens carnaval trekt iedere <w>zot</w> door de straten van de stad.",
                            "target_lang_translations": {
                                "en": "During carnival, every <w>fool</w> marches through the streets of the city.",
                                "tr": "Karnaval sırasında her <w>maskara</w> şehrin sokaklarına dökülür."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a person who acts foolishly, strangely, or ridiculously",
                        "tr": "Aptalca, tuhaf veya gülünç davranan kişi"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fool",
                                "target_lang_sense_clarification": "person acting unwisely or ridiculously"
                            },
                            {
                                "target_lang_word": "nut",
                                "target_lang_sense_clarification": "eccentric or silly person"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "deli",
                                "target_lang_sense_clarification": "saçma sapan veya taşkın davranan kimse"
                            },
                            {
                                "target_lang_word": "budala",
                                "target_lang_sense_clarification": "ahmak, safça davranan kimse"
                            },
                            {
                                "target_lang_word": "maskara",
                                "target_lang_sense_clarification": "kendini gülünç duruma düşüren kimse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38646394-286b-3c0f-abb2-3d26d2204fa5",
                    "sense_definition": "iemand met een ernstige psychische stoornis",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "persoon_psychisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vroeger werden mensen die verward waren vaak simpelweg als een <w>zot</w> bestempeld.",
                            "target_lang_translations": {
                                "en": "In the past, people who were confused were often simply labelled a <w>lunatic</w>.",
                                "tr": "Eskiden kafası karışık insanlar sık sık sadece birer <w>deli</w> olarak yaftalanırdı."
                            }
                        },
                        {
                            "text": "Ze sloten die arme <w>zotten</w> op in een kille instelling buiten de stad.",
                            "target_lang_translations": {
                                "en": "They locked those poor <w>madmen</w> away in a cold institution outside the city.",
                                "tr": "O zavallı <w>akıl hastalarını</w> şehir dışındaki soğuk bir kuruma kapattılar."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "vaak pejoratief gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a person suffering from a severe mental illness (dated, derogatory)",
                        "tr": "Ciddi bir ruhsal bozukluğu olan kimse (eski veya aşağılayıcı kullanım)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lunatic",
                                "target_lang_sense_clarification": "mentally ill person (dated/derogatory)"
                            },
                            {
                                "target_lang_word": "madman",
                                "target_lang_sense_clarification": "insane person (dated)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tımarhanelik",
                                "target_lang_sense_clarification": "akıl hastanesinde yatacak derecede hasta (aşağılayıcı)"
                            },
                            {
                                "target_lang_word": "deli",
                                "target_lang_sense_clarification": "akıl hastası (eski kullanım)"
                            },
                            {
                                "target_lang_word": "mecnun",
                                "target_lang_sense_clarification": "akıl sağlığını yitirmiş (eski dil)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27e02257-42df-3fd9-94bc-8b5c08323152",
                    "sense_definition": "iemand die zich overdreven enthousiast of fanatiek gedraagt",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "persoon_fanatiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als het om voetbal gaat, is hij echt een <w>zot</w> die overal meereist.",
                            "target_lang_translations": {
                                "en": "When it comes to football, he's really a <w>maniac</w> who travels everywhere with the team.",
                                "tr": "Konu futbol olunca, o her yere peşinden giden gerçek bir <w>çılgındır</w>."
                            }
                        },
                        {
                            "text": "Die <w>zot</w> stond uren in de vrieskou te wachten op een handtekening.",
                            "target_lang_translations": {
                                "en": "That <w>fanatic</w> stood in the freezing cold for hours waiting for an autograph.",
                                "tr": "O <w>deli</w>, bir imza için dondurucu soğukta saatlerce bekledi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak informeel en genegen gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "someone who acts overly enthusiastic, passionate, or obsessed",
                        "tr": "Aşırı hevesli, tutkulu veya fanatik davranan kimse"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "maniac",
                                "target_lang_sense_clarification": "overly passionate or fanatical person"
                            },
                            {
                                "target_lang_word": "fanatic",
                                "target_lang_sense_clarification": "extremely enthusiastic person"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çılgın",
                                "target_lang_sense_clarification": "tutkulu veya aşırı heyecanlı kimse"
                            },
                            {
                                "target_lang_word": "delisi",
                                "target_lang_sense_clarification": "bir şeyin aşırı düşkünü"
                            },
                            {
                                "target_lang_word": "fanatik",
                                "target_lang_sense_clarification": "bir şeye körü körüne bağlı olan kimse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1a9359b-cc84-3133-bd9d-0f86a4832d24",
                    "sense_definition": "de boer in een spel speelkaarten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kaartspel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij won het spel door op het juiste moment de <w>zot</w> op tafel te leggen.",
                            "target_lang_translations": {
                                "en": "He won the game by playing the <w>jack</w> at the right moment.",
                                "tr": "Doğru anda masaya <w>valeyi</w> atarak oyunu kazandı."
                            }
                        },
                        {
                            "text": "In dit kaartspel is de <w>zot</w> meer punten waard dan de koningin.",
                            "target_lang_translations": {
                                "en": "In this card game, the <w>jack</w> is worth more points than the queen.",
                                "tr": "Bu kâğıt oyununda <w>vale</w>, kızdan daha fazla puan değerindedir."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "vooral in Vlaanderen gebruikt voor de boer"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the jack in a deck of playing cards (Flemish)",
                        "tr": "İskambil destesinde vale/bacak kartı (özellikle Flaman bölgesinde)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jack",
                                "target_lang_sense_clarification": "playing card"
                            },
                            {
                                "target_lang_word": "knave",
                                "target_lang_sense_clarification": "jack in playing cards (archaic/traditional)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "vale",
                                "target_lang_sense_clarification": "iskambil kartı"
                            },
                            {
                                "target_lang_word": "bacak",
                                "target_lang_sense_clarification": "vale kartının halk dilindeki adı"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}