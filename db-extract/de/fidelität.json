                                    },
                                    {
                                        "sense_id": "e7317d44-9f42-3c50-9cec-cde4eecf1d06",
                                        "entry_id": "448cf18b-38cb-38e4-801d-a0d7359cebb6",
                                        "glosses": [
                                            "Accuracy, or exact correspondence to some given quality or fact."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02a68ac4-f788-3114-b024-6c9925e61dd7",
                                        "entry_id": "448cf18b-38cb-38e4-801d-a0d7359cebb6",
                                        "glosses": [
                                            "The degree to which a system accurately reproduces an input."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71908093-83ca-48cb-940b-87a87cd60386",
                                                "sense_id": "02a68ac4-f788-3114-b024-6c9925e61dd7",
                                                "text": "By placing them closer to the source, we can reduce the number of messages in the system and this in turn is likely to improve the fidelity of the system."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e15862b7-b2d2-4287-90da-13188b1aadcf",
                        "source_entry_id": "9cc86d49-4e7c-3b7e-aec5-ade8b1bd28e8",
                        "source_sense_id": "af19ae21-0582-33e3-87fe-d2044b06aa2a",
                        "target_lang_word": "faithfulness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faithfulness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a27ee80c-9336-3df0-9a44-2703a996a18a",
                                        "entry_id": "d03df98b-2ba0-333b-8143-9219fed0206e",
                                        "glosses": [
                                            "The state of being faithful.",
                                            "The state or act of keeping faith; constancy of support."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca3e8a37-c8e2-4440-b54d-efab4fc0542b",
                                                "sense_id": "a27ee80c-9336-3df0-9a44-2703a996a18a",
                                                "text": "Traditional Chinese philosophy teaches us that in dealing with friends, we should be loyal and faithful. In all of our relations with friendly nations, we have been strictly adhering to these principles of loyalty and faithfulness. Of course, we expect friends to do the same to us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62dcc3ff-218f-3b16-a918-58451d4aa4d3",
                                        "entry_id": "d03df98b-2ba0-333b-8143-9219fed0206e",
                                        "glosses": [
                                            "The state of being faithful.",
                                            "Consistency; exactness in copying or following."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d655364-3c7d-417d-a90d-629908bcb48e",
                                                "sense_id": "62dcc3ff-218f-3b16-a918-58451d4aa4d3",
                                                "text": "faithfulness to the original"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f341fcd-255f-4cae-8acf-00266af3fdc5",
                        "source_entry_id": "9cc86d49-4e7c-3b7e-aec5-ade8b1bd28e8",
                        "source_sense_id": "af19ae21-0582-33e3-87fe-d2044b06aa2a",
                        "target_lang_word": "loyalty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loyalty",
