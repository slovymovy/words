                    "sense_definition": "a bet or wager, or a risky attempt at something",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gambling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to take a <w>punt</w> on the new startup despite the risks.",
                            "target_lang_translations": {
                                "ru": "Я решил <w>рискнуть</w> и вложиться в новый стартап, несмотря на риски.",
                                "zh": "尽管有风险，我还是决定对这家初创公司进行一次<w>冒险尝试</w>。"
                            }
                        },
                        {
                            "text": "He had a small <w>punt</w> on the horse race just for fun.",
                            "target_lang_translations": {
                                "ru": "Он сделал небольшую <w>ставку</w> на скачках просто ради интереса.",
                                "zh": "他为了好玩，在赛马上下了一小笔<w>赌注</w>。"
                            }
                        }
