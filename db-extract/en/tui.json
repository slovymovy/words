                        "target_lang_word": "tui cravate-frisée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tui cravate-frisée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb45a723-e31d-3bc3-8e31-66d94c1aad6d",
                                        "entry_id": "40c82c6d-eea0-3c7c-9250-2d3526b48929",
                                        "glosses": [
                                            "Synonyme de méliphage tui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ce80397-8532-4a4b-a723-ffd905f5c7fd",
                                                "sense_id": "eb45a723-e31d-3bc3-8e31-66d94c1aad6d",
                                                "text": "Endémique de Nouvelle-Zélande, on trouve le tui cravate-frisée dans les trois principales îles, même s'il manque dans une grande partie de la moitié orientale de l'île du Sud."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
