                                "target_senses": [
                                    {
                                        "sense_id": "3c5f51f8-3a14-393c-90a4-d08a64f142f9",
                                        "entry_id": "7fc22f0b-467d-3099-8962-40143910a658",
                                        "glosses": [
                                            "Qui est plein de frayeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f059660-077c-421a-b9b9-4356210f2f75",
                                                "sense_id": "3c5f51f8-3a14-393c-90a4-d08a64f142f9",
                                                "text": "N’est-ce pas parce que vous êtes sa complice ? lança l’inspecteur, satisfait de son effet sur la pauvre secrétaire effrayée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1923a105-8ac7-302f-9c9a-4d726da18513",
                                        "entry_id": "7fc22f0b-467d-3099-8962-40143910a658",
                                        "glosses": [
                                            "Qui ressent de l’appréhension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b66a8af-b745-4b13-8236-ee8999472d1c",
                                                "sense_id": "1923a105-8ac7-302f-9c9a-4d726da18513",
                                                "text": "Le clergé, effrayé par la saisie du temporel des quarante-cinq évèques, donna son adhésion, ainsi que l'Université, et Nogaret partit pour l'Italie avec des pouvoirs illimités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "925a9155-863a-36a3-81d8-5ddd6afad3fa",
                                        "entry_id": "7fc22f0b-467d-3099-8962-40143910a658",
                                        "glosses": [
                                            "Se dit d'un quadrupède (surtout le cheval) qui est représenté debout sur ses pattes arrière et donnant l’impression de battre l’air de ses pattes avant. À rapprocher d’acculé, cabré, effaré, effarouché, forcené et furieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dccfe14-77ae-4335-bb7f-0074c25e8944",
                                                "sense_id": "925a9155-863a-36a3-81d8-5ddd6afad3fa",
                                                "text": "D’azur à la crosse d’or, accostée à dextre d’un bœuf effrayé contourné d’argent et à senestre de trois merlettes du même ordonnées 2 et 1, qui est de La Verrie → voir illustration « bœuf effrayé »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "effrayé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d584dd81-8f2e-3aed-a7b2-8afc90f47f8d",
                                        "entry_id": "f27af91a-76c3-3b26-b07d-92194b928ae6",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe effrayer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e81d7fb6-c9db-4f33-bb82-9b4ad153c00b",
                                                "sense_id": "d584dd81-8f2e-3aed-a7b2-8afc90f47f8d",
                                                "text": "Sans la fausse bonhomie du fainéant et le laisser-aller du gobelotteur de campagne, cet homme eût effrayé les gens les moins perspicaces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10376fe2-3f4e-44d8-abda-b72e92364b32",
                        "source_entry_id": "880b53f1-690f-3eb9-9a29-fe183c10e4ba",
                        "source_sense_id": "20d58965-dbbc-3b90-84c7-0ceab6c14a84",
                        "target_lang_word": "bang",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bang",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "fc43c610-1d19-3d76-a05f-ae894131aea2",
                                        "entry_id": "acb01f79-ee6a-3566-b90a-1cbf12130ca3",
                                        "glosses": [
                                            "een min of meer beredeneerde angst voor iets hebbend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "958012e6-2f08-41a3-a155-0ad0d24be5fc",
                                                "sense_id": "fc43c610-1d19-3d76-a05f-ae894131aea2",
                                                "text": "het is niet vreemd bang te zijn bij dit gevaarlijke spel."
                                            },
                                            {
                                                "example_id": "1d300fc2-b834-4d00-a1b2-22f4e36048b7",
                                                "sense_id": "fc43c610-1d19-3d76-a05f-ae894131aea2",
                                                "text": "‘Denkt u ook niet, meneer Scott, dat, alles in aanmerking genomen, het schilderij hier veiliger is? We hebben een nachtwaker en een inbraakalarm. Ik ben bang dat het in Surrey …’ ‘Nou, daar is het inderdaad bijzonder gevaarlijk.’ Quick bemoeide zich ermee."
                                            },
                                            {
                                                "example_id": "e6014938-5a2e-47bb-8a41-b9f4ffcce188",
                                                "sense_id": "fc43c610-1d19-3d76-a05f-ae894131aea2",
                                                "text": "„Als je zo midden in de nacht naar beneden springt met een parachute, ja ik weet er niets van, maar ik neem aan dat het midden in de nacht moet zijn, dan ben je toch enorm bang?” Hij verzekerde haar dat hij niet bang zou zijn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3905a76b-df88-3b06-a286-1bfcac1c5afa",
                                        "entry_id": "acb01f79-ee6a-3566-b90a-1cbf12130ca3",
                                        "glosses": [
                                            "angstaanjagend, angst verwekkend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d21e3a4-a544-4e62-96ab-d25bfdfa607a",
                                                "sense_id": "3905a76b-df88-3b06-a286-1bfcac1c5afa",
                                                "text": "Vallende kraan zorgt voor bange momenten"
                                            },
                                            {
                                                "example_id": "f4b96deb-cf05-41dc-951b-3f6d1beb03ff",
                                                "sense_id": "3905a76b-df88-3b06-a286-1bfcac1c5afa",
                                                "text": "Neerlands hoop in bange dagen"
                                            },
                                            {
                                                "example_id": "8fdee078-f939-4396-b3ea-e196e1fe78d0",
                                                "sense_id": "3905a76b-df88-3b06-a286-1bfcac1c5afa",
                                                "text": "Bang vroeg ik me af wat ik nu het best kon doen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8aeb795-2fe9-3e79-8704-cb9d8b139428",
                                        "entry_id": "acb01f79-ee6a-3566-b90a-1cbf12130ca3",
                                        "glosses": [
                                            "bangelijk, bang van karakter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7feff3b7-a18a-4434-9acb-5265e6151cbb",
                                                "sense_id": "a8aeb795-2fe9-3e79-8704-cb9d8b139428",
                                                "text": "Wat is hij toch een bange wezel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
