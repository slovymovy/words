                ],
                "senses": [
                    {
                        "sense_id": "45265745-af99-3f6d-8d0a-6bdf7301496a",
                        "entry_id": "a72791a9-5b9d-393b-8f9d-5e4508a10906",
                        "glosses": [
                            "jemand, der Kanu fährt; der das Kanufahren betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8829ed1c-da3b-40aa-b42c-26f5fda8f100",
                                "sense_id": "45265745-af99-3f6d-8d0a-6bdf7301496a",
                                "text": "Die Kanufahrer trainierten eifrig für die Weltmeisterschaft."
                            },
                            {
                                "example_id": "acde9567-6d6d-4500-b810-86ca28690d84",
                                "sense_id": "45265745-af99-3f6d-8d0a-6bdf7301496a",
                                "text": "„Donnerstagvormittag herrscht an der Neuen Donau jenseits der Steinspornbrücke noch die übliche beschauliche Ruhe: Radfahrer und Inlineskater rollen am Ufer entlang, Kanufahrer gleiten über das Wasser, nur zwischendurch gellt aus dem sommertrockenen Gras ein Quietschen, wo sich zwei Nagetiere in die Quere geraten sind.“"
                            },
                            {
                                "example_id": "58c05b5a-24df-443d-a104-517bdc8576dd",
                                "sense_id": "45265745-af99-3f6d-8d0a-6bdf7301496a",
                                "text": "„In der Moesa fahren mehr als 80 Kanufahrer um den Sieg im Classic-Rennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
