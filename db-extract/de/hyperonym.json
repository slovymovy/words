                                        "sense_id": "8cead7f9-ba0f-37b1-a7c5-4d255dd70893",
                                        "entry_id": "15d73919-f504-303a-8297-87a4966b1fba",
                                        "glosses": [
                                            "een woord dat een verzameling van verwante specifiekere woorden omvat, een overkoepelende term"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37c629ba-9f6b-45c9-9ffe-f3579332f985",
                                                "sense_id": "8cead7f9-ba0f-37b1-a7c5-4d255dd70893",
                                                "text": "Dier is een hyperoniem van vogel, dat op zijn beurt weer een hyperoniem is van mus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6e18333-7492-4886-90be-afdab3b94fcc",
