        "nl-extract.jsonl": [
            {
                "entry_id": "9fac83a0-82bb-3d6d-87c1-82623065ca0d",
                "word": "zingend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c838e267-b3a0-324e-9225-7d29f66f9807",
                        "entry_id": "9fac83a0-82bb-3d6d-87c1-82623065ca0d",
                        "glosses": [
                            "bezig zijn met te zingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c1e2346-6074-4c20-89e1-1838fe83ab08",
                                "sense_id": "c838e267-b3a0-324e-9225-7d29f66f9807",
                                "text": "Met veel plezier deed de zingende bouwvakker zijn werk."
                            },
                            {
                                "example_id": "91336cb8-99f7-4e2f-a104-d53e1880629f",
                                "sense_id": "c838e267-b3a0-324e-9225-7d29f66f9807",
                                "text": "Hij deed een optreden met de zingende zaag."
                            },
                            {
                                "example_id": "4cc8b20d-4e6d-4fcd-8320-a8791e1238d8",
                                "sense_id": "c838e267-b3a0-324e-9225-7d29f66f9807",
                                "text": "De brandende lampion die de kinderen, op de avond van Sint Maarten, zingend langs de huizen dragen, de kerstboom, de suizende lichtpijlen als het nieuwe jaar begint en de hoge sprong over het vuur op het zomerfeest van Sint Jan."
                            },
                            {
                                "example_id": "09e34a0e-1845-44cf-a90b-d379c2f9338a",
                                "sense_id": "c838e267-b3a0-324e-9225-7d29f66f9807",
                                "text": "God genas zijn vrouw en schonk hun beiden een lang leven en acht kinderen die allemaal bleven leven. De landsheer benoemde hem tot graaf van de zingende klif, Chanteroc in het middeleeuwse Frans."
                            }
                        ]
                    }
