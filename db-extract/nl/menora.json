                "senses": [
                    {
                        "sense_id": "9ba04945-d749-3940-8662-5d811492451a",
                        "entry_id": "63c97fec-9c2c-3ec5-af38-c4b7d751ff0c",
                        "glosses": [
                            "kandelaar met zeven armen (een van de symbolen van Israël; Ex. 25:31-40)"
                        ],
                        "tags": [
                            "Jiddisch-Hebreeuws"
                        ],
                        "examples": [
                            {
                                "example_id": "9af7a414-3041-47d9-96b6-caeebd66f575",
                                "sense_id": "9ba04945-d749-3940-8662-5d811492451a",
                                "text": "Het werd eigenlijk pas een oorlog toen Vespasianus en Titus, inmiddels keizer en keizerszoon, wilden terugkeren naar Rome. (…) Zij zeggen: kijk naar de oorlogsbuit die we meebrengen uit veroverd gebied! Ze doelen op pronkstukken uit de tempel, zoals de menora (zevenarmige kandelaar), waarmee de bouw van het Colosseum is gefinancierd."
                            }
                        ]
                    },
                    {
                        "sense_id": "e20f527d-9bb6-30d0-8d05-3d8f0018bb81",
                        "entry_id": "63c97fec-9c2c-3ec5-af38-c4b7d751ff0c",
                        "glosses": [
                            "kandelaar voor de viering van Chanoeka, met acht armen plus een extra arm, sjamasj, voor het licht waarmee de andere worden aangestoken"
                        ],
                        "tags": [
                            "Jiddisch-Hebreeuws"
                        ],
                        "examples": [
                            {
                                "example_id": "918fd1f5-ec67-4db0-8fb0-f211bd068803",
                                "sense_id": "e20f527d-9bb6-30d0-8d05-3d8f0018bb81",
                                "text": "Voor het stadhuis van Maastricht wordt deze maandagavond de grootste menora ter wereld ontstoken, een twaalf meter hoge kandelaar ter ere van Chanoeka."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe75c0ea-5dff-41ab-a9fa-3832b20f968f",
                        "source_entry_id": "63c97fec-9c2c-3ec5-af38-c4b7d751ff0c",
                        "source_sense_id": "9ba04945-d749-3940-8662-5d811492451a",
                        "source_sense_description": "kandelaar met zeven armen",
                        "target_lang_word": "menorah",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menorah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fc41a93-c03b-3096-908f-8673dfce6be4",
                                        "entry_id": "44b66ec4-ad04-3e33-9888-10acccadc943",
                                        "glosses": [
                                            "A holy candelabrum with seven branches used in the Temple of Jerusalem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26186136-a564-40b5-acf2-6f70798e3dc2",
                                                "sense_id": "7fc41a93-c03b-3096-908f-8673dfce6be4",
                                                "text": "‘Heathen muck,’ Liberalis said, as the pillaging began. The veil of the Temple was rent. The great menorah was taken away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8abb61b5-9626-3310-9071-b921cc220aad",
                                        "entry_id": "44b66ec4-ad04-3e33-9888-10acccadc943",
                                        "glosses": [
                                            "A candelabrum with nine branches, used in Jewish worship on Hanukkah."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dfff808-9c99-4ffb-8c29-da0c0402ceb6",
                                                "sense_id": "8abb61b5-9626-3310-9071-b921cc220aad",
                                                "text": "My father brings home a big brass antique menorah, shaped like an archway, heavy, on a pedestal, on a round base."
                                            },
                                            {
                                                "example_id": "213c8fbe-5b8c-4475-b93a-08c7960d2fd6",
                                                "sense_id": "8abb61b5-9626-3310-9071-b921cc220aad",
                                                "text": "In America every December my mother had decorated our home with metal Stars of David she hung on strings in the doorways and lit the menorah as we gathered at the table."
                                            },
                                            {
                                                "example_id": "32ca9afb-7f88-41c4-a200-2af6970c7adb",
                                                "sense_id": "8abb61b5-9626-3310-9071-b921cc220aad",
                                                "text": "However, traditional Sefardi families follow the halacha that each household uses only one menorah lit by the head of the household, to represent everyone in unison."
                                            },
                                            {
                                                "example_id": "3189b399-a2a8-4ed0-8eac-b886badc70ae",
                                                "sense_id": "8abb61b5-9626-3310-9071-b921cc220aad",
                                                "text": "A far-right Polish MP has extinguished candles on a menorah lit for Hanukah in Poland’s parliament, disrupting proceedings before a planned vote of confidence in the new government."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
