                    }
                ],
                "senses": [
                    {
                        "sense_id": "c30f2928-4938-3ee9-a2cc-9b6d5696e121",
                        "entry_id": "44497c71-580d-3d55-a80e-b81024fa3600",
                        "glosses": [
                            "прозаические повествовательные произведения художественной литературы (в отличие от научной, публицистической и т. п. литературы)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e46efdc6-9803-4306-92d4-51a23bd845ef",
                                "sense_id": "c30f2928-4938-3ee9-a2cc-9b6d5696e121",
                                "text": "Шерлок Холмс: Роман… Вы что, читаете романы? Доктор Ватсон: А вы хотите сказать, что… не читаете? Шерлок Холмс: Не читал, не читаю и не собираюсь читать. Я вообще не читаю беллетристику."
                            }
                        ]
                    },
                    {
                        "sense_id": "a45456db-2bba-332c-85ff-c73561892b00",
                        "entry_id": "44497c71-580d-3d55-a80e-b81024fa3600",
                        "glosses": [
                            "произведения, предназначенные для лёгкого чтения"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2e1e4d88-a547-3c6a-9169-96a1f39e2094",
                        "entry_id": "44497c71-580d-3d55-a80e-b81024fa3600",
                        "glosses": [
                            "перен., разг. что-либо незначительное, неглубокое по содержанию"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b12a13d9-69b8-478e-97a0-46976cfb68aa",
                                "sense_id": "2e1e4d88-a547-3c6a-9169-96a1f39e2094",
                                "text": "Я слушал оратора, пока у него деловые соображения не сменились беллетристикой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2a4d26c-152c-4644-adf3-94cfb90fc2ee",
                        "source_entry_id": "44497c71-580d-3d55-a80e-b81024fa3600",
                        "source_sense_description": "художественная литература",
                        "target_lang_word": "fiction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fiction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a8ee9b9-3ced-3e49-9ce9-f7fb553af69c",
                                        "entry_id": "37847da4-d4d6-301f-a5eb-f7c0b52db629",
                                        "glosses": [
                                            "Literary type using invented or imaginative writing, instead of real facts, usually written as prose."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a3157e8-5970-4755-a387-c87225592747",
                                                "sense_id": "9a8ee9b9-3ced-3e49-9ce9-f7fb553af69c",
                                                "text": "I am a great reader of fiction."
                                            },
                                            {
                                                "example_id": "23d9ba31-fa70-425a-bf1c-2b2d0cb94960",
                                                "sense_id": "9a8ee9b9-3ced-3e49-9ce9-f7fb553af69c",
                                                "text": "the fiction section of the library"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d503e9a-4a5c-37e0-aa65-607b0ae655cf",
                                        "entry_id": "37847da4-d4d6-301f-a5eb-f7c0b52db629",
                                        "glosses": [
                                            "A verbal or written account that is not based on actual events (often intended to mislead)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0592fc3-620b-46d4-9eaf-cfeab74a2f44",
                                                "sense_id": "4d503e9a-4a5c-37e0-aa65-607b0ae655cf",
                                                "text": "The company’s accounts contained a number of blatant fictions."
                                            },
                                            {
                                                "example_id": "3eb9a3e5-23ea-45d3-8e45-58c3b534f96a",
                                                "sense_id": "4d503e9a-4a5c-37e0-aa65-607b0ae655cf",
                                                "text": "The butler’s account of the crime was pure fiction."
                                            },
                                            {
                                                "example_id": "7c503357-3ad2-4902-909a-2971913bd200",
                                                "sense_id": "4d503e9a-4a5c-37e0-aa65-607b0ae655cf",
                                                "text": "separate the fact from the fiction"
                                            },
                                            {
                                                "example_id": "bf166012-9c59-47ba-a8db-8599d58b93cb",
                                                "sense_id": "4d503e9a-4a5c-37e0-aa65-607b0ae655cf",
                                                "text": "[…] in view of the facts—and some fictions—recently circulated in this country about the general performance of high-powered diesel-hydraulics of B.R., […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd4b87ca-38d5-30ca-bb32-95714c07976b",
                                        "entry_id": "37847da4-d4d6-301f-a5eb-f7c0b52db629",
                                        "glosses": [
                                            "A legal fiction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
