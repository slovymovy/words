                                                "sense_id": "b934ec31-b1eb-3a38-9463-cc53a6aa4355",
                                                "text": "„Sie bedienen sich selbst mit Suppe; inzwischen zerlege ich in ihrer Gegenwart einen gepökelten Kapaun mit verblüffendem Geschick.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b2ccf7f-52ec-3c40-897f-3abfc1a18952",
                                        "entry_id": "1c8a98b8-05b9-30eb-8dc5-34dee535511f",
                                        "glosses": [
                                            "Kastrat"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "737dd740-b08f-4fd7-9b0c-deb1da563f87",
                                                "sense_id": "8b2ccf7f-52ec-3c40-897f-3abfc1a18952",
                                                "text": "Mein Oheim rühmt sich immer seiner Singstimme, doch in Wahrheit klingt er wie ein Kapaun."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
