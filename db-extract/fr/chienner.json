                "senses": [
                    {
                        "sense_id": "478e3431-2fca-38f7-8a4f-f5f6868e4266",
                        "entry_id": "c7768241-20dd-31c4-8150-9e3e6615903e",
                        "glosses": [
                            "Mettre bas, en parlant de la chienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff5f52f9-0650-494b-953f-f8f59483f79a",
                                "sense_id": "478e3431-2fca-38f7-8a4f-f5f6868e4266",
                                "text": "S'il n'y avait qu'à chienner au coin d'un champ !…"
                            }
                        ]
                    },
                    {
                        "sense_id": "4beada6d-c78c-37cd-a2e0-a5a93927e99a",
                        "entry_id": "c7768241-20dd-31c4-8150-9e3e6615903e",
                        "glosses": [
                            "Se comporter comme on imagine que le font des chiens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df80d308-892f-4173-8f4a-1ee6fb8c142c",
                                "sense_id": "4beada6d-c78c-37cd-a2e0-a5a93927e99a",
                                "text": "Prendre la suite d’un comptable, d’un couple qui vient de chienner dans des draps à peine secs, humilie ma condition."
                            },
                            {
                                "example_id": "00d6dddf-a38c-4b6e-a2b8-2823247d20f4",
                                "sense_id": "4beada6d-c78c-37cd-a2e0-a5a93927e99a",
                                "text": "Ils chiennent jusqu’à avoir les yeux atteints jusqu’aux regards jusqu’à entrer dans le noir."
                            }
                        ]
                    }
                ],
