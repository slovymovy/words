                ],
                "senses": [
                    {
                        "sense_id": "d60fac22-257e-3d73-b718-58f271bf28ab",
                        "entry_id": "d7b345e3-d471-3c28-bc31-b0b3829e0e2a",
                        "glosses": [
                            "eine baulich verschieden ausgestaltete verglaste Öffnung in einem Kapellenbau, deren hauptsächliche Funktion darin besteht, Licht in das Bauwerk zu führen und dieses zu belüften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68466007-5751-46ea-8e76-ca536e27438a",
                                "sense_id": "d60fac22-257e-3d73-b718-58f271bf28ab",
                                "text": "„Das Kapellenfenster stammt entgegen anderer Vermutungen aus der Zeit um 1520.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c5a773b4-66a9-3510-bad9-9c5c87f3b692",
                        "entry_id": "d7b345e3-d471-3c28-bc31-b0b3829e0e2a",
                        "glosses": [
                            "das gerahmte Glas, das in eine Fensteröffnung eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36667dbe-661c-470d-9bc3-8278463c45bb",
                                "sense_id": "c5a773b4-66a9-3510-bad9-9c5c87f3b692",
                                "text": "„Das Kapellenfenster stammt entgegen anderer Vermutungen aus der Zeit um 1520.“"
                            },
                            {
                                "example_id": "14fbd701-4a32-4b5b-8c7c-4c35d6a8ea81",
                                "sense_id": "c5a773b4-66a9-3510-bad9-9c5c87f3b692",
                                "text": "„Die Lauretanische Litanei ist das Thema der Kapellenfenster, die vom Künstler Egbert Verbeek gestaltet wurden.“"
                            },
                            {
                                "example_id": "f491589c-874d-4b9c-bc18-8283b8e382eb",
                                "sense_id": "c5a773b4-66a9-3510-bad9-9c5c87f3b692",
                                "text": "„Denn zuletzt waren zu wenige anwesend beim angesetzten Gemeindeforum über das Kapellenfenster: ein belastbares Votum konnte nicht entstehen.“"
                            },
                            {
                                "example_id": "ad6b39c8-91cb-4e8c-b5fb-2bc3d60de63b",
                                "sense_id": "c5a773b4-66a9-3510-bad9-9c5c87f3b692",
                                "text": "„Es ist auch möglich, die kleinen Kapellenfenster und die Tür zum Sargausgang zu erneuern.“"
                            },
                            {
                                "example_id": "31609d6b-5967-4704-8ac6-cd57cac2f97c",
                                "sense_id": "c5a773b4-66a9-3510-bad9-9c5c87f3b692",
                                "text": "„Farbenprächtig sollten die Kapellenfenster sein.“"
                            },
                            {
                                "example_id": "8d74c1cf-ef0a-4c75-a43b-537728985223",
                                "sense_id": "c5a773b4-66a9-3510-bad9-9c5c87f3b692",
                                "text": "„Am Herzenberg regt sich Widerstand gegen den Austausch der Kapellenfenster.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
