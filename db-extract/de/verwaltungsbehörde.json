                ],
                "senses": [
                    {
                        "sense_id": "eb8ceaaf-a116-3865-b31f-edaa473f97a3",
                        "entry_id": "923a0517-a81d-3fa3-af80-4c06d84ab491",
                        "glosses": [
                            "Behörde, die die öffentliche Verwaltung wahrnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9bc23d8-b347-44b6-b9f8-7d40b9680999",
                                "sense_id": "eb8ceaaf-a116-3865-b31f-edaa473f97a3",
                                "text": "„Verfassungs-, Rechts- und Wirtschaftsgeschichte. Die ersten Anfänge und die Entwicklung einer obersten Verwaltungsbehörde in Württemberg, des fürstlichen Rats, seit dem 15. Jh. verfolgt Irmgard Kothe - 2377 auf Grund der Kanzleiakten, der alten Landschreibereirechnungen und der sog.“"
                            },
                            {
                                "example_id": "53050b5a-6db4-4e68-a682-bd84bf08868f",
                                "sense_id": "eb8ceaaf-a116-3865-b31f-edaa473f97a3",
                                "text": "„Lüneburg - Wer nach einem einfachen Rotlicht-Verstoß der Verwaltungsbehörde den Fahrer nicht nennen will, muß damit rechnen, ein halbes Jahr ein Fahrtenbuch führen zu müssen.“"
                            },
                            {
                                "example_id": "5e0fa513-3e84-4d90-b8a4-966fe40e5fbe",
                                "sense_id": "eb8ceaaf-a116-3865-b31f-edaa473f97a3",
                                "text": "„Es besteht kein Zweifel, daß unsere führenden Verwaltungsbehörden die deutsche Situation und unsere Mission in Deutschland mit sehr viel Kenntnis und Verständnis betrachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
