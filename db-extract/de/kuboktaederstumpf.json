                "senses": [
                    {
                        "sense_id": "6eb5f986-b80a-3f63-9b2d-6eda7cc607ba",
                        "entry_id": "1a91ba57-e162-3462-9ebd-ed53daa2bdc4",
                        "glosses": [
                            "Polyeder, das durch Abstumpfung der Ecken eines Kuboktaeders entsteht"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "8e393250-956c-4379-8770-1994db6d9c0c",
                                "sense_id": "6eb5f986-b80a-3f63-9b2d-6eda7cc607ba",
                                "text": "Es fügen sich hier 12 Vierecke, 8 Sechsecke und 6 Achtecke zur Bildung eines 26-Flachs zusammen, das ich Kuboktaederstumpf nenne, nicht etwa weil es durch Abstumpfung erzeugt werden könnte, sondern weil es dem abgestumpften Kuboktaeder ähnlich ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2990ab6e-d02b-47a1-93ed-a77c0e1fd456",
                        "source_entry_id": "1a91ba57-e162-3462-9ebd-ed53daa2bdc4",
                        "source_sense_id": "6eb5f986-b80a-3f63-9b2d-6eda7cc607ba",
                        "source_sense_description": "Geometrie: Polyeder, das durch Abstumpfung der Ecken eines Kuboktaeders entsteht",
                        "target_lang_word": "truncated cuboctahedron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "truncated cuboctahedron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b095a2a-d3ad-33ac-910d-a0c223e92b19",
                                        "entry_id": "2cc26b1a-af24-3406-8470-eca14f3b4fe2",
                                        "glosses": [
                                            "An Archimedean solid that is isogonal and has twenty-six regular faces (twelve square, eight hexagonal and six octagonal); a great rhombicuboctahedron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82e83c5f-4fc0-493a-b635-d0d138ce31b1",
                                                "sense_id": "0b095a2a-d3ad-33ac-910d-a0c223e92b19",
                                                "text": "The H'(S-S) type of linked truncated octahedra and truncated cuboctahedra is analogous to the fluorite structure with the truncated octahedra in the positions of the fluorine atoms and the truncated cuboctahedra in the positions of the calcium atoms."
                                            },
                                            {
                                                "example_id": "538a1389-e30e-4fb4-a3db-a9285075b778",
                                                "sense_id": "0b095a2a-d3ad-33ac-910d-a0c223e92b19",
                                                "text": "A three-dimensional network of linked cavities, each with a truncated cuboctahedron shape (Figure 6.5) through the structure, is thus formed; the truncated cuboctahedra are also space-filling (each shares its octagonal face with six others), forming channels that run parallel to the three axial cubic directions through these large cavities."
                                            },
                                            {
                                                "example_id": "99eee011-dfc4-4f73-a670-98e777a30931",
                                                "sense_id": "0b095a2a-d3ad-33ac-910d-a0c223e92b19",
                                                "text": "Its pore structure consists of truncated octahedra linked to other cavities through 6-membered rings and of truncated cuboctahedra linked together through 8-membered rings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c2af323-ea1e-4948-88f6-7a7f3fe8f38c",
                        "source_entry_id": "1a91ba57-e162-3462-9ebd-ed53daa2bdc4",
                        "source_sense_id": "6eb5f986-b80a-3f63-9b2d-6eda7cc607ba",
