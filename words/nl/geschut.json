            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9540af6b-432e-366e-bdff-a66590f3cd3b",
                    "sense_definition": "Zwaar oorlogsmateriaal zoals kanonnen waarmee projectielen over grote afstand worden afgeschoten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wapens",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij slaagden er eindelijk in het vijandige <w>geschut</w> het zwijgen op te leggen.",
                            "target_lang_translations": {
                                "de": "Es gelang ihnen schließlich, die feindlichen <w>Geschütze</w> zum Schweigen zu bringen."
                            }
                        },
                        {
                            "text": "Tijdens de veldslag vuurde het zware <w>geschut</w> onafgebroken op de stellingen.",
                            "target_lang_translations": {
                                "de": "Während der Schlacht feuerte das schwere <w>Geschütz</w> ununterbrochen auf die Stellungen."
                            }
                        }
                    ],
                    "synonyms": [
                        "artillerie"
                    ],
                    "common_phrases": [
                        "zwaar geschut",
                        "geschut in stelling brengen"
                    ],
                    "target_lang_definitions": {
                        "de": "Schwere Kriegswaffen wie Kanonen, mit denen Geschosse über große Entfernungen abgefeuert werden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Geschütz",
                                "target_lang_sense_clarification": "einzelne schwere Feuerwaffe"
                            },
                            {
                                "target_lang_word": "die Artillerie",
                                "target_lang_sense_clarification": "Gesamtheit der Geschütze oder Waffengattung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9180306-2e64-3b0a-9eb2-9fc9f0365157",
                    "sense_definition": "Voltooid deelwoord van <w>schutten</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het schip werd gisteren door de sluiswachter vlot <w>geschut</w>.",
                            "target_lang_translations": {
                                "de": "Das Schiff wurde gestern vom Schleusenwärter zügig <w>geschleust</w>."
                            }
                        },
                        {
                            "text": "Nadat de boot was <w>geschut</w>, kon de tocht over het kanaal worden voortgezet.",
                            "target_lang_translations": {
                                "de": "Nachdem das Boot <w>geschleust</w> worden war, konnte die Fahrt auf dem Kanal fortgesetzt werden."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "voltooid deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Perfekt von schutten (durch eine Schleuse befördern)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "geschleust",
                                "target_lang_sense_clarification": "Partizip Perfekt von schleusen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
