                    {
                        "sense_id": "41941fa4-8bf2-3eff-af45-b328f3b6eb4a",
                        "entry_id": "38b716e2-4947-33e8-a2ad-78d27ecc9efa",
                        "glosses": [
                            "Qui ne peut pas être chanté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac9d9e0c-f3e6-41f2-9369-1d4aee0527d2",
                                "sense_id": "41941fa4-8bf2-3eff-af45-b328f3b6eb4a",
                                "text": "Je le reconnus encore à ce qu’il ne chantait pas la chanson vraiment inchantable de l’assemblée qui formait le cercle autour d’un tas de pommes de terre germées."
                            },
                            {
                                "example_id": "a64ae0ee-3070-4169-bfb3-a198e4be77a2",
                                "sense_id": "41941fa4-8bf2-3eff-af45-b328f3b6eb4a",
                                "text": "Le mot « chômage », par exemple, est presque inchantable."
                            },
                            {
                                "example_id": "37c71612-35b0-4a49-a271-05539ecdfd30",
                                "sense_id": "41941fa4-8bf2-3eff-af45-b328f3b6eb4a",
                                "text": "Schumann et la symphonie, c'est comme Beethoven et la voix : une rencontre inaboutie. Beethoven, c'est inchantable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "092c0726-0138-41c3-bf55-8d3edf777233",
                        "source_entry_id": "38b716e2-4947-33e8-a2ad-78d27ecc9efa",
                        "source_sense_id": "41941fa4-8bf2-3eff-af45-b328f3b6eb4a",
                        "target_lang_word": "unsingable",
