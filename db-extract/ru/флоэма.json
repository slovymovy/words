                "senses": [
                    {
                        "sense_id": "af51d4a9-dcae-31e1-b7c7-61a2af010d67",
                        "entry_id": "66bc4af7-7921-35e9-89eb-fd1f2aa0e2cc",
                        "glosses": [
                            "ботан. ткань высших растений, служащая для проведения органических веществ к различным органам; луб"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09caffb3-3987-4ac8-ac75-257933a2469e",
                                "sense_id": "af51d4a9-dcae-31e1-b7c7-61a2af010d67",
                                "text": "Различают коллатеральные пучки — флоэма располагается по одну сторону — кнаружи от ксилемы; биколлатеральные пучки — флоэма располагается по обе стороны от ксилемы."
                            }
                        ]
                    }
                ],
