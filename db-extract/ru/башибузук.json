                        "target_lang_word": "bachi-bouzouk",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bachi-bouzouk",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7355332c-df72-30a0-ba63-fedcbeb2c3ef",
                                        "entry_id": "cb38d471-ba2d-3ae4-87af-63b3ce7cbc46",
                                        "glosses": [
                                            "Cavalier irrégulier (enrôlé pour une campagne) de l’armée ottomane."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b86ab6aa-51d8-4f1e-9cba-f6c650563f18",
                                                "sense_id": "7355332c-df72-30a0-ba63-fedcbeb2c3ef",
                                                "text": "Il a envoyé des bandes de Tatars et de bachi-bouzouks piller la région."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97035be5-8108-3c54-99b4-c13431d39d26",
                                        "entry_id": "cb38d471-ba2d-3ae4-87af-63b3ce7cbc46",
                                        "glosses": [
                                            "Injure préférée du capitaine Haddock, héros de la bande dessinée de Hergé Les Aventures de Tintin."
                                        ],
                                        "tags": [
                                            "Univers de Tintin",
                                            "Insulte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff2277f1-cb72-4a5e-8ae9-ead5c7497740",
                                                "sense_id": "97035be5-8108-3c54-99b4-c13431d39d26",
                                                "text": "Bandits !… Anacoluthes !… Bachi-bouzouks !…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cc389b6-0c39-336c-914a-d9c30389d8f1",
                                        "entry_id": "cb38d471-ba2d-3ae4-87af-63b3ce7cbc46",
                                        "glosses": [
                                            "Personne rustre, digne de peu de respect, au physique caractéristique de l’Europe sud-orientale ou de l’Asie Mineure."
                                        ],
                                        "tags": [
                                            "Sous l’influence du précédent"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffa4de45-2ae6-48c6-b2e7-c83eadc07b9d",
                                                "sense_id": "7cc389b6-0c39-336c-914a-d9c30389d8f1",
                                                "text": "Il se pouvait, aussi, qu’elle ne fréquentait pas le Grec depuis longtemps […]. Qu’elle me demande de partir, passe encore. Mais que ce bachi-bouzouk m’ordonne de ne pas revenir, c’était inacceptable."
                                            }
                                        ]
                                    }
                                ]
                            }
