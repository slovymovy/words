{
    "word_family": [
        "misgang",
        "gaan"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f1ab31ed-16ab-3eaf-be92-82cfa59aa209",
                    "sense_definition": "Op een verkeerde manier aflopen, mislukken.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mislukken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn schone plannen zijn helemaal <w>misgegaan</w>.",
                            "target_lang_translations": {
                                "en": "His beautiful plans have <w>gone completely wrong</w>."
                            }
                        },
                        {
                            "text": "Ik ben bang dat er vanavond iets zal <w>misgaan</w> tijdens het optreden.",
                            "target_lang_translations": {
                                "en": "I am afraid that something will <w>go wrong</w> during the performance tonight."
                            }
                        }
                    ],
                    "synonyms": [
                        "mislopen"
                    ],
                    "antonyms": [
                        "lukken",
                        "slagen"
                    ],
                    "common_phrases": [
                        "helemaal misgaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To end in a wrong way, to fail or go wrong."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go wrong",
                                "target_lang_sense_clarification": "to fail or proceed incorrectly"
                            },
                            {
                                "target_lang_word": "go awry",
                                "target_lang_sense_clarification": "to deviate from the planned course"
                            },
                            {
                                "target_lang_word": "fail",
                                "target_lang_sense_clarification": "to be unsuccessful"
                            },
                            {
                                "target_lang_word": "miscarry",
                                "target_lang_sense_clarification": "to fail to achieve a purpose or go wrong"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5b155ea-7993-3641-9f2e-bc6f6fbdbaba",
                    "sense_definition": "Dwalen, moreel of verstandelijk verkeerd handelen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dwalen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In zijn jeugd is hij weleens <w>misgegaan</w>, maar hij herstelde zijn leven.",
                            "target_lang_translations": {
                                "en": "In his youth he sometimes <w>went astray</w>, but he turned his life around."
                            }
                        },
                        {
                            "text": "Wie nooit <w>misgaat</w>, heeft nooit echt geleefd.",
                            "target_lang_translations": {
                                "en": "He who never <w>errs</w> has never really lived."
                            }
                        }
                    ],
                    "synonyms": [
                        "mislopen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "In de betekenis van moreel dwalen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To wander, to act wrongly in a moral or intellectual sense."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go astray",
                                "target_lang_sense_clarification": "to wander morally or intellectually"
                            },
                            {
                                "target_lang_word": "err",
                                "target_lang_sense_clarification": "to make a moral or intellectual mistake"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}