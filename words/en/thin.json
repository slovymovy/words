                    ],
                    "common_phrases": [
                        "thin wire",
                        "thin string",
                        "thin line"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень узкий в диаметре; имеющий малое поперечное сечение во всех направлениях.",
                        "nl": "Zeer smal in diameter; met een kleine dwarsdoorsnede."
                    },
