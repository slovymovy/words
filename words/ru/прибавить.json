                    ]
                },
                {
                    "sense_id": "477e5908-cfd5-388d-8528-51e506d6504e",
                    "sense_definition": "Сказать или написать что-то дополнительно к уже сказанному.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я хочу <w>прибавить</w> к своим словам, что это очень важно."
                        },
                        {
                            "text": "Он не мог ничего <w>прибавить</w> к тому, что уже было сказано."
