                    },
                    {
                        "sense_id": "7538e72b-ee1d-3abb-b94d-8f034a198643",
                        "entry_id": "aa7aa264-671c-36e2-99cf-32fc13558f97",
                        "glosses": [
                            "gebruik maken van een tunnel",
                            "door aanleg van een tunnel verbinden"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "d349a364-958f-4848-99f5-5be39396f7a0",
                                "sense_id": "7538e72b-ee1d-3abb-b94d-8f034a198643",
                                "text": "Als ook het omzetverlies van winkeliers en de overlast voor het verkeer worden meegenomen, dan zou, zeker in de binnenstad, tunnelen wel eens heel wat gunstiger uit de bus kunnen komen."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ec5f812-3f20-347e-a3a0-41bd3dbb8028",
                        "entry_id": "aa7aa264-671c-36e2-99cf-32fc13558f97",
                        "glosses": [
                            "gebruik maken van een tunnel",
                            "zich via een tunnel verplaatsen"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "eb6bd86c-93c5-418f-a1e0-66eef637c069",
                                "sense_id": "3ec5f812-3f20-347e-a3a0-41bd3dbb8028",
                                "text": "In Valkenburg kan men voortaan tunnelen"
                            }
                        ]
                    },
                    {
                        "sense_id": "a8739e7c-1217-3a7a-b7a6-185836634538",
                        "entry_id": "aa7aa264-671c-36e2-99cf-32fc13558f97",
                        "glosses": [
                            "de bal tussen de benen door spelen"
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d8c806b3-4b7d-3517-aacc-184a919a5c46",
                        "entry_id": "aa7aa264-671c-36e2-99cf-32fc13558f97",
                        "glosses": [
                            "zich ondanks een te lage energie verplaatsen voorbij een potentiaalbarrière"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "60aa42eb-e736-481a-83b5-6d3c4c997f3c",
                                "sense_id": "d8c806b3-4b7d-3517-aacc-184a919a5c46",
                                "text": "Wat het Josephson-effect - of moet ik zeggen de Josephson-effecten - betreft (dat zijn alle effecten die te maken hebben met het tunnelen van een persisterende stroom door een dun laagje van een stof die in dikkere lagen niet supergeleidend is), wil ik Josephson zelf aan het woord laten: ‘Experimentele onderzoekingen gedurende de laatste paar jaar over het gedrag van tunnelende superstromen hebben geresulteerd in het constateren van de meeste eigenschappen die waren voorspeld, maar ook van andere die op het ogenblik van hun ontdekking onverwacht waren.’"
                            }
                        ]
                    }
