                        ],
                        "examples": [
                            {
                                "example_id": "a510beac-0b08-442f-90e3-54dff2edb2ad",
                                "sense_id": "1f45cec0-5ff6-39c5-a66f-0887e8e82736",
                                "text": "One day the city magistrate asked the army for help to curb a protest march by women Congress workers who had threatened to gherao the officials in the divisional office."
                            },
                            {
                                "example_id": "f95812df-1605-4962-b532-d8d5a72e5f6a",
                                "sense_id": "1f45cec0-5ff6-39c5-a66f-0887e8e82736",
                                "text": "In reply, the cultivators, apparently now protesting under the banner of the BKU gheraoed the power station."
                            },
                            {
                                "example_id": "a63da248-5c3a-4a1b-a20d-f981d9678bb0",
                                "sense_id": "1f45cec0-5ff6-39c5-a66f-0887e8e82736",
                                "text": "Further incensed by the findings of two Citizen's Inquiry Committees that he had set up to probe the earlier police firings in Gaya and Patna, JP now announced a programme that involved picketing the Assembly, gheraoing the residences of MLAs, […]"
                            }
                        ]
