                        "sense_id": "7b5bff01-014f-3eb8-918b-3bfd0194e2ae",
                        "entry_id": "16467b2b-6783-32de-b408-c86b74a94f9c",
                        "glosses": [
                            "Ancien nom vulgaire de l’écureuil."
                        ],
                        "tags": [],
                        "note": "Sens douteux qui semble dérivé des armes des Fouquet",
                        "examples": [
                            {
