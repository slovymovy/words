                        "glosses": [
                            "Tirant sur le brun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21f9ba03-1350-4d21-b6f5-dc0d2ecdc4ac",
                                "sense_id": "c6d1a65a-1756-3b02-b129-44e3e945adc9",
                                "text": "L’Œillet des Chartreux (Dianthus Carthusianorum L.), à racine presque ligneuse; le calicule, formé de nombreuses écailles brunâtres ou rougeâtres, est entouré d’un involucre constitué par deux bractées longuement aristées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6c8d374-acce-4984-a01c-31ac3a6501e8",
                        "source_entry_id": "9bf9e94a-67bb-3dbd-9cac-cf8df7aff5cd",
                        "source_sense_id": "c6d1a65a-1756-3b02-b129-44e3e945adc9",
                        "source_sense_description": "Tirant sur le brun",
                        "target_lang_word": "brownish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brownish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19203d7f-291c-39fa-b483-7f03e30fb2af",
                                        "entry_id": "30af6603-85c8-38d9-916a-c2df11f895c1",
                                        "glosses": [
                                            "Of a colour which resembles brown; somewhat brown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e10da040-14ba-4974-a658-3973bfa13ac4",
                                                "sense_id": "19203d7f-291c-39fa-b483-7f03e30fb2af",
                                                "text": "Two pumps stood side by side in our kitchen. One was for well water and one was a cistern pump—water from the former was hard and clear, from the cistern it was brownish and soft."
                                            },
                                            {
                                                "example_id": "14937f7f-ebef-4cd1-a690-c2d44f6dbfa3",
                                                "sense_id": "19203d7f-291c-39fa-b483-7f03e30fb2af",
                                                "text": "The Giraffe and the Zebra and the Eland and the Koodoo and the Hartebeest lived there; and they were 'sclusively sandy-yellow-brownish all over […]"
                                            },
                                            {
                                                "example_id": "facac98e-b166-4b4e-94e1-5d68b205cbf7",
                                                "sense_id": "19203d7f-291c-39fa-b483-7f03e30fb2af",
                                                "text": "Watt wore, on his feet, a boot, brown in colour, and a shoe, happily of a brownish colour also."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c38f0733-4bb0-48df-ab84-c96d68764931",
                        "source_entry_id": "9bf9e94a-67bb-3dbd-9cac-cf8df7aff5cd",
