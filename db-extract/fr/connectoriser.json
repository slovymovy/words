                "senses": [
                    {
                        "sense_id": "7b24ec20-56d8-367e-accd-29cc79a254f4",
                        "entry_id": "6a3c1975-a8c4-3aaa-a6dd-a7ff8fdebb34",
                        "glosses": [
                            "Installer un connecteur au bout d’un câble."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "652bc095-8855-400d-8912-86ec8c5d28d8",
                                "sense_id": "7b24ec20-56d8-367e-accd-29cc79a254f4",
                                "text": "Raccorder, lover, délover, « connectoriser » les fibres en immeuble, selon les normes et règles en vigueur chez l'opérateur"
                            },
                            {
                                "example_id": "22fa8a0f-a53d-4bc9-b0c5-43c4ec54ee96",
                                "sense_id": "7b24ec20-56d8-367e-accd-29cc79a254f4",
                                "text": "Cette méthode consiste à assembler sur le câble à connectoriser le connecteur de son choix, livré en kit."
                            },
                            {
                                "example_id": "a42ff5f2-8ecd-4817-b707-0904bdce73c0",
                                "sense_id": "7b24ec20-56d8-367e-accd-29cc79a254f4",
                                "text": "Ce kit inclut tout le nécessaire pour connectoriser vos fibres sur le terrain."
                            },
                            {
                                "example_id": "10f4451c-f166-4449-a79e-89f9ae9f407d",
                                "sense_id": "7b24ec20-56d8-367e-accd-29cc79a254f4",
                                "text": "Enroulage du câble à connectoriser et mise sous pochette plastique transparente auto-soudable avec référence (étiquette)."
                            }
                        ]
                    }
