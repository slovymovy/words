                                    {
                                        "sense_id": "b1beb0af-4618-319f-9c93-3c3ca38b6afa",
                                        "entry_id": "4f8e361e-2ac2-3685-9ad2-ad4c23672c9b",
                                        "glosses": [
                                            "разг. надоедать, досаждать чем-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9846b78-1850-4a2d-98ef-32eecdacbd3d",
                                                "sense_id": "b1beb0af-4618-319f-9c93-3c3ca38b6afa",
                                                "text": "но, как эта вдова не дает мне покоя, защищу ее, чтобы она не приходила больше докучать мне."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d67a9aff-b110-471a-9709-2edfdd6dd842",
                        "source_entry_id": "5b2152b6-fd69-3181-aa81-53a1dee99206",
                        "source_sense_description": "transitive to mither",
                        "target_lang_word": "донима́ть",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "донима́ть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4d3a0b6a-a558-3ec9-8270-148216cb9eab",
                                        "entry_id": "572d1aa5-aa74-3a4f-8f69-59454245c44b",
                                        "glosses": [
                                            "разг. не давать покоя, надоедать кому-либо, выводить кого-либо из терпения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68105682-7953-4da5-a67c-5240a5a35f57",
                                                "sense_id": "4d3a0b6a-a558-3ec9-8270-148216cb9eab",
                                                "text": "Зато другие дровосушки, щеголявшие в кумачных платках и в ситцевых новых сарафанах, постоянно донимали Федорку разными смешками."
                                            },
                                            {
                                                "example_id": "0b8c9f57-fe05-4b00-bd5f-271e906cae2c",
                                                "sense_id": "4d3a0b6a-a558-3ec9-8270-148216cb9eab",
                                                "text": "Я донимал Наташу своей похотью, а она раздраженно оборонялась."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21a1888b-277b-3484-a346-531d211f0130",
                                        "entry_id": "572d1aa5-aa74-3a4f-8f69-59454245c44b",
                                        "glosses": [
                                            "разг. причинять боль, мучения кому-либо; изнурять кого-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57db9dfa-ce72-44ec-a393-7e20ecaac43b",
                                                "sense_id": "21a1888b-277b-3484-a346-531d211f0130",
                                                "text": "Жара тоже донимала, несмотря на неурочное время ― октябрь."
                                            },
                                            {
                                                "example_id": "07f62304-f68f-4466-880e-340ca12e3f87",
                                                "sense_id": "21a1888b-277b-3484-a346-531d211f0130",
                                                "text": "Он сел и стал чесать за ухом. Донимали блохи. Солнце блеснуло последний раз среди стволов и ушло."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
