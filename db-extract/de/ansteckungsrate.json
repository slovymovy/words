                "senses": [
                    {
                        "sense_id": "c08cf847-3736-3313-9051-cede2890192b",
                        "entry_id": "0ce84d4d-5141-3aa4-b8ee-35880a0779d4",
                        "glosses": [
                            "Zahl der Neuinfektionen, Anzahl der Neuerkrankungen an einer Infektionskrankheit"
                        ],
                        "tags": [
                            "Infektiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "881d56e6-d1a7-4180-bb10-cb6c0bba98c6",
                                "sense_id": "c08cf847-3736-3313-9051-cede2890192b",
                                "text": "Strenge Regeln haben dafür gesorgt, dass die Ansteckungsraten zurückgegangen sind."
                            },
                            {
                                "example_id": "cd572bbb-4656-40fc-b433-7ec04453e8f8",
                                "sense_id": "c08cf847-3736-3313-9051-cede2890192b",
                                "text": "„Wie wir gesehen haben, kann eine epidemische Krankheit, wie Grippe, Masern oder Mumps, wieder auftreten, nachdem eine Mutation ihre Ansteckungsrate verändert hat.“"
                            },
                            {
                                "example_id": "60602b3a-35ec-42c7-b620-f839a68f429b",
                                "sense_id": "c08cf847-3736-3313-9051-cede2890192b",
                                "text": "„Corona-Ausbrüche wie in der Fleischfabrik Tönnies im Kreis Gütersloh lassen die Ansteckungsrate in Deutschland wieder steigen. Die Reproduktionszahl, kurz R-Wert, liegt nun bei 1,79.“"
                            },
                            {
                                "example_id": "6d89efe5-c211-405d-be3e-b685ea53d9dd",
                                "sense_id": "c08cf847-3736-3313-9051-cede2890192b",
                                "text": "„Die Kontagiosität des Hl-Virus ist zum Glück gering: Die Ansteckungsrate nach direkter Inokulation wird auf < 0,25 % geschätzt […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
