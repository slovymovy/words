                        "examples": [
                            {
                                "example_id": "4badcd8d-ea1c-4b33-a873-501e904d8987",
                                "sense_id": "66d07584-3073-390f-be3d-d885d3c99807",
                                "text": "Le premier instrument de M. Bayer a été emporté en Amérique par Franklin , qui l'a nommé glass-cord; nom composé de deux mots Anglois , glass , verre , et cord , corde , et qui désigne un instrument à cordes de verres."
                            },
                            {
                                "example_id": "5055c2d8-f238-4dd8-a2bd-941fe782b112",
                                "sense_id": "66d07584-3073-390f-be3d-d885d3c99807",
                                "text": "Au temple d'Apollon, on a un chœur des Muses ; dans l'allée de la Cascade, on écoute l'harmonie placée dans la grotte souterraine; le berceau de vigne, décoré de fleurs et de glaces, mène à un superbe buffet, et l'on y a un concert français et allemand avec solo de glass-cord, instrument nouveau; […]."
                            }
                        ]
