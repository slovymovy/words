                        "form": "die Nonkonformisten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff49bb5e-5168-3fbf-b729-99cd0e8d957f",
                        "entry_id": "9cde7d31-ff36-3874-8c33-f2e48886783a",
                        "glosses": [
                            "Person mit einer Haltung, Einstellung, die nicht mit den üblichen, anerkannten Verhaltensweisen, Ansichten übereinstimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9935f1f5-9b9b-4e47-bb58-5107be41d92a",
                                "sense_id": "ff49bb5e-5168-3fbf-b729-99cd0e8d957f",
                                "text": "„Nonkonformisten sind Menschen, die keine Lust haben, wie alle zu sein. Und wie alle zu denken.“"
                            },
                            {
                                "example_id": "4430de77-bd58-4d9e-9382-1a6ff30cdd14",
                                "sense_id": "ff49bb5e-5168-3fbf-b729-99cd0e8d957f",
                                "text": "„Dostojewskij wird als in sich widersprüchliche Persönlichkeit beschrieben: ein Nonkonformist, der gegen Individualismus wettert, ein Schiller- und Hoffmann-Verehrer, der alles Deutsche hasst, ein Intellektueller, der sich in seiner Impulsivität nicht um Schlüssigkeit schert.“"
                            },
                            {
                                "example_id": "98d2bb32-50b9-4ac3-81f1-c36bed0d23b8",
                                "sense_id": "ff49bb5e-5168-3fbf-b729-99cd0e8d957f",
                                "text": "„Dabei sind es gerade die originellen Nonkonformisten, die mit innovativen Veränderungen der Wirtschaft neue Impulse geben.“"
                            },
                            {
                                "example_id": "4440eb79-2a68-450a-86af-06c8cdcde64a",
                                "sense_id": "ff49bb5e-5168-3fbf-b729-99cd0e8d957f",
                                "text": "„Aufgrund ihrer Ablehnung von parteipolitischer Organisation blieben die Nonkonformisten eine nur locker zusammengeschlossene Gruppe mit heterogenen Ansichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eedd3980-054e-3276-91b2-27105a547394",
                        "entry_id": "9cde7d31-ff36-3874-8c33-f2e48886783a",
                        "glosses": [
                            "Mitglied einer Kirche, die von der anglikanischen Staatskirche abweicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec48e786-2d18-4fdc-a786-ac7cf3aeb776",
                                "sense_id": "eedd3980-054e-3276-91b2-27105a547394",
                                "text": "„1795 gründeten Londoner Nonkonformisten eine Gemeinschaft, die sich später als South Place Ethical Society etablierte und als Beginn der organisierten ethischen Gesellschaften gilt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
