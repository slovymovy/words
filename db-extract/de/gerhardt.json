                        "examples": [
                            {
                                "example_id": "624b08fd-7fe2-4fc5-b249-204ed29e4dc9",
                                "sense_id": "8901bb50-59b2-328d-b571-2d3dce8f36c3",
                                "text": "Gerhardt Mustermann ist ein schöner Junge."
                            },
                            {
                                "example_id": "56513564-d0bc-4e91-b018-4aaa7eae6a94",
                                "sense_id": "8901bb50-59b2-328d-b571-2d3dce8f36c3",
                                "text": "Gerhardt ist 20 Jahre alt."
                            },
                            {
                                "example_id": "dc5b708b-22ce-4c4f-8615-c5dde20e9c0a",
                                "sense_id": "8901bb50-59b2-328d-b571-2d3dce8f36c3",
                                "text": "Grüß bitte Gerhardt Mustermann herzlich von mir."
                            },
                            {
                                "example_id": "7bcd5f87-1c85-43f3-9f86-59c86b60c915",
                                "sense_id": "8901bb50-59b2-328d-b571-2d3dce8f36c3",
                                "text": "Gerhardt fällt mir bei allem in den Rücken."
                            }
                        ],
                        "sense_index_json": "\"1\""
