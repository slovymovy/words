                        "examples": [
                            {
                                "example_id": "f50d11e6-2b53-4765-9d10-5bbe20176fd4",
                                "sense_id": "3bc7a745-c599-3c4f-9ff6-1ce70c56f561",
                                "text": "In de provincie Luxemburg is om verspreiding te voorkomen een zogenoemd spergebied van 62 vierkante kilometer ingesteld. Binnen dat gebied is een jachtverbod en een bijvoerverbod voor dieren van kracht. In september werd de Afrikaanse varkenspest geconstateerd bij een zwijn in België."
                            },
                            {
                                "example_id": "cfa4039a-7eb1-4d4f-90c2-db3c3584406b",
                                "sense_id": "3bc7a745-c599-3c4f-9ff6-1ce70c56f561",
                                "text": "De ADO-knollen van de mobiele eenheid zijn al opgetuigd, in verband met de verwachte drukte is de omgeving van HVV tot vesting verklaard. Feestelijk, maar spergebied."
                            },
                            {
                                "example_id": "dbcf4b16-07b8-4706-ba00-fc6f7f79ec98",
                                "sense_id": "3bc7a745-c599-3c4f-9ff6-1ce70c56f561",
                                "text": "De campagneafdelingen van de verschillende politieke partijen weten elkaar loepzuiver te bestoken, en daar tussenin ligt het spergebied dat we vroeger wel ‘het brede maatschappelijke middenveld’ noemden, waar een al even ‘brede maatschappelijke discussie’ werd gevoerd."
                            }
                        ]
                    }
