                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b87d901-9109-36e0-8c07-f21c0de06d22",
                                        "entry_id": "fae6bc97-975a-346c-a84e-dee8a849e026",
                                        "glosses": [
                                            "Vin qui ne forme pas de bulles à l’ouverture de la bouteille, ce qui est le cas de la plupart des vins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbc2597b-9300-4bc1-a0f2-945a139de327",
                                                "sense_id": "5b87d901-9109-36e0-8c07-f21c0de06d22",
                                                "text": "Définition légale d’un vin tranquille : Pas de dégagement de gaz carbonique à l'ouverture de la bouteille. Taux d'alcool compris entre 1,2 % vol. et 15 % vol ou entre 15 % vol. et 18 % vol. (sans enrichissement pour autant que l'alcool contenu dans le produit fini résulte entièrement d'une fermentation (et non d'un autre procédé telle que la distillation par exemple)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
