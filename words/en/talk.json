{
    "word_family": [
        "talkative",
        "talker",
        "talking",
        "talky",
        "backtalk",
        "small-talk"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "957d1bae-85af-3a13-a80b-934065e2b0df",
                    "sense_definition": "To communicate, usually by means of speech.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We should sit down and <w>talk</w> about our plans for the weekend.",
                            "target_lang_translations": {
                                "ru": "Нам стоит присесть и <w>поговорить</w> о наших планах на выходные."
                            }
                        },
                        {
                            "text": "Even though they didn't speak the same language, they managed to <w>talk</w> using signs.",
                            "target_lang_translations": {
                                "ru": "Хотя они не знали языка друг друга, им удавалось <w>общаться</w> с помощью знаков."
                            }
                        }
                    ],
                    "synonyms": [
                        "chat",
                        "communicate",
                        "speak"
                    ],
                    "antonyms": [
                        "silence"
                    ],
                    "common_phrases": [
                        "talk about",
                        "talk with",
                        "stop talking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общаться, обычно с помощью речи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "говорить",
                                "target_lang_sense_clarification": "владеть речью или произносить слова"
                            },
                            {
                                "target_lang_word": "разговаривать",
                                "target_lang_sense_clarification": "вести беседу с кем-либо"
                            },
                            {
                                "target_lang_word": "беседовать",
                                "target_lang_sense_clarification": "вести спокойный, продолжительный разговор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "051fdb15-b957-3c86-a231-a233c13a20fc",
                    "sense_definition": "To discuss or talk about a specific subject.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the meeting, the partners stayed behind to <w>talk</w> business.",
                            "target_lang_translations": {
                                "ru": "После встречи партнеры остались, чтобы <w>обсудить</w> дела."
                            }
                        },
                        {
                            "text": "Let's <w>talk</w> holidays and decide where we want to go this summer.",
                            "target_lang_translations": {
                                "ru": "Давайте <w>поговорим</w> об отпуске и решим, куда мы хотим поехать этим летом."
                            }
                        }
                    ],
                    "synonyms": [
                        "discussion"
                    ],
                    "common_phrases": [
                        "talk business",
                        "talk shop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обсуждать или говорить на определенную тему."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обсуждать",
                                "target_lang_sense_clarification": "рассматривать какой-либо вопрос"
                            },
                            {
                                "target_lang_word": "говорить о",
                                "target_lang_sense_clarification": "вести речь о чем-либо конкретном"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ee5982e-384a-3fdd-861f-7f89a197e264",
                    "sense_definition": "To speak a certain language.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When we visit my grandparents, we <w>talk</w> French at the dinner table.",
                            "target_lang_translations": {
                                "ru": "Когда мы навещаем бабушку с дедушкой, за обеденным столом мы <w>говорим</w> по-французски."
                            }
                        },
                        {
                            "text": "It is helpful to <w>talk</w> the local language when traveling abroad.",
                            "target_lang_translations": {
                                "ru": "В заграничных поездках полезно <w>изъясняться</w> на местном языке."
                            }
                        }
                    ],
                    "synonyms": [
                        "speak"
                    ],
                    "common_phrases": [
                        "talk French",
                        "talk sense"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить на определенном языке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "говорить",
                                "target_lang_sense_clarification": "пользоваться определенным языком для общения"
                            },
                            {
                                "target_lang_word": "изъясняться",
                                "target_lang_sense_clarification": "выражать свои мысли на языке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01da0a63-b7a0-39d2-ba5e-b3cd4cd96e05",
                    "sense_definition": "To confess or provide information, especially when it implicates others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police tried to make the suspect <w>talk</w> about his accomplices.",
                            "target_lang_translations": {
                                "ru": "Полиция пыталась заставить подозреваемого <w>заговорить</w> о его сообщниках."
                            }
                        },
                        {
                            "text": "They were worried that he might <w>talk</w> if he was offered a deal.",
                            "target_lang_translations": {
                                "ru": "Они боялись, что он может <w>расколоться</w>, если ему предложат сделку."
                            }
                        }
                    ],
                    "synonyms": [
                        "let on",
                        "make known"
                    ],
                    "common_phrases": [
                        "make someone talk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Признаваться или предоставлять информацию, особенно ту, которая изобличает других."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заговорить",
                                "target_lang_sense_clarification": "начать давать показания или признаваться"
                            },
                            {
                                "target_lang_word": "расколоться",
                                "target_lang_sense_clarification": "сленг: признаться под давлением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "619b7074-1054-3c9c-b4ff-9e7189bafd44",
                    "sense_definition": "To gossip or create a scandal through conversation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gossip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you leave the party early with him, people will <w>talk</w>.",
                            "target_lang_translations": {
                                "ru": "Если ты уйдешь с вечеринки вместе с ним так рано, <w>пойдут разговоры</w>."
                            }
                        },
                        {
                            "text": "She was afraid the neighbors would <w>talk</w> about her private life.",
                            "target_lang_translations": {
                                "ru": "Она боялась, что соседи будут <w>сплетничать</w> о ее личной жизни."
                            }
                        }
                    ],
                    "synonyms": [
                        "gossip"
                    ],
                    "common_phrases": [
                        "people will talk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сплетничать или создавать скандал посредством разговоров."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплетничать",
                                "target_lang_sense_clarification": "распространять слухи"
                            },
                            {
                                "target_lang_word": "судачить",
                                "target_lang_sense_clarification": "заниматься пересудами"
                            },
                            {
                                "target_lang_word": "пойдут разговоры",
                                "target_lang_sense_clarification": "о возникновении слухов в обществе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "004089de-0195-3ab6-a7d0-dff9da7f829e",
                    "sense_definition": "Used to emphasize the importance, size, or complexity of the thing mentioned.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you want to buy that mansion, you are <w>talking</w> big money.",
                            "target_lang_translations": {
                                "ru": "Если ты хочешь купить этот особняк, <w>речь идет о</w> больших деньгах."
                            }
                        },
                        {
                            "text": "We are not <w>talking</w> rocket science, so you should be able to fix it.",
                            "target_lang_translations": {
                                "ru": "Это не <w>высшая математика</w>, так что ты должен суметь это починить."
                            }
                        }
                    ],
                    "common_phrases": [
                        "talking big money",
                        "talking rocket science"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the progressive form to emphasize scale"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для подчеркивания важности, размера или сложности упоминаемой вещи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "речь идет о",
                                "target_lang_sense_clarification": "указывает на серьезность обсуждаемого предмета"
                            },
                            {
                                "target_lang_word": "говорить о",
                                "target_lang_sense_clarification": "подразумевать значительный масштаб"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e092c1e-3354-383a-bbb2-f5b9006e7113",
                    "sense_definition": "To criticize someone for a fault that the speaker also possesses.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You are complaining about me being late? Look who is <w>talking</w>!",
                            "target_lang_translations": {
                                "ru": "Ты жалуешься на мое опоздание? <w>Кто бы говорил</w>!"
                            }
                        },
                        {
                            "text": "He said I was lazy, but he is a fine one to <w>talk</w>.",
                            "target_lang_translations": {
                                "ru": "Он сказал, что я ленивый, но <w>чья бы корова мычала</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "look who is talking",
                        "fine one to talk"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "usually used in specific idiomatic constructions"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Критиковать кого-то за недостаток, которым обладает и сам говорящий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кто бы говорил",
                                "target_lang_sense_clarification": "ироничное замечание в ответ на критику"
                            },
                            {
                                "target_lang_word": "чья бы корова мычала",
                                "target_lang_sense_clarification": "пословица о неуместной критике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "092c5e64-2dc4-3787-b642-cb7a7cba0560",
                    "sense_definition": "To influence someone's expression or viewpoint, often attributed to an external factor like money or drugs.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't listen to his insults; that is just the alcohol <w>talking</w>.",
                            "target_lang_translations": {
                                "ru": "Не слушай его оскорбления, это в нем <w>говорит</w> алкоголь."
                            }
                        },
                        {
                            "text": "He claimed he was loyal, but his wallet was <w>talking</w> when he took the bribe.",
                            "target_lang_translations": {
                                "ru": "Он заявлял о своей преданности, но когда он взял взятку, за него <w>говорил</w> его кошелек."
                            }
                        }
                    ],
                    "common_phrases": [
                        "money talking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Влиять на чье-то мнение или высказывания (часто о деньгах или алкоголе)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "говорить",
                                "target_lang_sense_clarification": "проявляться в действиях под влиянием фактора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32ef5fec-adcb-39dd-b40b-2612683e7d6d",
                    "sense_definition": "To express ideas or values in speech that are not reflected in one's actual actions.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "hypocrisy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>talks</w> charity all day but never gives a penny to the poor.",
                            "target_lang_translations": {
                                "ru": "Он целыми днями <w>разглагольствует</w> о благотворительности, но не дает беднякам ни копейки."
                            }
                        },
                        {
                            "text": "It is easy to <w>talk</w> success when you haven't faced any real challenges.",
                            "target_lang_translations": {
                                "ru": "Легко <w>рассуждать</w> об успехе, когда ты не сталкивался с настоящими трудностями."
                            }
                        }
                    ],
                    "synonyms": [
                        "speechify"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать идеи или ценности на словах, которые не отражаются в реальных поступках."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разглагольствовать",
                                "target_lang_sense_clarification": "говорить много и пафосно без дела"
                            },
                            {
                                "target_lang_word": "рассуждать",
                                "target_lang_sense_clarification": "теоретизировать о чем-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b18f88a5-02e8-3e32-9e03-2e362c7b40f4",
                    "sense_definition": "A conversation or discussion, often serious but informal.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "conversation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher said we need to have a <w>talk</w> about your recent grades.",
                            "target_lang_translations": {
                                "ru": "Учитель сказал, что нам нужно провести <w>беседу</w> о твоих последних оценках."
                            }
                        },
                        {
                            "text": "After the argument, they had a long <w>talk</w> to clear the air.",
                            "target_lang_translations": {
                                "ru": "После ссоры у них состоялся долгий <w>разговор</w>, чтобы прояснить ситуацию."
                            }
                        }
                    ],
                    "synonyms": [
                        "conversation",
                        "discussion",
                        "chat"
                    ],
                    "antonyms": [
                        "silence"
                    ],
                    "common_phrases": [
                        "have a talk",
                        "serious talk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Беседа или обсуждение, часто серьезное, но неформальное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разговор",
                                "target_lang_sense_clarification": "словесный обмен сведениями или мнениями"
                            },
                            {
                                "target_lang_word": "беседа",
                                "target_lang_sense_clarification": "спокойный и обычно продолжительный разговор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a60964d1-2ec3-3f90-b1dd-8d86b2da4b3e",
                    "sense_definition": "A formal presentation or lecture on a specific subject.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "presentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am going to a <w>talk</w> on climate change at the library tonight.",
                            "target_lang_translations": {
                                "ru": "Сегодня вечером я иду в библиотеку на <w>лекцию</w> об изменении климата."
                            }
                        },
                        {
                            "text": "The professor gave an interesting <w>talk</w> about ancient history.",
                            "target_lang_translations": {
                                "ru": "Профессор выступил с интересным <w>докладом</w> о древней истории."
                            }
                        }
                    ],
                    "synonyms": [
                        "speech"
                    ],
                    "common_phrases": [
                        "give a talk",
                        "interesting talk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальная презентация или лекция на определенную тему."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лекция",
                                "target_lang_sense_clarification": "устное изложение учебной или научной темы"
                            },
                            {
                                "target_lang_word": "выступление",
                                "target_lang_sense_clarification": "публичная речь"
                            },
                            {
                                "target_lang_word": "доклад",
                                "target_lang_sense_clarification": "сообщение на заданную тему"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d264a898-3b95-349b-9a39-fae87fef7205",
                    "sense_definition": "Formal meetings or negotiations between groups or nations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "negotiation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two countries are currently in <w>talks</w> to end the trade war.",
                            "target_lang_translations": {
                                "ru": "В настоящее время две страны ведут <w>переговоры</w> о прекращении торговой войны."
                            }
                        },
                        {
                            "text": "Peace <w>talks</w> are scheduled to begin in Geneva next week.",
                            "target_lang_translations": {
                                "ru": "Мирные <w>переговоры</w> должны начаться в Женеве на следующей неделе."
                            }
                        }
                    ],
                    "synonyms": [
                        "conference",
                        "meeting",
                        "discussion"
                    ],
                    "common_phrases": [
                        "peace talks",
                        "trade talks",
                        "in talks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальные встречи или переговоры между группами или странами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переговоры",
                                "target_lang_sense_clarification": "официальное обсуждение условий или соглашений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "458b97e9-2313-34e9-8c1e-0d78ef000050",
                    "sense_definition": "Gossip or rumors circulating within a community.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gossip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There has been a lot of <w>talk</w> lately about the company closing down.",
                            "target_lang_translations": {
                                "ru": "В последнее время ходит много <w>слухов</w> о закрытии компании."
                            }
                        },
                        {
                            "text": "Don't pay attention to the <w>talk</w> you hear in the hallways.",
                            "target_lang_translations": {
                                "ru": "Не обращай внимания на <w>толки</w>, которые слышишь в коридорах."
                            }
                        }
                    ],
                    "synonyms": [
                        "gossip"
                    ],
                    "common_phrases": [
                        "lot of talk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сплетни или слухи, циркулирующие в обществе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слухи",
                                "target_lang_sense_clarification": "неподтвержденные сведения"
                            },
                            {
                                "target_lang_word": "толки",
                                "target_lang_sense_clarification": "пересуды, обсуждения в народе"
                            },
                            {
                                "target_lang_word": "молва",
                                "target_lang_sense_clarification": "общественное мнение или вести"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80d339b7-d9da-3ca8-a4b2-2f358c2f87e0",
                    "sense_definition": "A person or thing that is the main subject of social discussion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gossip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With her new movie out, she is the <w>talk</w> of the town.",
                            "target_lang_translations": {
                                "ru": "После выхода нового фильма она стала главной <w>темой</w> для разговоров в городе."
                            }
                        },
                        {
                            "text": "The scandal became the <w>talk</w> of the day across all social media.",
                            "target_lang_translations": {
                                "ru": "Этот скандал стал <w>притчей во языцех</w> во всех социальных сетях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "talk of the town",
                        "talk of the day"
