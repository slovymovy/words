                "senses": [
                    {
                        "sense_id": "10512f98-7706-307a-a4df-ee16cd71d88f",
                        "entry_id": "d391dddb-6ac2-390b-af8e-48be538d431a",
                        "glosses": [
                            "Person, die Geige spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31def21a-c0fb-4e12-8f59-d44e1ae69f1b",
                                "sense_id": "10512f98-7706-307a-a4df-ee16cd71d88f",
                                "text": "Lass dich nicht vom Geigenspieler verführen."
                            },
                            {
                                "example_id": "7142ab60-3bed-4ce0-882a-645ea75eedc4",
                                "sense_id": "10512f98-7706-307a-a4df-ee16cd71d88f",
                                "text": "„Ismaïl verkündete, die Tänzerin sei schon gefunden, worauf ich erwiderte, ich würde auch den Geigenspieler auftreiben, wenn er einen kurzen Brief zur venezianischen Gesandtschaft bringen ließe.“"
                            },
                            {
                                "example_id": "d71b33d8-aa88-4cbf-a07d-d616dc133b13",
                                "sense_id": "10512f98-7706-307a-a4df-ee16cd71d88f",
                                "text": "„Der Geigenspieler erschien zum zweitenmal.“"
                            },
                            {
                                "example_id": "08e0b576-2b49-4dfc-a798-65c43182143c",
                                "sense_id": "10512f98-7706-307a-a4df-ee16cd71d88f",
                                "text": "„Durch Begabung, Freude am Spiel und beständiges Üben wurde Einstein zu einem guten Geigenspieler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8065ed6-5132-4fc7-a019-56842d335eea",
                        "source_entry_id": "d391dddb-6ac2-390b-af8e-48be538d431a",
                        "source_sense_id": "10512f98-7706-307a-a4df-ee16cd71d88f",
                        "source_sense_description": "Person, die Geige spielt",
                        "target_lang_word": "violinist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "violinist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3588243-a7fa-3836-979f-ae8d94e2885a",
                                        "entry_id": "1e1771f9-7a89-3604-b6dc-c1f679de1a22",
                                        "glosses": [
                                            "A person who plays the violin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "941bbffa-8684-408b-8b1a-1095bd7dad44",
                                                "sense_id": "e3588243-a7fa-3836-979f-ae8d94e2885a",
                                                "text": "[…] on Sunday four more violinists, a second violist and a harpsichordist were added to give the ripieno sections of the fast movements a heftier punch than the smaller group delivered."
                                            },
                                            {
                                                "example_id": "646e586c-2003-47e5-8b38-6a39546babab",
                                                "sense_id": "e3588243-a7fa-3836-979f-ae8d94e2885a",
                                                "text": "Founded in 1975 and led by the violinist Richard Tognetti since 1989, the orchestra looks youthful and hip onstage, its players clad in varying shades of black semiformality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90e4d830-47ca-4b32-b4e4-0925cf11d27a",
                        "source_entry_id": "d391dddb-6ac2-390b-af8e-48be538d431a",
