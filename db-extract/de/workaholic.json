                ],
                "senses": [
                    {
                        "sense_id": "c502a6b9-01cb-320b-9103-9f7d73942f8a",
                        "entry_id": "bcce86a7-766d-39ed-9d3a-2cc1233d424d",
                        "glosses": [
                            "weibliche Person, die übermäßig viel arbeitet, die an Arbeitssucht leidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f057e10-3af0-4ac7-b601-4acfe8c80637",
                                "sense_id": "c502a6b9-01cb-320b-9103-9f7d73942f8a",
                                "text": "„Ist sie hektisch, chaotisch, eine Perfektionistin, über das Maß des Erträglichen hinaus ehrgeizig, sehr umtriebig, eine Workaholic oder schiebt sie eine ruhige Kugel und tut so, als würde sie unter der Last der Bürde zusammenbrechen?“"
                            },
                            {
                                "example_id": "6bf3941b-7520-40c7-817b-23fdca61cb28",
                                "sense_id": "c502a6b9-01cb-320b-9103-9f7d73942f8a",
                                "text": "„María Eva Duarte de Perón sei eine Workaholic gewesen, erzählte mir die 94-jährige Nélida de Miguel, eine ihrer engsten Mitarbeiterinnen.“"
                            },
                            {
                                "example_id": "bb335db9-d2ec-4951-9276-fb7cfea634c7",
                                "sense_id": "c502a6b9-01cb-320b-9103-9f7d73942f8a",
                                "text": "„Sie sagt, sie sei früher eine Workaholic gewesen und alle zwei Stunden aufgewacht, um ihren Posteingang zu checken, […]“"
                            },
                            {
                                "example_id": "c7efbc9a-ddf0-4205-8836-a99aa441864d",
                                "sense_id": "c502a6b9-01cb-320b-9103-9f7d73942f8a",
                                "text": "„Meine Mutter war schon immer eine Workaholic.“"
                            },
                            {
                                "example_id": "4058623e-f415-4cff-8600-ecc5cb7b02b3",
                                "sense_id": "c502a6b9-01cb-320b-9103-9f7d73942f8a",
                                "text": "„Dieser Job war der Beginn einer zwanzigjährigen Karriere bei der NHS, und du bist derart in deiner Arbeit aufgegangen, dass du dir den Vorwurf gefallen lassen musstest, eine Workaholic zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
