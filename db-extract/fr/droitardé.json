                                                "example_id": "5bef5e09-2bc9-403d-95d8-257ff6e060f5",
                                                "sense_id": "996add33-a95f-3247-9420-1eb4e076d8d3",
                                                "text": "Apparantly King George has forgotten bin Laden. He even said once that bin Laden wasn't a priority. But still crickets from you Righturds. So do the American people know more than the King? Hint: Rhetorical question."
                                            },
                                            {
                                                "example_id": "0042278b-497d-4eaa-9c85-cf229960cc3f",
                                                "sense_id": "996add33-a95f-3247-9420-1eb4e076d8d3",
                                                "text": "Its good to see you righturds are living in the here and now instead of some weird fifty year old fantasy world."
                                            },
                                            {
                                                "example_id": "3f823728-4cb4-49a4-af8a-2c237b526d2a",
                                                "sense_id": "996add33-a95f-3247-9420-1eb4e076d8d3",
                                                "text": "The Righturds don't want to use tax money for Social services benefiting American citizens and bash Obama at every turn when he does."
                                            }
