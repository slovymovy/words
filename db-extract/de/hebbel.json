                ],
                "senses": [
                    {
                        "sense_id": "eb3e55ed-2e2d-31f8-b3ab-289d408c09cf",
                        "entry_id": "6848030c-14aa-3bca-8d35-98f0f57a2442",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70f6c6a8-4fa3-4993-85b2-426882091f4d",
                                "sense_id": "eb3e55ed-2e2d-31f8-b3ab-289d408c09cf",
                                "text": "Frau Hebbel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "db9bfe46-a591-41c0-8c48-435051490f0a",
                                "sense_id": "eb3e55ed-2e2d-31f8-b3ab-289d408c09cf",
                                "text": "Herr Hebbel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c97eb1d8-8e2d-47b7-ae05-375f01f590b9",
                                "sense_id": "eb3e55ed-2e2d-31f8-b3ab-289d408c09cf",
                                "text": "Die Hebbels fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "2fbcba5f-39bf-4c77-8520-c3fd6f467cd7",
                                "sense_id": "eb3e55ed-2e2d-31f8-b3ab-289d408c09cf",
                                "text": "Der Hebbel trägt nie die Pullover, die die Hebbel ihm strickt."
                            },
                            {
                                "example_id": "b613ad37-8f32-488c-86c2-486531caf7d6",
                                "sense_id": "eb3e55ed-2e2d-31f8-b3ab-289d408c09cf",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hebbel kommt, geht der Herr Hebbel.“"
                            },
                            {
                                "example_id": "48dc5be5-ed07-4131-9251-270a50b9b767",
                                "sense_id": "eb3e55ed-2e2d-31f8-b3ab-289d408c09cf",
                                "text": "Hebbel kommt und geht."
                            },
                            {
                                "example_id": "7fc41a17-1494-4e4e-bd97-dc450fbc28c9",
                                "sense_id": "eb3e55ed-2e2d-31f8-b3ab-289d408c09cf",
                                "text": "Hebbels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
