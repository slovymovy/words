                    {
                        "sense_id": "20f46ff0-9479-333e-958a-a9c861de3172",
                        "entry_id": "663a0098-8900-31c5-be19-e54189076b5c",
                        "glosses": [
                            "Danse classique du nord de l’Inde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3622e0c3-289f-42bb-b741-e08fa4d76c07",
                                "sense_id": "20f46ff0-9479-333e-958a-a9c861de3172",
                                "text": "La danse kathak est la plus importante de l’Inde du Nord et remonte à l’époque des troubadours nomades, conteurs d’histoires. Le mot Kathak dérive du mot « Katha », l’art de raconter une histoire. L’expression « Katha Kahe so Kathak » signifie que quiconque raconte une histoire, en dansant et chantant est un Kathak."
                            },
                            {
                                "example_id": "3b2c842d-0adf-4d11-b85a-38ed693aee90",
                                "sense_id": "20f46ff0-9479-333e-958a-a9c861de3172",
                                "text": "Découvrez la danse traditionnelle, Kathak, ainsi qu’une multitude d’informations ayant trait aux danses folkloriques à travers le monde."
                            }
                        ]
                    }
