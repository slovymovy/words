                        "tags": [],
                        "examples": [
                            {
                                "example_id": "783e4a43-be5f-4dcf-9c09-66e96f627e84",
                                "sense_id": "7df3514b-a00e-318e-9bf1-ac0265e8c63f",
                                "text": "„Im achtzehnten Jahrhundert waren hauptsächlich Rotfüchse (Vulpes vulpes) Träger des Virus. In die Neue Welt gelangte es, als diese Tiere von britischen Auswanderern für Fuchsjagden importiert wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
