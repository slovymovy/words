                        "glosses": [
                            "Characteristic of or relating to a salutation or greeting."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "861c86b0-8501-4a35-8a71-4be52852138c",
                                "sense_id": "6b62146b-95c7-3a1e-832e-255bea9b2566",
                                "text": "a salutatory oration"
