    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e0bb2eef-cefd-3c6d-b586-23e385f663d0",
                    "sense_definition": "Qui exprime ou reflète une joie vive, un profond bonheur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bonheur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle affichait un sourire <w>radieux</w> en apprenant sa réussite à l'examen.",
                            "target_lang_translations": {
                                "en": "She wore a <w>radiant</w> smile when she learned she had passed her exam.",
                                "ru": "Узнав о своём успехе на экзамене, она расплылась в <w>сияющей</w> улыбке.",
                                "de": "Als sie erfuhr, dass sie die Prüfung bestanden hatte, zeigte sie ein <w>strahlendes</w> Lächeln.",
                                "es": "Ella lucía una sonrisa <w>radiante</w> al enterarse de que había aprobado el examen.",
                                "zh": "她得知自己考试通过的消息时，脸上挂着<w>灿烂</w>的笑容。"
                            }
                        },
                        {
                            "text": "Le jeune marié était tout <w>radieux</w> en accueillant ses proches.",
                            "target_lang_translations": {
                                "en": "The young groom was <w>radiant</w> as he welcomed his relatives.",
                                "ru": "Молодожён был весь <w>сияющий</w>, встречая близких.",
                                "de": "Der junge Bräutigam war ganz <w>strahlend</w>, als er seine Verwandten empfing.",
                                "es": "El joven novio estaba <w>radiante</w> de felicidad al recibir a sus allegados.",
                                "zh": "这位年轻的新郎迎接亲友时，整个人<w>容光焕发</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rayonnant"
                    ],
                    "antonyms": [
                        "morose",
                        "sombre",
                        "abattu"
                    ],
                    "common_phrases": [
                        "visage radieux",
                        "sourire radieux"
                    ],
                    "target_lang_definitions": {
                        "en": "Expressing or radiating intense joy or deep happiness.",
                        "ru": "Выражающий сильную радость и глубокое счастье.",
                        "de": "Ausdruck großer Freude und tiefen Glücks.",
                        "es": "Que expresa una alegría intensa o una felicidad profunda.",
                        "zh": "表达或流露出强烈的喜悦和深切的幸福。"
                    },
                    "translations": {
