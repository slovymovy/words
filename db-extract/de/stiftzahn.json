                    {
                        "sense_id": "2b625931-b88b-3974-954f-fad3f7c9881d",
                        "entry_id": "499a4844-6328-3167-be96-f6120f261f5f",
                        "glosses": [
                            "künstliche Zahnkrone, die meist mit einem Metallstift in der Zahnwurzel befestigt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c44813ee-86e8-4d47-b58c-07c5ddd92697",
                                "sense_id": "2b625931-b88b-3974-954f-fad3f7c9881d",
                                "text": "„Selbst kariöse Wurzeln soll man nicht ohne weiteres extrahieren, sondern zuvor den Zahnarzt zu Rate ziehen, ob die Wurzel nicht noch zu einem Stiftzahne oder dergleichen tauglich ist.“"
                            },
                            {
                                "example_id": "262d3c68-b3eb-4e18-9ca2-da35bcde13b4",
                                "sense_id": "2b625931-b88b-3974-954f-fad3f7c9881d",
                                "text": "„Er verschluckt seinen Stiftzahn, hält endlich das Maul und beschränkt sich aufs Röcheln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
