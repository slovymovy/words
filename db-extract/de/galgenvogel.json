                "senses": [
                    {
                        "sense_id": "42fb4202-ac25-3c4d-ad11-da3867c04c4c",
                        "entry_id": "a1402e2d-b8d4-32a5-9a9a-b13929c573b5",
                        "glosses": [
                            "jemand, der zu nichts taugt"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "44fa8266-c141-4c8c-bee7-a56ef50a6e4d",
                                "sense_id": "42fb4202-ac25-3c4d-ad11-da3867c04c4c",
                                "text": "Ach, geh und hol doch mal endlich die Holzscheitel, du Galgenvogel!"
                            },
                            {
                                "example_id": "33b0561d-b356-4e0f-825a-6469550efacb",
                                "sense_id": "42fb4202-ac25-3c4d-ad11-da3867c04c4c",
                                "text": "„Zwei Tage später um elf Uhr erblickte ich, als ich gerade meinen Wagen besteigen wollte, einen Galgenvogel, der mir ein Papier überreichte und mich aufforderte, es zu lesen.“"
                            },
                            {
                                "example_id": "ef375d06-ec2d-4aff-b1c5-2649b452e7df",
                                "sense_id": "42fb4202-ac25-3c4d-ad11-da3867c04c4c",
                                "text": "„Wie viel der Gast auch auf dem Herzen gehabt, und welch harte Rede er auch unterwegs vorbereitet, um Jón Marteinsson mores zu lehren – es erging ihm nun wie so oftmals vorher: dieser Galgenvogel überrumpelte ihn gänzlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
