                        "glosses": [
                            "ходящий в упряжи, носящий ярмо (о тягловом, рабочем скоте)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22c53e88-6f78-45b3-9635-fa01aaf0fe60",
                                "sense_id": "b1509255-995f-370d-81c6-f0b8cf3fb750",
                                "text": "А для низкой жизни были числа, // Как домашний, подъяремный скот, // Потому что все оттенки смысла // Умное число передает."
                            }
                        ]
