                ],
                "senses": [
                    {
                        "sense_id": "4696809c-07f0-3665-bdf1-d53297f090eb",
                        "entry_id": "a244c803-9867-3892-8094-269ff826e7ad",
                        "glosses": [
                            "женское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a311408a-007c-4188-b459-d897c3ab2115",
                                "sense_id": "4696809c-07f0-3665-bdf1-d53297f090eb",
                                "text": "Юрий Владимирович Андропов писал юной американке Саманте Смитт: «Мы хотим мира ― нам есть чем заняться: выращивать хлеб, строить и изобретать, писать книги и летать в космос»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e8d3165-72d5-409b-bc78-1279d5010fa7",
                        "source_entry_id": "a244c803-9867-3892-8094-269ff826e7ad",
                        "source_sense_id": "4696809c-07f0-3665-bdf1-d53297f090eb",
                        "target_lang_word": "Samantha",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Samantha",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84a37bfd-7aca-3c36-9e7a-b5ac88691589",
                                        "entry_id": "23c41dae-42be-3ddd-92e1-25895b2de8e7",
                                        "glosses": [
                                            "A female given name from Hebrew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bb9ac7f-0f1b-4b13-a8d6-033e97f1c0e5",
                                                "sense_id": "84a37bfd-7aca-3c36-9e7a-b5ac88691589",
                                                "text": "These country girls, as they were called, had queer names, which added to the singularity of their appearance. Samantha, Triphena, Plumy, Leafy, Ruhamah, Lovey, and Florilla were among them."
                                            },
                                            {
                                                "example_id": "2474104e-1184-4298-8ebf-97a5e961be91",
                                                "sense_id": "84a37bfd-7aca-3c36-9e7a-b5ac88691589",
                                                "text": "\"Its name is Samantha Jo, after Josiah and me. - - - If it had been a boy, we was layin' out to call it Josiah Sam, - Sam for Samantha.\""
                                            },
                                            {
                                                "example_id": "2d9537e6-6063-4d25-958e-32327dfb502b",
                                                "sense_id": "84a37bfd-7aca-3c36-9e7a-b5ac88691589",
                                                "text": "\"Middle of the depression - who's going to give a kid a nutty name like Samantha? Today's another matter, but around then, from what I hear, people weren't thinking about these stylish names.\""
                                            },
                                            {
                                                "example_id": "c01a6ec6-3fc9-4876-b6a5-90bbd8737056",
                                                "sense_id": "84a37bfd-7aca-3c36-9e7a-b5ac88691589",
                                                "text": "But here's my favorite name: Samuel. It's from the Bible. If it's a girl, name it Samantha. That sounds like something in a prayer, doesn't it? I think it's a name in the Chronicles. I've been reading the Bible every night.\" - - -\nShe found the Book of Chronicles and scanned it. - - - There was no Samantha in either the first or the second book of the Chronicles."
                                            },
                                            {
                                                "example_id": "231e03e3-4d02-48db-8e99-f94ab2458fa4",
                                                "sense_id": "84a37bfd-7aca-3c36-9e7a-b5ac88691589",
                                                "text": "Although US officials have been sounding the alarm about the imminent risk of famine in the war-torn strip, USAID Administrator Samantha Power is the first official to publicly agree with an assessment that famine is already taking place."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
