                "senses": [
                    {
                        "sense_id": "48d7d5c9-9dfc-3a7e-9e74-7fa77ed552a5",
                        "entry_id": "8b198c7e-2c26-3b1b-a45e-1acaf58c3293",
                        "glosses": [
                            "Relatif au télégraphe."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d482e406-29b8-4086-9cb0-29069645418e",
                                "sense_id": "48d7d5c9-9dfc-3a7e-9e74-7fa77ed552a5",
                                "text": "Marthe, en quittant Paris, avait envoyé une dépêche télégraphique à Château-Pignon pour que la calèche vînt les attendre à l’hôtel des allées de Tourny."
                            },
                            {
                                "example_id": "3c3addde-b53f-4314-90bb-d4d6ac384a74",
                                "sense_id": "48d7d5c9-9dfc-3a7e-9e74-7fa77ed552a5",
                                "text": "L’arrivée du steamer est une fête pour les marchands danois exilés dans cette localité, qu'aucun fil télégraphique ne relie au reste du monde ; […]."
                            },
                            {
                                "example_id": "abe730b1-852c-4922-8c50-a14a8a91bc2e",
                                "sense_id": "48d7d5c9-9dfc-3a7e-9e74-7fa77ed552a5",
                                "text": "Un fil télégraphique reliait les travaux avec Mikhaïlov, d’où partaient sur un petit chemin de fer Decauville, les trains qui apportaient les rails et les traverses."
                            },
                            {
                                "example_id": "26a49fdc-b9fa-487c-b49d-bcde7e58a928",
                                "sense_id": "48d7d5c9-9dfc-3a7e-9e74-7fa77ed552a5",
                                "text": "Mais, cinq cents mètres après, nous nous dirigeons tous les trois vers un poteau télégraphique ; […]."
                            }
                        ]
                    }
                ],
