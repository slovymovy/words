                        "glosses": [
                            "Plat traditionnel labourdin au Pays basque à base d’épaule de veau, de poivron, d’oignon et de piment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4e289b7-e906-4b72-8e8c-5385e9bf94d7",
                                "sense_id": "8cd1ffa2-97a7-39a1-8901-64e1a7054e75",
                                "text": "Axoa, marmitako, pipérade, poulet et boudin basque, ilargoria (les fameux haricots rouges), sans oublier les grands classiques, foies gras, pâté aux cèpes comme toutes les dernières nouveautés de l’année… — (Dominique Auzias, Jean-Paul Labourdette, Bayonne 2012, éditeur Petit Futé, 2012)"
                            },
                            {
                                "example_id": "47b4b037-744d-4b4a-9c6e-49d9e61f39c9",
                                "sense_id": "8cd1ffa2-97a7-39a1-8901-64e1a7054e75",
                                "text": "Le axoa était fumant dans leur assiette quand Pantxika arriva vers trois heures, avec presque une heure de retard."
                            }
                        ]
                    }
