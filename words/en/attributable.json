    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b3c70413-012f-3040-ad1b-3b49efb1f711",
                    "sense_definition": "Caused by or resulting from a specified thing; capable of being considered as belonging to or produced by someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Much of the company's recent success is directly <w>attributable</w> to effective marketing."
                        },
                        {
                            "text": "His sudden lack of energy was largely <w>attributable</w> to a poor diet."
                        }
                    ],
                    "synonyms": [
                        "ascribable",
                        "imputable"
                    ],
                    "antonyms": [
                        "unattributable"
                    ],
                    "common_phrases": [
                        "attributable to",
                        "directly attributable",
                        "partly attributable",
                        "largely attributable"
                    ]
                },
                {
                    "sense_id": "abae0e90-46a4-390d-8558-bd725910c909",
                    "sense_definition": "Permitted or authorized to be credited to an identified author, source, or cause.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government briefing was on background and therefore not <w>attributable</w> to any official."
                        },
                        {
                            "text": "Journalists confirmed that the damaging quotes were fully <w>attributable</w> to the senator."
                        }
                    ],
                    "common_phrases": [
                        "directly attributable",
                        "not attributable"
                    ]
                }
            ]
        }
    ]
