                        "form_id": "e5668926-f3ed-4f55-97c2-9d7f79f5bd15",
                        "entry_id": "9f6bd5f8-96b7-3459-844b-e38dacf320f1",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more fundamentally"
                    },
                    {
                        "form_id": "2a8ce6c3-00f1-48cd-8c3e-c7bc1d0ce57f",
                        "entry_id": "9f6bd5f8-96b7-3459-844b-e38dacf320f1",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most fundamentally"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a2fe6fef-f264-3f8c-b204-8f8b7e7da40f",
                        "entry_id": "9f6bd5f8-96b7-3459-844b-e38dacf320f1",
                        "glosses": [
                            "In a fundamental or basic sense; reaching the very core of the matter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cbdf82b-99a9-4474-b994-9226982df6dd",
                                "sense_id": "a2fe6fef-f264-3f8c-b204-8f8b7e7da40f",
                                "text": "What the science shows, he says, is that the brain of an addict is fundamentally different from that of a nonaddict."
                            },
                            {
                                "example_id": "377ef536-eba7-4172-9fa4-52ed5513064e",
                                "sense_id": "a2fe6fef-f264-3f8c-b204-8f8b7e7da40f",
                                "text": "Hanks is known as being an avid reader of history and biography, and seems to seek out stories which offer a certain optimism and humanism. In other words, he plays – fundamentally – good people."
                            },
                            {
                                "example_id": "c71c1d3a-1d48-4430-8180-451f73977169",
                                "sense_id": "a2fe6fef-f264-3f8c-b204-8f8b7e7da40f",
                                "text": "On Tuesday, a proposal to fundamentally restructure the Minneapolis police department in the wake of George Floyd’s death in 2020 was soundly defeated, a setback that even many Democrats acknowledged could be laid at the feet of the “defund the police” movement that some within the party embraced last summer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9152317f-b2d7-451b-b27f-2d9bca119a1a",
                        "source_entry_id": "9f6bd5f8-96b7-3459-844b-e38dacf320f1",
                        "source_sense_id": "a2fe6fef-f264-3f8c-b204-8f8b7e7da40f",
                        "source_sense_description": "to the very core of the matter",
                        "target_lang_word": "fondamentalement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fondamentalement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b905a585-3fa1-39bb-9522-4c43c1f1cd80",
                                        "entry_id": "a164d738-5864-3a56-9bb4-d23c03818aa2",
                                        "glosses": [
                                            "Sur de bons fondements, sur de bons principes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cffd33f-4b77-4ff1-8f49-1daa09ca9150",
                                                "sense_id": "b905a585-3fa1-39bb-9522-4c43c1f1cd80",
                                                "text": "Une maxime fondamentalement établie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efb6676c-bc91-3034-b9a9-a22c9366b3c1",
                                        "entry_id": "a164d738-5864-3a56-9bb4-d23c03818aa2",
                                        "glosses": [
                                            "Au fond, essentiellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "700fc64d-1a08-4823-8a25-be575295c8d7",
                                                "sense_id": "efb6676c-bc91-3034-b9a9-a22c9366b3c1",
                                                "text": "L'établissement du prix des choses dépend fondamentalement de la raison du total des choses au total des signes."
                                            },
                                            {
                                                "example_id": "b891e2b2-367d-4820-b68b-157d859033c6",
                                                "sense_id": "efb6676c-bc91-3034-b9a9-a22c9366b3c1",
                                                "text": "Mais plus fondamentalement, nous devons chercher les raisons de ce déficit d'opposition, dans notre trop grande acceptation du modèle dominant, …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41d5c9dd-dcce-3cdd-89a8-8f8ce088ab70",
                                        "entry_id": "a164d738-5864-3a56-9bb4-d23c03818aa2",
                                        "glosses": [
                                            "Totalement, complètement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe7c17ea-288a-4c5b-a27b-97c9aaa5ac92",
                                                "sense_id": "41d5c9dd-dcce-3cdd-89a8-8f8ce088ab70",
                                                "text": "Provoquer une réforme qui modifie fondamentalement le système religieux."
                                            },
                                            {
                                                "example_id": "4700578a-6a5b-4079-9e06-4b8b3c1a35ea",
                                                "sense_id": "41d5c9dd-dcce-3cdd-89a8-8f8ce088ab70",
                                                "text": "La caractéristique de quelques Marseillais de mes amis, c'est d'être, à ce sujet, fondamentalement optimistes. La dépopulation ? Ils la déplorent pour les pays circonvoisins, pour les Basses-Alpes, pour le Var."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ff5e4e7-9191-4d98-b6cd-9244b33b7ce6",
                        "source_entry_id": "9f6bd5f8-96b7-3459-844b-e38dacf320f1",
                        "source_sense_id": "a2fe6fef-f264-3f8c-b204-8f8b7e7da40f",
                        "source_sense_description": "to the very core of the matter",
                        "target_lang_word": "foncièrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foncièrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54de0c33-213b-3df8-a9b1-8e712fa13c90",
                                        "entry_id": "f7a04f7b-4a34-31a3-a3a9-b50030916991",
                                        "glosses": [
                                            "À fond."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7933f447-7aae-4145-8c50-a22e18e98ca0",
                                                "sense_id": "54de0c33-213b-3df8-a9b1-8e712fa13c90",
                                                "text": "Il sait foncièrement cette affaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bdecf04-fdc1-35df-92a9-846f2bdf475d",
                                        "entry_id": "f7a04f7b-4a34-31a3-a3a9-b50030916991",
                                        "glosses": [
                                            "Dans le fond."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f55b0bc5-c95a-4338-94b4-69fb73857c10",
                                                "sense_id": "2bdecf04-fdc1-35df-92a9-846f2bdf475d",
                                                "text": "Tout cela n’empêche pas, mon ami, qu’il n’y ait sur cette terre de fort braves gens, des gens foncièrement honnêtes, organiquement bons."
                                            },
                                            {
                                                "example_id": "49187289-0f3c-44ab-910c-b5a694e4db46",
                                                "sense_id": "2bdecf04-fdc1-35df-92a9-846f2bdf475d",
                                                "text": "Albergotti était un homme très dangereux et foncièrement malhonnête homme."
                                            },
                                            {
                                                "example_id": "5e9c3472-50a0-48af-9462-6441141f77e3",
                                                "sense_id": "2bdecf04-fdc1-35df-92a9-846f2bdf475d",
                                                "text": "Le propre de la culture antique est sa tournure foncièrement laïque."
                                            },
                                            {
                                                "example_id": "85fee43d-0b56-488e-89a9-f93b460a5442",
                                                "sense_id": "2bdecf04-fdc1-35df-92a9-846f2bdf475d",
                                                "text": "Je ne suis pas un homme foncièrement bon, mais je crois en la salvation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
