                                        "glosses": [
                                            "A reddish mark left on the bat by the impact of the ball."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a00f75d-8535-36df-8161-d0197975f759",
                                        "entry_id": "8d11eed5-6278-39f2-8b54-1867403da165",
                                        "glosses": [
                                            "A round, red light of the kind that is typically mounted on top of a police car."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c01ca1d4-6e6c-4a6d-b6fe-2bc6bb44df24",
                                                "sense_id": "7a00f75d-8535-36df-8161-d0197975f759",
                                                "text": "\"What do you think?\" he asked as he wove through traffic, matching Sanford's speed but without the benefit of a flashing cherry on the roof of his car."
                                            },
                                            {
                                                "example_id": "cf0ffaff-c389-43f5-8580-7d4c12c1f031",
                                                "sense_id": "7a00f75d-8535-36df-8161-d0197975f759",
                                                "text": "“This is a cartel operation,” Hackett said as Larson activated the dash-mounted cherry"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17fbdfff-3aa3-3e30-a664-b9f75f0c06b1",
                                        "entry_id": "8d11eed5-6278-39f2-8b54-1867403da165",
                                        "glosses": [
                                            "The burning tip of a cigarette."
                                        ],
                                        "tags": [],
