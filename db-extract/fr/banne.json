                    }
                ],
                "senses": [
                    {
                        "sense_id": "095d8e41-d31c-3579-bafb-0099cecca0ea",
                        "entry_id": "9c71c9a7-4600-3963-830a-b872c32e23ff",
                        "glosses": [
                            "Voiture en tombereau, à fond mobile."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c7b84ed1-2127-36f6-9726-5b34ede45bc1",
                        "entry_id": "9c71c9a7-4600-3963-830a-b872c32e23ff",
                        "glosses": [
                            "Petit chariot servant à transporter du charbon."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b3e33d69-8255-310a-92d5-52eeacb06461",
                        "entry_id": "9c71c9a7-4600-3963-830a-b872c32e23ff",
                        "glosses": [
                            "Grande manne faite communément de branches d’osier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3f2d8e9-c9d5-466f-a77c-a7fe45957966",
                                "sense_id": "b3e33d69-8255-310a-92d5-52eeacb06461",
                                "text": "Elle voit un copeau sur l’eau :\nvite l’écope dans sa banne\net l’emporte dans sa bannette\nà perdre haleine en son logis ;"
                            }
                        ]
                    },
                    {
                        "sense_id": "63dec14b-94af-3d74-b7b2-ef23f780c463",
                        "entry_id": "9c71c9a7-4600-3963-830a-b872c32e23ff",
                        "glosses": [
                            "Berceau d'enfant."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "c30b816b-606e-4b55-b655-4512edc41844",
                                "sense_id": "63dec14b-94af-3d74-b7b2-ef23f780c463",
                                "text": "Le berceau que l'on appelait banne à Belleville-sur-Bar, par exemple, pouvait avoir une capote d'où partaient des rideaux en cretonne fleurie longs et larges, qui entouraient et fermaient la banne, mettant ainsi le petit dormeur à l’abri …"
                            }
                        ]
                    },
                    {
                        "sense_id": "798f68dc-1e0c-355d-bd65-55b3fd1712b9",
                        "entry_id": "9c71c9a7-4600-3963-830a-b872c32e23ff",
                        "glosses": [
                            "Terme de charbonnier, Grande manne faite de branchages entrelacés dans laquelle on transporte le charbon (définition de M. Dupin dans le code du commerce du bois et du charbon édité à Paris chez Guillaume en 1817)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fd6f229a-2c23-3ddc-b877-69b863db33e8",
                        "entry_id": "9c71c9a7-4600-3963-830a-b872c32e23ff",
                        "glosses": [
                            "Grosse toile servant à couvrir les marchandises qui sont dans les bateaux, sur les charrettes de rouliers, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d79bdfb3-2487-4612-8d4d-b45ae25a7164",
                                "sense_id": "fd6f229a-2c23-3ddc-b877-69b863db33e8",
                                "text": "Mettre, étendre une banne sur des sacs de blé, sur un bateau."
                            },
                            {
                                "example_id": "c51d2cb4-5927-4c1c-bc36-f8c0e2e5fe0b",
                                "sense_id": "fd6f229a-2c23-3ddc-b877-69b863db33e8",
                                "text": "… les femmes s’étaient blotties au fond, sous la banne."
                            }
                        ]
                    },
                    {
                        "sense_id": "daecb87b-57b5-390a-bcf1-72bd3af4244f",
                        "entry_id": "9c71c9a7-4600-3963-830a-b872c32e23ff",
                        "glosses": [
                            "Grosse toile tendue sur un bateau pour se protéger du soleil ou de la pluie."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "04f421d9-f0de-327d-813c-d7b1adc9f743",
                        "entry_id": "9c71c9a7-4600-3963-830a-b872c32e23ff",
                        "glosses": [
                            "Store de grosse toile tendue au-devant d’une boutique pour protéger les vitrines et la marchandise exposée du soleil et de la pluie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16fc827a-0e2a-43e5-803b-c99ec4b75298",
                                "sense_id": "04f421d9-f0de-327d-813c-d7b1adc9f743",
                                "text": "Les bannes, par lesquelles les marchands de Paris et de quelques cités opulentes protègent leurs boutiques contre les ardeurs du soleil, sont un luxe inconnu dans Soulanges."
                            }
                        ]
                    },
                    {
                        "sense_id": "c07ae00e-8936-3f1b-8e10-010cbfd55e95",
                        "entry_id": "9c71c9a7-4600-3963-830a-b872c32e23ff",
                        "glosses": [
                            "Plus généralement un store de toile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2608c954-57c2-4d83-8ab1-3daff32f9828",
                                "sense_id": "c07ae00e-8936-3f1b-8e10-010cbfd55e95",
                                "text": "Les cinq fenêtres laissaient passer à travers le fin tissu des bannes un jour tamisé et déjà adouci par les pénombres de la vérandah."
                            },
                            {
                                "example_id": "b76da5f5-7c38-4305-8689-b2e8dcbaeed5",
                                "sense_id": "c07ae00e-8936-3f1b-8e10-010cbfd55e95",
                                "text": "La maison était fort petite, à toit plat, couverte de tuiles arrondies ; ses fenêtres sans persiennes se défendaient du soleil par de grandes bannes de toile blanche."
                            }
                        ]
                    },
                    {
                        "sense_id": "0eb225c8-b857-3400-bc43-be6d36d65443",
                        "entry_id": "9c71c9a7-4600-3963-830a-b872c32e23ff",
                        "glosses": [
                            "Montagne à sommet abrupt."
                        ],
                        "tags": [
                            "Auvergne"
                        ],
                        "examples": [
                            {
                                "example_id": "0e9f6d56-4721-45b0-905d-45bde34cb010",
                                "sense_id": "0eb225c8-b857-3400-bc43-be6d36d65443",
                                "text": "La Banne d’Ordanche."
                            }
                        ]
                    }
                ],
