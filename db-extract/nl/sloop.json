                "forms": [],
                "senses": [
                    {
                        "sense_id": "9648cae0-9d1d-31d8-84b3-3f7ca816676d",
                        "entry_id": "f94bfbdb-a089-37df-8241-317e05594bda",
                        "glosses": [
