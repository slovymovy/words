                    }
                ],
                "senses": [
                    {
                        "sense_id": "ca4c261f-6154-3285-89e6-60140683aefe",
                        "entry_id": "fd8bb67c-2135-3aca-a55d-d27d7cfd5729",
                        "glosses": [
                            "Lokal im britischen oder irischen Stil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b547c05d-f738-4678-8224-2bf186c91fdb",
                                "sense_id": "ca4c261f-6154-3285-89e6-60140683aefe",
                                "text": "Sie verbrachten viele Abende im Pub auf der anderen Straßenseite."
                            },
                            {
                                "example_id": "ac152bed-6541-442c-bc4f-7941b7c90212",
                                "sense_id": "ca4c261f-6154-3285-89e6-60140683aefe",
                                "text": "„Im Pub gab es keine Uhr.“"
                            },
                            {
                                "example_id": "4c0aae1d-c258-405d-b93a-9a6e12ffb907",
                                "sense_id": "ca4c261f-6154-3285-89e6-60140683aefe",
                                "text": "„Jasmina hieß sie. Eine junge Sámin, Studentin, und arbeitete hier im Pub des Hotels in den Sommermonaten.“"
                            },
                            {
                                "example_id": "47a2a429-478e-4e5e-b13c-b42cf62bd253",
                                "sense_id": "ca4c261f-6154-3285-89e6-60140683aefe",
                                "text": "„Er stand da und überlegte. Der Pub, dachte er. Du liebe Güte, der Pub. Vage erinnerte er sich, wahnsinnig wütend gewesen zu sein, wütend über irgendwas, das wohl wichtig war.“"
                            },
                            {
                                "example_id": "b1c3f8ac-5f5f-4a51-bed7-0ef575413992",
                                "sense_id": "ca4c261f-6154-3285-89e6-60140683aefe",
                                "text": "„Wir gingen zurück nach Wapping und aßen in einem Pub am Flussufer namens Prospect of Whitby zu Mittag."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d2e538d-7917-4368-8ee3-86e1758afbb8",
                        "source_entry_id": "fd8bb67c-2135-3aca-a55d-d27d7cfd5729",
                        "source_sense_id": "ca4c261f-6154-3285-89e6-60140683aefe",
                        "source_sense_description": "Lokal im britischen oder irischen Stil",
                        "target_lang_word": "pub",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pub",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8b64f84-d11c-3278-ba5b-6eda0d7c42f9",
                                        "entry_id": "f3db592d-2715-3373-b507-22e0134cd64f",
                                        "glosses": [
                                            "A public house where beverages, primarily alcoholic, may be bought and consumed, also providing food and sometimes entertainment such as live music or television."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21f1e3f5-88af-4b93-a202-39ca34dba23e",
                                                "sense_id": "f8b64f84-d11c-3278-ba5b-6eda0d7c42f9",
                                                "text": "Reg liked a chat about old times and we used to go and have a chinwag in the pub."
                                            },
                                            {
                                                "example_id": "ea9c6900-7225-4c26-895a-046f3b36bdec",
                                                "sense_id": "f8b64f84-d11c-3278-ba5b-6eda0d7c42f9",
                                                "text": "From the ground, Colombo’s port does not look like much. Those entering it are greeted by wire fences, walls dating back to colonial times and security posts. For mariners leaving the port after lonely nights on the high seas, the delights of the B52 Night Club and Stallion Pub lie a stumble away."
                                            }
