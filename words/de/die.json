                            "target_lang_translations": {
                                "en": "Today <w>the</w> sun is shining in the sky all day."
                            }
                        },
                        {
                            "text": "Ich habe <w>die</w> neue Zeitung schon heute Morgen gelesen.",
                            "target_lang_translations": {
                                "en": "I already read <w>the</w> new newspaper this morning."
                            }
                        }
                    ],
                    "common_phrases": [
                        "die ganze Zeit",
                        "die meiste Zeit"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Nominativ und Akkusativ Singular Femininum"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Definite article for feminine nouns in the nominative and accusative singular."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "the",
                                "target_lang_sense_clarification": "feminine singular"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de32183b-1bdd-376c-bbcc-3666b68b3816",
                    "sense_definition": "Bestimmter Artikel für Substantive im Nominativ und Akkusativ Plural aller Genera von <w>der</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "bestimmter_artikel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In den Ferien spielen <w>die</w> Kinder draußen im Garten.",
                            "target_lang_translations": {
                                "en": "During the holidays, <w>the</w> children play outside in the garden."
                            }
                        },
                        {
                            "text": "Wir haben gestern Abend <w>die</w> leckeren Äpfel gegessen.",
                            "target_lang_translations": {
                                "en": "We ate <w>the</w> delicious apples yesterday evening."
                            }
                        }
                    ],
                    "common_phrases": [
                        "die meisten Menschen",
                        "die vielen Leute"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Nominativ und Akkusativ Plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Definite article for plural nouns in the nominative and accusative across all genders."
                    },
                    "translations": {
