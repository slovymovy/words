                ],
                "senses": [
                    {
                        "sense_id": "8f002629-e310-35b7-b4cf-16bf9b7a5d90",
                        "entry_id": "04718dd7-50d9-3885-94d2-868ccf3dae10",
                        "glosses": [
                            "Person, die keine Impfung erhalten hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fa7f96a-ddb3-49c1-8b93-67f3355d3fdc",
                                "sense_id": "8f002629-e310-35b7-b4cf-16bf9b7a5d90",
                                "text": "[Coronapandemie 2021:] „Das ist jetzt eine Pandemie der Ungeimpften.“"
                            },
                            {
                                "example_id": "41bbdbc9-31fe-4425-9bb9-67c616b596dd",
                                "sense_id": "8f002629-e310-35b7-b4cf-16bf9b7a5d90",
                                "text": "„Vor allem Ungeimpfte erkranken schwer und sterben an den Folgen von Covid-19.“"
                            },
                            {
                                "example_id": "f833b3d2-b717-456c-b07a-5c830469c309",
                                "sense_id": "8f002629-e310-35b7-b4cf-16bf9b7a5d90",
                                "text": "[Schlagzeile:] „Dürfen Ungeimpfte bald nicht mehr ins Stadion?“"
                            },
                            {
                                "example_id": "1f27b663-e2b7-4b59-b635-6da623efce59",
                                "sense_id": "8f002629-e310-35b7-b4cf-16bf9b7a5d90",
                                "text": "[Coronapandemie 2021:] „»Bei hohem Infektionsgeschehen trotz Testkonzepten würden Ungeimpfte ihre Kontakte reduzieren müssen«, meint Kanzleramtschef Helge Braun.“"
                            },
                            {
                                "example_id": "659afbfc-8f0e-455c-8f2e-ad1eccb7db5f",
                                "sense_id": "8f002629-e310-35b7-b4cf-16bf9b7a5d90",
                                "text": "„Im Stadtstaat Hamburg wird nun erstmals die 7-Tage-Inzidenz nach Geimpften und Ungeimpften aufgeschlüsselt, was eine sehr viel höhere Inzidenz unter Ungeimpften zutage förderte.“"
                            },
                            {
                                "example_id": "f85a14a2-b034-4092-a6af-213afdee6986",
                                "sense_id": "8f002629-e310-35b7-b4cf-16bf9b7a5d90",
                                "text": "„Seit dem 31. August weist das LAGuS die Inzidenz auch gesondert bei Geimpften und Ungeimpften aus. Bei Geimpften liegt sie bei 7,1 (+-0), bei Ungeimpften bei 72,5 (+2,1).“"
                            },
                            {
                                "example_id": "19458341-f8d0-4133-9bf2-3f08f193bde3",
                                "sense_id": "8f002629-e310-35b7-b4cf-16bf9b7a5d90",
                                "text": "[Irland:] „»Die Leute registrieren sich fürs Impfen«, sagt Ger McCormack. »In den Medien ist zu sehen, dass die meisten Patienten in den Krankenhäusern Ungeimpfte sind. Das hat einen Effekt auf die Menschen.«“"
                            },
                            {
                                "example_id": "e77769ef-1783-4e36-958e-5c97aae3e32b",
                                "sense_id": "8f002629-e310-35b7-b4cf-16bf9b7a5d90",
                                "text": "„Während in Berlin diskutiert wird, überlegen einige Unternehmen schon, ob sie Geimpfte und Ungeimpfte auf unterschiedliche Zimmer verteilen.“"
                            },
                            {
                                "example_id": "1456c43e-bb17-4fc9-a156-2b5e17fba912",
                                "sense_id": "8f002629-e310-35b7-b4cf-16bf9b7a5d90",
                                "text": "„In Neuseeland müssen Beschäftigte eine solche Abfrage [Anmerkung: zum Impfstatus] nicht beantworten; gegebenenfalls werden Auskunftsverweigerer mit Ungeimpften gleichgestellt und dürfen nicht alle Tätigkeiten ausüben.“"
                            },
                            {
                                "example_id": "f6eb1751-fd9e-4d69-a552-66c5d92bf728",
                                "sense_id": "8f002629-e310-35b7-b4cf-16bf9b7a5d90",
                                "text": "„Ab dem 24. August gelten die griechische Urlaubsinsel Kreta und die südliche Ägäis als Corona-Hochrisikogebiete. Damit verbunden sind schärfere Corona-Regeln bei der Rückkehr nach Deutschland, insbesondere für Ungeimpfte.“"
                            },
                            {
                                "example_id": "c7de8d6c-85cb-4115-8e9f-e4b64aef23c2",
                                "sense_id": "8f002629-e310-35b7-b4cf-16bf9b7a5d90",
                                "text": "[Griechenland:] „Vor wenigen Tagen hatte die Regierung zudem striktere Corona-Maßnahmen für Ungeimpfte bei Freizeitaktivitäten und am Arbeitsplatz angekündigt. Ab dem 13. September ist der Zutritt zu Lokalen, Cafés oder Sportvereinen nur für Menschen gestattet, die entweder vollständig geimpft sind oder eine überstandene Infektion nachweisen können.“"
                            },
                            {
                                "example_id": "0eadd2d2-26b0-413a-946c-b9b8561078ff",
                                "sense_id": "8f002629-e310-35b7-b4cf-16bf9b7a5d90",
                                "text": "[Coronapandemie 2021:] „»[…] wenn die Fälle wirklich steigen werden […], dann werden wir mehr unternehmen müssen bei den Ungeimpften. Im Moment ist es so, dass die Treiber der Pandemie die Ungeimpften sind. Die Ungeimpften infizieren auch bereits geimpfte, aber im Wesentlichen infizieren sich die Ungeimpften untereinander, und es ist sehr problematisch, dass eine kleine Gruppe Ungeimpfter, die sich nicht impfen lassen will, hier, sage ich einmal, die Verbreitung des Virus so beschleunigt. Bei den Ungeimpften ist die Inzidenz ja sehr viel höher als bei den Geimpften. Daher müsste das auch gesondert ausgewiesen werden. Aber wir müssen zu Regeln kommen, die bei den Ungeimpften die Pandemie entschleunigen.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
