                "senses": [
                    {
                        "sense_id": "16047ffc-4341-321b-9182-2b526e08d86f",
                        "entry_id": "9fcd250a-df63-304c-ac7a-8f78e771eddd",
                        "glosses": [
                            "het minder schadelijk maken van processen met betrekking tot de leefomgeving; het stimuleren van zaken die de leefomgeving verbeteren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d4ee7b9-35b5-45ff-bb5d-8ad914c72aa4",
                                "sense_id": "16047ffc-4341-321b-9182-2b526e08d86f",
                                "text": "Meestal was het een combinatie van wetgeving, vergroening van de belasting, financiële prikkels, voorlichting en (collectieve) vormen van betrokkenheid van burgers en bedrijven."
                            },
                            {
                                "example_id": "c02274a0-5385-4098-8b32-c3b9b90ab364",
                                "sense_id": "16047ffc-4341-321b-9182-2b526e08d86f",
                                "text": "Ten eerste: vergroening van het belastingstelsel; dit thema was erop gericht om de aanschaf van duurzamere consumptiegoederen te stimuleren."
                            }
                        ]
                    },
                    {
                        "sense_id": "4faeb2ef-850d-3ca6-98c2-980d527957a3",
                        "entry_id": "9fcd250a-df63-304c-ac7a-8f78e771eddd",
                        "glosses": [
                            "het planten van meer planten en bomen in een bepaald (stedelijk) gebied"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d6ddb83-af47-4b95-98df-4a6d21bd6bf0",
                                "sense_id": "4faeb2ef-850d-3ca6-98c2-980d527957a3",
                                "text": "Maar, zegt een woordvoerder van de GGD, \"de rat hoort nu eenmaal in de stad.\" Omdat de gemeente inzet op vergroening, komt er meer natuur, inclusief de rat. Ook groeit de stad, waardoor er meer containers met etensresten zijn, \"Rattenpopulaties floreren hierbij\", stelt de gemeente."
                            }
                        ]
                    },
