                ],
                "senses": [
                    {
                        "sense_id": "7a1b08d5-b861-3a96-9813-b04ea1cfc2b2",
                        "entry_id": "ad70ed50-47ef-3ec7-8756-cb616df3af7d",
                        "glosses": [
                            "Verhalten, bei dem bestimmte Firmen, Personen ... gezielt, oft auch unberechtigt bevorzugt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13db0071-39d0-42e9-980e-97190c62365d",
                                "sense_id": "7a1b08d5-b861-3a96-9813-b04ea1cfc2b2",
                                "text": "„Aber die Schlacht gegen das System der Vorteilsnahme und Patronage ist mühselig und langwierig.“"
                            },
                            {
                                "example_id": "0ba36fd1-e91b-4bbc-8d7e-99cab16fe1d9",
                                "sense_id": "7a1b08d5-b861-3a96-9813-b04ea1cfc2b2",
                                "text": "„Die Stars leben ihr Mitleid in aller Öffentlichkeit aus, ihre Patronage wird zu einer Aufführung, wie riesige Kleinkinder, die Geld in die ausgestreckten Hände eines Bettlers stopfen und so tun, als hörten sie den Beifall nicht.“"
                            },
                            {
                                "example_id": "1e3bce58-63be-4694-b510-0a7f9ccbf354",
                                "sense_id": "7a1b08d5-b861-3a96-9813-b04ea1cfc2b2",
                                "text": "„Ihre Angestellten, die «covenanted servants», kamen durch Patronage zu ihren Posten und wurden schlecht bezahlt, mussten aber aufgrund ihres Vertrags (covenant) eine hohe Kaution stellen, die ihr Jahresgehalt um ein Mehrfaches überstieg.“"
                            },
                            {
                                "example_id": "fc227849-71c5-4dfe-afde-cf4020789aca",
                                "sense_id": "7a1b08d5-b861-3a96-9813-b04ea1cfc2b2",
                                "text": "„In den 1980er Jahren stiegen die Sharifs dank Zia-ul-Haqs Patronage zur bestimmenden politischen Kraft im Punjab auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
