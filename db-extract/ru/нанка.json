                    }
                ],
                "senses": [
                    {
                        "sense_id": "0e9c556f-76b7-3487-b4df-a038a38cf283",
                        "entry_id": "9a9ddccf-aeed-34f3-aa0e-a87b2204dc79",
                        "glosses": [
                            "сорт грубой хлопчатобумажной ткани из толстой пряжи"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31a4a18b-eb12-4d39-a1cc-1966334dfaea",
                                "sense_id": "0e9c556f-76b7-3487-b4df-a038a38cf283",
                                "text": "На них надеты овчинные полушубки, во многих местах изодранные, зашитые серыми нитками или дратвой, с заплатами кожи, холста и синей нанки."
                            },
                            {
                                "example_id": "be06ab5b-4524-4a6e-bb73-f5a5b1805b1e",
                                "sense_id": "0e9c556f-76b7-3487-b4df-a038a38cf283",
                                "text": "Оставшись в заношенном крытом нанкой тулупчике и в валеных сапогах на худых костлявых ногах, проезжий сел на диван, прислонив к спинке свою очень большую и широкую в висках, коротко обстриженную голову и взглянул на Безухова."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c35dcd2-56fe-4c19-ba4c-65f6daba5160",
                        "source_entry_id": "9a9ddccf-aeed-34f3-aa0e-a87b2204dc79",
                        "source_sense_id": "0e9c556f-76b7-3487-b4df-a038a38cf283",
                        "target_lang_word": "nankeen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nankeen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24bbba44-d59a-3bd1-a0c8-0f6bcba0358a",
                                        "entry_id": "7242455a-5d3f-376f-bf8e-e313677ecc53",
                                        "glosses": [
                                            "A type of cotton cloth originally from Nanking in China."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3eef3baf-2351-4a3f-9c12-f066e8705250",
                                                "sense_id": "24bbba44-d59a-3bd1-a0c8-0f6bcba0358a",
                                                "text": "1885, L. and A. Maude (translators), Leo Tolstoy, \"What Men Live By\", in What Men Live By and Other Tales\nHe put on over his shirt his wife's wadded nankeen jacket, and over that he put his own cloth coat."
                                            },
                                            {
                                                "example_id": "c27ffbea-9d77-4054-a61a-31bea4ef9c1c",
                                                "sense_id": "24bbba44-d59a-3bd1-a0c8-0f6bcba0358a",
                                                "text": "c. 1910-1920, Fyodor Dostoyevsky, Thomas Seltzer (translator), A Christmas Tree and a Wedding\nShe was a poor widow, and her little boy, clad in a sorry-looking little nankeen jacket, looked thoroughly crushed and intimidated."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
