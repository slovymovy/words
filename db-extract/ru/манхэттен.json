                                "target_senses": [
                                    {
                                        "sense_id": "1ed908e4-6af2-33bf-a4b6-2f07ce71c812",
                                        "entry_id": "de20b222-88dc-36b1-8c45-a407cfe49f4c",
                                        "glosses": [
                                            "An indigenous people of North America who lived in present day New York State."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33a0c57e-18a5-32fb-8fdb-529878e1bf06",
                                        "entry_id": "de20b222-88dc-36b1-8c45-a407cfe49f4c",
                                        "glosses": [
                                            "A borough of New York City, New York, United States, mainly on Manhattan Island, coterminous with New York County; in full, Borough of Manhattan."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8612e0b0-8130-3947-b4cf-cd67bde0a2b7",
                                        "entry_id": "de20b222-88dc-36b1-8c45-a407cfe49f4c",
                                        "glosses": [
                                            "An island of New York, United States; in full, Manhattan Island."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dc6c115-893e-456a-bd78-2c5d8daa4b49",
                                                "sense_id": "8612e0b0-8130-3947-b4cf-cd67bde0a2b7",
                                                "text": "Lo, body and soul—this land, / My own Manhattan with spires, and the sparkling and hurrying tides, and the ships, / The varied and ample land, the South and the North in the light, Ohio’s shores and flashing Missouri, / And ever the far-spreading prairies cover’d with grass and corn."
                                            },
                                            {
                                                "example_id": "96466257-717c-4bb9-977e-917c4f5ba7b5",
                                                "sense_id": "8612e0b0-8130-3947-b4cf-cd67bde0a2b7",
                                                "text": "Adam Gopnik has, by many accounts, including his own, a lovely life. A longtime staff writer for the New Yorker and bestselling author, Gopnik lives in Manhattan with his wife, Martha, a film-maker, and their two children, and he moves in the kind of circles that allow him to drop casual lines into conversation such as: “As John Updike once said to me …”, although he has the nervy Jewish self-consciousness to follow that with “… if you’ll forgive the namedrop.”"
                                            }
                                        ]
                                    },
