                "senses": [
                    {
                        "sense_id": "859cf24a-b4a7-31bb-b115-21b0af589182",
                        "entry_id": "770e47ee-77af-3495-b7eb-ee0ad5cc294c",
                        "glosses": [
                            "von einem Fahrzeug oder Himmelskörper eingeschlagene Fahrt-/Flugrichtung, die auf einen Zusammenstoß mit etwas hindeutet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "757a9de3-df97-4e9f-ac01-57f837448ff5",
                                "sense_id": "859cf24a-b4a7-31bb-b115-21b0af589182",
                                "text": "„1972 brachte Watson das kleine Greenpeace-Boot \"Astral\" im Hafen von Vancouver auf Kollisionskurs mit dem französischen Hubschrauberträger \"Jeanne D'Arc\", bis der erst den Kurs änderte, dann gar stoppte.“"
                            },
                            {
                                "example_id": "a4de0e92-4b4c-4e14-8e3c-cb7e4f80694d",
                                "sense_id": "859cf24a-b4a7-31bb-b115-21b0af589182",
                                "text": "„Die Sonden auf ihrer niedrigen Umlaufbahn von mitunter nur wenigen Kilometern gerieten auf Kollisionskurs mit dem Mond.“"
                            },
                            {
                                "example_id": "e8a81826-dbbf-4ace-9ee2-4c5ff1952022",
                                "sense_id": "859cf24a-b4a7-31bb-b115-21b0af589182",
                                "text": "„Was wäre, wenn ein kosmischer Flugkörper auf Kollisionskurs mit unserem Heimatplaneten gerät?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "733c5ecc-1c76-3069-b9c9-f8814a15cb9c",
                        "entry_id": "770e47ee-77af-3495-b7eb-ee0ad5cc294c",
                        "glosses": [
                            "Haltung oder Handeln, das auf Konfrontation/Streit mit jemand anderem hinausläuft"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "ccf5c144-14b4-4ff0-8833-18d450240a36",
                                "sense_id": "733c5ecc-1c76-3069-b9c9-f8814a15cb9c",
                                "text": "„Software-Giganten wie Google und Amazon rüsten bei der Hardware auf. Sie wollen damit die Kundenbindung stärken und zudem die Kontrolle über ihre Software-Dienste und über die Einnahmen ausdehnen, die diese Dienste hervorbringen. Damit gehen sie auf direkten Kollisionskurs zu Apple.“"
                            },
                            {
                                "example_id": "8f32e6e3-667b-495f-975c-8e862c99ec82",
                                "sense_id": "733c5ecc-1c76-3069-b9c9-f8814a15cb9c",
                                "text": "„Die Arabische Liga befindet sich weiterhin auf Kollisionskurs zur syrischen Oppositionsbewegung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e25eada3-7c6f-43e1-aa81-4686fc79e5c5",
                        "source_entry_id": "770e47ee-77af-3495-b7eb-ee0ad5cc294c",
