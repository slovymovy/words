{
    "word_family": [
        "intuitif",
        "intuitivement",
        "intuitivité"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dde593d8-1f1b-34fb-8694-c1cf0880c7e8",
                    "sense_definition": "Sentiment ou pressentiment obscur qui fait deviner quelque chose sans recours au raisonnement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a décidé de suivre son <w>intuition</w> plutôt que les conseils de ses amis."
                        },
                        {
                            "text": "J'avais la désagréable <w>intuition</w> que la réunion n'allait pas bien se passer."
                        }
                    ],
                    "synonyms": [
                        "pressentiment",
                        "flair"
                    ],
                    "common_phrases": [
                        "avoir l'intuition",
                        "suivre son intuition"
                    ]
                },
                {
                    "sense_id": "4730b3cc-2142-3f0c-ada9-181ddf3e914b",
                    "sense_definition": "Faculté d'esprit permettant de comprendre immédiatement une situation ou une vérité sans analyse préalable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce détective résout les affaires complexes grâce à une remarquable <w>intuition</w> psychologique."
                        },
                        {
                            "text": "Il comprenait les formules mathématiques par simple <w>intuition</w> sans apprendre les démonstrations."
                        }
                    ],
                    "synonyms": [
                        "perspicacité",
                        "pénétration"
                    ],
                    "antonyms": [
                        "raisonnement"
                    ],
                    "common_phrases": [
                        "par intuition"
                    ]
                },
                {
                    "sense_id": "f55d34ac-4297-35e4-a031-a9b0fb59f193",
                    "sense_definition": "Connaissance directe et immédiate de la vérité ou de la réalité, sans intermédiaire conceptuel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour ce philosophe, l'<w>intuition</w> constitue un mode de connaissance supérieur au discours logique."
                        },
                        {
                            "text": "La démonstration s'appuie d'abord sur une <w>intuition</w> sensible avant d'être formalisée."
                        }
                    ],
                    "antonyms": [
                        "concept",
                        "raisonnement"
                    ]
                },
                {
                    "sense_id": "c4bccf5f-94e5-34d9-917f-4337d6032ab0",
                    "sense_definition": "Vision béatifique et immédiate de l'essence de Dieu accordée aux élus célestes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "théologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les mystiques décrivent cette expérience spirituelle comme une <w>intuition</w> de la lumière divine."
                        },
                        {
                            "text": "La doctrine affirme que l'<w>intuition</w> de Dieu comble pleinement le désir des bienheureux."
                        }
                    ],
                    "synonyms": [
                        "vision béatifique"
                    ]
                }
            ]
        }
    ]
}