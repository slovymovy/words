                    "frequency": "Low",
                    "semantic_group_id": "omission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report conveniently <w>elides</w> crucial details about how much the project will actually cost."
                        },
                        {
                            "text": "When retelling the story, he chose to <w>elide</w> any mention of his own mistakes."
                        }
                    ],
                    "synonyms": [
