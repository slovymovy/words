                "senses": [
                    {
                        "sense_id": "9989593b-d3e3-389a-945a-90918e7a2a2d",
                        "entry_id": "51d27944-651c-3b91-9e34-17114da3c16c",
                        "glosses": [
                            "S’assigner à soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faa9bb17-6965-4875-99fc-0bcba09ef591",
                                "sense_id": "9989593b-d3e3-389a-945a-90918e7a2a2d",
                                "text": "Mais comme Pierre Bernard s'était autoassigné à la mise en scène du texte de la jeune Suzie Bastien, il a passé les derniers jours et quelques nuits dans son alma mater, retardant le cruel moment où il devrait nécessairement faire son deuil de ce lieu, amorcer la nouvelle vie qui l'attire et l'apeure, comme un feu."
                            },
                            {
                                "example_id": "1b061806-fba8-4876-984c-562095913152",
                                "sense_id": "9989593b-d3e3-389a-945a-90918e7a2a2d",
                                "text": "Cette mission autoassignée permet de soutenir la création et d'organiser les loisirs de masse."
                            },
                            {
                                "example_id": "1b2230ae-f5b0-45b7-aeea-a3cf2d2d83e2",
                                "sense_id": "9989593b-d3e3-389a-945a-90918e7a2a2d",
                                "text": "S'autoassigner au système d'information clientèle afin de faire un suivi de la demande et saisir des HPS."
                            }
                        ]
                    }
