                    {
                        "sense_id": "7aedb732-0770-3442-8132-ffce40bc4946",
                        "entry_id": "87e28a12-7a67-3f1e-a8e7-8f22f359c8be",
                        "glosses": [
                            "Hyménoptère, abeille du genre Colletes répandue sur toute la planète sauf en Australie, il en existe 58 espèces en Europe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55d415da-4375-4b6e-b058-0eca6fb4f914",
                                "sense_id": "7aedb732-0770-3442-8132-ffce40bc4946",
                                "text": "La collète du lierre est une petite abeille solitaire assez rare qui se nourrit presque exclusivement des fleurs du lierre."
                            },
                            {
                                "example_id": "676c1982-783c-44fc-9bd2-778a15cec6b3",
                                "sense_id": "7aedb732-0770-3442-8132-ffce40bc4946",
                                "text": "Les collètes sont des abeilles nichant dans le sol."
                            }
                        ]
                    }
                ],
                "translations": [
