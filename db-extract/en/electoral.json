                    {
                        "sense_id": "e4236017-372f-3308-8ddf-01682cbd5e10",
                        "entry_id": "c7fe3e15-8f31-3a09-8505-d7e31ca9e009",
                        "glosses": [
                            "Relating to or composed of electors."
                        ],
