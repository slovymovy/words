            {
                "entry_id": "b2cb1e55-f610-392e-b3a0-fa5edb9c4e6e",
                "word": "holà",
                "pos": "intj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b082392f-1bfd-3801-b308-7c3c22306bbc",
                        "entry_id": "b2cb1e55-f610-392e-b3a0-fa5edb9c4e6e",
                        "glosses": [
                            "Cri que les charretiers poussaient pour faire arrêter leurs chevaux."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "4c75bc3c-64de-45ca-b94a-f4e6aec814d4",
                                "sense_id": "b082392f-1bfd-3801-b308-7c3c22306bbc",
                                "text": "Holà, ohhh, holà a-t-il lancé pour faire arrêter son attelage !"
                            },
                            {
                                "example_id": "f130b35f-b00f-4bc8-bef3-1142fe2bfe65",
                                "sense_id": "b082392f-1bfd-3801-b308-7c3c22306bbc",
                                "text": "Montreval poussait des holà ! prolongés. Fend-l'Air ruait, se dressait, pointait, exécutait des tête-à-queue fantastiques, semblant pris de folie."
                            }
                        ]
                    },
                    {
                        "sense_id": "67934366-427e-3cd1-b4f6-6267956b39e8",
                        "entry_id": "b2cb1e55-f610-392e-b3a0-fa5edb9c4e6e",
                        "glosses": [
                            "Dont on se sert pour appeler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9292359-ded2-41e8-b53d-0d9ab19d8907",
                                "sense_id": "67934366-427e-3cd1-b4f6-6267956b39e8",
                                "text": "Holà ! Qui est là ?"
                            },
                            {
                                "example_id": "3a0f8b6a-43e5-46cc-b82e-ba51e5ac419e",
                                "sense_id": "67934366-427e-3cd1-b4f6-6267956b39e8",
                                "text": "Holà ! Il y a quelqu’un ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "8bfd5b6b-0b33-3d01-a0dc-30b1274dfccb",
                        "entry_id": "b2cb1e55-f610-392e-b3a0-fa5edb9c4e6e",
                        "glosses": [
                            "Cri poussé pour faire cesser une activité débordante, un chahut ou pour faire stopper des digressions hors sujet."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6cc1fe44-2f10-4185-bf3a-a6dbeb311abe",
                                "sense_id": "8bfd5b6b-0b33-3d01-a0dc-30b1274dfccb",
                                "text": "Holà ! Stop, ça suffit maintenant, on range les jouets nous a dit maman !"
                            },
                            {
                                "example_id": "db95d6ec-9751-43fe-9d4b-07a38b28c4fe",
                                "sense_id": "8bfd5b6b-0b33-3d01-a0dc-30b1274dfccb",
                                "text": "Holà ! holà !, on revient à l’ordre du jour !"
                            }
                        ]
                    },
                    {
                        "sense_id": "0988e87b-f884-301e-a927-07fd5d131dac",
                        "entry_id": "b2cb1e55-f610-392e-b3a0-fa5edb9c4e6e",
                        "glosses": [
                            "Tout beau, c’est assez."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c929e8ce-6068-498b-a2a5-d213f757644f",
                                "sense_id": "0988e87b-f884-301e-a927-07fd5d131dac",
                                "text": "Holà, ne faites pas tant de bruit."
                            }
                        ]
                    },
                    {
                        "sense_id": "455acd38-4fd8-3c8f-bfd9-ab4907cfd642",
                        "entry_id": "b2cb1e55-f610-392e-b3a0-fa5edb9c4e6e",
                        "glosses": [
                            "Ménagement, atténuation d'une exagération potentielle verbale ou factuelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57843ad5-1c07-4e86-8a62-cd3ec22af289",
                                "sense_id": "455acd38-4fd8-3c8f-bfd9-ab4907cfd642",
                                "text": "Holà, comme vous y allez !"
                            }
                        ]
                    },
                    {
                        "sense_id": "ca195807-4338-339f-abc5-88c52364dfc1",
                        "entry_id": "b2cb1e55-f610-392e-b3a0-fa5edb9c4e6e",
                        "glosses": [
                            "Marque d’un changement de contexte ou catégoriel important."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3022eb4b-7e95-4432-9ad5-501e2620df1d",
                                "sense_id": "ca195807-4338-339f-abc5-88c52364dfc1",
                                "text": "Holà, c’est une autre histoire !"
                            },
                            {
                                "example_id": "bcc37c27-28cc-4ef8-ab0f-98816fa55b32",
                                "sense_id": "ca195807-4338-339f-abc5-88c52364dfc1",
                                "text": "Holà, vous m’en direz tant !"
                            }
                        ]
                    },
                    {
                        "sense_id": "e7ddb797-a39b-3766-a267-9a22efc441e8",
                        "entry_id": "b2cb1e55-f610-392e-b3a0-fa5edb9c4e6e",
                        "glosses": [
