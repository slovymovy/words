                                            {
                                                "example_id": "85791d96-1d51-4d4d-bd09-58299cc50207",
                                                "sense_id": "9e2a6a8c-5128-3a98-b5ab-77e4328f7802",
                                                "text": "Der Prämolar ist an seiner distalen Fläche kariös."
