                                        "glosses": [
                                            "Action de vaporiser : dispersion en fines gouttelettes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd0c5f17-426b-4c65-8de7-08754392cf9c",
                                                "sense_id": "0902dcb3-3fdf-3535-af33-ec5a81f26c57",
                                                "text": "N’oubliez pas la vaporisation des plantes pour éviter leur dessèchement !"
