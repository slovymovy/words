                                        "entry_id": "5134e970-f627-3819-9388-43597c20f0f7",
                                        "glosses": [
                                            "vonný olej (popř. jiná substance), kterým se zvyšuje lesk vlasů nebo vousů"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e9aa5c0-6ac2-4d6e-9adf-fd1262e8cd58",
                                                "sense_id": "f32cbe00-9b0e-3689-b526-9a76d16451dd",
                                                "text": "(...) vlasy měl kučeravé a plné brilantiny, tak se mu třpytily ty vlasy, skoro jako brilianty na druhé ruce (...)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bed283b9-1802-4b79-8716-0b88417b4f6a",
                        "source_entry_id": "369bac60-2e25-38da-a505-760d2b157b6a",
                        "source_sense_id": "abb92932-8a50-3c5b-989b-f54f3f00094c",
                        "target_lang_word": "brillantine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brillantine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "513111cc-1f6d-30d0-b7b6-10d1044b5d18",
                                        "entry_id": "89de742d-0d42-3818-bfe0-d9210ef0c4c4",
                                        "glosses": [
                                            "Composition (pommade ou liquide) odorante permettant de lustrer les cheveux et la barbe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7413fef-6366-40aa-810e-9dba1c703eb4",
                                                "sense_id": "513111cc-1f6d-30d0-b7b6-10d1044b5d18",
                                                "text": "Ses cheveux blonds, généralement pommadés, étaient en désordre. Et, comme la brillantine les rendait raides, ils se dressaient sur sa tête."
                                            },
                                            {
                                                "example_id": "ef9b5550-73e7-478b-90ae-729ccf208338",
                                                "sense_id": "513111cc-1f6d-30d0-b7b6-10d1044b5d18",
                                                "text": "Un parfum d’étoffe teinte et de brillantine venait de ta robe de deuil, de tes cheveux."
                                            },
                                            {
                                                "example_id": "19e084fc-ef2a-40e5-a344-3eb65a214937",
                                                "sense_id": "513111cc-1f6d-30d0-b7b6-10d1044b5d18",
                                                "text": "Lavinia avait pensé à tout et à une petite boîte de brillantine à la violette dont Angelo se lissa la moustache."
                                            },
                                            {
                                                "example_id": "6091f067-2748-4fb0-82e9-0bd6758cff22",
                                                "sense_id": "513111cc-1f6d-30d0-b7b6-10d1044b5d18",
                                                "text": "Le style chanteur de charme, col blanc ouvert sur une médaille pieuse, cheveu rare plaqué par la brillantine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1cf7319-f3d8-3d1d-9867-653087277c89",
                                        "entry_id": "89de742d-0d42-3818-bfe0-d9210ef0c4c4",
                                        "glosses": [
                                            "Étoffe de soie utilisée pour la confection de robes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23c7aab5-88b9-49bc-98af-0484df82843f",
                                                "sense_id": "b1cf7319-f3d8-3d1d-9867-653087277c89",
                                                "text": "Brillantine : Tissu où il y a des flottés chaîne sur fond de taffetas."
                                            }
                                        ]
                                    }
                                ]
                            },
