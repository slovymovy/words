                                        "sense_id": "9b32952b-fd28-3770-8f53-b93e51f4d7ce",
                                        "entry_id": "a5741761-d706-3155-8041-8b9f3084af80",
                                        "glosses": [
                                            "Of a certain symmetry class with 24 congruent irregular quadrilateral faces."
                                        ],
                                        "tags": [
