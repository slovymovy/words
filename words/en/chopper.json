                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The injured soldiers were <w>choppered</w> out of the combat zone to a nearby hospital.",
