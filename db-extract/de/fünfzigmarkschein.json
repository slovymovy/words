                        "examples": [
                            {
                                "example_id": "1e6ba5d9-e114-41ac-914a-837ffe9ef354",
                                "sense_id": "25c7eeaa-da49-3f7e-a2c0-1adf1ae89330",
                                "text": "„Das Mädchen kramte in seinem Täschchen und hielt mir einen Fünfzigmarkschein hin.“"
                            },
                            {
                                "example_id": "fb7dbdc1-90c4-4220-a2bf-cd531bf2314f",
                                "sense_id": "25c7eeaa-da49-3f7e-a2c0-1adf1ae89330",
                                "text": "„Schlump bekam einen Fünfzigmarkschein in die Hand gedrückt, den er in die hintere Hosentasche steckte.“"
                            }
                        ],
