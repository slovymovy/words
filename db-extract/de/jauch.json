                ],
                "senses": [
                    {
                        "sense_id": "94da01b3-314e-3d88-9f11-d3bb3014a09f",
                        "entry_id": "13c4f652-679b-3522-919b-6b9a36b6a0f8",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a12778ff-5686-41b8-8eb5-9171d4fd6279",
                                "sense_id": "94da01b3-314e-3d88-9f11-d3bb3014a09f",
                                "text": "Jauch kommt und geht."
                            },
                            {
                                "example_id": "9e02caff-4e02-4520-9162-d50749343590",
                                "sense_id": "94da01b3-314e-3d88-9f11-d3bb3014a09f",
                                "text": "Frau Jauch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6fe32d49-0d73-4178-8f48-26019a865392",
                                "sense_id": "94da01b3-314e-3d88-9f11-d3bb3014a09f",
                                "text": "Herr Jauch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "56e8dce7-f0f3-44df-9a2e-14565f942f29",
                                "sense_id": "94da01b3-314e-3d88-9f11-d3bb3014a09f",
                                "text": "Die Jauchs fliegen heute nach Sri Lanka."
                            },
                            {
                                "example_id": "ef9ec47f-cca5-419d-8cdc-4e58f0baba14",
                                "sense_id": "94da01b3-314e-3d88-9f11-d3bb3014a09f",
                                "text": "Der Jauch trägt nie die Pullover, die die Jauch ihm strickt."
                            },
                            {
                                "example_id": "56f2fea7-5e7e-4180-9b86-deb51e7fcc29",
                                "sense_id": "94da01b3-314e-3d88-9f11-d3bb3014a09f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Jauch kommt, geht der Herr Jauch.“"
                            },
                            {
                                "example_id": "ccb8bb06-73be-4f40-a090-c5c2b10b7933",
                                "sense_id": "94da01b3-314e-3d88-9f11-d3bb3014a09f",
                                "text": "Jauchs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
