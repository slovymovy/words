                "senses": [
                    {
                        "sense_id": "41923644-27ac-3f0e-a6c7-d4d304e3fa1c",
                        "entry_id": "ee479a4b-9212-39ea-a76b-7749b15c3198",
                        "glosses": [
                            "der Zustand, die Tätigkeit, durch etwas, jemanden beleidigt zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "557a55e9-7f2e-4b63-80ab-b87cb4bce195",
                                "sense_id": "41923644-27ac-3f0e-a6c7-d4d304e3fa1c",
                                "text": "„Wer beschuldigt wird, sein Gegenüber zu beleidigen, hat keine Chance, diesem Vorwurf zu entkommen, weil sich Beleidigtsein nicht messen oder objektiv bestimmen lässt.“"
                            },
                            {
                                "example_id": "a06083b3-86be-41a3-b948-1e9275553296",
                                "sense_id": "41923644-27ac-3f0e-a6c7-d4d304e3fa1c",
                                "text": "„Die Tendenz zu inflationärem Beleidigtsein ist Gift für [die] Diskurskultur.“"
                            },
                            {
                                "example_id": "885cc9a1-5624-404c-ade2-9b8e1368d63b",
                                "sense_id": "41923644-27ac-3f0e-a6c7-d4d304e3fa1c",
                                "text": "[Manche glauben], „dass das Beleidigtsein häufig gar nichts mit dem Gegenüber zu tun hat.“"
                            },
                            {
                                "example_id": "a55fa42e-9a91-4163-953f-f6a20636ed63",
                                "sense_id": "41923644-27ac-3f0e-a6c7-d4d304e3fa1c",
                                "text": "„Das patzige Beleidigtsein … der Zuschauer zeigte, wie unkundig und vor allem respektlos viele von ihnen bei Länderspielen [der deutschen Fußballnationalmannschaft] … sind.“"
                            },
                            {
                                "example_id": "a96db91d-532b-4af9-b7b8-04e5a3e6d237",
                                "sense_id": "41923644-27ac-3f0e-a6c7-d4d304e3fa1c",
                                "text": "„Die AfD ist vielleicht das beste Beispiel für die politische Organisation des persönlichen Beleidigtseins.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
