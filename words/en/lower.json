                                "target_lang_sense_clarification": "miktar veya seviye olarak"
                            },
                            {
                                "target_lang_word": "daha alçak",
                                "target_lang_sense_clarification": "fiziksel yükseklik olarak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93f5d07e-e41b-3160-9d69-58af87de43f4",
                    "sense_definition": "Located at or near the bottom part of something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "adj_bottom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bit his <w>lower</w> lip while he was thinking.",
                            "target_lang_translations": {
                                "ru": "Он прикусил <w>нижнюю</w> губу, пока думал.",
                                "tr": "Düşünürken <w>alt</w> dudağını ısırdı."
                            }
                        },
                        {
                            "text": "The passengers on the <w>lower</w> deck felt the motion of the sea.",
                            "target_lang_translations": {
                                "ru": "Пассажиры на <w>нижней</w> палубе чувствовали качку.",
                                "tr": "<w>Alt</w> güvertedeki yolcular denizin hareketini hissettiler."
                            }
                        }
                    ],
                    "antonyms": [
                        "upper"
                    ],
                    "common_phrases": [
                        "lower lip",
                        "lower deck",
                        "lower jaw"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся внизу или у основания чего-либо.",
                        "tr": "Bir şeyin alt kısmında veya tabanına yakın bir yerde bulunan."
                    },
                    "translations": {
