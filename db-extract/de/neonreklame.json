                ],
                "senses": [
                    {
                        "sense_id": "9881bdac-aec1-3f67-acab-76ddeffb1171",
                        "entry_id": "e83f7e0c-3ea4-362c-8ec4-d69afb330570",
                        "glosses": [
                            "Reklame, die mit Neonlichtern beleuchtet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28940d51-6bce-420b-bc07-8048332ef044",
                                "sense_id": "9881bdac-aec1-3f67-acab-76ddeffb1171",
                                "text": "„Die Neonreklame, ein Saguarokaktus, der einen frech schiefsitzenden schwarzen Cowboyhut trägt, ist brandneu und sauber.“"
                            },
                            {
                                "example_id": "565b3a1a-0489-4286-b15c-3402400daf8c",
                                "sense_id": "9881bdac-aec1-3f67-acab-76ddeffb1171",
                                "text": "„Beim Gehen verschoben sich ihre Schultern gegeneinander, und durch eine Lücke zwischen ihnen sah ich Mohan Surve unter der Neonreklame stehen, immer noch an der Tür, reglos, den Rücken zur Wand.“"
                            },
                            {
                                "example_id": "bcd0d51f-16ec-4134-8e45-68ffd99e0f9b",
                                "sense_id": "9881bdac-aec1-3f67-acab-76ddeffb1171",
                                "text": "„HK war ein gedoptes New York. Las Vegas auf Speed. Auf jedem Quadratmeter eine Neonreklame, eine Farb- und Lärm- und Duftexplosion, ein Angriff auf die Sinne, hinter dem kaum verhohlen eine Werbeabsicht steckte für ein Produkt oder eine Dienstleistung, ohne die ein Leben absolut sinnlos war.“"
                            },
                            {
                                "example_id": "686b1a04-7657-4f19-8e76-29cd7225f6bf",
                                "sense_id": "9881bdac-aec1-3f67-acab-76ddeffb1171",
                                "text": "„Als graue Wolke wird Tabbi mit dem Wind davontreiben. Die Küste entlang auf die Stadt zu, das Hotel, die Häuser, die Kirche. Die Neonreklamen und Werbeplakate und Firmenlogos und Markennamen.“"
                            },
                            {
                                "example_id": "bf0d7ad2-2874-4634-b2d3-72e3e48b961c",
                                "sense_id": "9881bdac-aec1-3f67-acab-76ddeffb1171",
                                "text": "„An Kaufhäusern und Läden zu beiden Seiten der breiten Straße blinken bunte Neonreklamen mit den Logos von Fluggesellschaften, Fastfood-Restaurants und Mobilfunkfirmen, alle paar Häuser unterbrochen von düsteren Transparenten, auf denen in handgemalten Buchstaben an das Blut der Märtyrer erinnert wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
