                        "entry_id": "fb7dd18b-d2dc-3ff1-a96b-ee7dd9f1cb00",
                        "glosses": [
                            "A person who holds an office, especially one appointed or elected to a public office."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d2c70f6-52a4-472e-af9a-ffd4aac00c6b",
                                "sense_id": "f4a727a9-acc0-3847-a0c4-42786259517f",
                                "text": "But it’s an open question as to what happens if the officeholder is instead fired by the President."
                            },
                            {
                                "example_id": "c349d262-8232-4748-90a5-7d17637a814b",
                                "sense_id": "f4a727a9-acc0-3847-a0c4-42786259517f",
                                "text": "But even as he pledges financial support, Trump has not ruled out intervening in primaries to bolster challengers against Republican officeholders he perceives as insufficiently loyal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7511e3e-3540-43a5-8142-8a5ad13b9afb",
                        "source_entry_id": "fb7dd18b-d2dc-3ff1-a96b-ee7dd9f1cb00",
