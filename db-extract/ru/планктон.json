                                    {
                                        "sense_id": "21a616e8-52ba-3597-a2ac-796aa1a29929",
                                        "entry_id": "dbffe55f-1a0e-33a9-be39-55b7ac3892c1",
                                        "glosses": [
                                            "zespół organizmów żywych unoszących się w wodzie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09efbde5-36af-470b-b245-393651323fd1",
                                                "sense_id": "21a616e8-52ba-3597-a2ac-796aa1a29929",
                                                "text": "Zazwyczaj plankton stanowią drobne organizmy, ale zalicza się do niego również meduzy, które mogą mieć znaczne rozmiary"
                                            },
                                            {
                                                "example_id": "1c4a9ff9-99c0-419a-8180-dcf51271b6dc",
                                                "sense_id": "21a616e8-52ba-3597-a2ac-796aa1a29929",
                                                "text": "Organizmy odbywające cały cykl życia jako planktony to holoplankton, podczas gdy organizmy, które w planktonie występują tylko przez niektóre stadia rozwojowe to meroplankton."
                                            }
                                        ],
