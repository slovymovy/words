            {
                "entry_id": "b9d8ec7a-b018-399d-91e0-02587e714393",
                "word": "Dace",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3afd7daf-a50a-4abd-8616-93add8ea35be",
                        "entry_id": "b9d8ec7a-b018-399d-91e0-02587e714393",
                        "tags": [
                            "plural"
                        ],
                        "form": "Daces"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2c7572c8-2ccf-38bf-9046-540f412d4cb2",
                        "entry_id": "b9d8ec7a-b018-399d-91e0-02587e714393",
                        "glosses": [
                            "Membre des tribus thraces du Nord, ayant peuplé le bassin Bas-Danube, la Dacie."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "d45ef9f5-2de9-4dc3-a2fd-02fe8bf3ddad",
                                "sense_id": "2c7572c8-2ccf-38bf-9046-540f412d4cb2",
                                "text": "La prononciation roumaine de Dace est /ˈdat͡ʃe/."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f33b948f-44fc-464c-a7ae-583f37c70bfd",
                        "source_entry_id": "b9d8ec7a-b018-399d-91e0-02587e714393",
                        "source_sense_id": "2c7572c8-2ccf-38bf-9046-540f412d4cb2",
                        "target_lang_word": "Daker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Daker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "062c0f55-1237-3678-8f94-210c6f0af75e",
                                        "entry_id": "d2050390-c777-3467-a7fc-0af7e20bd193",
                                        "glosses": [
                                            "Angehöriger des antiken, gleichnamigen Volkes, das westlich des Schwarzen Meeres siedelte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99290586-b4b3-49ee-805c-6685b92b3206",
                                                "sense_id": "062c0f55-1237-3678-8f94-210c6f0af75e",
                                                "text": "„Der Daker erwies sich als mit allen Wassern gewaschener Taktiker, ein Ehrgeizling, der nichts Geringeres anstrebte als die Errichtung eines Großreiches.“"
                                            },
                                            {
                                                "example_id": "72dcee8b-14ab-45e2-85bd-c88f8aa79612",
                                                "sense_id": "062c0f55-1237-3678-8f94-210c6f0af75e",
                                                "text": "„Daneben wird eine Schlacht gegen die Daker dargestellt, die durch die Überlegenheit der römischen Soldaten siegreich endet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
