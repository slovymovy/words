                ],
                "senses": [
                    {
                        "sense_id": "3b94390c-25c6-3355-b604-9c7528307976",
                        "entry_id": "ef51c224-afaf-3d89-9d1f-394bdd49aa42",
                        "glosses": [
                            "een apparaat om beelden mee te registreren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df15bb07-1132-4210-9da1-4f1dce818bbb",
                                "sense_id": "3b94390c-25c6-3355-b604-9c7528307976",
                                "text": "Met deze camera maakt u zowel foto's als videofilms met geluid."
                            },
                            {
                                "example_id": "bfaa67b9-184e-4ed6-a225-796d1510e131",
                                "sense_id": "3b94390c-25c6-3355-b604-9c7528307976",
                                "text": "In zijn hand hield hij een groot palet met klodders verf erop, en hij had zijn lichaam in de richting van de camera gewend."
                            },
                            {
                                "example_id": "25b12be8-bfea-4064-9b91-67570e33b0fa",
                                "sense_id": "3b94390c-25c6-3355-b604-9c7528307976",
                                "text": "De wedstrijd werd over de hele wereld uitgezonden. Overal stonden camera's."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0234808c-7459-4abf-b851-2109523a3dd6",
                        "source_entry_id": "ef51c224-afaf-3d89-9d1f-394bdd49aa42",
                        "source_sense_id": "3b94390c-25c6-3355-b604-9c7528307976",
                        "source_sense_description": "een apparaat om beelden mee te registreren",
                        "target_lang_word": "Fotoapparat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fotoapparat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e39b5593-13cc-30b8-87d2-a6d7a309d9e1",
                                        "entry_id": "fbc189f7-74b2-3f11-9598-3e4e0ef7442a",
                                        "glosses": [
                                            "Gerät, das zum Aufnehmen von Fotos dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da80e7a3-0754-482b-abc7-f517e6697e6b",
                                                "sense_id": "e39b5593-13cc-30b8-87d2-a6d7a309d9e1",
                                                "text": "Ich habe mir einen neuen Fotoapparat gekauft."
                                            },
                                            {
                                                "example_id": "10829693-5a94-47c6-aef1-58d3e4094e03",
                                                "sense_id": "e39b5593-13cc-30b8-87d2-a6d7a309d9e1",
                                                "text": "Auf einer Safari darf ein Fotoapparat nicht fehlen."
                                            },
                                            {
                                                "example_id": "d255978d-3d2d-4222-a344-3ae300c946ea",
                                                "sense_id": "e39b5593-13cc-30b8-87d2-a6d7a309d9e1",
                                                "text": "Hast du deinen Fotoapparat eingepackt?"
                                            },
                                            {
                                                "example_id": "8f136f98-0585-405a-bf5e-b5d690b3aa7c",
                                                "sense_id": "e39b5593-13cc-30b8-87d2-a6d7a309d9e1",
                                                "text": "„Im Schrank erwarteten mich, gut verpackt, ein Tonbandgerät und ein Fotoapparat.“"
                                            },
                                            {
                                                "example_id": "cd0c45bd-abd2-4ed4-b82b-5eb806d3eb0a",
                                                "sense_id": "e39b5593-13cc-30b8-87d2-a6d7a309d9e1",
                                                "text": "„Von dem Papa gibt es keine Urlaubsfotos, weil die Mama nicht mit dem Fotoapparat umgehen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c9e1e0c-48e3-4822-95be-6a916c819275",
                        "source_entry_id": "ef51c224-afaf-3d89-9d1f-394bdd49aa42",
                        "source_sense_id": "3b94390c-25c6-3355-b604-9c7528307976",
                        "source_sense_description": "een apparaat om beelden mee te registreren",
                        "target_lang_word": "Kamera",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kamera",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "442da751-575d-36e0-bc3e-fb95cbcc473b",
                                        "entry_id": "46176da7-3677-3e08-b3a9-b6ea023f56bf",
                                        "glosses": [
                                            "Gerät zum Erstellen von Fotos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22688301-9449-4aa1-9649-f37326dc5b7f",
                                                "sense_id": "442da751-575d-36e0-bc3e-fb95cbcc473b",
                                                "text": "Ich habe mir eine neue Kamera gekauft."
                                            },
                                            {
                                                "example_id": "13325692-b7b3-4b23-85da-0caefc4110c0",
                                                "sense_id": "442da751-575d-36e0-bc3e-fb95cbcc473b",
                                                "text": "Heute hat fast jedes Smartphone eine integrierte Kamera."
                                            },
                                            {
                                                "example_id": "6bc6565b-8eba-4346-aeb3-13e0fb87bbde",
                                                "sense_id": "442da751-575d-36e0-bc3e-fb95cbcc473b",
                                                "text": "„Auf diese Weise neu ist für den abgebrühten und mit Kameras versehenen Traveller von heute nichts mehr.“"
                                            },
                                            {
                                                "example_id": "301a302b-5a12-4fb9-9a44-f35f28246bc3",
                                                "sense_id": "442da751-575d-36e0-bc3e-fb95cbcc473b",
                                                "text": "„Jan kniete sich hin, schob das Stativ zusammen und verstaute es zusammen mit der Kamera in der schwarzen Tasche, die er halb offen ließ.“"
                                            },
                                            {
                                                "example_id": "94ee9668-1738-4949-8d25-bca0a7a359bc",
                                                "sense_id": "442da751-575d-36e0-bc3e-fb95cbcc473b",
                                                "text": "„Gisèle war mit ihrer Kamera da, wie mittlerweile fast immer bei künstlerischen Veranstaltungen – sie fotogrfierte berühmte Schriftsteller, Maler und dergleichen, genau wie Adrienne und Sylvia es ihr prophezeit hatten.“"
                                            },
                                            {
                                                "example_id": "3253df89-e069-4c58-bc2b-08d3e5805f14",
                                                "sense_id": "442da751-575d-36e0-bc3e-fb95cbcc473b",
                                                "text": "„Am Ausgang des Friedhofs standen die Presseleute mit Kameras und Notizblöcken, machten sich ab und zu kurze Notizen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8ab5fbde-0dbc-3fb6-a0c2-7ce0dcd02b2c",
                                        "entry_id": "46176da7-3677-3e08-b3a9-b6ea023f56bf",
                                        "glosses": [
                                            "Gerät zum Aufnehmen von Filmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96ada94d-619f-460c-85a1-4d0b621facb0",
                                                "sense_id": "8ab5fbde-0dbc-3fb6-a0c2-7ce0dcd02b2c",
                                                "text": "Das Team war mit der Kamera unterwegs, um die Tiere zu filmen."
                                            },
                                            {
                                                "example_id": "01ba6ddd-5736-46a8-965a-9a7993f00775",
                                                "sense_id": "8ab5fbde-0dbc-3fb6-a0c2-7ce0dcd02b2c",
                                                "text": "„Ich hob die kaputte Kamera auf.“"
                                            },
                                            {
                                                "example_id": "4d8821f3-6c02-4700-bd28-957b8f9fa40d",
                                                "sense_id": "8ab5fbde-0dbc-3fb6-a0c2-7ce0dcd02b2c",
                                                "text": "„Die Kamera zog auf, und die Moderatorin machte eine kurze Pause.“"
                                            },
                                            {
                                                "example_id": "e836d6fd-d803-4f9f-b694-0e008f7d7e91",
                                                "sense_id": "8ab5fbde-0dbc-3fb6-a0c2-7ce0dcd02b2c",
                                                "text": "„Die Kamera schwenkte über die Menge und kippte dann himmelwärts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5de5cf52-d6a6-44d0-a7f5-f377785e42ce",
                        "source_entry_id": "ef51c224-afaf-3d89-9d1f-394bdd49aa42",
                        "source_sense_id": "3b94390c-25c6-3355-b604-9c7528307976",
                        "source_sense_description": "een apparaat om beelden mee te registreren",
                        "target_lang_word": "camera",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camera",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43bb3a97-dd2a-38a3-a1c3-8c7e1b7e5923",
                                        "entry_id": "2a72c291-ba2a-38d5-b996-6d025a85a1c3",
                                        "glosses": [
                                            "A device for taking still or moving pictures or photographs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6274b0bf-941b-465e-b6f6-9e9c2e0b4b37",
                                                "sense_id": "43bb3a97-dd2a-38a3-a1c3-8c7e1b7e5923",
                                                "text": "The single-imaging optic of the mammalian eye offers some distinct visual advantages. Such lenses can take in photons from a wide range of angles, increasing light sensitivity. They also have high spatial resolution, resolving incoming images in minute detail. It’s therefore not surprising that most cameras mimic this arrangement."
                                            },
                                            {
                                                "example_id": "990e525e-3067-4cae-8401-70c573e52e4e",
                                                "sense_id": "43bb3a97-dd2a-38a3-a1c3-8c7e1b7e5923",
                                                "text": "Glance up while strolling through parts of downtown Hong Kong and, chances are, you’ll notice the glassy black lens of a surveillance camera trained on the city’s crowded streets.\nAnd that sight will become more common in the coming years, as the city’s police pursue an ambitious campaign to install thousands of cameras to elevate their surveillance capabilities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89c62c8f-8df8-3bb8-9aca-168f74f2bee5",
                                        "entry_id": "2a72c291-ba2a-38d5-b996-6d025a85a1c3",
                                        "glosses": [
                                            "The viewpoint in a three-dimensional game or simulation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "629b52a9-1aa6-4e4e-a445-53e9d9197ee7",
                                                "sense_id": "89c62c8f-8df8-3bb8-9aca-168f74f2bee5",
                                                "text": "If you're building a third-person game with enclosed or tight spaces, try to figure out up front what camera problems you will likely encounter. Use this identification process to influence the early building process."
                                            },
                                            {
                                                "example_id": "ec28b242-d2c5-49a7-a989-44d9dd530f87",
                                                "sense_id": "89c62c8f-8df8-3bb8-9aca-168f74f2bee5",
                                                "text": "I'm talking about the way the camera flies up above the skater when you leap into the air. No one had done it before."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f872c09-e152-359b-80a6-41d91b5e5c1b",
                                        "entry_id": "2a72c291-ba2a-38d5-b996-6d025a85a1c3",
                                        "glosses": [
                                            "A vaulted room."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f7d9f24-09f2-3bc9-9a44-0cfd81f15a77",
                                        "entry_id": "2a72c291-ba2a-38d5-b996-6d025a85a1c3",
                                        "glosses": [
                                            "A judge's private chamber, where cases may be heard in camera."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9272f2a7-2e00-426a-a50d-b731df6e1260",
                        "source_entry_id": "ef51c224-afaf-3d89-9d1f-394bdd49aa42",
                        "source_sense_id": "3b94390c-25c6-3355-b604-9c7528307976",
                        "source_sense_description": "een apparaat om beelden mee te registreren",
                        "target_lang_word": "appareil-photo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appareil-photo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56b357af-9ef2-333f-b0ff-1dca1a729c42",
                                        "entry_id": "305586bd-3731-33b5-ba62-0d8f9a297324",
                                        "glosses": [
                                            "Variante de appareil photo."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9dd3df2-2526-46e1-b440-03b9a4f9acc3",
                                                "sense_id": "56b357af-9ef2-333f-b0ff-1dca1a729c42",
                                                "text": "Un jeune homme arriva en courant à la porte du café, un appareil-photo en bandoulière et le photographia ainsi, assis et souriant."
                                            },
                                            {
                                                "example_id": "4c66df7e-2a4c-4975-9afe-54cf7d76e9ae",
                                                "sense_id": "56b357af-9ef2-333f-b0ff-1dca1a729c42",
                                                "text": "On y est ! Beaucoup de fans (tous avec des appareil-photos) à l'aéroport. Quelque part il y aura des centaines d'horribles photos de moi... Je suis affreuse. Mais bon. Je ne suis pas surprise de combien les fans sont gentils et timides. Je ressens les mêmes impressions générales des courriers qu'ils envoient. Ils sont toujours si polis."
                                            },
                                            {
                                                "example_id": "01fbac7e-c12f-4192-8a94-e3b85d3f93a8",
                                                "sense_id": "56b357af-9ef2-333f-b0ff-1dca1a729c42",
                                                "text": "Depuis l’apparition des appareil-photos/vidéos numériques sur le marché grand public dans les années 90, la qualité de prise de vue et la puissance de traitement des appareils n’ont cessé d’augmenter. Les fonctionnalités de l’imagerie numérique se sont développées extrêmement rapidement, notamment sur les téléphones et assistants personnels portables."
                                            },
                                            {
                                                "example_id": "ace7b0d9-8353-43cf-bade-5edab96ea6fc",
                                                "sense_id": "56b357af-9ef2-333f-b0ff-1dca1a729c42",
                                                "text": "L.P. : Peut-on dire que le succès de La Salle de bain était celui d’un roman tandis que le succès de L’Appareil-photo a été celui d’un écrivain ? Plusieurs critiques, qui avaient été déçus par Monsieur, ont parlé, à propos de L’Appareil-photo, de la confirmation d’un talent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32e9e10b-4d70-4526-b6a4-a25c06b8788f",
                        "source_entry_id": "ef51c224-afaf-3d89-9d1f-394bdd49aa42",
                        "source_sense_id": "3b94390c-25c6-3355-b604-9c7528307976",
                        "source_sense_description": "een apparaat om beelden mee te registreren",
                        "target_lang_word": "caméra",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caméra",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b686847-d4be-3d0e-8ea2-4d5d2cf64e62",
                                        "entry_id": "307bcf9a-049e-3f78-9d37-b2e49e51dc61",
                                        "glosses": [
                                            "Appareil permettant de filmer, de réaliser la prise de vues d’un film."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12f0a451-d7a8-440d-aa9d-98dd050e1c8e",
                                                "sense_id": "9b686847-d4be-3d0e-8ea2-4d5d2cf64e62",
                                                "text": "Si la caméra se déplace, abandonne un personnage ou un objet, nous supposons qu’ils sont toujours là, hors du cadre."
                                            },
                                            {
                                                "example_id": "066f64e9-9b75-4960-93ae-2d66907f8251",
                                                "sense_id": "9b686847-d4be-3d0e-8ea2-4d5d2cf64e62",
                                                "text": "En un tour de main, j’insérai une K7 vierge dans la caméra, attrapai mon voile noir et dévalai l’escalier, me retenant à la rampe tant mes jambes mollissaient."
                                            },
                                            {
                                                "example_id": "2f55a864-c8b2-4ddd-9a42-447d4533a61f",
                                                "sense_id": "9b686847-d4be-3d0e-8ea2-4d5d2cf64e62",
                                                "text": "Comme Lagardère jouait les étonnés, le fonctionnaire lui expliqua qu’une caméra de surveillance avait filmé un triple assassinat dans ce quartier."
                                            },
                                            {
                                                "example_id": "29526166-18ba-4a0f-a083-b5ec1939c994",
                                                "sense_id": "9b686847-d4be-3d0e-8ea2-4d5d2cf64e62",
                                                "text": "Sauf que cette fois, les numéros pagnolesques devant les caméras ne suffisent plus à conjurer la crise. Gaudin a choqué la population en s'enfermant d'abord dans le déni, allant jusqu'à accuser la pluie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "503945be-f28b-34d1-8933-e0b1ca2bc2cd",
                                        "entry_id": "307bcf9a-049e-3f78-9d37-b2e49e51dc61",
                                        "glosses": [
                                            "Personne qui filme avec une caméra."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3204907-28e3-464a-b9bb-728b7f9d3b43",
                                                "sense_id": "503945be-f28b-34d1-8933-e0b1ca2bc2cd",
                                                "text": "Il trouve là l’occasion de pousser ses idées. Et surjoue la bravoure face aux mécontents et aux caméras."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77aca3d0-b6aa-3220-b74a-fbaabc73b24b",
                                        "entry_id": "307bcf9a-049e-3f78-9d37-b2e49e51dc61",
                                        "glosses": [
                                            "Ce même type d’appareil qui mesure les flux thermiques radiants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcc0efa1-0feb-43db-b30d-97c938787d20",
                                                "sense_id": "77aca3d0-b6aa-3220-b74a-fbaabc73b24b",
                                                "text": "La caméra utilisée est une Camelia 8M (ATMEL). Il s’agit d’une caméra haute résolution disposant d’un capteur de 2300x3500 pixels carrés de 10 µm de côté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c033a4c-f088-39ac-9a9e-84d2add0a08c",
                                        "entry_id": "307bcf9a-049e-3f78-9d37-b2e49e51dc61",
                                        "glosses": [
