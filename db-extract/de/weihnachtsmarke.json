                        "sense_id": "1847ff79-ee6a-3d6c-9b41-080b688a4d45",
                        "entry_id": "8f291ab8-2942-35fd-9620-7b9c1c1e64b1",
                        "glosses": [
                            "Briefmarke, die zu Weihnachten mit entsprechenden Motiven erscheint"
                        ],
                        "tags": [
                            "Postwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "449ab9ee-93d1-4abd-becd-1164fa129011",
                                "sense_id": "1847ff79-ee6a-3d6c-9b41-080b688a4d45",
                                "text": "„Auf griechischer Seite sind auch die ab 1969 regelmäßig erscheinenden Weihnachtsmarken zu erwähnen, die in der Regel aus drei Marken bestehen, deren Thema die Geburt Christi ist, zumeist Abbildungen von Ikonen.“"
                            },
                            {
                                "example_id": "594e05e2-3ef9-47eb-9504-a638f5e8f02d",
                                "sense_id": "1847ff79-ee6a-3d6c-9b41-080b688a4d45",
                                "text": "„Mit den neuen Weihnachtsmarken und passenden Stempeln verleihen Sie Ihren Postsendungen ganz einfach eine festliche Note.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
