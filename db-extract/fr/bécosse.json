                "senses": [
                    {
                        "sense_id": "4b802a12-d890-3c92-b46b-76f8ec7ee00a",
                        "entry_id": "6d117bb9-0768-3e5a-80b3-49bba04c5cb6",
                        "glosses": [
                            "Toilette extérieure détachée d’un bâtiment, à fosse simple."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "note": "Ce terme est généralement utilisé au pluriel",
                        "examples": [
                            {
                                "example_id": "aca3077a-0d2b-4911-b576-7dfadef98d99",
                                "sense_id": "4b802a12-d890-3c92-b46b-76f8ec7ee00a",
                                "text": "Autrefois on n'avait pas de belles toilettes comme aujourd'hui, on allait à la bécosse dehors."
                            },
                            {
                                "example_id": "fe26a5d6-085a-436a-b575-48fcf2b305ff",
                                "sense_id": "4b802a12-d890-3c92-b46b-76f8ec7ee00a",
                                "text": "Bien sûr, c’est bourré d’mouches dans la bécosse, Pis les mulots t'chatouillent le bout' des pieds, Bien sûr, des fois on s'torche avec d'l'écorce, Parc' l'épic'rie est à cinq milles à pied, cinq milles à pied, ça use ça use, cinq milles à pied, ça use les souliers, Mais nous avons le soleil"
                            },
                            {
                                "example_id": "3733bb8b-40bf-44f4-ad3c-27bde119a809",
                                "sense_id": "4b802a12-d890-3c92-b46b-76f8ec7ee00a",
                                "text": "Les égoûts ont r'foulé, La bécosse a débordé, Y'avait des coliformes fécaux, Qui flottaient su'l terrazo."
                            },
                            {
                                "example_id": "18e98ad7-1c77-4b65-9cf7-bec8a236b8d5",
                                "sense_id": "4b802a12-d890-3c92-b46b-76f8ec7ee00a",
                                "text": "La partie inférieure du pignon sise sur le carré et placée sous le pavé du toit … est fermée par des pièces de bois et colmatée soigneusement avec de la mousse. Cette dernière partie donnant à l'intérieur du camp, il est important de bien l'isoler. La partie supérieure du pignon pouvait demeurer ouverte ou close …. Tous les bâtiments, sauf la bécosse qui n'était pas isolée, étaient construits selon le même principe."
                            }
                        ]
                    },
                    {
                        "sense_id": "36d7a538-0004-3ccc-9525-f0e4121132e6",
                        "entry_id": "6d117bb9-0768-3e5a-80b3-49bba04c5cb6",
                        "glosses": [
                            "Toilettes en général, particulièrement celles en plein air."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "note": "Ce terme est généralement utilisé au pluriel",
                        "examples": [
                            {
                                "example_id": "bdd36e5f-2759-4388-ba40-1e13e9410707",
                                "sense_id": "36d7a538-0004-3ccc-9525-f0e4121132e6",
                                "text": "J’ai besoin d’aller à la bécosse du supermarché."
                            },
                            {
                                "example_id": "c8e736de-b625-44e5-8d5f-0ddf59b5a6db",
                                "sense_id": "36d7a538-0004-3ccc-9525-f0e4121132e6",
                                "text": "[…] la vespassienne du parc Laurier, payé $72,000 (c'est cher, pour une bécosse), a été construite à même le budget régulier de la ville …."
                            }
                        ]
                    },
                    {
                        "sense_id": "21697cbb-3ca8-3501-b585-305972e69116",
                        "entry_id": "6d117bb9-0768-3e5a-80b3-49bba04c5cb6",
                        "glosses": [
                            "(Par ironie) Bâtiment méprisé."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": []
                    }
