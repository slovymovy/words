                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "cdeec53b-0a0e-30a7-af28-51ea4276ce6a",
                        "entry_id": "cdd1b199-dd03-3555-acd6-d34bffd77a4c",
                        "glosses": [
