                                                "sense_id": "684f4094-be9f-3207-9cc0-60d49332c652",
                                                "text": "Mit Techniken des Yoga lassen sich Konzentration, Selbstdisziplin und positives Denken erreichen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cae90532-b800-31f6-9b5a-f43f09e99dcf",
                                        "entry_id": "1a0a6f21-8a5a-3d13-a8c7-2e75f029dcf4",
                                        "glosses": [
                                            "eine an das so genannte westliche Denken angepasste gymnastische und meditative Sportart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "709713d4-3367-4d6f-8d59-44bdb8133ea8",
                                                "sense_id": "cae90532-b800-31f6-9b5a-f43f09e99dcf",
                                                "text": "Meine Mutter geht jeden Mittwoch zum Yoga."
                                            },
                                            {
                                                "example_id": "17014b42-e4f7-4b10-8d45-4ef295b1e5aa",
                                                "sense_id": "cae90532-b800-31f6-9b5a-f43f09e99dcf",
                                                "text": "„Heute ist dieser selbsternannte Anhänger der Janosch-eigenen Art des Buddhismus, abgehärtet durch Yoga und von der spanischen Sonne gewärmt, ein glücklicher Mensch.“"
                                            },
                                            {
                                                "example_id": "e54f007c-3d85-49f4-add8-39e4a5dddd51",
                                                "sense_id": "cae90532-b800-31f6-9b5a-f43f09e99dcf",
                                                "text": "„Yoga ist etwas Spezielles."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf99c5d0-56ff-46b5-9e66-536bebf17073",
                        "source_entry_id": "ac6a185e-a5dd-390a-b12d-460f5fd71a56",
                        "source_sense_description": "религиозно-философское учение, разработавшее особую систему приёмов и методов самопознания, позволяющую управлять психическими и физиологическими функциями своего организма",
                        "target_lang_word": "yoga",
                        "target_lang_code": "tr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yoga",
                                "target_lang_code": "tr",
                                "target_senses": [
                                    {
                                        "sense_id": "7df5e509-29e3-351d-8f08-e1c7fe818101",
                                        "entry_id": "1b5b7a1a-0c58-317a-9e4c-10a95baa3a8f",
                                        "glosses": [
                                            "Ruhî yaşama ve bedene egemen olmayı amaçlayan Hint felsefe sistemi"
                                        ],
                                        "tags": [],
