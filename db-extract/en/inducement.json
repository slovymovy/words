                "translations": [
                    {
                        "translation_id": "cb364869-bf9b-44ed-8b8f-6b7dbfe9943e",
                        "source_entry_id": "51d8204b-81a1-3d3b-b37b-30838ddc613a",
                        "source_sense_id": "ae9f0a92-7b44-3e4f-b03d-acd66fdaaf8b",
                        "source_sense_description": "Anlass",
                        "target_lang_word": "Anlass",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anlass",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34a7a836-066b-3866-abe6-6b2ab39e95d8",
                                        "entry_id": "853c65dd-b40f-3be5-8c73-575a101811a1",
                                        "glosses": [
                                            "ein Grund, der den Zweck einer Handlung oder eines Verhaltens erklärt; beziehungsweise ein Beweggrund"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "783eb6ec-5a0b-4ea4-9b23-a3b3b3d6d86d",
                                                "sense_id": "34a7a836-066b-3866-abe6-6b2ab39e95d8",
                                                "text": "Aus Anlass des 100-Geburtstages des Dichters wurde ein Fest gefeiert."
                                            },
                                            {
                                                "example_id": "1091e244-401c-44b9-a494-52b506d1ad4c",
                                                "sense_id": "34a7a836-066b-3866-abe6-6b2ab39e95d8",
                                                "text": "„Offizieller Anlass für die Amnestie waren die Feierlichkeiten zum 20. Jahrestag der russischen Verfassung am 12. Dezember.“"
                                            },
                                            {
                                                "example_id": "c6031596-a94a-4dbc-b423-c74ca4176492",
                                                "sense_id": "34a7a836-066b-3866-abe6-6b2ab39e95d8",
                                                "text": "„Deshalb sehe er auch keinen Anlass, von seinem Amt als Präsident der Länderkammer zurückzutreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "71e291c8-3fcc-3e0b-a929-d2d271f2ab65",
                                        "entry_id": "853c65dd-b40f-3be5-8c73-575a101811a1",
                                        "glosses": [
                                            "Ereignis oder Umstände, die als Anstoß dienen, etwas (ggf. bislang aufgeschobenes) zu tun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ada2066-39a8-484f-b85e-35fd65b99a43",
                                                "sense_id": "71e291c8-3fcc-3e0b-a929-d2d271f2ab65",
                                                "text": "„Wähle einfach den gewünschten Anlass aus, gebe die nötigen Einladungsdaten ein und generiere dir deinen persönlichen Einladungstext.“"
                                            },
                                            {
                                                "example_id": "bedb9d73-3c72-4d31-b6de-1d0db3fd1156",
                                                "sense_id": "71e291c8-3fcc-3e0b-a929-d2d271f2ab65",
                                                "text": "„Er glänzte bei geselligen Anlässen gerne mit haarsträubenden Anekdoten und hatte schon bald den Ruf weg, ein vorzüglicher Erzähler und großartiger Spaßvogel zu sein.“"
                                            },
                                            {
                                                "example_id": "b67a6119-6004-47f9-992d-72a4020b881b",
                                                "sense_id": "71e291c8-3fcc-3e0b-a929-d2d271f2ab65",
                                                "text": "„Zahlreiche Konflikte in der Welt illustrieren, wie lange nationale Verlusterfahrungen nachwirken, und dass sie immer wieder zum Anlass für Streitigkeiten und gewaltsame Revanche-Akte werden können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "aa5a406f-bddd-3e83-ae8d-0be191eef89d",
                                        "entry_id": "853c65dd-b40f-3be5-8c73-575a101811a1",
                                        "glosses": [
                                            "eine festliche, sportliche oder familiäre, nicht alltägliche Veranstaltung"
                                        ],
                                        "tags": [
                                            "in der Schweiz"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3624a129-08af-46cd-9f01-fd7f0befa890",
                                                "sense_id": "aa5a406f-bddd-3e83-ae8d-0be191eef89d",
                                                "text": "„Am Anlass selber verlosen wir zusätzlich einen Ferienaufenthalt für zwei Personen im Hotel Schweizerhof in Lenzerheide, Graubünden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
