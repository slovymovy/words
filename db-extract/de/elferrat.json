                            "Fastnacht"
                        ],
                        "examples": [
                            {
                                "example_id": "c4eb0b29-b53b-490d-8e16-9e472c0a927a",
                                "sense_id": "2ba8da0f-0b75-304f-96c5-17559262be97",
                                "text": "„Die männlich dominierte Domäne der Elferräte erlebt einen Wandel.“"
                            },
                            {
                                "example_id": "2ca92336-21cf-4fa9-88aa-1d8ff0c59271",
                                "sense_id": "2ba8da0f-0b75-304f-96c5-17559262be97",
                                "text": "„Dafür hat sich der Elferrat dieses Jahr etwas ganz Besonderes einfallen lassen.“"
                            },
                            {
                                "example_id": "5ad922c5-2b77-4bc6-abd3-0dfd9f087e77",
                                "sense_id": "2ba8da0f-0b75-304f-96c5-17559262be97",
                                "text": "„Der Elferrat wird in diesem Jahr aus Sitzungspräsidentinnen und Präsidenten hessischer Fastnachtsvereine gebildet.“"
                            },
                            {
                                "example_id": "0407898b-3471-483b-93a7-d22b8972ee67",
                                "sense_id": "2ba8da0f-0b75-304f-96c5-17559262be97",
                                "text": "„Zur Sitzung gehört natürlich der Elferrat, der nicht nur im Hintergrund auf der Bühne Platz nehmen, sondern die Sitzung mit einer Eröffnungsshow auf das Kommende einstimmen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
