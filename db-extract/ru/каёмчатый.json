                                        "entry_id": "d72c43ed-3a43-39dd-8c8d-c1e867efaed7",
                                        "glosses": [
                                            "Participe passé masculin singulier de lisérer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
