                        "translation_id": "93f57bd6-310f-4118-a3f0-c3166d65834e",
                        "source_entry_id": "d9f7fca8-5148-3aeb-8e01-8c4bfba75045",
                        "source_sense_id": "b7ae8a92-c1c5-3604-83b8-9d6cb5001285",
