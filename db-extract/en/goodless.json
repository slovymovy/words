                        "glosses": [
                            "Without goods or property; destitute."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "42c1d3ea-8917-43c7-8c5e-429afd4ca7a8",
                                "sense_id": "b7143e03-a5e7-3277-a984-f8010ced4a6d",
                                "text": "I have therefore declared that it is all one whether a man says \"God\" or \"good:\" he is saying the same thing in substance, and cannot be called \"godless\" until he is goodless."
                            },
                            {
                                "example_id": "b7e1bdb1-b0e5-42b1-b0df-231f56aa5f3a",
                                "sense_id": "b7143e03-a5e7-3277-a984-f8010ced4a6d",
                                "text": "It may be an exaggeration to suppose that the country deliberately injures itself a little in order to hurt the goodless town more, but it is certainly true that the peasants, farmers and landlords (where these survive) refuse to regard it as any part of their patriotic duty to make the least effort, [...]"
                            },
                            {
                                "example_id": "6337ec63-06e4-4bfa-b12d-12c48e82bb32",
                                "sense_id": "b7143e03-a5e7-3277-a984-f8010ced4a6d",
                                "text": "Punishment conceived as the logical nemesis of the criminal's principle is embedded in a goodless normative framework; that is its home."
                            }
                        ]
                    },
