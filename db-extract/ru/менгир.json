                    {
                        "translation_id": "ff08a0ca-1220-487e-adde-57dc59ba62bc",
                        "source_entry_id": "0be5a5ba-2e04-32df-b817-b57b18ff3bb7",
                        "source_sense_id": "20ad21e7-e6ad-329c-81e6-848475eecd3b",
