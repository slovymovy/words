                    }
                ],
                "translations": [
                    {
                        "translation_id": "94a0b75b-ead5-454e-8064-02d7c256aa45",
                        "source_entry_id": "6b665337-1e39-300a-8b10-aaf6e7d80bb3",
                        "source_sense_id": "0933ed02-a9df-3251-9aa8-36577019ee92",
                        "target_lang_word": "emperor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emperor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d41e0a4e-2f17-3b19-b18b-1929d92bdfb6",
                                        "entry_id": "b6ef1cfe-90ad-3276-99ec-24829ef8b406",
                                        "glosses": [
                                            "The male monarch or ruler of an empire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "352f4d10-f3b1-4bcf-aafb-157998498422",
                                                "sense_id": "d41e0a4e-2f17-3b19-b18b-1929d92bdfb6",
                                                "text": "In imperial China, it was often a responsibility of the emperor to evaluate his predecessor after the latter's death."
                                            },
                                            {
                                                "example_id": "cfa7f825-7745-4122-8432-d54c0c2ca6eb",
                                                "sense_id": "d41e0a4e-2f17-3b19-b18b-1929d92bdfb6",
                                                "text": "They asked Julius Caesar, the valiant Roman emperor, what was the best death. He answered, that which is unexpected, which comes suddenly and unforeseen"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36a4632c-5db1-3d9a-b483-ce53b74befd0",
                                        "entry_id": "b6ef1cfe-90ad-3276-99ec-24829ef8b406",
                                        "glosses": [
                                            "Any monarch ruling an empire, irrespective of gender, with \\\"empress\\\" contrasting to mean the consort of an emperor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6adb38b5-6a3e-4f8e-8449-a8f8167817d5",
                                                "sense_id": "36a4632c-5db1-3d9a-b483-ce53b74befd0",
                                                "text": "Where is Sindbad? I have a summons for him direct from the galactic emperor herself. He is to be brought here immediately to give an explanation for his recent actions."
                                            },
                                            {
                                                "example_id": "0ceaf72c-cd35-4ca1-83eb-857b8ef8f51f",
                                                "sense_id": "36a4632c-5db1-3d9a-b483-ce53b74befd0",
                                                "text": "In 690 Wu usurped the throne and became Emperor herself, which proved a unique event in the history of China."
                                            },
                                            {
                                                "example_id": "26ad612b-edd3-4ac2-a143-3720d0610a1f",
                                                "sense_id": "36a4632c-5db1-3d9a-b483-ce53b74befd0",
                                                "text": "After his death in 683 she ruled for seven years as regent and then, deposing her son, became emperor herself, the only woman in Chinese history to hold the title."
                                            },
                                            {
                                                "example_id": "4483b860-bb80-4c1c-acb0-b4ecb3a68172",
                                                "sense_id": "36a4632c-5db1-3d9a-b483-ce53b74befd0",
                                                "text": "Empress, imperial regent, and even emperor herself (r. 797–802), Irene was an important and powerful figure at the Byzantine court in the late eighth and early ninth century."
                                            },
                                            {
                                                "example_id": "dea9ddad-c31d-412b-b1d0-58a7e17f810b",
                                                "sense_id": "36a4632c-5db1-3d9a-b483-ce53b74befd0",
                                                "text": "Originally the wife of the emperor, she engineered the imperial succession so that she could serve first as regent to a boy emperor and then as emperor herself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "040639e4-84f1-37d3-a5dc-16b3d8b15d0b",
                                        "entry_id": "b6ef1cfe-90ad-3276-99ec-24829ef8b406",
                                        "glosses": [
                                            "Specifically, the ruler of the Holy Roman Empire; the world-monarch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3876069f-454f-4b6c-aee9-20b7c2f11ab9",
                                                "sense_id": "040639e4-84f1-37d3-a5dc-16b3d8b15d0b",
                                                "text": "The Investiture Controversy was a conflict between the Emperor and the Pope."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b9f05c8-6ccf-3000-9bf0-4948c05d311b",
                                        "entry_id": "b6ef1cfe-90ad-3276-99ec-24829ef8b406",
                                        "glosses": [
                                            "The fourth trump or major arcana card of the tarot deck."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bacb5470-3a03-3277-9535-fb957293c037",
                                        "entry_id": "b6ef1cfe-90ad-3276-99ec-24829ef8b406",
                                        "glosses": [
                                            "A large, relatively valuable marble in children's games."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26f9f86d-145d-4866-81e3-12bafbe60005",
                                                "sense_id": "bacb5470-3a03-3277-9535-fb957293c037",
                                                "text": "But marbles are not only used to play games: they are also traded. In this market, the value of the different kinds of marbles (oilies, emperors, etc.) is determined by local supply and demand and not by the price of the marbles […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d29f97ff-dab0-3d54-9e3f-3eba900c461f",
                                        "entry_id": "b6ef1cfe-90ad-3276-99ec-24829ef8b406",
                                        "glosses": [
                                            "Any fish of the family Lethrinidae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1545d345-e31b-3483-93f8-39188f1c0212",
                                        "entry_id": "b6ef1cfe-90ad-3276-99ec-24829ef8b406",
                                        "glosses": [
                                            "Any of various butterflies of the subfamily Charaxinae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81a35fc4-c83d-3a6e-8557-ec485c96f79e",
                                        "entry_id": "b6ef1cfe-90ad-3276-99ec-24829ef8b406",
                                        "glosses": [
                                            "Any of various large dragonflies of the cosmopolitan genus Anax."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a6f90c1-bb48-394c-b96b-e2514045265e",
                                        "entry_id": "b6ef1cfe-90ad-3276-99ec-24829ef8b406",
                                        "glosses": [
                                            "An emperor penguin (Aptenodytes forsteri)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "317dff1d-3444-4244-ad6d-9861e0ecc910",
                                                "sense_id": "5a6f90c1-bb48-394c-b96b-e2514045265e",
                                                "text": "During pairing, mates walk an average of only 90 m per day, and, while incubating, male emperors move an average of 30 m per day."
                                            },
                                            {
                                                "example_id": "c30d1006-a5b2-45fd-8a24-885a581ab4ec",
                                                "sense_id": "5a6f90c1-bb48-394c-b96b-e2514045265e",
                                                "text": "We do not know if the emperors are monogamous. I know some of the penguins species mate for life."
                                            },
                                            {
                                                "example_id": "19a0a0d6-6a5a-494b-8bbd-915c855187a8",
                                                "sense_id": "5a6f90c1-bb48-394c-b96b-e2514045265e",
                                                "text": "If they were emperors, I wanted a better view. Being told they were emperors was no good; I needed to see them. But as quickly as we had spotted them, they spotted us. Sliding on their bellies, two emperors began to rush over."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0102dec0-aaec-4e38-8639-61b4e95b9d42",
                        "source_entry_id": "6b665337-1e39-300a-8b10-aaf6e7d80bb3",
                        "source_sense_id": "0933ed02-a9df-3251-9aa8-36577019ee92",
                        "target_lang_word": "imperator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imperator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e902f14c-b4f0-38ce-87d0-48b6f130e24f",
                                        "entry_id": "5c600a9b-cbc9-3075-b316-a08551617e62",
                                        "glosses": [
                                            "An emperor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24e5075c-74f0-4dee-972e-0b4400e43736",
                                                "sense_id": "e902f14c-b4f0-38ce-87d0-48b6f130e24f",
                                                "text": "But to compensate in some degree for what was then taken away, the custom was introduced of bestowing what was termed Triumphalia Ornamenta, that is, permission to receive the titles bestowed upon, and to appear in public with the robes worn by the imperatores of the commonwealth when they triumphed, and to bequeath to their descendants triumphal statues."
                                            },
                                            {
                                                "example_id": "11fdbcf3-f783-4a95-8e9c-4e0fa15f56ea",
                                                "sense_id": "e902f14c-b4f0-38ce-87d0-48b6f130e24f",
                                                "text": "Modern emperors and consuls of the year VIII. are no more the imperatores of ancient Rome, and modern religious organizations are but the phantasms of mediæval corporations."
                                            },
                                            {
                                                "example_id": "3e31c3f3-d49d-43cb-95e6-be619bf965ec",
                                                "sense_id": "e902f14c-b4f0-38ce-87d0-48b6f130e24f",
                                                "text": "He said cautiously, \"I do not think it right, Imperator.\""
                                            },
                                            {
                                                "example_id": "885a4924-b82c-43dd-b182-e2b2b2094078",
                                                "sense_id": "e902f14c-b4f0-38ce-87d0-48b6f130e24f",
                                                "text": "Given the sudden proliferation of self-portraits on the coins of all the imperatores of this period, many of whom certainly had not received such a privilege, such an unattested grant to Antony need not be assumed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6e980e4-06d6-4c3d-8949-f2e061ca294d",
                        "source_entry_id": "6b665337-1e39-300a-8b10-aaf6e7d80bb3",
                        "source_sense_id": "0933ed02-a9df-3251-9aa8-36577019ee92",
                        "target_lang_word": "imperátor",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c92ffd12-4f16-48d1-b0a8-0d46ae557aa6",
                        "source_entry_id": "6b665337-1e39-300a-8b10-aaf6e7d80bb3",
                        "source_sense_id": "0933ed02-a9df-3251-9aa8-36577019ee92",
                        "target_lang_word": "císař",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "císař",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "841cac60-5675-3173-9763-c1f029377d8b",
                                        "entry_id": "05cb72a6-4826-3c99-b1e8-68532e52333f",
                                        "glosses": [
                                            "titul panovníka, nadřazeného králům"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d60d8fd-acf6-42df-810f-7687120d6032",
                                                "sense_id": "841cac60-5675-3173-9763-c1f029377d8b",
                                                "text": "Říšskému císaři zachtělo se pokladů, kterých byl předešlého léta český kníže bojovnou rukou v Polsku vydobyl."
                                            },
                                            {
                                                "example_id": "da58f595-963e-4831-9a10-45fa8af12182",
                                                "sense_id": "841cac60-5675-3173-9763-c1f029377d8b",
                                                "text": "Mínilť podrobiti císaři celou říši německou, tak aby jí vládnouti mohl podobně neobmezeně jako dědičným panstvím svým."
                                            },
                                            {
                                                "example_id": "de90f494-dc6f-464a-b4f6-0e14f4086eb0",
                                                "sense_id": "841cac60-5675-3173-9763-c1f029377d8b",
                                                "text": "Dávejte tedy, co je císařovo, císaři, a co je boží, Bohu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87ba2bda-90f8-3518-bbc3-f36e49082d3c",
                                        "entry_id": "05cb72a6-4826-3c99-b1e8-68532e52333f",
                                        "glosses": [
                                            "císařský řez, operativní porod"
                                        ],
                                        "tags": [
                                            "colloquially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4909d0e-de5b-4197-bc14-c528324e25ad",
                                                "sense_id": "87ba2bda-90f8-3518-bbc3-f36e49082d3c",
                                                "text": "Maruna rodila císařem."
                                            },
                                            {
                                                "example_id": "c3f40de7-457b-42d9-ad56-32ee0c49f6d6",
                                                "sense_id": "87ba2bda-90f8-3518-bbc3-f36e49082d3c",
                                                "text": "Po dvou dětech a dvou císařích mě trápí větší bříško, které se mi nedaří dát dolů."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9bf0a4f2-934f-472b-af00-32179e94a97b",
                        "source_entry_id": "6b665337-1e39-300a-8b10-aaf6e7d80bb3",
                        "source_sense_id": "0933ed02-a9df-3251-9aa8-36577019ee92",
                        "target_lang_word": "empereur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empereur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3440a3d4-e33f-3159-b10d-7f8e3864c424",
                                        "entry_id": "07def407-ea0e-3fc4-b285-c991652ba3fe",
                                        "glosses": [
                                            "Souverain d’un empire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a8f80f5-6bdd-4922-bda9-bf591c00650f",
                                                "sense_id": "3440a3d4-e33f-3159-b10d-7f8e3864c424",
                                                "text": "Quoique la puissance et les richesses d’un Empereur de la Chine soient presque immenses, il était frugal dans ses repas, et éloigné de tout luxe pour sa personne; […]."
                                            },
                                            {
                                                "example_id": "09df345c-2d8f-4705-8db4-205b68c1da50",
                                                "sense_id": "3440a3d4-e33f-3159-b10d-7f8e3864c424",
                                                "text": "[…] le comte Karl arrivait de Flandre, où il était allé, sur l’ordre de l’empereur Louis V de Bavière, prêter le secours de sa vaillante épée à Édouard III d’Angleterre, nommé, dix-huit mois auparavant, vicaire général de l’Empire, […]."
                                            },
                                            {
                                                "example_id": "025e3a51-7ee3-4efe-bb95-e26512379346",
                                                "sense_id": "3440a3d4-e33f-3159-b10d-7f8e3864c424",
                                                "text": "Seulement la paix ne se faisait jamais ; une guerre finie, on en commençait une autre. Il nous manquait toujours quelque chose, soit du côté de la Russie, soit du côté de l’Espagne ou ailleurs ; — L’Empereur n’était jamais content."
                                            },
                                            {
                                                "example_id": "e8423e0d-a5c1-49a4-9413-086e51622da9",
                                                "sense_id": "3440a3d4-e33f-3159-b10d-7f8e3864c424",
                                                "text": "Et la France changeait, une fois encore, de régime. Le prince-président que s'était donnée la Deuxième République était devenu l’empereur Napoléon, troisième du nom."
                                            },
                                            {
                                                "example_id": "1aa678f8-e025-479b-bda0-114071527ef2",
                                                "sense_id": "3440a3d4-e33f-3159-b10d-7f8e3864c424",
                                                "text": "Curieuse pendule en métal patiné représentant satyriquement Ménélik II, empereur d’Éthiopie entre 1889 et 1913. Le mouvement et le cadran inscrit dans son ventre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7aa95c7-c700-3e5e-889d-d1c81b991ade",
                                        "entry_id": "07def407-ea0e-3fc4-b285-c991652ba3fe",
