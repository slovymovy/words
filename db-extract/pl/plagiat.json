                                "target_word": "plagiarism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86d7e140-92a1-3e50-a4f0-fdb7fca264a6",
                                        "entry_id": "11d7a82a-d958-3716-8871-dba60f8a9798",
                                        "glosses": [
                                            "Copying of another person's ideas, text, or other creative work, and presenting it as one's own, especially without permission; plagiarizing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36384008-6f88-412e-9b45-a44714b0041c",
                                                "sense_id": "86d7e140-92a1-3e50-a4f0-fdb7fca264a6",
                                                "text": "Even if it's not illegal, plagiarism is usually frowned upon."
                                            },
                                            {
                                                "example_id": "23409f7e-474a-4b6d-bbc2-c25c71b6d79e",
                                                "sense_id": "86d7e140-92a1-3e50-a4f0-fdb7fca264a6",
                                                "text": "Copy from one, it's plagiarism. Copy from two, it's research."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43501afa-cd65-3b10-b3bd-da7284504042",
                                        "entry_id": "11d7a82a-d958-3716-8871-dba60f8a9798",
                                        "glosses": [
                                            "Text or other work resulting from this act."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "439e3962-0918-4554-89a3-b82029ce1294",
                                                "sense_id": "43501afa-cd65-3b10-b3bd-da7284504042",
                                                "text": "The novel was awash in plagiarism, with entire passages lifted verbatim."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bbc384f-3b56-339f-8d3c-71fba04f1438",
                                        "entry_id": "11d7a82a-d958-3716-8871-dba60f8a9798",
                                        "glosses": [
                                            "The instance of plagiarism."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9056a99d-486e-49a1-a9b8-6dd1e90324fe",
                        "source_entry_id": "da03e79e-99f2-3f79-8c1c-67fde7f8ed18",
                        "source_sense_id": "22ba0c85-c215-3ac8-aac5-9d125a7eac8a",
                        "target_lang_word": "plagiat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plagiat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2776f992-eceb-33d6-bde8-5967c79daf0b",
                                        "entry_id": "5b7674d9-7453-3967-8a58-028331124b8e",
                                        "glosses": [
                                            "Action du plagiaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b1b9df8-42b2-4223-8106-07ead20054b7",
                                                "sense_id": "2776f992-eceb-33d6-bde8-5967c79daf0b",
                                                "text": "Ainsi, dans de nombreuses institutions, tous les mémoires sont systématiquement soumis au logiciel de détection de plagiat Ephorus avant transmission aux enseignants."
                                            },
                                            {
                                                "example_id": "4db60eb1-e911-4d9b-82fc-cdc76ffeaae4",
                                                "sense_id": "2776f992-eceb-33d6-bde8-5967c79daf0b",
                                                "text": "Cet auteur est accusé de plagiat."
                                            },
                                            {
                                                "example_id": "5060cb30-fc98-4886-8254-97c7858575a1",
                                                "sense_id": "2776f992-eceb-33d6-bde8-5967c79daf0b",
                                                "text": "Il dissimule adroitement ses plagiats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "833ae9e8-1560-33e0-b900-d9962505cc49",
                                        "entry_id": "5b7674d9-7453-3967-8a58-028331124b8e",
                                        "glosses": [
                                            "Emprunt à d’autres auteurs, des citations, des passages de quelque importance en les donnant comme siens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebab0740-32fe-417c-bde9-32dfeb40f7da",
                                                "sense_id": "833ae9e8-1560-33e0-b900-d9962505cc49",
                                                "text": "Paul Lucas l’a copié mot à mot, sans avertir du plagiat, selon sa coutume"
                                            },
                                            {
                                                "example_id": "932836fc-309e-45e5-9075-0ca4ee7dfb1a",
                                                "sense_id": "833ae9e8-1560-33e0-b900-d9962505cc49",
                                                "text": "Dans une interview donnée au Figaro Magazine du 6 avril 2013, le conseillé [sic] de Nicolas SARKOZY, Patrick BUISSON, a inauguré une variante inédite du plagiat en reprenant dans ses réponses des passages entiers du livre d’un prof de droit, Jean Louis Harouel : \" Le vrai génie du christianisme\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "033e3e14-d936-41d1-936a-ad6da91f28dd",
                        "source_entry_id": "da03e79e-99f2-3f79-8c1c-67fde7f8ed18",
                        "source_sense_id": "22ba0c85-c215-3ac8-aac5-9d125a7eac8a",
                        "target_lang_word": "plagio",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plagio",
