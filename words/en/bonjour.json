{
    "word_family": [],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "c4acc9da-02a2-34d3-82d9-88304d3c2f12",
                    "sense_definition": "Used as a greeting to say hello or good morning, often playfully or to evoke French culture.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "greeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She walked into the bakery with a cheerful smile and said, \"<w>Bonjour</w>, everyone!\"",
                            "target_lang_translations": {
                                "fr": "Elle est entrée dans la boulangerie avec un sourire éclatant et a dit : « <w>Bonjour</w> à tous ! »"
                            }
                        },
                        {
                            "text": "\"<w>Bonjour</w>! How are you doing today?\" he asked warmly as we met.",
                            "target_lang_translations": {
                                "fr": "« <w>Bonjour</w> ! Comment allez-vous aujourd'hui ? » demanda-t-il chaleureusement lorsque nous nous sommes croisés."
                            }
                        }
                    ],
                    "synonyms": [
                        "hello",
                        "good morning"
                    ],
                    "antonyms": [
                        "goodbye"
                    ],
                    "common_phrases": [
                        "say bonjour"
                    ],
                    "target_lang_definitions": {
                        "fr": "Formule de salutation utilisée pendant la journée pour dire bonjour."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "bonjour",
                                "target_lang_sense_clarification": "salutation standard"
                            },
                            {
                                "target_lang_word": "salut",
                                "target_lang_sense_clarification": "salutation informelle"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3c8a52e6-8588-354e-9297-112a33592850",
                    "sense_definition": "To greet someone using the French word \"bonjour\".",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "greeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He strolled along the boulevard, <w>bonjouring</w> every neighbor who passed him by.",
                            "target_lang_translations": {
                                "fr": "Il flânait sur le boulevard, <w>disant bonjour à</w> chaque voisin qui le croisait."
                            }
                        },
                        {
                            "text": "The visitor <w>bonjoured</w> the host politely before sitting at the table.",
                            "target_lang_translations": {
                                "fr": "Le visiteur <w>salua</w> poliment l'hôte avant de s'asseoir à table."
                            }
                        }
                    ],
                    "synonyms": [
                        "greet"
                    ],
                    "target_lang_definitions": {
                        "fr": "Saluer quelqu'un en lui disant « bonjour »."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "dire bonjour",
                                "target_lang_sense_clarification": "adresser une salutation"
                            },
                            {
                                "target_lang_word": "saluer",
                                "target_lang_sense_clarification": "action générale de saluer"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
