                "senses": [
                    {
                        "sense_id": "91cf38fe-169d-365c-9e70-ad9d03cda2ba",
                        "entry_id": "b2d9f4fa-73bd-3c01-8919-d9b62ef19dfe",
                        "glosses": [
                            "buyer, purchaser"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ce0dcbf7-1b3b-4a1a-9441-8371a08dc1b4",
                                "sense_id": "91cf38fe-169d-365c-9e70-ad9d03cda2ba",
                                "text": "— Смотри́ ж, Соло́пий: че́рез час я бу́ду к тебе́; а тепе́рь ступа́й домо́й: там ожида́ют тебя́ покупщики́ твое́й кобы́лы и пшени́цы!",
                                "translation": "Nikolai Gogol",
                                "english": "Nikolai Gogol"
                            },
                            {
                                "example_id": "3e16006d-f49d-4593-bed2-5635f9b63370",
                                "sense_id": "91cf38fe-169d-365c-9e70-ad9d03cda2ba",
                                "text": "Покупщи́к бу́дет дава́ть за бе́дного зверька́ о́чень мно́го де́нег, но продаве́ц до́лжен тре́бовать непреме́нно то́лько рубль, — ни бо́льше, ни ме́ньше как оди́н сере́бряный рубль. Покупщи́к бу́дет навя́зывать бо́лее, но на́до насто́йчиво тре́бовать рубль, и когда́, наконе́ц, э́тот рубль бу́дет дан, тогда́ его́ на́до положи́ть в карма́н и держа́ть руко́ю, а самому́ уходи́ть как мо́жно скоре́е и не огля́дываться.",
                                "translation": "Nikolai Leskov",
                                "english": "Nikolai Leskov"
                            }
                        ]
                    }
