                {
                    "sense_id": "61982b4a-84fb-30f7-964d-a2444f93f90e",
                    "sense_definition": "Een officieel verdrag dat een einde maakt aan een oorlog.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "treaty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>vrede</w> werd getekend in een neutraal land.",
                            "target_lang_translations": {
                                "en": "The <w>peace</w> was signed in a neutral country.",
                                "ru": "<w>Мир</w> был подписан в нейтральной стране.",
                                "pl": "<w>Pokój</w> został podpisany w neutralnym kraju.",
                                "de": "Der <w>Frieden</w> wurde in einem neutralen Land unterzeichnet.",
                                "fr": "La <w>paix</w> a été signée dans un pays neutre.",
                                "it": "La <w>pace</w> è stata firmata in un paese neutrale.",
                                "cs": "<w>Mír</w> byl podepsán v neutrální zemi.",
                                "tr": "<w>Barış antlaşması</w> tarafsız bir ülkede imzalandı.",
                                "es": "La <w>paz</w> se firmó en un país neutral."
                            }
                        },
                        {
                            "text": "Deze <w>vrede</w> zorgde voor nieuwe grenzen in Europa.",
                            "target_lang_translations": {
                                "en": "This <w>peace</w> created new borders in Europe.",
                                "ru": "Этот <w>мир</w> установил новые границы в Европе.",
                                "pl": "Ten <w>pokój</w> przyniósł nowe granice w Europie.",
                                "de": "Dieser <w>Friedensvertrag</w> sorgte für neue Grenzen in Europa.",
                                "fr": "Cette <w>paix</w> a créé de nouvelles frontières en Europe.",
                                "it": "Questa <w>pace</w> ha stabilito nuovi confini in Europa.",
                                "cs": "Tento <w>mír</w> vytvořil nové hranice v Evropě.",
                                "tr": "Bu <w>barış</w> Avrupa'da yeni sınırların çizilmesini sağladı.",
                                "es": "Esta <w>paz</w> trajo consigo nuevas fronteras en Europa."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An official treaty that ends a war.",
                        "ru": "Официальный договор, который кладет конец войне.",
                        "pl": "Oficjalny traktat kończący wojnę.",
