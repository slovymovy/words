                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2740e6f9-f163-355c-9351-da56bd185a90",
                        "entry_id": "56738b61-4532-3e3b-b2db-d6ea66629c89",
                        "glosses": [
                            "Saisir, accrocher fermement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "535b2305-885e-43db-89dc-3d14270616e7",
                                "sense_id": "2740e6f9-f163-355c-9351-da56bd185a90",
                                "text": "Quand il m’a agriché sur la pelouse à Auteuil alors que j’étais en train d’essayer de lui faire son porte-pèze, je m’attendais pas à ce que j’aurais à travailler pour son compte."
                            },
                            {
                                "example_id": "02918d74-2280-48d4-a5ba-c8856fbe818d",
                                "sense_id": "2740e6f9-f163-355c-9351-da56bd185a90",
                                "text": "Puis, ayant pas de temps à gaspiller j’ai ouvert sa portière et l’ai agriché à la cravate, tirant à moi d’un coup sec."
                            }
                        ]
                    }
