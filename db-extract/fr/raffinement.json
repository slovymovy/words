        "fr-extract.jsonl": [
            {
                "entry_id": "fef0ec54-4342-3170-bf57-75ae14b316f7",
                "word": "raffinement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "02615031-2546-450f-8a47-502020210e4e",
                        "entry_id": "fef0ec54-4342-3170-bf57-75ae14b316f7",
                        "tags": [
                            "plural"
                        ],
                        "form": "raffinements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "731d4a46-5c3d-3b43-88bb-bf1b07eb1424",
                        "entry_id": "fef0ec54-4342-3170-bf57-75ae14b316f7",
                        "glosses": [
                            "Extrême subtilité ; délicatesse particulière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff1566a0-98c0-4434-bff9-cc60002af3fd",
                                "sense_id": "731d4a46-5c3d-3b43-88bb-bf1b07eb1424",
                                "text": "Depuis son installation, assez récente, à Paris, où il habitait un magnifique hôtel, avenue de Friedland, il avait fait venir au Havre son beau yacht, le dernier raffinement du suprême confort, qui autrefois chauffait dans le port de New-York, toujours prêt à lever l'ancre."
                            },
                            {
                                "example_id": "c8b17db6-126d-4a97-90c6-fec138e61dc8",
                                "sense_id": "731d4a46-5c3d-3b43-88bb-bf1b07eb1424",
                                "text": "La délicatesse de son langage va jusqu’au raffinement."
                            },
                            {
                                "example_id": "0b5f5ad5-fabf-439c-be06-423cd7b462af",
                                "sense_id": "731d4a46-5c3d-3b43-88bb-bf1b07eb1424",
                                "text": "Les raffinements du style, des manières, du goût."
                            }
                        ]
                    },
                    {
                        "sense_id": "013ebd4c-60eb-3f46-8414-88cd32ea258e",
                        "entry_id": "fef0ec54-4342-3170-bf57-75ae14b316f7",
                        "glosses": [
                            "Excès de recherche que l’on met en certaines actions, en certaines habitudes de la vie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "424cd4f0-ad1a-4fa7-96c0-f5808d2551b4",
                                "sense_id": "013ebd4c-60eb-3f46-8414-88cd32ea258e",
                                "text": "Les raffinements du luxe. Un raffinement de cruauté."
                            },
                            {
                                "example_id": "a591bcfe-b9b1-44b9-8d6e-22e377d5aa10",
                                "sense_id": "013ebd4c-60eb-3f46-8414-88cd32ea258e",
                                "text": "La flagellation avait pour fonction déterminante de « préparer » le supplice de la crucifixion. Elle supposait un abominable raffinement puisque tout l’art du bourreau consistait à châtier le condamné, sans l’achever prématurément."
                            }
                        ]
                    },
                    {
                        "sense_id": "49c1a2d0-0aaa-3985-bc4d-6647b78d6905",
                        "entry_id": "fef0ec54-4342-3170-bf57-75ae14b316f7",
                        "glosses": [
                            "Choses raffinées."
                        ],
                        "tags": [
                            "broadly",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "fb2f0498-c3dc-4a97-90e1-f5a32c56d153",
                                "sense_id": "49c1a2d0-0aaa-3985-bc4d-6647b78d6905",
                                "text": "La foule entend désormais jouir des raffinements réservés naguère à de peu nombreux privilégiés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "babd9c84-258c-4c30-b3d3-ca9b38f937a0",
                        "source_entry_id": "fef0ec54-4342-3170-bf57-75ae14b316f7",
                        "source_sense_description": "Extrême subtilité, délicatesse",
                        "target_lang_word": "Raffinesse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Raffinesse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b1621f18-9865-3300-b065-9984293afedf",
                                        "entry_id": "6ffcceec-0fde-3abc-9707-8385a73c88e3",
                                        "glosses": [
                                            "Raffinement"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e1da3f0-6f46-4914-b370-d78f625fa2a5",
                                                "sense_id": "b1621f18-9865-3300-b065-9984293afedf",
                                                "text": "Sie planten ihren Coup mit großer Raffinesse."
                                            },
                                            {
                                                "example_id": "10a6adc3-f705-4a66-ba3e-a395a7faa5f1",
                                                "sense_id": "b1621f18-9865-3300-b065-9984293afedf",
                                                "text": "„In der Körpersprache der Internationalität verständigten sie sich lückenlos, Jottpee war in der Liebe eine delikate Mischung von Naturtalent und Raffinesse.“"
                                            },
                                            {
                                                "example_id": "3649f980-01ad-4d68-912c-eed6fe8d3a31",
                                                "sense_id": "b1621f18-9865-3300-b065-9984293afedf",
                                                "text": "„Schnöseldeutsch ist die Haltung, durch verkorksten Ausdruck den Eindruck von Raffinesse machen zu wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1ef753e4-f6ea-33e5-9dc1-2f47ae5278c7",
                                        "entry_id": "6ffcceec-0fde-3abc-9707-8385a73c88e3",
                                        "glosses": [
                                            "mit allem praktischen und bequemen Zubehör, mit allen Feinheiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3b4e8fd-b429-476e-a285-078ac4731ab1",
                                                "sense_id": "1ef753e4-f6ea-33e5-9dc1-2f47ae5278c7",
                                                "text": "Die Hose ist mit allen möglichen Raffinessen versehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "754f7a88-eae4-4336-a595-41e569d1287e",
                        "source_entry_id": "fef0ec54-4342-3170-bf57-75ae14b316f7",
