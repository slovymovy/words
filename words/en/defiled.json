                    "sense_definition": "Made unclean, impure, or ruined; desecrated or corrupted.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monks wept when they saw the <w>defiled</w> temple after the raid.",
                            "target_lang_translations": {
