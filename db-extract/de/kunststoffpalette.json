                ],
                "senses": [
                    {
                        "sense_id": "b4250810-30b2-3d09-a7ab-95844f611a1c",
                        "entry_id": "a1a153d7-c209-33a5-9e28-c55aee0f061a",
                        "glosses": [
                            "Palette aus Kunststoff"
                        ],
                        "tags": [
                            "Verkehr",
                            "Handel",
                            "Logistik"
                        ],
                        "examples": [
                            {
                                "example_id": "25f7dd2e-8ef8-4615-9ce2-2d7db647ccf4",
                                "sense_id": "b4250810-30b2-3d09-a7ab-95844f611a1c",
                                "text": "„Bei Kunststoffpaletten bzw. Europaletten aus Kunststoff gibt es keine hervorstehenden Nägel oder Splitter, die die Ware beschädigen oder sogar einen Mitarbeiter verletzen könnten.“"
                            },
                            {
                                "example_id": "922b85cd-a590-4008-a8bf-dc986e2116d5",
                                "sense_id": "b4250810-30b2-3d09-a7ab-95844f611a1c",
                                "text": "„Paletten wie die angebotenen Kunststoffpaletten bzw. Recyclingkunststoffpaletten, Europaletten oder Exportpaletten werden in den unterschiedlichsten Branchen benötigt.“"
                            },
                            {
                                "example_id": "d4c0dcd9-aeec-4d66-a8f1-36b90ff76e7a",
                                "sense_id": "b4250810-30b2-3d09-a7ab-95844f611a1c",
                                "text": "„Die Tragfähigkeit einer neuwertigen Holzpalette ist mit der Tragfähigkeit einer guten Kunststoffpalette durchaus vergleichbar.“"
                            },
                            {
                                "example_id": "4534b7ac-3d6b-4a03-b60e-18f4d0e7a095",
                                "sense_id": "b4250810-30b2-3d09-a7ab-95844f611a1c",
                                "text": "„Aufgrund ihres geringen Gewichts, ihrer Beständigkeit und ihrer hervorragenden Hygieneeigenschaften haben Kunststoffpaletten, die es in zahlreichen weiteren Ausführungen gibt, daneben auch in vielen weiteren Industrien ihren Platz gefunden.“"
                            },
                            {
                                "example_id": "1c0ca4d3-34d9-45a1-84e3-4a0826fdfe2b",
                                "sense_id": "b4250810-30b2-3d09-a7ab-95844f611a1c",
                                "text": "Die Kunststoffpaletten verfügen für den Stand und den Transport über je drei Kufen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
