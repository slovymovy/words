                                        "entry_id": "04c46e15-97fd-34c9-a5ab-151f6f153f66",
                                        "glosses": [
                                            "Itchy, swollen, red areas of the skin which can appear quickly in response to an allergen or due to other conditions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f08fd537-896f-45eb-aed8-a374a99f92b5",
                                                "sense_id": "6e137d85-2500-3bed-bf69-163e189c9bab",
                                                "text": "Poor kids. Only troubles wildfire and nettlerash."
                                            },
                                            {
                                                "example_id": "8f779632-2e79-448d-8ba9-10d1f6444442",
                                                "sense_id": "6e137d85-2500-3bed-bf69-163e189c9bab",
                                                "text": "They and their relatives ate peanuts till they were covered in nettle-rash."
                                            },
                                            {
                                                "example_id": "8f7f123f-6751-40c0-8133-bbc88355bd52",
                                                "sense_id": "6e137d85-2500-3bed-bf69-163e189c9bab",
                                                "text": "His skin was covered with little bumps as though from a nettle rash. I looked for the tick he had flung away. It was black and swollen from old blood and it seemed clear that this infected blood had got into the wound and caused acute blood poisoning."
                                            },
                                            {
                                                "example_id": "db153d0a-0348-42d0-9e38-2304c31048b7",
                                                "sense_id": "6e137d85-2500-3bed-bf69-163e189c9bab",
                                                "text": "His colour is changing now, he does not have to look in the mirror, it's like a nettle-rash rising, scalding, scalding."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
