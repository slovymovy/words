                "senses": [
                    {
                        "sense_id": "9e889598-434e-349b-8f13-db0e4ff8818f",
                        "entry_id": "826b0a97-2729-385d-b9b7-847706475538",
                        "glosses": [
                            "разг., сниж. то же, что любовник; возлюбленный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67ecf042-b13d-46a6-9ba2-8f5d4fa8ef23",
                                "sense_id": "9e889598-434e-349b-8f13-db0e4ff8818f",
                                "text": "— А говорят, — продолжал Костя, — Акулина оттого в реку и кинулась, что её полюбовник обманул."
                            },
                            {
                                "example_id": "1836cecf-d51a-4b68-8a11-a1e12a58cb7d",
                                "sense_id": "9e889598-434e-349b-8f13-db0e4ff8818f",
                                "text": "[Бабушка Авдотья (жен, бабушка Насти и Любуши)] И мужа-то ещё не припасла, а о полюбовнике уже думает."
                            },
                            {
                                "example_id": "af4e525a-0a8a-4a38-8be2-eb6490a50d62",
                                "sense_id": "9e889598-434e-349b-8f13-db0e4ff8818f",
                                "text": "И полюбовников, полюбовников было у этой самой Нинон, и не сосчитаешь, и нисколько она того ни от кого не таила."
                            }
                        ]
                    }
                ],
