                                "sense_id": "84cd87d7-36f5-3947-b2dd-85f2f6302541",
                                "text": "The harshness of the judge's penalty shocked the whole town."
                            }
                        ]
                    },
                    {
                        "sense_id": "cdf8c32c-2261-3c74-9a53-eea45b03004b",
