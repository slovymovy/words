                    }
                ],
                "senses": [
                    {
                        "sense_id": "1290735d-d10b-30b2-91c9-801341036e44",
                        "entry_id": "fbd0fb91-d612-3dcc-b1d3-a874ec1ba459",
                        "glosses": [
                            "zażarta dyskusja, w której argumenty merytoryczne nie mają znaczenia"
                        ],
                        "tags": [
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "a00a02e7-775c-4257-acea-dbfefda907ef",
                                "sense_id": "1290735d-d10b-30b2-91c9-801341036e44",
                                "text": "Kiedyś wdawałem się w gównoburze z antyszczepionkowcami, ale teraz uważam, że to bez sensu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e71519a4-854c-47aa-8306-8a4128fab4d4",
                        "source_entry_id": "fbd0fb91-d612-3dcc-b1d3-a874ec1ba459",
                        "source_sense_id": "1290735d-d10b-30b2-91c9-801341036e44",
                        "target_lang_word": "shitstorm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shitstorm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d45ad210-e2e4-37d4-ad2d-58232db62c81",
                                        "entry_id": "a12f8948-9ec0-30ba-a410-418fbf6e896e",
                                        "glosses": [
                                            "A chaotic and unpleasant or violent situation."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06b7dbcf-9c5b-4a50-80c3-bcf57cadd5e0",
                                                "sense_id": "d45ad210-e2e4-37d4-ad2d-58232db62c81",
                                                "text": "The hell with Brown […] He's been missing all the shit storms. It's his turn."
                                            },
                                            {
                                                "example_id": "249d2fdb-68d7-4b0d-9bc4-22edbb5d6d3e",
                                                "sense_id": "d45ad210-e2e4-37d4-ad2d-58232db62c81",
                                                "text": "'Sometimes the pool-pah,' Bokonon tells us, 'exceeds the power of humans to comment.' Bokonon translates pool-pah at one point in The Books of Bokonon as 'shit storm' and at another point as 'wrath of God'."
                                            },
                                            {
                                                "example_id": "6564db1d-2571-41b0-895d-1c42310397ea",
                                                "sense_id": "d45ad210-e2e4-37d4-ad2d-58232db62c81",
                                                "text": "“...seem’s he’s been tumbling ass over teakettle—though there’s no way to tell in this murky shitstorm, no visual references...”"
                                            },
                                            {
                                                "example_id": "389cc9df-7a43-426f-9d60-5d72e82c5e7a",
                                                "sense_id": "d45ad210-e2e4-37d4-ad2d-58232db62c81",
                                                "text": "\"You and your cowboys just stirred up a shitstorm, agent.\""
                                            },
                                            {
                                                "example_id": "b7f5ed0f-fe7f-486c-81e5-90963ae1695c",
                                                "sense_id": "d45ad210-e2e4-37d4-ad2d-58232db62c81",
                                                "text": "In Baltimore, the general rule is that if something looks like a shitstorm, smells like a shitstorm and tastes like a shitstorm, it goes to homicide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a88aa21-a954-345f-83e4-92550dddec5c",
                                        "entry_id": "a12f8948-9ec0-30ba-a410-418fbf6e896e",
                                        "glosses": [
                                            "Considerable backlash from the public."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "632e3aa2-c56d-412d-ae22-5adaf29ae73b",
                                                "sense_id": "7a88aa21-a954-345f-83e4-92550dddec5c",
                                                "text": "When Abbott stated openly that his plan involved a new tax of 1.7% on large companies with big profit margins - those, in fact, most able to pay - he provoked a near universal shitstorm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b355f1a6-d1da-46d1-bf28-1a84bcc389fd",
                        "source_entry_id": "fbd0fb91-d612-3dcc-b1d3-a874ec1ba459",
                        "source_sense_id": "1290735d-d10b-30b2-91c9-801341036e44",
                        "target_lang_word": "Shitstorm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Shitstorm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03f9e393-b1b7-3adb-908e-f05b46baeab7",
                                        "entry_id": "d64e986e-0466-3e22-aab2-69a2f00fb612",
                                        "glosses": [
                                            "massenhafte, im Internet geäußerte Empörung gegenüber einer Person, Institution oder einem Konzern in Form von Postings, Kommentaren, Blogbeiträgen und so weiter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ba210ad-d24b-478b-9204-6b1018140c5c",
                                                "sense_id": "03f9e393-b1b7-3adb-908e-f05b46baeab7",
                                                "text": "„Gabriel hatte sich von einem Besuch in Hebron so erschüttert gezeigt, dass er auf Facebook Israel vorwarf, ein Apartheidsystem zu sein. Das hatte einen Shitstorm zur Folge, sodass sich der SPD-Chef genötigt sah, sich zu entschuldigen.“"
                                            },
                                            {
                                                "example_id": "25952ddd-b43c-4399-b6ba-66e9d455a0cf",
                                                "sense_id": "03f9e393-b1b7-3adb-908e-f05b46baeab7",
                                                "text": "„Der hohe Redeanteil der ARD-Kommentatoren bei der Olympia-Abschlussfeier hat offenbar viele Zuschauer genervt: Im Netz brach deswegen ein Shitstorm los.“"
                                            },
                                            {
                                                "example_id": "a449e414-a114-4db4-aa4c-11b4bfca0e40",
                                                "sense_id": "03f9e393-b1b7-3adb-908e-f05b46baeab7",
                                                "text": "„Das heutige Prangerstehen heißt »Shitstorm« und spielt sich mit gnadenloser Härte im Internet ab.“"
                                            },
                                            {
                                                "example_id": "118710c5-003b-4a94-a8d7-d8ca029aa10b",
                                                "sense_id": "03f9e393-b1b7-3adb-908e-f05b46baeab7",
                                                "text": "„Ich weiß, mit dem, was ich jetzt schreibe, löse ich aller Voraussicht nach einen Shitstorm aus: Ich habe es probiert, ich habe Wal gegessen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
