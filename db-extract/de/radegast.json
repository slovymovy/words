                "forms": [],
                "senses": [
                    {
                        "sense_id": "ca7bb61d-a948-3f9a-861e-ab089dfbcd9c",
                        "entry_id": "a7df7838-4979-37ee-b027-13501ac6cdf3",
                        "glosses": [
                            "ein slawischer Gott"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a40fbf8-c1e8-4ad9-8056-1854d0159ef6",
                                "sense_id": "ca7bb61d-a948-3f9a-861e-ab089dfbcd9c",
                                "text": "„Die letztern verehrten einen höchsten guten Gott, Bog, oder Belibog; dann ein böses Grundwesen, Zhart oder Zhernibog (Gott der Finsternisse); ferner eine sehr große Zahl von Untergöttern, z. B. Triglav, ein dreyköpfiger Gott, als Herrscher über Luft, Erde und Wasser, Radegast, Gott der Freude, Shiva, Göttinn des Lebens, (Venus), Kurent, Gott der Schwelgerey, Mora, Alp oder Drud.“ (1815)"
                            },
                            {
                                "example_id": "088a0231-14b8-4d82-ac03-8e9a4ddd861a",
                                "sense_id": "ca7bb61d-a948-3f9a-861e-ab089dfbcd9c",
                                "text": "„Radegast war Sonnen-, Lebens- und Kriegsgott, Licht - und Schwarzgott, Rathgeber und Zauberer; daher wurde er mehr als alle Andern verehrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
