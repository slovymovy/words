                "senses": [
                    {
                        "sense_id": "c6cc53df-edbe-38f2-bd28-505a60f8b823",
                        "entry_id": "8fe82200-634c-38f8-ac99-04751499d8f2",
                        "glosses": [
                            "stabartiges Sportgerät mit Griff, das beim Skilaufen verwendet wird"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "8aa7dd9c-1bb9-47c2-a590-2059f9a842b8",
                                "sense_id": "c6cc53df-edbe-38f2-bd28-505a60f8b823",
                                "text": "„Sie sind die alpine Antwort auf das Klischee des Latin-Lovers: durchtrainiert, schneidig, immer lustig; tagsüber mit den Skistecken auf der Piste, nächtens mit der großen Bratpfanne ‚auf der Pischtn‘. So sieht das Urbild des klassischen Skilehrers aus […].“"
                            },
                            {
                                "example_id": "bc0cb26a-45a4-4207-b376-32e795cda762",
                                "sense_id": "c6cc53df-edbe-38f2-bd28-505a60f8b823",
                                "text": "„US-Superstar Lindsey Vonn hatte Pech mit einem Skistecken, das Missgeschick brachte sie im Riesentorlauf um Punkte.“"
                            },
                            {
                                "example_id": "9f4fb602-9cc0-45d3-8083-60e79aefa866",
                                "sense_id": "c6cc53df-edbe-38f2-bd28-505a60f8b823",
                                "text": "„Bei der ‚Planai Classic‘ geben sich ehemalige Rallye-Größen und Skilegenden das Lenkrad bzw. die Skistecken in die Hand: Der Finne Rauno Aaltonen (74) ist heuer wieder dabei.“"
                            },
                            {
                                "example_id": "e46764c6-eb69-464a-8427-b8cbffb78232",
                                "sense_id": "c6cc53df-edbe-38f2-bd28-505a60f8b823",
                                "text": "„Die Skistecken sind höchstens für das Gleichgewicht da. Vielleicht zum Tasten. Aber sicher nicht zum Aufstützen.“"
                            },
                            {
                                "example_id": "7b2e42a5-5ca7-4488-bcd5-f794398cfc88",
                                "sense_id": "c6cc53df-edbe-38f2-bd28-505a60f8b823",
                                "text": "„Vor einem Jahr zählten sie noch zu den Exoten. Wer frühmorgens im Stechschritt durch den Wald marschierte – am besten noch mit Skistecken in jeder Hand – musste sich schiefe Blicke gefallen lassen. Kommentare wie ‚Das ist doch kein Sport‘ bekamen die ersten Anhänger des Nordic Walking zu hören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
