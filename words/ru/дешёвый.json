                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это был <w>дешёвый</w> трюк, чтобы привлечь внимание публики.",
                            "target_lang_translations": {
                                "en": "It was a <w>cheap</w> trick to attract the public's attention."
