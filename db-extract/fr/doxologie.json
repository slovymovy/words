                "senses": [
                    {
                        "sense_id": "f680de6f-7b4c-3a0d-b708-f2eaf97167fe",
                        "entry_id": "6b96198f-a870-3c93-9229-3330a0038cd3",
                        "glosses": [
                            "Prière pour célébrer la grandeur et la majesté de Dieu. Dernière strophe d’une hymne, qui est relative à une glorification."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "192a1222-8995-42cf-a7c5-d6ef2cd92755",
                                "sense_id": "f680de6f-7b4c-3a0d-b708-f2eaf97167fe",
                                "text": "Lors de cette messe bilingue, les prêtres utilisent, l’un en latin et l’autre en anglais, le même texte final de la doxologie."
                            },
                            {
                                "example_id": "f96bcb7e-ddca-480c-b8a8-d08f34eb606c",
                                "sense_id": "f680de6f-7b4c-3a0d-b708-f2eaf97167fe",
                                "text": "Ce n’est donc que par une pastorale erronée que l’on peut faire chanter la doxologie par toute l’assemblée."
                            }
                        ]
                    },
                    {
                        "sense_id": "bbebdcd2-6c2c-3a68-bdf4-f2e527624dc3",
                        "entry_id": "6b96198f-a870-3c93-9229-3330a0038cd3",
                        "glosses": [
                            "Énoncé d’une opinion généralement admise."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
