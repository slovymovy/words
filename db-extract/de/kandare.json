                    {
                        "sense_id": "14c45637-aeb0-3c23-b0ab-70c856b3045c",
                        "entry_id": "a1040b60-771a-3010-8ba7-63425226de95",
                        "glosses": [
                            "curb bit, curb (driving bit for a horse)"
                        ],
                        "tags": [
                            "feminine",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "850a4d3c-5814-406a-b4e3-0fb77e9217df",
                                "sense_id": "14c45637-aeb0-3c23-b0ab-70c856b3045c",
                                "text": "»Geld hätte er mir keins gegeben. Er hätte mir die Kandare fester angezogen. Ich könnte Rosa jetzt nicht mal mehr sehn.«"
                            },
                            {
                                "example_id": "8fbe6637-a208-4433-a280-3186cb796a8e",
                                "sense_id": "14c45637-aeb0-3c23-b0ab-70c856b3045c",
                                "text": "„Wenn es bei uns auch so schnell ginge“, sagte ihr Gatte. „Na, also, Doktor, wie wollen Sie den Netzigern die Kandare anlegen?“"
                            },
                            {
                                "example_id": "77b4fe9e-8ad3-4366-9d23-a6a737e7c8ae",
                                "sense_id": "14c45637-aeb0-3c23-b0ab-70c856b3045c",
                                "text": "Das Tier röchelte, schnappte tief Atem, sprang plötzlich auf die vier Beine, fing sich in der Kandare."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
