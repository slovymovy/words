                        "zh": [
                            {
                                "target_lang_word": "卡西诺牌戏",
                                "target_lang_sense_clarification": "纸牌游戏名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03682429-a314-372a-816f-f271df526d8a",
                    "sense_definition": "A small country house or summer house used for pleasure and social gatherings, historically found in Italy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wealthy count retired to his private <w>casino</w> in the hills for the summer months.",
                            "target_lang_translations": {
                                "ru": "Богатый граф на летние месяцы уединился в своем личном <w>казино</w> на холмах.",
                                "zh": "那位富有的伯爵在夏季几个月里隐居到了他位于山间的私人<w>休闲别墅</w>中。"
                            }
                        },
                        {
                            "text": "Architects studied the design of the 18th-century <w>casino</w> located in the villa's gardens.",
                            "target_lang_translations": {
                                "ru": "Архитекторы изучали проект <w>казино</w> XVIII века, расположенного в садах виллы.",
                                "zh": "建筑师们研究了位于别墅花园中那座18世纪<w>避暑凉亭</w>的设计。"
                            }
                        }
                    ],
                    "synonyms": [
                        "summer house",
                        "lodge"
                    ],
                    "traits": [
                        {
