                        "sense_id": "e8037865-a6f9-30fb-aeb5-ca9fff77e4f4",
                        "entry_id": "12330b98-4312-3c4b-a813-cedcb5b034d2",
                        "glosses": [
                            "Relatif à la doctrine de Pélage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb1d26f3-6868-4bba-bb65-b7d781875f4f",
                                "sense_id": "e8037865-a6f9-30fb-aeb5-ca9fff77e4f4",
                                "text": "Les sombres rêves de Calvin sont presque de l’optimisme pélagien auprès des affreux cauchemars que le péché originel cause à notre pieux contemplatif."
                            },
                            {
                                "example_id": "12dd7be8-7560-4c7d-b672-60157862fc1d",
                                "sense_id": "e8037865-a6f9-30fb-aeb5-ca9fff77e4f4",
                                "text": "L’installation de l’hérésie en Bretagne nécessita la visite, en deux occasions, de l’évêque Germain d’Auxerre pour combattre l’extension des enseignements pélagiens."
                            }
                        ]
                    }
