            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cda36b58-2d9b-37cf-8b6d-4e4ea376ca65",
                    "sense_definition": "The ability to do something successfully or efficiently.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager questioned his <w>competence</w> in handling the new software system.",
                            "target_lang_translations": {
                                "ru": "Менеджер поставил под сомнение его <w>компетентность</w> в работе с новой программной системой."
                            }
                        },
                        {
                            "text": "She demonstrated a high level of professional <w>competence</w> during the complex project.",
                            "target_lang_translations": {
                                "ru": "Она продемонстрировала высокий уровень профессиональной <w>компетентности</w> в ходе реализации сложного проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "ability",
                        "competency",
                        "aptitude"
                    ],
                    "antonyms": [
                        "incompetence",
                        "ineptitude",
                        "inability"
                    ],
                    "common_phrases": [
                        "professional competence",
                        "core competence",
                        "technical competence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность успешно или эффективно выполнять какую-либо деятельность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компетентность",
                                "target_lang_sense_clarification": "наличие знаний и опыта"
                            },
                            {
                                "target_lang_word": "способность",
                                "target_lang_sense_clarification": "умение осуществлять действие"
                            },
                            {
                                "target_lang_word": "умение",
                                "target_lang_sense_clarification": "навык выполнения задачи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "170a08b0-cfb6-3eae-a140-16277bb62e62",
                    "sense_definition": "The legal authority or power of a court or person to deal with a particular matter.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "authority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court ruled that the matter fell outside its legal <w>competence</w>.",
                            "target_lang_translations": {
                                "ru": "Суд постановил, что данный вопрос выходит за рамки его юридической <w>компетенции</w>."
                            }
                        },
                        {
                            "text": "The division of legislative <w>competence</w> between the state and federal government is clearly defined.",
                            "target_lang_translations": {
                                "ru": "Разграничение законодательной <w>компетенции</w> между штатом и федеральным правительством четко определено."
                            }
                        }
                    ],
                    "common_phrases": [
                        "legal competence",
                        "legislative competence",
                        "jurisdictional competence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Законные полномочия или право суда или должностного лица рассматривать определенное дело."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компетенция",
                                "target_lang_sense_clarification": "совокупность полномочий и прав"
                            },
                            {
                                "target_lang_word": "правомочие",
                                "target_lang_sense_clarification": "предусмотренная законом возможность"
                            },
                            {
                                "target_lang_word": "подведомственность",
                                "target_lang_sense_clarification": "круг дел, подлежащих ведению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c0dad10-5f50-39bc-b039-a1a7332bce4f",
                    "sense_definition": "The unconscious knowledge of grammar that allows a speaker to use and understand a language.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Linguists often distinguish between linguistic <w>competence</w> and actual performance.",
                            "target_lang_translations": {
                                "ru": "Лингвисты часто проводят различие между языковой <w>компетенцией</w> и реальным речевым поведением."
                            }
                        },
                        {
                            "text": "Native speakers have an innate communicative <w>competence</w> that learners strive to achieve.",
                            "target_lang_translations": {
                                "ru": "Носители языка обладают врожденной коммуникативной <w>компетенцией</w>, к которой стремятся изучающие язык."
                            }
                        }
                    ],
                    "common_phrases": [
                        "linguistic competence",
                        "communicative competence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неосознанное знание грамматики, позволяющее носителю использовать и понимать язык."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компетенция",
                                "target_lang_sense_clarification": "лингвистический термин"
                            },
                            {
                                "target_lang_word": "владение языком",
                                "target_lang_sense_clarification": "способность использовать язык"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de34dd37-c68d-3c50-ba24-5f0ef7a02080",
                    "sense_definition": "An income large enough to live on comfortably.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "income",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He worked hard for many years to earn a <w>competence</w> for his retirement.",
                            "target_lang_translations": {
                                "ru": "Он много работал в течение многих лет, чтобы обеспечить себе <w>достаток</w> к выходу на пенсию."
                            }
                        },
                        {
                            "text": "In the nineteenth century, a modest <w>competence</w> was enough to maintain a respectable lifestyle.",
                            "target_lang_translations": {
                                "ru": "В девятнадцатом веке скромного <w>состояния</w> было достаточно для поддержания достойного образа жизни."
                            }
                        }
                    ],
                    "common_phrases": [
                        "earn a competence"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "used in older literature to refer to financial sufficiency"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Доход, достаточный для комфортного проживания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достаток",
                                "target_lang_sense_clarification": "материальная обеспеченность"
                            },
                            {
                                "target_lang_word": "состояние",
                                "target_lang_sense_clarification": "средства к существованию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55a2bb70-a288-31f1-bda6-d77679370e0f",
                    "sense_definition": "The degree to which a rock or geological stratum is resistant to deformation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The structural style of the fold depends on the relative <w>competence</w> of the rock layers.",
                            "target_lang_translations": {
                                "ru": "Структурный стиль складки зависит от относительной <w>компетентности</w> слоев горных пород."
                            }
                        },
                        {
                            "text": "Geologists measured the rock <w>competence</w> to predict how the mountain would erode.",
                            "target_lang_translations": {
                                "ru": "Геологи измерили <w>компетентность</w> горных пород, чтобы предсказать, как будет происходить эрозия горы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rock competence",
                        "relative competence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Степень устойчивости горной породы или геологического пласта к деформации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компетентность",
                                "target_lang_sense_clarification": "геологическая устойчивость пласта"
                            },
                            {
                                "target_lang_word": "прочность",
                                "target_lang_sense_clarification": "сопротивляемость деформации"
                            }
                        ]
                    }
                }
            ]
        }
