                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8323453e-d2b6-4ec3-aac7-f6d701ba53a0",
                                                "sense_id": "c9dd6e92-b95d-3a31-a582-54f96ce3d50f",
