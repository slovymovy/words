                    {
                        "sense_id": "56ba2fcf-d85e-31c6-b073-0b24368276cb",
                        "entry_id": "23800a3e-ecf8-37ea-bd3e-7dc6f8fb054f",
                        "glosses": [
                            "To chink or clink; to make a ringing sound, as of metal or glass being struck."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2c1a43e-c789-4e39-b6f5-e500e3aa3bfa",
                                "sense_id": "56ba2fcf-d85e-31c6-b073-0b24368276cb",
                                "text": "The cutlery was chinging as the boat swayed around on the sea."
                            },
                            {
                                "example_id": "d1031928-4391-457c-b063-d0be40c87b74",
                                "sense_id": "56ba2fcf-d85e-31c6-b073-0b24368276cb",
                                "text": "These shadows, black as the earth they emerged from, were wearing what looked like dull German helmets, their webgear and canteens chinging as they ran."
                            },
                            {
                                "example_id": "41a7c81d-a754-4680-b47e-6975d8edb143",
                                "sense_id": "56ba2fcf-d85e-31c6-b073-0b24368276cb",
                                "text": "Crystal chings and we sip."
                            },
                            {
                                "example_id": "c61e4d2d-5f9b-44c2-8bda-4bf3061f88eb",
                                "sense_id": "56ba2fcf-d85e-31c6-b073-0b24368276cb",
                                "text": "One of the braves had an ankle bell that chinged when he walked."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f95f637-8413-374a-83c6-97c5aa80ef20",
                        "entry_id": "23800a3e-ecf8-37ea-bd3e-7dc6f8fb054f",
