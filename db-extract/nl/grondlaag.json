                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e8f80f1-01b7-4406-b55d-b9886edb6557",
                                "sense_id": "1e0d56d0-600a-3221-8fcd-892d342f57bb",
                                "text": "De onderzoekers vermoeden dat het op grote schaal oppompen van water uit de dichter bij het oppervlak gelegen grondlagen arseen vrijmaakt en de diepere lagen verontreinigt."
