                        "glosses": [
                            "manier van spreken die de bewoners van een bepaalde streek onderling gewend zijn te gebruiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "029b0679-4995-4534-8a35-9829e3f17ec7",
                                "sense_id": "33f53e3a-c925-3ba0-865e-ff7eba9ba0aa",
                                "text": "Net als hijzelf, niet toevallig, zijn het van geboorte dorpse jongens, opgegroeid met gras en land en sappige gewesttaal, een horizon die niet veel verder reikte dan hun oog."
                            },
                            {
                                "example_id": "40dffce7-6c12-497f-ba59-36eae1803b99",
                                "sense_id": "33f53e3a-c925-3ba0-865e-ff7eba9ba0aa",
                                "text": "Het Vlaams (6 miljoen), steeds meer onderscheiden van het Nederlands, is bovendien nog opsplitsbaar in talloze bargoense gewesttalen die de Vlaamse uitstraling tot nul reduceren."
                            }
                        ]
                    }
