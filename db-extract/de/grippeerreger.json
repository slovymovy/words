                "senses": [
                    {
                        "sense_id": "9fb0e823-d28c-33a6-8c9e-31c93d319c1f",
                        "entry_id": "4c1b09c4-8e97-3788-9b74-dcc951041b51",
                        "glosses": [
                            "Virus (Erreger), der die Krankheit ›echte Grippe‹ auslöst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0a8db06-6709-4d45-92fd-1054f5342a9c",
                                "sense_id": "9fb0e823-d28c-33a6-8c9e-31c93d319c1f",
                                "text": "„Die bisherige Verbreitung der Grippeerreger durch Zuchtgeflügel und nicht durch Wildvögel erscheint demnach wahrscheinlich.“"
                            },
                            {
                                "example_id": "d0d7a8d9-aee0-4442-bd54-b00310d85311",
                                "sense_id": "9fb0e823-d28c-33a6-8c9e-31c93d319c1f",
                                "text": "„Allein die allseits bekannten Grippeerreger Influenza-A besitzen eine primitive DNS und dennoch eine hohe Mutagenität.“"
                            },
                            {
                                "example_id": "50d22ddc-91d9-43fe-9978-eaebbe34944d",
                                "sense_id": "9fb0e823-d28c-33a6-8c9e-31c93d319c1f",
                                "text": "„Der typische Vertreter dieser Familie ist der sehr eingehend erforschte Grippeerreger. Seine Größe ist mit Hilfe der Elektronenmikrophotographie mit etwa 80 m/t bei den Viren A und At und mit etwa 100 ma bei dem Virus B ermittelt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
