                        "examples": [
                            {
                                "example_id": "2a1e7c8a-f0de-45c5-9501-84e5b2c02416",
                                "sense_id": "59d142c7-c416-3fe1-858a-1cb70f40df14",
                                "text": "L’anonier ou chérimolier (Anona Cherimola Mill.) est une espèce subtropicale donnant des fruits délicieux de forme conique à sphérique, atteignant jusqu'à 750 grammes. Un des facteurs limitant la production commerciale de l’anone en Californie réside dans ses récoltes faibles et irrégulières et dans la déformation d'une partie de ses fruits."
                            },
                            {
                                "example_id": "7c0a642c-f3cf-4fcb-9c98-8b776ce77458",
                                "sense_id": "59d142c7-c416-3fe1-858a-1cb70f40df14",
                                "text": "Hommes, femmes, enfants ont travaillé sur ces pentes caillouteuses. … Sur la hauteur, dans une clairière, ils ont établi le premier arbre à pain. Dans un verger, ils ont planté le jacquier, l’anone, le jamlongue, l’oranger."
                            }
                        ]
                    }
