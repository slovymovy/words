{
    "word_family": [
        "leaf"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5fea6820-7c94-30a8-b0a5-3bdca2a906b9",
                    "sense_definition": "Covered with many leaves.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "foliage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was full of <w>leafy</w> trees that provided shade.",
                            "target_lang_translations": {
                                "pl": "Ogród był pełen <w>ulistnionych</w> drzew, które dawały cień."
                            }
                        },
                        {
                            "text": "We sat under the <w>leafy</w> branches during the hot afternoon.",
                            "target_lang_translations": {
                                "pl": "Siedzieliśmy pod <w>ulistnionymi</w> gałęziami podczas gorącego popołudnia."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leafy trees",
                        "leafy branches"
                    ],
                    "target_lang_definitions": {
                        "pl": "Pokryty wieloma liśćmi."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ulistniony",
                                "target_lang_sense_clarification": "mający dużo liści"
                            },
                            {
                                "target_lang_word": "zarośnięty",
                                "target_lang_sense_clarification": "gęsto pokryty roślinnością"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ce0182e-50fb-345a-8945-88a23f505469",
                    "sense_definition": "Having a lot of foliage or green plants.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "foliage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They walked down a quiet <w>leafy</w> avenue in the park.",
                            "target_lang_translations": {
                                "pl": "Spacerowali cichą, <w>pełną zieleni</w> aleją w parku."
                            }
                        },
                        {
                            "text": "The city is trying to create more <w>leafy</w> spaces for residents.",
                            "target_lang_translations": {
                                "pl": "Miasto stara się tworzyć więcej <w>zielonych</w> przestrzeni dla mieszkańców."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leafy avenue",
                        "leafy spaces"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mający dużo zieleni lub roślinności."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zielony",
                                "target_lang_sense_clarification": "pełen roślinności"
                            },
                            {
                                "target_lang_word": "pełen zieleni",
                                "target_lang_sense_clarification": "miejsce z dużą ilością drzew i krzewów"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61f5d427-a301-3d65-941a-bf492b7f3f88",
                    "sense_definition": "Resembling or consisting of leaves, often used to describe vegetables.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "foliage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doctors recommend eating more <w>leafy</w> greens for a healthy diet.",
                            "target_lang_translations": {
                                "pl": "Lekarze zalecają jedzenie większej ilości <w>liściastych</w> warzyw dla zdrowej diety."
                            }
                        },
                        {
                            "text": "Wash the <w>leafy</w> vegetables carefully before you start cooking.",
                            "target_lang_translations": {
                                "pl": "Umyj dokładnie <w>liściaste</w> warzywa, zanim zaczniesz gotować."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leafy greens",
                        "leafy vegetables"
                    ],
                    "target_lang_definitions": {
                        "pl": "Przypominający liście lub składający się z liści, często używany w odniesieniu do warzyw."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "liściasty",
                                "target_lang_sense_clarification": "dotyczący warzyw liściastych"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1b0cb4a-7a0c-3eae-be45-46c7f37580e2",
                    "sense_definition": "Describing a wealthy residential area with many trees and gardens.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wealth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They moved to a large house in a quiet <w>leafy</w> suburb.",
                            "target_lang_translations": {
                                "pl": "Przeprowadzili się do dużego domu na cichym, <w>zielonym</w> przedmieściu."
                            }
                        },
                        {
                            "text": "The family lives in one of the <w>leafy</w> parts of the city.",
                            "target_lang_translations": {
                                "pl": "Rodzina mieszka w jednej z <w>pełnych zieleni</w> części miasta."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leafy suburb",
                        "leafy area"
                    ],
                    "target_lang_definitions": {
                        "pl": "Opisujący zamożną dzielnicę mieszkaniową z dużą liczbą drzew i ogrodów."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zielony",
                                "target_lang_sense_clarification": "spokojna, zamożna okolica z dużą ilością drzew"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f5ec836-dcc0-3069-b689-a85e4bc4a696",
                    "sense_definition": "Formed of thin, flat layers like a leaf.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mineral has a <w>leafy</w> structure that breaks easily.",
                            "target_lang_translations": {
                                "pl": "Minerał ma <w>blaszkowatą</w> strukturę, która łatwo pęka."
                            }
                        },
                        {
                            "text": "The rock shows a <w>leafy</w> pattern due to high pressure.",
                            "target_lang_translations": {
                                "pl": "Skała wykazuje <w>warstwowy</w> wzór z powodu wysokiego ciśnienia."
                            }
                        }
                    ],
                    "synonyms": [
                        "foliated",
                        "laminate",
                        "layered"
                    ],
                    "target_lang_definitions": {
                        "pl": "Uformowany z cienkich, płaskich warstw przypominających liść."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "warstwowy",
                                "target_lang_sense_clarification": "mający strukturę płatów"
                            },
                            {
                                "target_lang_word": "blaszkowaty",
                                "target_lang_sense_clarification": "o strukturze przypominającej blaszki lub liście"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}