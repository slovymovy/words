                "senses": [
                    {
                        "sense_id": "90617124-66c1-3d0a-aab7-85a93614886d",
                        "entry_id": "4582e97f-f8b2-3a54-9f6f-67fb6d10d449",
                        "glosses": [
                            "Zeichen des Hexadezimalsystems, das auf der Basis 16 aufbaut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdf5ba77-07f7-4f1d-a3c1-7f45159f97d6",
                                "sense_id": "90617124-66c1-3d0a-aab7-85a93614886d",
                                "text": "Führende, abschließende und eingebettete Leerzeichen sind nicht zulässig und nur gültige Hexadezimalzeichen können in Eingabewerten verwendet werden."
                            },
                            {
                                "example_id": "f2c0beea-19d5-4063-b08c-af74974264cb",
                                "sense_id": "90617124-66c1-3d0a-aab7-85a93614886d",
                                "text": "Die folgende Tabelle zeigt die Entity-Zeichen Referenz, Dezimalzeichen-Referenz und Hexadezimalzeichen-Referenz für wichtige Auszeichnungs- und Internationalisierungszeichen, und ebenso die jeweilige Darstellung in Ihrem Browser."
                            },
                            {
                                "example_id": "8d08a171-f405-4908-bd6e-8318b557107a",
                                "sense_id": "90617124-66c1-3d0a-aab7-85a93614886d",
                                "text": "Das erste Nicht-Hexadezimalzeichen bricht die Eingabe ab. Alle Hexadezimalzeichen werden dekodiert und als 4-Bit-Wert rechtsbündig in ein 16-Bit-Schieberegister eingefügt; die links herausgeschobene 4-Bit-Gruppe geht verloren."
                            },
                            {
                                "example_id": "5aeeca9f-ad89-4923-99d8-d3c964819c1e",
                                "sense_id": "90617124-66c1-3d0a-aab7-85a93614886d",
                                "text": "Ein Schlüssel kann aus ASCII-Text oder Hexadezimalzeichen bestehen."
                            },
                            {
                                "example_id": "c47b38dd-6f9f-4c58-a324-c32586755cff",
                                "sense_id": "90617124-66c1-3d0a-aab7-85a93614886d",
                                "text": "Letztere werden oft von Bildbearbeitungsprogrammen, aber auch auf diversen Webseiten, zur Verfügung gestellt, und sind an einem #, gefolgt durch 6 Ziffern oder Buchstaben in Hexadezimalzeichen zu erkennen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
