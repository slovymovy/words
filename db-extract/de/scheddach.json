                ],
                "senses": [
                    {
                        "sense_id": "03d7b366-ddf2-3528-8c20-165a95a0074f",
                        "entry_id": "dda90dd9-fc75-30bb-9dcc-344d0a83b64e",
                        "glosses": [
                            "Dach mit aufgesetzten über die Dachbreite verlaufenden im Profil dreieckigen Teildächern; oft mit Lichteinlässen/Lufteinlässen; oft im Industriebau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ef9f95f-257c-4ddf-acdf-d47d0b73aa69",
                                "sense_id": "03d7b366-ddf2-3528-8c20-165a95a0074f",
                                "text": "„Ein Scheddach ist besonders stabil und bietet moderne Gestaltungsmöglichkeiten mit lichtdurchfluteten Räumen.“"
                            },
                            {
                                "example_id": "b8abb42b-3eaf-457b-8807-945c19444a7f",
                                "sense_id": "03d7b366-ddf2-3528-8c20-165a95a0074f",
                                "text": "„Im niederländischen Tilburg wird am Samstag dieser Woche ein neues Kunstzentrum eröffnet, die Stiftung des 1987 gestorbenen Anwalts und Geschäftsmanns J. H. de Pont. Schauplatz ist eine stillgelegte, aufwendig renovierte Textilfabrik mit zweckdienlichem Oberlicht vom Scheddach, mit einer 4200-Quadratmeter-Halle und kleineren (Lager-)Räumen.“"
                            },
                            {
                                "example_id": "90973093-b6f9-4d04-94ca-f29ce4d5fd8e",
                                "sense_id": "03d7b366-ddf2-3528-8c20-165a95a0074f",
                                "text": "„Ihr Kulturzentrum bekommt ein ansteigendes Dach, in Anlehnung an Scheddächer (\"Sägezahndächer\"), die man in Pasing vom mittlerweile ebenfalls verschwundenen Anbau der Eggenfabrik kannte.“"
                            },
                            {
                                "example_id": "6d1dac14-3393-4752-8787-d402a597fd20",
                                "sense_id": "03d7b366-ddf2-3528-8c20-165a95a0074f",
                                "text": "„Auf dem früheren Schlachthof“ […] „gab es eine Halle mit Scheddach, die seit geraumer Zeit für Kunst und Kultur genutzt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
