                "senses": [
                    {
                        "sense_id": "9612897a-f6ae-3590-8a29-3028e7f4d491",
                        "entry_id": "a1fe113b-f7ef-3dcd-91b4-61291f2a002c",
                        "glosses": [
                            "житель или уроженец Бухареста"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aca007cc-f57e-4cec-b30b-2c2e1bd536d3",
                                "sense_id": "9612897a-f6ae-3590-8a29-3028e7f4d491",
                                "text": "Молодой бухарестец."
                            },
                            {
                                "example_id": "10414a29-5925-4d61-9710-b0eadddf6c28",
                                "sense_id": "9612897a-f6ae-3590-8a29-3028e7f4d491",
                                "text": "Талантливые бухарестцы."
                            },
                            {
                                "example_id": "187a9e17-c738-47e4-b240-b5a111f9e111",
                                "sense_id": "9612897a-f6ae-3590-8a29-3028e7f4d491",
                                "text": "— Всё-таки хорошо, когда между тобой я твоим собеседником нет переводчика, — произношу я и смотрю на Мухину: понимает она, куда я клоню? — К сожалению, все наши конференции, обращённые к бухарестской аудитории, не избежали этого... ❬…❭ — Да не хотите ли вы, чтобы я выступила перед любознательными бухарестцами?"
                            },
                            {
                                "example_id": "fb356a11-9637-4cbf-bc43-07975d08d388",
                                "sense_id": "9612897a-f6ae-3590-8a29-3028e7f4d491",
                                "text": "Переезд в тесные квартиры заставил немало бухарестцев отпустить собак."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6dda1767-2d21-494c-84b0-1cd7b595cbce",
                        "source_entry_id": "a1fe113b-f7ef-3dcd-91b4-61291f2a002c",
