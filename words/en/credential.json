{
    "word_family": [
        "accredit",
        "accreditation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4d178490-9dce-3bdc-8d3e-f791c7e0b6b4",
                    "sense_definition": "Documentary or electronic evidence that a person has certain status or privileges.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "evidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "May I see your <w>credentials</w>, please?",
                            "target_lang_translations": {
                                "fr": "Puis-je voir vos <w>accréditations</w>, s'il vous plaît ?"
                            }
                        },
                        {
                            "text": "The computer verifies the user's <w>credentials</w> before allowing them to log on.",
                            "target_lang_translations": {
                                "fr": "L'ordinateur vérifie les <w>identifiants</w> de l'utilisateur avant de lui permettre de se connecter."
                            }
                        }
                    ],
                    "synonyms": [
                        "identification",
                        "authorization"
                    ],
                    "common_phrases": [
                        "check credentials",
                        "verify credentials"
                    ],
                    "target_lang_definitions": {
                        "fr": "Preuve documentaire ou électronique attestant qu'une personne possède un certain statut ou des privilèges."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "accréditation",
                                "target_lang_sense_clarification": "Procédure ou ensemble d'informations permettant d'accéder à des ressources ou services."
                            },
                            {
                                "target_lang_word": "identifiants",
                                "target_lang_sense_clarification": "Informations de connexion (nom d'utilisateur et mot de passe) pour un système informatique."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d32f55ed-10d2-3b33-a04d-6e3fc7cd5e00",
                    "sense_definition": "Evidence of skill or excellence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "evidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team showed their <w>credentials</w> by winning the championship game.",
                            "target_lang_translations": {
                                "fr": "L'équipe a prouvé ses <w>références</w> en remportant le match du championnat."
                            }
                        },
                        {
                            "text": "She has the academic <w>credentials</w> to lead the research project.",
                            "target_lang_translations": {
                                "fr": "Elle possède les <w>qualifications</w> universitaires pour diriger le projet de recherche."
                            }
                        }
                    ],
                    "synonyms": [
                        "qualifications",
                        "credentials"
                    ],
                    "common_phrases": [
                        "academic credentials",
                        "professional credentials"
                    ],
                    "target_lang_definitions": {
                        "fr": "Preuve de compétence, de qualification ou d'excellence."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "qualifications",
                                "target_lang_sense_clarification": "Diplômes ou compétences professionnelles attestées."
                            },
                            {
                                "target_lang_word": "références",
                                "target_lang_sense_clarification": "Preuves de succès ou d'expérience passée démontrant la capacité à réussir."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dde4312f-dc3c-3777-8ab6-b121863dabd1",
                    "sense_definition": "To furnish with credentials.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "School superintendents and teachers are <w>credentialed</w> by the state.",
                            "target_lang_translations": {
                                "fr": "Les inspecteurs d'académie et les enseignants sont <w>accrédités</w> par l'État."
                            }
                        },
                        {
                            "text": "The government <w>credentialed</w> the new ambassador last week.",
                            "target_lang_translations": {
                                "fr": "Le gouvernement a <w>accrédité</w> le nouvel ambassadeur la semaine dernière."
                            }
                        }
                    ],
                    "synonyms": [
                        "certify",
                        "authorize"
                    ],
                    "target_lang_definitions": {
                        "fr": "Fournir des accréditations ou des titres officiels."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "accréditer",
                                "target_lang_sense_clarification": "Donner officiellement le pouvoir ou la reconnaissance à quelqu'un."
                            },
                            {
                                "target_lang_word": "habiliter",
                                "target_lang_sense_clarification": "Donner le droit ou la capacité légale d'exercer une fonction."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8f89c552-3e1d-3f5f-859c-b0e3c72a46d8",
                    "sense_definition": "Pertaining to or serving as an introduction or recommendation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They presented their <w>credential</w> letters to the foreign minister.",
                            "target_lang_translations": {
                                "fr": "Ils ont présenté leurs lettres <w>d'accréditation</w> au ministre des Affaires étrangères."
                            }
                        },
                        {
                            "text": "The diplomat carried <w>credential</w> documents for the meeting.",
                            "target_lang_translations": {
                                "fr": "Le diplomate portait des documents <w>d'accréditation</w> pour la réunion."
                            }
                        }
                    ],
                    "synonyms": [
                        "introductory"
                    ],
                    "common_phrases": [
                        "credential letter"
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui sert d'introduction ou de recommandation officielle."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "d'accréditation",
                                "target_lang_sense_clarification": "Relatif à une lettre ou un document officiel de présentation."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}