                    {
                        "sense_id": "4544e877-caa7-30cf-9f32-c8a81e602c35",
                        "entry_id": "f768f02e-bfdf-35b6-a341-2491e438f1ca",
                        "glosses": [
                            "Approximately that number or quantity."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "428eec3b-0dd7-43ed-bbdf-12cdc6b30d9b",
                                "sense_id": "4544e877-caa7-30cf-9f32-c8a81e602c35",
                                "text": "The speed of light is 186,000 miles per second, right? Yes, thereabout."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6c7dfaf-87fe-3b23-8f10-b7d51a6bda28",
                        "entry_id": "f768f02e-bfdf-35b6-a341-2491e438f1ca",
                        "glosses": [
                            "About that; concerning that."
                        ],
                        "tags": [
