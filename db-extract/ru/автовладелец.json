                                    {
                                        "sense_id": "d2f1732c-e295-30a8-a834-ccb7d82de350",
                                        "entry_id": "790ffc89-7c79-389c-bbca-50820c741935",
                                        "glosses": [
                                            "The first part of a cons in Lisp. The first element of a list."
