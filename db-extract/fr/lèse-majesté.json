                                        "entry_id": "0a094330-3e43-34a6-831d-38948b306a17",
                                        "glosses": [
                                            "The crime of violating majesty, an offense against the dignity of a reigning sovereign or against a state."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d2c1646-0757-44ff-a142-ae4cc645ce61",
                                                "sense_id": "092f2992-f01d-3d84-b489-49547c080871",
                                                "text": "“[…]I allow neither perduellion nor lese-majesty against my sovereign authority.”"
                                            },
                                            {
                                                "example_id": "aa67c23f-ce64-476f-9b7e-cfe07a5e3e51",
                                                "sense_id": "092f2992-f01d-3d84-b489-49547c080871",
                                                "text": "His father was what you call an agitator, and his father was in jail for lese majesty—what you call speaking the truth about the Emperor."
                                            }
                                        ]
                                    }
                                ]
                            }
