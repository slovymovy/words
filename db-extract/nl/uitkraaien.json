                "forms": [],
                "senses": [
                    {
                        "sense_id": "c7f52ab2-c17f-32bd-9002-22f02566a6df",
                        "entry_id": "27a65742-7292-3a49-9aed-c4146fd07c1e",
                        "glosses": [
                            "schreeuwen van plezier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0303e35e-cc60-4efb-9ad9-4f9fd7afe46f",
                                "sense_id": "c7f52ab2-c17f-32bd-9002-22f02566a6df",
                                "text": "\"Zo wakker worden is heerlijk!\", jubelde André op Instagram. \"Op #1 staan met je album op iTunes. En dan ook nog eens bij Bol.com.\" In een niet veel later verschenen video zingt André \"papa staat op 1, papa staat op 1\" terwijl de in oktober geboren André het uitkraait. \"Mijn papa staar op 1\""
                            }
                        ]
                    },
                    {
                        "sense_id": "e1fc1185-d408-3a1c-9528-46e7563d5378",
                        "entry_id": "27a65742-7292-3a49-9aed-c4146fd07c1e",
                        "glosses": [
                            "luidkeels iets (onzinnigs) vertellen"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "100551eb-e468-4ffb-af12-496e60c72362",
                                "sense_id": "e1fc1185-d408-3a1c-9528-46e7563d5378",
                                "text": "Het was niet het eerste dat mis ging. Meteen na de eerste melding van de dramatische brand brak weer het onsmakelijke gegis naar het aantal dodelijke slachtoffers uit. \"Deze brand gaat Enschede ver overtreffen\", hoor ik een reporter met overslaande stem uitkraaien."
                            },
                            {
                                "example_id": "ac370760-4b65-434f-bde5-34772ce8c1a9",
                                "sense_id": "e1fc1185-d408-3a1c-9528-46e7563d5378",
                                "text": "\"Je kunt je afvragen of Bram Bouterse niet teveel laat uitkraaien.\" Dat zijn dossiers openbaar zouden worden gemaakt. Dat hij in Suriname voor de rechter zou komen. En dat Bouterse wist dat zijn proces vandaag zou beginnen. Justitie-officier Teeven: \"Bouterse lijkt me een onbeheersbare cliënt.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2ddae8d-afcc-4c4c-86c5-5ac2d4ea709f",
                        "source_entry_id": "27a65742-7292-3a49-9aed-c4146fd07c1e",
                        "source_sense_id": "e1fc1185-d408-3a1c-9528-46e7563d5378",
                        "source_sense_description": "luidkeels iets (onzinnigs) vertellen",
                        "target_lang_word": "call out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "call out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "117b4e57-aca9-3e00-9f04-6d8a018ecde1",
                                        "entry_id": "641dbfef-ca5c-3833-86d6-edf8308c334a",
                                        "glosses": [
                                            "To specify, especially in detail."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbc503f6-7973-4b1b-9dee-0db25259cd03",
                                                "sense_id": "117b4e57-aca9-3e00-9f04-6d8a018ecde1",
                                                "text": "They call out 304 stainless steel in the drawing, but the part was made from aluminum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8471593c-9c05-387f-8d6e-c1ccbb3a66a8",
                                        "entry_id": "641dbfef-ca5c-3833-86d6-edf8308c334a",
                                        "glosses": [
                                            "To order into service; to summon into service."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "504d93b2-814a-4a8e-9045-ec6c13b34d3c",
                                                "sense_id": "8471593c-9c05-387f-8d6e-c1ccbb3a66a8",
                                                "text": "The Governor called out the National Guard."
                                            },
                                            {
                                                "example_id": "d3b98e07-9e97-44e7-9ee8-d8756b78a6d3",
                                                "sense_id": "8471593c-9c05-387f-8d6e-c1ccbb3a66a8",
                                                "text": "Ninety-nine Decision Street\nNinety-nine ministers meet\nTo worry, worry, super scurry\nCall the troops out in a hurry"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "487d44e4-aa6c-3d6f-98ac-b2cf2d2d424a",
                                        "entry_id": "641dbfef-ca5c-3833-86d6-edf8308c334a",
                                        "glosses": [
                                            "To yell out; to vocalize audibly; announce."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b84fcec-45bf-405f-883a-b3fee790e9ee",
                                                "sense_id": "487d44e4-aa6c-3d6f-98ac-b2cf2d2d424a",
                                                "text": "1971, Carole King, “You’ve Got A Friend”, Tapestry, Ode Records\nYou just call out my name / And you know wherever I am / I'll come running to see you again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28041960-ed32-36c9-8215-8ca4dd2853b2",
                                        "entry_id": "641dbfef-ca5c-3833-86d6-edf8308c334a",
                                        "glosses": [
                                            "To challenge (someone).",
                                            "To challenge (someone) to a duel."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "69e1f8dd-c573-33b7-93d7-a99764242f66",
                                        "entry_id": "641dbfef-ca5c-3833-86d6-edf8308c334a",
                                        "glosses": [
                                            "To challenge (someone).",
                                            "To challenge (someone) to a fight."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd539521-aef5-3692-9dd7-05cc269eb0a9",
                                        "entry_id": "641dbfef-ca5c-3833-86d6-edf8308c334a",
                                        "glosses": [
                                            "To challenge (someone).",
                                            "To criticize or denounce (someone); to bring up previously unspoken criticisms about (someone); to point out (someone's) faults."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a237a6f7-bcb1-4a71-8975-cf41766942f2",
                                                "sense_id": "dd539521-aef5-3692-9dd7-05cc269eb0a9",
                                                "text": "He was very insulting. Finally Jack called him out and shut him up."
                                            },
                                            {
                                                "example_id": "27d17ed4-4185-465a-8bc4-2bff1eb2f4e7",
                                                "sense_id": "dd539521-aef5-3692-9dd7-05cc269eb0a9",
                                                "text": "She called them out on their lies."
                                            },
                                            {
                                                "example_id": "929baec8-eaba-4f68-be63-6a4c6bb1194d",
                                                "sense_id": "dd539521-aef5-3692-9dd7-05cc269eb0a9",
                                                "text": "He added: \"We've always had spin, especially from Government. But this is not spin. This is dishonesty and so it's our rail media's urgent responsibility to call it out because non-specialist journalists across the country will report this and gradually these untruths will be accepted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f98f3f81-d052-3617-b2c8-776e8b60e3b5",
                                        "entry_id": "641dbfef-ca5c-3833-86d6-edf8308c334a",
                                        "glosses": [
                                            "To contact one's workplace and announce that one is unable to attend work. Regionalism short for call out sick; much more commonly: call in sick."
                                        ],
                                        "tags": [
                                            "New-Jersey",
                                            "New-York",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0886fc0d-7be4-4646-a263-47fdf7109222",
                                                "sense_id": "f98f3f81-d052-3617-b2c8-776e8b60e3b5",
                                                "text": "I had to call out from work. […] I barely ate yesterday. The only thing that stayed in my stomach was soup and crackers."
                                            },
                                            {
                                                "example_id": "b4b6932a-16be-4b23-a55f-3e1becab2ee5",
                                                "sense_id": "f98f3f81-d052-3617-b2c8-776e8b60e3b5",
                                                "text": "I had to call out from work a few Saturdays to Dj at kid's party because they would normally start somewhere around 4:00 p.m."
                                            },
                                            {
                                                "example_id": "9a074650-4e2e-4e9f-b4f9-f1390c89ff72",
                                                "sense_id": "f98f3f81-d052-3617-b2c8-776e8b60e3b5",
                                                "text": "On this particular day, I felt ill, mostly from exhaustion, and had to call out from work. This callout caused a stir and a display of animosity."
                                            }
                                        ]
                                    }
                                ]
                            },
