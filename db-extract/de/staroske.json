                ],
                "senses": [
                    {
                        "sense_id": "12fb0f37-e609-3a1b-9088-fcff9df528d2",
                        "entry_id": "cbb105ad-9cf9-301b-8698-d71a0c546257",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dc93958-ec14-425b-a7d6-f7a2caec48e4",
                                "sense_id": "12fb0f37-e609-3a1b-9088-fcff9df528d2",
                                "text": "Frau Staroske ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ca36dbd6-f266-41c2-8afc-debe83de7c9a",
                                "sense_id": "12fb0f37-e609-3a1b-9088-fcff9df528d2",
                                "text": "Herr Staroske wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d9069b21-7942-4981-bcbc-ade1edeb42aa",
                                "sense_id": "12fb0f37-e609-3a1b-9088-fcff9df528d2",
                                "text": "Die Staroskes kommen heute von Wangerooge."
                            },
                            {
                                "example_id": "94bcf169-39f2-41ef-ac24-290f126b6d7e",
                                "sense_id": "12fb0f37-e609-3a1b-9088-fcff9df528d2",
                                "text": "Der Staroske trägt nie die Schals, die die Staroske ihm strickt."
                            },
                            {
                                "example_id": "e2df45ce-d7a8-4a4c-86e8-5613df77b864",
                                "sense_id": "12fb0f37-e609-3a1b-9088-fcff9df528d2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Staroske kommt, geht der Herr Staroske.“"
                            },
                            {
                                "example_id": "f1c1189b-0f9e-4ced-bf04-437eb60d6d93",
                                "sense_id": "12fb0f37-e609-3a1b-9088-fcff9df528d2",
                                "text": "Staroske kommt und geht."
                            },
                            {
                                "example_id": "82a35f5c-540b-4e0e-9127-19885f1d60cb",
                                "sense_id": "12fb0f37-e609-3a1b-9088-fcff9df528d2",
                                "text": "Staroskes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
