                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "signing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author stayed late to <w>autograph</w> copies of her new book for fans."
                        },
                        {
                            "text": "He was happy to <w>autograph</w> the jersey for the young supporter."
                        }
                    ],
                    "common_phrases": [
