                            "target_lang_translations": {
                                "en": "This house is built only from <w>high-quality</w> materials."
                            }
                        },
                        {
                            "text": "Het bedrijf levert altijd een <w>hoogwaardig</w> product aan zijn klanten.",
                            "target_lang_translations": {
                                "en": "The company always delivers a <w>premium</w> product to its customers."
                            }
                        }
                    ],
                    "synonyms": [
