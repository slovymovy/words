                "forms": [
                    {
                        "form_id": "cca46f9a-3263-45f7-b734-6f77dbbfbe3a",
                        "entry_id": "aac323ea-4d98-35eb-80ca-6843ed2718cb",
                        "tags": [
                            "plural"
                        ],
                        "form": "guinguettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e8045ae1-3157-3454-89cb-a01862097a79",
                        "entry_id": "aac323ea-4d98-35eb-80ca-6843ed2718cb",
                        "glosses": [
                            "Cabaret de faubourg ou de banlieue, où les gens du peuple aimaient à se divertir les jours de fête."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "04a3fa20-9a4b-4a93-806c-af27e31c7b37",
                                "sense_id": "e8045ae1-3157-3454-89cb-a01862097a79",
                                "text": "On les rencontre un jour accoudés à la cheminée d’un salon du monde, et le lendemain attablés sous les tonnelles des guinguettes dansantes."
                            },
                            {
                                "example_id": "07234283-f0ad-40c3-9661-5f6247eb2637",
                                "sense_id": "e8045ae1-3157-3454-89cb-a01862097a79",
                                "text": "Il s’agit d’un évadé de la Guyane. Je le piste depuis cinq mois et je l’ai manqué une première fois à Nogent dans une guinguette du bord de l’eau, où on l’employait comme garçon."
                            },
                            {
                                "example_id": "4a01d109-63da-4ba7-837f-a36b8dbc83e3",
                                "sense_id": "e8045ae1-3157-3454-89cb-a01862097a79",
                                "text": "La première édition, à l’été 2020, avait pris des airs de guinguette améliorée à cause des mesures sanitaires post-confinement."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b73c95d-961b-319b-9fca-96d0842f8505",
                        "entry_id": "aac323ea-4d98-35eb-80ca-6843ed2718cb",
                        "glosses": [
                            "(Belgique) Bar temporaire, situé en extérieur, souvent dans un espace vert."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08b009e9-d729-41d7-b5d2-eed3383704ac",
                                "sense_id": "9b73c95d-961b-319b-9fca-96d0842f8505",
                                "text": "Les beaux jours arrivent, les guinguettes aussi. Elles font leur grand retour dans les parcs bruxellois."
                            },
                            {
                                "example_id": "9874e94b-da09-4e2c-aab9-3e0cf2577596",
                                "sense_id": "9b73c95d-961b-319b-9fca-96d0842f8505",
                                "text": "Depuis que le soleil a pointé le bout de son nez en Belgique, les Bruxellois profitent pleinement de la saison des guinguettes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
