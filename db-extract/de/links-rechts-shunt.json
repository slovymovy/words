                ],
                "senses": [
                    {
                        "sense_id": "ccdaea78-b87c-33e0-be6b-c571a6cbdd91",
                        "entry_id": "5b32d79f-e64a-3c02-8266-bf56169eb554",
                        "glosses": [
                            "Störung des Blutkreislaufs, bei der sauerstoffreiches Blut aus dem arteriellen Schenkel des Blutkreislaufs (zum Beispiel aus der linken Herzhälfte) direkt in den venösen Schenkel des Blutkreislaufs (zum Beispiel in die rechte Herzhälfte) gelangt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8b1380f-888e-480a-872d-45f4e174bf07",
                                "sense_id": "ccdaea78-b87c-33e0-be6b-c571a6cbdd91",
                                "text": "Ein Links-Rechts-Shunt besteht z. B. beim persistierenden Ductus Botalli (PDA)."
                            },
                            {
                                "example_id": "ce0d2ded-9117-4788-8eec-7d1da83083ed",
                                "sense_id": "ccdaea78-b87c-33e0-be6b-c571a6cbdd91",
                                "text": "Gemessen am Grad des pulmonalen Gefäßwiderstands ist die schwerste Form der PAH das Eisenmenger-Syndrom, bei dem ein ursprünglicher Links-Rechts-Shunt sich zu einem Rechts-Links-Shunt umkehrt."
                            },
                            {
                                "example_id": "8e9f00c9-678e-40ac-8e24-717737b7e8d0",
                                "sense_id": "ccdaea78-b87c-33e0-be6b-c571a6cbdd91",
                                "text": "Patienten mit großem Links-Rechts-Shunt (LRS) zeigen ähnliche Beschwerden wie bei einem großen Ventrikelseptumdefekt."
                            },
                            {
                                "example_id": "6e23d467-a19c-4e12-82b5-548f848cfaa7",
                                "sense_id": "ccdaea78-b87c-33e0-be6b-c571a6cbdd91",
                                "text": "Angeborene Herzfehler mit überwiegendem Links-Rechts-Shunt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
