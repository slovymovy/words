{
    "word_family": [],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5fde1589-af34-343a-88a4-7ed7b9ce4fd9",
                    "sense_definition": "Used to emphasize a noun, often expressing annoyance, frustration, or surprise (a euphemism for 'damn').",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "euphemism_damn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot find my <w>dang</w> keys anywhere in this house.",
                            "target_lang_translations": {
                                "ru": "Я нигде в этом доме не могу найти свои <w>чёртовы</w> ключи.",
                                "zh": "我在这房子里哪儿都找不到我那<w>该死的</w>钥匙。"
                            }
                        },
                        {
                            "text": "That <w>dang</w> dog has been barking all night long.",
                            "target_lang_translations": {
                                "ru": "Эта <w>треклятая</w> собака лаяла всю ночь напролёт.",
                                "zh": "那只<w>讨厌的</w>狗整夜都在叫。"
                            }
                        }
                    ],
                    "synonyms": [
                        "darn",
                        "durn"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "euphemism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для усиления существительного, часто выражая раздражение, разочарование или удивление (эвфемизм для 'damn').",
                        "zh": "用于强调名词，常表示恼火、沮丧或惊讶，是 damn 的委婉说法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чёртов",
                                "target_lang_sense_clarification": "разг., эвфемизм"
                            },
                            {
                                "target_lang_word": "треклятый",
                                "target_lang_sense_clarification": "выражает сильное раздражение"
                            },
                            {
                                "target_lang_word": "дурацкий",
                                "target_lang_sense_clarification": "разг., выражает досаду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "该死的",
                                "target_lang_sense_clarification": "口语，放在名词前表示恼火、厌烦，相当于较委婉的 damn"
                            },
                            {
                                "target_lang_word": "讨厌的",
                                "target_lang_sense_clarification": "口语，强调说话人的烦躁或不满"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "0c285cba-eec1-3ba8-9e2d-611a2bb7b7d5",
                    "sense_definition": "Extremely or very; used to emphasize an adjective or adverb (a euphemism for 'damn').",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "euphemism_damn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is so <w>dang</w> hot outside that I can barely breathe.",
                            "target_lang_translations": {
                                "ru": "На улице так <w>чертовски</w> жарко, что я едва могу дышать.",
                                "zh": "外面<w>太</w>热了，我都快喘不过气来了。"
                            }
                        },
                        {
                            "text": "This math problem is too <w>dang</w> hard for me to solve.",
                            "target_lang_translations": {
                                "ru": "Эта задача по математике <w>чертовски</w> сложная для меня.",
                                "zh": "这道数学题<w>太</w>难了，我根本解不出来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "darn",
                        "durn",
                        "flipping",
                        "blinking",
                        "awfully",
                        "mighty"
                    ],
                    "common_phrases": [
                        "so-dang"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "euphemism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно или очень; используется для усиления прилагательного или наречия (эвфемизм для 'damn').",
                        "zh": "表示“非常、很”，用于强调形容词或副词，是 damn 的委婉说法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чертовски",
                                "target_lang_sense_clarification": "разг., очень сильно"
                            },
                            {
                                "target_lang_word": "жутко",
                                "target_lang_sense_clarification": "разг., в значении 'очень'"
                            },
                            {
                                "target_lang_word": "ужасно",
                                "target_lang_sense_clarification": "разг., усилительная частица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "太",
                                "target_lang_sense_clarification": "口语，放在形容词或副词前加强语气，表示“非常”"
                            },
                            {
                                "target_lang_word": "非常",
                                "target_lang_sense_clarification": "口语，强调程度高"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "06d9320c-71cc-316b-a660-c902dd2544ca",
                    "sense_definition": "Used to express annoyance, disappointment, or surprise (a euphemism for 'damn').",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "euphemism_damn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Dang</w>, I forgot to bring my wallet to the store.",
                            "target_lang_translations": {
                                "ru": "<w>Блин</w>, я забыл взять кошелёк в магазин.",
                                "zh": "<w>哎呀</w>，我忘了带钱包去商店。"
                            }
                        },
                        {
                            "text": "Oh <w>dang</w>, we missed the start of the movie.",
                            "target_lang_translations": {
                                "ru": "О <w>чёрт</w>, мы пропустили начало фильма.",
                                "zh": "哦<w>糟了</w>，我们错过了电影的开头。"
                            }
                        }
                    ],
                    "synonyms": [
                        "darn",
                        "durn",
                        "shoot"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "euphemism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения досады, разочарования или удивления (эвфемизм для 'damn').",
                        "zh": "用于表示恼火、失望或惊讶的感叹词，是 damn 的委婉说法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чёрт",
                                "target_lang_sense_clarification": "восклицание досады"
                            },
                            {
                                "target_lang_word": "блин",
                                "target_lang_sense_clarification": "разг., эвфемизм"
                            },
                            {
                                "target_lang_word": "проклятье",
                                "target_lang_sense_clarification": "выражение злости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哎呀",
                                "target_lang_sense_clarification": "口语感叹词，表示懊恼或小小的惊讶"
                            },
                            {
                                "target_lang_word": "糟了",
                                "target_lang_sense_clarification": "口语，表示事情不妙、失望或懊恼"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "01341c3d-6b44-3290-af37-6588b5fee44c",
                    "sense_definition": "A very small amount of concern or value; usually used in negative phrases.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "euphemism_damn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I honestly do not give a <w>dang</w> about what they think of me.",
                            "target_lang_translations": {
                                "ru": "Мне, честно говоря, ни <w>черта</w> не важно, что они обо мне думают.",
                                "zh": "老实说，我根本不<w>在乎</w>他们怎么看我。"
                            }
                        },
                        {
                            "text": "He didn't care a <w>dang</w> whether he won or lost the game.",
                            "target_lang_translations": {
                                "ru": "Его ни <w>черта</w> не волновало, выиграет он или проиграет.",
                                "zh": "他对比赛是输是赢一点都不<w>在乎</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "give-a-dang"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "euphemism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень малая степень беспокойства или ценности; обычно используется в отрицательных фразах.",
                        "zh": "指极少的一点在意或价值，通常用于否定说法里，表示“丝毫不在乎”。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чёрт",
                                "target_lang_sense_clarification": "в выражениях типа 'ни черта'"
                            },
                            {
                                "target_lang_word": "фиг",
                                "target_lang_sense_clarification": "разг., в выражениях типа 'ни фига'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在乎",
                                "target_lang_sense_clarification": "常见于“不在乎”“不关心”之类说法中，表示一点也不在意"
                            },
                            {
                                "target_lang_word": "关心",
                                "target_lang_sense_clarification": "表示关切、重视，多用于否定式来对应本义"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "043d6f5f-bb53-3866-b6b7-c113ae7434f6",
                    "sense_definition": "A humorous or euphemistic substitution for the word 'dam' due to its sound similarity to 'damn'.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tour guide made a joke about the Hoover <w>Dang</w>.",
                            "target_lang_translations": {
                                "ru": "Экскурсовод пошутил про плотину Гувера, назвав её <w>Данг</w>.",
                                "zh": "导游拿胡佛<w>大坝</w>开了个谐音玩笑。"
                            }
                        },
                        {
                            "text": "She refused to say the word and called the beaver's home a <w>dang</w>.",
                            "target_lang_translations": {
                                "ru": "Она отказалась произносить это слово и назвала жилище бобра <w>данг</w>.",
                                "zh": "她不肯说那个词，就把海狸的家戏称为<w>水坝</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "humorous"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шутливая или эвфемистическая замена слова 'dam' (плотина) из-за сходства звучания с 'damn'.",
                        "zh": "因与 damn 发音相近而用来戏谑或委婉代替 dam 的说法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плотина",
                                "target_lang_sense_clarification": "прямое значение слова dam"
                            },
                            {
                                "target_lang_word": "дамба",
                                "target_lang_sense_clarification": "гидротехническое сооружение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大坝",
                                "target_lang_sense_clarification": "字面对应 dam，指拦水建筑；本义里的幽默效果在中文里通常无法直接保留"
                            },
                            {
                                "target_lang_word": "水坝",
                                "target_lang_sense_clarification": "也可指 dam 一类的水工建筑"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "29cc3193-b7b9-3193-b06f-34daa50ae13c",
                    "sense_definition": "To curse or condemn someone or something (a euphemism for 'damn').",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "euphemism_damn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will be <w>danged</w> if I let you drive home in this weather.",
                            "target_lang_translations": {
                                "ru": "<w>Будь я проклят</w>, если позволю тебе ехать домой в такую погоду.",
                                "zh": "这天气我要是还让你开车回家，我就真是<w>见鬼了</w>。"
                            }
                        },
                        {
                            "text": "The old farmer <w>danged</w> the tractor when it refused to start.",
                            "target_lang_translations": {
                                "ru": "Старый фермер <w>проклял</w> трактор, когда тот отказался заводиться.",
                                "zh": "那台拖拉机发动不起来时，老农把它狠狠<w>骂</w>了一通。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ill-be-danged"
