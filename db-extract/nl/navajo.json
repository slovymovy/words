                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "3afdc437-d552-4cc5-b232-1d8b007c7722",
                                "sense_id": "ea1cbb10-054a-3dd8-95b6-c566ce1eba0b",
                                "text": "Religieuze leiders van de Hopi maken er dan ook bezwaar tegen dat kachina door Navajo worden gekopieerd en verkocht aan toeristen, zonder toestemming, laat staan compensatie, voor de Hopi-gemeenschap."
                            }
                        ]
                    }
