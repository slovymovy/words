        "fr-extract.jsonl": [
            {
                "entry_id": "70ee530e-1ab7-37a1-8315-4d00b5af489b",
                "word": "dope",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cf426129-9774-4786-ac2c-25e41e6927c2",
                        "entry_id": "70ee530e-1ab7-37a1-8315-4d00b5af489b",
                        "tags": [
                            "plural"
                        ],
                        "form": "dopes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d3ecc246-3bb6-3d1b-abd2-f604fdc1ce8b",
                        "entry_id": "70ee530e-1ab7-37a1-8315-4d00b5af489b",
                        "glosses": [
                            "Drogue."
                        ],
                        "tags": [
                            "Anglicism",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "77fcb936-8870-4ae0-b447-6093ccf1789d",
                                "sense_id": "d3ecc246-3bb6-3d1b-abd2-f604fdc1ce8b",
                                "text": "Une dope dont les pires vacheries de la vie ne peuvent nous guérir."
                            },
                            {
                                "example_id": "ace4240c-d141-4d03-832b-0a07fe9117cf",
                                "sense_id": "d3ecc246-3bb6-3d1b-abd2-f604fdc1ce8b",
                                "text": "La dope allait encore manquer : ses doses avaient considérablement augmenté ces derniers jours."
                            },
                            {
                                "example_id": "1f8be788-1ee5-4fbb-a0ff-9caaf53bb95a",
                                "sense_id": "d3ecc246-3bb6-3d1b-abd2-f604fdc1ce8b",
                                "text": "La dope rallumait juste le soleil une heure ou deux et puis elle nous faisait rentrer dans notre grotte, c’était qu’une quête permanente pour trouver du fric, faire notre shoot et recommencer."
                            },
                            {
                                "example_id": "91110bcf-a603-44df-9865-771693cf0434",
                                "sense_id": "d3ecc246-3bb6-3d1b-abd2-f604fdc1ce8b",
                                "text": "– OK, du calme. Alors disons que je me suis trompé sur l’homme. C’est pas grave, j’irai vendre ma dope ailleurs… Salut, Bob, et bon concert. Et encore désolé pour le dérangement… »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d37ac1c-a80e-455c-ba3e-d06111b2e654",
                        "source_entry_id": "70ee530e-1ab7-37a1-8315-4d00b5af489b",
                        "source_sense_id": "d3ecc246-3bb6-3d1b-abd2-f604fdc1ce8b",
                        "target_lang_word": "Stoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stoff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a83fe1f-9224-3c8e-aa96-9a936fbcc44f",
                                        "entry_id": "881e8593-b5e4-3579-a052-fd6db9dce20f",
                                        "glosses": [
                                            "das Material, die Materie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ba54e66-8a3b-4edf-b406-75ba335c47b5",
                                                "sense_id": "2a83fe1f-9224-3c8e-aa96-9a936fbcc44f",
                                                "text": "Meerwasser enthält viele gelöste Stoffe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ba3519c2-c7e5-3734-9181-b30aa51a603d",
                                        "entry_id": "881e8593-b5e4-3579-a052-fd6db9dce20f",
                                        "glosses": [
                                            "eine Textilie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "424eb21b-fca5-46c5-b812-6cd3fd7f7792",
                                                "sense_id": "ba3519c2-c7e5-3734-9181-b30aa51a603d",
                                                "text": "Soll ich die Lederweste anziehen oder die aus Stoff?"
                                            },
                                            {
                                                "example_id": "0dcc06c0-1c64-4fa0-a4fe-799f7494a60f",
                                                "sense_id": "ba3519c2-c7e5-3734-9181-b30aa51a603d",
                                                "text": "„Wir standen in einem Bekleidungsgeschäft, Musik dröhnte aus den Lautsprechern und die Luft war erfüllt vom Geruch nach Plastik und gefärbten Stoffen und Schweiß, als wir zu den Umkleiden gingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b63b7933-a6c5-3d52-b8b5-cbce35356c62",
                                        "entry_id": "881e8593-b5e4-3579-a052-fd6db9dce20f",
                                        "glosses": [
                                            "das, was zu erlernen, zu erarbeiten ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa49f8cc-7f30-4849-8b44-c5399c6fe27f",
                                                "sense_id": "b63b7933-a6c5-3d52-b8b5-cbce35356c62",
                                                "text": "Den ganzen Stoff, der im Lehrplan steht, bekommt man nicht durch."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f46480c5-8054-3925-b759-adac5d6528d0",
                                        "entry_id": "881e8593-b5e4-3579-a052-fd6db9dce20f",
                                        "glosses": [
                                            "literarisch, theatralisch, filmisch aufbereitbares Material"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e50726a-6e95-47a8-b4d5-25da620210a4",
                                                "sense_id": "f46480c5-8054-3925-b759-adac5d6528d0",
                                                "text": "Auf dieser Reise bot sich reichlich Stoff für ihren neuen Roman."
                                            },
                                            {
                                                "example_id": "f7163010-e9f1-463e-acc5-129854ada7d3",
                                                "sense_id": "f46480c5-8054-3925-b759-adac5d6528d0",
                                                "text": "„Er hat sich schon zuvor, vielleicht noch vor Zürich, an diesem Stoff versucht, aber er braucht die neue Stadt, um etwas Neues zu schaffen.“"
                                            },
                                            {
                                                "example_id": "4cb930aa-7bf6-4b77-a2a4-1f00c3c5326e",
                                                "sense_id": "f46480c5-8054-3925-b759-adac5d6528d0",
                                                "text": "„Das schwierigste daran war, einen geeigneten Stoff zu finden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "37befa14-0225-3c4d-b414-553c6b1a14ab",
                                        "entry_id": "881e8593-b5e4-3579-a052-fd6db9dce20f",
                                        "glosses": [
                                            "die Drogen (Rauschgift oder Alkohol)"
                                        ],
                                        "tags": [
                                            "in der Drogenszene",
                                            "unter Alkoholikern"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2aae2161-09bc-4451-b987-efc4c08c2b48",
                                                "sense_id": "37befa14-0225-3c4d-b414-553c6b1a14ab",
                                                "text": "Ich hab’ Stoff besorgt!"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "f7d04da4-bb57-345a-b35b-fd52dabb0eb9",
                                        "entry_id": "881e8593-b5e4-3579-a052-fd6db9dce20f",
                                        "glosses": [
                                            "Geschwindigkeit, Kraft"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f97b20c-f010-45bb-aed3-52c852377ec3",
                                                "sense_id": "f7d04da4-bb57-345a-b35b-fd52dabb0eb9",
                                                "text": "Gib Stoff!"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
