                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d44ac671-8cae-4380-a5b8-addaa7564550",
                                                "sense_id": "afa5f334-9188-35f6-a000-01080fa6037b",
                                                "text": "Mediapart est un journal d'information en ligne."
                                            }
