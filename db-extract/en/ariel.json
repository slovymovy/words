    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2a356084-a3d7-3d30-9867-c05f6650f270",
                "word": "Ariel",
                "pos": "name",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8179662b-09aa-4a61-95a7-6c2b1502841d",
                        "entry_id": "2a356084-a3d7-3d30-9867-c05f6650f270",
                        "tags": [
                            "plural"
                        ],
                        "form": "Ariels"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4dcae7af-ee33-377a-8273-b116b86c4b58",
                        "entry_id": "2a356084-a3d7-3d30-9867-c05f6650f270",
                        "glosses": [
                            "A name for the city of Jerusalem, the claimed (and de-facto) capital city of modern Israel, and the claimed capital city of modern Palestine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86692ec2-949f-42d6-8df7-81a32b07e0f6",
                                "sense_id": "4dcae7af-ee33-377a-8273-b116b86c4b58",
                                "text": "Woe to Ariel, to Ariel, the city where David dwelt! add ye year to year; let them kill sacrifices."
                            }
                        ]
                    },
                    {
                        "sense_id": "08b74bfe-cf39-3498-90e8-2002949c5289",
                        "entry_id": "2a356084-a3d7-3d30-9867-c05f6650f270",
                        "glosses": [
                            "A male given name from Hebrew, also ascribed to spirits and angels in English literature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5dd3e4e-9332-474c-af4d-47057286195a",
                                "sense_id": "08b74bfe-cf39-3498-90e8-2002949c5289",
                                "text": "Then sent I for Eliezer, for Ariel, for Shemaiah, and for Elnathan, and for Jarib, and for Elnathan, and for Nathan, and for Zechariah, and for Meshullam, chief men; also for Joiarib, and for Elnathan, men of understanding."
                            },
                            {
                                "example_id": "1d8d3db2-7edc-4cf8-a0c8-cec45bcb9e1e",
                                "sense_id": "08b74bfe-cf39-3498-90e8-2002949c5289",
                                "text": "All hail, great master! grave sir, hail! I come / To answer thy best pleasure; be't to fly, / To swim, to dive into the fire, to ride / On the curl'd clouds; to thy strong bidding task / Ariel and all his quality."
                            },
                            {
                                "example_id": "d6bbc9fd-c444-4c14-981a-d90d69064766",
                                "sense_id": "08b74bfe-cf39-3498-90e8-2002949c5289",
                                "text": "Nor stood unmindful Abdiel to annoy / The Atheist crew, but with redoubl’d blow / Ariel and Arioc, and the violence / Of Ramiel scorcht and blasted overthrew."
                            },
                            {
                                "example_id": "5c4b7c0a-13c9-44e2-8348-abb2c0976613",
                                "sense_id": "08b74bfe-cf39-3498-90e8-2002949c5289",
                                "text": "Of these am I, who thy Protection claim, / A watchful Sprite, and Ariel is my Name."
                            },
                            {
                                "example_id": "256d19d1-15a9-4ed6-9815-296fb4d90c29",
                                "sense_id": "08b74bfe-cf39-3498-90e8-2002949c5289",
                                "text": "You don't look like a Daniel (your pre-chosen name). There's something fierce and tawny about you. You're the Lion! You're Ariel: God's Lion. You'll be my father Leon's namesake — and for your father, you'll have a Hebrew name.\nI dub thee Ariel, faery spirit of my tempest. You'll be my Jerusalem..."
                            }
                        ]
                    },
                    {
                        "sense_id": "b15e4d87-b9cf-31f6-ab30-c46bc833b4c3",
                        "entry_id": "2a356084-a3d7-3d30-9867-c05f6650f270",
                        "glosses": [
                            "A female given name from Hebrew, used mainly since the 1980s."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fde1fe70-29e1-4d7f-8ef9-bed1abc0fed9",
                                "sense_id": "b15e4d87-b9cf-31f6-ab30-c46bc833b4c3",
                                "text": "\"I'm going to name her Ariel,\" Laura said, ignoring them completely as she stared down at the baby. \"The boys like the name because it's the same as the girl in the Little Mermaid movie. And I like it, because it's pretty.\""
                            },
                            {
                                "example_id": "03c7abd3-9cdd-45c2-80f9-88e7c7fd0940",
                                "sense_id": "b15e4d87-b9cf-31f6-ab30-c46bc833b4c3",
                                "text": "All the miniature Cinderellas, Belles, and Ariels who fill the streets every Halloween are essentially paying homage to characters that will slowly and inevitably chip away at their sense of worth in years to come."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac76fb08-283f-3f55-9e56-1ed24818cb38",
                        "entry_id": "2a356084-a3d7-3d30-9867-c05f6650f270",
                        "glosses": [
                            "The brightest moon of the planet Uranus."
                        ],
                        "tags": [],
                        "examples": []
                    },
