                        "form": "yapok"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "835caa67-4ce4-3971-8e3a-3315904c1b4c",
                        "entry_id": "1d760b1a-644f-3094-8dd8-0241da66f5ef",
                        "glosses": [
                            "Espèce d’opossum d’Amérique caractérisée par ses mœurs aquatiques et la coloration noire et blanche de son fin pelage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b43f284-fcb1-4c99-8973-119343b5b744",
                                "sense_id": "835caa67-4ce4-3971-8e3a-3315904c1b4c",
                                "text": "Le Yapock est plus petit que l’opossum ordinaire, mais possède une plus longue queue sans poils. Autre particularité, il vit au bord de l’eau et est adapté à cet environnement : ses pattes postérieures possèdent une membrane interdigitale lui permettant de nager et sa poche ventrale se ferme hermétiquement quand l’animal plonge, à l’aide d’un sphincter."
                            },
                            {
                                "example_id": "5cad1ea3-4916-4ee0-b4dc-aff249060d30",
                                "sense_id": "835caa67-4ce4-3971-8e3a-3315904c1b4c",
                                "text": "Mammifères : tous les mammifères marins (dauphins et lamantins), déjà bien rares sur le territoire. Mais aussi : l’opossum aquatique (appelé localement Yapock)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b728ec80-8b70-489c-8455-f664bbb2db90",
                        "source_entry_id": "1d760b1a-644f-3094-8dd8-0241da66f5ef",
                        "source_sense_id": "835caa67-4ce4-3971-8e3a-3315904c1b4c",
                        "target_lang_word": "Schwimmbeutler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwimmbeutler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00960ccf-b2c9-399a-9700-6ae67b6f3e97",
                                        "entry_id": "a7753bcf-8221-34a1-9f3a-f62588c7aeeb",
                                        "glosses": [
                                            "in Mittel- und Südamerika lebende Beutelratte, die mit dem Opossum verwandt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "976247ee-c7a2-4b64-bb57-76f9edd2a61b",
                                                "sense_id": "00960ccf-b2c9-399a-9700-6ae67b6f3e97",
                                                "text": "„Neben dem Opossum, das sich auch nach Nordamerika ausgebreitet hat, gehört hierher auch der otterähnliche Schwimmbeutler, das einzige aquatil lebende Beuteltier, verbreitet in den Gebirgsflüssen von Guatemala bis Südbrasilien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51151942-e652-4b0b-a478-1712a6e1ca71",
                        "source_entry_id": "1d760b1a-644f-3094-8dd8-0241da66f5ef",
