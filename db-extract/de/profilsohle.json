                            {
                                "example_id": "7e909c73-a5c5-4246-b7e6-e973c0d42df7",
                                "sense_id": "54fc21c7-0015-3930-ada5-5e17f733793d",
                                "text": "„Beim Schuhwerk achtet man auf die perfekte Passform, rutschfeste Profilsohle, Wasserdichte und geringes Gewicht.“"
                            },
                            {
                                "example_id": "375f3e05-ffae-4c9a-9a90-5f8240b5bab3",
                                "sense_id": "54fc21c7-0015-3930-ada5-5e17f733793d",
                                "text": "„Die speziell für Wasser und Schnee entwickelte Profilsohle verhindert außerdem, dass du auf dem Weg zum Jobinterview aufs Gesicht fällst.“"
                            },
                            {
                                "example_id": "680851aa-0f17-4da6-892d-af877ba50078",
                                "sense_id": "54fc21c7-0015-3930-ada5-5e17f733793d",
                                "text": "„Blake Lawson trägt Schwarz im Dienst – und dazu schwere Wanderstiefel mit dicker Profilsohle.“"
                            }
