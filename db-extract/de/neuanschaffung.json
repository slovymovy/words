                        "examples": [
                            {
                                "example_id": "76baa223-a914-4419-af68-074f4c3b3071",
                                "sense_id": "99c69a26-5419-37a5-9d5b-221cea6217c0",
                                "text": "In seiner Spedition sind dringend Neuanschaffungen von Zugmaschinen notwendig, da die aktuellen schon sehr viel Verschleiß haben."
                            },
                            {
                                "example_id": "21f7a9ec-b357-4c9a-9506-2d33f86353d4",
                                "sense_id": "99c69a26-5419-37a5-9d5b-221cea6217c0",
                                "text": "„Seit der Neuanschaffung der Wohnzimmersitzlandschaft und des Schlafzimmers hat die Mama ein schlechtes Gewissen dem Papa gegenüber und hat weitere Wünsche zurückgestellt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
