                "senses": [
                    {
                        "sense_id": "cb08a9af-c687-3a9d-a176-0e0bd2660834",
                        "entry_id": "d49eb60e-3daa-3d06-a36c-4fb2cfbfe915",
                        "glosses": [
                            "Händler, der sich auf den Verkauf von Produkten aus einer bestimmten Branche spezialisiert und oft über fundiertes Fachwissen zu diesen Produkten verfügt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46c5785f-1fb6-4547-ab3c-8238b13cf09a",
                                "sense_id": "cb08a9af-c687-3a9d-a176-0e0bd2660834",
                                "text": "„Fachhändler haben beim Akquirieren von Neukunden meist folgendes Problem: Sie müssen ihren Mitbewerbern Kunden abjagen.“"
                            },
                            {
                                "example_id": "932bb91d-cf65-4cc1-bd4e-5d1e3d23d825",
                                "sense_id": "cb08a9af-c687-3a9d-a176-0e0bd2660834",
                                "text": "„Voraussetzungen für ein erfolgreiches Geschäft ist das professionelle Agieren des Fachhändlers.“"
                            },
                            {
                                "example_id": "c9062bf4-df3c-4f05-8983-497bb0622cf0",
                                "sense_id": "cb08a9af-c687-3a9d-a176-0e0bd2660834",
                                "text": "„Jeder, ob Distributor oder Fachhändler, wird versuchen, seiner Kundschaft glaubhaft zu vermitteln, daß diese Produkte bei ihm bezogen werden müssen.“"
                            },
                            {
                                "example_id": "76c50695-8a13-4148-9a5b-d198a6c4d255",
                                "sense_id": "cb08a9af-c687-3a9d-a176-0e0bd2660834",
                                "text": "„Am besten lässt du dich von einem Fachhändler für Lauf- und Sportschuhe beraten, der dir je nach individuellem Laufstil passende Schuhe empfehlen kann.“"
                            },
                            {
                                "example_id": "f98e3197-be79-4c23-b0cf-3cd3e6df6034",
                                "sense_id": "cb08a9af-c687-3a9d-a176-0e0bd2660834",
                                "text": "„WM-Intern richtet sich an die Fachhändler aus den Bereichen Jagd, Messer, Schießsport und Security.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
