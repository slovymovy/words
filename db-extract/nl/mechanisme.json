                                "target_senses": [
                                    {
                                        "sense_id": "ad2ac18c-302a-3e55-a604-3dab88d40e31",
                                        "entry_id": "c6b20131-4e20-3721-a0f5-e4f1fb81b181",
                                        "glosses": [
                                            "Any mechanical means for the conversion or control of motion, or the transmission or control of power."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6691f726-d7b7-3a58-9386-3627e1bc26dc",
                                        "entry_id": "c6b20131-4e20-3721-a0f5-e4f1fb81b181",
                                        "glosses": [
                                            "Any combination of cams, gears, links, belts, chains and logical mechanical elements."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6912cadf-449b-483a-8ba5-5e35fb6ee929",
                                                "sense_id": "6691f726-d7b7-3a58-9386-3627e1bc26dc",
                                                "text": "A doorknob of whatever roundish shape is effectively a continuum of levers, with the axis of the latching mechanism—known as the spindle—being the fulcrum about which the turning takes place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae8b752e-09bc-3eab-be47-8c8f3d6bc711",
                                        "entry_id": "c6b20131-4e20-3721-a0f5-e4f1fb81b181",
                                        "glosses": [
                                            "A group of entities, such as objects, that interact together."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac725b1e-c8e8-40c4-8fff-567fd5fcc6d1",
                                                "sense_id": "ae8b752e-09bc-3eab-be47-8c8f3d6bc711",
                                                "text": "A very rare polymorphism in the prion protein gene recently has been identified that appears to protect against prion disease; this finding, in addition to providing greater understanding of the prionlike mechanisms of neurodegenerative disorders, might lead to potential treatments."
                                            },
                                            {
                                                "example_id": "38afd166-e150-48e8-9e5f-e379ac891a01",
                                                "sense_id": "ae8b752e-09bc-3eab-be47-8c8f3d6bc711",
                                                "text": "Outside the boundaries of the PTEs [Passenger Transport Executives], there was little mechanism to re-open routes, and despite a growing realisation that the lack of transport connectivity was a big contributor towards social deprivation and poor economic performance, there was little government policy recognition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acd42dd3-3a33-3c57-90cd-5a4b6f8e9a7d",
                                        "entry_id": "c6b20131-4e20-3721-a0f5-e4f1fb81b181",
                                        "glosses": [
                                            "A mental, physical, or chemical process."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba728253-d74a-3b74-a83c-2c0c9a9f3150",
                                        "entry_id": "c6b20131-4e20-3721-a0f5-e4f1fb81b181",
                                        "glosses": [
                                            "Any process of, or system designed to manage useful energy conversion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97ee36a4-847c-38ce-b718-2193353105d1",
                                        "entry_id": "c6b20131-4e20-3721-a0f5-e4f1fb81b181",
                                        "glosses": [
                                            "The theory that all natural phenomena can be explained by physical causes."
                                        ],
