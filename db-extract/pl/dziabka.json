                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hoe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a357bb71-0f37-3ec5-96d0-206ec240d975",
                                        "entry_id": "f23ee070-fe74-3e9a-a3f8-9951bc2659dc",
                                        "glosses": [
                                            "Any of various tools for scraping, scratching, digging, or stirring soil or other materials.",
                                            "An agricultural and horticultural hand tool consisting of a long handle with a flat blade fixed perpendicular to it at the end, used for digging rows or removing weeds by hand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aed9370-4971-458f-a56d-f2f74d7ae18f",
                                                "sense_id": "a357bb71-0f37-3ec5-96d0-206ec240d975",
                                                "text": "For their organic row crops, they do the weeding with hoes. They get in there often, but it goes fast, and the weeds never get ahead."
                                            },
                                            {
                                                "example_id": "57a589f9-b1c1-41ee-b551-a89ae0a6be17",
                                                "sense_id": "a357bb71-0f37-3ec5-96d0-206ec240d975",
                                                "text": "It was obvious that it consisted of several blows to the head from the hoe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6e0c946-b5c6-3a5e-9f6f-e381fbd06b24",
                                        "entry_id": "f23ee070-fe74-3e9a-a3f8-9951bc2659dc",
                                        "glosses": [
                                            "Any of various tools for scraping, scratching, digging, or stirring soil or other materials.",
                                            "Any of several implements or machines usually called by their more specific names, for example, backhoe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9a510f8-1e41-419a-8cc2-35978235eb32",
                                                "sense_id": "c6e0c946-b5c6-3a5e-9f6f-e381fbd06b24",
                                                "text": "The grading is on hold. In the meantime, get that hoe over here and work on this utility trench. [Instructions issued to a worker who will operate a backhoe]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hoe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4766fb44-118b-3fde-ab5f-8b24fc8bc52a",
                                        "entry_id": "6834dc92-05b5-3e55-9dcb-128157059442",
                                        "glosses": [
                                            "To cut, dig, scrape, turn, arrange, or clean, with this tool."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1313d4fc-9791-4c49-b05e-9f5eda842e12",
                                                "sense_id": "4766fb44-118b-3fde-ab5f-8b24fc8bc52a",
                                                "text": "to hoe the earth in a garden"
                                            },
                                            {
                                                "example_id": "3a6fda3b-537f-4261-8184-e0ce2bfe4358",
                                                "sense_id": "4766fb44-118b-3fde-ab5f-8b24fc8bc52a",
                                                "text": "Every year, I hoe my garden for aeration."
                                            },
                                            {
                                                "example_id": "746c1a0a-4a48-4719-8b8a-66c48778fa1f",
                                                "sense_id": "4766fb44-118b-3fde-ab5f-8b24fc8bc52a",
                                                "text": "I always take a shower after I hoe in my garden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf1eac7d-9d3f-3316-be45-53aee23cc45c",
                                        "entry_id": "6834dc92-05b5-3e55-9dcb-128157059442",
                                        "glosses": [
                                            "To clear from weeds, or to loosen or arrange the earth about, with a hoe."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af5b5aab-7f1e-4e70-8798-9951ec8aa6c2",
                                                "sense_id": "cf1eac7d-9d3f-3316-be45-53aee23cc45c",
                                                "text": "to hoe corn"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hoe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b4aa311-777a-3fc0-a259-96041b74cccc",
                                        "entry_id": "e83229ac-2969-3982-bb98-5e21b50577dd",
                                        "glosses": [
                                            "Alternative spelling of ho (“whore, prostitute”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c14d41e0-3929-4bc8-8a8c-e1b483ea0eff",
                                                "sense_id": "4b4aa311-777a-3fc0-a259-96041b74cccc",
                                                "text": "Then we split to the Cafe Black Rose / To party with some hoes"
                                            },
                                            {
                                                "example_id": "4a058e0e-3f25-4225-a4b0-64538101f31f",
                                                "sense_id": "4b4aa311-777a-3fc0-a259-96041b74cccc",
                                                "text": "Fuck all you hoes.\nGet a grip, motherfucker."
                                            },
                                            {
                                                "example_id": "59c61dd1-2776-432d-92cd-11d8d07f4bfc",
                                                "sense_id": "4b4aa311-777a-3fc0-a259-96041b74cccc",
                                                "text": "[…] this chapter […] will […] explore why pimp (and hoe) characters, with their dramatic staging of gendered and occupational relations […] have taken such hold of the black youth imagination"
                                            },
                                            {
                                                "example_id": "964e3c56-fcee-4107-a937-e1121fee85dd",
                                                "sense_id": "4b4aa311-777a-3fc0-a259-96041b74cccc",
                                                "text": "At school they had been among the only couples that had not done “it” at the Pimp & Hoe parties that popped up occasionally at the dorm"
                                            },
                                            {
                                                "example_id": "65bfa10c-f456-4642-8094-1143badf5d5e",
                                                "sense_id": "4b4aa311-777a-3fc0-a259-96041b74cccc",
                                                "text": "On the podcast, Gaines and his co-host Walter Weekes (Fresh), regularly refer to women as “hoes” or 304s (304 on an upside-down calculator looks like the word “hoe”)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hoe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68cd0078-4266-3703-8c9b-b5f574db7bab",
                                        "entry_id": "725db590-4718-3bf4-9fbb-9662261f559c",
                                        "glosses": [
                                            "Alternative spelling of ho (“to prostitute”)."
                                        ],
                                        "tags": [
                                            "US",
                                            "alt-of",
                                            "alternative",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e3daa40-a00c-4964-bda6-9faa79c935a4",
                                                "sense_id": "68cd0078-4266-3703-8c9b-b5f574db7bab",
                                                "text": "Pimpin’ came so naturally to MT when he and his sisters played pimp and hoe games that one of his sisters wanted to hoe for him when they grew up."
                                            }
                                        ]
                                    }
                                ]
                            },
