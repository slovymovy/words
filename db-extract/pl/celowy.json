                                        "entry_id": "f381583d-e390-3499-8b3c-f1b4e812aeb0",
                                        "glosses": [
                                            "Qui se fait sans contrainte, de pure volonté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0048c22-8a47-4d6e-ba71-b78efcb64797",
                                                "sense_id": "9cedb3e3-cda0-3c20-bbca-a40bd01335cf",
                                                "text": "Dans cette recherche, nous nous demandons comment expliquer et favoriser l’implication des sapeurs-pompiers volontaires (SPV) au sein des Services départementaux d’incendie et de secours (SDIS)."
                                            },
                                            {
                                                "example_id": "cf77dfec-ab9c-4cce-bea2-898e801b3e9c",
                                                "sense_id": "9cedb3e3-cda0-3c20-bbca-a40bd01335cf",
                                                "text": "L’embastillement sanitaire et épidémiologique peut pour autant nuire davantage que l’emmurement volontaire de l’abstraction créative ? Peut-il conduire à un esseulement frisant la déréliction ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e174ba57-bdaa-39f3-a472-2934ba22547e",
                                        "entry_id": "f381583d-e390-3499-8b3c-f1b4e812aeb0",
                                        "glosses": [
                                            "Qui a contracté un engagement dans l'armée de son plein gré dans l’année."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a02a097-e9a6-4fd4-b7db-fdf1eb022aaf",
                                                "sense_id": "e174ba57-bdaa-39f3-a472-2934ba22547e",
                                                "text": "Engagé volontaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66194fcc-2acc-3879-8665-a68046a2e0e1",
                                        "entry_id": "f381583d-e390-3499-8b3c-f1b4e812aeb0",
                                        "glosses": [
                                            "Qui veut fermement arriver à réaliser sa volonté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a40ca49-480c-4dee-b931-7b73e0ba2506",
                                                "sense_id": "66194fcc-2acc-3879-8665-a68046a2e0e1",
                                                "text": "Ce petit garçon est très volontaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "volontaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa653831-b0b5-3fcd-a006-d15e15298cc1",
                                        "entry_id": "3efa7b70-6a3e-3984-853b-80a7a73578cc",
                                        "glosses": [
                                            "Celui qui sert dans une armée sans y être obligé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "327b0006-6c90-4d1d-a743-c5143cd5e8e6",
                                                "sense_id": "aa653831-b0b5-3fcd-a006-d15e15298cc1",
                                                "text": "Un bataillon de volontaires."
                                            },
                                            {
                                                "example_id": "9eb58b6f-76da-4d23-beda-a84ec5c6673f",
                                                "sense_id": "aa653831-b0b5-3fcd-a006-d15e15298cc1",
                                                "text": "Il servait en qualité de volontaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ccecb6b-d3d9-3dff-86a2-36bc9ccc5c6d",
                                        "entry_id": "3efa7b70-6a3e-3984-853b-80a7a73578cc",
                                        "glosses": [
                                            "Celui qui prend part à une tâche sans y être obligé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd4e2ff5-4f52-472e-9b98-bdaebc207be2",
                                                "sense_id": "7ccecb6b-d3d9-3dff-86a2-36bc9ccc5c6d",
                                                "text": "Le cryobiologiste se caressa le menton. Il trouvait que son adjoint n'avait aucune considération pour les volontaires. Or, sans volontaires, il n'existerait pas d’expériences."
                                            },
                                            {
                                                "example_id": "2fadc2f2-a4b3-4538-b087-f741ad3c28db",
                                                "sense_id": "7ccecb6b-d3d9-3dff-86a2-36bc9ccc5c6d",
                                                "text": "On demande des volontaires."
                                            },
                                            {
                                                "example_id": "6939b8b0-d849-4d15-9c2e-68ff0679b5b6",
                                                "sense_id": "7ccecb6b-d3d9-3dff-86a2-36bc9ccc5c6d",
                                                "text": "Il y est allé comme volontaire."
                                            }
                                        ]
                                    }
                                ]
                            }
