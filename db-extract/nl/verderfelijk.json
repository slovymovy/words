                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd40a3eb-beaf-4a59-aba8-90dd39b179a0",
                                                "sense_id": "5eef875e-db13-373d-8c84-d441470c56c1",
                                                "text": "That was a wicked guitar solo, bro!"
                                            }
                                        ]
                                    }
