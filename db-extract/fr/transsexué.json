                "senses": [
                    {
                        "sense_id": "6bab3800-a2a8-3120-afb4-2ea8de9bff4b",
                        "entry_id": "9a927c78-4ae7-30cc-abe2-f95a028a0030",
                        "glosses": [
                            "Ayant changé ou souhaitant changer de sexe, ou en cours de transition."
                        ],
                        "tags": [
                            "Transitude"
                        ],
                        "examples": [
                            {
                                "example_id": "d835af81-95e0-4385-b386-6842dbe762de",
                                "sense_id": "6bab3800-a2a8-3120-afb4-2ea8de9bff4b",
                                "text": "Son seul problème est qu’on sait, dans sa région, qu’elle est transsexuée, et que cela inquiète un peu la clientèle."
                            },
                            {
                                "example_id": "f84c0b26-b467-44ae-bb80-b6e4e66db40a",
                                "sense_id": "6bab3800-a2a8-3120-afb4-2ea8de9bff4b",
                                "text": "Notons qu’il y a peu de temps encore, les personnes transsexuées ne pouvaient choisir leur prénom, ou féminiser leur prénom de baptême… il leur fallait piocher dans la liste des prénoms épicènes, comme Claude, Camille, Dominique…"
                            },
                            {
                                "example_id": "fe0361ae-2baa-46df-8d03-451c2bcaae12",
                                "sense_id": "6bab3800-a2a8-3120-afb4-2ea8de9bff4b",
                                "text": "Contrairement à nombre d’autres autobiographies de personnes transsexuées, celle de Beatie s’attache moins à narrer un parcours de vie où s’expérimente l’inscription dans un genre d’élection via une transformation corporelle."
                            }
                        ]
                    }
                ],
