                    {
                        "translation_id": "91a7434a-bbdf-443a-8d15-e5b8af7a6328",
                        "source_entry_id": "04ee209c-c02d-3cac-8040-8a4bb20b10f3",
                        "source_sense_id": "14236abe-e8aa-3d49-9ca8-5b169d4b07b1",
                        "target_lang_word": "Fluktuation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fluktuation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6321a2d-b96e-330a-8643-5beb18a57fb4",
                                        "entry_id": "7525caeb-e99b-36d3-93c8-5b612cbc4b3f",
                                        "glosses": [
                                            "unregelmäßige, zufällige Veränderung, Schwankung; zum Beispiel die Fluktuation um einen Mittelwert oder zwischen zwei Extremen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40396310-50e5-4bd1-98db-dec951a7898b",
                                                "sense_id": "e6321a2d-b96e-330a-8643-5beb18a57fb4",
                                                "text": "Der Börsenkurs unterlag im letzten Monat starken Fluktuationen."
                                            },
                                            {
                                                "example_id": "01e6bdfb-dd8d-4a14-a6a0-76e612a7c200",
                                                "sense_id": "e6321a2d-b96e-330a-8643-5beb18a57fb4",
                                                "text": "„In den Zellen herrschte jetzt zwar eine höhere Fluktuation, doch die Zahl der Gefängnisinsassen war immer noch gefährlich hoch.“"
                                            },
                                            {
                                                "example_id": "8af8924e-4e5d-4c77-b9da-f81e3196628c",
                                                "sense_id": "e6321a2d-b96e-330a-8643-5beb18a57fb4",
                                                "text": "„In Nürnberg war die Oligarchie ebenso schmal und ebenso abgeschlossen wie in Augsburg, anders als etwa in der Hansestadt Lübeck, wo die Fluktuation der Eliten verhinderte, dass sich eine geburtsständische Exklusivität der politischen Macht herausbildete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba6216a1-4be6-4acc-96cd-6eae2812b118",
                        "source_entry_id": "04ee209c-c02d-3cac-8040-8a4bb20b10f3",
                        "source_sense_id": "14236abe-e8aa-3d49-9ca8-5b169d4b07b1",
                        "target_lang_word": "Schwankung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwankung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd22b32e-23dd-3ea4-91e7-4d1151fc5b00",
                                        "entry_id": "76479590-492c-32e6-a751-379de2734613",
                                        "glosses": [
                                            "ständige Veränderung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2de25ba5-d722-4605-9526-a2909aad4a54",
                                                "sense_id": "bd22b32e-23dd-3ea4-91e7-4d1151fc5b00",
                                                "text": "Die Temperaturen sind im Hochgebirge großen Schwankungen unterworfen."
                                            },
                                            {
                                                "example_id": "62ec736a-032a-4a16-9fa1-36a398650121",
                                                "sense_id": "bd22b32e-23dd-3ea4-91e7-4d1151fc5b00",
                                                "text": "„Zweitens werde diskutiert, ob die globale Erwärmung die jährlichen Schwankungen im Luftdruckunterschied zwischen Islandtief und Azorenhoch verstärkt.“"
                                            },
                                            {
                                                "example_id": "edee166a-14a2-4046-888b-5ef5bf6c054e",
                                                "sense_id": "bd22b32e-23dd-3ea4-91e7-4d1151fc5b00",
                                                "text": "„Die Jahresleistung der Windkraft- und Fotovoltaikanlagen kommt also nicht durch einen gleichmäßigen und bedarfsgerechten Ertrag, sondern als Ergebnis massiver Schwankungen in der Erzeugung zustande.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
