                {
                    "sense_id": "b3b5924d-7bde-39ea-95a3-6e5de102a31b",
                    "sense_definition": "Devenir habité ou voir sa population augmenter progressivement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "habitat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce aux nouvelles constructions, ce quartier calme commence à se <w>peupler</w>.",
                            "target_lang_translations": {
                                "en": "Thanks to the new housing, this quiet neighbourhood is starting to <w>become populated</w>.",
                                "ru": "Благодаря новым постройкам этот тихий район начинает <w>заселяться</w>.",
                                "de": "Dank der Neubauten beginnt dieses stille Viertel, <w>sich</w> zu <w>bevölkern</w>.",
                                "es": "Gracias a las nuevas construcciones, este barrio tranquilo empieza a <w>poblarse</w>.",
                                "zh": "得益于新建的住房，这个安静的街区开始有人<w>入住</w>了。"
                            }
                        },
                        {
                            "text": "La nouvelle banlieue s'est rapidement <w>peuplée</w> de jeunes travailleurs.",
                            "target_lang_translations": {
                                "en": "The new suburb quickly <w>became populated</w> with young workers.",
                                "ru": "Новый пригород быстро <w>заселился</w> молодыми работниками.",
                                "de": "Die neue Vorstadt hat <w>sich</w> schnell mit jungen Arbeitern <w>bevölkert</w>.",
                                "es": "El nuevo suburbio <w>se pobló</w> rápidamente de jóvenes trabajadores.",
                                "zh": "这片新郊区很快便有大批年轻工人<w>定居</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "se dépeupler"
                    ],
                    "common_phrases": [
                        "se peupler rapidement"
                    ],
                    "target_lang_definitions": {
