                "senses": [
                    {
                        "sense_id": "820b4256-3a53-387b-a746-335c8bf1cef9",
                        "entry_id": "7b0f08fb-aca7-38ae-9231-e2352825b51e",
                        "glosses": [
                            "Donner un caractère guadeloupéen à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbe00142-9a4c-4c9e-a59c-a4393e1704eb",
                                "sense_id": "820b4256-3a53-387b-a746-335c8bf1cef9",
                                "text": "Inspiré de la cadence, musique haïtienne qui associe gwo-ka et biguine, il a été \"guadeloupéanisé\" et \"endiablé\" par le groupe Kassav."
                            },
                            {
                                "example_id": "d7afb218-8ab1-408a-b2ca-71a66594b15d",
                                "sense_id": "820b4256-3a53-387b-a746-335c8bf1cef9",
                                "text": "Un Martiniquais, individu forcément nanti d'une identité, peut parfaitement, par amour pour la culture guadeloupéenne, se guadeloupéaniser, sans pour autant perdre son identité, c'est-à-dire ce qui fait qu’il est lui et pas tel ou tel Guadeloupéen, ou tel ou tel Martiniquais, ou tel ou tel Allemand."
                            },
                            {
                                "example_id": "a0dd7599-7f91-4ff5-b3d1-ac0c3ee10873",
                                "sense_id": "820b4256-3a53-387b-a746-335c8bf1cef9",
                                "text": "Le forum social se guadeloupéanise"
                            }
                        ]
                    }
