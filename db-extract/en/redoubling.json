                        "glosses": [
                            "The act by which something is redoubled."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0927bde-5791-469e-9f97-8515e4a3912e",
                                "sense_id": "f8a55142-3daa-3a2f-abaf-438e71bf3ee6",
                                "text": "With their multiple narrators, labyrinthine story-within-a-story narrations, echoic redoublings and repetitions, and complex forms of self-referentiality, they repeatedly circumvent their own ostensibly orderly plot progressions."
                            },
                            {
                                "example_id": "45380696-e7cc-4450-88be-6be562656feb",
                                "sense_id": "f8a55142-3daa-3a2f-abaf-438e71bf3ee6",
                                "text": "Two short-term measures are proposed. The first is the redoubling of the junction, so that Up and Down trains on the Ely line no longer conflict with each other. The second is the provision of a passing loop."
                            }
                        ]
                    }
