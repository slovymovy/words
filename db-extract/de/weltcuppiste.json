                        "tags": [],
                        "examples": [
                            {
                                "example_id": "109ef2ba-8579-4838-8486-284124fe118e",
                                "sense_id": "f60b6eb9-6ec6-344d-9365-af639f144330",
                                "text": "„Burkhart verunglückte im Training für ein Rennen der Nor-Am-Serie auf der Weltcuppiste in Lake Louise – trotz bester Absicherung.“"
                            },
                            {
                                "example_id": "8ae76a19-c499-469d-afa5-863e6827c2a3",
                                "sense_id": "f60b6eb9-6ec6-344d-9365-af639f144330",
                                "text": "„Auf dem Truppenübungsplatz Seetaleralpe und auf der Weltcuppiste in Obdach kämpften die besten Soldaten aus ganz Österreich um Meter und Sekunden.“"
                            },
                            {
                                "example_id": "365d6d66-77d3-49aa-8274-3105bf5dbd45",
                                "sense_id": "f60b6eb9-6ec6-344d-9365-af639f144330",
                                "text": "„Denn nirgendwo könne man so gut trainieren wie auf einer Weltcuppiste, sagt der Coach.“"
                            }
                        ],
