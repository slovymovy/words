                                "target_senses": [
                                    {
                                        "sense_id": "47575cfe-44b2-320b-8d55-ee602cca460e",
                                        "entry_id": "197bfc91-2cb9-3138-9fe2-199c4c9b9d6f",
                                        "glosses": [
                                            "naar men denkt, maar niet zeker weet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fedacda-ea97-497d-9961-d88fcb2fff33",
                                                "sense_id": "47575cfe-44b2-320b-8d55-ee602cca460e",
                                                "text": "Ruimtevaartorganisatie NASA is klaar met het uitvoeren van tests met zijn Space Launch System-raket (SLS). De raket wordt vermoedelijk eind augustus gelanceerd."
                                            },
                                            {
                                                "example_id": "d524b982-e6a9-4113-b45c-e1dc1eedf34d",
                                                "sense_id": "47575cfe-44b2-320b-8d55-ee602cca460e",
                                                "text": "Vermoedelijk waren de mooie vloerkleden ook gewassen met groene zeep omdat andere soorten zeep en wasmiddel op rantsoen waren."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vermoedelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "063b5909-7fff-3bd1-9b4b-13459fa6e4f0",
                                        "entry_id": "007bbe57-d192-35af-b5a5-714b5d581b43",
                                        "glosses": [
                                            "naar men denkt, maar niet zeker weet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acc8f9a3-b66b-4c5f-82ee-78b17d1ab9f3",
                                                "sense_id": "063b5909-7fff-3bd1-9b4b-13459fa6e4f0",
                                                "text": "Riccardo bleef in de kuil van zo'n 1,5 meter achter en is vermoedelijk een tunnel gaan graven."
                                            },
                                            {
                                                "example_id": "a7fe291b-c694-488c-a93e-ffa05390955e",
                                                "sense_id": "063b5909-7fff-3bd1-9b4b-13459fa6e4f0",
                                                "text": "Aan beide kanten worden de onzekerheden in de resultaten vermoedelijk onderschat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "956adc2e-3fb9-4094-89f4-4829407bd568",
                        "source_entry_id": "1bb75cc1-9b52-327a-bd0e-e4ee37e715d4",
                        "source_sense_id": "02ec4e5d-cd1f-36cd-bc44-49ee8da1f7d2",
                        "source_sense_description": "able to be sensibly presumed",
                        "target_lang_word": "waarschijnlijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waarschijnlijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "809dff0c-a9cb-382a-bb0c-08fe50c943db",
                                        "entry_id": "a09a0e47-b575-3989-81ea-fcbe64ca77fd",
                                        "glosses": [
                                            "aannemelijk, iets dat vermoedelijk zo is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "951fda54-e0fe-4712-9520-64cf510207ea",
                                                "sense_id": "809dff0c-a9cb-382a-bb0c-08fe50c943db",
                                                "text": "Dit is de waarschijnlijke oorzaak van zijn overmatige alcoholgebruik."
                                            },
                                            {
                                                "example_id": "c64a87db-7cf1-4a95-a87f-69bec2f461a1",
                                                "sense_id": "809dff0c-a9cb-382a-bb0c-08fe50c943db",
                                                "text": "Kuipers benadrukt dat er momenteel geen redenen zijn voor een extra vaccinatieronde. Die zullen volgens hem in de loop van het jaar waarschijnlijk wel ontstaan."
                                            },
                                            {
                                                "example_id": "a78bc783-d596-42b6-aed8-e00ba5adea54",
                                                "sense_id": "809dff0c-a9cb-382a-bb0c-08fe50c943db",
                                                "text": "Alleen al het onroerendgoedarsenaal in Berlijn en Dresden bezat waarschijnlijk een waarde die niet zomaar in geld was uit te drukken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0bba82c-e70f-39d1-b00a-aba68945f8b7",
                                        "entry_id": "a09a0e47-b575-3989-81ea-fcbe64ca77fd",
                                        "glosses": [
                                            "een aanzienlijke kans bezittend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "917d9338-bf1f-4c2e-b8a6-cabedded4921",
                                                "sense_id": "f0bba82c-e70f-39d1-b00a-aba68945f8b7",
                                                "text": "Getuige zijn verrichtingen op het tentamen is het niet erg waarschijnlijk dat hij dit jaar zal afstuderen."
                                            },
                                            {
                                                "example_id": "db57dc71-45bb-4990-87e9-2fd90aeeac4c",
                                                "sense_id": "f0bba82c-e70f-39d1-b00a-aba68945f8b7",
                                                "text": "Deze fabrikanten proberen elkaar flink af te troeven. \"Er is echt een innovatie-oorlog gaande. Omdat er nu zo veel concurrentie is, probeert iedereen nieuwe functies in een auto te stoppen\", zegt Van Dillen. Niet elke innovatie is volgens hem even geslaagd. \"Veel van de nieuwe Chinese auto's hebben een waslijst aan innovaties waar mensen waarschijnlijk niet veel van zullen gebruiken.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "waarschijnlijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "eeaba038-1218-3c9a-a473-67299c6174f8",
                                        "entry_id": "5ecb3b44-c824-38ef-b457-f4d6bc651cca",
                                        "glosses": [
                                            "aannemelijk, iets dat vermoedelijk zo is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "357b2d32-c8aa-4651-bc65-2b4268eee75e",
                                                "sense_id": "eeaba038-1218-3c9a-a473-67299c6174f8",
                                                "text": "Hij had waarschijnlijk te veel alcohol gedronken."
                                            },
                                            {
                                                "example_id": "4a498228-948c-4054-8735-719e83326a82",
                                                "sense_id": "eeaba038-1218-3c9a-a473-67299c6174f8",
                                                "text": "Dat kwam waarschijnlijk omdat je in de woestijn altijd alles om je heen kon zien, maar ook doordat ik uit het vlakke Nederland kom, waar ik gewend ben aan weidse landschappen met vergezichten en hoge luchten."
                                            },
                                            {
                                                "example_id": "db75a3af-6041-4396-acd2-9f19c396b11f",
                                                "sense_id": "eeaba038-1218-3c9a-a473-67299c6174f8",
                                                "text": "Waarschijnlijk was het helemaal niet terecht geweest dat hij de twee Duitse schrijvers had vervloekt die om een of andere reden niet samen in het Grand Hotel in Saltsjôbaden wilden verblijven, zodat een van hen, helaas de bolsjewiek en niet de Nobelprijswinnaar, bij hen thuis in Villa Bellevue moest logeren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c7e95c2-a890-302c-9fc9-6e14c07998d4",
                                        "entry_id": "5ecb3b44-c824-38ef-b457-f4d6bc651cca",
                                        "glosses": [
                                            "een aanzienlijke kans bezittend"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
