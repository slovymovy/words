{
    "word_family": [
        "vaten",
        "vaatwasser",
        "vaatdoek",
        "vaatwerk"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "88aebb0c-043c-3ebe-87e8-2db739109162",
                    "sense_definition": "De verzameling van borden, glazen en bestek die na een maaltijd gewassen moeten worden.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "huishouden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het grote diner stond er een enorme berg <w>vaat</w> in de keuken te wachten.",
                            "target_lang_translations": {
                                "en": "After the big dinner, a huge pile of <w>dishes</w> was waiting in the kitchen."
                            }
                        },
                        {
                            "text": "Wie vanavond niet kookt, doet de <w>vaat</w> terwijl de anderen uitrusten.",
                            "target_lang_translations": {
                                "en": "Whoever doesn't cook tonight does the <w>washing-up</w> while the others rest."
                            }
                        }
                    ],
                    "synonyms": [
                        "afwas"
                    ],
                    "common_phrases": [
                        "doet de vaat",
                        "vuile vaat",
                        "schone vaat"
                    ],
                    "target_lang_definitions": {
                        "en": "The collection of plates, glasses, and cutlery that need to be washed after a meal."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dishes",
                                "target_lang_sense_clarification": "the items to be washed"
                            },
                            {
                                "target_lang_word": "washing-up",
                                "target_lang_sense_clarification": "the act or the items of cleaning dishes"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e6c6f183-af9f-3fbe-9b74-2c8a052b2fa6",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>vaten</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>vaat</w> de vloeistof in houten tonnen om het rijpingsproces te laten beginnen.",
                            "target_lang_translations": {
                                "en": "I <w>barrel</w> the liquid in wooden tuns to let the aging process begin."
                            }
                        },
                        {
                            "text": "Wanneer ik de wijn <w>vaat</w>, moet ik heel voorzichtig te werk gaan.",
                            "target_lang_translations": {
                                "en": "When I <w>cask</w> the wine, I have to work very carefully."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eerste persoon enkelvoud tegenwoordige tijd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first person singular present tense of 'vaten' (to barrel or put into casks)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "barrel",
                                "target_lang_sense_clarification": "to put liquid into a barrel"
                            },
                            {
                                "target_lang_word": "cask",
                                "target_lang_sense_clarification": "to put liquid into a cask"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57ad32d3-80bd-322f-907e-8be18bec6638",
                    "sense_definition": "De gebiedende wijs van <w>vaten</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Vaat</w> het bier nu direct voordat de temperatuur in de kelder te hoog wordt.",
                            "target_lang_translations": {
                                "en": "<w>Barrel</w> the beer right now before the temperature in the cellar gets too high."
                            }
                        },
                        {
                            "text": "Kom op, <w>vaat</w> die laatste liters zodat we eindelijk klaar zijn met het werk.",
                            "target_lang_translations": {
                                "en": "Come on, <w>cask</w> those last liters so we can finally be finished with the work."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The imperative form of 'vaten' (to barrel or put into casks)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "barrel",
                                "target_lang_sense_clarification": "command to put liquid into a barrel"
                            },
                            {
                                "target_lang_word": "cask",
                                "target_lang_sense_clarification": "command to put liquid into a cask"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}