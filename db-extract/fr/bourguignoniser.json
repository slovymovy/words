                "senses": [
                    {
                        "sense_id": "06ef2588-5769-3851-bbf3-0cc091a6c3e4",
                        "entry_id": "59262b1a-106c-3c38-ace0-68d67bf46819",
                        "glosses": [
                            "Donner un caractère bourguignon à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aba247c6-066e-4bd1-9e6e-2b8d67fa0277",
                                "sense_id": "06ef2588-5769-3851-bbf3-0cc091a6c3e4",
                                "text": "Pitainche n'est pas un mot bourguignon ; c'est un terme de l'argot, que le poëte a bourguignonisé."
                            },
                            {
                                "example_id": "b80b6b30-f4de-4eb7-8745-a4265f179e58",
                                "sense_id": "06ef2588-5769-3851-bbf3-0cc091a6c3e4",
                                "text": "Avait-elle par mégarde bourguignonisé de trop sa tisane du matin (tisane bourguignonne : tisane, miel, marc de Bourgogne, si si, recette rusée!"
                            },
                            {
                                "example_id": "9b288895-67eb-47b2-89ed-6bfb4716537a",
                                "sense_id": "06ef2588-5769-3851-bbf3-0cc091a6c3e4",
                                "text": "ps : et dire que je pense que la champagne devrait parcelliser des cuvées un peu partout (où cela en vaut la peine) histoire de se bourguignoniser l'image un peu."
                            }
                        ]
                    }
