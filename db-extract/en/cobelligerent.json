                                        "sense_id": "eb9b61a3-4e78-3fa0-94ec-284757a35d76",
                                        "entry_id": "d069b2ff-6db6-3383-9ab9-870d19ca6507",
                                        "glosses": [
                                            "Person oder Institution, die mit anderen Personen/Institutionen zusammenarbeiten, sich gegenseitig unterstützen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a60112d9-2363-4078-a254-e8f1903d463f",
                                                "sense_id": "eb9b61a3-4e78-3fa0-94ec-284757a35d76",
                                                "text": "„Sein einstiger Verbündeter Tschombé wird zum Gegenspieler auf Leben und Tod.“"
                                            },
                                            {
                                                "example_id": "7dea2051-84c7-4848-83de-1c979c4b9a47",
                                                "sense_id": "eb9b61a3-4e78-3fa0-94ec-284757a35d76",
                                                "text": "„Da kommt wohl Uraltes und immer Neues zwischen zwei Nachbarvölkern zum Vorschein, die derzeit doch als Waffengefährten, als brüderlich Verbündete gelten.“"
                                            },
                                            {
                                                "example_id": "6a8861ec-0da3-4582-bb11-049076dcb0d3",
                                                "sense_id": "eb9b61a3-4e78-3fa0-94ec-284757a35d76",
                                                "text": "„Diese Zahlen umschließen auch die beschlagnahmten Auslandsguthaben und die unter den Verbündeten aufgeteilte deutsche Handelsflotte.“"
                                            },
                                            {
                                                "example_id": "2de4f15b-bbe0-4567-b49d-6a59e1c64f6a",
                                                "sense_id": "eb9b61a3-4e78-3fa0-94ec-284757a35d76",
                                                "text": "„Ärzte boten sich da als die natürlichen Verbündeten der Kolonialbehörden an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11290afc-eb79-4aa6-b828-be570b5d622e",
                        "source_entry_id": "5fdb9a01-b94c-3034-9917-bde541900b38",
