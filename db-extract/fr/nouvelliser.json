                "senses": [
                    {
                        "sense_id": "ef78119c-40b9-3445-92d2-47c43604421a",
                        "entry_id": "ad2285ef-751e-3001-b613-45c6aa222772",
                        "glosses": [
                            "Donner à quelque chose un caractère de nouvelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e85a3ad6-ade0-4a7d-a6fe-fa79652df285",
                                "sense_id": "ef78119c-40b9-3445-92d2-47c43604421a",
                                "text": "Il ne fait plus rien autre chose au monde, que boire, manger, se promener, jouer à la boule, et nouvelliser."
                            },
                            {
                                "example_id": "d796f186-04a7-48f7-89f1-d648d45704a7",
                                "sense_id": "ef78119c-40b9-3445-92d2-47c43604421a",
                                "text": "Je vais, pour contenter l’Europe,\nOù notre lettre en vers galope,\nApprenant d’ailleurs ma leçon,\nNouvelliser d’autre façon."
                            },
                            {
                                "example_id": "b25c65f8-4dba-4e2b-a1f5-4c0d0870ef77",
                                "sense_id": "ef78119c-40b9-3445-92d2-47c43604421a",
                                "text": "Une écriture se vouant à l'exactitude du mot afin de nouvelliser la nouvelle, se recentrer autour du mot."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
