                                "sense_id": "bda52b46-6c47-3285-a7e3-4cd837f88afa",
                                "text": "Masseo odbył nowicjat w Miejskiej Górce."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "61749b37-13c3-3065-8b94-815618410d7f",
                        "entry_id": "9444b6f6-3adb-32ac-9897-4dc932bae8b1",
                        "glosses": [
