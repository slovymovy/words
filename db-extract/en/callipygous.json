                "senses": [
                    {
                        "sense_id": "39dd2753-9a66-3040-8ecd-74199ac11d80",
                        "entry_id": "dbc0fc4d-a366-33fc-a36b-cd0c8284be10",
                        "glosses": [
                            "Synonym of callipygian."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2c91f3b-c0ff-42e8-a54e-d16897ccf1ea",
                                "sense_id": "39dd2753-9a66-3040-8ecd-74199ac11d80",
                                "text": "One does not fall very desperately in love with a loud speaker, however pretty, however firmly plump (for Philip's tastes were rather old-fashioned), however attractively callipygous."
                            },
                            {
                                "example_id": "5377fdaf-ef45-4b71-a841-9cf9bb089ffd",
                                "sense_id": "39dd2753-9a66-3040-8ecd-74199ac11d80",
                                "text": "He enjoyed Nurse Sue Ann Duckett’s long white legs and supple, callipygous ass; he often neglected to remember that she was quite slim and fragile from the waist up and hurt her unintentionally in moments of passion when he hugged her too roughly."
                            },
                            {
                                "example_id": "6947d9c1-d481-459d-bb39-9e8960801bf7",
                                "sense_id": "39dd2753-9a66-3040-8ecd-74199ac11d80",
                                "text": "The other hand came up and together they described a near callipygous shape."
                            }
                        ]
                    }
                ],
