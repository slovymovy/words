                "senses": [
                    {
                        "sense_id": "37fdc8cd-6ef4-3195-943e-a894c8b3006e",
                        "entry_id": "7f1af939-83f9-33b5-9f62-b354f1b8d800",
                        "glosses": [
                            "zeitweise bestehende Absperrung, Absicherung einer Baustelle, eines Baugrundstücks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60cf045b-2703-4364-a977-2817d4365d93",
                                "sense_id": "37fdc8cd-6ef4-3195-943e-a894c8b3006e",
                                "text": "Durch Lücken im Bauzaun können Neugierige bereits einen Blick auf das neue Gebäude werfen."
                            },
                            {
                                "example_id": "d7d6ad70-3a53-4320-8cd9-33aeaee6e4df",
                                "sense_id": "37fdc8cd-6ef4-3195-943e-a894c8b3006e",
                                "text": "„Hinter dem Bauzaun pufft eine Lokomotive.“"
                            },
                            {
                                "example_id": "2d40f144-690a-4d14-9165-d87abd4446bb",
                                "sense_id": "37fdc8cd-6ef4-3195-943e-a894c8b3006e",
                                "text": "„Ein Bauzaun ist die vorübergehende Einfriedung eines Baugrundstückes und gegebenenfalls für die Durchführung der Arbeiten auf Zeit hinzugemieteter privater oder öffentlicher angrenzender Grundstücke oder Flächen. Ein Bauzaun dient der räumlichen Abgrenzung der Baustelle und zum Schutz von Personen und Sachgütern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
