                "senses": [
                    {
                        "sense_id": "3e078070-eecd-3ab4-8abb-f7cbf8767d90",
                        "entry_id": "d346f7ba-5300-31c9-a9cf-4bf7f3b665ee",
                        "glosses": [
                            "dornenartig umgewandelte Blätter oder Blattteile einer Pflanze als Abwehr gegen Tierfraß"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dbe0521-e9b8-43b3-aeab-4b17c950d5d2",
                                "sense_id": "3e078070-eecd-3ab4-8abb-f7cbf8767d90",
                                "text": "„Steht der Dorn mit dem Holze in direkter Verbindung, so unterscheidet man ihn auch wohl als Zweigdorn, und erscheint er als Fortsetzung der Gefässbündel der Blätter (der Blattrippen, Blattnerven), so nennt man ihn Blattdorn.“"
                            },
                            {
                                "example_id": "0812bf23-fb82-46ae-81bf-ba13d0e459c1",
                                "sense_id": "3e078070-eecd-3ab4-8abb-f7cbf8767d90",
                                "text": "„Naturgegebenes Muster war gleichsam die Verbindung der Agavefasern mit dem Blattdorn in der Spitze (Abb. 126).“"
                            },
                            {
                                "example_id": "2a3ee089-b53b-491f-a688-059d50e6ab08",
                                "sense_id": "3e078070-eecd-3ab4-8abb-f7cbf8767d90",
                                "text": "„Bei Robinia pseudoacacia wandelten sich die Nebenblätter zu je einem Blattdorn um.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
