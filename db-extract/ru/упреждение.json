                                "target_senses": [
                                    {
                                        "sense_id": "d18326c2-adc0-3421-9d3b-b2789cc5020a",
                                        "entry_id": "e15b9947-7123-3eed-b748-ac07747bacae",
                                        "glosses": [
                                            "present participle of warn"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "714d661c-5c3e-47b7-abf9-ad190e201b43",
                                                "sense_id": "d18326c2-adc0-3421-9d3b-b2789cc5020a",
                                                "text": "Although the Celebrity was almost impervious to sarcasm, he was now beginning to exhibit visible signs of uneasiness,[…]. It was with a palpable relief that he heard the first warning notes of the figure."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "warning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "196576a3-8eb3-3c89-9b36-3945c174bf34",
                                        "entry_id": "eb6f05bc-cb42-3439-805c-3816cb415f62",
                                        "glosses": [
                                            "The action of the verb warn; an instance of warning someone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17291c83-c313-47a7-a4f1-edf0f88351a5",
                                                "sense_id": "196576a3-8eb3-3c89-9b36-3945c174bf34",
                                                "text": "“[…] Churchill, my dear fellow, we have such greedy sharks, and wolves in lamb's clothing. Oh, dear, there's so much to tell you, so many warnings to give you, but all that must be postponed for the moment.”"
                                            },
                                            {
                                                "example_id": "e8cf8cff-826a-4628-8105-aca963a5443d",
                                                "sense_id": "196576a3-8eb3-3c89-9b36-3945c174bf34",
                                                "text": "Without much warning, a deep voice addressed the crowd, calling for a reverent silence as the Texans who died at the Alamo battle were named."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c95bb4b0-520c-3649-9d00-cfdc0fd2923e",
                                        "entry_id": "eb6f05bc-cb42-3439-805c-3816cb415f62",
                                        "glosses": [
                                            "Something spoken or written that is intended to warn."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba0af597-65be-4afe-ba9c-d882551eb4ae",
                                                "sense_id": "c95bb4b0-520c-3649-9d00-cfdc0fd2923e",
                                                "text": "The boss gave him a warning that he would be fired if he did not desist from his behaviour."
                                            },
                                            {
                                                "example_id": "c93e111d-0d40-4721-b7c8-894656861fe8",
                                                "sense_id": "c95bb4b0-520c-3649-9d00-cfdc0fd2923e",
                                                "text": "Risk is everywhere. From tabloid headlines insisting that coffee causes cancer (yesterday, of course, it cured it) to stern government warnings about alcohol and driving, the world is teeming with goblins."
                                            }
                                        ]
                                    }
                                ]
                            },
