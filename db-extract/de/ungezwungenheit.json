                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0b91efa-7cb4-4ed0-b6a8-e75acaca13fd",
                                "sense_id": "1e092733-1cbc-363b-ae5f-62cc28f5605a",
                                "text": "„Die größte Apathie und die größte Kraftäußerung bildeten hier durch ihre Ungezwungenheit nur um so größere Kontraste.“"
                            },
                            {
                                "example_id": "9758a376-6a3e-4510-9875-71ba796345af",
                                "sense_id": "1e092733-1cbc-363b-ae5f-62cc28f5605a",
                                "text": "„Fräulein X. C. V. verband mit einer seltenen Schönheit die Ungezwungenheit und den Ton der besten Gesellschaft, und besaß außerdem noch Anlagen und gründliche Kenntnisse, die sie stets nur am rechten Ort und ohne jede Anmaßung zur Geltung brachte.“"
                            }
                        ],
