                "senses": [
                    {
                        "sense_id": "20583b39-6305-3da8-9aed-fb94072e23f4",
                        "entry_id": "2b6d75ce-dd70-374f-b715-cb72df07f3f7",
                        "glosses": [
                            "het heel ergens naar verlangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dee2db5-d411-4581-accc-1cd4698897cf",
                                "sense_id": "20583b39-6305-3da8-9aed-fb94072e23f4",
                                "text": "Rik kreeg weer een wilde blik in zijn ogen. Hij kuste Marjoleins borsten met een begerigheid alsof hij de Internationale in zijn eentje tweestemmig zong."
                            },
                            {
                                "example_id": "db1572ff-d4ab-433b-9ce2-bbda88b8952a",
                                "sense_id": "20583b39-6305-3da8-9aed-fb94072e23f4",
                                "text": "Ik denk dat als je kinderen straft door ze geen zoetigheid te geven hun begerigheid eerder groter wordt."
                            }
                        ]
                    },
                    {
                        "sense_id": "347a2b8d-3372-3957-933d-640559a402ec",
                        "entry_id": "2b6d75ce-dd70-374f-b715-cb72df07f3f7",
                        "glosses": [
                            "iets waar men heel erg naar verlangt"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd2c2cf0-4e1d-4e7a-9d08-a40fb3953b06",
                        "source_entry_id": "2b6d75ce-dd70-374f-b715-cb72df07f3f7",
                        "source_sense_id": "20583b39-6305-3da8-9aed-fb94072e23f4",
                        "source_sense_description": "het heel ergens naar verlangen",
                        "target_lang_word": "voracity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voracity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3415ab9-1391-3805-be51-2b30edac8c71",
                                        "entry_id": "04a2fc1b-4157-31d9-b913-7a0fb89d223e",
                                        "glosses": [
                                            "The state of being voracious; rapacity or extreme gluttony."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86950551-1002-45d2-a327-a31f9c9fe57b",
                                                "sense_id": "d3415ab9-1391-3805-be51-2b30edac8c71",
                                                "text": "Beatrice felt heart-sick to see the famished voracity with which her father ate—it was the first time he had tasted food for three days."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7b11583-28a9-48e6-ad86-fd424f0a0d64",
                        "source_entry_id": "2b6d75ce-dd70-374f-b715-cb72df07f3f7",
                        "source_sense_id": "20583b39-6305-3da8-9aed-fb94072e23f4",
                        "source_sense_description": "het heel ergens naar verlangen",
                        "target_lang_word": "greediness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "greediness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95d7859f-422f-39b9-81c7-8487d3aa8e71",
                                        "entry_id": "e66ff6fc-5f5e-3ece-a466-bb673954707c",
                                        "glosses": [
                                            "The state of being greedy; greed."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88501a69-e290-4be2-9061-faf0a003c8b4",
                                                "sense_id": "95d7859f-422f-39b9-81c7-8487d3aa8e71",
                                                "text": "Thereto the body of a dog she had, / Full of fell ravin and fierce greedinesse […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8d87fb6-a167-419c-9c07-eae33c01e5d1",
                        "source_entry_id": "2b6d75ce-dd70-374f-b715-cb72df07f3f7",
                        "source_sense_id": "20583b39-6305-3da8-9aed-fb94072e23f4",
                        "source_sense_description": "het heel ergens naar verlangen",
                        "target_lang_word": "avidity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avidity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "682b3e75-898e-37d3-b054-a3aa8036d75b",
                                        "entry_id": "adacd4b9-0de1-3c23-be59-bd9e945b1093",
                                        "glosses": [
                                            "Greediness; strong appetite."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15e20ad0-ff23-3ec4-8e81-1213a897af37",
                                        "entry_id": "adacd4b9-0de1-3c23-be59-bd9e945b1093",
                                        "glosses": [
                                            "Eagerness; intenseness of desire."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd3cf2db-7ed6-41f7-b3fe-a514226f89d9",
                                                "sense_id": "15e20ad0-ff23-3ec4-8e81-1213a897af37",
                                                "text": "to eat with avidity"
                                            },
                                            {
                                                "example_id": "2afe94cb-2e88-484a-840e-4358f84cea7b",
                                                "sense_id": "15e20ad0-ff23-3ec4-8e81-1213a897af37",
                                                "text": "Still, there was an inquiry after me, the 'who was she?' that never can, that never must be answered; and it was pursued with only the more avidity, because my accomplishments proved that I had been expensively educated, and nature had stamped me with her own kindly distinctions."
                                            },
                                            {
                                                "example_id": "db9b3c11-2238-4d43-913f-c6759a637c42",
                                                "sense_id": "15e20ad0-ff23-3ec4-8e81-1213a897af37",
                                                "text": "Come, walk up, and purchase with avidity, / Overcome your diffidence and natural timidity."
                                            },
                                            {
                                                "example_id": "4a4ceba4-ab12-488a-86b7-54da2e765dfc",
                                                "sense_id": "15e20ad0-ff23-3ec4-8e81-1213a897af37",
                                                "text": "Little disappointed, then, she turned attention to \"Chat of the Social World,\" gossip which exercised potent fascination upon the girl's intelligence. She devoured with more avidity than she had her food those pretentiously phrased chronicles of the snobocracy—[…]—distilling therefrom an acid envy that robbed her napoleon of all its flavor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "386be1b4-628b-3456-b094-b5fb0ae49aa1",
                                        "entry_id": "adacd4b9-0de1-3c23-be59-bd9e945b1093",
                                        "glosses": [
                                            "The measure of the synergism of the strength of individual interactions between proteins."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2505d74-8d13-4f68-a283-d93c289699fd",
                        "source_entry_id": "2b6d75ce-dd70-374f-b715-cb72df07f3f7",
                        "source_sense_id": "20583b39-6305-3da8-9aed-fb94072e23f4",
                        "source_sense_description": "het heel ergens naar verlangen",
                        "target_lang_word": "greed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "greed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bff3a12-6956-38c5-9db7-39123cafa205",
                                        "entry_id": "55171cf4-41ee-31f1-9eaa-90671c1faec9",
                                        "glosses": [
                                            "A selfish or excessive desire for more than is needed or deserved, especially of money, wealth, food, or other possessions."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9830e570-5c1d-4e67-a317-8fd1cee96526",
                                                "sense_id": "8bff3a12-6956-38c5-9db7-39123cafa205",
                                                "text": "His greed was his undoing."
                                            },
                                            {
                                                "example_id": "9998a4c5-5551-4fed-990c-e7cd09736564",
                                                "sense_id": "8bff3a12-6956-38c5-9db7-39123cafa205",
                                                "text": "[…]But when I had bestridden the plank, quoth I to myself, \"Thou deserveth all that betideth thee. All this is decreed to me of Allah (whose name be exalted!), to turn me from my greed of gain, whence ariseth all that I endure, for I have wealth galore.\""
                                            },
                                            {
                                                "example_id": "090ab8ff-1782-428a-8903-372d23ae4873",
                                                "sense_id": "8bff3a12-6956-38c5-9db7-39123cafa205",
                                                "text": "Your market gardener is not a well-breeched man, dependant as he is on the imponderables of glut, the inequities of distribution, and the greeds of wholesaler and retailer."
                                            },
                                            {
                                                "example_id": "da05c7f1-cd52-47e9-95d3-7e40241c412f",
                                                "sense_id": "8bff3a12-6956-38c5-9db7-39123cafa205",
                                                "text": "She does not display voracities and greeds like a number of patients […] nor has she shown any significant tendency to possessiveness, grievance, paranoia, or mania."
                                            },
                                            {
                                                "example_id": "e472d04f-fceb-4cd9-8cc5-a17da0d738e1",
                                                "sense_id": "8bff3a12-6956-38c5-9db7-39123cafa205",
                                                "text": "The point is, ladies and gentleman, that greed, for lack of a better word, is good. Greed is right, greed works. Greed clarifies, cuts through, and captures the essence of the evolutionary spirit. Greed, in all of its forms; greed for life, for money, for love, knowledge has marked the upward surge of mankind."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "greed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec41933d-5820-3913-b821-23406d83c31e",
                                        "entry_id": "0cc97faf-bca1-385b-82df-ecd5dd0fbb81",
                                        "glosses": [
                                            "To desire in a greedy manner, or to act on such a desire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8670af7-9cad-404b-8633-d597266d1af5",
                                                "sense_id": "ec41933d-5820-3913-b821-23406d83c31e",
                                                "text": "The ravens sit greeding, / And watching, and heeding: / Thoro' wind, over water, / Comes scent of the slaughter, / And ravens sit greeding / Their share of the bones."
                                            },
                                            {
                                                "example_id": "b0808650-caae-47d5-bdb8-af9168706414",
                                                "sense_id": "ec41933d-5820-3913-b821-23406d83c31e",
                                                "text": "Hearing these words he arose, because indeed he greeded for her, and came up behind her as she rested upon her elbows and knees and bending in hand his prickle nailed it into her coynte and did manly devoir."
                                            },
                                            {
                                                "example_id": "de2fb649-fa3f-42e7-8e14-1be5d6d1a96a",
                                                "sense_id": "ec41933d-5820-3913-b821-23406d83c31e",
                                                "text": "This conniving bastard has greeded the farm off an old man and I end up with nothing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
