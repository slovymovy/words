                                    {
                                        "sense_id": "8e44f988-4ede-330d-b303-5d8904952aac",
                                        "entry_id": "2b109896-2574-34e9-93fe-a9c638a7f4a6",
                                        "glosses": [
                                            "An attack of a psychological disorder such as depression or anxiety so severe that it prevents a person from continuing to function normally"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db4a4d71-9fdf-466c-99e2-e9d5cd4d71d1",
                                                "sense_id": "8e44f988-4ede-330d-b303-5d8904952aac",
                                                "text": "1887, George Gissing, Thyrza\nThere was organic disease, and there was what is vaguely called nervous breakdown; it was too clear that Mr. Newthorpe must count upon very moderate activity either of mind or body henceforth."
                                            },
                                            {
                                                "example_id": "7aefe608-0a76-4ac2-ad9a-a2bd9d339559",
                                                "sense_id": "8e44f988-4ede-330d-b303-5d8904952aac",
                                                "text": "1915, P. G. Wodehouse, Something New\n...will you kindly think up at your earliest convenience some plan for politely ejecting this Mr Chalmers of yours from our humble home?--because if you don't, I'm going to have a nervous breakdown."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "532d36af-7549-3022-9ba0-145ab0f69482",
                                        "entry_id": "2b109896-2574-34e9-93fe-a9c638a7f4a6",
                                        "glosses": [
                                            "A psychological disorder usually characterized by panic attacks and aggressiveness, related to the Hispanic ataque de nervios."
                                        ],
