                        "glosses": [
                            "wegweisender Beschluss, der zwar nicht der eigentlichen Sache gilt, aber einen Weg zu einem solchen nachfolgenden Beschluss ebnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
