                    "semantic_group_id": "osoba_sluzaca",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wierny <w>służebny</w> czekał przed wejściem na kolejne polecenia swojego pana.",
                            "target_lang_translations": {
                                "ru": "Верный <w>слуга</w> ждал у входа следующих распоряжений своего господина."
                            }
                        },
                        {
                            "text": "Książę odprawił wszystkich <w>służebnych</w>, aby porozmawiać z posłem bez świadków.",
                            "target_lang_translations": {
                                "ru": "Князь отослал всех <w>слуг</w>, чтобы поговорить с послом без свидетелей."
