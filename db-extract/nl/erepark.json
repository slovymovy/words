                        "glosses": [
                            "deel van een begraafplaats waar belangrijke personen begraven liggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f8f7e69-28a9-44f9-a597-d989263d9faa",
                                "sense_id": "b31a8f2d-9e67-3cb5-a297-40d3389e7f9b",
                                "text": "Het was Rosseels’ wens om hier begraven te worden. Gezien haar verdiensten had ze in aanmerking kunnen komen voor een plaats op Erepark Schoonselhof in Antwerpen."
                            },
                            {
                                "example_id": "a3b6ef0a-7116-4ec7-b3d9-58eadd9ab0d8",
                                "sense_id": "b31a8f2d-9e67-3cb5-a297-40d3389e7f9b",
                                "text": "In 1953 werd de naam van Gijssels aan een nieuwe straat op Linkeroever (Antwerpen) gegeven. Twee jaar later werd zijn graf overgebracht naar het Erepark van de begraafplaats Schoonselhof."
                            }
