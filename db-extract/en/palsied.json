                        "glosses": [
                            "Trembling as if afflicted with palsy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a94ed6b0-d25f-4be8-956f-668e56cfc856",
                                "sense_id": "d385c9a9-f6be-32f8-8fd0-d53d74437cf3",
                                "text": "Then came some palsied oak, a cleft in him / Like a distorted mouth that splits its rim / Gaping at death, and dies while it recoils."
                            },
                            {
                                "example_id": "716fb556-053e-4a47-adf5-8265a0ae5455",
                                "sense_id": "d385c9a9-f6be-32f8-8fd0-d53d74437cf3",
                                "text": "[“]You had another of your vacillating consultations with your councillors. Fine advisers.” With infinite scorn, “A herd of palsied purblind idiots hugging their sterile profits close to their sunken chests in the face of my father’s displeasure.”"
                            }
                        ]
                    }
