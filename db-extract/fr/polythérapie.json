                        "glosses": [
                            "Traitement par plusieurs médicaments différents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c751165-8023-46b1-82eb-4dc3cdd52de5",
                                "sense_id": "cdb5fb2a-7d77-37f0-a850-46943844a675",
                                "text": "L’association de différents types de crises (qui ont une sensibilité pharmacologique différente), le recours à la polythérapie, et la survenue fréquente de périodes d’exacerbation de la maladie avec crises en série ou état de mal, créent un climat propice à la survenue d’effets secondaires et d’aggravation paradoxale."
                            }
                        ]
                    }
                ],
