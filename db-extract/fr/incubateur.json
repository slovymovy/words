                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d9a18f-645f-4a2d-b2cc-36a3f8f2b500",
                                                "sense_id": "89bce26b-7375-34a8-8423-b32d600b6610",
