                "senses": [
                    {
                        "sense_id": "346190b6-8274-3803-863b-47162c8bd807",
                        "entry_id": "ba6f15de-6c6c-3be0-8de7-e8ac3ae78322",
                        "glosses": [
                            "Hauptakteur beziehungsweise (allgemein) Puppe aus dem Ensemble des Kasperletheaters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9d8cc77-4ea1-44da-87b3-b76f60bc6c48",
                                "sense_id": "346190b6-8274-3803-863b-47162c8bd807",
                                "text": "„Für die Kasperlefigur ist kennzeichnend, dass das Kasperle dumm ist, aber immer siegt und aus den schlimmsten Dingen heil herauskommt.“"
                            },
                            {
                                "example_id": "3a807538-7fc5-461d-ad11-f17f5118bacf",
                                "sense_id": "346190b6-8274-3803-863b-47162c8bd807",
                                "text": "„Am einfachsten und schnellsten lassen sich Kasperlefiguren aus alten Tennisbällen herstellen.“"
                            },
                            {
                                "example_id": "9c8eed57-1232-47ea-95a2-77269e1650ee",
                                "sense_id": "346190b6-8274-3803-863b-47162c8bd807",
                                "text": "„Er liebte die groben, klar geschnitzten Gesichtszüge der Kasperlefiguren.“"
                            },
                            {
                                "example_id": "56526e70-c224-4401-b46a-9feea6bacb9e",
                                "sense_id": "346190b6-8274-3803-863b-47162c8bd807",
                                "text": "„Dem Gehäuse angemessen, bewegen sie sich als Kasperlefiguren: steif, künstlich.“"
                            },
                            {
                                "example_id": "8825cc9c-695c-47b0-bbbd-39b98abb1e1b",
                                "sense_id": "346190b6-8274-3803-863b-47162c8bd807",
                                "text": "„Dort sind die Kumpels und ich mit Decke und Kasperlefiguren unterm Arm von Tür zu Tür gegangen, und wir haben für ein oder zwei Pfennig ein Stück gespielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f5295aed-0dbc-39b2-83f4-b390f81f430a",
                        "entry_id": "ba6f15de-6c6c-3be0-8de7-e8ac3ae78322",
                        "glosses": [
                            "nicht ernst zu nehmende lächerliche oder witzige Person"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "3175db0e-acc9-45b2-b52f-355475992b8a",
                                "sense_id": "f5295aed-0dbc-39b2-83f4-b390f81f430a",
                                "text": "„Der Beckmesser, nichts von Formal-Fanatismus, von Ehrgeiz, Minderwertigkeitskomplex, Panik, von Menschlichem also, sondern ein Dorftrottel, eine Kasperlefigur.“"
                            },
                            {
                                "example_id": "595a2e86-7e46-4755-9f67-ebb9916e3d50",
                                "sense_id": "f5295aed-0dbc-39b2-83f4-b390f81f430a",
                                "text": "„Zwei Kasperlefiguren sind seine Werkzeuge.“"
                            },
                            {
                                "example_id": "fda35d96-0aef-456b-83f8-ee05dc251cc4",
                                "sense_id": "f5295aed-0dbc-39b2-83f4-b390f81f430a",
                                "text": "„Während Rechte die Innenstädte erobern, verniedlicht die ZDF-Miniserie ‚Familie Braun’ Nazis zu witzigen Kasperlefiguren.“"
                            },
                            {
                                "example_id": "e7dd4add-c3f3-453b-87ec-db1104a600ae",
                                "sense_id": "f5295aed-0dbc-39b2-83f4-b390f81f430a",
                                "text": "„Die Kostüme (von Gaby Frey) setzen die Suche nach einem Gegner fort: die Herrschenden tragen Fräcke und Melonen, das charakterisiert sie klischeehaft als Kasperlefiguren einer herrschenden Klasse, aber beweiskräftig, erschreckend, zu Herrschafts-Automaten werden sie nicht.“"
                            },
                            {
                                "example_id": "0457e244-a46a-4928-a5ff-1ce988b94d7c",
                                "sense_id": "f5295aed-0dbc-39b2-83f4-b390f81f430a",
                                "text": "„Ich hab’ wirklich was zu bieten, aber keine Kasperlefigur.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
