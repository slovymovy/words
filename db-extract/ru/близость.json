                                    {
                                        "sense_id": "5adf682a-6ffd-3f36-88ca-ba2af2d9b919",
                                        "entry_id": "bdce317b-f2a4-3304-868b-30498337c306",
                                        "glosses": [
                                            "geringe räumliche Entfernung, von einem bestimmten Punkt aus gesehen"
