                        "examples": [
                            {
                                "example_id": "2c70dc25-b10d-4324-8258-3c81ab09917c",
                                "sense_id": "0851a1b2-e35c-36c0-9ed5-0a4f4685feaf",
                                "text": "De meest kritieke fase is daarmee voorbij, meldt de brandweer, die 950 brandweerlieden inzette. De vlammen worden geblust met behulp van vliegtoestellen. Er blijven nog 520 brandweerlieden in het gebied om de brand verder te controleren. Hulpdiensten spreken van een 'megabrand'."
                            },
                            {
                                "example_id": "92a5f57a-5185-4086-9780-3cc5e9ccf6d3",
                                "sense_id": "0851a1b2-e35c-36c0-9ed5-0a4f4685feaf",
                                "text": "Door het kleine vliegtoestel werd de onrust in het toch al rumoerige stadion tijdens de eerste helft alleen maar groter. Na 41 minuten werd het duel stilgelegd en uiteindelijk gestaakt bij een stand van 0-0."
                            }
                        ]
                    }
