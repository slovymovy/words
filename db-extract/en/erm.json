                "senses": [
                    {
                        "sense_id": "0509e245-7da0-32ee-a0ce-9d341c4f3017",
                        "entry_id": "18475826-8f0e-3482-9f78-6242c4583dfe",
                        "glosses": [
                            "Used in hesitant speech, or to express uncertainty."
                        ],
                        "tags": [
                            "UK",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "fe506932-1fd5-49ec-8489-07ba26641fa8",
                                "sense_id": "0509e245-7da0-32ee-a0ce-9d341c4f3017",
                                "text": "She was going to, erm... the salon, I think."
                            }
                        ]
                    },
                    {
                        "sense_id": "57fa3fd9-8752-30a3-9286-b03fb3fddfbc",
                        "entry_id": "18475826-8f0e-3482-9f78-6242c4583dfe",
                        "glosses": [
                            "Used to express embarrassment or subtle disagreement."
                        ],
                        "tags": [
                            "UK",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "c183aab5-9107-439d-8529-1e05058bcf82",
                                "sense_id": "57fa3fd9-8752-30a3-9286-b03fb3fddfbc",
                                "text": "Erm, I don't think that was supposed to happen."
                            },
                            {
                                "example_id": "b39358a5-c721-4cf3-97b3-9c00b3ce8ded",
                                "sense_id": "57fa3fd9-8752-30a3-9286-b03fb3fddfbc",
                                "text": "– Bob would never say something like that!\n– Erm, he just did."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cf363a3-f7b5-4b12-be8d-577efd4bfa6d",
                        "source_entry_id": "18475826-8f0e-3482-9f78-6242c4583dfe",
