                        "examples": [
                            {
                                "example_id": "1d6fb5f8-29d8-4a14-a980-ba808af1c333",
                                "sense_id": "00a04492-f39d-3b3f-a255-1bc18231aaab",
                                "text": "Die tijd heeft mijn wereldbeeld gevormd."
                            },
                            {
                                "example_id": "b5a2323f-cdfa-4aef-b7b7-ddbc129fc330",
                                "sense_id": "00a04492-f39d-3b3f-a255-1bc18231aaab",
                                "text": "Het bestuur wordt gevormd door vrijwilligers."
                            },
                            {
                                "example_id": "7cb0aaa1-7c05-4b97-86d8-e428dc2dee96",
                                "sense_id": "00a04492-f39d-3b3f-a255-1bc18231aaab",
                                "text": "Wacht tot een schuim laagje is gevormd."
                            },
                            {
                                "example_id": "e158b786-d12d-4d6a-a0e7-228c464d7fac",
                                "sense_id": "00a04492-f39d-3b3f-a255-1bc18231aaab",
                                "text": "Ik ben gevormd door alles wat ik heb meegemaakt."
                            },
                            {
                                "example_id": "989b118e-ddd6-4747-8ac0-84b35b2c6f8c",
                                "sense_id": "00a04492-f39d-3b3f-a255-1bc18231aaab",
                                "text": "De jongen was goed getraind als een atleet, met golven in het iets te lange roodblonde haar en een mond die net zo gevormd was als die van zijn moeder."
                            }
                        ]
                    }
