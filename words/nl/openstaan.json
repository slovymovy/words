{
    "word_family": [
        "openheid",
        "openstellen",
        "openstaand"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e2ea84fd-f62a-3ff4-883f-86ff50085ea5",
                    "sense_definition": "niet gesloten zijn van een object zoals een deur, raam of kraan",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fysiek_open",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik merkte pas later dat de achterdeur de hele nacht had <w>opengestaan</w>.",
                            "target_lang_translations": {
                                "en": "I only noticed later that the back door had <w>been open</w> all night."
                            }
                        },
                        {
                            "text": "Laat de kraan niet <w>openstaan</w> terwijl je je tanden poetst.",
                            "target_lang_translations": {
                                "en": "Don't leave the tap <w>running</w> while you brush your teeth."
                            }
                        }
                    ],
                    "antonyms": [
                        "dichtstaan"
                    ],
                    "common_phrases": [
                        "de kraan laten openstaan",
                        "het raam laten openstaan"
                    ],
                    "target_lang_definitions": {
                        "en": "to be in an open position, such as a door, window, or tap"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be open",
                                "target_lang_sense_clarification": "referring to physical objects"
                            },
                            {
                                "target_lang_word": "to be left open",
                                "target_lang_sense_clarification": "referring to something not closed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79e3f26c-7c49-3be1-bb00-d42c83c58787",
                    "sense_definition": "bereid zijn om naar iets te luisteren of over iets nieuws na te denken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mentaal_open",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>staat</w> altijd <w>open</w> voor nieuwe ideeën van zijn collega's.",
                            "target_lang_translations": {
                                "en": "He is always <w>open</w> to new ideas from his colleagues."
                            }
                        },
                        {
                            "text": "Je moet <w>openstaan</w> voor kritiek als je jezelf wilt verbeteren.",
                            "target_lang_translations": {
                                "en": "You must <w>be open</w> to criticism if you want to improve yourself."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontvankelijk"
                    ],
                    "common_phrases": [
                        "openstaan voor suggesties",
                        "openstaan voor kritiek"
                    ],
                    "target_lang_definitions": {
                        "en": "to be willing to listen to or consider new ideas or suggestions"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be open to",
                                "target_lang_sense_clarification": "receptive to ideas or criticism"
                            },
                            {
                                "target_lang_word": "to be receptive",
                                "target_lang_sense_clarification": "willing to consider suggestions"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cb83526-0d38-3138-8e89-1cd18d3aa876",
                    "sense_definition": "nog niet vervuld, afgehandeld of betaald zijn",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onvervuld",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er <w>staan</w> nog verschillende vacatures <w>open</w> bij dat internationale bedrijf.",
                            "target_lang_translations": {
                                "en": "There are still several vacancies <w>open</w> at that international company."
                            }
                        },
                        {
                            "text": "Er <w>staan</w> nog drie rekeningen <w>open</w> die deze week betaald moeten worden.",
                            "target_lang_translations": {
                                "en": "There are still three bills <w>outstanding</w> that must be paid this week."
                            }
                        }
                    ],
                    "synonyms": [
                        "onbetaald",
                        "vacant"
                    ],
                    "antonyms": [
                        "voldaan"
                    ],
                    "common_phrases": [
                        "rekeningen laten openstaan",
                        "vacatures die openstaan"
                    ],
                    "target_lang_definitions": {
                        "en": "to be currently unfilled, outstanding, or unpaid"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be outstanding",
                                "target_lang_sense_clarification": "referring to unpaid bills"
                            },
                            {
                                "target_lang_word": "to be vacant",
                                "target_lang_sense_clarification": "referring to job positions"
                            },
                            {
                                "target_lang_word": "to be open",
                                "target_lang_sense_clarification": "referring to unresolved matters or vacancies"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}