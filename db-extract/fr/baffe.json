                        ],
                        "examples": [
                            {
                                "example_id": "efe03a07-644e-4378-a8a3-5b2d5956064e",
                                "sense_id": "495690fb-0ddc-3c9a-b784-e1f3a595e59c",
                                "text": "Cette gonzesse lui a allongé / flanqué / fiché / foutu une baffe.",
                                "translation": "Die meid heeft hem een optater gegeven."
                            },
                            {
                                "example_id": "d3651099-b04c-4db9-9901-d81bc818ef76",
                                "sense_id": "495690fb-0ddc-3c9a-b784-e1f3a595e59c",
                                "text": "Les gosses ont besoin qu’on leur foute des baffes de temps en temps.",
                                "translation": "Kinderen hebben af en toe wat klappen nodig."
                            }
                        ]
                    }
                ],
