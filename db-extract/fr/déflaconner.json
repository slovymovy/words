                "senses": [
                    {
                        "sense_id": "a28f4f93-15f7-3537-8842-17a04cce1941",
                        "entry_id": "28ea3313-fb18-39cd-a251-1eda6d7b3894",
                        "glosses": [
                            "Sortir d’un flacon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37f5bafa-23cf-4877-a141-2a2bf532fc1f",
                                "sense_id": "a28f4f93-15f7-3537-8842-17a04cce1941",
                                "text": "Ne pas déflaconner les produits ;"
                            },
                            {
                                "example_id": "fac90979-5005-48e9-96f8-92b2e865a0c6",
                                "sense_id": "a28f4f93-15f7-3537-8842-17a04cce1941",
                                "text": "Pour déflaconner le plus sûr c'est d'entourer le verre de chatterton et de donner des légers coups de marteau dessus jusqu'à ce que ça casse."
                            },
                            {
                                "example_id": "15ee05a3-07f5-4aed-b0bd-816579fa24f1",
                                "sense_id": "a28f4f93-15f7-3537-8842-17a04cce1941",
                                "text": "Maintenant, lorsque je \"déflaconne\" je les laisse à l'air libre de suite."
                            }
                        ]
                    }
