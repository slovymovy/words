        "pl-extract.jsonl": [
            {
                "entry_id": "37be94d6-274b-3544-90bd-4d1dae0a5a7f",
                "word": "wysmukły",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8b3ddba7-5502-38ad-ba58-06d67f55fcec",
                        "entry_id": "37be94d6-274b-3544-90bd-4d1dae0a5a7f",
                        "glosses": [
                            "długi, wysoki oraz cienki, szczupły"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "852e8460-eb74-47b9-9cb4-c062518348aa",
                                "sense_id": "8b3ddba7-5502-38ad-ba58-06d67f55fcec",
                                "text": "Wysmukła wieża ze złotym kurkiem na kilkumetrowym żelaznym krzyżu górowała nad niskimi domkami w małych ogródkach i ciasnymi uliczkami śródmieścia."
                            },
                            {
                                "example_id": "dd7917bb-6e67-4bed-bbe2-17afd823b2b7",
                                "sense_id": "8b3ddba7-5502-38ad-ba58-06d67f55fcec",
                                "text": "Siostrzeniec hrabiego, wysmukły chłopak o bladej, zalanej krwią twarzy, o ustach drżących ze wzruszenia i trwogi, stał bez hełmu i tarczy w grupie jeźdźców, w których wprawne oko Bertrama po strojach i herbach w mig poznało Tureńczyków."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d050144-b49d-453f-b981-d2111e7c2a72",
                        "source_entry_id": "37be94d6-274b-3544-90bd-4d1dae0a5a7f",
                        "source_sense_id": "8b3ddba7-5502-38ad-ba58-06d67f55fcec",
                        "target_lang_word": "slender",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slender",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9dae0431-47c0-34f0-ab01-144c731b1dc3",
                                        "entry_id": "f78950f2-5aa3-312e-a1e9-882124a63654",
                                        "glosses": [
                                            "Thin; slim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e90d9a6f-073c-4c72-ad73-e5583d4890c0",
                                                "sense_id": "9dae0431-47c0-34f0-ab01-144c731b1dc3",
                                                "text": "A rod is a long slender pole used for angling."
                                            },
                                            {
                                                "example_id": "ba70c749-66a2-4b05-83d9-8affa575765e",
                                                "sense_id": "9dae0431-47c0-34f0-ab01-144c731b1dc3",
                                                "text": "She is very slender."
                                            },
                                            {
                                                "example_id": "0127d8bc-f5e0-49ce-8488-ba383eb3f2af",
                                                "sense_id": "9dae0431-47c0-34f0-ab01-144c731b1dc3",
                                                "text": "Sepia Delft tiles surrounded the fireplace, their crudely drawn Biblical scenes in faded cyclamen blending with the pinkish pine, while above them, instead of a mantelshelf, there was an archway high enough to form a balcony with slender balusters and a tapestry-hung wall behind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdac61a9-c8bd-32b6-bd39-48213277bfce",
                                        "entry_id": "f78950f2-5aa3-312e-a1e9-882124a63654",
                                        "glosses": [
                                            "Meagre; deficient."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2278568-096a-42f7-a28f-2c61d759af28",
                                                "sense_id": "bdac61a9-c8bd-32b6-bd39-48213277bfce",
                                                "text": "Being a person of slender means, he was unable to afford any luxuries."
                                            },
                                            {
                                                "example_id": "2c9e090e-a06b-44b7-8609-1dad26b94025",
                                                "sense_id": "bdac61a9-c8bd-32b6-bd39-48213277bfce",
                                                "text": "The grounds for the conjecture are somewhat slender."
                                            },
                                            {
                                                "example_id": "83df510e-0748-4e8a-abd7-6b7c67286d08",
                                                "sense_id": "bdac61a9-c8bd-32b6-bd39-48213277bfce",
                                                "text": "The slender service between Ellesmere Port and Helsby has been added, too."
                                            }
                                        ]
                                    },
