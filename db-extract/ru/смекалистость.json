                                    {
                                        "sense_id": "0af2b0a2-f929-3499-9139-16e49b6a6710",
                                        "entry_id": "30e14e33-ed27-39b6-8ef6-95c6890ace32",
                                        "glosses": [
                                            "Qualité qui fait qu’une personne est ingénieuse, adroite, inventive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45ad5858-aced-45c5-addb-d428997b83dc",
                                                "sense_id": "0af2b0a2-f929-3499-9139-16e49b6a6710",
                                                "text": "[…] puis il avait remonté les crêts par un des milles^([sic]) sentiers que l’ingéniosité des contrebandiers leur fait sans cesse frayer à travers ces prés-bois et ces boqueteaux de sapins."
                                            },
                                            {
                                                "example_id": "77deaf63-764d-42b4-8835-834599900f4c",
                                                "sense_id": "0af2b0a2-f929-3499-9139-16e49b6a6710",
                                                "text": "[…] la préoccupation qui, chez les hommes, semble dominer toutes les autres, c’est celle de la vitesse obtenue soit par leurs propres moyens, soit par des instruments, et des appareils de locomotion, au perfectionnement desquels ils appliquent le meilleur de leur ingéniosité et de leurs facultés inventives."
                                            },
                                            {
                                                "example_id": "01624a39-86a4-4fc1-a206-1dfc535d930d",
                                                "sense_id": "0af2b0a2-f929-3499-9139-16e49b6a6710",
                                                "text": "Rappelons seulement que la harira, soupe marocaine très spécifique est, quand elle est réussie, un chef-d’œuvre de l’ingéniosité des femmes de cette contrée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
