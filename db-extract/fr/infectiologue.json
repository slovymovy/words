                "senses": [
                    {
                        "sense_id": "a033dba9-6ffb-3c56-bc1c-4f3ca7b5b527",
                        "entry_id": "9a26f979-ba2d-332d-b02a-eefa2b05034c",
                        "glosses": [
                            "Spécialiste d’infectiologie, spécialiste des maladies infectieuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d939ca2-8705-4fab-858a-953306c20c4a",
                                "sense_id": "a033dba9-6ffb-3c56-bc1c-4f3ca7b5b527",
                                "text": "Un cas hypothétique doit bénéficier d’un infectiologue, de chambres avec sas et d’un labo adapté."
                            },
                            {
                                "example_id": "797a1dc2-9ef3-419d-82e7-a78cc7526ccf",
                                "sense_id": "a033dba9-6ffb-3c56-bc1c-4f3ca7b5b527",
                                "text": "Pourtant, sa propagation semble pour l’heure limitée, comme l’indique au « Nouvel Observateur » l’infectiologue François Bicaire."
                            },
                            {
                                "example_id": "356a89c9-9bee-40d5-9ad3-99e187ab9317",
                                "sense_id": "a033dba9-6ffb-3c56-bc1c-4f3ca7b5b527",
                                "text": "Comme l’a expliqué la Dre Caroline Quach, microbiologiste et infectiologue, au micro de Tout un matin, le nouveau variant n’est pas assez différent génétiquement de la souche primaire du SRAS-CoV-2 pour lui donner le nom de nouvelle souche, mais a accumulé suffisamment de mutations pour dire que le virus a changé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ba76fb8-eb02-4ece-9b88-8a302e8f201a",
                        "source_entry_id": "9a26f979-ba2d-332d-b02a-eefa2b05034c",
                        "source_sense_id": "a033dba9-6ffb-3c56-bc1c-4f3ca7b5b527",
                        "target_lang_word": "Infektiologin",
