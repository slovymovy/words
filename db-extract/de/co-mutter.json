                "senses": [
                    {
                        "sense_id": "4e79a4fd-edc0-3639-be88-cf115bd54098",
                        "entry_id": "27c9fc8f-cf41-3a33-ac3f-c96713467aa9",
                        "glosses": [
                            "(rechtlicher und/oder sozialer) nichtgebärender weiblicher Elternteil eines Kindes neben der leiblichen Mutter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3d41c61-d797-4328-b6bb-5ff33255b0e1",
                                "sense_id": "4e79a4fd-edc0-3639-be88-cf115bd54098",
                                "text": "„Deshalb könnten die Richter das Gesetz nicht so auslegen, dass sie die „Co-Mutter“ als Mutter feststellen könnten, erläuterte der Sprecher.“"
                            },
                            {
                                "example_id": "0b64fe8b-b7b6-4550-931b-51ffe88723bf",
                                "sense_id": "4e79a4fd-edc0-3639-be88-cf115bd54098",
                                "text": "„Dementsprechend muss die Co-Mutter, also in diesem Fall wäre das Verena Akkermann, auch weiterhin das Kind als Stiefkind adoptieren – selbst dann, wenn die Schwangerschaft durch eine anonyme Samenspende beziehungsweise durch eine Embryonenspende erfolgte.“"
                            },
                            {
                                "example_id": "8cc2960b-ad42-4903-a334-2efe3ee2ea4f",
                                "sense_id": "4e79a4fd-edc0-3639-be88-cf115bd54098",
                                "text": "„ Aber Inga, die Co-Mutter, durfte dort keine medizinisch notwendigen Entscheidungen treffen.“"
                            },
                            {
                                "example_id": "ebdacf7e-b2b5-42f5-8d5e-fcf472e8dac9",
                                "sense_id": "4e79a4fd-edc0-3639-be88-cf115bd54098",
                                "text": "„Die leibliche Mutter reduzierte nach der Geburt ihr Arbeitspensum auf 50 Prozent, die Co-Mutter blieb Hauptverdienerin der Familie.“"
                            },
                            {
                                "example_id": "10d58755-e347-4a3c-ac8a-3a3ff165b55c",
                                "sense_id": "4e79a4fd-edc0-3639-be88-cf115bd54098",
                                "text": "„Für verheiratete Frauen, die ein Kind bekommen, gibt es in Deutschland derzeit keine gesetzliche Regelung, welche das Verhältnis der sogenannten ‚Co-Mutter‘ zum Kind definiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
