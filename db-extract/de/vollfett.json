                "senses": [
                    {
                        "sense_id": "1bbefade-4fe3-3a51-acf6-6702416d228e",
                        "entry_id": "a34d3309-8669-3e9e-a844-89f9a132effd",
                        "glosses": [
                            "mit vollem Fettgehalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f17aa7c7-4d5e-4ffa-aecb-0506c7bac293",
                                "sense_id": "1bbefade-4fe3-3a51-acf6-6702416d228e",
                                "text": "„Die Hälfte der Bevölkerung bevorzugt vollfette Milch, die andere Hälfte kauft fettarme Milch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aacac8f2-6dde-3851-ba9a-233f2e71aff1",
                        "entry_id": "a34d3309-8669-3e9e-a844-89f9a132effd",
                        "glosses": [
                            "Eigenschaft von Käse mit mehr als 45% F. i. T."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38aaad7e-f831-411c-8c8b-21f730e7cc31",
                                "sense_id": "aacac8f2-6dde-3851-ba9a-233f2e71aff1",
                                "text": "„Fiore Sardo ist ein vollfetter Hartkäse aus Schafsmilch, der mit zunehmender Reife einen ausgeprägt pikanten Geschmack entwickelt. Seine Heimat ist Sardinien.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
