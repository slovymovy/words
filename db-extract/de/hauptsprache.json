                ],
                "senses": [
                    {
                        "sense_id": "ba4d56b0-3b52-33a5-8fbf-0141d5a52049",
                        "entry_id": "07d840fa-b08d-3569-bb10-b823ac5032c6",
                        "glosses": [
                            "in älteren Sprachauffassungen eine der wichtigen Sprachen, aus denen sich die anderen Sprachen entwickelten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fe5e082-341a-40f3-8621-7f2f7e04466e",
                                "sense_id": "ba4d56b0-3b52-33a5-8fbf-0141d5a52049",
                                "text": "„Man betrachtete zu dieser Zeit das Deutsche als eine der Hauptsprachen, die nach dem Turmbau zu Babel entstanden waren und von denen sich andere Sprachen als verderbte Dialekte entwickelt hatten, wie die romanischen Sprachen aus dem Latein.“"
                            },
                            {
                                "example_id": "d3069227-df0d-4241-a992-10158119cfa6",
                                "sense_id": "ba4d56b0-3b52-33a5-8fbf-0141d5a52049",
                                "text": "„Dadurch konnte man das Deutsche in den Rang einer weiteren Hauptsprache (vgl. den Titel von Schottelius 1663) neben den Sprachen der Bibelkodifikation (Hebräisch, Griechisch, Latein) erheben. Die kulturell ‚gebenden‘ Sprachen Italienisch, Französisch, Spanisch wurden dadurch, weil Derivate der Hauptsprache Latein, automatisch zu rangniederen ‚Nebensprachen‘ erklärt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "39f2dbe5-9991-37c6-a7b7-65feae47c1c4",
                        "entry_id": "07d840fa-b08d-3569-bb10-b823ac5032c6",
                        "glosses": [
                            "besonders wichtige Sprache in einer mehrsprachigen Umgebung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ea03571-a2cc-4131-8623-7acc0d39f02e",
                                "sense_id": "39f2dbe5-9991-37c6-a7b7-65feae47c1c4",
                                "text": "„Wie war es nun wirklich - hatte die deutsche Sprache wirklich einmal die Chance darauf, die Hauptsprache der Amerikaner zu werden?“"
                            },
                            {
                                "example_id": "0b4b0f92-e3ec-4a83-965f-d1548e94f073",
                                "sense_id": "39f2dbe5-9991-37c6-a7b7-65feae47c1c4",
                                "text": "„Lorena spricht Tok Pisin, die Hauptsprache von über 800 Sprachen im Land.“"
                            },
                            {
                                "example_id": "a5b17f6a-c8c4-4dd5-8828-eadb5e4fcddd",
                                "sense_id": "39f2dbe5-9991-37c6-a7b7-65feae47c1c4",
                                "text": "„In den Wäldern bildeten sich jüdische Partisaneneinheiten, in denen Jiddisch die Hauptsprache war und jiddische Kampflieder gesungen wurden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "2bf25063-7fed-3d84-9487-39b9a209b2c1",
                        "entry_id": "07d840fa-b08d-3569-bb10-b823ac5032c6",
                        "glosses": [
                            "die Sprache einer mehrsprachigen Person, in der diese Person denkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d619ade8-11f3-43eb-8ba1-c89f2607cff1",
                                "sense_id": "2bf25063-7fed-3d84-9487-39b9a209b2c1",
                                "text": "„Als Hauptsprache gilt die Sprache, in der die betreffende Person denkt und die sie am besten beherrscht.“"
                            },
                            {
                                "example_id": "dcff0618-6b3f-449b-a7d2-823c17ac4701",
                                "sense_id": "2bf25063-7fed-3d84-9487-39b9a209b2c1",
                                "text": "„Aber ihre Hauptsprache wird natürlich Polnisch sein.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
