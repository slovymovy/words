                "senses": [
                    {
                        "sense_id": "03acba45-c7f1-314d-b558-dcdb2d61e989",
                        "entry_id": "a510985d-c4c1-354d-9a6e-4aab82510487",
                        "glosses": [
                            "Test zur Bestimmung der individuellen Ausdauerleistungsfähigkeit durch schrittweise Belastungssteigerung und gleichzeitige Messung der Laktatkonzentration im Blut nach jeder Belastungsstufe"
                        ],
                        "tags": [
                            "Sportmedizin",
                            "Leistungsdiagnostik"
                        ],
                        "examples": [
                            {
                                "example_id": "bb7bfacf-dbf2-450f-91e1-ff0540e8f268",
                                "sense_id": "03acba45-c7f1-314d-b558-dcdb2d61e989",
                                "text": "„Leistungsdiagnostische Untersuchung (LDU) und DSV-Präventions-Screening Neben den motorischen Testverfahren findet eine halbjährliche leistungsdiagnostische Untersuchung (LDU) statt, die neben einer internistischen Untersuchung inklusive eines Laktatstufentests auch eine orthopädische Grunduntersuchung beinhaltet.“"
                            },
                            {
                                "example_id": "8f497b11-0d9e-4c5d-88e5-1d83108ea56a",
                                "sense_id": "03acba45-c7f1-314d-b558-dcdb2d61e989",
                                "text": "„Durch den Vergleich von Laktatstufentests können Schlüsse auf die Trainingsentwicklung gezogen werden.“"
                            },
                            {
                                "example_id": "d72de9b0-f9ff-4e2c-8cd0-963c2168a7ac",
                                "sense_id": "03acba45-c7f1-314d-b558-dcdb2d61e989",
                                "text": "„Der Laktatstufentest beinhaltet eine in Stufen ansteigende Belastung auf dem Laufband, um die Laktatschwellen, die maximale Herzfrequenz und die damit verbundenen Trainingsbereiche zu ermitteln.“"
                            },
                            {
                                "example_id": "d5bc5a63-e7f6-4f84-8fdf-171e8a098de4",
                                "sense_id": "03acba45-c7f1-314d-b558-dcdb2d61e989",
                                "text": "„Schritt 1 heißt allerdings Bestandsaufnahme durch einen Laktatstufentest oder eine Atemgasanalyse.“"
                            },
                            {
                                "example_id": "2d005285-a87f-4ceb-b968-66e33e4f5c20",
                                "sense_id": "03acba45-c7f1-314d-b558-dcdb2d61e989",
                                "text": "„Ein Laktatstufentest auf dem Laufband oder auf einer Laufbahn ermittelt neben der Herzfrequenz auch die Laktatkonzentration im Blut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
