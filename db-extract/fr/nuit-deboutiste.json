                    {
                        "sense_id": "e2d4b749-9470-3fb7-bd62-d0f13bc8879b",
                        "entry_id": "e2559ae2-c290-3ffd-a303-bdca37a1b64b",
                        "glosses": [
                            "Personne participant au mouvement social « Nuit debout », dont la première manifestation s’est tenue le 31 mars 2016 à Paris, sur la place de la République."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cdc28ed-7b89-480e-9f2f-8f40fbae4ae7",
                                "sense_id": "e2d4b749-9470-3fb7-bd62-d0f13bc8879b",
                                "text": "«Maintenant qu’ils savent qu’on a leur adresse et qu’on est capable de débarquer chez eux, les membres du gouvernement vont réfléchir autrement», sourit un nuit-deboutiste."
                            },
                            {
                                "example_id": "98ebbb3b-bb0d-4818-97dc-7313b5607776",
                                "sense_id": "e2d4b749-9470-3fb7-bd62-d0f13bc8879b",
                                "text": "“J’espère que la Grande-Bretagne nous rejoindra bientôt”, confie Joseph, le “nuitdeboutiste” invétéré."
                            },
                            {
                                "example_id": "69187124-fb95-4451-9ac2-8e518cdb8730",
                                "sense_id": "e2d4b749-9470-3fb7-bd62-d0f13bc8879b",
                                "text": "Qui sont les “Nuit Deboutistes” et quel est leur combat ?"
                            },
                            {
                                "example_id": "cccec992-f360-43c9-b9cb-79da4500ae88",
                                "sense_id": "e2d4b749-9470-3fb7-bd62-d0f13bc8879b",
                                "text": "Si la filiation avec Occupy Wall Street ou les Indignés en Espagne semble à première vue criante, les « Nuit deboutistes » sont plus partagés quant à la forme que prendra la concrétisation de leur mouvement."
                            }
                        ]
                    }
