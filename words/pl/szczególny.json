            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a985f41c-0c5d-3c79-80f2-dd99aaa82971",
                    "sense_definition": "Taki, który wyróżnia się czymś spośród innych, jest inny niż wszystkie; wyjątkowy.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "unique_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To był dla nas bardzo <w>szczególny</w> dzień, pełen wzruszeń.",
                            "target_lang_translations": {
                                "ru": "Это был для нас очень <w>особенный</w> день, полный волнений.",
                                "en": "It was a very <w>special</w> day for us, full of emotions."
                            }
                        },
                        {
                            "text": "Ten region ma swój <w>szczególny</w> klimat, którego nie znajdziesz nigdzie indziej.",
                            "target_lang_translations": {
                                "ru": "У этого региона свой <w>особый</w> климат, которого не найдешь нигде больше.",
                                "en": "This region has its own <w>particular</w> atmosphere that you won't find anywhere else."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyjątkowy",
                        "niezwykły",
                        "nieprzeciętny",
                        "osobliwy",
                        "ponadprzeciętny"
                    ],
                    "antonyms": [
                        "zwykły",
                        "zwyczajny",
                        "przeciętny",
                        "typowy"
                    ],
                    "common_phrases": [
                        "w szczególny sposób",
                        "szczególny przypadek",
                        "szczególne cechy",
                        "szczególna okazja"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выделяющийся среди других, не такой, как все; исключительный.",
                        "en": "Standing out from others, unique or different; exceptional."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осо́бенный",
                                "target_lang_sense_clarification": "необычный, непохожий на других"
                            },
                            {
                                "target_lang_word": "осо́бый",
                                "target_lang_sense_clarification": "своеобразный, специфический"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "special",
                                "target_lang_sense_clarification": "unusual, distinct, or extraordinary"
                            },
                            {
                                "target_lang_word": "particular",
                                "target_lang_sense_clarification": "specific or unique to something"
                            },
                            {
                                "target_lang_word": "exceptional",
                                "target_lang_sense_clarification": "uncommon and superior"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd53e0bf-866c-3632-b865-5660b90ee7df",
                    "sense_definition": "Bardzo duży, znaczny; używany do podkreślenia wagi, intensywności lub znaczenia czegoś.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nauczyciel zwrócił <w>szczególną</w> uwagę na błędy ortograficzne w wypracowaniach.",
                            "target_lang_translations": {
                                "ru": "Учитель обратил <w>особое</w> внимание на орфографические ошибки в сочинениях.",
                                "en": "The teacher paid <w>particular</w> attention to spelling mistakes in the essays."
                            }
                        },
                        {
                            "text": "W obecnej sytuacji musimy zachować <w>szczególną</w> ostrożność na drodze.",
                            "target_lang_translations": {
                                "ru": "В нынешней ситуации мы должны соблюдать <w>особую</w> осторожность на дороге.",
                                "en": "In the current situation, we must exercise <w>extra</w> caution on the road."
                            }
                        }
                    ],
                    "synonyms": [
                        "specjalny"
                    ],
                    "antonyms": [
                        "nieszczególny"
                    ],
                    "common_phrases": [
                        "szczególna uwaga",
                        "szczególny nacisk",
                        "szczególne znaczenie",
                        "szczególna ostrożność"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень большой, значительный; используется для подчеркивания важности или интенсивности чего-либо.",
                        "en": "Very great or significant; used to emphasize importance, intensity, or weight of something."
                    },
                    "translations": {
