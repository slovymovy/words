                "senses": [
                    {
                        "sense_id": "b7ee0229-5420-3636-88c4-532aea9e851f",
                        "entry_id": "d4cca710-ab5c-3668-bfa4-9f18d36839d6",
                        "glosses": [
                            "veraltet: Denkmal, das für Personen errichtet wurde, die als Helden verehrt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc301e98-72d7-4d7d-8543-a5aebfa33009",
                                "sense_id": "b7ee0229-5420-3636-88c4-532aea9e851f",
                                "text": "„Wohl ist erwiesen, daß eine Anzahl von Landleuten beim Heldenmal sich am Kampf beteiligt haben, aber das wäre nur entscheidend, wenn die Bauern die Angreifer gewesen wären.“"
                            },
                            {
                                "example_id": "f40b3c05-1879-4b60-b41a-0bc0307cfad9",
                                "sense_id": "b7ee0229-5420-3636-88c4-532aea9e851f",
                                "text": "„Vollmondschein",
                                "translation": "Um versunkne Heldenmale.“"
                            },
                            {
                                "example_id": "62ff0cc0-e531-420f-b0aa-3deb9f69896e",
                                "sense_id": "b7ee0229-5420-3636-88c4-532aea9e851f",
                                "text": "„Die überall errichteten Kriegerdenkmale (früher Heldenmale) sprechen eine deutliche Sprache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
