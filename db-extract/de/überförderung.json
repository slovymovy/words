                ],
                "senses": [
                    {
                        "sense_id": "f857342a-4688-3c46-83d5-1922291b6276",
                        "entry_id": "ff34dbdc-cd95-3b27-8a6e-c14eb30966a8",
                        "glosses": [
                            "mehr Unterstützung (Förderung) als sinnvoll/zuträglich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90f855a8-454c-47ce-a93c-99138dfe0fd6",
                                "sense_id": "f857342a-4688-3c46-83d5-1922291b6276",
                                "text": "„Bei Windenergie an Land und Photovoltaik will das Ministerium künftig nur noch 9 beziehungsweise 11 Cent Vergütung bewilligen. Es gelte, \"die bestehende Überförderung\" abzubauen.“"
                            },
                            {
                                "example_id": "c74b1e51-9e1f-4577-bd30-2a5927e63f68",
                                "sense_id": "f857342a-4688-3c46-83d5-1922291b6276",
                                "text": "„Überförderung bei erneuerbaren Energien anzuprangern, aber den Supergau der Übersubventionierung von Kohle-, Gas- und Atomkraftwerken, die mehr als drei Mal so hoch ist, aus dem Auge zu verlieren ist überaus unglaubwürdig.“"
                            },
                            {
                                "example_id": "a63d5233-7292-442e-a945-fcbd0c286e60",
                                "sense_id": "f857342a-4688-3c46-83d5-1922291b6276",
                                "text": "„Dem Bundesrat ist deshalb keine systematische Überförderung der Kleinwasserkraftwerke bekannt.“"
                            },
                            {
                                "example_id": "f6181ba0-2e01-4eaa-ab3f-8213bd83de68",
                                "sense_id": "f857342a-4688-3c46-83d5-1922291b6276",
                                "text": "„Oft lassen sich jedoch gerade in solchen Familien auch Tendenzen der Überförderung feststellen. Kinder sollen alles immer früher, besser und schneller können und werden so durch die Kindheit gehetzt.“"
                            },
                            {
                                "example_id": "94814c08-cdd7-43a0-aa29-f7946231e77c",
                                "sense_id": "f857342a-4688-3c46-83d5-1922291b6276",
                                "text": "„Die Förderung ist anteilig und bezogen auf die tatsächlich angefallen Kosten, eine Gewinnerwirtschaftung ist ausgeschlossen, d.h. Überförderungen sind unzulässig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
