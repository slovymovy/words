                    {
                        "translation_id": "0d775039-aeab-453f-a749-1b6d2fb584b8",
                        "source_entry_id": "84a4fa92-0327-3afa-8f6e-00f52b21d3fd",
                        "source_sense_description": "an irregular open wound caused by a blunt impact to soft tissue",
                        "target_lang_word": "lacération",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lacération",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e51f13d-8233-381a-a6cd-1efcce3bb91e",
                                        "entry_id": "a3c5bacf-6dbe-3f92-b175-7fe1f718c6f2",
                                        "glosses": [
                                            "Action de lacérer un écrit, un livre."
                                        ],
                                        "tags": [
                                            "Ancienne Jurisprudence"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3512ba3-8419-47e8-a74b-b7d4cb81bc25",
                                                "sense_id": "5e51f13d-8233-381a-a6cd-1efcce3bb91e",
                                                "text": "Le jugement ordonna la lacération de cet écrit, comme d’un libelle injurieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e908c719-f803-3bdf-b31a-121ac1ef1dc4",
                                        "entry_id": "a3c5bacf-6dbe-3f92-b175-7fe1f718c6f2",
                                        "glosses": [
                                            "Action de lacérer un objet quelconque, la partie d'un corps."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cfb30f8-6ee7-4ee5-b259-f69333550f16",
                                                "sense_id": "e908c719-f803-3bdf-b31a-121ac1ef1dc4",
                                                "text": "Et dès ce moment, ce fut la lacération complète, à grands coups d'ongles, de son dos."
                                            },
                                            {
                                                "example_id": "4ae81407-011c-4da8-b5f1-e6ddff9320e4",
                                                "sense_id": "e908c719-f803-3bdf-b31a-121ac1ef1dc4",
                                                "text": "Ces deux ou trois traits de lacération permettent à la toile de s’ouvrir légèrement vers l’intérieur, telle un sexe de femme, en s’ourlant sur les côtés comme des lèvres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "682314fa-9a72-4859-af4d-5bfa98e47428",
                        "source_entry_id": "84a4fa92-0327-3afa-8f6e-00f52b21d3fd",
                        "source_sense_description": "an irregular open wound caused by a blunt impact to soft tissue",
                        "target_lang_word": "Platzwunde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Platzwunde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "457c9047-9fbd-392d-8cfe-6a8d18d32417",
                                        "entry_id": "a45ca8eb-5e85-34a1-8c1b-0f425b7d6c7f",
                                        "glosses": [
                                            "offene Verletzung der Haut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed5208d4-8ad8-4d38-a91b-2c5ab9f77060",
                                                "sense_id": "457c9047-9fbd-392d-8cfe-6a8d18d32417",
                                                "text": "Er zog sich bei einem Zusammenprall mit einem Mitspieler eine Platzwunde zu."
                                            },
                                            {
                                                "example_id": "1c34d0ec-4cc7-4f58-9935-5dff6e5c72b7",
                                                "sense_id": "457c9047-9fbd-392d-8cfe-6a8d18d32417",
                                                "text": "„Mein liebster Freund kam mit seiner Frau und ihren beiden Töchtern und fünf Minuten, nachdem sie angekommen waren, stürzte seine Frau aus der Hängematte, überschlug sich und hatte eine klaffende Platzwunde am Hinterkopf.“"
                                            },
                                            {
                                                "example_id": "2c7f09e1-a9a0-4a54-a3d2-3c1bce74c324",
                                                "sense_id": "457c9047-9fbd-392d-8cfe-6a8d18d32417",
                                                "text": "„Monsieur Morin erzählt mir, er habe damit innerhalb von drei Minuten eine Platzwunde an der Stirn eines jungen Mannes zum Verschwinden gebracht; eine abprallende Kugel hätte diesen so getroffen, daß man glaubte, der Knochen sei gebrochen.“"
                                            },
                                            {
                                                "example_id": "6c0acce8-c0e5-4345-923c-b7daad0c1ddf",
                                                "sense_id": "457c9047-9fbd-392d-8cfe-6a8d18d32417",
                                                "text": "„Adrienne hielt sich bisweilen die Hand vor die Augen, wenn Blut aus Nasen oder Platzwunden quoll, spähte dann aber zwischen ihren Fingern hindurch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
