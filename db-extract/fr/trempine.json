                "senses": [
                    {
                        "sense_id": "be5d532b-9b62-30b7-be35-de85f59353d7",
                        "entry_id": "c8290cdc-b693-3aaa-8b11-d290d5f4dacc",
                        "glosses": [
                            "Soupe composée de vin rouge et d’eau dans laquelle on trempe ou on émiette du pain grillé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9797e83e-cd0a-4f63-829c-1f3231c3e032",
                                "sense_id": "be5d532b-9b62-30b7-be35-de85f59353d7",
                                "text": "Elle demanda un litre de gros rouge et une livre de sucre pour se faire une trempine au vin chaud."
                            },
                            {
                                "example_id": "3b480f0a-0044-46f4-a91a-c91b0fd98f48",
                                "sense_id": "be5d532b-9b62-30b7-be35-de85f59353d7",
                                "text": "En Loire-Inférieure, on donne à des bébés « la trempine », sorte de soupe au vin."
                            }
                        ]
                    },
                    {
                        "sense_id": "10cd0ee2-fb3b-377c-a7ca-6c6110afc9d5",
                        "entry_id": "c8290cdc-b693-3aaa-8b11-d290d5f4dacc",
                        "glosses": [
                            "Substance hypothétique (et inexistante) qui aurait donné sa dureté à l’acier trempé."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "9e99e783-d409-4753-9426-423f07e67eec",
                                "sense_id": "10cd0ee2-fb3b-377c-a7ca-6c6110afc9d5",
                                "text": "Un pathologiste un peu au courant vous dira bien plus simplement que l’immersion de l’acier chaud dans l’eau froide fait naître dans le métal une trempine qui a la propriété de le rendre dur. À côté de cette trempine se développe quelquefois une bleuine qui rendra l’acier bleu ; etc."
                            },
                            {
                                "example_id": "b22d311f-4d20-436f-b381-e6408ec62cd3",
                                "sense_id": "10cd0ee2-fb3b-377c-a7ca-6c6110afc9d5",
                                "text": "En effet, chauffez l’acier de nouveau et laissez-le refroidir doucement ; il n’est plus dur, donc la trempine a disparu, détruite par la chaleur, donc elle existait ! Un enfant comprendrait celle démonstration élégante !"
                            }
                        ]
                    }
