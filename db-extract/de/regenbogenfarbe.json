                ],
                "senses": [
                    {
                        "sense_id": "1d220d5e-760b-3841-9a29-c1e0c00e1e20",
                        "entry_id": "6e00d884-936d-3d03-bfc7-be106a35245f",
                        "glosses": [
                            "Farbe des Farbspektrums des Regenbogens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5eec8d2-f5d7-4d71-b9ce-43b71ba64765",
                                "sense_id": "1d220d5e-760b-3841-9a29-c1e0c00e1e20",
                                "text": "„Durch das Netz der Piniennadeln kam ein dünner Lichtregen, die Sonne wischte blasse Farbtöne über die rotbraunen Stämme, sie zerlegte die Tautropfen in alle Regenbogenfarben und löste den Schleier von den Stirnen der Steinfiguren.“"
                            },
                            {
                                "example_id": "bcd7d78f-a3e5-4607-bb84-01ef662d2ea6",
                                "sense_id": "1d220d5e-760b-3841-9a29-c1e0c00e1e20",
                                "text": "„Und durch diese durchsichtige, glatte, gebrechliche Rüstung hindurch, die wie ein Kristallglas alle Regenbogenfarben widerspiegelt und ihn wunderbar vor den Tränen der Mutter und den Speichelbläschen Onkel Ottos isoliert, schaut er auf alle, von denen er sich distanziert hat.“"
                            },
                            {
                                "example_id": "fecc3f0a-228b-4018-ab97-1aa4889dbcad",
                                "sense_id": "1d220d5e-760b-3841-9a29-c1e0c00e1e20",
                                "text": "„Die Sonne stand schon sehr schräg, ihre Strahlen ließen den Wasserdunst der Kaskaden in allen Regenbogenfarben aufleuchten.“"
                            },
                            {
                                "example_id": "354fb014-f042-46f8-8ee3-c8d13fd2d74d",
                                "sense_id": "1d220d5e-760b-3841-9a29-c1e0c00e1e20",
                                "text": "„Alles war alt und gebraucht, und Vilborg schien keine Scheu davor zu haben, ihr Zuhause in allen Regenbogenfarben zu dekorieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
