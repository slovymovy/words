                                "target_senses": [
                                    {
                                        "sense_id": "2befaec9-5a6b-34cd-91fc-88198b544e33",
                                        "entry_id": "7412c631-08a1-393b-8b58-6958c4d32537",
                                        "glosses": [
                                            "die wissenschaftliche Auseinandersetzung mit Münzen (Numismatik) betreffend, zu ihr gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3e90b68-d3ea-4999-83c0-96d592574a4c",
                                                "sense_id": "2befaec9-5a6b-34cd-91fc-88198b544e33",
                                                "text": "Bei der Ausgrabung wurden Münzen mit numismatischem Wert gefunden."
                                            },
                                            {
                                                "example_id": "b9cc7d2a-cb18-4510-8745-f1ca5b1abd87",
                                                "sense_id": "2befaec9-5a6b-34cd-91fc-88198b544e33",
                                                "text": "In diesem Raum wird die numismatische Sammlung des Museums ausgestellt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
