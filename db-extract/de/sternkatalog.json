                "senses": [
                    {
                        "sense_id": "1cb64664-8c45-3961-a2a1-8df690c803ac",
                        "entry_id": "17f64290-91da-3d1a-abc5-22b17826568f",
                        "glosses": [
                            "Verzeichnis von Sternen mit verschiedenen Eigenschaften wie zum Beispiel Position am Himmel, Helligkeit oder Spektraltyp, entweder in Buchform oder elektronisch als Datenbank"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b1ede1c-500d-4064-9777-5fa9d4ba0716",
                                "sense_id": "1cb64664-8c45-3961-a2a1-8df690c803ac",
                                "text": "„Der Henry-Draper-Katalog ist ein astronomischer Sternkatalog mit Daten zu Position und Spektraltyp von 225.300 Sternen.“"
                            },
                            {
                                "example_id": "cc5da836-c45c-4f39-a912-0540149c9177",
                                "sense_id": "1cb64664-8c45-3961-a2a1-8df690c803ac",
                                "text": "„John Herschel entdeckte, dass die Magellanschen Wolken aus Sternen bestehen, gab verschiedene Sternkataloge heraus und führte das Julianische Datum in die Astronomie ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
