                        "sense_id": "0022d12a-aaa7-3e84-b1c4-67a6c400e419",
                        "entry_id": "4c63e17d-bbdb-3115-ac25-c709a49808d5",
                        "glosses": [
                            "female equivalent of pastour"
                        ],
                        "tags": [
                            "archaic",
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "af286f2b-b80b-4620-818e-de543543c9d8",
                                "sense_id": "0022d12a-aaa7-3e84-b1c4-67a6c400e419",
                                "text": "Les femmes ne connaissent guère le travail. Les enfants en sont mieux soignés; mais le ménage est aux abois quand le chef de la famille est au lit ou pâle et tremblotant sur le seuil de sa cabane. Jusqu'au mariage, les filles sont pastoures ou servantes dans les métairies et dans les villes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
