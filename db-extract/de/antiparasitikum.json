                ],
                "senses": [
                    {
                        "sense_id": "11963292-cb03-370e-b957-cdcff8fb6309",
                        "entry_id": "c67d464c-cb4c-3034-9889-cb3bf3a23c86",
                        "glosses": [
                            "Arzneimittel, das gegen Endo- oder Ektoparasiten eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "324bef30-4daa-4830-be9f-3dfcde854070",
                                "sense_id": "11963292-cb03-370e-b957-cdcff8fb6309",
                                "text": "„Vorsorglich wird dem Eisbärenjungen nun ein Antibiotikum und Antiparasitikum verabreicht, wie der Tierpark weiterhin mitteilte.“"
                            },
                            {
                                "example_id": "3839e5ff-7bb7-4826-a467-6a0e1cc3e934",
                                "sense_id": "11963292-cb03-370e-b957-cdcff8fb6309",
                                "text": "„Schwefelige Säure (medizinisch gesehen ein Antiparasitikum, Entwesungs-, Lebensmittelbleich- und Konservierungsmittel) kann dem Wein sowohl bei der Gärung als auch vor der Abfüllung (als Zusatz zur sogenannten „Süßreserve“) beigemischt werden.“"
                            },
                            {
                                "example_id": "79cf65bc-8ce8-46f7-8ed3-ee18d7768b74",
                                "sense_id": "11963292-cb03-370e-b957-cdcff8fb6309",
                                "text": "„Gleichwohl konnte jetzt schon die Aussage getroffen werden, dass auch eine Behandlung mit einem Antiparasitikum längst überfällig war.“"
                            },
                            {
                                "example_id": "236848d0-d32b-465f-b182-a2448acb5503",
                                "sense_id": "11963292-cb03-370e-b957-cdcff8fb6309",
                                "text": "„Außerdem wurden sie als Insektenrepellent und als Antiparasitikum in Salbe verwendet, zum Beispiel gegen Läuse und Krätzemilben.“"
                            },
                            {
                                "example_id": "3e1a66d6-70a2-43a8-882b-d3a9f55957d3",
                                "sense_id": "11963292-cb03-370e-b957-cdcff8fb6309",
                                "text": "„Bei einer Anwendung des Antiparasitikums Amitraz darf Xylazin wegen synergetischer Effekte nicht eingesetzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
