    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3933c7c3-c6a0-3988-b641-1711648ad647",
                    "sense_definition": "The act of putting something inside something else, or the thing that has been put inside.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "general_insertion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon performed the <w>insertion</w> of a pacemaker to help regulate the patient's heart rhythm.",
                            "target_lang_translations": {
                                "ru": "Хирург выполнил <w>введение</w> кардиостимулятора, чтобы помочь отрегулировать сердечный ритм пациента."
                            }
                        },
                        {
                            "text": "The <w>insertion</w> of new text into the contract completely changed the meaning of the document.",
                            "target_lang_translations": {
                                "ru": "<w>Вставка</w> нового текста в контракт полностью изменила смысл документа."
                            }
                        }
                    ],
                    "synonyms": [
                        "inclusion",
                        "incorporation",
                        "introduction"
                    ],
                    "antonyms": [
                        "deletion"
                    ],
                    "common_phrases": [
                        "insertion of text",
                        "surgical insertion",
                        "manual insertion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по помещению чего-либо внутрь чего-то другого, или сам предмет, который был вставлен."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вставка",
                                "target_lang_sense_clarification": "процесс или результат добавления чего-либо"
                            },
                            {
                                "target_lang_word": "введение",
                                "target_lang_sense_clarification": "помещение внутрь, например, медицинского прибора"
                            },
                            {
                                "target_lang_word": "вкладывание",
                                "target_lang_sense_clarification": "процесс помещения одного предмета в другой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e863de6f-98ab-36fc-95c4-f1be565b7e8d",
                    "sense_definition": "The addition of one or more nucleotide base pairs into a DNA sequence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scientific_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A genetic <w>insertion</w> can sometimes lead to a frameshift mutation that disrupts the entire protein.",
                            "target_lang_translations": {
                                "ru": "Генетическая <w>инсерция</w> иногда может привести к мутации сдвига рамки считывания, которая разрушает весь белок."
                            }
                        },
                        {
                            "text": "The researchers studied the <w>insertion</w> of a specific gene into the plant's genome.",
                            "target_lang_translations": {
                                "ru": "Исследователи изучили <w>вставку</w> специфического гена в геном растения."
                            }
                        }
                    ],
                    "antonyms": [
                        "deletion"
                    ],
                    "common_phrases": [
                        "genetic insertion",
                        "gene insertion"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Добавление одной или нескольких пар нуклеотидных оснований в последовательность ДНК."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инсерция",
                                "target_lang_sense_clarification": "специальный генетический термин"
                            },
                            {
                                "target_lang_word": "вставка",
                                "target_lang_sense_clarification": "добавление генетического материала"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88f75235-88f4-3eb3-b4d8-db388213c195",
                    "sense_definition": "The point where a muscle attaches to the bone that it moves.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>insertion</w> of the biceps muscle is located on the radius bone of the forearm.",
                            "target_lang_translations": {
                                "ru": "Место <w>прикрепления</w> двуглавой мышцы плеча находится на лучевой кости предплечья."
                            }
                        },
                        {
                            "text": "Pain near the muscle <w>insertion</w> often indicates a tendon injury rather than a muscle tear.",
                            "target_lang_translations": {
                                "ru": "Боль в области <w>прикрепления</w> мышцы часто указывает на повреждение сухожилия, а не на разрыв мышцы."
                            }
                        }
                    ],
                    "synonyms": [
                        "attachment"
                    ],
                    "common_phrases": [
                        "muscle insertion",
                        "point of insertion"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "anatomical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Точка прикрепления мышцы к кости, которую она приводит в движение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прикрепление",
                                "target_lang_sense_clarification": "место соединения мышцы с костью"
                            },
                            {
                                "target_lang_word": "инсерция",
                                "target_lang_sense_clarification": "анатомический термин для места прикрепления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e021a65-9493-34b0-b451-894e06f1780c",
                    "sense_definition": "The process in nuclear physics of moving from a subcritical state to a prompt critical state.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rapid <w>insertion</w> of reactivity must be carefully controlled to prevent a nuclear accident.",
                            "target_lang_translations": {
                                "ru": "Быстрый <w>ввод</w> реактивности должен тщательно контролироваться для предотвращения ядерной аварии."
                            }
                        },
                        {
                            "text": "Engineers monitored the <w>insertion</w> process to ensure the reactor remained within safety limits.",
                            "target_lang_translations": {
                                "ru": "Инженеры следили за процессом <w>ввода</w>, чтобы гарантировать, что реактор остается в пределах безопасности."
                            }
                        }
                    ],
                    "common_phrases": [
