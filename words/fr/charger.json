                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le logiciel met un certain temps à <w>charger</w> les images."
                        },
                        {
                            "text": "La page web refuse de se <w>charger</w> correctement sans connexion stable."
