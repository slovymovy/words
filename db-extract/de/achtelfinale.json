                "senses": [
                    {
                        "sense_id": "681157b6-f340-3d5b-bdd7-7af6e2be58a3",
                        "entry_id": "4f4fe0c6-8af9-366f-a4ff-f6e4f0ab0534",
                        "glosses": [
                            "Runde der letzten sechzehn verbliebenen Spieler oder Mannschaften in einem Turnier, das im K.-o.-System ausgetragen wird, bei der in acht Begegnungen die Teilnehmer am Viertelfinale ermittelt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31a5041f-0381-4765-b6e5-10684f194fa9",
                                "sense_id": "681157b6-f340-3d5b-bdd7-7af6e2be58a3",
                                "text": "„Der Kapitän und Abwehrchef wurde gegen die Briten nach seiner am Mittwoch erlittenen Verletzung des Beugemuskels geschont, soll aber im Achtelfinale wieder auflaufen können.“"
                            },
                            {
                                "example_id": "edfb923f-d350-42b0-8ede-f2dc6161b04f",
                                "sense_id": "681157b6-f340-3d5b-bdd7-7af6e2be58a3",
                                "text": "„So geht echter Minimalismus: Den Griechen reichen zwei Tore gegen schwache Ivorer, um ins Achtelfinale einzuziehen.“"
                            },
                            {
                                "example_id": "bb09e752-fe15-4671-8ce6-7015678c008b",
                                "sense_id": "681157b6-f340-3d5b-bdd7-7af6e2be58a3",
                                "text": "„Thiem haderte vor allem mit 58 unerzwungenen Fehlern, hat mit dem Achtelfinale aber zumindest sein Primärziel erreicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
