                "senses": [
                    {
                        "sense_id": "01066d52-99d4-31b6-a44f-11a8b1af9438",
                        "entry_id": "1bae4a65-e508-3661-8f40-d89175d44179",
                        "glosses": [
                            "Levée d'alerte, fin d'alerte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "939a3b5f-4fb5-4fd5-af35-f83e32087fbd",
                                "sense_id": "01066d52-99d4-31b6-a44f-11a8b1af9438",
                                "text": "Bei allen konnte schnell Entwarnung gegeben werden, Tests fielen negativ aus."
                            },
                            {
                                "example_id": "d3754135-30de-4f8c-9e92-804390f2407c",
                                "sense_id": "01066d52-99d4-31b6-a44f-11a8b1af9438",
                                "text": "Neue Studien geben Entwarnung: Bei gesunden Menschen führt Kaffeekonsum nicht zu vermehrten Herzrhythmusstörungen. Es konnte kein Zusammenhang zwischen Kaffee und dem Auftreten von Arrhythmien nachgewiesen werden.",
                                "translation": "De nouvelles études donnent le signal de fin d'alerte : chez les personnes en bonne santé, la consommation de café n'entraîne pas d'augmentation des troubles du rythme cardiaque. Aucun lien entre le café et l’apparition d'arythmies n’a pu être démontré."
                            }
                        ]
                    }
                ],
