                        "cross_references": [
                            {
                                "target_word": "dextrose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76c782ae-2f0f-362d-ad1f-a9348857ac81",
                                        "entry_id": "a2a41a39-c8e5-3305-83b3-52073813a9c4",
                                        "glosses": [
                                            "The naturally occurring dextrorotatory form of glucose monosaccharide molecule."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4dbe2c7-5856-46c1-b150-6b7af897d0be",
                                                "sense_id": "76c782ae-2f0f-362d-ad1f-a9348857ac81",
                                                "text": "The saccharides include such substances as dextrose and levulose, which are typical examples of the two classes into which these bodies are divisible, viz. the Aldoses and Ketoses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60ee9c19-be55-4a1c-a0eb-a6f2256ea0b8",
                        "source_entry_id": "d6eb5e40-f3a5-3501-8a86-9db1633dc002",
                        "source_sense_id": "f61b908b-23ab-3248-8b86-ea156656766f",
                        "source_sense_description": "ein Monosaccharid (Einfachzucker), das zu den Kohlenhydraten gehört",
                        "target_lang_word": "grape sugar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grape sugar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fbbcb312-9bef-3ead-a905-ff097a00ac54",
                                        "entry_id": "1829fcf0-8194-358b-a10c-20ac671dddf2",
                                        "glosses": [
                                            "Glucose."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d631b984-fdf0-45b9-8268-79cd82f9af60",
                                                "sense_id": "fbbcb312-9bef-3ead-a905-ff097a00ac54",
                                                "text": "Coniferin is converted into grape-sugar and coniferyl alcohol under the influence of emulsine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29aacf4d-08d4-4ae3-a79b-441a96197d11",
                        "source_entry_id": "d6eb5e40-f3a5-3501-8a86-9db1633dc002",
                        "source_sense_id": "f61b908b-23ab-3248-8b86-ea156656766f",
                        "source_sense_description": "ein Monosaccharid (Einfachzucker), das zu den Kohlenhydraten gehört",
                        "target_lang_word": "corn sugar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corn sugar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2185dc9-0783-3c01-b322-fdb33cf12049",
                                        "entry_id": "20b256ee-a0e8-37e6-b1a4-24eef20630bf",
                                        "glosses": [
                                            "Dextrose, especially originating from corn starch."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6b44592-b2a7-4bfb-9da4-5200c851678f",
                                                "sense_id": "a2185dc9-0783-3c01-b322-fdb33cf12049",
                                                "text": "Corn sugar is a key ingredient in home beer making."
                                            },
                                            {
                                                "example_id": "7336af28-be64-43f3-84a7-fee87b8c6d4d",
                                                "sense_id": "a2185dc9-0783-3c01-b322-fdb33cf12049",
                                                "text": "These added sugars assume various names on food labels: sucrose, invert sugar, corn sugar, corn syrups and solids, high-fructose corn syrup, and honey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96476a18-c3ad-357e-a4ef-539f0ee8e372",
                                        "entry_id": "20b256ee-a0e8-37e6-b1a4-24eef20630bf",
                                        "glosses": [
                                            "A deceptive term for high fructose corn syrup developed by corn refiners meant to imply sugar."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7dd2b5e-8cd5-4146-9456-88e996c3f97f",
                                                "sense_id": "96476a18-c3ad-357e-a4ef-539f0ee8e372",
                                                "text": "Last week, the industry group applied to the federal government for permission to use a new name for the ingredient on food labels: \"corn sugar.\""
                                            },
                                            {
                                                "example_id": "c5f5e050-123c-4342-8c3b-ad72b6c0fee0",
                                                "sense_id": "96476a18-c3ad-357e-a4ef-539f0ee8e372",
                                                "text": "The Corn Refiners Association wants to use \"corn sugar\" as an alternative name for the widely used liquid sweetener currently labeled as high fructose corn syrup on most sodas and packaged foods."
                                            },
                                            {
                                                "example_id": "4365c3b9-051f-4121-b4fa-44ca4a09b3df",
                                                "sense_id": "96476a18-c3ad-357e-a4ef-539f0ee8e372",
                                                "text": "In April, eight leading sugar companies and two trade associations sued six corn processors and a lobbying group, alleging the corn industry is improperly using the term \"corn sugar\" in advertisements and elsewhere to describe high-fructose corn syrup, a widely used sweetener used in snack foods, condiments, fruit drinks and other products."
                                            },
                                            {
                                                "example_id": "7cc32121-e1a3-4080-b9df-f24414fc1e3b",
                                                "sense_id": "96476a18-c3ad-357e-a4ef-539f0ee8e372",
                                                "text": "The Food and Drug Administration has cautioned the corn industry over its use of the term \"corn sugar\" to describe high fructose corn syrup before the proposed new name has received regulatory approval."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
