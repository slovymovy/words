                                    {
                                        "sense_id": "2f1da9b8-044c-3340-9e15-1a3ba2cc1e8b",
                                        "entry_id": "5f873866-8d6a-3bf2-b3af-7c41323f48d4",
                                        "glosses": [
                                            "makkelijk baantje, eenvoudige taak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ea79e16-21df-4d4d-9811-18e2550cf4f8",
                                                "sense_id": "2f1da9b8-044c-3340-9e15-1a3ba2cc1e8b",
                                                "text": "In theorie kan het op die manier gedaan worden, dit is echter bepaald geen sinecure."
                                            },
                                            {
                                                "example_id": "b447fbb8-238c-456a-8081-de9bd9b27455",
                                                "sense_id": "2f1da9b8-044c-3340-9e15-1a3ba2cc1e8b",
                                                "text": "Alleen een kind opvoeden is geen sinecure."
                                            }
