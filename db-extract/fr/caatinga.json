                                "target_senses": [
                                    {
                                        "sense_id": "4714bb06-4bc1-39fe-804c-07d40f2b0057",
                                        "entry_id": "9248d1f4-a223-3dec-a4da-a2acf119607f",
                                        "glosses": [
                                            "A sparse, thorny wooded biome of northeastern Brazil containing drought-resistant trees."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66c13613-ad2e-447d-b15f-544f0a1ac4be",
                                                "sense_id": "4714bb06-4bc1-39fe-804c-07d40f2b0057",
                                                "text": "He then goes on his way at a steady pace that does not tire him, climbing up slopes or down ravines, traversing scrubland caatinga or stony ground."
                                            },
                                            {
                                                "example_id": "0f7a56dc-9549-4ef6-a959-512f0c579a47",
                                                "sense_id": "4714bb06-4bc1-39fe-804c-07d40f2b0057",
                                                "text": "The geological substrate of the caatinga is severely eroded crystalline bedrock of the Precambrian Brazilian Shield and Paleozoic and Mesozoic sedimentary basins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
