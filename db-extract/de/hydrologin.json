                "senses": [
                    {
                        "sense_id": "eeb5a9a9-69c9-35ba-89d9-ceecfc71a7c9",
                        "entry_id": "37dd2593-0120-33cf-90bf-1b90cca8f111",
                        "glosses": [
                            "in der Hydrologie tätige Wissenschaftlerin"
                        ],
                        "tags": [
                            "Beruf"
                        ],
                        "examples": [
                            {
                                "example_id": "72373cc6-781f-4707-9feb-d0ee21fe9c73",
                                "sense_id": "eeb5a9a9-69c9-35ba-89d9-ceecfc71a7c9",
                                "text": "„Ein Forscherteam um die Hydrologin Anke Hildebrandt konstatierte bei der Untersuchung klare Unterschiede darin, wie sehr der Boden seiner Funktion als Auffangbecken für Niederschläge nachgehen kann.“"
                            },
                            {
                                "example_id": "df1eee8e-8f05-4a00-b4cb-70be10766841",
                                "sense_id": "eeb5a9a9-69c9-35ba-89d9-ceecfc71a7c9",
                                "text": "„Die Hydrologin Kumke aus dem Hochwassermeldezentrum beschrieb den Oder-Scheitel so: \"Es ist eine sehr inhaltsreiche, langgezogene Welle.\"“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
