                        "source_sense_id": "3f5192da-544e-3a17-af3c-7c00c670322c",
                        "target_lang_word": "sous-ordre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sous-ordre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "36586820-cd27-39d5-8c77-087ac20fb4c2",
                                        "entry_id": "38f8c682-8b06-3cf5-a1ca-9747e3a58aa7",
                                        "glosses": [
                                            "Procédure par laquelle les créanciers d’un débiteur, lui-même créancier dans une procédure d’ordre, prennent sa place et se partagent le montant de ce qui lui revient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15d53d1d-8a4c-4743-96f6-93e460ca58c0",
                                                "sense_id": "36586820-cd27-39d5-8c77-087ac20fb4c2",
                                                "text": "Créanciers en sous-ordre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aec96e45-e91f-352b-bf60-7c01d55c0ebc",
                                        "entry_id": "38f8c682-8b06-3cf5-a1ca-9747e3a58aa7",
                                        "glosses": [
                                            "Ordre pris en second."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6ddea96-b60a-45e7-bef3-f9bfc800994d",
                                                "sense_id": "aec96e45-e91f-352b-bf60-7c01d55c0ebc",
                                                "text": "Prendre des travaux en sous-ordre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d47deeb0-aec7-3b58-a02c-d74733d41e03",
                                        "entry_id": "38f8c682-8b06-3cf5-a1ca-9747e3a58aa7",
                                        "glosses": [
                                            "Celui qui est soumis aux ordres d’un autre, ou qui travaille sous lui à une affaire quelconque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3770d085-8be5-4134-ad8c-d8d0ee497b9e",
                                                "sense_id": "d47deeb0-aec7-3b58-a02c-d74733d41e03",
                                                "text": "J’ai rencontré, parmi mes camarades de réserve, de hauts fonctionnaires, des chefs de grandes entreprises privées. Tous, comme moi, s’effaraient d’être contraints à des besognes paperassières que, dans le civil, ils auraient abandonnées aux plus modestes de leurs sous-ordres."
                                            },
                                            {
                                                "example_id": "36510841-ce73-4813-9afa-4bbd80846f2a",
                                                "sense_id": "d47deeb0-aec7-3b58-a02c-d74733d41e03",
                                                "text": "La question n’était pas formulée sur un ton de prière, on eût dit plutôt l’interrogation d’un maître parlant à quelque sous-ordre !"
                                            },
                                            {
                                                "example_id": "a5044498-87be-473e-b566-6199eec32a77",
                                                "sense_id": "d47deeb0-aec7-3b58-a02c-d74733d41e03",
                                                "text": "— Parfait !\nOpinion irréfutable, qu’à l’envi ses sous-ordre corroborèrent avec d’étranges mimiques."
                                            },
                                            {
                                                "example_id": "73067d60-2aa5-40b5-a44b-dfd1a1c2b47f",
                                                "sense_id": "d47deeb0-aec7-3b58-a02c-d74733d41e03",
                                                "text": "Ils en suivaient, parfois, les acquéreurs ; ces heureux mortels n’étaient le plus souvent que des sous-ordres, des commis d’antiquaires, des secrétaires particuliers, des hommes de paille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f04c7a08-54d5-311f-99bc-feb36fc2839e",
                                        "entry_id": "38f8c682-8b06-3cf5-a1ca-9747e3a58aa7",
                                        "glosses": [
                                            "Niveau intermédiaire de la classification des êtres vivants, situé entre l’ordre et l’infra-ordre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
