                        "entry_id": "35cf620e-6c48-3c79-a9b7-40ec7697739c",
                        "glosses": [
                            "katoenen of linnen doek, m.n. gebruikt om serviesgoed, bestek, pannen e.d. mee af te drogen"
                        ],
                        "tags": [
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "610f0eee-028b-4b05-8d36-2db5b1518e39",
                                "sense_id": "c43346ac-0f27-3b5f-990f-79aba21a6e87",
                                "text": "Ik pak een schone theedoek uit de la."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b2e26ea-99ad-4bdc-b968-509a9bdc6d03",
                        "source_entry_id": "35cf620e-6c48-3c79-a9b7-40ec7697739c",
                        "source_sense_id": "c43346ac-0f27-3b5f-990f-79aba21a6e87",
                        "source_sense_description": "katoenen of linnen doek, m.n. gebruikt om serviesgoed, bestek, pannen e.d. mee af te drogen",
                        "target_lang_word": "Geschirrtuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschirrtuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c6373d8-36f6-3877-8ebf-a7cfeffafaa8",
                                        "entry_id": "63b97dde-85a4-3937-8bae-5d4a998035df",
                                        "glosses": [
                                            "Handtuch zum Abtrocknen von Geschirr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08722302-5c68-4db5-b4a7-79e45fb94e4e",
                                                "sense_id": "7c6373d8-36f6-3877-8ebf-a7cfeffafaa8",
                                                "text": "Nach dem Spülen trocknet man das Geschirr mit einem Geschirrtuch."
                                            },
                                            {
                                                "example_id": "90a7e54f-699a-4d89-8c02-4923af08df6e",
                                                "sense_id": "7c6373d8-36f6-3877-8ebf-a7cfeffafaa8",
                                                "text": "„Wenn in seinem Laden nicht viel los war, holte er einen Anar aus der Auslage, setzte sich im Vorratsraum auf einen Stuhl, band sich ein Geschirrtuch um den Hals und bedeckte mit einem zweiten die Beine.“"
                                            },
                                            {
                                                "example_id": "eb864459-28c8-4f05-9668-58be729905e2",
                                                "sense_id": "7c6373d8-36f6-3877-8ebf-a7cfeffafaa8",
                                                "text": "„Dietrich, der gerade ein Glas mit einem Geschirrtuch bearbeitet, wirft mir einen Blick zu.“"
                                            },
                                            {
                                                "example_id": "05f0b926-eb0b-4817-bbdc-08b45efed18a",
                                                "sense_id": "7c6373d8-36f6-3877-8ebf-a7cfeffafaa8",
                                                "text": "„Henni zog das Geschirrtuch von der Schulter, trocknete sich die Hände daran ab und legte es auf den Rand des Spülbeckens.“"
                                            },
                                            {
                                                "example_id": "d99d20df-79fd-416c-90c7-44f9a5fce272",
                                                "sense_id": "7c6373d8-36f6-3877-8ebf-a7cfeffafaa8",
                                                "text": "„Ola stand mit einem Geschirrtuch in der Tür.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d345604-886d-4d39-8d4b-e49892ea0527",
                        "source_entry_id": "35cf620e-6c48-3c79-a9b7-40ec7697739c",
