                    }
                ],
                "senses": [
                    {
                        "sense_id": "b8ac09ca-965c-3fdc-bc51-d180dc93eca5",
                        "entry_id": "ff50ec94-61b2-3a18-b9af-ce5c880f5df6",
                        "glosses": [
                            "Celui qui pratique la boxe, par goût ou par profession."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ae1839d-2c30-49ec-96a5-9c867998ccab",
                                "sense_id": "b8ac09ca-965c-3fdc-bc51-d180dc93eca5",
                                "text": "— Comment ? De quel boxeur ?\n— De celui dont vous avez apporté la photographie.\n— Je n’ai apporté la photographie d’aucun boxeur.\n— Enfin… quoi ?… de votre joueur de tennis… C’est la même chose."
                            },
                            {
                                "example_id": "76930c78-1ffa-45fe-880a-ad78a4184d64",
                                "sense_id": "b8ac09ca-965c-3fdc-bc51-d180dc93eca5",
                                "text": "La boxe est très en honneur à Panama. J’assistai à de bons matches et quelques boxeurs noirs étaient tout près de la meilleure classe mondiale."
                            },
                            {
                                "example_id": "52d405df-48e3-4db8-85fc-ad70ec2c944d",
                                "sense_id": "b8ac09ca-965c-3fdc-bc51-d180dc93eca5",
                                "text": "L'autorisation définitive de boxer pourra être retirée à tout boxeur dont les examens médicaux donneraient des résultats satisfaisants, mais qui présenterait des signes caractéristiques de déficience physique, de réflexes diminués, etc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25279427-6e06-439a-b8ea-373cb46b8b65",
                        "source_entry_id": "ff50ec94-61b2-3a18-b9af-ce5c880f5df6",
                        "source_sense_id": "b8ac09ca-965c-3fdc-bc51-d180dc93eca5",
