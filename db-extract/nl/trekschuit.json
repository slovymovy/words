                    }
                ],
                "translations": [
                    {
                        "translation_id": "372f3bf7-8a13-4021-87bf-8ea9a3fc41af",
                        "source_entry_id": "7a808612-b07a-3caa-a06f-66b3ac828f21",
                        "source_sense_id": "ec2a5057-69d2-36e2-8fd7-dfcaa329e342",
                        "source_sense_description": "vaartuig",
                        "target_lang_word": "Kahn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kahn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "169d375f-2bfe-3cb8-93e1-54083ff51467",
                                        "entry_id": "9d9fa946-c3c3-37c3-9c06-fccb0bea5558",
                                        "glosses": [
                                            "kleines, ungedecktes Wasserfahrzeug mit flachem Boden, das in Flüssen, Binnen- und Hafengewässern eingesetzt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e836f61a-43c3-483a-9062-d5271bece340",
                                                "sense_id": "169d375f-2bfe-3cb8-93e1-54083ff51467",
                                                "text": "Kähne werden oft mit Muskelkraft angetrieben."
                                            },
                                            {
                                                "example_id": "e9b19d13-a68e-428d-ba49-f80f8a46bc00",
                                                "sense_id": "169d375f-2bfe-3cb8-93e1-54083ff51467",
                                                "text": "„Hie und da wächst ein weniges von Schilf und Binsen auf, aber kein Kahn zieht seine Furchen, kein Vogel singt, und nur selten, daß ein Habicht drüber hinfliegt und seinen Schatten auf die Spiegelfläche wirft.“"
                                            },
                                            {
                                                "example_id": "763ca2ba-0734-456b-8879-996c442d6028",
                                                "sense_id": "169d375f-2bfe-3cb8-93e1-54083ff51467",
                                                "text": "„Aus einem Kahn stieg Rauch auf.“"
                                            },
                                            {
                                                "example_id": "6a6238d4-5fe1-41be-ad30-0b24c33458c7",
                                                "sense_id": "169d375f-2bfe-3cb8-93e1-54083ff51467",
                                                "text": "„Das ist der fast im Raum verlorene Laut, der kosmische Ozon eines anderen Stückes, worin Geister in goldenen Kähnen den himmlischen See befahren und der klingende Lauf glänzender Lieder sich niederringelt, - hinauf wallt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "67b4c7ce-7bda-326e-a6fa-419adf826e9f",
                                        "entry_id": "9d9fa946-c3c3-37c3-9c06-fccb0bea5558",
                                        "glosses": [
                                            "altes und kleines Wasserfahrzeug"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ab68ea6-e827-44e7-bb1e-a745eeb4fbbe",
                                                "sense_id": "67b4c7ce-7bda-326e-a6fa-419adf826e9f",
                                                "text": "Der Kapitän steuerte mit seinem Kahn den nächsten Hafen an."
                                            },
                                            {
                                                "example_id": "346186e0-f9f4-4c10-a59c-a713aaf23ac7",
                                                "sense_id": "67b4c7ce-7bda-326e-a6fa-419adf826e9f",
                                                "text": "„Unser Kahn hat angelegt, dieser gelbe Kasten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "95e914e6-13bf-3aeb-a6e8-fcf8a0f28358",
                                        "entry_id": "9d9fa946-c3c3-37c3-9c06-fccb0bea5558",
                                        "glosses": [
                                            "Gefängnis"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23e8f70e-eb5e-43ba-aeb6-374dbd8d56bc",
                                                "sense_id": "95e914e6-13bf-3aeb-a6e8-fcf8a0f28358",
                                                "text": "„Die Folge ist, dass er in den Kahn gesteckt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kahn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4bacf65-f3e0-3192-a505-fcc92fd01052",
                                        "entry_id": "b25bd31a-b985-3816-9d6c-07404421315c",
                                        "glosses": [
                                            "Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cb73da4-dab0-443d-b30d-12cdab6329d8",
                                                "sense_id": "a4bacf65-f3e0-3192-a505-fcc92fd01052",
                                                "text": "Frau Kahn ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "c9c13caa-c8ee-4eb3-87b8-2f3bf698317e",
                                                "sense_id": "a4bacf65-f3e0-3192-a505-fcc92fd01052",
                                                "text": "Herr Kahn wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "5995531d-3cd2-44f3-8be6-72616a4b98b6",
                                                "sense_id": "a4bacf65-f3e0-3192-a505-fcc92fd01052",
                                                "text": "Die Kahns fahren heute nach Nürnberg."
                                            },
                                            {
                                                "example_id": "c1e35bab-54cd-4851-b57b-b980b07f0ee0",
                                                "sense_id": "a4bacf65-f3e0-3192-a505-fcc92fd01052",
                                                "text": "Der Kahn trägt nie die Schals, die die Kahn ihm strickt."
                                            },
                                            {
                                                "example_id": "ce017975-63c9-40de-8da9-6e4816abacc4",
                                                "sense_id": "a4bacf65-f3e0-3192-a505-fcc92fd01052",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kahn kommt, geht der Herr Kahn.“"
                                            },
                                            {
                                                "example_id": "e3b78f86-45fb-4ee4-999c-d106b043252f",
                                                "sense_id": "a4bacf65-f3e0-3192-a505-fcc92fd01052",
                                                "text": "Kahn kommt und geht."
                                            },
                                            {
                                                "example_id": "b1675558-6900-4030-8ce4-bd0ce0193b2c",
                                                "sense_id": "a4bacf65-f3e0-3192-a505-fcc92fd01052",
                                                "text": "Kahns kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
