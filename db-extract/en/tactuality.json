                        "entry_id": "424bbf88-d29e-3738-ad9c-3476adc40516",
                        "glosses": [
                            "The quality of being tactual (relating to the sense of touch); that which concerns or is characterized by touch."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0a407b53-47c9-4b4f-95dd-d90572ce5aa2",
                                "sense_id": "faf054f6-c211-3f99-b712-960a34460aa6",
                                "text": "1858, William Robinson Pirie, An Inquiry into the Constitution, Powers, and Processes of the Human Mind, Aberdeen: A. Brown, Chapter 7, p. 398,\n[…] we are just as conscious of a cause of vision as of a cause of tactual feeling, and it is not improbable that we have even a sense of tactuality, if we may so speak, in the secondary sensations."
                            },
                            {
                                "example_id": "5a3c01b9-f93d-4647-acdf-02fc2cd95107",
                                "sense_id": "faf054f6-c211-3f99-b712-960a34460aa6",
                                "text": "Each heard with the same ear what the other heard. For every sniffing of the one nose there were two identical smells, and there were two tactualities for every touch."
                            },
                            {
                                "example_id": "2b4373b1-7f15-4dc0-93f5-ea9681c728d5",
                                "sense_id": "faf054f6-c211-3f99-b712-960a34460aa6",
                                "text": "[…] what [Sigmund Freud] calls infant sexuality appears to be, as Lawrence Frank has observed, largely tactuality."
                            }
                        ]
                    }
                ],
