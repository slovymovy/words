                "senses": [
                    {
                        "sense_id": "a3e148de-2217-3143-8e9a-a6077095c597",
                        "entry_id": "9c4093db-d72d-3aa6-970e-ff981f1cf192",
                        "glosses": [
                            "Donner un caractère stratosphérique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f067818d-8664-4ead-87f9-48b793ce492a",
                                "sense_id": "a3e148de-2217-3143-8e9a-a6077095c597",
                                "text": "Des caricaturistes ont osé liquider, stratosphériser, exploser toute l'équipe de Charlie Hebdo."
                            },
                            {
                                "example_id": "d123d164-ddad-470d-9400-e1419ced14c7",
                                "sense_id": "a3e148de-2217-3143-8e9a-a6077095c597",
                                "text": "Vu que les marques leader ont commencé à stratosphériser les tarifs les longues focales, il y a à mon avis un nouveau marché pour les marques tierces qui peuvent aussi taper un peu plus haut dans le prix, contre un supplément qualitatif..."
                            },
                            {
                                "example_id": "31a1467f-5db1-4ae5-81d4-afeb60aa362c",
                                "sense_id": "a3e148de-2217-3143-8e9a-a6077095c597",
                                "text": "Toutes les autres machines citées sus-ditement sont pas mal mais nécessitent de se stratosphériser pour espérer enrouler quelque chose."
                            }
                        ]
                    }
