                        "entry_id": "6fa565da-fae8-3c7a-9bcb-3e644c80d9ff",
                        "glosses": [
                            "situatie waarbij een regering evenveel geld ontvangt als uitgeeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a830b323-a6a2-452a-9ad4-4a748bd0d17e",
                                "sense_id": "1ed9c373-3686-3322-aa72-a2857f904e49",
                                "text": "Regeringspartij VVD benadrukt dat het goed is dat het tekort onder de 3 procent blijft. Maar ook met de nieuwe cijfers is het een uitdaging om begrotingsevenwicht te realiseren, zegt de VVD. Ook het CDA is blij dat het tekort meevalt, maar de partij noemt het onverstandig het geld meteen uit te geven."
                            },
                            {
                                "example_id": "5fb509b0-8ba2-4d4c-a6e7-7941d6e0e13c",
                                "sense_id": "1ed9c373-3686-3322-aa72-a2857f904e49",
                                "text": "De SGP streeft op termijn naar begrotingsevenwicht, maar wil zich nog niet vastleggen op een concreet jaar. De partij wil een aantal maatregelen uit het Vijfpartijenakkoord terugdraaien. Zo wordt de forensenbelasting afgeschaft, net als de verplichting van werkgevers om van ontslagen werknemers een half jaar WW door te betalen."
                            }
                        ]
                    }
