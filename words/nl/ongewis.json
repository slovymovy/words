{
    "word_family": [
        "gewis",
        "ongewisheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c402bc43-c66d-3b25-a2d4-8141dbe82f82",
                    "sense_definition": "Niet zeker of vaststaand; twijfelachtig.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onzekerheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gevolgen van deze nieuwe politieke wending zijn uiterst <w>ongewis</w>.",
                            "target_lang_translations": {
                                "en": "The consequences of this new political turn are extremely <w>uncertain</w>."
                            }
                        },
                        {
                            "text": "Zij lieten ons lange tijd in een <w>ongewisse</w> situatie verkeren.",
                            "target_lang_translations": {
                                "en": "They left us in an <w>uncertain</w> situation for a long time."
                            }
                        }
                    ],
                    "synonyms": [
                        "onzeker",
                        "onwis"
                    ],
                    "antonyms": [
                        "gewis"
                    ],
                    "common_phrases": [
                        "een ongewisse toekomst",
                        "in het ongewisse"
                    ],
                    "target_lang_definitions": {
                        "en": "Not certain or fixed; doubtful or unsure."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "uncertain",
                                "target_lang_sense_clarification": "not reliable or known beforehand"
                            },
                            {
                                "target_lang_word": "unsure",
                                "target_lang_sense_clarification": "not certain"
                            },
                            {
                                "target_lang_word": "doubtful",
                                "target_lang_sense_clarification": "unlikely or uncertain"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2cc85e0-7355-3896-883b-9e2a06b8482c",
                    "sense_definition": "Gekenmerkt door risico, instabiliteit of onduidelijkheid; hachelijk.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onzekerheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het plotselinge faillissement van het bedrijf ging hij een <w>ongewisse</w> toekomst tegemoet.",
                            "target_lang_translations": {
                                "en": "After the sudden bankruptcy of the company, he faced an <w>uncertain</w> future."
                            }
                        },
                        {
                            "text": "Of de operatie zou slagen, bleef tot het laatste moment een uiterst <w>ongewisse</w> zaak.",
                            "target_lang_translations": {
                                "en": "Whether the operation would succeed remained an extremely <w>uncertain</w> matter until the very last moment."
                            }
                        }
                    ],
                    "synonyms": [
                        "hachelijk",
                        "wankel",
                        "precair",
                        "onduidelijk"
                    ],
                    "antonyms": [
                        "gewis"
                    ],
                    "common_phrases": [
                        "een ongewisse zaak"
                    ],
                    "target_lang_definitions": {
                        "en": "Characterized by risk, instability, or lack of clarity; precarious."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "precarious",
                                "target_lang_sense_clarification": "dangerously insecure or unstable"
                            },
                            {
                                "target_lang_word": "uncertain",
                                "target_lang_sense_clarification": "unpredictable or risky"
                            },
                            {
                                "target_lang_word": "unpredictable",
                                "target_lang_sense_clarification": "not able to be foreseen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}