                    {
                        "sense_id": "9f2e16e0-0ab8-3459-acb3-7d532c67e9c9",
                        "entry_id": "20835f00-5b92-31ee-916e-323cc48e521f",
                        "glosses": [
                            "Given to or marked by forebodings or predictions of impending calamity."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5c05530f-21a8-4296-b071-545090cf2ccb",
                                "sense_id": "9f2e16e0-0ab8-3459-acb3-7d532c67e9c9",
                                "text": "The Sages chose to end the haftarah with this message of hope, in contrast to the episode's last verse with its doomsday warning that \"if you persist in your wrongdoing, both you and your king shall be swept away.\""
                            }
                        ]
                    },
