                "senses": [
                    {
                        "sense_id": "56655531-e99f-3a9f-8783-280594627ce2",
                        "entry_id": "35e26bf9-4998-3f1e-8c34-c5e069d3dcee",
                        "glosses": [
                            "ein niederländischer Käse der Gouda-Art, der aus Kuhmilch hergestellt und ein oder zwei Jahre gereift wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fa25949-663e-4682-8576-6fb97146c517",
                                "sense_id": "56655531-e99f-3a9f-8783-280594627ce2",
                                "text": "„Von Hand gewendet, über Jahre gereift und limitiert: der Reypenaer ist nicht irgendein Käse.“"
                            },
                            {
                                "example_id": "04621ddc-310d-4eb1-8260-e488eb984635",
                                "sense_id": "56655531-e99f-3a9f-8783-280594627ce2",
                                "text": "„Bei Holstein kaufte er zwei Brötchen mit Reypenaer Käse, nicht ohne von der Fachverkäuferin Mathilde Overkamp freundlich darauf hingewiesen zu werden, dass dies der erste Reypenaer der Saison sei.“"
                            },
                            {
                                "example_id": "9bba3410-9891-425b-b95e-b35ee24e41bc",
                                "sense_id": "56655531-e99f-3a9f-8783-280594627ce2",
                                "text": "„Der Reypenaer reift ein Jahr lang, der Reypenaer VSOP zwei Jahre und der XO zweieinhalb Jahre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
