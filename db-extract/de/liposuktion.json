                        "entry_id": "d2d9358b-6303-3203-91c7-c1d9bb566969",
                        "glosses": [
                            "Absaugen von überflüssigem Fettgewebe"
                        ],
                        "tags": [
                            "Schönheitschirurgie"
                        ],
                        "examples": [
                            {
                                "example_id": "7838e974-3619-4a98-9124-f1e6a4d0aaf0",
                                "sense_id": "7d02c093-7753-3848-86c3-29c6f89c8320",
                                "text": "Bei der Liposuktion hat sie mehrere Kilo verloren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e02ec93-c041-4a7c-b02a-797e1baaf2cc",
                        "source_entry_id": "d2d9358b-6303-3203-91c7-c1d9bb566969",
                        "source_sense_id": "7d02c093-7753-3848-86c3-29c6f89c8320",
                        "source_sense_description": "Medizin, Schönheitschirurgie: Absaugen von überflüssigem Fettgewebe",
                        "target_lang_word": "liposuction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liposuction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfe7398e-a522-3fbc-9b62-5e555b6e6df2",
                                        "entry_id": "86cc1370-7cb0-354f-a39b-8100dabb1fc0",
                                        "glosses": [
                                            "A cosmetic surgery procedure in which excess fat is removed from a specific area by suction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0ef34d7-6a8a-4e25-b404-fcb88c342a2b",
                                                "sense_id": "dfe7398e-a522-3fbc-9b62-5e555b6e6df2",
                                                "text": "Wasn't my Mom a betty? She died when I was just a baby. A fluke accident during a routine liposuction. I don't remember her, but I like to pretend she still watches over me."
                                            },
                                            {
                                                "example_id": "1d843e88-f3a9-4f93-ba3f-bc1f7747e8b3",
                                                "sense_id": "dfe7398e-a522-3fbc-9b62-5e555b6e6df2",
                                                "text": "Dr. Peter Normann, the physician who performed liposuctions and other procedures, has been charged in Superior Court with two counts of second-degree murder and one count of manslaughter."
                                            },
                                            {
                                                "example_id": "c7fab32f-0bfd-4bbd-8c4a-a12a2d7ad246",
                                                "sense_id": "dfe7398e-a522-3fbc-9b62-5e555b6e6df2",
                                                "text": "One of my patients, a beautiful 25-year-old woman, was left with shark bite-sized divots all over her thighs and stomach after undergoing laser liposuction by a family medicine doctor."
                                            },
                                            {
                                                "example_id": "18e88b40-8251-4cdf-a978-940aa963ea0a",
                                                "sense_id": "dfe7398e-a522-3fbc-9b62-5e555b6e6df2",
                                                "text": "But a number of surgeons and clinics have reported an increased demand for surgery on those body parts most visible during video calls – neck liposuctions, lower facelifts and under-eye fillers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "liposuction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f04ff783-88a1-3783-ac69-e0b3f90ac455",
                                        "entry_id": "309ba537-e8d8-3225-a797-146f5956cabf",
                                        "glosses": [
                                            "To remove by liposuction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4c49581-9012-4b12-b445-5aaf23d42ab2",
                                                "sense_id": "f04ff783-88a1-3783-ac69-e0b3f90ac455",
                                                "text": "It’s not easy to get curves like theirs. The most common type of buttock enhancement, called the “Brazilian Butt Lift,” involves liposuctioning fat from the thighs or hips, purifying it, and then re-injecting it into the buttocks."
                                            },
                                            {
                                                "example_id": "37dd5cae-b87b-4289-a156-3824550ca692",
                                                "sense_id": "f04ff783-88a1-3783-ac69-e0b3f90ac455",
                                                "text": "When Randi Wright got a Brazilian butt lift in 2020 — a complex surgery in which fat is liposuctioned from the abdomen or lower back or other fleshy parts and used to enlarge and shape the buttocks — she knew she couldn’t afford the most expensive post-op care."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33c3d683-716a-41e7-b569-e10211bfb235",
                        "source_entry_id": "d2d9358b-6303-3203-91c7-c1d9bb566969",
                        "source_sense_id": "7d02c093-7753-3848-86c3-29c6f89c8320",
                        "source_sense_description": "Medizin, Schönheitschirurgie: Absaugen von überflüssigem Fettgewebe",
                        "target_lang_word": "liposuccion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liposuccion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9561465-c954-37b9-810d-08af2c0cb1b3",
                                        "entry_id": "4613893b-e12e-3673-baab-c1bac3d0c432",
                                        "glosses": [
                                            "Opération de chirurgie esthétique permettant un remodelage de la silhouette par l’aspiration d’amas graisseux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa94eaea-7267-49fa-a2ff-329545c3b6f3",
                                                "sense_id": "c9561465-c954-37b9-810d-08af2c0cb1b3",
                                                "text": "Ayant pris du ventre ces derniers temps et n’étant pas dans le besoin financièrement parlant, il décida de se faire faire une liposuccion."
                                            },
                                            {
                                                "example_id": "3b3c2bb2-1de9-4b6f-99da-380033b3896a",
                                                "sense_id": "c9561465-c954-37b9-810d-08af2c0cb1b3",
                                                "text": "La semaine prochaine on part à Palm Desert pour un lifting du front, une réduction nasale, une blépharoplastie, une lipoaspiration des joues, une augmentation mammaire, une plastie abdominale, une liposuccion des cuisses et des mollets…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
