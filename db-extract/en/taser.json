                                    {
                                        "sense_id": "6b9c2d37-f11d-38f1-bcbd-0b3151181931",
                                        "entry_id": "eede1aac-ae14-3eec-aaf3-81c7c3ddacd2",
                                        "glosses": [
                                            "Pistolet à impulsion électrique."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d2255d9-160c-474c-9609-9a780cb1cd68",
                                                "sense_id": "6b9c2d37-f11d-38f1-bcbd-0b3151181931",
                                                "text": "Finalement arrêté à l’issue d’une course-poursuite, le conducteur, alors âgé de 23 ans, ne se laisse pas faire lors de l’interpellation et un des trois policiers doit utiliser son taser, pistolet à impulsion électrique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8648d7e1-ca87-3650-acf8-57783d2aa4d0",
                                        "entry_id": "eede1aac-ae14-3eec-aaf3-81c7c3ddacd2",
                                        "glosses": [
                                            "N’importe quelle arme de poing à impulsion électrique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2041988d-f0c4-4dfd-99ae-3fb033a640e6",
                                                "sense_id": "8648d7e1-ca87-3650-acf8-57783d2aa4d0",
                                                "text": "Hier vers 11 h, ils ont décelé un taser ou plus exactement un shocker sur un Belfortain qui était convoqué à l’hôtel de police. Il s’agissait d’un petit appareil de production d’impulsion électrique de couleur noir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "taser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ea2a2c8-6612-3aa8-8cb6-686df2b17577",
                                        "entry_id": "2a404e14-8e24-3a92-afef-e769d1d0422c",
                                        "glosses": [
                                            "Atteindre par un pistolet Taser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3391650-facf-4977-aedf-b7f00be6ca9f",
                                                "sense_id": "7ea2a2c8-6612-3aa8-8cb6-686df2b17577",
                                                "text": "Un supporter de l'équipe de baseball américaine les Phillies a été tasé par un policier après avoir pénétré sur le terrain en plein match."
                                            },
                                            {
                                                "example_id": "4e2a0d80-2412-4e0b-9313-c02a12f8be34",
                                                "sense_id": "7ea2a2c8-6612-3aa8-8cb6-686df2b17577",
                                                "text": "Une vidéo qui tombe mal, puisque ce même jour un homme est mort dans le pays après avoir été tasé en pleine poitrine."
                                            },
                                            {
                                                "example_id": "9532f590-eac4-49b3-bca8-1bd23c61ad1c",
                                                "sense_id": "7ea2a2c8-6612-3aa8-8cb6-686df2b17577",
                                                "text": "L'ancien receveur des Baltimore Ravens, Jermaine Lewis, a été tasé chez lui sous les yeux de son fils de 4 ans, après une balade en voiture dans le Maryland."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c03a60e9-0647-4e80-8b05-dd0567ddfde9",
