                    "sense_definition": "Река в России (в Кемеровской области или Красноярском крае).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Маленькая река <w>Собака</w> протекает через густой сибирский лес.",
                            "target_lang_translations": {
                                "de": "Der kleine Fluss <w>Sobaka</w> fließt durch einen dichten sibirischen Wald."
                            }
                        },
                        {
                            "text": "Рыбаки любят приезжать на берег реки <w>Собака</w> в летний сезон.",
                            "target_lang_translations": {
                                "de": "Angler kommen in der Sommersaison gerne an das Ufer des Flusses <w>Sobaka</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Fluss in Russland (in der Oblast Kemerowo oder der Region Krasnojarsk)."
                    },
                    "translations": {
