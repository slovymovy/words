                        "sense_id": "3d1cc867-aa44-32b9-bdf6-e244d504cab8",
                        "entry_id": "34514097-290c-3d07-8fda-06603be4ba35",
                        "glosses": [
                            "To ship incorrectly, such as to the wrong location or at the wrong time."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e945ecb0-a3fd-4749-8157-b6dbd6769169",
                                "sense_id": "3d1cc867-aa44-32b9-bdf6-e244d504cab8",
                                "text": "Agent Garretson had suggested to Yoshida that he could arrange for an IBM employee to misship a kit, and if Yoshida could find a buyer he would give Yoshida a sizable share of the profits."
                            },
                            {
                                "example_id": "a03f0baa-82e1-410d-9821-d9891b76cea1",
                                "sense_id": "3d1cc867-aa44-32b9-bdf6-e244d504cab8",
                                "text": "The FBI would come, find our bundles and water them down, or misship our stuff on purpose."
                            },
                            {
                                "example_id": "ef5b2501-3573-4085-b673-9e98bacbbfb0",
                                "sense_id": "3d1cc867-aa44-32b9-bdf6-e244d504cab8",
                                "text": "Rations were coming to us direct from Pusan, but carloads of supplies from Pohang-dong, which had been delayed or misshipped, were still arriving."
                            }
                        ]
                    }
