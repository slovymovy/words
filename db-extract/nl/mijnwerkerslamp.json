                        "tags": [],
                        "examples": [
                            {
                                "example_id": "101015b1-9abd-4981-a0cc-2c8f0dccad94",
                                "sense_id": "e6f3158e-380b-3e98-841d-e9ba0bbdb700",
                                "text": "Er kletterden dakpannen naar beneden en de vrouw hoorde iemand. Ze belde direct de politie, die bij aankomst een man op de grond in de tuin zag liggen, nat van het zweet, met een mijnwerkerslamp om zijn hals, handschoenen aan, een tang in zijn jas en een tas vol lood naast een fiets, die eigendom van de man bleek."
                            }
                        ]
