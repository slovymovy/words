                ],
                "senses": [
                    {
                        "sense_id": "c70cada9-ead1-3d2c-a2d7-08b28600be06",
                        "entry_id": "a30b2f7b-49e5-3877-9e59-8d07c854f54a",
                        "glosses": [
                            "voorheen omstreden, maar nu algemeen en zelfs tot in officiële kringen geaccepteerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd03a715-3ce6-4c42-905f-8ea9f79afbb2",
                                "sense_id": "c70cada9-ead1-3d2c-a2d7-08b28600be06",
                                "text": "Zowel Die Grünen als de Freie Demokraten dingen vanaf volgende week waarschijnlijk mee naar de hand van kanselier Angela Merkel. Voor haar zijn zij, met de SPD, de enige salonfähige coalitiepartners. Groen wil na twaalf jaar weg uit de oppositie, de FDP wil in de eerste plaats opnieuw in het parlement geraken na een tocht van vier jaar door de politieke woestijn. Hoe liggen hun kansen?"
                            },
                            {
                                "example_id": "4ee55fee-ec89-4d12-9944-0c838efaa3d9",
                                "sense_id": "c70cada9-ead1-3d2c-a2d7-08b28600be06",
                                "text": "Dat de schoen nu ook salonfähig is in Nederland is te danken aan Guillaume Schmidt, een van de eigenaren van de Amsterdamse sneakerwinkel Patta. Het viel hem op dat steeds meer jonge mensen in Mephisto's rond stapten en hij zag meteen de waarde ervan in. Maar dan wel op zíjn manier. \"Mijn eerste herinnering aan Mephisto was die van mijn docenten die ze in mijn geboorteplaats droegen. Leraren, agenten, verpleegkundigen: ze droegen allemaal Mephisto. Het was een soort fascinatie voor me – ze hebben een specifieke esthetiek\", aldus Schmidt in zijn eigen blog."
                            },
                            {
                                "example_id": "3a4354d8-adf0-4ecc-8001-a40b9fbaa92a",
                                "sense_id": "c70cada9-ead1-3d2c-a2d7-08b28600be06",
                                "text": "Men treft hier louter fatsoenlijke lieden aan; fatsoenlijk in den zin, dien Nederlands naburen, met de slappe knieën, aan de woorden hof- en salonfähig hechten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d17e266f-622b-4dcc-8500-617745c06390",
                        "source_entry_id": "a30b2f7b-49e5-3877-9e59-8d07c854f54a",
                        "source_sense_id": "c70cada9-ead1-3d2c-a2d7-08b28600be06",
                        "source_sense_description": "van iets dat eerst omstreden was dat het nu algemeen geaccepteerd is in officiële kringen",
                        "target_lang_word": "salonfähig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salonfähig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26d6dd05-f7d5-3ee0-828b-3d4a86c95c71",
                                        "entry_id": "24fa3336-17c6-3172-bc4e-2228d2192519",
                                        "glosses": [
                                            "von der Allgemeinheit als akzeptabel erachtet, den vorherrschenden gesellschaftlichen Normen entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa3ba785-eab9-4fb1-bf81-4115f9251c5b",
                                                "sense_id": "26d6dd05-f7d5-3ee0-828b-3d4a86c95c71",
                                                "text": "Mit seiner gewinnenden Art versucht er seine extremen Ansichten salonfähig zu machen."
                                            },
                                            {
                                                "example_id": "ca3283be-ba7c-46d5-b007-c12bd4132320",
                                                "sense_id": "26d6dd05-f7d5-3ee0-828b-3d4a86c95c71",
                                                "text": "„»Rassistische Positionen werden unter Umständen normalisiert und damit auch die politischen Schlussfolgerungen, die man aus ihnen ziehen kann: Ausgrenzung, Ungleichbehandlung und Diskriminierung werden salonfähig.«“"
                                            },
                                            {
                                                "example_id": "84988d15-e7bf-471c-8d9e-7a8b0ea42fa8",
                                                "sense_id": "26d6dd05-f7d5-3ee0-828b-3d4a86c95c71",
                                                "text": "„Trotz aller Beteuerungen laufen große Bemühungen der Energiekonzerne, Schiefergas in Europa salonfähig zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
