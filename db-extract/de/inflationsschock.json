                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fd4d391-c89b-47c6-a6a4-932faa496ed5",
                                "sense_id": "01a03f4a-39e4-3c93-b967-fc408c0ef9c5",
                                "text": "„Die Staatsschuldenwächter des Fiskalrats warnen vor lockerer Handhabe bei den Staatsausgaben. Höhere Einnahmen dank des Inflationsschocks seien nicht von Dauer.“"
                            },
                            {
                                "example_id": "c034553a-43dd-4c3a-8924-06f01d969a24",
                                "sense_id": "01a03f4a-39e4-3c93-b967-fc408c0ef9c5",
                                "text": "„Das erste Hilfspaket gegen den Energiepreis- und Inflationsschock ist vom Parlament noch nicht beschlossen, da schiebt die Regierung in Wien schon das zweite an.“"
                            }
                        ],
