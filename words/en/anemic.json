{
    "word_family": [
        "anemia",
        "anemically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b6264e03-0608-346c-809b-f6aba05b9ffc",
                    "sense_definition": "Suffering from, caused by, or relating to anemia.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor told Sarah she was <w>anemic</w> due to a lack of iron in her diet.",
                            "target_lang_translations": {
                                "ru": "Врач сказал Саре, что у неё <w>анемия</w> из-за недостатка железа в рационе."
                            }
                        },
                        {
                            "text": "He looked remarkably pale and felt constantly tired because he had become <w>anemic</w>.",
                            "target_lang_translations": {
                                "ru": "Он выглядел удивительно бледным и постоянно чувствовал усталость, потому что стал <w>анемичным</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "anaemic"
                    ],
                    "antonyms": [
                        "nonanemic"
                    ],
                    "common_phrases": [
                        "severely anemic",
                        "mildly anemic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Страдающий анемией (малокровием), вызванный ею или связанный с ней."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "анемичный",
                                "target_lang_sense_clarification": "страдающий анемией, медицинский контекст"
                            },
                            {
                                "target_lang_word": "малокровный",
                                "target_lang_sense_clarification": "страдающий малокровием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3ae5897-e312-3375-8aa3-40530f3ee022",
                    "sense_definition": "Lacking energy, vitality, power, or distinctive character.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government faced harsh criticism for its <w>anemic</w> response to the economic crisis.",
                            "target_lang_translations": {
                                "ru": "Правительство столкнулось с резкой критикой за свой <w>вялый</w> ответ на экономический кризис."
                            }
                        },
                        {
                            "text": "Critics described the band's latest album as an <w>anemic</w> imitation of their earlier work.",
                            "target_lang_translations": {
                                "ru": "Критики назвали последний альбом группы <w>безжизненным</w> подражанием их раннему творчеству."
                            }
                        }
                    ],
                    "synonyms": [
                        "feeble",
                        "lifeless",
                        "insipid",
                        "weak"
                    ],
                    "common_phrases": [
                        "anemic growth",
                        "anemic response",
                        "anemic performance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишённый энергии, жизненной силы, выразительности или мощи; вялый, слабый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вялый",
                                "target_lang_sense_clarification": "лишённый активности и энергии"
                            },
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "недостаточный по силе или выразительности"
                            },
                            {
                                "target_lang_word": "анемичный",
                                "target_lang_sense_clarification": "в переносном смысле: бледный, безжизненный"
                            },
                            {
                                "target_lang_word": "безжизненный",
                                "target_lang_sense_clarification": "лишённый живости и яркости"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ccb85e46-e93b-3d96-8912-7ef388a22a69",
                    "sense_definition": "A person who suffers from anemia.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As an <w>anemic</w>, she needs to take iron supplements every day to keep her energy levels up.",
                            "target_lang_translations": {
                                "ru": "Как <w>человек с анемией</w>, она должна каждый день принимать препараты железа, чтобы поддерживать уровень энергии."
                            }
                        },
                        {
                            "text": "The clinic offers special nutritional guidance for chronic <w>anemics</w> who struggle with fatigue.",
                            "target_lang_translations": {
                                "ru": "Клиника предлагает специальные рекомендации по питанию для людей с хронической <w>анемией</w>, страдающих от усталости."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, страдающий анемией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "больной анемией",
                                "target_lang_sense_clarification": "человек с диагнозом анемия"
                            },
                            {
                                "target_lang_word": "анемик",
                                "target_lang_sense_clarification": "разговорно-медицинское обозначение больного малокровием"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}