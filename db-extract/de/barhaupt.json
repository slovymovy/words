                        "entry_id": "a39a79e2-8086-3131-9d0e-9238064a887f",
                        "glosses": [
                            "keine Kopfbedeckung (zum Beispiel Hut oder Mütze) tragend, ein unbedecktes Haupt aufweisend"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "a27dc1f2-541b-44da-bde7-4530ea09c759",
                                "sense_id": "e1768534-54aa-32f4-b598-ae772993d639",
                                "text": "„Er war barhaupt und hatte eine Glatze.“"
                            },
                            {
                                "example_id": "d4587d95-f0c5-456b-bccd-6a22868d87fa",
                                "sense_id": "e1768534-54aa-32f4-b598-ae772993d639",
                                "text": "„Das Kind schob einen Teppichkehrer kreuz und quer; die Frau, barhaupt auf der Terrasse, putzte die große Fensterfront mit alten Zeitungen.“"
                            },
                            {
                                "example_id": "2b930fe4-8c65-4bdb-98ce-314b42845f9b",
                                "sense_id": "e1768534-54aa-32f4-b598-ae772993d639",
                                "text": "„…; rechts ist Hieronymus als Eremit dargestellt, barhaupt, mit blauem Mantelgewand, zu seinen Füßen sein Attribut, der Löwe; …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
