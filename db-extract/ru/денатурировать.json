                    },
                    {
                        "translation_id": "ea09cb15-83f9-4ace-8da6-04d2023705f4",
                        "source_entry_id": "58538c25-63d0-346d-a367-936ef076191e",
                        "source_sense_description": "изменять (изменить) каким-либо способом вкус, запах и т. п. продукта, чтобы сделать его непригодным к употреблению в пищу",
                        "target_lang_word": "denature",
