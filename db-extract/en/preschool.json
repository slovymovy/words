                        "examples": [
                            {
                                "example_id": "276f484e-bed9-42af-8523-42cd428e895f",
                                "sense_id": "7ce62aa5-c4c2-3670-a5fe-726ce8d7f8ee",
                                "text": "Sarah's daughter got rejected by the preschool of her choice.",
                                "translation": "Sarahs Tochter wurde von der Vorschule ihrer Wahl abgelehnt."
                            },
                            {
                                "example_id": "bac25c23-7245-4a51-b0be-bfc93ed2208a",
                                "sense_id": "7ce62aa5-c4c2-3670-a5fe-726ce8d7f8ee",
                                "text": "Young parents are wondering if they should enroll their child in preschool.",
                                "translation": "Junge Eltern fragen sich, ob sie ihr Kind bei einer Vorschule anmelden sollten."
