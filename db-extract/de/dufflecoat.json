                                        "entry_id": "0be9f415-a45a-3eda-8341-0a3e4aac0caa",
                                        "glosses": [
                                            "A warm, hooded coat, made from duffel, fastened with toggles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3e4a63c-936b-44c9-9696-6ceedb346d27",
                                                "sense_id": "86fb81aa-11b1-3510-aed1-9060966f03df",
                                                "text": "Even in an era when individuality in dress is a cult, his clothes were noticeable. He was wearing a hard hat of the low round kind favoured by hunting men, and with it a black duffle-coat lined with white."
                                            }
                                        ]
                                    }
                                ]
                            }
