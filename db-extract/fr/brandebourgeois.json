                                        "entry_id": "410877f4-1934-3c8f-ab88-3a99cf51d026",
                                        "glosses": [
                                            "sich auf die Mark Brandenburg beziehend, von dort kommend, zur Mark Brandenburg gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "558946e4-8ab0-471a-ab27-96f82656a974",
                                                "sense_id": "7c85b276-b4b8-35d6-b2a3-d63c18fa914d",
                                                "text": "Das Land Brandenburg führt den märkischen Adler im Wappen."
                                            },
                                            {
                                                "example_id": "5af17a9f-8f26-40fd-8727-3e3bd85ef496",
                                                "sense_id": "7c85b276-b4b8-35d6-b2a3-d63c18fa914d",
                                                "text": "Das märkische Städtchen Buckow liegt im Naturpark Märkische Schweiz."
                                            }
