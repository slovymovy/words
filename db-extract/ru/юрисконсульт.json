                    {
                        "translation_id": "3fa22745-287d-4c95-b2a6-4b0021841f47",
                        "source_entry_id": "5cba5ddb-6d66-3fda-9bd9-737829cd8b0c",
                        "source_sense_id": "49464522-9443-370c-bb3f-ee0b2ee8159a",
                        "target_lang_word": "Syndikus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Syndikus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c97982cc-b784-3f37-a2d3-3ad98b719f91",
                                        "entry_id": "1f804f3a-8526-32fc-a52e-578bfb90ddc0",
                                        "glosses": [
                                            "Jurist, der als Rechtsanwalt zugelassen ist, aber überwiegend oder nur für ein Unternehmen, eine Bank, einen Verband oder Ähnliches im Rahmen eines Dienstvertrages tätig wird"
                                        ],
                                        "tags": [
                                            "in Deutschland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6c3148f-5e96-4e86-8134-ffb33881f2e2",
                                                "sense_id": "c97982cc-b784-3f37-a2d3-3ad98b719f91",
                                                "text": "„Die Richter hätten zwar den bereits befreiten Syndizi einen Bestandsschutz eingeräumt – der gelte aber nicht mehr bei einem Wechsel des Arbeitgebers oder des Tätigkeitsfelds.“"
                                            },
                                            {
                                                "example_id": "990cf1a4-cc02-4a17-a076-b41630c00f4e",
                                                "sense_id": "c97982cc-b784-3f37-a2d3-3ad98b719f91",
                                                "text": "„Syndikus Distelwang zieht alles aus, indigniert.“"
                                            },
                                            {
                                                "example_id": "7de11db1-b568-4304-9753-3a41ecfe2dfb",
                                                "sense_id": "c97982cc-b784-3f37-a2d3-3ad98b719f91",
                                                "text": "„Der Syndikus der Hessischen Landesbank wird hereingerufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d1950851-41be-3321-a4be-eb1a391b5b64",
                                        "entry_id": "1f804f3a-8526-32fc-a52e-578bfb90ddc0",
                                        "glosses": [
                                            "zunächst ein Kleriker, später dann ein Jurist, der eine Gemeinde in rechtlichen Angelegenheiten berät und vertritt"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c714755-1ffa-41a2-839a-6924660cb6fb",
                                                "sense_id": "d1950851-41be-3321-a4be-eb1a391b5b64",
                                                "text": "„Die unpräsentablen Bürgermeister und Syndikusse und Rathmänner der kleinen Landstädte sind fest gestanden, wo vielleicht vornehmere Männer gewichen wären.“"
                                            },
                                            {
                                                "example_id": "d5e98a02-eb48-47f9-92f5-a1d3028a3474",
                                                "sense_id": "d1950851-41be-3321-a4be-eb1a391b5b64",
                                                "text": "„Nun wetteiferten der Syndikus und ich, ihr süße Komplimente zu machen und zu sagen, wir hofften, ihre Brüder zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c69a2c9-651e-4695-83cd-eaab44d69652",
