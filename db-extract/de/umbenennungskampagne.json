                "senses": [
                    {
                        "sense_id": "6550e15d-0a48-31dc-901c-56f09b9c54d8",
                        "entry_id": "8d9a5878-1061-3ba4-b1b8-9f40b231c1d1",
                        "glosses": [
                            "Aktion zur Umbenennung von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ad1560f-4de0-4c26-8f17-c99b3c8085f3",
                                "sense_id": "6550e15d-0a48-31dc-901c-56f09b9c54d8",
                                "text": "„Mit diesem Akt wurde eine gigantische Umbenennungskampagne in Gang gesetzt, in deren Verlauf Tausende deutsche Namen und Bezeichnungen für Ortschaften, Flüsse und Seen geändert und neue russische Namen für Zehntausende Straßen, Plätze und Gassen erfunden werden mussten.“"
                            },
                            {
                                "example_id": "abd32937-7220-4115-a942-2a799a3919c2",
                                "sense_id": "6550e15d-0a48-31dc-901c-56f09b9c54d8",
                                "text": "„Die Umbenennungskampagne für die übrigen Städte und Ortschaften im Königsberger Gebiet begann dagegen erst im Herbst 1947 und zog sich bis Sommer 1950 hin.“"
                            },
                            {
                                "example_id": "759f6d13-7e0d-4414-9c7c-7e20dcf2d8c4",
                                "sense_id": "6550e15d-0a48-31dc-901c-56f09b9c54d8",
                                "text": "„Ausgangspunkt der jüngsten Umbenennungskampagne waren einige kriminelle Vorkommnisse in Italien, in die rumänische Staatsbürger verwickelt waren, die angeblich der Romaminderheit angehören.“"
                            },
                            {
                                "example_id": "e937953b-75d9-4ec4-93f1-f6cdf48e08be",
                                "sense_id": "6550e15d-0a48-31dc-901c-56f09b9c54d8",
                                "text": "„Im Jahr 2004 hatte die taz, die an der Kochstraße residiert, die Umbenennungskampagne begonnen.“"
                            },
                            {
                                "example_id": "5fb7786b-12e5-41d2-80f2-c280094389fa",
                                "sense_id": "6550e15d-0a48-31dc-901c-56f09b9c54d8",
                                "text": "„Die Umbenennungskampagne soll mehrere Jahre dauern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
