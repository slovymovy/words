                    "frequency": "High",
                    "semantic_group_id": "organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bibliothécaire prend le temps de <w>classer</w> tous les livres par genre littéraire."
                        },
                        {
                            "text": "Tu peux <w>classer</w> ces photos dans des dossiers thématiques sur ton ordinateur."
                        }
                    ],
                    "synonyms": [
