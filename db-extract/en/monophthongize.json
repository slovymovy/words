                "translations": [
                    {
                        "translation_id": "f8bfe5c8-0823-4179-b163-51e4f1ae8a96",
                        "source_entry_id": "331c2393-cdea-3176-ad83-d4d643014a73",
                        "source_sense_description": "to change to a monophthong",
                        "target_lang_word": "monophtonguer",
