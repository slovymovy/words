                "senses": [
                    {
                        "sense_id": "dd2a52e5-c5da-351c-ae4c-286272b69898",
                        "entry_id": "ecf2a951-9736-323a-9cb3-9a2ab92b8485",
                        "glosses": [
                            "diminutive of боя́ться (bojátʹsja): to be rather afraid"
                        ],
                        "tags": [
                            "colloquial",
                            "diminutive",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "0feadb0d-c6c2-4e3e-bbf8-bb404a9fc0a0",
                                "sense_id": "dd2a52e5-c5da-351c-ae4c-286272b69898",
                                "text": "он поба́ивается идти́ туда́",
                                "translation": "he is rather afraid of going there",
                                "english": "he is rather afraid of going there"
                            },
                            {
                                "example_id": "ca70f097-8a7b-4adb-bc18-494904e0cb08",
                                "sense_id": "dd2a52e5-c5da-351c-ae4c-286272b69898",
                                "text": "Никола́й Петро́вич поба́ивался молодо́го «нигили́ста» и сомнева́лся в по́льзе его́ влия́ния на Арка́дия; но он охо́тно его́ слу́шал, охо́тно прису́тствовал при его́ физи́ческих и хими́ческих о́пытах.",
                                "translation": "Nikolai Petrovich was rather frightened of the young \"Nihilist\" and doubted the benefit of his influence on Arkady, but he listened keenly to what he said and was glad to be present during his chemical and scientific experiments.",
                                "english": "Nikolai Petrovich was rather frightened of the young \"Nihilist\" and doubted the benefit of his influence on Arkady, but he listened keenly to what he said and was glad to be present during his chemical and scientific experiments."
                            }
                        ]
                    }
                ],
