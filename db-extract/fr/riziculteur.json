                    {
                        "sense_id": "9f163178-b3bd-3e79-ada2-b677c9882b0a",
                        "entry_id": "e79ec550-b2d3-3ff4-8ba5-b540db6db2be",
                        "glosses": [
                            "Agriculteur qui fait pousser du riz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84f87ed3-4b73-4271-a600-50f02155753f",
                                "sense_id": "9f163178-b3bd-3e79-ada2-b677c9882b0a",
                                "text": "« Je n’ai jamais vu une sécheresse si prolongée. La situation est dramatique. Si le problème d’eau persiste, ma récolte risque d’être dévastée à 100 % », redoute Gianluigi Tacchini, un riziculteur de la bourgade de Santa Cristina e Bissone, à une quarantaine de kilomètres au sud de Milan."
                            },
                            {
                                "example_id": "8df6fc9b-388c-4e56-8ebd-3b47deac35a1",
                                "sense_id": "9f163178-b3bd-3e79-ada2-b677c9882b0a",
                                "text": "De petites exploitations se sont spécialisées dans la production de semences de première qualité qu’ils vendent aux riziculteurs dans des sacs de 500 kg."
                            }
                        ]
                    }
                ],
                "translations": [
