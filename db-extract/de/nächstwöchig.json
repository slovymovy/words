                    },
                    {
                        "form_id": "5c1da002-6783-4cce-bf6e-d3127ca90943",
                        "entry_id": "ae703dc6-c15e-39ac-8b7d-85cfdb72472b",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind nächstwöchig"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9e5d1a08-3bdd-3b61-8927-d86c35acf2de",
                        "entry_id": "ae703dc6-c15e-39ac-8b7d-85cfdb72472b",
                        "glosses": [
                            "zu der kommenden Woche gehörend, in der kommenden Woche stattfindend"
                        ],
                        "tags": [
                            "oft von etwas Wöchentlichem oder sich (in etwa) über eine Woche Erstreckendem"
                        ],
                        "examples": [
                            {
                                "example_id": "df0d1fd3-ddff-4e5b-80a3-8abc35a80793",
                                "sense_id": "9e5d1a08-3bdd-3b61-8927-d86c35acf2de",
                                "text": "„Beim nächstwöchigen ÖVP-Bundesparteitag wird es einen Abänderungsantrag zum neuen Parteiprogramm geben: Gesetze sollen künftig mit einem Ablaufdatum versehen werden.“"
                            },
                            {
                                "example_id": "32a7b8a4-a39f-466c-8b01-565650b05770",
                                "sense_id": "9e5d1a08-3bdd-3b61-8927-d86c35acf2de",
                                "text": "„Die Behebung der dritten Rate wird erst aus dem nächstwöchigen Bankausweis ersichtlich sein.“"
                            },
                            {
                                "example_id": "ef70335d-0e6b-4ada-84ef-b234b2c88cea",
                                "sense_id": "9e5d1a08-3bdd-3b61-8927-d86c35acf2de",
                                "text": "„Am 17./18. Mai jährt sich zum ersten Mal die Übernahme der Kanzlerschaft durch Kern. Das wird nun allerdings von der ÖVP-Führungsrochade überschattet. Ebenso die nächstwöchigen beiden Plenartage im Parlament.“"
                            },
                            {
                                "example_id": "c5bf4dda-c74e-4da3-be3f-0eb7c25c87c8",
                                "sense_id": "9e5d1a08-3bdd-3b61-8927-d86c35acf2de",
                                "text": "„Eine über Nacht errichtete Hütte und das offensichtliche Versagen der Stadtverwaltung waren dankbare Aufmacher für das nächstwöchige Sonntags-Feuilleton der Abendpost.“"
                            },
                            {
                                "example_id": "106f6659-077c-4462-a5c3-6afa53aace84",
                                "sense_id": "9e5d1a08-3bdd-3b61-8927-d86c35acf2de",
                                "text": "„‚Flandern & die Niederlande‘ sind gemeinsam Ehrengast der nächstwöchigen Frankfurter Buchmesse.“"
                            }
