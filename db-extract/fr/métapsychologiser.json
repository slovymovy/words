                "senses": [
                    {
                        "sense_id": "dafbe574-f480-3203-9e05-b88794ead265",
                        "entry_id": "c2685138-2271-3efb-9ab8-553d1996b6e4",
                        "glosses": [
                            "Donner un caractère métapsychologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b94f456e-efbe-47bf-a652-925d1dcbfbae",
                                "sense_id": "dafbe574-f480-3203-9e05-b88794ead265",
                                "text": "Certains vont adroitement sauver la mise en faisant du crime la limite d’un effondrement, d’autres vont s’efforcer de tout métapsychologiser."
                            },
                            {
                                "example_id": "c4d2cfa2-906e-4836-9c6b-037f1973e8f1",
                                "sense_id": "dafbe574-f480-3203-9e05-b88794ead265",
                                "text": "Comme le relève Le Guen (2008, p. 282), « Le moi et le çà » permet de dépasser l’observation directe et la seule clinique du complexe d’Œdipe pour véritablement le « métapsychologiser » en fonction du surmoi."
                            }
                        ]
                    }
