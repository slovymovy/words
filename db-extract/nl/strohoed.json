                                    {
                                        "sense_id": "f105d49f-d7af-351c-8f71-3b9eb0056ce8",
                                        "entry_id": "9dbf109b-94ed-3249-a416-2f41ec401156",
                                        "glosses": [
                                            "A drinking straw."
