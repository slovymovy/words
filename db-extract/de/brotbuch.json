                "senses": [
                    {
                        "sense_id": "c1353873-6845-3231-b5cd-5624628a2531",
                        "entry_id": "dc3d32da-e666-307c-a57c-beb63c2b968f",
                        "glosses": [
                            "von Behörden verausgabtes Heft für den kontrollierten Bezug von Brot in Notzeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef07be4d-ffa4-4885-9822-9bf8f346c14a",
                                "sense_id": "c1353873-6845-3231-b5cd-5624628a2531",
                                "text": "„Doch das neue Verfahren der Nahrungszuteilung musste verwaltet werden - die Kommunalbehörden hatten alle Anmeldungen zu kontrollieren, nummerierte Brotbücher sowie Brotkarten zu entwerfen, drucken zu lassen und zu verteilen.“"
                            },
                            {
                                "example_id": "32ea83db-d568-45fc-b62a-6efd57cf1a7b",
                                "sense_id": "c1353873-6845-3231-b5cd-5624628a2531",
                                "text": "„Die Verteilungsstelle ist nicht verpflichtet, für verlorene Brotbücher neue auszugeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "54b4a9e2-fd02-3bb3-9be8-710755e11f21",
                        "entry_id": "dc3d32da-e666-307c-a57c-beb63c2b968f",
                        "glosses": [
                            "Buch zum Thema „Brot“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96bf39b5-b170-4b80-80b0-247dd8509e4f",
                                "sense_id": "54b4a9e2-fd02-3bb3-9be8-710755e11f21",
                                "text": "„Übrigens: Das kleine Brotbuch stammt in der ersten Auflage aus dem Jahr 1991 und war damals auch in Schulküchen guter Ratgeber!“"
                            },
                            {
                                "example_id": "6943d3e6-4d3a-498a-a2e0-1fa23558542e",
                                "sense_id": "54b4a9e2-fd02-3bb3-9be8-710755e11f21",
                                "text": "„Neben einer ausführlichen Einführung und einer detaillierten Anleitung für den Grundteig mit verschiedenen Mehlsorten enthält das mit appetitlichen Rezeptbildern gestaltete Brotbuch über 45 absolut gelingsichere Rezepte mit Vollkorn, Nüssen, Quinoa oder Maismehl.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
