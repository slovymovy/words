                "senses": [
                    {
                        "sense_id": "90a13906-d779-3fa2-a471-cf57347f1c12",
                        "entry_id": "a1dd55ea-045e-3ba9-8107-16abc66c3d8e",
                        "glosses": [
                            "Hauptgottheit der babylonischen Religion, früher Stadtgott von Babylon"
                        ],
                        "tags": [
                            "babylonische"
                        ],
                        "examples": [
                            {
                                "example_id": "00061554-c756-4df8-91bb-a116b63153bb",
                                "sense_id": "90a13906-d779-3fa2-a471-cf57347f1c12",
                                "text": "Marduks Schöpfungsakte markieren den Beginn der Zeit und werden jährlich als Neujahr begangen."
                            },
                            {
                                "example_id": "1c090caf-3243-4d48-a4d8-16f8035a49dd",
                                "sense_id": "90a13906-d779-3fa2-a471-cf57347f1c12",
                                "text": "Nach Marduks Sieg über Tiamat versammeln, feiern und ehren die Götter Marduk, indem sie ihm 50 Namensattribute verleihen."
                            },
                            {
                                "example_id": "fac588a4-ad5f-40b4-b1e6-eb22d25bce0c",
                                "sense_id": "90a13906-d779-3fa2-a471-cf57347f1c12",
                                "text": "Nebukadnezar I. war der erste, der offiziell anerkannte, dass Marduk im 12. Jahrhundert v. Chr. Anführer des Pantheons war."
                            },
                            {
                                "example_id": "89a2f20e-86e3-41e9-a630-7c9e857b38d1",
                                "sense_id": "90a13906-d779-3fa2-a471-cf57347f1c12",
                                "text": "Marduk weist den Göttern ihre Aufgaben zu und lässt sie sein „prunkvolles Heiligtum“ himmelhoch in Babylon aufschichten."
                            },
                            {
                                "example_id": "5f7bdbc9-5d06-4a4b-ae31-f5f06873c787",
                                "sense_id": "90a13906-d779-3fa2-a471-cf57347f1c12",
                                "text": "Als Schöpfungsmythos sollte es die Allmacht von Marduk, dem Stadtgott von Babylon, manifestieren und damit in der trostlosen Gegenwart ein Zeichen setzen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
