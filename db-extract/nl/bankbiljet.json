                        ],
                        "form": "bankbiljetje"
                    },
                    {
                        "form_id": "940f5b66-8dfe-4d34-b58f-916c8539e94d",
                        "entry_id": "0d35f6a4-b080-30b4-a745-0399d2a382c1",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "bankbiljetjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f672016-5a3e-3c80-a272-1316ac75ec79",
                        "entry_id": "0d35f6a4-b080-30b4-a745-0399d2a382c1",
                        "glosses": [
                            "een betaalmiddel uitgegeven door een (centrale) bank van papier of kunststof dat is bedrukt met een tekst waaruit een tegenwaarde blijkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71492cce-dabb-4c18-9a5b-7c7ff63e71fa",
                                "sense_id": "8f672016-5a3e-3c80-a272-1316ac75ec79",
                                "text": "U kunt bij ons geen bankbiljetten van €500,- inwisselen."
                            },
                            {
                                "example_id": "4eb1f690-48b8-4050-9c6a-a33de95cd9d8",
                                "sense_id": "8f672016-5a3e-3c80-a272-1316ac75ec79",
                                "text": "'Slaoui trok een bankbiljet uit zijn zak en vertrok'. De visser vroeg of hij misschien ook een sigaret voor hem had. Slaoui tastte in zijn broekzak maar die was leeg. Hij zei dat hij er geen meer had en de visser bedankte hem zonder zijn teleurstelling te verbergen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a092a85-322f-48d9-b2fd-d60a3a05f246",
                        "source_entry_id": "0d35f6a4-b080-30b4-a745-0399d2a382c1",
                        "source_sense_id": "8f672016-5a3e-3c80-a272-1316ac75ec79",
                        "source_sense_description": "een betaalmiddel van papier",
                        "target_lang_word": "Banknote",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Banknote",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "98e29a8d-e10c-3ea3-9557-30d2874635be",
                                        "entry_id": "ff8f5ad3-3c11-3404-82f8-34c011287aea",
                                        "glosses": [
                                            "Geldschein, der im alltäglichen Zahlungsverkehr genutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f9e6ec0-35f1-41dd-9b74-23cbc67f59a0",
                                                "sense_id": "98e29a8d-e10c-3ea3-9557-30d2874635be",
                                                "text": "Wer Banknoten nachmacht oder fälscht, wird mit Gefängnis nicht unter zwei Jahren bestraft."
                                            },
                                            {
                                                "example_id": "a878388a-0706-43e7-a82f-1a031e13d5ad",
                                                "sense_id": "98e29a8d-e10c-3ea3-9557-30d2874635be",
                                                "text": "„Sechzig Berliner Privatdruckereien sind mit dem Druck von Banknoten beschäftigt.“"
                                            },
                                            {
                                                "example_id": "62dcfe97-6a33-416e-ad66-79647509f1ac",
                                                "sense_id": "98e29a8d-e10c-3ea3-9557-30d2874635be",
                                                "text": "„Die Schönheit der Banknoten machte ihn schwach, als er sie zählte.“"
                                            },
                                            {
                                                "example_id": "95e5cfc9-ad12-40b9-8a59-b8b07b5c0fc1",
                                                "sense_id": "98e29a8d-e10c-3ea3-9557-30d2874635be",
                                                "text": "„1661 war Schweden das erste Land Europas, das Banknoten druckte.“"
                                            },
                                            {
                                                "example_id": "7c0870f3-8df7-4665-8ad9-ac96a3f0566e",
                                                "sense_id": "98e29a8d-e10c-3ea3-9557-30d2874635be",
                                                "text": "„Ich ging in mein Zimmer; während der Graf bei seiner Frau war, steckte ich die fünfzehntausend Lire in Banknoten ein, die ich mir von Greppi geholt hatte, und legte das ganze Geld des Marchese Triulzi beiseite.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be6b1b80-ccdf-4a3b-b820-f136ac598899",
                        "source_entry_id": "0d35f6a4-b080-30b4-a745-0399d2a382c1",
                        "source_sense_id": "8f672016-5a3e-3c80-a272-1316ac75ec79",
                        "source_sense_description": "een betaalmiddel van papier",
                        "target_lang_word": "Geldschein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geldschein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad93a2af-1841-30a3-8588-664189d8b6de",
                                        "entry_id": "e235fc03-522c-326f-a1f0-20a6a6c90ec3",
                                        "glosses": [
                                            "Papiergeld; Schein, der als Zahlungsmittel verwendet wird oder wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0b11dc7-7e76-40bc-a6ee-fc33edf379da",
                                                "sense_id": "ad93a2af-1841-30a3-8588-664189d8b6de",
                                                "text": "Ich nehme sicherheitshalber immer nur wenig Geldscheine mit zum Einkaufen."
                                            },
                                            {
                                                "example_id": "9b57bc6e-75d1-4963-9cab-b0b3d004c347",
                                                "sense_id": "ad93a2af-1841-30a3-8588-664189d8b6de",
                                                "text": "„Der Geldschein machte ihn ein wenig verträglicher.“"
                                            },
                                            {
                                                "example_id": "eb279a33-790c-45ad-bb11-d48d5096b558",
                                                "sense_id": "ad93a2af-1841-30a3-8588-664189d8b6de",
                                                "text": "„Sie packten bald ihre zwei Klamotten zusammen, jener legte einen großen Geldschein auf den Tisch, bezahlte die Rechnung, und dann folgten sie ihm auf die Yacht.“"
                                            },
                                            {
                                                "example_id": "54259d99-98e7-4a68-b5dc-a6fe9ceaf793",
                                                "sense_id": "ad93a2af-1841-30a3-8588-664189d8b6de",
                                                "text": "„Stefans Geldscheine würden reichen, um die Familie für ein paar Tage zu ernähren.“"
                                            },
                                            {
                                                "example_id": "f20f5bcc-709e-481c-a627-7489fa36550d",
                                                "sense_id": "ad93a2af-1841-30a3-8588-664189d8b6de",
                                                "text": "„Er roch wieder an dem Geldschein, und der Geruch brachte ihn auch tatsächlich von dem Biergemälde ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a5e3d79-ad58-4b65-9628-b166e0fd1ad8",
                        "source_entry_id": "0d35f6a4-b080-30b4-a745-0399d2a382c1",
