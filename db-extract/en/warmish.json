                                        "glosses": [
                                            "Plus ou moins tiède, avec une valeur péjorative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07ab6ac7-e3b1-43ea-aac4-bdb832775947",
                                                "sense_id": "49f1abb0-266e-36e8-b108-dc32456fe546",
                                                "text": "Un auxiliaire, plus rogue que lui, offre des gamelles qu’un radiateur maintenait tiédasses."
                                            },
                                            {
                                                "example_id": "5624a48e-c8ae-4cf5-a7f2-82d8bdbf283e",
                                                "sense_id": "49f1abb0-266e-36e8-b108-dc32456fe546",
                                                "text": "2 août 42 – Le soleil nous brûle, la mère Landon circule avec une piquette tiédasse ; on pense à Pétrone et aux labiales fricatives comme à des folies de jeunesse."
                                            },
                                            {
                                                "example_id": "b1146255-e464-49d4-820c-aa1a19a8b20f",
                                                "sense_id": "49f1abb0-266e-36e8-b108-dc32456fe546",
                                                "text": "On a commandé du vin chaud. Le patron nous l’a servi tiédasse. J’ai jamais vu servir du vin chaud vraiment chaud, je sais pas comment ils se démerdent."
                                            },
                                            {
                                                "example_id": "f739223a-a057-48b6-a381-bc8c9ce7b738",
                                                "sense_id": "49f1abb0-266e-36e8-b108-dc32456fe546",
                                                "text": "Certes, on lui avait bien dit que ça ne serait pas facile de faire son « écolage » sous les ordres de Lorenzoni, mais il s’attendait plus à des ouragans qu’à cette petite brise tiédasse !"
                                            }
                                        ]
                                    }
