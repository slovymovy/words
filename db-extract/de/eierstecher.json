                                "sense_id": "898915ba-eb20-39a3-afe5-6b6ef80980db",
                                "text": "Pierre, nimm den Eierstecher, dann platzen die Eier auch nicht beim Kochen."
                            },
                            {
                                "example_id": "dce0b599-3b6e-4404-ba23-4913999f2945",
                                "sense_id": "898915ba-eb20-39a3-afe5-6b6ef80980db",
                                "text": "Autsch! Jetzt habe ich mich schon wieder am Eierstecher gestochen."
                            }
