                                        "entry_id": "8d0d3164-6c72-321e-900f-f2be148551a0",
                                        "glosses": [
                                            "Any short video, in a format directly supported by HTML5 (ie. GIF, MP4, WebM)"
                                        ],
                                        "tags": [
                                            "Internet",
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
