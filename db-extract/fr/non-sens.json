            {
                "entry_id": "8d57e1eb-ee1c-3da1-aefb-08437e6d60e2",
                "word": "non-sens",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "94362d1b-baf2-3eed-8109-8f15db2aebea",
                        "entry_id": "8d57e1eb-ee1c-3da1-aefb-08437e6d60e2",
                        "glosses": [
                            "Défaut de sens, de signification."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ccadcd85-11f7-3914-a44c-e64fa253d9de",
                        "entry_id": "8d57e1eb-ee1c-3da1-aefb-08437e6d60e2",
                        "glosses": [
                            "Discours dépourvu de sens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09b62359-0948-4476-a226-de6783d500db",
                                "sense_id": "ccadcd85-11f7-3914-a44c-e64fa253d9de",
                                "text": "Ce discours est un non-sens, un non-sens continuel."
                            }
                        ]
                    },
                    {
                        "sense_id": "30d4be2f-982b-35ce-a791-aa69aea60f72",
                        "entry_id": "8d57e1eb-ee1c-3da1-aefb-08437e6d60e2",
                        "glosses": [
                            "Absurdité, chose absurde."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f9b294f3-011d-4235-9672-833ff4d5d142",
                                "sense_id": "30d4be2f-982b-35ce-a791-aa69aea60f72",
                                "text": "La société sans la justice est un non-sens."
                            },
                            {
                                "example_id": "204a9079-d647-446d-8fe1-22237005e002",
                                "sense_id": "30d4be2f-982b-35ce-a791-aa69aea60f72",
                                "text": "Et personne n’avait de réponse. Même Freud, le génie le plus lucide de ce temps, avec qui je parlais souvent à cette époque, ne trouvait aucune voie, ne trouvait aucun sens à ce non-sens."
                            },
                            {
                                "example_id": "06676b8f-1580-4fc6-b2ab-437ebdfafde5",
                                "sense_id": "30d4be2f-982b-35ce-a791-aa69aea60f72",
                                "text": "Les troubles post-traumatiques traduisent la difficulté pour la personne de métamorphoser cette expérience traumatique qui reste un non-sens, une réalité brute chargée émotionnellement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de3d1a87-a006-45d9-9b06-ee0184266c21",
                        "source_entry_id": "8d57e1eb-ee1c-3da1-aefb-08437e6d60e2",
                        "target_lang_word": "Unsinn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unsinn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d3c72e9-a9d8-3af3-bd11-a546ba4f1e62",
                                        "entry_id": "c7fd412d-3bc1-32ba-b355-5ed77d61f42a",
                                        "glosses": [
                                            "etwas, das keinen Sinn hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3b38575-a2a1-4aa8-9012-764310c3db97",
                                                "sense_id": "4d3c72e9-a9d8-3af3-bd11-a546ba4f1e62",
                                                "text": "Was für einen Unsinn sie da wieder von sich gibt!"
                                            },
                                            {
                                                "example_id": "a33bdd3f-4f15-4456-bd76-2ab697fef490",
                                                "sense_id": "4d3c72e9-a9d8-3af3-bd11-a546ba4f1e62",
                                                "text": "Du glaubst wohl auch jeden Unsinn, oder?"
                                            },
                                            {
                                                "example_id": "62ff04c3-ca96-4796-a160-a4df147944a5",
                                                "sense_id": "4d3c72e9-a9d8-3af3-bd11-a546ba4f1e62",
                                                "text": "Das ist doch Unsinn! Nun geh mal wieder nach Hause und sprich mit deinen Eltern."
                                            },
                                            {
                                                "example_id": "5d591364-6683-4169-89a5-471488dc96f7",
                                                "sense_id": "4d3c72e9-a9d8-3af3-bd11-a546ba4f1e62",
                                                "text": "Unsinn! So geht das nicht, schau mal hier, wie man das macht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "01214789-3ffc-3b2b-9382-b77d04afdbea",
                                        "entry_id": "c7fd412d-3bc1-32ba-b355-5ed77d61f42a",
                                        "glosses": [
                                            "unüberlegte Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a50925f-5489-4f17-9a44-b61e946cb17f",
                                                "sense_id": "01214789-3ffc-3b2b-9382-b77d04afdbea",
                                                "text": "Was machst du da wieder für einen Unsinn?"
                                            },
                                            {
                                                "example_id": "04d5f475-bb08-46f8-b1ac-578965c824f4",
                                                "sense_id": "01214789-3ffc-3b2b-9382-b77d04afdbea",
                                                "text": "Der Junge hat den lieben langen Tag nur Unsinn im Kopf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4966535a-d76b-4329-9a95-71cba2c089be",
                        "source_entry_id": "8d57e1eb-ee1c-3da1-aefb-08437e6d60e2",
                        "target_lang_word": "Nonsens",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nonsens",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "011ac257-9d87-31fe-adab-9aadeeb293be",
                                        "entry_id": "ee1ec8e2-4ede-38df-b9de-2e0aa0f57e2e",
                                        "glosses": [
                                            "etwas Sinnloses; Quatsch"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16b526c9-8afe-483b-8b6f-b8bdf512d632",
                                                "sense_id": "011ac257-9d87-31fe-adab-9aadeeb293be",
                                                "text": "Der Nonsens, den Sie von sich geben, ist nicht mehr auszuhalten."
                                            },
                                            {
                                                "example_id": "74d564e0-3949-4144-b070-ad35a59aea56",
                                                "sense_id": "011ac257-9d87-31fe-adab-9aadeeb293be",
                                                "text": "Es ist Nonsens, das Ziel weiter zu verfolgen."
                                            },
                                            {
                                                "example_id": "868eb810-b82c-4ea8-9e2e-3abc3fbeb00b",
                                                "sense_id": "011ac257-9d87-31fe-adab-9aadeeb293be",
                                                "text": "„Das ist Sprech-Musik […] Der Verwaltungsgerichtshof spricht von ‚prävalierender Rechtswidrigkeit‘. Soll heißen: Die Bescheide der Erst- und Berufungsbehörde sind totaler Nonsens, hirnrissig, ein Armutszeugnis.“"
                                            },
                                            {
                                                "example_id": "f6b5eedb-002a-438a-b28d-7c5158386db1",
                                                "sense_id": "011ac257-9d87-31fe-adab-9aadeeb293be",
                                                "text": "„Erst zu Hause, wenn ich auf dem Bett liegend noch einmal in Gedanken die politischen Neuigkeiten analysierte, kam ich zu dem Schluß, daß Zyskinds Beweisführungen Nonsens waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d27c8d13-3e3d-49ff-a2e6-ec3ba95194e8",
                        "source_entry_id": "8d57e1eb-ee1c-3da1-aefb-08437e6d60e2",
                        "target_lang_word": "nonsense",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nonsense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f84c921c-d824-334d-9624-33530a2601f7",
                                        "entry_id": "5e7a4a90-3e7d-36cb-a8a8-02c209538e68",
                                        "glosses": [
                                            "Letters or words, in writing or speech, that have no meaning or pattern or seem to have no meaning."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e51733b-4103-42bf-bb36-3547b6a7227f",
                                                "sense_id": "f84c921c-d824-334d-9624-33530a2601f7",
                                                "text": "After my father had a stroke, every time he tried to talk, it sounded like nonsense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2e44b80-22f7-3592-a017-a66f9df445e8",
                                        "entry_id": "5e7a4a90-3e7d-36cb-a8a8-02c209538e68",
                                        "glosses": [
                                            "An untrue statement."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2ba7ff3-5f3c-4588-8048-aadc33b3146a",
                                                "sense_id": "b2e44b80-22f7-3592-a017-a66f9df445e8",
                                                "text": "You have seen it for yourselves in the play by Aristophanes, where Socrates goes whirling round, proclaiming that he is walking on air, and uttering a great deal of other nonsense about things of which I know nothing whatsoever."
                                            },
                                            {
                                                "example_id": "70321e25-9766-460f-9e19-4a9cdb85423a",
                                                "sense_id": "b2e44b80-22f7-3592-a017-a66f9df445e8",
                                                "text": "While at the hospital, David kept screaming and yelling nonsense, stating Vladimir Putin bailed him out of jail and is a god."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89b006da-574e-35bc-9704-c3c6d074e1d4",
                                        "entry_id": "5e7a4a90-3e7d-36cb-a8a8-02c209538e68",
                                        "glosses": [
                                            "That which is silly, illogical and lacks any meaning, reason or value; that which does not make sense."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bbbaf6b9-d8e8-3056-a480-62a2e0e247ae",
                                        "entry_id": "5e7a4a90-3e7d-36cb-a8a8-02c209538e68",
                                        "glosses": [
                                            "Something foolish."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abecf1f0-d1b1-4309-8ee7-a787fcd58f55",
                                                "sense_id": "bbbaf6b9-d8e8-3056-a480-62a2e0e247ae",
                                                "text": "and central banks lend vast sums against marshmallow backed securities, or other nonsenses creative bankers dreamed up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e20a78c8-6ba3-3318-9f81-e82255fd1ba6",
                                        "entry_id": "5e7a4a90-3e7d-36cb-a8a8-02c209538e68",
                                        "glosses": [
                                            "A type of poetry that contains strange or surreal ideas, as, for example, that written by Edward Lear."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "afd1081c-defe-32bb-a6d9-b28232b02999",
                                        "entry_id": "5e7a4a90-3e7d-36cb-a8a8-02c209538e68",
                                        "glosses": [
                                            "A damaged DNA sequence whose products are not biologically active, that is, that does nothing."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nonsense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "575c28a7-86cf-3d1e-a117-ddab3e634247",
                                        "entry_id": "6ed31c16-6ed7-3607-9bbb-896227debd38",
                                        "glosses": [
                                            "To make nonsense of;"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d682a32c-9f26-4cae-a7c6-6a5a3e78aa0c",
                                                "sense_id": "575c28a7-86cf-3d1e-a117-ddab3e634247",
                                                "text": "At the Haymarket all this is nonsensed by an endeavor to steer between Mr. Stanley Weyman's rights as author of the story and the prescriptive right of the leading actor to fight popularly and heroically against heavy odds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "986af08d-39bc-34c9-8ccb-18794cc1c18f",
                                        "entry_id": "6ed31c16-6ed7-3607-9bbb-896227debd38",
                                        "glosses": [
                                            "To attempt to dismiss as nonsense; to ignore or belittle the significance of something; to render unimportant or puny."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7625b9a0-d083-4f8e-a596-ba1af24f1af0",
                                                "sense_id": "986af08d-39bc-34c9-8ccb-18794cc1c18f",
                                                "text": "\"They haven't nonsensed these workouts. They've taken them and used them very well. I didn't know how they'd respond, but they've responded.\""
                                            },
                                            {
                                                "example_id": "c0dfef1f-f82a-4fbd-b24e-337f3ebcea30",
                                                "sense_id": "986af08d-39bc-34c9-8ccb-18794cc1c18f",
                                                "text": "Very commanding: very much 'end of this nonsensing'. Mister Fared spread his hands and shook his thin head imperceptibly, as if to say he understood."
                                            },
                                            {
                                                "example_id": "e5c5ab8f-9847-4078-9d3a-f3877511fcb1",
                                                "sense_id": "986af08d-39bc-34c9-8ccb-18794cc1c18f",
                                                "text": "He further nonsensed press suggestions that the Petroleum Unit was set up to assist in the administration of sporting activities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9c7a792-728f-3852-80cb-30dea3631f65",
                                        "entry_id": "6ed31c16-6ed7-3607-9bbb-896227debd38",
                                        "glosses": [
                                            "To joke around, to waste time"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7969aa5-2c12-4376-991f-3ef3c240d263",
                                                "sense_id": "c9c7a792-728f-3852-80cb-30dea3631f65",
                                                "text": "When he meant \"go and get one\" he said to go and get one, with no nonsensing around about \"liking\" to get one."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nonsense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d34fd531-2868-35c7-829b-12b5d9fbd955",
