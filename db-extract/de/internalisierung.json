                "senses": [
                    {
                        "sense_id": "e45aa17a-796b-3c03-b399-4b2719395e24",
                        "entry_id": "de293fe4-ff7e-3904-b376-9a09a8fa8f54",
                        "glosses": [
                            "die Verinnerlichung von Werten im Verlauf der Sozialisation"
                        ],
                        "tags": [
                            "Sozialwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "7552fafd-17fe-4463-b4fc-bb37765631d7",
                                "sense_id": "e45aa17a-796b-3c03-b399-4b2719395e24",
                                "text": "Von einem gewissen Alter an ist die Internalisierung der Normen nicht mehr umkehrbar."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b6e69f6b-2c94-364f-9d16-b724adc38f00",
                        "entry_id": "de293fe4-ff7e-3904-b376-9a09a8fa8f54",
                        "glosses": [
                            "Einbeziehung externer Effekte in interne Entscheidungen und damit in die Kostenrechnung"
                        ],
                        "tags": [
                            "Wirtschaftswissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "ed5035f8-720b-4f9f-b6c3-06acaa4e50fd",
                                "sense_id": "b6e69f6b-2c94-364f-9d16-b724adc38f00",
                                "text": "Ziel der Internalisierung ist es, die durch Marktversagen entstandenen Ineffizienzen zu minimieren und so das Wohlfahrtsoptimum zu erreichen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d6a52080-db3b-362e-95ec-53df4db8e0fb",
                        "entry_id": "de293fe4-ff7e-3904-b376-9a09a8fa8f54",
                        "glosses": [
                            "Rückzug (Translokation) von Rezeptoren von der Zelloberfläche in das Zellinnere"
                        ],
                        "tags": [
                            "Pharmakologie"
                        ],
                        "examples": [
                            {
                                "example_id": "109552df-ebc1-48de-ae8b-a17271b38af4",
                                "sense_id": "d6a52080-db3b-362e-95ec-53df4db8e0fb",
                                "text": "Die Internalisierung wird ausgelöst durch anhaltend hohe Konzentrationen stimulierender Rezeptor-Liganden (Agonisten)"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
