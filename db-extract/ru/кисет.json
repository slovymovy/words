                    {
                        "translation_id": "2bf23a73-b0a2-45f3-8132-10c6ad328cc3",
                        "source_entry_id": "843312f2-c120-35cd-ae9b-de2a84c84f4c",
                        "source_sense_id": "a22ab7c7-50f7-3ada-8d9a-309a48e86444",
                        "target_lang_word": "bolsa para tabaco",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7b651c37-e827-4b75-aab4-9cb5c075c129",
                        "source_entry_id": "843312f2-c120-35cd-ae9b-de2a84c84f4c",
                        "source_sense_id": "a22ab7c7-50f7-3ada-8d9a-309a48e86444",
                        "target_lang_word": "Tabaksbeutel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tabaksbeutel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c406c6e-0b67-3866-9bae-54f33924526c",
                                        "entry_id": "61280817-3e64-38d2-8fc6-1a6bf4c9369f",
                                        "glosses": [
                                            "kleiner flexibler Behälter zur Aufbewahrung von Tabak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa0b039f-2392-4b58-a2ae-e05b52978838",
                                                "sense_id": "7c406c6e-0b67-3866-9bae-54f33924526c",
                                                "text": "„Das Gesicht war faltig wie ein alter polnischer Tabaksbeutel aus dem napoleonischen Krieg.“"
                                            },
                                            {
                                                "example_id": "4aacf3a1-d674-42dd-a21d-8b74e4a0f6e8",
                                                "sense_id": "7c406c6e-0b67-3866-9bae-54f33924526c",
                                                "text": "„Die eine Hand, die den Tabaksbeutel umschlossen hielt, hatte er in den Brustausschnitt gesteckt, mit der andern stützte er sich auf das Pfeifenrohr.“"
                                            },
                                            {
                                                "example_id": "7b46bbcb-fec5-49f0-abf1-bbe800813d3d",
                                                "sense_id": "7c406c6e-0b67-3866-9bae-54f33924526c",
                                                "text": "„Ihre Lendenhemden, am Wampumgürtel befestigt, reichten bis an die Knie, und an einem Riemen, der quer über die Schultern hing, war ihr Tabaksbeutel befestigt.“"
                                            },
                                            {
                                                "example_id": "a41b8491-7244-4048-826d-cc4915bac8ad",
                                                "sense_id": "7c406c6e-0b67-3866-9bae-54f33924526c",
                                                "text": "„Er ging dazu über, sich aus einem neben ihm liegenden Tabaksbeutel eine Zigarette zu drehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f0d85e6-d5f0-455b-b86c-879e4097e1ae",
                        "source_entry_id": "843312f2-c120-35cd-ae9b-de2a84c84f4c",
                        "source_sense_id": "a22ab7c7-50f7-3ada-8d9a-309a48e86444",
                        "target_lang_word": "blague",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blague",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e8cc3d1-e76e-3876-9a9e-7b3e2b475db1",
                                        "entry_id": "855949a4-71ea-389e-8805-a01feb7b870d",
                                        "glosses": [
                                            "Petit sachet taillé dans une grosse toile, une vessie, une poche de pélican ou une peau dans lequel les fumeurs mettent le tabac dont ils font usage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d55b527-b7d4-429b-861f-575588b77bcc",
                                                "sense_id": "6e8cc3d1-e76e-3876-9a9e-7b3e2b475db1",
                                                "text": "[…] un marchand de tabac qui arborait fièrement à sa devanture, au-dessus de blagues en cuir granuleux et en vessie de porc, des grappes de pipes blanches."
                                            },
                                            {
                                                "example_id": "96288677-c202-4922-a48e-0f56c0060b0c",
                                                "sense_id": "6e8cc3d1-e76e-3876-9a9e-7b3e2b475db1",
                                                "text": "Le fossoyeur planta sa bêche dans le tas de terre meuble, tira une pipe et une blague à tabac de ses poches, puis bourra l’une avec le contenu de l’autre, tout en poursuivant son récit."
                                            },
                                            {
                                                "example_id": "311595a9-2302-4947-8747-e3985dc53d0d",
                                                "sense_id": "6e8cc3d1-e76e-3876-9a9e-7b3e2b475db1",
                                                "text": "Appartenant à la grande confrérie des conteurs et chanteurs errants, ce troubadour marocain ne possède pour toute fortune qu’un âne famélique, un vieux haïk en lambeaux, une pipe et une blague à kif et un petit instrument primitif à deux cordes, un gimbri, attribut de son état."
                                            },
                                            {
                                                "example_id": "b0bee016-bd67-476e-a605-cbdc0224095e",
                                                "sense_id": "6e8cc3d1-e76e-3876-9a9e-7b3e2b475db1",
                                                "text": "Je lève doucement la tête et je vois, à ma grande joie, que le lion, emporté par l’élan qu’il avait pris pour se jeter sur moi, était tombé juste dans la gueule du crocodile. […] Un pelletier de l’endroit me fit avec la peau du lion un certain nombre de blagues à tabac, dont je distribuai une partie à mes connaissances à Ceylan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8de6a3a-5cc4-3433-b983-45a07a69879e",
                                        "entry_id": "855949a4-71ea-389e-8805-a01feb7b870d",
                                        "glosses": [
                                            "Poche située sous le bec du pélican lui permettant d’attraper ses proies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ca87da8-16a0-4ef9-a90e-758513b8260d",
                                                "sense_id": "a8de6a3a-5cc4-3433-b983-45a07a69879e",
                                                "text": "Sa chair étant dure et puante, on estime surtout le Pélican pour sa blague, sans laquelle on pourrait le confondre avec le cygne… […] Il est vrai que pour lui ôter la tentation d’avaler les poissons renfermés dans sa blague, on lui met au bas du cou un ruban rouge assez étroit pour ne laisser passer que le fretin…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62bda5ac-2502-3fd6-9fe8-546bbf8706fb",
                                        "entry_id": "855949a4-71ea-389e-8805-a01feb7b870d",
                                        "glosses": [
                                            "Plaisanterie ou histoire imaginée pour amuser ou se moquer de quelqu’un."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "621a87fc-90d3-41a3-a947-937bf4a5e0d7",
                                                "sense_id": "62bda5ac-2502-3fd6-9fe8-546bbf8706fb",
                                                "text": "On a beaucoup parlé des toilettes de Barbey d’Aurevilly. L’excellente blague parisienne s’est fort exercée sur sa redingote et ses pantalons."
                                            },
                                            {
                                                "example_id": "e12c5da4-7df0-4f09-a0af-47b120b22ad1",
                                                "sense_id": "62bda5ac-2502-3fd6-9fe8-546bbf8706fb",
                                                "text": "Les blagues sur les bègues doivent être livrées avec parcimonie et le minimum d’effets. Elles doivent pouvoir faire rire un bègue.\nEt joignant le geste à l’idée, elle amenait un bègue pour qu’il entende la blague. De même, Tristan racontait des blagues sur les aveugles aux aveugles, et des blagues sur les trous de mémoire aux amnésiques."
                                            },
                                            {
                                                "example_id": "a0a8b28b-719a-4925-bf76-b5f878ced117",
                                                "sense_id": "62bda5ac-2502-3fd6-9fe8-546bbf8706fb",
                                                "text": "Nous avons défini la blague comme une forme d’« humour de l’instant ». Le conteur sait qu’en règle générale, les plus courtes sont bien les meilleures ! La puissance d’une blague réside dans la détente et le décalage de sa chute."
                                            },
                                            {
                                                "example_id": "db135b0d-447d-43ca-86e9-2ac759ded909",
                                                "sense_id": "62bda5ac-2502-3fd6-9fe8-546bbf8706fb",
                                                "text": "Je me replie dans ma chambre, après être redescendue dans le salon où j’ai trouvé Papa, Henri et Mayeul en plein fou-rire à propos de je ne sais pas quelle blague sur l’économie, […]."
                                            },
                                            {
                                                "example_id": "685cbe42-0074-48ab-ade1-f32f2af7c5ea",
                                                "sense_id": "62bda5ac-2502-3fd6-9fe8-546bbf8706fb",
                                                "text": "Il collectionne lui-même les breloques en tout genre, mais refuse d’en livrer le chiffre précis : « Vous savez bien que le nombre de décorations est inversement proportionnel à la santé de la prostate. » Une blague de corps de garde, on ne se refait pas."
                                            },
                                            {
                                                "example_id": "4f137e61-e3a0-4dc8-943f-0f6459387178",
                                                "sense_id": "62bda5ac-2502-3fd6-9fe8-546bbf8706fb",
                                                "text": "Selon leurs résultats, les blagues contenant 103 mots sont les plus drôles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0886536b-34fd-3a4c-9f3c-4a4254fffc08",
                                        "entry_id": "855949a4-71ea-389e-8805-a01feb7b870d",
                                        "glosses": [
                                            "Farce faite à quelqu’un."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7237362a-a5ae-4684-bfd8-2dc6a64706bf",
                                                "sense_id": "0886536b-34fd-3a4c-9f3c-4a4254fffc08",
                                                "text": "Voila que d un seul coup on crie aux masques et aux creneaux. Mais moi toujours farceur je croyais a une blague mais pas du tout un gros nuage d une drole de couleur s avancait droit sur nous Note : Le texte n’a pas d’accents ni de ponctuation."
                                            },
                                            {
                                                "example_id": "30630f20-a93c-4bea-aea4-a42b5f7f678c",
                                                "sense_id": "0886536b-34fd-3a4c-9f3c-4a4254fffc08",
                                                "text": "Tiens, ça me rappelle la blague de Roland Dorgelès, tu sais, le Boronali, l’âne dont on magnifia le tableau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3d3ae53-7c14-3a99-8ca4-51473c2ad118",
                                        "entry_id": "855949a4-71ea-389e-8805-a01feb7b870d",
                                        "glosses": [
                                            "Maladresse, erreur sans gravité."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46057777-149a-3380-b9f0-395d08b4f118",
                                        "entry_id": "855949a4-71ea-389e-8805-a01feb7b870d",
                                        "glosses": [
                                            "Raillerie éloquente."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85f6737c-bb38-4343-81f6-da99901b94ca",
                                                "sense_id": "46057777-149a-3380-b9f0-395d08b4f118",
                                                "text": "Quelle admirable connaissance ont les gens de choix des limites où doivent s’arrêter la raillerie et ce monde de choses françaises désigné sous le mot soldatesque de blague, mot qui sera repoussé de la langue, espérons-le, mais qui seul peut faire comprendre l’esprit de la Bohême !"
                                            },
                                            {
                                                "example_id": "2d3f5371-0906-486a-ad5e-56959cb1315c",
                                                "sense_id": "46057777-149a-3380-b9f0-395d08b4f118",
                                                "text": "Ce détaillant avait pris l’habitude de gourmander ses commis, de leur expliquer les minuties du commerce de la mercerie en demi-gros, en les ornant des plates plaisanteries qui constituent le bagout des boutiques. Ce mot, qui désignait autrefois l’esprit de repartie stéréotypée, a été détrôné par le mot soldatesque de blague."
                                            },
                                            {
                                                "example_id": "8bfaaf76-d505-4aea-9aaf-603f0100927d",
                                                "sense_id": "46057777-149a-3380-b9f0-395d08b4f118",
                                                "text": "Mais la colère dura peu — car il y a une sorte de noblesse, de générosité dans la colère, — et l’on se contenta de rire. Bientôt, la blague, qui exprime toujours l’opinion moyenne, dans un jet d’immonde salive, la blague vint remplacer très vite la menace des poings tendus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blague",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37257474-732e-3c02-b9ad-9e2a86bb8627",
                                        "entry_id": "d38f430a-ba1b-3ac0-bde3-485c95d05ace",
                                        "glosses": [
                                            "Première personne du singulier de l’indicatif présent de blaguer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "518a0f8a-1614-4d07-9cef-bb50f2300df7",
                                                "sense_id": "37257474-732e-3c02-b9ad-9e2a86bb8627",
                                                "text": "Je blaque, tu blagues, nous blaquons…"
                                            }
                                        ]
                                    },
                                    {
