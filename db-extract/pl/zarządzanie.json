                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2781def7-d49c-413c-b524-f42036e90c1c",
                                "sense_id": "ea793924-8cd6-359d-aa46-3fc4a1720915",
                                "text": "Przechodzenie od systemu totalitarnego do demokratycznego i wolnorynkowego wymaga głębokich zmian świadomości, ustawodawczych i organizacyjnych w zakresie zarządzania środowiskiem przyrodniczym."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de29965b-bcfb-47a6-b766-cdc383aad42c",
                        "source_entry_id": "e826cc14-cbb5-309d-a5db-cc17f5c62115",
                        "source_sense_id": "ea793924-8cd6-359d-aa46-3fc4a1720915",
                        "target_lang_word": "management",
                        "target_lang_code": "en",
