                            {
                                "example_id": "1fb4a030-6a36-4381-b3ae-712d16e0dda3",
                                "sense_id": "093c588c-42d5-3a8e-9460-0810a630934e",
                                "text": "„In den USA wird Hillary Clinton von vielen Parteifreunden als Präsidentschaftskandidatin 2016 in Stellung gebracht.“"
                            },
                            {
                                "example_id": "d4ce01d0-79b3-44ca-9324-e2a3396cc3ed",
                                "sense_id": "093c588c-42d5-3a8e-9460-0810a630934e",
                                "text": "„Als Präsidentschaftskandidatin hätte sie wohl dennoch einen schweren Stand, die US-Amerikaner mit Blick auf die Wirtschaftslage davon zu überzeugen, dass ein radikaler Wandel nötig ist.“"
