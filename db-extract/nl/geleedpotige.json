                            {
                                "example_id": "9f92c396-e937-45eb-9a25-2a1c3774f508",
                                "sense_id": "bff2f9c3-66f0-3f25-8554-ceb13f071be9",
                                "text": "Geleedpotigen komen in alle leefomgevingen voor."
                            }
                        ]
