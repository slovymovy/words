                "senses": [
                    {
                        "sense_id": "dfc4c125-ca3e-3fd9-881c-42a06cebf9c7",
                        "entry_id": "19fc4261-c6fd-3bf7-8407-dfa8be4c6f99",
                        "glosses": [
                            "Elektrodenröhe mit drei Elektroden, bei der das zweite Gitter eine höhere positive Spannung als die Anode aufweist, wodurch es zu einer Emission von Sekundärelektronen kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1699468-d2e4-44f7-9511-3715d5d58f51",
                                "sense_id": "dfc4c125-ca3e-3fd9-881c-42a06cebf9c7",
                                "text": "„Es wurde ein Dynatron mit einer Gitterspannung Vg von 2 V, einer Anodenspannung Vp von 3,7 Volt und einem auf 52 kHz abgestimmten Anodenkreis gebaut, das mit sehr kleiner Leistung schwingt.“"
                            },
                            {
                                "example_id": "07e9249f-1687-43f9-8261-62533e73c127",
                                "sense_id": "dfc4c125-ca3e-3fd9-881c-42a06cebf9c7",
                                "text": "„Als Spannungsquelle für die hochfrequente Brückenspannung kann ein Dynatron verwendet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
