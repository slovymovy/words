                        "glosses": [
                            "paramilitaire hulppolitie van de Duitse bezetter tijdens de Tweede Wereldoorlog"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "999dc3e1-8d4a-4c91-a11c-1df5d1829e3a",
                                "sense_id": "56f8d55c-042f-3849-a26a-f48cdc8dfa2b",
                                "text": "Twee broers melden zich bij de Landwacht, een andere broer is commandant bij de WA (allebei paramilitaire organisaties gelieerd aan de NSB). Een vierde broer sluit zich aan bij de Waffen-SS en een van zijn zussen gaat in zee met een Duitse militair."
                            },
                            {
                                "example_id": "7ba2293c-63ef-4a93-b7a9-e234b384dfef",
                                "sense_id": "56f8d55c-042f-3849-a26a-f48cdc8dfa2b",
                                "text": "Als lid van de Landwacht infiltreerde Boere in 1944 met andere NSB'ers in het verzet in het Limburgse Helden-Panningen. Ze verraadden 52 onderduikers en verzetslieden, van wie er in ieder geval zeven later in concentratiekampen stierven."
                            }
                        ]
                    }
