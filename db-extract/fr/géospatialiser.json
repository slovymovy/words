                "senses": [
                    {
                        "sense_id": "b316eebf-943e-3220-a92b-551727c9e0c0",
                        "entry_id": "d966e44d-299c-36a6-b7c1-7de558f70893",
                        "glosses": [
                            "Repérer de façon géospatiale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5adaa7f-6150-42b7-a37b-5acf0e636a33",
                                "sense_id": "b316eebf-943e-3220-a92b-551727c9e0c0",
                                "text": "Dans son projet de réalisation de SCOT, le Pays de Balagne, syndicat mixte de trente six communes, collabore avec le CBN de Corse, pour géospatialiser la flore et la végétation dans les zones à fort enjeux d’urbanisation à court et moyen termes."
                            },
                            {
                                "example_id": "4e9075b8-f820-4a00-95cc-fe22b242b1e5",
                                "sense_id": "b316eebf-943e-3220-a92b-551727c9e0c0",
                                "text": "Lors du second semestre, des ateliers de travail avec les services de Nîmes Métropole ont permis, suite à l’exploitation par l’A’U de la base AGDE, de géospatialiser et qualifier la totalité des établissements privés, avec un traitement spécifique pour ceux concernant l’industrie numérique et de la santé."
                            },
                            {
                                "example_id": "c8aa6c77-849d-48fe-b8df-c15aecdcf889",
                                "sense_id": "b316eebf-943e-3220-a92b-551727c9e0c0",
                                "text": "Réseaux de grande taille, géospatialisés, évoluant dans le temps ?"
                            }
                        ]
                    }
                ],
