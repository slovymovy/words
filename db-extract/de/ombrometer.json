                "senses": [
                    {
                        "sense_id": "78d7180a-38e8-37a1-acf7-0fe27a45f82d",
                        "entry_id": "ddca827c-9637-3f6c-92a8-5f05aea59394",
                        "glosses": [
                            "Messgerät zur Bestimmung der Niederschlagsmenge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac43588d-4910-4636-9b47-e883c4f7f0e7",
                                "sense_id": "78d7180a-38e8-37a1-acf7-0fe27a45f82d",
                                "text": "„Hooke ist ferner, wenn auch nicht der Erste, doch einer der Ersten, der an das Ombrometer, den Regenmesser, dachte.“"
                            },
                            {
                                "example_id": "d3735a21-7153-4189-8973-c27061a39cbf",
                                "sense_id": "78d7180a-38e8-37a1-acf7-0fe27a45f82d",
                                "text": "„Zur Bestimmung der Wassermenge, die als Regen niederfällt, dient der Regenmesser, auch Ombrometer oder Udometer genannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
