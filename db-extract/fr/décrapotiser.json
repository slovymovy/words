                "senses": [
                    {
                        "sense_id": "47f3b08c-43b6-3091-929e-5ab74d816ce9",
                        "entry_id": "a7301261-33e7-3c44-abe6-276516459530",
                        "glosses": [
                            "Faire perdre son caractère crapoteux à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cac650b7-1f96-472a-8bbf-4ce54861de3e",
                                "sense_id": "47f3b08c-43b6-3091-929e-5ab74d816ce9",
                                "text": "C'est qu'y faut s'en occuper, d'une mob, et ces p'tits jeunes m'impressionnent par leur facilité à diagnostiquer, dévisser, remplacer, décalaminer, schroupitter, zoubriphier et décrapotiser les pièces les plus retorses de leurs capricieux engins."
                            },
                            {
                                "example_id": "90e74cc3-a0c1-4ff2-b9aa-22c19e607cf2",
                                "sense_id": "47f3b08c-43b6-3091-929e-5ab74d816ce9",
                                "text": "et rassure-moi tu as décrapotisé (si je puis dire) tes persos"
                            },
                            {
                                "example_id": "24af77b9-5942-4d4c-81bb-3058ae370fbc",
                                "sense_id": "47f3b08c-43b6-3091-929e-5ab74d816ce9",
                                "text": "Ma fille se décrapotise."
                            }
                        ]
                    }
