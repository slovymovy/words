                ],
                "senses": [
                    {
                        "sense_id": "254c5e27-8e9a-3afb-b57c-50f58c9ccaed",
                        "entry_id": "c2609d63-52a8-3a55-9850-2c19ee29ce25",
                        "glosses": [
                            "Bouillonnant, agité, en effervescence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6980494e-1b1e-4ad7-b927-a09cab393a4c",
                                "sense_id": "254c5e27-8e9a-3afb-b57c-50f58c9ccaed",
                                "text": "Le lendemain, ils ne se voyaient pas. Les couples restaient enfermés chez eux, à la diète, écœurés, abusant de cafés noirs et de cachets effervescents."
                            },
                            {
                                "example_id": "afb06a57-4f88-4401-aed6-9302d8ce3f4b",
                                "sense_id": "254c5e27-8e9a-3afb-b57c-50f58c9ccaed",
                                "text": "J’aurais voulu qu’elle vînt m’apporter un thé brûlant et sans sucre, qu’elle posât sur mon front une compresse humide, qu’elle fît dissoudre dans un grand verre cristallin des cachets effervescents."
                            },
                            {
                                "example_id": "6517b17e-62dd-4eb2-9ac3-bbdc870944d9",
                                "sense_id": "254c5e27-8e9a-3afb-b57c-50f58c9ccaed",
                                "text": "Ô Sylvius, bénissons les heures effervescentes de l’été qui posent leurs mains régénératrices sur nos corps détendus."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ce4c5dc-39d3-35e1-80c0-f5e81e36e6a3",
                        "entry_id": "c2609d63-52a8-3a55-9850-2c19ee29ce25",
                        "glosses": [
                            "Qui est susceptible d’effervescence."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d3918024-fb9f-47b1-9a31-dc788d9c9825",
                                "sense_id": "2ce4c5dc-39d3-35e1-80c0-f5e81e36e6a3",
                                "text": "Matières effervescentes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
