                                    {
                                        "sense_id": "bfde4b28-2f4e-3a25-a03c-31d8ed236a62",
                                        "entry_id": "a453fd51-d73a-3570-9353-827c179d05d0",
                                        "glosses": [
                                            "Eigenschaft, sich verändern (mutieren) zu können, Mutationen bilden zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ae948c8-6fc6-4f7c-8f7c-0864cc11f385",
                                                "sense_id": "bfde4b28-2f4e-3a25-a03c-31d8ed236a62",
                                                "text": "„Die Richtung der Evolution wird sicher mitbestimmt durch die faktische Begrenztheit der Mutabilität aller Organismenarten.“"
                                            },
                                            {
                                                "example_id": "6aa75be1-9e3d-4d23-a68a-7bc504e24dd1",
                                                "sense_id": "bfde4b28-2f4e-3a25-a03c-31d8ed236a62",
                                                "text": "„Um mutagene Effekte quantitativ beurteilen zu können, muß man nicht nur die Stadien der normalen Keimzellentwicklung, sondern auch die spontane Mutabilität möglichst genau kennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2e2a96a-1a0a-43fb-9a48-f63104921a5a",
                        "source_entry_id": "74bb9de5-df34-30b0-9b97-33f51cac0707",
