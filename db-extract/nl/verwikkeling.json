                                    }
                                ]
                            },
                            {
                                "target_word": "tangle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8481ce2-72a1-33dd-a5c0-96c7341588cf",
                                        "entry_id": "902af8b8-2e02-3f73-9153-0297ec2d6bee",
                                        "glosses": [
                                            "Any large type of seaweed, especially a species of Laminaria."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74d5b5e6-0e16-479b-acc7-18fc5ea08172",
                                                "sense_id": "d8481ce2-72a1-33dd-a5c0-96c7341588cf",
                                                "text": "[…] if with thee the roaring wells\n⁠Should gulf him fathom-deep in brine;\n⁠And hands so often clasp’d in mine,\nShould toss with tangle and with shells."
