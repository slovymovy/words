                ],
                "senses": [
                    {
                        "sense_id": "3a8bb4d8-5edc-3b69-9031-7d789dbbbbc8",
                        "entry_id": "080135d0-b03d-3f32-9e35-347b0b3e9ec9",
                        "glosses": [
                            "Wort, das scherzhaft gemeint ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcae0a9e-52da-4897-a702-31d55e33efd8",
                                "sense_id": "3a8bb4d8-5edc-3b69-9031-7d789dbbbbc8",
                                "text": "„Birne“ war längere Zeit ein geläufiges Scherzwort für den damaligen Bundeskanzler Helmut Kohl."
                            },
                            {
                                "example_id": "e66f292c-26cd-4957-a871-2d2c95538aec",
                                "sense_id": "3a8bb4d8-5edc-3b69-9031-7d789dbbbbc8",
                                "text": "„Angeblich ein missglückter Eindeutschungsversuch eines unbekannten Sprachpuristen, tatsächlich dürfte es sich bei dieser Wortschöpfung jedoch um ein Scherzwort bzw. einen Ulk handeln.“"
                            },
                            {
                                "example_id": "c6e0bc99-e006-41e7-bbe4-6225f0c17a62",
                                "sense_id": "3a8bb4d8-5edc-3b69-9031-7d789dbbbbc8",
                                "text": "„Kein Scherzwort genügte ihr.“"
                            },
                            {
                                "example_id": "20996eeb-04f2-433a-82c7-b903411c91d4",
                                "sense_id": "3a8bb4d8-5edc-3b69-9031-7d789dbbbbc8",
                                "text": "„Da sie an Scherzworten über unsere große Flasche nicht sparten, gerieten wir ins Gespräch, und bald war Paul, der sich bei dieser Gelegenheit auch als geschickter Billardspieler erwies, mit von der Partie.“"
                            },
                            {
                                "example_id": "157b90f7-74db-4381-a9cb-972606d425e5",
                                "sense_id": "3a8bb4d8-5edc-3b69-9031-7d789dbbbbc8",
                                "text": "„Derartige Scherze muss ich machen, wenn ich nicht anmaßend erscheinen will, sobald mir jemand ein Scherzwort entgegenruft und eine Antwort erwartet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
