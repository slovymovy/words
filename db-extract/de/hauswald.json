                "senses": [
                    {
                        "sense_id": "a8cde02b-dacd-32c8-b9e6-1a0b1f4cf927",
                        "entry_id": "b984cda1-378e-3579-bee4-e91af93bd70f",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b15c9126-bd05-4e71-a952-57b1f637cf34",
                                "sense_id": "a8cde02b-dacd-32c8-b9e6-1a0b1f4cf927",
                                "text": "Frau Hauswald ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6186fffa-4e41-4d47-88b4-32d9a935fb2d",
                                "sense_id": "a8cde02b-dacd-32c8-b9e6-1a0b1f4cf927",
                                "text": "Herr Hauswald wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f38ae3c3-1620-402f-af90-bde168518474",
                                "sense_id": "a8cde02b-dacd-32c8-b9e6-1a0b1f4cf927",
                                "text": "Die Hauswalds fahren heute nach Prag."
                            },
                            {
                                "example_id": "a5615311-e6c5-4c80-83be-6105619a79e7",
                                "sense_id": "a8cde02b-dacd-32c8-b9e6-1a0b1f4cf927",
                                "text": "Der Hauswald trägt nie die Schals, die die Hauswald ihm strickt."
                            },
                            {
                                "example_id": "cd7c566c-a455-4a6c-815f-fc373d36682f",
                                "sense_id": "a8cde02b-dacd-32c8-b9e6-1a0b1f4cf927",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hauswald kommt, geht der Herr Hauswald.“"
                            },
                            {
                                "example_id": "2a5dea19-3221-4e9f-a56b-c3d8c795b5a4",
                                "sense_id": "a8cde02b-dacd-32c8-b9e6-1a0b1f4cf927",
                                "text": "Hauswald kommt und geht."
                            },
                            {
                                "example_id": "908c1d0f-9cf6-4f10-83c0-9634d7bb0231",
                                "sense_id": "a8cde02b-dacd-32c8-b9e6-1a0b1f4cf927",
                                "text": "Hauswalds kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
