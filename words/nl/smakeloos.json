{
    "word_family": [
        "smaak",
        "smakelijk",
        "smaken"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0b72c9e5-edab-3348-a239-1f369f7b69c2",
                    "sense_definition": "Zonder smaak; geen smaakgewaarwording veroorzakend bij het eten of drinken.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "smaakwaarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soep was helemaal <w>smakeloos</w> omdat er geen zout in zat.",
                            "target_lang_translations": {
                                "fr": "La soupe était complètement <w>sans goût</w> parce qu'il n'y avait pas de sel dedans."
                            }
                        },
                        {
                            "text": "Deze <w>smakeloze</w> maaltijd heeft echt meer kruiden nodig.",
                            "target_lang_translations": {
                                "fr": "Ce repas <w>fade</w> a vraiment besoin de plus d'épices."
                            }
                        }
                    ],
                    "synonyms": [
                        "flauw"
                    ],
                    "antonyms": [
                        "smakelijk",
                        "pittig"
                    ],
                    "common_phrases": [
                        "smakeloze maaltijd"
                    ],
                    "target_lang_definitions": {
                        "fr": "Sans saveur ; qui ne provoque aucune sensation gustative lors de la consommation."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "sans goût",
                                "target_lang_sense_clarification": "qui n'a aucune saveur"
                            },
                            {
                                "target_lang_word": "insipide",
                                "target_lang_sense_clarification": "manquant de goût ou de saveur"
                            },
                            {
                                "target_lang_word": "fade",
                                "target_lang_sense_clarification": "qui manque de sel ou d'assaisonnement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ad2124f-a6c8-31ff-97df-6415b8546208",
                    "sense_definition": "Getuigend van een slechte stijl, gebrek aan stijl, fatsoen of gevoel voor esthetiek.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "esthetiek_en_gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij maakte een hele <w>smakeloze</w> grap tijdens het diner.",
                            "target_lang_translations": {
                                "fr": "Il a fait une blague très <w>de mauvais goût</w> pendant le dîner."
                            }
                        },
                        {
                            "text": "Die opmerking was erg <w>smakeloos</w> en niet passend.",
                            "target_lang_translations": {
                                "fr": "Cette remarque était très <w>déplacée</w> et inappropriée."
                            }
                        }
                    ],
                    "synonyms": [
                        "plat",
                        "vulgair"
                    ],
                    "antonyms": [
                        "verfijnd",
                        "modieus",
                        "trendy"
                    ],
                    "common_phrases": [
                        "smakeloze grap"
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui témoigne d'un manque de style, de savoir-vivre, de tact ou de sens esthétique."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "de mauvais goût",
                                "target_lang_sense_clarification": "qui manque de finesse, de tact ou d'élégance"
                            },
                            {
                                "target_lang_word": "déplacé",
                                "target_lang_sense_clarification": "qui convient mal à la situation, inapproprié"
                            },
                            {
                                "target_lang_word": "vulgaire",
                                "target_lang_sense_clarification": "qui manque de raffinement ou d'élégance"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}