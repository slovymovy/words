                ],
                "senses": [
                    {
                        "sense_id": "f312fe70-fc7b-3c4e-b8ae-a81d53e97f3d",
                        "entry_id": "ec7946a1-4f6b-345d-823a-b26d18731aaa",
                        "glosses": [
                            "A mine used by defenders to intercept an enemy mine or tunnel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20d822a2-da27-4a0f-a16e-e40e5e901a83",
                                "sense_id": "f312fe70-fc7b-3c4e-b8ae-a81d53e97f3d",
                                "text": "Normally the threat would have been dealt with by means of a counter-mine, but the tunnel was now far too close for that."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d3709c3-3cbf-395c-bf84-071398c888ed",
                        "entry_id": "ec7946a1-4f6b-345d-823a-b26d18731aaa",
                        "glosses": [
                            "An underground gallery excavated to intercept and destroy the mining of an enemy."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f8c17a3f-3287-3646-9d85-c12eecf1b4f2",
                        "entry_id": "ec7946a1-4f6b-345d-823a-b26d18731aaa",
                        "glosses": [
                            "A stratagem or plot by which another stratagem or project is defeated."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b521389-629f-4465-b25e-2d1fb4871d56",
                                "sense_id": "f8c17a3f-3287-3646-9d85-c12eecf1b4f2",
                                "text": "Thinking himself contemned, knowing no countermine against contempt but terror.",
                                "translation": "The New Arcadia",
                                "english": "The New Arcadia"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
