                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7a0ba88-1e39-4362-82e5-ad12d477fc18",
                        "source_entry_id": "0eea4a2b-ede1-30c3-88a1-da5983726241",
                        "source_sense_id": "39db95db-0095-3dac-83fd-cf7a87a30db4",
                        "source_sense_description": "sich auf die Vereinigten Arabischen Emirate oder einen ihrer Emirate beziehend; emiratisch",
                        "target_lang_word": "emiratisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emiratisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d18ce8b7-2124-36aa-abe1-4ec404d202fc",
                                        "entry_id": "1a3e141e-e0c2-3364-a295-a2c0ee73b45e",
                                        "glosses": [
                                            "die Vereinigten Arabischen Emirate oder ihre Einwohner betreffend, aus den Vereinigten Arabischen Emiraten kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a152b4c1-3937-4444-941a-7aa6afe6bb36",
                                                "sense_id": "d18ce8b7-2124-36aa-abe1-4ec404d202fc",
                                                "text": "„Die emiratischen Streitkräfte operieren vor allem im Süden, wo sie enge Verbindungen zu Separatisten halten, die einen eigenen südjeminitischen Staat fordern.“"
                                            },
                                            {
                                                "example_id": "b2a9d66e-aa6a-43fc-ab0b-6f4c3d5b07ce",
                                                "sense_id": "d18ce8b7-2124-36aa-abe1-4ec404d202fc",
                                                "text": "„Fortan musste die emiratische Regierung die Anwendung des klassischen islamischen Rechts nicht nur gegenüber innerstaatlichen Ausschüssen wie der GWU, sondern auch vor dem CEDAW-Komitee rechtfertigen; die nationale Familienpolitik wurde internationalisiert und der äußere Druck auf die VAE wuchs.“"
                                            },
                                            {
                                                "example_id": "086d24ee-1757-457f-a5db-dc91610b5466",
                                                "sense_id": "d18ce8b7-2124-36aa-abe1-4ec404d202fc",
                                                "text": "„So kann man beispielsweise emiratische Speisen oder Musik ergründen, durch emiratische Wohnviertel spazieren, die Corniche entlangradeln, einen Ausflug zum Perlentauchen oder ins Wathba-Vogelschutzgebiet unternehmen.“"
                                            },
                                            {
                                                "example_id": "1229aee2-4e4f-4926-a511-e7f06f2ef616",
                                                "sense_id": "d18ce8b7-2124-36aa-abe1-4ec404d202fc",
                                                "text": "„Eine andere Studie von 2006 besagt, dass unter allen neugeborenen Kindern in Dubai die Rate der Kinder, die mit Downsyndrom geboren werden, bei emiratischen Staatsangehörigen doppelt so hoch liegt wie bei Expats.“"
                                            },
                                            {
                                                "example_id": "aee9b504-66c6-40c6-b3ed-1a2cf8ec7a08",
                                                "sense_id": "d18ce8b7-2124-36aa-abe1-4ec404d202fc",
                                                "text": "„Bereits 1973 hatten die VAE ein Brautgabenbegrenzungsgesetz erlassen, wonach die Brautgabe insgesamt 10.000 emiratische Dirham (ED) nicht überschreiten durfte.“"
                                            },
                                            {
                                                "example_id": "1ea1a899-6c3c-4586-95fe-e2c6153dabdb",
                                                "sense_id": "d18ce8b7-2124-36aa-abe1-4ec404d202fc",
                                                "text": "„Die schätzungsweise 20.000 bis 100.000 in den VAE geborenen staatenlosen Personen hatten weiterhin nicht dieselben Rechte wie emiratische Staatsangehörige, die staatlich subventionierte Leistungen in Anspruch nehmen konnten, darunter Zugang zu Gesundheitsversorgung, Wohnraum und höherer Bildung.“"
                                            },
                                            {
                                                "example_id": "95db8511-ae43-48f8-9ea2-2ec3247536c7",
                                                "sense_id": "d18ce8b7-2124-36aa-abe1-4ec404d202fc",
                                                "text": "„Zudem bestehen 20 Kooperationsprojekte zwischen deutschen und emiratischen Hochschul- und Bildungseinrichtungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
