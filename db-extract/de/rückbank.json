                ],
                "senses": [
                    {
                        "sense_id": "d1bba636-1914-3ae9-98bf-993ed6cffa49",
                        "entry_id": "72303620-2796-3122-8b7e-93e001e3165f",
                        "glosses": [
                            "bankartige Sitzreihe hinter den Vordersitzen in Personenwagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ce0c60c-696c-4f32-8976-0838374167f6",
                                "sense_id": "d1bba636-1914-3ae9-98bf-993ed6cffa49",
                                "text": "„An die zwei auf der Rückbank dachte er jetzt nicht, nur an die Büffel.“"
                            },
                            {
                                "example_id": "469c6bfe-6528-487b-928e-dff5fa42d5d3",
                                "sense_id": "d1bba636-1914-3ae9-98bf-993ed6cffa49",
                                "text": "„Die Rückbank endlich teilten sich ein älteres englisches Ehepaar, ein schläfenlockiger junger Schlaks im glänzenden schwarzen Kaftan, der unentwegt telefonierte, und ich, der das alles sah.“"
                            },
                            {
                                "example_id": "a9c0c21d-b373-4e95-ad0d-7d0820df825e",
                                "sense_id": "d1bba636-1914-3ae9-98bf-993ed6cffa49",
                                "text": "„Fariba, Mamans Cousine, die meine Großmutter tot aufgefunden hat, sitzt vorne neben dem Taxifahrer, unangeschnallt, den Oberkörper uns auf der Rückbank zugewandt.“"
                            },
                            {
                                "example_id": "fe36fef7-3c36-4f29-a172-ab93f82b7a8c",
                                "sense_id": "d1bba636-1914-3ae9-98bf-993ed6cffa49",
                                "text": "„Almuth legte ihren Sonnenhut auf die Rückbank und band sich das Tuch um den Kopf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
