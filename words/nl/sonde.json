    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fdd21625-26f9-356a-87ed-c8ae3dd56ecf",
                    "sense_definition": "Een dun buisje waarmee vloeibare voeding of medicijnen rechtstreeks in de maag worden toegediend.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De patiënt kreeg voeding via een <w>sonde</w> na de zware operatie. ",
                            "target_lang_translations": {
                                "en": "The patient received nutrition via a <w>feeding tube</w> after the heavy operation."
                            }
                        },
                        {
                            "text": "De verpleegkundige controleerde of de <w>sonde</w> goed was geplaatst.",
                            "target_lang_translations": {
                                "en": "The nurse checked whether the <w>feeding tube</w> was placed correctly."
                            }
                        }
                    ],
                    "synonyms": [
                        "maagsonde"
                    ],
                    "common_phrases": [
                        "voeding via een sonde"
                    ],
                    "target_lang_definitions": {
                        "en": "A thin tube used to administer liquid nutrition or medication directly into the stomach."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "feeding tube",
                                "target_lang_sense_clarification": "medical tube for nutrition"
                            },
                            {
                                "target_lang_word": "gastric tube",
                                "target_lang_sense_clarification": "tube inserted into the stomach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8290bedd-9d2d-3e09-bf35-85123cb3a458",
                    "sense_definition": "Een instrument of dun staafje dat gebruikt wordt om de diepte, vorm of toestand van een doorgang of opening te onderzoeken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arts gebruikte een dunne <w>sonde</w> om de wond te onderzoeken. ",
                            "target_lang_translations": {
                                "en": "The doctor used a thin <w>probe</w> to examine the wound."
                            }
                        },
                        {
                            "text": "Met een metalen <w>sonde</w> kon het gat in de muur precies worden opgemeten.",
                            "target_lang_translations": {
                                "en": "With a metal <w>probe</w>, the hole in the wall could be accurately measured."
                            }
                        }
                    ],
                    "synonyms": [
                        "peilstift",
                        "peilstok",
                        "meetkop"
                    ],
                    "target_lang_definitions": {
                        "en": "An instrument or thin rod used to examine the depth, shape, or condition of a passage or opening."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "probe",
                                "target_lang_sense_clarification": "investigative medical or technical tool"
                            },
                            {
                                "target_lang_word": "sounding rod",
                                "target_lang_sense_clarification": "rod used to measure depth or shape"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5cf6744-9cfa-3c95-9d8e-3c72d953c4d1",
                    "sense_definition": "Een onbemand ruimtevaartuig dat wordt gebruikt om gegevens te verzamelen over het heelal en de planeten.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>sonde</w> stuurde prachtige foto's van de planeet Mars naar de aarde. ",
                            "target_lang_translations": {
                                "en": "The <w>probe</w> sent beautiful photos of the planet Mars to Earth."
                            }
                        },
                        {
                            "text": "Wetenschappers lanceerden een nieuwe <w>sonde</w> om de zon te bestuderen.",
                            "target_lang_translations": {
                                "en": "Scientists launched a new <w>probe</w> to study the sun."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruimtesonde"
                    ],
                    "target_lang_definitions": {
                        "en": "An uncrewed spacecraft used to gather data about space and planets."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "space probe",
                                "target_lang_sense_clarification": "uncrewed spacecraft for exploration"
                            },
                            {
                                "target_lang_word": "probe",
                                "target_lang_sense_clarification": "spacecraft"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}