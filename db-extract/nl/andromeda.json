        "nl-extract.jsonl": [
            {
                "entry_id": "a98df250-ccaa-35b6-8e39-377c1afe0452",
                "word": "Andromeda",
                "pos": "name",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "48c99be9-32e5-3111-a10f-ad5e2a2238c3",
                        "entry_id": "a98df250-ccaa-35b6-8e39-377c1afe0452",
                        "glosses": [
                            "figuur uit de Griekse en Romeinse mythologie, namelijk de dochter van de Ethiopische koning en koningin Cepheus en Cassiopeia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0902906b-bfdb-40b9-86a4-c16628fe398f",
                                "sense_id": "48c99be9-32e5-3111-a10f-ad5e2a2238c3",
                                "text": "De trouwe Andromeda is een van de personages, die door Zeus werden beloond met een plaats aan de sterrenhemel."
                            }
                        ]
                    },
                    {
                        "sense_id": "7761f67f-93d7-37d9-9122-9594044cd3ec",
                        "entry_id": "a98df250-ccaa-35b6-8e39-377c1afe0452",
                        "glosses": [
                            "sterrenbeeld noordelijk van de dierenriem naast de sterrenbeelden \\\"Perseus\\\" en \\\"Pegasus\\\", (tussen rechte klimming 22ᵘ56ᵐ en 2ᵘ36ᵐ en tussen declinatie +21° en +53°)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79de2010-72ee-4300-810e-818512a43f8d",
                                "sense_id": "7761f67f-93d7-37d9-9122-9594044cd3ec",
                                "text": "Het sterrenbeeld Andromeda is geen teken van de dierenriem en daardoor wat minder bekend."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee2a5d0a-cbab-3399-9acb-1cca5e65b8b6",
                        "entry_id": "a98df250-ccaa-35b6-8e39-377c1afe0452",
                        "glosses": [
                            "spiraalvormig extragalactisch sterrenstelsel (melkwegstelsel) in het gelijknamige sterrenbeeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5ae389e-66ef-4d4e-acbd-cab64ab3ec3b",
                                "sense_id": "ee2a5d0a-cbab-3399-9acb-1cca5e65b8b6",
                                "text": "De Andromedanevel is het meest nabije melkwegstelsel en het enige dat met het blote oog waarneembaar is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad30e4eb-e4d2-4351-b5d2-88fa7a9c61ee",
                        "source_entry_id": "a98df250-ccaa-35b6-8e39-377c1afe0452",
                        "source_sense_id": "48c99be9-32e5-3111-a10f-ad5e2a2238c3",
                        "source_sense_description": "mythologische figuur",
                        "target_lang_word": "Andromeda",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Andromeda",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75a0d3ad-6031-3a1e-b9c3-79259f174e7a",
                                        "entry_id": "e7b4a437-62b0-30d0-aafb-b45747db66b6",
                                        "glosses": [
                                            "griechische Sagengestalt, Tochter des äthiopischen Königs Kepheus und der Kassiopeia, die durch Perseus vor einem Ungeheuer gerettet wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ce34c61-b875-4a5c-9e0f-d4e778102aa2",
                                                "sense_id": "75a0d3ad-6031-3a1e-b9c3-79259f174e7a",
                                                "text": "Ohne Hindernis führt jetzt Perseus seine Geliebte, Andromeda, heim. - (Gustav Schwab, „Das Buch der schönsten Geschichten und Sagen“)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Andromeda",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd638da0-ae32-3ff6-bee0-6977c688d916",
                                        "entry_id": "39e26306-d72a-3f0e-af76-2e6644333332",
                                        "glosses": [
                                            "ein Sternbild"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "122bdc07-e2fd-49cc-91a7-ca94fdbc76be",
                                                "sense_id": "cd638da0-ae32-3ff6-bee0-6977c688d916",
                                                "text": "In der Andromeda liegen mehrere auffällige Galaxien."
                                            },
                                            {
                                                "example_id": "36089efa-e335-4699-9480-8339f9e1ec37",
                                                "sense_id": "cd638da0-ae32-3ff6-bee0-6977c688d916",
                                                "text": "„Zu sagen, der Mensch erobere jetzt den Weltraum, ist nichts als eine Illusion. Mit der Geschwindigkeit von 40000 km/Std., die unsere »Raumschiffe« zwischen Erde und Mond derzeit erreichen, würde eine Reise zum rund 4 Lichtjahre entfernten sonnennächsten Fixstern über 100000 Jahre dauern. Die Zeit, die erforderlich ist, um mit dieser Geschwindigkeit dasjenige unserer Milchstraße vergleichbare Sternsystem, das uns im Weltraum am nächsten liegt, zu erreichen (Spiralsystem im Sternbild Andromeda, rund 2 Millionen Lichtjahre entfernt), ist etwa 10mal so lang wie die Zeitspanne, die seit der Entstehung unseres Sonnensystems verflossen ist, nämlich 60 Milliarden Jahre! Es ist also berechtigt, zu sagen, daß kein Sterblicher jemals die Tiefe des Weltraums betreten oder befahren wird. …“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16e61cd5-ff75-477a-b2fb-881b3e422f6a",
                        "source_entry_id": "a98df250-ccaa-35b6-8e39-377c1afe0452",
                        "source_sense_id": "48c99be9-32e5-3111-a10f-ad5e2a2238c3",
                        "source_sense_description": "mythologische figuur",
                        "target_lang_word": "Andromeda",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Andromeda",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca2f1bfe-3542-3d5d-a811-3eccb0479ef7",
                                        "entry_id": "f1433dda-142e-3776-b4dd-632d7d94f932",
                                        "glosses": [
                                            "The daughter of Cepheus and Cassiopeia, king and queen of Eritrea, rescued from her sacrifice to the sea monster Cetus by Perseus, who married her; mother of Perses, ancient king of Persia."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6152c1f9-b242-3783-ab8c-60bcc138c5f9",
                                        "entry_id": "f1433dda-142e-3776-b4dd-632d7d94f932",
                                        "glosses": [
                                            "A constellation of the northern sky representing the \\\"chained woman\\\" Andromeda in Greek mythology, which is surrounded by the constellations of Cassiopeia, Perseus, and Pegasus, among others."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4344cc20-de12-3042-8724-a44f9d98f272",
                                        "entry_id": "f1433dda-142e-3776-b4dd-632d7d94f932",
                                        "glosses": [
                                            "The nearest spiral galaxy to the Milky Way, located within the Andromeda constellation (see Andromeda Galaxy); M31."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "969dcceb-6211-40e9-812c-1787d6566a55",
                                                "sense_id": "4344cc20-de12-3042-8724-a44f9d98f272",
                                                "text": "The Milky Way once had a massive galactic sibling that was shredded and consumed by our closest neighbour, Andromeda, scientists have discovered."
                                            },
                                            {
                                                "example_id": "d687c1bc-4b51-4ad3-8c28-204e6761e231",
                                                "sense_id": "4344cc20-de12-3042-8724-a44f9d98f272",
                                                "text": "Andromeda is a large, spiral galaxy like the Milky Way. It's between two and three million light years away. On a clear night in a dark place, you can see Andromeda with the naked eye."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2acaf96-d76f-464c-897e-75b5fde70112",
                        "source_entry_id": "a98df250-ccaa-35b6-8e39-377c1afe0452",
                        "source_sense_id": "48c99be9-32e5-3111-a10f-ad5e2a2238c3",
                        "source_sense_description": "mythologische figuur",
                        "target_lang_word": "Andromède",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Andromède",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6529125-af81-3385-9486-707419791020",
                                        "entry_id": "6bc64e3f-f1d5-30d4-9ea5-8bfc1b5e2a95",
                                        "glosses": [
                                            "Fille de Céphée et femme de Persée, que la fable disait avoir été transportée au ciel."
                                        ],
                                        "tags": [
                                            "Anthroponyme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90b52758-9092-40f4-938e-5e5e6e119850",
                                                "sense_id": "c6529125-af81-3385-9486-707419791020",
                                                "text": "Et tous, le shérif, le surveillant, le juge et le commodore étaient autour d’elle comme ces monstres obscènes qui sortaient de la mer pour dévorer Andromède."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c969aae-8f06-3d7c-a35c-4cf1e0f43240",
                                        "entry_id": "6bc64e3f-f1d5-30d4-9ea5-8bfc1b5e2a95",
                                        "glosses": [
                                            "Constellation du ciel boréal, bordée par Cassiopée, le Lézard, Pégase, les Poissons, le Triangle et Persée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "effd5818-79ea-4e2d-9328-ab4fad0a3d2d",
                                                "sense_id": "6c969aae-8f06-3d7c-a35c-4cf1e0f43240",
                                                "text": "Plus la [Grande] Comète [de 1556] approchoit de Saturne, plus son mouvement se ralentissoit : Saturne étoit alors sous le Poisson boréal, dans le signe du Bélier ; la Comète le joignit, après s’être arrêtée quelque temps dans les chaînes d’Andromède."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3c84460-e140-3b09-b204-d5fce9906509",
                                        "entry_id": "6bc64e3f-f1d5-30d4-9ea5-8bfc1b5e2a95",
                                        "glosses": [
                                            "La galaxie d’Andromède (M31)."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a93fa16-700d-4961-9e5d-9bb8a7ebba36",
                                                "sense_id": "b3c84460-e140-3b09-b204-d5fce9906509",
                                                "text": "Il reconnut Andromède, notre galaxie voisine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
