                        ],
                        "examples": [
                            {
                                "example_id": "d7da4ec4-1807-4f67-babb-3f8983cb3817",
                                "sense_id": "fd7da481-5ddd-3033-b961-ae7665063a54",
                                "text": "Leicester could only manage a goalless draw midweek with Sutton Coldfield and will be keen to return to winning form."
                            }
                        ]
                    }
                ],
