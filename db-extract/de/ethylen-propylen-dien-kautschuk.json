                ],
                "senses": [
                    {
                        "sense_id": "6dc3486d-9769-3112-9b56-a3e6eb10e778",
                        "entry_id": "397430dd-9595-34b6-a371-2306c422d5af",
                        "glosses": [
                            "Synthesekautschuk mit gesättigter Hauptkette"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dface2f-324b-4a95-85fc-539d2fe9e920",
                                "sense_id": "6dc3486d-9769-3112-9b56-a3e6eb10e778",
                                "text": "„Sowohl in der Automobilindustrie als auch in der Baubranche ist Ethylen-Propylen-Dien-Kautschuk der mengenmäßig am meisten eingesetzte Werkstoff für Dichtungen.“"
                            },
                            {
                                "example_id": "9b042d57-372d-4674-935e-749de65c4517",
                                "sense_id": "6dc3486d-9769-3112-9b56-a3e6eb10e778",
                                "text": "„Von diesen Halogeniden sind jedoch nur die Chloride Vanadium(IV)-chlorid und Vanadium(III)-chlorid technisch relevant. Sie dienen unter anderem als Katalysator für die Herstellung von Ethylen-Propylen-Dien-Kautschuk.“"
                            },
                            {
                                "example_id": "372a167c-569d-4468-b922-3444a4c48e91",
                                "sense_id": "6dc3486d-9769-3112-9b56-a3e6eb10e778",
                                "text": "„Ethylen-Propylen-Dien-Kautschuk (EPDM) ist ein Terpolymerisat aus Ethylen, Propylen und einem Dien.“"
                            },
                            {
                                "example_id": "b412c286-7816-40bf-b12d-42b1bfb619fa",
                                "sense_id": "6dc3486d-9769-3112-9b56-a3e6eb10e778",
                                "text": "„Ethylen-Propylen-Dien-Kautschuk (Kurzzeichen EPDM, Ethylen-Propylen-Dien) ist ein terpolymeres Elastomer (Gummi) und somit ein synthetischer Kautschuk […].“"
                            },
                            {
                                "example_id": "5b5b64fe-0e36-4482-a422-27c759920255",
                                "sense_id": "6dc3486d-9769-3112-9b56-a3e6eb10e778",
                                "text": "„Ethylen-Propylen-Dien-Kautschuk (EPDM) ist ein amorphes Terpolymer, welches eine unpolare, gesättigte Hauptkette enthält […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
