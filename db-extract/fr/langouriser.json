                "senses": [
                    {
                        "sense_id": "a929c621-0305-3194-95a4-573c86b103df",
                        "entry_id": "e546c08c-99c1-38bf-8672-2703f75d43c8",
                        "glosses": [
                            "Donner un caractère langoureux à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a1f5806-c458-4838-ac61-2160f7db08d0",
                                "sense_id": "a929c621-0305-3194-95a4-573c86b103df",
                                "text": "Rigoureux mais jamais austère, toujours humble mais souvent cabot, assis sagement à son piano ou emporté dans un délire marionnettiste, heureux d’avoir poussé ses complices «classiques» à «langouriser» leurs violons ou à «kitchiser» le saxophone, Sheller, au milieu des siens, se révèle un véritable monsieur Loyal, dans une complicité rare avec son public."
                            },
                            {
                                "example_id": "05cccbc9-33da-4986-92c5-a0235a9e212f",
                                "sense_id": "a929c621-0305-3194-95a4-573c86b103df",
                                "text": "Ca langourise, ça chaloupe, ça avance une vague main, ça ricane conjointement."
                            },
                            {
                                "example_id": "5d175cb8-29de-48a5-abbb-37951836fab4",
                                "sense_id": "a929c621-0305-3194-95a4-573c86b103df",
                                "text": "Au diable la tristesse, et, lorsqu'on rimaille, Cet enragé démon qui toujours vous travaille D'une insipide ardeur de se langouriser, Et de vouloir partout sentimentaliser !"
                            }
                        ]
                    }
                ],
