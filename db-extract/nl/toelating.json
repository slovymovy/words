                                "target_senses": [
                                    {
                                        "sense_id": "c1a34772-04a8-34e4-84ed-00e8e03e8cc7",
                                        "entry_id": "a0f86122-34f9-3fad-89a2-555bfaca5b22",
                                        "glosses": [
                                            "The action of entering, or going in."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22328e1e-a8ab-4b89-9a1e-b0c01aab7a77",
                                                "sense_id": "c1a34772-04a8-34e4-84ed-00e8e03e8cc7",
                                                "text": "make a grand entrance"
                                            },
                                            {
                                                "example_id": "46045862-0639-420b-a512-5e9357ac31c9",
                                                "sense_id": "c1a34772-04a8-34e4-84ed-00e8e03e8cc7",
                                                "text": "Her entrance attracted no attention whatsoever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a1b868a-9760-3973-b2cb-b6ba11c30e08",
                                        "entry_id": "a0f86122-34f9-3fad-89a2-555bfaca5b22",
                                        "glosses": [
                                            "The act of taking possession, as of property, or of office."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23362e6f-23c6-41c1-8379-3e1afed154b7",
                                                "sense_id": "8a1b868a-9760-3973-b2cb-b6ba11c30e08",
                                                "text": "the entrance of an heir upon his inheritance, or of a magistrate into office"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e06c94dd-0dae-3e14-92fe-6d6d89245e3d",
                                        "entry_id": "a0f86122-34f9-3fad-89a2-555bfaca5b22",
                                        "glosses": [
                                            "The place of entering, as a gate or doorway."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f83626a0-3aeb-4443-a430-115d0db31737",
                                                "sense_id": "e06c94dd-0dae-3e14-92fe-6d6d89245e3d",
                                                "text": "‘It was called the wickedest street in London and the entrance was just here. I imagine the mouth of the road lay between this lamp standard and the second from the next down there.’"
                                            },
                                            {
                                                "example_id": "099a43d7-49d7-4b5c-9259-ff9f30c8c3ff",
                                                "sense_id": "e06c94dd-0dae-3e14-92fe-6d6d89245e3d",
                                                "text": "Place your bag by the entrance so that you can find it easily."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e052ccb3-cf8e-34fe-a39e-4b337dc49b43",
                                        "entry_id": "a0f86122-34f9-3fad-89a2-555bfaca5b22",
                                        "glosses": [
                                            "The right to go in."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63074afa-ee84-4cbe-8ab0-b61e6adb7ec2",
                                                "sense_id": "e052ccb3-cf8e-34fe-a39e-4b337dc49b43",
                                                "text": "You'll need a ticket to gain entrance to the museum."
                                            },
                                            {
                                                "example_id": "22efba82-9154-4b23-a166-9e4f7ea1e974",
                                                "sense_id": "e052ccb3-cf8e-34fe-a39e-4b337dc49b43",
                                                "text": "to give entrance to friends"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d2fd801-5218-33dd-ac88-9022c74739c0",
                                        "entry_id": "a0f86122-34f9-3fad-89a2-555bfaca5b22",
                                        "glosses": [
                                            "The entering upon; the beginning, or that with which the beginning is made; the commencement; initiation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3f482f4-e940-463c-a473-d2f19b678548",
                                                "sense_id": "2d2fd801-5218-33dd-ac88-9022c74739c0",
                                                "text": "a difficult entrance into business"
                                            },
                                            {
                                                "example_id": "2cb91331-1feb-4742-8dc1-1fdb77450286",
                                                "sense_id": "2d2fd801-5218-33dd-ac88-9022c74739c0",
                                                "text": "Beware of entrance to a quarrel."
                                            },
                                            {
                                                "example_id": "72373369-f83a-4ecd-9fcb-fd48e2cee19e",
                                                "sense_id": "2d2fd801-5218-33dd-ac88-9022c74739c0",
                                                "text": "in the entrance of the history of this great patriarch"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df416a2a-fcb1-30c3-b3d7-3b9cd4892c32",
                                        "entry_id": "a0f86122-34f9-3fad-89a2-555bfaca5b22",
                                        "glosses": [
                                            "The causing to be entered upon a register, as a ship or goods, at a customhouse; an entering."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9951e3b-81c7-43c4-8a04-dacfca979688",
                                                "sense_id": "df416a2a-fcb1-30c3-b3d7-3b9cd4892c32",
                                                "text": "His entrance of the arrival was made the same day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55ce38d7-8f02-39b3-98df-26005c264b18",
                                        "entry_id": "a0f86122-34f9-3fad-89a2-555bfaca5b22",
                                        "glosses": [
                                            "The angle which the bow of a vessel makes with the water at the water line."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d0636f1-4fa4-481f-84bd-f6a53e8a5846",
                                                "sense_id": "55ce38d7-8f02-39b3-98df-26005c264b18",
                                                "text": "A coarse-lined ship, fig. 4, has an angle of entrance of about 40 deg., measured at the load-water line; while a fine-lined ship has only about half that angle."
                                            },
                                            {
                                                "example_id": "bb47bf01-109d-49f4-ac3e-19793cad7e29",
                                                "sense_id": "55ce38d7-8f02-39b3-98df-26005c264b18",
                                                "text": "At low , say 9 knots for a 400-ft. ship, 60 deg. entrance angle (side to side) can be accepted."
                                            },
                                            {
                                                "example_id": "935c3ff3-0c2e-456b-b199-ce3fddfffb16",
                                                "sense_id": "55ce38d7-8f02-39b3-98df-26005c264b18",
                                                "text": "This bulb therefore creates a greater wave but has a higher form resistance as the waterlines have larger entrance angles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d761a2d-c821-34b9-93cc-c8b194d19a5c",
                                        "entry_id": "a0f86122-34f9-3fad-89a2-555bfaca5b22",
                                        "glosses": [
                                            "The bow, or entire wedgelike forepart of a vessel, below the water line."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e23826d-df8e-4065-9684-6a19b456b711",
                                                "sense_id": "6d761a2d-c821-34b9-93cc-c8b194d19a5c",
                                                "text": "She [the Albemarle] has a bold entrance, and clean run."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd95538e-8305-324a-a1d1-8bf11952cba1",
                                        "entry_id": "a0f86122-34f9-3fad-89a2-555bfaca5b22",
                                        "glosses": [
                                            "The beginning of a musician's playing or singing; entry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
