                        "form": "die Präsupposition"
                    },
                    {
                        "form_id": "02fadd8b-430f-4f81-abcd-bfc479a199e9",
                        "entry_id": "7141a9de-99be-3a71-bc88-0bbcb0b80359",
                        "tags": [
                            "accusative",
