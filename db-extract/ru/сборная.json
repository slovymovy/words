                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8acb213-4529-3fd5-8dcd-16ee64e54f40",
                                        "entry_id": "54454844-69ab-3993-a958-72e18ad4dc07",
                                        "glosses": [
                                            "Groupe de travailleurs attachés à un travail spécial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b4feaa5-4ee6-4df7-b404-a31b7ed6d910",
                                                "sense_id": "d8acb213-4529-3fd5-8dcd-16ee64e54f40",
                                                "text": "Dévoiler la Joconde ? C'est l'objectif lascif d'une équipe scientifique, associée au Louvre pour percer le mystère du sfumato, qui a fait la célébrité de Léonard de Vinci."
                                            },
                                            {
                                                "example_id": "ac005980-74a3-44db-97f7-24b08badb61c",
                                                "sense_id": "d8acb213-4529-3fd5-8dcd-16ee64e54f40",
                                                "text": "Composer une équipe."
                                            },
                                            {
                                                "example_id": "88e2bde7-4acb-4ca3-b769-a1507316a343",
                                                "sense_id": "d8acb213-4529-3fd5-8dcd-16ee64e54f40",
                                                "text": "Chef d’équipe."
                                            },
                                            {
                                                "example_id": "14a67cdd-d9e0-4d37-ade4-135784ff3d4f",
                                                "sense_id": "d8acb213-4529-3fd5-8dcd-16ee64e54f40",
                                                "text": "Équipe de jour, de nuit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2671c1f-ba04-3623-bcf3-147ab6ca1154",
                                        "entry_id": "54454844-69ab-3993-a958-72e18ad4dc07",
                                        "glosses": [
                                            "Série de bateaux amarrés les uns aux autres, allant à la voile ou traînés par des hommes le long d’une rivière."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc6507bd-7f3e-3a6d-9d51-c9b8e7db7a04",
                                        "entry_id": "54454844-69ab-3993-a958-72e18ad4dc07",
                                        "glosses": [
                                            "Équipage d’un bateau, d’un canot de plaisance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e0a998c-6358-379a-87d6-f2f9d079d9b8",
                                        "entry_id": "54454844-69ab-3993-a958-72e18ad4dc07",
                                        "glosses": [
                                            "Ensemble de joueurs divisés en camps rivaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f901b57-2829-4ebf-8832-1737ffc4cd4d",
                                                "sense_id": "6e0a998c-6358-379a-87d6-f2f9d079d9b8",
                                                "text": "La Canasta peut réunir de deux à six joueurs ; mais elle est surtout passionnante quand elle peut être pratiquée par deux équipes de deux joueurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f1997b3-1f65-3197-b87f-85a6ce5516da",
                                        "entry_id": "54454844-69ab-3993-a958-72e18ad4dc07",
                                        "glosses": [
                                            "Groupe de sportifs qui agissent de concert pour une victoire commune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1501a15b-8268-4c32-a5c7-01f7118d77d8",
                                                "sense_id": "2f1997b3-1f65-3197-b87f-85a6ce5516da",
                                                "text": "Des études ont montré, par exemple, que les supporters d'une équipe de football qui perd voient leur niveau de testostérone chuter, contrairement à celui des supporters de l’équipe vainqueure, dont le taux de testostérone augmente (sachant que les niveaux étaient comparables avant le match)."
                                            },
                                            {
                                                "example_id": "5225bba3-4177-4df3-8e87-2c0c4ccd02ce",
                                                "sense_id": "2f1997b3-1f65-3197-b87f-85a6ce5516da",
                                                "text": "Le directeur sportif s’était réjoui de découvrir en Kimball un joueur de lacrosse prêt à entraîner l’équipe. Il était rapidement devenu l'entraîneur en chef de l’équipe féminine."
                                            },
                                            {
                                                "example_id": "6b6a8d6a-9cb4-4ffa-a591-52d8eeb26b08",
                                                "sense_id": "2f1997b3-1f65-3197-b87f-85a6ce5516da",
                                                "text": "— C'est l’équipe du Brésil, ça ?\n— Oui, c'est l’équipe du Brésil.\n— Ils sont super, hein ?\n— Oui, ils sont super.\n— Bon, eh ben salut, alors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2beefcaf-b65b-35bf-8848-aa9a9a478b39",
                                        "entry_id": "54454844-69ab-3993-a958-72e18ad4dc07",
                                        "glosses": [
                                            "Petit groupe de soldats, de même rang et souvent de compétences complémentaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
