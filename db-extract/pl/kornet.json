                                        "entry_id": "1d381378-9152-3694-98f6-20ae64dd9667",
                                        "glosses": [
                                            "The fifth commissioned officer in a cavalry troop, who carried the colours (equivalent to the ensign in infantry)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "feddc1ae-4430-4833-b738-00d1c7dcf37f",
                                                "sense_id": "dc9e71d9-c168-3c8a-b422-011436c63ca3",
                                                "text": "No general would have sent a mere cornet in command of five hundred horse: Fairfax despatched a colonel to take charge as soon as he heard what had happened."
                                            },
                                            {
                                                "example_id": "e3738eff-89a1-4459-91e7-41ed61382c8a",
                                                "sense_id": "dc9e71d9-c168-3c8a-b422-011436c63ca3",
                                                "text": "This cornet [translating Cornet] was a brave young cavalier and not more than two years older than me."
                                            }
                                        ]
                                    }
                                ]
                            }
