                "senses": [
                    {
                        "sense_id": "e61fc93f-898d-37d8-9da4-9694296dda8d",
                        "entry_id": "792a8ad3-f0b7-30e0-935d-bdd8f083471b",
                        "glosses": [
                            "A sheep of a Spanish breed with long, fine hair."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0c8c164a-72a3-3097-a3df-e85df534c71c",
                        "entry_id": "792a8ad3-f0b7-30e0-935d-bdd8f083471b",
                        "glosses": [
                            "The wool of this sheep."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "84299475-ff00-3b39-85f9-54acb73835d2",
                        "entry_id": "792a8ad3-f0b7-30e0-935d-bdd8f083471b",
                        "glosses": [
                            "The fabric made from this wool (or from any similar yarn)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3f3989a3-3d06-45a0-a1de-216d8cfb5534",
                                "sense_id": "84299475-ff00-3b39-85f9-54acb73835d2",
                                "text": "The Priest pulled the light merino carriage rug higher about his knees."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a7db6a4-d9d4-322d-922a-f7ffad77ac99",
                        "entry_id": "792a8ad3-f0b7-30e0-935d-bdd8f083471b",
                        "glosses": [
                            "A dress made out of merino fabric."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f086caf5-05fd-419c-89b9-62c4c6c87aee",
                                "sense_id": "6a7db6a4-d9d4-322d-922a-f7ffad77ac99",
                                "text": "\"Oh, mamma,\" cried Georgiana, and the speech was heroic for her who dearly loved dress, \"I would rather wear my merino, and then I should keep Isabella in countenance.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "ca3905bd-01ec-34da-bee5-0014b0448d6d",
                        "entry_id": "792a8ad3-f0b7-30e0-935d-bdd8f083471b",
                        "glosses": [
                            "A yarn made from a combination of wool and cotton in imitation of this wool."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60c0fb4a-e419-46fb-b245-d68dcdd816b8",
                        "source_entry_id": "792a8ad3-f0b7-30e0-935d-bdd8f083471b",
                        "source_sense_description": "sheep",
                        "target_lang_word": "mérinos",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mérinos",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7aeef53b-f1c9-3d69-b373-9a0f335fd516",
                                        "entry_id": "ff481418-e9f2-3dc7-826d-0a439eba820c",
                                        "glosses": [
                                            "Race de mouton d’origine nord-africaine puis espagnole dont la toison est épaisse et dont la laine est très fine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5463c6a-f0e5-4057-aa5c-7bf6c6a7545b",
                                                "sense_id": "7aeef53b-f1c9-3d69-b373-9a0f335fd516",
                                                "text": "[…], les moutons sont l’objet de toute la sollicitude des cultivateurs, et l’on y voit de grands troupeaux de mérinos, remarquables par leur bonne conformation et l’abondance et la finesse de leurs toisons qui sont livrées aux fabriques de Reims et de Rethel."
                                            },
                                            {
                                                "example_id": "e8ee14ad-a841-4399-b9fa-340390680e0f",
                                                "sense_id": "7aeef53b-f1c9-3d69-b373-9a0f335fd516",
                                                "text": "— Nous reconnaissons que d’une laine mérinos à une laine commune, le toucher diffère sensiblement."
                                            },
                                            {
                                                "example_id": "9a231d3d-fdda-4950-83f5-e709a658fddc",
                                                "sense_id": "7aeef53b-f1c9-3d69-b373-9a0f335fd516",
                                                "text": "De beaux nuages semblables à des mérinos blancs voyageaient avec lenteur. Le soleil brillait très haut ; l’heure était éclatante et douce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d25cbe03-1b99-32eb-b1e8-782557619f5f",
                                        "entry_id": "ff481418-e9f2-3dc7-826d-0a439eba820c",
                                        "glosses": [
                                            "Textile naturel. Laine fine, ondulée et longue issue de la tonte des moutons de race mérinos."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b57ff97f-20ab-4119-bea8-62d086aacf12",
                                                "sense_id": "d25cbe03-1b99-32eb-b1e8-782557619f5f",
                                                "text": "Cette vieille fille portait une robe de mérinos, couleur raisin de Corinthe, dont la coupe et les lisérés dataient de la Restauration, une collerette brodée qui pouvait valoir trois francs, un chapeau de paille cousue à coques de satin bleu bordées de paille comme on en voit aux revendeuses de la halle."
                                            },
                                            {
                                                "example_id": "14a274dc-ae34-4e00-879c-0531342c84ae",
                                                "sense_id": "d25cbe03-1b99-32eb-b1e8-782557619f5f",
                                                "text": "Certainement mon paletot de lasting vert et mon pantalon en mérinos écossais sont très-jolis ; mais c’est trop printanier, et bon pour habiter sous l’équateur"
                                            },
                                            {
                                                "example_id": "fb8a8145-df75-4360-86df-dbb384a33e00",
                                                "sense_id": "d25cbe03-1b99-32eb-b1e8-782557619f5f",
                                                "text": "Liane s’était contentée d’un simple peignoir de mérinos grisâtre avec devantiau (tablier) noir, fichu à grands ramages, et ce gracieux petit bonnet rond qui s’appelle une canipette."
                                            },
                                            {
                                                "example_id": "70815a94-025f-409c-ba04-41022b3ccf96",
                                                "sense_id": "d25cbe03-1b99-32eb-b1e8-782557619f5f",
                                                "text": "Cela partait de haut, des pièces de lainage et de draperie, mérinos, cheviottes, molletons, tombaient de l’entresol."
                                            },
                                            {
                                                "example_id": "33dfaaea-5a17-4bb8-b6ba-4e5c75a56f62",
                                                "sense_id": "d25cbe03-1b99-32eb-b1e8-782557619f5f",
                                                "text": "Je la rencontrai quelques jours plus tard devant la poste ; les fleurs de son chapeau étaient fanées, sa robe de mérinos noir avait des reflets roux, ses gants étaient blanchis au bout des doigts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27657423-57c8-4695-9fdb-896d524e56de",
                        "source_entry_id": "792a8ad3-f0b7-30e0-935d-bdd8f083471b",
                        "source_sense_description": "sheep",
                        "target_lang_word": "мерино́с",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мерино́с",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5a9d93b7-ca03-3877-9c2b-9712e0cbe33a",
                                        "entry_id": "16fea8e2-7b40-3d92-9ea5-c92d478694a3",
                                        "glosses": [
                                            "тонкорунная овца испанской породы с тонкой и мягкой шерстью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0098b6e7-b75d-43cf-8cbb-32e6d67ed48f",
                                                "sense_id": "5a9d93b7-ca03-3877-9c2b-9712e0cbe33a",
                                                "text": "Покрывающее плиту сукно было соткано из руна ставропольских мериносов, рекордсменов по длине шерсти; через несколько лет, во время первой Всесоюзной сельскохозяйственной выставки, их наградят специальной медалью именно за этот показатель."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbf8f302-9438-37dd-a6c7-0ea14402a506",
                                        "entry_id": "16fea8e2-7b40-3d92-9ea5-c92d478694a3",
                                        "glosses": [
                                            "шерсть этой овцы"
                                        ],
                                        "tags": [
                                            "только ед."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ee71262-4d32-4fc6-88d8-6cea9618dba9",
                                                "sense_id": "fbf8f302-9438-37dd-a6c7-0ea14402a506",
                                                "text": "<...> она день-деньской суетилась, полоскалась и при всем том находила время приводить в порядок белье Чемезова и приступить, для себя собственно, к шитью платья из серого мериноса, который ухитрилась купить за полцены."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a91656c-f7f9-3e28-ba33-4f81128076f2",
                                        "entry_id": "16fea8e2-7b40-3d92-9ea5-c92d478694a3",
                                        "glosses": [
                                            "ткань или изделие из такой шерсти"
                                        ],
                                        "tags": [
                                            "только ед."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "331f3d55-27cd-44b9-9b6d-7272fe0aa8bb",
                                                "sense_id": "0a91656c-f7f9-3e28-ba33-4f81128076f2",
                                                "text": "Ткани высококачественные, только натуральные: альпака, меринос, кашемир высшего качества."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
