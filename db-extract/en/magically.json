                                        "sense_id": "515b23ea-a168-32a1-a3bc-6fb86f96ca07",
                                        "entry_id": "541015d5-3a25-3cac-9d41-c7499a0d3b4b",
                                        "glosses": [
                                            "unvorstellbar groß, außergewöhnlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2689eebf-94ac-463e-b8f8-1dd438b08013",
                                                "sense_id": "515b23ea-a168-32a1-a3bc-6fb86f96ca07",
                                                "text": "„Mugabe ließ es zu, dass seine engsten Vertrauten innerhalb weniger Jahre märchenhaft reich wurden.“"
                                            }
