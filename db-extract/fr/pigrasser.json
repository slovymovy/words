                ],
                "senses": [
                    {
                        "sense_id": "6ca62b4c-94c4-3024-8841-1e9c2da9b61d",
                        "entry_id": "58221b0f-cf57-38a1-ad8e-140fae05ce55",
                        "glosses": [
                            "Jouer avec sa nourriture sans vraiment manger, ou encore en mangeant de façon très sélective."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "cacbd5d3-7c33-4ab6-8897-83e40b2e73e6",
                                "sense_id": "6ca62b4c-94c4-3024-8841-1e9c2da9b61d",
                                "text": "[…] et c'est sous la longue chevelure rousse que s'est laissé emprisonner la jument de la nuit, j'entends ses gros sabots ferrés qui pigrassent dans la matière grise, floc et floc et floc que ça fait sous les parois du crâne […]."
                            },
                            {
                                "example_id": "08c57a83-399b-430e-9270-42f7adaa5b14",
                                "sense_id": "6ca62b4c-94c4-3024-8841-1e9c2da9b61d",
                                "text": "Le matin, Moutarde était toujours le premier de la maisonnée à se lever. Il pigrassait dans les rognons froids laissés sur les tables la veille par les clients, puis il partait à la crique du Diable quérir de l'eau pour la journée."
                            },
                            {
                                "example_id": "ffb73f5e-5a64-4409-8303-a1820e02331e",
                                "sense_id": "6ca62b4c-94c4-3024-8841-1e9c2da9b61d",
                                "text": "Le gouverneur pigrassait à deux doigts dans le glaçage du gâteau."
                            }
                        ]
                    },
                    {
                        "sense_id": "78bb07b6-6e0b-3e13-898e-2eb511bcca49",
                        "entry_id": "58221b0f-cf57-38a1-ad8e-140fae05ce55",
                        "glosses": [
                            "Faire de petites choses sans but particulier, pour passer le temps."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
