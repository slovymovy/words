                                ]
                            },
                            {
                                "target_word": "uplift",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6404436a-9e71-3374-9d4b-9d3deac9dd2a",
                                        "entry_id": "332e3303-78f6-35e7-b3af-2f961f9fd770",
                                        "glosses": [
                                            "The act or result of uplifting (in various senses)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74076e6f-9df5-4734-a8f9-5baa54c4717b",
                                                "sense_id": "6404436a-9e71-3374-9d4b-9d3deac9dd2a",
                                                "text": "The EMR Regional timetable improvements also include a significant uplift in Sunday services."
                                            },
                                            {
                                                "example_id": "f5416a28-d6a5-48ab-82ee-9fbc56b9dc29",
                                                "sense_id": "6404436a-9e71-3374-9d4b-9d3deac9dd2a",
                                                "text": "This means that while initial funding will come from the public purse, landowners along the route will eventually pay back a share of the uplift in land values created by the new line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "267f36d7-92cd-3dee-b12f-5f7db0f443d5",
                                        "entry_id": "332e3303-78f6-35e7-b3af-2f961f9fd770",
                                        "glosses": [
                                            "A tectonic upheaval, especially one that takes place in the process of mountain building."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a636f60-8454-4988-8af6-093ca0c7c4fd",
                                                "sense_id": "267f36d7-92cd-3dee-b12f-5f7db0f443d5",
                                                "text": "Recent uplift of the Maine and Oregon coasts has not been enough to \"undrown\" the larger valleys; the shorelines are still submergent."
                                            },
                                            {
                                                "example_id": "3ae10884-6664-4d04-a9e3-f2a2f15aa46e",
                                                "sense_id": "267f36d7-92cd-3dee-b12f-5f7db0f443d5",
                                                "text": "This is explained as an uplift in the coast at a rate of 16.2 mm/y in the period before 1900, a downlift of 2.8 mm/y in the period 1900-1906 and a rapid «sinking» of the coast at 22.7 mm/y in the 24 months before the earthquake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60f589bb-c5ea-3f79-a862-70cc4aaf5061",
                                        "entry_id": "332e3303-78f6-35e7-b3af-2f961f9fd770",
                                        "glosses": [
                                            "The picking up and loading of goods to be transported by a mover."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9c7d68f-bc03-3acd-91b4-036ee1b915f8",
                                        "entry_id": "332e3303-78f6-35e7-b3af-2f961f9fd770",
                                        "glosses": [
                                            "A brassiere that raises the breasts."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "935d9e09-da07-4e53-9959-e3414566ef1d",
                                                "sense_id": "f9c7d68f-bc03-3acd-91b4-036ee1b915f8",
                                                "text": "Dressed in a light silk brassiere and scanties, which was all she wore under her frock, she was unkind enough to say, \"I think those uplift fakes of yours are a mistake, Sadie dear. They raise false expectations in the amorous male.\" \"But my breasts are all right,\" said Sadie, hurt, and pushing her breasts up from under to prove they were in the right place[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a72f52e4-a2d1-39f0-a73a-1fe53772bd75",
                                        "entry_id": "332e3303-78f6-35e7-b3af-2f961f9fd770",
                                        "glosses": [
                                            "An increase in a fine or penalty due to aggravating circumstances."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19b6d902-07e5-4f67-b214-a2877b793e32",
                                                "sense_id": "a72f52e4-a2d1-39f0-a73a-1fe53772bd75",
                                                "text": "The CMA fined the companies involved £3.4 million, which included uplifts for director level involvement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
