                ],
                "senses": [
                    {
                        "sense_id": "1510f9df-4f20-3f48-8944-c0361ca98cda",
                        "entry_id": "572115ff-d063-3817-bbc3-e70ae6135ef3",
                        "glosses": [
                            "Appareil propre à polariser la lumière."
                        ],
                        "tags": [
                            "Optique"
                        ],
                        "examples": [
                            {
                                "example_id": "17aafa79-2715-4665-91cf-0f4e9474ff93",
                                "sense_id": "1510f9df-4f20-3f48-8944-c0361ca98cda",
                                "text": "Ceux-ci s’engrènent sur deux roues dentées, qui portent le polariseur, et l’analyseur avec l’oculaire."
                            },
                            {
                                "example_id": "def98b3e-e9c1-4654-affa-8f972008eef6",
                                "sense_id": "1510f9df-4f20-3f48-8944-c0361ca98cda",
                                "text": "Tous les polariseurs ne peuvent pas servir pour les rayons très réfrangibles."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed452191-7df1-338f-adce-50556e4aedc8",
                        "entry_id": "572115ff-d063-3817-bbc3-e70ae6135ef3",
                        "glosses": [
                            "Film à polariser la lumière du rétroéclairage d’un écran à cristaux liquides."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92ff98c9-a32a-4b82-ac19-22df20748486",
                        "source_entry_id": "572115ff-d063-3817-bbc3-e70ae6135ef3",
                        "source_sense_description": "Appareil à polariser",
                        "target_lang_word": "polarizer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polarizer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3a4dcd0-2f51-3f7f-933a-b2d55f1705dd",
                                        "entry_id": "6998fdc3-75f2-36f3-af39-1f01a31198d8",
                                        "glosses": [
                                            "One who polarizes; one who divides a group or community into two extremes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c32b5c57-596f-4a1e-aae4-df644e1071fb",
                                                "sense_id": "c3a4dcd0-2f51-3f7f-933a-b2d55f1705dd",
                                                "text": "a polarizer of opinions"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54a24afe-a6ba-3272-ab22-e956732cc439",
                                        "entry_id": "6998fdc3-75f2-36f3-af39-1f01a31198d8",
                                        "glosses": [
                                            "Any device that produces polarized light."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a612d24b-ab93-4b98-9dbf-81545864c7b3",
                                                "sense_id": "54a24afe-a6ba-3272-ab22-e956732cc439",
                                                "text": "When the polarizers are aligned in the same direction, they block the same state of polarization, i.e. they both block horizontally polarized light, and both let the vertically polarized light through. The second polarizer therefore has no effect on the light. When the polarizers are aligned perpendicular to one another, one will block the horizontally polarized light and the other will block vertically polarized light — no light at all gets through the pair!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
