                    {
                        "translation_id": "4ba7b88f-8ba8-4d90-90df-aaced77a583a",
                        "source_entry_id": "3af66b19-13e4-3403-9a07-5faae1cf7144",
                        "source_sense_id": "06180c04-e734-3032-9fea-4a86634b08ba",
                        "source_sense_description": "van werk of andere activiteit dat je er voordeel van ondervindt; dat het de moeite waard is",
                        "target_lang_word": "lukrativ",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lukrativ",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6685bd7b-c1aa-310b-8801-1551f06e41fd",
                                        "entry_id": "7ee1e333-ab7a-3029-8749-b9db0b8b7b6f",
                                        "glosses": [
                                            "finanziell einen hohen Gewinn versprechend/abwerfend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed69e8e3-627b-4064-96e1-a6fd4282306c",
                                                "sense_id": "6685bd7b-c1aa-310b-8801-1551f06e41fd",
                                                "text": "„Für Trump und seine Familie ist die Präsidentschaft ein lukratives Geschäft.“"
                                            },
                                            {
                                                "example_id": "ac0b3d1a-93ff-4091-b95f-db3bb37d539a",
                                                "sense_id": "6685bd7b-c1aa-310b-8801-1551f06e41fd",
                                                "text": "Dies ist ein überaus lukratives Angebot."
                                            },
                                            {
                                                "example_id": "14855129-aab5-4ffb-bd65-42a2d12a8a4c",
                                                "sense_id": "6685bd7b-c1aa-310b-8801-1551f06e41fd",
                                                "text": "„Nach Drogen und Waffen zähle der internationale Kunst-Schwarzmarkt zu den lukrativsten Geschäften der Welt.“"
                                            },
                                            {
                                                "example_id": "029523fb-dc7d-439e-9ce3-ecbac30d6746",
                                                "sense_id": "6685bd7b-c1aa-310b-8801-1551f06e41fd",
                                                "text": "„Nach nur zwei Bewerbungen bekam er einen lukrativen Job bei einer Versicherung.“"
                                            },
                                            {
                                                "example_id": "f3ebbe99-9190-49d0-8503-cfca5eab981e",
                                                "sense_id": "6685bd7b-c1aa-310b-8801-1551f06e41fd",
                                                "text": "„Die Prohibition ist in vollem Gang, letzte Farce eines puritanischen Amerika, durch die das Entstehen illegaler Treffpunkte, eines lukrativen Schwarzhandels und einer anmaßenden Mafia gefördert wird.“"
                                            },
                                            {
                                                "example_id": "963ca935-07ff-465d-b0d6-3dc4dc2c8547",
                                                "sense_id": "6685bd7b-c1aa-310b-8801-1551f06e41fd",
                                                "text": "„Es fehlen ausreichend Studienplätze für Mediziner. Und die Studenten, die es gibt, spezialisieren sich lieber und übernehmen eine lukrative Facharztpraxis in einem Ballungsgebiet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a44ed198-f9f4-471e-84ad-92298b5109cd",
                        "source_entry_id": "3af66b19-13e4-3403-9a07-5faae1cf7144",
                        "source_sense_id": "06180c04-e734-3032-9fea-4a86634b08ba",
                        "source_sense_description": "van werk of andere activiteit dat je er voordeel van ondervindt; dat het de moeite waard is",
                        "target_lang_word": "lucrative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lucrative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "773ec48a-7642-3b89-87ce-2d7ac6b869df",
                                        "entry_id": "7cdd7d0c-9403-31ca-9782-a2cf211857c0",
                                        "glosses": [
                                            "Producing a surplus; profitable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ed90e74-1781-4c5e-8c8f-4efbb97a5da8",
                                                "sense_id": "773ec48a-7642-3b89-87ce-2d7ac6b869df",
                                                "text": "Since the mid-1980s, when Indonesia first began to clear its bountiful forests on an industrial scale in favour of lucrative palm-oil plantations, “haze” has become an almost annual occurrence in South-East Asia. The cheapest way to clear logged woodland is to burn it, producing an acrid cloud of foul white smoke that, carried by the wind, can cover hundreds, or even thousands, of square miles."
                                            },
                                            {
                                                "example_id": "b52dcdda-563d-4227-bb9b-2b3bc127b021",
                                                "sense_id": "773ec48a-7642-3b89-87ce-2d7ac6b869df",
                                                "text": "In a given recent year, Celine has earned $40-$50 million from her various endeavors, though the majority of that income was thanks to a lucrative Las Vegas residency deal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2e51d52-4125-37ba-a92e-7e09dab442a8",
                                        "entry_id": "7cdd7d0c-9403-31ca-9782-a2cf211857c0",
                                        "glosses": [
                                            "Of a target: worth attacking; whose destruction is militarily useful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa70b4c5-c9d4-4001-97aa-8d6b58e6a386",
                                                "sense_id": "a2e51d52-4125-37ba-a92e-7e09dab442a8",
                                                "text": "Command and Control centers and headquarters are strategically important and lucrative targets."
                                            },
                                            {
                                                "example_id": "932797c0-7e06-4270-8a0d-1a21e4abf1cc",
                                                "sense_id": "a2e51d52-4125-37ba-a92e-7e09dab442a8",
                                                "text": "Its troops can be widely dispersed as light infantry, using light anti-ship, anti-air and anti-land missiles and weapons to defenda given area or facility without presenting lucrative targets for air, missile, and artillery fire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dc2b179-82da-4f8e-84cb-bb37822d5fae",
                        "source_entry_id": "3af66b19-13e4-3403-9a07-5faae1cf7144",
                        "source_sense_id": "06180c04-e734-3032-9fea-4a86634b08ba",
                        "source_sense_description": "van werk of andere activiteit dat je er voordeel van ondervindt; dat het de moeite waard is",
                        "target_lang_word": "efficient",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "efficient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08372609-3d97-3f23-90f5-292edc1c9672",
                                        "entry_id": "ef6e836e-04c6-3c80-b3ba-0b6c12fe4019",
                                        "glosses": [
                                            "Making good, thorough, or careful use of resources; not consuming extra. Especially, making good use of time or energy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a5e514b-4139-4f78-97ec-7a88019a11b4",
                                                "sense_id": "08372609-3d97-3f23-90f5-292edc1c9672",
                                                "text": "An efficient process would automate all the routine work."
                                            },
                                            {
                                                "example_id": "4a701c63-fe41-4fe1-89e5-d43dde80c8af",
                                                "sense_id": "08372609-3d97-3f23-90f5-292edc1c9672",
                                                "text": "Our cleaners are almost too efficient: they throw away anything left out on a desk."
                                            },
                                            {
                                                "example_id": "66c5afe3-d585-466f-962c-6865cc5c1e81",
                                                "sense_id": "08372609-3d97-3f23-90f5-292edc1c9672",
                                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic[…]real kidneys[…]. But they are nothing like as efficient, and can cause bleeding, clotting and infection—not to mention inconvenience for patients, who typically need to be hooked up to one three times a week for hours at a time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6d3e1b8-ef45-3839-a19c-68f1ed5d3715",
                                        "entry_id": "ef6e836e-04c6-3c80-b3ba-0b6c12fe4019",
                                        "glosses": [
                                            "Expressing the proportion of consumed energy that was successfully used in a process; the ratio of useful output to total input."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cc42af8-09fc-4f24-ac1a-61fb26cbb7a4",
                                                "sense_id": "f6d3e1b8-ef45-3839-a19c-68f1ed5d3715",
                                                "text": "The motor is only 20% efficient at that temperature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ad90144-dad8-33d0-9220-c8f542bb90ea",
                                        "entry_id": "ef6e836e-04c6-3c80-b3ba-0b6c12fe4019",
                                        "glosses": [
                                            "Causing effects, producing results; bringing into being; initiating change (rare except in philosophical and legal expression efficient cause = causative factor or agent)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e14d528-4abf-416a-b9d0-bcb7976e94b8",
                                                "sense_id": "4ad90144-dad8-33d0-9220-c8f542bb90ea",
                                                "text": "Ownership, maintenance, or use of the automobile need not be the direct and efficient cause of the injury sustained"
                                            },
                                            {
                                                "example_id": "a50a1016-f640-4ed6-81b6-bed8354cd4b0",
                                                "sense_id": "4ad90144-dad8-33d0-9220-c8f542bb90ea",
                                                "text": "It was well said of Plotinus, that the stars were significant, but not efficient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab66cafd-4fed-3aff-95e2-896d59668f44",
                                        "entry_id": "ef6e836e-04c6-3c80-b3ba-0b6c12fe4019",
                                        "glosses": [
                                            "effective, efficacious"
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddfbec1c-65bd-48e5-964b-821a2e8156e1",
                                                "sense_id": "ab66cafd-4fed-3aff-95e2-896d59668f44",
                                                "text": "Ye wake no more to anguish;‥ ye have borne\nThe Chosen, the Destroyer!‥ soon his hand\nShall strike the efficient blow;\nSoon shaking off your penal forms, shall ye,\nWith songs of joy, amid the Eden groves,\nHymn the Deliverer’s praise!"
                                            },
                                            {
                                                "example_id": "bc8942a4-614a-4fce-99b1-35305c32284b",
                                                "sense_id": "ab66cafd-4fed-3aff-95e2-896d59668f44",
                                                "text": "The Efficient Cause is that from which emanates the force that produces the Effect"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "efficient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5edc432-e4cd-3928-89ed-ebe441a28330",
                                        "entry_id": "dec2f9e4-f053-37f5-aaa8-448ccfe10554",
                                        "glosses": [
                                            "A cause; something that causes an effect."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73c361c7-e3ba-45f5-bdb2-c369b0ee0655",
                                                "sense_id": "f5edc432-e4cd-3928-89ed-ebe441a28330",
                                                "text": "Some are without efficient, as God; others without matter, as Angels […]."
                                            },
                                            {
                                                "example_id": "83e1d88c-3398-49e1-ba75-58f0e8b3079d",
                                                "sense_id": "f5edc432-e4cd-3928-89ed-ebe441a28330",
                                                "text": "This implies, that something happens without a cause. If it should be said, that motive in this case is not the efficient of the action or doing — this is granted; but at the same time, for reasons already given, it is denied, that the man himself is the efficient cause of it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb21140d-352e-44f2-a1bb-28561a7db75d",
                        "source_entry_id": "3af66b19-13e4-3403-9a07-5faae1cf7144",
                        "source_sense_id": "06180c04-e734-3032-9fea-4a86634b08ba",
