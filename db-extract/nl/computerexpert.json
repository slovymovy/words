                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "ae47c72c-e29a-4114-a1d3-fe788fd9a0c5",
                                "sense_id": "b5044cd2-4957-350a-b13a-1d357eb2215f",
                                "text": "De computerexpert richtte de actiegroep 'Wij vertrouwen stemcomputers niet' op omdat hij vond dat de computersystemen die gebruikt werden, veel te kwetsbaar zijn."
                            },
                            {
                                "example_id": "f0442d31-e200-474f-9c5c-34d0ccb793e3",
                                "sense_id": "b5044cd2-4957-350a-b13a-1d357eb2215f",
                                "text": "Een Amerikaanse computerexpert die zijn broer jarenlang stiekem de winnende loterijgetallen doorspeelde is in hoger beroep veroordeeld tot een gevangenisstraf van 25 jaar. Eddie en Tommy Tipton wisten in vier Amerikaanse staten 2,2 miljoen dollar bij elkaar te 'winnen', onder meer in de Megabucks loterij in Wisconsin en de Hot Lotto in Oklahoma."
                            }
                        ]
                    }
