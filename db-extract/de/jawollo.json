                                "example_id": "62c0b86a-34b7-431c-bdbf-00470451b04f",
                                "sense_id": "2530aa25-a6e6-3453-a09a-c335e6b46b17",
                                "text": "„Nach der Telefonabstimmung fiel der ‚erfolgreichste deutsche Komponist‘ (Eigendefinition) vor Daniels Oma auf die Knie, rief ‚Yes, jawollo!‘ und umarmte die Dame.“"
                            },
                            {
                                "example_id": "ecd77d76-5199-40c3-bcea-8763bacdd3d4",
                                "sense_id": "2530aa25-a6e6-3453-a09a-c335e6b46b17",
                                "text": "„Jawollo, so macht man das!“"
                            },
                            {
                                "example_id": "7235677a-7d38-4d09-9513-def8215eb37e",
                                "sense_id": "2530aa25-a6e6-3453-a09a-c335e6b46b17",
                                "text": "„Spindelegger: Ready when you are!",
                                "translation": "Spindelegger: Jawollo! Ran an den Feind.“"
                            },
                            {
                                "example_id": "293f6d9e-d2b2-4e3f-8513-a2ae977699dd",
                                "sense_id": "2530aa25-a6e6-3453-a09a-c335e6b46b17",
                                "text": "„‚Jawollo!‘, so bestätigt er seine Rede gern mit einem seiner Lieblingsworte.“"
                            },
                            {
                                "example_id": "f405bb2e-b174-44b7-ad06-c787d7ec4829",
                                "sense_id": "2530aa25-a6e6-3453-a09a-c335e6b46b17",
                                "text": "„Auf den ersten Blick mag man denken: Jawollo, schlau, endlich Schluss mit dieser Affenscheiße für Vollidioten – Alkies, go home!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
