{
    "word_family": [
        "kriebelen",
        "gekriebel",
        "kriebelig"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8041fb79-3f50-3dbc-b4bc-7fb64b8a4462",
                    "sense_definition": "Een kriebelend gevoel dat jeuk, hoest of irritatie veroorzaakt; ook figuurlijk gebruikt voor een gevoel van onbehagen of zenuwen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_en_mentaal_gevoel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb een vervelende <w>kriebel</w> in mijn keel waardoor ik steeds moet hoesten.",
                            "target_lang_translations": {
                                "en": "I have an annoying <w>tickle</w> in my throat that keeps making me cough."
                            }
                        },
                        {
                            "text": "Ik krijg de <w>kriebels</w> van die griezelige spin op de muur.",
                            "target_lang_translations": {
                                "en": "That creepy spider on the wall gives me the <w>creeps</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "jeuk"
                    ],
                    "common_phrases": [
                        "kriebel in de keel",
                        "de kriebels krijgen"
                    ],
                    "target_lang_definitions": {
                        "en": "A tickling sensation that causes itching, coughing, or irritation; also used figuratively for a feeling of unease, jitters, or creeps."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tickle",
                                "target_lang_sense_clarification": "a light, tickling sensation in the throat or skin"
                            },
                            {
                                "target_lang_word": "itch",
                                "target_lang_sense_clarification": "an irritating sensation on the skin or in the throat"
                            },
                            {
                                "target_lang_word": "creeps",
                                "target_lang_sense_clarification": "a feeling of fear, unease, or disgust (de kriebels krijgen)"
                            },
                            {
                                "target_lang_word": "jitters",
                                "target_lang_sense_clarification": "nervous anxiety or unease"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd94c7b7-d8bd-3653-8383-7283f28c2b7e",
                    "sense_definition": "Een innerlijk gevoel van onrust, spanning of zin om iets te gaan ondernemen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_en_mentaal_gevoel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen het voorjaar begon, kreeg zij weer de <w>kriebel</w> om te gaan reizen.",
                            "target_lang_translations": {
                                "en": "When spring started, she got the <w>itch</w> to travel again."
                            }
                        },
                        {
                            "text": "De gezonde <w>kriebels</w> voor de wedstrijd waren duidelijk voelbaar in de kleedkamer.",
                            "target_lang_translations": {
                                "en": "The healthy pre-match <w>jitters</w> were clearly palpable in the dressing room."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de kriebel krijgen"
                    ],
                    "target_lang_definitions": {
                        "en": "An inner feeling of restlessness, excitement, or a strong urge to start doing something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "itch",
                                "target_lang_sense_clarification": "a strong urge or desire to do something"
                            },
                            {
                                "target_lang_word": "wanderlust",
                                "target_lang_sense_clarification": "a strong desire to travel"
                            },
                            {
                                "target_lang_word": "urge",
                                "target_lang_sense_clarification": "an inner impulse or drive to act"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ce47569e-865b-314d-afd8-ce87db2597c4",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>kriebelen</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kriebel</w> zachtjes op je rug om je te helpen ontspannen.",
                            "target_lang_translations": {
                                "en": "I gently <w>tickle</w> your back to help you relax."
                            }
                        },
                        {
                            "text": "Als ik daar <w>kriebel</w>, moet de hond altijd hard lachen.",
                            "target_lang_translations": {
                                "en": "When I <w>tickle</w> there, the dog always laughs hard."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present indicative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present indicative of the verb 'kriebelen' (to tickle)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tickle",
                                "target_lang_sense_clarification": "first-person singular present of 'to tickle'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d09b1dc-af3c-3f14-9e5a-34b2e46591ae",
                    "sense_definition": "Gebiedende wijs van <w>kriebelen</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kriebel</w> me eens op mijn rug, want ik heb daar zo'n jeuk.",
                            "target_lang_translations": {
                                "en": "<w>Tickle</w> my back for a moment, because I have such an itch there."
                            }
                        },
                        {
                            "text": "Nee, stop, <w>kriebel</w> niet zo hard!",
                            "target_lang_translations": {
                                "en": "No, stop, don't <w>tickle</w> so hard!"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of the verb 'kriebelen' (to tickle)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tickle",
                                "target_lang_sense_clarification": "imperative form of 'to tickle'"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}