                ],
                "senses": [
                    {
                        "sense_id": "15f7f4a4-393f-3d48-a46e-aa067e2e6bdf",
                        "entry_id": "a626bca5-18bd-3b23-91e3-e315d0edf13b",
                        "glosses": [
                            "fest installierte Gegenstände, die mit Wasser versorgt werden und zum Reinigen oder Waschen dienen, wonach das Wasser entsorgt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7acb4ecf-12bc-4448-b773-55633ca173f3",
                                "sense_id": "15f7f4a4-393f-3d48-a46e-aa067e2e6bdf",
                                "text": "„Die Unterscheidung in Einzelanschlussleitung und Sammelanschlussleitung ist in anderen Ländern Europas nicht üblich, weshalb man sich auf den Begriff Anschlussleitung geeinigt hat, die einen einzigen Entwässerungsgegenstand oder auch mehrere an die Fallleitung oder an die Grundleitung bzw. die Sammelleitung anschließt.“"
                            },
                            {
                                "example_id": "8b224cd7-6a67-428b-a740-606c4c534475",
                                "sense_id": "15f7f4a4-393f-3d48-a46e-aa067e2e6bdf",
                                "text": "„In Abschnitt 9 der DIN EN 1717 sind die erforderlichen Sicherheitsabstände für den freien Ablauf über einen Entwässerungsgegenstand durch vollkommene Trennung bzw. die Querschnitte der Belüftungsöffnungen, z. B. bei einer „Befestigungsverbindung“ mit Stegen beschrieben.“"
                            },
                            {
                                "example_id": "52800805-217e-453c-8d9b-e1b189c129ba",
                                "sense_id": "15f7f4a4-393f-3d48-a46e-aa067e2e6bdf",
                                "text": "„Rückstauverschlüsse dürfen niemals als zentrale Absicherung eines Gebäudes mit oberhalb der Rückstauebene installierten Entwässerungsgegenständen eingesetzt werden.“"
                            },
                            {
                                "example_id": "6dd94618-9413-4f4f-beed-6d2f4dd75481",
                                "sense_id": "15f7f4a4-393f-3d48-a46e-aa067e2e6bdf",
                                "text": "„Nur im Falle untergeordneter Nutzung dieser Entwässerungsgegenstände ist es zulässig, sie über Rückstauverschlüsse zu entwässern.“"
                            },
                            {
                                "example_id": "328b308c-a2a6-49d0-b93d-c1b331fbc32b",
                                "sense_id": "15f7f4a4-393f-3d48-a46e-aa067e2e6bdf",
                                "text": "„Das Dokument gilt für werkmäßig hergestellte Entwässerungsgegenstände und -einrichtungen aus Beton und Stahlbeton.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
