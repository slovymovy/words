                "senses": [
                    {
                        "sense_id": "22a0b8f1-a190-3f4c-a79d-2025ba954610",
                        "entry_id": "5a4a3cc2-1bf3-36ac-897d-85c415d9821f",
                        "glosses": [
                            "Document obtenu par polycopiage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "659431bc-7d5a-4589-b347-1397ee83201a",
                                "sense_id": "22a0b8f1-a190-3f4c-a79d-2025ba954610",
                                "text": "Tu me passes ton polycopié du cours ?"
                            },
                            {
                                "example_id": "31ab70ba-2527-4190-b1f9-d8539ff54356",
                                "sense_id": "22a0b8f1-a190-3f4c-a79d-2025ba954610",
                                "text": "À chacune des 6 séances de 3 heures, un polycopié est distribué et il sert de fil directeur de la séance."
                            },
                            {
                                "example_id": "1203a9fb-29eb-4fc7-82b6-3e10b4e8038d",
                                "sense_id": "22a0b8f1-a190-3f4c-a79d-2025ba954610",
                                "text": "Eléonore vivait dans un minuscule studio envahi de livres, polycopiés, photocopies, cahiers et carnets en tout genre, la pièce ressemblait au coin désordonné d'une bibliothèque universitaire, un lieu sans poésie."
                            }
                        ]
                    }
