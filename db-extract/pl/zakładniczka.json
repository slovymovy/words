                                    {
                                        "sense_id": "ce644758-f48b-3704-8fed-7164f6cb5a6a",
                                        "entry_id": "3514a728-0cf8-37a2-9c6f-6378c1d26170",
                                        "glosses": [
                                            "женск. к заложник"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe6e527d-4cfb-475a-9924-2b34f37e2121",
                                                "sense_id": "ce644758-f48b-3704-8fed-7164f6cb5a6a",
                                                "text": "Символ сегодняшнего дня ― спецназовец, выносящий на руках из заминированного здания хрупкое тело спасённой заложницы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
