                                "sense_id": "87e3962e-53bc-3135-9798-76726c6548d7",
                                "text": "Pośród metod badawczych socjologii szczególne znaczenie mają badania statystyczne."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
