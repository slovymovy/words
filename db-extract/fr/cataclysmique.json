                                    {
                                        "sense_id": "92fb7a5e-d725-3711-99a4-8f08262d298b",
                                        "entry_id": "cb23a43a-d929-3a8f-8422-dbbfa10dd495",
                                        "glosses": [
                                            "As noisy or destructive as a cataclysm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb2ccadd-c097-4bff-a2ad-d5ecf6ff2118",
                                                "sense_id": "92fb7a5e-d725-3711-99a4-8f08262d298b",
                                                "text": "That they have been exterminated by exceptional cataclysmal changes of the earth's surface has not been proved."
                                            },
                                            {
                                                "example_id": "2b383a91-0a39-4997-8d8b-a30143255950",
                                                "sense_id": "92fb7a5e-d725-3711-99a4-8f08262d298b",
                                                "text": "Perhaps she’s so deaf that nothing short of a cataclysmal uproar will reach her auditory nerves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da0d5deb-67c9-4098-9502-e374e2c0a6e3",
                        "source_entry_id": "77120d6e-0234-33f0-a006-c08d690edaf6",
