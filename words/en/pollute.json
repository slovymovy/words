{
    "word_family": [
        "pollution",
        "pollutant",
        "polluter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1fdaa400-d541-37cb-9342-1e3a7c7f6c56",
                    "sense_definition": "To make a substance or environment dirty, impure, or harmful by adding waste or chemicals.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "contamination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory <w>polluted</w> the river when it cleaned its tanks.",
                            "target_lang_translations": {
                                "ru": "Завод <w>загрязни́л</w> реку, когда очищал свои резервуары."
                            }
                        },
                        {
                            "text": "Chemical waste can <w>pollute</w> the local water supply.",
                            "target_lang_translations": {
                                "ru": "Химические отходы могут <w>загрязни́ть</w> местный источник водоснабжения."
                            }
                        }
                    ],
                    "synonyms": [
                        "contaminate",
                        "taint"
                    ],
                    "antonyms": [
                        "purify",
                        "cleanse"
                    ],
                    "common_phrases": [
                        "pollute the water",
                        "pollute the air"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать среду или вещество грязным, вредным или непригодным для использования путем добавления отходов или химикатов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загрязня́ть",
                                "target_lang_sense_clarification": "процесс или регулярное действие по внесению загрязнений"
                            },
                            {
                                "target_lang_word": "загрязни́ть",
                                "target_lang_sense_clarification": "результативное действие, сделать грязным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfe5a801-e370-3341-9b5e-ed243c9d0630",
                    "sense_definition": "To make a place or experience less suitable or enjoyable by introducing something unnatural or unwanted.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contamination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lights from the stadium <w>polluted</w> the night sky, and we could not see the stars.",
                            "target_lang_translations": {
                                "ru": "Огни стадиона <w>испо́ртили</w> ночное небо, и мы не могли видеть звезды."
                            }
                        },
                        {
                            "text": "Loud music can <w>pollute</w> the peaceful atmosphere of the park.",
                            "target_lang_translations": {
                                "ru": "Громкая музыка может <w>нару́шить</w> мирную атмосферу парка."
                            }
                        }
                    ],
                    "synonyms": [
                        "spoil",
                        "mar"
                    ],
                    "common_phrases": [
                        "pollute the view",
                        "pollute the atmosphere"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать место или впечатление менее приятным из-за присутствия чего-то неестественного или нежелательного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испо́ртить",
                                "target_lang_sense_clarification": "нарушить гармонию или приятную атмосферу"
                            },
                            {
                                "target_lang_word": "наруша́ть",
                                "target_lang_sense_clarification": "в контексте нарушения покоя или тишины"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ded9b7ad-eb96-3cdf-93ed-055a06a723c4",
                    "sense_definition": "To morally corrupt or profane something sacred or pure.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "corruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scandal <w>polluted</w> the reputation of the entire organization.",
                            "target_lang_translations": {
                                "ru": "Скандал <w>очерни́л</w> репутацию всей организации."
                            }
                        },
                        {
                            "text": "He feared that greed would <w>pollute</w> his original vision for the project.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что жадность <w>испо́ртит</w> его первоначальное видение проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "corrupt",
                        "defile"
                    ],
                    "antonyms": [
                        "sanctify"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in religious or formal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Морально разлагать или осквернять что-то священное или чистое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оскверня́ть",
                                "target_lang_sense_clarification": "лишать святости, порочить"
                            },
                            {
                                "target_lang_word": "разлага́ть",
                                "target_lang_sense_clarification": "морально портить, подрывать принципы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "464da62b-1d25-3c01-8a9f-e3b845089f50",
                    "sense_definition": "To violate or dishonor someone sexually.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "corruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical text described how the invaders <w>polluted</w> the captured women.",
                            "target_lang_translations": {
                                "ru": "В историческом тексте описывалось, как захватчики <w>надруга́лись</w> над пленными женщинами."
                            }
                        },
                        {
                            "text": "Such acts were seen as a way to <w>pollute</w> the honor of the family.",
                            "target_lang_translations": {
                                "ru": "Подобные действия рассматривались как способ <w>обесче́стить</w> семью."
                            }
                        }
                    ],
                    "synonyms": [
                        "debauch",
                        "violate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or historical context."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нарушать честь или достоинство человека, совершая насильственные действия сексуального характера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обесче́стить",
                                "target_lang_sense_clarification": "лишить чести, опозорить"
                            },
                            {
                                "target_lang_word": "надруга́ться",
                                "target_lang_sense_clarification": "совершить насильственные действия, унижающие достоинство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}