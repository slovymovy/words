                ],
                "senses": [
                    {
                        "sense_id": "63cfd923-6ad1-33a3-9692-c1756160b596",
                        "entry_id": "d05acf33-3725-3250-8595-351ea255d5d6",
                        "glosses": [
                            "Hauptstadt der pakistanischen Provinz Khyber Pakhtunkhwa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d530efb-9d49-4761-a363-2bc4d812f5f7",
                                "sense_id": "63cfd923-6ad1-33a3-9692-c1756160b596",
                                "text": "„Administratives, wirtschaftliches und kulturelles Zentrum von Khyber Pakhtunkhwa ist die Millionenstadt Peschawar.“"
                            },
                            {
                                "example_id": "3ca88fca-7606-4d94-ad95-ff15660b0ca6",
                                "sense_id": "63cfd923-6ad1-33a3-9692-c1756160b596",
                                "text": "„Diesen Zerfall des Durrani-Reiches in eine Vielzahl kleiner Fürstentümer nutzte Ranjit Singh, indem er 1819 Kaschmir eroberte und 1823 sogar Peschawar einnahm.“"
                            },
                            {
                                "example_id": "059756b1-338f-44c3-8050-73cbc7511ebd",
                                "sense_id": "63cfd923-6ad1-33a3-9692-c1756160b596",
                                "text": "„An Kleidung hatte Harry zusätzlich noch eine warme Jacke bekommen, denn immerhin würde die Leiche ja Ende Dezember im Bergland zwischen Peschawar und der afghanischen Grenze aufgefunden werden.“"
                            },
                            {
                                "example_id": "42a40e49-486b-4973-8600-89e3b5888180",
                                "sense_id": "63cfd923-6ad1-33a3-9692-c1756160b596",
                                "text": "„Es gab kein Diplom, keinen warmen Händedruck vom Direktor, keinen tränenreichen Abschied von den Ausbildungskollegen, keine Pläne, sich nächsten Sommer mal auf einen Drink in Wien oder Peschawar zu treffen.“"
                            },
                            {
                                "example_id": "72f3729c-e941-41df-986e-600e7e809cfa",
                                "sense_id": "63cfd923-6ad1-33a3-9692-c1756160b596",
                                "text": "„Doyle hielt sich im pakistanischen Peschawar auf, als Afghanistan fiel.“"
                            },
                            {
                                "example_id": "e3a826f0-6849-4e15-a604-656ac9dabcf2",
                                "sense_id": "63cfd923-6ad1-33a3-9692-c1756160b596",
                                "text": "„Also schickte Stansfield ihn nach Peschawar, um bei der Ausbildung und Bewaffnung der Mudschaheddin zu helfen.“"
                            },
                            {
                                "example_id": "f867621e-ecd7-4a61-a3e4-c13d80e7e98b",
                                "sense_id": "63cfd923-6ad1-33a3-9692-c1756160b596",
                                "text": "„Auf der großen Fernstraße fuhr er auf die erste Station seiner Reise zu, einen Fliegerhorst westlich von Peschawar.“"
                            },
                            {
                                "example_id": "f04fff2b-919a-4d71-b0f3-d4422077be2f",
                                "sense_id": "63cfd923-6ad1-33a3-9692-c1756160b596",
                                "text": "„Die Führer dieser Bewegung flohen 1975 nach Peschawar und wurden von Pakistans Premierminister Zulfiquar Ali Bhutto weiter in ihrer Oppositionshaltung zu Daud unterstützt.“"
                            },
                            {
                                "example_id": "bdc2408c-ba73-4bdb-8653-873a37ebe7d5",
                                "sense_id": "63cfd923-6ad1-33a3-9692-c1756160b596",
                                "text": "„Von nun an ging es schneller voran, in westlicher und nordwestlicher Richtung, quer über die Ebenen und mächtigen Ströme des Pandschab, durchs Land der Sikhs bis hinauf nach Peschawar, wo Indien aufhört.“"
                            },
                            {
                                "example_id": "fdf80afb-6904-474d-896c-1e6bd2213758",
                                "sense_id": "63cfd923-6ad1-33a3-9692-c1756160b596",
                                "text": "„›Mir schwebt ein Team von drei oder vier Männern vor. Ich bringe sie über den Chaiber-Pass den Hindukusch runter, durch Peschawar und bis nach Rawalpindi.‹“"
                            },
                            {
                                "example_id": "6b975263-66c2-4561-951f-f1d9585fbcd9",
                                "sense_id": "63cfd923-6ad1-33a3-9692-c1756160b596",
                                "text": "„Immerhin hatte er 2008 in Bagdad die Nummer zwei in der Al-Qaida-Führung erledigt, und deren Nachfolger ebenso, diesmal in Peschawar, 2011.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
