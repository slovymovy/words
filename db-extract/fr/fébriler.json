                "senses": [
                    {
                        "sense_id": "6b2bb5cc-2aa0-30f2-b7ee-2eb997b88a95",
                        "entry_id": "5deedf5d-af68-32da-92fe-474a68a7a793",
                        "glosses": [
                            "Être fébrile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bd07ff9-2384-43f2-a4de-859b4039b69d",
                                "sense_id": "6b2bb5cc-2aa0-30f2-b7ee-2eb997b88a95",
                                "text": "Vous allez jusqu’à Paris, demanda l’abbé qui, depuis quelques minutes, fébrilait sur les coussins de la banquette."
                            },
                            {
                                "example_id": "a3d692fe-282c-4a5f-8f79-13e830229d75",
                                "sense_id": "6b2bb5cc-2aa0-30f2-b7ee-2eb997b88a95",
                                "text": "Les signes se croisent sur mon chemin. Seulement les signes qui fébrilent."
                            },
                            {
                                "example_id": "47a113bb-4d22-4a2b-96ba-a143a6a7184b",
                                "sense_id": "6b2bb5cc-2aa0-30f2-b7ee-2eb997b88a95",
                                "text": "J'ai peur, je crève de trouille à en mouiller mon froc, je ventile, je fébrile, je tachycardise, je spasmophilise."
                            }
                        ]
                    }
