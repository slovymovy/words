                                    {
                                        "sense_id": "8191c6f3-237a-3006-806d-da43bbf02370",
                                        "entry_id": "2ae21677-0240-3e9d-b81d-c46d0228228f",
                                        "glosses": [
                                            "Schriftstück, das es nur in einer einzigen Ausfertigung gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b461b001-14e1-4e7f-b1b9-285fc40b6122",
                                                "sense_id": "8191c6f3-237a-3006-806d-da43bbf02370",
                                                "text": "„Das Haptische einer Urkunde ist unwiederbringlich dahin, wenn das Unikat zerstört ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f2652e87-99bc-3da5-b347-fd9b0baddebd",
                                        "entry_id": "2ae21677-0240-3e9d-b81d-c46d0228228f",
                                        "glosses": [
                                            "etwas, von dem es nur ein einziges Exemplar gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f5d5faa-f74f-4480-984a-49944abe0bc8",
                                                "sense_id": "f2652e87-99bc-3da5-b347-fd9b0baddebd",
                                                "text": "Jedes Dirndl aus unserem Haus ist ein handgeschneidertes Unikat."
                                            }
                                        ],
