                        "glosses": [
                            "Pertaining to, characteristic of, or produced by a demon or evil spirit; devilish, demonic, fiendish."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57969608-8fd8-41ae-9129-2fad2a6fc99e",
                                "sense_id": "24c30fe3-3fa0-3b68-bdab-3cb6603d944b",
                                "text": "sarcastic, demoniacal laughter"
                            },
                            {
                                "example_id": "c5f9cda0-c745-46f5-826c-c7c6166102ce",
                                "sense_id": "24c30fe3-3fa0-3b68-bdab-3cb6603d944b",
                                "text": "Rebecca laughed in her face, with a horrid sarcastic demoniacal laughter, that almost sent the schoolmistress into fits."
                            },
                            {
                                "example_id": "f676f971-3a45-436f-a5b0-82dedbec65fe",
                                "sense_id": "24c30fe3-3fa0-3b68-bdab-3cb6603d944b",
                                "text": "'What do you think of that, Job?' I asked of our retainer, who was sitting on the edge of the boat, trying to get as much sunshine as possible, and generally looking uncommonly wretched, and I pointed to the fiery and demoniacal head."
                            },
                            {
                                "example_id": "943255e1-4649-48ba-b1d9-9f1e0b01bd53",
                                "sense_id": "24c30fe3-3fa0-3b68-bdab-3cb6603d944b",
                                "text": "The spectator feels almost persuaded that he is witnessing some unearthly demoniacal orgie."
                            }
                        ]
                    }
                ],
