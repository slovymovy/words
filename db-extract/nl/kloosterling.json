                ],
                "translations": [
                    {
                        "translation_id": "b4c22724-56ba-48f4-8892-58f639b56e4e",
                        "source_entry_id": "dc563ddd-6df6-36c0-b7bb-76d1e8caaeec",
                        "source_sense_id": "4e6ea018-0ba1-3d60-a402-eb0ea34a9b74",
                        "source_sense_description": "iemand die gekozen heeft voor het leven in een klooster",
                        "target_lang_word": "religious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "religious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c9beae8-ef92-3095-875c-393f846faee0",
                                        "entry_id": "dde0e99d-9e05-3968-b613-bef92be7d219",
                                        "glosses": [
                                            "Concerning religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6a2d195-abec-4959-a641-c9e8acd24710",
                                                "sense_id": "5c9beae8-ef92-3095-875c-393f846faee0",
                                                "text": "It is the job of this court to rule on legal matters. We do not consider religious issues."
                                            },
                                            {
                                                "example_id": "53c9417e-b5e9-4107-8b02-4c4419c61ba3",
                                                "sense_id": "5c9beae8-ef92-3095-875c-393f846faee0",
                                                "text": "The Senators and Representatives before mentioned, and the members of the several State Legislatures, and all executive and judicial Officers, both of the United States and of the several States, shall be bound by Oath or Affirmation, to support this Constitution; but no religious Test shall ever be required as a Qualification to any Office or public Trust under the United States."
                                            },
                                            {
                                                "example_id": "fd0a0d82-a09f-44ba-91da-ecd5200310e8",
                                                "sense_id": "5c9beae8-ef92-3095-875c-393f846faee0",
                                                "text": "Despite personal schisms and differences in spiritual experience, there is a very coherent theology of Snape shared between the wives. To examine this manifestation of religious fandom, I will first discuss the canon scepticism and anti-Rowling sentiment that helps to contextualise the wider belief in Snape as a character who extends beyond book and film."
                                            },
                                            {
                                                "example_id": "8af57398-9341-4f6a-913e-056dfe0bd6c6",
                                                "sense_id": "5c9beae8-ef92-3095-875c-393f846faee0",
                                                "text": "All U.S. states allow exemptions for children with medical conditions that prevent them from getting certain vaccines. Most also allow exemptions for religious or other nonmedical reasons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afeedc4a-4512-3170-97b4-d47d14341bb7",
                                        "entry_id": "dde0e99d-9e05-3968-b613-bef92be7d219",
                                        "glosses": [
                                            "Committed to the practice or adherence of religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c33ef46b-99d5-4bb7-a3d5-6aa41d4065c1",
                                                "sense_id": "afeedc4a-4512-3170-97b4-d47d14341bb7",
                                                "text": "I was much more religious as a teenager than I am now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59503a0c-53bd-3938-b5d6-4e81ae656654",
                                        "entry_id": "dde0e99d-9e05-3968-b613-bef92be7d219",
                                        "glosses": [
                                            "Highly dedicated, as one would be to a religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81e8a061-a797-4210-acf2-c4717e0b9fa3",
                                                "sense_id": "59503a0c-53bd-3938-b5d6-4e81ae656654",
                                                "text": "I'm a religious fan of college basketball."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c902406-232b-3dec-97fe-d2fac842056b",
                                        "entry_id": "dde0e99d-9e05-3968-b613-bef92be7d219",
                                        "glosses": [
                                            "Belonging or pertaining to a religious order or religious congregation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b8b3d97-aec7-4fe0-9cfa-7c23dd3cb9ef",
                                                "sense_id": "4c902406-232b-3dec-97fe-d2fac842056b",
                                                "text": "religious priest, religious sister, religious brother"
                                            },
                                            {
                                                "example_id": "903e68e2-7235-4c92-a3eb-30b12915307a",
                                                "sense_id": "4c902406-232b-3dec-97fe-d2fac842056b",
                                                "text": "The religious vows are either simple or solemn. Vows are solemn according to the more common opinion, not, for instance, because of any solemnity attending the making of them, but because of the will of the Church."
                                            },
                                            {
                                                "example_id": "5cd6bd23-4a6c-4676-9ec9-3932bbf74b9d",
                                                "sense_id": "4c902406-232b-3dec-97fe-d2fac842056b",
                                                "text": "The religious priest lives his priesthood vocation within the religious congregation to which he belongs. He may serve within a parish or another institution, such as a school or a hospital. Unlike the diocesan priest, the religious priest develops his identity from the charism of the religious order and finds his community with the members of that order."
                                            },
                                            {
                                                "example_id": "0f4c00a3-191b-4a91-b607-6d637e6dc8f0",
                                                "sense_id": "4c902406-232b-3dec-97fe-d2fac842056b",
                                                "text": "From the 1450s onward it was possible for a religious to have included in his dispensation a clause that allowed him, once beneficed, to wear the garb of a secular priest provided he wore his religious habit underneath."
                                            },
                                            {
                                                "example_id": "225ddeed-ec15-4a12-836a-dae5e4e51fcf",
                                                "sense_id": "4c902406-232b-3dec-97fe-d2fac842056b",
                                                "text": "Divergence in religious rule and observance for women within the Franciscan order undoubtedly complicated the assimilation of the Irish Poor Clare sisters within Spanish convents."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "religious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b2b886c-8e49-364f-b4bf-145b6ca53a33",
                                        "entry_id": "47487f13-2393-340e-be1f-46de646417c9",
                                        "glosses": [
                                            "A member of a religious order, congregation, or certain other forms of consecrated life, i.e. a monk, nun, sister, brother, friar, or other religious priest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db19ebca-d477-45f0-abee-e5a0cfeeba49",
                                                "sense_id": "8b2b886c-8e49-364f-b4bf-145b6ca53a33",
                                                "text": "Towards the end of the seventh century the monks of Fleury [...] clandestinely excavated the body of Benedict himself, plus the corpse of his even more shadowy sister and fellow religious, Scholastica."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
