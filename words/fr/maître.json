                    "frequency": "Middle",
                    "semantic_group_id": "enseignement et expertise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce peintre est un <w>maître</w> de la couleur."
                        },
                        {
                            "text": "Mon <w>maître</w> de piano me corrige quand je joue trop vite."
