                                "target_senses": [
                                    {
                                        "sense_id": "72b0eafc-19a0-322d-940c-0bfd1df563de",
                                        "entry_id": "704f1705-6d03-3f12-8b5c-0a7ee4bafc07",
                                        "glosses": [
                                            "amerykańska Narodowa Agencja Aeronautyki i Przestrzeni Kosmicznej, zajmująca się planowaniem, koordynacją i realizacją badań nad kosmosem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48114cb0-0244-4fa8-bb94-5bc7982d60c6",
                                                "sense_id": "72b0eafc-19a0-322d-940c-0bfd1df563de",
                                                "text": "Pod koniec września br. próbnik wystrzelony przez amerykańską agencję kosmiczną NASA w ramach misji Double Asteroid Redirection Test (DART) uderzył w moonletkę (księżyc planetoidy) Dimoprhos, okrążającą planetoidę Didymos."
                                            },
                                            {
                                                "example_id": "154221cd-1d48-4ffe-8560-b145d3ff69df",
                                                "sense_id": "72b0eafc-19a0-322d-940c-0bfd1df563de",
                                                "text": "Istnieje teoria spiskowa, według której lądowanie na Księżycu nigdy się nie odbyło, a amerykańskie władze wraz z NASA wyreżyserowały całe zdarzenie."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eca92487-7c58-4e56-9135-51968756c2a1",
                        "source_entry_id": "cdde3a8f-5563-3a9e-ac88-6927d20cd8cc",
                        "source_sense_id": "cd252258-09a9-31d3-84d4-bd9b37b308b1",
