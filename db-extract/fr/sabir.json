        "fr-extract.jsonl": [
            {
                "entry_id": "4f5c6420-3c9b-30e7-bff5-92bd8a042771",
                "word": "sabir",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c762809c-4548-4a71-af7c-20a1d375612b",
                        "entry_id": "4f5c6420-3c9b-30e7-bff5-92bd8a042771",
                        "tags": [
                            "plural"
                        ],
                        "form": "sabirs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2469e04f-0f94-3e25-9d5e-d2ff12b61cf7",
                        "entry_id": "4f5c6420-3c9b-30e7-bff5-92bd8a042771",
                        "glosses": [
                            "Mélange de langues romanes et, dans une moindre mesure, de turc, d’arabe et de grec, parlé du XVIᵉ au XIXᵉ siècle dans les ports levantins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f3afaaf-c66b-43ba-b8a7-ff92a6367152",
                                "sense_id": "2469e04f-0f94-3e25-9d5e-d2ff12b61cf7",
                                "text": "Note : Rendue célèbre par Molière dans son ballet turc du Bourgeois gentilhomme (acte IV, scène 5) : Se te sabir, Te respondir… Si toi savoir, toi répondre…"
                            },
                            {
                                "example_id": "06d8e27e-ba97-4bdb-a94f-6d7cf7817ea4",
                                "sense_id": "2469e04f-0f94-3e25-9d5e-d2ff12b61cf7",
                                "text": "Le sabir est encore appelé langue franque."
                            },
                            {
                                "example_id": "2359c467-bc8f-47a7-a315-82db15d229b8",
                                "sense_id": "2469e04f-0f94-3e25-9d5e-d2ff12b61cf7",
                                "text": "Notre langue lui était inconnue, et à peine s’il parlait le sabir, ce patois algérien composé de provençal, d’italien, d’arabe, fait de mots bariolés ramassés comme des coquillages tout le long des mers latines."
                            },
                            {
                                "example_id": "e0e869a8-0853-4f79-97da-4715ae6bd387",
                                "sense_id": "2469e04f-0f94-3e25-9d5e-d2ff12b61cf7",
                                "text": "Cela était dit en sabir avec une crudité sauvage que le français ne peut pas traduire."
                            },
                            {
                                "example_id": "e2f56cb9-eb59-426a-a7c6-d30b5fad8533",
                                "sense_id": "2469e04f-0f94-3e25-9d5e-d2ff12b61cf7",
                                "text": "D’ailleurs, comment allait-il lui parler, puisque, bien certainement, elle ne comprenait pas un mot de français et que lui ne savait pas même le sabir ?"
                            },
                            {
                                "example_id": "8cc6ab70-2f98-4015-b5b3-abba08a3df8d",
                                "sense_id": "2469e04f-0f94-3e25-9d5e-d2ff12b61cf7",
                                "text": "Dans les estaminets des villes maritimes où ils avaient promené leur jeunesse, ils avaient pris ce tour d’esprit gouailleur et libertin qu’on ramasse en courant le monde ; ils possédaient, en argot, en sabir, en arabe, de cyniques plaisanteries toutes faites qu’ils jetaient à la face de toute chose."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2c36172-d907-3ca9-9836-4c29ed0ddacb",
                        "entry_id": "4f5c6420-3c9b-30e7-bff5-92bd8a042771",
                        "glosses": [
                            "Parler hétérogène au vocabulaire restreint, à la morphologie et à la syntaxe sommaires, utilisé par des locuteurs de langues maternelles différentes à des fins de communication orale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dda1a10b-085f-4642-a93a-a457f2666e4a",
                                "sense_id": "f2c36172-d907-3ca9-9836-4c29ed0ddacb",
                                "text": "Le jargon chinook est un sabir d'Amérique du Nord né du contact entre certaines tribus amérindiennes et les descendants d'Européens."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5d24a54-efa9-3f44-a636-62fbfb1d0f02",
                        "entry_id": "4f5c6420-3c9b-30e7-bff5-92bd8a042771",
                        "glosses": [
                            "Discours difficilement compréhensible ; charabia."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a64f19a3-7fb0-4be7-a76b-baf64f731730",
                                "sense_id": "f5d24a54-efa9-3f44-a636-62fbfb1d0f02",
                                "text": "Tais-toi ! Ne prononce pas ce nom-là ! Il pourrait t'en cuire ! éructa l'homme en un anglais douteux, émaillé de sabir."
                            },
                            {
                                "example_id": "d334a6b7-2687-4b9e-a122-8d0189075403",
                                "sense_id": "f5d24a54-efa9-3f44-a636-62fbfb1d0f02",
                                "text": "Le matin, aux aurores, j’étais au guichet de la police des frontières, attendant avec anxiété que le fonctionnaire enfermé dans son aquarium eût fini d’examiner mon passeport, page par page, lorsque le haut-parleur crachota une annonce dans un sabir qui voulait se faire passer pour de l’arabe classique."
                            },
                            {
                                "example_id": "0e2dd0e3-7943-48e8-a976-2ef0abe7329e",
                                "sense_id": "f5d24a54-efa9-3f44-a636-62fbfb1d0f02",
                                "text": "Sur deux pages, la spécialiste internationale du jupon nous éblouit de son savoir encyclopédique et de son sabir savant."
                            },
                            {
                                "example_id": "5bc7177b-341f-43eb-af63-6a0705549c7f",
                                "sense_id": "f5d24a54-efa9-3f44-a636-62fbfb1d0f02",
                                "text": "[…], elle plongea une première fois la main dans son sac et commença à filmer nos ébats avec son iPhone 6 ! Comme en transe, elle psalmodiait des je-ne-sais-quoi dans son sabir magyar, entrecoupés de petits halètements saccadés de chienne mettant bas sa portée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2521f330-5d60-44ff-9ee0-a1ccbafe80ff",
                        "source_entry_id": "4f5c6420-3c9b-30e7-bff5-92bd8a042771",
                        "source_sense_description": "Charabia.",
                        "target_lang_word": "Kauderwelsch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kauderwelsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                        "entry_id": "7bbf4698-8968-37d2-8f1f-1d8f074d36b4",
                                        "glosses": [
                                            "schwer- oder unverständliche Sprache; aus Elementen verschiedener Sprachen gemischte Ausdrucksweise, fehlerhafte Ausdrucksweise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0e05eeb-adfc-4c59-830c-8d8908adf1ec",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "Sein Kauderwelsch aus Spanisch und Deutsch war kaum verständlich."
                                            },
                                            {
                                                "example_id": "03da9ff9-2d2d-4500-99e2-f49e12229b0d",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "Man kann einen Satz, in dem Wörter oder grammatische Strukturen unterschiedlicher sprachlicher Herkunft gemischt werden, als Kauderwelsch bezeichnen."
                                            },
                                            {
                                                "example_id": "1370db05-c8d6-4361-ad1b-1fa36ac5e1df",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "Auch eine unverständliche Ausdrucksweise kann als Kauderwelsch bezeichnet werden."
                                            },
                                            {
                                                "example_id": "455e2124-bc05-4ea0-a051-6311b023ae7e",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "Auf Fremde wirkt der Hamburger manchmal leicht befremdlich, weil er ein nicht leicht verständliches Kauderwelsch, das Hamborger Platt, als Verständigungsmittel einsetzt."
                                            },
                                            {
                                                "example_id": "2c3282df-4437-46eb-9d54-b423a7db36a2",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "Der Linguist [Reiner Pogarell] hat beobachtet, dass das Aufbegehren gegen Denglisch-Kauderwelsch in Firmen stärker wird […]"
                                            },
                                            {
                                                "example_id": "a91c9376-2258-4ede-a4ac-36ab77d5517a",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "„Wir haben .. wiederholt auf das zähe westliche Vorurteil bei Jud und Christ hingewiesen, wonach Jiddisch nichts anderes sei als ein Jargon, ein verdorbenes, mit fremden Brocken anorganisch durchwürfeltes Deutsch, ein Kauderwelsch.“"
                                            },
                                            {
                                                "example_id": "8cc5b731-89f5-45ff-9805-0849d5e97e6a",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "„Für das, was er für Englisch hielt, hätte es ohnehin eines Dolmetschers bedurft, es handelte sich um ein Kauderwelsch aus Schwäbisch und Globalesisch."
                                            },
                                            {
                                                "example_id": "69586255-3a16-4259-a723-e550e00ddf00",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "„Und wenn Eltern eine Sprache vermitteln wollen, die sie selbst nur mangelhaft beherrschen, kommt dabei oft eher ein Kauderwelsch heraus.“"
                                            },
                                            {
                                                "example_id": "29149c2f-06f7-4d3e-823c-e9e3f2bd532f",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "„Wir besaßen jeder nicht weniger als dreißigtausend Fuß in den »reichsten Gruben der Erde«, wie es im wilden Kauderwelsch der Minensprache hieß - und hatten Schulden beim Metzger.“"
                                            },
                                            {
                                                "example_id": "35879291-482c-46e0-b036-78cd148b270d",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "„Soll man nun beim Jiddisch des Ostens nach wie vor von Mischsprache oder Kauderwelsch sprechen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fec66ad5-4fd9-4cb5-ba99-dcf15fd10ef6",
                        "source_entry_id": "4f5c6420-3c9b-30e7-bff5-92bd8a042771",
                        "source_sense_description": "Charabia.",
                        "target_lang_word": "sabir",
