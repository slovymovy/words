                    "semantic_group_id": "salad_dish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij het avondeten serveren we een frisse <w>sla</w> met tomaten.",
                            "target_lang_translations": {
                                "en": "At dinner we serve a fresh <w>salad</w> with tomatoes.",
                                "ru": "За ужином мы подаем свежий <w>салат</w> с помидорами.",
                                "pl": "Do kolacji podajemy świeżą <w>sałatkę</w> z pomidorami.",
                                "de": "Zum Abendessen servieren wir einen frischen <w>Salat</w> mit Tomaten.",
                                "fr": "Au dîner, nous servons une <w>salade</w> fraîche avec des tomates.",
