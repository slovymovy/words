                                        "glosses": [
                                            "besonders schön; üppig ausgestattet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "031cceca-c1aa-4a69-9b4b-0a56616cba82",
                                                "sense_id": "4976cb34-30da-3ff2-80ff-8f7773b5bb44",
                                                "text": "Unser Weihnachtsbaum war prächtig geschmückt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "16817597-83ec-3d7c-9763-f8688b7f593b",
                                        "entry_id": "2d1d0dd7-99a9-36b0-a6d9-545604ccabd5",
                                        "glosses": [
                                            "sehr gut, tüchtig"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54f9e3c9-b0be-4cdc-a220-11bc34e8ca4c",
                                                "sense_id": "16817597-83ec-3d7c-9763-f8688b7f593b",
                                                "text": "Dein prächtiger Sohn hat mir geholfen, mein Auto zu waschen."
                                            },
                                            {
                                                "example_id": "8e0f54b1-eab6-4e54-a1f7-efdc0efd724d",
                                                "sense_id": "16817597-83ec-3d7c-9763-f8688b7f593b",
                                                "text": "Er lieferte eine prächtige Vorstellung ab."
                                            },
                                            {
                                                "example_id": "64b15e0a-b2c5-425a-9252-af40cd6695c8",
                                                "sense_id": "16817597-83ec-3d7c-9763-f8688b7f593b",
                                                "text": "Bush und die Republikanische Partei verstanden es prächtig, sich als Verteidiger dieser Werte zu präsentieren. (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "7a40dda3-2ec0-4f97-aaa4-fee9801ba3bc",
                                                "sense_id": "16817597-83ec-3d7c-9763-f8688b7f593b",
                                                "text": "Mir geht es heute wieder prächtig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
