                },
                {
                    "sense_id": "b2c239b1-86e4-300a-acd0-ea2c91c13a95",
                    "sense_definition": "Rendu fou de désir ou passionnément épris de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "passion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis leur première rencontre l'été dernier, il est complètement <w>affolé</w> d'elle.",
                            "target_lang_translations": {
                                "en": "Since they first met last summer, he has been completely <w>besotted</w> with her.",
                                "ru": "С тех пор как они впервые встретились прошлым летом, он совершенно <w>влюблён</w> в неё.",
                                "de": "Seit ihrer ersten Begegnung im vergangenen Sommer ist er völlig <w>vernarrt</w> in sie.",
                                "es": "Desde que se conocieron el verano pasado, está completamente <w>enamorado</w> de ella.",
                                "zh": "自从去年夏天他们初次相遇以来，他已经对她完全<w>神魂颠倒</w>了。"
                            }
                        },
                        {
                            "text": "Ce jeune poète semblait <w>affolé</w> par la beauté fascinante de sa muse.",
                            "target_lang_translations": {
                                "en": "The young poet seemed <w>smitten</w> by the captivating beauty of his muse.",
                                "ru": "Молодой поэт, казалось, был <w>очарован</w> завораживающей красотой своей музы.",
                                "de": "Der junge Dichter wirkte von der faszinierenden Schönheit seiner Muse <w>hingerissen</w>.",
                                "es": "Ese joven poeta parecía <w>prendado</w> de la fascinante belleza de su musa.",
                                "zh": "这位年轻诗人似乎为他的缪斯那迷人的美貌而<w>痴迷</w>。"
                            }
                        }
                    ],
