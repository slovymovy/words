        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e2acf168-2cd6-3989-ab28-0a1011cf077d",
                    "sense_definition": "Of a deep reddish-brown colour.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "colour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a pair of <w>chestnut</w> boots to match her coat.",
                            "target_lang_translations": {
                                "ru": "Она купила пару <w>каштановых</w> сапог под пальто.",
                                "zh": "她买了一双<w>栗色的</w>靴子来搭配外套。"
                            }
                        },
                        {
                            "text": "The horse had a shiny <w>chestnut</w> coat that gleamed in the sun.",
