    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ca120aa3-c950-3aad-9bb6-32ce748b2cd6",
                    "sense_definition": "nasycać ciecz gazem, zwłaszcza dwutlenkiem węgla",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nasycanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tej fabryce producenci sztucznie <w>gazują</w> wodę mineralną przed rozlaniem do butelek.",
                            "target_lang_translations": {
                                "ru": "На этой фабрике производители искусственно <w>газируют</w> минеральную воду перед розливом в бутылки."
                            }
                        },
                        {
                            "text": "Kupiłem specjalny syfon, którym można samemu <w>gazować</w> soki owocowe w domu.",
                            "target_lang_translations": {
                                "ru": "Я купил специальный сифон, с помощью которого можно дома самому <w>газировать</w> фруктовые соки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gazować wodę"
                    ],
                    "target_lang_definitions": {
                        "ru": "насыщать жидкость газом, особенно углекислым"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "газировать",
                                "target_lang_sense_clarification": "насыщать жидкость газом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66d2e6a2-8d2a-3eab-a93e-2bd404bd5106",
                    "sense_definition": "przyspieszać pojazdem, mocno wciskając pedał gazu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kierowca niepotrzebnie <w>gazuje</w> przed światłami, zamiast płynnie zwolnić.",
                            "target_lang_translations": {
                                "ru": "Водитель зря <w>газует</w> перед светофором вместо того, чтобы плавно притормозить."
                            }
                        },
                        {
                            "text": "Młody chłopak <w>gazował</w> swoim starym motocyklem i hałasował w całej okolicy.",
                            "target_lang_translations": {
                                "ru": "Молодой парень <w>газовал</w> на своём старом мотоцикле и шумел на всю округу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mocno gazować"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie dodawania gazu w pojeździe"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "ускорять движение автомобиля или другого транспорта, сильно нажимая на педаль газа"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "газовать",
                                "target_lang_sense_clarification": "жать на педаль газа"
                            },
                            {
                                "target_lang_word": "поддавать газу",
                                "target_lang_sense_clarification": "ускоряться на автомобиле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "970f2401-b18b-37f5-b3c5-1726d2d6af02",
                    "sense_definition": "uśmiercać lub truć ludzi albo zwierzęta przy użyciu trującego gazu",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "trucie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W czasie wojny naziści masowo <w>gazowali</w> niewinnych ludzi w obozach zagłady.",
                            "target_lang_translations": {
                                "ru": "Во время войны нацисты массово <w>травили газом</w> невинных людей в лагерях смерти."
                            }
                        },
                        {
                            "text": "Wojska nieprzyjaciela bezwzględnie <w>gazowały</w> żołnierzy uwięzionych w podziemnych bunkrach.",
                            "target_lang_translations": {
                                "ru": "Войска противника беспощадно <w>травили газом</w> солдат, заблокированных в подземных бункерах."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "убивать или травить людей либо животных с использованием ядовитого газа"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травить газом",
                                "target_lang_sense_clarification": "убивать ядовитым газом"
                            },
                            {
                                "target_lang_word": "умерщвлять газом",
                                "target_lang_sense_clarification": "казнить с использованием газа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd0f93e8-db2f-3962-a45c-dee120e989b4",
                    "sense_definition": "stosować trujący gaz w celu zwalczania szkodników lub odkażania",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trucie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Specjaliści przez cały ranek <w>gazowali</w> magazyn zboża, aby wytępić owady.",
                            "target_lang_translations": {
                                "ru": "Специалисты всё утро <w>окуривали</w> зерновой склад, чтобы истребить насекомых."
                            }
                        },
                        {
                            "text": "Rolnicy musieli regularnie <w>gazować</w> nory gryzoni, które niszczyły uprawy warzyw.",
                            "target_lang_translations": {
                                "ru": "Фермерам приходилось регулярно <w>обрабатывать газом</w> норы грызунов, уничтожавших посевы овощей."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "обрабатывать ядовитым газом для уничтожения вредителей или дезинфекции"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окуривать",
                                "target_lang_sense_clarification": "обрабатывать газом от вредителей"
                            },
                            {
                                "target_lang_word": "фумигировать",
                                "target_lang_sense_clarification": "проводить химическую газовую обработку"
                            },
                            {
                                "target_lang_word": "газовать",
                                "target_lang_sense_clarification": "обрабатывать газом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af325654-e622-3db5-8fa4-baed96a990aa",
                    "sense_definition": "pić duże ilości alkoholu",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sąsiedzi znowu głośno <w>gazowali</w> przez całą noc i nie dali nam spać.",
                            "target_lang_translations": {
                                "ru": "Соседи снова шумно <w>бухали</w> всю ночь и не давали нам спать."
                            }
                        },
                        {
                            "text": "Zamiast przygotowywać się do egzaminu, koledzy z akademika bez przerwy <w>gazowali</w> w pokoju.",
                            "target_lang_translations": {
                                "ru": "Вместо подготовки к экзамену соседи по общежитию без продыху <w>квасили</w> в комнате."
                            }
                        }
                    ],
                    "synonyms": [
                        "chlać",
                        "tankować",
                        "żłopać"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "potoczne lub slangowe określenie picia alkoholu"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "употреблять алкоголь в больших количествах"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бухать",
                                "target_lang_sense_clarification": "много пить алкоголя, разг."
                            },
                            {
                                "target_lang_word": "квасить",
                                "target_lang_sense_clarification": "пьянствовать, разг."
                            },
                            {
                                "target_lang_word": "глушить",
                                "target_lang_sense_clarification": "пить алкоголь в больших количествах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "110cb803-5ee2-3842-8595-721768eef987",
                    "sense_definition": "szybko biec lub spieszyć się dokądś",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Spóźniony uczeń <w>gazował</w> ile sił w nogach prosto w stronę przystanku autobusowego.",
                            "target_lang_translations": {
                                "ru": "Опоздавший ученик изо всех сил <w>гнал</w> прямо к автобусной остановке."
                            }
                        },
                        {
                            "text": "Gdy tylko usłyszał dzwonek, zaczął szybko <w>gazować</w> przez korytarz do sali.",
                            "target_lang_translations": {
                                "ru": "Как только он услышал звонок, он со всех ног <w>помчал</w> по коридору в класс."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "środowiskowe, potoczne określenie szybkiego biegu"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "быстро бежать или очень спешить куда-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнать",
                                "target_lang_sense_clarification": "очень быстро бежать или мчаться, разг."
                            },
                            {
                                "target_lang_word": "мчать",
                                "target_lang_sense_clarification": "быстро нестись"
                            },
                            {
                                "target_lang_word": "лететь",
                                "target_lang_sense_clarification": "стремительно бежать или спешить"
                            }
                        ]
                    }
                }
            ]
        }
    ]
