                "senses": [
                    {
                        "sense_id": "1deb4ea9-b00d-38b6-93d8-66d2cbd2acd1",
                        "entry_id": "de1ad74a-9f8c-3570-96d0-286690a3d6d0",
                        "glosses": [
                            "Person, die sich für Klimaneutralität einsetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1633b090-ffe8-4a0b-96c3-ecc29604017a",
                                "sense_id": "1deb4ea9-b00d-38b6-93d8-66d2cbd2acd1",
                                "text": "„Der neue Klimaheld Macron gründet seinen Ruhm auf Atomstrom.“"
                            },
                            {
                                "example_id": "295563d3-d9bb-47a6-9566-d0fe95062dfa",
                                "sense_id": "1deb4ea9-b00d-38b6-93d8-66d2cbd2acd1",
                                "text": "„So könnten alle Klimahelden sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b75726df-efd3-36e1-a812-977d3d7d1cea",
                        "entry_id": "de1ad74a-9f8c-3570-96d0-286690a3d6d0",
                        "glosses": [
                            "Lebewesen oder Vegetation mit klimaneutraler Eigenschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c436dec2-4f37-409f-a544-e9a105ed22d7",
                                "sense_id": "b75726df-efd3-36e1-a812-977d3d7d1cea",
                                "text": "„Moore sind nicht nur als Klimahelden schützenswert“"
                            },
                            {
                                "example_id": "5e737107-1107-4c47-9476-d3f576fbe8d1",
                                "sense_id": "b75726df-efd3-36e1-a812-977d3d7d1cea",
                                "text": "„Natur hautnah erleben: Schüler lernen den Wald als Klimahelden kennen“"
                            },
                            {
                                "example_id": "63ae7d75-cacb-44b0-a217-2b264df94439",
                                "sense_id": "b75726df-efd3-36e1-a812-977d3d7d1cea",
                                "text": "„Aber fast nirgends werden Tiere thematisiert – dabei gibt es einige Arten, die richtige Klimahelden sind.“"
                            },
                            {
                                "example_id": "ecbe77ae-2671-47b3-be9c-e99e3f318872",
                                "sense_id": "b75726df-efd3-36e1-a812-977d3d7d1cea",
                                "text": "„Was die Wisente laut Yale-Ökologe Oswald Schmitz zu »Klimahelden« macht, sei klar: Die Ökosysteme von Wald und Grasland gediehen durch das gleichmäßige Grasen der umherziehenden Herde besser.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
