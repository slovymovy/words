                    {
                        "translation_id": "f8321c52-64fd-4c31-8249-ccbf880e0293",
                        "source_entry_id": "6792d115-147d-391e-9876-88348e091c8d",
                        "source_sense_id": "d6ec98c4-0f43-387d-b25d-42bdefc9d8a2",
                        "target_lang_word": "Fieber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fieber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a56ea4b-adc0-3deb-affa-d4de1e387772",
                                        "entry_id": "d83c842a-d20f-3f78-8b01-65ba2986b4c4",
                                        "glosses": [
                                            "Erhöhung der Körpertemperatur im Krankheitsfall; Schutzreaktion des Körpers, um Krankheitserreger abzutöten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc445aae-3f94-434c-bbc5-c746c15fc96f",
                                                "sense_id": "7a56ea4b-adc0-3deb-affa-d4de1e387772",
                                                "text": "Er lag mit 40 (Grad) Fieber im Bett."
                                            },
                                            {
                                                "example_id": "cb210baa-675b-4dd0-b2c9-49ccfed070a9",
                                                "sense_id": "7a56ea4b-adc0-3deb-affa-d4de1e387772",
                                                "text": "Der Krankheitsverlauf ging mit Fieber einher."
                                            },
                                            {
                                                "example_id": "c4387275-45fc-45c8-aabc-020bcc1154b9",
                                                "sense_id": "7a56ea4b-adc0-3deb-affa-d4de1e387772",
                                                "text": "„Das Fieber stieg noch immer und hatte schon fast einundvierzig Grad erreicht.“"
                                            },
                                            {
                                                "example_id": "d74323e8-aa07-4c5b-a01d-090909e5d4cd",
                                                "sense_id": "7a56ea4b-adc0-3deb-affa-d4de1e387772",
                                                "text": "„Das Fieber ließ sich senken.“"
                                            },
                                            {
                                                "example_id": "ba1ba792-46ef-4f81-ac4c-40ae540f4079",
                                                "sense_id": "7a56ea4b-adc0-3deb-affa-d4de1e387772",
                                                "text": "„Josianne litt immer noch unter Schlafstörungen, Angel klagte über Fieber und Jacques sah blass und müde aus.“"
                                            },
                                            {
                                                "example_id": "bbec7fb1-8d09-492e-b4a4-52c4323a0adb",
                                                "sense_id": "7a56ea4b-adc0-3deb-affa-d4de1e387772",
                                                "text": "„Der Schmerz wächst, ich bekomme heftiges Fieber bis zum Schüttelfrost, eine Lähmung tritt hinzu, die die linke Körperseite erfaßt; ich kann meinen Arm nicht mehr bewegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1fc95d41-f640-372e-9b28-99a1763ae90c",
                                        "entry_id": "d83c842a-d20f-3f78-8b01-65ba2986b4c4",
                                        "glosses": [
                                            "Erregung, Anspannung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "889bad0e-4db9-44bd-83ca-c722518b984e",
                                                "sense_id": "1fc95d41-f640-372e-9b28-99a1763ae90c",
                                                "text": "Er reagierte wie im Fieber."
                                            },
                                            {
                                                "example_id": "d3258e02-f344-437d-84e8-fa9982251d35",
                                                "sense_id": "1fc95d41-f640-372e-9b28-99a1763ae90c",
                                                "text": "Kaum sah sie den Rouletttisch, erfasste sie wieder dieses altbekannte Fieber."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
