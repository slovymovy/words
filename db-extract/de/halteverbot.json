                    {
                        "form_id": "5687afa2-d106-4e76-b064-333f9ca6b4b0",
                        "entry_id": "a6a02a64-86a2-32db-b29c-966775db6e32",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Halteverbote"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3387d838-e66c-3c84-8df9-1af5d00becf9",
                        "entry_id": "a6a02a64-86a2-32db-b29c-966775db6e32",
                        "glosses": [
                            "Ort beziehungsweise Zone, wo ein Fahrzeug oder Anhänger nicht zum Halten oder Parken abgestellt werden darf"
                        ],
                        "tags": [
                            "Verkehr"
                        ],
                        "examples": [
                            {
                                "example_id": "6a7ef974-1740-4941-a4e7-452493c392c5",
                                "sense_id": "3387d838-e66c-3c84-8df9-1af5d00becf9",
                                "text": "Vor der Feuerwehrzufahrt herrscht absolutes Halteverbot."
                            },
                            {
                                "example_id": "a0008c6a-fd4e-43ce-85ac-21cdbdfb5f36",
                                "sense_id": "3387d838-e66c-3c84-8df9-1af5d00becf9",
                                "text": "„Zeitweilige Ausnahmen vom Halteverbot werden mit der Zusatztafel «Ausnahmen vom Halteverbot» (5.10), zeitweilige Ausnahmen vom Parkierungsverbot mit der Zusatztafel «Ausnahmen vom Parkierungsverbot» (5.11) angezeigt.“"
                            },
                            {
                                "example_id": "174bcfa3-160e-4bc4-ad02-3ea52ad83c35",
                                "sense_id": "3387d838-e66c-3c84-8df9-1af5d00becf9",
                                "text": "„Im Bereich des […] Halteverbotes sowie im Bereich einer Ladezone […] oder eines Taxistandplatzes […] darf zum Aus- oder Einsteigen kurz gehalten werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "25c3d9aa-e3f7-338d-bdfc-d4e7b85646af",
                        "entry_id": "a6a02a64-86a2-32db-b29c-966775db6e32",
                        "glosses": [
                            "das Verbot, mit Fahrzeugen zu halten"
                        ],
                        "tags": [
                            "Verkehr"
                        ],
                        "examples": [
                            {
                                "example_id": "3084afa6-e8d7-4105-bd45-900e408d85cd",
                                "sense_id": "25c3d9aa-e3f7-338d-bdfc-d4e7b85646af",
                                "text": "Sie missachten das Halteverbot."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "a98575a7-1272-3db5-9543-bb1d36346d4b",
                        "entry_id": "a6a02a64-86a2-32db-b29c-966775db6e32",
                        "glosses": [
                            "das Verbot, Tiere zu halten"
                        ],
                        "tags": [
                            "Tiere"
                        ],
                        "examples": [
                            {
                                "example_id": "6b60643b-0509-4a14-ab21-e41e04de6099",
                                "sense_id": "a98575a7-1272-3db5-9543-bb1d36346d4b",
                                "text": "In diesem Haus besteht ein Halteverbot für Hunde."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ad75b93-5d87-4129-b1df-0006ea8ec06c",
                        "source_entry_id": "a6a02a64-86a2-32db-b29c-966775db6e32",
                        "source_sense_id": "3387d838-e66c-3c84-8df9-1af5d00becf9",
                        "source_sense_description": "Ort beziehungsweise Zone",
                        "target_lang_word": "clearway",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clearway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26bff1da-e6b1-335b-bb86-82df9d5e8a1d",
                                        "entry_id": "45b4119f-b2ce-3bf6-9e35-531ac36a73c9",
                                        "glosses": [
                                            "A road or other path that is kept free of obstructions, or on which stopping is strictly regulated, in order to maintain free flow of movement."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95af2f06-5cc5-4fe1-9c44-ab394e0a509c",
                                                "sense_id": "26bff1da-e6b1-335b-bb86-82df9d5e8a1d",
                                                "text": "The traffic lanes of the sea can be clearways for thousands of miles."
                                            },
                                            {
                                                "example_id": "1ba48fc8-33c7-4b36-b8d1-1cc01d9131bc",
                                                "sense_id": "26bff1da-e6b1-335b-bb86-82df9d5e8a1d",
                                                "text": "The red cross means no stopping, not even to pick up or set down passengers. The sign is used to indicate a 24-hour clearway (usually on a rural road) or may be incorporated into other signs with the words “No stopping” (e.g. the “no stopping except local buses” sign at bus stops. On a 24-hour clearway, the prohibition of stopping applies only to the main carriageway. You may stop in a lay-by unless there are signs to say otherwise. A 24-hour clearway does not have any special road markings, but there should be smaller repeater signs at approximately one mile intervals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eea34b8b-1dba-365c-8a17-fbc47f72e219",
                                        "entry_id": "45b4119f-b2ce-3bf6-9e35-531ac36a73c9",
                                        "glosses": [
                                            "An area projecting from the end of a runway that is kept clear of obstructions exceeding a height that increases with distance from the end of the runway."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b5a26fe-c605-469d-ae97-0976e2b7cdf7",
                                                "sense_id": "eea34b8b-1dba-365c-8a17-fbc47f72e219",
                                                "text": "A clearway may be provided to extend the takeoff distance available (TODA) beyond the end of the hard surface which defines the declarable length of the available takeoff run (TORA)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
