                    "sense_id": "560c5d19-0256-346e-ba97-b6240f1999ec",
                    "sense_definition": "Items worn to cover the body, such as shirts, pants, and dresses.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "apparel_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to buy some new <w>clothes</w> for the winter.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить новую <w>одежду</w> на зиму.",
                                "nl": "Ik moet wat nieuwe <w>kleren</w> kopen voor de winter.",
                                "pl": "Muszę kupić nowe <w>ubrania</w> na zimę.",
                                "de": "Ich muss mir ein paar neue <w>Kleider</w> für den Winter kaufen.",
                                "fr": "J'ai besoin d'acheter de nouveaux <w>vêtements</w> pour l'hiver.",
                                "it": "Devo comprare dei <w>vestiti</w> nuovi per l'inverno.",
                                "cs": "Potřebuji si koupit nějaké nové <w>oblečení</w> na zimu.",
                                "tr": "Kış için yeni <w>kıyafetler</w> almam gerekiyor.",
                                "es": "Necesito comprar algo de <w>ropa</w> nueva para el invierno."
                            }
                        },
                        {
                            "text": "She changed her <w>clothes</w> as soon as she got home from work.",
                            "target_lang_translations": {
                                "ru": "Она сменила <w>одежду</w>, как только вернулась домой с работы.",
                                "nl": "Ze trok andere <w>kleren</w> aan zodra ze thuiskwam van haar werk.",
                                "pl": "Zmieniła <w>ubranie</w>, jak tylko wróciła z pracy do domu.",
                                "de": "Sie zog ihre <w>Kleidung</w> um, sobald sie von der Arbeit nach Hause kam.",
                                "fr": "Elle a changé de <w>vêtements</w> dès qu'elle est rentrée du travail.",
                                "it": "Si è cambiata i <w>vestiti</w> non appena è tornata a casa dal lavoro.",
                                "cs": "Jakmile přišla domů z práce, převlékla si <w>šaty</w>.",
                                "tr": "İşten eve gelir gelmez <w>üstünü</w> değiştirdi.",
                                "es": "Se cambió de <w>ropa</w> tan pronto como llegó a casa del trabajo."
                            }
                        }
                    ],
