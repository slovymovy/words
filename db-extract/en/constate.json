                    },
                    {
                        "sense_id": "73656f08-2b9e-3a93-9c86-9f654f432394",
                        "entry_id": "b675a477-7f2b-304a-b4c6-77998434209c",
                        "glosses": [
                            "To ascertain; to verify; to establish; to prove."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c13862d-7e27-49d8-8c4f-fa133734a557",
                                "sense_id": "73656f08-2b9e-3a93-9c86-9f654f432394",
                                "text": "It need be no concern of his how we come, through the joint action of our double nature, to apprehend at first those truths which, when apprehended, he knows to be necessary. The metaphysician has only to constate such facts ; it is the business of the psychologist to explain them."
                            },
                            {
                                "example_id": "68f793f1-514b-48a8-81fc-42a75ce80708",
                                "sense_id": "73656f08-2b9e-3a93-9c86-9f654f432394",
                                "text": "Above all, he has thought himself able to constate a preparoxysmal increase of albumin, from which he has drawn far-reaching conclusions."
                            }
                        ]
                    }
