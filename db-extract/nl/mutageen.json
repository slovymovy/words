                                "target_senses": [
                                    {
                                        "sense_id": "12fb5d00-6ae1-30ed-aafe-df78580b64e0",
                                        "entry_id": "8c1d39e0-3b7c-3399-af0f-af15427fd399",
                                        "glosses": [
                                            "Capable of causing mutation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8346d01-5989-46b4-b2cb-d6e5918c41fe",
                                                "sense_id": "12fb5d00-6ae1-30ed-aafe-df78580b64e0",
                                                "text": "Would it help to say that we misunderestimated the effects of Frankenfood and mutagenic smog, to speculate that amid all our infornography and anticipointment, some crisitunity slumbered unnoticed in a roadside motel?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59d6fc4c-bf79-3278-8ac7-f4872da6003c",
                                        "entry_id": "8c1d39e0-3b7c-3399-af0f-af15427fd399",
                                        "glosses": [
                                            "Relating to mutagenesis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e2e919d-b1fd-45ff-9682-c0d71d6be432",
                                                "sense_id": "59d6fc4c-bf79-3278-8ac7-f4872da6003c",
                                                "text": "For the antimutagenicity evaluation, the same doses of CPN employed in the mutagenic evaluation were co-treated with their respective positive controls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
