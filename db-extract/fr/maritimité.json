                "senses": [
                    {
                        "sense_id": "6880d759-0fba-30c4-9485-6d93446ef49b",
                        "entry_id": "08de9782-bb97-3d3f-9fc6-8359bcf80800",
                        "glosses": [
                            "Ensemble des manières dont une société humaine perçoit, représente et s’approprie la mer. Regroupe un ensemble de relations économiques, culturelles, récréatives et sportives entre les sociétés et la mer."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "486442fc-be72-453a-b571-be775d16556b",
                                "sense_id": "6880d759-0fba-30c4-9485-6d93446ef49b",
                                "text": "Un pan des études sur la maritimité se concentre sur les « gens de la mer » (Rieucau, 1989), pêcheurs, marins, sauveteurs, gardiens de phare."
                            },
                            {
                                "example_id": "d5720f01-913e-4f14-8d46-f40885313d25",
                                "sense_id": "6880d759-0fba-30c4-9485-6d93446ef49b",
                                "text": "Une nouvelle maritimité émerge avec des nouvelles pratiques sociales : croissance des sports nautiques et de glisse, tourisme maritime et reconquête urbaine des espaces portuaires délaissés (friches portuaires)."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6dc957f-bca4-35aa-88ae-6b4992629bce",
                        "entry_id": "08de9782-bb97-3d3f-9fc6-8359bcf80800",
                        "glosses": [
                            "Degré de dépendance d'un Etat ou d'une région à la mer."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "72276f4d-b2eb-430c-8ade-b948df6eada3",
                                "sense_id": "c6dc957f-bca4-35aa-88ae-6b4992629bce",
                                "text": "La notion de maritimité est parfois également utilisée lorsqu’il se réfère à un Etat ou une région afin d’exprimer « le degré de dépendance au fait maritime d’un espace donné."
                            }
                        ]
                    }
                ],
