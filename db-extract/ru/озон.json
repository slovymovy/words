                    {
                        "translation_id": "265629b2-845e-4fe6-b4bb-103368601c75",
                        "source_entry_id": "5356d46f-f47d-388c-810b-82572a56dce1",
                        "source_sense_id": "c6c6a79e-5c15-3f14-81fb-ec51a45d02f5",
                        "target_lang_word": "Ozon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ozon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5352d95-d0c4-3ff0-9605-559cd7c1c99b",
                                        "entry_id": "d43ee71b-6128-3d33-99e8-3e72af89fd91",
                                        "glosses": [
                                            "farblose, aggressive, giftige Verbindung aus drei Sauerstoffatomen, die sich durch UV-Strahlung oder elektrische Entladung in der Luft bildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a047d258-b7cc-4852-bcfc-63975a8957ec",
                                                "sense_id": "b5352d95-d0c4-3ff0-9605-559cd7c1c99b",
                                                "text": "Ozon spielt in der Stratosphäre eine wichtige Rolle beim Filtern von UV-Strahlen."
                                            },
                                            {
                                                "example_id": "742e2ae2-31d4-4e08-9fdc-9605774ed58f",
                                                "sense_id": "b5352d95-d0c4-3ff0-9605-559cd7c1c99b",
                                                "text": "„In der Atmosphäre ist Ozon unterschiedlich verteilt und spielt somit im Klimakreislauf verschiedene Rollen.“"
                                            },
                                            {
                                                "example_id": "c36c8d6d-14f2-4028-8db6-70e88478554a",
                                                "sense_id": "b5352d95-d0c4-3ff0-9605-559cd7c1c99b",
                                                "text": "„Das ultraviolette Licht eines eingeschalteten Solariums spaltet kleine Mengen Sauerstoff der atmosphärischen Luft und bildet das instabile Ozon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4fa4f357-dcdb-3f56-8bae-15bca3e9c53c",
                                        "entry_id": "d43ee71b-6128-3d33-99e8-3e72af89fd91",
                                        "glosses": [
                                            "frische Luft"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98692808-7593-4d60-8ff8-19a8f6c4fa99",
                                                "sense_id": "4fa4f357-dcdb-3f56-8bae-15bca3e9c53c",
                                                "text": "„Das ist der fast im Raum verlorene Laut, der kosmische Ozon eines anderen Stückes, worin Geister in goldenen Kähnen den himmlischen See befahren und der klingende Lauf glänzender Lieder sich niederringelt, - hinauf wallt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
