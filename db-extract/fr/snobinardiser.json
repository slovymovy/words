                "senses": [
                    {
                        "sense_id": "1a2e4a18-c5ad-364c-8b42-74e3407ef91f",
                        "entry_id": "248c7607-5a0e-33b3-a3ea-01d0f88628f8",
                        "glosses": [
                            "Donner un caractère snobinard à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33ccd600-a621-4849-83c4-f04d2b479df9",
                                "sense_id": "1a2e4a18-c5ad-364c-8b42-74e3407ef91f",
                                "text": "Les « Artusans » jouent ce qu’ils sont, sans tricher, et sans chercher à servir la soupe à ceux qui voudraient juste s’encanailler dans le folklore gascon ou encore se snobinardiser la tronche avec des sons « âââcthuueells »."
                            },
                            {
                                "example_id": "5f203434-269e-4ebc-92f8-adfeb6d9db28",
                                "sense_id": "1a2e4a18-c5ad-364c-8b42-74e3407ef91f",
                                "text": "Puis tu finis par te snobinardiser ailleurs quoi."
                            },
                            {
                                "example_id": "4c6367e1-6ac9-4351-a23c-6e50ae166df1",
                                "sense_id": "1a2e4a18-c5ad-364c-8b42-74e3407ef91f",
                                "text": "Et puis, de toute façon, je trouve que l'édition jeunesse a une légère tendance à bêtifier et quand elle veut faire un succès à se snobinardiser, héhé !"
                            }
                        ]
                    }
                ],
