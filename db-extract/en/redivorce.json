                        "entry_id": "1231bffc-d661-322e-bedf-b2b25bef0e8e",
                        "glosses": [
                            "A divorce that terminates a remarriage."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "41b3d0ea-32d7-4fc1-adc5-17b1243b32df",
                                "sense_id": "e8ff504c-e0dc-3f60-9127-ac95b7ccab3e",
                                "text": "Further, although the remarriage rate for whites is higher, redivorce among them also is more common (Glick, 1980)."
                            },
                            {
                                "example_id": "4337a042-d745-4cd6-9ebe-7731b21dd9f1",
                                "sense_id": "e8ff504c-e0dc-3f60-9127-ac95b7ccab3e",
                                "text": "Past increases in the number of remarriages after divorce have led to increases in the number of couples subject to ending a marriage through the redivorce of at least one of the partners."
                            },
                            {
                                "example_id": "7dfb978f-428d-4d84-a399-8987fdf1c31c",
                                "sense_id": "e8ff504c-e0dc-3f60-9127-ac95b7ccab3e",
                                "text": "Upon redivorce, the in loco parentis relationship is considered terminated."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
