                "senses": [
                    {
                        "sense_id": "e0f88f42-f30c-33ae-844e-21098f9e9c06",
                        "entry_id": "28a98aee-49a2-37f5-a174-59de58abe6ff",
                        "glosses": [
                            "Abouché, joint par les bouts."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ff3c7702-40e2-3815-abe7-ae279f141e99",
                        "entry_id": "28a98aee-49a2-37f5-a174-59de58abe6ff",
                        "glosses": [
                            "Qualifie des structures connectées entre elles ou la structure globale ainsi formée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7fca46b-17a2-46ca-aa4c-2356a3a2496c",
                                "sense_id": "ff3c7702-40e2-3815-abe7-ae279f141e99",
                                "text": "Gousse ornée […] de nervures anastomosées […]"
                            },
                            {
                                "example_id": "f1d0e9f1-87c9-4091-bb41-dea0278a737e",
                                "sense_id": "ff3c7702-40e2-3815-abe7-ae279f141e99",
                                "text": "Deux types d’hyphes individualisées émergentes peuvent être identifiées en microscopie électronique […] des hyphes de formes tubulaires, à paroi épaisse et rigide, et des hyphes anastomosées à paroi plus fines réalisant des formes aplaties."
                            },
                            {
                                "example_id": "c8d2a8c3-2f12-4d7d-9113-8ab13e166eca",
                                "sense_id": "ff3c7702-40e2-3815-abe7-ae279f141e99",
                                "text": "Les pertes de la Loire dans le Val d’Orléans créent parfois des vortex en surface. En moyenne, environ 12 m³/s rejoindront la nappe des calcaires de Beauce sous-jacents pour emprunter un réseau karstique anastomosé dont une partie alimente les sources du Loiret."
                            },
                            {
                                "example_id": "f5dc8559-6cc4-448a-9d46-3d38dc7a0891",
                                "sense_id": "ff3c7702-40e2-3815-abe7-ae279f141e99",
                                "text": "Les membres de la cité se tiennent comme les cellules d'un organisme. L'habitude, servie par l'intelligence et l'imagination, introduit parmi eux une discipline qui imite de loin, par la solidarité qu'elle établit entre les individualités distinctes, l'unité d'un organisme aux cellules anastomosées."
                            }
                        ]
                    }
