                "translations": [
                    {
                        "translation_id": "7132fe2b-2b35-46c9-8218-5aedbac87f9b",
                        "source_entry_id": "00e6b24b-5fea-3991-9488-a788385d3a85",
                        "source_sense_id": "4d38eb24-5988-3eaa-a09d-b3e17b8e12a4",
                        "target_lang_word": "dizzy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dizzy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94734891-e8f5-3e19-8f98-2d55c3613996",
                                        "entry_id": "04cc668a-444c-3149-b123-6d9e797ebe8e",
                                        "glosses": [
                                            "Experiencing a sensation of whirling and of being giddy, unbalanced, or lightheaded."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd26e9d2-721a-45e8-a587-82b8337c56d0",
                                                "sense_id": "94734891-e8f5-3e19-8f98-2d55c3613996",
                                                "text": "I stood up too fast and felt dizzy."
                                            },
                                            {
                                                "example_id": "42defd1d-4c8b-4b55-84f4-2b51b3d845df",
                                                "sense_id": "94734891-e8f5-3e19-8f98-2d55c3613996",
                                                "text": "Alas! his brain was dizzy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "806f8d78-fc03-3783-ad07-68dbd6a41b9d",
                                        "entry_id": "04cc668a-444c-3149-b123-6d9e797ebe8e",
                                        "glosses": [
                                            "Producing giddiness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d8b2c1a-6b48-4c31-a8f1-df5fcda8fc50",
                                                "sense_id": "806f8d78-fc03-3783-ad07-68dbd6a41b9d",
                                                "text": "We climbed to a dizzy height."
                                            },
                                            {
                                                "example_id": "4b7c6620-c267-4c53-bbdb-d79365f7f9da",
                                                "sense_id": "806f8d78-fc03-3783-ad07-68dbd6a41b9d",
                                                "text": "To climb from the brink of Fleet Ditch by a dizzy ladder."
                                            },
                                            {
                                                "example_id": "82d45ee8-8ecb-493f-b6bf-65e41ea22f52",
                                                "sense_id": "806f8d78-fc03-3783-ad07-68dbd6a41b9d",
                                                "text": "...faintly from the valley far below came an unmistakable sound which brought me to my feet, trembling with excitement, to peer eagerly downward from my dizzy ledge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "135bc3e5-95a0-310c-ac3c-876d95c9c7cb",
                                        "entry_id": "04cc668a-444c-3149-b123-6d9e797ebe8e",
                                        "glosses": [
                                            "Empty-headed, scatterbrained or frivolous; ditzy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccef5170-871e-4bf6-9db6-d8f2c2572fc9",
                                                "sense_id": "135bc3e5-95a0-310c-ac3c-876d95c9c7cb",
                                                "text": "My new secretary is a dizzy blonde."
                                            },
                                            {
                                                "example_id": "be9dafba-8790-4c51-8f0a-ce9c3109091e",
                                                "sense_id": "135bc3e5-95a0-310c-ac3c-876d95c9c7cb",
                                                "text": "the dizzy multitude"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "965dbe0a-44c7-3c62-bd10-ae084d19055f",
                                        "entry_id": "04cc668a-444c-3149-b123-6d9e797ebe8e",
                                        "glosses": [
                                            "simple, half-witted."
                                        ],
                                        "tags": [
                                            "UK",
                                            "Yorkshire",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0264bb0b-86a2-4d4e-9b68-de665c7db825",
                                                "sense_id": "965dbe0a-44c7-3c62-bd10-ae084d19055f",
                                                "text": "Them as diz ’at is dizzy.",
                                                "translation": "Those who do that are half-witted.",
                                                "english": "Those who do that are half-witted."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dizzy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8d66a7d-7891-386c-a3ba-540e55650ef8",
                                        "entry_id": "070d8b67-cd52-3830-b748-447694344b8b",
                                        "glosses": [
                                            "To make (someone or something) dizzy; to bewilder."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c52492c-6447-48d4-bc7e-ffcd9369af4e",
                                                "sense_id": "d8d66a7d-7891-386c-a3ba-540e55650ef8",
                                                "text": "Let me have this violence and compulsion removed, there is nothing that, in my seeming, doth more bastardise and dizzie a wel-borne and gentle nature […]"
                                            },
                                            {
                                                "example_id": "59df24bb-b719-4d3b-85d7-2dec449ff6aa",
                                                "sense_id": "d8d66a7d-7891-386c-a3ba-540e55650ef8",
                                                "text": "If the jangling of thy bells had not dizzied thy understanding."
                                            },
                                            {
                                                "example_id": "bebd8db4-d94e-4d3f-a8fd-6358ec4d88f6",
                                                "sense_id": "d8d66a7d-7891-386c-a3ba-540e55650ef8",
                                                "text": "So ramshackle was the locals' attempt at defence that, with energetic wingers pouring into the space behind panicked full-backs and centre-halves dizzied by England's movement, it was cruel to behold at times. The contest did not extend beyond the half-hour mark."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dizzy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03b0f8f8-0226-31b5-9d9d-e18a5208d558",
                                        "entry_id": "812b57a5-eb21-34b6-925b-fd4da8906f0c",
                                        "glosses": [
                                            "A distributor (device in internal combustion engine)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd795898-bf5f-46dd-9573-9eaca355c76c",
                                                "sense_id": "03b0f8f8-0226-31b5-9d9d-e18a5208d558",
                                                "text": "A service exchange distributor usually needs to be ordered by a motor factor and cost £150-200! I would suggest you use the SD1 dizzy body/cap etc but change the trigger mechanism to a modern electronic/breakerless unit such as the Newtronic unit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
