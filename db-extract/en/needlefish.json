                ],
                "translations": [
                    {
                        "translation_id": "5e3691dc-bfdd-4e91-a4b7-f204bcca7e57",
                        "source_entry_id": "e118c8e2-9ae1-3081-b968-80e480b785e8",
                        "source_sense_id": "5dab4f17-3c98-3f98-92ba-01344c820151",
                        "source_sense_description": "slender fish",
                        "target_lang_word": "aiguillette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aiguillette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d8d6a5c-3383-339a-9359-522160ec92e6",
                                        "entry_id": "f23cc349-34fe-3cd7-99a6-0c914896038f",
                                        "glosses": [
                                            "Petite aiguille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f24ba349-fa67-4640-a789-1ba4672c436e",
                                                "sense_id": "1d8d6a5c-3383-339a-9359-522160ec92e6",
                                                "text": "À l'instant où je me penche à la fenêtre de cette chambre d'hôtel sous les toits, face à la cathédrale de Strasbourg et à ses aiguillettes vieux rose qui se haussent du col, je vois une souris courir dans la gouttière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecdf582d-bfab-3c42-bef4-2756a8bb82a3",
                                        "entry_id": "f23cc349-34fe-3cd7-99a6-0c914896038f",
                                        "glosses": [
                                            "Cordon, ruban, etc., ferré par les deux bouts, pour servir à attacher, mais qui ne sert quelquefois que d’ornement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b064dfa9-7de3-4854-a308-164d4289bd6c",
                                                "sense_id": "ecdf582d-bfab-3c42-bef4-2756a8bb82a3",
                                                "text": "Abraham Knupfer distingue son chapeau à trois cornes, ses aiguillettes de laine rouge, sa cocarde traversée d’une ganse, et sa queue nouée d’un ruban."
                                            },
                                            {
                                                "example_id": "2dd520e7-5b73-4c8a-91ef-1f0c7c7f445f",
                                                "sense_id": "ecdf582d-bfab-3c42-bef4-2756a8bb82a3",
                                                "text": "Ces vieilles bandes, muettes et brillantes, offraient mille contrastes de couleurs dus à la diversité des uniformes, des parements, des armes et des aiguillettes."
                                            },
                                            {
                                                "example_id": "d3e34e95-4abc-4567-b25e-18b6d213ec70",
                                                "sense_id": "ecdf582d-bfab-3c42-bef4-2756a8bb82a3",
                                                "text": "Quand je m’ennuyais par trop dans cette ville sans mouvement, sans intérêt et sans vie, je me mettais en grande tenue, — toutes aiguillettes dehors, — et l’ennui fuyait devant mon hausse-col !"
                                            },
                                            {
                                                "example_id": "593907e7-3f0c-4bea-94ec-e4758a26f76f",
                                                "sense_id": "ecdf582d-bfab-3c42-bef4-2756a8bb82a3",
                                                "text": "En un clin d’œil La Mole écarta les aiguillettes de son pourpoint, et tira de sa poitrine une lettre enfermée dans une enveloppe de soie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b51287b-2b30-39ca-b721-af5b8780efd7",
                                        "entry_id": "f23cc349-34fe-3cd7-99a6-0c914896038f",
                                        "glosses": [
                                            "Morceau de la peau ou de la chair coupés en long, en parlant d’une volaille."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94b70006-0c56-4ec1-8de4-886384ca6a83",
                                                "sense_id": "6b51287b-2b30-39ca-b721-af5b8780efd7",
                                                "text": "Couper un canard par aiguillettes."
                                            },
                                            {
                                                "example_id": "ce263a7a-5b84-4330-b96d-890aa718abcc",
                                                "sense_id": "6b51287b-2b30-39ca-b721-af5b8780efd7",
                                                "text": "Découper adroitement en faisant des aiguillettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caf16196-879a-386d-9d9d-2d4e8240c47d",
                                        "entry_id": "f23cc349-34fe-3cd7-99a6-0c914896038f",
                                        "glosses": [
                                            "Viande de bœuf de première catégorie."
                                        ],
                                        "tags": [
                                            "Boucherie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cdc864c-2de4-4123-828c-ed4d52b2758b",
                                                "sense_id": "caf16196-879a-386d-9d9d-2d4e8240c47d",
                                                "text": "L’aiguillette de romsteck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecfe48a0-28b8-38ba-ab43-8750cdbd2faa",
                                        "entry_id": "f23cc349-34fe-3cd7-99a6-0c914896038f",
                                        "glosses": [
                                            "Petit cordage d’une certaine longueur, servant à aiguilleter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2293f22d-424f-42ce-abb8-5d62604ce1c6",
                                                "sense_id": "ecfe48a0-28b8-38ba-ab43-8750cdbd2faa",
                                                "text": "Aiguillettes de culasse, etc."
                                            },
                                            {
                                                "example_id": "8cef3b0d-90c3-4d74-bce7-0564453b0fff",
                                                "sense_id": "ecfe48a0-28b8-38ba-ab43-8750cdbd2faa",
                                                "text": "Aiguillettes d’amarrage."
                                            },
                                            {
                                                "example_id": "bb517339-ae62-4bdc-b114-66f671176bfc",
                                                "sense_id": "ecfe48a0-28b8-38ba-ab43-8750cdbd2faa",
                                                "text": "Aiguillettes de bouées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2e814a2-b701-3051-880f-f9cc9069a69f",
                                        "entry_id": "f23cc349-34fe-3cd7-99a6-0c914896038f",
                                        "glosses": [
                                            "Bélonidé ou orphie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89d401e7-e56c-4e3e-b5aa-fb219d4191aa",
                                                "sense_id": "f2e814a2-b701-3051-880f-f9cc9069a69f",
                                                "text": "On pêche aussi anchois, maquereau, rouget, aiguillette et dorade en été."
                                            },
                                            {
                                                "example_id": "7fd81a05-7e29-45e6-ac2c-be3c1f4faf3d",
                                                "sense_id": "f2e814a2-b701-3051-880f-f9cc9069a69f",
                                                "text": "Des lieus, des chinchards, des aiguillettes, parfois des maquereaux, des bars…"
                                            }
                                        ]
                                    }
                                ]
                            },
