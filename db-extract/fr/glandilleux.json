                        "examples": [
                            {
                                "example_id": "031e3381-f28c-4ae4-99d9-911b00bc0017",
                                "sense_id": "68c6d1fb-6285-3576-a357-cb74a487e662",
                                "text": "À ce compte, mieux valait qu’il s'en mêle pour éviter la casse, les initiatives glandilleuses, les opérations suicide."
                            },
                            {
                                "example_id": "3f675daa-1b7f-4d6d-8b40-7307e987bc5a",
                                "sense_id": "68c6d1fb-6285-3576-a357-cb74a487e662",
                                "text": "Dans ce parcours glandilleux le vieux griffait une thune par gramme, cinquante sacs qu’il ne permettrait à personne de lui contester, pas même de lui reprocher."
                            },
                            {
                                "example_id": "2aba3ab8-41f3-439d-8756-bc98ff4205ad",
                                "sense_id": "68c6d1fb-6285-3576-a357-cb74a487e662",
                                "text": "Avec Rachel, elle était devant un cas glandilleux. Elle se rendait compte que ses sentiments envers le petit Jésus n’étaient pas d’une limpidité de source fraîche."
                            }
                        ]
