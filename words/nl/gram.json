                        {
                            "text": "Dit specifieke <w>gram</w> is een zeldzaam voorbeeld van oud schrift.",
                            "target_lang_translations": {
                                "en": "This specific <w>gram</w> is a rare example of ancient script.",
                                "ru": "Этот конкретный <w>знак</w> является редким примером древнего письма."
                            }
