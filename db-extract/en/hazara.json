                        "target_lang_word": "Hazara",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hazara",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b61a16e2-603f-3d9e-a0c6-98c858bec7f6",
                                        "entry_id": "61205983-f4cf-3ea8-b831-63730c52689c",
                                        "glosses": [
                                            "Membre d’une ethnie présente en Afghanistan, au Pakistan et en Iran."
                                        ],
                                        "tags": [
                                            "Ethnonymie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5af1be20-5306-411c-8211-abeef9de98da",
                                                "sense_id": "b61a16e2-603f-3d9e-a0c6-98c858bec7f6",
                                                "text": "Les Hazaras sont majoritairement chiites."
                                            },
                                            {
                                                "example_id": "2cb4ac3e-9aa3-4722-b8ca-89e65f0b0bb7",
                                                "sense_id": "b61a16e2-603f-3d9e-a0c6-98c858bec7f6",
                                                "text": "C’étaient des Hazaras dont les tribus vivaient sur les âpres plateaux et dans les vallées closes de l’Hindou Kouch, du côté où le soleil décline."
                                            },
                                            {
                                                "example_id": "4790e328-1c10-482b-8da2-97aac360d857",
                                                "sense_id": "b61a16e2-603f-3d9e-a0c6-98c858bec7f6",
                                                "text": "S’ils ne sont pas aujourd’hui les seuls à être pétrifiés par les conséquences de la victoire talibane, les Hazaras craignent encore plus pour leurs vies. Même ceux qui n’étaient à l’époque que des bambins se souviennent de l’épouvante des leurs, de leurs tentatives d’exil, des humiliations, de la faim et des massacres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
