                        "glosses": [
                            "Relatif aux différents éléments du psychique, le surmoi, le moi et le ça."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "749a6118-bb9c-414b-af5d-421ddcaf2647",
                                "sense_id": "7c1ef738-aa0a-3183-9547-aa200cb1f76f",
                                "text": "Cela a engendré confusions, conflits et souffrances intrapsychiques, somatisations, pathologies comme l’anorexie ou la frigidité."
                            }
                        ]
                    },
                    {
                        "sense_id": "107cd403-1d89-3ccc-b174-35da3ba310b9",
                        "entry_id": "25b8bf67-9cff-3d21-ba68-4c22c45740ea",
                        "glosses": [
                            "Qui naît ou se joue au sein du psychisme personnel de l’individu, plutôt qu’en interaction avec le monde extérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04e4a459-eb63-4532-b4fb-f7488d4319b3",
                                "sense_id": "107cd403-1d89-3ccc-b174-35da3ba310b9",
                                "text": "Par manque de références pour penser ce qui relève de l’extérieur, du champ social, Pauline rapatrie la causalité en intrapsychique. Elle pense sa souffrance en terme de responsabilité personnelle."
                            },
                            {
                                "example_id": "9b26d26b-2d17-4bd6-b989-eb6b8f244209",
                                "sense_id": "107cd403-1d89-3ccc-b174-35da3ba310b9",
                                "text": "L’aliénation sectaire relèverait de l’histoire singulière et intrapsychique et non pas de la rencontre entre deux cultures."
                            }
                        ]
                    }
