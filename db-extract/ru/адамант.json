                                                "sense_id": "bc5df1ea-12c4-3c49-bf61-1c1a9b94ffb6",
                                                "text": "The saw is coated with diamond."
                                            },
                                            {
                                                "example_id": "fd1ae512-fd14-45b9-9ce8-a9fbcc2db07b",
                                                "sense_id": "bc5df1ea-12c4-3c49-bf61-1c1a9b94ffb6",
                                                "text": "synthetic diamond"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca220736-dc58-3b17-9fe0-a392a91892cf",
                                        "entry_id": "7d34fd50-98c2-34ee-8267-9504c2b7a859",
                                        "glosses": [
                                            "A gemstone made from this mineral."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d8d3f7c-01d9-4242-8dc6-a21942633a2b",
                                                "sense_id": "ca220736-dc58-3b17-9fe0-a392a91892cf",
                                                "text": "The dozen loose diamonds sparkled in the light."
                                            },
                                            {
                                                "example_id": "14e3c8a0-6501-4a2b-913c-627526bdd896",
                                                "sense_id": "ca220736-dc58-3b17-9fe0-a392a91892cf",
                                                "text": "Although there are dozens of different types of gems, among the best known and most important are diamond, ruby and sapphire, emerald and other gem forms of the mineral beryl, chrysoberyl, tanzanite, tsavorite, topaz and jade."
                                            },
                                            {
                                                "example_id": "edf57973-c9df-4bcf-99a1-fa1cad2deedd",
                                                "sense_id": "ca220736-dc58-3b17-9fe0-a392a91892cf",
                                                "text": "she is wearing small diamond studs in her earlobes. the kind u wear if u’re a modest person & u don’t want to wear anything that could catch on stuff, or be a health risk in a hospital – but u’re still someone who cares."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c857b4bd-ca0e-3704-b8a8-f6f68e7d2aac",
                                        "entry_id": "7d34fd50-98c2-34ee-8267-9504c2b7a859",
                                        "glosses": [
                                            "A diamond ring."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
