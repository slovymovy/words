                    {
                        "sense_id": "3fd26109-7cac-30e6-a17e-c4391018f5ec",
                        "entry_id": "16f91c23-da85-3d17-af57-e1010175977d",
                        "glosses": [
                            "To talk at length, to spiel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc9da847-4c29-4077-bd67-452c6aa063a8",
                                "sense_id": "3fd26109-7cac-30e6-a17e-c4391018f5ec",
                                "text": "Old Saxon, who was so sweet and gentle despite his long years on the halls, smiled at me and suggested I should do some speeling. Yedo gave me a megaphone. I held it to my mouth but there was silence."
                            },
                            {
                                "example_id": "2f037daa-53ae-4945-936c-6b05cb4b7386",
                                "sense_id": "3fd26109-7cac-30e6-a17e-c4391018f5ec",
                                "text": "1973, Irene Baird, Waste Heritage, Macmillan of Canada, page 262,\n“I must close now or I shall go on speeling all night. […] ”"
                            }
                        ]
                    }
