                "senses": [
                    {
                        "sense_id": "f550ea20-5a59-369a-a1c1-5ead35ca01e9",
                        "entry_id": "97dfbc00-4a59-3aed-84bb-5aa5c65fa026",
                        "glosses": [
                            "Qui peut être amélioré par la correction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8527a026-3004-47ff-91de-f93cf47d7d68",
                                "sense_id": "f550ea20-5a59-369a-a1c1-5ead35ca01e9",
                                "text": "Seul l’examen ophtalmologique permet de constater une myopie corrigeable à droite, non corrigeable à gauche, mais ancienne : […]"
                            },
                            {
                                "example_id": "4a50aa9e-7db3-456b-821c-76033cd4ef12",
                                "sense_id": "f550ea20-5a59-369a-a1c1-5ead35ca01e9",
                                "text": "Une baisse de l’acuité visuelle d'origine neurologique n’est pas corrigeable par le port de lentilles."
                            },
                            {
                                "example_id": "a2f63a42-f39e-4a3a-bb9c-e7bf390ea79e",
                                "sense_id": "f550ea20-5a59-369a-a1c1-5ead35ca01e9",
                                "text": "Mais elle fait de la division des tâches entre unités territoriales le résultat provisoire et corrigeable du travail qu’elles accomplissent et non l’expression d’un partage des responsabilités ancré dans la tradition."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e519df6d-561d-459e-867d-9e2faf0dd4b6",
                        "source_entry_id": "97dfbc00-4a59-3aed-84bb-5aa5c65fa026",
                        "source_sense_id": "f550ea20-5a59-369a-a1c1-5ead35ca01e9",
                        "target_lang_word": "corrigible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corrigible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87c19a77-13f4-3584-ab7e-4e76a6a1e984",
                                        "entry_id": "9cc2545d-c419-3473-bd2a-6abaa39861b0",
                                        "glosses": [
                                            "Able to be corrected or set right."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d563e67-132a-452d-b74b-a9d2ffeee69a",
                                                "sense_id": "87c19a77-13f4-3584-ab7e-4e76a6a1e984",
                                                "text": "Why is it, then, that there is on the whole a preponderance among mankind of rational opinions and rational conduct? […] it is owing to a quality of the human mind, the source of everything respectable in man either as an intellectual or as a moral being, namely, that his errors are corrigible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "643c7c6f-277a-3155-85f8-5d7118c5251c",
                                        "entry_id": "9cc2545d-c419-3473-bd2a-6abaa39861b0",
                                        "glosses": [
                                            "Submissive to correction"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e55ee029-b1f2-4fd5-8275-491c60664688",
                                                "sense_id": "643c7c6f-277a-3155-85f8-5d7118c5251c",
                                                "text": "Wouldst thou […] see\nThy master thus with pleach’d arms, bending down\nHis corrigible neck […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8636d6de-f5db-3c4e-b911-deb68ac2f39f",
                                        "entry_id": "9cc2545d-c419-3473-bd2a-6abaa39861b0",
                                        "glosses": [
                                            "Deserving chastisement."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27625606-4899-4c7b-9b2f-f67f4ea9f285",
                                                "sense_id": "8636d6de-f5db-3c4e-b911-deb68ac2f39f",
                                                "text": "[…] he was taken up very short, and adjudgd corrigible for such presumptuous language."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5907edb-0d10-37aa-bf90-e02d9152504a",
                                        "entry_id": "9cc2545d-c419-3473-bd2a-6abaa39861b0",
                                        "glosses": [
                                            "Having power to correct."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e98e531-3d42-4886-9581-6d7771e60f16",
                                                "sense_id": "c5907edb-0d10-37aa-bf90-e02d9152504a",
                                                "text": "Our bodies are our gardens, to the which our wills are gardeners: so that if we will plant nettles, or sow lettuce, set hyssop and weed up thyme, supply it with one gender of herbs, or distract it with many, either to have it sterile with idleness, or manured with industry, why, the power and corrigible authority of this lies in our wills."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
