                    },
                    {
                        "translation_id": "3a9c65f7-aab2-4cfc-95e5-b96a872d55f4",
                        "source_entry_id": "d8bbbbd2-fedd-3b5c-97a1-dd219b3c2b9a",
                        "source_sense_id": "f1a4c63e-bc5a-31a3-a79f-3a9b32bb2a22",
                        "source_sense_description": "plant met kleverige bloemknoppen",
                        "target_lang_word": "bardane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bardane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a6270ca-3175-3990-ae97-109caf948b16",
                                        "entry_id": "0110bede-13fb-3d61-a5b5-e3572929e517",
                                        "glosses": [
                                            "Nom usuel des plantes du genre Arctium de la famille des Asteraceae (Astéracées) dont l’involucre est formé de folioles crochues et qui croît le plus souvent le long des chemins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a958ee92-db37-4dbc-bd56-1b298e9b7740",
                                                "sense_id": "9a6270ca-3175-3990-ae97-109caf948b16",
                                                "text": "La racine de bardane est employée en médecine comme dépurative."
                                            },
                                            {
                                                "example_id": "b7d31665-46fd-47c4-860a-5705dbdbaf66",
                                                "sense_id": "9a6270ca-3175-3990-ae97-109caf948b16",
                                                "text": "Elles firent place à de maigres bardanes, et à des chardons gigantesques hauts de neuf pieds."
                                            },
                                            {
                                                "example_id": "a0882f7b-f2b5-4160-84dd-99509bd8c3b2",
                                                "sense_id": "9a6270ca-3175-3990-ae97-109caf948b16",
                                                "text": "bardane. Importunité. — La bardane croit dans les bons terrains, et il est fort difficile de l’en arracher. Ses graines ont ensuite l’inconvénient de s’attacher aux vêtements avec la même ténacité. De là son importunité."
                                            },
                                            {
                                                "example_id": "1a8b4a1e-97e4-4ca8-9e88-5dd32e0c80f5",
                                                "sense_id": "9a6270ca-3175-3990-ae97-109caf948b16",
                                                "text": "Pierre remontait vers l’auberge, par la ruelle envahie de bardanes et d’herbes de Saint-Jacques, quand il aperçut près d’une fenêtre ouverte un tambour de brodeuse."
                                            },
                                            {
                                                "example_id": "d23c9ed8-980c-460d-ad88-149353823b36",
                                                "sense_id": "9a6270ca-3175-3990-ae97-109caf948b16",
                                                "text": "Dans l’âge où tout vice s’accroche à l’adolescence, comme les capitules, cent fois crochus, de la bardane sur une chevelure, une fille de quinze ans court plus d’un danger."
                                            },
                                            {
                                                "example_id": "49f24658-66b1-4be1-8ad2-0d7f267b7571",
                                                "sense_id": "9a6270ca-3175-3990-ae97-109caf948b16",
                                                "text": "[L’inventeur de la bande Velcro], Georges de Mestral, avait été intrigué dans les années 1950 par l’étrange comportement des fruits secs d’une plante des montagnes, la bardane Arctium lappa , qui s’accrochent aux vêtements ou au pelage des animaux et s'y maintiennent aisément."
                                            },
                                            {
                                                "example_id": "69f86e3d-8382-4802-8700-a509020ebb93",
                                                "sense_id": "9a6270ca-3175-3990-ae97-109caf948b16",
                                                "text": "Le succès médicinal de la bardane date de l’Antiquité."
                                            },
                                            {
                                                "example_id": "bf9a9798-1867-4d26-b0b8-d54d8ed89a17",
                                                "sense_id": "9a6270ca-3175-3990-ae97-109caf948b16",
                                                "text": "La racine de bardane est également un légume courant en Corée et en Chine. Sous l’influence de la communauté asiatique, il s’en vend fréquemment Arctium lappa sur les marchés de New York ou du Brésil."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bardane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a33bec23-98eb-39f5-8ac8-7e44d84fb00b",
                                        "entry_id": "65a1fc21-eb22-3437-994c-a6b7a235d8c9",
                                        "glosses": [
                                            "Punaise des lits."
                                        ],
                                        "tags": [
                                            "Lyonnais"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a446cb28-6eaa-4c26-aa8f-8b0f169075b9",
                                                "sense_id": "a33bec23-98eb-39f5-8ac8-7e44d84fb00b",
                                                "text": "Lorsqu’un Lyonnais dit : … bardane pour punaise…"
                                            },
                                            {
                                                "example_id": "0db0d9cd-0dab-4061-9997-4dc5a4aba1ed",
                                                "sense_id": "a33bec23-98eb-39f5-8ac8-7e44d84fb00b",
                                                "text": "C’est-y que tu me croirais attaché à mes pécuniaux comme une bardane au bardanier ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
