            {
                "entry_id": "370c004d-9f1d-3b6a-83ba-95da4c90f605",
                "word": "pellet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f16a1aa2-a4da-465d-b886-e01bda06ef10",
                        "entry_id": "370c004d-9f1d-3b6a-83ba-95da4c90f605",
                        "tags": [
