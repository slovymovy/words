                "translations": [
                    {
                        "translation_id": "25f9f4b1-af4f-4fe7-8880-6173905e1b25",
                        "source_entry_id": "ee2249ea-2568-3c6b-977d-6a70de2b7616",
                        "source_sense_id": "5c6fd690-1295-3fa4-acaa-5335c4b411f2",
                        "target_lang_word": "Schreiner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schreiner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2451bf0f-2c0b-3b79-94ea-d95b5a4795e5",
                                        "entry_id": "871720ec-3c34-3774-9f53-491de9aa71e4",
                                        "glosses": [
                                            "Handwerker, der aus Holz Möbel oder Fenster und Türen herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc169f6b-69d5-4deb-80fc-00793a1e1d3a",
                                                "sense_id": "2451bf0f-2c0b-3b79-94ea-d95b5a4795e5",
                                                "text": "Den Schrank haben wir uns vom Schreiner machen lassen."
                                            },
                                            {
                                                "example_id": "fffd6693-6ee3-4d34-989b-f41dfef8477b",
                                                "sense_id": "2451bf0f-2c0b-3b79-94ea-d95b5a4795e5",
                                                "text": "„Die beiden Schreiner lächelten und meinten, sie würden es doch hoffen.“"
                                            },
                                            {
                                                "example_id": "fb3eaf31-d610-4b05-bacf-1cc9cf429a60",
                                                "sense_id": "2451bf0f-2c0b-3b79-94ea-d95b5a4795e5",
                                                "text": "„Später ging er zu einem Schreiner in die Lehre, allerdings brach er diese bald ab.“"
                                            },
                                            {
                                                "example_id": "40b34c4c-a3f7-4b22-856d-62c4d1339106",
                                                "sense_id": "2451bf0f-2c0b-3b79-94ea-d95b5a4795e5",
                                                "text": "„Schreiner fertigten Holzroste für französische Betten.“"
                                            },
                                            {
                                                "example_id": "e472b7dc-db5b-4d7d-9591-697e4a9a7273",
                                                "sense_id": "2451bf0f-2c0b-3b79-94ea-d95b5a4795e5",
                                                "text": "„Fried kam in die Lehrlingsgruppe der Schreiner, und ihn steckte man zu den Gärtnern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schreiner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7973c0c7-888b-3e6a-ad27-246674e13992",
                                        "entry_id": "b6d9e395-caa9-3ee3-a338-4e7875041769",
                                        "glosses": [
                                            "Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "431c1428-2b2c-4991-bb27-c01a15ab397f",
                        "source_entry_id": "ee2249ea-2568-3c6b-977d-6a70de2b7616",
                        "source_sense_id": "5c6fd690-1295-3fa4-acaa-5335c4b411f2",
                        "target_lang_word": "Tischler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tischler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9de0d99-e0a8-33f5-a780-00b721f13cf1",
                                        "entry_id": "4ba550b3-9709-3b52-b7b1-2406945f7826",
                                        "glosses": [
                                            "Handwerker, der aus Holz Möbel oder Fenster und Türen herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6de4f02-e209-4de7-8e0b-7789e64fe29d",
                                                "sense_id": "a9de0d99-e0a8-33f5-a780-00b721f13cf1",
                                                "text": "Den Schrank haben wir uns vom Tischler machen lassen."
                                            },
                                            {
                                                "example_id": "8bd46a48-15e8-474d-9d2a-507b72973784",
                                                "sense_id": "a9de0d99-e0a8-33f5-a780-00b721f13cf1",
                                                "text": "„Und der Tischler hebt seinen grauen Kopf und sieht den Wirt groß an.“"
                                            },
                                            {
                                                "example_id": "1d75b1d1-d670-40b7-a17e-e9da3db5b1b4",
                                                "sense_id": "a9de0d99-e0a8-33f5-a780-00b721f13cf1",
                                                "text": "„Tatsächlich sei sie bis zum Tischler Lý Phong vorgedrungen, der in einem dritten Hinterhof nahe dem Mauerpark Möbel ausbesserte und von geradezu sprichwörtlich schlechter Laune war.“"
                                            },
                                            {
                                                "example_id": "4a61fbb2-1af4-47f8-956f-affe074d0229",
                                                "sense_id": "a9de0d99-e0a8-33f5-a780-00b721f13cf1",
                                                "text": "„Sie bestellte sogleich bei einem Tischler einen vergitterten und abschließbaren Bücherschrank, der nach meiner Abreise ihre ganze Wonne sein mußte.“"
                                            },
                                            {
                                                "example_id": "4c8a2a6b-7c0d-43d8-93c8-38f8abf5489d",
                                                "sense_id": "a9de0d99-e0a8-33f5-a780-00b721f13cf1",
                                                "text": "„Somit ist der Tischler Beste, der dort wohnt, ein Verräter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da7891dc-5ae6-47d8-9841-3963d0e0f333",
                        "source_entry_id": "ee2249ea-2568-3c6b-977d-6a70de2b7616",
                        "source_sense_id": "5c6fd690-1295-3fa4-acaa-5335c4b411f2",
                        "target_lang_word": "cabinetmaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cabinetmaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2f2c8fb-95c5-3699-b3ae-896b64b9c437",
                                        "entry_id": "476baf1e-65a5-3ec5-8b0e-6b3dfe1e03c7",
                                        "glosses": [
                                            "A skilled woodworker who makes high-quality wooden cabinets and furniture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87a5bf33-4286-472b-89f9-864e26d18ae6",
                                                "sense_id": "a2f2c8fb-95c5-3699-b3ae-896b64b9c437",
                                                "text": "He waited and waited, in the faith that Schinkel was dealing with them in his slow, categorical Teutonic way, and only objurgated the cabinetmaker for having in the first place paltered with his sacred trust. Why hadn't he come straight to him—whatever the mysterious document was—instead of talking it over with French featherheads?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40ec56b3-9791-4c2f-ad68-8f4f12be85b3",
                        "source_entry_id": "ee2249ea-2568-3c6b-977d-6a70de2b7616",
                        "source_sense_id": "5c6fd690-1295-3fa4-acaa-5335c4b411f2",
                        "target_lang_word": "joiner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "joiner",
