                        "glosses": [
                            "Otite chronique, inflammation des petits os de l’oreille aboutissant à des lésions qui peuvent dégénérer en surdité définitive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6d750d1-6986-49b6-99a2-b37f6ff950d0",
                                "sense_id": "cf729713-25c0-3bd8-bf12-59cc96e5b068",
                                "text": "L'otosclérose affecte approximativement une personne sur 250."
                            },
                            {
                                "example_id": "392cd131-889d-4966-ac59-b8b54891a950",
                                "sense_id": "cf729713-25c0-3bd8-bf12-59cc96e5b068",
                                "text": "Beethoven évoque dès 1796 ses troubles de l'audition, en 1819, la surdité était totale, on sait aujourd'hui qu'une forme de syphilis doublée d'otosclérose en était la cause."
                            },
                            {
                                "example_id": "27d83ebf-8c63-4e09-8797-a298e183899b",
                                "sense_id": "cf729713-25c0-3bd8-bf12-59cc96e5b068",
                                "text": "L’otosclérose est une maladie qui affecte la mobilité de l’étrier, un petit osselet situé dans l’oreille interne."
                            }
                        ]
                    }
