            "senses": [
                {
                    "sense_id": "4240e327-88e2-3b65-8f64-331cd2988cd7",
                    "sense_definition": "Highest in rank, authority, or power.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "power_rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>supreme</w> commander ordered the troops to advance immediately.",
