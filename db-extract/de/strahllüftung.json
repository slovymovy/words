                "senses": [
                    {
                        "sense_id": "a5e425d7-7e91-3190-b64a-03080a68c90c",
                        "entry_id": "44af9781-fdb0-3481-a4b7-a143f30637d5",
                        "glosses": [
                            "zugeführte, impulsstarke Luftströmung, die sich mit der vorhanden Raumluft vermengt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c040283d-57b4-4ab3-9c6c-394c3e4e70f2",
                                "sense_id": "a5e425d7-7e91-3190-b64a-03080a68c90c",
                                "text": "„Der Dachraum wird nicht erwärmt, die Strahllüftung bringt bei hohen Außentemperaturen die nötige Luftwalzenbildung zur Versorgung der Tiere.“"
                            },
                            {
                                "example_id": "50bf5e8c-f81e-4fa7-b0d9-79d0143df89f",
                                "sense_id": "a5e425d7-7e91-3190-b64a-03080a68c90c",
                                "text": "„Wird eine Strahllüftung eingesetzt, ist es notwendig, die kalte, schwere Frischluft mit hoher Geschwindigkeit (möglichst über 1,0 m/s) durch eine entsprechende Stellung der Klappen in den Raum einzuleiten, um die Zugluftgefahr bei der Strahllüftung zu vermeiden.“"
                            },
                            {
                                "example_id": "efc73521-7507-462c-a0f7-2694d0cc0f19",
                                "sense_id": "a5e425d7-7e91-3190-b64a-03080a68c90c",
                                "text": "„Die Strahllüftung wird auch als Mischlüftung oder Verdünnungslüftung bezeichnet.“"
                            },
                            {
                                "example_id": "fa977a55-d4b5-4b80-a139-b02adb0f8e34",
                                "sense_id": "a5e425d7-7e91-3190-b64a-03080a68c90c",
                                "text": "„Da bei der Verdrängungslüftung insgesamt höhere Strömungswiderstände als bei der Strahllüftung oder bei kombinierten Systemen überwunden werden müssen, ist ihr Energiebedarf tendenziell größer.“"
                            },
                            {
                                "example_id": "c9fabef2-42f4-467d-8bd6-577f1831f332",
                                "sense_id": "a5e425d7-7e91-3190-b64a-03080a68c90c",
                                "text": "„Strahllüftung ist die häufigste Art der Lüftung.“"
                            },
                            {
                                "example_id": "57b9aeff-6a5e-4fd9-afae-d9b4ddd90e12",
                                "sense_id": "a5e425d7-7e91-3190-b64a-03080a68c90c",
                                "text": "„Die Ammoniakemissionen sind bei der Tunnellüftung gegenüber Strahllüftung niedriger, die Staubemissionen sind dagegen bei der Strahllüftung geringer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
