                        "glosses": [
                            "Geschwister mit nur einem gemeinsamen Elternteil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a77c01a-0e27-419f-83e8-47d497c8d7d0",
                                "sense_id": "11fea7b6-5d99-30d0-93f8-7e9b16e01cff",
                                "text": "„Er blieb trotz der früh erlittenen Schicksalsschläge ein fröhliches Kind und entwickelte zur Stiefmutter wie auch zu den Stiefgeschwistern ein herzliches Verhältnis.“"
                            },
                            {
                                "example_id": "fac0a252-23e6-4afa-b7de-aad2a2d88797",
                                "sense_id": "11fea7b6-5d99-30d0-93f8-7e9b16e01cff",
                                "text": "„Er ist sein Stiefgeschwister. Immerhin, nur Stief-!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e1833f0e-828c-38de-900d-3c9ca490adb7",
