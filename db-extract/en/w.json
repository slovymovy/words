                "senses": [
                    {
                        "sense_id": "e36ef342-f509-3273-a33d-50f99c1d0641",
                        "entry_id": "6ef77717-3daa-3510-98e0-c04d62a001d2",
                        "glosses": [
                            "Victoire, réussite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c02427d6-57f3-4f49-8010-196394b3caf2",
                                "sense_id": "e36ef342-f509-3273-a33d-50f99c1d0641",
                                "text": "“I started this account [Twitter] in February because I was tired of all of the misogyny from the Women Posting Ls page and wanted a positive space for women (it used to be a personal account). It looks like there are more people who want to see women winning, so that is a W for everyone.”",
                                "translation": "J’ai lancé ce compte [Twitter] en février parce que j’en avais marre de toute la misogynie publiée sur le compte Women Posting Ls et je voulais un espace positif pour les femmes (c’était au départ un compte personnel). Il semblerait qu’il y ait d’autres personnes qui veulent voir des femmes réussir, donc c’est une victoire pour tout le monde."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
