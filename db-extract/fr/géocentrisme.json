        "fr-extract.jsonl": [
            {
                "entry_id": "edabfe26-a083-339e-9237-1ea63a17ac37",
                "word": "géocentrisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f24760d3-90c6-4c97-b82c-6a14f2cb0b28",
                        "entry_id": "edabfe26-a083-339e-9237-1ea63a17ac37",
                        "tags": [
                            "plural"
                        ],
                        "form": "géocentrismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9a3346d5-4fe5-3bde-bd0e-4f857a0ad528",
                        "entry_id": "edabfe26-a083-339e-9237-1ea63a17ac37",
                        "glosses": [
                            "Conception du monde plaçant la Terre au centre de l’univers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c47412e-9de1-4e16-9feb-22e5e1be5da3",
                                "sense_id": "9a3346d5-4fe5-3bde-bd0e-4f857a0ad528",
                                "text": "Le long et difficile détachement du géocentrisme, fixé par Ptolémée et associé à la physique qualitative d’Aristote, ne peut être réduit à un simple affrontement entre l’évidence des faits et le dogmatisme aveugle de l’Église."
                            },
                            {
                                "example_id": "05391f95-b49e-486f-b0a4-f5db1592d1ff",
                                "sense_id": "9a3346d5-4fe5-3bde-bd0e-4f857a0ad528",
                                "text": "Si la connaissance du mouvement des planètes n’avait eu comme protocole de légitimation que le suffrage, nous en serions certainement encore au géocentrisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cff4201-12b3-48f7-a744-df600d70dfbd",
                        "source_entry_id": "edabfe26-a083-339e-9237-1ea63a17ac37",
                        "source_sense_id": "9a3346d5-4fe5-3bde-bd0e-4f857a0ad528",
                        "target_lang_word": "geocentrism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geocentrism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be3bc5f3-9ca0-314d-8c4c-d711605aa9e7",
                                        "entry_id": "da5e9668-b47d-354f-9d80-c92812b0ca1c",
                                        "glosses": [
                                            "A belief that the Earth is the center of the universe."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "842bc285-fc39-3ad4-ac67-539b2e63c5ba",
                                        "entry_id": "da5e9668-b47d-354f-9d80-c92812b0ca1c",
                                        "glosses": [
                                            "The misbelief that the sun revolves around the Earth."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "898523d4-59ad-4ba8-af46-7accace2faee",
                                                "sense_id": "842bc285-fc39-3ad4-ac67-539b2e63c5ba",
                                                "text": "The most famous major challenge was the modern rejection of geocentrism and its acceptance of heliocentrism: that is, the rejection of the view that the sun, planets, and stars all revolve around the earth in favor of the view that the earth and planets revolve around the sun. You can understand why the ancients might have been drawn to geocentrism: it does rather look as if the heavens revolve around the earth, after all, as the sun moves from east to west during the day and then pops up again the next morning in the east."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
