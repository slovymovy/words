                        "examples": [
                            {
                                "example_id": "986440a6-2986-4df5-827d-0efbafb13a34",
                                "sense_id": "f918af06-2222-3c79-976d-94c1ed8f6ecb",
                                "text": "„Währenddessen setzt meine Monatsblutung ein, doch ich traue mich nicht, bei einem der Schergen um Binden zu bitten.“"
                            },
                            {
                                "example_id": "f38ab69c-d521-459b-8778-8074376b1a38",
                                "sense_id": "f918af06-2222-3c79-976d-94c1ed8f6ecb",
                                "text": "„Wie früher setzten Monatsblutungen ein, die nicht aufhörten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
