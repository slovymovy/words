                    {
                        "sense_id": "38b3eecd-ec40-38ce-a5ec-6395fb07343d",
                        "entry_id": "1860fa2d-18d4-3c0e-b091-515063c5d918",
                        "glosses": [
                            "Serving to counteract rioting."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c8f3edc8-3460-480d-b0ea-dc461cb73083",
                                "sense_id": "38b3eecd-ec40-38ce-a5ec-6395fb07343d",
                                "text": "Thus, the administration was not in favor of an antiriot bill before Congress that was designed to curb militant blacks suspected of encouraging riots."
                            },
                            {
                                "example_id": "c7418248-b128-478e-b508-156382a96b0e",
                                "sense_id": "38b3eecd-ec40-38ce-a5ec-6395fb07343d",
                                "text": "...who told him that things were spiraling out of control in Edgehill and that the police were conducting antiriot maneuvers there."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af487d13-7fac-428d-a7de-a6a85c780805",
                        "source_entry_id": "1860fa2d-18d4-3c0e-b091-515063c5d918",
