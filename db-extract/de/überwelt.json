                "senses": [
                    {
                        "sense_id": "7fcb4dc8-17c1-3345-bc64-6f62a1689b8c",
                        "entry_id": "4ba9db06-6d79-3f22-8006-dfe13d4d1b4a",
                        "glosses": [
                            "eine transzendentale Welt jenseits der bekannten, irdischen Welt"
                        ],
                        "tags": [
                            "Esoterik"
                        ],
                        "examples": [
                            {
                                "example_id": "3a268a7f-6b4a-4191-9398-f62380f7a47e",
                                "sense_id": "7fcb4dc8-17c1-3345-bc64-6f62a1689b8c",
                                "text": "Philosophie: „Strukturell betrachtet kann das triadische Verhältnis zwischen dem Menschen, der ihn umgebenden Welt und der sog. jenseitigen Überwelt in drei Weisen gedacht werden, in denen drei verschiedene Richtungen des Übersteigens vorliegen und drei Arten des Über zum Ausdruck gelangen.“"
                            },
                            {
                                "example_id": "ba2c90ce-a857-4db0-b383-a740d4ca228d",
                                "sense_id": "7fcb4dc8-17c1-3345-bc64-6f62a1689b8c",
                                "text": "Religion: „Das Leben in dieser nur durch Symbole darstellbaren Überwelt ermöglicht der Geist Gottes im Menschen.“"
                            },
                            {
                                "example_id": "3bb2f0d5-795a-4cf5-a587-b051f3f1580e",
                                "sense_id": "7fcb4dc8-17c1-3345-bc64-6f62a1689b8c",
                                "text": "Esoterik: „Allerdings könnten mathematisch gesehen zahlreiche unterschiedliche Überwelten existieren, die unsere Welt in ihrem jetzigen Zustand beschreiben. Welche davon die richtige sei, wissen wir nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
