                "senses": [
                    {
                        "sense_id": "a940fa61-d55c-3d30-9127-d5e60dbb35eb",
                        "entry_id": "9abb4a73-2975-3bc4-a02b-355b5acf1bd5",
                        "glosses": [
                            "een arcade (gaanderij) rond de binnenplaats van een klooster of van een kerk waar kanunniken huizen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "079b0c32-232e-4bce-9f1d-055db862af66",
                                "sense_id": "a940fa61-d55c-3d30-9127-d5e60dbb35eb",
                                "text": "Op zondag zijn de museale ruimtes, de abdijkerk met klokkentoren, de bibliotheek, de bisschopszaal, het kloosterpark, de wijngaarden en de historische kruisgangen vrij toegankelijk. Gedurende de dag zijn er kruidenwandelingen door het park en worden er miniconcerten in de abdijkerk gegeven."
                            }
                        ]
                    },
                    {
                        "sense_id": "973e77ed-dfea-3e65-8010-18ce1c257947",
                        "entry_id": "9abb4a73-2975-3bc4-a02b-355b5acf1bd5",
                        "glosses": [
                            "de gang naar een kruisiging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd9823eb-558f-4947-a47e-326a2ccf883e",
                                "sense_id": "973e77ed-dfea-3e65-8010-18ce1c257947",
                                "text": "Waar halen wij, zondige mensen, het lef vandaan om de kruisgang en het onnavolgbare lijden van de Heere Jezus na te bootsen, vraagt K. A. Gort zich af."
                            }
                        ]
                    },
                    {
                        "sense_id": "48f4cc09-e86b-3e93-a172-c0d6bf1090f6",
                        "entry_id": "9abb4a73-2975-3bc4-a02b-355b5acf1bd5",
                        "glosses": [
                            "een lijdensweg in het algemeen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3ea365e-2717-43ef-a8ee-45e8bb25848c",
                                "sense_id": "48f4cc09-e86b-3e93-a172-c0d6bf1090f6",
                                "text": "Maar de kruisgang van Club was nog niet voorbij. Scheidsrechter Luc Wouters gunde Dessel nog een tweede penalty na een vederlicht contact tussen Donk en Bennassar. De strafschop werd dit keer genomen door Alan Ven - maar pas nadat een onwel geworden Dessel-supporter werd afgevoerd. Coosemans pakte de penalty."
                            },
                            {
                                "example_id": "878348dd-26a3-492b-8be1-f9f3d395ea7c",
                                "sense_id": "48f4cc09-e86b-3e93-a172-c0d6bf1090f6",
                                "text": "Als ik nu op YouTube de beelden van die legendarische etappe terugzie, bekruipt me het gevoel dat hij de hemel in probeert te rijden; klaar met hier en nu. Dat daar bedrog bij kwam kijken, is de religie noch het wielrennen vreemd. Toen was de Galibier het decor van zijn grootste zege. Sinds 2004 is het altaarstuk van zijn kruisgang."
                            }
                        ]
                    }
                ],
