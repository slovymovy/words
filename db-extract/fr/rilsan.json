                "senses": [
                    {
                        "sense_id": "771c29c4-b0d1-3340-a188-e9ce17e4e127",
                        "entry_id": "4dddd580-0edd-3e14-a8ce-4611d65d6502",
                        "glosses": [
                            "Polymère thermoplastique dérivé de l’huile de ricin, utilisé un temps comme fibre textile synthétique, puis pour des conduites flexibles, des filets de pêche, des cordes pour instruments de musique, des colliers de serrage etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d7953e9-5c9b-48b1-b385-8ac05abe4705",
                                "sense_id": "771c29c4-b0d1-3340-a188-e9ce17e4e127",
                                "text": "Le Rilsan est utilisé dans la soirie, la bonneterie. Les textiles en Rilsan sont particulièrement reconnus et appréciés pour leur légèreté, leur toucher soyeux et doux, leur infroissabilité, l’absence d’allergie."
                            }
                        ]
                    }
                ],
