                                                "example_id": "6298ef6f-00cd-4121-878a-b27edd1780ed",
                                                "sense_id": "142f82a0-68f2-39cd-83fb-3ca3a7370a51",
                                                "text": "Un État prébendier, qui s’enrichit sur le dos de l’économie du pays."
                                            }
                                        ]
