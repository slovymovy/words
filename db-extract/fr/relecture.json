                    }
                ],
                "senses": [
                    {
                        "sense_id": "8ba697bf-b75e-3d13-a275-6caf399e9b5c",
                        "entry_id": "b041a688-ab4e-3883-81ce-04b340e4fe55",
                        "glosses": [
                            "Lecture d’un texte écrit à des fins de correction."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f06445e7-c6e9-3c54-8f23-005d4388de1e",
                        "entry_id": "b041a688-ab4e-3883-81ce-04b340e4fe55",
                        "glosses": [
                            "Lecture à nouveau d’un texte pouvant amener à une nouvelle interprétation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03adc884-be05-4894-8f96-2452b076bf21",
                                "sense_id": "f06445e7-c6e9-3c54-8f23-005d4388de1e",
                                "text": "Cette remarque pose, d'ailleurs, à l'historien, un problème. L'analyse qui est la sienne s'appuie sur SA lecture, véritable relecture dans un contexte parfaitement différent."
                            }
                        ]
                    },
                    {
                        "sense_id": "dec7d911-4bb4-34f8-83ea-c661f9fbadcf",
                        "entry_id": "b041a688-ab4e-3883-81ce-04b340e4fe55",
                        "glosses": [
                            "Pratique spirituelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e2394a0-225d-42a4-b418-83ff83bf1dd6",
                                "sense_id": "dec7d911-4bb4-34f8-83ea-c661f9fbadcf",
                                "text": "La relecture nous permet de nous rappeler les événements que nous venons de traverser, pour y discerner Dieu et son action."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f75ccf26-9eef-455e-a3fc-c5c97c9acc5b",
                        "source_entry_id": "b041a688-ab4e-3883-81ce-04b340e4fe55",
                        "source_sense_description": "lecture d’un texte écrit à des fins de correction",
                        "target_lang_word": "Korrekturlesen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Korrekturlesen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a19baa1e-b7c4-3d07-8713-814aff0be099",
                                        "entry_id": "383dec49-4ca1-34a2-b5ae-2fe2acc80b92",
                                        "glosses": [
                                            "Überprüfung und Berichtigung eines Textes bezüglich Rechtschreibung und Grammatik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d41e3c41-63b3-40d4-a1c4-b5ee7f1eae4c",
                                                "sense_id": "a19baa1e-b7c4-3d07-8713-814aff0be099",
                                                "text": "„In Dänemark, wo das Weihnachtsfest weniger feierlich als in Deutschland, dafür mit ganz eigenen Bräuchen begangen wird, sind verschiedene Arten von Nissen bekannt, unter anderem der ‚Sætternissen‘: Er schmuggelt Druckfehler in Bücher und Zeitungen – und zwar so trickreich, dass sie beim Korrekturlesen nicht entdeckt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "328d7849-5781-4e09-b9c5-6875a3ca3699",
                        "source_entry_id": "b041a688-ab4e-3883-81ce-04b340e4fe55",
                        "source_sense_description": "lecture d’un texte écrit à des fins de correction",
                        "target_lang_word": "Prüfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prüfung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0f1355a-d24d-3e76-b8e2-b705afc46e77",
                                        "entry_id": "2c376bea-f50c-3762-b336-35c397f99739",
                                        "glosses": [
                                            "Handlung des Kontrollierens; das Nachschauen oder Testen, ob etwas funktioniert beziehungsweise in Ordnung ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f091846e-be20-497f-aa7d-78998cd317e4",
                                                "sense_id": "e0f1355a-d24d-3e76-b8e2-b705afc46e77",
                                                "text": "Wir äußern uns erst nach gründlicher Prüfung des Sachverhaltes."
                                            },
                                            {
                                                "example_id": "69136a2a-28b6-49d3-aa48-43859be77a06",
                                                "sense_id": "e0f1355a-d24d-3e76-b8e2-b705afc46e77",
                                                "text": "„Kluge Kapitalanleger lassen sich nicht nur bisherige Mietverträge zur Prüfung aushändigen, sondern lassen sich auch den regelmäßigen Mieteingang bescheinigen, indem sie z.B. Einsicht in die Kontoauszüge des Vorbesitzers bekommen.“"
                                            },
                                            {
                                                "example_id": "f60778c1-1f17-42fe-9f3d-3dd481372da6",
                                                "sense_id": "e0f1355a-d24d-3e76-b8e2-b705afc46e77",
                                                "text": "„Dann entschuldigte er sich und ließ mich allein, damit ich mit der Prüfung der Geschäftsbücher beginnen könne.“"
                                            },
                                            {
                                                "example_id": "ffa137e6-06a7-40fa-9b60-a602f42071e0",
                                                "sense_id": "e0f1355a-d24d-3e76-b8e2-b705afc46e77",
                                                "text": "„Seine Stimmung schien mir eher moros und bitter, — was nicht allein auf die furchtbaren Prüfungen, Opfer und Leiden zurückzuführen sein mochte, die der Krieg seinem Lande auferlegte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9664d232-e37b-3a9d-bc44-011d6af8bbf1",
                                        "entry_id": "2c376bea-f50c-3762-b336-35c397f99739",
                                        "glosses": [
                                            "meist offizielle Abfrage mündlich oder schriftlich in einem Fachgebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ca1e2b2-675c-4cee-8ace-3b5a47f4a802",
                                                "sense_id": "9664d232-e37b-3a9d-bc44-011d6af8bbf1",
                                                "text": "Morgen habe ich meine mündliche Prüfung."
                                            },
                                            {
                                                "example_id": "0e0cb66b-6760-48e8-bf4d-050460afc10f",
                                                "sense_id": "9664d232-e37b-3a9d-bc44-011d6af8bbf1",
                                                "text": "„Aber mit der Einführung einer Prüfung war das Problem noch nicht gelöst.“"
                                            },
                                            {
                                                "example_id": "014bcdfc-5e21-4644-be3c-85534def54c3",
                                                "sense_id": "9664d232-e37b-3a9d-bc44-011d6af8bbf1",
                                                "text": "„Verletzt er in der Prüfung den Nachbarzahn, fällt er durch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "119bd97d-db06-43ec-b481-335d7ac185bb",
