{
    "word_family": [
        "rampantly",
        "rampancy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "74d09c08-f46b-3e5e-80e6-abe99af5c7d4",
                    "sense_definition": "Rife, widespread, or occurring widely and menacingly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unchecked_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The citizens demanded immediate action because there was <w>rampant</w> corruption in the city government.",
                            "target_lang_translations": {
                                "ru": "Граждане потребовали немедленных действий, поскольку в городском правительстве процветала <w>повальная</w> коррупция."
                            }
                        },
                        {
                            "text": "Without proper security measures, <w>rampant</w> rumors can easily destroy a company's reputation.",
                            "target_lang_translations": {
                                "ru": "Без надлежащих мер безопасности <w>безудержные</w> слухи могут легко разрушить репутацию компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "rife",
                        "widespread",
                        "prevalent"
                    ],
                    "antonyms": [
                        "scarce",
                        "rare"
                    ],
                    "common_phrases": [
                        "rampant corruption",
                        "rampant inflation",
                        "rampant rumors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Широко распространенный, свирепствующий или угрожающе разрастающийся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повальный",
                                "target_lang_sense_clarification": "о болезнях, слухах, коррупции"
                            },
                            {
                                "target_lang_word": "широко распространенный",
                                "target_lang_sense_clarification": "о явлениях"
                            },
                            {
                                "target_lang_word": "угрожающий",
                                "target_lang_sense_clarification": "о масштабах проблем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a3b6a01-0416-3b62-b4cf-20385756edd3",
                    "sense_definition": "Unrestrained, unchecked, or growing out of control.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unchecked_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Weeds grew <w>rampant</w> in the neglected garden, choking out all the beautiful flowers.",
                            "target_lang_translations": {
                                "ru": "Сорняки <w>буйно</w> разрослись в запущенном саду, заглушая все красивые цветы."
                            }
                        },
                        {
                            "text": "During the winter months, flu and other seasonal illnesses ran <w>rampant</w> through the crowded school.",
                            "target_lang_translations": {
                                "ru": "В зимние месяцы грипп и другие сезонные заболевания <w>свирепствовали</w> в переполненной школе."
                            }
                        }
                    ],
                    "synonyms": [
                        "uncontrolled",
                        "unchecked",
                        "unrestrained",
                        "wild"
                    ],
                    "antonyms": [
                        "controlled",
                        "restrained",
                        "checked"
                    ],
                    "common_phrases": [
                        "run rampant",
                        "rampant growth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неудержимый, безудержный или вышедший из-под контроля."
                    },
                    "translations": {
