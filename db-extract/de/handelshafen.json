                "senses": [
                    {
                        "sense_id": "c0a1741a-442c-3662-a40a-e19733e3f18d",
                        "entry_id": "504555e5-f300-3176-b324-adba57c7141b",
                        "glosses": [
                            "Hafen, der zum Warenumschlag von Handelsgütern genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b13e9c4-f86d-49ef-9124-ec3db338d24c",
                                "sense_id": "c0a1741a-442c-3662-a40a-e19733e3f18d",
                                "text": "„Nach den Ausschreitungen der vergangenen Woche in Oakland haben mehrere tausend Demonstranten der ‚Occupy‘-Bewegung den Handelshafen der Stadt blockiert.“"
                            },
                            {
                                "example_id": "174b7bdb-ee63-47dd-a977-3304a0b6c6e0",
                                "sense_id": "c0a1741a-442c-3662-a40a-e19733e3f18d",
                                "text": "„Vergrößert wird er noch, seit eine chinesische Firma eine weitere Ausschreibung gewonnen hat, um den israelischen Handelshafen Ashdot im Süden des Landes zu modernisieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
