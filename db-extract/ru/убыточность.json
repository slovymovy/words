                    },
                    {
                        "translation_id": "33a0af6a-c98a-4862-b270-c3d081ed96db",
                        "source_entry_id": "40133e8b-9cd9-31cf-87d4-f571fbb122c6",
                        "source_sense_id": "7eb221f3-6cef-3b84-bbcb-0cd36e45e045",
                        "target_lang_word": "lésion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lésion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "496000c8-fd93-32b6-bebc-bff718d7bc6d",
                                        "entry_id": "76620a66-c998-3e1b-b558-e40c4d54be8c",
                                        "glosses": [
                                            "Atteinte faite à une partie de l’organisme par une cause externe ou une maladie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbc4a42b-a4fe-4064-843b-b6cb4dacd108",
                                                "sense_id": "496000c8-fd93-32b6-bebc-bff718d7bc6d",
                                                "text": "S’il n’y a aucun signe plessimétrique ou stéthoscopique indiquant une lésion superficielle du poumon, et si la respiration est simplement affaiblie, on ne peut guère hésiter qu’entre l'existence d’indurations centrales ou disséminées et un état emphysémateux du poumon."
                                            },
                                            {
                                                "example_id": "1249930e-102c-41f3-a507-fa31abecac86",
                                                "sense_id": "496000c8-fd93-32b6-bebc-bff718d7bc6d",
                                                "text": "Ces symptômes correspondent sans doute à des lésions du myocarde ou du péricarde qui ont été constatées en effet quelquefois."
                                            },
                                            {
                                                "example_id": "0ad620be-ef01-4954-a14d-7f8875a5e167",
                                                "sense_id": "496000c8-fd93-32b6-bebc-bff718d7bc6d",
                                                "text": "L’exposition à la lewisite et au phosgène provoque une douleur immédiate. Les lésions tissulaires apparaissent en quelques minutes. En cas d’exposition des yeux, il y a douleur, photophobie, larmoiement et perte d’acuité visuelle."
                                            },
                                            {
                                                "example_id": "9944b04c-48aa-49bd-acfd-96baada47f87",
                                                "sense_id": "496000c8-fd93-32b6-bebc-bff718d7bc6d",
                                                "text": "Le pus présent dans les lésions d’actinobacillose est un pus blanc laiteux, inodore, visqueux, renfermant des grains parfois difficiles à observer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb51b745-b6fc-3314-ba93-b02b095ac209",
                                        "entry_id": "76620a66-c998-3e1b-b558-e40c4d54be8c",
                                        "glosses": [
                                            "Atteinte aux intérêts de quelqu’un ou de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4ccc665-8ad0-4dc4-9fcf-d65320a18b08",
                                                "sense_id": "fb51b745-b6fc-3314-ba93-b02b095ac209",
                                                "text": "Mᵉ Guillaume Blanchard tient à rappeler que la lésion d’un candidat évincé s’apprécie au regard, d’une part, des points qu’il a perdus dans sa note ; d’autre part, des points gagnés par ses concurrents par l’application d’une méthode irrégulière de notation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
