                        "examples": [
                            {
                                "example_id": "ebb3cc3e-2916-4f3f-b33b-71bd1d6de1f1",
                                "sense_id": "63a8dc77-2992-3711-b476-e07af04a54ff",
                                "text": "Валерьянка отличается особым действием на кошек, схожим с действием наркотиков на человека."
