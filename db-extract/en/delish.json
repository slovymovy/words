                        "examples": [
                            {
                                "example_id": "eba252d7-07fc-4311-841d-1870f286f3d1",
                                "sense_id": "e37ee8df-66fd-3983-a150-67a4f8502d10",
                                "text": "Not that I want to rush you, but that'd be simply delish!"
                            },
                            {
                                "example_id": "9be7cfd0-8d5d-4d22-bf70-4e6433b4b6d4",
                                "sense_id": "e37ee8df-66fd-3983-a150-67a4f8502d10",
                                "text": "Delish! I tried some crackers loaded with cheese and pâté. Double delish!"
                            },
                            {
                                "example_id": "312ea608-6a8b-4c3b-9041-f271781d4665",
                                "sense_id": "e37ee8df-66fd-3983-a150-67a4f8502d10",
                                "text": "\"Ummm. Sounds delish.\" I don't know what to say; this is what comes out. \"Yes, delish.\""
                            },
                            {
                                "example_id": "b7fe7378-b410-4897-809b-c92a1d244220",
                                "sense_id": "e37ee8df-66fd-3983-a150-67a4f8502d10",
                                "text": "Tom Aikens is the name of the notorious kitchen firebrand who runs this wonderful modern European restaurant where the setting is handsome and the food delish."
                            }
                        ]
