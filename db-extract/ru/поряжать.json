                "senses": [
                    {
                        "sense_id": "676574e1-177c-35a4-ae36-a695a99c74c7",
                        "entry_id": "02c453d9-089a-380a-aaa3-a748975015a7",
                        "glosses": [
                            "устар. и прост. нанимать на определённых условиях"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e73ca5d1-e17f-3bac-bd36-1d86e8123d1e",
                        "entry_id": "02c453d9-089a-380a-aaa3-a748975015a7",
                        "glosses": [
                            "прост. подряжать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e69266c-df58-47a7-9012-8d3df390a6e7",
                                "sense_id": "e73ca5d1-e17f-3bac-bd36-1d86e8123d1e",
                                "text": "Прослышали сыновья, что в Киеве поряжают строить церковь, и пошли туда. Порядились и стали класть."
                            },
                            {
                                "example_id": "c03e3f50-95bf-4105-b224-8d3f0fc17518",
                                "sense_id": "e73ca5d1-e17f-3bac-bd36-1d86e8123d1e",
                                "text": "Порядил я пильщиков, косцов."
                            },
                            {
                                "example_id": "da1a30f1-2d1b-4b5b-b43a-6c847de3dd96",
                                "sense_id": "e73ca5d1-e17f-3bac-bd36-1d86e8123d1e",
                                "text": "В городе ноне чуть ли не дешевле деревенского поряжают поденщиков."
                            }
                        ]
                    },
                    {
                        "sense_id": "89907dbf-fe47-3a97-a931-0f1afb31ec72",
                        "entry_id": "02c453d9-089a-380a-aaa3-a748975015a7",
                        "glosses": [
                            "рег. (Волог., Арх.) отдать кому-либо (в выражениях типа поряжать в люди, в няньки и т.п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "890e15f2-38f4-4380-91f7-54626ce8db4f",
                                "sense_id": "89907dbf-fe47-3a97-a931-0f1afb31ec72",
                                "text": "В люди меня порядили, так и не пришлось учиться-то"
                            },
                            {
                                "example_id": "7d67f29a-c6c8-4927-ada1-c328c1965676",
                                "sense_id": "89907dbf-fe47-3a97-a931-0f1afb31ec72",
                                "text": "Всяко девяти годов была в няньки поряжена."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8337ff2-c44d-3056-bd3e-48b7e597c980",
                        "entry_id": "02c453d9-089a-380a-aaa3-a748975015a7",
                        "glosses": [
                            "рег. (Калм.) обращаться с просьбой, договариваться о чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38e15faf-844a-4fa8-a019-857013011f5b",
                                "sense_id": "b8337ff2-c44d-3056-bd3e-48b7e597c980",
                                "text": "Я сегодня Костю поряжала дрова попилить, да он не может."
                            }
                        ]
                    },
                    {
                        "sense_id": "5caf8bbb-d0f1-31b7-82a7-c982c038cc1c",
                        "entry_id": "02c453d9-089a-380a-aaa3-a748975015a7",
                        "glosses": [
                            "рег. (Нижегор., Р.Урал) и прост. нанимать на определённых условиях, брать во временное пользование"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49297f5c-1a1e-4ffb-b944-616c1c95dbd7",
                                "sense_id": "5caf8bbb-d0f1-31b7-82a7-c982c038cc1c",
                                "text": "Порядят машину, приедут и смолют (зерно)."
                            },
                            {
                                "example_id": "6ccad228-448c-4bca-97a3-97a7739468f7",
                                "sense_id": "5caf8bbb-d0f1-31b7-82a7-c982c038cc1c",
                                "text": "Поряжают тройку лошадей."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2092da2-d9ac-3a4d-9ed6-0b3042f250ff",
                        "entry_id": "02c453d9-089a-380a-aaa3-a748975015a7",
                        "glosses": [
                            "рег. (Арх.) снимать (помещение)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9f6e1e4-f911-4f41-b012-5c43a149a6a4",
                                "sense_id": "f2092da2-d9ac-3a4d-9ed6-0b3042f250ff",
                                "text": "В Пасху девушки сарай поряжают, общего не было, так снимут у частника и танцы там устраивают."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fcfcd96-6cc8-3637-8eb5-3f19e03339bb",
                        "entry_id": "02c453d9-089a-380a-aaa3-a748975015a7",
                        "glosses": [
                            "прост. решать, определять, распоряжаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfce7453-b5ac-4dae-9bd4-bff86a00a8a1",
                                "sense_id": "4fcfcd96-6cc8-3637-8eb5-3f19e03339bb",
                                "text": "Что мир порядил, то Бог рассудил."
                            },
                            {
                                "example_id": "5373cd5d-3736-4ba9-a6b9-5641b3e612ab",
                                "sense_id": "4fcfcd96-6cc8-3637-8eb5-3f19e03339bb",
                                "text": "Коли барин порядил, так и вся рада там."
                            },
                            {
                                "example_id": "ef1b3fea-fa39-4e0a-9f7b-66ddb5dc23ce",
                                "sense_id": "4fcfcd96-6cc8-3637-8eb5-3f19e03339bb",
                                "text": "И поряжу я, лебедь белая, Прирубить-то леса темные, И найму-то я добрых коней Привести-то брата милого"
                            },
                            {
                                "example_id": "44bf5b21-0229-416a-a032-b1ade6528682",
                                "sense_id": "4fcfcd96-6cc8-3637-8eb5-3f19e03339bb",
                                "text": "Порядили два раза в неделю топить баню."
                            }
                        ]
                    },
                    {
                        "sense_id": "da5c4444-0a2d-3fcd-8fea-42598f7fbccc",
                        "entry_id": "02c453d9-089a-380a-aaa3-a748975015a7",
                        "glosses": [
                            "рег. (Волог.) посудачить, порассуждать о чем-либо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ed6691e3-f850-3155-9774-4cfb95aa16bd",
                        "entry_id": "02c453d9-089a-380a-aaa3-a748975015a7",
                        "glosses": [
                            "рег. (Пск.) мирить, устанавливать мир и согласие в семье"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88b20691-71e9-42dd-a7a6-6da739f0d750",
                                "sense_id": "ed6691e3-f850-3155-9774-4cfb95aa16bd",
                                "text": "Судите меня с женой, Порядите молодца с молодой женой"
                            }
                        ]
                    },
                    {
                        "sense_id": "907619c4-b823-31ee-929c-77a34b9dcb7e",
                        "entry_id": "02c453d9-089a-380a-aaa3-a748975015a7",
                        "glosses": [
                            "рег. (Дон) запродавать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bec6e93-0853-43a3-9b31-24360e253517",
                                "sense_id": "907619c4-b823-31ee-929c-77a34b9dcb7e",
                                "text": "Добыча рыбы поряжена по ценам."
                            }
                        ]
                    }
                ],
