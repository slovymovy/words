                        "entry_id": "28a9c80e-7a10-3d9a-a4bf-f08a55633b77",
                        "glosses": [
                            "ein Schmetterling aus der Familie der Ritter (Papillionidae) mit je einem roten Fleck, blauen Monden und schwarzen Streifen auf strohgelben Flügeln"
                        ],
                        "tags": [
                            "Entomologie"
                        ],
                        "examples": [
                            {
                                "example_id": "237ee86c-5c30-4a5b-a604-e6e708623ad3",
                                "sense_id": "73df46bb-a598-39bb-8da5-f10e69b0fb14",
                                "text": "Der Segelfalter gilt als einer der schönsten europäischen Tagfalter."
                            },
                            {
                                "example_id": "64632b88-9b16-4f04-bbdf-26fa09ef115d",
                                "sense_id": "73df46bb-a598-39bb-8da5-f10e69b0fb14",
                                "text": "Der in Mittel- und Südeuropa vorkommende Segelfalter ist in seinem Bestand gefährdet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
