                "senses": [
                    {
                        "sense_id": "75641fae-1d6e-3a21-baa6-0c498450c0d3",
                        "entry_id": "93650758-e9e9-3633-a6ea-1f9c2931d34f",
                        "glosses": [
                            "Person, die als Rugbyspieler bekannt und berühmt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5caf8e5-265a-4361-8534-7e629f914e44",
                                "sense_id": "75641fae-1d6e-3a21-baa6-0c498450c0d3",
                                "text": "„Anfang der 1930er Jahre verfasste Verwoerd neben anderen Kurzgeschichten auch einen kurzen Krimi mit dem Titel ‚Der Hauch des Todes‘. Eine prominente Person, ehemaliger Rugbystar und nun als unbestechlich gefeierter Schiedsrichter, fällt nach einer Auseinandersetzung mit seiner Tochter plötzlich um.“"
                            },
                            {
                                "example_id": "3e98e8b3-2795-4847-bede-c60b1af3d45f",
                                "sense_id": "75641fae-1d6e-3a21-baa6-0c498450c0d3",
                                "text": "„Aber stellen Sie sich mal vor: zweiundzwanzig, attraktiv, Rugbystar und Winzer auf einem Gut, dessen Wohnhaus zweihundertzwanzig Jahre alt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
