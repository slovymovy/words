            "senses": [
                {
                    "sense_id": "b957cf47-f9e5-3026-b6e2-2d7c351d4011",
                    "sense_definition": "mający dużą grubość, szerokość lub średnicę",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "wymiary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na biurku leży bardzo <w>gruba</w> książka do historii.",
                            "target_lang_translations": {
                                "ru": "На письменном столе лежит очень <w>толстая</w> книга по истории."
                            }
                        },
                        {
                            "text": "Robotnicy przeciągnęli przez ścianę <w>gruby</w> kabel elektryczny.",
                            "target_lang_translations": {
                                "ru": "Рабочие протянули через стену <w>толстый</w> электрический кабель."
                            }
                        }
                    ],
                    "antonyms": [
                        "cienki"
                    ],
                    "common_phrases": [
                        "gruba warstwa",
                        "gruba książka",
                        "gruby portfel"
                    ],
                    "target_lang_definitions": {
