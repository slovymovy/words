                "senses": [
                    {
                        "sense_id": "f1a16e96-9b24-32c3-b6bd-49c7a3192296",
                        "entry_id": "83124f4f-800a-39a8-bc33-aa6ea0db5468",
                        "glosses": [
                            "Person, die eine Bahnreise unternimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ccd6eb2-3b7b-406f-9bfc-2173e586246b",
                                "sense_id": "f1a16e96-9b24-32c3-b6bd-49c7a3192296",
                                "text": "„Warum sollte ein Bahnreisender zur Schienen-Rush-hour belohnt werden, wenn die ICEs ohnehin überlastet sind und der Konzern wegen ihm teure Spitzenlastkapazitäten – spricht: Züge – vorhalten muss?“"
                            },
                            {
                                "example_id": "28e7c76e-6410-4d18-ab59-34c4c7108205",
                                "sense_id": "f1a16e96-9b24-32c3-b6bd-49c7a3192296",
                                "text": "„Für die Bahnreisenden war das ein zeitraubendes Ärgernis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
