                                "example_id": "e7d8db53-294a-4473-ad5f-eaecb530d17d",
                                "sense_id": "17aff1bd-f949-332c-b120-9b29fd083fda",
                                "text": "„Der Gleichstrommotor ist eine elektrische Maschine, die sehr einfach in der Drehzahl und im Drehmoment verstellbar ist und deshalb in allen Größenordnungen gebaut wird.“"
                            },
                            {
                                "example_id": "1ec90257-4e48-463a-99ed-4814f559bb5f",
                                "sense_id": "17aff1bd-f949-332c-b120-9b29fd083fda",
                                "text": "„Der Dauermagnet eines fremderregten Gleichstrommotors ist feststehend und wird als Stator bezeichnet.“"
                            }
                        ],
