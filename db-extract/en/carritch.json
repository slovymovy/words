                            {
                                "example_id": "88628805-4967-4267-8e1b-c318521ed435",
                                "sense_id": "ec4acdd1-260c-3922-ae23-11e74e65a5bc",
                                "text": "\"Do sae, minister — do sae,\" cried Madge; \"I am as weel worth looking at as ony book in your aught. — And I can say the single carritch, and the double carritch, and justification, and effectual calling, and the assembly of divines at Westminster, that is,\" (she added in a low tone) \" I could say them anes -- but it's lang syne -- and ane forgets, ye ken.\""
                            },
                            {
                                "example_id": "5f18b125-28f7-4870-a278-760e06d83d25",
                                "sense_id": "ec4acdd1-260c-3922-ae23-11e74e65a5bc",
                                "text": "Can I forget how lang and weel The carritches ye made me read ?"
                            },
                            {
                                "example_id": "02168c98-db39-420b-aa1c-aa6662350dcc",
                                "sense_id": "ec4acdd1-260c-3922-ae23-11e74e65a5bc",
                                "text": "Christily is a most faithful young woman with a face as red and lush as a rasp, who knows her carritches both ways, and has such a reverence for ministers that she looks upon me more as an edifice than a mortal."
                            }
                        ]
                    }
