                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbb55e9d-bfaf-4108-970f-398e3db93cdc",
                        "source_entry_id": "f8593cee-4f11-3a55-be11-b4e9b1849ee7",
                        "source_sense_id": "d4ec9cb3-bcaa-3b92-b9f0-2720e0f6fa84",
                        "source_sense_description": "afschuw opwekkend",
                        "target_lang_word": "grässlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grässlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2bd5343e-bf7a-33b5-8f29-057d0f105f36",
                                        "entry_id": "9a740f3b-ef43-32b4-a8d2-1568f9c585f4",
                                        "glosses": [
                                            "Ekel oder sehr negative Gefühle hervorrufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de24526e-d43b-4360-ba8d-12e813bb41cc",
                                                "sense_id": "2bd5343e-bf7a-33b5-8f29-057d0f105f36",
                                                "text": "„Da müssen die Autos auch mal so grässlich unsexy aussehen wie der neueste Jahrgang, außerhalb des Augenmaßes für die Sinnlichkeit einer Rennmaschine.“"
                                            },
                                            {
                                                "example_id": "6d897251-6141-4109-a026-a02e21802c34",
                                                "sense_id": "2bd5343e-bf7a-33b5-8f29-057d0f105f36",
                                                "text": "„Dunkle Ahnungen eines gräßlichen mir drohenden Geschicks breiten sich wie schwarze Wolkenschatten über mich aus, undurchdringlich jedem freundlichen Sonnenstrahl.“"
                                            },
                                            {
                                                "example_id": "a4f9c914-8f54-4d71-b242-cdac0a8c5be5",
                                                "sense_id": "2bd5343e-bf7a-33b5-8f29-057d0f105f36",
                                                "text": "„Hässlich, ich bin so hässlich, so grässlich hässlich:“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29c7f35c-5281-4090-bbe2-1c3a65c06ef5",
                        "source_entry_id": "f8593cee-4f11-3a55-be11-b4e9b1849ee7",
                        "source_sense_id": "d4ec9cb3-bcaa-3b92-b9f0-2720e0f6fa84",
                        "source_sense_description": "afschuw opwekkend",
                        "target_lang_word": "grausig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grausig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd14f851-b3be-3350-86e7-afe3efcc7f92",
                                        "entry_id": "bb0c4903-a406-3012-b282-44ffd748ff1e",
                                        "glosses": [
                                            "Grausen auslösend; entsetzlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7c01f33-df38-43bd-bef9-2bae137961e7",
                                                "sense_id": "bd14f851-b3be-3350-86e7-afe3efcc7f92",
                                                "text": "In ihrer Nachbarschaft wurde ein grausiger Fund gemacht."
                                            },
                                            {
                                                "example_id": "5140644a-657a-403a-8246-dbb3e8cf5176",
                                                "sense_id": "bd14f851-b3be-3350-86e7-afe3efcc7f92",
                                                "text": "„Über 50 Jahre nach den grausigen Verbrechen ist ein Mann nun sicher, den Killer identifiziert zu haben – es soll sein Vater sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f3d51e50-f9f1-3706-a7f5-f0a0f00b0c5a",
                                        "entry_id": "bb0c4903-a406-3012-b282-44ffd748ff1e",
                                        "glosses": [
                                            "arg, besonders; sehr"
                                        ],
                                        "tags": [
                                            "mundartlich",
                                            "verstärkend",
                                            "adverbiell"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f57b5848-2ae3-43d3-9469-9013279eacef",
                                                "sense_id": "f3d51e50-f9f1-3706-a7f5-f0a0f00b0c5a",
                                                "text": "Ich finde, so grausig attraktiv ist Charlotte dann auch wieder nicht."
                                            },
                                            {
                                                "example_id": "efaa7121-481f-4e76-9eb3-7fa85b8123cc",
                                                "sense_id": "f3d51e50-f9f1-3706-a7f5-f0a0f00b0c5a",
                                                "text": "Ich habe keine grausige Lust, morgen so früh auszustehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5af99fbb-397e-41c5-8f88-e9eeadeb6934",
                        "source_entry_id": "f8593cee-4f11-3a55-be11-b4e9b1849ee7",
                        "source_sense_id": "d4ec9cb3-bcaa-3b92-b9f0-2720e0f6fa84",
                        "source_sense_description": "afschuw opwekkend",
                        "target_lang_word": "gruesome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gruesome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "620d6944-1a9b-363f-becd-35b3a8160aaf",
                                        "entry_id": "27818388-a396-3eff-b661-acdc9ffbf4d9",
                                        "glosses": [
                                            "Repellently frightful and shocking; horrific or ghastly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fc5b0a3-2460-4fce-ae55-41921d76a167",
                                                "sense_id": "620d6944-1a9b-363f-becd-35b3a8160aaf",
                                                "text": "True, there were the usual night-sounds of the country—the whir of night-birds, the buzzing of insects, the barking of distant dogs, the mellow lowing of far-off kine—but these didn't seem to break the stillness, they only intensified it, and added a grewsome melancholy to it into the bargain."
                                            },
                                            {
                                                "example_id": "ec579843-90f4-4526-b70d-bc9ca7313019",
                                                "sense_id": "620d6944-1a9b-363f-becd-35b3a8160aaf",
                                                "text": "In the middle of the floor lay a skeleton, every vestige of flesh gone from the bones to which still clung the mildewed and moldered remnants of what had once been clothing. Upon the bed lay a similar gruesome thing, but smaller, while in a tiny cradle near-by was a third, a wee mite of a skeleton."
                                            },
                                            {
                                                "example_id": "825fe0ba-6220-4f03-a3d1-62e2635f8317",
                                                "sense_id": "620d6944-1a9b-363f-becd-35b3a8160aaf",
                                                "text": "Jay Carney said that the US was considering whether to release photos of bin Laden after he was killed on Sunday but that the photos were gruesome and could be inflammatory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98cc9c1e-2e57-491e-a9ac-172f16194198",
                        "source_entry_id": "f8593cee-4f11-3a55-be11-b4e9b1849ee7",
