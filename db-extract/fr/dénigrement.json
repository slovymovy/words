        "fr-extract.jsonl": [
            {
                "entry_id": "d6ffcce1-3adb-39f8-a9df-0c261b8d1eb9",
                "word": "dénigrement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "adadef02-2287-41d2-a638-cb9a8dcba5ae",
                        "entry_id": "d6ffcce1-3adb-39f8-a9df-0c261b8d1eb9",
                        "tags": [
                            "plural"
                        ],
                        "form": "dénigrements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "61f59aae-f2dc-34c7-b93b-ec28ed54b994",
                        "entry_id": "d6ffcce1-3adb-39f8-a9df-0c261b8d1eb9",
                        "glosses": [
                            "Action de dénigrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2448499-8277-4dd5-ad04-89f4f89d2725",
                                "sense_id": "61f59aae-f2dc-34c7-b93b-ec28ed54b994",
                                "text": "…, les dires de ses gens à qui le mot fut donné, prêtaient un air de vraisemblance à ces fables grossières, auxquelles chacun crut en obéissant à l’esprit de dénigrement qui anime les commerçants les uns contre les autres."
                            },
                            {
                                "example_id": "0d6d9dda-8bf0-4e18-9605-7c3dc25b6cf0",
                                "sense_id": "61f59aae-f2dc-34c7-b93b-ec28ed54b994",
                                "text": "Elle ne retiendra pas plus le dénigrement disproportionné de l’homme politique auquel s'acharnèrent les gens de droite que les grotesques injures dont le suppôt de Satan fut l’objet."
                            },
                            {
                                "example_id": "e02f31a6-36be-4f05-88b9-527e5bc75d5b",
                                "sense_id": "61f59aae-f2dc-34c7-b93b-ec28ed54b994",
                                "text": "L’approbation a tellement moins de nuances que le dénigrement !"
                            },
                            {
                                "example_id": "4fa04516-1282-49ed-a299-6de41d8fa362",
                                "sense_id": "61f59aae-f2dc-34c7-b93b-ec28ed54b994",
                                "text": "Les partis modérés, qui nous avaient donné leur sympathie, leur appui moral et qui dans bien des cas étaient de complicité avec nous, nous abandonnèrent et commencèrent une ardente campagne de dénigrement qui entraîna tous les hésitants, les couards et la masse flottante de la petite bourgeoisie dont les oboles régulières nous étaient indispensables."
                            },
                            {
                                "example_id": "12eeb06b-b408-4b08-ae69-1e77f52da9d3",
                                "sense_id": "61f59aae-f2dc-34c7-b93b-ec28ed54b994",
                                "text": "De quelle culture québécoise hostile aux autres parle-t-il ? Les livres, les pièces, les films, les séries des vingt dernières années ont donc été une vaste entreprise de dénigrement des minorités culturelles ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5abd2ce7-e105-46a5-bd9b-0be81386f0d9",
                        "source_entry_id": "d6ffcce1-3adb-39f8-a9df-0c261b8d1eb9",
                        "source_sense_id": "61f59aae-f2dc-34c7-b93b-ec28ed54b994",
                        "target_lang_word": "Herabwürdigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herabwürdigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d61785c-b074-32da-9f9d-71f373a70c58",
                                        "entry_id": "b40eeef4-9e87-37bb-a8ee-c98fe1bd6a6e",
                                        "glosses": [
                                            "Geringschätzung der Leistung einer Person; Abwertung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b54fd63-7fe6-40fc-a9e4-e2a26ecf99a5",
                                                "sense_id": "8d61785c-b074-32da-9f9d-71f373a70c58",
                                                "text": "„Er empfindet diese Behauptung als eine Herabwürdigung seiner Person.“"
                                            },
                                            {
                                                "example_id": "9295b303-8339-4384-8dc1-8325bc672054",
                                                "sense_id": "8d61785c-b074-32da-9f9d-71f373a70c58",
                                                "text": "„Die Herabwürdigung kommt dadurch ohne externe Verweise auf persönliche Merkmale, wie beispielsweise schlechte Kleidung, oder andere Verhaltensweisen des zahlungssäumigen Mitglieds aus.“"
                                            },
                                            {
                                                "example_id": "63d2654a-0f2c-44f0-bb01-8ec948a792d6",
                                                "sense_id": "8d61785c-b074-32da-9f9d-71f373a70c58",
                                                "text": "„Nichts ist besser oder schlechter als das andere, und Herabwürdigungen mit Ausdrücken wie ‚banal‘ oder ‚stupide‘ sind selbstverständlich verboten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd341710-2169-4f23-b3d8-0ce9dadd9d74",
                        "source_entry_id": "d6ffcce1-3adb-39f8-a9df-0c261b8d1eb9",
                        "source_sense_id": "61f59aae-f2dc-34c7-b93b-ec28ed54b994",
                        "target_lang_word": "Verunglimpfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verunglimpfung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ff6b2bd-6d86-3344-8b3d-7f81f2a2fa11",
                                        "entry_id": "143c7379-3e0a-3471-90a8-cdd90e765236",
                                        "glosses": [
                                            "Herabsetzung, Verächtlichmachung von jemandem oder etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63292ca3-ac82-4862-9a6d-3079ef3e7601",
                                                "sense_id": "7ff6b2bd-6d86-3344-8b3d-7f81f2a2fa11",
                                                "text": "„Seit Mitte des 19. Jahrhunderts wurde es zur Verunglimpfung von Personen verwendet.“"
                                            },
                                            {
                                                "example_id": "78c92635-1df6-43ea-a677-5639c4d26389",
                                                "sense_id": "7ff6b2bd-6d86-3344-8b3d-7f81f2a2fa11",
                                                "text": "„Der sogenannte Blasphemieartikel 295 a-c des pakistanischen Strafgesetzbuchs stellt die Schändung religiöser Texte jeder Religionsgruppe unter Strafe. Auf die Verunglimpfung des Korans steht lebenslange Haft, auf die des Propheten die Todesstrafe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2cf5c851-136c-44b6-be91-f897fee62458",
                        "source_entry_id": "d6ffcce1-3adb-39f8-a9df-0c261b8d1eb9",
