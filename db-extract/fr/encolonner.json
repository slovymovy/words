                ],
                "senses": [
                    {
                        "sense_id": "73f3314b-93ba-3304-af74-77543cca0dc4",
                        "entry_id": "aa37bc97-6f19-3f8e-8b1b-c0923cadfd73",
                        "glosses": [
                            "Ranger, dresser sur une même colonne."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "a6ca4089-6319-4033-a2e3-9dd930e1d92b",
                                "sense_id": "73f3314b-93ba-3304-af74-77543cca0dc4",
                                "text": "Un pupitre à plan incliné renferme tout l’outillage intellectuel du maître fromager. Un cahier de grand format encolonne les apports de lait des producteurs."
                            },
                            {
                                "example_id": "7ae86675-3ec4-411c-9970-de503c0376e3",
                                "sense_id": "73f3314b-93ba-3304-af74-77543cca0dc4",
                                "text": "Le conducteur qui en suit un autre n a pas le droit de le talonner pour le faire quitter la voie . Il doit lui laisser le temps de prendre une distance suffisante pour encolonner sur la droite."
                            },
                            {
                                "example_id": "1c7aa5ea-8845-4e99-ad1f-ff7807928f2d",
                                "sense_id": "73f3314b-93ba-3304-af74-77543cca0dc4",
                                "text": "Certains évêques, en effet, n'ont pas caché leur soutien aux mouvements, à condition de pouvoir les encolonner dans les plans pastoraux diocésains et de couper tout ce qui dépasse."
                            },
                            {
                                "example_id": "d0643218-3a49-407d-ace3-33929801c433",
                                "sense_id": "73f3314b-93ba-3304-af74-77543cca0dc4",
                                "text": "Nous avons fait encolonner les voitures sur la ligne de départ à 11 h30 , afin de leur permettre de disputer tout de même une montée de course , mais les conditions de visibilité ont alors commencé à empirer."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa2752a6-389a-38ba-9e56-1d65bffd2e2c",
                        "entry_id": "aa37bc97-6f19-3f8e-8b1b-c0923cadfd73",
                        "glosses": [
                            "Se mettre en colonne."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a82a5a58-b1d7-33b5-ac23-d242486487f4",
                        "entry_id": "aa37bc97-6f19-3f8e-8b1b-c0923cadfd73",
                        "glosses": [
                            "S’enrôler dans une armée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "693e0859-4df8-4035-84b1-7cd419f9807f",
                                "sense_id": "a82a5a58-b1d7-33b5-ac23-d242486487f4",
                                "text": "Il a raison, dit Joseph, le Français est trop fier de sa colonne pour aller s’encolonner ailleurs."
                            }
                        ]
                    }
