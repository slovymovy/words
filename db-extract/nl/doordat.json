                    {
                        "sense_id": "3368ddc7-8a75-31a7-90ea-019bf23365e1",
                        "entry_id": "77cd0ba7-6d61-356f-8f3a-e9ef7cac1169",
                        "glosses": [
                            "geeft onderschikkend een oorzaak aan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74a6c5e7-7481-4c9e-8412-420c12f9316b",
                                "sense_id": "3368ddc7-8a75-31a7-90ea-019bf23365e1",
                                "text": "De straten zijn glad doordat het geregend heeft."
                            },
                            {
                                "example_id": "64f2da94-0879-43e8-a9fa-c22f6c195154",
                                "sense_id": "3368ddc7-8a75-31a7-90ea-019bf23365e1",
                                "text": "Doordat het geregend heeft zijn de straten glad."
                            },
                            {
                                "example_id": "28e8d17b-046d-4619-ad05-4d7c79f15dcf",
                                "sense_id": "3368ddc7-8a75-31a7-90ea-019bf23365e1",
                                "text": "Doordat Rezeki begint te blaffen, hoeft Nella daar geen antwoord op te geven."
                            },
                            {
                                "example_id": "6328d539-fb63-4e77-96cf-0eb2a1fdc4e3",
                                "sense_id": "3368ddc7-8a75-31a7-90ea-019bf23365e1",
                                "text": "Doordat de wind recht mijn kant opblies en het geluid van de donder steeds dichterbij kwam bleven mijn tranen stromen."
                            }
                        ]
                    }
                ],
