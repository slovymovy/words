{
    "word_family": [
        "donate",
        "donation",
        "donative"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "940ae706-aabb-3d3e-ac47-b6a71525e05d",
                    "sense_definition": "A person or organization that gives something, such as money, blood, or an organ, to help others.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "giving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local hospital is urgently seeking a blood <w>donor</w> with a rare type.",
                            "target_lang_translations": {
                                "ru": "Местная больница срочно ищет <w>донора</w> крови с редкой группой."
                            }
                        },
                        {
                            "text": "A generous anonymous <w>donor</w> provided the funds needed to build the new library.",
                            "target_lang_translations": {
                                "ru": "Щедрый анонимный <w>жертвователь</w> предоставил средства, необходимые для строительства новой библиотеки."
                            }
                        }
                    ],
                    "synonyms": [
                        "donater",
                        "donator"
                    ],
                    "antonyms": [
                        "recipient",
                        "receiver"
                    ],
                    "common_phrases": [
                        "anonymous donor",
                        "organ donor",
                        "blood donor",
                        "charity donor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или организация, которые предоставляют что-либо (деньги, кровь, органы) для помощи другим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "донор",
                                "target_lang_sense_clarification": "в медицине или благотворительности"
                            },
                            {
                                "target_lang_word": "жертвователь",
                                "target_lang_sense_clarification": "тот, кто делает денежные пожертвования"
                            },
                            {
                                "target_lang_word": "меценат",
                                "target_lang_sense_clarification": "спонсор в сфере культуры или искусства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d28b723-3416-3a1a-a76e-ddbdb5853d73",
                    "sense_definition": "An atom, molecule, or group that provides electrons or a chemical group during a reaction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this specific chemical reaction, the nitrogen atom acts as an electron <w>donor</w>.",
                            "target_lang_translations": {
                                "ru": "В этой конкретной химической реакции атом азота выступает в качестве <w>донора</w> электронов."
                            }
                        },
                        {
                            "text": "Scientists identified a carbonyl <w>donor</w> molecule that facilitates the bonding process.",
                            "target_lang_translations": {
                                "ru": "Ученые идентифицировали молекулу-<w>донор</w> карбонила, которая способствует процессу связывания."
                            }
                        }
                    ],
                    "antonyms": [
                        "acceptor"
                    ],
                    "common_phrases": [
                        "electron donor",
                        "proton donor",
                        "donor molecule"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Атом, молекула или группа, отдающая электроны или химическую группу в ходе реакции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "донор",
                                "target_lang_sense_clarification": "в химии и физике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29e9ce5d-6703-32bb-8ed6-49a18801e789",
                    "sense_definition": "An object, such as a car or machine, that is used to provide spare parts for another similar object.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mechanics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a rusted car to serve as a <w>donor</w> vehicle for his restoration project.",
                            "target_lang_translations": {
                                "ru": "Он купил заржавевший автомобиль, чтобы использовать его как машину-<w>донор</w> для своего проекта по реставрации."
                            }
                        },
                        {
                            "text": "You will need to swap the connector from the <w>donor</w> to make the fan switch work.",
                            "target_lang_translations": {
                                "ru": "Вам нужно будет переставить разъем с <w>донора</w>, чтобы заработал переключатель вентилятора."
                            }
                        }
                    ],
                    "common_phrases": [
                        "donor car",
                        "donor vehicle",
                        "donor engine"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used by mechanics or hobbyists"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объект (автомобиль или механизм), используемый как источник запасных частей для другого аналогичного объекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "донор",
                                "target_lang_sense_clarification": "технический жаргон"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}