                                        "examples": [
                                            {
                                                "example_id": "07e81b92-84be-4455-83b3-1c9a62506732",
                                                "sense_id": "2c95065a-7bdb-3665-8de0-c7e54fed7c39",
                                                "text": "Der Bau dieser kleinen Straße hat nur regional eine Bedeutung."
                                            },
                                            {
                                                "example_id": "e3fae6c9-2e1d-4a20-98ed-e59eccf7bb3b",
                                                "sense_id": "2c95065a-7bdb-3665-8de0-c7e54fed7c39",
                                                "text": "„Zu ungleich seien die sozialen, wirtschaftlichen und politischen Verhältnisse, als dass das tunesische Beispiel auf einen regionalen Flächenbrand hindeutete.“"
                                            },
                                            {
                                                "example_id": "708b6485-ae6b-4200-afb6-36d9dfe143ae",
                                                "sense_id": "2c95065a-7bdb-3665-8de0-c7e54fed7c39",
                                                "text": "„Hinsichtlich der regionalen Faktoren sei die Nachbarschaft zum deutschen Sprachgebiet (Deutschland, Österreich) von Bedeutung, während bezüglich der ethnischen Faktoren die Situation des Deutschen als Minderheitensprache in Ungarn zu berücksichtigen sei.“"
                                            },
                                            {
                                                "example_id": "b0a3100a-2053-462b-81d9-2ccdc8333421",
                                                "sense_id": "2c95065a-7bdb-3665-8de0-c7e54fed7c39",
                                                "text": "„Die in der regionalen Geographie verwendete Grenzgürtelmethode hat bei formaler Handhabung jedoch meist wenig Aussagekraft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
