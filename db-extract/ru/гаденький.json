                                        "sense_id": "87f369ce-4eaa-3ce3-96f0-1a62afe01227",
                                        "entry_id": "f33ca445-3086-3265-9afb-d03f2ecdbf5c",
                                        "glosses": [
                                            "Personne qui provoque le dégoût."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
