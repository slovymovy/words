                "senses": [
                    {
                        "sense_id": "989dcdb9-8756-38b8-83b0-761f3ebcb238",
                        "entry_id": "82894534-2e43-3de0-86bd-71595357941a",
                        "glosses": [
                            "Person, die das Fach Jura/Rechtswissenschaft studiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1f3053d-ab8f-4e88-a2e4-7b1a65974a64",
                                "sense_id": "989dcdb9-8756-38b8-83b0-761f3ebcb238",
                                "text": "„Natürlich weiß sie, dass die meisten Jurastudenten heute keine Lust haben auf Xus Leben oder auch auf ihres.“"
                            },
                            {
                                "example_id": "44ece4ac-34b3-4fa7-b6fa-67f2ea553c44",
                                "sense_id": "989dcdb9-8756-38b8-83b0-761f3ebcb238",
                                "text": "„Der ehemalige Jurastudent Frank Wedekind wurde später in München nicht nur seßhaft, sondern er blieb dieser Stadt auch treu.“"
                            },
                            {
                                "example_id": "9fdfe3aa-774c-4f58-8974-194007b78460",
                                "sense_id": "989dcdb9-8756-38b8-83b0-761f3ebcb238",
                                "text": "„Jurastudenten besuchten das örtliche Gericht, Medizinstudenten wurden im Krankenhaus eingesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
