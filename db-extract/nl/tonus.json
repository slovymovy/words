                                    {
                                        "sense_id": "b45c1898-9356-3bb4-99f7-14a72afcee58",
                                        "entry_id": "76972fdc-2808-3659-841a-11d3afc04ea6",
                                        "glosses": [
                                            "The pitch of a word's sound that distinguishes a difference in meaning, as for example in Chinese."
