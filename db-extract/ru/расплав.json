                ],
                "translations": [
                    {
                        "translation_id": "a00eb538-d967-49c3-9db6-7c6ccfb0e6d0",
                        "source_entry_id": "addde3ce-6882-316b-b63c-77f490253077",
                        "source_sense_id": "b9024353-9e40-346e-99f0-b78bec40c165",
                        "target_lang_word": "melt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "melt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a20ef6e1-add5-33d9-a236-b77dad9c9809",
                                        "entry_id": "7bec4a36-d275-30e2-b25f-e38e82ab44ae",
                                        "glosses": [
                                            "To change (or to be changed) from a solid state to a liquid state, usually by a gradual heat."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebb3a97e-5080-4f65-927d-e1b6369a52e7",
                                                "sense_id": "a20ef6e1-add5-33d9-a236-b77dad9c9809",
                                                "text": "I melted butter to make a cake."
                                            },
                                            {
                                                "example_id": "a3b8b630-cf22-4771-8d9c-f5a8ef8419a8",
                                                "sense_id": "a20ef6e1-add5-33d9-a236-b77dad9c9809",
                                                "text": "When the weather is warm, the snowman will disappear; he will melt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df4046a0-0a2c-3e83-a4a2-07e3a1fc42e7",
                                        "entry_id": "7bec4a36-d275-30e2-b25f-e38e82ab44ae",
                                        "glosses": [
                                            "To dissolve, disperse, vanish."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "478de517-e47f-415c-b88b-e905be1914e6",
                                                "sense_id": "df4046a0-0a2c-3e83-a4a2-07e3a1fc42e7",
                                                "text": "His troubles melted away."
                                            },
                                            {
                                                "example_id": "ed640790-c774-4a08-88b6-78f9f3accab7",
                                                "sense_id": "df4046a0-0a2c-3e83-a4a2-07e3a1fc42e7",
                                                "text": "I gave him a couple of Advil and, after a few minutes, urged him back onto the track. Over the next few laps his pained expression slowly melted, although he still shuffled with a slight limp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4daf3102-fa82-31fc-ba96-3ae7a3072995",
                                        "entry_id": "7bec4a36-d275-30e2-b25f-e38e82ab44ae",
                                        "glosses": [
                                            "To soften, as by a warming or kindly influence; to relax; to render gentle or susceptible to mild influences; sometimes, in a bad sense, to take away the firmness of; to weaken."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5625b679-05e9-4507-9a93-eec7252d52b8",
                                                "sense_id": "4daf3102-fa82-31fc-ba96-3ae7a3072995",
                                                "text": "Thou would'st have […] melted down thy youth."
                                            },
                                            {
                                                "example_id": "9f104968-07b5-456f-b824-9686df589289",
                                                "sense_id": "4daf3102-fa82-31fc-ba96-3ae7a3072995",
                                                "text": "For pity melts the mind to love."
                                            },
                                            {
                                                "example_id": "97364f8b-4bbd-4cca-9e3d-b2d916d3d3a3",
                                                "sense_id": "4daf3102-fa82-31fc-ba96-3ae7a3072995",
                                                "text": "The traveller hears me now and then,\n⁠And sometimes harshly will he speak:\n⁠‘This fellow would make weakness weak,\nAnd melt the waxen hearts of men.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c6b5668-25fb-3c3b-ac9f-aab344167cb7",
                                        "entry_id": "7bec4a36-d275-30e2-b25f-e38e82ab44ae",
                                        "glosses": [
                                            "To be discouraged."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "63a83ede-5d1f-321b-976f-3dd42e8c20a5",
                                        "entry_id": "7bec4a36-d275-30e2-b25f-e38e82ab44ae",
                                        "glosses": [
                                            "To be emotionally softened or touched."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ee919f3-6c93-46c1-96ac-6b3e625d30d4",
                                                "sense_id": "63a83ede-5d1f-321b-976f-3dd42e8c20a5",
                                                "text": "She melted when she saw the romantic message in the Valentine's Day card."
                                            },
                                            {
                                                "example_id": "d8936015-04a6-4665-acda-dfb749c6db9a",
                                                "sense_id": "63a83ede-5d1f-321b-976f-3dd42e8c20a5",
                                                "text": "My heart melted when I first heard the song."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94f15c1d-ee50-3950-8f08-2ab8b2638796",
                                        "entry_id": "7bec4a36-d275-30e2-b25f-e38e82ab44ae",
                                        "glosses": [
                                            "To be very hot and sweat profusely."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47c773b1-8462-48ce-9846-5a53b0d186d4",
                                                "sense_id": "94f15c1d-ee50-3950-8f08-2ab8b2638796",
                                                "text": "I need shade! I'm melting!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "melt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc6548ad-06a9-3b7a-ae39-9f267b73927e",
                                        "entry_id": "bf76a953-1c36-3faf-af30-9e5973931790",
                                        "glosses": [
                                            "Molten material, the product of melting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76bdcbda-8e06-4271-9ecc-df40bde317d4",
                                                "sense_id": "dc6548ad-06a9-3b7a-ae39-9f267b73927e",
                                                "text": "The crust (a mere 1% of the Earth's volume) is made of lighter melt products from the mantle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d62b24e0-486d-3c0e-889d-3a88c795f0a8",
                                        "entry_id": "bf76a953-1c36-3faf-af30-9e5973931790",
                                        "glosses": [
                                            "The transition of matter from a solid state to a liquid state."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f90cc32e-795c-366c-9232-754b5d65ee6c",
                                        "entry_id": "bf76a953-1c36-3faf-af30-9e5973931790",
                                        "glosses": [
                                            "The springtime snow runoff in mountain regions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5553323-3b15-36dd-993a-fc43ed8944be",
                                        "entry_id": "bf76a953-1c36-3faf-af30-9e5973931790",
                                        "glosses": [
                                            "A melt sandwich."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "915afabc-cabf-459a-a28f-956836a879fa",
                                                "sense_id": "c5553323-3b15-36dd-993a-fc43ed8944be",
                                                "text": "I recently asked a group of people whether they had eaten tuna melts as a kid. Everyone remembered a version of this dish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcc4fa20-b276-3c2e-8fb7-fc863c7e4f73",
                                        "entry_id": "bf76a953-1c36-3faf-af30-9e5973931790",
                                        "glosses": [
                                            "Rock showing evidence of having been remelted after it originally solidified."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d743572e-bcfa-4020-8b50-39a434006923",
                                                "sense_id": "fcc4fa20-b276-3c2e-8fb7-fc863c7e4f73",
                                                "text": "Numerous samples of breccia and impact melts were recovered by drilling into the floor of the crater."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74dad39c-d8f3-30af-9bbe-33ba8757c710",
                                        "entry_id": "bf76a953-1c36-3faf-af30-9e5973931790",
                                        "glosses": [
                                            "A wax-based substance for use in an oil burner as an alternative to mixing oils and water."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "610dddce-7828-3382-94ff-b428a1802954",
                                        "entry_id": "bf76a953-1c36-3faf-af30-9e5973931790",
                                        "glosses": [
                                            "An idiot."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "derogatory",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68053be2-30dd-4661-94fa-87f58fef5807",
                                                "sense_id": "610dddce-7828-3382-94ff-b428a1802954",
                                                "text": "You are from Blackburn you fucking melt...have a bastard word with yourself."
                                            },
                                            {
                                                "example_id": "9eae9212-b633-4bdb-b810-8d59b0e0d8ce",
                                                "sense_id": "610dddce-7828-3382-94ff-b428a1802954",
                                                "text": "Kiss it ya melt!"
                                            },
                                            {
                                                "example_id": "8a1736e1-2f26-4151-aae7-a50d4b408064",
                                                "sense_id": "610dddce-7828-3382-94ff-b428a1802954",
                                                "text": "LOL! you fucking melt. Get a job."
                                            },
                                            {
                                                "example_id": "b0873dec-6ed6-42ca-9f85-aab316ce60ee",
                                                "sense_id": "610dddce-7828-3382-94ff-b428a1802954",
                                                "text": "Over the course of this chapter on 'Love Island Essentials' we'll be charting exactly who went with who, showing you around the villa, and equipping you with the vocabulary you'll need to avoid looking like a melt and get grafting like a true Islander."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5474a385-faaf-371d-b8ae-51a057f415d3",
                                        "entry_id": "bf76a953-1c36-3faf-af30-9e5973931790",
                                        "glosses": [
                                            "A centre-left or liberal person, when in opposition to a leftist; (especially) a critic of Jeremy Corbyn within the Labour Party."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "derogatory",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75f02c28-4f62-4631-b5bc-3694a895a652",
                                                "sense_id": "5474a385-faaf-371d-b8ae-51a057f415d3",
                                                "text": "Anyone who said different was a Tory, a melt or – worse – a Blairite. Centrists (mostly Labour voters) were the devil incarnate."
                                            },
                                            {
                                                "example_id": "bbb0750f-295c-4b0c-aa8a-5e62af1dd420",
                                                "sense_id": "5474a385-faaf-371d-b8ae-51a057f415d3",
                                                "text": "They developed their own lexicon, with Corbyn critics referred to as 'melts' or 'slugs' while their man was lauded as 'the absolute boy'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7e3e243-e474-35ec-acf4-4988a5261d16",
                                        "entry_id": "bf76a953-1c36-3faf-af30-9e5973931790",
                                        "glosses": [
                                            "Variant spelling of milt, the semen of a male fish, used as food."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f64c48c1-3a0c-4ece-b56e-ebe296a9319b",
                                                "sense_id": "d7e3e243-e474-35ec-acf4-4988a5261d16",
                                                "text": "A mass of herring melts, tinged with the streams of claret, had fallen into his hair, and this, added to his temporary stupor, had led to the Doctor's mistake."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
