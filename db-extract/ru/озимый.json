                ],
                "senses": [
                    {
                        "sense_id": "24385955-1b61-30dd-9b6f-4e24872538af",
                        "entry_id": "4b3bb50e-1a2d-3459-b0dc-be5d8a36fea2",
                        "glosses": [
                            "с.-х. высеваемый и прорастающий осенью, зимующий под снегом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e21ed34-260a-479a-bf55-f1cd73cd2f42",
                                "sense_id": "24385955-1b61-30dd-9b6f-4e24872538af",
                                "text": "Наступила осень ― запашки и посевы озимых хлебов, чинка амбаров, риг, скотных дворов, хлебный опыт и первый умолот."
                            },
                            {
                                "example_id": "2364ec06-df45-4aff-b7fe-df75777a0d0a",
                                "sense_id": "24385955-1b61-30dd-9b6f-4e24872538af",
                                "text": "К счастию, страда кончается: и с озимым отсеялись, и снопы с поля свезены и сложены в скирды, и последнее сено убрали."
                            }
                        ]
                    },
                    {
                        "sense_id": "25b3ef15-3453-3f3f-bacf-13dacd6dbba2",
                        "entry_id": "4b3bb50e-1a2d-3459-b0dc-be5d8a36fea2",
                        "glosses": [
                            "с.-х. занятый посевами культур, высеянных осенью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c61ba475-9094-4abb-a31a-651112a7dcc5",
                                "sense_id": "25b3ef15-3453-3f3f-bacf-13dacd6dbba2",
                                "text": "С другой стороны и впереди до сада и нашего дома, видневшегося из-за него, чернело и кое-где полосами уже зеленело озимое оттаявшее поле."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c614e6f-931e-4d48-ab52-06f8ca7d8ec3",
                        "source_entry_id": "4b3bb50e-1a2d-3459-b0dc-be5d8a36fea2",
                        "source_sense_description": "о растениях",
                        "target_lang_word": "winter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
