                    "frequency": "High",
                    "semantic_group_id": "difficulte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur se trouve dans une situation <w>délicate</w> après cette annonce imprévue."
                        },
                        {
                            "text": "C'est un sujet très <w>délicat</w> qu'il vaut mieux aborder avec diplomatie."
                        }
                    ],
                    "synonyms": [
                        "difficile",
                        "sensible"
                    ],
                    "common_phrases": [
