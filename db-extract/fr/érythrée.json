                        "entry_id": "61900e1a-4174-3059-828c-6d1038bb4c13",
                        "glosses": [
                            "la mer Érythrée (“厄立特里亞海、厄利垂亞海”)的缩略形式"
                        ],
                        "tags": [
                            "form-of",
