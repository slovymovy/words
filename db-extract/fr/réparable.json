                                "sense_id": "f68da799-733c-3dc0-8223-70b6f1b71e3f",
                                "text": "La perte du temps est difficilement réparable."
                            },
                            {
                                "example_id": "33c71b0c-5fa0-44bf-9b43-ea212399d73d",
                                "sense_id": "f68da799-733c-3dc0-8223-70b6f1b71e3f",
                                "text": "Il a manqué une occasion dont la perte n’est pas réparable."
                            },
