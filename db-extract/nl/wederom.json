                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "357ef085-b5bf-303c-a1c8-7c1b46224670",
                        "entry_id": "e26f4048-1e4d-380d-92ab-8500d76cdc8d",
                        "glosses": [
                            "opnieuw, weer eens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b0f1e76-63ba-4652-9013-f69b4d46ef7f",
                                "sense_id": "357ef085-b5bf-303c-a1c8-7c1b46224670",
                                "text": "Dat is wederom een verzwakking van het gehele stelsel."
                            },
                            {
                                "example_id": "48c2e8c5-a6e4-4223-8c6c-7ef4c73ca18e",
                                "sense_id": "357ef085-b5bf-303c-a1c8-7c1b46224670",
                                "text": "Ik probeerde het nogmaals maar de lijn was wederom heel slecht en de helft van mijn woorden viel weg."
                            },
                            {
                                "example_id": "4616a890-d414-4d60-bcda-3b4e02a6fe8a",
                                "sense_id": "357ef085-b5bf-303c-a1c8-7c1b46224670",
                                "text": "Fluiten, galjoten hoekers, spiegelretourschepen - allerlei vormen en doelen ten bate van de republiek De meeste masten zijn kaal, het tuigage en de zeilen opgeborgen, beschermd tegen de elementen tot het wederom tijd wordt om ze te teren, te hijsen en over het hout te spannen."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
