{
    "word_family": [
        "rekenen",
        "berekenen",
        "afrekenen",
        "rekening"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1673731a-6015-38a2-aec9-a0c3f74c04e3",
                    "sense_definition": "Een bepaalde prijs in rekening brengen of vragen voor een product of dienst.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "prijs_vragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De winkelier wilde mij geen extra kosten <w>aanrekenen</w> voor de bezorging.",
                            "target_lang_translations": {
                                "en": "The shopkeeper did not want to <w>charge</w> me extra costs for delivery."
                            }
                        },
                        {
                            "text": "Hoeveel gaat de garagehouder ons <w>aanrekenen</w> voor deze reparatie?",
                            "target_lang_translations": {
                                "en": "How much is the garage owner going to <w>charge</w> us for this repair?"
                            }
                        }
                    ],
                    "synonyms": [
                        "berekenen",
                        "vragen",
                        "kosten"
                    ],
                    "common_phrases": [
                        "kosten aanrekenen",
                        "extra aanrekenen"
                    ],
                    "target_lang_definitions": {
                        "en": "To charge or ask a certain price for a product or service."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "charge",
                                "target_lang_sense_clarification": "to ask for a price or fee"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec6b4b1f-02ed-3770-91f7-036231e7b00d",
                    "sense_definition": "Iemand verantwoordelijk houden voor een fout of een onaangename situatie; kwalijk nemen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verantwoordelijk_houden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt hem die fout toch niet persoonlijk <w>aanrekenen</w>?",
                            "target_lang_translations": {
                                "en": "You can't <w>hold</w> that mistake <w>against</w> him personally, can you?"
                            }
                        },
                        {
                            "text": "Zul je me dat ons hele leven blijven <w>aanrekenen</w>?",
                            "target_lang_translations": {
                                "en": "Will you keep <w>holding</w> that <w>against</w> me for the rest of our lives?"
                            }
                        }
                    ],
                    "synonyms": [
                        "kwalijk nemen",
                        "verwijten"
                    ],
                    "antonyms": [
                        "vergeven",
                        "verontschuldigen"
                    ],
                    "common_phrases": [
                        "iemand iets aanrekenen",
                        "zwaar aanrekenen"
                    ],
                    "target_lang_definitions": {
                        "en": "To hold someone responsible for a mistake or an unpleasant situation; to resent or blame."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blame",
                                "target_lang_sense_clarification": "to hold responsible for a mistake"
                            },
                            {
                                "target_lang_word": "hold against",
                                "target_lang_sense_clarification": "to resent someone for something"
                            },
                            {
                                "target_lang_word": "impute",
                                "target_lang_sense_clarification": "to attribute a crime or mistake to someone"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}