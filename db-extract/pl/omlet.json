                    },
                    {
                        "translation_id": "ac89310b-4268-4eef-87a8-eda6bb3e2f5c",
                        "source_entry_id": "575e8feb-862d-343f-a67c-d986ed1581e2",
                        "source_sense_id": "707d7f3d-50df-31e2-af5a-65ab70a183d6",
                        "target_lang_word": "omeleta",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "omeleta",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "827f0fb0-9385-3765-9c0b-5e4a93c95cf4",
                                        "entry_id": "e84c56cc-4fa9-33f9-9141-afd4305f9201",
                                        "glosses": [
                                            "slaný pokrm z rozkvedlaných osmažených vajec případně ochucených kořením, nadrobno nakrájenou zeleninou, sýrem apod."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f87e337-a187-4069-bd2e-9cacec0344fe",
                                                "sense_id": "827f0fb0-9385-3765-9c0b-5e4a93c95cf4",
                                                "text": "Když je omeleta z jedné strany dozlatova, otoč ji a dopeč i z druhé strany."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efb21bbc-dd6c-3fda-a1d3-6a66a8cf1520",
                                        "entry_id": "e84c56cc-4fa9-33f9-9141-afd4305f9201",
                                        "glosses": [
                                            "palačinka; pokrm z osmaženého litého těsta obvykle z mléka, mouky a vejce, obvykle připravený na sladko (např. pomazáním marmeládou) nebo na slano (např. naplněním upraveným špenátem) a srolovaný do ruličky"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52015df3-7b1c-313c-88a8-f616a1c44685",
                                        "entry_id": "e84c56cc-4fa9-33f9-9141-afd4305f9201",
                                        "glosses": [
                                            "poradní a výcvikový tým – OMLT (Operational Mentoring and Liaison Team)"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0e5ef4d-44c4-422d-9f1d-b62abea6be87",
                                                "sense_id": "52015df3-7b1c-313c-88a8-f616a1c44685",
                                                "text": "Jednotce složené hlavně z odborníků na výcvik, střelbu, taktiku a plánování se přezdívalo „omeleta“ - to kvůli anglické zkratce pro poradní a výcvikový tým - OMLT (Operational Mentoring and Liaison Team)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9d46854-914a-45b9-ad9f-4407c99ac796",
                        "source_entry_id": "575e8feb-862d-343f-a67c-d986ed1581e2",
                        "source_sense_id": "707d7f3d-50df-31e2-af5a-65ab70a183d6",
                        "target_lang_word": "tortilla",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tortilla",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "9b085703-e12a-32fe-b97e-6dacd6cdd4d6",
                                        "entry_id": "c2f71a3d-d8e6-31ab-ac63-a3c22afe8bc4",
                                        "glosses": [
                                            "Plato a base de huevo batido, al que se incorporan otros ingredientes; el conjunto se frie en una sola pieza."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95de3943-4055-42ce-9e46-1687f3796db9",
                                                "sense_id": "9b085703-e12a-32fe-b97e-6dacd6cdd4d6",
                                                "text": "¡Ay, huevo mío de dos yemas, que para echar vos guardava yo! ¡Que de uno o de dos hazía yo una tortilla tan dorada que complía mis vergüenças!"
                                            },
                                            {
                                                "example_id": "260514b4-7f78-4e78-85f3-f09fe740a5ed",
                                                "sense_id": "9b085703-e12a-32fe-b97e-6dacd6cdd4d6",
                                                "text": "Luego pasé a un gallinero de más alante, levantó una gallina clueca que estaba empollando dieciocho huevos de raza e hizo una tortilla como pa un banquete."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a235e113-b4a2-370b-88a7-f77ea9009b01",
                                        "entry_id": "c2f71a3d-d8e6-31ab-ac63-a3c22afe8bc4",
                                        "glosses": [
                                            "Porción de masa de harina de maíz o trigo, redonda, plana y muy delgada que se cocina sobre una superficie caliente, habitualmente un comal; forma parte de la gastronomía tradicional de México y América Central."
                                        ],
                                        "tags": [
                                            "Mexico"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2faed898-fde1-4fa7-9c24-9e1ecbb2a01f",
                                                "sense_id": "a235e113-b4a2-370b-88a7-f77ea9009b01",
                                                "text": "El principal y de mayor dignidad, poder y autoridad, sacerdote, ayunaba ochenta días antes; los cuatro días primeros no comía ni bebía más de una tortilla de maíz, que no pesaba una onza, y un poquillo de agua."
                                            },
                                            {
                                                "example_id": "0639f1dd-6158-44ea-bb47-60b646ef9de0",
                                                "sense_id": "a235e113-b4a2-370b-88a7-f77ea9009b01",
                                                "text": "La tortilla mexicana no tiene nada que ver con las tortillas francesa o española. Ya lo dije en otro capítulo. Es un disco de masa de maíz que se lamina y sutiliza a palmetazos maestros."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3819f62e-3dad-351e-ba5a-a2af02e0afbd",
                                        "entry_id": "c2f71a3d-d8e6-31ab-ac63-a3c22afe8bc4",
                                        "glosses": [
                                            "Pan aplanado de masa muy compacta, sin levadura y habitualmente con algo de manteca."
                                        ],
                                        "tags": [
                                            "Bolivia",
                                            "Chile",
