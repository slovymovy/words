                        "sense_id": "57a4d9a3-4dac-3ad7-99be-a8fe9d272316",
                        "entry_id": "571bbf7b-9cce-3a2f-8699-7491a5819880",
                        "glosses": [
                            "Nom donné au filament médian de l'extrémité postérieure de l'abdomen de certains insectes (typiquement les poissons d'argent)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "612d344b-6c30-45e8-818c-a5d4505512b8",
                                "sense_id": "57a4d9a3-4dac-3ad7-99be-a8fe9d272316",
                                "text": "Les deux cerques sont fortement ciliés sur leur bord interne; le paracerque porte des cils sur deux rangées opposées."
                            },
                            {
                                "example_id": "e940eba9-b654-4d3b-be60-56b9024856d1",
                                "sense_id": "57a4d9a3-4dac-3ad7-99be-a8fe9d272316",
                                "text": "Les genitalia mâles ne présentent pas de caractère spécifique et sont assez variables d’un spécimen à l’autre. […] Les cerques et paracerques sont gris brunâtre striés de bandes claires."
                            }
                        ]
                    }
