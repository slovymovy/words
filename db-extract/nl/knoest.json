                "senses": [
                    {
                        "sense_id": "a73abb6e-a154-3e61-8bfa-ead0b167419f",
                        "entry_id": "494bf15a-6b41-3d6a-984b-76a1632d33a2",
                        "glosses": [
                            "de plaats waar een zijtak aan de boom groeide, het hout is er minder sterk en moeilijker bewerkbaar, het is dan ook een houtgebrek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e756a88-e5ae-4fb0-8be4-6af0fa792fb7",
                                "sense_id": "a73abb6e-a154-3e61-8bfa-ead0b167419f",
                                "text": "Miriam van de Lubbe heeft een knoest in een simpel tweedehands notenhouten tafeltje vervangen door een intrigerende zilvervlek. Voelt heerlijk, staat mooi."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8efc9bf-24fa-3067-b1af-3c8d24d1bf68",
                        "entry_id": "494bf15a-6b41-3d6a-984b-76a1632d33a2",
                        "glosses": [
                            "de overgang van stam naar wortel bij een boom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92c79405-00e0-4319-9a2b-d4695e1ffa32",
                                "sense_id": "c8efc9bf-24fa-3067-b1af-3c8d24d1bf68",
                                "text": "Op de terugweg rijd ik langs het nieuwe Russische buurmeisje en haar moeder. Het meisje, een jaar of zeven, en haar moeder zijn net verhuisd uit Moskou. Ze spreken nog geen woord Engels. Afgelopen weken, toen het door de Indian summer opvallend zacht weer was, zaten ze op het gras door een prentenboek te bladeren. Gisteren telden ze de ringen in de knoest van een omgezaagde eik."
                            }
                        ]
                    }
                ],
