                                "target_senses": [
                                    {
                                        "sense_id": "64a57905-57a9-3d73-8f77-61f92e386b8b",
                                        "entry_id": "9a8dd8f4-0155-312d-9a7d-e9702180e9bf",
                                        "glosses": [
                                            "Divinités persécutrices."
                                        ],
                                        "tags": [
                                            "Divinité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d51c3b62-e32a-47b2-8094-5f55036d6aeb",
                                                "sense_id": "64a57905-57a9-3d73-8f77-61f92e386b8b",
                                                "text": "Pour les Grecs, le cheval furieux est terrible à regarder et terrible à entendre, car le grincement des dents, le bruit du mors, rappellent le grondement des Érinyes […]"
                                            },
                                            {
                                                "example_id": "bba60413-c90c-4bc5-b432-32d7c70a900a",
                                                "sense_id": "64a57905-57a9-3d73-8f77-61f92e386b8b",
                                                "text": "Depuis la soumission des Érinyes dans l’Orestie d’Eschyle, la culture occidentale a été une mise en garde constamment répétée contre les dangers de la barbarie, du règne chaotique de la violence et de la vengeance."
                                            }
                                        ]
                                    }
                                ]
                            }
