{
    "word_family": [
        "huddling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0f493f0d-fbcd-3f5c-904c-8cde98cb25db",
                    "sense_definition": "To gather closely together in a group.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_crowd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cold hikers <w>huddled</w> together to share their body heat.",
                            "target_lang_translations": {
                                "cs": "Promrzlí turisté se <w>tisknuli</w> k sobě, aby sdíleli tělesné teplo.",
                                "fr": "Les randonneurs frigorifiés se sont <w>blottis</w> les uns contre les autres pour partager leur chaleur corporelle.",
                                "zh": "受冻的徒步者们<w>挤在一起</w>，互相取暖。"
                            }
                        },
                        {
                            "text": "The penguins <w>huddle</w> for warmth during the harsh winter months.",
                            "target_lang_translations": {
                                "cs": "Tučňáci se během drsných zimních měsíců <w>shlukují</w> kvůli teplu.",
                                "fr": "Les manchots se <w>blottissent</w> pour se réchauffer pendant les rudes mois d'hiver.",
                                "zh": "在严酷的冬季，企鹅们会<w>挤在一起</w>取暖。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cluster",
                        "gather"
                    ],
                    "antonyms": [
                        "disperse",
                        "scatter"
                    ],
                    "common_phrases": [
                        "huddle together"
                    ],
                    "target_lang_definitions": {
                        "cs": "Shluknout se nebo těsně se přiblížit k sobě ve skupině.",
                        "fr": "Se rassembler étroitement en groupe.",
                        "zh": "（通常为了取暖或因害怕而）紧紧挤在一起，挤作一团"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tisknout se",
                                "target_lang_sense_clarification": "vyjadřuje těsné přiblížení se k sobě"
                            },
                            {
                                "target_lang_word": "natěsnat se",
                                "target_lang_sense_clarification": "vyjadřuje shromáždění na malém prostoru"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "se blottir",
                                "target_lang_sense_clarification": "se serrer les uns contre les autres"
                            },
                            {
                                "target_lang_word": "s'amasser",
                                "target_lang_sense_clarification": "se regrouper en grand nombre"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挤在一起",
                                "target_lang_sense_clarification": "指人或动物紧挨着聚集"
                            },
                            {
                                "target_lang_word": "聚集",
                                "target_lang_sense_clarification": "紧密地聚拢"
                            },
                            {
                                "target_lang_word": "簇拥",
                                "target_lang_sense_clarification": "紧凑地聚拢在一起"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be70dfa2-42a7-316c-8380-750853562b2e",
                    "sense_definition": "To meet briefly to discuss something privately.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_meeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coaches <w>huddled</w> to decide on the final play of the game.",
                            "target_lang_translations": {
                                "cs": "Trenéři se <w>poradili</w>, aby rozhodli o poslední herní akci.",
                                "fr": "Les entraîneurs se sont <w>concertés</w> pour décider de la dernière action du match.",
                                "zh": "教练们<w>碰头</w>商量，以决定比赛的最后一攻战术。"
                            }
                        },
                        {
                            "text": "The team members <w>huddle</w> before every match to discuss their strategy.",
                            "target_lang_translations": {
                                "cs": "Členové týmu se před každým zápasem <w>shluknou k poradě</w>, aby probrali strategii.",
                                "fr": "Les membres de l'équipe se <w>réunissent</w> avant chaque match pour discuter de leur stratégie.",
                                "zh": "队员们在每场比赛前都会<w>聚在一起商量</w>策略。"
                            }
                        }
                    ],
                    "synonyms": [
                        "confer",
                        "consult"
                    ],
                    "common_phrases": [
                        "huddle up"
                    ],
                    "target_lang_definitions": {
                        "cs": "Krátce se sejít za účelem soukromé porady.",
                        "fr": "Se réunir brièvement pour discuter en privé.",
                        "zh": "（尤指私下或在比赛、会议中）聚在一起商量，碰头密谈"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "poradit se",
                                "target_lang_sense_clarification": "obecný výraz pro krátkou poradu"
                            },
                            {
                                "target_lang_word": "shluknout se k poradě",
                                "target_lang_sense_clarification": "popisuje fyzické vytvoření kruhu za účelem porady"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "se concerter",
                                "target_lang_sense_clarification": "se réunir pour prendre une décision"
                            },
                            {
                                "target_lang_word": "se réunir",
                                "target_lang_sense_clarification": "se rassembler pour une discussion rapide"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "商量",
                                "target_lang_sense_clarification": "围在一起私下讨论"
                            },
                            {
                                "target_lang_word": "碰头",
                                "target_lang_sense_clarification": "短时间聚在一起商谈"
                            },
                            {
                                "target_lang_word": "密谈",
                                "target_lang_sense_clarification": "秘密或私下商议"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5aa0a647-c382-3f2c-b10d-b9093f5c0563",
                    "sense_definition": "To curl one's body into a tight position, often for warmth or protection.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "group_posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>huddled</w> under the blanket to escape the freezing draft.",
                            "target_lang_translations": {
                                "cs": "Zalezla pod deku a <w>schoulila se</w>, aby unikla mrazivému průvanu.",
                                "fr": "Elle s'est <w>blottie</w> sous la couverture pour échapper au courant d'air glacial.",
                                "zh": "她<w>蜷缩</w>在毯子下面，躲避刺骨的穿堂风。"
                            }
                        },
                        {
                            "text": "The frightened child <w>huddled</w> in the corner of the room.",
                            "target_lang_translations": {
                                "cs": "Vyděšené dítě se <w>choulilo</w> v rohu místnosti.",
                                "fr": "L'enfant effrayé s'est <w>recroquevillé</w> dans le coin de la pièce.",
                                "zh": "受惊的孩子在房间的角落里<w>缩成一团</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crouch",
                        "nestle"
                    ],
                    "target_lang_definitions": {
                        "cs": "Schoulit se do klubíčka, často kvůli teplu nebo pocitu bezpečí.",
                        "fr": "Se replier sur soi-même, souvent pour se protéger du froid ou par peur.",
                        "zh": "（因寒冷或恐惧而）蜷缩，缩成一团"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "choulit se",
                                "target_lang_sense_clarification": "stav, kdy se někdo krčí kvůli zimě nebo strachu"
                            },
                            {
                                "target_lang_word": "schoulit se",
                                "target_lang_sense_clarification": "dokonavý tvar pro zaujetí skrčené polohy"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "se blottir",
                                "target_lang_sense_clarification": "se ramasser sur soi-même"
                            },
                            {
                                "target_lang_word": "se recroqueviller",
                                "target_lang_sense_clarification": "se replier sur soi-même par peur ou froid"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蜷缩",
                                "target_lang_sense_clarification": "身体弯曲收缩成一团"
                            },
                            {
                                "target_lang_word": "缩成一团",
                                "target_lang_sense_clarification": "因冷或怕身体收拢"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e748d209-d965-3606-bad5-05c6f16b3bde",
                    "sense_definition": "A small, close-knit group of people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_crowd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A small <w>huddle</w> of students stood by the entrance talking quietly.",
                            "target_lang_translations": {
                                "cs": "Malý <w>hlouček</w> studentů stál u vchodu a tiše si povídal.",
                                "fr": "Un petit <w>groupe</w> d'étudiants se tenait près de l'entrée en parlant doucement.",
                                "zh": "<w>一小群</w>学生站在门口低声交谈。"
                            }
                        },
                        {
                            "text": "The players formed a <w>huddle</w> to listen to the captain's instructions.",
                            "target_lang_translations": {
                                "cs": "Hráči vytvořili <w>hlouček</w>, aby si poslechli pokyny kapitána.",
                                "fr": "Les joueurs ont formé un <w>groupe</w> pour écouter les instructions du capitaine.",
                                "zh": "队员们围成<w>一圈</w>，听取队长的指示。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cluster",
                        "group"
                    ],
                    "target_lang_definitions": {
                        "cs": "Malá, úzce spjatá skupina lidí.",
                        "fr": "Un petit groupe de personnes soudées.",
                        "zh": "紧紧聚集的一小群人（或事物）"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hlouček",
                                "target_lang_sense_clarification": "malá skupinka lidí stojících blízko sebe"
                            },
                            {
                                "target_lang_word": "skupinka",
                                "target_lang_sense_clarification": "neutrální označení pro malý počet osob"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "groupe",
                                "target_lang_sense_clarification": "terme général pour un petit ensemble de personnes"
                            },
                            {
                                "target_lang_word": "petit groupe",
                                "target_lang_sense_clarification": "insiste sur la taille réduite et la proximité"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一小群",
                                "target_lang_sense_clarification": "指紧密聚在一起的少数人"
                            },
                            {
                                "target_lang_word": "一伙",
                                "target_lang_sense_clarification": "聚集在一起的一帮人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a8c8ad2-eda3-34a1-9e0f-71ff452165ff",
                    "sense_definition": "A large, messy, and disorganized crowd.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_crowd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protesters formed a chaotic <w>huddle</w> in the middle of the street.",
                            "target_lang_translations": {
                                "cs": "Protestující vytvořili uprostřed ulice chaotický <w>chumel</w>.",
                                "fr": "Les manifestants ont formé une <w>cohue</w> chaotique au milieu de la rue.",
                                "zh": "抗议者在街道中央乱哄哄地挤成<w>一团</w>。"
                            }
                        },
                        {
                            "text": "The items were left in a messy <w>huddle</w> on the floor.",
                            "target_lang_translations": {
                                "cs": "Věci zůstaly na podlaze v nepořádném <w>shluku</w>.",
                                "fr": "Les objets ont été laissés en un <w>amas</w> désordonné sur le sol.",
                                "zh": "这些物品乱七八糟地堆在地板上的<w>一处</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jumble",
                        "mass"
                    ],
                    "target_lang_definitions": {
                        "cs": "Velký, neuspořádaný a chaotický dav.",
                        "fr": "Une foule nombreuse, désordonnée et chaotique.",
                        "zh": "杂乱的一群；混乱的一堆（人或物）"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chumel",
                                "target_lang_sense_clarification": "označení pro neuspořádaný shluk lidí či věcí"
                            },
                            {
                                "target_lang_word": "shluk",
                                "target_lang_sense_clarification": "hromada nebo neuspořádané seskupení"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "cohue",
                                "target_lang_sense_clarification": "foule désordonnée et bruyante"
                            },
                            {
                                "target_lang_word": "amas",
                                "target_lang_sense_clarification": "accumulation désordonnée de personnes ou d'objets"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一团",
                                "target_lang_sense_clarification": "杂乱聚集的群体或事物"
                            },
                            {
                                "target_lang_word": "一堆",
                                "target_lang_sense_clarification": "杂乱堆放或拥挤在一起的人或物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9cbeec38-60ee-30e3-bcfb-d914f42b1ee1",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historian researched the origins of the <w>Huddle</w> family.",
                            "target_lang_translations": {
                                "cs": "Historik zkoumal původ rodiny <w>Huddleových</w>.",
                                "fr": "L'historien a fait des recherches sur les origines de la famille <w>Huddle</w>.",
                                "zh": "历史学家研究了<w>哈德尔</w>家族的起源。"
                            }
                        },
                        {
                            "text": "Mr. <w>Huddle</w> is a well-known local author.",
                            "target_lang_translations": {
                                "cs": "Pan <w>Huddle</w> je známý místní autor.",
                                "fr": "M. <w>Huddle</w> est un auteur local bien connu.",
                                "zh": "<w>哈德尔</w>先生是当地一位知名作家。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Příjmení.",
                        "fr": "Un nom de famille.",
                        "zh": "姓氏，多译作“哈德尔”"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Huddle",
                                "target_lang_sense_clarification": "příjmení (nepřekládá se)"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "Huddle",
                                "target_lang_sense_clarification": "nom de famille (ne se traduit pas)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哈德尔",
                                "target_lang_sense_clarification": "英语姓氏的音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}