                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14359aaa-31c3-402b-8980-1693ab23dab7",
                                "sense_id": "f6e88030-3fce-32bc-9879-6ccbbffdb7bf",
                                "text": "On retrique ensemble bientôt oui bien?"
                            },
                            {
                                "example_id": "b1b393d7-3433-4580-8d4f-8332cc9bba70",
                                "sense_id": "f6e88030-3fce-32bc-9879-6ccbbffdb7bf",
                                "text": "Bah j'te trique, j'te retrique, et j'te reretrique."
                            },
                            {
                                "example_id": "dbc8feab-da55-4e86-9012-036aa0a2caad",
                                "sense_id": "f6e88030-3fce-32bc-9879-6ccbbffdb7bf",
                                "text": "Non mon bébé, c'est pas du priapisme, je débande après; seulement, je suis tellement cochon, que je retrique, aussi \"sec\"."
                            }
                        ]
                    }
