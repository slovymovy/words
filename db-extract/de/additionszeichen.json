                "senses": [
                    {
                        "sense_id": "77aba4c0-7d74-3ea4-b618-899db690a179",
                        "entry_id": "baa47ff0-75df-3164-86e4-3e8d65ded01a",
                        "glosses": [
                            "Zeichen für die Addition"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb0dc617-d87f-4426-a206-a29bfd9c7c5e",
                                "sense_id": "77aba4c0-7d74-3ea4-b618-899db690a179",
                                "text": "„Mit beliebigen Gegenständen (Duplosteinen, Knöpfen, Murmeln etc.) wird eine bestimmte Anzahl als 1. Summand aufgelegt, dann folgt ein großes schwarzes Additionszeichen (+) aus Karton und der 2. Summand wird wieder mit denselben Gegenständen aufgelegt. Anschließend kommt das große ›Ist gleich‹ Zeichen (=).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
