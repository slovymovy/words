                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c90c82b8-188c-3bb1-a16c-26f860c3874c",
                                        "entry_id": "e50bd275-c337-3e96-b58f-ac8d34b1a5aa",
                                        "glosses": [
                                            "A small joined pair of drums, beaten with the hands."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7976b2a-53c6-47d3-8d13-27a99d0a67ed",
                                                "sense_id": "c90c82b8-188c-3bb1-a16c-26f860c3874c",
                                                "text": "It was voodoo, apparently, but voodoo of a more terrible sort than they had ever known; and some of their women and children had disappeared since the malevolent tom-tom had begun its incessant beating far within the black haunted woods where no dweller ventured."
                                            },
                                            {
                                                "example_id": "02310f17-e5a6-478e-826d-e6ebaf242c66",
                                                "sense_id": "c90c82b8-188c-3bb1-a16c-26f860c3874c",
                                                "text": "Many visitors to France will go back to the States after a three months' fling of night spots and sight-seeing without remarking that can-can girls and champagne play about the same part in French life today as the tom-tom and totem pole in American life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "472d787c-8724-3b2e-a034-3f328edf8822",
                                        "entry_id": "e50bd275-c337-3e96-b58f-ac8d34b1a5aa",
                                        "glosses": [
                                            "Any cylindrical drum, with no snare; part of a drum kit."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5a380bd-1413-340b-b534-e9cd5174121f",
                                        "entry_id": "e50bd275-c337-3e96-b58f-ac8d34b1a5aa",
                                        "glosses": [
                                            "Alternative form of tam-tam (“a kind of flat gong”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
