{
    "word": "countermeasure",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4c858964-2bbc-3413-a058-571e47c39310",
                "word": "countermeasure",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1307a264-fa34-47e5-9723-bd0429201af8",
                        "entry_id": "4c858964-2bbc-3413-a058-571e47c39310",
                        "tags": [
                            "plural"
                        ],
                        "form": "countermeasures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a6eff0ff-7277-39cf-a4f9-c4ea93217588",
                        "entry_id": "4c858964-2bbc-3413-a058-571e47c39310",
                        "glosses": [
                            "Any action taken to counteract or correct another."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cc7beec-01e7-449d-9886-745196505864",
                                "sense_id": "a6eff0ff-7277-39cf-a4f9-c4ea93217588",
                                "text": "We fear that this will be the beginning of a negative development of measures and countermeasures, at the end of which there will be no winner"
                            },
                            {
                                "example_id": "c4b1cba5-0075-4554-b5c2-788b9f951979",
                                "sense_id": "a6eff0ff-7277-39cf-a4f9-c4ea93217588",
                                "text": "Adopting a computerlike countermeasure for a problem enabled by computer algorithms is admittedly an unnatural practice."
                            }
                        ]
                    },
                    {
                        "sense_id": "35743b4f-8955-3866-9639-17e27cba36f3",
                        "entry_id": "4c858964-2bbc-3413-a058-571e47c39310",
                        "glosses": [
                            "Any of the devices and techniques used to impair the operational effectiveness of an enemy."
                        ],
                        "tags": [
                            "in-plural"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f8d2e47-e585-4494-8191-f89ff3d85322",
                        "source_entry_id": "4c858964-2bbc-3413-a058-571e47c39310",
                        "source_sense_description": "action",
                        "target_lang_word": "tegenmaatregel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tegenmaatregel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "175a6ac5-b1ad-3102-93d5-4e18139386ff",
                                        "entry_id": "48de00df-8899-30c0-81f3-a89c40b3c9e6",
                                        "glosses": [
                                            "een handeling die erop gericht is de effecten van een andere handeling ongedaan te maken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "603a4ddb-b564-4498-a3b7-955b12be9b52",
                                                "sense_id": "175a6ac5-b1ad-3102-93d5-4e18139386ff",
                                                "text": "Ik denk: Esthers Slothandeling was niet krachtig genoeg. Ik denk: De Blinde Kathaar heeft tegenmaatregelen genomen."
                                            },
                                            {
                                                "example_id": "7b737d64-e9dd-473e-9a81-3a23fa99de2f",
                                                "sense_id": "175a6ac5-b1ad-3102-93d5-4e18139386ff",
                                                "text": "Ook schaadt het huidige sanctieregime tegen Rusland, dat de premier niet openlijk afvalt, nog steeds delen van de Belgische economie door de tegenmaatregelen die Rusland nam. En dat terwijl het embargo Rusland nauwelijks van koers heeft doen veranderen."
                                            },
                                            {
                                                "example_id": "eb21a0a9-2e97-4bb1-ad8b-7cb776eb389b",
                                                "sense_id": "175a6ac5-b1ad-3102-93d5-4e18139386ff",
                                                "text": "Onduidelijk is nog welke sancties Europa wil loslaten op landen die niet meewerken. De Franse minister Bruno Lemaire opperde ze uit te sluiten van steun van het IMF of de Wereldbank, maar daarover bestaat nog geen overeenstemming. ,,Het is hoe dan ook belangrijk dat we tegenmaatregelen kunnen nemen”, zo meent Dombrovskis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "169b18ca-3507-44e6-a4aa-fb3b053df66a",
                        "source_entry_id": "4c858964-2bbc-3413-a058-571e47c39310",
                        "source_sense_description": "action",
                        "target_lang_word": "contre-mesure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contre-mesure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10463ec8-5f5d-3782-8fd1-b7d05b8e0b03",
                                        "entry_id": "0e523597-c0a4-30f9-a1ec-94477e1c03e9",
                                        "glosses": [
                                            "Disposition prise pour s'opposer à une action, à un effet, à un événement, ou pour les prévenir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db58aa8f-e557-47c5-8317-59b0953627d0",
                                                "sense_id": "10463ec8-5f5d-3782-8fd1-b7d05b8e0b03",
                                                "text": "Ni la milice ni la Gestapo ne sonnèrent la cloche du portail. Il est vrai que mon père, engagé tôt dans la Résistance — ce que j’ignorais alors —, avait pris d’autres contre-mesures après les grandes rafles de l’été 1942."
                                            },
                                            {
                                                "example_id": "ce1ebe17-7a87-421a-9382-202533a54027",
                                                "sense_id": "10463ec8-5f5d-3782-8fd1-b7d05b8e0b03",
                                                "text": "Plusieurs contre-mesures ont aussi été intégrées contre des failles de sécurité, notamment Retpoline de Google contre les attaques utilisant Spectre V2 (processeurs Intel)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e54966e-7056-35b6-be4d-8953d8582e40",
                                        "entry_id": "0e523597-c0a4-30f9-a1ec-94477e1c03e9",
                                        "glosses": [
                                            "Mesure préventive"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd0d99fe-6d3f-4e45-817c-ca71266323df",
                        "source_entry_id": "4c858964-2bbc-3413-a058-571e47c39310",
                        "source_sense_description": "action",
                        "target_lang_word": "Gegenmaßnahme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegenmaßnahme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d4aa28d-48f1-300c-a352-02a86be9eda6",
                                        "entry_id": "4ac25def-a252-3e42-afe6-e2a7d8f39507",
                                        "glosses": [
                                            "Maßnahme, die sich gegen etwas richtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf68cea0-73dd-480f-b206-566dbba9396c",
                                                "sense_id": "4d4aa28d-48f1-300c-a352-02a86be9eda6",
                                                "text": "Alle getroffenen Gegenmaßnahmen haben nicht ausgereicht, um das Unglück zu verhindern."
                                            },
                                            {
                                                "example_id": "1b01ab7d-c8f7-48e5-ba2b-ffe64ff720ac",
                                                "sense_id": "4d4aa28d-48f1-300c-a352-02a86be9eda6",
                                                "text": "„Und welche Strategien und Gegenmaßnahmen hält die Weltraummedizin bereit, um die Gesundheit von Raumfahrern bei Reisen zum Mars bestmöglich zu schützen?“"
                                            },
                                            {
                                                "example_id": "36eb8e50-4a9f-452c-a4be-16367d5d27ef",
                                                "sense_id": "4d4aa28d-48f1-300c-a352-02a86be9eda6",
                                                "text": "„Für die Stadtväter der betroffenen Gebiete ergab sich das Problem, Gegenmaßnahmen zu treffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
