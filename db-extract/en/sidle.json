                                    {
                                        "sense_id": "d50fbf48-1f07-3449-b1c7-72a6df2ff9a7",
                                        "entry_id": "d24879d6-38aa-3463-a7d3-c02179230203",
                                        "glosses": [
                                            "lautlos gehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f8d8582-4910-449f-be51-025e748efdfb",
                                                "sense_id": "d50fbf48-1f07-3449-b1c7-72a6df2ff9a7",
                                                "text": "Heute Nacht schlich er durch das Wohnzimmer, um sich ungestört an unserem Kühlschrank bedienen zu können."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f8b166aa-61f2-327b-a652-2664629715bc",
                                        "entry_id": "d24879d6-38aa-3463-a7d3-c02179230203",
                                        "glosses": [
                                            "nur langsam vorankommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "702ca948-28b2-4cf8-9314-d1ca38b0b2ec",
                                                "sense_id": "f8b166aa-61f2-327b-a652-2664629715bc",
                                                "text": "Der Fahrer vor uns kennt sich hier wohl nicht aus, er schleicht mit 20 km/h um jede Kurve."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
