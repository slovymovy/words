                "senses": [
                    {
                        "sense_id": "f9eae6b3-d72d-3256-aa55-d639d853d952",
                        "entry_id": "abceb92a-5d02-3a95-a992-09bd7a63a9c2",
                        "glosses": [
                            "Beschreibung oder Bezifferung (Bewertung) einer drohenden Gefahr oder eines möglichen Schadens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8466d6f4-a931-48c6-98cd-585dbef5409d",
                                "sense_id": "f9eae6b3-d72d-3256-aa55-d639d853d952",
                                "text": "„Die Risiken aus den Risikoeinheiten und/oder Risikoaggregaten sind nachfolgend die Ausgangspunkte und Bezugsgrößen der Risikobewertung und Risikohandhabung im Versicherungsunternehmen.“"
                            },
                            {
                                "example_id": "da5b8030-ca23-47e9-8374-952c9395228b",
                                "sense_id": "f9eae6b3-d72d-3256-aa55-d639d853d952",
                                "text": "Eine Risikoanalyse ist der Prozess aus den miteinander verbundenen Schritten Risikobewertung, Risikomanagement und Risikokommunikation."
                            },
                            {
                                "example_id": "ea5f5a2b-c61a-47ed-853b-30505bff65a9",
                                "sense_id": "f9eae6b3-d72d-3256-aa55-d639d853d952",
                                "text": "Das Risiko für die Bevölkerung durch das neuartige Coronavirus ist von mäßig auf hoch eingestuft worden. Diese Risikobewertung wurde im März vom Robert-Koch-Institut in Berlin abgegeben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
