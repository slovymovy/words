                        {
                            "text": "The small town of <w>Springer</w> serves as a local hub for the surrounding ranches.",
                            "target_lang_translations": {
                                "ru": "Маленький городок <w>Спрингер</w> служит местным центром для окрестных ранчо."
                            }
