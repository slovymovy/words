                "senses": [
                    {
                        "sense_id": "25fad480-3942-366f-93ba-9ffe60d14ac5",
                        "entry_id": "cdde439f-f3c2-3410-841d-cb82d0e637c6",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eae1deb9-8f9a-4165-b273-789531f04dfc",
                                "sense_id": "25fad480-3942-366f-93ba-9ffe60d14ac5",
                                "text": "Frau Finckbein ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "635657ab-5627-408f-9bac-cf93f6748a3c",
                                "sense_id": "25fad480-3942-366f-93ba-9ffe60d14ac5",
                                "text": "Herr Finckbein wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "28df37a1-869a-47ba-8062-570375d1c1b8",
                                "sense_id": "25fad480-3942-366f-93ba-9ffe60d14ac5",
                                "text": "Die Finckbeins fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "73316a66-5735-4900-b5a4-b621f16d6317",
                                "sense_id": "25fad480-3942-366f-93ba-9ffe60d14ac5",
                                "text": "Der Finckbein trägt nie die Schals, die die Finckbein ihm strickt."
                            },
                            {
                                "example_id": "74b37773-3c83-4337-b5ae-1a5c4a917bbe",
                                "sense_id": "25fad480-3942-366f-93ba-9ffe60d14ac5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Finckbein kommt, geht der Herr Finckbein.“"
                            },
                            {
                                "example_id": "e8523f69-bdfd-4ad2-a19a-0ed23b1e468f",
                                "sense_id": "25fad480-3942-366f-93ba-9ffe60d14ac5",
                                "text": "Finckbein kommt und geht."
                            },
                            {
                                "example_id": "f2307077-2605-4518-a370-66f487dca57d",
                                "sense_id": "25fad480-3942-366f-93ba-9ffe60d14ac5",
                                "text": "Finckbeins kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
