                "senses": [
                    {
                        "sense_id": "39e0bae9-d292-357b-a0ca-d075c674104b",
                        "entry_id": "eec5d953-dfd1-3b9d-b612-233059189bfd",
                        "glosses": [
                            "Qui a subi une cuisson excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b9b2422-d618-4f1c-a47b-f902b7f13980",
                                "sense_id": "39e0bae9-d292-357b-a0ca-d075c674104b",
                                "text": "Sans intérêt : buffets sans originalité, petits déjeuners de qualité quelconque, viennoiseries surcuites, jus de fruits concentrés. (critique d'hôtel)"
                            },
                            {
                                "example_id": "5939f7c0-c918-4baa-9634-05201d409678",
                                "sense_id": "39e0bae9-d292-357b-a0ca-d075c674104b",
                                "text": "Evitez les plats en sauce, les viandes surcuites, les graisses. Le régime méditerranéen n'est pas qu'un régime de vacances. Il faut l'appliquer toute l'année."
                            }
                        ]
                    }
                ],
