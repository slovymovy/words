                "senses": [
                    {
                        "sense_id": "b9dda480-403f-3a88-9c00-6c04ed0e1ec1",
                        "entry_id": "26fc0daa-5cd4-3072-bc4e-2fbb5c862b10",
                        "glosses": [
                            "Person, die von einer Schule abgeht, weil die Schulzeit vorüber ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa53bf63-a272-48a4-97d0-e33c426a3646",
                                "sense_id": "b9dda480-403f-3a88-9c00-6c04ed0e1ec1",
                                "text": "„Der Handwerksberuf ist heute in einigen Sparten attraktiver als vermutlich von vielen Schulabgängern gedacht.“"
                            },
                            {
                                "example_id": "f69420a1-a2d1-4678-abbd-1113d63ea60c",
                                "sense_id": "b9dda480-403f-3a88-9c00-6c04ed0e1ec1",
                                "text": "„Die Professorin an der Wirtschaftsuniversität spricht in dem Zusammenhang nicht von Schulabbrechern, sondern lieber von Schulabgängern, die über keinen Abschluss einer Lehre, einer berufsbildenden mittleren Schule oder höheren Schule (Sekundarstufe 2) verfügen.“"
                            },
                            {
                                "example_id": "ef0592cf-6136-4406-8be0-5711d0fa1525",
                                "sense_id": "b9dda480-403f-3a88-9c00-6c04ed0e1ec1",
                                "text": "„83 Prozent der Schüler waren damals nichtdeutscher Herkunft, und keiner der Schulabgänger aus dem Vorjahr hatte einen Ausbildungsplatz erhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
