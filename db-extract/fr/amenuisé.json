                ],
                "senses": [
                    {
                        "sense_id": "96bd6efc-57a0-366e-a58f-f8085db827f0",
                        "entry_id": "447e7a4b-124f-3194-aa6d-96e6c8c99e26",
                        "glosses": [
                            "Diminué, écourté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca00619f-9170-4597-9d32-4128e57b733f",
                                "sense_id": "96bd6efc-57a0-366e-a58f-f8085db827f0",
                                "text": "Son col amenuisé, flexible comme celui d’un cygne, s’unissait, par une ligne virginale, à des épaules encore un peu maigres et à une poitrine juvénile d’une blancheur neigeuse, que ne soulevaient pas les battements du cœur."
                            },
                            {
                                "example_id": "e506285b-5a15-40e5-981c-85b2a162cde9",
                                "sense_id": "96bd6efc-57a0-366e-a58f-f8085db827f0",
                                "text": "Aussi loin que je remonte dans ma mémoire, il n’y avait eu que de faux étés, amenuisés par de contraintes, vacances famiiales d’autrefois, voyages plus ou moins organisés ensuite."
                            },
                            {
                                "example_id": "b6efa4e7-f77b-4d0c-8c7c-824731e0b95c",
                                "sense_id": "96bd6efc-57a0-366e-a58f-f8085db827f0",
                                "text": "Elle parlait d'une voix amenuisée qui me torturait et ne se plaignait presque pas."
                            }
                        ]
                    }
                ],
