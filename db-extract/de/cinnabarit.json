                "senses": [
                    {
                        "sense_id": "bf41eef0-2bde-3f28-8069-a3c95e13b0c9",
                        "entry_id": "2c485b5a-7260-3bb9-81ea-7439dae8ba05",
                        "glosses": [
                            "häufig vorkommendes Mineral, eine chemische Verbindung aus Quecksilber und Schwefel"
                        ],
                        "tags": [
                            "Mineralogie"
                        ],
                        "examples": [
                            {
                                "example_id": "cc80bd27-57f5-4ad8-bd0b-2c392ac991be",
                                "sense_id": "bf41eef0-2bde-3f28-8069-a3c95e13b0c9",
                                "text": "Sehr detailliert war auch die Beschreibung der Farbe von Zinnober bei Ludwig August Emmerling (1765 bis 1842; Mineraloge), der Cinnabarit der Farbe nach in \"dunkelrother, hochrother und gemeinen Zinnober\" unterschied."
                            },
                            {
                                "example_id": "d46e4c46-4bf9-4db5-88d2-6705bd27a80e",
                                "sense_id": "bf41eef0-2bde-3f28-8069-a3c95e13b0c9",
                                "text": "Die Strichfarbe von Cinnabarit ist dunkelrot."
                            },
                            {
                                "example_id": "a53d5a4c-f407-4d17-ae36-6a7200bac828",
                                "sense_id": "bf41eef0-2bde-3f28-8069-a3c95e13b0c9",
                                "text": "Cinnabarit wird seit der Zeit des römischen Reiches in Spanien abgebaut."
                            },
                            {
                                "example_id": "a1a914fc-e1fa-4269-ae48-422e34f13b6b",
                                "sense_id": "bf41eef0-2bde-3f28-8069-a3c95e13b0c9",
                                "text": "Cinnabarit enthält 86% Quecksilber. Es ist das wichtigste Mineral für dessen Gewinnung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
