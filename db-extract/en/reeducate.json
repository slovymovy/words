                    {
                        "translation_id": "dcde6039-f253-4741-bb07-c72dc48a4296",
                        "source_entry_id": "104f3804-f317-3c05-b249-65e9bf97fc2e",
                        "source_sense_description": "Translations",
                        "target_lang_word": "rééduquer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rééduquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "949c46b8-1fce-3b12-95f9-d4bc549b9bce",
                                        "entry_id": "1bf91ac8-8b95-37d2-adf6-ef401a12610d",
                                        "glosses": [
                                            "Procéder à une rééducation après un accident ayant provoqué un handicap physique, mental ou psychique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f04c3e76-14e5-3b18-83b9-0503ccc813da",
                                        "entry_id": "1bf91ac8-8b95-37d2-adf6-ef401a12610d",
                                        "glosses": [
                                            "Dispenser une nouvelle éducation à une personne ou à quelque chose dans le but de rectifier une mauvaise orientation et d’en supprimer les causes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "758f017e-d085-4476-938d-d9665e18b826",
                                                "sense_id": "f04c3e76-14e5-3b18-83b9-0503ccc813da",
                                                "text": "Jamais un pays développé ne s’était encore fixé pour mission de « rééduquer » un autre pays avancé."
                                            },
                                            {
                                                "example_id": "1351d1d5-c3bf-4c98-a2b2-769eb7c57022",
                                                "sense_id": "f04c3e76-14e5-3b18-83b9-0503ccc813da",
                                                "text": "Ces formations font la fortune d’idéologues qui prétendent nous rééduquer en nous dévoilant la nature profondément raciste et colonialiste de nos sociétés. Car ce racket de la culpabilisation est payant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b804ad1e-65a1-304f-887b-f064fd434544",
                                        "entry_id": "1bf91ac8-8b95-37d2-adf6-ef401a12610d",
                                        "glosses": [
                                            "Endoctriner sous la contrainte, user de propagandes, de pressions psychologiques, de chantages et parfois même de tortures à l’encontre des personnes n’entrant pas dans les lignes politiques souhaitées ou jugées déviantes et que l’on souhaite recadrer, réintégrer de gré ou de force."
                                        ],
                                        "tags": [
                                            "euphemism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87932b56-0d04-42c8-b967-85fb1627e2dc",
                                                "sense_id": "b804ad1e-65a1-304f-887b-f064fd434544",
                                                "text": "Le prisonnier bien rééduqué obéit, tandis que le malade fait demi-tour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4bbe595-1763-4b7a-b1b1-899d08517670",
                        "source_entry_id": "104f3804-f317-3c05-b249-65e9bf97fc2e",
