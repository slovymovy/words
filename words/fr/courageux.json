    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "76667b4e-3d82-3a32-a422-fb2be669e5a5",
                    "sense_definition": "Qui fait preuve de bravoure ou de force morale face au danger, à la souffrance ou à l'adversité.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bravoure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce pompier <w>courageux</w> est entré sans hésiter dans le bâtiment en flammes pour sauver un enfant."
                        },
                        {
                            "text": "Elle s'est montrée très <w>courageuse</w> tout au long de sa maladie et a toujours gardé l'espoir."
                        }
                    ],
                    "synonyms": [
                        "brave",
                        "hardi",
                        "vaillant",
                        "valeureux"
                    ],
                    "antonyms": [
                        "couard",
                        "craintif",
                        "froussard",
                        "lâche",
                        "peureux",
                        "poltron"
                    ],
                    "common_phrases": [
                        "homme courageux"
                    ]
                },
                {
                    "sense_id": "a3d46379-279b-3275-91dc-2b550700d27f",
                    "sense_definition": "Qui manifeste du courage ou demande de la fermeté morale, en parlant d'un acte ou d'une décision.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bravoure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avouer son erreur devant toute l'équipe a été un acte <w>courageux</w> de sa part."
                        },
                        {
                            "text": "Le maire a pris une décision <w>courageuse</w> malgré les nombreuses critiques des habitants."
                        }
                    ],
                    "synonyms": [
                        "brave",
                        "hardi"
                    ],
                    "antonyms": [
                        "lâche",
                        "timoré"
                    ],
                    "common_phrases": [
                        "acte courageux",
                        "décision courageuse"
                    ]
                },
                {
                    "sense_id": "364c5fdc-a889-31cb-80bc-45c6af1ff4fe",
                    "sense_definition": "Qui fait preuve d'énergie, d'ardeur et de volonté face à une tâche ou au travail.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "travail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon voisin est un artisan <w>courageux</w> qui commence sa journée très tôt chaque matin."
                        },
                        {
                            "text": "Après cette longue journée de marche, personne n'est assez <w>courageux</w> pour préparer le dîner."
                        }
                    ],
                    "synonyms": [
                        "vaillant"
                    ],
                    "antonyms": [
                        "cagnard",
                        "douillet"
                    ],
                    "common_phrases": [
                        "travailleur courageux"
                    ]
                }
            ]
        }
    ]
}