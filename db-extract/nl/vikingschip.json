                        "sense_id": "b715f3a1-e48a-3804-90ee-7187556cf2ec",
                        "entry_id": "3fd25b71-ecfa-365e-994e-1fac97e58788",
                        "glosses": [
                            "zeewaardig vaartuig met weinig diepgang, geschikt voor roeien en zeilen, zoals de Noormannen gebruikten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f79ccd6-33cc-4575-914b-6b0138fa0a7e",
                                "sense_id": "b715f3a1-e48a-3804-90ee-7187556cf2ec",
                                "text": "Van der Tuuk gaat ook diep in op de beroemde Vikingschepen, waarvan er twee types zijn. De ene is het drakenschip: geroeide ranke ‘langschepen’, geschikt voor oorlog maar ongeschikt voor hoge zee. De andere is de ‘knarr’: een zwaar en hoog vrachtschip waarmee vooral gezeild werd."
                            },
                            {
                                "example_id": "a76f22bd-627e-43dd-84b8-3e8c22dbe10c",
                                "sense_id": "b715f3a1-e48a-3804-90ee-7187556cf2ec",
                                "text": "We gaan duizend jaar terug in de tijd en maken, met Rode Orm, een wervelende tocht per Vikingschip tot diep in de Middellandse Zee."
                            }
                        ]
                    }
