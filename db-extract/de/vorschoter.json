                "senses": [
                    {
                        "sense_id": "8f34a41f-707e-3417-9715-805a228aca8e",
                        "entry_id": "84622917-3c6e-3586-8728-63d16cf821f8",
                        "glosses": [
                            "Person, die auf einem Segelboot, meist einer Jolle oder einem kleinen Kielboot, die Vorsegel, beispielsweise die Fock, Genua, den Spinnaker, Gennaker, bedient und darüber hinaus für den Gewichtstrimm des Bootes sorgt"
                        ],
                        "tags": [
                            "Seglersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "c1e9625a-a53b-44d8-9a2a-2a9bc0f4e8c0",
                                "sense_id": "8f34a41f-707e-3417-9715-805a228aca8e",
                                "text": "„Der Vorschoter hat die Aufgaben, das Boot durch Gewichtstrimm und unter Einsatz des Trapezes aufrecht zu halten und auf Am-Wind-Kursen die Fock zu bedienen. Auf Raumkursen baumt er den Spinnakerbaum aus und bedient ihn.“"
                            },
                            {
                                "example_id": "0e34c5ff-aaee-4e22-9953-cbfa42842610",
                                "sense_id": "8f34a41f-707e-3417-9715-805a228aca8e",
                                "text": "[49er:] „Vorschoter und Steuermann stehen auf den breiten Wings im Trapez und halten mit ihrem Körpergewicht das Boot aufrecht.“"
                            },
                            {
                                "example_id": "0b6157da-4ed0-4b57-a541-dafdd240b1ed",
                                "sense_id": "8f34a41f-707e-3417-9715-805a228aca8e",
                                "text": "[Wende:] „Beim Kommando [»Klar zum Wenden«] bereitet sich der Vorschoter auf die bevorstehende Wende vor, indem er die Fockschot aus der Klemme löst, beziehungsweise von der Winsch nimmt. Ist er damit fertig, antwortet er: »Ist klar.«“"
                            },
                            {
                                "example_id": "b87201ea-2539-4168-8fd7-b2b4d74c241a",
                                "sense_id": "8f34a41f-707e-3417-9715-805a228aca8e",
                                "text": "[Wende:] „Gerade der Vorschoter kann in dieser kurzen schwer zu kontrollierenden Phase mit einer Hand am Trapezharken und Dichtnehmen der Fock Stabilität ins Boot bringen.“"
                            },
                            {
                                "example_id": "c58e9b24-f606-4513-a921-dcf49b935a8c",
                                "sense_id": "8f34a41f-707e-3417-9715-805a228aca8e",
                                "text": "[28. Juli 1978:] „Der österreichische Segler Hubert Raudaschl wird mit seinem Vorschoter Karl Ferste vor Medemblink (Niederlande) Europameister in der Starboot-Klasse.“"
                            },
                            {
                                "example_id": "aac9e0c9-730f-4004-a8a1-71ec9a87493b",
                                "sense_id": "8f34a41f-707e-3417-9715-805a228aca8e",
                                "text": "„Mit seinem Vorschoter Oliver Szymanski (JSC) fuhr Ferdi Gerz vom SV Wörthsee einen Start-Ziel-Sieg ein […].“"
                            },
                            {
                                "example_id": "af4b265b-9b06-4760-91ab-e240de93a4eb",
                                "sense_id": "8f34a41f-707e-3417-9715-805a228aca8e",
                                "text": "[Olympia 2016 vor Rio de Janeiro:] „Das anspruchsvolle Revier, in dem er vor zwei Wochen Dritter bei der olympischen Generalprobe wurde, liegt ihm und seinem Vorschoter Thomas Plößel.“"
                            },
                            {
                                "example_id": "4cc1d7a4-b985-4709-b08a-88ef558642d1",
                                "sense_id": "8f34a41f-707e-3417-9715-805a228aca8e",
                                "text": "„»Markus Koy ist ohne Frage einer der besten Starboot-Vorschoter der Welt«, sagt Robert Stanjek.“"
                            },
                            {
                                "example_id": "3d90ed4c-ef02-4272-8910-302bdf473ae4",
                                "sense_id": "8f34a41f-707e-3417-9715-805a228aca8e",
                                "text": "„Nach dem insgesamt erfolgreichen Tag mit den Rängen 8, 11, 1 und 9 sagte Buhl: »Schlüssel zur guten Leistung ist unser Gesamtpaket: ein gutes Boot, ein guter Mast und ein guter Vorschoter.«“"
                            },
                            {
                                "example_id": "2ee987ae-a937-40f0-a887-8aa920103434",
                                "sense_id": "8f34a41f-707e-3417-9715-805a228aca8e",
                                "text": "„Er brauchte eine Mannschaft, mindestens einen Vorschoter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6616098a-388f-430e-847e-1a19f3867d62",
                        "source_entry_id": "84622917-3c6e-3586-8728-63d16cf821f8",
                        "source_sense_id": "8f34a41f-707e-3417-9715-805a228aca8e",
                        "source_sense_description": "Person, die auf einem Segelboot die Vorsegel bedient",
                        "target_lang_word": "crew",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81969c8d-eb38-35f3-b50f-aaef6eb68745",
                                        "entry_id": "7373b25c-902e-370f-9e5d-5dd231039a44",
                                        "glosses": [
                                            "A group of people together",
                                            "Any company of people; an assemblage; a throng."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b436d4a7-71d7-46b6-b6fd-46ad2c03ed5c",
                                                "sense_id": "81969c8d-eb38-35f3-b50f-aaef6eb68745",
                                                "text": "There a noble crew / Of Lordes and Ladies stood on every side."
                                            },
                                            {
                                                "example_id": "c58ce6b1-f158-4973-9eda-c055b58b6347",
                                                "sense_id": "81969c8d-eb38-35f3-b50f-aaef6eb68745",
                                                "text": "Faithful to whom? to thy rebellious crew?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b4112c3-0199-3007-9c3a-17d5402e4536",
                                        "entry_id": "7373b25c-902e-370f-9e5d-5dd231039a44",
                                        "glosses": [
                                            "A group of people together",
                                            "A group of people (often staff) manning and operating a large facility or piece of equipment such as a factory, ship, boat, airplane, or spacecraft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a7e5a85-76d9-4be9-bddb-80cefab8d814",
                                                "sense_id": "5b4112c3-0199-3007-9c3a-17d5402e4536",
                                                "text": "If you need help, please contact a member of the crew."
                                            },
                                            {
                                                "example_id": "56ecf4f9-52f6-48c5-8e45-bf0d8a0dee7b",
                                                "sense_id": "5b4112c3-0199-3007-9c3a-17d5402e4536",
                                                "text": "He saw now clearly that the sole crew of the vessel was these two dead men, and though he could not see their faces, he saw by their outstretched hands, which were all of ragged flesh, that they had been subjected to some strange exceptional process of decay."
                                            },
                                            {
                                                "example_id": "e0403ad3-9e58-4497-8334-38d43c9db4d4",
                                                "sense_id": "5b4112c3-0199-3007-9c3a-17d5402e4536",
                                                "text": "There's a change of driver halfway at Crianlarich. Glasgow crews bring the 35-year-old Class 156 north, then wait to take over the next train back south. Crews from Mallaig, Oban and Fort William take their trains from the coast to Crianlarich and swap over. There's a tiny rest room on the platform, with a microwave and a sink, while they wait. Some drivers are signed all the way to the city. Most are not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "367af9c2-a6de-3ace-8c8e-54d2f6a91828",
                                        "entry_id": "7373b25c-902e-370f-9e5d-5dd231039a44",
                                        "glosses": [
                                            "A group of people together",
                                            "A group of people working together on a task."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa915c04-01c0-4e84-8a51-2d83b56e0244",
                                                "sense_id": "367af9c2-a6de-3ace-8c8e-54d2f6a91828",
                                                "text": "The crews competed to cut the most timber."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be27a19f-4081-39b2-827e-d0e62cfbcf78",
                                        "entry_id": "7373b25c-902e-370f-9e5d-5dd231039a44",
                                        "glosses": [
                                            "A group of people together",
                                            "The group of workers on a dramatic production who are not part of the cast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35b35ac9-8ded-4982-8ccf-7f4731759e38",
                                                "sense_id": "be27a19f-4081-39b2-827e-d0e62cfbcf78",
                                                "text": "There are a lot of carpenters in the crew!"
                                            },
                                            {
                                                "example_id": "83ca7872-2d44-48b7-935d-e1852dd3098b",
                                                "sense_id": "be27a19f-4081-39b2-827e-d0e62cfbcf78",
                                                "text": "The crews for different movies would all come down to the bar at night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7b86e77-ec23-3be9-b696-0252a6d3166b",
                                        "entry_id": "7373b25c-902e-370f-9e5d-5dd231039a44",
                                        "glosses": [
                                            "A group of people together",
                                            "A close group of friends."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce336b49-1a19-4c29-a318-d68058ec9a53",
                                                "sense_id": "a7b86e77-ec23-3be9-b696-0252a6d3166b",
                                                "text": "I’d look out for that whole crew down at Jack’s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a3347ad-b0a9-339f-9b73-2b2eb831a3e6",
                                        "entry_id": "7373b25c-902e-370f-9e5d-5dd231039a44",
                                        "glosses": [
                                            "A group of people together",
                                            "A set of individuals lumped together by the speaker."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7a99be5-cc24-46c3-84a0-f186445bb29f",
                                                "sense_id": "4a3347ad-b0a9-339f-9b73-2b2eb831a3e6",
                                                "text": "1861 William Weston Patton, (version of) John Brown's Body\nHe captured Harper’s Ferry, with his nineteen men so few,\nAnd frightened \"Old Virginny\" till she trembled thru and thru;\nThey hung him for a traitor, they themselves the traitor crew,\nBut his soul is marching on."
                                            },
                                            {
                                                "example_id": "0aea46df-3a49-4850-b94f-2e14148bee78",
                                                "sense_id": "4a3347ad-b0a9-339f-9b73-2b2eb831a3e6",
                                                "text": "Malignant principles bear fruit in kind and the Revolution did no more than practice what men had been taught by the abandoned crew of philosophers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2de0d58-24f8-3910-ade1-f49f35572f41",
                                        "entry_id": "7373b25c-902e-370f-9e5d-5dd231039a44",
                                        "glosses": [
                                            "A group of people together",
                                            "A group of Rovers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eeee4313-e745-3732-bc43-7a98492f243f",
                                        "entry_id": "7373b25c-902e-370f-9e5d-5dd231039a44",
                                        "glosses": [
                                            "A group of people together",
                                            "A hip-hop or b-boying group."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f594b1f1-330a-41d0-ba99-3964f11320e3",
                                                "sense_id": "eeee4313-e745-3732-bc43-7a98492f243f",
                                                "text": "And Jay cuts the records every day of the week / And we are the crew that can never be meek"
                                            },
                                            {
                                                "example_id": "97112c8c-7d11-4160-968c-731a07a4d4de",
                                                "sense_id": "eeee4313-e745-3732-bc43-7a98492f243f",
                                                "text": "The most popular and critically acclaimed rap and deejay “crews”—Run-D.M.C., Whodini, L.L. Cool J, the Beastie Boys, the Fat Boys, Public Enemy, Full Force, Salt & Pepa, Afrika Bambaataa, Kurtis Blow, Mantronix, U.T.F.O., et al.—were spawned on that city's streets."
                                            },
                                            {
                                                "example_id": "157c4a52-5832-4301-80b0-9caac8ef5090",
                                                "sense_id": "eeee4313-e745-3732-bc43-7a98492f243f",
                                                "text": "We decided we needed another rapper in the crew and spent months looking."
                                            },
                                            {
                                                "example_id": "ce96fa52-1212-4b5a-b02a-85dea10d969f",
                                                "sense_id": "eeee4313-e745-3732-bc43-7a98492f243f",
                                                "text": "In b-boying culture, a group of b-boys or b-girls who dance and battle together are referred to as a crew."
                                            },
                                            {
                                                "example_id": "9057d365-7e60-46a3-b1df-e473cc02c11f",
                                                "sense_id": "eeee4313-e745-3732-bc43-7a98492f243f",
                                                "text": "[…] mutating into all-star line-ups of emcees spitting hot bars over familiar beats, then to a single crew spitting bars over familiar beats, then eventually to a single crew (or artist) spitting bars over unfamiliar beats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7137ab8d-b070-3512-8d78-34b5fa396acd",
                                        "entry_id": "7373b25c-902e-370f-9e5d-5dd231039a44",
                                        "glosses": [
                                            "A group of people together",
                                            "A rowing team manning a single shell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2db40c26-0c41-49cb-8325-acb2fba14891",
                                                "sense_id": "7137ab8d-b070-3512-8d78-34b5fa396acd",
                                                "text": "If a crew feather much under water, it is a good plan to seat them in a row on a bench, and give each man a stick to handle as an oar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a50c7bf0-77ea-3e3d-8d01-ec89669dd3d0",
                                        "entry_id": "7373b25c-902e-370f-9e5d-5dd231039a44",
                                        "glosses": [
                                            "A person in a crew",
                                            "A member of the crew of a vessel or plant."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cc0a76e-5a42-45bf-962c-8528c24f7a13",
                                                "sense_id": "a50c7bf0-77ea-3e3d-8d01-ec89669dd3d0",
                                                "text": "One crew died in the accident."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eefa4e57-217c-3871-832a-5cfb3714b3c3",
                                        "entry_id": "7373b25c-902e-370f-9e5d-5dd231039a44",
                                        "glosses": [
                                            "A person in a crew",
                                            "A worker on a dramatic production who is not part of the cast."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f015581e-5921-4dd6-8d10-43511ad6c400",
                                                "sense_id": "eefa4e57-217c-3871-832a-5cfb3714b3c3",
                                                "text": "There were three actors and six crew on the set."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f543b43-1de2-3ef4-a156-1372b7311cb5",
                                        "entry_id": "7373b25c-902e-370f-9e5d-5dd231039a44",
                                        "glosses": [
                                            "A person in a crew",
                                            "A member of a ship's company who is not an officer."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9478a23e-8a24-4b5b-8db6-1f7d441f8f1e",
                                                "sense_id": "5f543b43-1de2-3ef4-a156-1372b7311cb5",
                                                "text": "The officers and crew assembled on the deck."
                                            },
                                            {
                                                "example_id": "e946157e-9b31-479a-8af2-01f00390cb48",
                                                "sense_id": "5f543b43-1de2-3ef4-a156-1372b7311cb5",
                                                "text": "There are quarters for three officers and five crew."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8de840bc-9b7c-3485-ac56-bf7a4578c0ad",
                                        "entry_id": "7373b25c-902e-370f-9e5d-5dd231039a44",
                                        "glosses": [
                                            "The sport of competitive rowing."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe41f6bf-b980-4199-ac16-79beee8db447",
                                                "sense_id": "8de840bc-9b7c-3485-ac56-bf7a4578c0ad",
                                                "text": "The University of Virginia belongs to the Atlantic Coast Conference and competes interscholastically in basketball, baseball, crew, cross country, fencing, football, golf, indoor track, lacrosse, polo, soccer, swimming, tennis, track, and wrestling."
                                            },
                                            {
                                                "example_id": "cd1d54b6-49b8-49ab-8941-5728ea1f7463",
                                                "sense_id": "8de840bc-9b7c-3485-ac56-bf7a4578c0ad",
                                                "text": "Two Andover classmates, Al Wilson and Al Lindley, both went out for crew in our freshman year at Yale."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dd52814-67c6-3c00-8948-68e0e6ef59f3",
                                        "entry_id": "ac48f999-bf10-381a-aa96-1139f9828f17",
                                        "glosses": [
                                            "To be a member of a vessel's crew"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd9a5994-8897-431a-9a05-db22649f7db8",
                                                "sense_id": "3dd52814-67c6-3c00-8948-68e0e6ef59f3",
                                                "text": "We crewed together on a fishing boat last year."
                                            },
                                            {
                                                "example_id": "4a275d74-c062-457d-84e4-da66c6fc0859",
                                                "sense_id": "3dd52814-67c6-3c00-8948-68e0e6ef59f3",
                                                "text": "The ship was crewed by fifty sailors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1add581-abd9-39e6-acd5-62299c9c10c9",
                                        "entry_id": "ac48f999-bf10-381a-aa96-1139f9828f17",
                                        "glosses": [
                                            "To be a member of a work or production crew"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b258ac6-783d-4766-8d7d-e13ebf98eb40",
                                                "sense_id": "c1add581-abd9-39e6-acd5-62299c9c10c9",
                                                "text": "The film was crewed and directed by students."
                                            }
                                        ]
                                    },
                                    {
