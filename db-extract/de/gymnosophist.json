                "translations": [
                    {
                        "translation_id": "033c3a96-9e5c-4a68-92b5-fd073cee05d2",
                        "source_entry_id": "ecc359d9-6396-3d76-ae5f-b928045e70a4",
                        "source_sense_id": "077efcb2-2a7a-35e0-a714-d3300038a995",
                        "source_sense_description": "Bezeichnung, welche der antike Grieche für einen indischen Weisen benutzte",
                        "target_lang_word": "gymnosophist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gymnosophist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5067c787-794e-3688-8375-fae237b2ea47",
                                        "entry_id": "e6597afd-e136-3c27-a737-930cf8960456",
                                        "glosses": [
                                            "One of a school of ancient Indian ascetic philosophers, reported in antiquity, who wore little clothing; a mystic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a72be9be-3ceb-4ca9-9126-f4066838bb35",
                                                "sense_id": "5067c787-794e-3688-8375-fae237b2ea47",
                                                "text": "As that gymnosophist in Plutarch made answer to Alexander (demanding which spake best), Every one of his fellows did speak better than the other: so may I say of these causes […]."
                                            },
                                            {
                                                "example_id": "ce3cfccc-6b1a-4da5-b0a2-d9075680e4df",
                                                "sense_id": "5067c787-794e-3688-8375-fae237b2ea47",
                                                "text": "I was speaking today with an unclothed Hindu religious, a parama-hamsa, on the steps of a Portuguese church, a true gymnosophist."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f78ccde3-b6a8-4cce-946c-aa9b75e4c6c5",
                        "source_entry_id": "ecc359d9-6396-3d76-ae5f-b928045e70a4",
                        "source_sense_id": "077efcb2-2a7a-35e0-a714-d3300038a995",
                        "source_sense_description": "Bezeichnung, welche der antike Grieche für einen indischen Weisen benutzte",
                        "target_lang_word": "gymnosophiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gymnosophiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44da1313-3dfd-3507-af4a-77197d51143a",
                                        "entry_id": "887942fc-6bcd-300e-af66-e234ff36c1ae",
                                        "glosses": [
                                            "Philosophe de religions de l’Inde (notamment dans le jaïnisme et l’hindouisme) dont les membres allaient nus et s’adonnaient à la contemplation et à la méditation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3d8daf7-fc70-4332-97e7-9f30b8d6f5b0",
                                                "sense_id": "44da1313-3dfd-3507-af4a-77197d51143a",
                                                "text": "Ce gai gymnosophiste n’était qu’un malfaiteur, et de la plus sinistre espèce."
                                            },
                                            {
                                                "example_id": "82a8566b-fcb0-49ba-91eb-8986c96d775f",
                                                "sense_id": "44da1313-3dfd-3507-af4a-77197d51143a",
                                                "text": "Ce gymnosophiste devenu chef de la caste, dix ans après, reconnaîtra dans la vierge promise aux dieux nationaux, l’enfant qu’il a sauvée."
                                            },
                                            {
                                                "example_id": "45f52728-e629-4cb1-89ed-7f966115a64a",
                                                "sense_id": "44da1313-3dfd-3507-af4a-77197d51143a",
                                                "text": "Il lut dix heures à la hauteur du soleil et demeura silencieux et accablé, assis en tailleur sur la glace, plus immobile que le gymnosophiste du Gange."
                                            },
                                            {
                                                "example_id": "b74a328a-1e3e-4fb2-9328-3e8ae9387454",
                                                "sense_id": "44da1313-3dfd-3507-af4a-77197d51143a",
                                                "text": "La secte des gymnosophistes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
