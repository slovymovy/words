                ],
                "senses": [
                    {
                        "sense_id": "26272773-2722-3b58-9f05-90553b1bdc9e",
                        "entry_id": "83a05530-7502-332a-b6f9-2be56c680573",
                        "glosses": [
                            "Faire de la propagande."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e37c40b-9d1a-473c-9229-912752fcfdea",
                                "sense_id": "26272773-2722-3b58-9f05-90553b1bdc9e",
                                "text": "On devrait envoyer ce Blue-Boy de Glainsborough et la Nelly O’Brien de la galerie de lord Hertford propagander par le monde en faveur de l’école anglaise."
                            },
                            {
                                "example_id": "2d36dc9e-5420-483f-a0fc-9d913a0e491c",
                                "sense_id": "26272773-2722-3b58-9f05-90553b1bdc9e",
                                "text": "Les nouveaux immigrants, déjà sollicités et propagandés par les filiales des partis politiques à l’étranger, seront pris en charge par tout un réseau d’institutions appartenant aux partis politiques."
                            },
                            {
                                "example_id": "24e462d0-b8e2-4189-98d5-682c99e15128",
                                "sense_id": "26272773-2722-3b58-9f05-90553b1bdc9e",
                                "text": "Derrière la petite moustache, la netteté ordinaire, le sérieux hésitant du maintien, il y avait donc un stratège qui aimait combattre. Par la suite il [Robbe-Grillet] avait tant propagandé pour lui-même et pour les autres, les « nouveaux romanciers » enrôlés sous sa bannière sans qu’on leur ait demandé leur avis, qu’on l’appellerait le « Pape du Nouveau Roman »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "131d87c0-1df5-4bb7-a5bb-593bd65856e7",
                        "source_entry_id": "83a05530-7502-332a-b6f9-2be56c680573",
                        "source_sense_id": "26272773-2722-3b58-9f05-90553b1bdc9e",
                        "target_lang_word": "propaganda",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "propaganda",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0933bf54-58ae-3b69-93a6-9c9c6acd816e",
                                        "entry_id": "d84aeaab-2f1a-3d97-94e2-ed2559188a67",
                                        "glosses": [
                                            "Agitation, publicity, public communication aimed at influencing an audience and furthering an agenda."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be9ef222-96e8-45b8-be73-7f6ca2aa3ff2",
                                                "sense_id": "0933bf54-58ae-3b69-93a6-9c9c6acd816e",
                                                "text": "Despite being biased and often untrue, propaganda material can be useful in OSINT analysis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "398412b6-7efc-3fcb-ad48-264c9903b507",
                                        "entry_id": "d84aeaab-2f1a-3d97-94e2-ed2559188a67",
                                        "glosses": [
                                            "Agitation, publicity, public communication aimed at influencing an audience and furthering an agenda.",
                                            "The propagation of the faith by the Catholic Church by means of missionary work etc."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f3a0858b-215f-3ef3-bed3-1bc34b6f0ab9",
                                        "entry_id": "d84aeaab-2f1a-3d97-94e2-ed2559188a67",
                                        "glosses": [
                                            "Such communication specifically when it is biased, misleading, and/or provoking mainly emotional responses."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7af90a27-64f7-480b-bafe-9939b9a0319b",
                                                "sense_id": "f3a0858b-215f-3ef3-bed3-1bc34b6f0ab9",
                                                "text": "They established a government propaganda commission, called the Creel Commission, which succeeded, within six months, in turning a pacifist population into a hysterical, war-mongering population which wanted to destroy everything German, tear the Germans limb from limb, go to war and save the world."
                                            },
                                            {
                                                "example_id": "dcd81668-5dc7-4d43-8374-c05805fa0309",
                                                "sense_id": "f3a0858b-215f-3ef3-bed3-1bc34b6f0ab9",
                                                "text": "In this metropolis that had a prewar population of almost a million, but where the city center now feels like an Orwellian ghost town of propaganda posters and armed patrols, perhaps no one feels more alone than those who still harbor pro-Ukrainian sentiments."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee2e8f46-f2c2-4ebf-94b3-dab3c356d7a5",
                        "source_entry_id": "83a05530-7502-332a-b6f9-2be56c680573",
                        "source_sense_id": "26272773-2722-3b58-9f05-90553b1bdc9e",
                        "target_lang_word": "пропагандировать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пропагандировать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1088255a-094a-3b11-a982-005844d98cfe",
                                        "entry_id": "36d9c3d8-d871-311a-8cce-01e41dd8c295",
                                        "glosses": [
                                            "распространять какую либо идею или учение, заниматься пропагандой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b31073f0-0b2a-4bac-b247-84a019c282d5",
                                                "sense_id": "1088255a-094a-3b11-a982-005844d98cfe",
                                                "text": "Сначала шло всё хорошо, писали прокламации, пропагандировали на фабриках, но потом схватили одну выдающуюся личность, захватили бумаги и начали всех брать."
                                            },
                                            {
                                                "example_id": "1cb0876f-6218-493a-a32f-d4e6a52008b4",
                                                "sense_id": "1088255a-094a-3b11-a982-005844d98cfe",
                                                "text": "Она пропагандирует благотворительность во всех её видах…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
