                        "sense_id": "bb7dc7d0-83d3-39fb-a9ee-5e90c274f102",
                        "entry_id": "0738d7b1-5ca0-3ed6-8e37-58ff54771254",
                        "glosses": [
                            "slome, tamelijk domme man"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "74af927b-d6cc-447e-850b-9122206a553c",
                                "sense_id": "bb7dc7d0-83d3-39fb-a9ee-5e90c274f102",
                                "text": "Een beetje optillen, zei ik, niet meteen het halve bord leeggieten, kloris, nee, dat red je niet met de keukenrol. Pak maar een dweil."
                            }
                        ]
