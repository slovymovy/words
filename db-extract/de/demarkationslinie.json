                    {
                        "form_id": "05dd51cb-6af8-49f2-b10c-9c2f420f0406",
                        "entry_id": "efc76d57-291f-3d59-b25d-af6ab1349765",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Demarkationslinien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d10c3e5-4094-3edb-8cf7-0e78a8b113e5",
                        "entry_id": "efc76d57-291f-3d59-b25d-af6ab1349765",
                        "glosses": [
                            "vorläufig vereinbarte Grenzlinie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f134bd02-69e4-4299-8d96-ae6b43922870",
                                "sense_id": "5d10c3e5-4094-3edb-8cf7-0e78a8b113e5",
                                "text": "„Über die Rückkehr entlassener Heeresangehöriger des einen Landes, die jenseits der Demarkationslinie des anderen Landes beheimatet sind, kann erst bei den Friedensverhandlungen entschieden werden.“"
                            },
                            {
                                "example_id": "6c52cf75-134f-4006-aae5-56a6a5c997f5",
                                "sense_id": "5d10c3e5-4094-3edb-8cf7-0e78a8b113e5",
                                "text": "„Von dort pendelte ja der Zug über die Demarkationslinie nach Scheune; dorthin brechen wir nach einer zweiten Übernachtung auf, von Tante Ilse innig umarmt, von Gretchen rührend mit Broten versorgt, die wir um keinen Preis ablehnen dürfen, obwohl sie gewiß nicht vom satten Munde, sondern von den ohnehin kargen Rationen eines »Normalverbrauchers« abgespart sind.“"
                            },
                            {
                                "example_id": "c56f39a3-df2a-4878-9dfe-d9bbf59f5d40",
                                "sense_id": "5d10c3e5-4094-3edb-8cf7-0e78a8b113e5",
                                "text": "„Nach jungentypischer Indianer-Cowboy-Manier sind sie oft mit ihrem Mountainbike unterwegs, wobei sie das nach der Wende undurchdringliche Gelände nahe der früheren Demarkationslinie erforschen, die an einigen Stellen noch immer stacheldrahtbewehrt ist.“"
                            },
                            {
                                "example_id": "d16cb0b7-cce5-4567-8b2d-671840d0aed6",
                                "sense_id": "5d10c3e5-4094-3edb-8cf7-0e78a8b113e5",
                                "text": "„Wir mußten ohne Erlaubnis der Deutschen über die Demarkationslinie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3f361b15-3b5f-3b30-8c8f-9aa473e39004",
                        "entry_id": "efc76d57-291f-3d59-b25d-af6ab1349765",
                        "glosses": [
                            "Linie zwischen gesundem und krankem Gewebe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03c11e16-0ac2-4dea-a5e3-54128042d80b",
                                "sense_id": "3f361b15-3b5f-3b30-8c8f-9aa473e39004",
                                "text": "„Oft wird um einen eitrig-nekrotischen Entzündungsherd eine deutlich sichtbare Demarkationslinie (Grenzlinie) ausgebildet. Damit wird der geschädigte Bereich gegen gesundes Gewebe abgegrenzt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39fb7a35-bca6-4c3a-b777-3897b9d393e2",
                        "source_entry_id": "efc76d57-291f-3d59-b25d-af6ab1349765",
                        "source_sense_id": "5d10c3e5-4094-3edb-8cf7-0e78a8b113e5",
                        "source_sense_description": "Politik: vorläufig vereinbarte Grenzlinie",
                        "target_lang_word": "line of demarcation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "898fc5aa-3066-489e-a81b-f9c660fdc4c2",
                        "source_entry_id": "efc76d57-291f-3d59-b25d-af6ab1349765",
                        "source_sense_id": "5d10c3e5-4094-3edb-8cf7-0e78a8b113e5",
                        "source_sense_description": "Politik: vorläufig vereinbarte Grenzlinie",
                        "target_lang_word": "ligne de démarcation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ligne de démarcation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "882582ef-55ba-3ad7-8f69-0d2070189107",
                                        "entry_id": "6d139e90-2110-3d77-af48-8d4569f3ea98",
                                        "glosses": [
                                            "Toute ligne tracée sur une carte, etc., pour marquer les limites de deux territoires, de deux propriétés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a540549f-05d6-46cd-a75c-cec20a9f08ee",
                                                "sense_id": "882582ef-55ba-3ad7-8f69-0d2070189107",
                                                "text": "« Récemment, l'armée nord-coréenne a érigé des murs, creusé le sol et construit des routes dans certaines zones situées entre la ligne de démarcation militaire (MDL) et la ligne de démarcation nord de la DMZ », a déclaré la source militaire, selon Yonhap, samedi, qui a ajouté ne pas savoir exactement ce qu'ils construisaient."
                                            },
                                            {
                                                "example_id": "cbffd98d-8add-44a9-9783-6da4339828cc",
                                                "sense_id": "882582ef-55ba-3ad7-8f69-0d2070189107",
                                                "text": "Tracer une ligne de démarcation entre le pouvoir administratif et le pouvoir judiciaire."
                                            },
                                            {
                                                "example_id": "42b54a6e-5019-4b6a-9299-215dfd70a55e",
                                                "sense_id": "882582ef-55ba-3ad7-8f69-0d2070189107",
                                                "text": "La ligne de démarcation qui sépare la physique de la chimie."
                                            },
                                            {
                                                "example_id": "57a67702-cdde-4135-873f-b5007c03cf95",
                                                "sense_id": "882582ef-55ba-3ad7-8f69-0d2070189107",
                                                "text": "Il avait toujours l’impression que la ligne de démarcation entre la réalité et le rêve était imprécise, s’effaçait à chaque instant davantage."
                                            },
                                            {
                                                "example_id": "ad6583bb-2018-44bc-a150-2b83a22a11ab",
                                                "sense_id": "882582ef-55ba-3ad7-8f69-0d2070189107",
                                                "text": "J’ai découvert l’antagonisme hutu et tutsi, infranchissable ligne de démarcation qui obligeait chacun à être d’un camp ou d’un autre. — (Gaël Faye, Petit Pays, Grasset, 2016, page 136)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5673409a-330f-3e06-9fca-885921bc85f5",
                                        "entry_id": "6d139e90-2110-3d77-af48-8d4569f3ea98",
                                        "glosses": [
                                            "Durant la Seconde Guerre mondiale, limite entre la France occupée et la France du régime de Vichy."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b22973d6-db69-47dc-85d4-195cdbf8cd81",
                                                "sense_id": "5673409a-330f-3e06-9fca-885921bc85f5",
                                                "text": "Ils ont été faits prisonnier en franchissant la ligne de démarcation."
                                            },
                                            {
                                                "example_id": "ef4faccb-fa5d-45b3-9e32-7e71e9a65110",
                                                "sense_id": "5673409a-330f-3e06-9fca-885921bc85f5",
                                                "text": "Une de ses grand-mères n’était pas très catholique et bien que Français de naissance, de cœur, de culture et de carte d’identité, il portait un nom polonais. Il remplissait ainsi assez bien les conditions requises pour avoir des ennuis, aussi avait-il choisi de rester au sud de la ligne de démarcation, côté du moindre mal."
                                            },
                                            {
                                                "example_id": "7bdaf9f4-0f0f-4894-b231-3a4ffa6ca8d1",
                                                "sense_id": "5673409a-330f-3e06-9fca-885921bc85f5",
                                                "text": "Chaque kilomètre les rapproche de la zone libre. Mais il leur faudra passer les contrôles, qui se trouvent sur la ligne de démarcation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
