                                "sense_id": "fe9bca84-fca3-3c6f-9231-ea2d3564e021",
                                "text": "Ein interessantes Thema der Fußballgeschichte ist die Entwicklung der Terminologie des Fußballspiels."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "fbe7f3a8-d375-3070-8b83-e4a641d60ed3",
                        "entry_id": "17c0a017-6cbd-379d-af9f-c7f68afda633",
