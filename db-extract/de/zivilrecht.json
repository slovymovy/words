                        "form": "des Zivilrechts"
                    },
                    {
                        "form_id": "19603ad5-e6bf-410f-9218-4a5cabeb3012",
                        "entry_id": "8774a9ce-3a09-3a6f-abb3-fd55d826c46d",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Zivilrecht"
                    },
                    {
                        "form_id": "3afc009b-ddce-4601-81fe-f00621760fb2",
                        "entry_id": "8774a9ce-3a09-3a6f-abb3-fd55d826c46d",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Zivilrecht"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b615c1c2-7cce-3210-89db-895f8fc94727",
                        "entry_id": "8774a9ce-3a09-3a6f-abb3-fd55d826c46d",
                        "glosses": [
                            "das allgemeine Privatrecht; die die Bürger (im Sinne von Privatpersonen bzw. natürlichen Personen) und die privatrechtlichen juristischen Personen betreffenden Rechtsnormen, aber nur solange und soweit die Rechtssubjekte nicht im Unterordnungsverhältnis zur öffentlichen Gewalt stehen"
                        ],
                        "tags": [
                            "Jura"
                        ],
                        "examples": [
                            {
                                "example_id": "89ac2dde-e55b-4c6e-b3a4-43e9971bc21e",
                                "sense_id": "b615c1c2-7cce-3210-89db-895f8fc94727",
                                "text": "„Das Bereicherungsrecht ist ein Teilgebiet des Zivilrechts.“"
                            },
                            {
                                "example_id": "91628c41-b712-4b3c-b5c4-a4b73d570325",
                                "sense_id": "b615c1c2-7cce-3210-89db-895f8fc94727",
                                "text": "„Als Auflage bezeichnet man im deutschen Zivilrecht eine Bestimmung, die zu einem Rechtsgeschäft hinzutritt und nach der ein anderer zu einer Leistung verpflichtet sein soll.“"
                            },
                            {
                                "example_id": "b84120c6-dc19-409e-a6a8-e3c1fe49d4a4",
                                "sense_id": "b615c1c2-7cce-3210-89db-895f8fc94727",
                                "text": "Das Verwaltungsverfahrensgesetz enthält zwar auch die Bürger betreffende Rechtsnormen – zum Beispiel Beteiligungs- und Antragsrechte, gehört aber nicht zum Zivilrecht, sondern zum öffentlichen Recht."
                            },
                            {
                                "example_id": "1f420998-2509-4c7a-9995-ac9945c0e87f",
                                "sense_id": "b615c1c2-7cce-3210-89db-895f8fc94727",
                                "text": "„Das ist aber nicht der Fall, er hat keine Ahnung ob das geht, das ist Zivilrecht, und da ist er schon zu lange raus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
