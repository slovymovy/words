                                        "glosses": [
                                            "Lacking prior examples; unprecedented."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1d12a6e-df27-479c-ad02-fd7bfd860480",
                                                "sense_id": "78d5cbf5-525e-36ad-8f0b-49239281301c",
                                                "text": "Shortly after this Mrs. Wix looked so ill that it was to be feared her ladyship had treated her to some unexampled passage."
                                            },
                                            {
                                                "example_id": "f2308656-4a45-4ba7-970c-c7a7e9242a60",
                                                "sense_id": "78d5cbf5-525e-36ad-8f0b-49239281301c",
                                                "text": "At the height of Napoleon's unexampled conquests […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
