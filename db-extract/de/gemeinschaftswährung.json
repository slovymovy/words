                                        "sense_id": "c4d3dd36-41d9-3236-9b8a-1b158efcd708",
                                        "entry_id": "64f087bb-74e3-3614-bb11-19b8a749c9b6",
                                        "glosses": [
                                            "A currency that is common to several countries."
                                        ],
                                        "tags": [
                                            "countable",
                                            "literally",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4033baa8-a637-3469-a537-7274fbb70b7f",
                                        "entry_id": "64f087bb-74e3-3614-bb11-19b8a749c9b6",
                                        "glosses": [
                                            "A standard of measurement that can be used for comparing disparate things."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edb4daec-0795-4cc7-bc0e-2af15f871340",
                                                "sense_id": "4033baa8-a637-3469-a537-7274fbb70b7f",
                                                "text": "Based on these factors, scientists can calculate their global warming potential, which makes it possible to have a \"common currency\" for greenhouse gasses, translating any given gas into its equivalent in carbon dioxide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de7addc3-05ef-3f73-8c48-fc57d3a1964e",
                                        "entry_id": "64f087bb-74e3-3614-bb11-19b8a749c9b6",
                                        "glosses": [
                                            "Common practice; a widespread idea, a commonplace habit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2089814-f432-48bc-a64b-fffb1dc1eded",
                                                "sense_id": "de7addc3-05ef-3f73-8c48-fc57d3a1964e",
                                                "text": "In global climate-speak, terms like 'scenario', 'impact', 'vulnerability', 'irreversible', 'mitigation', 'adaptation' and 'adaptive capacity' have become common currency, verbal coins sometimes so worn that they almost lose meaning, even though they carry sinister messages about the future of humanity."
                                            }
                                        ]
                                    }
