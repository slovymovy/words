                    "sense_id": "10e58120-4d78-3d7e-9be4-ae3b41d21771",
                    "sense_definition": "The edible nut of the walnut tree, typically consisting of two wrinkled halves inside a hard shell.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "walnut",
                    "name_type": "no",
                    "examples": [
                        {
