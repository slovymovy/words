            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ea1b7e1-111d-3c47-9d14-4abe5f68dcb9",
                    "sense_definition": "Rendre triste, causer de la peine ou du chagrin à quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette mauvaise nouvelle va profondément l'<w>attrister</w> quand elle rentrera ce soir."
                        },
                        {
                            "text": "Son départ soudain a beaucoup <w>attristé</w> l'ensemble de ses collègues de travail."
                        }
                    ],
                    "synonyms": [
                        "affliger",
                        "chagriner",
                        "désoler",
                        "peiner"
                    ],
                    "antonyms": [
                        "consoler",
                        "égayer",
                        "réconforter",
                        "réjouir"
                    ],
                    "common_phrases": [
                        "attrister profondément",
                        "attrister le cœur"
                    ]
                },
                {
                    "sense_id": "a25d134f-ba61-3589-967d-202f7f6596fd",
                    "sense_definition": "Devenir triste, concevoir du chagrin (le plus souvent à la forme pronominale).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas s'<w>attrister</w> pour des broutilles sans aucune importance."
                        },
                        {
                            "text": "Elle s'<w>attriste</w> chaque fois qu'elle repense à ces douloureux souvenirs."
                        }
                    ]
                },
                {
                    "sense_id": "0c3dabc8-ed94-351b-aa13-84a7b1ec4b5f",
                    "sense_definition": "Donner un aspect morne, sombre ou mélancolique à un lieu ou une chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "aspect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieux bâtiment délabré semble <w>attrister</w> tout le quartier depuis des années."
                        },
                        {
                            "text": "La pluie continue finit par <w>attrister</w> le paysage de cette belle vallée."
                        }
                    ],
                    "antonyms": [
                        "égayer"
                    ],
                    "common_phrases": [
                        "attrister le paysage",
                        "attrister le décor"
                    ]
                }
            ]
        }
