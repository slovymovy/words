                "senses": [
                    {
                        "sense_id": "289cf240-521b-3ef8-8305-91467fcba281",
                        "entry_id": "38f4556d-2c48-3c00-92e2-96f801a3baed",
                        "glosses": [
                            "Orthographe ancienne de jeûner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe322e69-f4a0-4989-a2e0-a57394894b0d",
                                "sense_id": "289cf240-521b-3ef8-8305-91467fcba281",
                                "text": "Celuy qui ne peut dormir s'il n'a soupe, est-il obligé de jeusner ?"
                            },
                            {
                                "example_id": "37fa84f9-755f-4ede-a3fd-afb7f6e07bf0",
                                "sense_id": "289cf240-521b-3ef8-8305-91467fcba281",
                                "text": "Nous sommes en temps de jeusner spirituellement : et pourtant si nous voulons jeusner, je trouve qu'il fait bon au soir prendre la dragée, laquelle je vous veux donner."
                            }
                        ]
                    }
