                                "de": "Schälst du kurz die <w>Kartoffeln</w> fürs Abendessen?",
                                "fr": "Tu épluches les <w>patates</w> pour le dîner ?",
                                "it": "Sbucci tu le <w>patate</w> per cena?",
                                "cs": "Oloupeš prosím <w>brambory</w> k večeři?",
                                "tr": "Akşam yemeği için <w>patatesleri</w> soyar mısın?",
                                "es": "¿Puedes pelar las <w>patatas</w> para la cena?"
                            }
