        "fr-extract.jsonl": [
            {
                "entry_id": "b8cd5c47-6282-3794-8926-99e31014a2d0",
                "word": "méiose",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a2fd3d1b-9261-4e04-ac66-b83f8b0c056d",
                        "entry_id": "b8cd5c47-6282-3794-8926-99e31014a2d0",
                        "tags": [
                            "plural"
                        ],
                        "form": "méioses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "792ce83c-42bd-3d71-93c7-1a690a19d82a",
                        "entry_id": "b8cd5c47-6282-3794-8926-99e31014a2d0",
                        "glosses": [
                            "Ensemble des deux divisions cellulaires aboutissant à la formation du gamète par réduction chromatique."
                        ],
                        "tags": [
                            "Biologie cellulaire"
                        ],
                        "examples": [
                            {
                                "example_id": "39a78f3b-09f6-4506-867e-cf78e29b5013",
                                "sense_id": "792ce83c-42bd-3d71-93c7-1a690a19d82a",
                                "text": "La conception nécessite l’atteinte et la pénétration par le spermatozoïde de l’ovocyte, qui complète sa méiose II avant la fusion des deux noyaux lors de la fécondation ([…])."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "990a2715-033e-4c2e-bbe0-c11dd6bd6a0e",
                        "source_entry_id": "b8cd5c47-6282-3794-8926-99e31014a2d0",
                        "source_sense_id": "792ce83c-42bd-3d71-93c7-1a690a19d82a",
                        "target_lang_word": "Meiose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meiose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ae0438d-c333-38b9-aded-ca1b2ca7da8b",
                                        "entry_id": "81b16fd1-b885-39f6-b1ec-15c4672880e3",
                                        "glosses": [
                                            "besondere Form der Zellkernteilung, wobei im Unterschied zur gewöhnlichen Kernteilung, der Mitose, die Anzahl der Chromosomen halbiert wird"
                                        ],
                                        "tags": [
                                            "Genetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77251aea-9baf-45d2-817f-d16ded26d86e",
                                                "sense_id": "6ae0438d-c333-38b9-aded-ca1b2ca7da8b",
                                                "text": "„Die Meiose läuft in zwei Teilungsschritten ab. In der Meiose I (Anmerkung: Reduktionsteilung) werden die homologen Chromosomen, die aus je zwei Chromatiden bestehen voneinander getrennt. Die Meiose II (Anmerkung: Äquationsteilung) ist eine im Prinzip mitotische Teilung, in der die beiden Chromatiden voneinander getrennt werden.“"
                                            },
                                            {
                                                "example_id": "b618843a-9e37-4e57-8d46-c6347e4b3a36",
                                                "sense_id": "6ae0438d-c333-38b9-aded-ca1b2ca7da8b",
                                                "text": "Immerhin musste die Evolution diploide Organismen hervorbringen, d.h. Organismen, bei denen die Chromosomen doppelt vorliegen. Diese müssen dann in einer Meiose wieder auf einfache Chromosomensätze reduziert und dann mit Hilfe von Sexualität neu kombiniert werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0918597b-9f70-4dfc-9c1a-eec16e035552",
                        "source_entry_id": "b8cd5c47-6282-3794-8926-99e31014a2d0",
                        "source_sense_id": "792ce83c-42bd-3d71-93c7-1a690a19d82a",
                        "target_lang_word": "meiosis",
                        "target_lang_code": "en",
