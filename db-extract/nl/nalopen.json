                "senses": [
                    {
                        "sense_id": "af4ef679-5dd1-395d-bd2a-f0d684b21282",
                        "entry_id": "6f22ccb8-4d3c-342d-a767-dac126a35132",
                        "glosses": [
                            "to check or verify information that one received earlier"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bd62ecb7-1e8f-4a56-aacd-c15279d2dd86",
                                "sense_id": "af4ef679-5dd1-395d-bd2a-f0d684b21282",
                                "text": "De redacteur vond het artikel interessant, maar hij moest nog wel even nalopen of alle feiten klopten",
                                "translation": "The editor found the article interesting, but he still had to check if all the facts were correct",
                                "english": "The editor found the article interesting, but he still had to check if all the facts were correct"
                            }
                        ]
                    },
