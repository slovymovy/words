                },
                {
                    "sense_id": "73a06878-0114-30b4-a1a7-36be89374186",
                    "sense_definition": "Donner l'apparence ou l'illusion d'une autre matière ou d'un autre objet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "illusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le plâtre a été travaillé avec minutie afin de <w>figurer</w> de véritables blocs de pierre taillée."
                        },
                        {
                            "text": "Sur la scène du théâtre, des toiles peintes suffisaient à <w>figurer</w> une forêt obscure et mystérieuse."
