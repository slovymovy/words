                ],
                "senses": [
                    {
                        "sense_id": "04d5dc78-bfce-333b-b3bf-f41915b75616",
                        "entry_id": "fc87b6a9-3e03-3f1a-8a74-4217b87f5dee",
                        "glosses": [
                            "Vorschrift (Regel), die beschreibt, wie man sich verhalten soll, wenn man niest (man soll in die Armbeuge niesen oder ein Einmaltaschentuch benutzen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45e64a14-205c-490d-b1b6-4698ed1d1cb3",
                                "sense_id": "04d5dc78-bfce-333b-b3bf-f41915b75616",
                                "text": "„Personen, die leichte Beschwerden verspüren, sollen sich zunächst isolieren und eine gute Handhygiene sowie die Hust- und Niesregel einhalten.“"
                            },
                            {
                                "example_id": "d5dc9310-56b9-46d9-9f33-f7a19e38f45f",
                                "sense_id": "04d5dc78-bfce-333b-b3bf-f41915b75616",
                                "text": "„Der Einzelunterricht wird unter diesen Voraussetzungen abgehalten: […] unbedingte Einhaltung der Hygienevorschriften (Hust- und Niesregel, keine Umarmung, kein physischer Kontakt etc.)“"
                            },
                            {
                                "example_id": "eaf0f225-ed4c-4bad-8443-6633f72d80b4",
                                "sense_id": "04d5dc78-bfce-333b-b3bf-f41915b75616",
                                "text": "„Eine gute Händehygiene, die Wahrung der Hust- und Niesregel sowie Abstand zu Erkrankten (ca. 1-2 Meter) schützt, wie bei Influenza und anderen Atemwegsinfektionen auch vor der Übertragung des Coronavirus.“"
                            },
                            {
                                "example_id": "8e818943-37aa-4597-b6d4-25230c937818",
                                "sense_id": "04d5dc78-bfce-333b-b3bf-f41915b75616",
                                "text": "„Achten Sie weiterhin auf die Händehygiene sowie die Anwendung der Husten- und Niesregeln.“"
                            },
                            {
                                "example_id": "e43a6251-f82e-489d-8aa1-0f1953836849",
                                "sense_id": "04d5dc78-bfce-333b-b3bf-f41915b75616",
                                "text": "„Halten Sie sich auch an die Husten-und Niesregeln: Ist kein Taschentuch griffbereit, sollten Sie beim Husten und Niesen die Armbeuge vor Mund und Nase halten und sich dabei von anderen Personen abwenden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
