                                        "sense_id": "ad72d275-b739-374d-ba19-47f4137b51e3",
                                        "entry_id": "36fdd052-7b36-3f63-aef0-cf2aaf1c2ad3",
                                        "glosses": [
                                            "A South Asian dish of rice and lentils."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6beb90b1-146d-4549-a183-508928b31c29",
                                                "sense_id": "ad72d275-b739-374d-ba19-47f4137b51e3",
                                                "text": "As for Paulette, the first language she learnt was Bengali, and the first solid food she ate was a rice-and-dal khichri cooked by Jodu's mother."
                                            },
                                            {
                                                "example_id": "0803e18d-6a1b-4048-bd4c-e6f46c7ae621",
                                                "sense_id": "ad72d275-b739-374d-ba19-47f4137b51e3",
                                                "text": "She found Kali Boori lying flat in front of the goddess. The khichiri was being distributed to the devotees."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
