                                                "sense_id": "b77445c3-b639-3f4f-94ba-59b80829fce7",
                                                "text": "I can't find my book."
                                            },
                                            {
                                                "example_id": "d3537570-aaca-4e8a-be13-88717a1788be",
                                                "sense_id": "b77445c3-b639-3f4f-94ba-59b80829fce7",
                                                "text": "Everyone always asks what my advice is, and my advice is don’t overintellectualize your art."
