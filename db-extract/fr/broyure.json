                    {
                        "sense_id": "53742d79-8720-3f3b-85bf-06e9a6d8094e",
                        "entry_id": "453c2510-4acf-3b95-90ee-955d614f3fcd",
                        "glosses": [
                            "Action de broyer."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5ab82e7b-8e9c-4266-8779-84edf11a7ed1",
                                "sense_id": "53742d79-8720-3f3b-85bf-06e9a6d8094e",
                                "text": "Ce n’est pas tout encore ; le tissu réticulaire de la moëlle et la partie fibreuse de la canne, éprouvent une broyure considérable lors du passage des cannes entre les cylindres, pour en exprimer le suc."
                            }
                        ]
                    },
                    {
                        "sense_id": "5199d05d-54e6-3a38-905e-28d5e70a29fd",
                        "entry_id": "453c2510-4acf-3b95-90ee-955d614f3fcd",
                        "glosses": [
                            "Résultat de cette action : matière broyée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31453d39-ffcc-473b-8499-eef07505e90f",
                                "sense_id": "5199d05d-54e6-3a38-905e-28d5e70a29fd",
                                "text": "Sa crotte, son rejeton, son fils sortit dégoulinant d’orbes et de constellations défaites, baignant dans une broyure d’étoiles."
                            },
                            {
                                "example_id": "423a974a-a4ea-4cbf-8adf-444603420c38",
                                "sense_id": "5199d05d-54e6-3a38-905e-28d5e70a29fd",
                                "text": "La masse la plus grande est celle des débris des pierres-ponces réduites en sable blanc, qu’on trouve en grande quantité et même en couches épaisses, que Dolomieu a prise pour de la broyure calcaire, et qui est de la même nature que celle qui abonde à l’île Vulcano."
                            },
                            {
                                "example_id": "e5ae94b2-a0dc-4780-9cb0-8dcba08ce780",
                                "sense_id": "5199d05d-54e6-3a38-905e-28d5e70a29fd",
                                "text": "Amarrées à la rive d’en face, d’autres péniches somnolaient, lourdes, chargées de broyures, de gravettes et de gravats."
                            }
                        ]
                    }
