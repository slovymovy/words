            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "981629bd-cf82-3120-af49-dfa192d4a566",
                    "sense_definition": "Confused, disorganized, or mixed up in a chaotic way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His explanation was so <w>muddled</w> that nobody in the room understood the plan.",
                            "target_lang_translations": {
                                "tr": "Açıklaması o kadar <w>karmakarışıktı</w> ki odadaki hiç kimse planı anlamadı."
                            }
                        },
                        {
                            "text": "The bad decision was the clear result of <w>muddled</w> thinking by the board.",
                            "target_lang_translations": {
                                "tr": "Bu kötü karar, yönetim kurulunun <w>karışık</w> düşünce yapısının bariz bir sonucuydu."
                            }
                        }
                    ],
                    "synonyms": [
                        "confused",
                        "disorganized",
                        "jumbled",
                        "mixed-up"
                    ],
                    "antonyms": [
                        "clear",
                        "organized",
                        "coherent"
                    ],
                    "common_phrases": [
                        "muddled thinking",
                        "muddled state"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kafası karışmış, düzensiz ya da karmakarışık bir durumda olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "karmakarışık",
                                "target_lang_sense_clarification": "düşünce veya durum için düzensiz"
                            },
                            {
                                "target_lang_word": "karışık",
                                "target_lang_sense_clarification": "net olmayan, anlaşılması güç"
                            },
                            {
                                "target_lang_word": "kafası karışık",
                                "target_lang_sense_clarification": "zihni bulanık veya kararsız olan kimse"
                            }
                        ]
                    }
                }
            ]
        },
        {
