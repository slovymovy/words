                    {
                        "sense_id": "8e51bc70-4d97-359f-8996-877efdf9eb53",
                        "entry_id": "10d92152-68ac-353b-8b2b-4391d8382db8",
                        "glosses": [
                            "A low stool for supporting the feet while seated."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47138859-ffc9-4e86-a034-d0db935d194c",
                                "sense_id": "8e51bc70-4d97-359f-8996-877efdf9eb53",
                                "text": "In Christianity, the world is called the footstool of Christ; in this Sumerian vision, the awakened body would be called the bed of the Queen of Heaven."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b725043-83ca-3628-909c-b7062953ccf8",
                        "entry_id": "10d92152-68ac-353b-8b2b-4391d8382db8",
                        "glosses": [
                            "Anything trodden upon or treated as subservient."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c22ba510-8fba-4be4-bfba-bb54b0df5e3a",
                                "sense_id": "0b725043-83ca-3628-909c-b7062953ccf8",
                                "text": "Thereafter, when I have eaten and drunken and made merry in my royal palace at Carcë, I will sail with my armies over the teeming deep to many-mountained Demonland. And it shall be my footstool, and these other Demons the slaves of me, yea, and the slaves of my slaves."
                            }
                        ]
                    }
                ],
