                "senses": [
                    {
                        "sense_id": "15882fe5-98ea-3012-9ce2-88867d047a78",
                        "entry_id": "e09ec496-c3bf-300d-9428-ac3fca311e31",
                        "glosses": [
                            "Lüftungsart und Lüftungstechnik zum Lüften von Gebäuden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5de40fc3-b2e1-466a-b357-4a41efbb1a05",
                                "sense_id": "15882fe5-98ea-3012-9ce2-88867d047a78",
                                "text": "„Auch gibt es schon seit längerem für die Gebäudelüftung geeignete Mischgas-Sensoren, jedoch ist deren Messgenauigkeit für eine zuverlässige und genaue Luftqualitätsmessung nicht befriedigend.“"
                            },
                            {
                                "example_id": "ad9d252f-0bd2-4dc5-b7f2-f4462e20d947",
                                "sense_id": "15882fe5-98ea-3012-9ce2-88867d047a78",
                                "text": "„Dabei wird nach Vorstellung verschiedenster Möglichkeiten der Gebäudelüftung der Effekt der optimalen Ausnutzung und des kostengünstigen Betriebes der Anlagen vermittelt.“"
                            },
                            {
                                "example_id": "14f3b3ea-7d83-4b3c-8673-a33ed853e2ad",
                                "sense_id": "15882fe5-98ea-3012-9ce2-88867d047a78",
                                "text": "„Mit zwei neuen Produkten unterstützt SIEGENIA-AUBI jetzt die energieeffiziente Gebäudelüftung: Der Luftqualitätssensor SENSOAIR und der Schalldämmlüfter AEROPAC lassen sich mithilfe von Z-Wave-Technologie miteinander verbinden und in intelligente dezentrale Lüftungssysteme einbinden.“"
                            },
                            {
                                "example_id": "77d766ee-bfdf-4987-8296-defa82237724",
                                "sense_id": "15882fe5-98ea-3012-9ce2-88867d047a78",
                                "text": "„Eine hochkarätig besetzte Runde von Fachleuten diskutierte gemeinsam mit den 160 Teilnehmern unter dem Motto \"Mechanische Lüftung - eine Luftnummer?\" die Entwicklung von innovativen und technisch realisierbaren sowie nutzerbezogenen Ansätzen im Bereich der Gebäudelüftung.“"
                            },
                            {
                                "example_id": "7bbeb0e1-7e8a-4ad9-9ab5-9ae662606065",
                                "sense_id": "15882fe5-98ea-3012-9ce2-88867d047a78",
                                "text": "„Am 1. und 2. Oktober treffen sich in Berlin Fachleute für Gebäudelüftung und -luftdichtheit zum 4. Internationale Symposium „Luftdichtheit von Gebäuden und Lüftungssystemen“ (vormals Europäisches Blower Door-Symposium) und zur 30. AIVC-Tagung „Trends bei hocheffizienten Gebäuden und die Rolle der Lüftung“.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
