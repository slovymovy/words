                        "glosses": [
                            "Qui précède le premier concile de Nicée, en 325 de notre ère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be5bbf52-014d-4740-aebd-f6f24ce67d9d",
                                "sense_id": "6b474579-f000-3686-953c-7fce4872db6f",
                                "text": "Pseudo Isidore a imaginé un concile pré-nicéen tenu à Rome en 324, dans lequel Arius aurait été condamné ; cette imagination est dépourvue de tout fondement."
                            },
                            {
                                "example_id": "0f66f775-a217-455b-99ab-0d2854a12aa1",
                                "sense_id": "6b474579-f000-3686-953c-7fce4872db6f",
                                "text": "Son anaphore, qui reflète probablement les traditions pré-nicéennes de la Cappadoce, comporte une préface dont la partie finale ne se distingue pas vraiment du type représenté par la préface déjà citée des Constitutiones Apostolorum VIII : la cour céleste chante le trisagion."
                            }
                        ]
                    }
