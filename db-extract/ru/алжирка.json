                "senses": [
                    {
                        "sense_id": "588cb187-17cd-3eac-8f16-4a1b980b79e7",
                        "entry_id": "07e34f94-2549-3757-83da-1cc13d38b51d",
                        "glosses": [
                            "женск. к алжирец; гражданка, жительница или уроженка Алжира"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f233e31-3f24-4de5-be0d-e8855bd12017",
                                "sense_id": "588cb187-17cd-3eac-8f16-4a1b980b79e7",
                                "text": "— Я сама алжирка, и для меня в этом смысле нет проблем. Но почему у нас нет права на демократию в рамках нашей мусульманской культуры?"
                            }
                        ]
                    },
                    {
                        "sense_id": "f8311159-7b5e-3937-a2d5-7b091edac412",
                        "entry_id": "07e34f94-2549-3757-83da-1cc13d38b51d",
                        "glosses": [
                            "жительница одноимённой столицы этой страны"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "372dc9a2-b155-4a46-b413-dea389c8b90d",
                        "source_entry_id": "07e34f94-2549-3757-83da-1cc13d38b51d",
                        "source_sense_description": "национальная принадлежность",
                        "target_lang_word": "Algerian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Algerian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "736b5b70-1889-3155-b5ed-7d4564f11514",
                                        "entry_id": "5e7e9c76-7ac2-3b45-b00a-485b71abaf84",
                                        "glosses": [
                                            "A person from Algeria or of Algerian descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36c79a85-aa70-4eac-b532-633001292046",
                                                "sense_id": "736b5b70-1889-3155-b5ed-7d4564f11514",
                                                "text": "It was a view that would not necessarily be shared by Algerians subjected to the gégène or having had their bellies pumped full of water during the Battle of Algiers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Algerian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f67c7fb0-c27e-3930-bdb1-a25b6a368d60",
                                        "entry_id": "b8adf20f-0c8c-34f0-8142-3e47a68747a5",
                                        "glosses": [
                                            "Of, from, or pertaining to Algeria or the Algerian people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb77b172-4fde-450f-b385-c1323fe73006",
                                                "sense_id": "f67c7fb0-c27e-3930-bdb1-a25b6a368d60",
                                                "text": "(Yasmina Khadra is a female pseudonym for a former Algerian army officer, Mohammed Moulessehoul, who lives in France and whose work has once again been overheatedly translated by John Cullen.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
