        "fr-extract.jsonl": [
            {
                "entry_id": "3014e5b0-695d-3596-bb52-ae05f8261bc7",
                "word": "commentatrice",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d78ffaf6-fa64-4eb4-a8e8-5c7ff382598b",
                        "entry_id": "3014e5b0-695d-3596-bb52-ae05f8261bc7",
                        "tags": [
                            "plural"
                        ],
                        "form": "commentatrices"
                    },
                    {
                        "form_id": "ccd1bec0-e707-4a51-b0b6-6b2cc137e0ca",
                        "entry_id": "3014e5b0-695d-3596-bb52-ae05f8261bc7",
                        "tags": [
                            "masculine"
                        ],
                        "form": "commentateur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0612788b-d941-3d16-86d7-6870d19b220c",
                        "entry_id": "3014e5b0-695d-3596-bb52-ae05f8261bc7",
                        "glosses": [
                            "Celle qui commente une œuvre de l’esprit, un sport, un spectacle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6bf335e-6ea9-47c5-b496-535cf455465c",
                                "sense_id": "0612788b-d941-3d16-86d7-6870d19b220c",
                                "text": "En effet, vous allez trouver ici photos de ces lignes manuscrites, émouvantes, belles et libres, dont je me ferai la commentatrice émue."
                            },
                            {
                                "example_id": "dd0a96e9-cf82-4178-a6ec-2417f9630528",
                                "sense_id": "0612788b-d941-3d16-86d7-6870d19b220c",
                                "text": "C. Meyers, déjà connue par ses publications sur le Pentateuque ou Zacharie ou dans le domaine archéologique, est la commentatrice du livre de l’Exode pour le New Cambridge Bible Commentary."
                            },
                            {
                                "example_id": "b7b33dc2-b302-4d78-9328-00b820fe8a2d",
                                "sense_id": "0612788b-d941-3d16-86d7-6870d19b220c",
                                "text": "Diana Nyad, qui a été dans les années soixante-dix la plus grande nageuse de fond du monde, a lancé une brillante carrière de commentatrice sportive."
                            },
                            {
                                "example_id": "4e83d2bc-9d53-4d2d-aba3-5d6478a155ad",
                                "sense_id": "0612788b-d941-3d16-86d7-6870d19b220c",
                                "text": "La commentatrice Hiroko Ogiwara n’a pas pris de gants dans sa tribune publiée par le tabloïd Nikkan Sports, en réaction à la diffusion, mi-avril, d’une vidéo montrant le premier ministre japonais, Shinzo Abe, tentant de convaincre la population de rester confinée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a131f83-a139-4242-90d5-cf8c1152bc7e",
                        "source_entry_id": "3014e5b0-695d-3596-bb52-ae05f8261bc7",
                        "source_sense_id": "0612788b-d941-3d16-86d7-6870d19b220c",
                        "target_lang_word": "commentator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commentator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33a2e9c8-095f-3a48-aa75-c687f92dd730",
                                        "entry_id": "1b605842-52e2-34d5-b379-7c03243bfb28",
                                        "glosses": [
                                            "A person who makes a commentary, particularly"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cb453a0-7729-4dab-a531-7877b5f5cb51",
                                                "sense_id": "33a2e9c8-095f-3a48-aa75-c687f92dd730",
                                                "text": "He was a commentator for football two years before retiring."
                                            },
                                            {
                                                "example_id": "d4ca3f88-0f00-4162-b552-b1dbbeb6c351",
                                                "sense_id": "33a2e9c8-095f-3a48-aa75-c687f92dd730",
                                                "text": "Specifically, and unforgivably, she restarted the Heathrow Third Runway bandwagon, which had been stalled for more than a decade and even declared dead by most commentators."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb89546c-7160-338a-a49c-f5819d899f83",
                                        "entry_id": "1b605842-52e2-34d5-b379-7c03243bfb28",
                                        "glosses": [
                                            "A person who makes a commentary, particularly",
                                            "Synonym of historian or chronicler, a person who compiles an annotated history."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7bf2f0d-b348-320b-8569-642df43cab1a",
                                        "entry_id": "1b605842-52e2-34d5-b379-7c03243bfb28",
                                        "glosses": [
                                            "A person who makes a commentary, particularly",
                                            "A person who compiles explanations and critical notes on a text."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae0a37d8-78b2-334c-865f-8e51c16a0d70",
                                        "entry_id": "1b605842-52e2-34d5-b379-7c03243bfb28",
                                        "glosses": [
                                            "A person who makes a commentary, particularly",
                                            "A person who compiles explanations of the law, particularly (historical) comparatively innovative European jurists in the 14th century, as opposed to earlier glossators."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd34c356-c2f4-4f7b-b27d-11645ffe19f1",
                                                "sense_id": "ae0a37d8-78b2-334c-865f-8e51c16a0d70",
                                                "text": "It would be well into the fourteenth century before the commentators came into their own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23cee1f2-9e0e-3fc0-9069-b4b83d2b7714",
                                        "entry_id": "1b605842-52e2-34d5-b379-7c03243bfb28",
                                        "glosses": [
                                            "A person who makes a commentary, particularly",
                                            "A person who compiles explanations of biblical passages."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "353966ef-0532-3cad-8963-d9a76c7724b0",
                                        "entry_id": "1b605842-52e2-34d5-b379-7c03243bfb28",
                                        "glosses": [
                                            "A person who makes a commentary, particularly",
                                            "A person who provides an instantaneous description of a public event, particularly a sporting event, for a mass media audience."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02fd0665-7f1e-3f76-9566-62630c7272bd",
                                        "entry_id": "1b605842-52e2-34d5-b379-7c03243bfb28",
                                        "glosses": [
                                            "A person who makes a commentary, particularly",
                                            "A person who provides analysis or opinion on current events, especially for a mass media audience."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "304b2cdd-6766-45f4-adc5-d42bd7e86eb6",
                        "source_entry_id": "3014e5b0-695d-3596-bb52-ae05f8261bc7",
                        "source_sense_id": "0612788b-d941-3d16-86d7-6870d19b220c",
                        "target_lang_word": "pundit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pundit",
