                        "examples": [
                            {
                                "example_id": "31ddb15e-d94c-4290-885a-16fe3b0d6a40",
                                "sense_id": "776e958f-50fb-3a7d-8708-e56db714331d",
                                "text": "Deze regeling is niet de eerste deal die het Openbaar Ministerie (OM) sluit met een kroongetuige. Eerder regelde men de bescherming voor hasjhandelaar Ad Karma. Het OM sloot met Karman een overeenkomst met de toezegging, dat als hij verklaringen af zou leggen over zijn rol en over de rol van de andere betrokkenen in de zaak, hij geen gevangenisstraf opgelegd zou krijgen."
                            },
                            {
                                "example_id": "85f3ec91-ab2b-4ad3-8af7-28910b0fec6f",
                                "sense_id": "776e958f-50fb-3a7d-8708-e56db714331d",
                                "text": "Mink K. is in 2006 vervolgd voor betrokkenheid bij de liquidatie van hasjhandelaar Jaap van der Heiden in 1993 in Alkmaar. Hij werd hiervan vrijgesproken."
                            }
                        ]
