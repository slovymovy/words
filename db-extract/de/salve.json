                ],
                "senses": [
                    {
                        "sense_id": "610baafe-b7a9-3881-95eb-cdc789b87144",
                        "entry_id": "f179811a-60e2-359a-a524-4d9df4cf87ef",
                        "glosses": [
                            "das gleichzeitige Abfeuern mehrerer Schusswaffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71f66686-e2e5-46fb-a64b-c82ab673c559",
                                "sense_id": "610baafe-b7a9-3881-95eb-cdc789b87144",
                                "text": "Als die erste Salve erfolgte, haben sich die anwesenden Frauen und Jungfern aus angeborener Zaghaftigkeit des weiblichen Geschlechts gewaltig verschrocken."
                            },
                            {
                                "example_id": "17ad3ed4-26f7-402b-a979-56d2d05a5c2c",
                                "sense_id": "610baafe-b7a9-3881-95eb-cdc789b87144",
                                "text": "„Nach den ersten Salven wurde der Beschuß unregelmäßig, und der Feuersturm versank fast wieder in der Dunkelheit.“"
                            },
                            {
                                "example_id": "5ef09daa-d36a-43f8-99fd-cc3e896dfbbe",
                                "sense_id": "610baafe-b7a9-3881-95eb-cdc789b87144",
                                "text": "„Aus der Gegend der Marienkirche flattern plötzlich Gewehrschüsse auf; erst vereinzelt, dann eine ganze Salve.“"
                            },
                            {
                                "example_id": "b20f8150-1959-407e-9baf-a7bc510ddcc3",
                                "sense_id": "610baafe-b7a9-3881-95eb-cdc789b87144",
                                "text": "„Die Soldaten feuerten eine Salve in die Menge, doch bevor sie nachladen konnten, drängten die Hawaiianer vorwärts, und die Männer tauchten ihre Kampfmatten ins Wasser, offensichtlich in dem Glauben, dadurch vor den Feuer spuckenden Musketen geschützt zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a53a0a7-8e7b-42ae-82da-57fa7b36ed12",
                        "source_entry_id": "f179811a-60e2-359a-a524-4d9df4cf87ef",
                        "source_sense_id": "610baafe-b7a9-3881-95eb-cdc789b87144",
                        "source_sense_description": "Militär: das gleichzeitige Abfeuern mehrerer Schusswaffen",
                        "target_lang_word": "salvo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salvo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4f22fad-e40c-3b3e-8764-a67f5645a998",
                                        "entry_id": "4e21348b-94d8-3858-b1c1-e2ffe9c30bd1",
                                        "glosses": [
                                            "An exception; a reservation; an excuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2826451-bb82-4b81-90df-0902d29bf502",
                                                "sense_id": "a4f22fad-e40c-3b3e-8764-a67f5645a998",
                                                "text": "1649, Charles I of England (attributed), Eikon Basilike\nThey admit […] salvos, cautions, and reservations."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "salvo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "adeef5f7-5b5d-30f1-bdaf-0500e3364e27",
                                        "entry_id": "2ecb00f6-d95d-3a72-8650-310c3a7aaa16",
                                        "glosses": [
                                            "A concentrated fire from pieces of artillery, as in endeavoring to make a break in a fortification; a volley."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12cda06a-3ac5-303b-b3a7-67ff04727e81",
                                        "entry_id": "2ecb00f6-d95d-3a72-8650-310c3a7aaa16",
                                        "glosses": [
                                            "A salute paid by a simultaneous, or nearly simultaneous, firing of a number of cannon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e13cc3f-be6b-4de8-9134-57aa7200298a",
                                                "sense_id": "12cda06a-3ac5-303b-b3a7-67ff04727e81",
                                                "text": "“Regard not that, my brother,” answered Magdalen Græme; “the first successors of Saint Peter himself, were elected not in sunshine but in tempests—not in the halls of the Vatican, but in the subterranean vaults and dungeons of Heathen Rome—they were not gratulated with shouts and salvos of cannon-shot and of musquetry, and the display of artificial fire—no, my brother—but by the hoarse summons of Lictors and Prætors, who came to drag the Fathers of the Church to martyrdom.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a1abda2-7b49-3c08-a173-47d818f7eca5",
                                        "entry_id": "2ecb00f6-d95d-3a72-8650-310c3a7aaa16",
                                        "glosses": [
                                            "Any volley, as in an argument or debate."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60eba688-1466-47f8-9ab0-72ff46995678",
                                                "sense_id": "2a1abda2-7b49-3c08-a173-47d818f7eca5",
                                                "text": "It was an impressive opening salvo from the Baggies, especially for a side that have made a poor beginning to what has been an admittedly tough start to their campaign."
                                            },
                                            {
                                                "example_id": "dd30a479-4e5d-4739-8f57-96ee5eeb78dd",
                                                "sense_id": "2a1abda2-7b49-3c08-a173-47d818f7eca5",
                                                "text": "Together, Johnson's plans mean that the clashes in parliament and the Supreme Court may be only the opening salvos in what promises to be the biggest constitutional storm in centuries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baa2bf32-f19f-36df-8e24-b2b3d9aaa775",
                                        "entry_id": "2ecb00f6-d95d-3a72-8650-310c3a7aaa16",
                                        "glosses": [
                                            "The combined cheers of a crowd."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "salvo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74976755-b9a7-33d1-91ea-38b87c8af8f4",
                                        "entry_id": "1e76f4c1-34f6-3ec6-bcd7-705d393780fe",
                                        "glosses": [
                                            "To discharge weapons in a salvo."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c3d8de2-bde3-4f2c-9177-b54a622f1195",
                        "source_entry_id": "f179811a-60e2-359a-a524-4d9df4cf87ef",
                        "source_sense_id": "610baafe-b7a9-3881-95eb-cdc789b87144",
                        "source_sense_description": "Militär: das gleichzeitige Abfeuern mehrerer Schusswaffen",
                        "target_lang_word": "salve",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "713a7706-ace3-3e1f-a486-14023fad0eb2",
                                        "entry_id": "8bd9f794-0a0e-348d-8cd5-626a24f35629",
                                        "glosses": [
                                            "Plusieurs coups de canon tirés successivement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f97a4d06-c4aa-463c-a56f-ce668cd41ea4",
                                                "sense_id": "713a7706-ace3-3e1f-a486-14023fad0eb2",
                                                "text": "Aussitôt après l'acceptation et la signature du traité par les commissaires de la Convention et les chefs royalistes, des salves d’artillerie et les sons de la musique militaire annoncèrent au public ce grand événement : par un mouvement spontané, les soldats des deux partis se précipitèrent dans les bras les uns des autres comme s'il n'eût jamais été question de guerre."
                                            },
                                            {
                                                "example_id": "ff759c36-10fc-4413-aa1e-91b3099af3c0",
                                                "sense_id": "713a7706-ace3-3e1f-a486-14023fad0eb2",
                                                "text": "Les salves devaient se faire entendre au milieu du discours de Safvet-pacha aux plénipotentiaires, et l’aider dans sa péroraison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5947b9e9-a217-30a6-b063-f9b5c3ba0ee6",
                                        "entry_id": "8bd9f794-0a0e-348d-8cd5-626a24f35629",
                                        "glosses": [
                                            "Plusieurs coups d’armes à feu qui se tirent en même temps à l’exercice ou dans le combat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35a6e761-cd30-44e3-9c00-a2403d70bc7c",
                                                "sense_id": "5947b9e9-a217-30a6-b063-f9b5c3ba0ee6",
                                                "text": "En approchant de nos lignes, l’ennemi fut accueilli par une salve bien nourrie."
                                            },
                                            {
                                                "example_id": "24e67b5b-a155-4a6f-ab0c-765d0fe0f2f6",
                                                "sense_id": "5947b9e9-a217-30a6-b063-f9b5c3ba0ee6",
                                                "text": "Mes hommes ont des balles en quantité suffisante, je vais leur ordonner de faire un feu de salve."
                                            },
                                            {
                                                "example_id": "bc9449fc-da82-4f8e-ae57-c93d35e4a2c1",
                                                "sense_id": "5947b9e9-a217-30a6-b063-f9b5c3ba0ee6",
                                                "text": "Le craquement d’un feu de salve, comme un tour de scie mécanique, coupa son propos."
                                            },
                                            {
                                                "example_id": "748a0b12-0f46-497c-9937-cdc6aa6e69a0",
                                                "sense_id": "5947b9e9-a217-30a6-b063-f9b5c3ba0ee6",
                                                "text": "À combien d’officiers, dans cette guerre, aura-t-il été donné de faire exécuter un feu par salves ?\n– Feu par salves ! ordonna-t-il donc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deb9a8ae-7211-3c40-a057-4231978e8aba",
                                        "entry_id": "8bd9f794-0a0e-348d-8cd5-626a24f35629",
                                        "glosses": [
                                            "Décharge de plusieurs canons ou fusils tirés en même temps soit en l’honneur de quelqu’un, soit dans des occasions de réjouissance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28df8e13-673b-4c60-8255-1b41cc00aa87",
                                                "sense_id": "deb9a8ae-7211-3c40-a057-4231978e8aba",
                                                "text": "Quand il arriva, on tira plusieurs salves d’artillerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5449ff96-7535-39ab-8f70-fbe330782932",
                                        "entry_id": "8bd9f794-0a0e-348d-8cd5-626a24f35629",
                                        "glosses": [
                                            "Bruit rythmé et répété en l'honneur de quelqu'un."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21e61d04-101a-44a0-ba11-9dbf50199127",
                                                "sense_id": "5449ff96-7535-39ab-8f70-fbe330782932",
                                                "text": "Une salve d’applaudissements, le bruit que font un grand nombre de personnes assemblées, en applaudissant toutes à la fois."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "salve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "225dd7c6-80b3-3465-b035-25b385764785",
                                        "entry_id": "be4ce63c-2d76-3eab-8634-7d352146db9f",
                                        "glosses": [
                                            "Plat, grande soucoupe qui, servait autrefois à présenter aux rois et princes divers objets et en particulier les mouchoirs et les linges de toilette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b35f4ac-abd5-4b56-844f-4e86afd27963",
                                                "sense_id": "225dd7c6-80b3-3465-b035-25b385764785",
                                                "text": "Ceux^([les mouchoirs]) que l'on présentait tous les matins, au nombre de trois, à Louis XIV, sur un salve de vermeil étaient en point comme les mouchoirs de l'auguste épouse de l'homme appelé par un poète allemand, le moucheur universel, …."
                                            },
                                            {
                                                "example_id": "5ebd91d9-b8e3-44aa-9017-0378c7d90c68",
                                                "sense_id": "225dd7c6-80b3-3465-b035-25b385764785",
                                                "text": "Outre la chemise et la serviette à laver, on appelle les Honneurs les mouchoirs, gants, …, qui se présentent à la fin de la toilette sur une soucoupe garnie et recouverte d'un grand taffetas, qui s'appelle une salve."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
