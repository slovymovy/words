                    },
                    {
                        "translation_id": "84905b9c-1a58-4ae9-ba0d-2b6d90935560",
                        "source_entry_id": "de4b0d0c-79e4-3184-bbe8-a790c6406d5b",
                        "source_sense_id": "9f3e2ad4-5ac4-3de2-8f89-7a0128292376",
                        "target_lang_word": "fortune hunter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fortune hunter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c7c7928-b6fe-339e-a6a3-f2506fdfb0c3",
                                        "entry_id": "b2f81b91-0aac-3929-baa4-46f9d4f227a9",
                                        "glosses": [
                                            "A person who eagerly seeks wealth without working to earn it, especially in an adventurous way or in an unsavory or unscrupulous way such as through marriage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76b218ea-dab2-4d22-bf23-646fa7bc7cd7",
                                                "sense_id": "7c7c7928-b6fe-339e-a6a3-f2506fdfb0c3",
                                                "text": "“You are very charming, sir, so charming, in fact, that you made me forget for a time that you are a fortune hunter. You slipped up only once just now, but that was enough. You don’t want me or my help, only my money.”"
                                            },
                                            {
                                                "example_id": "3a394312-46b8-4fa7-984f-5feb38eb13b6",
                                                "sense_id": "7c7c7928-b6fe-339e-a6a3-f2506fdfb0c3",
                                                "text": "101-year-old Rose (Gloria Stuart) returns to the scene of waterlogged hubris, where fortune hunter Lovett (Bill Paxton) is diving for diamonds."
                                            },
                                            {
                                                "example_id": "91d64d0a-9dee-4b58-bfd0-a282f83fae0f",
                                                "sense_id": "7c7c7928-b6fe-339e-a6a3-f2506fdfb0c3",
                                                "text": "[T]he swashbuckling modern-day fortune hunter Nathan Drake treks from Istanbul to Borneo to the highest peaks of the Himalayas in search of the lost treasures of the mystical Shambhala."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
