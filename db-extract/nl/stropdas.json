                                ]
                            },
                            {
                                "target_word": "cravate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a41f77a-1042-3817-bd1c-8ba8028020d6",
                                        "entry_id": "58e2a76b-e7e8-3c53-87b9-b44c4c0bce93",
                                        "glosses": [
                                            "Cheval robuste d’origine croate."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2c6d2d4-37d1-4454-9825-960ee9939e9f",
                                                "sense_id": "9a41f77a-1042-3817-bd1c-8ba8028020d6",
                                                "text": "Les cravates sont des chevaux de grand travail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f009c826-1eed-3adf-aebf-80c1edab53e1",
                                        "entry_id": "58e2a76b-e7e8-3c53-87b9-b44c4c0bce93",
                                        "glosses": [
                                            "Soldat de cavalerie légère originaire de Croatie."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c648918-fd25-48b1-8058-9de6d3f75a3d",
                                                "sense_id": "f009c826-1eed-3adf-aebf-80c1edab53e1",
                                                "text": "S'enrôler dans une compagnie de cravates."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cravate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bfd95913-2e41-3509-b4c5-e9dbf533838c",
                                        "entry_id": "0807e5a4-81e7-33c8-9ec8-78d1d0d08278",
                                        "glosses": [
                                            "Foulard que les hommes et plus rarement les femmes se mettent autour du cou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e959d633-61c9-499a-8179-d653b8fdde0f",
                                                "sense_id": "bfd95913-2e41-3509-b4c5-e9dbf533838c",
                                                "text": "Je mis un soin extrême à ma toilette et, pour la première fois, le nœud de ma cravate me parut une chose grave ; je m’absorbai dans sa confection avec complaisance."
                                            },
                                            {
                                                "example_id": "3db8ea52-5084-4180-a227-fc1b8ca4115a",
                                                "sense_id": "bfd95913-2e41-3509-b4c5-e9dbf533838c",
                                                "text": "Il passa la cravate autour de son cou. Au centre de la cravate, à travers un petit couloir de métal, devait glisser le ruban d’attache, que s’apprêtait à coincer un bec en levier. Ingénieux appareil, mais qui n’attendait que la visite du ruban pour abandonner la cravate ; celle-ci retomba sur la table d’opération."
                                            },
                                            {
                                                "example_id": "2e967f9b-035c-4e6c-b3a4-36031d640413",
                                                "sense_id": "bfd95913-2e41-3509-b4c5-e9dbf533838c",
                                                "text": "Je m’apprête, pour descendre à table. J’endosse un gilet de fantaisie, un vêtement sombre. Je pique une perle à ma cravate."
                                            },
                                            {
                                                "example_id": "b66608d6-ae4b-4de2-afc3-c00d921cfd6f",
                                                "sense_id": "bfd95913-2e41-3509-b4c5-e9dbf533838c",
                                                "text": "Jusqu’aux cravates, au petit nœud suavement bloqué par une épingle dans l’échancrure du col, jusqu’au feu d’un vrai diam’ et au cuir mat du bracelet-montre, on sentait ces messieurs soucieux de leur mise."
                                            },
                                            {
                                                "example_id": "ef034f88-b248-4a84-a799-c510c5154d62",
                                                "sense_id": "bfd95913-2e41-3509-b4c5-e9dbf533838c",
                                                "text": "Il allait, tête haute, serré dans un complet avantageux, la cravate impeccable, le chapeau désinvolte."
                                            },
                                            {
                                                "example_id": "56fe4d61-b713-4434-a406-70d4d63c9e69",
                                                "sense_id": "bfd95913-2e41-3509-b4c5-e9dbf533838c",
                                                "text": "Jim tirait ses manchettes et rectifiait sa cravate, en s’inclinant d’un air modeste."
                                            },
                                            {
                                                "example_id": "8f7c3a1d-5533-435c-ad54-991f376e0e72",
                                                "sense_id": "bfd95913-2e41-3509-b4c5-e9dbf533838c",
                                                "text": "Monsieur André, l’Inspecteur le lui répète chaque fois, devrait savoir que la cravate fait partie de la civilisation, que ce soit une lavallière, un nœud droit ou une régate et que le décorum est lié à la fonction publique."
                                            },
                                            {
                                                "example_id": "d80c3978-6dd9-4a8b-91ce-26502228b903",
                                                "sense_id": "bfd95913-2e41-3509-b4c5-e9dbf533838c",
                                                "text": "Elle prit toutes les cravates et les jeta en vrac sur le linge, comme un nœud de serpents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8fe000f-92b9-366b-86c9-dd705c941b43",
                                        "entry_id": "0807e5a4-81e7-33c8-9ec8-78d1d0d08278",
                                        "glosses": [
                                            "Petite fourrure dont les femmes s’entourent le cou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d234ac94-8ea4-4d2c-9c34-d732bbf0eeb2",
                                                "sense_id": "a8fe000f-92b9-366b-86c9-dd705c941b43",
                                                "text": "une cravate d’astrakan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd51156e-252f-3f4e-871f-c4f690c653a6",
                                        "entry_id": "0807e5a4-81e7-33c8-9ec8-78d1d0d08278",
                                        "glosses": [
                                            "Corde qui serre le cou d’un pendu."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2bae949-c133-4aa4-8640-d5d9bed9d5d5",
                                                "sense_id": "fd51156e-252f-3f4e-871f-c4f690c653a6",
                                                "text": "Ou bien serait-ce quelque araignée qui brode une demi-aune de mousseline pour cravate à ce col étranglé ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5375f2cd-9514-33ac-8c0a-93ad0bd9a1dc",
                                        "entry_id": "0807e5a4-81e7-33c8-9ec8-78d1d0d08278",
                                        "glosses": [
                                            "Pièce de tissu rouge moirée qui sert à attacher autour du cou l’insigne de commandeur de la Légion d’honneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eb90c6f-8739-46d2-a363-06fd921b163a",
                                                "sense_id": "5375f2cd-9514-33ac-8c0a-93ad0bd9a1dc",
                                                "text": "Recevoir la cravate. (Être promu commandeur)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9652be9f-2b36-3b64-8473-9e8fce18d2df",
                                        "entry_id": "0807e5a4-81e7-33c8-9ec8-78d1d0d08278",
                                        "glosses": [
                                            "Ruban qu’on attache en haut d’une lance, d’un drapeau, et dont les bouts sont pendants."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9843ff4-2d60-4815-86ea-c54185ac4d82",
                                                "sense_id": "9652be9f-2b36-3b64-8473-9e8fce18d2df",
                                                "text": "La cravate d’un drapeau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bc74be6-7e32-37a5-b802-621ab7294dc5",
                                        "entry_id": "0807e5a4-81e7-33c8-9ec8-78d1d0d08278",
                                        "glosses": [
                                            "Plaquage à hauteur du cou, sévèrement sanctionné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9ccf9aa-7c83-4828-a4fa-54549688e211",
                                                "sense_id": "8bc74be6-7e32-37a5-b802-621ab7294dc5",
                                                "text": "« Très vilaine cravate du Samoan sur le joueur anglais ! » N’allez pas croire que les joueurs se prêtent des vêtements entre deux mêlées. La cravate en question est en réalité un bras tendu pour frapper la gorge d’un autre joueur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24037542-1186-3bc6-9cc9-df618c54173a",
                                        "entry_id": "0807e5a4-81e7-33c8-9ec8-78d1d0d08278",
                                        "glosses": [
                                            "Mousseline des Indes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "36ccf83a-76e9-3c5f-b1ed-4bc7f48f20f2",
                                        "entry_id": "0807e5a4-81e7-33c8-9ec8-78d1d0d08278",
                                        "glosses": [
                                            "Au tric-trac, marque que l’on met à son fichet pour signifier que l’on a une grande bredouille."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e46cb42a-99a9-3485-98c0-7853f40c0ff1",
                                        "entry_id": "0807e5a4-81e7-33c8-9ec8-78d1d0d08278",
                                        "glosses": [
