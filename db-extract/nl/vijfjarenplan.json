                        "sense_id": "7ec007d3-eef4-3a05-bfa3-037293080423",
                        "entry_id": "48b32537-705b-356a-9521-74303bee2646",
                        "glosses": [
                            "een plan waarin een aantal doelstellingen staan die binnen vijf jaar moeten zijn gehaald"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "685e125a-cd80-47c2-ac7c-61eced5b7ea2",
                                "sense_id": "7ec007d3-eef4-3a05-bfa3-037293080423",
                                "text": "In het kader van China’s dertiende vijfjarenplan (2016-2020) bouwt het land een landelijk netwerk van oplaadstations om te voldoen aan de vraag om vijf miljoen elektrische voertuigen te kunnen opladen in 2020."
                            },
                            {
                                "example_id": "89c0b0c2-0ca0-404b-930d-21cf539611ee",
                                "sense_id": "7ec007d3-eef4-3a05-bfa3-037293080423",
                                "text": "Deze stap kan gevolgen hebben voor andere onderdelen van het bedrijf, aangezien de automaker de kapitaaluitgaven wil terugbrengen tot 6 procent van de omzet. Het vijfjarenplan zou momenteel door de raad van toezicht worden bestudeerd."
                            }
                        ]
                    }
