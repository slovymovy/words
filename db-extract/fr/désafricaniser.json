                "senses": [
                    {
                        "sense_id": "a2949b1e-ae28-3160-a09e-2d96c13da49f",
                        "entry_id": "5e2a1c79-53f0-3c16-9a96-1a52100e71d6",
                        "glosses": [
                            "Faire perdre son caractère africain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1146da86-8f9e-4411-af36-5a1341cd669a",
                                "sense_id": "a2949b1e-ae28-3160-a09e-2d96c13da49f",
                                "text": "Elle a eu tendance à désafricaniser les Africains – allant dans le sens des paradigmes conquérants de la mentalité européenne."
                            },
                            {
                                "example_id": "99d131f1-ffd7-4b11-9385-3efaad9e31b0",
                                "sense_id": "a2949b1e-ae28-3160-a09e-2d96c13da49f",
                                "text": "En s’attaquant aux juifs et aux musulmans, elles cherchaient instinctivement à se « désémitiser, » à se « désafricaniser. »"
                            }
                        ]
                    }
