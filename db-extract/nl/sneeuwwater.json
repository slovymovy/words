                                                "sense_id": "79885389-91f7-3fee-86b4-374808ec1e66",
                                                "text": "We added a slosh of white wine to the sauce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cec51a68-61e5-30e5-9500-83f3d1028f90",
