    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dbdbb7b6-f60d-3109-9b1a-e8bf290ea4e2",
                    "sense_definition": "A mathematical function defined as the sine of x divided by x, commonly used in signal processing and physics.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematical_functions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer used the <w>sinc</w> function to model the ideal low-pass filter in the frequency domain.",
                            "target_lang_translations": {
                                "ru": "Инженер использовал <w>синк-функцию</w> для моделирования идеального фильтра нижних частот в частотной области."
                            }
                        },
                        {
                            "text": "In many textbooks, the unnormalized <w>sinc</w> is defined simply as the sine of x over x.",
                            "target_lang_translations": {
                                "ru": "Во многих учебниках ненормированный <w>кардинальный синус</w> определяется просто как отношение синуса x к x."
                            }
                        }
                    ],
                    "synonyms": [
                        "sine cardinal function",
                        "cardinal sine function",
                        "sine of x over x",
                        "sampling function"
                    ],
                    "common_phrases": [
                        "unnormalized sinc",
                        "sinc function"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Математическая функция, определяемая как отношение синуса x к x, широко используемая в обработке сигналов и физике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "синк-функция",
                                "target_lang_sense_clarification": "математический термин"
                            },
                            {
                                "target_lang_word": "кардинальный синус",
                                "target_lang_sense_clarification": "полное название функции"
                            },
                            {
                                "target_lang_word": "функция sinc",
                                "target_lang_sense_clarification": "техническое обозначение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecfe7e73-c004-3d88-b53e-221c76e33483",
                    "sense_definition": "The normalized version of the cardinal sine function, defined as the sine of pi times x divided by pi times x.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematical_functions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Digital signal processing often relies on the normalized <w>sinc</w> to ensure the zero-crossings occur at integer values.",
                            "target_lang_translations": {
                                "ru": "Цифровая обработка сигналов часто опирается на нормированную <w>синк-функцию</w>, чтобы обеспечить пересечение нуля в целых значениях."
                            }
                        },
                        {
                            "text": "When calculating the Fourier transform of a rectangular pulse, the result is a <w>sinc</w> shape.",
                            "target_lang_translations": {
                                "ru": "При вычислении преобразования Фурье прямоугольного импульса результатом является график в форме <w>синка</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sine of pi times x over pi times x"
                    ],
                    "common_phrases": [
                        "normalized sinc",
                        "sinc interpolation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нормированная версия функции кардинального синуса, определяемая как отношение синуса (pi * x) к (pi * x)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нормированная синк-функция",
                                "target_lang_sense_clarification": "в цифровой обработке сигналов"
                            },
                            {
                                "target_lang_word": "нормированный кардинальный синус",
                                "target_lang_sense_clarification": "математически точное название"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}