            {
                "entry_id": "fa7bf5c2-832f-38df-9030-115689fd3905",
                "word": "repousse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2422c421-8a37-49a3-8a6e-1aa284a03c5e",
                        "entry_id": "fa7bf5c2-832f-38df-9030-115689fd3905",
                        "tags": [
                            "plural"
                        ],
                        "form": "repousses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "30fa892d-5db0-3d19-9a33-6dac2be88980",
                        "entry_id": "fa7bf5c2-832f-38df-9030-115689fd3905",
                        "glosses": [
                            "Action de repousser, de croître de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cc52bac-6579-47e5-96df-de45fb320d1b",
                                "sense_id": "30fa892d-5db0-3d19-9a33-6dac2be88980",
                                "text": "Les pâturages sont divisés en six parts utilisées successivement par périodes de cinq jours, ce qui permet et la repousse de l'herbe et la répartition de la fumure."
                            },
                            {
                                "example_id": "73283358-a8aa-4660-bba8-33f0adb08a7e",
                                "sense_id": "30fa892d-5db0-3d19-9a33-6dac2be88980",
                                "text": "Qu'une lotion, chimiquement établie après de longues recherches, provoque la repousse des cheveux n'a en soi rien d'illogique. Le client s'y attend."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c1f79ee-170e-32b8-ba38-4da9653ee740",
                        "entry_id": "fa7bf5c2-832f-38df-9030-115689fd3905",
                        "glosses": [
                            "Nouvelle pousse d'un végétal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9892e75-30f7-40d5-a20a-cba71669e46d",
                                "sense_id": "4c1f79ee-170e-32b8-ba38-4da9653ee740",
                                "text": "Les amitiés d’enfance (...) plantes venues aux terrains jeunes, fleuries mais fortes en racines, pleines de vie et de repousses."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f11649c-8dd7-3285-b061-fb2b2d53b66c",
                        "entry_id": "fa7bf5c2-832f-38df-9030-115689fd3905",
                        "glosses": [
                            "Dépôt d'apparence blanchâtre ou résineuse qui se forme à la surface du cuir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d10daa0-57b2-43f3-a9c2-ed9f6f961011",
                                "sense_id": "9f11649c-8dd7-3285-b061-fb2b2d53b66c",
                                "text": "Repousses blanches, grasses, minérales ; repousses salines, cristallines ; repousses résinoïdes."
                            },
                            {
                                "example_id": "2a824689-da68-457f-832f-735761c41ddf",
                                "sense_id": "9f11649c-8dd7-3285-b061-fb2b2d53b66c",
                                "text": "En corroierie, où il faut éviter le phénomène de « repousse » dû à la formation de boutons de suif sur la fleur du cuir, il est nécessaire de se cantonner strictement dans les savons contenant le moins possible d'acides gras saturés constituant des suifs."
                            }
                        ]
                    }
                ],
