                        "glosses": [
                            "Tolérance de l’organisme à un agent pathogène ou à un médicament, nécessitant une augmentation des doses administrées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "030634f0-8f67-4db5-9ea8-c1e628d4e093",
                                "sense_id": "1946e190-625e-3d11-b696-96fb75370a4f",
                                "text": "Un des exemples de tachyphylaxie est celui de l'injection d'une petite dose d’antigène qui a pour résultat d'empêcher une dose plus forte injectée quelques heures après, de provoquer des accidents graves. On retrouve cette réaction avec l'administration de bêta-bloquants."
                            }
