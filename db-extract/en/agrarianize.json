                        "glosses": [
                            "To convert to a more agricultural model."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dec474a-0e72-4699-96c4-6defa78f7f8a",
                                "sense_id": "5eadbc2d-cc74-30dd-8744-d22b62905c69",
                                "text": "Their living conditions had begun to deteriorate, initially with the administrative attempts to agrarianize their land .The attmpts to transform the Ainu into farmers were, however, not successful."
                            },
                            {
                                "example_id": "b2a99b27-084e-49bf-9f1d-24c77a79508a",
                                "sense_id": "5eadbc2d-cc74-30dd-8744-d22b62905c69",
                                "text": "Traditionally, Hitler's has been seen as a determinedly atavistic ideology, with his admiration of healthy peasant life and his dislike of urban culture reflecting a desire to 're-agrarianize' Germany, to turn back the clock and put the industrial revolution into reverse, recreating Germany as a pre-industrial idyll."
                            },
                            {
                                "example_id": "18ed5f25-5d32-46b0-aa07-760b4b5c8d9d",
                                "sense_id": "5eadbc2d-cc74-30dd-8744-d22b62905c69",
                                "text": "Man \"has been industrialized to the limit. Now agrarianize him. Somewhat.\""
                            }
                        ]
                    }
