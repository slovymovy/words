                },
                {
                    "sense_id": "51c4f483-7c76-305c-b82d-cf78ffc612c6",
                    "sense_definition": "A particular way of thinking; a mindset or mental attitude.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
