                ],
                "senses": [
                    {
                        "sense_id": "8ad33c6d-86b6-3c0f-86e9-fd02a8257fc9",
                        "entry_id": "6c91f2f8-8562-3319-88e2-872c3f8c249d",
                        "glosses": [
                            "fassförmiger Behälter, in dem radioaktive Abfälle (Atommüll) gelagert oder transportiert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27833a60-bb5f-4f44-bc4a-7028a772db4d",
                                "sense_id": "8ad33c6d-86b6-3c0f-86e9-fd02a8257fc9",
                                "text": "Im Lager Asse wurden Atommüllfässer von Radladern einfach in die Anlage hineingekippt."
                            },
                            {
                                "example_id": "d23d8e80-454d-4fc3-a6f0-9c52b0dca5b0",
                                "sense_id": "8ad33c6d-86b6-3c0f-86e9-fd02a8257fc9",
                                "text": "„Hunderte beschädigte Atommüllfässer will der Energiekonzern Vattenfall mit Spezialgreifern aus dem Kernkraftwerk Brunsbüttel holen. Die Aufsichtsbehörde hat dem Plan jetzt zugestimmt. Doch die Bergung wird Jahre dauern.“"
                            },
                            {
                                "example_id": "6aceb36f-d202-4a00-a3ca-a3506795e804",
                                "sense_id": "8ad33c6d-86b6-3c0f-86e9-fd02a8257fc9",
                                "text": "„Rund 2000 Atommüllfässer sind bundesweit beschädigt.“"
                            },
                            {
                                "example_id": "be794151-db71-4ac4-8490-da2e16101cdb",
                                "sense_id": "8ad33c6d-86b6-3c0f-86e9-fd02a8257fc9",
                                "text": "„Der Weg zu Kammer sieben auf der 725-Meter-Sohle ist mit einem Tor und Warnschildern versperrt. In diesen Hohlraum wurden 8500 Atommüllfässer eingelagert – per „Versturztechnik“, wie der frühere Betreiber sagte. Ein „geschönter“ Begriff, urteilt Parlitz. Radlader hatten die Behälter einfach über Abhänge in tiefer liegende Bereiche gekippt. Etliche Fässer sollen zerbeult oder geplatzt sein.“"
                            },
                            {
                                "example_id": "90670177-a08e-4c7d-8ed4-facf971e212f",
                                "sense_id": "8ad33c6d-86b6-3c0f-86e9-fd02a8257fc9",
                                "text": "[Entsorgung von Atommüll im Ozean:] „Den Wissenschaftlern zufolge wurden die Atommüllfässer so konzipiert, dass sie dem Druck der Tiefe standhalten; nicht aber so, dass sie die Radioaktivität zwingend einschließen. “"
                            },
                            {
                                "example_id": "7478aef4-cb5d-4637-8044-290a4d41a706",
                                "sense_id": "8ad33c6d-86b6-3c0f-86e9-fd02a8257fc9",
                                "text": "„Zu den fragwürdigen Entsorgungsmethoden gehörte beispielsweise die Versenkung von Atommüllfässern in den Ozeanen […].“"
                            },
                            {
                                "example_id": "c10598a3-dc49-4a19-8125-ff6595666845",
                                "sense_id": "8ad33c6d-86b6-3c0f-86e9-fd02a8257fc9",
                                "text": "[Schlagzeile:] „Atommüllfässer in Ärmelkanal entdeckt“"
                            },
                            {
                                "example_id": "5928c448-73f6-4f3b-b868-f4975b937e56",
                                "sense_id": "8ad33c6d-86b6-3c0f-86e9-fd02a8257fc9",
                                "text": "[Schlagzeile:] „Beschädigte Atommüllfässer an 17 Standorten“"
                            },
                            {
                                "example_id": "b2a9c00a-ef88-4cc0-ac74-f894bc842816",
                                "sense_id": "8ad33c6d-86b6-3c0f-86e9-fd02a8257fc9",
                                "text": "„Die Strahlenschützerin Lisa ist verantwortlich für die Durchführung der Bergungsarbeiten der Atommüllfässer aus dem Zwischenlager Asse II.“"
                            },
                            {
                                "example_id": "d23f1fa4-a31c-4dba-be49-adb561f17b86",
                                "sense_id": "8ad33c6d-86b6-3c0f-86e9-fd02a8257fc9",
                                "text": "„Für das Zwischenlager Gorleben wurde ein Einlagerungsstopp verfügt, in den Kellern des stillgelegten Atomkraftwerks Brunsbüttel tauchen immer mehr durchgerostete Atommüllfässer auf.“"
                            },
                            {
                                "example_id": "d7ffdd87-84b7-4e15-8f29-0edc854c6262",
                                "sense_id": "8ad33c6d-86b6-3c0f-86e9-fd02a8257fc9",
                                "text": "„Auf dem Gelände des Altmeilers Würgassen sollte ein neues Logistikzentrum entstehen, in dem 15.000 Atommüllfässer über einen Zeitraum von 30 Jahren zwischengelagert werden könnten, bevor sie in das geplante Endlager Schacht Konrad verfrachtet werden sollten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
