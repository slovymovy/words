                            {
                                "example_id": "77aa6ddc-75be-45b4-afca-c6c1e51b70d4",
                                "sense_id": "6f84b690-ca44-3e90-9e2d-e20423565ac3",
                                "text": "Segment sphérique. — Triangle sphérique."
                            }
