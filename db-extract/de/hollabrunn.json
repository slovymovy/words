                        "entry_id": "20eb61b5-a14e-317d-ba65-e730a4f7be82",
                        "glosses": [
                            "Bezirkshauptstadt im österreichischen Bundesland Niederösterreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3dfcc64-78f5-49a2-859b-737b9ff7058e",
                                "sense_id": "74be7c37-03ac-3ce3-9aec-8f063f9a8298",
                                "text": "Hollabrunn liegt im Weinviertel."
                            },
                            {
                                "example_id": "e60a765a-4406-430d-82a2-2b8c001233bd",
                                "sense_id": "74be7c37-03ac-3ce3-9aec-8f063f9a8298",
                                "text": "„In der Stadt Hollabrunn sind die Preise schon recht hoch. Bauplätze sind Mangelware, daher sind sie und auch die Häuser entsprechend teuer. …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7ca4daf8-04c5-30c2-969a-11094242f17c",
                        "entry_id": "20eb61b5-a14e-317d-ba65-e730a4f7be82",
                        "glosses": [
                            "österreichischer Verwaltungsbezirk in Niederösterreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b1fb14f-9b71-40a7-b3aa-af2f3ba47f04",
                                "sense_id": "7ca4daf8-04c5-30c2-969a-11094242f17c",
                                "text": "Der Bezirk Hollabrunn grenzt im Norden an das tschechische Mähren."
                            },
                            {
                                "example_id": "e8f4652b-73df-4d24-befd-adf8afc9e5ff",
                                "sense_id": "7ca4daf8-04c5-30c2-969a-11094242f17c",
                                "text": "In diesem Sinne haben wir uns auch heuer wieder bemüht, ein interessantes Bildungsprogramm im Bezirk Hollabrunn anzubieten."
                            }
                        ],
