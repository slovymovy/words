    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "595c9796-fd4c-36ee-9acb-fa937b60fff3",
                    "sense_definition": "Carrying more fat than usual on one's body; plump; not lean or thin.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "physical_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fat</w> man had problems going through the narrow door.",
                            "target_lang_translations": {
                                "ru": "<w>Толстому</w> мужчине было трудно пройти через узкую дверь."
                            }
                        },
                        {
                            "text": "The farmer decided that the <w>fattest</w> pig should yield the most meat for the winter.",
                            "target_lang_translations": {
                                "ru": "Фермер решил, что самая <w>жирная</w> свинья даст больше всего мяса на зиму."
                            }
                        }
                    ],
                    "synonyms": [
                        "chubby",
                        "corpulent",
                        "obese",
                        "overweight",
                        "plump",
                        "rotund"
                    ],
                    "antonyms": [
                        "skinny",
                        "slender",
                        "slim",
                        "thin"
                    ],
                    "common_phrases": [
                        "fat pig",
                        "fat guy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий избыточный вес, полный, не худой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толстый",
                                "target_lang_sense_clarification": "о человеке или животном"
                            },
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "вежливая форма"
                            },
                            {
                                "target_lang_word": "тучный",
                                "target_lang_sense_clarification": "очень полный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3ca2e9e-88bd-3226-b4f2-58b6ed7b59c5",
                    "sense_definition": "Thick or large in size or volume.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fat</w> wallets of the men from the city brought joy to the local peddlers.",
                            "target_lang_translations": {
                                "ru": "<w>Пухлые</w> кошельки городских мужчин принесли радость местным торговцам."
                            }
                        },
                        {
                            "text": "He pulled a <w>fat</w> book from the shelf and began to read the first chapter.",
                            "target_lang_translations": {
                                "ru": "Он достал с полки <w>толстую</w> книгу и начал читать первую главу."
                            }
                        }
                    ],
                    "synonyms": [
                        "thick"
                    ],
                    "antonyms": [
                        "thin"
                    ],
                    "common_phrases": [
                        "fat wallet",
                        "fat book"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий большую толщину или объем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толстый",
                                "target_lang_sense_clarification": "о предметах, например, книге"
                            },
                            {
                                "target_lang_word": "пухлый",
                                "target_lang_sense_clarification": "о кошельке или конверте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a18d4bc-4360-3036-9827-25d708a849fd",
                    "sense_definition": "Oily, greasy, or rich, especially when describing food.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fat</w> meat was too heavy for my stomach to digest late at night.",
                            "target_lang_translations": {
                                "ru": "<w>Жирное</w> мясо было слишком тяжелым для моего желудка, чтобы переварить его поздно ночью."
                            }
                        },
                        {
                            "text": "She avoided the <w>fat</w> gravy because she was trying to eat healthier meals.",
                            "target_lang_translations": {
                                "ru": "Она избегала <w>жирной</w> подливки, так как старалась питаться более здоровой пищей."
                            }
                        }
                    ],
                    "synonyms": [
                        "grease",
                        "fatty"
                    ],
                    "antonyms": [
                        "Of sense: lean"
                    ],
                    "common_phrases": [
                        "fat meat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий много жира, маслянистый (о пище)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жирный",
                                "target_lang_sense_clarification": "о еде или мясе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d559c081-c701-3802-8658-32823c9d2df9",
                    "sense_definition": "Fertile or productive, often referring to soil or land.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "productivity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers were grateful for the <w>fat</w> soil that produced a bountiful harvest.",
                            "target_lang_translations": {
                                "ru": "Фермеры были благодарны за <w>плодородную</w> почву, которая дала обильный урожай."
                            }
                        },
                        {
                            "text": "They moved their cattle to a <w>fat</w> pasture where the grass was green and thick.",
                            "target_lang_translations": {
                                "ru": "Они перегнали скот на <w>богатое</w> пастбище, где трава была зеленой и густой."
                            }
                        }
                    ],
                    "synonyms": [
                        "bountiful",
                        "prosperous"
                    ],
                    "common_phrases": [
                        "fat soil",
                        "fat pasture"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плодородный или продуктивный (о почве или земле)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плодородный",
                                "target_lang_sense_clarification": "о почве"
                            },
                            {
                                "target_lang_word": "богатый",
                                "target_lang_sense_clarification": "о пастбище или урожае"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c0fcbb9-903f-3fc4-ad09-12adb3570722",
                    "sense_definition": "Rich, producing a large income, or highly desirable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wealth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was lucky to land such a <w>fat</w> job right after finishing his university degree.",
                            "target_lang_translations": {
                                "ru": "Ему повезло получить такую <w>доходную</w> работу сразу после окончания университета."
                            }
                        },
                        {
                            "text": "The executive received a <w>fat</w> bonus at the end of the fiscal year.",
                            "target_lang_translations": {
                                "ru": "Руководитель получил <w>солидный</w> бонус в конце финансового года."
                            }
                        }
                    ],
                    "synonyms": [
                        "prosperous"
                    ],
                    "common_phrases": [
                        "fat job",
                        "fat paycheck"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used for financial gain"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приносящий большой доход, прибыльный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солидный",
                                "target_lang_sense_clarification": "о куше или бонусе"
                            },
                            {
                                "target_lang_word": "жирный",
                                "target_lang_sense_clarification": "разговорное о прибыли"
                            },
                            {
                                "target_lang_word": "доходный",
                                "target_lang_sense_clarification": "о работе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f72750e3-d753-3e5f-8674-2f3f623ce963",
                    "sense_definition": "Of a role: significant, major, or meaty.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theatre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor was thrilled to finally get a <w>fat</w> role in a major Broadway production.",
                            "target_lang_translations": {
                                "ru": "Актер был в восторге от того, что наконец получил <w>крупную</w> роль в большой бродвейской постановке."
                            }
                        },
                        {
                            "text": "He seeks a <w>fat</w> role in a hit show to increase his market value.",
                            "target_lang_translations": {
                                "ru": "Он ищет <w>выигрышную</w> роль в хитовом шоу, чтобы повысить свою востребованность."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fat role"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "theatrical jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Значительная, важная или большая роль."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крупная",
                                "target_lang_sense_clarification": "о роли в театре или кино"
                            },
                            {
                                "target_lang_word": "выигрышная",
                                "target_lang_sense_clarification": "о роли"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b9ce98e7-1f13-36a9-889f-805a458d4fb6",
                    "sense_definition": "A lipid substance found in animal tissue or blood, often solid at room temperature.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dietary <w>fat</w> is an essential part of a balanced diet when consumed in moderation.",
                            "target_lang_translations": {
                                "ru": "Пищевой <w>жир</w> является важной частью сбалансированного рациона при умеренном потреблении."
                            }
                        },
                        {
                            "text": "The chef removed the excess <w>fat</w> from the steak before grilling it.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар удалил лишний <w>жир</w> со стейка перед тем, как жарить его на гриле."
                            }
                        }
                    ],
                    "synonyms": [
                        "lard",
                        "grease",
                        "blubber"
                    ],
                    "common_phrases": [
                        "saturated fat",
                        "animal fat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жировое вещество, содержащееся в тканях животных или продуктах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жир",
                                "target_lang_sense_clarification": "вещество или продукт"
                            },
                            {
                                "target_lang_word": "сало",
                                "target_lang_sense_clarification": "подкожный жир животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d35684e2-5b3e-3fa8-b7ad-2e3786468d47",
                    "sense_definition": "A specialized animal tissue used for long-term storage of energy.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mammals that hibernate have plenty of <w>fat</w> to keep them warm during the winter.",
                            "target_lang_translations": {
                                "ru": "У млекопитающих, впадающих в спячку, много <w>жира</w>, чтобы согреться зимой."
                            }
                        },
                        {
                            "text": "The body stores excess calories as <w>fat</w> for future energy needs.",
                            "target_lang_translations": {
                                "ru": "Организм запасает лишние калории в виде <w>жира</w> для будущих энергетических нужд."
                            }
                        }
                    ],
                    "synonyms": [
                        "adipose tissue",
                        "flab"
                    ],
                    "common_phrases": [
                        "body fat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специализированная ткань организма для хранения энергии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жир",
                                "target_lang_sense_clarification": "биологическая ткань"
                            },
                            {
                                "target_lang_word": "жировая прослойка",
                                "target_lang_sense_clarification": "анатомический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "839cba25-177d-3674-9d99-e504c59c5836",
                    "sense_definition": "The best or richest part of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "best_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After winning the lottery, they were able to live on the <w>fat</w> of the land.",
                            "target_lang_translations": {
                                "ru": "Выиграв в лотерею, они смогли жить, вкушая все <w>блага</w> жизни."
                            }
                        },
                        {
                            "text": "The investors took the <w>fat</w> of the profits and left nothing for the workers.",
                            "target_lang_translations": {
                                "ru": "Инвесторы забрали самые <w>сливки</w> прибыли, ничего не оставив рабочим."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fat of the land"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "idiomatic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лучшая или самая богатая часть чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сливки",
                                "target_lang_sense_clarification": "переносное значение, лучшая часть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6689614d-b0f1-3ccb-b9cc-2e0e809fc7c3",
                    "sense_definition": "The part of an organization or system that is considered wasteful or unnecessary.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "waste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new CEO promised to trim the <w>fat</w> in the company to improve efficiency.",
                            "target_lang_translations": {
                                "ru": "Новый гендиректор пообещал убрать <w>излишки</w> в компании, чтобы повысить эффективность."
                            }
                        },
                        {
                            "text": "There is a lot of <w>fat</w> in the government budget that could be cut.",
                            "target_lang_translations": {
                                "ru": "В государственном бюджете много <w>лишних трат</w>, которые можно было бы сократить."
                            }
                        }
                    ],
                    "common_phrases": [
                        "trim the fat"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "business context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Излишки или ненужные расходы в организации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "излишки",
                                "target_lang_sense_clarification": "в бюджете или штате"
                            },
                            {
                                "target_lang_word": "балласт",
                                "target_lang_sense_clarification": "ненужные элементы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e58aef37-26ea-3e63-aacb-862cadcc9eff",
                    "sense_definition": "To make something or someone <w>fat</w>; to fatten.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fattening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer began to <w>fat</w> the cattle in preparation for the autumn market.",
                            "target_lang_translations": {
                                "ru": "Фермер начал <w>откармливать</w> скот для подготовки к осенней ярмарке."
                            }
                        },
                        {
                            "text": "They decided to kill the <w>fatted</w> calf to celebrate the return of their son.",
                            "target_lang_translations": {
                                "ru": "Они решили заколоть <w>откормленного</w> тельца, чтобы отпраздновать возвращение сына."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fatted calf"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "fatten is more common"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать кого-либо или что-либо жирным; откармливать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откармливать",
                                "target_lang_sense_clarification": "животных на убой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}