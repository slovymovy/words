                "senses": [
                    {
                        "sense_id": "a7e773a9-8585-3b0d-88b6-a53c3e17a691",
                        "entry_id": "fe685fd3-8d6a-3022-a80b-fb636bf0bcf3",
                        "glosses": [
                            "die Größe einer Murmel habend, so groß wie eine Murmel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82403403-097f-4b11-acd2-110b6772bd18",
                                "sense_id": "a7e773a9-8585-3b0d-88b6-a53c3e17a691",
                                "text": "„Der Mann im Achselshirt trug den gleichen Ring wie der Originalhinterwäldler: einen murmelgroßen, dunkelroten Stein.“"
                            },
                            {
                                "example_id": "a5ebab85-a62e-4896-bcfa-d7c1b37c66f2",
                                "sense_id": "a7e773a9-8585-3b0d-88b6-a53c3e17a691",
                                "text": "„Er brauchte sich nicht umzudrehen, um zu wissen, dass sie ihre murmelgroßen, arthritischen Knöchel noch immer fest in die Hüften gestemmt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
