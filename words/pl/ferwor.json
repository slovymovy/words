                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "chaos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W całym tym <w>ferworze</w> nikt nie zauważył, że zginęły ważne dokumenty.",
