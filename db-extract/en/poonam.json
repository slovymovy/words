            {
                "entry_id": "2a0fb3c3-0cbd-3bae-b1a5-5a917132402e",
                "word": "poonam",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3021e4cc-8076-4999-aa41-e9eed7ecd3be",
                        "entry_id": "2a0fb3c3-0cbd-3bae-b1a5-5a917132402e",
