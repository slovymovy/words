                        "examples": [
                            {
                                "example_id": "688b25c5-fe29-4910-9638-b81915128c48",
                                "sense_id": "11ef4afb-e772-37e6-8f75-bc24e2815518",
                                "text": "Der Kallus trägt nie die Pullover, die die Kallus ihm strickt."
                            },
                            {
                                "example_id": "5752b6a4-d206-4282-99cf-f6020585ba27",
                                "sense_id": "11ef4afb-e772-37e6-8f75-bc24e2815518",
                                "text": "Frau Kallus ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e0cd4070-87df-4427-832a-fdc9508420bd",
                                "sense_id": "11ef4afb-e772-37e6-8f75-bc24e2815518",
                                "text": "Herr Kallus wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ee504f9e-de9b-48f0-bc71-d7f03be40747",
                                "sense_id": "11ef4afb-e772-37e6-8f75-bc24e2815518",
                                "text": "Die Kallus fliegen heute nach Toronto."
                            },
                            {
                                "example_id": "ec497bc9-88aa-4207-898c-e38863e89212",
                                "sense_id": "11ef4afb-e772-37e6-8f75-bc24e2815518",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kallus kommt, geht der Herr Kallus.“"
                            },
                            {
                                "example_id": "7e41ab94-3645-42f1-bc18-446dc2ef5934",
                                "sense_id": "11ef4afb-e772-37e6-8f75-bc24e2815518",
                                "text": "Kallus kommt und geht."
                            },
                            {
                                "example_id": "6401d976-aeaf-4de2-903e-f0f677c66774",
                                "sense_id": "11ef4afb-e772-37e6-8f75-bc24e2815518",
                                "text": "Kallus kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
