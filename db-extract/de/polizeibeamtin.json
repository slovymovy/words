                        ]
                    },
                    {
                        "translation_id": "f403cf8f-a467-47f4-8795-e5446fb17efa",
                        "source_entry_id": "aeb612f2-df6d-3bee-9b99-6a7e1ec34575",
                        "source_sense_id": "ccadb13f-1026-36f5-b46f-1df4b9b9bcf4",
                        "source_sense_description": "Beamtin bei der Polizei",
                        "target_lang_word": "agent de police",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agent de police",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8327a6b-864c-3df2-92dd-a9f310843367",
                                        "entry_id": "0d2c85e3-1cac-341d-b321-6db2e3ef81e1",
                                        "glosses": [
                                            "Policier (nom officiel)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc565723-937c-4e27-aa82-09e87fb376ed",
                                                "sense_id": "f8327a6b-864c-3df2-92dd-a9f310843367",
                                                "text": "Puis il s'apaisa tout à coup, lorsque […] son valet de chambre, excusa leur retard en lui disant qu’ils avaient été arrêtés à l'entrée de Montreuil par des gendarmes et des agents de police en quête d'un assassin."
                                            },
                                            {
                                                "example_id": "03ca0b4e-a8c4-49a5-9787-a5a4bb4fb756",
                                                "sense_id": "f8327a6b-864c-3df2-92dd-a9f310843367",
                                                "text": "L’heure du repas s’approchait dangereusement lorsqu’une agent de police me sortit de la salle d’attente pour me guider jusqu’à un box d’entretien, un peu plus loin au rez-de-chaussée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bff0787c-6615-32ac-99ac-fb536a958f18",
                                        "entry_id": "0d2c85e3-1cac-341d-b321-6db2e3ef81e1",
                                        "glosses": [
                                            "Premier grade dans la police."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "662de593-cefb-4fbf-8b55-70b4328721cb",
                        "source_entry_id": "aeb612f2-df6d-3bee-9b99-6a7e1ec34575",
                        "source_sense_id": "ccadb13f-1026-36f5-b46f-1df4b9b9bcf4",
                        "source_sense_description": "Beamtin bei der Polizei",
                        "target_lang_word": "agente de police",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agente de police",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89e52b7f-3f93-3f65-81c1-a2624d6c9d03",
                                        "entry_id": "ba9da264-f360-3154-ad22-9ae6ff302a5f",
                                        "glosses": [
                                            "Policière."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d138a56b-d56c-4cd5-a2fd-2b9a5b717f02",
                                                "sense_id": "89e52b7f-3f93-3f65-81c1-a2624d6c9d03",
                                                "text": "Tout de suite après, une agente de police sort du commissariat pour assurer la circulation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3baf0d5b-2b55-4405-98b9-566c8345bfb6",
                        "source_entry_id": "aeb612f2-df6d-3bee-9b99-6a7e1ec34575",
                        "source_sense_id": "ccadb13f-1026-36f5-b46f-1df4b9b9bcf4",
                        "source_sense_description": "Beamtin bei der Polizei",
                        "target_lang_word": "policière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "policière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c40077c4-1f50-3a83-a402-2e3177d9e1bc",
                                        "entry_id": "9a51c2f1-4931-3393-9429-7fdf3afae879",
                                        "glosses": [
                                            "Fonctionnaire employée dans la police."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19adc047-23e8-4448-b112-be3786c1ddcb",
                                                "sense_id": "c40077c4-1f50-3a83-a402-2e3177d9e1bc",
                                                "text": "Dans la matinée, il avait attaqué une policière avec un couteau, la blessant, avant d’être tué par d’autres policiers."
                                            },
                                            {
                                                "example_id": "0bb2fbda-fabe-4886-bdc7-b410c64f51ba",
                                                "sense_id": "c40077c4-1f50-3a83-a402-2e3177d9e1bc",
                                                "text": "Très grièvement blessée, la policière a été admise pour un polytraumatisme à la clinique de la Dorcas à Tournai."
                                            },
                                            {
                                                "example_id": "f5d3dc38-be87-46bb-97f2-59de9bd9f0d0",
                                                "sense_id": "c40077c4-1f50-3a83-a402-2e3177d9e1bc",
                                                "text": "Il existe maintenant des policières, des soldates et forcément des officières, y’a pas de raison !"
                                            },
                                            {
                                                "example_id": "43619700-4a1a-47ca-b772-589e62a45d10",
                                                "sense_id": "c40077c4-1f50-3a83-a402-2e3177d9e1bc",
                                                "text": "Dans tous ces récits des victimes apparaissent des figures protectrices, celles qui ont dit « je te crois » et qui ont agi en conséquence : une mère ou un parent, un enseignant, une policière ou un gendarme, l’avocat général à l’audience malgré l’acquittement, une psychologue ou un médecin, un éducateur, la littérature, une émission, un article dans un journal, le témoignage d’une autre victime, un groupe de parole sur l’inceste, un film, la description des troubles de stress post-traumatique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "policière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "930e3c34-cf69-3c53-9dd0-49178e7dd747",
                                        "entry_id": "f735054f-9763-3c78-a5d9-b2fd3e3fca24",
                                        "glosses": [
                                            "Féminin singulier de policier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddb90450-d453-4ab8-813c-61a3e842fbbd",
                                                "sense_id": "930e3c34-cf69-3c53-9dd0-49178e7dd747",
                                                "text": "A. Comte avait fabriqué une caricature du catholicisme, dans laquelle il n’avait conservé que la défroque administrative, policière et hiérarchique de cette Église ; […]."
                                            },
                                            {
                                                "example_id": "accf8167-cbc5-4bd5-bf62-02d2859bb12e",
                                                "sense_id": "930e3c34-cf69-3c53-9dd0-49178e7dd747",
                                                "text": "Afin de démonopoliser, de désexpertiser le droit, l’enseignement doit être donné par les éducateurs réguliers et non pas par des policiers ou des juristes comme l’on tend à le pratiquer car, en premier lieu ceux-ci ne possèdent aucune formation pédagogique et d’autre part l’entraînement du policier est basé avant tout sur la répression : les échecs répétés dans la mise en application de l’enseignement juridique par les policiers sont dus avant tout au besoin inné d’inquisition de la personnalité policière."
                                            },
                                            {
                                                "example_id": "92dab40c-b947-4d7f-9912-e2b3daa86ad1",
                                                "sense_id": "930e3c34-cf69-3c53-9dd0-49178e7dd747",
                                                "text": "Et les chamboulements programmés par Chirac, qui souhaite alors « déballaduriser » la haute hiérarchie policière, nommée sous les auspices de Balladur et de son ministre de l’Intérieur Charles Pasque, tombent à l’eau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
