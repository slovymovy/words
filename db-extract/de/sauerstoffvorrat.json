                "senses": [
                    {
                        "sense_id": "889427ec-4151-35b9-87e6-9ea1c0d9fda1",
                        "entry_id": "ae70b03a-0437-3692-9bda-8bda22e9c23b",
                        "glosses": [
                            "Vorrat/Reserve an Sauerstoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d06a4809-52e8-489f-8199-469dbe776ca7",
                                "sense_id": "889427ec-4151-35b9-87e6-9ea1c0d9fda1",
                                "text": "„Zwar schafften wir es, auf der Venus zu landen, doch kaum waren wir dort, mussten wir auch schon wieder zurückkehren, weil wir wegen einer gravierenden Fehlberechnung unseres Bedarfs keine ausreichenden Sauerstoffvorräte an Bord hatten.“"
                            },
                            {
                                "example_id": "74e4fe5a-b59b-48f6-919b-b888503393f4",
                                "sense_id": "889427ec-4151-35b9-87e6-9ea1c0d9fda1",
                                "text": "„Während des drei Tage dauernden Rückflugs versuchten die Astronauten, so sparsam wie möglich mit ihren knappen Strom- und Sauerstoffvorräten umzugehen.“"
                            },
                            {
                                "example_id": "9bc77786-de22-4c8b-ab80-810b81d315cf",
                                "sense_id": "889427ec-4151-35b9-87e6-9ea1c0d9fda1",
                                "text": "„Trotz weiteren Auftriebs mußte der Salzburger aus Kaprun den Flug abbrechen, da sein Sauerstoffvorrat zu Ende ging und ihm die Kälte arg zu schaffen machte – die Außentemperatur betrug zu diesem Zeitpunkt minus 55 Grad Celsius.“"
                            },
                            {
                                "example_id": "f94d7244-dd0e-4c5f-bd59-b2807ae05d0f",
                                "sense_id": "889427ec-4151-35b9-87e6-9ea1c0d9fda1",
                                "text": "„Die Krankenhäuser stocken ihre Sauerstoffvorräte auf; das Technische Hilfswerk steht bereit, der Polizei bei der erwarteten Alarmstufe 2 zu helfen und Straßenbarrieren zu errichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
