                                "example_id": "0daa0179-c03a-4aeb-9b2a-ac15cc8eee3f",
                                "sense_id": "d4d13e9b-19ae-30f2-a397-9865f6a35d4a",
                                "text": "\"Secrets of the London Underground is completely unscripted. It is just me and Tim going to a location, and I have to contextualise where we are."
                            }
