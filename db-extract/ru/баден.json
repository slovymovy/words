                                        "sense_id": "34ac7dfb-1807-3959-9134-f00eaec45d9e",
                                        "entry_id": "394aa108-1ecc-3c79-b462-0d6fd48c2ed5",
                                        "glosses": [
                                            "Nom francisé de Baden-Baden, ville d’Allemagne, située dans le Bade-Wurtemberg."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1ec8136-84f7-4d82-ba1f-44fbec06a50d",
                                                "sense_id": "34ac7dfb-1807-3959-9134-f00eaec45d9e",
                                                "text": "— Il y avait une fois, répète-t-elle, docile, un hôtel à Bade, au bord d’une petite rivière où il était défendu de cracher, entouré d’un gazon qu’on balayait au balai-brosse tous les matins…"
                                            }
                                        ]
                                    }
