        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b85a82f7-38e6-32ed-955d-26cdf70d61f7",
                    "sense_definition": "The hobby or activity of seeking, acquiring, organizing, and storing specific items of interest.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stamp <w>collecting</w> used to be a very popular pastime for children.",
                            "target_lang_translations": {
                                "ru": "<w>Коллекционирование</w> марок раньше было очень популярным времяпрепровождением для детей.",
                                "tr": "Pul <w>koleksiyonculuğu</w> eskiden çocuklar için çok popüler bir hobiyidi."
                            }
                        },
                        {
                            "text": "His passion for <w>collecting</w> vintage cars requires a lot of garage space.",
                            "target_lang_translations": {
                                "ru": "Его страсть к <w>коллекционированию</w> ретро-автомобилей требует много места в гараже.",
                                "tr": "Klasik araba <w>koleksiyonu yapma</w> tutkusu çok fazla garaj alanı gerektiriyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stamp collecting",
                        "coin collecting",
                        "art collecting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хобби или деятельность по поиску, приобретению, систематизации и хранению определенных предметов, представляющих интерес.",
                        "tr": "Belirli ilgi alanına giren nesneleri arama, edinme, düzenleme ve saklama hobisi veya faaliyeti."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коллекционирование",
                                "target_lang_sense_clarification": "систематический сбор предметов"
                            },
                            {
                                "target_lang_word": "собирательство",
                                "target_lang_sense_clarification": "увлечение сбором чего-либо"
                            }
                        ],
                        "tr": [
