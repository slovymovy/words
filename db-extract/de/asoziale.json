                "senses": [
                    {
                        "sense_id": "12e9533b-12fe-3c2c-b9a6-0a2927b00f4f",
                        "entry_id": "281a4d80-98bf-3162-9e3f-8e6099bb562a",
                        "glosses": [
                            "weibliche Person, die sich in die Gesellschaft nicht einfügt und zum Zusammenleben in der Gemeinschaft nicht fähig oder nicht willens ist"
                        ],
                        "tags": [
                            "meist abwertend"
                        ],
                        "examples": [
                            {
                                "example_id": "df6c5c8a-8a60-4d32-b03a-274a2e7f0cd7",
                                "sense_id": "12e9533b-12fe-3c2c-b9a6-0a2927b00f4f",
                                "text": "Auf dem abgelegenen Gehöft haust eine Asoziale mit ihren Kindern."
                            },
                            {
                                "example_id": "0325e416-f71a-48fb-8e70-ec61ed9c1ebc",
                                "sense_id": "12e9533b-12fe-3c2c-b9a6-0a2927b00f4f",
                                "text": "Weil sie mit den Konventionen brach, wurde sie in ihrem katholischen Heimatdorf bald als Asoziale gebrandmarkt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
