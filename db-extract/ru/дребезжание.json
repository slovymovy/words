                "senses": [
                    {
                        "sense_id": "98c33cf7-a84e-34bf-afc3-570b69234028",
                        "entry_id": "ff0a1a62-8ef5-3f9e-9de4-6650a505576c",
                        "glosses": [
                            "действие по значению гл. дребезжать"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f9e44541-2fae-3ec8-9b8c-8a3ee0ad75ad",
                        "entry_id": "ff0a1a62-8ef5-3f9e-9de4-6650a505576c",
                        "glosses": [
                            "звуки, возникающие в процессе такого действия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b7a893c-69c5-4e37-958b-4fcd095c603b",
                                "sense_id": "f9e44541-2fae-3ec8-9b8c-8a3ee0ad75ad",
                                "text": "Вскоре мимо Машиной двери протопали торопливо тяжёлые шаги кухарки, сопровождавшиеся дребезжанием блюдечек и чашек, а минут десять спустя Машу кликнули в залу пить кофе."
                            },
                            {
                                "example_id": "70648eb6-5baa-4da4-ab37-6b1a8864a7b8",
                                "sense_id": "f9e44541-2fae-3ec8-9b8c-8a3ee0ad75ad",
                                "text": "На машине, говорят, очень надоедает стук машины, рев её, когда выпускают пар перед станциями, постоянное трепетание вагонов, храпение от хода всего поезда, шум кипящей воды, дребезжание всего железа, стукотня рам в окошках, а также и то, что нельзя уснуть спокойно; хотя кресла широкие, но всё же в креслах мудрено уснуть."
                            }
                        ]
                    }
