                "senses": [
                    {
                        "sense_id": "8f822a4d-7353-3e21-8409-93cd7d8e0f52",
                        "entry_id": "9b2bc71f-1358-3c77-acc4-ab8c849a9f77",
                        "glosses": [
                            "Cellule géante (d’environ 50 à 100 µm de diamètre) de la moelle hématopoïétique, responsable de la production des thrombocytes (par thrombopoïèse)."
                        ],
                        "tags": [
                            "Biologie cellulaire"
                        ],
                        "examples": [
                            {
                                "example_id": "cdbf0bcd-d900-4261-ade9-ae99dc096692",
                                "sense_id": "8f822a4d-7353-3e21-8409-93cd7d8e0f52",
                                "text": "Ils se sont détachés d’une énorme cellule de la moelle osseuse, le mégacaryocyte, dont la maturation (thrombopoïèse) est très originale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94680add-f843-4bf5-9de9-29543b9bd0bc",
                        "source_entry_id": "9b2bc71f-1358-3c77-acc4-ab8c849a9f77",
                        "source_sense_id": "8f822a4d-7353-3e21-8409-93cd7d8e0f52",
                        "target_lang_word": "megakaryocyte",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "megakaryocyte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46fdafc5-d9d2-332f-b128-2b53924471f7",
                                        "entry_id": "2752f1a2-4608-3026-a072-a02d56a1066f",
                                        "glosses": [
                                            "A large cell, found in bone marrow, responsible for the production of platelets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c074b02f-bcae-46f2-81ce-71af3cc2f6ab",
                                                "sense_id": "46fdafc5-d9d2-332f-b128-2b53924471f7",
                                                "text": "These have been described as giant cells with budding nuclei (Bizzozero [2]); but it seems to me that they are worthy of a more distinctive name. I shall speak of them hereafter as megakaryocytes, or large nucleated giant cells, while the first class might be named polykaryocytes, or multinucleated giant cells."
                                            },
                                            {
                                                "example_id": "46e0c3cc-67c9-45c0-afac-42acf86d1830",
                                                "sense_id": "46fdafc5-d9d2-332f-b128-2b53924471f7",
                                                "text": "The evidence of formation of blood platelets from the megakaryocyte is conclusive. Except for the origin of platelets in the early embryo from a forerunner of the megakaryocyte, Wright recognizes no other source for blood platelets in mammals."
                                            },
                                            {
                                                "example_id": "229ba00f-21d3-46ae-9b43-c40a4491f376",
                                                "sense_id": "46fdafc5-d9d2-332f-b128-2b53924471f7",
                                                "text": "Under appropriate culture conditions, the megakaryocyte burst-forming cell can develop into 40 to 500 megakaryocytes within 1 week."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
