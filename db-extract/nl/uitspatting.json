                                                "sense_id": "aa948c70-3788-3838-96ca-51b59b279d0d",
                                                "text": "life of debauchery"
                                            },
                                            {
                                                "example_id": "dc42aeb3-8e86-4cda-a378-73347c5f3f4c",
                                                "sense_id": "aa948c70-3788-3838-96ca-51b59b279d0d",
                                                "text": "drunken debauchery"
                                            },
                                            {
                                                "example_id": "3df98d25-d3dd-4948-b2ad-f225f654ecda",
                                                "sense_id": "aa948c70-3788-3838-96ca-51b59b279d0d",
                                                "text": "moral debauchery"
                                            },
                                            {
                                                "example_id": "315e6d87-27e1-4b2b-ba8f-3111e3b5530e",
                                                "sense_id": "aa948c70-3788-3838-96ca-51b59b279d0d",
                                                "text": "The novel depicts the debauchery of the ruling class."
                                            },
                                            {
                                                "example_id": "dda874b9-5ba5-4fd2-935f-a86a6369eb1c",
                                                "sense_id": "aa948c70-3788-3838-96ca-51b59b279d0d",
