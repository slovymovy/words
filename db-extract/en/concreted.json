                "senses": [
                    {
                        "sense_id": "39062e42-4bb1-3e1b-bdaf-354addb4c4c1",
                        "entry_id": "ca1ff70e-b9dc-3dc5-8ca1-c39e965e96ea",
                        "glosses": [
                            "Covered in or surrounded by concrete."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "426eac2f-e791-47f7-8c59-7f5a7b4a06d6",
                                "sense_id": "39062e42-4bb1-3e1b-bdaf-354addb4c4c1",
                                "text": "In 2009, Ruby moved to a much bigger studio complex in Vernon, further south, across the concreted LA River. Last year, Ruby expanded into even bigger premises in the area — 110,000 sq feet of studio space on a four-acre plot."
                            },
                            {
                                "example_id": "1f2b1102-efe0-4143-bf7d-ac6cc3f380c6",
                                "sense_id": "39062e42-4bb1-3e1b-bdaf-354addb4c4c1",
                                "text": "For Gio Fitzpatrick, the project represents the culmination of an old dream. As a 15-year-old exploring St Kilda's Elster Creek – once central to a coastal marsh ecosystem but since reduced to a concreted canal – he stumbled upon a flock of eastern rosellas, a species of birds thought long vanished from the area."
                            }
                        ]
                    },
                    {
                        "sense_id": "00c87354-73b4-3f87-9b19-f00a780d6d7e",
                        "entry_id": "ca1ff70e-b9dc-3dc5-8ca1-c39e965e96ea",
                        "glosses": [
                            "Solidified."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "36fe0f25-5f98-40a3-8daf-01b7a648ffb5",
                                "sense_id": "00c87354-73b4-3f87-9b19-f00a780d6d7e",
                                "text": "Hereof the common opinion hath been, and ſtill remaineth amongſt us, that Cryſtall is nothing elſe, but Ice or Snow concreted, and by duration of time, congealed beyond liquation."
                            }
                        ]
                    }
