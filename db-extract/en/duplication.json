                                            {
                                                "example_id": "8529cf01-a876-49df-b826-9992ebb39834",
                                                "sense_id": "bbce3c88-4eb5-3bce-b88e-d3da2107dc26",
                                                "text": "La duplication du cube, la construction en géométrie d’un cube qui est le double d’un autre."
                                            }
                                        ]
