                            "środ."
                        ],
                        "examples": [
                            {
                                "example_id": "a52f1266-ef13-4176-9d38-10fa549e46fd",
                                "sense_id": "37b4c390-2e1a-3115-9cf8-4322054ffb1c",
                                "text": "Odpowiednio przekazany feedback daje możliwość przemyślenia, co i w jaki sposób można poprawić tak, by w przyszłości omijać negatywne efekty"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23e886bb-c8b7-4aeb-9828-46f20d318722",
                        "source_entry_id": "5b1c8b7b-95ab-319b-aa10-de5432aa22c4",
                        "source_sense_id": "37b4c390-2e1a-3115-9cf8-4322054ffb1c",
                        "target_lang_word": "feedback",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feedback",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49eec534-9c60-384b-a97e-15d458fd28bc",
                                        "entry_id": "655b3b68-e947-3cd0-9cdb-ca6df8ceab0f",
                                        "glosses": [
                                            "Critical assessment of a process or activity or of their results."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "564e6818-e927-4305-b18d-034304569160",
                                                "sense_id": "49eec534-9c60-384b-a97e-15d458fd28bc",
                                                "text": "After you hand in your essays, I will give both grades and feedback."
                                            },
                                            {
                                                "example_id": "c033156b-a96c-4a25-be39-6a114341c853",
                                                "sense_id": "49eec534-9c60-384b-a97e-15d458fd28bc",
                                                "text": "“Over the past month, the Department has held three separate meetings with the ACLU to receive feedback and engage the organization in the solutions,” the department said in a statement. “As a result of the meetings, the Department agrees that publishing FIO statistics going forward is necessary, and the Department is working toward personalizing interactions between officers and citizens.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c085fea-4c0b-388d-af7a-c60f8c8196f0",
                                        "entry_id": "655b3b68-e947-3cd0-9cdb-ca6df8ceab0f",
                                        "glosses": [
                                            "The part of an output signal that is looped back into the input to control or modify a system."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6c17819-d8f5-44e2-b1a5-abbcc390a891",
                                                "sense_id": "7c085fea-4c0b-388d-af7a-c60f8c8196f0",
                                                "text": "The fact that similar cortical abnormalities can be experimentally induced in monkeys has allowed Michael Merzenich and his colleagues in San Francisco to explore an animal model of focal dystonia, and to demonstrate the abnormal feedback in the sensory loop and the motor misfirings that, once started, grow relentlessly worse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01be947a-4dff-366f-8b76-ebcc57171e27",
                                        "entry_id": "655b3b68-e947-3cd0-9cdb-ca6df8ceab0f",
                                        "glosses": [
                                            "The high-pitched howling noise heard when there is a loop between a microphone and a speaker."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e943145f-6c82-4831-8b0c-6765656527f3",
                                                "sense_id": "01be947a-4dff-366f-8b76-ebcc57171e27",
                                                "text": "A loud feedback screech blasted from a speaker on the wall. It was a hailing signal of some kind."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "feedback",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73b5c9ec-083a-36f0-8996-df3edc53cbb4",
                                        "entry_id": "6c42f122-f7f1-3a78-9624-c7fee4a847ef",
                                        "glosses": [
                                            "To generate the high-frequency sound by allowing a speaker to cause vibration of the sound generator of a musical instrument connected by an amplifier to the speaker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7fccb45-7b77-4d25-85a0-127973dc013d",
                                                "sense_id": "73b5c9ec-083a-36f0-8996-df3edc53cbb4",
                                                "text": "The show ended with a riot of feedbacking guitars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87b1477c-3981-36b6-83cf-4f5cf729176f",
                                        "entry_id": "6c42f122-f7f1-3a78-9624-c7fee4a847ef",
                                        "glosses": [
                                            "To provide informational feedback to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e557c555-1b9a-4406-8f89-14d07eb3f4ff",
                                                "sense_id": "87b1477c-3981-36b6-83cf-4f5cf729176f",
                                                "text": "His employees feedbacked him a lot more than he wanted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3d68a8e-1c98-3632-8008-2083d6a49e7c",
                                        "entry_id": "6c42f122-f7f1-3a78-9624-c7fee4a847ef",
                                        "glosses": [
                                            "To convey by means of specialized communications channel."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11486de1-a69c-44fb-aca7-266416d31b64",
                                                "sense_id": "f3d68a8e-1c98-3632-8008-2083d6a49e7c",
