                "forms": [
                    {
                        "form_id": "6039a2f5-6e61-40ab-861f-aaeb1779b2bf",
                        "entry_id": "f9aad1c4-119a-35ee-bed0-ebfa4988695a",
                        "tags": [
                            "plural"
                        ],
                        "form": "polymnies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ef8018fb-e299-3955-b294-3814079c024b",
                        "entry_id": "f9aad1c4-119a-35ee-bed0-ebfa4988695a",
                        "glosses": [
                            "Espèce de ver polychète marin sédentaire, du genre Eupolymnia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2820b934-99d4-4dc2-aea5-96c05e7b5bbf",
                                "sense_id": "ef8018fb-e299-3955-b294-3814079c024b",
                                "text": "Les polymnies ont une centaine de tentacules mobiles, qui ne se rétractent pas totalement."
                            },
                            {
                                "example_id": "f2738d1a-5c82-4ac3-a36d-124ef95d77fc",
                                "sense_id": "ef8018fb-e299-3955-b294-3814079c024b",
                                "text": "La polymnie vit sous les pierres, dans les anfractuosités des roches, à marée basse et plus profond."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d0c6353-257c-31e1-9bf5-293ef294177d",
                        "entry_id": "f9aad1c4-119a-35ee-bed0-ebfa4988695a",
                        "glosses": [
                            "Genre de grandes plantes astéracées américaines, dont une espèce (la poire de terre) produit des tubercules comestibles, et une autre (la patte d’ours) est une plante médicinale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9961c20-9587-4421-87dd-d04202cae68e",
                                "sense_id": "0d0c6353-257c-31e1-9bf5-293ef294177d",
                                "text": "Les polymnies peuvent dépasser 2 mètres de hauteur et portent des capitules de fleurs, généralement jaunes."
                            }
                        ]
                    }
                ],
