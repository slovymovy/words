    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "87e90562-e18a-3871-acdb-96d86a0e33d4",
                    "sense_definition": "Se couvrir de moisissure, s'altérer sous l'action de champignons microscopiques.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "alteration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si tu laisses ce pain dans un sachet humide, il va <w>moisir</w> très vite."
                        },
                        {
                            "text": "Ce pot de confiture entamé a fini par <w>moisir</w> au fond du réfrigérateur."
                        }
                    ],
                    "synonyms": [
                        "chancir"
                    ],
                    "common_phrases": [
                        "laisser moisir",
                        "commencer à moisir"
                    ]
                },
                {
                    "sense_id": "227a3efc-d318-3939-8c56-ba4b15c3db50",
                    "sense_definition": "Demeurer longtemps inactif au même endroit ou dans la même condition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stagnation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dépêchons-nous, je n'ai pas du tout envie de <w>moisir</w> ici toute l'après-midi."
                        },
                        {
                            "text": "Il refuse de <w>moisir</w> dans un bureau sans aucune perspective d'avenir."
                        }
                    ],
                    "common_phrases": [
                        "ne pas moisir",
                        "moisir sur place"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "cf6a1fa8-cce1-35f7-b14b-4b58289b5bde",
                    "sense_definition": "Provoquer l'apparition de moisissure sur quelque chose, dénaturer par l'humidité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "alteration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'humidité excessive de la cave a fini par <w>moisir</w> tous les vieux livres empilés."
                        },
                        {
                            "text": "Cette pièce mal ventilée retient les vapeurs d'eau et <w>moisit</w> rapidement le linge."
                        }
                    ]
                }
            ]
        }
    ]
