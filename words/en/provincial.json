{
    "word_family": [
        "province",
        "provincialism",
        "provinciality",
        "provincially"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7f56d253-0b1b-34ef-abc5-2103e600e4cf",
                    "sense_definition": "Relating to a province, which is a specific administrative district or division of a country.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "administrative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>provincial</w> government decided to increase funding for local schools this year.",
                            "target_lang_translations": {
                                "ru": "<w>Провинциальное</w> правительство решило увеличить финансирование местных школ в этом году.",
                                "zh": "今年<w>省级</w>政府决定增加对当地学校的拨款。"
                            }
                        },
                        {
                            "text": "She studied the <w>provincial</w> laws to understand the specific regulations of the region.",
                            "target_lang_translations": {
                                "ru": "Она изучала <w>провинциальные</w> законы, чтобы понять специфические правила региона.",
                                "zh": "她研究了<w>地方</w>法规，以了解该地区的具体规定。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "provincial government",
                        "provincial capital",
                        "provincial election"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к провинции как к административной единице или региону страны.",
                        "zh": "与省份有关的，指国家行政区划或区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провинциальный",
                                "target_lang_sense_clarification": "административный"
                            },
                            {
                                "target_lang_word": "региональный",
                                "target_lang_sense_clarification": "относящийся к региону"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "省级的",
                                "target_lang_sense_clarification": "行政级别"
                            },
                            {
                                "target_lang_word": "地方的",
                                "target_lang_sense_clarification": "区域性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa1e4f64-4716-33b0-a33f-445cc440f781",
                    "sense_definition": "Having a narrow or limited outlook; lacking the polish and sophistication of a large city.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>provincial</w> attitude made it difficult for him to appreciate different cultures.",
                            "target_lang_translations": {
                                "ru": "Его <w>провинциальное</w> отношение мешало ему ценить другие культуры.",
                                "zh": "他那<w>狭隘的</w>态度使他难以欣赏不同的文化。"
                            }
                        },
                        {
                            "text": "The city dwellers often looked down on what they considered <w>provincial</w> manners.",
                            "target_lang_translations": {
                                "ru": "Городские жители часто свысока смотрели на то, что они считали <w>провинциальными</w> манерами.",
                                "zh": "城市居民经常看不起他们认为<w>土气的</w>举止。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rural"
                    ],
                    "antonyms": [
                        "cosmopolitan",
                        "sophisticated"
                    ],
                    "common_phrases": [
                        "provincial attitude",
                        "provincial outlook",
                        "provincial mindset"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий узким кругозором; лишенный утонченности и лоска, характерных для жителей столицы.",
                        "zh": "指眼界狭窄、缺乏大城市那种圆滑与世故的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провинциальный",
                                "target_lang_sense_clarification": "ограниченный, неискушенный"
                            },
                            {
                                "target_lang_word": "узколобый",
                                "target_lang_sense_clarification": "с ограниченным кругозором"
                            },
                            {
                                "target_lang_word": "недалекий",
                                "target_lang_sense_clarification": "о взглядах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "狭隘的",
                                "target_lang_sense_clarification": "眼界有限"
                            },
                            {
                                "target_lang_word": "土气的",
                                "target_lang_sense_clarification": "缺乏世故"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e28b21f-241d-3585-afac-c79141179df1",
                    "sense_definition": "Characteristic of people from the country or small towns; unsophisticated or countrified.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The play was criticized for its <w>provincial</w> humor that only locals would understand.",
                            "target_lang_translations": {
                                "ru": "Пьесу критиковали за <w>провинциальный</w> юмор, который поняли бы только местные жители.",
                                "zh": "这部戏因其只有当地人才能理解的<w>乡土</w>幽默而受到批评。"
                            }
                        },
                        {
                            "text": "He felt out of place in the capital with his <w>provincial</w> accent and simple clothes.",
                            "target_lang_translations": {
                                "ru": "В столице он чувствовал себя не в своей тарелке со своим <w>провинциальным</w> акцентом и простой одеждой.",
                                "zh": "他带着<w>地方</w>口音和朴素的衣着，在首都感到格格不入。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rural"
                    ],
                    "antonyms": [
                        "urban"
                    ],
                    "common_phrases": [
                        "provincial life",
                        "provincial town"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характерный для жителей сельской местности или маленьких городов; простоватый или неотесанный.",
                        "zh": "具有乡村或小城镇特征的，指不成熟或带有乡土气息的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провинциальный",
                                "target_lang_sense_clarification": "о манерах или стиле"
                            },
                            {
                                "target_lang_word": "деревенский",
                                "target_lang_sense_clarification": "простоватый"
                            },
                            {
                                "target_lang_word": "местечковый",
                                "target_lang_sense_clarification": "ограниченный рамками малого города"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乡土的",
                                "target_lang_sense_clarification": "带有地方特色"
                            },
                            {
                                "target_lang_word": "地方性的",
                                "target_lang_sense_clarification": "非都市的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1403ff0-42f8-378d-9cd6-9d1becaa1c49",
                    "sense_definition": "Relating to an ecclesiastical province or the jurisdiction of an archbishop.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>provincial</w> synod met to discuss changes to the church liturgy.",
                            "target_lang_translations": {
                                "ru": "<w>Провинциальный</w> синод собрался для обсуждения изменений в церковной литургии.",
                                "zh": "<w>教省</w>会议召开，讨论教会礼仪的变更。"
                            }
                        },
                        {
                            "text": "He held a high position within the <w>provincial</w> hierarchy of the church.",
                            "target_lang_translations": {
                                "ru": "Он занимал высокий пост в <w>провинциальной</w> иерархии церкви.",
                                "zh": "他在教会的<w>教省</w>体系中担任要职。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "provincial synod"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к церковной провинции или юрисдикции архиепископа.",
                        "zh": "与教会省份或大主教管辖区有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провинциальный",
                                "target_lang_sense_clarification": "церковно-административный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "教省的",
                                "target_lang_sense_clarification": "教会行政"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2eba7d47-6ed6-3084-834e-4d1c152a14d3",
                    "sense_definition": "Relating to Provence, a historical region in southeastern France.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geographical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restaurant specialized in <w>provincial</w> cooking featuring herbs and olive oil.",
                            "target_lang_translations": {
                                "ru": "Ресторан специализировался на <w>провансальской</w> кухне с использованием трав и оливкового масла.",
                                "zh": "这家餐厅主打以香草和橄榄油为特色的<w>普罗旺斯</w>菜肴。"
                            }
                        },
                        {
                            "text": "They decorated their home in a rustic <w>provincial</w> style inspired by southern France.",
                            "target_lang_translations": {
                                "ru": "Они оформили свой дом в деревенском <w>прованском</w> стиле, вдохновленном югом Франции.",
                                "zh": "他们以法国南部为灵感，将家装饰成了质朴的<w>普罗旺斯</w>风格。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "provincial style"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Провансу, историческому региону на юго-востоке Франции.",
                        "zh": "与法国东南部历史地区普罗旺斯有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провансальский",
                                "target_lang_sense_clarification": "относящийся к Провансу"
                            },
                            {
                                "target_lang_word": "прованский",
                                "target_lang_sense_clarification": "о стиле или кухне"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "普罗旺斯的",
                                "target_lang_sense_clarification": "地理与文化"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2bc1f4b4-67bd-35ed-a2b3-ae0e1a653a79",
                    "sense_definition": "A person who lives in or comes from a province rather than the capital city.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a <w>provincial</w> moving to the big city, she found the pace of life overwhelming.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>провинциалкой</w>, переехавшей в большой город, она нашла темп жизни ошеломляющим.",
                                "zh": "作为一个搬到大城市的<w>外地人</w>，她觉得生活节奏快得让人难以适应。"
                            }
                        },
                        {
                            "text": "The locals viewed the newcomer as a typical <w>provincial</w> with little worldly experience.",
                            "target_lang_translations": {
                                "ru": "Местные жители видели в новичке типичного <w>провинциала</w> с малым жизненным опытом.",
                                "zh": "当地人把这位新来者看作是一个没什么世面、典型的<w>外地人</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "cosmopolitan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, живущий в провинции или приехавший из нее, в отличие от жителя столицы.",
                        "zh": "指居住在省份或来自省份而非首都的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провинциал",
                                "target_lang_sense_clarification": "житель провинции"
                            },
                            {
                                "target_lang_word": "приезжий",
                                "target_lang_sense_clarification": "из региона"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外地人",
                                "target_lang_sense_clarification": "非本地居民"
                            },
                            {
                                "target_lang_word": "省民",
                                "target_lang_sense_clarification": "来自省份的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9fd33c8-3e9c-368c-8dcc-84f943d58a38",
                    "sense_definition": "A senior official in certain religious orders who oversees a specific district or province.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religious_official",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>provincial</w> visited each monastery in the district to ensure rules were followed.",
                            "target_lang_translations": {
                                "ru": "<w>Провинциал</w> посетил каждый монастырь в округе, чтобы убедиться в соблюдении правил.",
                                "zh": "<w>省会长</w>巡视了该区的每一座修道院，以确保规章得到遵守。"
                            }
                        },
                        {
                            "text": "Letters were sent to the <w>provincial</w> requesting guidance on the new mission.",
                            "target_lang_translations": {
                                "ru": "<w>Провинциалу</w> были отправлены письма с просьбой дать указания по новой миссии.",
                                "zh": "信件被寄往<w>省会长</w>处，请求对新传教任务进行指导。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокопоставленное лицо в некоторых религиозных орденах, курирующее определенный округ или провинцию.",
                        "zh": "某些宗教修会中负责管理特定区域或省份的高级官员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провинциал",
                                "target_lang_sense_clarification": "глава монашеской провинции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "省会长",
                                "target_lang_sense_clarification": "宗教职务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6180078-af85-3546-a2c5-b0f6e90f48dc",
                    "sense_definition": "An unsophisticated person from the country; a bumpkin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sophisticated socialites mocked him, calling him a mere <w>provincial</w>.",
                            "target_lang_translations": {
                                "ru": "Искушенные светские львы насмехались над ним, называя его просто <w>провинциалом</w>.",
                                "zh": "世故的社交名流嘲笑他，称他不过是个<w>乡下人</w>。"
                            }
                        },
                        {
                            "text": "He rose from being a simple <w>provincial</w> to a powerful figure in the national government.",
                            "target_lang_translations": {
                                "ru": "Он прошел путь от простого <w>провинциала</w> до влиятельной фигуры в национальном правительстве.",
                                "zh": "他从一个单纯的<w>乡下人</w>成长为国家政府中的重要人物。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used disparagingly"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неотесанный человек из сельской местности; деревенщина.",
                        "zh": "指来自乡村、缺乏世故的人；乡巴佬。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провинциал",
                                "target_lang_sense_clarification": "в пренебрежительном смысле"
                            },
                            {
                                "target_lang_word": "деревенщина",
                                "target_lang_sense_clarification": "неотесанный человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乡下人",
                                "target_lang_sense_clarification": "非城市居民"
                            },
                            {
                                "target_lang_word": "土包子",
                                "target_lang_sense_clarification": "贬义"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}