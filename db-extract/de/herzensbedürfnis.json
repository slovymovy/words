                        "entry_id": "9ef447d1-e6cc-3173-88de-33ed46c74ae4",
                        "glosses": [
                            "besonderes persönliches Bedürfnis, dessen Erfüllung jemandem besonders am Herzen liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f5af207-91b9-4f21-aad6-b36ff669865a",
                                "sense_id": "2f9c7cf2-423b-3818-aab5-87fe8377f57e",
                                "text": "„Außerdem war es August und Rike ein Herzensbedürfnis, ihren Kindern eine ausreichende Bildung mit auf den Weg zu geben.“"
                            },
                            {
                                "example_id": "af842086-10af-445c-82f4-91f9e0dbf656",
                                "sense_id": "2f9c7cf2-423b-3818-aab5-87fe8377f57e",
                                "text": "„Du erwartest nichts zurück, tust es nicht aufgrund eines Nutzens für dich, sondern du gibst einfach, weil es dir ein Herzensbedürfnis ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
