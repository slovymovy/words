                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d35b397-66e6-4363-b0e6-f610d9115546",
                                "sense_id": "9a677e95-e6ba-3c06-81b9-9f6db507d830",
                                "text": "Aardig is de scène waarbij een grote kozak aan juffrouw Rosine en haar man een inkwartieringsbiljet vertoont (…)"
                            },
                            {
                                "example_id": "3de53b80-c64c-4ce8-b94f-10f8de26b9bd",
                                "sense_id": "9a677e95-e6ba-3c06-81b9-9f6db507d830",
                                "text": "De Russische prins Narischkin naderde met 2000 kozakken Utrecht, en noopte generaal Molitor de stad aan hem over te geven."
                            }
                        ]
                    }
                ],
