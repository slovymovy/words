                                                "sense_id": "2e9d7aa3-0831-3c88-b33a-81fa86015bc7",
                                                "text": "Un absolutiste."
                                            },
                                            {
                                                "example_id": "42ad4762-0672-4271-b41c-b787f73fb4f7",
                                                "sense_id": "2e9d7aa3-0831-3c88-b33a-81fa86015bc7",
                                                "text": "Les absolutistes l’ont emporté dans telle circonstance."
                                            },
                                            {
                                                "example_id": "c6dbf9b2-7e5e-4913-b7f7-fa9de3c4e5eb",
                                                "sense_id": "2e9d7aa3-0831-3c88-b33a-81fa86015bc7",
                                                "text": "Houphouët-Boigny, par tempérament, par sa formation religieuse, par sa position de notable, est loin d’être un absolutiste."
                                            }
                                        ]
