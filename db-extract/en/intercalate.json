                "senses": [
                    {
                        "sense_id": "1ca1e9d5-3a1a-3ee3-b3fe-25dcad8a9a9c",
                        "entry_id": "6adaacf3-4f46-3484-a6df-719a0108b4e0",
                        "glosses": [
                            "An atom or molecule, or a substance, that enters between the layers of the crystal lattice of another substance, especially that of graphite."
                        ],
                        "tags": [
                            "attributive",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "e6561afe-67cc-46ed-9caf-54762f63f4fa",
                                "sense_id": "1ca1e9d5-3a1a-3ee3-b3fe-25dcad8a9a9c",
                                "text": "Entry of intercalate molecules from the edge of basal planes of crystallites must be kept sufficiently slow to mitigate mechanical strains..before the intercalate has spread uniformly through any layer."
                            }
                        ]
                    },
                    {
                        "sense_id": "63ab069a-ac60-31c0-8b0d-81f1e949c340",
                        "entry_id": "6adaacf3-4f46-3484-a6df-719a0108b4e0",
                        "glosses": [
                            "A compound formed by foreign atoms or molecules entering between the layers of a crystal lattice, especially that of graphite."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
