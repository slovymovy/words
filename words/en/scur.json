                {
                    "sense_id": "67a32583-8b8b-3d22-b143-082942bcbdc5",
                    "sense_definition": "A loose, rudimentary horn that regrows or develops improperly after disbudding or dehorning in cattle, goats, or sheep.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer noticed a small <w>scur</w> forming on the young goat where the horn bud had been removed."
                        },
                        {
                            "text": "Unlike a fully developed horn, a <w>scur</w> is not tightly attached to the animal's skull."
