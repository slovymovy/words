                "senses": [
                    {
                        "sense_id": "4503eb19-ef46-36bd-b246-79a9effe4b72",
                        "entry_id": "6bc3f650-c641-3d13-8bcd-04d8d429a71c",
                        "glosses": [
                            "besonders empörender Missstand"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2ea76258-b86e-40e0-875d-df558e3865dc",
                                "sense_id": "4503eb19-ef46-36bd-b246-79a9effe4b72",
                                "text": "Hartz IV ist eine Affenschande."
                            },
                            {
                                "example_id": "71674b58-25ad-4a16-9da6-38ab97c89ef0",
                                "sense_id": "4503eb19-ef46-36bd-b246-79a9effe4b72",
                                "text": "„Da erwiderte ich im breitesten Cockney, jenem Londoner Vorstadtdialekt: ‚Is es nich 'ne Affenschande, daß sogar Taubstumme zur Armee eingezogen werden?‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32d6b271-4710-4c95-8801-9e8cb9887a1f",
                        "source_entry_id": "6bc3f650-c641-3d13-8bcd-04d8d429a71c",
                        "source_sense_id": "4503eb19-ef46-36bd-b246-79a9effe4b72",
                        "source_sense_description": "umgangssprachlich: besonders empörender Missstand",
                        "target_lang_word": "позор",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "позор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d203867d-b637-3d54-80a2-81e1c902f639",
                                        "entry_id": "46ae38e5-e629-373c-b4f3-f752ce51448e",
                                        "glosses": [
                                            "постыдное, унизительное для кого-либо положение, вызывающее презрение; бесчестие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a868513a-b445-4409-a518-2e7683ae966d",
                                                "sense_id": "d203867d-b637-3d54-80a2-81e1c902f639",
                                                "text": "Не вынесла душа поэта // Позора мелочных обид."
                                            },
                                            {
                                                "example_id": "df8960d4-d65d-4197-9dbc-d091eff80e18",
                                                "sense_id": "d203867d-b637-3d54-80a2-81e1c902f639",
                                                "text": "Это было огромным ударом и величайшим позором для революционного правительства…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3d2a4b5-c6cd-313a-8c89-fe538b55cfed",
                                        "entry_id": "46ae38e5-e629-373c-b4f3-f752ce51448e",
                                        "glosses": [
                                            "перен. что-либо неудачное, плохо сделанное (или существующее), позорящее кого-либо, вызывающее чувство стыда или насмешку, презрение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c0fc9c3-60fb-4e08-a271-dd30a8231ea8",
                                                "sense_id": "b3d2a4b5-c6cd-313a-8c89-fe538b55cfed",
                                                "text": "Городничий. Две недели! (В сторону.) Батюшки, сватушки! Выносите, святые угодники! В эти две недели высечена унтер-офицерская жена! Арестантам не выдавали провизии! На улицах кабак, нечистота! Позор! Поношенье! (Хватается за голову.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d3e4fd6-e364-36a3-9c8a-78d9e0c22615",
                                        "entry_id": "46ae38e5-e629-373c-b4f3-f752ce51448e",
                                        "glosses": [
                                            "устар. вид, зрелище"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "629aee14-d7c6-43bf-86a4-2eacc138d275",
                                                "sense_id": "8d3e4fd6-e364-36a3-9c8a-78d9e0c22615",
                                                "text": "Благодарю, что вновь чудес, красот позор // Открыл мне в жизни толь блаженной."
                                            },
                                            {
                                                "example_id": "a2fab6d2-4faf-4544-a01f-ecdc4f0db35c",
                                                "sense_id": "8d3e4fd6-e364-36a3-9c8a-78d9e0c22615",
                                                "text": "Величествен и грустен был позор // Пустынных вод, лесов, долин и гор."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
