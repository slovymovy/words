                "senses": [
                    {
                        "sense_id": "18b2c2ff-a819-3720-973e-54ec0af1bea5",
                        "entry_id": "22cbc59a-2c1f-30ff-8951-5eaf756f92e0",
                        "glosses": [
                            "öffentliches Verzeichnis, das Eintragungen über die angemeldeten Kaufleute im Bezirk des zuständigen Registergerichts führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb8e697a-d2e4-4568-914c-a81e95a0128d",
                                "sense_id": "18b2c2ff-a819-3720-973e-54ec0af1bea5",
                                "text": "Die Kosten der Eintragung in das Handelsregister richten sich nach Rechtsform und Unternehmensgröße."
                            },
                            {
                                "example_id": "4bd81e4d-d9f5-4ab7-a47e-d7ca88178f24",
                                "sense_id": "18b2c2ff-a819-3720-973e-54ec0af1bea5",
                                "text": "Sie erhalten eine Handelsregisternummer nach Eintragung in das Handelsregister."
                            },
                            {
                                "example_id": "bdc2424d-e9b2-4b6e-99c3-732c3499ed11",
                                "sense_id": "18b2c2ff-a819-3720-973e-54ec0af1bea5",
                                "text": "Die Müller GmbH wurde wegen Vermögenslosigkeit im Handelsregister gelöscht."
                            },
                            {
                                "example_id": "43e05753-5751-4bad-a9da-78b4c3c46784",
                                "sense_id": "18b2c2ff-a819-3720-973e-54ec0af1bea5",
                                "text": "Obwohl ich in den Handelsregistern mehrerer Staaten gesucht habe, konnte ich die Firma, die mir den Gebrauchtwagen mit dem Motorschaden angedreht hatte, nirgends finden."
                            }
                        ],
