    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2c7576ca-556c-3ac7-b398-76a6e5ba9684",
                    "sense_definition": "A person who is used by another person for their own benefit or profit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "subordinate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician treated his assistant like a mere <w>stooge</w> to take the blame for his mistakes."
                        },
                        {
                            "text": "He realized he was just a <w>stooge</w> for the company and quit his job immediately."
                        }
                    ],
                    "synonyms": [
                        "lackey",
                        "minion",
                        "puppet"
                    ]
                },
                {
                    "sense_id": "617f7b97-2f5f-3e68-a548-f0f9876c960c",
                    "sense_definition": "A person who secretly provides information to the police.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "informant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gang members suspected that one of them was a police <w>stooge</w>."
                        },
                        {
                            "text": "He was labeled a <w>stooge</w> after the authorities raided the hideout."
                        }
                    ],
                    "synonyms": [
                        "informant",
                        "snitch"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often used in criminal or informal contexts."
                        }
                    ]
                },
                {
                    "sense_id": "f0966951-a719-3ae5-b1ba-84c2d022edd7",
                    "sense_definition": "A person who secretly works for a researcher to assist in an experiment without the participant knowing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "confederate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The experiment included a <w>stooge</w> who acted as another participant to influence the results."
                        },
                        {
                            "text": "Participants were unaware that the person sitting next to them was actually a <w>stooge</w>."
                        }
                    ],
                    "synonyms": [
                        "confederate"
                    ]
                },
                {
                    "sense_id": "3aef4bdd-9da7-36d7-95fd-8d4e4ab27b6d",
                    "sense_definition": "A performer who acts as a straight man in a comedy routine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "performer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent years working as a <w>stooge</w> for the famous comedian."
                        },
                        {
                            "text": "The role of the <w>stooge</w> is to set up the jokes for the funny man."
                        }
                    ]
                },
                {
                    "sense_id": "d65a7841-9b1a-335b-afe9-42a8b89ea37f",
                    "sense_definition": "A magician's assistant who pretends to be a member of the audience.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "performer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician used a <w>stooge</w> in the crowd to help with the card trick."
                        },
                        {
                            "text": "The audience did not realize the volunteer was actually a <w>stooge</w>."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a2177957-e316-3c68-ac89-39f473b2bbdc",
                    "sense_definition": "To perform the role of a straight man in a comedy act.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "performer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>stooge</w> for his partner during their new comedy show."
                        },
                        {
                            "text": "It is difficult to <w>stooge</w> effectively without good timing."
                        }
                    ]
                }
            ]
        }
    ]
