                                        "sense_id": "cab46dcc-caad-3608-a372-a1f833a8f4cc",
                                        "entry_id": "4ea2201c-0d50-3cbf-a88a-cfe552b2650d",
                                        "glosses": [
                                            "weibliche Person, die etwas referiert, ein Referat hält"
