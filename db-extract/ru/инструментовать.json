                                        "sense_id": "7d0524b1-3333-3c63-87c4-aa32a7eb1b31",
                                        "entry_id": "d992c8ca-7bd1-37c6-8106-9705f2923a05",
                                        "glosses": [
                                            "Faire des contrats, des procès-verbaux, des exploits et d’autres actes publics."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a94b181f-9928-4151-98e9-bab8a7779a51",
                                                "sense_id": "7d0524b1-3333-3c63-87c4-aa32a7eb1b31",
                                                "text": "Les notaires ne peuvent pas instrumenter hors de leur ressort."
                                            },
                                            {
                                                "example_id": "b80b89c5-d999-4cf8-b8fe-e43006201414",
                                                "sense_id": "7d0524b1-3333-3c63-87c4-aa32a7eb1b31",
                                                "text": "Convoquer un huissier pour instrumenter."
                                            },
                                            {
                                                "example_id": "5c35c57d-1442-4a39-ab03-f31de1e6c9e2",
                                                "sense_id": "7d0524b1-3333-3c63-87c4-aa32a7eb1b31",
                                                "text": "Bridois, très digne, retirant son chapeau et montrant son écharpe qu’il a tirée pliée de sa poche. — Si le magistrat instrumente… (Saluant par petites saccades) l’homme du monde s’excuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6443877-2f24-3d3d-834a-c97197f68bee",
                                        "entry_id": "d992c8ca-7bd1-37c6-8106-9705f2923a05",
                                        "glosses": [
                                            "Orchestrer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c4a2191-3930-38c3-9993-70c2a1008494",
                                        "entry_id": "d992c8ca-7bd1-37c6-8106-9705f2923a05",
                                        "glosses": [
                                            "Poser des instruments sur un appareil, pour en déterminer la résistance, les capacités industrielles, la performance, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa73b3e8-62fc-3d18-bdd0-945fd8157742",
                                        "entry_id": "d992c8ca-7bd1-37c6-8106-9705f2923a05",
                                        "glosses": [
                                            "Utiliser comme instrument, détourner quelque chose de son orientation originale pour l'utiliser à son profit ou considérer quelqu'un comme un simple instrument sous son angle utilitaire."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e103ddc2-04d2-4f33-b3fc-cc5c5f0f28ee",
                                                "sense_id": "fa73b3e8-62fc-3d18-bdd0-945fd8157742",
                                                "text": "Les deux choses sont vraies: et que le terrorisme est une vraie menace pour nos sociétés, et que cette menace est très largement instrumentée à des fins n’ayant, en règle générale, rien à voir avec la lutte contre le terrorisme (l’instauration de l’État total, entre autres)."
                                            }
                                        ]
                                    }
                                ]
                            }
