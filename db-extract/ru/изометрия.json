                                            {
                                                "example_id": "e19630c5-d094-43ac-922c-b665ff837c5a",
                                                "sense_id": "e7782e85-650c-3818-adcc-aa79693ff64c",
                                                "text": "Isometry is to metric spaces what isomorphism is to groups."
