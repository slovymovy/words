                                    {
                                        "sense_id": "271250f7-7cd2-3edb-a5ce-c9d477c6df96",
                                        "entry_id": "4a9242f0-3177-3a22-84a8-7235ec4de341",
                                        "glosses": [
                                            "To change greatly the appearance or form of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28ff7f49-ff49-4b67-96d5-44f58e0b06a4",
                                                "sense_id": "271250f7-7cd2-3edb-a5ce-c9d477c6df96",
                                                "text": "The alchemists sought to transform lead into gold."
                                            },
                                            {
                                                "example_id": "211ebece-4379-44ca-9522-c00867c8ff52",
                                                "sense_id": "271250f7-7cd2-3edb-a5ce-c9d477c6df96",
                                                "text": "Love may transform me to an oyster."
                                            },
                                            {
                                                "example_id": "45769a97-668a-45d0-91b8-c1acadf1217f",
                                                "sense_id": "271250f7-7cd2-3edb-a5ce-c9d477c6df96",
                                                "text": "Creating a complete map of the human connectome would therefore be a monumental milestone but not the end of the journey to understanding how our brains work. The achievement will transform neuroscience and serve as the starting point for asking questions we could not otherwise have answered, […]."
                                            },
                                            {
                                                "example_id": "4719fde8-67f4-43a2-95bc-dbe652230aba",
                                                "sense_id": "271250f7-7cd2-3edb-a5ce-c9d477c6df96",
                                                "text": "Among its findings, the report says: \"In recent years we have seen more stations transformed from run-down Victorian hulks, or spartan bus-sheltered platforms, into places that people can take pride in, feel comfortable in using, and which are fulfilling more of their wider potential."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27bff6e1-353c-308d-b37c-533ea3c448d0",
                                        "entry_id": "4a9242f0-3177-3a22-84a8-7235ec4de341",
                                        "glosses": [
                                            "To change the nature, condition or function of; to change in nature, disposition, heart, character, etc.; to convert."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65359116-441b-45bd-9f1e-7ec97ad99071",
                                                "sense_id": "27bff6e1-353c-308d-b37c-533ea3c448d0",
                                                "text": "Be ye transformed by the renewing of your mind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90249d61-3fac-3fa3-9895-0746d6a07b0e",
                                        "entry_id": "4a9242f0-3177-3a22-84a8-7235ec4de341",
                                        "glosses": [
                                            "To subject to a transformation; to change into another form without altering the value."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f628715e-d77b-3340-82f8-6f7a70d90ddb",
