                "senses": [
                    {
                        "sense_id": "7ead8c83-9c17-3e93-90bf-dea730f69f8f",
                        "entry_id": "e754bd92-2544-3995-9151-322627e04ea6",
                        "glosses": [
                            "das Beseitigen/Neutralisieren von wahrnehmbaren Gerüchen in der Luft"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "4b86e12e-bef0-4997-ad6f-9580e9f401f2",
                                "sense_id": "7ead8c83-9c17-3e93-90bf-dea730f69f8f",
                                "text": "Die Geruchsneutralisierung wird in der Natur hauptsächlich durch das Sonnenlicht und aktive Sauerstoffionen erreicht."
                            },
                            {
                                "example_id": "17460754-f8c6-4318-b45b-bd91031c4a98",
                                "sense_id": "7ead8c83-9c17-3e93-90bf-dea730f69f8f",
                                "text": "Die Geruchsneutralisierung wird zum Beispiel durch den Einbau von Aktivkohlefiltern in der Lüftungstechnik erreicht."
                            },
                            {
                                "example_id": "0e1b89c7-e915-40ef-b952-a8a85d2bf489",
                                "sense_id": "7ead8c83-9c17-3e93-90bf-dea730f69f8f",
                                "text": "Weitere technische Beispiele zur Geruchsneutralisierung sind der Einsatz eines Biofilters, Ozongenerators, einer Ionisationsröhre und so weiter."
                            },
                            {
                                "example_id": "fdeaa859-cdea-432d-8a2b-3c411aec4d88",
                                "sense_id": "7ead8c83-9c17-3e93-90bf-dea730f69f8f",
                                "text": "„Die vorliegende Erfindung bezieht sich auf eine Zusammensetzung zur Neutralisierung von Gerüchen, insbesondere von Gerüchen biologischen Ursprungs, die von Geruchsbildnern abgegeben werden. Zur Geruchsneutralisierung wird die erfindungsgemäße Zusammensetzung auf die Geruchsbildner aufgebracht, beispielsweise aufgesprüht, aufgegossen oder durch Wischen aufgetragen.“"
                            },
                            {
                                "example_id": "e9d4aeae-8476-4861-a4e6-108a4fde8e52",
                                "sense_id": "7ead8c83-9c17-3e93-90bf-dea730f69f8f",
                                "text": "„Es schließt sich die Reaktionsstrecke an, in der die gewünschte Aufoxidierung und/oder Geruchsneutralisierung noch vorhandener gasförmiger Bestandteile in der zu reinigenden Luft erfolgt.“"
                            },
                            {
                                "example_id": "8031a5f1-a6f6-43c8-b2a2-fa92f2a8c7c2",
                                "sense_id": "7ead8c83-9c17-3e93-90bf-dea730f69f8f",
                                "text": "„Der Wirkungsgrad der Geruchsneutralisierung in dem jeweiligen Raum ist durch weitere geeignete Maßnahmen positiv beeinflussbar, indem man die katalytisch wirkende Oberfläche nahe zu der Geruchsquelle bringt bzw. man ordnet die katalytisch wirkenden Oberflächen dort an, wo eine starke Luftströmung vorhanden ist“"
                            },
                            {
                                "example_id": "9c968696-e4fb-4153-a2d0-ea4ffbae8f84",
                                "sense_id": "7ead8c83-9c17-3e93-90bf-dea730f69f8f",
                                "text": "„Die Besonderheit der patentierten Produkte zur Geruchsneutralisierung basiert auf chemischen und chemisch/physikalischen Reaktionen.“"
                            },
                            {
                                "example_id": "94bcbecf-bea1-41dd-b6b1-69de64aefc38",
                                "sense_id": "7ead8c83-9c17-3e93-90bf-dea730f69f8f",
                                "text": "„Nach Besichtigung des Objekts und anschließender Beratung durch unser Fachpersonal empfehlen wir Ihnen die geeigneten Verfahren zur Geruchsneutralisierung an, die eine schnelle Wiederbenutzung und Bewohnbarkeit der Räume gewährleisten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
