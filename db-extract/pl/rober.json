                                                "sense_id": "b5b2af33-bf7b-37a5-968d-e6e1e5be5e07",
                                                "text": "Jones toes the rubber and then fires to the plate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a72f70a9-e06a-378f-8184-ce0cf9fa4920",
                                        "entry_id": "bee1068d-1dee-3df4-96e9-a1e925c69f69",
                                        "glosses": [
                                            "Water-resistant shoe covers, galoshes, overshoes."
                                        ],
                                        "tags": [
