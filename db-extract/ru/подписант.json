                            {
                                "example_id": "807bdc81-ec3a-4a3a-87d1-2e590f607a85",
                                "sense_id": "fc5e40a2-f4f8-370b-a81b-8e105f514d39",
                                "text": "Удиви́тельно, но по иро́нии судьбы́ льви́ная до́ля из подписа́нтов са́ми рабо́тают тре́нерами.",
                                "translation": "Sovetsky Sport",
                                "english": "Sovetsky Sport"
                            },
                            {
                                "example_id": "ccceb696-b0d3-45ce-817e-4e95128358f8",
                                "sense_id": "fc5e40a2-f4f8-370b-a81b-8e105f514d39",
                                "text": "В опублико́ванном в понеде́льник откры́том письме́ почти́ 300 подписа́нтов обвини́ли руково́дство аге́нтства в потака́нии «разруши́тельным ата́кам» со стороны́ президе́нта США До́нальда Тра́мпа.",
                                "translation": "Kommersant",
                                "english": "Kommersant"
                            }
                        ]
                    }
                ],
