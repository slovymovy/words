        "fr-extract.jsonl": [
            {
                "entry_id": "11ee58e8-1314-3292-ba3c-8dccf37310fc",
                "word": "dissipation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6d00a63b-dfbf-45bf-ac74-0192dbf44ac1",
                        "entry_id": "11ee58e8-1314-3292-ba3c-8dccf37310fc",
                        "tags": [
                            "plural"
                        ],
                        "form": "dissipations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "522fc3ef-0d37-3dc4-8606-19f692a9cb76",
                        "entry_id": "11ee58e8-1314-3292-ba3c-8dccf37310fc",
                        "glosses": [
                            "Action par laquelle une chose est dissipée ou se dissipe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "927035d2-158a-4083-ae89-b7279b035096",
                                "sense_id": "522fc3ef-0d37-3dc4-8606-19f692a9cb76",
                                "text": "Dissipation de la chaleur."
                            },
                            {
                                "example_id": "a083df1e-0ab9-47c8-81bc-8600a7d948f8",
                                "sense_id": "522fc3ef-0d37-3dc4-8606-19f692a9cb76",
                                "text": "Un monde est une enveloppe du ciel, qui enveloppe astres, terre et tout ce qui apparaît, qui s’est scindée de l’illimité, et qui se termine par une limite ou rare ou dense, dont la dissipation bouleversera tout ce qu’elle contient ; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "3067f965-5a40-3441-a526-41d649c90c77",
                        "entry_id": "11ee58e8-1314-3292-ba3c-8dccf37310fc",
                        "glosses": [
                            "Action de consumer un bien par de grandes dépenses ; ces dépenses elles-mêmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7283c097-8418-4875-b617-2c6da146e274",
                                "sense_id": "3067f965-5a40-3441-a526-41d649c90c77",
                                "text": "Cette femme […] avait un goût décidé pour la dissipation et l’amusement : très bornée dans ses dépenses, elle ne pouvait se procurer les plaisirs dont elle était avide, ni consentir à s’en priver."
                            },
                            {
                                "example_id": "cdca15fe-19df-44c3-b454-377a3b71e990",
                                "sense_id": "3067f965-5a40-3441-a526-41d649c90c77",
                                "text": "Les dissipations du règne de Louis XV, les orgies de ce temps égoïste et funeste ont produit la génération étiolée chez laquelle les manières seules survivent aux grandes qualités évanouies."
                            },
                            {
                                "example_id": "a92ba1db-3dc0-4650-ac71-74b892d7f957",
                                "sense_id": "3067f965-5a40-3441-a526-41d649c90c77",
                                "text": "Maxime Dethomas et moi, peu enclins aux spiritueux, nous arrangions pour dissimuler nos verres non vidés ou en jeter, comme à l’Ambigu, le contenu sur nos bottes. Cette manœuvre n’échappait pas à Curne. Il murmurait : « C’est de la dissipation… »"
                            }
                        ]
                    },
                    {
                        "sense_id": "99016485-6f08-3d94-bd95-6947ee769702",
                        "entry_id": "11ee58e8-1314-3292-ba3c-8dccf37310fc",
                        "glosses": [
                            "État d’une personne dissipée, d’une personne qui vit au milieu des plaisirs, qui se laisse distraire de son travail, de ses occupations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "809d5bce-bb7b-44fc-a7cb-824e50229c14",
                                "sense_id": "99016485-6f08-3d94-bd95-6947ee769702",
                                "text": "La pauvre Marie abomina la dissipation de cette vie qui ne lui permettait plus d’être seule avec son Dieu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4bca8fa-7981-432b-8ff4-3430379efe0c",
                        "source_entry_id": "11ee58e8-1314-3292-ba3c-8dccf37310fc",
                        "target_lang_word": "dissipation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dissipation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52968849-0640-3ff9-980d-53b30a946613",
                                        "entry_id": "b3a905aa-df56-3e90-9abc-706d765e5d70",
                                        "glosses": [
                                            "The act of dissipating or dispersing; a state of dispersion or separation; dispersion; waste."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dbc114e-9ed6-49bc-8853-79d8505a95a5",
                                                "sense_id": "52968849-0640-3ff9-980d-53b30a946613",
                                                "text": "without loss or dissipation of the matter"
                                            },
                                            {
                                                "example_id": "de48f708-9e2d-41ea-a3a4-dc14d6d7d87f",
                                                "sense_id": "52968849-0640-3ff9-980d-53b30a946613",
                                                "text": "the famous dissipation of mankind"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce815612-8b28-31aa-aafc-78ecc1b96fee",
                                        "entry_id": "b3a905aa-df56-3e90-9abc-706d765e5d70",
                                        "glosses": [
                                            "A dissolute course of life, in which health, money, etc., are squandered in pursuit of pleasure; profuseness in immoral indulgence, as late hours, riotous living, etc.; dissoluteness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26a876d9-443d-4825-bdfa-ca38c989b904",
                                                "sense_id": "ce815612-8b28-31aa-aafc-78ecc1b96fee",
                                                "text": "I rose by candle-light, and consumed, in the intensest application, the hours which every other individual of our party wasted in enervating slumbers, from the hesternal dissipation or debauch."
                                            },
                                            {
                                                "example_id": "d7969a78-bbce-4ba4-bc0a-9a4918c5b4e2",
                                                "sense_id": "ce815612-8b28-31aa-aafc-78ecc1b96fee",
                                                "text": "18th century, Patrick Henry in a parliamentary debate\nto reclaim the spendthrift from his dissipation and extravagance"
                                            },
                                            {
                                                "example_id": "afd9e845-b855-456b-b938-5a11377a3b7b",
                                                "sense_id": "ce815612-8b28-31aa-aafc-78ecc1b96fee",
                                                "text": "He neither wept nor prayed; he cursed and defied: execrated God and man, and gave himself up to reckless dissipation."
                                            },
                                            {
                                                "example_id": "afbfd431-0a95-4e8d-a57e-d4d99e06a874",
                                                "sense_id": "ce815612-8b28-31aa-aafc-78ecc1b96fee",
                                                "text": "[...] This is a surprise attack, and I’d no wish that the garrison, forewarned, should escape. I am sure, Lord Stranleigh, that he has been descanting on the distraction of the woods and the camp, or perhaps the metropolitan dissipation of Philadelphia, [...]"
                                            },
                                            {
                                                "example_id": "35d83343-a0d5-46df-b681-a021a0880eb4",
                                                "sense_id": "ce815612-8b28-31aa-aafc-78ecc1b96fee",
                                                "text": "An oil lamp burned upon a high, old-fashioned mantel, casting its dim rays over a dozen repulsive figures. All but one were men. The other was a woman of about thirty. Her face, marked by low passions and dissipation, might once have been lovely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cb8b25f-c5d6-3fcc-81f7-9b7f1c9c3f71",
                                        "entry_id": "b3a905aa-df56-3e90-9abc-706d765e5d70",
                                        "glosses": [
                                            "A trifle which wastes time or distracts attention."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "558ed572-5a17-4015-8fc6-3dd32f64ed9f",
                                                "sense_id": "8cb8b25f-c5d6-3fcc-81f7-9b7f1c9c3f71",
                                                "text": "Prevented from finishing them [the letters] a thousand avocations and dissipations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d768e36f-f3be-3289-b0e5-9a20fabe2c15",
                                        "entry_id": "b3a905aa-df56-3e90-9abc-706d765e5d70",
                                        "glosses": [
                                            "A loss of energy, usually as heat, from a dynamic system."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a063118-fdca-4f7d-bf2d-dcfbb7167ad3",
                                                "sense_id": "d768e36f-f3be-3289-b0e5-9a20fabe2c15",
                                                "text": "They conclude[…] the planet will have a final period of rotation between 56 and 88 days, depending on the assumed form of the dissipation function."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
