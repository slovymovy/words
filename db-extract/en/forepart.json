                "senses": [
                    {
                        "sense_id": "43b8ab41-496b-3ab4-bf11-e6137e55b640",
                        "entry_id": "7c87b822-dfc1-3611-ac8d-e43ef9005cc5",
                        "glosses": [
                            "The front or anterior part of something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "269566d2-1658-4a31-9497-661929c233da",
                                "sense_id": "43b8ab41-496b-3ab4-bf11-e6137e55b640",
                                "text": "The wing being suppos'd placed in the upmost limit, seems to be put so that the plain of it lies almost horizontal, but onely the forepart does dip a little, or is somewhat more deprest […]."
                            },
                            {
                                "example_id": "03cc2fc7-f43c-4a91-a0b3-2bb5219bfccb",
                                "sense_id": "43b8ab41-496b-3ab4-bf11-e6137e55b640",
                                "text": "I became aware that the two were standing on the shore alongside the forepart of the steamboat, just below my head."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14622d10-de04-4500-864d-e46406828bde",
                        "source_entry_id": "7c87b822-dfc1-3611-ac8d-e43ef9005cc5",
