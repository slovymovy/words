                                    {
                                        "sense_id": "fdda839b-2c65-3b9f-9895-23ea8d33bc61",
                                        "entry_id": "a0f9774f-139a-3c2b-9710-7d98c12a750c",
                                        "glosses": [
                                            "A small, slender knife or dagger-like weapon intended for stabbing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b2abd5a-e7e0-4b5b-833f-165d88c8cdbb",
                                                "sense_id": "fdda839b-2c65-3b9f-9895-23ea8d33bc61",
                                                "text": "There the cause of death was soon ascertained; the victim of this daring outrage had been stabbed to death from ear to ear with a long, sharp instrument, in shape like an antique stiletto, which, I may tell you, was subsequently found under the cushions of the hansom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f137eea8-4960-3280-b28b-90e392ed3fa5",
                                        "entry_id": "a0f9774f-139a-3c2b-9710-7d98c12a750c",
                                        "glosses": [
                                            "A rapier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00bdfabc-fc12-351c-a757-ffb25d8df16b",
                                        "entry_id": "a0f9774f-139a-3c2b-9710-7d98c12a750c",
                                        "glosses": [
                                            "An awl."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df672dd5-56df-3cef-be7e-f4768919f214",
                                        "entry_id": "a0f9774f-139a-3c2b-9710-7d98c12a750c",
                                        "glosses": [
                                            "A woman's shoe with a tall, slender heel (called a stiletto heel)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd41dbd4-143b-3529-9e5b-220ee313f873",
                                        "entry_id": "a0f9774f-139a-3c2b-9710-7d98c12a750c",
                                        "glosses": [
                                            "A beard trimmed into a pointed form."
                                        ],
                                        "tags": [
                                            "historical",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efa55d2c-4166-472a-9e60-073b8cba52a4",
                                                "sense_id": "dd41dbd4-143b-3529-9e5b-220ee313f873",
                                                "text": "The very quaik of faſhions, the very hee that / VVeares a Steletto on his chinne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stiletto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb69d226-2cd4-37f3-acab-57ac5c59d1b6",
                                        "entry_id": "91b8a9f2-aa87-3a7a-93d8-01904399cf4a",
                                        "glosses": [
                                            "To attack or kill with a stiletto (dagger)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff8c9221-a653-4c8e-9735-8eddaf365fa1",
                                                "sense_id": "fb69d226-2cd4-37f3-acab-57ac5c59d1b6",
                                                "text": "The recollection of former atrocities by the populace in plundering the city and stilettoing the inhabitants, is sufficiently fresh in the remembrance of the government to serve as an additional stimulus to prevent similar disorders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec5ef9ed-3045-4482-a238-8be39c0ad8cc",
                        "source_entry_id": "08e405ff-007c-3b5e-835a-ac148dd780aa",
                        "source_sense_description": "Instrument d’écriture",
                        "target_lang_word": "stylus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stylus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a21f830b-c122-323b-ba96-1b9066838bde",
                                        "entry_id": "b9efaba6-30ac-34d9-a7fd-7a23eab726e3",
                                        "glosses": [
                                            "An ancient writing implement consisting of a small rod with a pointed end for scratching letters on clay, wax-covered tablets or other surfaces, and a blunt end for obliterating them."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbbc0aba-27dd-418c-9640-e73e901a9d5c",
                                                "sense_id": "a21f830b-c122-323b-ba96-1b9066838bde",
                                                "text": "[T]he pleasure of writing on wax with a stylus is exemplified by the fine, flowing hand of a Roman scribe who made out the birth certificate of Herennia Gemella, born March 128 AD."
                                            },
                                            {
                                                "example_id": "26ee995c-6397-4dae-9429-f64d3ba6c87e",
                                                "sense_id": "a21f830b-c122-323b-ba96-1b9066838bde",
                                                "text": "But that tactic may have older roots than we thought; archaeologists have discovered an iron stylus in London, complete with an inscribed joke, that dates back nearly 2,000 years.\nOf 200 styluses found at a site under Bloomberg’s new European headquarters, only one – dating back to around 70 A.D. – had a message inscribed onto it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20fbd45b-62ad-359c-b1ff-381146b6a4e6",
                                        "entry_id": "b9efaba6-30ac-34d9-a7fd-7a23eab726e3",
                                        "glosses": [
                                            "An ancient writing implement consisting of a small rod with a pointed end for scratching letters on clay, wax-covered tablets or other surfaces, and a blunt end for obliterating them.",
                                            "A small implement with a pointed end used for engraving and tracing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f2e495d1-b8d7-336b-a80e-3873402be729",
                                        "entry_id": "b9efaba6-30ac-34d9-a7fd-7a23eab726e3",
                                        "glosses": [
                                            "An ancient writing implement consisting of a small rod with a pointed end for scratching letters on clay, wax-covered tablets or other surfaces, and a blunt end for obliterating them.",
                                            "A small device resembling a pen used to input handwritten text or drawings directly into an electronic device with a touch-sensitive screen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a3d59d0-b688-4b22-9ca7-5d31b48da50b",
                                                "sense_id": "f2e495d1-b8d7-336b-a80e-3873402be729",
                                                "text": "It’s the cheapest stylus Apple’s released yet, but you’ll need a USB-C iPad to use it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26420271-051d-3b18-8e68-2c08b9d5dff0",
                                        "entry_id": "b9efaba6-30ac-34d9-a7fd-7a23eab726e3",
                                        "glosses": [
                                            "A hard-pointed pen-shaped instrument for marking on stencils used in a mimeograph machine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b9eddb3-a7f9-3f11-92cc-45ddb74d51d6",
                                        "entry_id": "b9efaba6-30ac-34d9-a7fd-7a23eab726e3",
                                        "glosses": [
                                            "A hard point, typically of diamond or sapphire, following a groove in a phonograph and transmitting the recorded sound for reproduction."
                                        ],
