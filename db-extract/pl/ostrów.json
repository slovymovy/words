                    }
                ],
                "senses": [
                    {
                        "sense_id": "0dfaefc9-c098-3603-8d51-13b1d2e94d4d",
                        "entry_id": "edc28c71-65d0-3ac8-973c-e67c9278e8da",
                        "glosses": [
                            "type of river island, with ground relatively high above the water level and usually covered with forest"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "a7b654d7-3a06-4229-8702-e217a6c61354",
                                "sense_id": "0dfaefc9-c098-3603-8d51-13b1d2e94d4d",
                                "text": "Książe Albrycht ... zanosi skargę na potężnego swego sąsiada księcia Janusza Ostrogskiego z sąsiednej Stepańszczyzny, o najechanie puszczy czyli ostrowu do Jabłonnego należącego...",
                                "translation": "Prince Albrycht ... submits a complaint against his powerful neighbor Prince Janusz Ostrogski, from the neighboring Stepań region, for invading a wild area, a river island, belonging to Jabłonny...",
                                "english": "Prince Albrycht ... submits a complaint against his powerful neighbor Prince Janusz Ostrogski, from the neighboring Stepań region, for invading a wild area, a river island, belonging to Jabłonny..."
                            },
                            {
                                "example_id": "a8c4e2e9-da44-4f1a-addd-8dda16e450f0",
                                "sense_id": "0dfaefc9-c098-3603-8d51-13b1d2e94d4d",
                                "text": "Żuk obudził się i nękany strachem wcisnął się jeszcze głębiej pod gęste choiny ostrowu.",
                                "translation": "The beetle woke up and, tormented by fear, pushed itself even deeper under the dense conifers of the river island.",
                                "english": "The beetle woke up and, tormented by fear, pushed itself even deeper under the dense conifers of the river island."
                            },
                            {
                                "example_id": "cb76d670-99e5-4220-8daa-fc9708025e5d",
                                "sense_id": "0dfaefc9-c098-3603-8d51-13b1d2e94d4d",
                                "text": "... stąd do dużej rzeki zw[anej] Stara Rzeka (Obra) i rzeką do ostrowa Wedroyn (w 1567 jako Wądroj); na ostrowie stoi kopiec narożny dzielący Przemęt i Solec...",
                                "translation": "... from here to the big river called the Old River (the Obra) and along the river up to the island of Wedroyn (in 1567 known as Wądroj); on the island stands a mound at a corner, which separates Przemęt and Solec...",
                                "english": "... from here to the big river called the Old River (the Obra) and along the river up to the island of Wedroyn (in 1567 known as Wądroj); on the island stands a mound at a corner, which separates Przemęt and Solec..."
                            }
                        ]
                    },
