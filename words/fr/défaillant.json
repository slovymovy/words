{
    "word_family": [
        "défaillance",
        "défaillir"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "312bc8f8-a27e-36f3-ac17-a30c066dbb38",
                    "sense_definition": "Qui ne fonctionne pas correctement, qui présente des pannes ou des défauts techniques.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le technicien a rapidement remplacé la pièce <w>défaillante</w> pour éviter une panne générale."
                        },
                        {
                            "text": "À cause d'un système <w>défaillant</w>, toutes les données informatiques ont été temporairement perdues."
                        }
                    ],
                    "synonyms": [
                        "défectueux"
                    ],
                    "antonyms": [
                        "opérationnel"
                    ],
                    "common_phrases": [
                        "système défaillant",
                        "matériel défaillant"
                    ]
                },
                {
                    "sense_id": "321c779f-72b6-340b-b3ab-508ec1e85e0c",
                    "sense_definition": "Qui s'affaiblit ou décline, en parlant des forces physiques, du corps ou de l'esprit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré une santé <w>défaillante</w>, le vieil homme continuait à marcher chaque matin dans le jardin."
                        },
                        {
                            "text": "Une mémoire <w>défaillante</w> lui causait souvent des difficultés pour retrouver ses affaires."
                        }
                    ],
                    "synonyms": [
                        "chancelant",
                        "vacillant"
                    ],
                    "antonyms": [
                        "vigoureux"
                    ],
                    "common_phrases": [
                        "santé défaillante",
                        "mémoire défaillante",
                        "cœur défaillant"
                    ]
                },
                {
                    "sense_id": "3c633033-1396-35eb-be2e-d7bb8c786833",
                    "sense_definition": "Qui ne respecte pas ses engagements financiers, légaux ou contractuels.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La banque a envoyé plusieurs rappels à l'emprunteur <w>défaillant</w> avant d'engager des poursuites."
                        },
                        {
                            "text": "Le propriétaire a résilié le bail en raison d'un locataire <w>défaillant</w> depuis plusieurs mois."
                        }
                    ],
                    "common_phrases": [
                        "emprunteur défaillant",
                        "locataire défaillant",
                        "débiteur défaillant"
                    ]
                },
                {
                    "sense_id": "2579719d-d1db-310c-a9c3-b661a2459daf",
                    "sense_definition": "Qui omet ou refuse de se présenter devant une juridiction après avoir été régulièrement convoqué.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge a ordonné le report de l'audience en raison d'un témoin <w>défaillant</w>."
                        },
                        {
                            "text": "La partie <w>défaillante</w> s'expose à une décision rendue en son absence par le tribunal."
                        }
                    ],
                    "antonyms": [
                        "comparant"
                    ],
                    "common_phrases": [
                        "témoin défaillant",
                        "partie défaillante"
                    ]
                },
                {
                    "sense_id": "99086bfe-52d5-3cf3-9589-1033fd37d6f2",
                    "sense_definition": "Qui n'utilise pas la réservation effectuée à son nom pour un transport ou un hébergement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La compagnie aérienne réattribue souvent les sièges des passagers <w>défaillants</w> aux personnes en attente."
                        },
                        {
                            "text": "L'établissement hôtelier facture la première nuitée pour tout client <w>défaillant</w> sans préavis."
