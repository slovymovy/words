{
    "word_family": [
        "water",
        "wateriness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "797fca65-65a4-328b-af97-14edc36c68d6",
                    "sense_definition": "Containing too much water, or diluted, thin, and lacking strength or flavor.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "liquid_properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soup was so <w>watery</w> that it tasted mostly like boiled vegetables in plain tap water.",
                            "target_lang_translations": {
                                "ru": "Суп был настолько <w>водянистым</w>, что на вкус напоминал обычные варёные овощи в воде из-под крана."
                            }
                        },
                        {
                            "text": "He complained that the café served weak, <w>watery</w> coffee instead of rich espresso.",
                            "target_lang_translations": {
                                "ru": "Он пожаловался, что в кафе подали слабый, <w>жидкий</w> кофе вместо насыщенного эспрессо."
                            }
                        }
                    ],
                    "synonyms": [
                        "wishy-washy",
                        "flavorless",
                        "insipid"
                    ],
                    "common_phrases": [
                        "watery soup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий слишком много воды, разбавленный, жидкий или ненасыщенный по вкусу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водянистый",
                                "target_lang_sense_clarification": "о пище, напитках: содержащий избыток воды"
                            },
                            {
                                "target_lang_word": "жидкий",
                                "target_lang_sense_clarification": "ненаваристый, разбавленный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e55d03c3-23df-3eef-b94f-40b78d6ca4e0",
                    "sense_definition": "Discharging fluid, tears, or thin liquid, often due to an allergy, illness, or irritation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I took my cat to the vet because I was worried about his <w>watery</w> eyes.",
                            "target_lang_translations": {
                                "ru": "Я отвёз кота к ветеринару, потому что беспокоился о его <w>слезящихся</w> глазах."
                            }
                        },
                        {
                            "text": "The pollen in the spring air gave her a runny nose and itchy, <w>watery</w> eyes.",
                            "target_lang_translations": {
                                "ru": "Из-за весенней пыльцы в воздухе у неё начался насморк, а глаза стали чесаться и <w>слезиться</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "watery eyes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выделяющий жидкость или слёзы из-за аллергии, болезни или раздражения (о глазах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слезящийся",
                                "target_lang_sense_clarification": "о глазах, слезоточивый"
                            },
                            {
                                "target_lang_word": "водянистый",
                                "target_lang_sense_clarification": "выделяющий влагу, жидкий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d9d2956-55f0-3005-9dfb-a5b3924a332e",
                    "sense_definition": "Filled, soaked, or covered with water; soggy or wet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid_properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the heavy storm, our boots sank into the <w>watery</w> mud of the garden.",
                            "target_lang_translations": {
                                "ru": "После сильного шторма наши сапоги увязали в <w>жидкой</w> грязи в саду."
                            }
                        },
                        {
                            "text": "Sailors feared they might eventually meet their end in a <w>watery</w> grave.",
                            "target_lang_translations": {
                                "ru": "Моряки боялись, что однажды найдут свой конец в <w>водной</w> могиле."
                            }
                        }
                    ],
                    "synonyms": [
                        "waterlogged",
                        "wet",
                        "drenched",
                        "moist"
                    ],
                    "common_phrases": [
                        "watery grave"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пропитанный, заполненный или покрытый водой; сырой или мокрый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водянистый",
                                "target_lang_sense_clarification": "жидкий, насыщенный влагой"
                            },
                            {
                                "target_lang_word": "водный",
                                "target_lang_sense_clarification": "состоящий из воды, связанный с водой (напр. водная могила)"
                            },
                            {
                                "target_lang_word": "мокрый",
                                "target_lang_sense_clarification": "сырой, пропитанный влагой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0d60831-cfd3-3124-91a1-7ba91d8602a3",
                    "sense_definition": "Pale, faint, and weak in appearance, suggestive of water or viewed through mist.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>watery</w> sun broke through the thick morning mist, providing little warmth.",
                            "target_lang_translations": {
                                "ru": "<w>Тусклое</w> солнце пробилось сквозь густой утренний туман, почти не давая тепла."
                            }
                        },
                        {
                            "text": "She offered only a faint, <w>watery</w> smile before looking away silently.",
                            "target_lang_translations": {
                                "ru": "Она лишь слабо, <w>бледно</w> улыбнулась и молча отвела взгляд."
                            }
                        }
                    ],
                    "common_phrases": [
                        "watery sunlight",
                        "watery smile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бледный, тусклый или слабый на вид; словно пробивающийся сквозь дымку или воду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тусклый",
                                "target_lang_sense_clarification": "о свете, солнце: бледный, неяркий"
                            },
                            {
                                "target_lang_word": "бледный",
                                "target_lang_sense_clarification": "слабый, невыразительный"
                            },
                            {
                                "target_lang_word": "водянистый",
                                "target_lang_sense_clarification": "о цвете, улыбке: невыразительный, блёклый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "559fc9f1-ed4a-3c38-8e79-8b2745604143",
                    "sense_definition": "Resembling, consisting of, or characteristic of water.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "liquid_properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sound effects gave a very convincing, <w>watery</w> noise to the stage production.",
                            "target_lang_translations": {
                                "ru": "Звуковые эффекты добавили спектаклю очень убедительный <w>плеск воды</w>."
                            }
                        },
                        {
                            "text": "Fish and amphibians thrive in this lush, <w>watery</w> habitat.",
                            "target_lang_translations": {
                                "ru": "Рыбы и земноводные прекрасно себя чувствуют в этой богатой <w>водной</w> среде обитания."
                            }
                        }
                    ],
                    "synonyms": [
                        "aqueous",
                        "waterish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напоминающий воду, состоящий из неё или характерный для воды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водный",
                                "target_lang_sense_clarification": "относящийся к воде или гидросфере"
                            },
                            {
                                "target_lang_word": "водяной",
                                "target_lang_sense_clarification": "связанный со звуком или стихией воды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57e61275-7a04-3c8a-a080-b18888680345",
                    "sense_definition": "Filled with tears; tearful.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked up at him with <w>watery</w> eyes as she said goodbye.",
                            "target_lang_translations": {
                                "ru": "Она посмотрела на него <w>полными слёз</w> глазами, прощаясь."
                            }
                        },
                        {
                            "text": "He cleared his throat and tried to disguise his <w>watery</w> gaze.",
                            "target_lang_translations": {
                                "ru": "Он откашлялся и попытался скрыть свой <w>заплаканный</w> взгляд."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наполненный слезами от эмоций; заплаканный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на мокром месте",
                                "target_lang_sense_clarification": "полный слёз, готовый расплакаться"
                            },
                            {
                                "target_lang_word": "заплаканный",
                                "target_lang_sense_clarification": "о глазах или взгляде"
                            },
                            {
                                "target_lang_word": "влажный от слёз",
                                "target_lang_sense_clarification": "блестящий от слёз"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6532cf50-e5a4-3149-81d4-ecd1f8102587",
                    "sense_definition": "Lacking vigor, substance, or impact; weak or insipid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His latest novel feels like a <w>watery</w> imitation of his early masterpieces.",
                            "target_lang_translations": {
                                "ru": "Его последний роман кажется <w>блеклым</w> подобием ранних шедевров."
                            }
                        },
                        {
                            "text": "The committee presented a <w>watery</w> compromise that satisfied neither political party.",
                            "target_lang_translations": {
                                "ru": "Комитет предложил <w>половинчатый</w> компромисс, который не удовлетворил ни одну из политических партий."
                            }
                        }
                    ],
                    "synonyms": [
                        "bland",
                        "insipid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишённый выразительности, силы или глубины; слабый, бессодержательный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водянистый",
                                "target_lang_sense_clarification": "бессодержательный, пустой"
                            },
                            {
                                "target_lang_word": "блеклый",
                                "target_lang_sense_clarification": "невыразительный, лишённый живости"
                            },
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "лишённый убедительности или оригинальности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfd03b0f-6909-371c-b33c-d098ed04b5cd",
                    "sense_definition": "Characterized by or containing many bodies of water, such as lakes, marshes, or rivers.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "liquid_properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The delta is a <w>watery</w> landscape threaded with endless channels and shallow lagoons.",
                            "target_lang_translations": {
                                "ru": "Дельта представляет собой <w>водный</w> ландшафт, пронизанный бесконечными протоками и мелководными лагунами."
                            }
                        },
                        {
                            "text": "They sailed through <w>watery</w> vistas bounded by thick mangrove forests.",
                            "target_lang_translations": {
                                "ru": "Они плыли по <w>водным</w> просторам, окружённым густыми мангровыми лесами."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изобилующий водоёмами (реками, озёрами, болотами)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водный",
                                "target_lang_sense_clarification": "состоящий преимущественно из водоёмов"
                            },
                            {
                                "target_lang_word": "изобилующий водой",
                                "target_lang_sense_clarification": "богатый водными просторами"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}