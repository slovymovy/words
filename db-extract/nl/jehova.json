                        "glosses": [
                            "andere naam voor Jahweh, de Hebreeuwse naam van het Opperwezen"
                        ],
                        "tags": [
                            "protestantisme"
                        ],
                        "examples": [
                            {
                                "example_id": "094c2472-e1a5-46bf-ac01-271a22432547",
                                "sense_id": "69222b38-8a7f-3f8f-955d-8cd7333ec60c",
                                "text": "Jehova zelf zo zegt de ironische schrijver, gaf zijn aanbidders een voorbeeld van ledigheid: hij schiep de wereld, na zes dagen arbeid, ‘en nam verder voor eeuwig rust’."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a3c6fa0-50dd-45b5-be44-54c27f5bd1a9",
                        "source_entry_id": "0628c8ea-c146-30f4-ae24-2e1f7abf1db3",
