                "senses": [
                    {
                        "sense_id": "43bdcd07-3b5b-3457-a34e-29ef56226b5c",
                        "entry_id": "bc1c0abe-22e8-3391-b641-599574703f5a",
                        "glosses": [
                            "истор. участник испанских завоевательных походов в Центральную и Южную Америку в конце XV–XVI вв., жестоко истреблявшие и порабощавшие коренное население"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2efcbd90-d712-4fab-ad43-18208f088565",
                                "sense_id": "43bdcd07-3b5b-3457-a34e-29ef56226b5c",
                                "text": "В ноябре 1519 года испанские конкистадоры под водительством Эрнана Кортеса ворвались в древнюю столицу Мексики город Теночтитлан и захватили его."
                            }
                        ]
                    },
                    {
                        "sense_id": "75956b10-93fb-3cca-88cc-8517003b80e2",
                        "entry_id": "bc1c0abe-22e8-3391-b641-599574703f5a",
                        "glosses": [
                            "перен. завоеватель, захватчик, грабитель"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
