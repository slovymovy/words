                        ]
                    },
                    {
                        "translation_id": "aaa5752a-68da-4f68-9994-fb51dcaed188",
                        "source_entry_id": "d4f150c2-f55d-36b5-83df-86ffd9529825",
                        "source_sense_id": "482dcb54-8dbe-3957-b9df-38deafb4444d",
