                            },
                            {
                                "target_lang_word": "Hoch-",
                                "target_lang_sense_clarification": "Höhepunkt einer Jahreszeit, z. B. Hochsommer"
                            },
                            {
                                "target_lang_word": "Mitten",
                                "target_lang_sense_clarification": "mitten in der Jahreszeit"
                            }
                        ]
                    }
                }
