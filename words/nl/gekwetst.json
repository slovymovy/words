                    "sense_definition": "Lichamelijk gewond of beschadigd.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <gekwetste> passagiers werden onmiddellijk naar het ziekenhuis gebracht.",
                            "target_lang_translations": {
                                "ru": "<w>Пострадавшие</w> пассажиры были немедленно доставлены в больницу.",
                                "en": "The <w>injured</w> passengers were immediately taken to the hospital.",
                                "fr": "Les passagers <w>blessés</w> ont été immédiatement transportés à l'hôpital."
                            }
                        },
                        {
                            "text": "Hij kon de wedstrijd niet uitspelen omdat hij zwaar <gekwetst> was.",
                            "target_lang_translations": {
                                "ru": "Он не смог доиграть матч, так как был тяжело <w>травмирован</w>.",
                                "en": "He could not finish the match because he was seriously <w>injured</w>.",
                                "fr": "Il n'a pas pu finir le match car il était gravement <w>blessé</w>."
                            }
