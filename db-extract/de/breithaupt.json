                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13219a45-d711-4461-9450-69106e75da52",
                                "sense_id": "0b3cc930-3b0e-3283-984d-de0caa4b72c8",
                                "text": "Frau Breithaupt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "825bd347-7740-4cec-8ac8-4ab513808fd2",
                                "sense_id": "0b3cc930-3b0e-3283-984d-de0caa4b72c8",
                                "text": "Herr Breithaupt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4fc71b96-303c-4e11-9a26-fcc2b909ca14",
                                "sense_id": "0b3cc930-3b0e-3283-984d-de0caa4b72c8",
                                "text": "Die Breithaupts fliegen heute nach Rom."
                            },
                            {
                                "example_id": "f2fd2620-b9b2-4d3d-8bef-9a9da9967695",
                                "sense_id": "0b3cc930-3b0e-3283-984d-de0caa4b72c8",
                                "text": "Der Breithaupt trägt nie die Pullover, die die Breithaupt ihm strickt."
                            },
                            {
                                "example_id": "a61d9e1a-1db5-4d5a-8a62-0062cb26a4d7",
                                "sense_id": "0b3cc930-3b0e-3283-984d-de0caa4b72c8",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Breithaupt kommt, geht der Herr Breithaupt.“"
                            },
                            {
                                "example_id": "56b296ae-e19a-4383-81a8-4de8fd8bba84",
                                "sense_id": "0b3cc930-3b0e-3283-984d-de0caa4b72c8",
                                "text": "Breithaupt kommt und geht."
                            },
                            {
                                "example_id": "ae9f76ee-f4a9-45bf-8696-6aa16acc6a27",
                                "sense_id": "0b3cc930-3b0e-3283-984d-de0caa4b72c8",
                                "text": "Breithaupts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
