                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zodra de eieren van nestvlieders <w>uitgebroed</w> zijn, verlaten de jongen het nest.",
                            "target_lang_translations": {
                                "en": "As soon as the eggs of precocial birds have <w>hatched</w>, the young leave the nest."
                            }
                        },
                        {
                            "text": "De vogel moet de eieren drie weken lang <w>uitbroeden</w> voordat ze uitkomen.",
                            "target_lang_translations": {
                                "en": "The bird must <w>incubate</w> the eggs for three weeks before they hatch."
                            }
