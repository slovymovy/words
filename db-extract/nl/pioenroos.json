        "nl-extract.jsonl": [
            {
                "entry_id": "c25cf24d-3876-311e-9184-9ffe67da4526",
                "word": "pioenroos",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "aa3fc29f-cd7c-4c6f-9ded-58d17c27d3cd",
                        "entry_id": "c25cf24d-3876-311e-9184-9ffe67da4526",
                        "tags": [
                            "plural"
                        ],
                        "form": "pioenrozen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b9e8753b-9fd4-3a0f-a431-344d95a8b3cd",
                        "entry_id": "c25cf24d-3876-311e-9184-9ffe67da4526",
                        "glosses": [
                            "Paeonia lactiflora vaste tuinplant met grote purperrode bloemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c07a447-6dff-4d20-8a70-ba84583cefde",
                                "sense_id": "b9e8753b-9fd4-3a0f-a431-344d95a8b3cd",
                                "text": "Scheerder vertelt dat er al decennia onderzoek naar wordt gedaan, maar dat wordt niet heel goed gecommuniceerd. Zo blijken mensen die lavendel ruiken, eerder geneigd geld met elkaar te delen. En rood en geel geven hoop, dat is zo overduidelijk dat de pioenroos en de zonnebloem al buiten onderzoek worden gehouden."
                            },
                            {
                                "example_id": "df5fd4d4-7abf-4bb9-a83f-0d307cb17642",
                                "sense_id": "b9e8753b-9fd4-3a0f-a431-344d95a8b3cd",
                                "text": "De Wogmeer is 680 hectare groot. Het meeste land wordt gebruikt voor bloembollenteelt, akkerbouw en voedselwinning ten behoeve van de veeteelt. Vooral de pioenroos doet het hier fantastisch gezien de vele kwekerijen."
                            },
                            {
                                "example_id": "bd661fb1-813c-4155-b5ae-617eb4b1dd7a",
                                "sense_id": "b9e8753b-9fd4-3a0f-a431-344d95a8b3cd",
                                "text": "PostNL heeft ter gelegenheid van het 25 jubileum van Janneke, wier tekeningen al jaren de postzegels ten bate van het Nationaal Ouderenfonds sieren, een zilveren postzegel met een pioenroos uitgebracht. „Daar ben ik heel blij mee”, aldus de kunstenares."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "860b740f-498e-4da9-a46d-5d19991960ba",
                        "source_entry_id": "c25cf24d-3876-311e-9184-9ffe67da4526",
                        "source_sense_id": "b9e8753b-9fd4-3a0f-a431-344d95a8b3cd",
                        "target_lang_word": "peony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51266a5e-5875-317a-a687-910efaf32886",
                                        "entry_id": "b3b1cd7c-8b44-35f9-9fed-a8183e5e7c56",
                                        "glosses": [
                                            "A flowering plant of the genus Paeonia with large fragrant flowers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85fe77b5-9d5c-4914-8724-40f9006be665",
                                                "sense_id": "51266a5e-5875-317a-a687-910efaf32886",
                                                "text": "The root of the Male Peony fresh gathered has been found by experience to cure the falling-sickness."
                                            },
                                            {
                                                "example_id": "04bce55d-7c33-46d3-a588-081da0ab8751",
                                                "sense_id": "51266a5e-5875-317a-a687-910efaf32886",
                                                "text": "There might ye ſee the pioney ſpread vvide, / The full-blovvn roſe, the ſhepherd and his laſs, / Lap-dog and lambkin vvith black ſtaring eyes, / And parrots vvith tvvin cherries in their beak."
                                            },
                                            {
                                                "example_id": "ef62c7a5-36b0-4f8f-beb3-58cbcf81f04a",
                                                "sense_id": "51266a5e-5875-317a-a687-910efaf32886",
                                                "text": "'Twas early June, the new grass was flourishing everywheres, the posies in the yard—peonies and such—in full bloom, the sun was shining, and the water of the bay was blue, with light green streaks where the shoal showed."
                                            },
                                            {
                                                "example_id": "64c6328c-1291-4a85-b856-ba6c37964924",
                                                "sense_id": "51266a5e-5875-317a-a687-910efaf32886",
                                                "text": "Peony would keep away any kind of storms. Mugwort hung over doorways on Midsummer's Day, June 24, would keep off lightning, as St. John's-Wort would if gathered before sunrise on that day."
                                            },
                                            {
                                                "example_id": "835610cc-83b7-41de-a254-1a1b9d4d5a22",
                                                "sense_id": "51266a5e-5875-317a-a687-910efaf32886",
                                                "text": "Mr. Farzan’s narrow backyard in Brooklyn’s South Slope neighborhood is a lush, if slightly chaotic, oasis. There are Fuji apples, Meyer lemons, figs, peonies and avocados — although that’s far from a complete census of all that grows there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e8953d8-81f4-35d8-adeb-347caf47d9df",
                                        "entry_id": "b3b1cd7c-8b44-35f9-9fed-a8183e5e7c56",
                                        "glosses": [
                                            "A dark red colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbe16cbb-177a-4882-a071-5cc47efb5172",
                                                "sense_id": "6e8953d8-81f4-35d8-adeb-347caf47d9df",
                                                "text": "She was a fine and handsome girl—not handsomer than some others, possibly—but her mobile peony mouth and large innocent eyes added eloquence to colour and shape."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
