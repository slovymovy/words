                        "glosses": [
                            "To brim upwards"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f07a1e4e-7194-44fa-88ff-64dfdfbc37bb",
                                "sense_id": "db5e3318-2d08-364d-b2cc-64ab340549e7",
                                "text": "[…], whom I knew when her dreams\nwere upbrimming with light,\nAnd with laughter her eyes."
                            },
                            {
                                "example_id": "80c6b296-dd3c-4f74-935a-986074a08058",
                                "sense_id": "db5e3318-2d08-364d-b2cc-64ab340549e7",
                                "text": "Lady many-spoused, more charity\nUpbrims in thee than in some loftier ones\nWho would not name thee with their white-washed tongues."
                            }
                        ]
                    }
