        "fr-extract.jsonl": [
            {
                "entry_id": "3633fa84-f0c1-3343-877e-6ccbf430e8a7",
                "word": "engelure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7d620cc2-3cd9-4040-ad9b-a58619ee3104",
                        "entry_id": "3633fa84-f0c1-3343-877e-6ccbf430e8a7",
                        "tags": [
                            "plural"
                        ],
                        "form": "engelures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "315fd0e7-03de-35ad-98e6-42ca0e014672",
                        "entry_id": "3633fa84-f0c1-3343-877e-6ccbf430e8a7",
                        "glosses": [
                            "Enflure causée par le froid, surtout aux pieds et aux mains et accompagnée d’inflammation, quelquefois même de crevasses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae52f797-d605-4f8d-adeb-4a866d67d2d0",
                                "sense_id": "315fd0e7-03de-35ad-98e6-42ca0e014672",
                                "text": "Tu n’es pas un de ceux qui nourrissent la flamme, mais tu la protèges de tes pauvres mains, et j’ai la rage au cœur de les voir pleines d’engelures, parce que tu n’as jamais pu te payer ces gants de peau grise fourrée de lapin que tu regardes depuis trois ans dans la vitrine d’un magasin."
                            },
                            {
                                "example_id": "1b85772a-0ab2-483f-8a9a-2bded04258c2",
                                "sense_id": "315fd0e7-03de-35ad-98e6-42ca0e014672",
                                "text": "Les engelures et des conditions météo difficiles avaient forcé la cordée à redescendre la voie, sonnant le glas de la mission."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e861a052-2e5f-41bd-b101-20d00bdfe105",
                        "source_entry_id": "3633fa84-f0c1-3343-877e-6ccbf430e8a7",
                        "source_sense_id": "315fd0e7-03de-35ad-98e6-42ca0e014672",
                        "target_lang_word": "Frostbeule",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frostbeule",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e8a1a57-5771-3941-9b42-714f77021497",
                                        "entry_id": "ad945517-e9d6-39f4-8de8-dae690315a44",
                                        "glosses": [
                                            "\\\"juckende bis schmerzhafte Schwellungen unter der Haut, die durch wiederholte Einwirkung von Kälte und Feuchtigkeit entstehen\\"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "628a2e79-6218-4540-a934-b1a9ec688044",
                                                "sense_id": "6e8a1a57-5771-3941-9b42-714f77021497",
                                                "text": "Mit der Zeit wurden die Frostbeulen immer schmerzhafter."
                                            },
                                            {
                                                "example_id": "ff6aab69-0eb9-4bf1-8a9e-94fb1d2dd677",
                                                "sense_id": "6e8a1a57-5771-3941-9b42-714f77021497",
                                                "text": "Sein [des US-Bergsteigers Roland Yearwood] nepalesischer Sherpa wurde oberhalb von 8000 Metern bewusstlos und mit Frostbeulen aufgefunden."
                                            },
                                            {
                                                "example_id": "1023a3ca-4c87-40a0-8462-3d47bb9163d5",
                                                "sense_id": "6e8a1a57-5771-3941-9b42-714f77021497",
                                                "text": "Tag für Tag wanderte der Polar-Abenteurer [Roland Krüger] im Schnitt siebeneinhalb bis achteinhalb Stunden auf Skiern. […] Von Frostbeulen oder gar Erfrierungen blieb er verschont. „Nichts, nicht einmal eine Blase.“"
                                            },
                                            {
                                                "example_id": "da8fd691-85b8-49b3-903b-d8b0beac7bbd",
                                                "sense_id": "6e8a1a57-5771-3941-9b42-714f77021497",
                                                "text": "[Idomeni/Balkan:] […] aufgrund der derzeit niedrigen Temperaturen und der beschwerlichen Reise [leiden viele] Flüchtlinge an Atemprobleme, Unterkühlung und Frostbeulen."
                                            },
                                            {
                                                "example_id": "f31b9ece-8487-47a7-bbbe-c7e9b1ca3e56",
                                                "sense_id": "6e8a1a57-5771-3941-9b42-714f77021497",
                                                "text": "„Da eine offene Frostbeule mich nötigte, im Bett zu bleiben, und der Doktor mit allen meinen Mitschülern in die Kirche ging, blieb nur Bettina zu Hause und setzte sich zu mir aufs Bett.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1c87b5ff-c1f3-3920-af32-bdf8291dc11e",
                                        "entry_id": "ad945517-e9d6-39f4-8de8-dae690315a44",
                                        "glosses": [
                                            "Person, die schon bei mäßigen Temperaturen und/oder auch mit dickerer Kleidung schnell friert"
                                        ],
                                        "tags": [
                                            "North German",
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b9711fa-1bed-4202-8ca8-3171992126f3",
                                                "sense_id": "1c87b5ff-c1f3-3920-af32-bdf8291dc11e",
                                                "text": "„Ich bin eine Frostbeule, deswegen laufe ich schon im Herbst mit Handschuhen herum.“"
                                            },
                                            {
                                                "example_id": "f676e69c-917e-4fae-8e64-281742fb57d0",
                                                "sense_id": "1c87b5ff-c1f3-3920-af32-bdf8291dc11e",
                                                "text": "„Als Frostbeule ist mein liebster Platz im Winter am Ofen.“"
                                            },
                                            {
                                                "example_id": "5d144803-8673-4a97-8850-7fdeffe2cec1",
                                                "sense_id": "1c87b5ff-c1f3-3920-af32-bdf8291dc11e",
                                                "text": "[Wechseljahre:] „Ich bin doch nicht mehr ich. Immer war ich 'ne Frostbeule. Und jetzt schwitz ich wie ein Schwein.“"
                                            },
                                            {
                                                "example_id": "fc87d04f-32a9-4d06-9e48-c9403fa3aaa7",
                                                "sense_id": "1c87b5ff-c1f3-3920-af32-bdf8291dc11e",
                                                "text": "„Eigentlich wollten wir noch einmal runter zum See. Mal schauen, ob das Wasser noch erträglich ist.“ „Du meinst wohl eher, ob du dich noch in den See traust, du Frostbeule“, foppt Lucas mich. Grinsend steige ich in sein Spiel ein. „Fragt sich nur, wer nachher die Frostbeule sein wird, du oder ich. Schließlich bist du immer der Erste, dem gleich kalt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0471fde-f44a-42ed-b184-ecbafd9d132d",
                        "source_entry_id": "3633fa84-f0c1-3343-877e-6ccbf430e8a7",
                        "source_sense_id": "315fd0e7-03de-35ad-98e6-42ca0e014672",
                        "target_lang_word": "chilblain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chilblain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "397f8045-8000-3a85-bcab-758452dc6c51",
                                        "entry_id": "a716107b-41c6-3f4c-8a5a-0db767206ee0",
                                        "glosses": [
                                            "An itchy purple red inflammation of the skin, especially of the hands, feet and ears, occurring when capillaries below the skin are damaged by exposure to cold weather (but do not freeze, which would lead to frostbite instead)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6033762c-58a4-4b17-93fd-2b8b15edc7d9",
                                                "sense_id": "397f8045-8000-3a85-bcab-758452dc6c51",
                                                "text": "Faith and those chilblanes are a foul trouble, Mistresse Merie-thought when your youth comes home, let him rub all the soles of his feete, and the heeles, and his ancles, with a mouse skinne, or if none of your people can catch a mouse, when hee goes to bed, let him rowle his feete in the warme embers, and I warrant you hee shall be well, and you may make him put his fingers between his toes & smell to them, it's very soueraigne for his head if he be costiue."
                                            },
                                            {
                                                "example_id": "7d4a542f-d9a0-430f-801c-c524c92753c7",
                                                "sense_id": "397f8045-8000-3a85-bcab-758452dc6c51",
                                                "text": "Mrs. Goddard’s school was in high repute—and very deservedly; for Highbury was reckoned a particularly healthy spot: she had an ample house and garden, gave the children plenty of wholesome food, let them run about a great deal in the summer, and in winter dressed their chilblains with her own hands."
                                            },
                                            {
                                                "example_id": "7f927317-3dbf-45c0-aecc-d27fdbba659f",
                                                "sense_id": "397f8045-8000-3a85-bcab-758452dc6c51",
                                                "text": "Our clothing was insufficient to protect us from the severe cold: we had no boots, the snow got into our shoes and melted there; our ungloved hands became numbed and covered with chilblains, as were our feet[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5851ab66-e59e-412e-9840-c3148cce4593",
                        "source_entry_id": "3633fa84-f0c1-3343-877e-6ccbf430e8a7",
