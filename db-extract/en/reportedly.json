                                        "sense_id": "f564d31b-1a29-381e-8cb0-7f65ce52285b",
                                        "entry_id": "a093c7fc-4514-3e73-8917-53287696c08a",
                                        "glosses": [
                                            "volgens berichten waarvan de betrouwbaarheid niet zeker is\\nDe bijbetekenis is zowel een versterking van de uitspraak, omdat men zich beroept op een kennelijk bestaande bron, als een verzwakking daarvan, omdat men geen eigen oordeel over de juistheid van de berichten geeft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6b47838-da67-4bb6-93fc-de87008e6bbf",
                                                "sense_id": "f564d31b-1a29-381e-8cb0-7f65ce52285b",
                                                "text": "Bugatti heeft nog niet bevestigd dat Ronaldo de koper is - naar verluidt wegens privacyredenen -, wel melden ze dat de auto daadwerkelijk is verkocht."
                                            },
                                            {
                                                "example_id": "8ec483cc-201d-4cc3-b9be-9e609d20fe70",
                                                "sense_id": "f564d31b-1a29-381e-8cb0-7f65ce52285b",
                                                "text": "Graaf Herman had in zijn jeugd een humanistische opvoeding genoten. Naar verluidt, zou hij de Psalmen deels in Griekse, deels in Latijnse verzen hebben overgebracht."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6af668b0-52c6-4b5f-9878-0515f967d5f3",
                        "source_entry_id": "03a4b1d7-055a-31c5-99c0-272720d70f16",
                        "source_sense_id": "04a5c2ea-3665-3594-ae7d-e240586be162",
                        "source_sense_description": "according to reports or rumors",
                        "target_lang_word": "supposément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
