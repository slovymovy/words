                                            {
                                                "example_id": "91ed84c7-7c3a-417b-b726-5bf6d4eb0877",
                                                "sense_id": "bd55d0a8-bfaa-37c2-a762-36eda8b5e92c",
                                                "text": "a runaway victory at the polls"
