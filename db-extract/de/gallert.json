                "senses": [
                    {
                        "sense_id": "919b487b-3243-3b9b-b98c-865d5a412a8a",
                        "entry_id": "9db96293-ea2f-3745-bd7e-dfc4cabf6a19",
                        "glosses": [
                            "steife, durchsichtige Masse eingedickter Brühe oder eines Saftes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "164092e6-f09c-4057-9ed4-f442af0d28b8",
                                "sense_id": "919b487b-3243-3b9b-b98c-865d5a412a8a",
                                "text": "Das Gallert ist sehr glibberig."
                            },
                            {
                                "example_id": "51ec83c1-987c-4b9b-bf6d-a06ad43889df",
                                "sense_id": "919b487b-3243-3b9b-b98c-865d5a412a8a",
                                "text": "„Ohne es zu wollen, hatte er sich bereits darauf eingestellt; denn er besaß den Vorteil eines Lebens ohne den Gallert verdickter Gefühle: Die Flüssigkeit klaren Blutes, das den Instinkt ungetrübt erhalten hat, einen Wächter über den Sinnen, der schon ins Horn stößt, wenn sie noch ahnunglos schlafen.“"
                            },
                            {
                                "example_id": "9f434990-eedc-43de-b3a9-e883bad0034e",
                                "sense_id": "919b487b-3243-3b9b-b98c-865d5a412a8a",
                                "text": "„Je größer ein Fisch ist, um so mehr Gallert enthält er und um so schwerer ist er verdaulich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
