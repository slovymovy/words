                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d4853f7-b348-492f-83f1-d02adb18f910",
                                "sense_id": "5f99368e-3eed-3cf1-90d0-58d51144927d",
                                "text": "„Sie durchstreift die Unterwelt und erreicht den Tempel, der von Ereschkigal beherrscht wird, der Göttin des Todes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc6070d5-cf6a-4024-9c90-f5387fc0f545",
                        "source_entry_id": "7728e3fc-67ab-39fb-8818-c7e9670f031b",
                        "source_sense_id": "5f99368e-3eed-3cf1-90d0-58d51144927d",
