                                        "entry_id": "d08c7bc0-64c8-32c7-ba5d-16078dacfd76",
                                        "glosses": [
                                            "Synonyme de grande aunée (espèce de plantes)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ddd8a0b-a83d-4534-9a2d-c05e9a3b2a9a",
                                                "sense_id": "67eff014-568a-36c3-ad78-c50f67969259",
                                                "text": "L’inule aunée, connue autrefois sous le nom d’énule campane, est une grande et belle Composée aussi utile au point de vue médicinal que décorative au jardin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
