                "translations": [
                    {
                        "translation_id": "b23cb7cb-1629-43fd-8dda-54f0be244cd9",
                        "source_entry_id": "588c1a60-391b-36b9-912f-80a01bce07c8",
                        "source_sense_id": "ddd5e046-2e97-36d8-bbd4-6ce2dc3fe9d0",
                        "source_sense_description": "französischer männlicher Vorname",
                        "target_lang_word": "Anthony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anthony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04fa89ca-93b3-3757-a2fb-d5a6306a698b",
                                        "entry_id": "7c9bc7d1-7202-3dd9-b543-f79476ccb8dc",
                                        "glosses": [
                                            "A male given name from Latin, in regular use since the Middle Ages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70e1ffde-375a-4f9a-a2ab-7708fdbbafab",
                                                "sense_id": "04fa89ca-93b3-3757-a2fb-d5a6306a698b",
                                                "text": "\"...Think you've got the best name I've heard,\" she was saying. - - \"Anthony Patch. Only you ought to look sort of like a horse, with a long narrow face - and you ought to be in tatters.\" \"That's the Patch part though. How should Anthony look?\" \"You look like Anthony,\" she assured him seriously - he thought she had scarcely seen him - \"rather majestic,\" she continued, \" and solemn.\""
                                            },
                                            {
                                                "example_id": "10ab33bc-87de-4745-bcbe-b79c5513b713",
                                                "sense_id": "04fa89ca-93b3-3757-a2fb-d5a6306a698b",
                                                "text": "It is doubtless true that American English lacks a tradition for the pronunciation of Anthony, a name which was not often bestowed upon American males until the comparatively recent craze for supposedly swank \"British\" Christian names, like Stephen, Peter, Michael, etc., in this country."
                                            },
                                            {
                                                "example_id": "b668bcd8-9ece-448e-a1f3-e3e84cb2defb",
                                                "sense_id": "04fa89ca-93b3-3757-a2fb-d5a6306a698b",
                                                "text": "She was built like a dream and wore a chain around her neck with a medal of Saint Anthony hanging down inside the most beautiful bosom I never saw. \"It must be a terrible temptation for Saint Anthony,\" I joked - just to put her at ease, you know. \"Saint Anthony?\" her husband said. \"Who's Saint Anthony?\""
                                            },
                                            {
                                                "example_id": "44048a91-02da-49bb-8e88-3466e4e487ef",
                                                "sense_id": "04fa89ca-93b3-3757-a2fb-d5a6306a698b",
                                                "text": "Covid-19 is still spreading rampantly and must be tackled aggressively if we want life to get back to normal soon, Dr. Anthony Fauci told CNN on Sunday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "869b7990-0837-3506-aba3-d3716f68dd6e",
                                        "entry_id": "7c9bc7d1-7202-3dd9-b543-f79476ccb8dc",
                                        "glosses": [
                                            "A surname originating as a patronymic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f98915c-f36b-4639-ac26-0abe00e277c5",
                                                "sense_id": "869b7990-0837-3506-aba3-d3716f68dd6e",
                                                "text": "The online fundraising site GiveSendGo continues to face criticism over a page that has raised more than $320,000 for Karmelo Anthony, the teen arrested for stabbing fellow 17-year-old student-athlete Austin Metcalf to death at a Texas track meet last week."
                                            }
                                        ]
                                    },
