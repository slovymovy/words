{
    "word_family": [
        "slangy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bd24ace3-620d-30cf-b24d-5aae202d17ac",
                    "sense_definition": "Language outside of conventional usage and in the informal register.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "language",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "English-speaking Australians have always had a love affair with <w>slang</w>.",
                            "target_lang_translations": {
                                "zh": "讲英语的澳大利亚人一直对<w>俚语</w>情有独钟。"
                            }
                        },
                        {
                            "text": "After years when I met a friend inside the aircraft and could sense stiffness in the conversation, a whiff of mild <w>slang</w> was the ice breaker.",
                            "target_lang_translations": {
                                "zh": "多年后我在飞机上遇到一位朋友，谈话间感到有些拘谨，于是我用几句轻松的<w>俚语</w>打破了僵局。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vernacular",
                        "lingo"
                    ],
                    "common_phrases": [
                        "use slang"
                    ],
                    "target_lang_definitions": {
                        "zh": "非正式场合使用的口语或俚语。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "俚语",
                                "target_lang_sense_clarification": "指非正式的、口语化的词汇。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df31f908-36f8-3c90-a7b7-48fd9cafb20b",
                    "sense_definition": "Language that is unique to a particular profession or subject; jargon.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "language",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manual was difficult to read because it was full of technical <w>slang</w>.",
                            "target_lang_translations": {
                                "zh": "这份手册很难读，因为它充满了技术<w>行话</w>。"
                            }
                        },
                        {
                            "text": "Doctors often use medical <w>slang</w> when talking to each other in the hospital.",
                            "target_lang_translations": {
                                "zh": "医生在医院交谈时经常使用医学<w>行话</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jargon"
                    ],
                    "common_phrases": [
                        "technical slang"
                    ],
                    "target_lang_definitions": {
                        "zh": "特定行业或领域内使用的专业术语。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "行话",
                                "target_lang_sense_clarification": "指特定行业或群体内部使用的专门用语。"
                            },
                            {
                                "target_lang_word": "术语",
                                "target_lang_sense_clarification": "指专业领域内的专门词汇。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a82d636-fe12-3040-8da2-bcb15a7a0916",
                    "sense_definition": "The specialized language of a social group, sometimes used to conceal one's meaning from outsiders; cant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "language",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thieves developed a secret <w>slang</w> to communicate without being understood by the police.",
                            "target_lang_translations": {
                                "zh": "小偷们发明了一种秘密<w>隐语</w>，以便在不被警察听懂的情况下进行交流。"
                            }
                        },
                        {
                            "text": "They used a coded <w>slang</w> to keep their plans hidden from the rest of the group.",
                            "target_lang_translations": {
                                "zh": "他们使用一种加密的<w>隐语</w>，以防计划被小组里的其他人发现。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cant"
                    ],
                    "target_lang_definitions": {
                        "zh": "特定社会群体使用的隐语，旨在不让外人听懂。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "隐语",
                                "target_lang_sense_clarification": "指为了保密而使用的特殊语言。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78594438-821d-34dd-ba55-b376e92e7685",
                    "sense_definition": "An item of slang; a slang word or expression.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "language",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have learned many <w>slangs</w> while I am in New York.",
                            "target_lang_translations": {
                                "zh": "我在纽约期间学到了许多<w>俚语词</w>。"
                            }
                        },
                        {
                            "text": "The internet comes up with so many <w>slangs</w> used by people to survive in the online world.",
                            "target_lang_translations": {
                                "zh": "互联网上出现了许多人们在网络世界中生存所使用的<w>俚语词</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in plural form to refer to individual terms."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一个俚语词汇或表达方式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "俚语词",
                                "target_lang_sense_clarification": "指单个的俚语表达。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da842508-e2ef-3c0f-ae8c-1ca677c44645",
                    "sense_definition": "A curse word.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "language",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry woman was known for using <w>slangs</w> to verbally abuse her neighbours.",
                            "target_lang_translations": {
                                "zh": "那个愤怒的女人以用<w>脏话</w>辱骂邻居而闻名。"
                            }
                        },
                        {
                            "text": "He was told to stop using offensive <w>slangs</w> in the classroom.",
                            "target_lang_translations": {
                                "zh": "他被告知在课堂上停止使用冒犯性的<w>脏话</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "粗俗的辱骂性词汇。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "脏话",
                                "target_lang_sense_clarification": "指粗鲁、冒犯性的语言。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "559df55f-a900-3d5c-b7e0-80c7c477f38b",
                    "sense_definition": "To vocally abuse, or shout at.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to keep his temper when he was <w>slanged</w> in the theatre porch by a policeman.",
                            "target_lang_translations": {
                                "zh": "当他在剧院门廊被警察<w>辱骂</w>时，他不得不克制自己的脾气。"
                            }
                        },
                        {
                            "text": "The angry customer <w>slanged</w> the manager for the poor service.",
                            "target_lang_translations": {
                                "zh": "愤怒的顾客因为服务质量差而<w>辱骂</w>了经理。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Common in 19th and early 20th-century British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "大声辱骂或斥责某人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "辱骂",
                                "target_lang_sense_clarification": "指用恶毒的语言攻击他人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c685802-d32f-3d05-8b63-229fcda77981",
                    "sense_definition": "To sell (something, especially illegal drugs).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gang members were caught <w>slanging</w> drugs on the street corner.",
                            "target_lang_translations": {
                                "zh": "帮派成员在街角<w>贩卖</w>毒品时被抓获。"
                            }
                        },
                        {
                            "text": "He was arrested for <w>slanging</w> illegal substances to teenagers.",
                            "target_lang_translations": {
                                "zh": "他因向青少年<w>贩卖</w>非法物质而被捕。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flog"
                    ],
                    "common_phrases": [
                        "slang drugs"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used primarily in criminal or street subcultures."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "非法兜售（尤指毒品）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "贩卖",
                                "target_lang_sense_clarification": "指非法买卖违禁品。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6253a2ca-651f-359d-896f-1807d6bb6fee",
                    "sense_definition": "simple past of <w>sling</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before he <w>slang</w> the all-deciding stone, he took a deep breath.",
                            "target_lang_translations": {
                                "zh": "在<w>投出</w>那块决定性的一石之前，他深吸了一口气。"
                            }
                        },
                        {
                            "text": "He <w>slang</w> the heavy bag over his shoulder and walked away.",
                            "target_lang_translations": {
                                "zh": "他把沉重的包<w>甩</w>在肩上，走开了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This is an old-fashioned past tense form."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "sling的古旧过去式。"
                    },
                    "translations": {
                        "zh": []
                    }
                }
            ]
        }
    ]
}