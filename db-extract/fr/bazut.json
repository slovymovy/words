                "senses": [
                    {
                        "sense_id": "778d92df-47ee-3653-9744-b50113ca67ac",
                        "entry_id": "0a9857e6-b728-3660-b10c-2ae28cf0ef76",
                        "glosses": [
                            "Idiot, benêt."
                        ],
                        "tags": [
                            "Rhône-Alpes",
                            "Lyonnais"
                        ],
                        "examples": [
                            {
                                "example_id": "1a9065ba-f886-427c-8a12-43991ebea4b1",
                                "sense_id": "778d92df-47ee-3653-9744-b50113ca67ac",
                                "text": "— Pardi ! Vous n’êtes que des ballouffes, des bambanes, des bazuts, des bradins, des bugnassons, des coquenanos, des cogue-mous, des couanes, des Jean-la-Fiarde, des miguedandouilles, des torches-bugnes. » Faut bien avouer que le tablier de sapeur de la Jeanine, s’est brusquement arrêté entre le gésier et l’estome. Comme si cette radée de jurons avait eu le pouvoir de vous supprimer tout plaisir."
                            },
                            {
                                "example_id": "4641bafe-9814-419c-a5b6-81b1421a3f22",
                                "sense_id": "778d92df-47ee-3653-9744-b50113ca67ac",
                                "text": "L’homme avait lu les étiquettes sur les vêtements de ces bazuts quand ils s’étaient assis dans son fauteuil."
                            }
                        ]
                    }
                ],
