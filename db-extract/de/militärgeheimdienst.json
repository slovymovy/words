                ],
                "senses": [
                    {
                        "sense_id": "0ea42192-6ce4-36eb-b572-6a1d29d0c142",
                        "entry_id": "b986389d-d93d-38cf-9cff-527403923371",
                        "glosses": [
                            "im Dienst des Militärs stehender Geheimdienst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cb989e9-6cd4-40e0-aa41-d76ac1d2acad",
                                "sense_id": "0ea42192-6ce4-36eb-b572-6a1d29d0c142",
                                "text": "„Nach der Jahrtausendwende beschaffte sich der Militärgeheimdienst in Kasachstan langsam wirkende Gifte, die keine Spuren hinterließen und mit denen politische Gegner aus dem Weg geräumt wurden.“"
                            },
                            {
                                "example_id": "adecb0e3-75f6-4e01-96a8-3936db708a39",
                                "sense_id": "0ea42192-6ce4-36eb-b572-6a1d29d0c142",
                                "text": "„Rabin und Jariv, der Chef des Militärgeheimdienstes, räumten ein, dass sie fälschlicherweise davon ausgegangen seien, dass die jordanische Armee untätig bleiben würde.“"
                            },
                            {
                                "example_id": "0cddabe6-c746-4536-8d6a-0fd05292af83",
                                "sense_id": "0ea42192-6ce4-36eb-b572-6a1d29d0c142",
                                "text": "„Der Chef der AfD-Jugendorganisation Junge Alternative, Hannes Gnauck – selbst vom Militärgeheimdienst als Rechtsextremist eingestuft – kritisierte: ‚Die juristische Auseinandersetzung mit dem BfV lähmt die AfD seit Jahren, ohne jeglichen Erfolg.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
