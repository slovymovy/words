                        "glosses": [
                            "Transfecter simultanément."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5c20a21-c204-46d5-a98b-a79f651c5fde",
                                "sense_id": "e79c8085-1b17-3c87-90d3-18211b254eb6",
                                "text": "C'est pourquoi pour comparer les efficacités de diverses combinaisons de régions régulatrices, il est préférable de co-transfecter, avec chaque ADN Xi que l'on veut tester, un ADN de référence Y, dont on peut mesurer indépendamment (et facilement) l'expression."
                            },
                            {
                                "example_id": "20bf3ff1-a2dd-4721-a51b-55f229859ed8",
                                "sense_id": "e79c8085-1b17-3c87-90d3-18211b254eb6",
                                "text": "Si l'ADN plasmidique ne possède pas ce gène, vous pouvez co-transfecter un autre plasmide avec le gène neo."
                            }
                        ]
                    }
