                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee96ac2f-aac4-44b5-af76-960e7e9b938f",
                        "source_entry_id": "f9019f34-20ed-39ea-8ed6-00d21c92524b",
                        "source_sense_description": "having the appearance of nature, lifelike, realistic",
                        "target_lang_word": "naturgetreu",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naturgetreu",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38f3000a-322c-3247-b414-9bd8225cc96a",
                                        "entry_id": "c9a05611-b768-31d9-af69-82dc02738456",
                                        "glosses": [
                                            "dem natürlichen Zustand/der Wirklichkeit entsprechend (dargestellt seiend)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "002152dc-286c-4271-bc6d-b793a28926ad",
                                                "sense_id": "38f3000a-322c-3247-b414-9bd8225cc96a",
                                                "text": "„Von dem italienischen Maler Giotto (1266 bis 1337) [wurde] berichtet, er habe bereits als armer Hütejunge seine Schafe derart lebensnah und naturgetreu abgezeichnet, dass man ihm später kaum mehr etwas beibringen konnte.“"
                                            },
                                            {
                                                "example_id": "5964e4fd-ab5b-4a0b-91cd-72a7be2d08fa",
                                                "sense_id": "38f3000a-322c-3247-b414-9bd8225cc96a",
                                                "text": "„Der Abdruck war erstaunlich naturgetreu. Um den Hals des Tieres lag ein Strick.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1ff59c1-1b2e-4a71-a26c-edd16f6968a7",
                        "source_entry_id": "f9019f34-20ed-39ea-8ed6-00d21c92524b",
                        "source_sense_description": "having the appearance of nature, lifelike, realistic",
                        "target_lang_word": "realitätsnah",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "realitätsnah",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d5a1c59-736a-3a36-af8a-dce918204821",
                                        "entry_id": "7fc8e7f7-ae36-3ce4-8192-0c1d8fd1288a",
                                        "glosses": [
                                            "die Wirklichkeit, die wahren Gegebenheiten berücksichtigend, wahrnehmend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ff06452-dd40-488b-b7de-68cdbd7ef5ed",
                                                "sense_id": "9d5a1c59-736a-3a36-af8a-dce918204821",
                                                "text": "„In realitätsnahen Trainings- und Übungssituationen kann auch die Wirksamkeit, Angemessenheit und Effektivität der BCM-Maßnahmen erprobt werden.“"
                                            },
                                            {
                                                "example_id": "68ca3b54-6823-485d-9966-596ebf778da3",
                                                "sense_id": "9d5a1c59-736a-3a36-af8a-dce918204821",
                                                "text": "„Um diesem Umstand entgegenzuwirken, müssen die Einsatzkräfte so realitätsnah, aber auch so sicher wie möglich, aus- und fortgebildet werden.“"
                                            },
                                            {
                                                "example_id": "04dec870-a4e8-40b5-8b42-aad0439b9493",
                                                "sense_id": "9d5a1c59-736a-3a36-af8a-dce918204821",
                                                "text": "„In der Tat verbinden sich in Picassos ‚Frauen von Algier‘ Kubismus, Surrealismus und sogar realitätsnahe Formen.“"
                                            },
                                            {
                                                "example_id": "349492ab-d8a6-4862-a0cc-79e87e239cab",
                                                "sense_id": "9d5a1c59-736a-3a36-af8a-dce918204821",
                                                "text": "„In erster Linie sind daher die Aufgabenstellungen realitätsnah zu gestalten.“"
                                            },
                                            {
                                                "example_id": "fd5871dd-571d-438d-8052-5cd241b70fd1",
                                                "sense_id": "9d5a1c59-736a-3a36-af8a-dce918204821",
                                                "text": "„Die Distanz zum Kerngeschäft lässt erahnen, wie wenig realitätsnah so manche Strategie ausfällt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e577f512-a536-4794-9297-7f98423ac33c",
                        "source_entry_id": "f9019f34-20ed-39ea-8ed6-00d21c92524b",
