                    },
                    {
                        "sense_id": "b8ba41f5-342f-3be5-ac3a-db993f68c559",
                        "entry_id": "d117323d-430f-34ec-9183-f7eacce0a1c4",
                        "glosses": [
                            "работник детского — обычно дошкольного — учреждения, непосредственно занимающийся с детьми"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a269bb09-31ba-418c-b013-bfef7e946d0d",
                        "source_entry_id": "d117323d-430f-34ec-9183-f7eacce0a1c4",
                        "target_lang_word": "Erzieher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erzieher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "25097974-e3fe-3a5f-b7e9-82ac579cabf9",
                                        "entry_id": "79b0c5e2-9e17-3b95-8eb6-8f10e5d307c1",
                                        "glosses": [
                                            "pädagogisch Berufstätiger, der Kindern und Jugendlichen soziale Verhaltensregeln und Bildungsinhalte vermittelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd5dc1dd-1bff-41c6-b209-4257b4395de6",
                                                "sense_id": "25097974-e3fe-3a5f-b7e9-82ac579cabf9",
                                                "text": "Zwei Erzieher betreuen die Ferienkinder jeden Tag und erarbeiten ein vielfältiges Programm."
                                            },
                                            {
                                                "example_id": "c0ccae00-bdd3-49de-b972-e3e22f40561d",
                                                "sense_id": "25097974-e3fe-3a5f-b7e9-82ac579cabf9",
                                                "text": "„Hermann, widerspenstig und exzentrisch, war für seine Erzieher ein Alptraum.“"
                                            },
                                            {
                                                "example_id": "351d05f7-a865-47fe-91db-e5f13a0b3d3f",
                                                "sense_id": "25097974-e3fe-3a5f-b7e9-82ac579cabf9",
                                                "text": "„Familienministerin Giffey will Erzieher finanziell besser stellen. In einem Interview forderte sie, das Gehalt deutlich anzuheben - auf das Niveau von Grundschul-Pädagogen.“"
                                            },
                                            {
                                                "example_id": "094feef9-95d3-44c9-a1b2-ae4e07c14110",
                                                "sense_id": "25097974-e3fe-3a5f-b7e9-82ac579cabf9",
                                                "text": "„Sein Bruder, der Mathematikprofessor an der Universität Padua, kam um die gleiche Zeit aus Neapel mit dem jungen Cavaliere Morosini, dessen Erzieher er war, nach Rom.“"
                                            },
                                            {
                                                "example_id": "45b946a5-279f-4910-9d05-8412b8a3beaf",
                                                "sense_id": "25097974-e3fe-3a5f-b7e9-82ac579cabf9",
                                                "text": "„Als der kleine Wilhelm seinen Heimatort verlassen mußte, konnte er nicht ahnen, daß ihm in der Person des geistlichen Onkels ein Erzieher gegeben würde, der für seinen späteren Lebenslauf die wichtigsten Impulse geben sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be9171dd-1c0f-4c9c-b7fe-30dd566fa34c",
                        "source_entry_id": "d117323d-430f-34ec-9183-f7eacce0a1c4",
                        "target_lang_word": "éducateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éducateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7fa0b015-fd35-3446-9683-b80b92971a5e",
                                        "entry_id": "d0787356-9f73-30f9-b4c6-ddc944354f5e",
                                        "glosses": [
                                            "Celui qui s’occupe d’éducation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc35866b-0d9a-4700-9791-9a63c3e6e045",
                                                "sense_id": "7fa0b015-fd35-3446-9683-b80b92971a5e",
                                                "text": "Ce directeur d’école fut un admirable éducateur."
                                            },
                                            {
                                                "example_id": "706a67b4-a487-49cc-8002-d77f14bfb75c",
                                                "sense_id": "7fa0b015-fd35-3446-9683-b80b92971a5e",
                                                "text": "Témoignage d’un éducateur, et l’expression des jeunes en difficulté rencontrés au fil de l’année."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a550cdb5-afc4-37c9-9125-4f5593d73727",
                                        "entry_id": "d0787356-9f73-30f9-b4c6-ddc944354f5e",
                                        "glosses": [
                                            "Se dit des penseurs, des écrivains qui forment l’esprit des lecteurs."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5062d069-14d2-4991-ba9b-4c8a002c782c",
                                                "sense_id": "a550cdb5-afc4-37c9-9125-4f5593d73727",
                                                "text": "Ce critique a été un utile éducateur du goût."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd77c91e-ed3e-3fdf-ae27-01bf3895ffd8",
                                        "entry_id": "d0787356-9f73-30f9-b4c6-ddc944354f5e",
                                        "glosses": [
                                            "Arbre qui, par son ombrage, limite et différencie les semis à ses pieds, ou favorise la formation d’une belle bille de pied sur un voisin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "045eec82-c11b-47a5-a171-a8eb8646f9b6",
                                                "sense_id": "bd77c91e-ed3e-3fdf-ae27-01bf3895ffd8",
                                                "text": "Il n'est pas nécessaire de prélever en bordure des trouées de régénération et si elles sont grandes ; il faut laisser des arbres éducateurs au centre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "680edffd-93fd-3f17-a60d-a981885c223b",
                                        "entry_id": "d0787356-9f73-30f9-b4c6-ddc944354f5e",
                                        "glosses": [
                                            "Éducateur spécialisé."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93132f23-7d75-4539-af3d-684cc5af8ab0",
                                                "sense_id": "680edffd-93fd-3f17-a60d-a981885c223b",
                                                "text": "Dans tous ces récits des victimes apparaissent des figures protectrices, celles qui ont dit « je te crois » et qui ont agi en conséquence : une mère ou un parent, un enseignant, une policière ou un gendarme, l’avocat général à l’audience malgré l’acquittement, une psychologue ou un médecin, un éducateur, la littérature, une émission, un article dans un journal, le témoignage d’une autre victime, un groupe de parole sur l’inceste, un film, la description des troubles de stress post-traumatique. Quelqu’un, une voix, un point fixe qui permet de ne pas se croire folle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
