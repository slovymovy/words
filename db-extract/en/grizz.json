                                "example_id": "05332b67-3ca1-41c5-8806-e1cb89ccc916",
                                "sense_id": "bc0ed83a-639e-3665-9e8a-b6f20a19f8d2",
                                "text": "“Are you sure it was a black bear and not a grizz?”"
