                ],
                "senses": [
                    {
                        "sense_id": "ca998ac3-4d44-3e31-87bc-d9b6750ce177",
                        "entry_id": "64728f60-883a-3b0c-bf06-5a51e67c4ea5",
                        "glosses": [
                            "An overabundance; a great amount"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "066daa8c-c0ed-4982-93bf-90bb1ec78535",
                                "sense_id": "ca998ac3-4d44-3e31-87bc-d9b6750ce177",
                                "text": "Take physic, pomp;\nExpose thyself to feel what wretches feel,\nThat thou mayst shake the superflux to them\nAnd show the heavens more just."
                            },
                            {
                                "example_id": "5157d03b-720f-42ae-b6ea-006fed873f10",
                                "sense_id": "ca998ac3-4d44-3e31-87bc-d9b6750ce177",
                                "text": "There she lay,\nWith brow so pale,—who yester-morn breath'd forth\nThrough joyous smiles her superflux of bliss\nInto the hearts of others."
                            },
                            {
                                "example_id": "85514c31-f5a7-4b5b-887b-24a32140ae17",
                                "sense_id": "ca998ac3-4d44-3e31-87bc-d9b6750ce177",
                                "text": "Intense device, and superflux of pain"
                            }
                        ]
                    }
                ],
                "translations": [],
