                    {
                        "sense_id": "a7b5ef72-d26f-3400-afb5-2f8a82bc90c8",
                        "entry_id": "d6ff2fe6-1711-3349-876f-9e31216b153c",
                        "glosses": [
                            "Travailleur et/ou immigré clandestin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf432eaa-f93c-46f7-bd49-2349909f5af0",
                                "sense_id": "a7b5ef72-d26f-3400-afb5-2f8a82bc90c8",
                                "text": "« Clando » (clandestin), il retourne pourtant, le samedi soir, toujours au même club, à quelques dizaines de mètres des policiers qui effectuent des contrôles."
                            },
                            {
                                "example_id": "a6a699e4-07df-480e-beb6-979056f01d54",
                                "sense_id": "a7b5ef72-d26f-3400-afb5-2f8a82bc90c8",
                                "text": "C’est pas un clando. C’est un ancien de la DDASS."
                            }
                        ]
                    },
                    {
                        "sense_id": "efa67bc8-6e51-3d83-bda6-5e36a555c36a",
                        "entry_id": "d6ff2fe6-1711-3349-876f-9e31216b153c",
                        "glosses": [
                            "Véhicule utilisé comme taxi sans licence."
                        ],
                        "tags": [
                            "Afrique"
                        ],
                        "examples": [
                            {
                                "example_id": "8201440b-17ea-4b5a-ace4-dee3d45ddc90",
                                "sense_id": "efa67bc8-6e51-3d83-bda6-5e36a555c36a",
                                "text": "Le « clando » est considéré comme un transport informel car n’étant pas régi par une autorité organisatrice de transport."
                            },
                            {
                                "example_id": "0713fb47-b34e-428a-818c-1ca94262be31",
                                "sense_id": "efa67bc8-6e51-3d83-bda6-5e36a555c36a",
                                "text": "Connue sous l’appellation « Bensikin » pour ce qui est de la zone méridionale et « Clando » pour ce qui est du Nord Cameroun, l’activité des motos taxis a évolué considérablement avec l’entrée en scène de la Chine, pays dont proviennent ces engins à deux roues, avec des prix variant de 350.000 Fcfa à 400.000 Fcfa selon la marque et la qualité du produit."
                            }
                        ]
                    }
