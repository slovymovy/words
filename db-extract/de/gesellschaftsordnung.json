                ],
                "senses": [
                    {
                        "sense_id": "7c10ca5d-1cdd-330d-b3cb-33a4a0633ad5",
                        "entry_id": "7d189fd6-7b7d-3cf2-a80d-01560fbd03d0",
                        "glosses": [
                            "Aufbau, Gesamtheit der Merkmale einer Gesellschaft in wirtschaftlicher, sozialer und ideologischer Hinsicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6578c41-f330-49f9-b7e0-6dafbcd9e0b2",
                                "sense_id": "7c10ca5d-1cdd-330d-b3cb-33a4a0633ad5",
                                "text": "„Unsere Wirtschafts- und Gesellschaftsordnung beruht in weiten Teilen auf dem Glauben, der Mensch sei im Grunde egoistisch und faul.“"
                            },
                            {
                                "example_id": "3bdb15a8-7a21-4123-a82f-fa9e048cf392",
                                "sense_id": "7c10ca5d-1cdd-330d-b3cb-33a4a0633ad5",
                                "text": "„Dementsprechend sei die Absetzung dieser durch die Herstellung der sozialistischen Gesellschaftsordnung erforderlich, um die ökonomischen Ursachen des Krieges und damit den Krieg selbst zu verhindern.“"
                            },
                            {
                                "example_id": "8bba0b49-43c0-4c8d-807d-70ef80acdfda",
                                "sense_id": "7c10ca5d-1cdd-330d-b3cb-33a4a0633ad5",
                                "text": "„Ferdinand von Schirach und Alexander Kluge gehen der Frage nach, was die Corona-Pandemie für unsere Gesellschaftsordnung und unsere bürgerliche Freiheit bedeutet.“"
                            },
                            {
                                "example_id": "18247e1b-bcfb-4c60-9fc3-16ece7e20fb8",
                                "sense_id": "7c10ca5d-1cdd-330d-b3cb-33a4a0633ad5",
                                "text": "„Was die Naturwissenschaft von heute zur Gesellschaftsordnung von morgen beitragen kann Günter Dedié.“"
                            },
                            {
                                "example_id": "919bdd28-f641-4d2a-b1f0-8d67a8ee7fd3",
                                "sense_id": "7c10ca5d-1cdd-330d-b3cb-33a4a0633ad5",
                                "text": "„Das Programm zeigt, dass diese deutsche Linkspartei eine andere Wirtschafts- und Gesellschaftsordnung will.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
