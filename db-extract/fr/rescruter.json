                "senses": [
                    {
                        "sense_id": "cae6d74e-ea4a-30d5-8a34-7543f532ad5c",
                        "entry_id": "2312eb0e-f06c-3f95-b5d8-c1ddb9d73e76",
                        "glosses": [
                            "Scruter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d52ffe70-d50b-41e4-be27-3ce6035fcf6a",
                                "sense_id": "cae6d74e-ea4a-30d5-8a34-7543f532ad5c",
                                "text": "Nos exégètes et théologiens vont donc rescruter ce qui, dans l'Ecriture et la Tradition, parle du Retour glorieux du Christ pour l'instauration du Royaume."
                            },
                            {
                                "example_id": "06c260d7-a2c0-4f31-8eb8-d43899f4ff45",
                                "sense_id": "cae6d74e-ea4a-30d5-8a34-7543f532ad5c",
                                "text": "Ainsi, lorsqu'il décrit le bon Samaritain, son admirable charité apparaît évidente et nous passons à côté de l'essentiel. Il faut rescruter le texte, remâcher les dires de Jésus."
                            }
                        ]
                    }
