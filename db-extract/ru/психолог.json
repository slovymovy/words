                                        "entry_id": "ff472796-c13b-3302-8d9e-c015024541fb",
                                        "glosses": [
                                            "absolwent studiów w dziedzinie psychologii"
                                        ],
                                        "tags": [
                                            "psychology"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eea1b8b5-1e3e-49df-845b-494bbca0b0b5",
                                                "sense_id": "391a8096-00b3-3a9c-af68-5e6ebb67028c",
                                                "text": "Psychologa widziałem dwa razy, bo był na pół etatu na sto osób."
                                            },
                                            {
                                                "example_id": "c5d116c7-8b04-44bd-b50b-291ba6de4bb6",
                                                "sense_id": "391a8096-00b3-3a9c-af68-5e6ebb67028c",
