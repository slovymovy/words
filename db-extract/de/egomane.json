                                "example_id": "8234e219-c7ac-42c0-b990-d3b74c59dedb",
                                "sense_id": "216d93a5-17ed-3705-8e5b-1cae7ab4b062",
                                "text": "„Dieser Kerl hat in Sachen Sex einige Tricks drauf, ist aber auch ein Egomane, der nach Anerkennung sucht.“"
                            }
                        ],
