                        "examples": [
                            {
                                "example_id": "24d6fe1c-1a1c-410b-9fa1-eeb826ba8f56",
                                "sense_id": "538766c8-5d1c-388d-b701-b2ae2a15de3f",
                                "text": "„Ein hungriger Einwohner des Viertels hatte eine Dose Tomatenpüree gekauft, eine Dose, die leider nicht den Weg nach Hause schaffte.“"
                            },
                            {
                                "example_id": "688389f5-7936-473e-bdbe-9c6ca12567c3",
                                "sense_id": "538766c8-5d1c-388d-b701-b2ae2a15de3f",
                                "text": "„Und der Lippenstift hatte das volle Rot von Tomatenpüree.“"
                            },
                            {
                                "example_id": "2bbe5631-1065-47c4-b8c5-9f9e7802d531",
                                "sense_id": "538766c8-5d1c-388d-b701-b2ae2a15de3f",
                                "text": "„Ein geschäftstüchtiger Dorfbewohner hatte in einer der Hütten einen Lebensmittelladen eingerichtet, hier gab es Waschpulver, Tomatenpüree und kalte Cola aus einem Kühlschrank, der von einem ratternden Benzingenerator betrieben wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
