                        "glosses": [
                            "Graphie ancienne de paroxysme."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b5101b27-7048-4d73-9a26-d0be1373cf2b",
                                "sense_id": "a277b531-08a9-31b9-9e2c-4a0c2ab13674",
                                "text": "Sthal remarque dans son Problème sur la Théorie des Fièvres, que l’assoupissement n'est point nuisible dans les paroxismes de la fièvre quarte; & qu'il ne faut point l'empêcher."
                            },
                            {
                                "example_id": "05383078-b067-4ba1-b434-06486238a993",
                                "sense_id": "a277b531-08a9-31b9-9e2c-4a0c2ab13674",
                                "text": "— La douleur me fera nier éternellement Dieu, s’écria Clément au paroxisme de l’exaltation"
                            },
                            {
                                "example_id": "98ec6e57-c6dd-4ed0-bc66-55dd077bc352",
                                "sense_id": "a277b531-08a9-31b9-9e2c-4a0c2ab13674",
                                "text": "Quand Aphrodite et Arès furent au paroxisme de leur passion, du lit jaillirent des chaînes d'or qui emprisonnèrent les dieux dénudés dans leur étreinte illicite."
                            }
                        ]
                    }
