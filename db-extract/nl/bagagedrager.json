                    {
                        "sense_id": "7d9e06dd-a2f9-37e5-817f-928f7ae90eed",
                        "entry_id": "8572cdbf-9f13-3bda-a724-0112d99fe2d7",
                        "glosses": [
                            "een rek op de fiets (of andere tweewieler) waarop bagage bevestigd kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a42b459-fdcc-45de-ae5d-97d5335995c8",
                                "sense_id": "7d9e06dd-a2f9-37e5-817f-928f7ae90eed",
                                "text": "Mijn bagagedrager is momenteel kapot en moet gerepareerd worden."
                            },
                            {
                                "example_id": "9cfb7425-480a-4c41-9591-9d90edcb08a9",
                                "sense_id": "7d9e06dd-a2f9-37e5-817f-928f7ae90eed",
                                "text": "De jongen fietste terwijl het meisje in amazonezit op de bagagedrager zat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a52d016d-1752-4ef8-92bc-a28f2fc6e7ff",
                        "source_entry_id": "8572cdbf-9f13-3bda-a724-0112d99fe2d7",
                        "source_sense_id": "7d9e06dd-a2f9-37e5-817f-928f7ae90eed",
                        "target_lang_word": "Gepäckträger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gepäckträger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82a7d319-ecf0-3aa2-93c3-28d68df7abe4",
                                        "entry_id": "c0fc09b0-9caa-33dc-a938-2e1042fe63a4",
                                        "glosses": [
                                            "Teil eines Gefährts (meist eines Fahrrads oder Autos), der dazu dient, Gepäck zu transportieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e1c3dbb-8c3c-4de8-bd8b-f8f666260924",
                                                "sense_id": "82a7d319-ecf0-3aa2-93c3-28d68df7abe4",
                                                "text": "„Ich suche einen kleinen Gepäckträger für mein Moped.“"
                                            },
                                            {
                                                "example_id": "3a6ff533-8cd8-4d33-a7e2-b4a9d56cc7bd",
                                                "sense_id": "82a7d319-ecf0-3aa2-93c3-28d68df7abe4",
                                                "text": "„Tatsächlich radelt ein einzelner Mann auf einem klapprigen Damenfahrrad die Chaussee entlang, auf das Auto zu. Auf dem Gepäckträger bauscht sich ein dicker Sack. Vermutlich transportiert er Futter für seine Kaninchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "15ef25d2-b40f-3046-98f2-fdfc788ce4e8",
                                        "entry_id": "c0fc09b0-9caa-33dc-a938-2e1042fe63a4",
                                        "glosses": [
                                            "Person, die für das Tragen des Gepäckes zuständig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b735ef2c-998b-4602-aa06-3c8a6f7232a6",
                                                "sense_id": "15ef25d2-b40f-3046-98f2-fdfc788ce4e8",
                                                "text": "In vielen Urlaubsländern ist es üblich, dem Zimmermädchen und dem Gepäckträger ein Trinkgeld zu geben."
                                            },
                                            {
                                                "example_id": "17a6d72f-1bb5-4e1d-bf5f-3e5771e736d4",
                                                "sense_id": "15ef25d2-b40f-3046-98f2-fdfc788ce4e8",
                                                "text": "„Ich winkte einen Gepäckträger für die Koffer herbei.“"
                                            },
                                            {
                                                "example_id": "cd539f79-8ec1-4ebc-8104-e57c3d041c22",
                                                "sense_id": "15ef25d2-b40f-3046-98f2-fdfc788ce4e8",
                                                "text": "„Sobald sie weg waren, packte ich hastig alle Koffer, ließ mir die Rechnung heraufbringen, vom Bahnhof einen Gepäckträger schicken und fuhr mit dem nächsten Zug weg.“"
                                            },
                                            {
                                                "example_id": "26339619-1312-4ebf-9c3b-126b812d58a2",
                                                "sense_id": "15ef25d2-b40f-3046-98f2-fdfc788ce4e8",
                                                "text": "„Er schlief fast ein, bis der Gepäckträger kam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
