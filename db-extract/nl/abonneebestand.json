                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4a14c0c-1d05-47db-b590-ae0d034440f0",
                                "sense_id": "40c0c403-8fe8-375e-96ca-1523a3e5ae6e",
                                "text": "T-Mobile Nederland heeft in het tweede kwartaal 61.000 nieuwe mobiele klanten binnengehaald, waardoor het abonneebestand in een jaar met meer dan een kwart miljoen is gegroeid."
                            },
                            {
                                "example_id": "3b23065e-27dc-47a0-94c8-bf6af6849aa7",
                                "sense_id": "40c0c403-8fe8-375e-96ca-1523a3e5ae6e",
                                "text": "Zowel bij collega vermogensbeheerders als bij de toezichthouder AFM bespeur ik in toenemende mate ergernis over deze gang van zaken. Wettelijk heeft de AFM geen bevoegdheden om deze beursprofeten, die met een schuin oog naar het abonneebestand hun lezers een financieel Utopia voorspiegelen, aan te pakken."
                            },
                            {
                                "example_id": "db317244-05b9-44b5-b08d-10c56cb194d7",
                                "sense_id": "40c0c403-8fe8-375e-96ca-1523a3e5ae6e",
                                "text": "Netflix wees erop dat de groei van het abonneebestand in voorgaande kwartalen de verwachtingen juist overtrof. Voor de laatste 3 maanden van 2014 rekent het bedrijf op 4 miljoen nieuwe leden. In totaal heeft Netflix nu wereldwijd ruim 53 miljoen abonnees."
                            }
                        ]
