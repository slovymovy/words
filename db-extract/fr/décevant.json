                                        "entry_id": "dd85ec3f-4806-3710-9468-0138c4cd0be9",
                                        "glosses": [
                                            "meelijwekkend, bedroevend, zielig, jammerlijk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6555ee16-6ecb-4112-b28d-0cc8af9b6f9c",
                                                "sense_id": "2aad2f06-645f-3979-bdc3-31e868be0385",
                                                "text": "Rond hem hangt de geur van mislukking. En wat hij ook probeert, van dat sneue imago komt hij niet af."
                                            },
                                            {
                                                "example_id": "85d80e24-bcae-4ea2-89ce-7d7d1e067f91",
                                                "sense_id": "2aad2f06-645f-3979-bdc3-31e868be0385",
