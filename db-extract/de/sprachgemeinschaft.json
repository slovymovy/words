                    {
                        "form_id": "6f4f8bab-b448-4fb6-a539-da4a0cd812dc",
                        "entry_id": "42088db5-89b8-3ddf-8c7d-9af7d97ad4c3",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sprachgemeinschaften"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2d253a6a-7951-3511-a8cb-86493503940f",
                        "entry_id": "42088db5-89b8-3ddf-8c7d-9af7d97ad4c3",
                        "glosses": [
                            "Gruppe der Menschen, die dieselbe Sprache verwenden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd0c8c6c-f433-4ba8-9242-2927da3aefb5",
                                "sense_id": "2d253a6a-7951-3511-a8cb-86493503940f",
                                "text": "Man kann mehr als einer Sprachgemeinschaft angehören, z.B., wenn man bilingual (zweisprachig) aufgewachsen ist."
                            },
                            {
                                "example_id": "04bca2dc-4082-4578-a478-dccbfd0c3729",
                                "sense_id": "2d253a6a-7951-3511-a8cb-86493503940f",
                                "text": "Zu einer Sprachgemeinschaft gehören alle Menschen, die dieselbe Sprache sprechen. Bisweilen wird der Begriff so weit gefasst, dass es sich nicht unbedingt immer um ein und dieselbe Sprache handeln muss: Eine Sprachgemeinschaft ist dann eine Gruppe von Menschen, die sozial und sprachlich - aber womöglich in verschiedenen Sprachen - miteinander Umgang pflegen."
                            },
                            {
                                "example_id": "13538e23-e937-40e6-be59-a2a7d06d2e14",
                                "sense_id": "2d253a6a-7951-3511-a8cb-86493503940f",
                                "text": "„Und obwohl nur sehr wenige Staaten der Welt sprachlich ganz einheitlich sind, fällt einem nur die Schweiz als leuchtendes Vorbild ein, wo tatsächlich mehrere Sprachgemeinschaften (Deutsch, Französisch, Italienisch, Rätoromanisch) ohne große Konflikte schon seit Jahrhunderten miteinander leben.“"
                            },
                            {
                                "example_id": "872b9234-4736-46c9-aca9-82ebec385f01",
                                "sense_id": "2d253a6a-7951-3511-a8cb-86493503940f",
                                "text": "„Wenn es bei der Betrachtung der europäischen Sprachgemeinschaften um den Bezug zu ihrer einzelstaatlichen Verteilung geht, muß man sich immer bewußt machen, daß es sich um zwei divergierende und voneinander unabhängige Kriterien handelt (sprachliche versus staatliche Gemeinschaft).“"
                            },
                            {
                                "example_id": "938d587c-2ee2-4530-9021-ae689baad9b8",
                                "sense_id": "2d253a6a-7951-3511-a8cb-86493503940f",
                                "text": "„Und da diese Gebärden festgelegt sind, gibt es unter den Sprachgemeinschaften (und oft auch schon innerhalb ihrer) Unterschiede.“"
                            },
                            {
                                "example_id": "05a67950-55fc-4158-9fad-b4e7c1feb6cd",
                                "sense_id": "2d253a6a-7951-3511-a8cb-86493503940f",
                                "text": "„Die Linguistik hat eine Bringschuld und eine Verantwortung der Sprachgemeinschaft gegenüber, deren Sprache sie erforscht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "233ea141-1e68-4abf-98fe-0c9f1aa1d317",
                        "source_entry_id": "42088db5-89b8-3ddf-8c7d-9af7d97ad4c3",
                        "source_sense_id": "2d253a6a-7951-3511-a8cb-86493503940f",
                        "target_lang_word": "speech community",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speech community",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7eb4cd5-d984-3c7d-bdc6-08f9dfd6817a",
                                        "entry_id": "3ee38f68-a8a7-39af-977c-836aea37594a",
                                        "glosses": [
                                            "A group of people sharing a language, or a particular way of using that language"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f021bfc-5d99-42f3-8bea-81b0dd948471",
                                                "sense_id": "e7eb4cd5-d984-3c7d-bdc6-08f9dfd6817a",
                                                "text": "The phonetic laws always work without the consciousness of the speech community in which they act ; they are due wholly to physiological causes acting unknown to the will of the individual speaker."
                                            },
                                            {
                                                "example_id": "13a60b17-073b-42b5-8b41-65173c74ef1a",
                                                "sense_id": "e7eb4cd5-d984-3c7d-bdc6-08f9dfd6817a",
                                                "text": "Another language of this group, Cantonese, probably ranks among the world's largest speech-communities."
                                            },
                                            {
                                                "example_id": "44325baa-08f0-4f15-96f2-74bc8103a596",
                                                "sense_id": "e7eb4cd5-d984-3c7d-bdc6-08f9dfd6817a",
                                                "text": "Research indicates that men and women in the mainstream US culture tend to form separate speech communities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
