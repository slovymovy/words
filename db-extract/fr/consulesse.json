                        "source_entry_id": "1c3fbd94-0876-3159-b83f-506edc3e1ba8",
                        "target_lang_word": "Konsulin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konsulin",
