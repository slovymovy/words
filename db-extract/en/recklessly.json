                                "target_senses": [
                                    {
                                        "sense_id": "e6361f95-431a-3b02-808f-51fe3c51c959",
                                        "entry_id": "e846b7c8-37e5-3160-951d-850ddd5ec823",
                                        "glosses": [
                                            "pozbawiony głowy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c0f1bd8-ed81-4aed-aff6-41ad9b13cb88",
                                                "sense_id": "e6361f95-431a-3b02-808f-51fe3c51c959",
                                                "text": "W krzakach za boiskiem do koszykówki przy naszej szkole znaleźli człowieka bez głowy"
                                            },
                                            {
                                                "example_id": "d342cc11-3ecb-4fac-9d34-995458b29b6b",
                                                "sense_id": "e6361f95-431a-3b02-808f-51fe3c51c959",
                                                "text": "„Oto pierwszy facet w kinie przygodowym, który gra jak 13-letnia dziewczynka – zachwycał się Deppem Burton, kiedy przed 6 laty kręcili „Jeźdźca bez głowy"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "bez głowy",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "85227e50-d2f5-3458-8871-cea14b2baca6",
                                        "entry_id": "5f648519-4b65-38d4-b555-a93fd1bf0ca4",
                                        "glosses": [
                                            "nierozsądnie, bez namysłu, rozwagi, w sposób nieprzemyślany"
                                        ],
                                        "tags": [
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23b4093d-72c2-4ae7-8e7f-20c73cbd2488",
                                                "sense_id": "85227e50-d2f5-3458-8871-cea14b2baca6",
                                                "text": "„Moim zdaniem – twierdził Merz – to, co dotychczas zrobiła Policja Bezpieczeństwa w obszarze, którym się zajmuję, było robione bez głowy"
                                            }
                                        ],
                                        "sense_index_json": "\"2.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
