                ],
                "senses": [
                    {
                        "sense_id": "5f106a5d-a4d2-3f67-abbd-f01ce88a4d31",
                        "entry_id": "39f909cb-6dee-3be6-acf3-3750d0adb4a9",
                        "glosses": [
                            "A region of Scotland, spanning from the Highland Boundary Fault to the border with England, encompassing the Central Lowlands, Central Belt (including Edinburgh and Glasgow) and the Scottish Borders, spanning the traditional extent of the Scots language."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "bedc707c-6126-400c-ab58-f9ec6060c16a",
                                "sense_id": "5f106a5d-a4d2-3f67-abbd-f01ce88a4d31",
                                "text": "Of the miserable Highland clachan, to which Sir Walter Scott brought Bailie Nicol Jarvie and Frank Osbaldistone for their meeting with the redoubtable Rob Roy, little or nothing remains, and Aberfoyle is now a bright and clean holiday resort, standing on historic ground, where the Highlands and Lowlands meet."
                            }
                        ]
                    }
                ],
