                ],
                "senses": [
                    {
                        "sense_id": "988192c5-842e-337d-bdc5-de74f25ea8d7",
                        "entry_id": "ce8f5685-75d7-3ea1-b13b-37b9a052b2cf",
                        "glosses": [
                            "Vorgang, bei dem sich etwas (zum Beispiel Eis) verflüssigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82085795-1d21-4aee-91aa-a7a6e7d64b95",
                                "sense_id": "988192c5-842e-337d-bdc5-de74f25ea8d7",
                                "text": "„Der Schmelzprozess könnte sich zwar über Hunderte oder Tausende von Jahren hinziehen, wäre jedoch womöglich unumkehrbar und könnte den gesamten Eisschild Grönlands betreffen.“"
                            },
                            {
                                "example_id": "6999442c-e0d1-483f-9976-40820e40e370",
                                "sense_id": "988192c5-842e-337d-bdc5-de74f25ea8d7",
                                "text": "„Ein Beschneiungssystem soll helfen, den Schmelzprozess des Gletschers zu verlangsamen.“"
                            },
                            {
                                "example_id": "1bfe0fbb-e099-4a7e-86a8-41843160da07",
                                "sense_id": "988192c5-842e-337d-bdc5-de74f25ea8d7",
                                "text": "„Zum anderen wird durch die stärkere Bindung von Fett und Wasser eine höhere Stabilität erreicht, wodurch sich der Schmelzprozess verlangsamt und das Eis höhere Temperaturen aushält.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
