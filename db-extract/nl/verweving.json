                "senses": [
                    {
                        "sense_id": "5cecf893-f4db-36bd-83c6-5b4c83767444",
                        "entry_id": "bde28747-48b0-3850-b18b-c8d29fd09c1e",
                        "glosses": [
                            "de mate waarin verschillende zelfstandige zaken met elkaar in verband staan en onderling afhankelijk van elkaar zijn (zoals de losse draden in een geweven stof)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9629633-3c96-4e85-9c4c-3ccb2af017c9",
                                "sense_id": "5cecf893-f4db-36bd-83c6-5b4c83767444",
                                "text": "„De situatie is verslechterd door het opdrogen van de kredietmarkt. De hoge mate van verweving van het Europese financiële systeem heeft geleid tot een snelle stijging van de kans op besmetting."
                            },
                            {
                                "example_id": "b8c49e00-2b13-4fa8-bf1d-38d303a0220f",
                                "sense_id": "5cecf893-f4db-36bd-83c6-5b4c83767444",
                                "text": "Het onderzoek zal zich toespitsen op de wijze waarop Winter en zijn medeaandeelhouders het vastgoed in handen kregen en de huurovereenkomsten die gesloten zijn. Hierbij was volgens de Ondernemingskamer sprake van 'verwevenheid van functies en belangen'bij bestuurders, toezichthouders en aandeelhouders."
                            },
                            {
                                "example_id": "c5d49fc4-84c3-4dfa-869b-015b26725b94",
                                "sense_id": "5cecf893-f4db-36bd-83c6-5b4c83767444",
                                "text": "Jasper Kerkwijk,fractievoorzitter van D66: „Zijn aanpak van ondermijning en het tegengaan van de dreigende verweving van de onder- en bovenwereld zijn in lijn met wat we hebben afgesproken in Enschede. Als de burgemeester op deze wijze optreedt, dan beschikt hij kennelijk over informatie die hem hiertoe noodzaakt. Ik zie daar geen kwaad in.”"
                            }
                        ]
                    }
