                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "275dbbf6-a145-443a-b7fb-7b88eb993f71",
                                                "sense_id": "3bf8497a-137d-3c44-8b43-6aea92131fd8",
                                                "text": "Auf der Wiese mümmelte ein Häschen vor sich hin."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0b09d2c3-f190-3cfa-870c-eb4b17ee4c2c",
                                        "entry_id": "44894a1f-7090-3444-bf4b-f30cdec2ad74",
                                        "glosses": [
                                            "Kosewort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5f09ec6-eb70-4511-8ea9-fae553e2d819",
                                                "sense_id": "0b09d2c3-f190-3cfa-870c-eb4b17ee4c2c",
                                                "text": "Na, Häschen, wo drückt der Schuh?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b333fedf-1dc5-4070-b180-97552efebd05",
                        "source_entry_id": "ce8662d4-e431-305b-aa85-6762600bdcd6",
                        "source_sense_id": "6692a2b4-bfe6-3122-9c24-e4ef2ee966a0",
                        "target_lang_word": "Häslein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Häslein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "976e2984-eaa2-3b13-a123-1556e90a9b2a",
                                        "entry_id": "770747b2-be2b-3bd5-9a53-fc42e4b61ede",
                                        "glosses": [
                                            "kleiner/junger Hase"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "392c16a1-6a0e-48c3-95be-b6e9489d7512",
                                                "sense_id": "976e2984-eaa2-3b13-a123-1556e90a9b2a",
                                                "text": "„Mit einer Scherbe habe er am Kaninchenloch gebuddelt, um das Häslein herauszuholen.“"
                                            },
                                            {
                                                "example_id": "642d57fd-2f9b-4064-8f49-1731a205b160",
                                                "sense_id": "976e2984-eaa2-3b13-a123-1556e90a9b2a",
                                                "text": "„So ritt er denn einem Dorfe zu, durch das seine Straße führte, und streichelte zuweilen das Häslein auf seinem Arme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1827fa90-f0b8-4bc1-a90d-4a8dd32be446",
                        "source_entry_id": "ce8662d4-e431-305b-aa85-6762600bdcd6",
                        "source_sense_id": "6692a2b4-bfe6-3122-9c24-e4ef2ee966a0",
                        "target_lang_word": "leveret",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leveret",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c62fc7ce-c5b4-3e67-9e74-e36218750b54",
                                        "entry_id": "282267f1-80f6-3d6b-8bf8-453e8a638722",
                                        "glosses": [
                                            "A young hare less than one year old."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea112873-a782-4af9-8698-4e9959998bf4",
                                                "sense_id": "c62fc7ce-c5b4-3e67-9e74-e36218750b54",
                                                "text": "[…] Shall I die like a leveret,\nWithout any resistance?—Help, help, help!\nI am slain!"
                                            },
                                            {
                                                "example_id": "2667d94c-d1cf-412a-b461-9b35a39a0313",
                                                "sense_id": "c62fc7ce-c5b4-3e67-9e74-e36218750b54",
                                                "text": "Fair Hand that can on Virgin-paper write,\n Yet from the stain of Ink preserve it white,\nWhose travel o’er that Silver Field does show,\nLike track of Leveretts in morning Snow;"
                                            },
                                            {
                                                "example_id": "8018b632-164f-4b90-b84c-9f009cd50526",
                                                "sense_id": "c62fc7ce-c5b4-3e67-9e74-e36218750b54",
                                                "text": "As when two skilful hounds the leveret wind;\nOr chase through woods obscure the trembling hind;\nNow lost, now seen, they intercept his way,\nAnd from the herd still turn the flying prey:\nSo fast, and with such fears, the Trojan flew;\nSo close, so constant, the bold Greeks pursue."
                                            },
                                            {
                                                "example_id": "0304cd76-0d04-4ade-a658-b20c60cc8bc6",
                                                "sense_id": "c62fc7ce-c5b4-3e67-9e74-e36218750b54",
                                                "text": "They heard Marvel squeal like a caught leveret, and forthwith they were clambering over the bar to his rescue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
