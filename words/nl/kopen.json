                                "cs": "Včera jsme <w>koupili</w> nové auto.",
                                "tr": "Dün yeni bir araba <w>satın aldık</w>.",
                                "es": "Ayer <w>compramos</w> un coche nuevo."
                            }
                        },
                        {
                            "text": "Je kunt hier kaartjes <w>kopen</w> voor het concert.",
                            "target_lang_translations": {
                                "en": "You can <w>buy</w> tickets for the concert here.",
                                "ru": "Здесь можно <w>купить</w> билеты на концерт.",
                                "pl": "Tutaj możesz <w>kupić</w> bilety na koncert.",
                                "de": "Hier kann man Tickets für das Konzert <w>kaufen</w>.",
                                "fr": "Vous pouvez <w>acheter</w> des billets pour le concert ici.",
                                "it": "Qui puoi <w>comprare</w> i biglietti per il concerto.",
                                "cs": "Zde si můžete <w>koupit</w> lístky na koncert.",
                                "tr": "Konser için biletleri buradan <w>satın alabilirsiniz</w>.",
                                "es": "Puedes <w>comprar</w> entradas para el concierto aquí."
                            }
