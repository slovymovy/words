                "senses": [
                    {
                        "sense_id": "ee5ddf4f-d1c9-3712-bc11-2b5f19346d5d",
                        "entry_id": "d4d08fcd-495e-336b-ae56-cbc8096a2775",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23585710-5f34-4231-94f3-1e5186335227",
                                "sense_id": "ee5ddf4f-d1c9-3712-bc11-2b5f19346d5d",
                                "text": "Frau Buhck ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a95ea898-e14d-4e31-a57a-f106e1588b48",
                                "sense_id": "ee5ddf4f-d1c9-3712-bc11-2b5f19346d5d",
                                "text": "Herr Buhck wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "22800b09-954d-4ebd-a79e-92e815576104",
                                "sense_id": "ee5ddf4f-d1c9-3712-bc11-2b5f19346d5d",
                                "text": "Die Buhcks fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0bd5db2a-7d25-4204-93ad-793985a77b1d",
                                "sense_id": "ee5ddf4f-d1c9-3712-bc11-2b5f19346d5d",
                                "text": "Der Buhck trägt nie die Schals, die die Buhck ihm strickt."
                            },
                            {
                                "example_id": "29701bf7-85dc-4ca1-8066-a30c9edfeed0",
                                "sense_id": "ee5ddf4f-d1c9-3712-bc11-2b5f19346d5d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Buhck kommt, geht der Herr Buhck.“"
                            },
                            {
                                "example_id": "0bdfde44-6413-45b8-836e-cdbbeb35e07c",
                                "sense_id": "ee5ddf4f-d1c9-3712-bc11-2b5f19346d5d",
                                "text": "Buhck kommt und geht."
                            },
                            {
                                "example_id": "acb0d2d8-0785-4067-a8e5-61575c3c524a",
                                "sense_id": "ee5ddf4f-d1c9-3712-bc11-2b5f19346d5d",
                                "text": "Buhcks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
