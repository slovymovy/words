                        "examples": [
                            {
                                "example_id": "031b25f3-89ce-45ee-943d-64b1ff988991",
                                "sense_id": "fbcfe076-aecc-35f8-9185-12c09349f78c",
                                "text": "Когда в Москву приехала, в первый же день в планетарий отправилась, как отличница и золотая медалистка."
                            },
                            {
                                "example_id": "ff49bf46-2e27-44b6-8dc0-ce955093c470",
                                "sense_id": "fbcfe076-aecc-35f8-9185-12c09349f78c",
                                "text": "Интересно, что серебряная медалистка Сиднея и чемпионка мира-2001 вернулась в спорт менее чем через год после рождения ребенка."
                            }
                        ]
                    }
