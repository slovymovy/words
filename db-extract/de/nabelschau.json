                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nombrilisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c00fac3c-942f-370b-9240-d605d3ea250c",
                                        "entry_id": "987fed98-d78c-34fe-9bd6-5de63c69dc97",
                                        "glosses": [
                                            "Narcissisme, égoïsme, égocentrisme, tendance à tout rapporter à soi."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e33e5910-e243-4b32-9b14-6ba99a1943bc",
                                                "sense_id": "c00fac3c-942f-370b-9240-d605d3ea250c",
                                                "text": "En vérité, j’étais rassurée de ne pas terminer en meilleure position et même si j’étais heureuse d’être reconnue comme une jolie fille, j’évitais tout nombrilisme ou grosse tête."
                                            }
                                        ]
