                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9299e729-cec0-497a-9d8e-483e66b161ac",
                                "sense_id": "05bb2b0e-f538-3149-b5c8-edf11a820d91",
                                "text": "Halverwege leidde Oranje met 8-1. De doelpuntenmachine draaide na rust op volle toeren en in de derde periode was Oranje maar liefst tienmaal trefzeker. Met zes doelpunten was Kas te Riele de topscorer."
                            },
                            {
                                "example_id": "8ac5beb6-79c0-4d2f-a5cd-2766071f2275",
                                "sense_id": "05bb2b0e-f538-3149-b5c8-edf11a820d91",
                                "text": "Terwijl Zuid-Korea bleef inzetten op de counter, vond Duitsland af en toe wel de rust om onder de druk uit te spelen. De verliezend EK-finalist werd een paar keer gevaarlijk, maar het vizier stond niet helemaal op scherp. Behalve bij Alexandra Popp. De Duitse doelpuntenmachine kopte haar ploeg een paar minuten voor rust op 1-1."
                            }
                        ]
                    }
