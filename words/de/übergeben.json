                    "frequency": "High",
                    "semantic_group_id": "weitergabe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Vermieter wird dem neuen Mieter morgen feierlich die Schlüssel <w>übergeben</w>."
                        },
