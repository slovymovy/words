                    {
                        "translation_id": "1fb4157b-f3be-41a1-9b19-a7b3529261f1",
                        "source_entry_id": "fef39bcc-e330-33ff-9321-159663191db6",
                        "source_sense_id": "cbbaa931-92aa-3f2f-804a-880d042f365a",
                        "target_lang_word": "acquainted",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acquainted",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0ba2995-7f19-3184-921f-69d34b87722e",
                                        "entry_id": "e09b4448-0efd-3b72-8f49-81ba633c8f09",
                                        "glosses": [
                                            "Personally known; familiar."
                                        ],
                                        "tags": [
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d0d6766-cadd-4cd2-b458-88fa10fa98fa",
                                                "sense_id": "a0ba2995-7f19-3184-921f-69d34b87722e",
                                                "text": "Suppoſe, therefore, a Perſon to have enjoy'd his Sight for thirty Years, and to have become perfectly well acquainted with Colours of all kinds, excepting one particular Shade of Blue, for Inſtance, which it never has been his Fortune to meet with."
                                            },
                                            {
                                                "example_id": "8c8a536e-a8c3-4fdc-8f30-0c8b8a78600c",
                                                "sense_id": "a0ba2995-7f19-3184-921f-69d34b87722e",
                                                "text": "I have been one acquainted with the night.\nI have walked out in rain—and back in rain.\nI have outwalked the furthest city light."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "acquainted",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19bd4ad4-3e2b-3ff4-9581-33e88f8eab4b",
                                        "entry_id": "20a50efb-ab3a-3dfb-9215-67699897bd2f",
                                        "glosses": [
                                            "simple past and past participle of acquaint"
                                        ],
