                        "entry_id": "47b14b69-0e58-3ede-9231-09dad55549ec",
                        "glosses": [
                            "To walk while shuffling or dragging the feet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db917adb-740c-4f41-8a03-f1e7dc814469",
                                "sense_id": "96ec8dec-cb51-344a-8696-53468fdcf7f8",
                                "text": "I wasn't too impressed with the fellow, when he shambled in unenthusiastically and an hour late."
                            },
                            {
                                "example_id": "677d3e94-2e00-4b7e-b4e8-550c2c054976",
                                "sense_id": "96ec8dec-cb51-344a-8696-53468fdcf7f8",
                                "text": "The old black, not in any very high glee at having been previously roused from his warm hammock at a most unseasonable hour, came shambling along from his galley, for, like many old blacks, there was something the matter with his knee-pans, which he did not keep well scoured like his other pans; [...]"
                            }
                        ]
                    }
