                        "glosses": [
                            "deel van een toernooi waarbij de verliezende partij van een wedstrijd het toernooi moet verlaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7be7384-9658-4d92-a136-e07d30d10656",
                                "sense_id": "415b961f-4923-3c87-945e-975eac0c510d",
                                "text": "Het begon met een ingestort dak en eindigde in de coronacrisis. Daartussenin vocht AZ zich naar de knock-outfase van de Europa League en toonde het zich een waardig uitdager van Ajax in de strijd om de landstitel."
                            },
                            {
                                "example_id": "d30f5e9b-0281-4c58-9151-1bec4dd4ef54",
                                "sense_id": "415b961f-4923-3c87-945e-975eac0c510d",
                                "text": "De clubs spelen drie groepswedstrijden, waarna er in totaal 16 doorstoten naar de knock-outfase. Volgens Don Garber, competitieleider van de MLS, duurt het toernooi niet meer dan 35 dagen."
                            }
                        ]
