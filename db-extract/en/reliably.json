                                                "example_id": "70fd4f35-e8d8-48ef-a5e7-d9677b96b75f",
                                                "sense_id": "8b31be35-d9bf-38ee-a43c-fd207d7d83f9",
                                                "text": "« Je me suis positionné dans un endroit du défilé plutôt resserré et étroit afin de compter fiablement », a expliqué l’huissier, Laurent Vialelle, dépêché dans les rues d’Albi avec une collègue."
                                            },
                                            {
                                                "example_id": "48175e88-6808-44f6-af23-2b41fd994a5a",
                                                "sense_id": "8b31be35-d9bf-38ee-a43c-fd207d7d83f9",
                                                "text": "C’est précisément l’ensemble des menaces anthropiques qui ont motivé la NOAA à évaluer le plus fiablement possible l’abondance des espèces."
                                            }
                                        ]
                                    }
                                ]
                            }
