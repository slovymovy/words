                        "sense_id": "85977e22-73bd-3904-88d1-1e1d8a241ef9",
                        "entry_id": "ce7093b2-3cad-3936-8243-ab94a96702bd",
                        "glosses": [
                            "Application d’une fonction mathématique à des données de taille variable pour en calculer une empreinte numérique de taille fixe, afin d’en comparer rapidement la valeur, en vue de la stocker ou d’en vérifier l’intégrité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d75f552c-10a7-4035-b17f-29b451270cf6",
                                "sense_id": "85977e22-73bd-3904-88d1-1e1d8a241ef9",
                                "text": "Hachage : Mécanisme permettant de calculer l’adresse physique d’une donnée à partir de la valeur clé."
                            },
                            {
                                "example_id": "93858a32-b420-452c-a0bc-5bb87d828e1f",
                                "sense_id": "85977e22-73bd-3904-88d1-1e1d8a241ef9",
                                "text": "Le hachage est notamment utilisé pour la signature numérique et l’adressage dispersé."
                            },
                            {
                                "example_id": "6de90c63-970a-4a96-a62e-793c0abf414a",
                                "sense_id": "85977e22-73bd-3904-88d1-1e1d8a241ef9",
                                "text": "Les clés créées par hachage ne sont pas forcément uniques : on parle alors de collision."
                            }
                        ]
                    },
