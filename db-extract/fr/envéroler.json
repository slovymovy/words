                "senses": [
                    {
                        "sense_id": "5013fd03-92fa-3b8a-b47c-7feaa421ee1e",
                        "entry_id": "06744db9-b987-380d-943f-18f5bd9a9db3",
                        "glosses": [
                            "Transmettre la vérole à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dfc5b0d-e12a-4ed5-8cf4-a59a71d75181",
                                "sense_id": "5013fd03-92fa-3b8a-b47c-7feaa421ee1e",
                                "text": "Le sieur Lebray, la Brissault et la Bertrand ont fait si bien depuis quelques mois que de lever une troupe de sultanes capables d’envéroler en une nuit tout le royaume de Sicile."
                            },
                            {
                                "example_id": "f725292b-4c41-4aab-a0fb-610cd527a465",
                                "sense_id": "5013fd03-92fa-3b8a-b47c-7feaa421ee1e",
                                "text": "Il résulterait de là qu'on a la faculté de subir deux ou trois fois de suite une contagion nouvelle et de « s'envéroler coup sur coup », comme on le disait autrefois."
                            }
                        ]
                    }
