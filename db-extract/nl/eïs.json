                    {
                        "sense_id": "9e3ba237-354a-38cf-916b-f3c78b75c3de",
                        "entry_id": "02576373-e4e8-3a7d-9f9d-c2b7c57aa24f",
                        "glosses": [
                            "een met een halve toon verhoogde toon \\\"e\\"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b2e153c-eb07-4d4d-a23f-c6b04d4d9323",
                                "sense_id": "9e3ba237-354a-38cf-916b-f3c78b75c3de",
                                "text": "De toon “eïs” klinkt in de getempereerde stemming gelijk aan de toon “f”."
                            }
                        ]
                    },
                    {
                        "sense_id": "bef93e37-0ae3-34a7-9a5e-b5a9986c94b2",
                        "entry_id": "02576373-e4e8-3a7d-9f9d-c2b7c57aa24f",
                        "glosses": [
                            "de grondtoon (tonica) van de “eïs-mineurtoonladder”, tevens een korte aanduiding van die toonladder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38aa09dc-540a-4f0a-9ea2-46ab743e1496",
                                "sense_id": "bef93e37-0ae3-34a7-9a5e-b5a9986c94b2",
                                "text": "Op de notenbalk van een etude in eïs, staan acht kruisen als voortekens."
                            }
                        ]
                    },
                    {
                        "sense_id": "67a696ca-0da8-3f4d-984c-53c49b9dd1a1",
                        "entry_id": "02576373-e4e8-3a7d-9f9d-c2b7c57aa24f",
                        "glosses": [
                            "de grondtoon van het “eïs-mineurakkoord”, de kleine drieklank op de eerste trap (tonica-akkoord) van de kleinetertstoonladder op die toon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "896903eb-d2ab-4515-ba03-d013a44e5f13",
                                "sense_id": "67a696ca-0da8-3f4d-984c-53c49b9dd1a1",
                                "text": "De drie tonen van het eïs-mineurakkoord (symbool: E#m) in grondligging, zijn: eïs - gis - bis."
                            }
                        ]
                    }
                ],
