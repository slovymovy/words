                "senses": [
                    {
                        "sense_id": "cce887e7-d406-306e-a220-09294755c35c",
                        "entry_id": "27aad06d-dc33-32be-9355-c569c030adb7",
                        "glosses": [
                            "medizinische Disziplin, die sich mit Sprachstörungen und Sprachentwicklungsstörungen aller Art befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d710a9c0-6f91-4c75-a818-b03cff5efc7f",
                                "sense_id": "cce887e7-d406-306e-a220-09294755c35c",
                                "text": "„Heute wird Logopädie üblicherweise als Bezeichnung für eine interdisziplinäre Wissenschaft verstanden, in der insbesondere die Psycho- und Neurolinguistik, die Psychologie, die mit Sprach-, Stimm- und Hörstörungen (Hörschädigung) befaßten medizinischen Fachrichtungen und die Hör- und Sprachbehindertenpädagogik eingehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1afbf3d3-0c8b-40c6-b76e-af790ff4599b",
                        "source_entry_id": "27aad06d-dc33-32be-9355-c569c030adb7",
                        "source_sense_id": "cce887e7-d406-306e-a220-09294755c35c",
