{
    "word_family": [
        "crooked",
        "crookedly",
        "crookedness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8a0b413d-ad7e-33fe-9b51-d675a36c7e95",
                    "sense_definition": "A bend or curve in something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She held the sleeping baby in the <w>crook</w> of her arm.",
                            "target_lang_translations": {
                                "fr": "Elle tenait le bébé endormi dans le <w>creux</w> de son bras."
                            }
                        },
                        {
                            "text": "The river makes a sharp <w>crook</w> near the old bridge.",
                            "target_lang_translations": {
                                "fr": "La rivière forme un <w>coude</w> prononcé près du vieux pont."
                            }
                        }
                    ],
                    "common_phrases": [
                        "crook of the arm"
                    ],
                    "target_lang_definitions": {
                        "fr": "Une courbure ou un pli dans quelque chose."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "courbure",
                                "target_lang_sense_clarification": "La forme courbe d'un objet ou d'une ligne."
                            },
                            {
                                "target_lang_word": "pli",
                                "target_lang_sense_clarification": "Un repli ou une flexion dans une surface."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df10bab9-9a08-3913-873b-d925624e9e0c",
                    "sense_definition": "A person who acts dishonestly or illegally.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "criminal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police finally caught the <w>crook</w> who had been stealing from local shops.",
                            "target_lang_translations": {
                                "fr": "La police a finalement attrapé l'<w>escroc</w> qui volait dans les magasins locaux."
                            }
                        },
                        {
                            "text": "He claimed he was innocent and told the judge he was not a <w>crook</w>.",
                            "target_lang_translations": {
                                "fr": "Il a clamé son innocence et a dit au juge qu'il n'était pas un <w>malfaiteur</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "criminal"
                    ],
                    "target_lang_definitions": {
                        "fr": "Une personne qui agit de manière malhonnête ou illégale."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "escroc",
                                "target_lang_sense_clarification": "Personne qui trompe autrui pour obtenir de l'argent."
                            },
                            {
                                "target_lang_word": "arnaqueur",
                                "target_lang_sense_clarification": "Personne qui pratique des arnaques ou des fraudes."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b63141d-b204-31e8-b00b-e4553c08ecdb",
                    "sense_definition": "A long staff with a curved top used by shepherds.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shepherd leaned on his <w>crook</w> while watching the sheep graze.",
                            "target_lang_translations": {
                                "fr": "Le berger s'appuyait sur sa <w>houlette</w> en regardant les moutons paître."
                            }
                        },
                        {
                            "text": "He used the <w>crook</w> to gently guide the lamb back to the flock.",
                            "target_lang_translations": {
                                "fr": "Il a utilisé sa <w>houlette</w> pour guider doucement l'agneau vers le troupeau."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Un long bâton avec une extrémité recourbée utilisé par les bergers."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "houlette",
                                "target_lang_sense_clarification": "Bâton traditionnel de berger."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "41df0ef6-0c03-32ad-9875-2f8d60e0e114",
                    "sense_definition": "To bend something into a curved shape.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>crooked</w> his finger to signal for her to come closer.",
                            "target_lang_translations": {
                                "fr": "Il a <w>courbé</w> son doigt pour lui faire signe de s'approcher."
                            }
                        },
                        {
                            "text": "She <w>crooked</w> her arm to hold the heavy bag more comfortably.",
                            "target_lang_translations": {
                                "fr": "Elle a <w>plié</w> le bras pour porter le sac lourd plus confortablement."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Plier quelque chose pour lui donner une forme courbe."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "courber",
                                "target_lang_sense_clarification": "Donner une forme courbe à un objet."
                            },
                            {
                                "target_lang_word": "plier",
                                "target_lang_sense_clarification": "Donner une forme courbée ou pliée."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6fce84e5-11d0-3172-b3fe-714ee279d895",
                    "sense_definition": "Feeling ill or sick.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I think I ate something bad because I am feeling a bit <w>crook</w> today.",
                            "target_lang_translations": {
                                "fr": "Je pense que j'ai mangé quelque chose de mauvais car je me sens un peu <w>malade</w> aujourd'hui."
                            }
                        },
                        {
                            "text": "He stayed home from work because he was feeling <w>crook</w>.",
                            "target_lang_translations": {
                                "fr": "Il est resté à la maison car il se sentait <w>indisposé</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in Australian and New Zealand English."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Se sentir malade ou souffrant."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "malade",
                                "target_lang_sense_clarification": "État de santé altéré."
                            },
                            {
                                "target_lang_word": "indisposé",
                                "target_lang_sense_clarification": "Se sentir légèrement souffrant."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "44c46e70-3223-382d-b81a-8417f24d52c2",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historical figure George <w>Crook</w> was a famous general.",
                            "target_lang_translations": {
                                "fr": "La figure historique George <w>Crook</w> était un général célèbre."
                            }
                        },
                        {
                            "text": "I met a man named Mr. <w>Crook</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "fr": "J'ai rencontré un homme nommé M. <w>Crook</w> à la conférence hier."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Un nom de famille."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "Crook",
                                "target_lang_sense_clarification": "nom de famille; ne se traduit pas"
                            }
                        ]
                    }
                }
            ]
        }
    ]
