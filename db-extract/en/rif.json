                ],
                "senses": [
                    {
                        "sense_id": "72ba7064-c76f-3566-a973-b93c2c4a766f",
                        "entry_id": "ae11415a-1637-33d0-89cf-2af67fafd420",
                        "glosses": [
                            "Alternative letter-case form of RIF."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e1ca3f48-7a4e-4980-b307-d7a2d21c082f",
                                "sense_id": "72ba7064-c76f-3566-a973-b93c2c4a766f",
                                "text": "This sense was expressed in a story about a friend who had been laid off (riffed) in a particularly uncaring manner."
                            },
                            {
                                "example_id": "c6dbdea7-e337-4fb9-bb75-5c78e5f75d5c",
                                "sense_id": "72ba7064-c76f-3566-a973-b93c2c4a766f",
                                "text": "If an employee is not given concrete and objective reasons for being riffed, it may be assumed the decision, \"must have been discrimination\" due to race, sex, age, ethnic background, or other wrongful basis."
                            },
                            {
                                "example_id": "fb333e90-3ae0-4c55-ad6d-328c48deb43d",
                                "sense_id": "72ba7064-c76f-3566-a973-b93c2c4a766f",
                                "text": "People are being riffed at her company, too."
                            }
                        ]
                    }
                ],
