                "senses": [
                    {
                        "sense_id": "a321e02e-f78e-3e4d-88f9-d50cf1359c06",
                        "entry_id": "779f0fa8-0feb-39c7-9194-5158ea4b0a27",
                        "glosses": [
                            "Verbot, die Fahrtrichtung bogenartig zu ändern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4babb872-8b8d-4966-acf7-459d64de6fd9",
                                "sense_id": "a321e02e-f78e-3e4d-88f9-d50cf1359c06",
                                "text": "„Um eine korrekte Routenberechnung und Zielführung zu ermöglichen, sind Knoten und Kanten raumbezogene Attribute wie Straßenart, Einbahnstraßenrichtung, Abbiegeverbote, Zufahrten, Sperrungen, Brücken, Tunnels, Über- und Unterführungen zugewiesen.“"
                            },
                            {
                                "example_id": "0c670a5b-9747-4153-9345-4a489b568e35",
                                "sense_id": "a321e02e-f78e-3e4d-88f9-d50cf1359c06",
                                "text": "„Aufgrund genauer Analysen legt die Kommission verkehrspolizeiliche, verkehrsregelnde und bauliche Maßnahmen fest, die Abhilfe versprechen – von erneuerter oder veränderter Markierung, Verkehrszeichen, Abbiegeverboten, verbesserter Ampelschaltung oder Aufstellung von Ampeln bis zum Umbau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
