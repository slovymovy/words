                "senses": [
                    {
                        "sense_id": "c80f8876-e00d-338a-a7e7-3d3011902756",
                        "entry_id": "e4ddb097-f81e-3f87-859d-1320aeade693",
                        "glosses": [
                            "Flasche, in der Gin aufbewahrt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78eabbfb-8510-45b3-bc86-a9408ab6a954",
                                "sense_id": "c80f8876-e00d-338a-a7e7-3d3011902756",
                                "text": "„Drinnen saßen zwei weiße Männer auf Stühlen vor einem Kanonenofen, auf dem Tisch in der Ecke hinter ihnen standen eine Kerosinlaterne und eine leere Ginflasche.“"
                            },
                            {
                                "example_id": "ab732ec6-67fe-4b4a-b039-6d17c0ce4a39",
                                "sense_id": "c80f8876-e00d-338a-a7e7-3d3011902756",
                                "text": "„›Genug von Small Talk‹, sagte der Schiffer und drehte demonstrativ seine leere Ginflasche um.“"
                            },
                            {
                                "example_id": "e0b3d808-2c8d-448c-bab7-a6eee03fdcc2",
                                "sense_id": "c80f8876-e00d-338a-a7e7-3d3011902756",
                                "text": "„›Tut mit leid, Vanessa!‹, schrie Crisp, der sein Ziel mit der Ginflasche knapp verfehlte.“"
                            },
                            {
                                "example_id": "c251f7bf-e810-4627-8c39-19395c442400",
                                "sense_id": "c80f8876-e00d-338a-a7e7-3d3011902756",
                                "text": "„Ihr Blick fiel auf die Ginflasche.“"
                            },
                            {
                                "example_id": "b13495b5-bba3-487b-81f9-43e44fd6b7f1",
                                "sense_id": "c80f8876-e00d-338a-a7e7-3d3011902756",
                                "text": "„In der Hand hielt ich die kleine Ginflasche aus der Minibar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
