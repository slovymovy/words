                "senses": [
                    {
                        "sense_id": "cd4b02d8-7a6c-3f68-9b83-a7c4c9a97411",
                        "entry_id": "f18967bd-232b-3af8-9125-31126f070bd0",
                        "glosses": [
                            "Tätigkeit/Organisation, die das Ausspionieren durch fremde Mächte im eigenen Land verhindern soll; eigene Agententätigkeit, die darauf ausgerichtet ist, Wissen über fremde Agenten (Spione) zu erhalten, die (im eigenen Land) gegen einen spionieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf714cc1-ed88-40e1-9674-60ed6783c07d",
                                "sense_id": "cd4b02d8-7a6c-3f68-9b83-a7c4c9a97411",
                                "text": "„Das beste Werkzeug der Gegenspionage ist die »compartmentalization« (Abschottung). Dabei wird der Zugang zu geheimdienstlichen Erkenntnissen innerhalb des eigenen Dienstes auf Abteilungen oder Zellen beschränkt.“"
                            },
                            {
                                "example_id": "f3545f31-98e4-4b5a-951b-ea967a90561a",
                                "sense_id": "cd4b02d8-7a6c-3f68-9b83-a7c4c9a97411",
                                "text": "„Auch bei der Gegenspionage bot der Mossad Unterstützung. Agenten der Unterabteilung IV D (Sicherheit) flogen im Oktober 1970 nach Israel, um ehemalige Offiziere des polnischen Nachrichtendienstes zu befragen.“"
                            },
                            {
                                "example_id": "090f8329-9076-4417-b13e-f612f121cb0b",
                                "sense_id": "cd4b02d8-7a6c-3f68-9b83-a7c4c9a97411",
                                "text": "„Bei der Gegenspionage (Counterintelligence)/Spionageabwehr (Counterespionage) (englischer Sammelbegriff: Countering) handelt es sich um jenen Bereich, der Staat und Gesellschaft am stärksten durchdringt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
