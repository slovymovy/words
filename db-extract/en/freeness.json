                        "entry_id": "e379232a-db69-330a-a992-866069530f87",
                        "glosses": [
                            "The state or condition of being free (unconstrained, unconfined, unencumbered, unobstructed, or free-spirited)."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "2b561753-175f-4724-9da3-097c30151b18",
                                "sense_id": "95b465d8-4f9d-37b7-a938-6559903504ad",
                                "text": "Whoever would overthrow the Liberty of a Nation, must begin by subduing the Freeness of Speech; a Thing terrible to Publick Traytors."
                            },
                            {
                                "example_id": "1d2069b3-bce9-42b4-a1e7-720ff39458fe",
                                "sense_id": "95b465d8-4f9d-37b7-a938-6559903504ad",
                                "text": "Vern could appreciate his freeness. He was a spirited, buoyant thing."
                            }
                        ]
                    },
                    {
                        "sense_id": "dad4e9df-bf40-3c8e-9556-6151b3ae7b79",
                        "entry_id": "e379232a-db69-330a-a992-866069530f87",
                        "glosses": [
                            "Openness; unreservedness; frankness; ingenuousness; candor."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "25a4732c-2c03-40b7-9a95-107fab1de25d",
                                "sense_id": "dad4e9df-bf40-3c8e-9556-6151b3ae7b79",
                                "text": "The freeness of a confession."
                            }
                        ]
                    },
                    {
