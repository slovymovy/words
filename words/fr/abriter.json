{
    "word_family": [
        "abri"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8b2be17f-071a-3c6a-875a-a08c32e27384",
                    "sense_definition": "Mettre à l'abri, protéger des intempéries ou d'un danger.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce grand hangar en bois <w>abrite</w> tout le matériel agricole contre l'humidité."
                        },
                        {
                            "text": "Les propriétaires ont installé un toit pour <w>abriter</w> les vélos de la pluie."
                        }
                    ],
                    "synonyms": [
                        "protéger",
                        "couvrir"
                    ],
                    "antonyms": [
                        "exposer"
                    ],
                    "common_phrases": [
                        "abriter du vent",
                        "abriter de la pluie"
                    ]
                },
                {
                    "sense_id": "53c2b0b2-3bf9-371b-9569-8478164fcebe",
                    "sense_definition": "Se mettre en lieu sûr pour se protéger des intempéries ou d'une menace.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès que l'orage a éclaté, nous avons couru nous <w>abriter</w> sous un porche."
                        },
                        {
                            "text": "Les randonneurs surpris par la grêle s'<w>abritent</w> dans une petite cabane."
                        }
                    ],
                    "synonyms": [
                        "se réfugier",
                        "se protéger"
                    ],
                    "antonyms": [
                        "s'exposer"
                    ],
                    "common_phrases": [
                        "s'abriter de la pluie",
                        "s'abriter sous un porche"
                    ]
                },
                {
                    "sense_id": "41e7066c-357f-33d8-9fdd-67bb10368d40",
                    "sense_definition": "Contenir, loger ou servir de lieu d'accueil pour des personnes, des objets ou des manifestations.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce musée moderne <w>abrite</w> une collection remarquable d'œuvres d'art contemporain."
                        },
                        {
                            "text": "Cette réserve naturelle préservée <w>abrite</w> de nombreuses espèces d'oiseaux migrateurs."
                        }
                    ],
                    "synonyms": [
                        "accueillir",
                        "contenir",
                        "héberger",
                        "loger"
                    ],
                    "common_phrases": [
                        "abriter une collection",
                        "abriter des espèces menacées"
                    ]
                },
                {
                    "sense_id": "8f98efea-e5aa-39f7-9e49-d571900190dd",
                    "sense_definition": "Invoquer un motif, un prétexte ou une règle pour se justifier ou éluder une responsabilité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur refuse de répondre en s'<w>abritant</w> derrière le secret professionnel."
                        },
                        {
                            "text": "Vous ne pouvez pas toujours vous <w>abriter</w> derrière la complexité du règlement."
                        }
                    ],
                    "synonyms": [
                        "se retrancher"
                    ],
                    "common_phrases": [
                        "s'abriter derrière un prétexte",
                        "s'abriter derrière la loi"
                    ]
                }
            ]
        }
    ]
}