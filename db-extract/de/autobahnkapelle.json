                "senses": [
                    {
                        "sense_id": "c9b29a80-5075-3897-b7bf-fe3c1153a255",
                        "entry_id": "deded7db-0e3a-3853-8ee8-06d83ca7b217",
                        "glosses": [
                            "einfach gestaltetes Gotteshaus oder abgeteilter Bereich in etwas, der für persönliche Andachten oder auch Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a62954eb-f8cc-4e81-b19d-81d056faf87f",
                                "sense_id": "c9b29a80-5075-3897-b7bf-fe3c1153a255",
                                "text": "„Bei der Planung, nach Entwürfen von Josef Wulf (Geeste), hat man sich ganz bewusst für eine traditionelle Bauweise der Region, im emsländischen Stil eines Backhauses/Brothauses, entschieden und so die ökumenische Autobahnkapelle „Jesus, Brot des Lebens“ geschaffen."
                            },
                            {
                                "example_id": "08bc4f97-b805-4051-92b1-ebbf55de8958",
                                "sense_id": "c9b29a80-5075-3897-b7bf-fe3c1153a255",
                                "text": "„Der Wegweiser zur Autobahnkapelle in Adelsried.“"
                            },
                            {
                                "example_id": "2b36e315-9991-4846-9129-6b4316ebda84",
                                "sense_id": "c9b29a80-5075-3897-b7bf-fe3c1153a255",
                                "text": "„\"Es ist ein bewegender Moment. Ein langjähriger Traum, der in Erfüllung geht\", sagt Christusträger-Schwester Angela, als sie mit glänzenden Augen vor der Autobahnkapelle steht. “"
                            },
                            {
                                "example_id": "df625e9e-45c8-4809-8406-263e6affde98",
                                "sense_id": "c9b29a80-5075-3897-b7bf-fe3c1153a255",
                                "text": "„Am 1. Advent 2009 wurde die Autobahnkapelle Hamm im ehemaligen Tankstellengebäude Rhynern-Nord an der Autobahn A 2 eingeweiht.“"
                            },
                            {
                                "example_id": "1aa23e02-1d44-4f92-9ea9-629b0c7aaac8",
                                "sense_id": "c9b29a80-5075-3897-b7bf-fe3c1153a255",
                                "text": "„Am Sonntag wurde in der Autobahnkapelle „Maria - Schutz der Reisenden“ das Ende der 19-monatigen Renovierungsarbeiten gefeiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
