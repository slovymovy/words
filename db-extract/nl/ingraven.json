                "senses": [
                    {
                        "sense_id": "580de897-0155-31cc-a8f0-ff81a89634d4",
                        "entry_id": "7ffe0bde-8cc0-3186-8318-2067b0ca999f",
                        "glosses": [
                            "zich ~: door een gat of graaf aan te leggen zich dekking verschaffen"
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "884ed82e-4071-4463-846d-497ed7e48104",
                                "sense_id": "580de897-0155-31cc-a8f0-ff81a89634d4",
                                "text": "De Eerste Wereldoorlog zag het merendeel van de strijdkrachten zich ingraven aan een statisch front."
                            }
                        ]
                    },
                    {
                        "sense_id": "31053018-3379-3299-a31e-d57d31a1e9ae",
                        "entry_id": "7ffe0bde-8cc0-3186-8318-2067b0ca999f",
                        "glosses": [
                            "zich ~ zich nestelen in de bodem of in het lichaam van een andere levensvorm"
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "5d75d47e-8970-48ba-8b11-1952e0f02279",
                                "sense_id": "31053018-3379-3299-a31e-d57d31a1e9ae",
                                "text": "Deze parasiet graaft zich in in de huid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94c8aba9-08ae-4dc0-b76a-c705410f87a4",
                        "source_entry_id": "7ffe0bde-8cc0-3186-8318-2067b0ca999f",
                        "source_sense_id": "580de897-0155-31cc-a8f0-ff81a89634d4",
                        "source_sense_description": "door een gat of graaf aan te leggen zich dekking verschaffen",
                        "target_lang_word": "einbuddeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einbuddeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d6c4b96-1dd8-32bf-85cf-abb5444c2ac6",
                                        "entry_id": "e5552885-1223-37c9-b5ee-f0718c5d6b8a",
                                        "glosses": [
                                            "eingraben; in der Erde vergraben"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17676761-fd10-4c0a-9871-cfd9a8cfe1a1",
                                                "sense_id": "4d6c4b96-1dd8-32bf-85cf-abb5444c2ac6",
                                                "text": "Und wo hat der Hund jetzt wieder den Knochen eingebuddelt? Nicht in meinem Rosenbeet, hoffe ich!"
                                            },
                                            {
                                                "example_id": "b9f834b0-386f-4b3b-b305-1f4b103b0bbd",
                                                "sense_id": "4d6c4b96-1dd8-32bf-85cf-abb5444c2ac6",
                                                "text": "Wir können doch die Leiche nicht einfach in Nachbars Garten einbuddeln."
                                            },
                                            {
                                                "example_id": "25ddee9d-0755-4161-a3af-e22efb2a560b",
                                                "sense_id": "4d6c4b96-1dd8-32bf-85cf-abb5444c2ac6",
                                                "text": "Fliegeralarm! Jeder muss sich einbuddeln, wo er gerade steht."
                                            },
                                            {
                                                "example_id": "da7f3a1a-3584-44fe-aa05-d310bbdeccb4",
                                                "sense_id": "4d6c4b96-1dd8-32bf-85cf-abb5444c2ac6",
                                                "text": "Ich kann gar nicht so schnell gucken, wie die Maus sich einbuddelt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60f03414-a9a4-4c54-a4d1-2acf5b28b0cd",
                        "source_entry_id": "7ffe0bde-8cc0-3186-8318-2067b0ca999f",
                        "source_sense_id": "580de897-0155-31cc-a8f0-ff81a89634d4",
                        "source_sense_description": "door een gat of graaf aan te leggen zich dekking verschaffen",
                        "target_lang_word": "eingraben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eingraben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9ab9d7e-bdd1-306d-9c03-af30b170775d",
                                        "entry_id": "bd965311-3dc4-30ed-a58a-d5aadb6d4cc1",
                                        "glosses": [
                                            "unter die Erde bringen, in der Erde vergraben/verankern"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55d6bf56-7d19-48d6-984e-3098452f74e1",
                                                "sense_id": "e9ab9d7e-bdd1-306d-9c03-af30b170775d",
                                                "text": "Du solltest den Müll nicht eingraben, sondern zur Müllstation fahren!"
                                            },
                                            {
                                                "example_id": "a3afb6bf-48b7-4b16-b19b-4bb1455e9ce0",
                                                "sense_id": "e9ab9d7e-bdd1-306d-9c03-af30b170775d",
                                                "text": "Wir können den Betonpfeiler bis zur Hälfte eingraben, dann hat er noch mehr Stabilität."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05a7b66f-b761-3b47-8c2c-dece4306571b",
                                        "entry_id": "bd965311-3dc4-30ed-a58a-d5aadb6d4cc1",
                                        "glosses": [
                                            "eine Oberfläche durch Druck deformieren, eine Spur hinterlassen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b533e15b-9091-4cd5-8ea0-920e91de7f6c",
                                                "sense_id": "05a7b66f-b761-3b47-8c2c-dece4306571b",
                                                "text": "Tiefe Falten hatten sich in ihre Stirn eingegraben."
                                            },
                                            {
                                                "example_id": "aeaba683-ca3a-43e0-8710-d4f642b1c613",
                                                "sense_id": "05a7b66f-b761-3b47-8c2c-dece4306571b",
                                                "text": "Ihre Fingernägel gruben sich in die zarte Haut ein."
                                            },
                                            {
