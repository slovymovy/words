        "fr-extract.jsonl": [
            {
                "entry_id": "6e58e19d-cef9-3490-8ce4-2bc3023b4277",
                "word": "impérieusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d254e8c1-d54e-37c8-a379-e2545660432a",
                        "entry_id": "6e58e19d-cef9-3490-8ce4-2bc3023b4277",
                        "glosses": [
                            "Avec hauteur, d’un ton de commandement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21b1d30e-8ae6-47c4-ac01-8f8802c1fa1b",
                                "sense_id": "d254e8c1-d54e-37c8-a379-e2545660432a",
                                "text": "Le pécheur, voyant la parole divine venir à lui impérieusement pour détruire ces idoles pompeuses qu’il a élevées."
                            },
                            {
                                "example_id": "01381bf7-c369-44fd-b13a-45986674cc73",
                                "sense_id": "d254e8c1-d54e-37c8-a379-e2545660432a",
                                "text": "Lorsqu'elle a donné à son public ce qu'il attendait d'elle, elle pivote impérieusement, lance un dédaigneux regard dans sa direction avant de regagner de façon tout aussi déterminée le monde à part dans lequel ne vivent que les tops, les créateurs et les millionnaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f67721e-34b1-38cd-8db3-898ac2ab4ce4",
                        "entry_id": "6e58e19d-cef9-3490-8ce4-2bc3023b4277",
                        "glosses": [
                            "Par une nécessité absolue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d33470e5-89fc-4f85-a704-5378cb3d4cf4",
                                "sense_id": "4f67721e-34b1-38cd-8db3-898ac2ab4ce4",
                                "text": "Il est de son devoir, et de ceux de sa maison, de vous rendre les soins assidus que réclame impérieusement votre état actuel."
                            },
                            {
                                "example_id": "44749e21-a71c-43d9-b51c-e6a8ef9cbd4a",
                                "sense_id": "4f67721e-34b1-38cd-8db3-898ac2ab4ce4",
                                "text": "Dans la rue, un son de cor a éclaté, un air de chasse… Apparemment, quelque piqueur de grande maison, debout près d’un comptoir de cabaret, les joues gonflées, la bouche impérieusement serrée, l’air féroce, émerveille et fait taire l’assistance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f485a912-5c4a-434a-8d65-63d7511c4445",
                        "source_entry_id": "6e58e19d-cef9-3490-8ce4-2bc3023b4277",
                        "target_lang_word": "commandingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commandingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a307b209-2d8c-3c33-87fb-1b14ab5717ac",
                                        "entry_id": "184a7722-cd23-3f5c-b476-ee52162198fe",
                                        "glosses": [
                                            "In a commanding fashion."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "368a4ca4-1921-4d4b-ac75-7905b4287dc8",
                                                "sense_id": "a307b209-2d8c-3c33-87fb-1b14ab5717ac",
                                                "text": "And yet, somehow, did Ahab—in his own proper self, as daily, hourly, and every instant, commandingly revealed to his subordinates,—Ahab seemed an independent lord […]"
                                            },
                                            {
                                                "example_id": "aaf5316a-6e43-4622-994a-dedfc3e8dd3f",
                                                "sense_id": "a307b209-2d8c-3c33-87fb-1b14ab5717ac",
                                                "text": "She could see it all so clearly, so commandingly, when she looked: it was when she took her brush in hand that the whole thing changed."
                                            },
                                            {
                                                "example_id": "1ab41c94-d27a-4ac4-b093-af6a2eb1fbdf",
                                                "sense_id": "a307b209-2d8c-3c33-87fb-1b14ab5717ac",
                                                "text": "“Delightful idea,” said Lady Partridge. […] / “It is, I believe, an irresistible one,” said Lipscomb, laying his left hand commandingly on the table."
                                            },
                                            {
                                                "example_id": "8916e1e7-32e3-4f62-b0b1-401df7135aa5",
                                                "sense_id": "a307b209-2d8c-3c33-87fb-1b14ab5717ac",
                                                "text": "“I ordered for the table,” she says, commandingly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc6ba019-42ad-4d0c-a421-1a425de55b8d",
                        "source_entry_id": "6e58e19d-cef9-3490-8ce4-2bc3023b4277",
                        "target_lang_word": "imperiously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imperiously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af9f39e6-2789-3ddd-b88a-b585cd29316d",
                                        "entry_id": "d50f903e-7d44-3e16-8061-f950258a4cf0",
                                        "glosses": [
                                            "In an imperious manner; in the style of an emperor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "865bd7b5-ab0f-474b-8a7c-17334f6f7372",
                                                "sense_id": "af9f39e6-2789-3ddd-b88a-b585cd29316d",
                                                "text": "Reversing the car I got the headlights on the bird sitting on the roadside fencepost to reveal a Powerful Owl imperiously staring back at us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "139087cb-8682-37b0-a5e4-3ad35898b665",
                                        "entry_id": "d50f903e-7d44-3e16-8061-f950258a4cf0",
                                        "glosses": [
                                            "In a way that brooks no refusal; commandingly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb9d8ef4-8895-4c4e-a5f8-c35c17110fe7",
                                                "sense_id": "139087cb-8682-37b0-a5e4-3ad35898b665",
                                                "text": "Something up above was calling him imperiously[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
