                        "glosses": [
                            "книжн. свойство по значению прилагательного аутентичный; подлинность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5803b365-bd86-4355-88f3-51589b77cb99",
                                "sense_id": "de7bef7b-69c2-34e0-88ca-792705510766",
