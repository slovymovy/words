                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tourterelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "584956d1-6a69-3f02-9d62-471b80384536",
                                        "entry_id": "1c52a9e5-defa-3491-9748-c44443cd2a21",
                                        "glosses": [
                                            "Nom vernaculaire ou normalisé de plusieurs genres d'oiseaux de la famille des columbidés de taille inférieure au pigeon, à queue généralement plus longue et effilée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48e30810-4985-48c5-b5c6-c29e3be9133c",
                                                "sense_id": "584956d1-6a69-3f02-9d62-471b80384536",
                                                "text": "Une tourterelle roucoula et avança sa tête, hors de son nid, pour montrer son anneau conjugal."
                                            },
                                            {
                                                "example_id": "5dadcaf6-91c3-432d-b67e-0bb324844c86",
                                                "sense_id": "584956d1-6a69-3f02-9d62-471b80384536",
                                                "text": "Par intervalles, quand un rayon de lune, crevant d’argent les nuages gonflés de chaleur, lui fait croire au jeune soleil, une tourterelle roucoule dans les palmeraies."
                                            },
                                            {
                                                "example_id": "62cf2784-ae4a-496e-9d31-dcc60f7e077c",
                                                "sense_id": "584956d1-6a69-3f02-9d62-471b80384536",
                                                "text": "Tamesloht est la cité des oiseaux : sous la claire lumière, des merles, des moineaux et des tourterelles volent sans cesse d’un arbre à l’autre, au milieu de la végétation surabondante, des « tbibits », petits oiseaux particuliers à la région de Marrakech, semblent chez eux ici, et viennent familièrement se disputer les miettes des repas dans les appartements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e21db06-0927-344a-83c0-3464775a97eb",
                                        "entry_id": "1c52a9e5-defa-3491-9748-c44443cd2a21",
                                        "glosses": [
                                            "Couleur grise légèrement rosée. #BBACAC"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6cba71f2-5994-37af-8b7d-0c8b6e32afd9",
                                        "entry_id": "1c52a9e5-defa-3491-9748-c44443cd2a21",
                                        "glosses": [
                                            "Crécelle"
                                        ],
                                        "tags": [
                                            "Régionalisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78acc015-dfdd-43e6-b6ea-f19b2231ccca",
                                                "sense_id": "6cba71f2-5994-37af-8b7d-0c8b6e32afd9",
                                                "text": "Il y a des claquoirs simples ou doubles, que l'on appelle : claquoirs, battoirs, crécelles ou cricri, routelles, tartarelles ou tourterelles, dont la forme la plus connue est celle de Corbie, qui ressemble à un tonnelet de fer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69dd430b-be95-3367-90b5-c024190007aa",
                                        "entry_id": "1c52a9e5-defa-3491-9748-c44443cd2a21",
                                        "glosses": [
                                            "Meuble représentant l’animal du même nom dans les armoiries. Elle se blasonne comme le pigeon dont elle ne diffère pas vraiment (il y a donc risque de confusion) si ce n’est par le fait qu’elle est généralement représentée de sable (même si d’autres couleurs sont possibles). À rapprocher de colombe et pigeon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f923c856-195e-465f-b8f7-37b399b3e956",
                                                "sense_id": "69dd430b-be95-3367-90b5-c024190007aa",
                                                "text": "D’or au chevron de sable accompagné de deux tourterelles du même se regardant et en pointe une quintefeuille de gueules, qui est de l’Abbé Alexandre Slootmans → voir illustration « armoiries avec 2 tourterelles »"
                                            }
                                        ]
                                    }
                                ]
                            }
