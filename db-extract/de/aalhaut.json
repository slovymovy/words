                                        "entry_id": "69e54b7c-2d24-3cc4-846f-90053f07e02d",
                                        "glosses": [
                                            "the skin of a hagfish"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b876e71-1f0e-4944-ad92-ba1b73890653",
                                                "sense_id": "4884e20b-85da-3723-a1ad-a1d7f31f77e5",
                                                "text": "She paid for three eelskins."
                                            },
                                            {
                                                "example_id": "fb2dc7c3-1ad3-4a50-b476-1688c939de2b",
                                                "sense_id": "4884e20b-85da-3723-a1ad-a1d7f31f77e5",
                                                "text": "He had an eelskin wallet."
                                            },
                                            {
                                                "example_id": "5bcdeb7d-478b-4c37-af06-19007590f9e9",
                                                "sense_id": "4884e20b-85da-3723-a1ad-a1d7f31f77e5",
                                                "text": "Wear an eelskin around your waist to keep off rheumatism. Some say they had rather have the rheumatism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
