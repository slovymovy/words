                    {
                        "sense_id": "52a95c78-d789-3206-9851-b0dac17f4122",
                        "entry_id": "6d27bc9c-0b77-3b98-9c10-5228e5489384",
                        "glosses": [
                            "An ancient kind of brooch used to hold clothing together, similar in function to the modern safety pin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d44266d-71c6-45d4-8018-37975f5c098f",
                                "sense_id": "52a95c78-d789-3206-9851-b0dac17f4122",
                                "text": "Most of the fibulae have a triangular molding above the notch, which probably contained wound wire. The crossbar is decorated either with a flat knob or with a Persian merlon."
                            }
                        ]
                    },
                    {
                        "sense_id": "e67f202e-8c82-356f-9f67-c4de2f500271",
                        "entry_id": "6d27bc9c-0b77-3b98-9c10-5228e5489384",
                        "glosses": [
                            "The smaller of the two bones in the lower leg."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12615896-6dd5-48e1-8b23-32bf08949944",
                        "source_entry_id": "6d27bc9c-0b77-3b98-9c10-5228e5489384",
                        "source_sense_description": "ancient brooch",
                        "target_lang_word": "fibule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fibule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68b9f1f9-2698-3121-a5a0-9900f77d88ae",
                                        "entry_id": "8c7de435-fadd-34fb-88e0-da13e7c765ab",
                                        "glosses": [
                                            "Agrafe dont se servaient les anciens pour retenir les extrémités d’un vêtement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d6a998c-24a8-4b41-8c5f-998d7ac2b341",
                                                "sense_id": "68b9f1f9-2698-3121-a5a0-9900f77d88ae",
                                                "text": "… la tombe renfermait une belle fibule cruciforme en or, similaire à celle que portaient les hauts fonctionnaires romains."
                                            },
                                            {
                                                "example_id": "6edfb965-e8a1-4f4b-90fc-0f02cf4ba41f",
                                                "sense_id": "68b9f1f9-2698-3121-a5a0-9900f77d88ae",
                                                "text": "Une fibule de Nauheim en bronze, complète et fermée, a été découverte dans le comblement du négatif du poteau P9."
                                            },
                                            {
                                                "example_id": "cb3aeae3-6cc2-4578-99b5-e2d8bb788bb6",
                                                "sense_id": "68b9f1f9-2698-3121-a5a0-9900f77d88ae",
                                                "text": "Il ouvrit une boîte bleue qui était sur son bureau. Et Zybine, fasciné, aperçut des paillettes, des copeaux jaune pâle, de minuscules rondelles, des pendants d’oreilles, des fibules, des figurines d’êtres humains, de chevaux, de bêtes sauvages, un grouillement d’or, cet or des sépultures qu’il connaissait si bien."
                                            }
                                        ]
                                    }
                                ]
                            },
