                            {
                                "target_lang_word": "инстаграм",
                                "target_lang_sense_clarification": "полное название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e866abd-7714-3bd3-887f-925ff4be69c0",
                    "sense_definition": "A leguminous plant grown for its seeds, such as the chickpea.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer decided to plant green <w>gram</w> during the dry season.",
                            "target_lang_translations": {
                                "ru": "Фермер решил посадить <w>маш</w> в засушливый сезон."
                            }
                        },
                        {
                            "text": "Bengal <w>gram</w> is a staple ingredient in many traditional Indian dishes.",
                            "target_lang_translations": {
                                "ru": "<w>Нут</w> является основным ингредиентом многих традиционных индийских блюд."
                            }
                        }
                    ],
                    "synonyms": [
                        "chickpea",
                        "pulse"
                    ],
                    "common_phrases": [
                        "bengal gram",
                        "green gram",
                        "red gram"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бобовое растение, выращиваемое ради семян, например, нут."
