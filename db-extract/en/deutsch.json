                "translations": [
                    {
                        "translation_id": "0caceb96-1910-4304-a4b3-e273b2dcfb9f",
                        "source_entry_id": "eeae6d81-c3d9-36ed-920e-7038c7056320",
                        "source_sense_id": "24801223-e934-36bc-98bf-b0d0f2ee5bf7",
