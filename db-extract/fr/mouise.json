                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b202a304-a513-44f1-8498-71722a400713",
                        "entry_id": "7826575b-6047-3b62-9618-801973bccf02",
                        "tags": [
                            "plural"
                        ],
                        "form": "mouises"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "67250134-d280-3546-90f4-24137eec568f",
                        "entry_id": "7826575b-6047-3b62-9618-801973bccf02",
                        "glosses": [
                            "Misère ; difficultés."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3eb62adb-b61c-476c-a18f-0d1d88059f92",
                                "sense_id": "67250134-d280-3546-90f4-24137eec568f",
                                "text": "Voilà, un soir de mouise, le ventre creux, pas un pélo en poche, je me reposais sur un banc du côté de la porte Maillot. V’là le vieux qui s’aboule… […] Y s’met à côté de moi et m'offre une cigarette."
                            },
                            {
                                "example_id": "67b7c220-9164-41c1-870c-f0462fb82e7f",
                                "sense_id": "67250134-d280-3546-90f4-24137eec568f",
                                "text": "Même la lente dégringolade ne devait pas être sans charme. On s’habitue très bien à un hôtel de cinquième ordre et, un jour de mouise, on peut trouver une certaine excitation à coucher sur un banc après avoir fait la queue devant une soupe populaire."
                            },
                            {
                                "example_id": "631c9005-64a6-4232-803a-a55a302de943",
                                "sense_id": "67250134-d280-3546-90f4-24137eec568f",
                                "text": "Et, d’un trait, il expliqua toute son histoire, la rencontre de Tacherot, un jour de cafard et de mouise sinistre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aad02778-9f13-49da-8807-aaf6026e69c2",
                        "source_entry_id": "7826575b-6047-3b62-9618-801973bccf02",
                        "source_sense_id": "67250134-d280-3546-90f4-24137eec568f",
                        "target_lang_word": "Elend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1755aa60-91b4-391c-9a24-025c37fb5738",
                                        "entry_id": "3e0327de-a797-3a6e-a518-64bfb78fdef4",
                                        "glosses": [
                                            "das Land außerhalb der eigenen Heimat, die Fremde, das Wohnen in der Fremde, das Wohnen im Ausland"
                                        ],
                                        "tags": [
                                            "ursprünglich",
                                            "daraus entwickelt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79382e97-68d2-4a0d-865a-7b73d6af1c89",
                                                "sense_id": "1755aa60-91b4-391c-9a24-025c37fb5738",
                                                "text": "Das Elend bauen heißt, im fremden Land zu wohnen, wo man wartete, aus dem Elend heimkehren zu können."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "95333c73-b311-3e4b-9ff0-9f8bca270120",
                                        "entry_id": "3e0327de-a797-3a6e-a518-64bfb78fdef4",
                                        "glosses": [
                                            "Zustand von Hilf- und Rechtlosigkeit und die daraus resultierende Befindlichkeit des Leides, des Kummers und des Unglücks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ae753a4-cf8e-4df2-827b-c0d71bd389fb",
                                                "sense_id": "95333c73-b311-3e4b-9ff0-9f8bca270120",
                                                "text": "Nach ihrer Flucht aus Jugoslawien sind sie ins Elend geraten."
                                            },
                                            {
                                                "example_id": "c27024d6-c3b6-4b52-8cf7-9145b8d355ae",
                                                "sense_id": "95333c73-b311-3e4b-9ff0-9f8bca270120",
                                                "text": "Die Kleine saß da in ihrem Sessel, ein Häufchen Elend nur, und knetete ihr Taschentuch mit den feinen Stickereien."
                                            },
                                            {
                                                "example_id": "36a5cc52-47f9-4e33-a3ce-0b06599b1a65",
                                                "sense_id": "95333c73-b311-3e4b-9ff0-9f8bca270120",
                                                "text": "Als ich in das Kinderzimmer kam, fand ich das heulende Elend vor: alle beide schnauften und schneutzten sich und hatten ganz rot geränderte Augen."
                                            },
                                            {
                                                "example_id": "3d71f69e-8466-4af3-8728-cc5c02ab3403",
                                                "sense_id": "95333c73-b311-3e4b-9ff0-9f8bca270120",
                                                "text": "Als er in den Garten kam, sah er das ganze Elend mit eigenen Augen."
                                            },
                                            {
                                                "example_id": "2529c666-7118-4eae-89ca-605e6b06ae57",
                                                "sense_id": "95333c73-b311-3e4b-9ff0-9f8bca270120",
                                                "text": "„Besonders grämte ich mich, daß Lucia binnen kurzem, wenn sie im Elend und wohl auch in der Schande an mich zurückdachte, mich als erste Ursache ihres Unglücks verabscheuen und hassen mußte.“"
                                            },
                                            {
                                                "example_id": "f1c8b48b-0522-43db-a993-bf15fa305d6b",
                                                "sense_id": "95333c73-b311-3e4b-9ff0-9f8bca270120",
                                                "text": "Denke ich an Deutschland, ist mir auch nach Schrei'n",
                                                "translation": "Hier bin ich geboren, auch das ist mein Land."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "07abc955-ad6c-3330-b0a1-97d9b7e7000e",
                                        "entry_id": "3e0327de-a797-3a6e-a518-64bfb78fdef4",
                                        "glosses": [
                                            "materieller Mangel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8140e784-50e8-4226-8096-1fca5888232b",
                                                "sense_id": "07abc955-ad6c-3330-b0a1-97d9b7e7000e",
                                                "text": "Einerseits leben die Einwohner der Favelas im Elend, aber andererseits schafft eben diese Umgebung eine Kultur, aus der große Kunst entsteht."
                                            },
                                            {
                                                "example_id": "b8048d2c-a3d3-4380-bb81-87f2c27bb700",
                                                "sense_id": "07abc955-ad6c-3330-b0a1-97d9b7e7000e",
                                                "text": "Wenn man einmal im Elend gelandet ist, ist es schwer, aus eigener Kraft wieder herauszukommen."
                                            },
                                            {
                                                "example_id": "26178a2e-a70c-4bfc-aeb2-b963f0338c09",
                                                "sense_id": "07abc955-ad6c-3330-b0a1-97d9b7e7000e",
                                                "text": "„Doch sie brauchten nicht lange, um der Armut, dem Gestank und dem Elend zu begegnen.“"
                                            },
                                            {
                                                "example_id": "0102043f-570d-46b2-a237-bf66b85f63bc",
                                                "sense_id": "07abc955-ad6c-3330-b0a1-97d9b7e7000e",
                                                "text": "„Dabei waren die Mieter des Vorderhauses privilegiert, im zweiten und dritten Hinterhof wohnte das Elend.“"
                                            },
                                            {
                                                "example_id": "0113490c-d450-47b4-b3a9-5c539b2b6e72",
                                                "sense_id": "07abc955-ad6c-3330-b0a1-97d9b7e7000e",
                                                "text": "„Wann das Elend begann, daran kann er sich kaum erinnern.“"
                                            },
                                            {
                                                "example_id": "3ccb4989-2114-4dbf-9c2b-b3c1e9661a70",
                                                "sense_id": "07abc955-ad6c-3330-b0a1-97d9b7e7000e",
                                                "text": "Denke ich an Deutschland, ist mir auch nach Schrei'n",
                                                "translation": "Hier bin ich geboren, auch das ist mein Land."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
