                                "example_id": "22fa2e0e-6af8-45f1-9cec-4f67780ab62c",
                                "sense_id": "54066501-71e8-3685-a679-27824ff7d8b2",
                                "text": "Le chien s’entasse dans son panier."
                            }
                        ]
                    }
