                    },
                    {
                        "sense_id": "3ac27063-3f9f-3e71-8dfc-c996bd1ba621",
                        "entry_id": "f267746b-89a3-3c47-993a-e1a72d4cb06d",
                        "glosses": [
                            "Having, resembling, or composed of wings or alae."
                        ],
