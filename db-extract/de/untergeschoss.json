                "senses": [
                    {
                        "sense_id": "d1a0f6d1-37fd-3df6-a197-3ced24d57699",
                        "entry_id": "2a7c025d-302f-37b6-8736-77b67bff7c8a",
                        "glosses": [
                            "unter der Erde befindlicher Teil eines Gebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdca518b-d2da-4202-a4ab-9a00ac7ed93a",
                                "sense_id": "d1a0f6d1-37fd-3df6-a197-3ced24d57699",
                                "text": "„Das Japan Center ist ein Hochhaus im Bankenviertel von Frankfurt am Main. […] Das Gebäude weist unter dem Straßenniveau vier Untergeschosse, mit einer Tiefgarage in den untersten drei Etagen, auf."
                            },
                            {
                                "example_id": "5d53c55c-fb8e-4e9f-95aa-d437b514b5ba",
                                "sense_id": "d1a0f6d1-37fd-3df6-a197-3ced24d57699",
                                "text": "„Sie befindet sich in einem Museum im Untergeschoss der Marktkirche von Halle, jener Stadt, die Luthers Gegner Kardinal Albrecht zum Standort seiner Reliquiensammlung auserkoren hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1e87c56-729e-4dba-9ce4-e3ea0749a51a",
                        "source_entry_id": "2a7c025d-302f-37b6-8736-77b67bff7c8a",
                        "source_sense_id": "d1a0f6d1-37fd-3df6-a197-3ced24d57699",
