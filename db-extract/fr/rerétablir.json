                        "tags": [],
                        "examples": [
                            {
                                "example_id": "862a0b3b-2407-480b-b625-5c1befc41f05",
                                "sense_id": "16d15f31-5ea9-31ad-8313-e1a487d4aa22",
                                "text": "Le lendemain, on le trouva de nouveau coupé. On le rerétablit, on le rerecoupa."
                            },
                            {
                                "example_id": "80af53a1-dc14-4977-b42a-c1fa5616e0d6",
                                "sense_id": "16d15f31-5ea9-31ad-8313-e1a487d4aa22",
                                "text": "(...) titre d'Opéra-Comique, et, supprimé en 1718, rétabli en 1721, supprimé de nouveau en 1745, rerétabli en 1752, avait fini par s'amalgamer aux Italiens en 1762."
                            }
                        ]
                    }
