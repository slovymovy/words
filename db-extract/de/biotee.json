                ],
                "senses": [
                    {
                        "sense_id": "bb842727-2d5c-35a5-956b-beb2c602ca51",
                        "entry_id": "245fbf27-077b-3b7b-ad04-de5ab6f376fe",
                        "glosses": [
                            "Tee, der aus ökologischer Landwirtschaft und umweltfreundlicher Herstellung stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3246b494-f33d-4884-87f7-55d14bb6fa73",
                                "sense_id": "bb842727-2d5c-35a5-956b-beb2c602ca51",
                                "text": "„Auch beim Tee gibt es Unterschiede: Biotee ist besser als konventioneller, schon wegen des Themas Pestizide.“"
                            },
                            {
                                "example_id": "828a0a17-c94e-4b12-8fd8-ee9f298e7aa4",
                                "sense_id": "bb842727-2d5c-35a5-956b-beb2c602ca51",
                                "text": "„Einige Fungizide sind mit Schwermetallen verunreinigt, aber bei Biotee würde man davon ausgehen, dass er weniger verseucht ist.“"
                            },
                            {
                                "example_id": "c91382a6-332c-476c-ab4c-4d32801624ef",
                                "sense_id": "bb842727-2d5c-35a5-956b-beb2c602ca51",
                                "text": "„Alle Türen standen offen, hippe junge Leute saßen in kippeligen Stühlen, skypten, tippten oder schlürften Biotee.“"
                            },
                            {
                                "example_id": "424b0272-099f-4786-8b27-98095a7c7e66",
                                "sense_id": "bb842727-2d5c-35a5-956b-beb2c602ca51",
                                "text": "„Hier bekommt man neben Kaffee, Kuchen, Biotee und teurem Frühstück auch deutsches Brot, Laugenbrezeln und Apfelstrudel.“"
                            },
                            {
                                "example_id": "6ae17a3c-d7d8-4e92-8003-4c4545818c83",
                                "sense_id": "bb842727-2d5c-35a5-956b-beb2c602ca51",
                                "text": "„Sofie füllte zwei Teebecher, hängte Beutel mit grünem Biotee hinein – den hatte ihre Mutter am liebsten getrunken – und reichte Jake einen Becher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
