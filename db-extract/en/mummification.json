                "senses": [
                    {
                        "sense_id": "47bf8051-43f6-31a4-b401-d55c4d353c8d",
                        "entry_id": "bfc5afeb-6ed6-37c8-9ae6-587b04ee5b3b",
                        "glosses": [
                            "The preserving of a dead body, by making it into a mummy."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ba1b27b6-7a34-41cc-8ea3-77b7c688a79e",
                                "sense_id": "47bf8051-43f6-31a4-b401-d55c4d353c8d",
                                "text": "Mummification is not reserved exclusively for humans. Cats, dogs, and even crocodiles often get the same treatment—complete with animal-shaped coffins and painted faces."
                            }
                        ]
                    },
                    {
                        "sense_id": "7368a362-e487-3214-9266-28a851f01ac8",
                        "entry_id": "bfc5afeb-6ed6-37c8-9ae6-587b04ee5b3b",
                        "glosses": [
                            "The practice of wrapping a person's arms, torso, and legs in order to restrict their movement."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
