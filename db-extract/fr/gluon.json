                "senses": [
                    {
                        "sense_id": "37554eed-311a-3d37-b7ac-8894bc791222",
                        "entry_id": "a5bfd0af-369c-3941-8f48-5897b3eb1d58",
                        "glosses": [
                            "Boson responsable de l’interaction forte."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "ba8cd269-dc3b-46bf-b2e1-45a8e78e11be",
                                "sense_id": "37554eed-311a-3d37-b7ac-8894bc791222",
                                "text": "Gluon : médiateur de la force forte de couleur entre les quarks. […] On pense que 99 % de la masse des protons et des neutrons est due à l’énergie emportée par les gluons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbc3512c-1ed8-4b3a-a008-17d226c262f7",
                        "source_entry_id": "a5bfd0af-369c-3941-8f48-5897b3eb1d58",
                        "source_sense_id": "37554eed-311a-3d37-b7ac-8894bc791222",
                        "source_sense_description": "Boson responsable de l’interaction forte",
                        "target_lang_word": "Gluon",
