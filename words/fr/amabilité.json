                    "frequency": "Middle",
                    "semantic_group_id": "qualite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La réceptionniste nous a accueillis avec une grande <w>amabilité</w> dès notre arrivée à l'hôtel."
                        },
                        {
                            "text": "Il a eu l'<w>amabilité</w> de me guider dans les couloirs du bâtiment."
                        }
                    ],
                    "synonyms": [
                        "aménité"
                    ],
                    "common_phrases": [
