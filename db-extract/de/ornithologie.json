                "senses": [
                    {
                        "sense_id": "7d3f6f65-a632-35f4-b471-1e7c26648381",
                        "entry_id": "7b964109-0683-3c23-b175-4beb52e69619",
                        "glosses": [
                            "Teilgebiet der Zoologie, das sich mit den Vögeln befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ba29b4a-852f-4146-a012-f19459955145",
                                "sense_id": "7d3f6f65-a632-35f4-b471-1e7c26648381",
                                "text": "„Doch Dieter Zingel von der Hessischen Gesellschaft für Ornithologie und Naturschutz hat keinen Zweifel: Noch nie gab es in Wiesbaden so viele Halsbandsittiche wie heute.“"
                            },
                            {
                                "example_id": "c722581c-f9f9-42c1-94c2-f4bc1063b75c",
                                "sense_id": "7d3f6f65-a632-35f4-b471-1e7c26648381",
                                "text": "„So können die Hessen beispielsweise eine Feldhamster-Patenschaft übernehmen oder der Hessischen Gesellschaft für Ornithologie und Naturschutz helfen, den Lebensraum des vom Aussterben bedrohten Tieres zu kartieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c05a10f1-af28-40ca-8fd7-c5c3b38caf1f",
                        "source_entry_id": "7b964109-0683-3c23-b175-4beb52e69619",
                        "source_sense_id": "7d3f6f65-a632-35f4-b471-1e7c26648381",
                        "source_sense_description": "Zoologie: Teilgebiet der Zoologie, der sich mit den Vögeln befasst",
                        "target_lang_word": "ornithology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ornithology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f242e121-e4f0-39b7-af47-62c0469a0e1a",
                                        "entry_id": "b3265d66-0102-3914-b3a6-662ea272f731",
                                        "glosses": [
                                            "The branch of zoology that deals with the scientific study of birds."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08c52368-630e-41c6-b774-08ff1d9a6280",
                                                "sense_id": "f242e121-e4f0-39b7-af47-62c0469a0e1a",
                                                "text": "Gesner says in his Ornithology, that this fact was attested by a great many moderns of his own time, and he even quotes Albert the great, who asserts that he has seen a cock foster chickens."
                                            },
                                            {
                                                "example_id": "41a189d3-c45b-49b2-ad5b-957f35b4d284",
                                                "sense_id": "f242e121-e4f0-39b7-af47-62c0469a0e1a",
                                                "text": "Jerome A. Jackson, an ivory bill specialist at Florida Gulf Coast University in Fort Myers, has now increased the intensity of the discussion in a 15-page article in the current issue of The Auk, a quarterly ornithology journal published by the American Ornithologists' Union."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa9a2364-62d1-4353-812a-468eb53aac66",
                        "source_entry_id": "7b964109-0683-3c23-b175-4beb52e69619",
                        "source_sense_id": "7d3f6f65-a632-35f4-b471-1e7c26648381",
                        "source_sense_description": "Zoologie: Teilgebiet der Zoologie, der sich mit den Vögeln befasst",
                        "target_lang_word": "ornithologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ornithologie",
