                "senses": [
                    {
                        "sense_id": "01670be0-c5a4-372c-9a91-27c325de6a67",
                        "entry_id": "870a5e0e-446e-31ff-ba8e-c7f8454270e1",
                        "glosses": [
                            "der Segen Gottes oder der Segen eines Heiligen für eine reiche Weinernte"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ecc75517-a899-33ca-b516-9965c12b9c58",
                        "entry_id": "870a5e0e-446e-31ff-ba8e-c7f8454270e1",
                        "glosses": [
                            "der Segen über den Wein im Gottesdienst"
                        ],
                        "tags": [
                            "Christliche Religion"
                        ],
                        "examples": [
                            {
                                "example_id": "7ffd80e5-39ae-4d78-9aaf-fa40bb2d5758",
                                "sense_id": "ecc75517-a899-33ca-b516-9965c12b9c58",
                                "text": "Der Weinsegen der christlichen Liturgie geht auf den jüdischen Kiddusch, einen häuslichen Segensspruch über einen Becher Wein, mit dem man den anbrechenden Sabbat oder ein anbrechendes Fest einleitete, zurück."
                            },
                            {
                                "example_id": "f8c10cdb-2346-4875-a369-fca876bad570",
                                "sense_id": "ecc75517-a899-33ca-b516-9965c12b9c58",
                                "text": "„Über die Reihenfolge wurde schon im Altertum gestritten; Schammaj stellte den Weinsegen, Hillel den Brotsegen an die erste Stelle. Der Brotsegen lautet: […] der Weinsegen: „Gelobet seist du, Herr unser Gott, der du die Frucht des Weinstocks erschaffen hast.““"
                            },
                            {
                                "example_id": "1d03bce7-9d85-4dcc-88a2-6a35ca38b343",
                                "sense_id": "ecc75517-a899-33ca-b516-9965c12b9c58",
                                "text": "„Feste Elemente des Ablaufs waren: Weinsegen, Brotbrechen und Mahlzeit.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1b1500a8-294f-36c4-a9f9-98b2b7d00fd4",
                        "entry_id": "870a5e0e-446e-31ff-ba8e-c7f8454270e1",
                        "glosses": [
                            "eine reiche Weinernte"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "0ddadfd2-e47b-44e9-baef-cbe3ce008cde",
                                "sense_id": "1b1500a8-294f-36c4-a9f9-98b2b7d00fd4",
                                "text": "Dieses Jahr hatten wir einen reichen Weinsegen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
