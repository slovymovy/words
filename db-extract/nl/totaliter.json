                            {
                                "example_id": "b1f17d46-3e17-40c4-803c-6b57accf57c2",
                                "sense_id": "6bc819ef-43a5-3d01-ad04-d50dadb9d961",
                                "text": "Totaliter telt dit register om en nabij de 1.100 ingeschrevenen."
