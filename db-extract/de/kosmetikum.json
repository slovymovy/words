                        "glosses": [
                            "Substanz oder Produkt zur Körperpflege beziehungsweise zur Erhaltung oder Vergrößerung der Schönheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ff5051b-933a-42da-8f6f-d463c10f140c",
                                "sense_id": "d25bb23c-bfcf-3889-9ac7-8aa988eec5cb",
                                "text": "„Ob es sich nun um den Honig oder das berühmte Gelée royale handelt, das die Bienen ihren Königinnenlarven füttern und das bei uns für Arzneimittel und Kosmetika sehr begehrt ist – in Ägypten wurden die Erzeugnisse der Bienen als rar und wertvoll angesehen.“"
                            }
                        ],
