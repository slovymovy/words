                                    }
                                ]
                            },
                            {
                                "target_word": "Eberhard",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c042466-5d68-3917-bc11-bf7147e6e6a6",
                                        "entry_id": "96dae5c2-e279-352f-ad19-ab507127f9d8",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ae2d709-763b-4d89-a060-e6aa5e084567",
                                                "sense_id": "5c042466-5d68-3917-bc11-bf7147e6e6a6",
                                                "text": "Frau Eberhard ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "2bf99e25-d5e0-4615-8b8a-e11893e39bb7",
                                                "sense_id": "5c042466-5d68-3917-bc11-bf7147e6e6a6",
                                                "text": "Herr Eberhard wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "dfecefb3-5eb6-422f-a210-3b046b09d655",
                                                "sense_id": "5c042466-5d68-3917-bc11-bf7147e6e6a6",
                                                "text": "Die Eberhards kommen heute aus dem Berner Oberland."
                                            },
                                            {
                                                "example_id": "23e27929-be26-4961-acc9-022ed4b01c35",
                                                "sense_id": "5c042466-5d68-3917-bc11-bf7147e6e6a6",
                                                "text": "Der Eberhard trägt nie die Schals, die die Eberhard ihm strickt."
                                            },
                                            {
                                                "example_id": "8b99cbb6-b3d4-4be2-9243-8b9768fc8d92",
                                                "sense_id": "5c042466-5d68-3917-bc11-bf7147e6e6a6",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eberhard kommt, geht der Herr Eberhard.“"
                                            },
                                            {
                                                "example_id": "fd70c5dd-78a3-43ee-9851-15a9710db52d",
                                                "sense_id": "5c042466-5d68-3917-bc11-bf7147e6e6a6",
                                                "text": "Eberhard kommt und geht."
                                            },
                                            {
                                                "example_id": "5fd02019-4ba7-4655-a7cd-160d2e7f93ee",
                                                "sense_id": "5c042466-5d68-3917-bc11-bf7147e6e6a6",
                                                "text": "Eberhards kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
