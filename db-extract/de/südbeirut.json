                        "examples": [
                            {
                                "example_id": "c3d015c4-b129-459b-9c3a-52193f8d02ae",
                                "sense_id": "f4b0a8d9-c05a-38d2-8f68-e24c9fea792a",
                                "text": "„Eine Regierung, in der sowohl der Ministerpräsident als auch der Verteidigungsminister Zivilisten ohne militärische Laufbahn waren, bombte Teile Südbeiruts in Schutt und Asche und führte Dresden und Kosovo als Präzedenzfälle an.“"
                            },
                            {
                                "example_id": "dac3b1b8-54af-4444-a6ff-33acdcd3b237",
                                "sense_id": "f4b0a8d9-c05a-38d2-8f68-e24c9fea792a",
                                "text": "„Nur zwei Tage, nachdem sie ihr Gründungsmanifest vorgestellt hatte, ließ die Hisbollah mit zahlreichen Fahrzeugen fünftausend Männer und Tschador tragende Frauen von Südbeirut nach Sidon befördern, wo in den Tagen zuvor die Befreiung der Stadt von den israelischen Besatzern gefeiert worden war.“"
                            }
                        ],
