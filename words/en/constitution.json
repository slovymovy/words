    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "414ce405-4f23-3637-98ef-153ebabacdeb",
                    "sense_definition": "The system of fundamental principles and laws that governs a country, state, or organization.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "legal_framework",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country adopted a new <w>constitution</w> to ensure democratic rights for all citizens.",
                            "target_lang_translations": {
                                "ru": "Страна приняла новую <w>конституцию</w>, чтобы гарантировать демократические права всем гражданам."
                            }
                        },
                        {
                            "text": "Every member of the club must follow the rules outlined in the written <w>constitution</w>.",
                            "target_lang_translations": {
                                "ru": "Каждый член клуба должен соблюдать правила, изложенные в письменном <w>уставе</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "composition",
                        "structure"
                    ],
                    "common_phrases": [
                        "written constitution",
                        "amend the constitution",
                        "under the constitution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система основополагающих принципов и законов, по которым управляется страна, штат или организация."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конституция",
                                "target_lang_sense_clarification": "основной закон государства или организации"
                            },
                            {
                                "target_lang_word": "устройство",
                                "target_lang_sense_clarification": "государственный или общественный строй"
                            },
                            {
                                "target_lang_word": "основной закон",
                                "target_lang_sense_clarification": "базовый правовой акт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "270f0722-df23-30ea-a952-706d76efcdbb",
                    "sense_definition": "A person's physical makeup, health, or strength, especially regarding their ability to resist illness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a strong <w>constitution</w> and rarely gets sick even during the winter.",
                            "target_lang_translations": {
                                "ru": "У него крепкое <w>телосложение</w>, и он редко болеет даже зимой."
                            }
                        },
                        {
                            "text": "The long journey was very difficult for someone with such a delicate <w>constitution</w>.",
                            "target_lang_translations": {
                                "ru": "Долгое путешествие было очень трудным для человека с таким хрупким <w>здоровьем</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "makeup",
                        "composition"
                    ],
                    "common_phrases": [
                        "strong constitution",
                        "robust constitution",
                        "delicate constitution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое состояние, здоровье или сила человека, особенно в отношении способности сопротивляться болезням."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "телосложение",
                                "target_lang_sense_clarification": "физическое строение человека"
