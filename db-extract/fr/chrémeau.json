                    {
                        "sense_id": "f70d90ce-bb72-3999-ba4d-8feff8c192db",
                        "entry_id": "7f171414-9569-3f94-9e26-994c614a7a15",
                        "glosses": [
                            "Petit bonnet blanc de linge fin, dont, après l’onction du saint chrême, on coiffe l’enfant baptisé."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4c07c048-357e-3265-a35e-97d6d2e4f806",
                        "entry_id": "7f171414-9569-3f94-9e26-994c614a7a15",
                        "glosses": [
                            "Linge dont l’évêque se sert pour essuyer le front de ceux qu’il confirme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0633265-66b9-4137-ba01-a99053bec420",
                                "sense_id": "4c07c048-357e-3265-a35e-97d6d2e4f806",
                                "text": "L'usage du chrémeau nous conduit ainsi naturellement à celui du bandeau de lin que les confirmands tiennent à la main en s'approchant du Pontife et dont on leur bande le front après l’onction sacramentelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "52d79685-0021-30b3-8e95-9709c164a972",
                        "entry_id": "7f171414-9569-3f94-9e26-994c614a7a15",
                        "glosses": [
                            "Toile cirée qui sert à recouvrir un autel récemment consacré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e537b06-ea80-49f2-a915-dbbdb4cd58fc",
                                "sense_id": "52d79685-0021-30b3-8e95-9709c164a972",
                                "text": "Sur un autel fixe on met toujours une toile cirée ou chrémeau (chrismale). Il est louable d'en mettre une aussi sur les pierres consacrées."
                            }
                        ]
                    },
                    {
                        "sense_id": "a51b4088-c7b0-3c9e-897a-042966a510a4",
                        "entry_id": "7f171414-9569-3f94-9e26-994c614a7a15",
                        "glosses": [
                            "Ensemble de deux vases cylindriques accolés, qui au Moyen Âge contenait respectivement l'huile des catéchumènes et le saint chrême, servant pour les onctions prébaptismales et postbaptismales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d5cd107-0e12-4b57-8d46-0efe7e3cd9dc",
                                "sense_id": "a51b4088-c7b0-3c9e-897a-042966a510a4",
                                "text": "Les chrémeaux sont des récipients à couvercle qui conservent les huiles saintes, consacrées par l'évêque le jeudi-saint lors de la messe chrismale. Ces huiles sont utilisées pour conférer les sacrements de baptême et d’extrême-onction. Ils se présentent souvent sur un plateau."
                            }
                        ]
                    }
                ],
