                    "frequency": "Low",
                    "semantic_group_id": "exchange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I refused to <w>bandy</w> words with someone who was clearly looking for an argument.",
                            "target_lang_translations": {
                                "nl": "Ik weigerde <w>woorden te wisselen</w> met iemand die duidelijk op ruzie uit was.",
                                "ru": "Я отказался <w>пререкаться</w> с тем, кто явно искал ссоры."
                            }
                        },
                        {
                            "text": "The two politicians continued to <w>bandy</w> insults throughout the heated debate.",
                            "target_lang_translations": {
                                "nl": "De twee politici bleven elkaar tijdens het verhitte debat beledigingen <w>naar het hoofd slingeren</w>.",
                                "ru": "Оба политика продолжали <w>переругиваться</w> оскорблениями на протяжении всех жарких дебатов."
