                    }
                ],
                "senses": [
                    {
                        "sense_id": "882d71f5-03a4-3c27-97d7-10e515e9650e",
                        "entry_id": "bcd208c5-e35d-3beb-b910-4c25f234e907",
                        "glosses": [
                            "Of or relating to ancient Lutetia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ae1790f-ec48-476d-92bd-1adf0d93898c",
                                "sense_id": "882d71f5-03a4-3c27-97d7-10e515e9650e",
                                "text": "The activity of the Lutetian shippers and navigators covered the territory bathed by the Seine, the Marne, and the Oise, all of them quite navigable."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf094ba6-2827-3635-b6c6-93b7556e01ba",
                        "entry_id": "bcd208c5-e35d-3beb-b910-4c25f234e907",
                        "glosses": [
                            "Parisian."
                        ],
                        "tags": [
                            "broadly",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "679a8e1f-6f5b-4a07-8f0b-6cf9d399522c",
                                "sense_id": "cf094ba6-2827-3635-b6c6-93b7556e01ba",
                                "text": "[...] not long before I took him to the Aerogare, he gave the last of his Lutetian homilies [...]"
                            }
                        ]
                    },
                    {
                        "sense_id": "d8e1570d-e010-3ed3-9f12-19946d952008",
                        "entry_id": "bcd208c5-e35d-3beb-b910-4c25f234e907",
                        "glosses": [
                            "Of or pertaining to the Lutetian."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13d453b5-ab4d-4a9a-9015-c587a62db44d",
                                "sense_id": "d8e1570d-e010-3ed3-9f12-19946d952008",
                                "text": "It is important to note that the Lutetian sediments occurring in the area under investigation were distinguished as limestone and flysch during previous studies also."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "120a693c-470f-4027-9955-9fcb05530543",
                        "source_entry_id": "bcd208c5-e35d-3beb-b910-4c25f234e907",
                        "source_sense_description": "Translations",
                        "target_lang_word": "lutécien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lutécien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "312e0722-a026-3740-862e-d9932f6d22e0",
                                        "entry_id": "d25446fa-42b0-3849-806f-284318320c58",
                                        "glosses": [
                                            "Relatif à Lutèce, ville gallo-romaine correspondant au Paris actuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b72958c-c43e-48e5-8b72-38c682c6a9b5",
                                                "sense_id": "312e0722-a026-3740-862e-d9932f6d22e0",
                                                "text": "Chrétien renégat, il songeait à élever auprès de sa demeure lutécienne un temple aux dieux tombés de l’Olympe, et, plus tard, si la mort ne l’avait pas surpris en Asie, il aurait, aissant de côté ces divinités ensevelies, instauré sur les rives de la Seine le culte du Soleil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f70d1636-8464-3c81-8c5d-c088d7c70411",
                                        "entry_id": "d25446fa-42b0-3849-806f-284318320c58",
                                        "glosses": [
                                            "Parisien."
                                        ],
                                        "tags": [
                                            "Par plaisanterie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2726bf6-d94c-4ac6-9ba4-3259c291e9c0",
                                                "sense_id": "f70d1636-8464-3c81-8c5d-c088d7c70411",
                                                "text": "Le paysage en caoutchouc rend tous les jours de nouveaux services ; il est de plus en plus apprécié par la population lutécienne. Hier, une malheureuse femme, accablée de misère, s’est précipitée d’un quatrième étage dans la rue Michel-Delaporte. Grâce au nouveau système de pavage, sa tête seule ayant heureusement porté sur le caoutchouc, elle a rebondi avec tant d’élasticité qu’elle est rentrée par la fenêtre d’où elle s’était jetée. Elle en a été quitte pour quelques contusions. — On a beau dire, la pauvreté ne fait pas le bonheur."
                                            },
                                            {
                                                "example_id": "22e21d44-3d77-499f-9010-4ba4690489b5",
                                                "sense_id": "f70d1636-8464-3c81-8c5d-c088d7c70411",
                                                "text": "Les plus mordus d’entre les voyageurs, la dame francophone en tête, revenus de leur surprise, pourchassaient leur archiguide à travers le dédale lutécien et le magma des encombrements et venaient avec un pot d’enfer de remettre la main dessus."
                                            },
                                            {
                                                "example_id": "66a3ceca-12d4-4559-9f2b-4d985337ab73",
                                                "sense_id": "f70d1636-8464-3c81-8c5d-c088d7c70411",
                                                "text": "Après une courte période de déclin, voilà que souffle le vent du renouveau sur les Francs Mâchons de Paris, branche lutécienne des Mâchons Lyonnais, « Société Philanthropique pour la défense du Bien Boire et du Bien Manger» créée à Lyon en 1964."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
