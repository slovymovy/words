{
    "word_family": [
        "grantee",
        "grantor"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0cceee86-b6cf-3aef-8d57-8839375b764c",
                    "sense_definition": "To give or allow something that has been requested, such as permission, a right, or a wish.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "give_allow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university decided to <w>grant</w> him a full scholarship for his studies.",
                            "target_lang_translations": {
                                "ru": "Университет решил <w>предоставить</w> ему полную стипендию для обучения.",
                                "zh": "大学决定<w>授予</w>他全额奖学金以供学习。"
                            }
                        },
                        {
                            "text": "The authorities refused to <w>grant</w> permission for the new building project.",
                            "target_lang_translations": {
                                "ru": "Власти отказались <w>выдать</w> разрешение на новый строительный проект.",
                                "zh": "当局拒绝<w>批准</w>该新建项目。"
                            }
                        }
                    ],
                    "synonyms": [
                        "allow"
                    ],
                    "antonyms": [
                        "deny"
                    ],
                    "common_phrases": [
                        "grant permission",
                        "grant access",
                        "grant a wish",
                        "grant asylum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать или разрешать что-либо, о чем просили, например, разрешение, право или исполнение желания.",
                        "zh": "给予或允许某人所请求的事物，例如许可、权利或愿望。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предоставлять",
                                "target_lang_sense_clarification": "давать право или возможность"
                            },
                            {
                                "target_lang_word": "выдавать",
                                "target_lang_sense_clarification": "давать в официальном порядке (документы, деньги)"
                            },
                            {
                                "target_lang_word": "даровать",
                                "target_lang_sense_clarification": "торжественно давать, жаловать (высокий стиль)"
                            },
                            {
                                "target_lang_word": "разрешать",
                                "target_lang_sense_clarification": "давать согласие на что-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "给予",
                                "target_lang_sense_clarification": "正式地给与"
                            },
                            {
                                "target_lang_word": "批准",
                                "target_lang_sense_clarification": "正式同意请求"
                            },
                            {
                                "target_lang_word": "准许",
                                "target_lang_sense_clarification": "允许做某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce3ff5f0-e286-3156-92cc-3b66c81c4f10",
                    "sense_definition": "To admit that something is true, often unwillingly or for the sake of argument.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "admit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>grant</w> that the plan has some risks, but it is still our best option.",
                            "target_lang_translations": {
                                "ru": "Я <w>признаю</w>, что у плана есть риски, но это все же наш лучший вариант.",
                                "zh": "我<w>承认</w>这个计划存在一些风险，但它仍然是我们最好的选择。"
                            }
                        },
                        {
                            "text": "He takes it for <w>granted</w> that his parents will pay for everything.",
                            "target_lang_translations": {
                                "ru": "Он принимает как <w>должное</w>, что его родители за все заплатят.",
                                "zh": "他认为父母为一切买单是理所当然的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "concede",
                        "concur"
                    ],
                    "common_phrases": [
                        "take for granted"
                    ],
                    "target_lang_definitions": {
                        "ru": "Признавать, что что-то является правдой, часто неохотно или ради спора.",
                        "zh": "承认某事是真实的，通常是不情愿的或为了辩论的需要。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "признавать",
                                "target_lang_sense_clarification": "соглашаться с истинностью чего-либо"
                            },
                            {
                                "target_lang_word": "допускать",
                                "target_lang_sense_clarification": "считать возможным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "承认",
                                "target_lang_sense_clarification": "认可事实"
                            },
                            {
                                "target_lang_word": "姑且承认",
                                "target_lang_sense_clarification": "为了讨论而暂时接受"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "921bb5fc-722a-3a2f-9bea-a7394edbd008",
                    "sense_definition": "A sum of money given by a government or organization for a specific purpose, which does not need to be repaid.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "give_allow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She applied for a research <w>grant</w> to study marine biology.",
                            "target_lang_translations": {
                                "ru": "Она подала заявку на исследовательский <w>грант</w> для изучения морской биологии.",
                                "zh": "她申请了一项研究<w>拨款</w>来学习海洋生物学。"
                            }
                        },
                        {
                            "text": "The local library received a generous <w>grant</w> to buy new computers.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека получила щедрый <w>грант</w> на покупку новых компьютеров.",
                                "zh": "当地图书馆收到了一笔慷慨的<w>补助金</w>用于购买新电脑。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "research grant",
                        "government grant",
                        "student grant",
                        "apply for a grant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сумма денег, выделяемая правительством или организацией на определенные цели, которую не нужно возвращать.",
                        "zh": "政府或组织为特定目的提供的无需偿还的资金。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грант",
                                "target_lang_sense_clarification": "целевая финансовая помощь"
                            },
                            {
                                "target_lang_word": "субсидия",
                                "target_lang_sense_clarification": "денежное пособие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拨款",
                                "target_lang_sense_clarification": "政府或机构拨出的款项"
                            },
                            {
                                "target_lang_word": "补助金",
                                "target_lang_sense_clarification": "用于特定用途的资助"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ea11411-400b-3bdb-a57e-85b7b11406b1",
                    "sense_definition": "The act of giving, allowing, or conceding something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "give_allow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>grant</w> of citizenship was a long and complicated legal process.",
                            "target_lang_translations": {
                                "ru": "<w>Предоставление</w> гражданства было долгим и сложным юридическим процессом.",
                                "zh": "<w>授予</w>公民身份是一个漫长而复杂的法律程序。"
                            }
                        },
                        {
                            "text": "We are awaiting the official <w>grant</w> of authority to proceed with the operation.",
                            "target_lang_translations": {
                                "ru": "Мы ожидаем официального <w>предоставления</w> полномочий для продолжения операции.",
                                "zh": "我们正在等待正式<w>授予</w>继续执行该行动的权力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "concession",
                        "allowance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт передачи, разрешения или уступки чего-либо.",
                        "zh": "给予、允许或让步的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предоставление",
                                "target_lang_sense_clarification": "действие по передаче прав или возможностей"
                            },
                            {
                                "target_lang_word": "выдача",
                                "target_lang_sense_clarification": "действие по вручению чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "授予",
                                "target_lang_sense_clarification": "正式给予权利或地位"
                            },
                            {
                                "target_lang_word": "准予",
                                "target_lang_sense_clarification": "正式批准的行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a46faa9b-43b8-3f52-bfee-8a94f8e8aaac",
                    "sense_definition": "A legal transfer of property, usually by a deed, or the property transferred in this way.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "give_allow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The original land <w>grant</w> dates back to the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Первоначальное земельное <w>пожалование</w> датируется девятнадцатым веком.",
                                "zh": "最初的土地<w>转让</w>可以追溯到十九世纪。"
                            }
                        },
                        {
                            "text": "The deed contained a <w>grant</w> of rights to use the private road.",
                            "target_lang_translations": {
                                "ru": "Документ содержал <w>передачу</w> прав на использование частной дороги.",
                                "zh": "契据中包含了使用私人道路的权利<w>转让</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "land grant"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридическая передача собственности, обычно по акту, или сама переданная таким образом собственность.",
                        "zh": "法律上的财产转让，通常通过契据进行，或指以此方式转让的财产。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передача",
                                "target_lang_sense_clarification": "юридический переход прав"
                            },
                            {
                                "target_lang_word": "дарственная",
                                "target_lang_sense_clarification": "документ о дарении имущества"
                            },
                            {
                                "target_lang_word": "пожалование",
                                "target_lang_sense_clarification": "исторический акт дарения земли или титула"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "转让",
                                "target_lang_sense_clarification": "法律上的权利转移"
                            },
                            {
                                "target_lang_word": "赠与",
                                "target_lang_sense_clarification": "无偿转让财产"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3636b875-6f3f-316b-884e-a1397f347ddb",
                    "sense_definition": "A United States fifty-dollar bill.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "money_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He pulled a few <w>Grants</w> from his wallet to pay for the expensive dinner.",
                            "target_lang_translations": {
                                "ru": "Он вытащил несколько <w>Грантов</w> из кошелька, чтобы расплатиться за дорогой ужин.",
                                "zh": "他从钱包里掏出几张<w>五十美元钞票</w>来支付昂贵的晚餐。"
                            }
                        },
                        {
                            "text": "I don't have any <w>Grants</w> on me, only a couple of twenties.",
                            "target_lang_translations": {
                                "ru": "У меня с собой нет <w>Грантов</w>, только пара двадцаток.",
                                "zh": "我身上没有<w>五十美元钞票</w>，只有几张二十美元的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Банкнота США достоинством в пятьдесят долларов.",
                        "zh": "美国五十美元面值的钞票。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пятидесятидолларовая купюра",
                                "target_lang_sense_clarification": "разговорное название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "五十美元钞票",
                                "target_lang_sense_clarification": "口语称呼"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7cc9c365-22a9-3d2b-b03c-4bce8200d7dd",
                    "sense_definition": "A male given name.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My friend <w>Grant</w> is coming to visit us next weekend.",
                            "target_lang_translations": {
                                "ru": "Мой друг <w>Грант</w> приедет навестить нас в следующие выходные.",
                                "zh": "我的朋友<w>格兰特</w>下周末要来看我们。"
                            }
                        },
                        {
                            "text": "They decided to name their newborn son <w>Grant</w>.",
                            "target_lang_translations": {
                                "ru": "Они решили назвать своего новорожденного сына <w>Грант</w>.",
                                "zh": "他们决定给刚出生的儿子取名为<w>格兰特</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя.",
                        "zh": "男性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Грант",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "格兰特",
                                "target_lang_sense_clarification": "人名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23f42fbc-5bfa-37d0-b9dc-10ed2e230d20",
                    "sense_definition": "A surname of English and Scottish origin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Grant</w> has been our neighbor for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Грант</w> был нашим соседом более двадцати лет.",
                                "zh": "<w>格兰特</w>先生做我们的邻居已经二十多年了。"
                            }
                        },
                        {
                            "text": "The <w>Grant</w> family has a long history in this part of the country.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Грант</w> имеет долгую историю в этой части страны.",
                                "zh": "<w>格兰特</w>家族在这个地区有着悠久的历史。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия английского и шотландского происхождения.",
                        "zh": "源自英国和苏格兰的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Грант",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "格兰特",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b409ff42-94f3-33c3-b20e-998aebb91d2f",
                    "sense_definition": "A place name used for various towns, cities, and communities in the United States and other countries.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They stopped in the small town of <w>Grant</w> to refuel their car.",
                            "target_lang_translations": {
                                "ru": "Они остановились в маленьком городке <w>Грант</w>, чтобы заправить машину.",
                                "zh": "他们在<w>格兰特</w>小镇停下来给车加油。"
                            }
                        },
                        {
                            "text": "The population of <w>Grant</w> has grown steadily over the last decade.",
                            "target_lang_translations": {
                                "ru": "Население <w>Гранта</w> неуклонно росло в течение последнего десятилетия.",
                                "zh": "<w>格兰特</w>的人口在过去十年中稳步增长。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название населенных пунктов, используемое для различных городов и общин в США и других странах.",
                        "zh": "用于美国及其他国家城镇、城市和社区的地名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Грант",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "格兰特",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}