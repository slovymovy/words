            {
                "entry_id": "816c168e-194b-3092-8b82-ed062dac2f8a",
                "word": "nix",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a826548d-a134-41b6-95ea-0c1289c4bedb",
                        "entry_id": "816c168e-194b-3092-8b82-ed062dac2f8a",
                        "tags": [
                            "feminine"
                        ],
                        "form": "nixe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b29bd854-62c4-36e6-af7e-17cba12d74f6",
                        "entry_id": "816c168e-194b-3092-8b82-ed062dac2f8a",
                        "glosses": [
                            "Nixe mâle, ondin."
                        ],
                        "tags": [
                            "Fantastique"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0992bb2-c17d-482d-a9f9-1d91f6fc8a2d",
                        "source_entry_id": "816c168e-194b-3092-8b82-ed062dac2f8a",
                        "source_sense_id": "b29bd854-62c4-36e6-af7e-17cba12d74f6",
                        "target_lang_word": "nix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c19668d-e074-397f-82c4-edb8aaccd655",
                                        "entry_id": "6da3c9f9-37c4-33a3-a16c-6744376cacff",
                                        "glosses": [
                                            "Nothing."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b112efd3-7644-4904-92c8-15004a7df22e",
                                                "sense_id": "4c19668d-e074-397f-82c4-edb8aaccd655",
                                                "text": "\"That's a clean lift from Kipling—or is it Conan Doyle? Anyway, I've read something just like it before. Say, kid, guess what these magazine guys get for a full page ad.? Nix. That's just like a woman. Three thousand straight. Fact.\""
                                            },
                                            {
                                                "example_id": "48cbe7d8-9c65-4d63-9f75-f1141d5106b1",
                                                "sense_id": "4c19668d-e074-397f-82c4-edb8aaccd655",
                                                "text": "\"I can take you down, Miss Conover, but I cannot take Mr. Hawksley. When the boss gives me an order I obey it—if I possibly can. On the day the boss tells me you can go strolling, I'll give you the key to the city. Until then, nix! No use arguing, Mr. Hawksley.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afbb7200-be5c-3b68-9da8-6e1e2a8853d0",
                                        "entry_id": "c0359bff-7466-3994-ba0b-417d87c75a9a",
                                        "glosses": [
                                            "To make something become nothing; to reject or cancel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8bdad8c-3480-4346-ba57-4732ef7b3eba",
                                                "sense_id": "afbb7200-be5c-3b68-9da8-6e1e2a8853d0",
                                                "text": "Nix the last order – the customer walked out."
                                            },
                                            {
                                                "example_id": "aa4a2fac-a2d3-4600-910b-c5497314f9e6",
                                                "sense_id": "afbb7200-be5c-3b68-9da8-6e1e2a8853d0",
                                                "text": "Sticks Nix Hick Pix [headline]"
                                            },
                                            {
                                                "example_id": "2e5d98dc-3db4-47ae-9e15-50a0cbdb0f84",
                                                "sense_id": "afbb7200-be5c-3b68-9da8-6e1e2a8853d0",
                                                "text": "1977-1980, Lou Sullivan, personal diary, quoted in 2019, Ellis Martin, Zach Ozma (editors), We Both Laughed In Pleasure\nHe said his roommate had reacted favorably & said he \"wanted to share the bed\" with him! So I figured that nixed me out of the picture at least for now."
                                            },
                                            {
                                                "example_id": "3fc47925-7390-471d-a959-7ce86e42aa6d",
                                                "sense_id": "afbb7200-be5c-3b68-9da8-6e1e2a8853d0",
                                                "text": "The move came less than six months after Jobs had nixed the spin-off of Newton Inc. as an independent company and brought it back inside Apple (see “The Fallen Apple,” page 143)."
                                            },
                                            {
                                                "example_id": "139762b2-0897-4593-a4b8-441d236921c9",
                                                "sense_id": "afbb7200-be5c-3b68-9da8-6e1e2a8853d0",
                                                "text": "At work Mr. Burns spies Homer munching complacently on a donut and hisses that each donut Homer shoves into his fat face brings him one donut closer to the poisoned donut Mr. Burns has ordered thrown into the mix as a form of culinary Russian Roulette, only to learn from Smithers that the plant’s lawyers ultimately nixed the poisoned donut plan because “they consider it murder.”"
                                            }
                                        ]
                                    },
