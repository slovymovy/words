                "senses": [
                    {
                        "sense_id": "b511ff92-f3ee-3729-8fd3-aa6f9a2303bc",
                        "entry_id": "1702b70f-adbd-3550-9dc7-583314cc0c03",
                        "glosses": [
                            "Relatif aux Samnites, une ancienne tribu italique."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "c2239f86-f245-4ba7-91cf-6ae699fa9617",
                                "sense_id": "b511ff92-f3ee-3729-8fd3-aa6f9a2303bc",
                                "text": "Pilate sortait d’une riche famille samnite et, pour cette raison sans doute, n’avait jamais été considéré comme un vrai noble, les Samnites étant des alliés, des « fédérés », non des Romains."
                            },
                            {
                                "example_id": "af6d8137-73fc-4e50-b225-cf4949fc3fa4",
                                "sense_id": "b511ff92-f3ee-3729-8fd3-aa6f9a2303bc",
                                "text": "Après les guerres latines qui ont vu Rome prendre le pouvoir du Latium, les Samnites s’opposent à la conquête romaine du centre de l’Italie. C’est le début des guerres samnites, qui sont rapportées par Tite-Live."
                            }
                        ]
                    }
                ],
