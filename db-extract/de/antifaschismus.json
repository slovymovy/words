                        "source_sense_id": "aeb0dc9b-e66f-3fbf-96be-23f2338b89cb",
                        "source_sense_description": "politische Ablehnung des Faschismus und möglicher Entwicklungen dorthin",
                        "target_lang_word": "antifascisme",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
