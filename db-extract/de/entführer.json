                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95fda77a-429b-4e8c-8d92-8cf08e978ac3",
                        "source_entry_id": "909e8672-f18d-3c58-9113-912067d2026d",
                        "source_sense_id": "9d65d999-5630-3740-ba86-f2776d502707",
                        "source_sense_description": "jemand, der andere Menschen gegen ihren Willen an einen anderen Ort bringt",
                        "target_lang_word": "abducteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abducteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b7fad6ee-e8c6-3ee5-ba71-08560789004c",
                                        "entry_id": "308c9d47-4895-349d-9bec-3bfdc0b34799",
                                        "glosses": [
                                            "Qui produit l’abduction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4fe81a8-e3e1-47f0-96a4-9765e65a9e6d",
                                                "sense_id": "b7fad6ee-e8c6-3ee5-ba71-08560789004c",
                                                "text": "Muscle abducteur."
                                            },
                                            {
                                                "example_id": "ce980141-d63f-4ed3-b011-2ff0048498c3",
                                                "sense_id": "b7fad6ee-e8c6-3ee5-ba71-08560789004c",
                                                "text": "Les muscles abducteur du pouce et abducteur du gros orteil sont, sans conteste, deux formations homologues."
                                            },
                                            {
                                                "example_id": "791584b6-86e0-41c3-8c27-4acbea29e3c3",
                                                "sense_id": "b7fad6ee-e8c6-3ee5-ba71-08560789004c",
                                                "text": "La disparition d’un muscle abducteur dans mon épaule droite, m’a ôté la capacité d’effectuer des déplacements rapides sur le clavier."
                                            },
                                            {
                                                "example_id": "735a6da9-3c0c-484b-9400-73ceb07c868b",
                                                "sense_id": "b7fad6ee-e8c6-3ee5-ba71-08560789004c",
                                                "text": "À l’inverse, chez les oiseaux herbivores actuels, le muscle adducteur est très développé, leur permettant de broyer des plantes et des graines dures, alors que le muscle ptérygoïde est très réduit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abducteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3c3284e-9666-3fcf-9cc4-8ca560c33025",
                                        "entry_id": "13df6e41-56e3-3d9c-b808-2a7e36dced8c",
                                        "glosses": [
                                            "Muscles produisant l’abduction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18398ee8-6007-4467-8811-a2d95d25fd0f",
                                                "sense_id": "c3c3284e-9666-3fcf-9cc4-8ca560c33025",
                                                "text": "L’abducteur de l’œil, de la cuisse."
                                            },
                                            {
                                                "example_id": "d4acb544-a713-49b1-bfd2-82a30d99f910",
                                                "sense_id": "c3c3284e-9666-3fcf-9cc4-8ca560c33025",
                                                "text": "Le long abducteur du bras ou deltoïde."
                                            },
                                            {
                                                "example_id": "0777b0ac-ff33-475c-9095-6a7914dabe65",
                                                "sense_id": "c3c3284e-9666-3fcf-9cc4-8ca560c33025",
                                                "text": "Elle est constituée des muscles courts (intrinsèques) du pouce, à savoir l’adducteur du pouce, le court fléchisseur du pouce, l’opposant du pouce et le court abducteur du pouce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
