                "translations": [
                    {
                        "translation_id": "3b0f75e7-87e5-4385-a786-bba83cd4afa3",
                        "source_entry_id": "7a1dfc75-d1d8-3a52-bb2b-7d12d33abf0b",
                        "source_sense_id": "1a503507-5de2-3a9f-9eba-02f7e1575436",
                        "source_sense_description": "regenen in zeer fijne druppeltjes",
                        "target_lang_word": "nieseln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nieseln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "679e4383-bc2f-316c-b7d0-f7bb5cb22cf3",
                                        "entry_id": "86f8dcc8-3030-3447-8763-9f89c4c0e714",
                                        "glosses": [
                                            "sanft, fein regnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a7d78ce-7058-44fe-aec1-2192058cd692",
                                                "sense_id": "679e4383-bc2f-316c-b7d0-f7bb5cb22cf3",
                                                "text": "Da draußen nieselte es viel."
                                            },
                                            {
                                                "example_id": "8418ad3f-b709-40f4-a163-c09ed3b928c7",
                                                "sense_id": "679e4383-bc2f-316c-b7d0-f7bb5cb22cf3",
                                                "text": "„Als ich nach Kalisz kam, nieselte es.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81b7e0dc-2863-4f32-8ad5-070d51f9bfb1",
                        "source_entry_id": "7a1dfc75-d1d8-3a52-bb2b-7d12d33abf0b",
                        "source_sense_id": "1a503507-5de2-3a9f-9eba-02f7e1575436",
                        "source_sense_description": "regenen in zeer fijne druppeltjes",
                        "target_lang_word": "fisseln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fisseln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd9d8927-f875-3ac0-8977-d587bfef9e0d",
                                        "entry_id": "81aa1a33-66a8-3c55-9d9c-2c88c771f718",
                                        "glosses": [
                                            "leicht, sanft regnen oder schneien"
                                        ],
                                        "tags": [
                                            "impersonal",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c3cc5dc-7811-420f-b93f-754032b3203e",
                                                "sense_id": "cd9d8927-f875-3ac0-8977-d587bfef9e0d",
                                                "text": "Es fisselt."
                                            },
                                            {
                                                "example_id": "188d22b5-5b10-4ac9-b9d9-90744054c14b",
                                                "sense_id": "cd9d8927-f875-3ac0-8977-d587bfef9e0d",
                                                "text": "Es fisselte seit dem frühen Morgen, wahrscheinlich auch schon seit Mitternacht."
                                            },
                                            {
                                                "example_id": "81700174-0f7d-4ee0-8219-5cae0e3925ab",
                                                "sense_id": "cd9d8927-f875-3ac0-8977-d587bfef9e0d",
                                                "text": "Der erwartete Regen sei ausgeblieben. \"Es hat bloß ein bisschen gefisselt.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "800a8a37-13a5-4803-acd6-8675d5ce06fc",
                        "source_entry_id": "7a1dfc75-d1d8-3a52-bb2b-7d12d33abf0b",
                        "source_sense_id": "1a503507-5de2-3a9f-9eba-02f7e1575436",
                        "source_sense_description": "regenen in zeer fijne druppeltjes",
                        "target_lang_word": "drizzle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drizzle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31a062ff-e88c-3803-bb0c-7bd0dcc61b79",
                                        "entry_id": "c833c2f0-2e1c-3117-bf6c-e0d5a2f9c126",
                                        "glosses": [
                                            "To rain lightly."
                                        ],
                                        "tags": [
                                            "impersonal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "650a3c6e-e759-4905-9a91-9d7eb1217a21",
                                                "sense_id": "31a062ff-e88c-3803-bb0c-7bd0dcc61b79",
                                                "text": "We had planned a picnic for Joe's birthday, but it ended up drizzling all day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b705362f-9172-3e91-bf5e-bb1e61aa005b",
                                        "entry_id": "c833c2f0-2e1c-3117-bf6c-e0d5a2f9c126",
                                        "glosses": [
                                            "To shed slowly in minute drops or particles."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be64af0f-bcd8-41db-a27f-4c2a493b5ca4",
                                                "sense_id": "b705362f-9172-3e91-bf5e-bb1e61aa005b",
                                                "text": "And from mine eyes the drizling teares descend,\nAs on your boughes the ysicles depend."
                                            },
                                            {
                                                "example_id": "dc061c63-f8ce-44bf-a1c1-9df33bad8260",
                                                "sense_id": "b705362f-9172-3e91-bf5e-bb1e61aa005b",
                                                "text": "When the sun sets, the air doth drizzle dew;\nBut for the sunset of my brother’s son\nIt rains downright."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fddc1e0-e59e-363a-8fbf-3641122aacda",
                                        "entry_id": "c833c2f0-2e1c-3117-bf6c-e0d5a2f9c126",
                                        "glosses": [
                                            "To pour slowly and evenly, especially oil or honey in cooking."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f3b2cda-b81d-465b-afff-7c9f42786929",
                                                "sense_id": "4fddc1e0-e59e-363a-8fbf-3641122aacda",
                                                "text": "The recipe says to toss the salad and then drizzle olive oil on it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "787350dd-bcc2-3b52-9871-cf739660d22a",
                                        "entry_id": "c833c2f0-2e1c-3117-bf6c-e0d5a2f9c126",
                                        "glosses": [
                                            "To cover by pouring in this manner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c03990b-e099-4518-b353-22992c275731",
                                                "sense_id": "787350dd-bcc2-3b52-9871-cf739660d22a",
                                                "text": "The recipe says to toss the salad and then drizzle it in olive oil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04760fad-4e2c-3a3a-9ee0-a5e23349a87c",
                                        "entry_id": "c833c2f0-2e1c-3117-bf6c-e0d5a2f9c126",
                                        "glosses": [
                                            "To urinate."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a57d303-7f63-47f5-ac51-20153f01f91a",
                                                "sense_id": "04760fad-4e2c-3a3a-9ee0-a5e23349a87c",
                                                "text": "She'll be right back, had to drizzle before we leave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c8d51fa-1c64-3844-aee5-985195dbf035",
                                        "entry_id": "c833c2f0-2e1c-3117-bf6c-e0d5a2f9c126",
                                        "glosses": [
                                            "To carry out parfilage, the process of unravelling."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32e0c6f6-fc52-43e2-a918-5a51d1369a40",
                                                "sense_id": "6c8d51fa-1c64-3844-aee5-985195dbf035",
                                                "text": "She found that all those ladies who did not play at cards occupied their fingers with parfilage.[...] Here, the work was called drizzling. Ladies begged their friends to give them pieces of the gold lace used on uniforms and the gold tassels of sword-belts, they picked out the metal threads, and by selling these they realised considerable sums. Prince Leopold himself drizzled continually[...]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "drizzle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94f4dc66-f573-320d-ad7d-5f13642e39b0",
                                        "entry_id": "a793945a-c72d-3d73-bfbc-dcd88f0656d9",
                                        "glosses": [
                                            "Light rain."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26d365f7-9b7f-4722-a4ac-79a392479b24",
                                                "sense_id": "94f4dc66-f573-320d-ad7d-5f13642e39b0",
                                                "text": "Up here, it's a 'dreich' day with steady drizzle. Deep drainage channels either side of the track are already more like streams: Rannoch Moor is a wet place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd02c57b-84b1-36fa-b0aa-c84e3cd0adba",
                                        "entry_id": "a793945a-c72d-3d73-bfbc-dcd88f0656d9",
                                        "glosses": [
                                            "Very small, numerous, and uniformly dispersed water drops, mist, or sprinkle. Unlike fog droplets, drizzle falls to the ground."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08088136-cf6d-4b20-86af-62b24ff13dff",
                                                "sense_id": "dd02c57b-84b1-36fa-b0aa-c84e3cd0adba",
                                                "text": "No longer pouring, the rain outside slowed down to a faint drizzle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2bcbcc3-803d-3cb6-91be-1f035200aaf3",
                                        "entry_id": "a793945a-c72d-3d73-bfbc-dcd88f0656d9",
                                        "glosses": [
                                            "Water."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "349233d2-60e8-463c-9e29-79277a13bcbf",
                                                "sense_id": "f2bcbcc3-803d-3cb6-91be-1f035200aaf3",
                                                "text": "Stop drinking all of my drizzle!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb2bf7d7-9af3-3567-80a0-c083eee2b593",
                                        "entry_id": "a793945a-c72d-3d73-bfbc-dcd88f0656d9",
                                        "glosses": [
                                            "A cake onto which icing, honey or syrup has been drizzled in an artistic manner."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbbcf1e8-7c8c-41f2-ba87-4a9847a6134a",
                                                "sense_id": "fb2bf7d7-9af3-3567-80a0-c083eee2b593",
                                                "text": "April 19, 2013,Felicity Cloake, \"How to Cook the Perfect Lemon Drizzle Cake\" in The Guardian\nDrizzle is not normally good news. Not when it's falling from the sky, not when it's replacing a decent helping of sauce, and especially not when it's found on a menu in close proximity to the words \"balsamic vinegar\". Deliciously sticky, sweet and sour lemon drizzle cake is the one, and very honourable, exception."
                                            },
                                            {
                                                "example_id": "f48ea154-f39d-4fb1-87db-bace7ffb5be7",
                                                "sense_id": "fb2bf7d7-9af3-3567-80a0-c083eee2b593",
                                                "text": "The rest of the day is spent trying to concentrate on ingredient labels, ordering supplies, baking some fairy cakes for a hen party and two lemon drizzles, one for a new baby and one for an old dear's birthday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b55c1e33-4bbb-41a6-b9b5-9d38e9f7320f",
                        "source_entry_id": "7a1dfc75-d1d8-3a52-bb2b-7d12d33abf0b",
                        "source_sense_id": "1a503507-5de2-3a9f-9eba-02f7e1575436",
                        "source_sense_description": "regenen in zeer fijne druppeltjes",
                        "target_lang_word": "bruiner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bruiner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e0554ef-9926-337a-b80e-e7ab9d3c3b6f",
                                        "entry_id": "518dbe98-18ae-3c8a-946b-edcb5883003b",
                                        "glosses": [
                                            "Faire de la bruine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65fdc7d8-c564-44c9-9c08-18fbf061a263",
                                                "sense_id": "7e0554ef-9926-337a-b80e-e7ab9d3c3b6f",
                                                "text": "Toute la nuit encore, il avait bruiné, une poussière d’eau dont l’humidité salissait les rues."
                                            },
                                            {
                                                "example_id": "d19154e0-6cc4-400f-8147-6eb86d1ca56b",
                                                "sense_id": "7e0554ef-9926-337a-b80e-e7ab9d3c3b6f",
                                                "text": "Au dessus de ces couches de cumulo-stratus purement acqueux, il peut bruiner fortement, et même il peut pleuvoir."
                                            },
                                            {
                                                "example_id": "d15b9915-8888-4dee-a26c-8f94f536112a",
                                                "sense_id": "7e0554ef-9926-337a-b80e-e7ab9d3c3b6f",
                                                "text": "Il pleuvait un peu, mais pas trop, il bruinait plutôt, de façon à donner une couleur grise aux choses et à rendre l’atmosphère mélancolique ; bref, ce temps moyen allait parfaitement avec le caractère modeste des funérailles."
                                            },
                                            {
                                                "example_id": "bfaafb65-f149-4892-a8e2-c1ee908ef43a",
                                                "sense_id": "7e0554ef-9926-337a-b80e-e7ab9d3c3b6f",
                                                "text": "Il bruinait ; le Mont-Saint-Michel abandonné des touristes se dressait solitairement entre le gris du ciel et le gris de la mer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73d61530-f2c4-41f6-a881-1d05c0db67dd",
                        "source_entry_id": "7a1dfc75-d1d8-3a52-bb2b-7d12d33abf0b",
                        "source_sense_id": "1a503507-5de2-3a9f-9eba-02f7e1575436",
                        "source_sense_description": "regenen in zeer fijne druppeltjes",
                        "target_lang_word": "pleuvioter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pleuvioter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ed1fea9-7f1a-307c-9e7c-939902697fde",
                                        "entry_id": "4ec449c6-c802-3f76-a0a9-6c4bfc97ee0d",
                                        "glosses": [
                                            "Pleuvoir faiblement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5029363a-bdfd-4e42-864b-5c6954c7ef70",
                                                "sense_id": "0ed1fea9-7f1a-307c-9e7c-939902697fde",
                                                "text": "Il commença à pleuvioter au moment où Don et Eva se mirent en quête d'un taxi qui les raccompagnerait à la Grand-Place. Quand la voiture freina sur les mares d'eau de la place, les gouttes éparses s’étaient muées en pluie torrentielle."
                                            },
                                            {
                                                "example_id": "e44b08f0-6b66-4211-972b-5bcb77f6278b",
                                                "sense_id": "0ed1fea9-7f1a-307c-9e7c-939902697fde",
                                                "text": "Il pleuviota ainsi par intermittence jusque dans l'après-midi. Le vent soufflait légèrement et malgré la pluie la mer était tranquille."
                                            },
                                            {
                                                "example_id": "ec1c84fe-8254-4eea-a370-5c0ac1200661",
                                                "sense_id": "0ed1fea9-7f1a-307c-9e7c-939902697fde",
                                                "text": "Et sur les trottoirs il y avait beaucoup de pétales et de feuilles vertes et jaunes, comme si c'était Corpus Christi, et c'était à cause de la pluie, même si cet après-midi-là il pleuviotait à peine dans le quartier des Stein, pour la première fois depuis des semaines il pleuviotait à peine, il tombait seulement une pluie très fine qui mouillait à peine […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
