                "senses": [
                    {
                        "sense_id": "fd686daa-89c6-352c-bf3b-b15082bc16c6",
                        "entry_id": "7cdfb8fc-330a-3025-b6bc-4dba2b7240c7",
                        "glosses": [
                            "Veröffentlichung einer Information, amtliche Mitteilung über Ergebnisse, Beschlüsse am Ende einer Verhandlungsrunde, Tagung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d5c9543-f3ac-439b-81bf-c27b4d7ee8dd",
                                "sense_id": "fd686daa-89c6-352c-bf3b-b15082bc16c6",
                                "text": "„Nach langem Ringen wurden die Gegensätze am Samstag in das Abschlusskommuniqué aufgenommen, was für die sonst um Einigkeit bemühte Gruppe ungewöhnlich ist.“"
                            },
                            {
                                "example_id": "8aa4f3a7-b345-4e09-bf0b-9121c908f34e",
                                "sense_id": "fd686daa-89c6-352c-bf3b-b15082bc16c6",
                                "text": "„Wegen der Differenzen mit Trump, der schon die letzten beiden Gipfel im Streit enden ließ, hatte Macron von vornherein kein Abschlusskommuniqué angestrebt.“"
                            },
                            {
                                "example_id": "bff890d8-0314-43d5-a317-3eeeeab1f795",
                                "sense_id": "fd686daa-89c6-352c-bf3b-b15082bc16c6",
                                "text": "„Letztlich wurden auf dem Gipfel jedoch kaum verbindliche Entscheidungen getroffen, sondern lediglich ein Abschlusskommuniqué mit Absichtserklärungen und Maßnahmenvorschlägen veröffentlicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
