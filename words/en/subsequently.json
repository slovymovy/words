                                "nl": "Ze verloor haar paspoort en kon <w>daardoor</w> niet naar de conferentie reizen.",
                                "pl": "Zgubiła paszport i <w>w konsekwencji</w> nie mogła pojechać na konferencję.",
                                "de": "Sie verlor ihren Reisepass und konnte <w>daraufhin</w> nicht zur Konferenz reisen.",
                                "fr": "Elle a perdu son passeport et <w>de ce fait</w> n'a pas pu se rendre à la conférence.",
                                "it": "Ha perso il passaporto e <w>di conseguenza</w> non ha potuto recarsi alla conferenza.",
                                "cs": "Ztratila pas a <w>následně</w> nemohla odcestovat na konferenci.",
                                "tr": "Pasaportunu kaybetti ve <w>dolayısıyla</w> konferansa gidemedi.",
                                "es": "Ella perdió su pasaporte y, <w>en consecuencia</w>, no pudo viajar a la conferencia.",
                                "zh": "她弄丢了护照，<w>结果</w>没能去参加会议。"
                            }
                        }
