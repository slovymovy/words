                ],
                "senses": [
                    {
                        "sense_id": "08739a40-2f94-37df-aa15-e08bcce6eaef",
                        "entry_id": "6dd59582-9cef-36cb-8fdb-52a043fed668",
                        "glosses": [
                            "Provinz im Nordosten von Afghanistan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40e7c569-1faa-4386-bb2d-7c25ff5e92bf",
                                "sense_id": "08739a40-2f94-37df-aa15-e08bcce6eaef",
                                "text": "„Vor vier Jahren, als Peter Chambliss noch Mitglied der 5. Special Forces Group gewesen war, hatte sein Humvee auf einer felsigen Straße in der Provinz Kunar in Afghanistan eine Landmine ausgelöst.“"
                            },
                            {
                                "example_id": "13015164-b059-41b1-988b-44943096975e",
                                "sense_id": "08739a40-2f94-37df-aa15-e08bcce6eaef",
                                "text": "„Im Mai wurde die indische Botschaft in Kabul bombardiert, und bei Kämpfen in der Provinz Kunar wurden an einem einzigen Tag neun US-Soldaten getötet und 15 verwundet - der schwerste Verlust der US-Armee in Kampfhandlungen seit Beginn des Kriegs.“"
                            },
                            {
                                "example_id": "fd60f18a-26d4-4d15-ba47-52bfad97dee6",
                                "sense_id": "08739a40-2f94-37df-aa15-e08bcce6eaef",
                                "text": "„›24 Monate im Wüstensand und dann noch ein Jahr auf vorgeschobenem Posten in einer Militärbasis in der Provinz Kunar, da versagt anschließend jeder Psychotest, wenn er nicht berücksichtigt, was ich da mitgemacht hab - an jedem einzelnen verdammten Tag hieß es da: töten oder getötet werden.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
