                        "entry_id": "c3f78a44-d401-35be-9010-f49b0eee9788",
                        "glosses": [
                            "Avant l’ère commune. Note d’usage : Placé après une année, un siècle ou un millénaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bb522e1-d3aa-41cb-baae-5116c06ba60d",
                                "sense_id": "f3d89fe3-5883-321c-919d-dfe16f7251cb",
                                "text": "L’invention de l’agriculture en Chine a eu lieu dans le bassin du fleuve Bleu, dans le Sud, avec le début de la domestication du riz vers 8000 AEC."
                            }
                        ]
                    }
                ],
                "translations": [
