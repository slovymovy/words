    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "78686e8a-2a97-39f5-9cdb-e45c2eb1152b",
                    "sense_definition": "Of, from, or pertaining to Israel or the Israeli people.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She loves to cook traditional <w>Israeli</w> food for her friends.",
                            "target_lang_translations": {
                                "ru": "Она любит готовить для друзей традиционную <w>израильскую</w> еду.",
                                "zh": "她喜欢为朋友们烹饪传统的<w>以色列</w>美食。",
                                "es": "A ella le encanta cocinar comida tradicional <w>israelí</w> para sus amigos."
                            }
                        },
                        {
                            "text": "The <w>Israeli</w> government announced a new policy yesterday.",
                            "target_lang_translations": {
                                "ru": "<w>Израильское</w> правительство вчера объявило о новой политике.",
                                "zh": "<w>以色列</w>政府昨天宣布了一项新政策。",
                                "es": "El gobierno <w>israelí</w> anunció una nueva política ayer."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Israeli citizen",
                        "Israeli society",
                        "Israeli culture",
                        "Israeli government"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Израилю или израильскому народу.",
                        "zh": "与以色列或以色列人有关的。",
                        "es": "Relativo a Israel o al pueblo israelí."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "израильский",
                                "target_lang_sense_clarification": "прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "以色列的",
                                "target_lang_sense_clarification": "形容词，指代国家或民族"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "israelí",
                                "target_lang_sense_clarification": "adjetivo que indica origen o relación con Israel"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e639ba12-4183-3f48-adf1-bfcb2e6d7ff6",
                    "sense_definition": "A person from Israel or of Israeli descent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I met an <w>Israeli</w> while traveling through Europe last summer.",
                            "target_lang_translations": {
                                "ru": "Путешествуя по Европе прошлым летом, я встретил <w>израильтянина</w>.",
                                "zh": "去年夏天在欧洲旅行时，我遇到了一位<w>以色列人</w>。",
                                "es": "Conocí a un <w>israelí</w> mientras viajaba por Europa el verano pasado."
                            }
                        },
                        {
                            "text": "Many <w>Israelis</w> speak English very well.",
                            "target_lang_translations": {
                                "ru": "Многие <w>израильтяне</w> очень хорошо говорят по-английски.",
                                "zh": "许多<w>以色列人</w>英语说得非常好。",
                                "es": "Muchos <w>israelíes</w> hablan inglés muy bien."
                            }
                        }
                    ],
                    "common_phrases": [
                        "native Israeli",
                        "young Israelis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек родом из Израиля или имеющий израильское происхождение.",
                        "zh": "来自以色列的人或具有以色列血统的人。",
                        "es": "Persona originaria de Israel o de ascendencia israelí."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "израильтянин",
