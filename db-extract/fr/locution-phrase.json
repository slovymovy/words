                "senses": [
                    {
                        "sense_id": "af6f8cde-e54a-37dd-956e-15bb540f6550",
                        "entry_id": "fdfa1a68-e076-35e1-b58b-60cdcbced014",
                        "glosses": [
                            "Suite de mots, figée par l’usage, formant une phrase et dans laquelle la fonction de chaque mot pris isolément n’est pas analysable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b2b4cec-44b4-45e4-88b3-0b28f672e17d",
                                "sense_id": "af6f8cde-e54a-37dd-956e-15bb540f6550",
                                "text": "« Tant pis », « à la bonne heure », « œil pour œil, dent pour dent » et « dont acte » sont des locutions-phrases."
                            },
                            {
                                "example_id": "8cc428db-a76f-4b2c-b67e-a6982c0d0475",
                                "sense_id": "af6f8cde-e54a-37dd-956e-15bb540f6550",
                                "text": "Comme l’indique leur nom, le mot-phrase et la locution-phrase résument une phrase à eux seuls."
                            },
                            {
                                "example_id": "50c3f506-0097-44c9-8ee2-b844c97935db",
                                "sense_id": "af6f8cde-e54a-37dd-956e-15bb540f6550",
                                "text": "On parlera de locution-phrase à propos d’une suite de mots qui constitue une phrase, sans que le locuteur puisse attribuer une fonction (et parfois un sens) à chacun de ces mots."
                            }
                        ]
                    }
                ],
