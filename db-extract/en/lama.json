                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4621114f-8785-4601-bfcf-25ddc59e4295",
                                                "sense_id": "c9d5635d-6134-3327-be73-ce020c30b6a4",
                                                "text": "Hansjochen braucht für alles, was er tut, unendlich lange. Er ist ein echtes Lama."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "001e9a3f-0212-3a6c-825b-4f5a4cb49005",
                                        "entry_id": "4175219d-856e-3edf-a024-1411ecc8151f",
                                        "glosses": [
                                            "Person, die eine feuchte Aussprache hat"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3ca8a65-643a-4b6c-99c4-a865ee9ea5f5",
                                                "sense_id": "001e9a3f-0212-3a6c-825b-4f5a4cb49005",
                                                "text": "Heike ist ein Lama. Wenn sie redet, verlassen nicht nur Worte ihren Mund."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Lama",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3ec81b9-29b7-3a1e-85de-41ffb8f93c5d",
