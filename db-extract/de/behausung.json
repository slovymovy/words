                        ],
                        "form": "die Behausungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5e0aae36-5fe6-3db7-a6df-6d6c67398800",
                        "entry_id": "a977b726-f19c-3c4b-93c9-eae26939dd14",
                        "glosses": [
                            "einfache, schlichte, manchmal notdürftige Unterkunft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bad95dc3-8bfc-44ac-a707-7da17261599c",
                                "sense_id": "5e0aae36-5fe6-3db7-a6df-6d6c67398800",
                                "text": "„Im Inneren der Behausung hieß ihn Orwo auf einem niedrigen Sitz, einer langen, mit Rentierfellen bedeckten Bohle, Platz nehmen.“"
                            },
                            {
                                "example_id": "b8bd79e1-c7bd-49a8-916c-ea5139e2de96",
                                "sense_id": "5e0aae36-5fe6-3db7-a6df-6d6c67398800",
                                "text": "„Im Lauf der Wochen wurde die Katze mit Fyssts Behausung immer vertrauter und in ihrer Beziehung zu Fysst selbst immer kecker.“"
                            },
                            {
                                "example_id": "1a8efd19-1974-4fc9-84fc-c290bfc5706e",
                                "sense_id": "5e0aae36-5fe6-3db7-a6df-6d6c67398800",
                                "text": "„Ihre dunkle Behausung wird durch ein offenes Feuer spärlich erhellt.“"
                            },
                            {
                                "example_id": "65032f81-c1bd-4c12-86b2-5199195f9eb0",
                                "sense_id": "5e0aae36-5fe6-3db7-a6df-6d6c67398800",
                                "text": "„Auch die menschlichen Behausungen sind hier ganz wie auf der andern Seite, und hier wie dort kommen wir an Hirten, Herden und Wegarbeitern vorüber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c306a8e-30ed-4788-9a81-0a3d9eb3ec39",
                        "source_entry_id": "a977b726-f19c-3c4b-93c9-eae26939dd14",
                        "source_sense_id": "5e0aae36-5fe6-3db7-a6df-6d6c67398800",
                        "source_sense_description": "einfache, schlichte, manchmal notdürftige Unterkunft",
                        "target_lang_word": "dwelling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dwelling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e739b693-75d9-3dc0-9dad-ab8d77f73515",
                                        "entry_id": "e0e89909-12d5-3db5-9ea4-4cd04b6f0b22",
                                        "glosses": [
                                            "A house or place in which a person lives; a habitation, a home."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5873636-da5c-4746-a3ea-ff36588423ac",
                                                "sense_id": "e739b693-75d9-3dc0-9dad-ab8d77f73515",
                                                "text": "The old house served as a dwelling for Albert."
                                            },
                                            {
                                                "example_id": "3dc6f372-7f73-442d-9aa2-9980d4c674b1",
                                                "sense_id": "e739b693-75d9-3dc0-9dad-ab8d77f73515",
                                                "text": "For Philip's dwelling fronted on the street, / The latest house to landward; but behind, / With one small gate that open'd on the waste, / Flourish'd a little garden square and wall'd; [...]"
                                            },
                                            {
                                                "example_id": "53c2257d-ecff-42db-beeb-b621cf516cbe",
                                                "sense_id": "e739b693-75d9-3dc0-9dad-ab8d77f73515",
                                                "text": "The place had the empty and musty feel and smell usual to a dwelling no longer inhabited. Everywhere was a thick litter of discarded and ragged garments, old sea-boots, leaky oilskins -- all the worthless forecastle dunnage of a long voyage."
                                            },
                                            {
                                                "example_id": "f3061c5e-c5f1-4d96-8395-c775dcb4542b",
                                                "sense_id": "e739b693-75d9-3dc0-9dad-ab8d77f73515",
                                                "text": "He turned back to the scene before him and the enormous new block of council dwellings. The design was some way after Corbusier but the block was built up on plinths and resembled an Atlantic liner swimming diagonally across the site."
                                            },
                                            {
                                                "example_id": "6c72bffb-d767-40a4-81c7-33c2e346a816",
                                                "sense_id": "e739b693-75d9-3dc0-9dad-ab8d77f73515",
                                                "text": "I was so thrilled to see a live bedbug, I showed it off to every graduate student I ran into that day: Cimex lectularius[,] a small, flat, wingless, brown ectoparasite that hides in cracks and crevices in human dwellings and emerges under cover of darkness to feast on human blood."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dwelling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f88de209-0852-340b-b174-42dedb6f5b4e",
                                        "entry_id": "79d849bd-8af2-3798-a424-672c9af34feb",
                                        "glosses": [
                                            "present participle and gerund of dwell"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "078660a8-1e49-4c3b-bb90-83f32d0e587d",
                        "source_entry_id": "a977b726-f19c-3c4b-93c9-eae26939dd14",
                        "source_sense_id": "5e0aae36-5fe6-3db7-a6df-6d6c67398800",
                        "source_sense_description": "einfache, schlichte, manchmal notdürftige Unterkunft",
                        "target_lang_word": "habitation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "habitation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "352341b9-9bc1-387e-9b21-8862e686711c",
                                        "entry_id": "63be3ddc-136d-35f6-9671-5851d3f16c44",
                                        "glosses": [
                                            "The act of inhabiting; state of inhabiting or dwelling, or of being inhabited; occupancy."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "883deaf3-071c-4954-b4bb-b57e753e662d",
                                                "sense_id": "352341b9-9bc1-387e-9b21-8862e686711c",
                                                "text": "And there have been Common-wealths that having no more Territory, than hath served them for habitation, have neverthelesse, not onely maintained, but also encreased their Power, partly by the labour of trading from one place to another, and partly by selling the Manifactures, whereof the Materials were brought in from other places."
                                            },
                                            {
                                                "example_id": "d319c600-e96a-4b52-b7b6-05376528eb5b",
                                                "sense_id": "352341b9-9bc1-387e-9b21-8862e686711c",
                                                "text": "Witness this new-made world, another Heaven\nFrom Heaven-gate not far, founded in view\nOn the clear hyaline, the glassy sea;\nOf amplitude almost immense, with stars\nNumerous, and every star perhaps a world\nOf destined habitation […]"
                                            },
                                            {
                                                "example_id": "a835d01e-26c1-49d4-a0e7-9205860c0699",
                                                "sense_id": "352341b9-9bc1-387e-9b21-8862e686711c",
                                                "text": "The few miserable hovels that shewed some marks of human habitation, were now of still rarer occurrence; and, at length, as we began to ascend a huge and uninterrupted swell of moorland, they totally disappeared."
                                            },
                                            {
                                                "example_id": "cc43046c-c35d-43c7-a687-a2e4985eed22",
                                                "sense_id": "352341b9-9bc1-387e-9b21-8862e686711c",
                                                "text": "Now, however, the windows in the houses began one by one to be lit up, giving a greater sense of habitation and humanity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e68671e7-bb42-353e-8779-4e40357653ef",
                                        "entry_id": "63be3ddc-136d-35f6-9671-5851d3f16c44",
                                        "glosses": [
                                            "A place of abode; settled dwelling; residence; house."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa48580b-5f0a-454b-9b2c-ec882906b219",
                                                "sense_id": "e68671e7-bb42-353e-8779-4e40357653ef",
                                                "text": "And as imagination bodies forth\nThe forms of things unknown, the poet’s pen\nTurns them to shapes and gives to airy nothing\nA local habitation and a name."
                                            },
                                            {
                                                "example_id": "cc428e69-f5a4-4f0e-a5a9-6956e2610fa2",
                                                "sense_id": "e68671e7-bb42-353e-8779-4e40357653ef",
                                                "text": "Ye shall kindle no fire throughout your habitations upon the sabbath day."
                                            },
                                            {
                                                "example_id": "b734e1ba-3e56-4d73-ad71-8a584f4c0090",
                                                "sense_id": "e68671e7-bb42-353e-8779-4e40357653ef",
                                                "text": "Mrs Deborah, having disposed of the child according to the will of her master, now prepared to visit those habitations which were supposed to conceal its mother."
                                            },
                                            {
                                                "example_id": "85c20edc-1cf5-4a29-828f-7aa8e1e6d38f",
                                                "sense_id": "e68671e7-bb42-353e-8779-4e40357653ef",
                                                "text": "How gay the Habitations that adorn\nThis fertile Valley! Not a House but seems\nTo give assurance of content within;"
                                            },
                                            {
                                                "example_id": "2db8a66a-4721-412e-9a9c-63045f4dc5e3",
                                                "sense_id": "e68671e7-bb42-353e-8779-4e40357653ef",
                                                "text": "And this is Shanty Town, my friend. ¶ Even here the children laugh in the narrow lanes that run between these tragic habitations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03afbcef-02cf-319b-832e-67efabd14f8c",
                                        "entry_id": "63be3ddc-136d-35f6-9671-5851d3f16c44",
                                        "glosses": [
                                            "A group, lodge, or company, as of the Primrose League."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "habitation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6507fad8-d1ce-3f6c-8ca7-d17d5220b293",
                                        "entry_id": "444cbee4-38d2-3867-b9f4-2729c7270065",
                                        "glosses": [
                                            "A farm, ranch or plantation."
                                        ],
                                        "tags": [
                                            "Louisiana"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
