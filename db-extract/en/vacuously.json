                        "sense_id": "64ef7439-15cc-3fd7-b278-f1bd01f4d4b5",
                        "entry_id": "3a6f2ed1-fae0-38a4-a7a7-184c19c0213a",
                        "glosses": [
                            "In a vacuous manner, lacking thought."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c74e71dd-bafa-4ebe-9903-e929ae9ca57e",
                                "sense_id": "64ef7439-15cc-3fd7-b278-f1bd01f4d4b5",
                                "text": "Here, in distress that was consternation, and in fear that was panic, excitedly bobbed up and down a cowboy in bearskin chaps, vacuously repeating the exclamation, \"Oh God! Oh God!\" […]"
                            },
                            {
                                "example_id": "db7af43e-cdad-4d6f-b290-09c422a730fd",
                                "sense_id": "64ef7439-15cc-3fd7-b278-f1bd01f4d4b5",
                                "text": "He scowled vacuously, keeping at bay a horrible enlightenment on the mechanism of effort, which must drive into being a resistance equal to itself."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf4e9f29-640e-36d0-aa86-4e023d0cb2cb",
                        "entry_id": "3a6f2ed1-fae0-38a4-a7a7-184c19c0213a",
                        "glosses": [
                            "Because of being a vacuous truth."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5d80a60-7a58-4009-9652-62efcd170ed2",
                                "sense_id": "bf4e9f29-640e-36d0-aa86-4e023d0cb2cb",
                                "text": "The statement is vacuously true because P is false and P implies Q."
                            }
                        ]
                    }
                ],
