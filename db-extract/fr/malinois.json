                "senses": [
                    {
                        "sense_id": "67a6bec2-e073-387c-a534-69fbe5df5433",
                        "entry_id": "de75925a-5934-3d26-8c46-6de2177abe71",
                        "glosses": [
                            "Relatif à la ville belge de Malines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39944591-d94a-41e8-843d-588fe486f0ef",
                                "sense_id": "67a6bec2-e073-387c-a534-69fbe5df5433",
                                "text": "Les ateliers malinois produisent des œuvres datant à la fois de la période fastueuse des ateliers bruxellois de la fin du xvᵉ siècle et de celle de la grande production anversoise de la première moitié du xviᵉ."
                            },
                            {
                                "example_id": "0e6a8ff6-de7b-422e-81e6-570dc3132686",
                                "sense_id": "67a6bec2-e073-387c-a534-69fbe5df5433",
                                "text": "En conclusion, les volets peints d’origine malinoise se caractérisent par leur caractère éclectique."
                            },
                            {
                                "example_id": "88626571-aad4-4484-a562-831a3577435d",
                                "sense_id": "67a6bec2-e073-387c-a534-69fbe5df5433",
                                "text": "Les blocs de bois qui servaient à les façonner provenaient des fonderies de cloches malinoises."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
