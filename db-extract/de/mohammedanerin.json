                "translations": [
                    {
                        "translation_id": "ad6a39f0-4f48-446d-89bc-a395feb0c084",
                        "source_entry_id": "e60e07a9-9014-3988-990d-0c3aec5c1a0e",
                        "source_sense_id": "f3a52659-0a1f-35c4-93db-af79dd6c3fb5",
                        "source_sense_description": "veraltet, Islam, Religion: Anhängerin des Islam",
                        "target_lang_word": "Muslim",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muslim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2ef67c0-92b0-38fa-99e8-e18c5b439151",
                                        "entry_id": "75a49b57-cb12-3a33-8d61-660d69333e20",
                                        "glosses": [
                                            "A person who is a follower and believer of Islam."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2eaba674-32ce-49a5-bb11-d35b9c4615a4",
                                                "sense_id": "d2ef67c0-92b0-38fa-99e8-e18c5b439151",
                                                "text": "It was gouerned by Macuac, which conditioned with Amrus that euery Egyptian should pay an Egyptian peece of Gold, and to entertaine three dayes euery Muslim which passed that way."
                                            },
                                            {
                                                "example_id": "f54537a5-fc79-4bcc-820a-a47b9404dc03",
                                                "sense_id": "d2ef67c0-92b0-38fa-99e8-e18c5b439151",
                                                "text": "Muslims invented the concept of zero, which is a foundation for the numbering system used throughout the world."
                                            },
                                            {
                                                "example_id": "3d68a910-c601-47c4-b48c-1a252948d569",
                                                "sense_id": "d2ef67c0-92b0-38fa-99e8-e18c5b439151",
                                                "text": "“At the end of the day, Jews and Muslims are cousins,” Alhomsi said."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Muslim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16524950-ec6c-3740-9b13-bc15d3b6244e",
                                        "entry_id": "43b2a4e8-8e9b-3d18-bd1e-f9058e8dee03",
                                        "glosses": [
                                            "Being or relating to a believer of Islam."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f5cd4cc-317e-434c-99ce-57a2d56ec3e3",
                                                "sense_id": "16524950-ec6c-3740-9b13-bc15d3b6244e",
                                                "text": "The notion of blood purity was first elaborated in Europe, where it was used to separate Old Christians from Spain’s New Christians—women and men of Jewish and Muslim origin whose ancestors had converted to Christianity."
                                            },
                                            {
                                                "example_id": "c8bc5261-3abc-407a-8fd6-f917890969ac",
                                                "sense_id": "16524950-ec6c-3740-9b13-bc15d3b6244e",
                                                "text": "Kaplan-Miller said she first joined the Sisterhood of Salaam Shalom, an interfaith organization that was founded by a Muslim and a Jewish woman in suburban New Jersey, shortly after the 2016 election."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Muslim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3f68db2-4092-381a-bbed-c1d3581c0552",
                                        "entry_id": "df2e09a8-bafa-35ef-817d-954a2539432e",
                                        "glosses": [
                                            "A barangay of Guindulungan, Maguindanao del Sur, Philippines."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4aa72c24-7b1d-4bbd-9e72-088f1dd8694b",
                        "source_entry_id": "e60e07a9-9014-3988-990d-0c3aec5c1a0e",
                        "source_sense_id": "f3a52659-0a1f-35c4-93db-af79dd6c3fb5",
                        "source_sense_description": "veraltet, Islam, Religion: Anhängerin des Islam",
                        "target_lang_word": "musulmane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "musulmane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7bc298ad-62d4-3cc1-91c9-3eda83dcb3d9",
                                        "entry_id": "ec4f5620-3c92-3de1-ad14-4f8ec2a98f9e",
                                        "glosses": [
                                            "Femme musulmane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c9eeb60-074c-4ccc-9f53-a6530f6a95c6",
                                                "sense_id": "7bc298ad-62d4-3cc1-91c9-3eda83dcb3d9",
                                                "text": "On leur parle de roumis ennemis. Ennemis ? Les musulmanes des douars kabyles n'ont jamais vu de roumis. Comment pourraient-elles les haïr ? On leur dit qu'après le départ des roumis l'Algérie renaîtra, la terre sera aux musulmans."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "musulmane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0188fd6-3c34-3f94-ae05-605680a5bfe5",
                                        "entry_id": "7b85ac71-c222-39de-8ccf-023954a77de9",
                                        "glosses": [
                                            "Féminin singulier de musulman."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "765d5538-bbf4-4d48-8316-02b90c80632f",
                                                "sense_id": "a0188fd6-3c34-3f94-ae05-605680a5bfe5",
                                                "text": "Ainsi, l’‘ivoirité’ s’est ‘débaoulisée’ […] pour se régionaliser et camper un ‘Sud’ utile et autochtone face à l’immigration étrangère et musulmane provenant du ‘Nord’, c’est-à-dire du Burkina Faso, du Mali, de Guinée mais aussi, par glissements successifs, des départements septentrionaux de la Côte d’Ivoire : un patronyme sahélien suffit désormais à l’administration et à la police pour confisquer les papiers d’identité d’un ressortissant ivoirien et ouvrir la porte à d’interminables tracasseries"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
