                                "target_senses": [
                                    {
                                        "sense_id": "2cb622e6-392f-3875-a6ee-71eb8eb97139",
                                        "entry_id": "a72feeb1-7620-37f5-b916-f59984020624",
                                        "glosses": [
                                            "de wetenschap die de werking van giftige stoffen op biologische systemen bestudeert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebdeb241-b490-40c0-a892-82ec64900c52",
                                                "sense_id": "2cb622e6-392f-3875-a6ee-71eb8eb97139",
                                                "text": "Een belangrijke vraag binnen de toxicologie is hoe giftige stoffen zich verspreiden."
