                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e05942eb-4425-43a1-b083-4c04e0f01bd2",
                                "sense_id": "3834c097-e6a5-315c-b550-333bbbe3b567",
                                "text": "„Nick ging an den Straßenbahnschienen entlang und wandte sich an der nächsten Bogenlampe in eine Nebenstraße.“"
                            },
                            {
                                "example_id": "4d509b2a-798d-4246-ab41-05aa2ec8aec6",
                                "sense_id": "3834c097-e6a5-315c-b550-333bbbe3b567",
                                "text": "„Mittels Kran wurden Straßenbahnschienen von einem auf dem Ladegleis stehenden Eisenbahnwaggon auf einen LKW verladen.“"
                            },
                            {
                                "example_id": "9880f284-7a7e-4010-86af-ef1bbc4032ab",
                                "sense_id": "3834c097-e6a5-315c-b550-333bbbe3b567",
                                "text": "„generelles Verbot, zu bestimmten Jahreszeiten (wegen der Schneeräumung beziehungsweise Straßenreinigung), oder beschildertes Verbot, zu bestimmten Tageszeiten (während des Berufsverkehrs in der Früh und in den späten Nachmittagsstunden) in Straßen mit Straßenbahnschienen Kraftfahrzeuge zu parken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
