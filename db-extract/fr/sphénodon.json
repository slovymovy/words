                        "entry_id": "e9e44446-cf34-301a-8198-19fb20b89af1",
                        "glosses": [
                            "Reptile panchronique (Sphenodon punctatus et Sphenodon guntheri) de l’ordre des rhynchocéphales (aussi appelé rhynchocephalia ou sphenodontia), originaire de Nouvelle-Zélande, ressemblant au lézard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f81a079c-1860-4716-a0ce-c2c04e463c4b",
                                "sense_id": "7c7ec08f-50a2-3dd8-89fe-dd2fb78243c4",
                                "text": "Aujourd’hui le sphénodon (Sphenodon punctatus), dont certains reconnaissent deux espèces, ne se trouve plus qu’en Nouvelle-Zélande et encore seulement sur des îlots au nord de l’île du Nord."
                            }
                        ]
                    }
