                                    {
                                        "sense_id": "a844b841-ca02-3aef-b0da-b55048fc83cb",
                                        "entry_id": "3872994f-5152-3c0f-a55d-67e2215612a6",
                                        "glosses": [
                                            "Bewohner von Alexandria, jemand, der aus Alexandria stammt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e991d351-833b-4cee-a6ca-3bdd286d93da",
                                                "sense_id": "a844b841-ca02-3aef-b0da-b55048fc83cb",
                                                "text": "Mein Wohnungsnachbar ist ein gebürtiger Alexandriner."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Alexandriner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54390aa7-c2a1-31e8-a101-0ce94e93c095",
                                        "entry_id": "06b300fa-1e74-3c25-a29f-3c2db54170c8",
                                        "glosses": [
                                            "Versmaß aus zwölf oder auch dreizehn Silben mit fester Zäsur nach der sechsten Silbe, das in der französischen Literatur entwickelt wurde"
                                        ],
                                        "tags": [
                                            "Metrik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06d91e36-865e-471d-98ca-dceb7cd83506",
                                                "sense_id": "54390aa7-c2a1-31e8-a101-0ce94e93c095",
                                                "text": "Dieses Epos ist in Alexandrinern verfasst."
                                            },
                                            {
                                                "example_id": "ba70a991-6964-4f02-a732-62c5bbe5da84",
                                                "sense_id": "54390aa7-c2a1-31e8-a101-0ce94e93c095",
                                                "text": "„Es umfasst in der 1770 umgearbeiteten Fassung, die Wieland nebst damaliger Vorrede auch in seine »Sämmtlichen Werke« aufnimmt, über 500 Verse, Alexandriner, das heißt sechshebige Jamben mit deutlicher Zäsur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Alexandriner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94518d15-4c3b-34a5-8476-0deac9dd82f8",
                                        "entry_id": "54bbf0bb-d7ab-3043-bb50-fc08785ad90f",
                                        "glosses": [
                                            "gelehrte Person, vor allem im Bereich der Philosophie"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b806bfce-5219-4a49-90b6-4d64a2edc46f",
                                                "sense_id": "94518d15-4c3b-34a5-8476-0deac9dd82f8",
                                                "text": "Die Alexandriner der Hellenismuszeit gehörten zu einem Verbund unabhängiger Lehrer, die im „Museion“ (Musentempel) von Alexandria ihre Studien betrieben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "29337ccd-269d-3dea-a084-4a5231509845",
                                        "entry_id": "54bbf0bb-d7ab-3043-bb50-fc08785ad90f",
                                        "glosses": [
                                            "Anhänger des Alexandrismus"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4bdfaaf-1555-422c-bc32-b407c430fb06",
                                                "sense_id": "29337ccd-269d-3dea-a084-4a5231509845",
                                                "text": "Die Alexandriner der Renaissancezeit sind nach Alexander von Aphrodisias (um 200 n. Chr.) benannt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Alexandriner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ed63637-6fb9-3d50-b9ad-02f30ba1aee4",
                                        "entry_id": "9b7a651d-a874-35f3-b5e2-90922bf5a734",
                                        "glosses": [
                                            "Münzgeld, das in Alexandria zur römischen Kaiserzeit geprägt wurde"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21c24e1c-0bf6-4678-93ca-99bf000c92c7",
                                                "sense_id": "5ed63637-6fb9-3d50-b9ad-02f30ba1aee4",
                                                "text": "Das Provinzialgeld Alexandriner schloss verschiedene Nominale ein: Tetradrachme, Drachme, Hemidrachme und andere."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
