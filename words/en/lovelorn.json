                    "frequency": "Low",
                    "semantic_group_id": "romantic_distress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>lovelorn</w> poet spent many nights writing melancholy verses about his unreturned affection."
                        },
                        {
                            "text": "After their sudden breakup, he wandered through the quiet streets like a <w>lovelorn</w> wanderer."
                        }
                    ],
                    "common_phrases": [
                        "lovelorn puppy",
                        "lovelorn youth"
                    ]
                },
                {
                    "sense_id": "02965caf-2766-3489-9677-11e28369d474",
                    "sense_definition": "Bereft of love; completely lacking affection or feeling unloved.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "romantic_distress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The neglected garden seemed like a fitting metaphor for his <w>lovelorn</w> existence."
                        },
                        {
                            "text": "She felt completely <w>lovelorn</w> and isolated after moving alone to an unfamiliar city."
                        }
                    ],
                    "synonyms": [
