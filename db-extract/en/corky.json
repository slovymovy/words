                                        "entry_id": "6f6f1b50-b521-3207-8888-4c06554e845c",
                                        "glosses": [
                                            "Qui a un goût de bouchon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d4d4678-bf74-4896-8e46-385d78bd969d",
                                                "sense_id": "068bb281-df4e-3030-a1e8-3ed9f7268cee",
                                                "text": "Dites… Vous l’avez goûté le vin, là ? Il me paraît bien bouchonné."
                                            }
                                        ]
                                    },
