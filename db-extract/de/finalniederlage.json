                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6fb4a54-ee0f-4b71-a5a5-8c54d0b2110f",
                                "sense_id": "884622e3-cb30-3506-bdbb-8eeaf4af2926",
                                "text": "„Es sollte nicht die letzte Finalniederlage bleiben.“"
                            },
                            {
                                "example_id": "2c4e972b-120b-44ce-9b41-ea910bf352fe",
                                "sense_id": "884622e3-cb30-3506-bdbb-8eeaf4af2926",
                                "text": "„Schumacher war zumindest das erste Tor anzulasten und er hatte Anteil an der Finalniederlage gegen Argentinien.“"
                            },
                            {
                                "example_id": "71deaa84-1f43-4e0c-8293-55b9b937f3b1",
                                "sense_id": "884622e3-cb30-3506-bdbb-8eeaf4af2926",
                                "text": "„Nach ihrer vierten Finalniederlage in Folge waren die Berliner unendlich deprimiert.“"
                            },
                            {
                                "example_id": "20f8e740-b1ed-445b-8e18-141b751107e9",
                                "sense_id": "884622e3-cb30-3506-bdbb-8eeaf4af2926",
                                "text": "„Und 2017, nach Juves Finalniederlage gegen Real Madrid, wurde in Neapel ein Feuerwerk gezündet.“"
                            },
                            {
                                "example_id": "5ba63466-094e-49d9-8ae8-ff0ef362df46",
                                "sense_id": "884622e3-cb30-3506-bdbb-8eeaf4af2926",
                                "text": "„Im März 2006 schoss ich eine Woche nach der bitteren Finalniederlage bei unserem 1:2 in der Premier League als erster Wigan-Spieler ein Pflichtspieltor gegen Manchester United.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
