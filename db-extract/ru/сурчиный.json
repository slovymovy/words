                "senses": [
                    {
                        "sense_id": "a84ce46f-dcff-3bfb-8de6-7025055fe2ad",
                        "entry_id": "8207f31d-9b6a-356b-8acf-19e1a62ceb27",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным сурок; свойственный или принадлежащий сурку, суркам"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac6ebd44-ec75-4ef5-8cf9-b71ffa3781a9",
                                "sense_id": "a84ce46f-dcff-3bfb-8de6-7025055fe2ad",
                                "text": "Ближе к горам стали встречаться сурчиные норы."
                            },
                            {
                                "example_id": "f1929e47-0040-4691-a5aa-4f586462c8f9",
                                "sense_id": "a84ce46f-dcff-3bfb-8de6-7025055fe2ad",
                                "text": "Старуха поила Петра сурчиным жиром, настоем целебных трав, снятых весною, в майском цвету."
                            }
                        ]
                    }
