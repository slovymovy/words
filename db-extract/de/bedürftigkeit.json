                ],
                "senses": [
                    {
                        "sense_id": "c68e3980-fa12-39be-8f02-032fde214efe",
                        "entry_id": "6d6ffa42-0933-39b7-8dc5-d60cbc87d051",
                        "glosses": [
                            "Zustand, etwas Notwendiges dringend zu entbehren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25064a86-a229-4e68-b3dd-6c5d62c9eb99",
                                "sense_id": "c68e3980-fa12-39be-8f02-032fde214efe",
                                "text": "„Dem Pathos weiblicher Bedürftigkeit ist mein Sohn auf grausamste Weise verfallen.“"
                            },
                            {
                                "example_id": "9f1338fc-cb5e-4762-ac36-47e7cdf63473",
                                "sense_id": "c68e3980-fa12-39be-8f02-032fde214efe",
                                "text": "Bedingungsloses Grundeinkommen – Arbeitslosenunterstützung, Sozialhilfe, Kindergeld, Rente, alles wird abgeschafft und ersetzt durch einen pauschalen monatlichen Satz, den jeder ohne Ansehen seiner Person und Bedürftigkeit bekommt."
                            },
                            {
                                "example_id": "34dae446-0ee8-4d89-9535-693656119162",
                                "sense_id": "c68e3980-fa12-39be-8f02-032fde214efe",
                                "text": "„Wird in diesem Einkommensbereich [der Geringverdiener] nicht zusätzlich für das Alter vorgesorgt, steigt das Risiko der Bedürftigkeit im Alter stark an.“"
                            },
                            {
                                "example_id": "b5d856d3-7631-4dc9-ad2a-9d6ca82e05f3",
                                "sense_id": "c68e3980-fa12-39be-8f02-032fde214efe",
                                "text": "„Meistens begleitete Adrienne Sylvia nach Les Déserts, aber etwas in ihr war angesichts all der Rastlosigkeit und Bedürftigkeit auch aufgeblüht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8e0ef82-c1a9-4ad6-bc03-aa4e1873232a",
                        "source_entry_id": "6d6ffa42-0933-39b7-8dc5-d60cbc87d051",
                        "source_sense_id": "c68e3980-fa12-39be-8f02-032fde214efe",
                        "source_sense_description": "Zustand, etwas Notwendiges dringend zu entbehren",
                        "target_lang_word": "indigence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indigence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6ab48fb-b41b-3d0d-a567-f83809baee58",
                                        "entry_id": "2f061f31-8fea-3792-91f6-8cebe2f42999",
                                        "glosses": [
                                            "Extreme poverty or destitution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0e86081-9777-4d53-b205-951e44e1f4fa",
                                                "sense_id": "a6ab48fb-b41b-3d0d-a567-f83809baee58",
                                                "text": "On Professor Solanka’s street, well-heeled white youths lounged in baggy garments on roseate stoops, stylishly simulating indigence while they waited for the billionairedom that would surely be along sometime soon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bd92100-5b8e-4c0d-93fe-dfce30447c21",
                        "source_entry_id": "6d6ffa42-0933-39b7-8dc5-d60cbc87d051",
                        "source_sense_id": "c68e3980-fa12-39be-8f02-032fde214efe",
                        "source_sense_description": "Zustand, etwas Notwendiges dringend zu entbehren",
                        "target_lang_word": "indigence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indigence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "900cc72f-8520-3b7e-b449-bf707bf4e53e",
                                        "entry_id": "53b1f4be-0d1e-3c69-ba7c-e3db44338f1e",
                                        "glosses": [
                                            "Grande pauvreté ; privation du nécessaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f1d6c17-c7ed-4294-a122-5a27fca9742d",
                                                "sense_id": "900cc72f-8520-3b7e-b449-bf707bf4e53e",
                                                "text": "Blangy avait donné trois autres hommes, douze femmes, huit filles et cinq garçons, dont les maris et les pères devaient répondre, et qui étaient dans une entière indigence ; mais aussi c’étaient les seuls qui ne possédassent rien."
                                            },
                                            {
                                                "example_id": "df38dbb9-e8ef-446b-b31e-f99e45237d6d",
                                                "sense_id": "900cc72f-8520-3b7e-b449-bf707bf4e53e",
                                                "text": "Vous relevez l’indigence de leur vocabulaire monsieur l’Inspecteur ?"
                                            },
                                            {
                                                "example_id": "f1b52e94-d71c-4c73-8deb-b124ec469695",
                                                "sense_id": "900cc72f-8520-3b7e-b449-bf707bf4e53e",
                                                "text": "Le yé-yé désigne un genre, l'ensemble des exhibitions de mineurs ignares, exhibitions vocales ou instrumentales, individuelles ou collectives, caractérisées par leur outrance sonore et leur indigence d’expression."
                                            },
                                            {
                                                "example_id": "c96167f0-eeb7-4aa6-a93e-5ece458acaf2",
                                                "sense_id": "900cc72f-8520-3b7e-b449-bf707bf4e53e",
                                                "text": "Afin de souligner l’indigence des moyens matériels de la Mairie on notera que l’essentiel de ses biens mobiliers devant être introduits dans son patrimoine se résume à 2 camions bennes, un camion citerne vidangeur et 1 citerne à eau acquis en 1997 ; […]."
                                            },
                                            {
                                                "example_id": "df2bd969-8837-4b8e-a97c-6a61304238a9",
                                                "sense_id": "900cc72f-8520-3b7e-b449-bf707bf4e53e",
                                                "text": "Ce qui ne veut pas dire, ajoute-t-il, que les catholiques de notre unité doivent avaler toutes les couleuvres qu’on leur propose et que les athées ou agnostiques ne revêtiront pas la burka (sic) après avoir digéré, avec beaucoup de mal, les indigences de nos gérants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f6c8d4f-afbd-3127-8b07-b0988d4236e8",
                                        "entry_id": "53b1f4be-0d1e-3c69-ba7c-e3db44338f1e",
                                        "glosses": [
                                            "État de pauvreté qui appelle les secours publics ou privés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f9d32c6-b2a9-4405-aee4-ec39b012a7f3",
                                                "sense_id": "8f6c8d4f-afbd-3127-8b07-b0988d4236e8",
                                                "text": "Certificat d’indigence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76500541-f1f9-34bc-886b-421a874f31d5",
                                        "entry_id": "53b1f4be-0d1e-3c69-ba7c-e3db44338f1e",
                                        "glosses": [
                                            "Ensemble des indigents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
