                    "common_phrases": [
                        "duidelijke structuur",
                        "behoefte aan structuur",
                        "vaste structuur"
                    ],
                    "target_lang_definitions": {
                        "en": "The way in which a complex whole is built up to provide order and stability."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "structure",
                                "target_lang_sense_clarification": "the overall organization of something"
                            },
                            {
                                "target_lang_word": "framework",
                                "target_lang_sense_clarification": "a supporting or underlying system"
                            },
                            {
                                "target_lang_word": "order",
                                "target_lang_sense_clarification": "the arrangement or disposition of people or things"
                            }
                        ]
