                    {
                        "sense_id": "297626ce-c4b6-32ac-8274-49a62e6e0b31",
                        "entry_id": "ec6bb555-914c-3ab0-a0c3-d8ebfe790b25",
                        "glosses": [
                            "een groothartig persoon denkt niet alleen maar aan zijn eigenbelang maar ook aan de belangen van zijn medemensen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4628634-71d4-467c-a905-83b87db94f5e",
                                "sense_id": "297626ce-c4b6-32ac-8274-49a62e6e0b31",
                                "text": "De edelmoedige man voelde zich de koning te rijk toen hij de resultaten van zijn hulp zag."
                            },
                            {
                                "example_id": "887c09b3-9b0f-494e-b7c5-fac234f3745c",
                                "sense_id": "297626ce-c4b6-32ac-8274-49a62e6e0b31",
                                "text": "Over studenten gesproken. Wat geweldig dat onze Nobelprijswinnaar Ben Feringa zijn studenten zo expliciet naar voren schoof en zijn felbegeerde prijs grootmoedig met hen deelde. Leuke gozer, dacht ik toen ik hem op televisie zag. En knettergek. Dat dacht ik ook. Wie komt er nou op het idee om moleculen onder invloed van ultraviolet licht te laten ronddraaien? Sterker nog: hij maakt er voertuigen van die 80.000 keer kleiner zijn dan een menselijke haar."
                            }
                        ]
                    }
