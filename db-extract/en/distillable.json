                                    {
                                        "sense_id": "bddcc4bc-0174-3a3c-8a13-98a0dd0fb315",
                                        "entry_id": "3fc4c442-a4fb-3217-91bc-74bbd7ceca74",
                                        "glosses": [
                                            "Qui peut être distillé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "927d83b9-9bd1-4655-a61a-272c9a0593a2",
                                                "sense_id": "bddcc4bc-0174-3a3c-8a13-98a0dd0fb315",
                                                "text": "La prospérité de la distillerie est subordonnée à une bonne récolte, à la fois parce que la matière distillable est alors à bon marché et parce que cette bonne récolte met les agriculteurs à même d’acheter le produit distillé."
                                            },
                                            {
                                                "example_id": "5facdf36-5047-44d7-a2ee-e7089817a8f2",
                                                "sense_id": "bddcc4bc-0174-3a3c-8a13-98a0dd0fb315",
                                                "text": "Une partie de ces pétroles est distillable à pression atmosphérique, fournissant gaz de pétrole liquéfié, essence, kérosène et gazole (dits de première distillation, ou « straight-run »)."
                                            },
                                            {
                                                "example_id": "7d1f07ae-d957-46f4-bc06-ac042303aea4",
                                                "sense_id": "bddcc4bc-0174-3a3c-8a13-98a0dd0fb315",
                                                "text": "Ainsi irrémédiablement assaisonné, le vin de Vincent, cette année-là, ne fut ni consommable, ni distillable, ni acétifiable."
                                            }
                                        ]
                                    }
