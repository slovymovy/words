                "senses": [
                    {
                        "sense_id": "79bf0c56-3289-35b2-a6c7-74da63c745b5",
                        "entry_id": "6a73426b-59a8-3728-8341-5a3f1c1e0fec",
                        "glosses": [
                            "Lactarius mushroom, milk-cap"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "e20a7dd6-546d-4730-b52c-6760258c22e1",
                                "sense_id": "79bf0c56-3289-35b2-a6c7-74da63c745b5",
                                "text": "Назва́лся гру́здем — полеза́й в ку́зов.",
                                "translation": "In for a penny, in for a pound; you've made your bed, now lie in it.",
                                "english": "In for a penny, in for a pound; you've made your bed, now lie in it."
                            },
                            {
                                "example_id": "2b7e79ec-a15d-4b39-b75a-00eca2c80790",
                                "sense_id": "79bf0c56-3289-35b2-a6c7-74da63c745b5",
                                "text": "Сухи́е бе́лые грибы́ свари́ть и ме́лко нашинкова́ть соло́мкой, гру́зди и ры́жики промы́ть, та́кже нашинкова́ть и ошпа́рить."
                            }
                        ]
                    }
                ],
