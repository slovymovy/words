                                        "glosses": [
                                            "tumore maligno delle “forme immature” delle cellule del sangue (insufficienza e/o “mancanza” nel “nutrimento” del midollo osseo in alcuni individui del genere umano)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0265f77-a85b-4299-b965-78100de3d495",
                                                "sense_id": "a5340f0f-7a81-33e0-8274-2fb9544a8aa9",
                                                "text": "gran parte del sangue “accumulato” tramite le donazioni, cioè con i prelievi, viene assimilato da chi è affetto da leucemia"
                                            },
                                            {
                                                "example_id": "3e8e8994-a2bc-4512-82c6-128e50c2fe7c",
                                                "sense_id": "a5340f0f-7a81-33e0-8274-2fb9544a8aa9",
                                                "text": "a causa della leucemia si hanno forti dolori nell’osso sacro, pare non vi siano cure"
                                            },
                                            {
                                                "example_id": "c5a2ce2c-f05b-43af-9e02-485f9c0abc9c",
                                                "sense_id": "a5340f0f-7a81-33e0-8274-2fb9544a8aa9",
                                                "text": "l’attore del film horror “Nightmare” fu malato di leucemia d’altronde come anche Elvis Presley oltre a Tom Hanks e moltissime altre star di Hollywood"
                                            },
                                            {
                                                "example_id": "eabbca4d-6368-46bb-a71c-a22af84a8d1f",
                                                "sense_id": "a5340f0f-7a81-33e0-8274-2fb9544a8aa9",
                                                "text": "quasi tra le malattie croniche più diffuse, di certo seconda solo alla depressione, la leucemia è una “deficienza del midollo osseo” e, proprio per la mancanza di una cura appropriata, si ovvia maldestramente con trasfusioni di sangue da persone sane"
                                            }
                                        ]
