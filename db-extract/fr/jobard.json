                    }
                ],
                "senses": [
                    {
                        "sense_id": "04172f69-6a24-385b-bffb-4a26eb132769",
                        "entry_id": "d9cf0074-83d3-39b3-9c67-678e883740fb",
                        "glosses": [
                            "Simple d’esprit, crédule, niais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75f9d5d1-9dfa-49c2-a190-a500536fe28a",
                                "sense_id": "04172f69-6a24-385b-bffb-4a26eb132769",
                                "text": "– Si vous trouvez plaisant d’être jobard…\n– Dans jobard il y a Job, mon ami."
                            },
                            {
                                "example_id": "f1d7a013-8848-452d-bdce-6550528d392c",
                                "sense_id": "04172f69-6a24-385b-bffb-4a26eb132769",
                                "text": "« Décidément, vous êtes le plus curieux garçon que je connaisse… Il y a en vous du paladin et du jobard, si vous me permettez de vous le dire… Chevalier à midi… Bouffon à minuit… Vous excellez dans tous les emplois !…"
                            },
                            {
                                "example_id": "bf9249c2-760a-4474-8811-d047c0acfed3",
                                "sense_id": "04172f69-6a24-385b-bffb-4a26eb132769",
                                "text": "Aujourd’hui, poursuivit-il, transi, purotin, jobard, moulu par l’affliction, ayant un gros bourdon, il avait cru, naïf, qu’un cyprin du Jardin d’Acclimatation lui offrirait, pourquoi pas ? un amical bonjour."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d4b4471-4818-4f4c-9f91-ad0cdb30dfb9",
                        "source_entry_id": "d9cf0074-83d3-39b3-9c67-678e883740fb",
                        "source_sense_id": "04172f69-6a24-385b-bffb-4a26eb132769",
                        "target_lang_word": "onnozel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onnozel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a84116c9-5b02-354f-b054-48484e076737",
                                        "entry_id": "bbd1e6f8-1d0c-349c-848d-56a1846e2233",
                                        "glosses": [
                                            "onschadelijk (ook van zaken)"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44a59e47-ffae-4bc0-831f-bc45f7c7607c",
                                                "sense_id": "a84116c9-5b02-354f-b054-48484e076737",
                                                "text": "Item die derde schouwe is des Woensdages na sinte Martijnsdach in den winter alle dyken in hair volle groot te wesen up 10 se., then ware offet den hiemraden onnosel dochte wesen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b136ecf-1064-32ca-986d-7a20015567a5",
                                        "entry_id": "bbd1e6f8-1d0c-349c-848d-56a1846e2233",
                                        "glosses": [
                                            "onschuldig, schuldeloos (zonder seksuele ervaringen)"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64371630-212c-4f46-b72b-cf8e71e0213c",
                                                "sense_id": "1b136ecf-1064-32ca-986d-7a20015567a5",
                                                "text": "Het feest van de Onnozele Kinderen wordt op 28 december gevierd."
                                            },
                                            {
                                                "example_id": "d590cffc-b933-47f8-acac-f195aa6fd7c7",
                                                "sense_id": "1b136ecf-1064-32ca-986d-7a20015567a5",
                                                "text": "di cuesch ende fijn ende onbeulect es, betekent mede daer ic noit met sunde en dede maer hebben gehouden van kinde alneen onosel van wiuen ende suuer ende reen"
                                            },
                                            {
                                                "example_id": "315e3038-b0ef-4561-9e24-75deff7b4e7d",
                                                "sense_id": "1b136ecf-1064-32ca-986d-7a20015567a5",
                                                "text": "Ende vp onse kinder na desen. Doe dede al dar pylatus. Gheselen den onnoselen ihesus. Want het was die romsce wet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83f3f90e-7ee4-3ab7-b6ce-cae93b99bd8d",
                                        "entry_id": "bbd1e6f8-1d0c-349c-848d-56a1846e2233",
                                        "glosses": [
                                            "dwaas, naïef"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a91f3dd-3361-4a20-b97e-339a388704c3",
                                                "sense_id": "83f3f90e-7ee4-3ab7-b6ce-cae93b99bd8d",
                                                "text": "De Heeren vragen hem, waar in hy een dief was; De Lant-heer antwoord: Om dat mijn buur-mans zeug, die hy zijn Boer betrouwt had, elf biggelen geworpen had, en zijn ezelin, die hem te bewaren gegeven was, maar een jong geworpen had. Door welke onnozele antwoord, de Heeren bestonden te lagchen, hem vragende, of hy dan ook een dief was, om dat zijn vrouw maar een kind gebaart had? Hy antwoorde, dat het den aart der vrouwen was, gemeenlijk maar een kint voort te brengen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a8dee02-67ac-327a-9902-e641e3b1b3a6",
                                        "entry_id": "bbd1e6f8-1d0c-349c-848d-56a1846e2233",
                                        "glosses": [
                                            "niet ernstig"
                                        ],
                                        "tags": [
                                            "van een ding, kwestie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a7b93d7-c602-34ce-ba55-d0c1ff5cf615",
                                        "entry_id": "bbd1e6f8-1d0c-349c-848d-56a1846e2233",
                                        "glosses": [
                                            "onbeduidend, onbelangrijk"
                                        ],
                                        "tags": [
                                            "van een ding"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3998359f-a3dd-413b-84af-74be35bff66c",
                                                "sense_id": "2a7b93d7-c602-34ce-ba55-d0c1ff5cf615",
                                                "text": "Heel die ruzie was om een onnozele paraplu?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "04f6a319-317c-3911-a203-b472c0faa3b7",
                "word": "jobard",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e05c080f-6034-4714-916b-c34ad2b84630",
                        "entry_id": "04f6a319-317c-3911-a203-b472c0faa3b7",
                        "tags": [
                            "plural"
                        ],
                        "form": "jobards"
                    },
                    {
                        "form_id": "32774206-9cb2-40b4-8b51-3a75a40fc1f2",
                        "entry_id": "04f6a319-317c-3911-a203-b472c0faa3b7",
                        "tags": [
                            "feminine"
                        ],
                        "form": "jobarde"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "edf94e22-eab7-3bc4-85ce-76e363a445d1",
                        "entry_id": "04f6a319-317c-3911-a203-b472c0faa3b7",
                        "glosses": [
                            "Celui qui est simple d’esprit, crédule, niais."
                        ],
                        "tags": [
                            "Moquerie familière"
                        ],
                        "examples": [
                            {
                                "example_id": "679c1444-fe62-426f-a6e9-7f1beb647655",
                                "sense_id": "edf94e22-eab7-3bc4-85ce-76e363a445d1",
                                "text": "Toi ! tu es né pour être autre chose qu’un jobard, tu es en homme ce que je suis en femme : un génie gouapeur !"
                            },
                            {
                                "example_id": "b06f3257-3c20-434d-a5c7-b81c347a2380",
                                "sense_id": "edf94e22-eab7-3bc4-85ce-76e363a445d1",
                                "text": "Tu ne m'empêcheras pas de dire que c'est un jobard. Il comptait pour se refaire sur la dot de la fille à Bernage, et on vient de la lui souffler."
                            },
                            {
                                "example_id": "31ba9184-42e8-420a-b05f-cdd45ebaa600",
                                "sense_id": "edf94e22-eab7-3bc4-85ce-76e363a445d1",
                                "text": "Épouse-la, si le cœur t’en dit, mon pauvre Pierre : trompé avant, trompé après, t’es bien assez jobard pour faire un cocu."
                            },
                            {
                                "example_id": "430367fa-7cb4-4f71-9d10-35087b369d14",
                                "sense_id": "edf94e22-eab7-3bc4-85ce-76e363a445d1",
                                "text": "Vexé d’être pris pour un jobard, l’arbitre décerna un carton jaune à l’un des simulateurs."
                            },
                            {
                                "example_id": "6accce52-5d95-4e58-a8a2-0c0f78865d53",
                                "sense_id": "edf94e22-eab7-3bc4-85ce-76e363a445d1",
                                "text": "Dans l’argot du monde criminel, le terme de « jobard » désigne la victime, actuelle ou virtuelle, de formes concertées d’exploitation illégale."
                            },
                            {
                                "example_id": "96cb8217-4176-41a6-a96c-2e526f629c88",
                                "sense_id": "edf94e22-eab7-3bc4-85ce-76e363a445d1",
                                "text": "S’il y a un jobard ici, et surtout un malade fou à lier, c’est bien toi."
                            },
                            {
                                "example_id": "642abad6-50ba-491d-ac9e-6b8c6d0143a1",
                                "sense_id": "edf94e22-eab7-3bc4-85ce-76e363a445d1",
                                "text": "Les nihilistes de 1880 étaient une secte mystique, des rêveurs, les routiniers du bonheur universel. Nous, nous étions aux antipodes de ces jobards et de leurs fumeuses théories."
                            }
                        ]
                    }
                ],
