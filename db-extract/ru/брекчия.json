                        ]
                    },
                    {
                        "translation_id": "8bbf1315-05fb-49fa-a330-c4562bdbcda4",
                        "source_entry_id": "5741fccf-ad4a-33be-b8d3-ccdcb701832c",
                        "source_sense_id": "aa3b1286-5e36-3eb7-a2fc-6510085f3d0e",
                        "target_lang_word": "brèche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brèche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a688d5ba-3ac0-3389-ae43-abe22fd2db80",
                                        "entry_id": "5b83d123-9dbd-3f2c-8343-8906114731d8",
                                        "glosses": [
                                            "Ouverture dans une clôture, un mur, une haie…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d77b5e9-5ce3-4cc4-9a5b-448aaf93ce04",
                                                "sense_id": "a688d5ba-3ac0-3389-ae43-abe22fd2db80",
                                                "text": "La dimension de la litière obligea plusieurs fois de faire élargir des chemins et abattre les murailles de quelques villes et villages où elle ne pouvait entrer ; en sorte, disent les auteurs des manuscrits du temps, tout pleins d’une sincère admiration pour ce luxe, en sorte qu’il semblait un conquérant qui entre par la brèche."
                                            },
                                            {
                                                "example_id": "99266816-7a2d-4899-97a1-a855e9831371",
                                                "sense_id": "a688d5ba-3ac0-3389-ae43-abe22fd2db80",
                                                "text": "L’ennemi entrait dans la ville par escalade ou par une brèche, sans que pour cela la garnison se rendît ; car alors, celle-ci renfermée dans les tours qui, je le répète, sont autant de réduits indépendants, pouvait se défendre encore."
                                            },
                                            {
                                                "example_id": "feb0234f-473e-4111-9465-147a6d69eb42",
                                                "sense_id": "a688d5ba-3ac0-3389-ae43-abe22fd2db80",
                                                "text": "Au bout de cinq minutes de cette course, il parvint à un endroit où le mur avait une sorte de brèche ; il la franchit."
                                            },
                                            {
                                                "example_id": "c4d78397-5e28-49b3-bb23-cd4b80871217",
                                                "sense_id": "a688d5ba-3ac0-3389-ae43-abe22fd2db80",
                                                "text": "Ouvrir une brèche dans une artère de calibre important afin de réaliser un cathétérisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fbf9e99-a121-3631-bd61-deca09a27d71",
                                        "entry_id": "5b83d123-9dbd-3f2c-8343-8906114731d8",
                                        "glosses": [
                                            "Vide ou cassure que l’on fait dans quelque chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "713ed05a-103f-41a5-b1c0-6280d6b3ef73",
                                                "sense_id": "6fbf9e99-a121-3631-bd61-deca09a27d71",
                                                "text": "J’obstrue avec du coton et de l’étoupe la brèche que présente le pont."
                                            },
                                            {
                                                "example_id": "3799a60f-035f-4500-a1bd-5df28577b240",
                                                "sense_id": "6fbf9e99-a121-3631-bd61-deca09a27d71",
                                                "text": "Le tranchant de ce couteau a de nombreuses brèches."
                                            },
                                            {
                                                "example_id": "65b25cb1-ff17-4fec-b11c-58752ed54330",
                                                "sense_id": "6fbf9e99-a121-3631-bd61-deca09a27d71",
                                                "text": "Ouverture ou passage pratiqué par les assaillants dans une fortification ou un front."
                                            },
                                            {
                                                "example_id": "99d7c6e6-e958-4133-b037-5a74e0086b5f",
                                                "sense_id": "6fbf9e99-a121-3631-bd61-deca09a27d71",
                                                "text": "Mais aucun des 136 bombardiers français et anglais ayant effectué des missions n'aura été envoyé ce jour-là sur la principale brèche du front, le pont de Gaulier. Les mille Panzers pourront donc traverser la Meuse sans être inquiétés […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc823655-2526-3763-8003-5bce388d8f67",
                                        "entry_id": "5b83d123-9dbd-3f2c-8343-8906114731d8",
                                        "glosses": [
                                            "Partie entamée d'un ensemble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7826fd91-bf05-478c-8715-622845b842ed",
                                                "sense_id": "bc823655-2526-3763-8003-5bce388d8f67",
                                                "text": "Il y a une brèche à ce pâté, quelqu’un en a mangé une partie. — On a abattu cent arpents de bois dans cette forêt, cela fait une grande brèche."
                                            },
                                            {
                                                "example_id": "f5c80732-90c7-4706-b788-c4f5bc26be99",
                                                "sense_id": "bc823655-2526-3763-8003-5bce388d8f67",
                                                "text": "On dut faire, en cette nuit du 23 avril, une belle brèche à la réserve de champagne de Lady Arbukle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cff2f509-4671-3474-b4c0-0ca86c7e701c",
                                        "entry_id": "5b83d123-9dbd-3f2c-8343-8906114731d8",
                                        "glosses": [
                                            "Tort, dommage que l’on fait à quelque chose, la diminution d’un bien qui devrait être conservé entier, intact."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84b6aa4a-1438-4199-a1ae-f9884b3e3f3f",
                                                "sense_id": "cff2f509-4671-3474-b4c0-0ca86c7e701c",
                                                "text": "Il a fait une brèche à sa réputation."
                                            },
                                            {
                                                "example_id": "d2bef8fe-ded8-43a0-b56e-fdef24fbc4ed",
                                                "sense_id": "cff2f509-4671-3474-b4c0-0ca86c7e701c",
                                                "text": "Cela fait brèche à sa fortune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7db842a6-fe66-35bb-9919-6e1fbe9b4f78",
                                        "entry_id": "5b83d123-9dbd-3f2c-8343-8906114731d8",
                                        "glosses": [
                                            "Écart de deux jeux d’avance, break."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23cf6aa8-af60-3d4e-a044-a124db7cc1a8",
                                        "entry_id": "5b83d123-9dbd-3f2c-8343-8906114731d8",
                                        "glosses": [
                                            "Ouverture dans la coque résistante d’un sous-marin pour embarquer du matériel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b5d05a4-ac40-3743-99fa-dc6a00d812f9",
                                        "entry_id": "5b83d123-9dbd-3f2c-8343-8906114731d8",
                                        "glosses": [
                                            "Absence d’un ou plusieurs nucléotides dans un des deux brins de l’ADN."
                                        ],
                                        "tags": [
                                            "Génétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06b623f5-04f0-4fb8-8a85-feacc73be156",
                                                "sense_id": "3b5d05a4-ac40-3743-99fa-dc6a00d812f9",
                                                "text": "La transposition s'accompagne, en effet, d'une brèche dans l’ADN, qui peut être réparée par conversion génique, séquence partiellement homologue aux bords de la brèche servant de donneur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brèche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "725d6ca7-3015-3927-977f-777b71ffc84d",
                                        "entry_id": "faf877a1-b6a7-3dab-8969-09af6106a309",
                                        "glosses": [
                                            "Réunion de pierres agglutinées par un ciment naturel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7817364c-427a-405c-bcde-98824fcf9afb",
                                                "sense_id": "725d6ca7-3015-3927-977f-777b71ffc84d",
                                                "text": "La chapelle de la Vierge, entièrement revêtue de porphyre, de jaspe, de brèches jaunes et violettes d’un poli admirable, est d’une richesse qui dépasse les splendeurs des Mille et une Nuits."
                                            },
                                            {
                                                "example_id": "7d66e8b3-f605-4b11-842d-da15be8dd48b",
                                                "sense_id": "725d6ca7-3015-3927-977f-777b71ffc84d",
                                                "text": "Les alluvions anciennes […] sont essentiellement formées d'un sable quartzeux dans la masse duquel on rencontre du gravier et des cailloux roulés de nature variable : porphyre pétrosiliceux, brèche, granite à amphibole des Ballons, porphyrites et quartzites, celles-ci provenant du démantèlement des poudingues de grès."
                                            },
                                            {
                                                "example_id": "51a3a01d-2216-4464-a8be-645d184e4265",
                                                "sense_id": "725d6ca7-3015-3927-977f-777b71ffc84d",
                                                "text": "Brèche. Roche hétérogène, formée de fragments assez volumineux, anguleux, quelquefois émoussés mais non roulés, agglutinés par une pâte contemporaine ou un peu postérieure à la formation des fragments."
                                            },
                                            {
                                                "example_id": "6c959e4d-26c6-4127-9a1f-bf6be206fbc5",
                                                "sense_id": "725d6ca7-3015-3927-977f-777b71ffc84d",
                                                "text": "Là, au moins deux grands fossiles ont été exhumés. Arrachés à la terre devrait-on dire, tant ils étaient incarcérés dans les brèches, et tant a été difficile leur extraction. Tout d’abord Mrs Ples, un Australopithecus africanus (mâle en réalité) découvert par Robert Broom en 1947."
                                            },
                                            {
                                                "example_id": "8fff7e99-a6e7-4dd4-a4a4-6437f569e9d3",
                                                "sense_id": "725d6ca7-3015-3927-977f-777b71ffc84d",
                                                "text": "Les ossements, très fragiles et souvent associés à ceux d’animaux (léopard, hyène), sont pris dans un sédiment, la brèche, aussi solide que du béton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffd9d8a2-0611-3a01-a30f-a83e0d750674",
                                        "entry_id": "faf877a1-b6a7-3dab-8969-09af6106a309",
                                        "glosses": [
                                            "Sorte de marbre veiné qui semble formé d’un amas de petits cailloux de différentes couleurs fortement unis, de manière qu'en le cassant il se forme des brèches qui lui ont fait donner ce nom."
                                        ],
                                        "tags": [
                                            "Marbrerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a182ce6c-cc1e-4aa6-a3e4-b39554966d53",
                                                "sense_id": "ffd9d8a2-0611-3a01-a30f-a83e0d750674",
                                                "text": "De la brèche violette."
                                            },
                                            {
                                                "example_id": "1ba200f5-80f8-4cfd-8273-f8a2ca648f22",
                                                "sense_id": "ffd9d8a2-0611-3a01-a30f-a83e0d750674",
                                                "text": "[…] bronze, stuc, bois précieux, fer forgé, brèche de Numibie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brèche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4dd8aed-31db-3e4c-8842-05732c66ee83",
                                        "entry_id": "d4c05f8f-7214-3aec-8c34-1808214585b4",
                                        "glosses": [
                                            "Papillon noctuidé d'Europe et d'Afrique du Nord, dont le dos des ailes est de couleur brune à paille."
                                        ],
                                        "tags": [
                                            "Lépidoptérologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd7d0b61-8283-4970-a7ca-1f19f74ef0eb",
                                                "sense_id": "a4dd8aed-31db-3e4c-8842-05732c66ee83",
                                                "text": "La chenille de la brèche se nourrit sur l'arbre aux papillons, l'orchis, la scrophulaire ou le bouillon blanc."
                                            },
                                            {
                                                "example_id": "ff14fe69-ceba-4a3b-87ba-ca34c7c34f7c",
                                                "sense_id": "a4dd8aed-31db-3e4c-8842-05732c66ee83",
                                                "text": "La Cucullie du bouillon blanc, alias la Brèche, est parfois appelée la \"Noctuelle du bouillon blanc\", dénomination faisant référence à son appartenance à la Famille des Noctuidae."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brèche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b746696-5000-399c-8675-64b731fde0ae",
                                        "entry_id": "3e65ce7a-9e2f-3416-9113-32bc440852f0",
                                        "glosses": [
                                            "Rayon de miel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f8221f1-05d0-4691-9e6e-970370cb3a28",
                                                "sense_id": "0b746696-5000-399c-8675-64b731fde0ae",
                                                "text": "Un cérificateur est constitué par une caisse en bois ou en métal munie d'un couvercle vitré. On le place au soleil pour accumuler de l'énergie calorifique et fondre ainsi les rayons que l'on y a disposé. La cire se sépare peu à peu des cocons et du pollen et s'écoule sur le fond incliné. Les dimensions du cérificateur sont fonction de la quantité moyenne de brèches à traiter."
                                            },
                                            {
                                                "example_id": "f6a77f7d-d61d-4bd1-a7c0-6e8c63b80250",
                                                "sense_id": "0b746696-5000-399c-8675-64b731fde0ae",
                                                "text": "Dans certaines régions apicoles, et notamment du Massif central aux Cévennes, il arrive que l’on trouve sans trop de peine du miel en brèche, y compris dans certains supermarchés. C’est du miel encore en rayon, tel qu’il se présente quand l’apiculteur l’extrait de la ruche."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brèche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bda481de-ee0f-3136-85be-611879aa28bf",
                                        "entry_id": "af325a54-8e7b-35b8-8194-491feacf028c",
                                        "glosses": [
                                            "Saut effectué par un cachalot, une baleine, jaillissant de l’océan à la verticale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65671f3e-c70c-47a5-87d8-9251f191ac23",
                                                "sense_id": "bda481de-ee0f-3136-85be-611879aa28bf",
                                                "text": "La chose est manifeste chez Moby Dick : à chacune de ses apparitions attestées, ou presque, il se fend d’un pont, d’une montagne, d’un arc-en-ciel au-dessus des eaux – œuvres spectaculaires par ailleurs appelées brèche (breach) par Ismahel, le bonhomme narrateur, et par tous les Anglo-Saxons."
                                            },
                                            {
                                                "example_id": "34793328-0a6a-4485-a055-5aaaf50a9925",
                                                "sense_id": "bda481de-ee0f-3136-85be-611879aa28bf",
                                                "text": "En octobre 2004, des chercheurs du Centre de recherche sur les baleines de l’Université de Southern Cross ont pu prélever des échantillons de peau de Migaloo lorsqu’il a fait une brèche, laissant des fragments dans l’eau."
                                            }
                                        ]
                                    }
                                ]
                            },
