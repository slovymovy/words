                "senses": [
                    {
                        "sense_id": "bc18f22e-e771-3a41-9062-980e4bb00b72",
                        "entry_id": "626cc8f1-78c2-3a05-9d9f-5c00efd0c06b",
                        "glosses": [
                            "The amount that will fit into a basket"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f41e95bd-c79b-4012-9be1-b86c81e19cda",
                                "sense_id": "bc18f22e-e771-3a41-9062-980e4bb00b72",
                                "text": "Basketsful of mail for Svetlana began to arrive, friendly notes of welcome to America, marriage proposals, invitations to join religious organizations, as well as the occasional variation of \"Go back home, Red dog! Our cat is better than you. She takes care of her children.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15232bb9-a3c5-431c-9618-7b7f6e481e9e",
                        "source_entry_id": "626cc8f1-78c2-3a05-9d9f-5c00efd0c06b",
                        "source_sense_id": "bc18f22e-e771-3a41-9062-980e4bb00b72",
                        "source_sense_description": "the amount that will fit into a basket",
                        "target_lang_word": "hottée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hottée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "035152fb-e074-3b1c-8b99-b63c15617ccd",
                                        "entry_id": "08dcbbf4-6eaa-3b9d-8bb5-772f2b9b7fcf",
                                        "glosses": [
                                            "Le contenu d’une hotte pleine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc324b30-2467-43b4-b564-05d18fba7538",
                                                "sense_id": "035152fb-e074-3b1c-8b99-b63c15617ccd",
                                                "text": "Pendant ce temps-là, Brisquet étoit revenu par le grand chemin de Puchay, en passant par la Croix-aux-Ânes sur l’abbaye de Mortemer, parce qu’il avoit une hottée de cotrets à fournir chez Jean Paquier."
                                            },
                                            {
                                                "example_id": "083b97c4-8795-4822-806c-a89170bde5f8",
                                                "sense_id": "035152fb-e074-3b1c-8b99-b63c15617ccd",
                                                "text": "Le monarque mangea au dessert une pleine quertinée, ou, si vous le préférez, une pleine hottée de pêches et mourut d’indigestion."
                                            },
                                            {
                                                "example_id": "19a3918e-a14e-49ee-a1cf-ebcd44869d24",
                                                "sense_id": "035152fb-e074-3b1c-8b99-b63c15617ccd",
                                                "text": "Ma mère, le visage en sueur, geignant et soufflant, versait dans un coin de la grange une hottée de carottes ou de pommes de terre ; puis, de la manche de son caraco, elle essuyait son front, et restait un instant immobile, appuyée au mur."
                                            },
                                            {
                                                "example_id": "baa416b4-7f78-4cee-a5df-06630339dd27",
                                                "sense_id": "035152fb-e074-3b1c-8b99-b63c15617ccd",
                                                "text": "[…], on lui glisse toujours quelques douceurs. Elle les refuse, puis finit par les accepter pour sa vieille mère : un pot de miel, une paire de grives, une hottée de pommes."
                                            },
                                            {
                                                "example_id": "18256cd2-240b-473a-9a24-715d74baa1a6",
                                                "sense_id": "035152fb-e074-3b1c-8b99-b63c15617ccd",
                                                "text": "Grande quantité."
                                            },
                                            {
                                                "example_id": "9fb279c6-1434-4973-9761-f9f6180104f1",
                                                "sense_id": "035152fb-e074-3b1c-8b99-b63c15617ccd",
                                                "text": "Elle s’élança vers sa belle-sœur ; et toutes deux, l’une énorme avec son ventre menaçant, l’autre épileptique et maigre, la voix changée, la main tremblante, s’envoyèrent à pleine gueule des hottées d’injures."
                                            },
                                            {
                                                "example_id": "8349c11e-071b-4690-b567-a72168e5ddf6",
                                                "sense_id": "035152fb-e074-3b1c-8b99-b63c15617ccd",
                                                "text": "Je me suis arrêté d’écrire pour ramasser ces lettres dans mes doigts. Elles étaient sèches et légères comme le souvenir. Tout ce trésor qui s’écrasait contre ma poitrine. Toute cette hottée de feuilles mortes. Je me suis approché de la cheminée."
                                            }
                                        ]
                                    }
                                ]
                            },
