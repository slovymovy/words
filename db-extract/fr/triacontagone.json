                                        "sense_id": "e121a8a3-1ef5-34ff-a901-8b778fc017dd",
                                        "entry_id": "7d51a58f-c428-3503-8e21-0fae9098b56f",
                                        "glosses": [
                                            "A polygon with thirty sides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44612917-901d-435f-ac65-cccc25634f8c",
                                                "sense_id": "e121a8a3-1ef5-34ff-a901-8b778fc017dd",
                                                "text": "After projection onto the (x₁, x₂) plane, the A’s, B’s, C’s, and D’s form four concentric triacontagons, inscribed in circles of radii a, b, c, and d."
                                            },
                                            {
                                                "example_id": "dfac756f-1f6c-403e-9b51-ba86a6e56fd2",
                                                "sense_id": "e121a8a3-1ef5-34ff-a901-8b778fc017dd",
                                                "text": "1964 July, B. L. Chilton, On the Projection of the Regular Polytope {5, 3, 3} into a Regular Triacontagon, Canadian Mathematical Bulletin, Volume 7, Number 3, page 386,\nIn the projection the 600 points can be classified in 12 sets: each set consists of either of 30 or of 60 vertices which lie on a circle concentric with the outer triacontagon."
                                            },
                                            {
                                                "example_id": "7dc81bff-1df2-4df6-93bd-cebc25db95ac",
                                                "sense_id": "e121a8a3-1ef5-34ff-a901-8b778fc017dd",
                                                "text": "1997, Johannes Kepler, E. J. Aiton, Alistair Matheson Duncan, Judith Veronica Field (translators), The Harmony of the World, [1619, Harmonices Mundi], American Philosophical Society, Volume 309, page 59,\nWhat should the decision now be about the sides of the Triacontagon?"
                                            }
                                        ]
                                    }
