                                        "sense_id": "c3ee53f7-1e53-39ff-9506-7b220c9c9780",
                                        "entry_id": "fac67943-4e46-33c1-be4b-302c0feb0926",
                                        "glosses": [
                                            "Stange, mit deren Hilfe Lasten fortbewegt werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "979d227f-8096-4cc8-aa25-226f6fdc91c8",
                                                "sense_id": "c3ee53f7-1e53-39ff-9506-7b220c9c9780",
                                                "text": "„Ihnen folgte, von vier Männern nur mühsam getragen, der getötete Tiger, der wie ein Leinwandsack an der Tragstange hing.“"
                                            }
                                        ],
