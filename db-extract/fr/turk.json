                "senses": [
                    {
                        "sense_id": "6dfcb46d-c4d6-3886-8a79-37cc841618db",
                        "entry_id": "8ff4a49b-b388-3d9d-bde0-28adf8ad919a",
                        "glosses": [
                            "Variante de turc."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "fc84ed78-5235-4fbd-8745-11fcf4ad4bed",
                                "sense_id": "6dfcb46d-c4d6-3886-8a79-37cc841618db",
                                "text": "À la différence des Turcs, habitants de Turquie, on désigne par Turks tous les peuples parlant des langues du groupe « turk » (azéri, turkmène, ouzbek, kazakh, kirghize, tatare, etc.)."
                            },
                            {
                                "example_id": "cba4acd7-48e8-4085-b6f5-65b31e4b9647",
                                "sense_id": "6dfcb46d-c4d6-3886-8a79-37cc841618db",
                                "text": "Dans les langues turkes, par exemple, l’une des séries d’indices suffixés provient à coup sûr de la série pronominale […]"
                            },
                            {
                                "example_id": "6a572a1c-1cbb-4c1e-97ea-f721169cbc48",
                                "sense_id": "6dfcb46d-c4d6-3886-8a79-37cc841618db",
                                "text": "Outre les langues du Caucase, Marr connaissait également de nombreuses langues de l’Union Soviétique, ouralo-altaïques et turkes (tchouvache)."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c67c23b-fdfb-3827-8fb0-6ef9acabf9da",
                        "entry_id": "8ff4a49b-b388-3d9d-bde0-28adf8ad919a",
                        "glosses": [
                            "Relatif aux peuples de langues turciques, aux peuples turcs d’Asie centrale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03ce5583-b411-4af4-bd70-737c521f95f6",
                                "sense_id": "7c67c23b-fdfb-3827-8fb0-6ef9acabf9da",
                                "text": "Tout d’abord l’empereur chercha à se frayer une route vers l’ouest à travers les tribus turkes et tibétaines, ce qui lui fut possible lorsque le général Ho K’iu-ping eut conquis en 121 Kan Tcheou et Leang Tcheou."
                            }
                        ]
                    }
