                                    {
                                        "sense_id": "3e8c67dc-5787-33c3-8b17-e5b87c455286",
                                        "entry_id": "cd66d207-1aa1-3dc7-9cb9-67e7328f643c",
                                        "glosses": [
                                            "Any of (at least) seven centres of spiritual energy in or near the body, according to Ayurveda philosophy."
                                        ],
                                        "tags": [
                                            "Hinduism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dac9572-a8d6-4cbf-b0ea-9f602bad8adc",
                                                "sense_id": "3e8c67dc-5787-33c3-8b17-e5b87c455286",
                                                "text": "In the etheric body of a yogini in meditation, the polarity is, therefore, not between the brain and the genitals, the second and sixth chakras, but between the inner sexuality of the womb and the heart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a82c5fc-6d2d-361a-aac9-88088cb3ca69",
                                        "entry_id": "cd66d207-1aa1-3dc7-9cb9-67e7328f643c",
                                        "glosses": [
                                            "Synonym of hackery."
                                        ],
                                        "tags": [],
