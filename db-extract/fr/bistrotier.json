                "senses": [
                    {
                        "sense_id": "17cb2905-0c1f-3cdc-9760-342d7e34ba34",
                        "entry_id": "d819ae4e-11d2-3ff9-b9a5-b647e56594ac",
                        "glosses": [
                            "Celui qui tient un bistro."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "900daa6d-9578-4cbc-bb7a-62824f93b216",
                                "sense_id": "17cb2905-0c1f-3cdc-9760-342d7e34ba34",
                                "text": "Il est un peu fier, ton client, disent certains au bistrotier."
                            },
                            {
                                "example_id": "f7bc6a95-d2fa-4b47-9e9e-c86d7c367f7b",
                                "sense_id": "17cb2905-0c1f-3cdc-9760-342d7e34ba34",
                                "text": "Les percolateurs, antiques, achetés d’occasion à ces marchés aux puces réservés aux bistrotiers, dans les antres de la rue de Lappe, commençaient leur labeur, non sans peine, ils n’étaient plus de première jeunesse : ils éternuaient, ils toussaient, laissant gicler des jets de vapeur avant de distiller un jus de chique cent fois mâchée."
                            }
                        ]
                    }
