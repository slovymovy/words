                                        "entry_id": "ee220271-411e-3bb2-b15f-72ed3b45ad41",
                                        "glosses": [
                                            "To deport to a penal colony."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13aca1fc-42d5-3faa-ab1e-3ac276860aa3",
                                        "entry_id": "ee220271-411e-3bb2-b15f-72ed3b45ad41",
                                        "glosses": [
                                            "To move (someone) to strong emotion; to carry away."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "962335c6-1e56-4415-8faf-d4ecec32ba21",
                                                "sense_id": "13aca1fc-42d5-3faa-ab1e-3ac276860aa3",
                                                "text": "Music transports the soul."
                                            },
                                            {
                                                "example_id": "2a8da080-5390-4ccb-9c19-3438cf65641f",
                                                "sense_id": "13aca1fc-42d5-3faa-ab1e-3ac276860aa3",
                                                "text": "Thes. Pray you kneele not,\nI was transported with your Speech, and suffer'd\nYour knees to wrong themselves; I have heard the fortunes\nOf your dead Lords, which gives me such lamenting\nAs wakes my vengeance, and revenge for 'em."
                                            },
                                            {
                                                "example_id": "d8ddb434-2bcc-40c5-8bf6-cd9dd61a69a0",
                                                "sense_id": "13aca1fc-42d5-3faa-ab1e-3ac276860aa3",
                                                "text": "[They] laugh as if transported with some fit / Of passion."
                                            },
                                            {
                                                "example_id": "2482cb92-68fa-46e3-8eb1-152caa3d96c8",
                                                "sense_id": "13aca1fc-42d5-3faa-ab1e-3ac276860aa3",
                                                "text": "We shall then be transported with a nobler […] wonder."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
