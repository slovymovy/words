                "senses": [
                    {
                        "sense_id": "ab666ac7-d794-3056-9d19-28f56a497c76",
                        "entry_id": "893ada1e-ba69-359a-a9c0-56b52d256d4f",
                        "glosses": [
                            "Eigenschaft einer Funktion, bei der die Verknüpfung mit sich selbst die gleichen Ergebnisse liefert wie bei der ersten Anwendung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ae32c47-9bca-4061-92af-4f934e59bd35",
                                "sense_id": "ab666ac7-d794-3056-9d19-28f56a497c76",
                                "text": "Eine Idempotenz liegt vor, wenn die Multiplikation einer Zahl mit sich selbst als Ergebnis dieselbe Zahl ergibt; dies trifft für die Zahlen 0 und 1 zu."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bd8fa1a9-f758-3ee3-9c41-5b263b3f0235",
                        "entry_id": "893ada1e-ba69-359a-a9c0-56b52d256d4f",
                        "glosses": [
                            "Eigenschaft einer Methode, dass sie nach mehrmaliger Verwendung die gleichen Ergebnisse liefert wie bei der ersten Anwendung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6f30e24-e5f4-4930-bc43-63aae9c9a126",
                                "sense_id": "bd8fa1a9-f758-3ee3-9c41-5b263b3f0235",
                                "text": "In der Kommunikation zwischen Mensch und Maschine ist dann Idempotenz gegeben, wenn das mehrmalige Drücken eines Knopfes den gleichen Effekt hat wie das einmalige Drücken."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
