                {
                    "sense_id": "b5f30ef0-e306-3896-96f3-db1fc09b07d2",
                    "sense_definition": "Morceau d'étoffe usée, déchirée ou réduite en lambeaux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tissu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après des années d'abandon, le vieux rideau pendait à la fenêtre comme une triste <w>loque</w>."
                        },
                        {
                            "text": "Le vent violent a déchiré la voile du bateau qui n'est désormais plus qu'une <w>loque</w> inutile."
                        }
                    ],
                    "synonyms": [
                        "chiffon",
                        "haillon",
                        "lambeau"
                    ],
                    "common_phrases": [
