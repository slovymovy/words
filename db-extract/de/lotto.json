                    {
                        "translation_id": "2e042bc4-94cd-4e8c-80fa-f14c1f0cd2fe",
                        "source_entry_id": "94563350-9833-3186-bcaa-f9e8d4f90016",
                        "source_sense_id": "f5111a03-2dde-3a4f-bbc6-fcd9dbf90e02",
                        "source_sense_description": "Zahlenglücksspiel",
                        "target_lang_word": "loterie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loterie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aef27e0e-d0ba-3523-89c9-1d7f0bacea79",
                                        "entry_id": "846d724b-005b-383d-a343-3a6777896118",
                                        "glosses": [
                                            "Sorte de jeu de hasard où l’on fait des mises, pour lesquelles on reçoit des billets portant des numéros : celui ou ceux de ces numéros qui sortent, lorsque le tirage a lieu, donnent droit à un lot, par exemple à la propriété d’un objet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6761be40-9ce0-427b-87b9-a4bb23c5c54a",
                                                "sense_id": "aef27e0e-d0ba-3523-89c9-1d7f0bacea79",
                                                "text": "Lors des essais libres de 6 Heures de Fuji, au Japon, les gagnants d’une loterie peuvent circuler au milieu des bolides, dont certains participeront, fin juin 2023, aux 24 Heures du Mans."
                                            },
                                            {
                                                "example_id": "eaded41a-9b36-460a-8220-c7b005d269dd",
                                                "sense_id": "aef27e0e-d0ba-3523-89c9-1d7f0bacea79",
                                                "text": "Et les minutes se remirent à couler inexorablement, une à une, avec ce petit frottement doux et métallique des roues de loteries dans les foires."
                                            },
                                            {
                                                "example_id": "a917b9d3-d73c-456f-bc2e-b3615aa8e7dd",
                                                "sense_id": "aef27e0e-d0ba-3523-89c9-1d7f0bacea79",
                                                "text": "L’élan des grands manèges soulevant le cœur et faisant crier d’effroi les adolescentes dans la nuit bleue ne s'écarte qu’en apparence des loteries pauvrettes et des tirettes aux peluches à deux sous."
                                            },
                                            {
                                                "example_id": "6fe828f6-fb35-4e10-a8ac-ffb47d2a0f56",
                                                "sense_id": "aef27e0e-d0ba-3523-89c9-1d7f0bacea79",
                                                "text": "Voulez vous le mettre en loterie?\nAssurément, ce sera le gros lot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6ef175d-14ae-3910-8159-a9ba5f7db73d",
                                        "entry_id": "846d724b-005b-383d-a343-3a6777896118",
                                        "glosses": [
                                            "Sorte de banque établie par quelques gouvernements, dans laquelle les particuliers font des mises et courent la chance de gagner des sommes plus ou moins considérables, ou risquent de perdre leur argent."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33112e11-4ffe-4f42-8b9b-1626e7456aa1",
                                                "sense_id": "f6ef175d-14ae-3910-8159-a9ba5f7db73d",
                                                "text": "La loterie royale de France fut supprimée en 1836."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24aae74e-0f65-3747-9364-820343a1a329",
                                        "entry_id": "846d724b-005b-383d-a343-3a6777896118",
                                        "glosses": [
                                            "Affaire de hasard."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57c27df9-63e5-4f32-aa6e-ed53b720a96f",
                                                "sense_id": "24aae74e-0f65-3747-9364-820343a1a329",
                                                "text": "— Ah, oui ! Tu continues d'espérer. La chasse aux yoyettes, c'est de la pure loterie. Dénicher l’oiseau rare équivaut à gagner le jackpot au loto ou au tiercé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea1f7d05-f46e-4eb6-a2f9-bcc9b278a295",
                        "source_entry_id": "94563350-9833-3186-bcaa-f9e8d4f90016",
                        "source_sense_id": "f5111a03-2dde-3a4f-bbc6-fcd9dbf90e02",
                        "source_sense_description": "Zahlenglücksspiel",
                        "target_lang_word": "loto",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loto",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0811441e-a652-397a-9d98-0b279408ed4b",
                                        "entry_id": "175d4d54-2f9c-337f-9546-46ae8d0d4e39",
                                        "glosses": [
                                            "Sorte de jeu qu’on joue avec des numéros, dont les uns sont sur des sortes de boules, de jetons qu’on tire au sort, les autres sur des tableaux distribués aux joueurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7166db54-6c1c-4f6b-a50d-91c4d70f27e2",
                                                "sense_id": "0811441e-a652-397a-9d98-0b279408ed4b",
                                                "text": "Le Parisien prenait-il son lorgnon pour examiner les singuliers accessoires de la salle, […], aussitôt les joueurs de loto levaient le nez et le considéraient avec autant de curiosité qu’ils en eussent manifesté pour une girafe."
                                            },
                                            {
                                                "example_id": "9f00de87-b4d8-4a58-b7e0-f8e50b84022c",
                                                "sense_id": "0811441e-a652-397a-9d98-0b279408ed4b",
                                                "text": "Sur trois rangées de tables, les joueurs étaient alignés en bon ordre, certains avec la femme et la marmaille qui chahutait dans les travées. Des cartons de loto avec de gros numéros noirs et des cases vides en face des joueurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc5f06de-8551-36c3-8c44-dd2521bbb639",
                                        "entry_id": "175d4d54-2f9c-337f-9546-46ae8d0d4e39",
                                        "glosses": [
                                            "Séance où l’on joue à ce jeu."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d3e32bd-7eaa-46b6-8796-33fde9c2cbb0",
                                                "sense_id": "dc5f06de-8551-36c3-8c44-dd2521bbb639",
                                                "text": "Si l’essor du phénomène associatif (loto des pompiers, des musiciens à la Sainte-Cécile, du club du troisième âge, des parents d’élèves, des anciens combattants, des boulistes, de la paroisse, des chasseurs…) atteste de mutations sociales et favorise des ambiances particulières, il montre aussi la permanence des besoins de la communauté."
                                            },
                                            {
                                                "example_id": "27d23766-75e4-48f2-8430-3a67bdba4dfc",
                                                "sense_id": "dc5f06de-8551-36c3-8c44-dd2521bbb639",
                                                "text": "La loi autorise l’organisation d’un loto, sans autorisation ni déclaration préalable, à condition qu’il respecte les conditions suivantes:\n— poursuivre un but social, culturel, scientifique, éducatif, sportif ou d’animation sociale, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d2b0681-b957-3cfa-9f22-936d59bad5d2",
                                        "entry_id": "175d4d54-2f9c-337f-9546-46ae8d0d4e39",
                                        "glosses": [
                                            "Ensemble des objets dont on se sert pour jouer à ce jeu."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a90d366-02e7-4311-8f14-5bb60262ba1b",
                                                "sense_id": "1d2b0681-b957-3cfa-9f22-936d59bad5d2",
                                                "text": "Une boite de loto bien complète doit renfermer 24 cartons, un petit sac contenant 700 petits jetons d‘os ou d’ivoire peints en rouge, un sac plus rond, ordinairement en peau, qui contient 90 boules numérotées, une petite corbeille, une tablette dont la surface présente de petits enfoncements destinés à recevoir les boules, enfin un certain nombre de jetons blancs."
                                            },
                                            {
                                                "example_id": "dc8d812f-2cdd-4b22-b008-7f5e6d1e9fb0",
                                                "sense_id": "1d2b0681-b957-3cfa-9f22-936d59bad5d2",
                                                "text": "[…] ; ces mœurs sont loin d’être austères, puisqu’on trouve dans ce salon une table de jeu, une boîte de loto ainsi que quatre raquettes et deux volants, ancêtre peut-être du badminton, et même une baignoire dans le corridor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
