                ],
                "senses": [
                    {
                        "sense_id": "888d86e0-58c3-3587-b499-941c978d4a26",
                        "entry_id": "f5a71c01-0232-3176-81c9-2b9b0f01eea7",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "881633e0-f041-415c-94b8-a742f62aad69",
                                "sense_id": "888d86e0-58c3-3587-b499-941c978d4a26",
                                "text": "Frau Nägele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "32bc0901-fdbe-48d9-a1e6-23bddc8fdeaa",
                                "sense_id": "888d86e0-58c3-3587-b499-941c978d4a26",
                                "text": "Herr Nägele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fe70e110-fee2-4fe3-b797-1965244d3f95",
                                "sense_id": "888d86e0-58c3-3587-b499-941c978d4a26",
                                "text": "Die Nägeles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "37263a35-c9fe-4e66-b0e8-1b629b5d0a58",
                                "sense_id": "888d86e0-58c3-3587-b499-941c978d4a26",
                                "text": "Der Nägele trägt nie die Pullover, die die Nägele ihm strickt."
                            },
                            {
                                "example_id": "1bbd815a-0eaa-45a1-872e-6433d8ccb644",
                                "sense_id": "888d86e0-58c3-3587-b499-941c978d4a26",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Nägele kommt, geht der Herr Nägele.“"
                            },
                            {
                                "example_id": "c8b4f784-5e9a-4a61-896b-538ac8779fbc",
                                "sense_id": "888d86e0-58c3-3587-b499-941c978d4a26",
                                "text": "Nägele kommt und geht."
                            },
                            {
                                "example_id": "b6076d94-8c60-4a42-a504-7c70fa5120f0",
                                "sense_id": "888d86e0-58c3-3587-b499-941c978d4a26",
                                "text": "Nägeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
