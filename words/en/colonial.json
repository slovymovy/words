        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "099c85e3-26a0-39ce-b02c-349d6b7932c9",
                    "sense_definition": "Relating to a colony or the political control of a country by a more powerful foreign power.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "general_relational",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>colonial</w> government imposed strict laws on the local population.",
                            "target_lang_translations": {
                                "ru": "<w>Колониальное</w> правительство ввело строгие законы для местного населения.",
                                "zh": "<w>殖民地</w>政府对当地居民实施了严格的法律。"
                            }
                        },
                        {
                            "text": "Britain was once a major <w>colonial</w> power with territories around the globe.",
                            "target_lang_translations": {
                                "ru": "Британия когда-то была крупной <w>колониальной</w> державой с территориями по всему земному шару.",
                                "zh": "英国曾是一个在全球拥有领土的主要<w>殖民</w>强国。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "colonial power",
                        "colonial administration",
                        "colonial government",
                        "colonial rule"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к колонии или политическому контролю одной страны над другой.",
                        "zh": "指与殖民地或外国势力对某国的政治控制有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колониальный",
                                "target_lang_sense_clarification": "относящийся к колонии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "殖民的",
                                "target_lang_sense_clarification": "与殖民地相关的"
                            },
                            {
                                "target_lang_word": "殖民地",
                                "target_lang_sense_clarification": "作为定语修饰政府或势力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26378d34-fc30-3e50-85a3-d6800953f08f",
