                "senses": [
                    {
                        "sense_id": "82e2574e-5b47-30f6-9109-dab890999074",
                        "entry_id": "24eb3d3b-fbb9-32b0-a475-fb9e340daa24",
                        "glosses": [
                            "Person, die zur Besatzung eines Ubootes gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49ceb667-2650-4788-b6d3-833ffbe541b4",
                                "sense_id": "82e2574e-5b47-30f6-9109-dab890999074",
                                "text": "„Auch Ubootfahrer wenden es an.“"
                            },
                            {
                                "example_id": "1825bdbe-61ab-4e73-9a1b-fd341eedd502",
                                "sense_id": "82e2574e-5b47-30f6-9109-dab890999074",
                                "text": "„Am Anfang der Ausbildung wird den angehenden Ubootfahrern erst einmal allgemeines Grundwissen über das Ubootfahren vermittelt.“"
                            },
                            {
                                "example_id": "8e3a2ed1-a4af-4c39-b523-2b5fbc3a91f3",
                                "sense_id": "82e2574e-5b47-30f6-9109-dab890999074",
                                "text": "„Das Stadtoberhaupt dankte den Marinesoldaten für die großzügige Spende und die gelebte, über Jahre gewachsene Freundschaft zwischen Stadt und Ubootfahrern.“"
                            },
                            {
                                "example_id": "afdb10ed-c4b5-4ac2-b446-af5eb2147db6",
                                "sense_id": "82e2574e-5b47-30f6-9109-dab890999074",
                                "text": "„Der Verband Deutscher Ubootfahrer e.V. ist im Vereinsregister des Amtsgerichts Hamburg unter der Nummer VR 7267 eingetragen.“"
                            },
                            {
                                "example_id": "507ca847-106b-4ff3-9b7a-4e916db6e08f",
                                "sense_id": "82e2574e-5b47-30f6-9109-dab890999074",
                                "text": "„In ihrer Fjordlandschaft haben die norwegischen Ubootfahrer das Verfahren der Navigation mittels Sonar perfektioniert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
