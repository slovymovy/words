                        "glosses": [
                            "Discordian"
                        ],
                        "tags": [
                            "not-comparable",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "fd1cd80c-2ea3-450e-8151-aa3cc5c53d91",
                                "sense_id": "a70d518b-70bb-38ad-865d-048f3fdf478c",
                                "text": "Ein gewisser diskordischer Touch ist sicherlich nicht zu verleugnen, doch sind alle Durchführungsschritte mit einem ernsten Hintergrund verfasst worden."
                            },
                            {
                                "example_id": "98fe033e-cdc8-4acf-8ef8-2be79d445ae7",
                                "sense_id": "a70d518b-70bb-38ad-865d-048f3fdf478c",
                                "text": "2021, Robert Shea (d. 1994), Robert A. Wilson (d. 2007), Illuminatus! 3: Leviathan, Rowohlt Verlag (e-book), chapter Vau: Flachskript und Hanfskript",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "1cbdeb8c-8318-4320-b2a8-3ecb685e045f",
                                "sense_id": "a70d518b-70bb-38ad-865d-048f3fdf478c",
                                "text": "Der diskordische Kalender kennt fünf Jahreszeiten (Chaos, Zwietracht, Verwirrung, Bürokratie und die Nachwirkung).",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "3040a761-5854-4eb3-a959-0558e2f35115",
                                "sense_id": "a70d518b-70bb-38ad-865d-048f3fdf478c",
                                "text": "AV: Genau. Diese Erzählung besteht jedenfalls darin, dass die Strategie der Putin'schen Herrschaft im Grunde darin besteht, ähnlich diskordisch zu sagen: „Wir unterstützen einfach alle. Wir fördern die Faschist*innen und wir fördern die Antifaschist*innen und die dazwischen, [...]“"
                            }
                        ]
                    }
