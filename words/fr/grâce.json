    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d6cc4d2a-5efa-3244-9689-66087eb48703",
                    "sense_definition": "Agrément particulier, charme indéfinissable et élégance naturelle dans les manières ou les mouvements.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "elegance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette danseuse étoile se déplace avec une <w>grâce</w> incomparable sur la scène."
                        },
                        {
                            "text": "Malgré son grand âge, la vieille dame marchait avec une <w>grâce</w> que tous admiraient."
                        }
                    ],
                    "synonyms": [
                        "appas"
                    ],
                    "common_phrases": [
                        "avec grâce",
                        "bonne grâce",
                        "mauvaise grâce"
                    ]
                },
                {
                    "sense_id": "cb05080c-0419-39e9-9600-5fa535d4208e",
                    "sense_definition": "Faveur ou bienfait que l'on accorde à quelqu'un par pure bienveillance, sans y être obligé.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "faveur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je vous demande la <w>grâce</w> de m'écouter encore un instant avant de partir."
                        },
                        {
                            "text": "Le directeur lui a accordé cette <w>grâce</w> exceptionnelle après de longues négociations."
                        }
                    ],
                    "synonyms": [
                        "bienfait",
                        "service"
                    ],
                    "common_phrases": [
                        "demander une grâce",
                        "faire une grâce",
                        "trouver grâce"
                    ]
                },
                {
                    "sense_id": "a0ba87fa-7f8b-3295-8fb7-965b7929cc1f",
                    "sense_definition": "Pardon accordé à un fautif ou suspension d'un châtiment mérité ; clémence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pardon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vaincu a supplié son adversaire de lui faire <w>grâce</w>."
                        },
                        {
                            "text": "Le professeur a fait <w>grâce</w> aux élèves de l'interrogation prévue ce matin."
                        }
                    ],
                    "synonyms": [
                        "rémission"
                    ],
                    "common_phrases": [
