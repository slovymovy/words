                "senses": [
                    {
                        "sense_id": "42388549-cce8-3899-9bba-4a65a943ee2b",
                        "entry_id": "c44c92e0-e64a-32dd-9f5d-9c38488f5030",
                        "glosses": [
                            "den Geist stark beanspruchend, Sorgen/Schwierigkeiten bereitend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb9e09a0-ee2e-4e0b-b0e6-6385021b1c8d",
                                "sense_id": "42388549-cce8-3899-9bba-4a65a943ee2b",
                                "text": "„In jenem gespenstischen und geschmeidigen Gesicht, das da körperlos, leuchtend und verjüngt in der Schwärze erstrahlte, lag mehr schiere, strotzende, hirnzermürbende Angst, als der Rest von Himmel und Erde mir je offenbarte.“"
                            }
                        ],
