                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "801ca0b6-c1a3-4bae-8651-9c14b318207f",
                                                "sense_id": "f03f45bf-34db-36fa-abb7-b421c89b4bda",
                                                "text": "OMG, I just won tickets to a concert! Today is the best day ever!"
                                            },
                                            {
