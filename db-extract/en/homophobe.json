                "senses": [
                    {
                        "sense_id": "658ddad7-8d77-3669-a404-c886e6b7ec41",
                        "entry_id": "4b2eabee-da63-3f1d-8403-75f13e9a7fd7",
                        "glosses": [
                            "恐同的；對同性戀者或 LGBTQ 群體抱持偏見的人"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f8cfb5b-af09-43ef-98f8-1979e17becab",
                                "sense_id": "658ddad7-8d77-3669-a404-c886e6b7ec41",
                                "text": "That one can love another of the same gender, that is what the homophobe really cannot stand."
                            },
                            {
                                "example_id": "03c63e6d-abee-486d-907b-1b471e5ddcda",
                                "sense_id": "658ddad7-8d77-3669-a404-c886e6b7ec41",
                                "text": "If you're against gay marriage, just be honest, put a scarlet 'H' on your shirt, and say, \"I am a homophobe!\""
                            },
                            {
                                "example_id": "2575270b-bb9e-4536-8a17-cc6b0e36529b",
                                "sense_id": "658ddad7-8d77-3669-a404-c886e6b7ec41",
                                "text": "To me, Ennis stands for the conservative side of America. He's the biggest homophobe in the whole movie — culturally and psychologically — but by the time he admits his feelings, it's too late."
                            },
                            {
                                "example_id": "e5ebf7be-316d-4ae8-86bf-8cce38d247c0",
                                "sense_id": "658ddad7-8d77-3669-a404-c886e6b7ec41",
                                "text": "Narrators demonstrated resistance coping techniques through direct confrontation with aggressors, such as racists, sexists, homophobes, elitists, and misogynoirists."
                            }
                        ]
                    }
                ],
