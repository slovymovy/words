                        "entry_id": "f8d79dbd-5936-31d9-9957-6aadf02abfa7",
                        "glosses": [
                            "metalen bakje waarin met een cake kan bakken"
                        ],
                        "tags": [
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "47df81ad-51a2-4544-b6c2-f74669a6f43b",
                                "sense_id": "de6902f5-1f27-36fb-979d-53e873155971",
                                "text": "Vet een cakevorm in of bekleed met bakpapier en stort het deeg hierin. Bak gedurende 1 uur in de voorverwarmde oven. Om te testen of de cake gaar is, prik je met een metalen priem tot in het midden van de cake. Als ze er schoon uitkomt, is de cake klaar."
                            },
                            {
                                "example_id": "cddb62cc-1090-4a22-90c4-301d49b4c795",
                                "sense_id": "de6902f5-1f27-36fb-979d-53e873155971",
                                "text": "Bekleed een cakevorm met bakpapier, vouw de plooien goed strak. Giet het beslag in de cakevorm, leg de versiernoten erbovenop en bak het bananenbrood in 50 minuten bruin en gaar. Laat het brood buiten de vorm afkoelen, dan wordt het niet klef."
                            }
                        ]
                    }
