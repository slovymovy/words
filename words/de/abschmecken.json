            "senses": [
                {
                    "sense_id": "4145b51d-6f8a-333e-9950-dfc017607a70",
                    "sense_definition": "das Prüfen und geschmackliche Abstimmen einer Speise; Substantivierung des Verbs <w>abschmecken</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "kochen_geschmack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beim <w>Abschmecken</w> der Tomatensuppe bemerkte der Koch, dass noch eine Prise Zucker fehlte."
