                "senses": [
                    {
                        "sense_id": "f32ee777-ebd2-3b6e-b137-f51d7cba3a84",
                        "entry_id": "e39b3f86-a3cf-3937-b246-2535a3eacefb",
                        "glosses": [
                            "действие по значению гл. опознавать, а также результат такого действия; визуальная идентификация человека или какого-либо объекта по каким-нибудь признакам, приметам и т.п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "479fe4c7-c2cf-4277-ab12-34917de8ec93",
                                "sense_id": "f32ee777-ebd2-3b6e-b137-f51d7cba3a84",
                                "text": "Казалось бы, что задача опознавания отдельных, да и всех бобров ― так они все похожи по внешности ― почти неосуществима."
                            },
                            {
                                "example_id": "da44cce5-a8bd-4376-a06c-7dfea048c6bc",
                                "sense_id": "f32ee777-ebd2-3b6e-b137-f51d7cba3a84",
                                "text": "Для лучшего опознавания своих танков с самолетов разрабатываются специальные знаки."
                            }
                        ]
                    }
