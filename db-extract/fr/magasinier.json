                                        "sense_id": "0b832ebe-3e90-3d5f-9011-7d80130fb62c",
                                        "entry_id": "bd3577e9-51e7-3ad3-ba72-1d8b53a0b6a8",
                                        "glosses": [
                                            "One who runs a shop, either the owner or manager."
