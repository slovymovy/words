        "fr-extract.jsonl": [
            {
                "entry_id": "daec35d7-1074-3dc3-9798-b06c2b98773a",
                "word": "intimement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d03090a9-5864-35d9-9d0b-0eb258d94105",
                        "entry_id": "daec35d7-1074-3dc3-9798-b06c2b98773a",
                        "glosses": [
                            "D'une manière intime, dans le fond des choses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8da39d1-469e-4144-8524-02b69d58d13e",
                                "sense_id": "d03090a9-5864-35d9-9d0b-0eb258d94105",
                                "text": "On mélange alors intimement à froid le coton-poudre et la gélatine […] avec 10% de gutta-percha dissous également dans l'acide acétique cristallisable."
                            }
                        ]
                    },
                    {
                        "sense_id": "d22c1f88-b01d-32ab-bbd8-ec3edf938c81",
                        "entry_id": "daec35d7-1074-3dc3-9798-b06c2b98773a",
                        "glosses": [
                            "Dans le fond de l’âme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a3cd34c-b70b-4fd3-b1cb-9a40925cf09c",
                                "sense_id": "d22c1f88-b01d-32ab-bbd8-ec3edf938c81",
                                "text": "Quelles que soient la bonne foi et la conviction de ceux qui proclament le danger de cet article , et qui veulent le faire rejeter , j'atteste qu'avec la même bonne foi je suis intimement convaincu de ses salutaires effets, […]."
                            },
                            {
                                "example_id": "c3dd3591-7d60-4ef2-93e0-216e943cf366",
                                "sense_id": "d22c1f88-b01d-32ab-bbd8-ec3edf938c81",
                                "text": "Il est infiniment plus facile d’être intimement persuadé des opinions de théorie les plus contraires aux apparences, que d’être sincèrement et tranquillement au-dessus des passions."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b836957-074b-3d81-b004-55d43dc58353",
                        "entry_id": "daec35d7-1074-3dc3-9798-b06c2b98773a",
                        "glosses": [
                            "Avec une affection très particulière et très étroite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15edf61b-94e7-466e-878b-5a18312e7b40",
                                "sense_id": "9b836957-074b-3d81-b004-55d43dc58353",
                                "text": "Ils sont intimement liés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69c8460b-0008-4e38-943e-cfeae55aa6f7",
                        "source_entry_id": "daec35d7-1074-3dc3-9798-b06c2b98773a",
