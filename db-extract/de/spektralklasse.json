                    {
                        "sense_id": "9a1b29a8-0045-3f9e-a29e-6a69fc5c35e5",
                        "entry_id": "688e8374-85fe-3578-9be9-bfaa3b1f8b8b",
                        "glosses": [
                            "Klassifizierung von Sternen nach dem Aussehen ihres Lichtspektrums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fae4312-c3be-401a-ab65-2a52d3234256",
                                "sense_id": "9a1b29a8-0045-3f9e-a29e-6a69fc5c35e5",
                                "text": "„Diese Welt ist ein kleiner, einsamer Zwergplanet, der um einen Gasriesen kreist, der seinerseits um einen Stern der Spektralklasse M kreist, der am äußersten Ende des Spiralarms liegt, fast zwanzig Lichtjahre von der nächsten Kolonie entfernt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
