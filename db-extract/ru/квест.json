                                "target_senses": [
                                    {
                                        "sense_id": "06303d40-e817-3aa1-b290-dade5157cb44",
                                        "entry_id": "2b9736db-9168-32fb-a493-f3cb0ddd1395",
                                        "glosses": [
                                            "A short test."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8253543-8dea-4c5b-8749-8a49652331e8",
                                                "sense_id": "06303d40-e817-3aa1-b290-dade5157cb44",
                                                "text": "I had a calculus quest (not a quiz or a test, but somewhere in between...) it was on limits, and l'hopital's rule..."
                                            },
                                            {
                                                "example_id": "debbd104-e296-4127-8fda-e9c70396d97d",
                                                "sense_id": "06303d40-e817-3aa1-b290-dade5157cb44",
                                                "text": "However took a quest, quiz/test combination that this math progrm^([sic]) uses, and got ten out of ten on it!"
                                            },
                                            {
                                                "example_id": "03b34975-04d6-4dea-8170-bde6bd5aafa3",
                                                "sense_id": "06303d40-e817-3aa1-b290-dade5157cb44",
                                                "text": "Quests, bigger than quizzes and smaller than tests, consist of around 10 questions worth 2 points each, designed to take about 30–40 minutes."
                                            },
                                            {
                                                "example_id": "ea211877-f466-4653-9a1b-c4485135acfd",
                                                "sense_id": "06303d40-e817-3aa1-b290-dade5157cb44",
                                                "text": "Most outcomes were assessed with 10 min, single-page, five-question quizzes/tests (“quests”) given at the beginning of class, followed immediately with a brief discussion of the correct answers; mastery could be demonstrated by the student with four of five complete, correct answers (with no partial credit). […] Students were given a finite number of “quest” retakes. Three class periods during the semester were used as quest makeup periods, during which students would be able to take new versions of EO and GO quests."
                                            }
                                        ]
