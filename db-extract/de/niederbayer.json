                        "sense_id": "bfd839a9-f0ad-34b4-9474-b7e47ada348e",
                        "entry_id": "6588eaf5-7193-3ce6-9775-348d6420b97b",
                        "glosses": [
                            "Einwohner des bayerischen Regierungsbezirks Niederbayern, Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2c7fa7f-3be5-4a3b-b589-0ddc8838dd17",
                                "sense_id": "bfd839a9-f0ad-34b4-9474-b7e47ada348e",
                                "text": "„Seehofer ist als Ingolstädter wie Stoiber ein echter Oberbayer, Huber vertritt als Niederbayer den Regierungsbezirk mit den traditionell treuesten CSU-Wählern.“"
                            },
                            {
                                "example_id": "ec22e1b6-aa4c-41fc-aebe-3b110594beab",
                                "sense_id": "bfd839a9-f0ad-34b4-9474-b7e47ada348e",
                                "text": "„Ich sage es mal so: Die Oberbayern haben die höheren Berge und wir Niederbayern haben den größeren Horizont.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
