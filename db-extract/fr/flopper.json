                "senses": [
                    {
                        "sense_id": "0e5879a5-fff2-38ed-9e21-4af22ccf6158",
                        "entry_id": "5abfd4b8-4549-3369-b297-4c2ab1b28435",
                        "glosses": [
                            "Tomber volontairement pour faire croire à une faute de l'attaque, et ainsi obtenir une faute offensive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57ff72c3-6945-449c-9dba-72fc657fd046",
                                "sense_id": "0e5879a5-fff2-38ed-9e21-4af22ccf6158",
                                "text": "Agacé par ce qu'il appelle du « cinéma », l'ailier de Portland estime avoir donné au Barcelonais « une bonne raison de flopper »."
                            },
                            {
                                "example_id": "edcc842c-8172-44e4-8627-18f48ad9e92a",
                                "sense_id": "0e5879a5-fff2-38ed-9e21-4af22ccf6158",
                                "text": "Blake Griffin devra réfléchir à deux fois avant de flopper."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3586a0c-47a9-3120-9881-54a93c427263",
                        "entry_id": "5abfd4b8-4549-3369-b297-4c2ab1b28435",
                        "glosses": [
                            "Faire un flop, échouer complètement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4dcdab5-f7d3-4748-b194-ab2fd94c26e5",
                                "sense_id": "d3586a0c-47a9-3120-9881-54a93c427263",
                                "text": "Le premier prequel du film de Kubrick, Doctor Sleep, de Mike Flanagan avec Ewan McGregor sorti en 2019, a tellement floppé que Warner a renoncé à en faire un deuxième."
                            }
                        ]
                    }
