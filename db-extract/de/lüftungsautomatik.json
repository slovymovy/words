                "senses": [
                    {
                        "sense_id": "1cd571f8-0bab-3175-889e-2b34d7795c2e",
                        "entry_id": "fd4180a7-4223-3ab8-92b0-6b706a189d71",
                        "glosses": [
                            "Funktionsweise einer sich selbst steuernden Lüftungsanlage und die dafür notwendigen technischen Vorrichtungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7743d88-c32b-4ed0-9768-9393504a3d02",
                                "sense_id": "1cd571f8-0bab-3175-889e-2b34d7795c2e",
                                "text": "„Bei der Entwicklung der Lüftungsautomatik OJ Air2 von OJ Electronics lag laut Anbieter der Schwerpunkt auf Wirtschaftlichkeit in allen Phasen, von der Implementierung über den Betrieb bis zur Wartung.“"
                            },
                            {
                                "example_id": "5ba914a5-c785-42a3-83ad-dbf98cb44af2",
                                "sense_id": "1cd571f8-0bab-3175-889e-2b34d7795c2e",
                                "text": "„Die Lüftungsautomatik nach Temperatur oder Luftfeuchtigkeit wird nur ausgeführt, wenn keine Sperre aktiv ist.“"
                            },
                            {
                                "example_id": "c3970afe-e32c-4ebf-b1cd-ea997ae44552",
                                "sense_id": "1cd571f8-0bab-3175-889e-2b34d7795c2e",
                                "text": "„Stellungsrückmelder für Elektroantriebe EWA zur Rückmeldung der Stellung von Lüftungen usw. an die Lüftungsautomatik.“"
                            },
                            {
                                "example_id": "b619617a-7674-43cc-968c-787879b02954",
                                "sense_id": "1cd571f8-0bab-3175-889e-2b34d7795c2e",
                                "text": "„Nach Wunsch des Benutzers kann die Lüftungsautomatik übersteuert werden und von Hand eine der 3 Lüftungsstufen gewählt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
