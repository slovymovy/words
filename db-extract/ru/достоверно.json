                                        "glosses": [
                                            "In an authentic manner; genuinely"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98fe6a28-3a88-4353-8e4f-dac925d38619",
                        "source_entry_id": "45bf5ed5-ec1b-3d8e-81bf-ff670e62d2c9",
                        "source_sense_description": "наречие",
                        "target_lang_word": "for certain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "for certain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9884895a-82b8-35ec-9df4-588601f9f546",
                                        "entry_id": "ed6563c8-bc63-3923-a253-a9a8316a5ebb",
                                        "glosses": [
                                            "definitely, positively, without doubt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "323a3941-1f07-412f-b395-5e5412ea8eae",
                                                "sense_id": "9884895a-82b8-35ec-9df4-588601f9f546",
                                                "text": "We'll never be able to know for certain what happened."
                                            },
                                            {
                                                "example_id": "cd609ad7-c2b0-4891-b780-d52d0b539b21",
                                                "sense_id": "9884895a-82b8-35ec-9df4-588601f9f546",
                                                "text": "I would go to that concert for certain."
                                            },
                                            {
                                                "example_id": "ba9863c4-1fb9-4943-9bc9-c6e6fad3005d",
                                                "sense_id": "9884895a-82b8-35ec-9df4-588601f9f546",
                                                "text": "- Would you buy one of those?\n- For certain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2fbaec9-567a-42e7-9e40-d9be6c9edd60",
                        "source_entry_id": "45bf5ed5-ec1b-3d8e-81bf-ff670e62d2c9",
                        "source_sense_description": "наречие",
                        "target_lang_word": "for sure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "for sure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9145809d-1989-3581-9834-f38e00775dab",
                                        "entry_id": "3791d9ef-d657-3a4f-a976-f366e36a8db5",
                                        "glosses": [
                                            "Definitely, positively, without a doubt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3baf880-b75f-467e-9fbb-91a72d0298eb",
                                                "sense_id": "9145809d-1989-3581-9834-f38e00775dab",
                                                "text": "I would buy one of those for sure."
                                            },
                                            {
                                                "example_id": "fb139a2d-6e3d-4c53-aac8-3c296ca1d7cb",
                                                "sense_id": "9145809d-1989-3581-9834-f38e00775dab",
                                                "text": "Did you enjoy the concert? —For sure."
                                            },
                                            {
                                                "example_id": "014b2d15-e2dc-4523-b672-bf4ae1f6f4d8",
                                                "sense_id": "9145809d-1989-3581-9834-f38e00775dab",
                                                "text": "Yet strictly we should all be teapot agnostics: we cannot prove, for sure, that there is no celestial teapot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
