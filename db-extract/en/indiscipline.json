                        "sense_id": "3ac9fe11-64fc-3479-9f7f-787fffd3101a",
                        "entry_id": "487254a0-f767-3bac-8104-5a8ef7574714",
                        "glosses": [
                            "Lack of discipline."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "1bce70fd-4bab-4a82-8baa-76156f7b575f",
                                "sense_id": "3ac9fe11-64fc-3479-9f7f-787fffd3101a",
                                "text": "[O]ur delay, and other things which happened, were proofs—and I was told not uncommon ones—of that carelessness, unreadiness, and general indiscipline of French arrangements, which has helped to bring about, since then, an utter ruin."
                            },
                            {
                                "example_id": "fbfdbc5b-01c4-4ece-9751-6631ae620235",
                                "sense_id": "3ac9fe11-64fc-3479-9f7f-787fffd3101a",
                                "text": "Germany feared that the fiscal indiscipline of countries like Italy and Greece could make the new euro currency unstable."
                            }
                        ]
                    }
