                        "form": "die Kirchenlieder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ee67c38f-6e2b-30e9-9975-436882ce8e12",
                        "entry_id": "e0697d38-2f11-3b52-91a4-ad67c0dee841",
                        "glosses": [
                            "Lied, das bei Gottesdiensten gesungen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8dedd92-e22d-4ae3-9537-239108b0c400",
                                "sense_id": "ee67c38f-6e2b-30e9-9975-436882ce8e12",
                                "text": "„In der vorreformatorischen Zeit begann man, volkssprachliche Kirchenlieder in Gesangbüchern zusammenzustellen.“"
                            },
                            {
                                "example_id": "676d2297-dd17-4025-8fe4-e53db2ceee2e",
                                "sense_id": "ee67c38f-6e2b-30e9-9975-436882ce8e12",
                                "text": "„Die Besucher sangen die alten Kirchenlieder und der feine Weihrauchduft stieg in ihre Nasen.“"
                            },
                            {
                                "example_id": "e174516e-cf1c-4fce-b6cb-5337cff0ec9e",
                                "sense_id": "ee67c38f-6e2b-30e9-9975-436882ce8e12",
                                "text": "„Er komponierte Kirchenlieder und verfasste Gedichte.\""
                            },
                            {
                                "example_id": "4bf9e79c-88f1-4ac3-ba69-f478c0cf6eb3",
                                "sense_id": "ee67c38f-6e2b-30e9-9975-436882ce8e12",
                                "text": "„Da geschieht es unter dem Absingen des letzten Verses dieses Kirchenliedes, daß der Domkirchenpastor Sigurdur Sveinsson seinen Platz verläßt, in der Chortür Aufstellung nimmt und dorten regungslos und grabesernst abwartet, bis man zu Ende gesungen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "930531ce-c1ac-4373-a7e9-8ee192f9a2cb",
                        "source_entry_id": "e0697d38-2f11-3b52-91a4-ad67c0dee841",
                        "source_sense_id": "ee67c38f-6e2b-30e9-9975-436882ce8e12",
                        "source_sense_description": "Lied, das bei Gottesdiensten gesungen wird",
                        "target_lang_word": "cantique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cantique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "038b3128-4347-3dfb-925e-3d8cc8641789",
                                        "entry_id": "6df78609-57fa-342f-ab3a-5d7f39146d07",
                                        "glosses": [
                                            "Chant consacré à la gloire de Dieu, en action de grâces ou en l’honneur des saints."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61cba1bc-3624-4bf0-8de0-d6f64c60f47f",
                                                "sense_id": "038b3128-4347-3dfb-925e-3d8cc8641789",
                                                "text": "Du reste, on n’y regardait pas de si près, et l’on pouvait tout aussi bien, au XVIᵉ siècle, accommoder ces cantiques naïfs sur des airs de danse, que, cent ans après, ajuster les noëls de de la Monnoye sur les airs des ballets de Lulli, le Rigodon de Galathée, sa Chaconne du grand ballet du Roy, l’ouverture de Bellérophon, etc."
                                            },
                                            {
                                                "example_id": "5dd2dacd-c59e-4e77-8128-230cfb385962",
                                                "sense_id": "038b3128-4347-3dfb-925e-3d8cc8641789",
                                                "text": "Des chanteurs de complaintes allaient et venaient comme dans une foire; mais au lieu du fameux cantique de Geneviève de Brabant, ils chantaient sur le même air une chanson non moins bien versifiée."
                                            },
                                            {
                                                "example_id": "793d3cf5-53f0-4400-824f-21f017f71c56",
                                                "sense_id": "038b3128-4347-3dfb-925e-3d8cc8641789",
                                                "text": "En passant, écoutez les chants qui montent quelquefois des ateliers où les sardinières s’appliquent à la tâche. De vieux cantiques alternent avec les grivoiseries de café-concert."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
