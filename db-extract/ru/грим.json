                ],
                "translations": [
                    {
                        "translation_id": "ac2fdcf5-1a29-43ff-9f69-27a8bc45fe43",
                        "source_entry_id": "2b5a9270-cf1a-3a5f-9ac9-2bd75b3c68ec",
                        "source_sense_description": "вид, придаваемый лицу актёра при помощи специальных красок и наклеек",
                        "target_lang_word": "make-up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "make-up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d425e02d-3c75-371d-b784-cbc44e9aaff9",
                                        "entry_id": "f60077e4-5781-3fd8-b908-224d944cfff9",
                                        "glosses": [
                                            "Alternative spelling of makeup. See usage notes there."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d41ec690-5083-4ca7-a7bc-5bdd43af8a32",
                                                "sense_id": "d425e02d-3c75-371d-b784-cbc44e9aaff9",
                                                "text": "From Whitemoor, left at 6.45 p.m., the train's make-up usually includes also some Continental ferry wagons, originating from Harwich."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "make-up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32a1fec9-bec2-39db-adea-5eef930fc924",
                                        "entry_id": "f5130459-78fe-3367-bd16-83f664d96776",
                                        "glosses": [
                                            "Made-up, false, imaginary, fabricated."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81847c47-91fe-3ac9-b4cb-7dea0634e370",
                                        "entry_id": "f5130459-78fe-3367-bd16-83f664d96776",
                                        "glosses": [
                                            "Of or relating to a reconciliation."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8219cad9-a384-4a4b-8493-5cb1e793a967",
                                                "sense_id": "81847c47-91fe-3ac9-b4cb-7dea0634e370",
                                                "text": "Joe and Joanne had a big fight, and then apologized and had incredible make-up sex."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "make-up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf5b8000-8590-3af3-aa1f-9a30427d47b0",
                                        "entry_id": "6b785661-9579-3f32-85bd-653ea6dd1d51",
                                        "glosses": [
                                            "Rare form of make up (“to put makeup on”)."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c399d61-74a5-49a9-9017-5c658399e6f4",
                                                "sense_id": "bf5b8000-8590-3af3-aa1f-9a30427d47b0",
                                                "text": "Orange, mauve, and cobalt blue are three favorite shades now employed by the woman who desires to “make-up” her face, according to the approved beauty standards."
                                            },
                                            {
                                                "example_id": "922061d9-8fca-4a71-b714-8bf01bbf229d",
                                                "sense_id": "bf5b8000-8590-3af3-aa1f-9a30427d47b0",
                                                "text": "And shame at what you thought was fard! It’s only make-upping your face."
                                            },
                                            {
                                                "example_id": "860070d2-33ae-4a3a-910a-463e7cb8044f",
                                                "sense_id": "bf5b8000-8590-3af3-aa1f-9a30427d47b0",
                                                "text": "The make-up artist stops make-upping."
                                            },
                                            {
                                                "example_id": "216eec08-966b-4254-9738-88cc33375e77",
                                                "sense_id": "bf5b8000-8590-3af3-aa1f-9a30427d47b0",
                                                "text": "As we’re in the bathroom side-by-side, silently make-upping, Sophie turns to me."
                                            },
                                            {
                                                "example_id": "f422b153-ca19-486e-a7f8-f622aaaca68f",
                                                "sense_id": "bf5b8000-8590-3af3-aa1f-9a30427d47b0",
                                                "text": "Like Carnelle in The Miss Firecracker Contest, Teddy will attempt to transform herself on the outside by shaving, plucking, dressing, make-uping, and acting like a lady."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32e58674-e19b-4b96-a41d-e9f50875f4ce",
                        "source_entry_id": "2b5a9270-cf1a-3a5f-9ac9-2bd75b3c68ec",
                        "source_sense_description": "вид, придаваемый лицу актёра при помощи специальных красок и наклеек",
                        "target_lang_word": "maquillage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maquillage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f7158db-01e0-3e85-8a44-15ec71da6baa",
                                        "entry_id": "735d90cf-690c-3e34-9962-51f617cc38bb",
                                        "glosses": [
                                            "Action de (se) maquiller le visage."
                                        ],
                                        "tags": [
                                            "Cosmétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5705dc9e-e840-4709-9134-b92c35e5542c",
                                                "sense_id": "5f7158db-01e0-3e85-8a44-15ec71da6baa",
                                                "text": "Il lui fallut deux fois plus de temps pour faire son maquillage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20bdc46f-a381-3fd6-8fcb-1ff8289a5122",
                                        "entry_id": "735d90cf-690c-3e34-9962-51f617cc38bb",
                                        "glosses": [
                                            "Résultat de cette action."
                                        ],
                                        "tags": [
                                            "Cosmétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d673cfe-5a3a-403d-bc57-de1e98d8aea6",
                                                "sense_id": "20bdc46f-a381-3fd6-8fcb-1ff8289a5122",
                                                "text": "Par son travail sur les costumes, Sophie Desmarais a mis en évidence les contrastes entre MTS [Marie-Stella, ainsi surnommée par ses camarades de classe] et Marie-Clown. Cheveux gaufrés, vêtements amples couleur saumon et bas de nylon donnent à la première une allure de gamine venue tout droit des années 80. À l’opposé, la seconde est clairement de son temps : jupe courte, chandail bedaine, bracelets clinquants, gomme à mâcher, maquillage, espadrilles. Toutes deux paraissent pourtant déguisées : pas encore adultes, encore un peu enfants."
                                            },
                                            {
                                                "example_id": "d21c958f-fe85-4412-945f-ad1a57a8b3fb",
                                                "sense_id": "20bdc46f-a381-3fd6-8fcb-1ff8289a5122",
                                                "text": "Oui, le timide n’a jamais osé danser, du coup, il a eu le temps d’affûter son sens de la répartie pendant que ses petits camarades galochaient des nanas au look douteux et au maquillage ringard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41298a4b-823e-3213-8f75-f659d3d63ec1",
                                        "entry_id": "735d90cf-690c-3e34-9962-51f617cc38bb",
                                        "glosses": [
                                            "Action de dissimuler, de déformer une réalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1eb8d23-2b17-4dd7-9bc9-7de8cbf18bce",
                                                "sense_id": "41298a4b-823e-3213-8f75-f659d3d63ec1",
                                                "text": "J’en reviens à ma thèse : maquillage, mise en scène fictive, combinaison bizarre, trucs extraordinaires, imaginés dans le seul but de détourner l’attention, créés dans l’intention de faire croire à un crime, alors qu’il n’y en a pas."
                                            },
                                            {
                                                "example_id": "5586704e-3eac-448b-b685-d2ad90825b8c",
                                                "sense_id": "41298a4b-823e-3213-8f75-f659d3d63ec1",
                                                "text": "– Savez-vous ce qui me gâte l’écriture ? Ce sont les corrections, les ratures, les maquillages qu’on y fait."
                                            },
                                            {
                                                "example_id": "d63a3584-d7fd-45bf-9a71-c188572acf19",
                                                "sense_id": "41298a4b-823e-3213-8f75-f659d3d63ec1",
                                                "text": "Le troisième point semblait discréditer l’hypothèse d’un maquillage de voiture volée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b67137c-ec0f-33e5-ba74-424d10b675e4",
                                        "entry_id": "735d90cf-690c-3e34-9962-51f617cc38bb",
                                        "glosses": [
                                            "Du maquillage : Produit de maquillage, cosmétiques. (Ne s’utilise pas au pluriel.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78d526b5-ed1f-4d5e-9fde-38d33742e5be",
                                                "sense_id": "3b67137c-ec0f-33e5-ba74-424d10b675e4",
                                                "text": "Mais elle s’était rapidement emparé de quelques vêtements, avait quitté la chambre où elle l’avait enfermé à clé, avant de prendre la voiture en quête d’un endroit où acheter du maquillage, en pleine nuit."
                                            },
                                            {
                                                "example_id": "92e0227b-81bb-4268-abd3-415d040eca2b",
                                                "sense_id": "3b67137c-ec0f-33e5-ba74-424d10b675e4",
                                                "text": "Il faudrait vraiment être tombée bien bas pour en être réduite à voler du maquillage à sa mère de soixante-douze ans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
