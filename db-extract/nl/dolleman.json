                    },
                    {
                        "translation_id": "d16a153a-d752-4ac8-903b-9ce71909c1b7",
                        "source_entry_id": "de6ca540-fcda-3179-8484-b9aba762faaa",
                        "source_sense_id": "45ebecd4-007d-3082-85a9-5c1f7cedfc71",
                        "target_lang_word": "maniac",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maniac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0bcce9c-7f34-3326-bac5-da4224fb014c",
                                        "entry_id": "40546f1f-c868-36ff-901a-21ef18a8acb9",
                                        "glosses": [
                                            "An insane person, especially one who suffers from a mania."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3ae43cb-ccec-48ce-a18a-2c9691c8776f",
                                                "sense_id": "d0bcce9c-7f34-3326-bac5-da4224fb014c",
                                                "text": "She was driving like a maniac."
                                            },
                                            {
                                                "example_id": "a7d654b5-0813-4238-9c49-1c6b521de3eb",
                                                "sense_id": "d0bcce9c-7f34-3326-bac5-da4224fb014c",
                                                "text": "In these early days of silent pictures, the accent was chiefly on thrills and danger as provided by supposedly unstoppable locomotives with crooks or maniacs on the footplate."
                                            },
                                            {
                                                "example_id": "4bdfc0f3-5c15-44d7-a778-f15edd1f01f9",
                                                "sense_id": "d0bcce9c-7f34-3326-bac5-da4224fb014c",
                                                "text": "Hey kids, the word of the week is \"pupaphobia\"! Others may enjoy being frightened by chainsaw-wielding maniacs and cannibal clowns, but my Halloween is never complete without a murderous Muppet or two. Thankfully, a pair of events last Friday the 13th provided a perfect double feature of puppet perversity."
                                            },
                                            {
                                                "example_id": "a25d88a9-4c83-41b0-b51d-7bc0de732ba8",
                                                "sense_id": "d0bcce9c-7f34-3326-bac5-da4224fb014c",
                                                "text": "“It gives me the dithers, thinking of the damage that maniac could do if he ever took the headship. He could reinstate the cycle of chosen births, or enact any of a hundred other terrible laws.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0234e8b-f1e2-3636-8d5c-61aff87ba60d",
                                        "entry_id": "40546f1f-c868-36ff-901a-21ef18a8acb9",
                                        "glosses": [
                                            "A fanatic, a person with an obsession."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e314457-cb26-45d4-9ed6-d1de67c1c145",
                                                "sense_id": "c0234e8b-f1e2-3636-8d5c-61aff87ba60d",
                                                "text": "He's a manga maniac."
                                            },
                                            {
                                                "example_id": "38557ae8-9817-4e35-b6d6-791fdf6ec590",
                                                "sense_id": "c0234e8b-f1e2-3636-8d5c-61aff87ba60d",
                                                "text": "She's a maniac, maniac on the floor / And she's dancing like she's never danced before"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f9de868-5330-3bcc-9226-1a7c6f210c4f",
                                        "entry_id": "40546f1f-c868-36ff-901a-21ef18a8acb9",
                                        "glosses": [
                                            "Ellipsis of sex maniac."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a296278d-2ea6-41bc-a2be-54561ac7d0d7",
                        "source_entry_id": "de6ca540-fcda-3179-8484-b9aba762faaa",
                        "source_sense_id": "45ebecd4-007d-3082-85a9-5c1f7cedfc71",
                        "target_lang_word": "idiot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idiot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d4142f4-b076-3230-bbbd-2e6d655c5295",
                                        "entry_id": "5caa5447-c87a-3c3a-84f2-109635201945",
                                        "glosses": [
                                            "A person of low general intelligence."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6128c31-8a73-4b7c-81e6-5593c6a7045c",
                                                "sense_id": "2d4142f4-b076-3230-bbbd-2e6d655c5295",
                                                "text": "Only an idiot would fail this exam."
                                            },
                                            {
                                                "example_id": "508bfb32-043f-48be-957d-116415cb8e3a",
                                                "sense_id": "2d4142f4-b076-3230-bbbd-2e6d655c5295",
                                                "text": "After failing a hat-trick of exams, the teacher called him an idiot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53ef83e5-1b37-35ce-be41-e5df58193180",
                                        "entry_id": "5caa5447-c87a-3c3a-84f2-109635201945",
                                        "glosses": [
                                            "A person who makes stupid decisions; a fool."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0bb3dd6-682e-468d-91b8-e646d373b678",
                                                "sense_id": "53ef83e5-1b37-35ce-be41-e5df58193180",
                                                "text": "He thought people who don't like cricket are idiots. He later got into fights with people who like footabll."
                                            },
                                            {
                                                "example_id": "2b758441-1b8a-4e2c-a2d5-c49b480c7a83",
                                                "sense_id": "53ef83e5-1b37-35ce-be41-e5df58193180",
                                                "text": "We think that people who cycle without a helmet are idiots."
                                            },
                                            {
                                                "example_id": "ce90f186-69c0-4498-b756-6399e93b8679",
                                                "sense_id": "53ef83e5-1b37-35ce-be41-e5df58193180",
                                                "text": "“He’s an idiot – in terms of saying that. Everybody knows this. Everybody knows it. Nobody doubts it,” Biden said."
                                            },
                                            {
                                                "example_id": "7b8285ec-e4fa-4269-a273-e4e76cef8485",
                                                "sense_id": "53ef83e5-1b37-35ce-be41-e5df58193180",
                                                "text": "“One of the things that you write so beautifully, and your stuff is so fun to read, but you write about Trump, quote, ‘The way that you build a truly vicious nationalist movement is to wed a relatively small core of belligerent idiots to a much larger group of opportunists and spineless fellow travelers whose primary function is to turn a blind eye to things,’” Kennedy said, reading Taibbi’s own writing back to him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "111d41a7-15d2-3dff-9e2c-f7cc630ce39b",
                                        "entry_id": "5caa5447-c87a-3c3a-84f2-109635201945",
                                        "glosses": [
                                            "A person of the lowest intellectual standing, a person who lacks the capacity to develop beyond the mental age of a normal four-year-old; a person with an IQ below 30."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed94fe7c-d445-4c4b-96b1-9293a559b9dd",
                                                "sense_id": "111d41a7-15d2-3dff-9e2c-f7cc630ce39b",
                                                "text": "Idiots were thought to be peculiarly under the care of the Deity, and it was believed that those who treated them kindly would be blessed."
                                            },
                                            {
                                                "example_id": "e449e471-554f-408e-a706-0595f64c12f5",
                                                "sense_id": "111d41a7-15d2-3dff-9e2c-f7cc630ce39b",
                                                "text": "It is an offence for a man to have unlawful sexual intercourse with a woman whom he knows to be an idiot or imbecile."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "idiot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d199d7ae-0277-3c21-9db9-d05f42baf0ce",
                                        "entry_id": "ff137029-fa92-3de5-9556-09a8586bbf0e",
                                        "glosses": [
                                            "Idiotic, stupid."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03825097-f290-4bee-9487-55701c53dda6",
                        "source_entry_id": "de6ca540-fcda-3179-8484-b9aba762faaa",
                        "source_sense_id": "45ebecd4-007d-3082-85a9-5c1f7cedfc71",
                        "target_lang_word": "lunatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lunatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66cc7b45-0a65-3a56-a19a-1e193df4699c",
                                        "entry_id": "29f24dfb-f140-381c-aa6a-1256444accb6",
                                        "glosses": [
                                            "An insane person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7e21d48-4081-43e4-80b0-2da56e7f1854",
                                                "sense_id": "66cc7b45-0a65-3a56-a19a-1e193df4699c",
                                                "text": "While there are other races (or individuals—heaven forgive me, I am no ethnologist) who think you a criminal or a lunatic unless you carefully plod along from step to step like a hippopotamus out of water."
                                            },
                                            {
                                                "example_id": "c0fdf044-75e6-4630-ae89-61c6bbe7b650",
                                                "sense_id": "66cc7b45-0a65-3a56-a19a-1e193df4699c",
                                                "text": "You may be right\nI may be crazy\nOh, but it just may be a lunatic you're looking for"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lunatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "919627e7-ffdf-3c9b-9feb-09f4e64839a4",
                                        "entry_id": "d228d122-5c94-3581-8421-54907168dfef",
                                        "glosses": [
                                            "Crazed, mad, insane, demented."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16374634-d0a4-366a-b264-8fa869df9a61",
                                        "entry_id": "d228d122-5c94-3581-8421-54907168dfef",
                                        "glosses": [
                                            "Relating to the Moon; lunar."
                                        ],
                                        "tags": [
                                            "literary",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2370c0cf-bde5-4ceb-bdfa-47f5e8c518cd",
                                                "sense_id": "16374634-d0a4-366a-b264-8fa869df9a61",
                                                "text": "As the narrator turns his attention to the moon itself and its Lunatic inhabitants, Heinsius seems to draw on the True History, but is still within the confines of the Icaromenippus."
                                            },
                                            {
                                                "example_id": "70da88a6-946f-4697-8477-726284e1d8be",
                                                "sense_id": "16374634-d0a4-366a-b264-8fa869df9a61",
                                                "text": "That or I might bounce off something I hit and head back out into space, become the light in the eye of some lunatic observer, looking up at the big blue ball and seeing me bang something in their retina."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3992182-e050-3ccb-acfc-94a759da2e04",
                                        "entry_id": "d228d122-5c94-3581-8421-54907168dfef",
                                        "glosses": [
                                            "Influenced or affected by the Moon."
                                        ],
                                        "tags": [
                                            "literary",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd31f492-2b86-4c36-a76a-c0e1d49c3151",
                                                "sense_id": "b3992182-e050-3ccb-acfc-94a759da2e04",
                                                "text": "This I remember: she was false as the lunatic sea."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
