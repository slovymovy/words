                        "glosses": [
                            "Donner un caractère indochinois à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "466f19e4-f722-4021-9d05-abeeed21b705",
                                "sense_id": "f12abe8c-1168-3cf7-8cb5-5207096ab397",
                                "text": "Il ne semble pas comprendre que pour les Cambodgiens, \"indochiniser\" est synonyme de \"vietnamiser\"."
