                        "entry_id": "7ce85f80-034d-3d4f-9488-76c11817180c",
                        "glosses": [
                            "Ursus arctos horribilis Ord, duży drapieżny ssak występujący w Ameryce Północnej, podgatunek niedźwiedzia brunatnego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d81d129-ebb6-403c-a4c7-852ef5f14e2d",
                                "sense_id": "06ca3551-9ad8-3f84-8757-03818351f1c1",
                                "text": "Jego potężne łapy zaopatrzone są w straszliwie zakrzywione pazury, którymi grizzly z łatwością potrafi rozszarpać bawołu"
                            },
                            {
                                "example_id": "15acd7a8-93ce-407e-82c3-9f70c58c7456",
                                "sense_id": "06ca3551-9ad8-3f84-8757-03818351f1c1",
                                "text": "Pantera albo jaguar zwinąłby się jak kot w takich warunkach, mój grizzly zaś kroczył sobie spokojnie dalej"
                            },
                            {
                                "example_id": "9bafba61-b857-43a7-b7ce-25535985feae",
                                "sense_id": "06ca3551-9ad8-3f84-8757-03818351f1c1",
                                "text": "Po kilku zaledwie chwilach pies leżał martwy, rozerwany na kawałki, wściekły zaś grizzly zwrócił się znowu przeciwko mnie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
