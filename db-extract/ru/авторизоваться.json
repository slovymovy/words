                        "glosses": [
                            "спец. получать авторизацию"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ac6875a-8067-4c11-8aea-01f9575b6bf2",
                                "sense_id": "70ca06f0-dcd1-3401-b547-a48a1dc0c27a",
                                "text": "Теперь, когда средства появились на счету (это происходит практически моментально), вы можете в любой момент авторизоваться на сайте и зайти на страницу с номерами журнала и пометить нужные галочкой."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc7aa04d-5285-3263-8dae-b428f6e7decf",
                        "entry_id": "1d4ba2cf-dcd1-35d3-91aa-a82c179e07d5",
                        "glosses": [
                            "страд. к авторизовать"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "bde8a294-089c-49aa-8d52-8abc3811955b",
                                "sense_id": "bc7aa04d-5285-3263-8dae-b428f6e7decf",
                                "text": "А вот при оплате товаров в магазинах карточка авторизуется только по основному счёту."
                            }
                        ]
                    }
