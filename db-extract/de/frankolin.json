                                        "entry_id": "5517d86b-a4c2-3074-a817-63faa63d7e23",
                                        "glosses": [
                                            "Any of various terrestrial birds of several genera in family Phasianidae, principally in tribe Gallini."
                                        ],
                                        "tags": [],
