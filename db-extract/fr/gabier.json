                        "sense_id": "67e926af-64cf-35f3-b611-c03be38f3597",
                        "entry_id": "f1f5f13d-a3ec-3baf-b5d0-b5e290129d89",
                        "glosses": [
                            "Guichet automatique bancaire."
                        ],
                        "tags": [
                            "La Réunion"
                        ],
                        "examples": [
                            {
                                "example_id": "5ae21f14-3355-40c7-a4f4-2073c08770a7",
                                "sense_id": "67e926af-64cf-35f3-b611-c03be38f3597",
                                "text": "Le gabier ? Tout le monde sait ce qu’est le gabier à la Réunion. C’est ce nous appellerions en métropole « le distributeur de billets »."
                            },
                            {
                                "example_id": "0629bc32-1175-45df-bac9-4fd1ece87756",
                                "sense_id": "67e926af-64cf-35f3-b611-c03be38f3597",
                                "text": "À 10 heures, elles passent retirer du liquide pour un montant de 200 euros. Gabier du centre-ville. On a le relevé."
                            }
                        ]
                    }
