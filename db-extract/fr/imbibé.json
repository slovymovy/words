                    {
                        "sense_id": "08aab20c-4267-3510-a88d-5dd42c49959d",
                        "entry_id": "1e47b80f-ff87-3759-b3d5-2e7a4f269209",
                        "glosses": [
                            "Qui a été pénétré d’eau ou d’un autre liquide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36f35596-17cb-4b43-9c7f-5f94f090616b",
                                "sense_id": "08aab20c-4267-3510-a88d-5dd42c49959d",
                                "text": "Dans le hall d’entrée du cinéma, Anna avait installé des grands panneaux d’affichage avec l’horaire des séances de cinéma, les thèmes des débats à venir, une foule de slogans qui s’entredévoraient et des messages à caractère informatif : « Comment réaliser un cocktail Molotov : une bouteille remplie de 2/3 d’essence, de savon en poudre, et un chiffon imbibé d’essence enfoncé dans le goulot. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "27845e77-5e97-30d3-a266-ad130540c96d",
                        "entry_id": "1e47b80f-ff87-3759-b3d5-2e7a4f269209",
                        "glosses": [
                            "Ivre."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f6c25a40-2aa4-49e6-b316-5fcced45121a",
                                "sense_id": "27845e77-5e97-30d3-a266-ad130540c96d",
                                "text": "Lucas était à la limite de l’irradiation complète de l'alcool, suffisamment imbibé pour amortir le coup de la confrontation mais pas au point d'être ivre à se rouler par terre."
                            }
                        ]
                    }
