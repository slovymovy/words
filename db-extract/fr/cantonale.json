                        "entry_id": "b50efa63-5c98-347d-97d7-ee915325bb10",
                        "glosses": [
                            "Élection départementale par canton."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "cd4356e4-1eaa-4edb-9986-6221ec160e5a",
                                "sense_id": "75feb37f-b1e7-380b-b3a6-4788cf9637d8",
                                "text": "Donc une cantonale partielle aura lieu chaque fois qu'un député ou un sénateur, élu au conseil général, devra renoncer au mandat cantonal."
                            },
                            {
                                "example_id": "7cce7d06-fd6e-4b1b-a574-d29bf7ea41c6",
                                "sense_id": "75feb37f-b1e7-380b-b3a6-4788cf9637d8",
                                "text": "Depuis que le comte lui avait promis son soutien pour les prochaines cantonales, il fayotait sans vergogne et Archibald, en qualité de protégé de ce dernier, trouvait à ses yeux toutes les grâces du monde."
                            }
                        ]
                    }
