{
    "word_family": [
        "dimestore"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "62cfc65d-3393-3bb9-9c2a-7f9543969306",
                    "sense_definition": "A coin worth ten cents (one-tenth of a dollar), primarily used in the United States and Canada.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "money_currency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I found a shiny <dime> on the sidewalk this morning.",
                            "target_lang_translations": {
                                "ru": "Сегодня утром я нашел на тротуаре блестящий <w>десятицентовик</w>.",
                                "zh": "今天早上我在人行道上捡到了一枚亮闪闪的<w>10美分硬币</w>。"
                            }
                        },
                        {
                            "text": "The parking meter accepts quarters, nickels, and <dimes>.",
                            "target_lang_translations": {
                                "ru": "Паркомат принимает четвертаки, пятаки и <w>десятицентовики</w>.",
                                "zh": "停车收费表接受25美分、5美分和<w>10美分硬币</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ten-cent piece"
                    ],
                    "common_phrases": [
                        "stop on a dime",
                        "turn on a dime"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US, Canada"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Монета достоинством в 10 центов (одна десятая доллара), используемая преимущественно в США и Канаде.",
                        "zh": "10美分的硬币，即1美元的十分之一，主要用于美国和加拿大。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "десятицентовик",
                                "target_lang_sense_clarification": "разговорное название монеты"
                            },
                            {
                                "target_lang_word": "дайм",
                                "target_lang_sense_clarification": "прямое заимствование"
                            },
                            {
                                "target_lang_word": "монета в 10 центов",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "10美分硬币",
                                "target_lang_sense_clarification": "最常用的说法，指美国或加拿大的10美分硬币"
                            },
                            {
                                "target_lang_word": "一角硬币",
                                "target_lang_sense_clarification": "按面值理解时可说"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ff6201b-72ec-399a-8502-8f90d39baf5b",
                    "sense_definition": "A very small amount of money, usually mentioned in negative contexts to indicate zero cost or value.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "money_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He didn't spend a <dime> on the trip because his company paid for everything.",
                            "target_lang_translations": {
                                "ru": "Он не потратил на поездку <w>ни копейки</w>, потому что компания всё оплатила.",
                                "zh": "这次旅行他<w>一分钱</w>都没花，因为公司把一切都付了。"
                            }
                        },
                        {
                            "text": "Her advice wasn't worth a <dime>.",
                            "target_lang_translations": {
                                "ru": "Ее совет не стоил и <w>гроша</w>.",
                                "zh": "她的建议连<w>一分钱</w>都不值。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "not worth a dime",
                        "without a dime"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень маленькая сумма денег; обычно используется в отрицательном контексте, означая отсутствие стоимости или ценности.",
                        "zh": "极少的一点钱，通常用于否定语境，表示完全没花钱或毫无价值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грош",
                                "target_lang_sense_clarification": "в значении ничтожной суммы"
                            },
                            {
                                "target_lang_word": "копейка",
                                "target_lang_sense_clarification": "в значении минимальной суммы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一分钱",
                                "target_lang_sense_clarification": "表示极少的钱，常用于否定句"
                            },
                            {
                                "target_lang_word": "半毛钱",
                                "target_lang_sense_clarification": "口语说法，表示一点钱也没有或不值钱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3a8328a-4116-347a-9382-9554b11b613d",
                    "sense_definition": "Financial responsibility or expense; used to indicate who is paying for something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "money_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We traveled to the conference on the company's <dime>.",
                            "target_lang_translations": {
                                "ru": "Мы поехали на конференцию за <w>счёт</w> компании.",
                                "zh": "我们去参加那次会议花的是公司的<w>钱</w>。"
                            }
                        },
                        {
                            "text": "I am not going to fix their mistake on my own <dime>.",
                            "target_lang_translations": {
                                "ru": "Я не собираюсь исправлять их ошибку за свой <w>счёт</w>.",
                                "zh": "我可不打算自掏<w>腰包</w>去替他们收拾这个错误。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "on someone's dime",
                        "on the company dime"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Финансовая ответственность или расходы; указывает на того, кто платит.",
                        "zh": "指付款责任或开销，用来说明某件事是由谁出钱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "счёт",
                                "target_lang_sense_clarification": "в контексте оплаты расходов"
                            },
                            {
                                "target_lang_word": "деньги",
                                "target_lang_sense_clarification": "финансы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钱",
                                "target_lang_sense_clarification": "指由某人承担费用时最自然的说法"
                            },
                            {
                                "target_lang_word": "腰包",
                                "target_lang_sense_clarification": "强调自己出钱、自己承担开销"
                            },
                            {
                                "target_lang_word": "费用",
                                "target_lang_sense_clarification": "正式些，指所承担的开销"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62fba5e6-24b6-3837-adbf-aa5234193f77",
