                            {
                                "example_id": "29b5f59d-dcd9-44cb-a7cc-4fa72d50b85e",
                                "sense_id": "6a558454-8cad-30bf-b069-9d12f8ac9baf",
                                "text": "Sinds Pinksteren heb ik de huiskamerdeur nog geregeld open zien en horen springen onder de lichte druk van Tonio's vinger."
                            },
                            {
                                "example_id": "f0d5fdb8-3d8b-4ca8-8fc4-b6af2037fbee",
                                "sense_id": "6a558454-8cad-30bf-b069-9d12f8ac9baf",
                                "text": "Even dwalen mijn gedachten af naar een half geverfde huiskamerdeur thuis, een ov-chipkaart in een broodtrommel en een slaapkamer die er regelmatig uitziet als een ontplofte kledingwinkel."
                            }
