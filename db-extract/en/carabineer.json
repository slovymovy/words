                                                "sense_id": "94063d11-f5b7-325c-b04a-f18b145d7d78",
                                                "text": "„Später bestand die österreichische Reiterei aus Kürassieren, Dragonern, Husaren, Karabinieren und Chevauxlegers.“"
                                            },
                                            {
                                                "example_id": "ec1bf076-aac6-4ff2-9897-411af2719da1",
                                                "sense_id": "94063d11-f5b7-325c-b04a-f18b145d7d78",
                                                "text": "„Ein Kornett von den schwedischen Karabinieren habe es gebracht.“"
                                            },
                                            {
                                                "example_id": "a6f860d8-26dd-406a-b764-702a56d684d3",
                                                "sense_id": "94063d11-f5b7-325c-b04a-f18b145d7d78",
                                                "text": "„Von seinen Adjutanten begleitet, ritt Kutusow im Schritt hinter den Karabiniers her.“"
                                            }
                                        ],
