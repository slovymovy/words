                        "target_lang_word": "bittersweet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bittersweet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b2ca40c-f41f-3059-a61d-2f7f897ceda4",
                                        "entry_id": "2037a8bc-1f38-3ceb-b4a3-ab53b1dd617c",
                                        "glosses": [
                                            "Both bitter and sweet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db669c58-35af-4b78-b96f-5e58989aa8b3",
                                                "sense_id": "0b2ca40c-f41f-3059-a61d-2f7f897ceda4",
                                                "text": "bittersweet chocolate"
                                            },
                                            {
                                                "example_id": "9b7549a8-39c7-4d81-8dfa-6e6753d0bab1",
                                                "sense_id": "0b2ca40c-f41f-3059-a61d-2f7f897ceda4",
                                                "text": "The dark green mooncake is loaded with matcha-infused salted egg yolk custard, which gives a bittersweet taste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b91c096e-90ad-3b50-82cb-37530d8788ad",
                                        "entry_id": "2037a8bc-1f38-3ceb-b4a3-ab53b1dd617c",
                                        "glosses": [
                                            "Expressing contrasting emotions of pain and pleasure."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2502cdfe-67bd-4a8c-9d7c-8a9e9c838c36",
                                                "sense_id": "b91c096e-90ad-3b50-82cb-37530d8788ad",
                                                "text": "The break-up was very bittersweet; they both hurt to end it, but were glad it was over."
                                            },
                                            {
                                                "example_id": "d9a23f68-ca0e-4fa6-9b8a-202d5621a19f",
                                                "sense_id": "b91c096e-90ad-3b50-82cb-37530d8788ad",
                                                "text": "[…] sensations of this kind, however delicious, are, at their first recognition, of a very tumultuous nature, and have very little of the opiate in them. They were, moreover, in the present case, embittered with certain circumstances, which being mixed with sweeter ingredients, tended altogether to compose a draught that might be termed bitter-sweet […]"
                                            },
                                            {
                                                "example_id": "1747e465-9820-4eca-abc4-b0030dbc6da6",
                                                "sense_id": "b91c096e-90ad-3b50-82cb-37530d8788ad",
                                                "text": "Her eyes still shone upon the ground, and still she prolonged the bittersweet delight at seeing this humiliation of both soul and body by asking the one question whose reply would complete her sad success."
                                            },
                                            {
                                                "example_id": "3952fb62-3920-4214-af44-c11dd6a562f9",
                                                "sense_id": "b91c096e-90ad-3b50-82cb-37530d8788ad",
                                                "text": "He sat beside the busy street,\nThere, where he last had seen her face:\nAnd thronging memories, bitter-sweet,\nSeemed yet to haunt the ancient place:"
                                            },
                                            {
                                                "example_id": "bf1ec753-8d43-42da-9b84-8987226e4d61",
                                                "sense_id": "b91c096e-90ad-3b50-82cb-37530d8788ad",
                                                "text": "While the final festivities were bittersweet, David and Lisa insisted on a party rather than a funeral."
                                            },
                                            {
                                                "example_id": "5387d2ee-9529-4a39-a209-c790b8df7610",
                                                "sense_id": "b91c096e-90ad-3b50-82cb-37530d8788ad",
                                                "text": "The public has complicated feelings about our decision to end this trial before it ever began, and that’s OK. It’s bittersweet for us, too."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2571237-bd4b-3929-b037-7e8804321da8",
                                        "entry_id": "2037a8bc-1f38-3ceb-b4a3-ab53b1dd617c",
                                        "glosses": [
                                            "Of bittersweet color (see the noun section, below)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bittersweet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50aaefe9-3e50-343f-b95f-cd5256928473",
                                        "entry_id": "8ff0f78e-4bed-351d-a88a-5b979dd31733",
                                        "glosses": [
                                            "Bittersweet nightshade (Solanum dulcamara)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33e6c406-603d-48d0-9a9b-2159bc557234",
                                                "sense_id": "50aaefe9-3e50-343f-b95f-cd5256928473",
                                                "text": "Bitter ſweete bringeth foorth wooddie ſtalks as doth the Vine, parted into many ſlender creeping braunches, by which it climeth and taketh holde of hedges and ſhrubbes next vnto it. […] Bitter ſweet doth grow in moiſt places about ditches, riuers, and hedges, almoſt euery where."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d684c1a-20e1-326a-9afc-4201d9df34bc",
                                        "entry_id": "8ff0f78e-4bed-351d-a88a-5b979dd31733",
                                        "glosses": [
                                            "Bittersweetness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68f90a72-b152-4de6-9fec-e72dea779126",
                                                "sense_id": "5d684c1a-20e1-326a-9afc-4201d9df34bc",
                                                "text": "I had once before visited these three villages, Skedans, Tanoo and Cumshewa. The bitter-sweet of their overwhelming loneliness created a longing to return to them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58df97dc-6562-32d8-aa43-5c2d49f1d7ec",
                                        "entry_id": "8ff0f78e-4bed-351d-a88a-5b979dd31733",
                                        "glosses": [
                                            "A vine, of the genus Celastrus, having small orange fruit that open to reveal red seeds."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b9f72ce-7598-4b63-8042-4c28ccd2a92b",
                                                "sense_id": "58df97dc-6562-32d8-aa43-5c2d49f1d7ec",
                                                "text": "Over by the creek-bed scarlet-flamed sumac shouldered the silver-green of the willows, and orange-colored bittersweet crept through the tangle of wild plums."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ed530c7-a99f-3fe2-a30a-359db6a82088",
                                        "entry_id": "8ff0f78e-4bed-351d-a88a-5b979dd31733",
                                        "glosses": [
                                            "A variety of apple with a bittersweet taste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e18870e-6a64-4c65-9a5e-1b029cefd613",
                                                "sense_id": "3ed530c7-a99f-3fe2-a30a-359db6a82088",
                                                "text": "\"They had a good crop of bitter-sweets, they couldn’t grind them all\"—nodding towards an orchard where some heaps of apples had been left lying ever since the ingathering."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a3dfa64-8d1a-32ef-8b4f-e257aeb3769b",
                                        "entry_id": "8ff0f78e-4bed-351d-a88a-5b979dd31733",
                                        "glosses": [
                                            "Any variety of clam in the family Glycymerididae"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe31de09-0c12-31e3-9b66-05c8c869a1de",
                                        "entry_id": "8ff0f78e-4bed-351d-a88a-5b979dd31733",
                                        "glosses": [
                                            "A pinkish-orange color. Any color in between scarlet and orange."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
