                "senses": [
                    {
                        "sense_id": "5ef27d41-1a6f-3171-bb58-26a8589be25a",
                        "entry_id": "ad010536-727f-3345-9422-9368e3413e8b",
                        "glosses": [
                            "von Dezember bis Januar auf den Sprungschanzen in Oberstdorf, Garmisch-Partenkirchen, Innsbruck und Bischofshofen ausgetragener Wettbewerb im Skispringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c656ff3-87f8-4d64-b602-593bd3088a7b",
                                "sense_id": "5ef27d41-1a6f-3171-bb58-26a8589be25a",
                                "text": "„Nach Olympiasieg, Weltmeistertitel und Gesamtweltcup triumphierte der Österreicher nun auch bei der 60. Vierschanzentournee.“"
                            },
                            {
                                "example_id": "bbc4d18c-6e86-48f8-96a2-97b4974a8fd5",
                                "sense_id": "5ef27d41-1a6f-3171-bb58-26a8589be25a",
                                "text": "„Alle wollen werden wie Schanzenkönig Martin Schmitt, 22, der dieser Tage in Oberstdorf und andernorts um den Sieg bei der Vierschanzentournee kämpft.“"
                            },
                            {
                                "example_id": "44521db8-95e8-475c-9c24-3611f98d0221",
                                "sense_id": "5ef27d41-1a6f-3171-bb58-26a8589be25a",
                                "text": "„Statt am ersten Highlight mit einer Klassierung in den Top Ten zu glänzen, hat Ammanns Selbstvertrauen am zweitletzten Springen vor der Vierschanzentournee einen weiteren Knacks bekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
