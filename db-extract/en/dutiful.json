                    {
                        "sense_id": "5743927a-dc67-3d58-903e-4df8fe0749fd",
                        "entry_id": "ca895efa-cd1a-3c73-8d0c-5ca1f866ce55",
                        "glosses": [
                            "Accepting of one's legal or moral obligations and willing to do them well, and without complaint."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a609aeb-9698-41f8-873d-faae9d871e96",
                                "sense_id": "5743927a-dc67-3d58-903e-4df8fe0749fd",
                                "text": "Ralph was a dutiful child, and took the trash out without being told."
                            },
                            {
                                "example_id": "b7341cbd-3801-42c6-b8d9-413b0ea065a2",
                                "sense_id": "5743927a-dc67-3d58-903e-4df8fe0749fd",
                                "text": "And when blondes and beautiful are multiple / They become so dull and dutiful"
                            }
                        ]
                    },
                    {
                        "sense_id": "c2cd64e5-80d9-387b-9a2b-d5a36945bf41",
                        "entry_id": "ca895efa-cd1a-3c73-8d0c-5ca1f866ce55",
                        "glosses": [
                            "Pertaining to one's duty; demonstrative of one's sense of duty."
                        ],
                        "tags": [],
                        "examples": []
                    }
