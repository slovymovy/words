                "senses": [
                    {
                        "sense_id": "a47c08fe-ab2d-3c57-9016-d3b2e341fca6",
                        "entry_id": "7d10a126-7603-3b31-a13e-1d974c82f3f1",
                        "glosses": [
                            "Angehöriger des gleichnamigen, antiken samnitischen Stammes in Mittelitalien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47b29449-eb17-4e33-af97-5dcb3226e3b1",
                                "sense_id": "a47c08fe-ab2d-3c57-9016-d3b2e341fca6",
                                "text": "„Dieser Bund umfaßte mehrere Stämme, die Pentrer, Hirpiner und Kaudiner.“"
                            },
                            {
                                "example_id": "4b7f0b80-9e4d-4200-92f7-27468f61e42f",
                                "sense_id": "a47c08fe-ab2d-3c57-9016-d3b2e341fca6",
                                "text": "„Samniten ist der Oberbegriff für vier altitalische Stämme, nämlich die Caracener, Kaudiner, Hirpiner und Pentrer.“"
                            },
                            {
                                "example_id": "0dc84794-a4d8-4ae4-ade2-0af9a1c2fd2e",
                                "sense_id": "a47c08fe-ab2d-3c57-9016-d3b2e341fca6",
                                "text": "„In den zwei folgenden Jahren behielten die Römer gleichfalls die Oberhand und siegten bei Sueffula, machten aber schon 341 Friede und Bündnis mit den Samnitern (den Stämmen, die den Krieg mit Kampanien und Rom geführt hatten: Hirpiner, Frentaner, Kaudiner und Pentrer).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
