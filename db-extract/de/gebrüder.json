                        "sense_id": "df3956b8-1403-3489-9357-9cc4d260cb9d",
                        "entry_id": "188265d2-ba0a-3f89-9f27-f3ac6502f163",
                        "glosses": [
                            "Brüder, die ein Unternehmen leiten oder eine bedeutende Leistung vollbracht haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7a3b400-76af-453b-9c6f-2f7ca259454b",
                                "sense_id": "df3956b8-1403-3489-9357-9cc4d260cb9d",
                                "text": "„Die Gebrüder Grimm sind die Begründer der modernen Märchenforschung und aus diesem Grund nicht aus ihr wegzudenken.“"
                            },
                            {
                                "example_id": "2dbe33d7-f74e-4079-9d0c-4189ed691e05",
                                "sense_id": "df3956b8-1403-3489-9357-9cc4d260cb9d",
                                "text": "„In diesem Papier werde ein für allemal festgelegt, dass niemand anderes als die Gebrüder Wright als erste Motorflieger genannt werden dürften; zwei Amerikaner und nicht der Bayer.“"
                            }
                        ],
