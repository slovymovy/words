                    {
                        "translation_id": "8ecf4dbd-c03f-4a40-97c7-ae26c66e852c",
                        "source_entry_id": "904c5e90-1a74-3e75-b768-442c2c9d4874",
                        "source_sense_description": "The horizontal movement of a body of atmosphere (or other fluid) along with a concurrent transport of its temperature, humidity etc.",
                        "target_lang_word": "advection",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "advection",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d87a0b70-df0b-30e0-b2d5-915f1781efad",
                                        "entry_id": "bf7e059c-7f93-32d8-bac6-2505829c559c",
                                        "glosses": [
                                            "Transport d’une propriété, telle que l’humidité, la température, la pollution, par un fluide, tel que l’eau ou l’air, en général (en météorologie) selon un mouvement à dominante horizontale."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8924157b-e70f-466a-b8ae-8b335ce52751",
                                                "sense_id": "d87a0b70-df0b-30e0-b2d5-915f1781efad",
                                                "text": "Le brouillard d’advection se forme lorsqu'une masse d’air chaud et humide se déplace au-dessus d'une surface froide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e282adb6-ebeb-46df-b874-faf85c08f62d",
                        "source_entry_id": "904c5e90-1a74-3e75-b768-442c2c9d4874",
                        "source_sense_description": "The horizontal movement of a body of atmosphere (or other fluid) along with a concurrent transport of its temperature, humidity etc.",
                        "target_lang_word": "Strömungstransport",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fcd09fd7-0f35-4307-90e0-e801e1f8380f",
                        "source_entry_id": "904c5e90-1a74-3e75-b768-442c2c9d4874",
                        "source_sense_description": "The horizontal movement of a body of atmosphere (or other fluid) along with a concurrent transport of its temperature, humidity etc.",
                        "target_lang_word": "Advektion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Advektion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5556380d-5759-3b2b-992a-0d9761b48d8d",
                                        "entry_id": "f374fa6f-9f79-3038-809e-49a9092d7ccf",
                                        "glosses": [
                                            "überwiegend horizontal erfolgende Zufuhr von Luftmassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "266ca95c-70c6-42cc-90b3-820271ee79b6",
                                                "sense_id": "5556380d-5759-3b2b-992a-0d9761b48d8d",
                                                "text": "Die Häufigkeit der Advektion wird durch die allgemeine Zirkulation der Atmosphäre bestimmt."
                                            },
                                            {
                                                "example_id": "d5bf6141-2d37-4266-ae00-3a8db7dc4ee0",
                                                "sense_id": "5556380d-5759-3b2b-992a-0d9761b48d8d",
                                                "text": "Durch das Zusammenwirken lokaler Klimafaktoren und Advektion entsteht das lokale Klima."
                                            },
                                            {
                                                "example_id": "00e71069-0653-4b25-b18e-61f51ddeb2d9",
                                                "sense_id": "5556380d-5759-3b2b-992a-0d9761b48d8d",
                                                "text": "Als zweites Glied des Ozonkreislaufs sollen die Transporteffekte behandelt werden. Sie lassen sich aufteilen in Advektion und Großturbulenz einerseits sowie einen Austausch Stratosphäre – Troposphäre andererseits."
                                            },
                                            {
                                                "example_id": "a74a3e57-80f4-46ea-8960-f080fc90d8fb",
                                                "sense_id": "5556380d-5759-3b2b-992a-0d9761b48d8d",
                                                "text": "In einem gleichförmigen Geschwindigkeitsfeld verändert sich die Konzentration einer nur durch Advektion bewegten Schadstoffwolke nicht. Sie wird lediglich verschoben, und zwar mit der Strömungsgeschwindigkeit in die jeweilige Strömungsrichtung."
                                            },
                                            {
                                                "example_id": "2c6c3bd1-2da5-4928-8ce8-b0ddf347a971",
                                                "sense_id": "5556380d-5759-3b2b-992a-0d9761b48d8d",
                                                "text": "Es zeigte sich ferner, daß die stratosphärische Advektion in den Fällen steigenden Bodendruckes, also bei der Ausbildung antizyklonaler Wetterlagen, besonders deutlich ausgeprägt ist, …"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4d47f33a-4c4b-3856-a550-14a4ba97e654",
                                        "entry_id": "f374fa6f-9f79-3038-809e-49a9092d7ccf",
                                        "glosses": [
                                            "horizontal erfolgende Bewegung von Wassermassen in den Ozeanen"
                                        ],
                                        "tags": [
                                            "Ozeanografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbd41f97-796d-4b2b-b51a-29ecd62a25df",
                                                "sense_id": "4d47f33a-4c4b-3856-a550-14a4ba97e654",
                                                "text": "Für den Wärmeaustausch im System Ozean – Atmosphäre sind die obersten Wasserschichten von Bedeutung für Strahlung, Verdunstung, Niederschlag, Advektion und Konvektion."
                                            },
                                            {
                                                "example_id": "4be14f5e-02d6-4dd2-8953-8bbc1ff04356",
                                                "sense_id": "4d47f33a-4c4b-3856-a550-14a4ba97e654",
                                                "text": "Das zweite Muster wird als Resultat des Einflusses der Advektion im Wasserkörper interpretiert."
                                            },
                                            {
                                                "example_id": "75bd7450-95ab-45a5-99e9-57677dad4d6c",
                                                "sense_id": "4d47f33a-4c4b-3856-a550-14a4ba97e654",
                                                "text": "Janssen (2002) zegt, dass die erklärten Varianzen der beiden Muster in der südlichen Einstromregion in etwa gleich groß sind und folgert, dass hier beide Prozesse (ozeanische Advektion und lokale Wärmeflüsse) von etwa gleicher Bedeutung sind."
                                            },
                                            {
                                                "example_id": "ce78bcc0-5ae2-4047-9cd3-bba862b059f7",
                                                "sense_id": "4d47f33a-4c4b-3856-a550-14a4ba97e654",
                                                "text": "In der Tiefe kommt es unterhalb der OMZ zu einem erneuten Anstieg der Sauerstoffkonzentration. Das ist mit der Advektion sauerstoffreichen Wassers in einer Umgebung mit geringer Sauerstoffzehrung begründet."
                                            },
                                            {
                                                "example_id": "0c5dbdc4-c6b4-406b-9a82-5d594d8da8d0",
                                                "sense_id": "4d47f33a-4c4b-3856-a550-14a4ba97e654",
                                                "text": "Innerhalb einer Dichtefläche hängt die Ausbreitung des Tracers wesentlich von der mittleren Ozeanzirkulation und der turbulenten Vermischung durch mesoskalige Wirbel ab. Daher können horizontale Dispersion und Advektion aus der horizontalen Ausdehnung und Verschiebung des Tracers bestimmt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
