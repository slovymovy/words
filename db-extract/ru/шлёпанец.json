                "translations": [
                    {
                        "translation_id": "e562ff1d-894c-497d-ac7e-4826e69b3a47",
                        "source_entry_id": "6492ad1f-dd73-3c8b-bab7-609ca6041c66",
                        "source_sense_id": "850e75f5-aae0-3d80-a5c7-69e7e3c7a52f",
                        "target_lang_word": "flip-flop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flip-flop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "920a84d4-e9ef-3c3e-bf71-3bef07f645bb",
                                        "entry_id": "37f32b61-2dd5-384a-a8f5-7fff8cd2481b",
                                        "glosses": [
                                            "A sandal consisting of a rubber sole fastened to the foot by a rubber thong fitting between the toes and around the sides of the foot."
                                        ],
                                        "tags": [
                                            "UK",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c50746ed-4826-44c7-9d97-74a04b181712",
                                                "sense_id": "920a84d4-e9ef-3c3e-bf71-3bef07f645bb",
                                                "text": "the necessity for yet another place at which to buy a polo shirt or a pair of flip-flops may not be apparent to the town's residents"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bcbb2ae-cb65-3398-9fe5-a45b9b3c9ba8",
                                        "entry_id": "37f32b61-2dd5-384a-a8f5-7fff8cd2481b",
                                        "glosses": [
                                            "A change of places; an inversion or swap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b18afb1-92cc-46e8-8798-240a6eefba1b",
                                                "sense_id": "2bcbb2ae-cb65-3398-9fe5-a45b9b3c9ba8",
                                                "text": "On the break for strong left, everything remains the same, except for the flip-flop of positions."
                                            },
                                            {
                                                "example_id": "31ea49a5-6ec7-47be-ad48-2d7412fed46c",
                                                "sense_id": "2bcbb2ae-cb65-3398-9fe5-a45b9b3c9ba8",
                                                "text": "BR's flip-flop attitude towards the two options can be observed in comments made by the BR chairman in September 1967, which were interpreted as meaning that the facts now have to be \"adjusted\" to prove the electrification case."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75161c9d-4a81-3127-ad71-a5c01b0b1ba0",
                                        "entry_id": "37f32b61-2dd5-384a-a8f5-7fff8cd2481b",
                                        "glosses": [
                                            "A change of places; an inversion or swap.",
                                            "An instance of flip-flopping, of repeatedly changing one's stated opinion about a matter."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9fb3dba1-c9e0-3de8-96a9-09b6c471b635",
                                        "entry_id": "37f32b61-2dd5-384a-a8f5-7fff8cd2481b",
                                        "glosses": [
                                            "A bistable; an electronic switching circuit that has either two stable states (switching between them in response to a trigger) or a stable and an unstable state (switching from one to the other and back again in response to a trigger), and which is thereby capable of serving as one bit of memory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a75db883-9137-4b95-b85b-8149a61e2411",
                                                "sense_id": "9fb3dba1-c9e0-3de8-96a9-09b6c471b635",
                                                "text": "Ten two-state flip-flops […] were formed into ten-stage ring counters representing each decimal digit in the ten-digit accumulators […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08c04859-d1c3-38d6-bb24-2277dd33441a",
                                        "entry_id": "37f32b61-2dd5-384a-a8f5-7fff8cd2481b",
                                        "glosses": [
                                            "The sound of a regular footfall."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8abc0b4-94ad-312f-9a05-b4928f7feefc",
                                        "entry_id": "37f32b61-2dd5-384a-a8f5-7fff8cd2481b",
                                        "glosses": [
                                            "A somersault."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97aa46f5-44eb-350d-81f1-d18e0fad74ec",
                                        "entry_id": "37f32b61-2dd5-384a-a8f5-7fff8cd2481b",
                                        "glosses": [
                                            "A return trip."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5aafb1eb-3dce-44ed-af09-f8fdf547906f",
                                                "sense_id": "97aa46f5-44eb-350d-81f1-d18e0fad74ec",
                                                "text": "We'll catch you on the flip-flop. This here's the Rubber Duck on the side. We gone, 'bye, 'bye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47bcbf6e-0fdf-343f-bbc5-decd601a4ee3",
                                        "entry_id": "37f32b61-2dd5-384a-a8f5-7fff8cd2481b",
                                        "glosses": [
                                            "A person or inhabitant of the Middle East, or a Muslim nation, particularly Afghanistan."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "offensive",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "flip-flop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7e53395-0d66-34ff-8295-99505798992c",
                                        "entry_id": "80b6f0d6-f4ec-397b-a4f6-505162a03954",
                                        "glosses": [
                                            "To alternate back and forth between directly opposite opinions, ideas, or decisions."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bfc3089-e366-4fdb-975d-3fce21158cdf",
                        "source_entry_id": "6492ad1f-dd73-3c8b-bab7-609ca6041c66",
                        "source_sense_id": "850e75f5-aae0-3d80-a5c7-69e7e3c7a52f",
                        "target_lang_word": "slipper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slipper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8823d95-235e-32ca-8a97-a7f55b755c62",
                                        "entry_id": "731843ad-a6b2-3a69-908c-ca2b1027cddb",
                                        "glosses": [
                                            "A low soft shoe that can be slipped on and off easily."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4cc70889-a19c-332a-93e2-ba8b65c7d286",
                                        "entry_id": "731843ad-a6b2-3a69-908c-ca2b1027cddb",
                                        "glosses": [
                                            "A low soft shoe intended for indoor use; a bedroom slipper or house slipper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7602ab18-72c8-4072-9d76-354d766d25d0",
                                                "sense_id": "4cc70889-a19c-332a-93e2-ba8b65c7d286",
                                                "text": "Get out of bed, put on your slippers, and come downstairs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df21294f-5624-361a-9e3f-f03e9ca1666b",
                                        "entry_id": "731843ad-a6b2-3a69-908c-ca2b1027cddb",
                                        "glosses": [
                                            "A flip-flop (type of rubber sandal)."
                                        ],
                                        "tags": [
                                            "Hawaii",
                                            "India",
                                            "Malaysia",
                                            "Philippines",
                                            "Singapore",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bca26540-8d82-3a32-9d7f-450666d23410",
                                        "entry_id": "731843ad-a6b2-3a69-908c-ca2b1027cddb",
                                        "glosses": [
                                            "A person or creature that slips."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60d167d8-2f13-4c0a-bd0d-7543e7bcc344",
                                                "sense_id": "bca26540-8d82-3a32-9d7f-450666d23410",
                                                "text": "He is a frequent “slipper,” but doesn’t seem to have sufficient intelligence upon which to ever build permanent sobriety and happiness."
                                            },
                                            {
                                                "example_id": "9a707a36-518c-476a-adb4-91b7c5401039",
                                                "sense_id": "bca26540-8d82-3a32-9d7f-450666d23410",
                                                "text": "Virtually all human action is liable to opposing interpretations, depending mainly upon distance: to take the familiar case of the banana peel, the fall is painful to the slipper, hilarious to the spectator across the street."
                                            },
                                            {
                                                "example_id": "3f76d882-e3d0-4aa6-9799-a5a22864fe3f",
                                                "sense_id": "bca26540-8d82-3a32-9d7f-450666d23410",
                                                "text": "Slipping on a banana peel does not mean big bucks for the “slipper” if the “slippee” has a good law firm representing it."
                                            },
                                            {
                                                "example_id": "7fa08170-9346-4c67-ae91-694fc39dc39e",
                                                "sense_id": "bca26540-8d82-3a32-9d7f-450666d23410",
                                                "text": "He was grey and had eight legs, and could travel anywhere and slip into any corner of 9 worlds. For this reason he was called Sleipnir (\"the slipper) and was given to Oðinn as his steed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75e4a133-663f-3062-9b49-95469adfb4d1",
                                        "entry_id": "731843ad-a6b2-3a69-908c-ca2b1027cddb",
                                        "glosses": [
                                            "A kind of apron or pinafore for children."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da94d1b3-3b1d-3d38-875e-7b1be0fcfee2",
                                        "entry_id": "731843ad-a6b2-3a69-908c-ca2b1027cddb",
                                        "glosses": [
                                            "A kind of brake or shoe for a wagon wheel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab295d90-960c-3bf3-89f0-a57f90484e3d",
                                        "entry_id": "731843ad-a6b2-3a69-908c-ca2b1027cddb",
                                        "glosses": [
                                            "A piece, usually a plate, applied to a sliding piece, to receive wear and permit adjustment; a gib."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b705594f-ebef-3373-9ca5-4e22069f3668",
                                        "entry_id": "731843ad-a6b2-3a69-908c-ca2b1027cddb",
                                        "glosses": [
                                            "A form of corporal punishment where the buttocks are repeatedly struck with a plimsoll; \\\"the slipper\\\"."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13521ce1-4c74-4adb-b017-e8475acee96f",
                                                "sense_id": "b705594f-ebef-3373-9ca5-4e22069f3668",
                                                "text": "1981, Andrew Loudon, Staffroom mole leaks secret of his school's beatings book, Daily Mail and General Trust, World Corporal Punishment Research\n\"Mrs Marlene Foster […] , an opponent of the slipper, said her son Gary had a bottom \"as red as a beetroot\" after he was punished for writing on desks. \""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aed22a3c-6346-33c2-bfee-62eb27f7deba",
