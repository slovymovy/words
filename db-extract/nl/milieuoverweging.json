                        "examples": [
                            {
                                "example_id": "3afd6867-1a83-4863-a99e-0a49d13f8cf0",
                                "sense_id": "027b27fd-674a-3167-a414-d56111ea610d",
                                "text": "Groenland is ook bezig met een verbod op het zoeken naar uranium en het delven ervan. Ook hierbij spelen milieuoverwegingen."
                            },
                            {
                                "example_id": "735c7457-2db7-4034-b91d-e1bd323a85fc",
                                "sense_id": "027b27fd-674a-3167-a414-d56111ea610d",
                                "text": "Minister De Rugy heeft niet gezegd voor welke wegen buitenlandse vrachtwagens moeten betalen. Volgens hem spelen niet alleen milieuoverwegingen een rol. De Rugy wil met de opbrengst ook investeren in wegen en spoorlijnen. Hij zei dat hij geen ongeval wil zoals in Genua, waar een viaduct instortte en 43 mensen om het leven kwamen."
                            }
