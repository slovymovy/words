{
    "word_family": [
        "afsteker",
        "afsteekmes",
        "afsteekbeitel"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "397e2744-9052-3494-8f58-55de09cbbc98",
                    "sense_definition": "een duidelijk zichtbaar verschil of contrast vormen met de omgeving of een andere zaak",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "contrast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De witte muren van het huis <w>steken</w> scherp <w>af</w> tegen de donkerblauwe lucht.",
                            "target_lang_translations": {
                                "en": "The white walls of the house <w>stand out</w> sharply against the dark blue sky."
                            }
                        },
                        {
                            "text": "Zijn vrolijke gedrag <w>stak</w> nogal <w>af</w> bij de sombere sfeer in de kamer.",
                            "target_lang_translations": {
                                "en": "His cheerful behavior <w>contrasted</w> quite a bit with the somber atmosphere in the room."
                            }
                        }
                    ],
                    "synonyms": [
                        "contrasteren",
                        "verschillen"
                    ],
                    "antonyms": [
                        "overeenkomen",
                        "samenvallen"
                    ],
                    "common_phrases": [
                        "scherp afsteken tegen",
                        "sterk afsteken bij"
                    ],
                    "target_lang_definitions": {
                        "en": "To form a clearly visible difference or contrast with the surroundings or another matter."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to stand out",
                                "target_lang_sense_clarification": "to be very noticeable by contrast"
                            },
                            {
                                "target_lang_word": "to contrast",
                                "target_lang_sense_clarification": "to show a striking difference"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9048bd0a-ae9a-3bc7-9745-8502b156ed10",
                    "sense_definition": "iets in brand steken of laten ontploffen, zoals vuurwerk of een lucifer",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ontsteken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de jaarwisseling mag men in deze straat geen vuurwerk <w>afsteken</w>.",
                            "target_lang_translations": {
                                "en": "During the turn of the year, one is not allowed to <w>set off</w> fireworks in this street."
                            }
                        },
                        {
                            "text": "Hij wilde een lucifer <w>afsteken</w> om de kaars aan te steken.",
                            "target_lang_translations": {
                                "en": "He wanted to <w>light</w> a match to light the candle."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontsteken",
                        "aansteken"
                    ],
                    "antonyms": [
                        "doven",
                        "uitmaken"
                    ],
                    "common_phrases": [
                        "vuurwerk afsteken",
                        "een lucifer afsteken"
                    ],
                    "target_lang_definitions": {
                        "en": "To set something on fire or cause it to explode, such as fireworks or a match."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to set off",
                                "target_lang_sense_clarification": "to ignite fireworks or explosives"
                            },
                            {
                                "target_lang_word": "to light",
                                "target_lang_sense_clarification": "to ignite a match or candle"
                            },
                            {
                                "target_lang_word": "to fire",
                                "target_lang_sense_clarification": "to launch or ignite fireworks"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "200c7e26-0996-3588-9b5f-47bb51ef8af1",
                    "sense_definition": "met een scherp voorwerp (zoals een spade) een stuk van iets losmaken of verwijderen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verwijderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De tuinman is bezig om de graskanten van het gazon netjes <w>af te steken</w>.",
                            "target_lang_translations": {
                                "en": "The gardener is busy <w>edging</w> the grass borders of the lawn neatly."
                            }
                        },
                        {
                            "text": "Je kunt de oude verfresten gemakkelijk met een plamuurmes <w>afsteken</w>.",
                            "target_lang_translations": {
                                "en": "You can easily <w>scrape off</w> the old paint residue with a putty knife."
                            }
                        }
                    ],
                    "synonyms": [
                        "lossteken",
                        "afsnijden"
                    ],
                    "common_phrases": [
                        "graskanten afsteken",
                        "zoden afsteken"
                    ],
                    "target_lang_definitions": {
                        "en": "To loosen or remove a piece of something using a sharp object (such as a spade)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to cut off",
                                "target_lang_sense_clarification": "to remove by cutting with a tool"
                            },
                            {
                                "target_lang_word": "to edge",
                                "target_lang_sense_clarification": "to trim the borders of a lawn"
                            },
                            {
                                "target_lang_word": "to scrape off",
                                "target_lang_sense_clarification": "to remove layers like paint with a tool"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9db0b09a-0011-330c-bf57-e3139bad12c7",
                    "sense_definition": "een formeel of uitgebreid verhaal, zoals een speech of een preek, hardop uitspreken",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "spreken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De directeur begon een langdradig verhaal <w>af te steken</w> over de nieuwe bedrijfsstrategie.",
                            "target_lang_translations": {
                                "en": "The director started to <w>launch into</w> a tedious story about the new business strategy."
                            }
                        },
                        {
                            "text": "Zonder enige voorbereiding <w>stak</w> hij een indrukwekkende redevoering <w>af</w>.",
                            "target_lang_translations": {
                                "en": "Without any preparation, he <w>delivered</w> an impressive speech."
                            }
                        }
                    ],
                    "synonyms": [
                        "houden",
                        "voordragen"
                    ],
                    "common_phrases": [
                        "een verhaal afsteken",
                        "een redevoering afsteken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt voor lange of vervelende verhalen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To deliver a formal or extensive story, such as a speech or a sermon, out loud."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to deliver",
                                "target_lang_sense_clarification": "to give a speech or address"
                            },
                            {
                                "target_lang_word": "to launch into",
                                "target_lang_sense_clarification": "to start a long story or speech"
                            },
                            {
                                "target_lang_word": "to hold",
                                "target_lang_sense_clarification": "to give a discourse or speech"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75f0ab9e-776c-360b-9216-51a8410de897",
                    "sense_definition": "met een vaartuig van de wal of de kust vertrekken",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "vertrek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zodra de wind gunstig was, <w>stak</w> de kleine vissersboot <w>af</w> van de kust.",
                            "target_lang_translations": {
                                "en": "As soon as the wind was favorable, the small fishing boat <w>pushed off</w> from the coast."
                            }
                        },
                        {
                            "text": "De zeilers besloten vroeg in de ochtend <w>af te steken</w> naar het eiland.",
                            "target_lang_translations": {
                                "en": "The sailors decided to <w>set sail</w> for the island early in the morning."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitvaren",
                        "vertrekken"
                    ],
                    "antonyms": [
                        "aanleggen",
                        "meren"
                    ],
                    "common_phrases": [
                        "van wal afsteken"
                    ],
                    "target_lang_definitions": {
                        "en": "To depart from the shore or coast with a vessel."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to push off",
                                "target_lang_sense_clarification": "to leave the shore in a boat"
                            },
                            {
                                "target_lang_word": "to set sail",
                                "target_lang_sense_clarification": "to begin a journey by water"
                            },
                            {
                                "target_lang_word": "to put out to sea",
                                "target_lang_sense_clarification": "to leave the coast for open water"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}