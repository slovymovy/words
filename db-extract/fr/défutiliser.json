                "senses": [
                    {
                        "sense_id": "c0f0a0ef-6d9c-3e39-b8bb-a915ebb851cc",
                        "entry_id": "fdba2cd8-08c9-3b89-8433-10c6233b4ff9",
                        "glosses": [
                            "Rendre moins futile."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "64296d56-d8e5-4900-9390-dcb18837c772",
                                "sense_id": "c0f0a0ef-6d9c-3e39-b8bb-a915ebb851cc",
                                "text": "L'objet des nôtres paraîtra-t-il futile ? Pour le « défutiliser », trois avertissements préalables s'imposent."
                            },
                            {
                                "example_id": "d1adb34a-8f01-484d-8f7b-6ab20f411fd2",
                                "sense_id": "c0f0a0ef-6d9c-3e39-b8bb-a915ebb851cc",
                                "text": "C’est un club qui défutilise la mode…"
                            },
                            {
                                "example_id": "592626fd-f350-4a54-b276-efe4b221164f",
                                "sense_id": "c0f0a0ef-6d9c-3e39-b8bb-a915ebb851cc",
                                "text": "Et pourtant, à bien réfléchir le banal est riche d’enseignements car il est détenteur de toutes nos évidences, de tous nos présupposés. Il importe constamment de défutiliser le banal […]."
                            }
                        ]
                    }
