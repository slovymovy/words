                "senses": [
                    {
                        "sense_id": "6941026b-1074-371b-95fd-2137569f4c29",
                        "entry_id": "e65967ba-63d5-38c5-8e5a-8cca5a3e03ef",
                        "glosses": [
                            "Lüftungsgitter, durch das Luft in einen Raum eintritt"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "ca971986-71ba-48e4-b040-4e6c4b42a183",
                                "sense_id": "6941026b-1074-371b-95fd-2137569f4c29",
                                "text": "Durch das Zuluftgitter strömt frische Zuluft, aus dem Zuluftkanal von der Klimaanlage, in den Raum."
                            },
                            {
                                "example_id": "2ba36c80-b558-4561-8483-43ae4d20f974",
                                "sense_id": "6941026b-1074-371b-95fd-2137569f4c29",
                                "text": "„Der Luftverteilkasten ist mit einem induktionsarmen Zuluftgitter ausgerüstet.“"
                            },
                            {
                                "example_id": "65e13fb0-7d37-47e0-831c-c032dcfe51f2",
                                "sense_id": "6941026b-1074-371b-95fd-2137569f4c29",
                                "text": "„Ein bekanntes Zuluftgitter und das oben beschriebene Abluftgitter können in einem gemeinsamen Rahmen übereinander in einer Öffnung einer Gebäudefront angeordnet werden.“"
                            },
                            {
                                "example_id": "3cc05080-728f-4c86-bfa6-7a50b4ac65ba",
                                "sense_id": "6941026b-1074-371b-95fd-2137569f4c29",
                                "text": "„Zuluftgitter reinigen spart Energie und fördert den Luftdurchsatz.“"
                            },
                            {
                                "example_id": "b4362330-3ea0-41b6-991f-b075a8592ffb",
                                "sense_id": "6941026b-1074-371b-95fd-2137569f4c29",
                                "text": "„Unter Zuluftgitter versteht man in einem Rahmen angeordnete horizontale und vertikale Luftleitlamellen.“"
                            },
                            {
                                "example_id": "674780ee-6c1a-41b9-863e-ca910c024329",
                                "sense_id": "6941026b-1074-371b-95fd-2137569f4c29",
                                "text": "„Der in dem Verdampfer abgekühlte Kühlluftstrom wird anschließend über den Rückluftkanal und das Zuluftgitter wieder dem Warenraum zugeführt. Der von dem Zuluftgitter zu dem Rückluftgitter strömende Kühlluftstrom bildet einen Kühlluftschleier, der das Eindringen von warmer Umgebungsluft in den Warenraum wirkungsvoll verhindert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
