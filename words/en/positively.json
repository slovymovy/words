                                "target_lang_word": "确定地",
                                "target_lang_sense_clarification": "毫无疑问"
                            },
                            {
                                "target_lang_word": "明确地",
                                "target_lang_sense_clarification": "清晰且无误地"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "con seguridad",
                                "target_lang_sense_clarification": "sin lugar a dudas"
                            },
                            {
                                "target_lang_word": "inequívocamente",
                                "target_lang_sense_clarification": "de forma clara y sin error"
                            },
                            {
                                "target_lang_word": "con certeza",
                                "target_lang_sense_clarification": "de manera confirmada"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kesinlikle",
                                "target_lang_sense_clarification": "şüpheye yer bırakmayacak şekilde"
                            },
                            {
                                "target_lang_word": "emin bir şekilde",
                                "target_lang_sense_clarification": "tam bir güvenle"
                            },
                            {
                                "target_lang_word": "tam olarak",
                                "target_lang_sense_clarification": "doğruluğundan emin olunan"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sicher",
                                "target_lang_sense_clarification": "bestimmt, unzweifelhaft"
                            },
                            {
                                "target_lang_word": "eindeutig",
                                "target_lang_sense_clarification": "keine andere Möglichkeit zulassend"
                            },
                            {
                                "target_lang_word": "bestimmt",
                                "target_lang_sense_clarification": "mit Nachdruck oder hoher Wahrscheinlichkeit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a558e3fe-bc3f-37e5-9d35-e67e7ea09498",
                    "sense_definition": "Completely or absolutely; used to emphasize the truth of a statement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is <w>positively</w> no reason for you to be afraid.",
                            "target_lang_translations": {
                                "ru": "У тебя нет <w>абсолютно</w> никаких причин бояться.",
                                "zh": "你<w>绝对</w>没有理由感到害怕。",
                                "es": "No hay <w>absolutamente</w> ninguna razón para que tengas miedo.",
                                "tr": "Korkman için <w>kesinlikle</w> hiçbir neden yok.",
                                "de": "Es gibt <w>absolut</w> keinen Grund für dich, Angst zu haben."
                            }
                        },
                        {
                            "text": "She <w>positively</w> refused to eat her vegetables at dinner.",
                            "target_lang_translations": {
                                "ru": "Она <w>категорически</w> отказалась есть овощи за ужином.",
                                "zh": "晚餐时，她<w>断然</w>拒绝吃蔬菜。",
                                "es": "Ella se negó <w>categóricamente</w> a comer sus verduras en la cena.",
                                "tr": "Akşam yemeğinde sebzelerini yemeyi <w>kategorik olarak</w> reddetti.",
                                "de": "Sie weigerte sich <w>kategorisch</w>, beim Abendessen ihr Gemüse zu essen."
                            }
                        }
                    ],
                    "synonyms": [
                        "absolutely",
                        "completely",
                        "totally",
                        "utterly",
                        "entirely"
                    ],
                    "common_phrases": [
                        "positively no",
                        "positively refuse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершенно или абсолютно; используется для подчеркивания истинности утверждения.",
                        "zh": "完全地或绝对地；用于强调陈述的真实性。",
                        "es": "Completamente o absolutamente; se usa para enfatizar la veracidad de una afirmación.",
                        "tr": "Tamamen veya kesinlikle; bir ifadenin doğruluğunu vurgulamak için kullanılır.",
                        "de": "Völlig oder absolut; wird verwendet, um die Wahrheit einer Aussage zu unterstreichen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "абсолютно",
                                "target_lang_sense_clarification": "полностью"
                            },
                            {
                                "target_lang_word": "категорически",
                                "target_lang_sense_clarification": "решительно (часто при отказе)"
                            },
                            {
                                "target_lang_word": "решительно",
                                "target_lang_sense_clarification": "твердо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绝对",
                                "target_lang_sense_clarification": "完全地"
                            },
                            {
                                "target_lang_word": "断然",
                                "target_lang_sense_clarification": "坚决地（常用于拒绝）"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "absolutamente",
                                "target_lang_sense_clarification": "de forma total"
                            },
                            {
                                "target_lang_word": "categóricamente",
                                "target_lang_sense_clarification": "de manera rotunda, especialmente al negar"
