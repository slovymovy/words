                    },
                    {
                        "translation_id": "25df707f-c829-4a24-b500-8f09f22fa6e9",
                        "source_entry_id": "18f38db2-24de-3964-8293-eec40afad505",
                        "source_sense_id": "94975721-91eb-3223-b96a-9bc62d1ebcbc",
                        "target_lang_word": "séjour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "séjour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02158096-cc55-3163-8fe9-3c5250a47302",
                                        "entry_id": "1928e62b-b216-37ee-99ff-fb6e1d392640",
                                        "glosses": [
                                            "Demeure, résidence plus ou moins longue dans un lieu, dans un pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41b773ed-8277-4811-b2af-c63cc941ce88",
                                                "sense_id": "02158096-cc55-3163-8fe9-3c5250a47302",
                                                "text": "Ma belle-mère m'avait appris, dans un moment d’égarement, qu'il avait été en prison pendant vingt ans pour inceste sur ses propres filles en Normandie et interdit de séjour depuis lors dans sa région."
                                            },
                                            {
                                                "example_id": "920e060a-a087-46d8-bd4d-c71abb44fbb0",
                                                "sense_id": "02158096-cc55-3163-8fe9-3c5250a47302",
                                                "text": "Que je le plains, pécheur, en ton heure dernière !\nLes maux les plus affreux sont amassés sur toi ;\nLe noir enfer, séjour rempli d’effroi,\nT’attend au bout de la carrière."
                                            },
                                            {
                                                "example_id": "f6779e31-828d-406f-9431-6375a3aca018",
                                                "sense_id": "02158096-cc55-3163-8fe9-3c5250a47302",
                                                "text": "— Par contre, la grande gueule, celui qui balance les « krèles », je le connais. Il tape sa petite sœur. La gamine a déjà fait trois séjours à l’hosto."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a2e5e11-d2f8-38d8-944c-ef6f596f58e3",
                                        "entry_id": "1928e62b-b216-37ee-99ff-fb6e1d392640",
                                        "glosses": [
                                            "Temps qu’un bâtiment de guerre passe en relâche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff4c0b47-4d2a-4daa-9937-8451a07cdf29",
                                                "sense_id": "3a2e5e11-d2f8-38d8-944c-ef6f596f58e3",
                                                "text": "Le séjour de ce vaisseau dans tel port a été d’une semaine, d’un mois, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "528a9fb8-05e8-3659-8537-eebd763ea619",
                                        "entry_id": "1928e62b-b216-37ee-99ff-fb6e1d392640",
                                        "glosses": [
                                            "Arrêt des liquides qui restent plus ou moins longtemps en quelque endroit."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01c6e3d4-3feb-4a2c-88e2-0bc1168d343b",
                                                "sense_id": "528a9fb8-05e8-3659-8537-eebd763ea619",
                                                "text": "Le séjour des eaux dans un terrain."
                                            },
                                            {
                                                "example_id": "536844de-018e-4366-a1a7-df29393922e9",
                                                "sense_id": "528a9fb8-05e8-3659-8537-eebd763ea619",
                                                "text": "Le séjour des mers sur un continent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa32347d-1e02-3894-89af-f20f2797bf1e",
                                        "entry_id": "1928e62b-b216-37ee-99ff-fb6e1d392640",
                                        "glosses": [
                                            "Par métonymie, temps passé dans un lieu déterminé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "268c7a1f-5a88-426d-9bb3-19a97afd2eeb",
                                                "sense_id": "aa32347d-1e02-3894-89af-f20f2797bf1e",
                                                "text": "Il a fait un séjour d’une semaine en Andalousie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b455a281-6fa1-3135-8d3d-ab729e6e6151",
                                        "entry_id": "1928e62b-b216-37ee-99ff-fb6e1d392640",
                                        "glosses": [
                                            "Lieu considéré par rapport à l’habitation, à la demeure qu’on y fait ou qu’on y peut faire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "425a4bae-ad3d-4476-94e8-ac901ba66a49",
                                                "sense_id": "b455a281-6fa1-3135-8d3d-ab729e6e6151",
                                                "text": "Un séjour champêtre."
                                            },
                                            {
                                                "example_id": "398b9d3f-fb86-4c7e-bf4f-0be6c28f8fcc",
                                                "sense_id": "b455a281-6fa1-3135-8d3d-ab729e6e6151",
                                                "text": "Cette maison est un beau séjour."
                                            },
                                            {
                                                "example_id": "3796b21a-a728-45b4-b5d1-263fe0b3ac40",
                                                "sense_id": "b455a281-6fa1-3135-8d3d-ab729e6e6151",
                                                "text": "Cette ville est un agréable séjour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f746e7c6-d507-35ce-b4f2-0c8d817a3bf3",
                                        "entry_id": "1928e62b-b216-37ee-99ff-fb6e1d392640",
                                        "glosses": [
                                            "Salle, pièce où l’on se tient habituellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa9c221e-e070-4833-b6b2-c5ec28d4f62a",
                                                "sense_id": "f746e7c6-d507-35ce-b4f2-0c8d817a3bf3",
                                                "text": "Cette maison a un beau séjour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a48763fa-ee18-4ea2-802d-ffdb9da2cde7",
                        "source_entry_id": "18f38db2-24de-3964-8293-eec40afad505",
                        "source_sense_id": "94975721-91eb-3223-b96a-9bc62d1ebcbc",
                        "target_lang_word": "résidence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "résidence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9588b9b-3940-30bc-9671-4bfdfb637a7e",
                                        "entry_id": "cbc3a168-60be-3816-a97c-2bbc20fa9c71",
                                        "glosses": [
                                            "Séjour permanent ou prolongé ; lieu où l’on séjourne habituellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cdc4a83-bae2-40d2-976f-6a8bbc9ea34d",
                                                "sense_id": "f9588b9b-3940-30bc-9671-4bfdfb637a7e",
                                                "text": "Ravie de cette réponse, Theodehilde fit charger sur plusieurs voitures les richesses de son mari, et partit pour Châlon-sur-Saône, résidence du roi Gonthramn."
                                            },
                                            {
                                                "example_id": "e0ad9b75-886e-46d7-bf94-1cb82924e13c",
                                                "sense_id": "f9588b9b-3940-30bc-9671-4bfdfb637a7e",
                                                "text": "Écossais jusqu’à la moelle, grand amateur du pibroch dont il joue avec conviction, serviable, jovial, toujours très actif, il est la providence des rares touristes étrangers qui visitent la résidence chérifienne."
                                            },
                                            {
                                                "example_id": "6ae114eb-dc31-47ac-a326-13170a3699f2",
                                                "sense_id": "f9588b9b-3940-30bc-9671-4bfdfb637a7e",
                                                "text": "Il n’était pas en voyage, ni même en résidence, en Afrique. Il y était chez lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a113a81f-7e93-3de6-8f4f-de40a19fd560",
                                        "entry_id": "cbc3a168-60be-3816-a97c-2bbc20fa9c71",
                                        "glosses": [
                                            "Séjour forcé, fait de devoir rester un lieu donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fbb826e-0233-4d8d-91a2-173e759dbe58",
                                                "sense_id": "a113a81f-7e93-3de6-8f4f-de40a19fd560",
                                                "text": "« […] et l’abbé Studer, vicaire de Nouzon, alors en résidence à Annelles, vint plusieurs fois dire la messe et c’est tout » résume après la guerre l’abbé Sauvegrain."
                                            },
                                            {
                                                "example_id": "4fa5211a-4d36-46ac-bbfe-3091542ccaaa",
                                                "sense_id": "a113a81f-7e93-3de6-8f4f-de40a19fd560",
                                                "text": "Il a été placé en résidence surveillée depuis le putsch."
                                            },
                                            {
                                                "example_id": "9de55871-6949-4020-9dbd-b51a125cb90a",
                                                "sense_id": "a113a81f-7e93-3de6-8f4f-de40a19fd560",
                                                "text": "Il sera nécessaire de l’assigner à résidence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f19283c-ee1e-3953-8b7c-cbd667bab88d",
                                        "entry_id": "cbc3a168-60be-3816-a97c-2bbc20fa9c71",
                                        "glosses": [
                                            "Lieu où habitent en permanence les époux, leurs enfants et les personnes vivant sous le même toit qu’eux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d555cd1-84bb-465e-b009-2dd615905057",
                                                "sense_id": "4f19283c-ee1e-3953-8b7c-cbd667bab88d",
                                                "text": "Après leur mariage, ils ont élu résidence en centre-ville."
                                            },
                                            {
                                                "example_id": "b4733f1e-9046-45a7-bf8d-ab6421610a48",
                                                "sense_id": "4f19283c-ee1e-3953-8b7c-cbd667bab88d",
                                                "text": "De nombreux ressortissants britanniques se sont rendus «de bonne foi» au Royaume-Uni pour les fêtes de fin d'année et «éprouvent des difficultés à rejoindre leur pays de résidence», selon le ministère qui a donc décidé d'adresser des «consignes de tolérance» aux effectifs de police aux frontières afin que chacun puisse rejoindre sa résidence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9c3a7b1-c856-37f4-bdf9-08155ea61e31",
                                        "entry_id": "cbc3a168-60be-3816-a97c-2bbc20fa9c71",
                                        "glosses": [
                                            "Lieu d’habitation lié à la charge officielle d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a4ac023-097c-452a-b939-596f6ccdc0c3",
                                                "sense_id": "b9c3a7b1-c856-37f4-bdf9-08155ea61e31",
                                                "text": "La résidence papale se trouve au Vatican."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d434e86b-705f-3c18-8427-8842f26d3205",
                                        "entry_id": "cbc3a168-60be-3816-a97c-2bbc20fa9c71",
                                        "glosses": [
                                            "Maison, maison de campagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f71af00f-0ca6-4aab-a8ed-4d602b94b9db",
                                                "sense_id": "d434e86b-705f-3c18-8427-8842f26d3205",
                                                "text": "J’ai investit deux cent mille euros dans ma résidence secondaire."
                                            },
                                            {
                                                "example_id": "1b2b6065-c490-4c67-bc84-2671b4e30828",
                                                "sense_id": "d434e86b-705f-3c18-8427-8842f26d3205",
                                                "text": "Plus d’un, en apercevant ces coquettes résidences, si tranquilles, enviait d’en être le propriétaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93cf3b8a-8a9d-38d9-a931-20d8344b1dac",
                                        "entry_id": "cbc3a168-60be-3816-a97c-2bbc20fa9c71",
                                        "glosses": [
                                            "Groupe d’immeubles ou d’appartements offrant un certain confort, et souvent gérés par une copropriété."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aaae4d00-89b3-3a0e-8748-58707413bae1",
                                        "entry_id": "cbc3a168-60be-3816-a97c-2bbc20fa9c71",
                                        "glosses": [
                                            "Stage de spécialisation suivant le doctorat en médecine"
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d4addb7-280c-460d-b7b1-b0fff50a7f01",
                                                "sense_id": "aaae4d00-89b3-3a0e-8748-58707413bae1",
                                                "text": "Après sont doctorat, l’étudiant devra faire sa résidence pour pouvoir exercer la médecine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06feb916-85b0-3b43-b6d6-0d17e8ecfc8e",
                                        "entry_id": "cbc3a168-60be-3816-a97c-2bbc20fa9c71",
                                        "glosses": [
                                            "Charge, fonction, office de résident. Ensemble des services qui l’entourent ou parlent en son nom."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57414043-36d5-4d46-ad84-3fe2f6a9a319",
                                                "sense_id": "06feb916-85b0-3b43-b6d6-0d17e8ecfc8e",
                                                "text": "La Résidence générale [de Tunis] (…) a justifié par les troubles de ces jours derniers les mesures administratives ainsi prises à l’égard de M. Bourguiba."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79843de4-0633-3d60-9c64-a7dd83017d38",
                                        "entry_id": "cbc3a168-60be-3816-a97c-2bbc20fa9c71",
                                        "glosses": [
                                            "Statut d’un artiste, d’un expert, invité à pratiquer son art de manière provisoire dans un endroit prestigieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f22e7cb4-c4a6-43d8-be55-6cb6302d46a1",
                                                "sense_id": "79843de4-0633-3d60-9c64-a7dd83017d38",
                                                "text": "Le jeune chef voit toutes ses résidences culinaires afficher complet plus vite qu’un concert de Beyoncé au Stade de France."
                                            },
                                            {
                                                "example_id": "3afdb8c5-6709-4c8f-97f4-eff59c7b000b",
                                                "sense_id": "79843de4-0633-3d60-9c64-a7dd83017d38",
                                                "text": "Être en résidence à la Villa Médicis est une récompense pour tout écrivain."
                                            },
                                            {
                                                "example_id": "6084cd6e-20cd-41a2-b64b-20f290b6f63e",
                                                "sense_id": "79843de4-0633-3d60-9c64-a7dd83017d38",
                                                "text": "Donc de manière classique, on accompagne dans les différents missionnements les acteurs culturels des principales structures de l’agglomération et évidemment les résidences qu’ils accueillent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
