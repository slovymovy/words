                "senses": [
                    {
                        "sense_id": "b0569f3f-9489-37bf-b8b7-b76757b4893b",
                        "entry_id": "1e493955-edc1-3a57-bfbd-8dbf91c3d2af",
                        "glosses": [
                            "een gebaar dat bestaat uit het omhoog trekken en na korte tijd weer omlaag laten gaan van beide schouders. Het gebaar drukt uit dat iemand het niet weet of niet interesseert, soms is het zelfs een uitdrukking van machteloosheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea2f7f61-284e-46e4-ab5a-b72165cb594c",
                                "sense_id": "b0569f3f-9489-37bf-b8b7-b76757b4893b",
                                "text": "Ze waren een nest aan het maken bij het meer.'Beatrice herinnerde zich hoe verheugd Theo was geweest toen Cameron hem over het nest had verteld en keek snel op. Cameron reageerde met een licht schouderophalen."
                            },
                            {
                                "example_id": "6d0bd5fe-6360-424f-8161-7b4da59ad01b",
                                "sense_id": "b0569f3f-9489-37bf-b8b7-b76757b4893b",
                                "text": "Wees je bewust van de camera’s. Alles wat je doet wordt gezien en uitvergroot. Elke zucht, elk schouderophalen, elke opgetrokken wenkbrauw - hoe miniem ook. Weet waar de camera’s staan en ga niet kris-kras over het podium dolen. Want dat ziet er raar uit, zo bleek in 2008."
                            }
                        ]
                    }
