                        "examples": [
                            {
                                "example_id": "d468bbc7-a900-44b8-aff7-a8ada4cb7beb",
                                "sense_id": "79574136-f3db-3fde-8a71-dd93b34d02cb",
                                "text": "La verve d’un Dumas au rude et gros bon sens / De ces rustres puant, en leur minablerie / L’égoïsme grossier."
                            },
                            {
                                "example_id": "8a72e561-13ad-40ff-818f-48ee26c1456f",
                                "sense_id": "79574136-f3db-3fde-8a71-dd93b34d02cb",
                                "text": "Il se savait mauvais clown, n’éprouvait nulle honte à cet échec et prenait quand même plaisir à ses minableries."
                            },
                            {
                                "example_id": "378e7d06-4734-43ac-abb9-fb33af66f24f",
                                "sense_id": "79574136-f3db-3fde-8a71-dd93b34d02cb",
                                "text": "La civilisation croissante ne perfectionne chez l’homme que les grimaces de sa minablerie régnante."
                            }
                        ]
                    }
