                "senses": [
                    {
                        "sense_id": "2c7463d5-05fb-3657-9eba-12bd9f1fb0f8",
                        "entry_id": "7e7f03f8-010b-3354-954e-4deccd14e41b",
                        "glosses": [
                            "ein kleiner Bart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5191e54-ca5d-48df-b2ad-91a40388664c",
                                "sense_id": "2c7463d5-05fb-3657-9eba-12bd9f1fb0f8",
                                "text": "„Er hatte sich seinen Sohn als großen, kräftigen jungen Mann vorgestellt, stattdessen ist dieser ein schmächtiger Bursche mit schmalem Bärtchen, Baskenmütze und modischen Kleidern.“"
                            },
                            {
                                "example_id": "65095ee3-dd30-4fb7-a185-df51e833db31",
                                "sense_id": "2c7463d5-05fb-3657-9eba-12bd9f1fb0f8",
                                "text": "„Er faltete die rosigen, fetten Händchen und senkte den rosigen, dicken Kopf mit den blonden Haaren, den blonden Augenbrauen und dem blonden Bärtchen am Kinn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
