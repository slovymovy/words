                                    {
                                        "sense_id": "46236d69-981e-302c-9d59-ce10218ab1ad",
                                        "entry_id": "382eee25-25a7-3b99-899d-4100284efb19",
                                        "glosses": [
                                            "mit jemandem gemeinsame Vorfahren habend, dieselbe Abstammung teilend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc68915c-3cfb-4a62-97f4-f1f514c61634",
                                                "sense_id": "46236d69-981e-302c-9d59-ce10218ab1ad",
                                                "text": "„Natürlich ist ›blutsverwandt‹ ein umstrittener Begriff, und etwa zehn Paragraphen in Ihren Verordnungen legen dar, was als blutsverwandt gilt und was nicht.“"
                                            }
