                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arcanson",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5acd885a-6099-30e8-b27d-ebe066fd0e45",
                                        "entry_id": "3b835803-80cf-30f9-b882-607338c47618",
                                        "glosses": [
                                            "Colophane."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71101043-cd7e-4330-8612-e4ff2b60a197",
                                                "sense_id": "5acd885a-6099-30e8-b27d-ebe066fd0e45",
                                                "text": "Un jour\nIl y aura autre chose que le jour\nUn chose, plus franche, que l'on appellera le Jodel\nUne encore, translucide comme l'arcanson\nQue l'on s'enchâssera dans l'œil avec élégance\nIl y aura l'auraille, plus cruel\nLe volutin, plus dégagé…"
                                            },
                                            {
                                                "example_id": "a9b1657d-ed59-4b6c-98a2-b10123c68f70",
                                                "sense_id": "5acd885a-6099-30e8-b27d-ebe066fd0e45",
                                                "text": "Poix noire. Mélange d'arcanson ou fausse colophane, & de goudron : la meilleure vient de Suède, …."
                                            },
                                            {
                                                "example_id": "51f10b83-ce6f-457a-8201-510c3546aea8",
                                                "sense_id": "5acd885a-6099-30e8-b27d-ebe066fd0e45",
                                                "text": "Une demi-once d’arcanson et de térébenthine, quatre onces de cire jaune, et trois demi-onces de noir animal, s’il vous plaît, pour nettoyer les cuirs vernis de mon équipement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
