                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fde79d4-fe19-3be9-ab32-4172a56ff0db",
                                        "entry_id": "0ede2623-0c7e-33e3-b31f-40b4129267fb",
