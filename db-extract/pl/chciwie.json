                ],
                "senses": [
                    {
                        "sense_id": "a2091c3b-8c66-374c-bd47-c533244388df",
                        "entry_id": "e04e960f-9167-3eae-8112-9328538778f2",
                        "glosses": [
                            "voller Begierde; begehrlich, gierig, habgierig, habsüchtig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f973b757-d388-4d2a-8e83-7bff6f5a7bbc",
                                "sense_id": "a2091c3b-8c66-374c-bd47-c533244388df",
                                "text": "„Wbiega i okiem chciwie ściany starodawne / Ogląda czule, jako swe znajome dawne.“"
                            },
                            {
                                "example_id": "a43be6c3-e4e0-43cc-a107-a6254e10906a",
                                "sense_id": "a2091c3b-8c66-374c-bd47-c533244388df",
                                "text": "„Biedny, zostawiony sam sobie, ratował się instynktem, jakim… przypadkiem dorwał się abecadlnika, zaciekawił nim, pisać i czytać sam prawie nauczył; gwałtem potem wcisnął się do szkółki kościelnej, o suchym chlebie karmiąc łaciną chciwie…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f768422-cc0d-46a3-bf82-c6d90923c24e",
                        "source_entry_id": "e04e960f-9167-3eae-8112-9328538778f2",
                        "source_sense_id": "a2091c3b-8c66-374c-bd47-c533244388df",
                        "source_sense_description": "voller Begierde; begehrlich, gierig, habgierig, habsüchtig",
                        "target_lang_word": "begehrlich",
