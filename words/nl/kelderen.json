{
    "word_family": [
        "kelder",
        "kelderruimte",
        "kelderverdieping",
        "kelderluik"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5a10e61d-bafb-39f5-8e60-893091fbf3ab",
                    "sense_definition": "zeer snel en sterk in waarde, aantal of niveau afnemen",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "dalen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De prijzen van de huizen <w>kelderen</w> door de aanhoudende economische crisis.",
                            "target_lang_translations": {
                                "en": "House prices are <w>plummeting</w> due to the ongoing economic crisis."
                            }
                        },
                        {
                            "text": "Na het slechte nieuws <w>kelderde</w> de koers van het aandeel onmiddellijk.",
                            "target_lang_translations": {
                                "en": "Following the bad news, the share price <w>plunged</w> immediately."
                            }
                        }
                    ],
                    "synonyms": [
                        "dalen",
                        "instorten"
                    ],
                    "common_phrases": [
                        "de prijzen kelderen",
                        "de koers kelderde"
                    ],
                    "target_lang_definitions": {
                        "en": "to decrease very quickly and sharply in value, amount, or level"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plummet",
                                "target_lang_sense_clarification": "prices, numbers, or rates"
                            },
                            {
                                "target_lang_word": "plunge",
                                "target_lang_sense_clarification": "sudden sharp fall"
                            },
                            {
                                "target_lang_word": "tumble",
                                "target_lang_sense_clarification": "fall rapidly"
                            },
                            {
                                "target_lang_word": "slump",
                                "target_lang_sense_clarification": "drop heavily"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a18e2c6-4571-3d31-a3ae-12fbfb4c6325",
                    "sense_definition": "door verlies van drijfvermogen naar de bodem zakken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zinken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vissersboot raakte lek tijdens de zware storm en <w>kelderde</w> binnen een uur.",
                            "target_lang_translations": {
                                "en": "The fishing boat sprang a leak during the severe storm and <w>sank</w> within an hour."
                            }
                        },
                        {
                            "text": "Het oude schip is na een botsing met een rots <w>gekelderd</w>.",
                            "target_lang_translations": {
                                "en": "The old ship <w>went down</w> after colliding with a rock."
                            }
                        }
                    ],
                    "synonyms": [
                        "zinken"
                    ],
                    "common_phrases": [
                        "een schip kelderde"
                    ],
                    "target_lang_definitions": {
                        "en": "to sink to the bottom due to loss of buoyancy (of a vessel)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sink",
                                "target_lang_sense_clarification": "of a ship going down"
                            },
                            {
                                "target_lang_word": "go down",
                                "target_lang_sense_clarification": "vessel submerging"
                            },
                            {
                                "target_lang_word": "founder",
                                "target_lang_sense_clarification": "fill with water and sink"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5cf48fd-5286-3b98-b357-f771fe504459",
                    "sense_definition": "een schip of ander vaartuig opzettelijk of door geweld doen zinken",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "zinken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De duikboot wist het vijandelijke transportschip met twee torpedo's te <w>kelderen</w>.",
                            "target_lang_translations": {
                                "en": "The submarine managed to <w>sink</w> the enemy transport ship with two torpedoes."
                            }
                        },
                        {
                            "text": "Tijdens de zeeslag werd het vrachtschip door de marine <w>gekelderd</w>.",
                            "target_lang_translations": {
                                "en": "During the naval battle, the cargo ship was <w>sunk</w> by the navy."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een schip kelderen"
                    ],
                    "target_lang_definitions": {
                        "en": "to cause a ship or other vessel to sink intentionally or by force"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sink",
                                "target_lang_sense_clarification": "cause to submerge, e.g. with torpedoes"
                            },
                            {
                                "target_lang_word": "scuttle",
                                "target_lang_sense_clarification": "deliberately sink one's own ship"
                            },
                            {
                                "target_lang_word": "send to the bottom",
                                "target_lang_sense_clarification": "destroy and sink a ship"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5155d968-4f0a-3549-a2fd-7a2cbd525915",
                    "sense_definition": "goederen, zoals vaten wijn of voorraden, naar een kelder brengen of daarin opslaan",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wijnhandelaar liet de zware houten vaten voorzichtig via de trap <w>kelderen</w>.",
                            "target_lang_translations": {
                                "en": "The wine merchant had the heavy wooden barrels carefully <w>lowered into the cellar</w> via the stairs."
                            }
                        },
                        {
                            "text": "We moesten die ochtend tientallen kisten aardappelen <w>kelderen</w> voor de winter.",
                            "target_lang_translations": {
                                "en": "That morning we had to <w>cellar</w> dozens of crates of potatoes for the winter."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wijn kelderen"
                    ],
                    "target_lang_definitions": {
                        "en": "to move goods, such as wine barrels or provisions, down to a cellar or store them there"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cellar",
                                "target_lang_sense_clarification": "store wine or provisions in a cellar"
                            },
                            {
                                "target_lang_word": "lower into the cellar",
                                "target_lang_sense_clarification": "move goods down to a cellar"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}