                    },
                    {
                        "sense_id": "ec744b12-fedc-3a86-a483-f53b5f3b76eb",
                        "entry_id": "6915477f-151a-375a-a67c-6e0fa436fd9e",
                        "glosses": [
                            "Moving, proceeding or shaped smoothly, gracefully, or continuously."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0aac4593-1cb8-4bd6-9e88-7a434090a046",
                                "sense_id": "ec744b12-fedc-3a86-a483-f53b5f3b76eb",
                                "text": "a flowing dress"
                            },
                            {
                                "example_id": "b7f58a43-cdeb-47fa-864b-b03f59144362",
                                "sense_id": "ec744b12-fedc-3a86-a483-f53b5f3b76eb",
                                "text": "flowing prose"
                            },
                            {
                                "example_id": "1e3108ae-63ca-4657-8afe-cb3b87d663fa",
                                "sense_id": "ec744b12-fedc-3a86-a483-f53b5f3b76eb",
                                "text": "[T]he pleasure of writing on wax with a stylus is exemplified by the fine, flowing hand of a Roman scribe who made out the birth certificate of Herennia Gemella, born March 128 AD."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03da6c2c-1024-4a74-acab-d3362e79668a",
                        "source_entry_id": "6915477f-151a-375a-a67c-6e0fa436fd9e",
                        "source_sense_description": "moving, proceeding or shaped smoothly",
                        "target_lang_word": "potoczysty",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "71aa5cb2-01e1-4cc9-b571-a1362be0a9c6",
                        "source_entry_id": "6915477f-151a-375a-a67c-6e0fa436fd9e",
                        "source_sense_description": "moving, proceeding or shaped smoothly",
                        "target_lang_word": "плавный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "плавный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c40e313e-ca32-3e99-9a8b-6c1043d92aa5",
                                        "entry_id": "47eb9bb9-d920-30dc-b9a5-ca0ad625aec3",
                                        "glosses": [
                                            "совершаемый, происходящий легко и ровно, без резких и крутых изменений (о движении)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d39b099-9fac-4b8a-802d-01252d6ac6b1",
                                                "sense_id": "c40e313e-ca32-3e99-9a8b-6c1043d92aa5",
                                                "text": "Несколько орлов с закрюченными крыльями; их плавный и быстрый полёт."
                                            },
                                            {
                                                "example_id": "28901f06-7688-4cf1-a257-c08024577adb",
                                                "sense_id": "c40e313e-ca32-3e99-9a8b-6c1043d92aa5",
                                                "text": "Явился Карамзин ― следствие и итог тогдашней образованности и просвещения, ― с ним явился новый русский язык, сильный, плавный, приятный, ясный; звонкий, как серебро, сияющий, как хрусталь, бесчисленными радужными отливами света..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ae74349-b310-3d9c-b380-9f27cb7b8f66",
                                        "entry_id": "47eb9bb9-d920-30dc-b9a5-ca0ad625aec3",
                                        "glosses": [
                                            "отличающийся равномерными, ритмичными движениями"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89dcc612-368c-4851-a1a0-12791ed1ac6a",
                                                "sense_id": "7ae74349-b310-3d9c-b380-9f27cb7b8f66",
                                                "text": "Он завидовал Титу Ливию в богатстве предмета; а Ливий, плавный, красноречивый, иногда целые книги наполняет известиями о сшибках и разбоях, которые едва ли важнее половецких набегов."
                                            },
                                            {
                                                "example_id": "988b75cb-6b33-4b15-a218-fbf93ffcbc6b",
                                                "sense_id": "7ae74349-b310-3d9c-b380-9f27cb7b8f66",
                                                "text": "...она говорит одно только слово: галоп! по этой команде берейтор дотрагивается хлыстиком до лошади, и она поднимается в плавный и лёгкий галоп."
                                            },
                                            {
                                                "example_id": "2f4d1e16-c026-42b0-87c6-1578bb1cc74f",
                                                "sense_id": "7ae74349-b310-3d9c-b380-9f27cb7b8f66",
                                                "text": "И хотя доктор, у которого она лечилась в московском Гагаринском переулке в поликлинике ЦЕКУБУ, велел ей не подымать свыше трех килограммов и делать лишь медленные, плавные движения, Людмила Николаевна, по-крестьянски закряхтев, взвалила себе на плечи мешок, полный сырых поленьев, махом поднялась на второй этаж."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34397ad8-0ef2-30ad-bb59-df478e683f2a",
                                        "entry_id": "47eb9bb9-d920-30dc-b9a5-ca0ad625aec3",
                                        "glosses": [
                                            "не имеющий резких изгибов, острых углов (о линиях)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "339ab271-550d-47c9-b8b5-6cf1bf9325c6",
                                                "sense_id": "34397ad8-0ef2-30ad-bb59-df478e683f2a",
                                                "text": "Плавный Волхов подмывал серебряными струями своими корни столетних лип, принадлежавших к саду, в котором Свельда гуляла или пела с подругами, девами Новгородскими, песни, в посидельнике, построенном на самом берегу реки Волхова."
                                            },
                                            {
                                                "example_id": "bab3e792-de78-4788-a0d6-24145e2072dc",
                                                "sense_id": "34397ad8-0ef2-30ad-bb59-df478e683f2a",
                                                "text": "Несимметричный вырез низко спускался на левую грудь, обегая обнажённую руку. Только здесь, над грудью, единственное украшение оттеняло простоту чистого цвета и плавных линий платья."
                                            },
                                            {
                                                "example_id": "fe326aba-a69e-41e9-bfec-de9a62cd7e63",
                                                "sense_id": "34397ad8-0ef2-30ad-bb59-df478e683f2a",
                                                "text": "Англичане любят парки почти без кустов, любят оголённые берега рек и озёр, где граница воды и земли создаёт чёткие и плавные линии, «уединённые дубы» или группы старых деревьев, боскеты (небольшие рощи), стоящие среди лужаек как гигантские букеты."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1154def1-26de-3449-847e-0c34c078fa5c",
                                        "entry_id": "47eb9bb9-d920-30dc-b9a5-ca0ad625aec3",
                                        "glosses": [
                                            "ровный, без резких переходов (о звуках)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22e72780-5525-4d5c-a247-5344f95003ab",
                                                "sense_id": "1154def1-26de-3449-847e-0c34c078fa5c",
                                                "text": "Но чтоб стать на верном пути для сравнительных поисков, надобно прежде всего взять в соображение то, что слово рота образовалось по организации славянского языка, употребляющего гласный звук после плавных р, л, в тех случаях, где прочие индоевропейские языки ставят гласный перед плавным; сличите: брада bart, шлем helm; и если слово начинается слогом, состоящим из одного плавного и одного гласного звука, то у нас вначале стоит плавный, в других языках гласный; например arka рака, древневерхненемецкое albiz, англосакское elfet, а у нас лебедь."
                                            },
                                            {
                                                "example_id": "5cfe3c49-bf93-4f9a-b150-ebff9fa2aa20",
                                                "sense_id": "1154def1-26de-3449-847e-0c34c078fa5c",
                                                "text": "По всему лесу равномерно распространялся широкий, плавный гул, — точно где вблизи шумела вода; ни одного птичьего голоса; кругом полумрак, вместе с гулом располагавший к тяжёлым думам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3dc52e2-dc42-3887-8459-d8a4696e392d",
                                        "entry_id": "47eb9bb9-d920-30dc-b9a5-ca0ad625aec3",
                                        "glosses": [
                                            "постепенно, без резких изменений переходящий из одного положения или состояния в другое"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f45e48b-ae42-48cb-93d3-ca76cf80edae",
                                                "sense_id": "b3dc52e2-dc42-3887-8459-d8a4696e392d",
                                                "text": "По нашему обычному ловкому умению давать отмазку, советское посольство в Стокгольме оговорилось, впрочем, что «оно не исключает, что виза Гирову будет дана в другое, более удобное время» ― чтобы смягчить раздражение, создать иллюзию и плавный переход на ноль."
                                            },
                                            {
                                                "example_id": "11fd14ac-a07f-43f4-825b-f0282302b3c4",
                                                "sense_id": "b3dc52e2-dc42-3887-8459-d8a4696e392d",
                                                "text": "Она помогала раздеваться. Она была как плавный переход от земли к морю."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
