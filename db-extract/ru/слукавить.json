                    },
                    {
                        "translation_id": "2ce5c4ef-0662-4414-8446-afbd4fefe843",
                        "source_entry_id": "67b9fe37-6f28-36af-93b6-b7c3526f5396",
                        "source_sense_id": "5b1783ed-e493-309e-82b3-2eb88bbce4bd",
                        "target_lang_word": "play a cunning trick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "46439b60-fd24-48bf-838c-7635cab0d5b9",
                        "source_entry_id": "67b9fe37-6f28-36af-93b6-b7c3526f5396",
                        "source_sense_id": "5b1783ed-e493-309e-82b3-2eb88bbce4bd",
                        "target_lang_word": "talk through one's hat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "talk through one's hat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d371e445-eeeb-37a6-9553-67facef406c6",
                                        "entry_id": "05fc445a-e726-3738-b1f5-e2f182b370b9",
                                        "glosses": [
                                            "To speak lacking expertise, authority, or knowledge; to invent or fabricate facts."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13bb657b-5bab-441d-8bb6-fd12ec17cdc8",
                                                "sense_id": "d371e445-eeeb-37a6-9553-67facef406c6",
                                                "text": "\"Mr. Pride said to me a moment ago that they spoke better English in Boston than any other place in the world.\"\n\"Did he, though, Lady Lawless? That's good. Well, I guess he was only talking through his hat.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "851149a2-a6ef-3af5-9eef-9621c603f451",
                                        "entry_id": "05fc445a-e726-3738-b1f5-e2f182b370b9",
                                        "glosses": [
                                            "To assert something as true or valid; to bluff."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83b31706-40bb-40a5-b4f8-a91763c93251",
                                                "sense_id": "851149a2-a6ef-3af5-9eef-9621c603f451",
                                                "text": "No, sir, she yust standing pat, / And vonce more she tal her father, / “Yu ban talking tru yure hat!”"
                                            },
                                            {
                                                "example_id": "4586487a-474e-4ec2-8245-2e3f9c8fc55b",
                                                "sense_id": "851149a2-a6ef-3af5-9eef-9621c603f451",
                                                "text": "He's conceited and opinionative and argues all the time, even when he knows perfectly well that he's talking through his hat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "822700f3-8a75-4072-a425-97d0e952ffc3",
                        "source_entry_id": "67b9fe37-6f28-36af-93b6-b7c3526f5396",
                        "source_sense_id": "5b1783ed-e493-309e-82b3-2eb88bbce4bd",
                        "target_lang_word": "stretch the truth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stretch the truth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "280c3ff9-6a9a-3832-b1b5-a9aa28c419e4",
                                        "entry_id": "4a6a0434-8320-391c-b823-374a20865d21",
                                        "glosses": [
                                            "To exaggerate, often to the point where the truth is obscured or lost."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "855700a8-5d50-4ed6-a12d-b5fdbda1ff72",
                                                "sense_id": "280c3ff9-6a9a-3832-b1b5-a9aa28c419e4",
                                                "text": "It would stretch the truth, but perhaps not tear it to tatters, to say that World War II was fought over oil."
                                            },
                                            {
                                                "example_id": "eed026c5-3875-4dab-8904-d962b51624f1",
                                                "sense_id": "280c3ff9-6a9a-3832-b1b5-a9aa28c419e4",
                                                "text": "You think they exaggerate sometimes? You think they embellish things, stretch the truth, play loose with the facts?"
                                            },
                                            {
                                                "example_id": "15ec5bf4-9460-41fd-9ad2-b1a817dfe191",
                                                "sense_id": "280c3ff9-6a9a-3832-b1b5-a9aa28c419e4",
                                                "text": "\"And you suspect them of stretching the truth? Or shrinking the truth?\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
