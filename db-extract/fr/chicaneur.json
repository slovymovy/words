                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "šťoural",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "2e551918-5c10-3898-91f8-1d69211005dd",
                                        "entry_id": "2bf5a5cb-bd46-356d-8d50-5516236b5fde",
                                        "glosses": [
                                            "kdo rád šťourá čili upozorňuje na možné problémy či nedostatky, zvláště když malicherným, nekonstruktivním či obtěžujícím způsobem"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdd89f89-2558-4a01-b359-ef575fc54bfb",
                                                "sense_id": "2e551918-5c10-3898-91f8-1d69211005dd",
                                                "text": "Náš esoterický podnikatel nedávno objevil nový, úžasný zdroj duchovna i příjmu. Při putování velehorami našel v přírodě vystavenou kovovou mísu. Nazval ji „vodnářským zvonem“ a v mystickém vytržení začal na mísu hrát, přičemž objevil její léčebné účinky. (…) Šťouralové říkají, že mísa nepochází z Tibetu, že není stará 3 tisíce let, že není zhotovena ze sedmi kovů, že jde o běžný mosazný suvenýr z čínského trhu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
