{
    "word_family": [
        "poisonous",
        "poisoner",
        "poisonously",
        "poisonousness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "de3cd308-33ee-3471-949d-59e4d874ac1a",
                    "sense_definition": "A substance that causes death or injury to a living organism if swallowed or absorbed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective discovered traces of a deadly <w>poison</w> in the victim's tea.",
                            "target_lang_translations": {
                                "ru": "Детектив обнаружил следы смертельного <w>яда</w> в чае жертвы.",
                                "zh": "侦探在受害者的茶里发现了致命<w>毒药</w>的痕迹。"
                            }
                        },
                        {
                            "text": "Farmers often use rat <w>poison</w> to protect their crops from pests.",
                            "target_lang_translations": {
                                "ru": "Фермеры часто используют крысиный <w>яд</w>, чтобы защитить урожай от вредителей.",
                                "zh": "农民常用灭鼠<w>毒药</w>来保护庄稼免受害虫侵害。"
                            }
                        }
                    ],
                    "synonyms": [
                        "toxin",
                        "venom"
                    ],
                    "antonyms": [
                        "antidote"
                    ],
                    "common_phrases": [
                        "deadly poison",
                        "rat poison",
                        "take poison",
                        "food poison"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, вызывающее смерть или вред живому организму при проглатывании или всасывании.",
                        "zh": "吞下或被吸收后会导致生物死亡或受伤的物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "яд",
                                "target_lang_sense_clarification": "основное значение"
                            },
                            {
                                "target_lang_word": "отрава",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毒药",
                                "target_lang_sense_clarification": "致人死亡或伤害的有毒物质；最常用"
                            },
                            {
                                "target_lang_word": "毒物",
                                "target_lang_sense_clarification": "较正式，强调有毒的物质"
                            },
                            {
                                "target_lang_word": "毒",
                                "target_lang_sense_clarification": "概括说法，常见于固定搭配"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7086c64-7514-39d2-97c9-cdb877d5e7d3",
                    "sense_definition": "Anything that has a destructive, harmful, or corrupting influence on a person or situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jealousy acts as a <w>poison</w> that slowly destroys even the strongest relationships.",
                            "target_lang_translations": {
                                "ru": "Ревность действует как <w>яд</w>, который медленно разрушает даже самые крепкие отношения.",
                                "zh": "嫉妒像一种<w>毒药</w>，会慢慢毁掉再牢固的关系。"
                            }
                        },
                        {
                            "text": "His constant negativity was a <w>poison</w> to the team's morale.",
                            "target_lang_translations": {
                                "ru": "Его постоянный негатив был <w>отравой</w> для морального духа команды.",
                                "zh": "他持续不断的消极态度成了团队士气的<w>毒药</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bane"
                    ],
                    "common_phrases": [
                        "poison to the mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-либо, оказывающее разрушительное, вредное или разлагающее влияние на человека или ситуацию.",
                        "zh": "任何对人或局面具有破坏性、有害或腐蚀性影响的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "яд",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "отрава",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毒药",
                                "target_lang_sense_clarification": "比喻有破坏性、腐蚀性的东西"
                            },
                            {
                                "target_lang_word": "祸害",
                                "target_lang_sense_clarification": "比喻对人或局面有害的事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56b54e5c-ab17-3bb3-8146-69107a431748",
                    "sense_definition": "An alcoholic drink.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bartender smiled at the customer and asked, \"What is your <w>poison</w>?\"",
                            "target_lang_translations": {
                                "ru": "Бармен улыбнулся клиенту и спросил: «Какую <w>отраву</w> предпочитаете?»",
                                "zh": "酒保微笑着问顾客：“您想喝点什么<w>酒</w>？”"
                            }
                        },
                        {
                            "text": "I do not usually drink, but tonight my <w>poison</w> is whiskey.",
                            "target_lang_translations": {
                                "ru": "Я обычно не пью, но сегодня моя <w>отрава</w> — виски.",
                                "zh": "我平时不太喝酒，不过今晚我选的<w>酒</w>是威士忌。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "what is your poison",
                        "name your poison",
                        "pick your poison"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "humorous usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Алкогольный напиток (обычно в шутливом контексте).",
                        "zh": "酒精饮料，通常是戏谑说法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрава",
                                "target_lang_sense_clarification": "шутливое"
                            },
                            {
                                "target_lang_word": "зелье",
                                "target_lang_sense_clarification": "ироничное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "酒",
                                "target_lang_sense_clarification": "口语中戏谑地指酒类饮品"
                            },
                            {
                                "target_lang_word": "酒精饮料",
                                "target_lang_sense_clarification": "较明确地指含酒精的饮料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "365ec2b2-7674-3fda-bc4a-718853df17f5",
                    "sense_definition": "A substance that reduces or stops the effectiveness of a catalyst in a chemical reaction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sulfur acts as a <w>poison</w> to the metal catalyst in this process.",
                            "target_lang_translations": {
                                "ru": "Сера действует как <w>яд</w> для металлического катализатора в этом процессе.",
                                "zh": "在这个过程中，硫会成为金属催化剂的<w>毒物</w>。"
                            }
                        },
                        {
                            "text": "The reaction failed because a catalyst <w>poison</w> was present in the mixture.",
                            "target_lang_translations": {
                                "ru": "Реакция не удалась, так как в смеси присутствовал катализаторный <w>яд</w>.",
                                "zh": "由于混合物中存在催化剂<w>毒物</w>，反应失败了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "catalyst poison"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical (chemistry)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, снижающее или прекращающее эффективность катализатора в химической реакции.",
                        "zh": "在化学反应中降低或阻止催化剂发挥作用的物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "яд",
                                "target_lang_sense_clarification": "химический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毒物",
                                "target_lang_sense_clarification": "化学中使催化剂失效的物质"
                            },
                            {
                                "target_lang_word": "催化剂毒物",
                                "target_lang_sense_clarification": "更具体的技术说法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fd30cbd4-55f0-364e-889a-89d96c91b6a9",
                    "sense_definition": "To give a harmful substance to a person or animal with the intent to kill or harm them.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spy attempted to <w>poison</w> the enemy agent by spiking his drink.",
                            "target_lang_translations": {
                                "ru": "Шпион попытался <w>отравить</w> вражеского агента, подсыпав что-то в его напиток.",
                                "zh": "间谍试图在敌方特工的饮料里做手脚来<w>毒害</w>他。"
                            }
                        },
                        {
                            "text": "It is illegal to <w>poison</w> wild animals in this protected forest.",
                            "target_lang_translations": {
                                "ru": "В этом заповедном лесу запрещено <w>травить</w> диких животных.",
                                "zh": "在这片受保护的森林里，给野生动物<w>下毒</w>是违法的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "poison the food",
                        "poison a victim"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать вредное вещество человеку или животному с намерением убить или навредить.",
                        "zh": "给人或动物施用有害物质，意图将其杀死或伤害。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отравить",
                                "target_lang_sense_clarification": "совершенный вид"
                            },
                            {
                                "target_lang_word": "отравлять",
                                "target_lang_sense_clarification": "несовершенный вид"
                            },
                            {
                                "target_lang_word": "травить",
                                "target_lang_sense_clarification": "обычно о вредителях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毒害",
                                "target_lang_sense_clarification": "使人或动物中毒受害"
                            },
                            {
                                "target_lang_word": "下毒",
                                "target_lang_sense_clarification": "给人或动物投放毒物"
                            },
                            {
                                "target_lang_word": "毒杀",
                                "target_lang_sense_clarification": "强调用毒致死"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c13c24d-8c88-35ff-a991-603fd27c4129",
                    "sense_definition": "To put harmful chemicals or waste into the environment, making it dangerous.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Industrial waste will <w>poison</w> the river if the factory does not filter it.",
                            "target_lang_translations": {
                                "ru": "Промышленные отходы <w>отравят</w> реку, если завод не будет их фильтровать.",
                                "zh": "如果工厂不加处理，工业废料就会<w>污染</w>这条河。"
                            }
                        },
                        {
                            "text": "Heavy smoke from the fires threatens to <w>poison</w> the air we breathe.",
                            "target_lang_translations": {
                                "ru": "Густой дым от пожаров грозит <w>отравить</w> воздух, которым мы дышим.",
                                "zh": "火灾产生的浓烟可能会<w>毒害</w>我们呼吸的空气。"
                            }
                        }
                    ],
                    "synonyms": [
                        "contaminate",
                        "pollute"
                    ],
                    "antonyms": [
                        "purify"
                    ],
                    "common_phrases": [
                        "poison the water",
                        "poison the air",
                        "poison the earth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выбрасывать вредные химикаты или отходы в окружающую среду, делая её опасной.",
                        "zh": "向环境中排放有害化学物质或废弃物，使其变得危险。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отравлять",
                                "target_lang_sense_clarification": "загрязнять среду"
                            },
                            {
                                "target_lang_word": "заражать",
                                "target_lang_sense_clarification": "инфицировать/загрязнять"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "污染",
                                "target_lang_sense_clarification": "使水、空气、土地等变得有害"
                            },
                            {
                                "target_lang_word": "毒害",
                                "target_lang_sense_clarification": "强调有毒有害地危害环境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53346a38-a093-3355-af53-7f3bbb9d4919",
                    "sense_definition": "To have a bad influence on something and spoil or corrupt it.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Constant arguing began to <w>poison</w> the atmosphere in the office.",
                            "target_lang_translations": {
                                "ru": "Постоянные споры начали <w>отравлять</w> атмосферу в офисе.",
                                "zh": "没完没了的争吵开始<w>破坏</w>办公室里的气氛。"
                            }
                        },
                        {
                            "text": "Do not let suspicion <w>poison</w> your friendship with him.",
                            "target_lang_translations": {
                                "ru": "Не позволяй подозрениям <w>отравить</w> твою дружбу с ним.",
                                "zh": "别让猜疑<w>毒害</w>你和他的友谊。"
                            }
                        }
                    ],
                    "synonyms": [
                        "corrupt",
                        "taint"
                    ],
                    "common_phrases": [
                        "poison the atmosphere",
                        "poison the relationship",
                        "poison everything"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оказывать дурное влияние на что-либо, портить или развращать.",
                        "zh": "对某事物产生不良影响，使其恶化、败坏或受损。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отравлять",
                                "target_lang_sense_clarification": "портить жизнь/атмосферу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毒害",
                                "target_lang_sense_clarification": "比喻性地损害关系、气氛等"
                            },
                            {
                                "target_lang_word": "破坏",
                                "target_lang_sense_clarification": "使某事物变坏、受损"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd457b5b-0d35-3578-9ce2-f0e4e8998b9a",
                    "sense_definition": "To influence someone to have a bad opinion of another person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tried to <w>poison</w> the child against his father with lies.",
                            "target_lang_translations": {
                                "ru": "Она пыталась <w>настроить</w> ребенка против отца с помощью лжи.",
                                "zh": "她试图用谎言<w>离间</w>那个孩子和他父亲的关系。"
                            }
                        },
                        {
                            "text": "Rumors were spread to <w>poison</w> the voters against the new candidate.",
                            "target_lang_translations": {
                                "ru": "Слухи распространялись, чтобы <w>настроить</w> избирателей против нового кандидата.",
                                "zh": "有人散布谣言，想<w>煽动</w>选民反对这位新候选人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "poison against someone",
                        "poison the mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внушать кому-либо плохое мнение о другом человеке.",
                        "zh": "使某人对另一人产生不好的看法或敌意。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настраивать",
                                "target_lang_sense_clarification": "против кого-то"
                            },
                            {
                                "target_lang_word": "отравлять",
                                "target_lang_sense_clarification": "ум/сознание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "离间",
                                "target_lang_sense_clarification": "挑拨关系，使人与人疏远"
                            },
                            {
                                "target_lang_word": "煽动",
                                "target_lang_sense_clarification": "煽动别人去反对某人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2c008f0-c304-35ba-9bb3-94254157ca8e",
                    "sense_definition": "To place false or malicious data into a computer system or cache to cause errors or security breaches.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hackers managed to <w>poison</w> the DNS cache to redirect users to a fake website.",
                            "target_lang_translations": {
                                "ru": "Хакерам удалось <w>отравить</w> DNS-кэш, чтобы перенаправить пользователей на поддельный сайт.",
                                "zh": "黑客成功对 DNS 缓存进行<w>投毒</w>，把用户重定向到一个假网站。"
                            }
                        },
                        {
                            "text": "The attack attempts to <w>poison</w> the database with invalid entries.",
                            "target_lang_translations": {
                                "ru": "Атака направлена на то, чтобы <w>отравить</w> базу данных неверными записями.",
                                "zh": "这次攻击试图用无效条目<w>污染</w>数据库。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "poison the cache",
                        "DNS poisoning"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical (computing)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внедрять ложные или вредоносные данные в компьютерную систему или кэш.",
                        "zh": "向计算机系统或缓存中植入虚假或恶意数据，以造成错误或安全漏洞。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отравлять",
                                "target_lang_sense_clarification": "компьютерный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投毒",
                                "target_lang_sense_clarification": "计算机术语，指向缓存或系统注入恶意错误数据"
                            },
                            {
                                "target_lang_word": "污染",
                                "target_lang_sense_clarification": "较通俗地说使数据或系统被错误信息破坏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}