{
    "word_family": [
        "major",
        "majorly",
        "majoritarian"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3f9e2c82-26b0-3140-adb2-0e2d9d9f06a4",
                    "sense_definition": "The larger number or part of a group; more than half of a total.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quantitative_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vast <w>majority</w> of students voted in favor of the new school policy.",
                            "target_lang_translations": {
                                "ru": "Подавляющее <w>большинство</w> студентов проголосовало за новую школьную политику.",
                                "zh": "绝大<w>多数</w>学生都投票支持新的学校政策。"
                            }
                        },
                        {
                            "text": "Only a small <w>majority</w> of the committee agreed with the proposal.",
                            "target_lang_translations": {
                                "ru": "Лишь незначительное <w>большинство</w> членов комитета согласилось с предложением.",
                                "zh": "委员会中只有微弱<w>多数</w>同意这项提议。"
                            }
                        }
                    ],
                    "antonyms": [
                        "minority"
                    ],
                    "common_phrases": [
                        "vast majority",
                        "overwhelming majority",
                        "simple majority",
                        "silent majority",
                        "great majority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая часть группы; более половины от общего числа.",
                        "zh": "一组人或事物中较大的部分；总数中超过一半。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "большинство",
                                "target_lang_sense_clarification": "бо́льшая часть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "多数",
                                "target_lang_sense_clarification": "人数、数量或比例上超过一半的部分"
                            },
                            {
                                "target_lang_word": "大多数",
                                "target_lang_sense_clarification": "群体中占最大部分的人或事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1081e90b-507b-3044-b67e-78d1a8c84403",
                    "sense_definition": "The difference in the number of votes or seats between the winning party or candidate and the opposition.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantitative_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ruling party secured a parliamentary <w>majority</w> of twenty seats.",
                            "target_lang_translations": {
                                "ru": "Правящая партия обеспечила себе парламентское <w>большинство</w> в двадцать мест.",
                                "zh": "执政党取得了二十个席位的议会<w>多数</w>优势。"
                            }
                        },
                        {
                            "text": "She won the local election with a slim <w>majority</w> over her rival.",
                            "target_lang_translations": {
                                "ru": "Она победила на местных выборах с небольшим <w>перевесом</w> над соперником.",
                                "zh": "她以微弱<w>优势</w>击败对手，赢得了地方选举。"
                            }
                        }
                    ],
                    "synonyms": [
                        "margin"
                    ],
                    "common_phrases": [
                        "parliamentary majority",
                        "slim majority",
                        "comfortable majority",
                        "overall majority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разница в количестве голосов или мест между победителем и оппозицией.",
                        "zh": "获胜的政党或候选人与反对方之间在票数或席位上的差额。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевес",
                                "target_lang_sense_clarification": "численное преимущество"
                            },
                            {
                                "target_lang_word": "большинство",
                                "target_lang_sense_clarification": "преимущество в голосах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "优势",
                                "target_lang_sense_clarification": "选举或议会中领先对手的票数或席位差额"
                            },
                            {
                                "target_lang_word": "多数",
                                "target_lang_sense_clarification": "在议会或投票中占有较多票数或席位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "523b9777-c839-3286-8615-362a3aa4e506",
                    "sense_definition": "The legal age at which a person is considered an adult and fully responsible for their actions.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He will receive his inheritance when he reaches his <w>majority</w>.",
                            "target_lang_translations": {
                                "ru": "Он получит наследство, когда достигнет <w>совершеннолетия</w>.",
                                "zh": "他到<w>成年</w>时就会继承遗产。"
                            }
                        },
                        {
                            "text": "The age of <w>majority</w> is eighteen in many parts of the world.",
                            "target_lang_translations": {
                                "ru": "Во многих частях мира возраст <w>совершеннолетия</w> составляет восемнадцать лет.",
                                "zh": "世界上许多地区的法定<w>成年年龄</w>是十八岁。"
                            }
                        }
                    ],
                    "synonyms": [
                        "adulthood"
                    ],
                    "common_phrases": [
                        "age of majority",
                        "reach one's majority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридический возраст, по достижении которого человек считается взрослым и полностью дееспособным.",
                        "zh": "法律上一个人被视为成年人并对自己的行为负完全责任的年龄。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совершеннолетие",
                                "target_lang_sense_clarification": "возраст дееспособности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成年",
                                "target_lang_sense_clarification": "法律上被视为成年并具备完全责任能力的状态"
                            },
                            {
                                "target_lang_word": "成年年龄",
                                "target_lang_sense_clarification": "法律规定成为成年人的年龄"
                            },
                            {
                                "target_lang_word": "法定成年年龄",
                                "target_lang_sense_clarification": "正式法律语境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40180e5c-8b9e-3e10-b8c1-b321b51f12d2",
                    "sense_definition": "The rank or office of a major in the armed forces.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of dedicated service, the captain finally received his <w>majority</w>.",
                            "target_lang_translations": {
                                "ru": "После долгих лет преданной службы капитан наконец получил <w>чин майора</w>.",
                                "zh": "经过多年尽职服役，这位上尉终于获得了<w>少校军衔</w>。"
                            }
                        },
                        {
                            "text": "He was promoted to his <w>majority</w> following the successful campaign.",
                            "target_lang_translations": {
                                "ru": "После успешной кампании он был повышен до <w>звания майора</w>.",
                                "zh": "在那次成功的战役后，他被晋升为<w>少校</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Звание или должность майора в вооруженных силах.",
                        "zh": "武装部队中少校这一军衔或职务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чин майора",
                                "target_lang_sense_clarification": "воинское звание"
                            },
                            {
                                "target_lang_word": "звание майора",
                                "target_lang_sense_clarification": "воинское звание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "少校军衔",
                                "target_lang_sense_clarification": "武装部队中的少校这一军阶"
                            },
                            {
                                "target_lang_word": "少校",
                                "target_lang_sense_clarification": "军队中的少校职位或身份"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4c54086-d427-3166-a241-e6d26d405091",
                    "sense_definition": "One's ancestors or forebears.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient texts spoke of the wisdom passed down from their <w>majority</w>.",
                            "target_lang_translations": {
                                "ru": "В древних текстах говорилось о мудрости, переданной их <w>предками</w>.",
                                "zh": "古代文献谈到由他们的<w>祖先</w>传下来的智慧。"
                            }
                        },
                        {
                            "text": "He sought to honor the legacy of his <w>majority</w> through his noble deeds.",
                            "target_lang_translations": {
                                "ru": "Он стремился почтить наследие своих <w>предков</w> своими благородными поступками.",
                                "zh": "他试图通过自己的高尚行为来尊崇其<w>祖先</w>的遗产。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предки или предшественники (устаревшее).",
                        "zh": "祖先，前辈（古旧用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предки",
                                "target_lang_sense_clarification": "устаревшее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "祖先",
                                "target_lang_sense_clarification": "祖辈、先人；古旧用法"
                            },
                            {
                                "target_lang_word": "先人",
                                "target_lang_sense_clarification": "较文言或书面"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}