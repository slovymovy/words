                {
                    "sense_id": "00785efb-7fa9-315b-9c34-08a4bbca2af5",
                    "sense_definition": "Stupidité, bêtise profonde propre à une personne ou à un comportement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "caractere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>connerie</w> humaine semble parfois n'avoir aucune limite face à de telles réactions.",
                            "target_lang_translations": {
                                "en": "Human <w>stupidity</w> sometimes seems to know no bounds when faced with such reactions.",
                                "ru": "Человеческая <w>глупость</w> порой, кажется, не знает предела, когда дело доходит до таких реакций.",
                                "nl": "De menselijke <w>domheid</w> lijkt soms geen grenzen te kennen bij dergelijke reacties.",
                                "de": "Die menschliche <w>Dummheit</w> scheint angesichts solcher Reaktionen manchmal keine Grenzen zu kennen.",
                                "pl": "Ludzka <w>głupota</w> czasem zdaje się nie znać granic wobec takich reakcji.",
                                "it": "La <w>stupidità</w> umana sembra a volte non avere limiti di fronte a simili reazioni.",
                                "cs": "Lidská <w>hloupost</w> se občas zdá nemít hranic, když jde o takové reakce.",
                                "tr": "Böyle tepkiler karşısında insan <w>aptallığı</w> bazen sınır tanımıyor gibi görünüyor.",
                                "es": "La <w>estupidez</w> humana parece a veces no tener límites ante tales reacciones.",
                                "zh": "面对这种反应，人类的<w>愚蠢</w>有时似乎毫无止境。"
                            }
                        },
