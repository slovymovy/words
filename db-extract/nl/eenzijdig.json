                        "entry_id": "bbdf5c44-57b5-30c3-a368-9f794dae1304",
                        "glosses": [
                            "met of aan één kant, belang, partij etc; waarbij geen andere(n) betrokken zijn, of buiten beschouwing blijven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d5b61a6-9662-4c17-b5bb-4086d73bcee5",
                                "sense_id": "a00a54d0-f089-306f-8238-4ebd28a583d7",
                                "text": "Het papier is eenzijdig bedrukt."
                            },
                            {
                                "example_id": "8fe05c4c-984d-4ccd-b747-a8a2cb72fa9a",
                                "sense_id": "a00a54d0-f089-306f-8238-4ebd28a583d7",
                                "text": "Het is een nogal eenzijdig contract, de opsteller dacht alleen aan zijn eigen belangen."
                            },
                            {
                                "example_id": "45067e3f-1d95-489d-a118-203eb3a0cafe",
                                "sense_id": "a00a54d0-f089-306f-8238-4ebd28a583d7",
                                "text": "Het is een eenzijdig ongeval, hij reed zomaar tegen het hek, er was verder niemand in de buurt."
                            }
                        ]
                    },
                    {
                        "sense_id": "c282fd28-0b1e-3ecb-9a18-efa330ebba53",
                        "entry_id": "bbdf5c44-57b5-30c3-a368-9f794dae1304",
                        "glosses": [
                            "van een beslissing of afspraak dat een van de partijen de beslissing of afspraak aan de andere partijen oplegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0599eab6-143c-4d34-b73d-89f3d74b7d12",
                                "sense_id": "c282fd28-0b1e-3ecb-9a18-efa330ebba53",
                                "text": "De docent was boos door de eenzijdige beslissing van haar superieur."
                            }
                        ]
                    }
                ],
