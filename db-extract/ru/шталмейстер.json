                "senses": [
                    {
                        "sense_id": "a8bbad67-0e52-3a49-b375-92a6bd513062",
                        "entry_id": "4cb4854f-eec1-3c7f-aa0f-fe339976033c",
                        "glosses": [
                            "истор. придворный чин в дореволюционной России, заведовавший царскими конюшнями"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "686f0aab-3d4c-49a5-b6d8-c1612af1d9e3",
                                "sense_id": "a8bbad67-0e52-3a49-b375-92a6bd513062",
                                "text": "Когда настал час приема, шталмейстер царя пришел с санями для посла и белыми лошадьми для свиты."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6e1f531-0253-3c6a-80d2-2bf36dcb879c",
                        "entry_id": "4cb4854f-eec1-3c7f-aa0f-fe339976033c",
                        "glosses": [
                            "режиссёр манежа, ведущий цирковую программу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa724d3e-1a57-4d81-8a2d-c0fe452fc8c4",
                                "sense_id": "d6e1f531-0253-3c6a-80d2-2bf36dcb879c",
                                "text": "Коллинз сумел «подать» номер покупателю со всеми атрибутами настоящего циркового представления и даже сам выступил в роли шталмейстера"
                            }
                        ]
                    }
