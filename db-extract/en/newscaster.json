                "word": "newscaster",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b8356f63-c8cc-45b1-81f6-6dd94b752e5a",
                        "entry_id": "b9c53f0b-175d-354e-9c98-0aed234d3b51",
                        "tags": [
                            "plural"
                        ],
                        "form": "newscasters"
