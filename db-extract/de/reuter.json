                                "example_id": "0731d04f-5fd6-4883-bab2-4e0ef38cadaf",
                                "sense_id": "c4a2c18d-1aa3-3c6c-9c83-12289a04ed87",
                                "text": "Frau Reuter ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fb74cd11-d779-4ff8-bbc4-0234542373d6",
                                "sense_id": "c4a2c18d-1aa3-3c6c-9c83-12289a04ed87",
                                "text": "Herr Reuter wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "48f8ecd5-0c29-49c9-9bf6-7a7ed49eb3ff",
                                "sense_id": "c4a2c18d-1aa3-3c6c-9c83-12289a04ed87",
                                "text": "Die Reuters kommen heute von Rügen."
                            },
                            {
                                "example_id": "0e7ef4a1-4fd2-42ee-9225-8b5fd1e3a051",
                                "sense_id": "c4a2c18d-1aa3-3c6c-9c83-12289a04ed87",
                                "text": "Der Reuter trägt nie die Schals, die die Reuter ihm strickt."
                            },
                            {
                                "example_id": "60fc9cbf-2cf6-4746-b096-fe741544e151",
                                "sense_id": "c4a2c18d-1aa3-3c6c-9c83-12289a04ed87",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Reuter kommt, geht der Herr Reuter.“"
                            },
                            {
                                "example_id": "3fa558e3-c768-419b-af26-3b2d15d685b8",
                                "sense_id": "c4a2c18d-1aa3-3c6c-9c83-12289a04ed87",
                                "text": "Reuter kommt und geht."
                            },
                            {
                                "example_id": "187b6558-a3ec-4b9e-93bd-382ebfd21cbd",
                                "sense_id": "c4a2c18d-1aa3-3c6c-9c83-12289a04ed87",
                                "text": "Reuters kamen, sahen und siegten."
                            },
                            {
                                "example_id": "8df2ab7f-499e-4f54-86ce-c8ffb1bc6bd7",
                                "sense_id": "c4a2c18d-1aa3-3c6c-9c83-12289a04ed87",
                                "text": "An verregneten Herbsttagen ist Familie Reuters liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "a793a7df-1921-4f18-ba10-4f8e65696a0a",
                                "sense_id": "c4a2c18d-1aa3-3c6c-9c83-12289a04ed87",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Reuter das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
