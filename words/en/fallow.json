{
    "word_family": [],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "95d9b6f7-ff11-30d9-9bc6-e9442653926f",
                    "sense_definition": "Inactive or undeveloped for a period of time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "inactive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist spent a <w>fallow</w> period in her career before finding new inspiration.",
                            "target_lang_translations": {
                                "de": "Die Künstlerin durchlebte eine <w>unproduktive</w> Phase in ihrer Karriere, bevor sie neue Inspiration fand."
                            }
                        },
                        {
                            "text": "After several years of success, the company entered a <w>fallow</w> phase of low productivity.",
                            "target_lang_translations": {
                                "de": "Nach mehreren erfolgreichen Jahren trat das Unternehmen in eine <w>brachliegende</w> Phase geringer Produktivität ein."
                            }
                        }
                    ],
                    "synonyms": [
                        "abeyant",
                        "dormant",
                        "latent",
                        "inactive"
                    ],
                    "common_phrases": [
                        "fallow period"
                    ],
                    "target_lang_definitions": {
                        "de": "Für eine gewisse Zeit inaktiv, ungenutzt oder unproduktiv."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "brachliegend",
                                "target_lang_sense_clarification": "im übertragenen Sinne, z. B. Talente oder Potenziale"
                            },
                            {
                                "target_lang_word": "unproduktiv",
                                "target_lang_sense_clarification": "keine Ergebnisse hervorbringend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad483d03-c629-3317-8226-49cc90dbb455",
                    "sense_definition": "Agricultural land that is ploughed but left unseeded to recover its fertility.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "agricultural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers leave the field <w>fallow</w> for a season to improve the soil quality.",
                            "target_lang_translations": {
                                "de": "Landwirte lassen das Feld für eine Saison <w>brach</w>, um die Bodenqualität zu verbessern."
                            }
                        },
                        {
                            "text": "The <w>fallow</w> land was eventually replanted with wheat after resting for a year.",
                            "target_lang_translations": {
                                "de": "Das <w>brachliegende</w> Land wurde schließlich nach einem Jahr Ruhe wieder mit Weizen bepflanzt."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fallow field"
                    ],
                    "target_lang_definitions": {
                        "de": "(Von landwirtschaftlichen Flächen) gepflügt, aber zur Erholung des Bodens unbepflanzt gelassen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "brach",
                                "target_lang_sense_clarification": "bezogen auf Felder und Äcker"
                            },
                            {
                                "target_lang_word": "brachliegend",
                                "target_lang_sense_clarification": "vorübergehend ungenutzt"
                            },
                            {
                                "target_lang_word": "unbestellt",
                                "target_lang_sense_clarification": "nicht mit Feldfrüchten bepflanzt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eee4f20e-0b3e-3be6-bab8-7cb705c438ea",
                    "sense_definition": "Having a pale red, yellow, or light brown color.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fallow</w> deer grazed quietly in the meadow near the forest edge.",
                            "target_lang_translations": {
                                "de": "Das <w>Dam</w>wild graste friedlich auf der Wiese am Waldrand."
                            }
                        },
                        {
                            "text": "Its coat was a distinct <w>fallow</w> shade that blended perfectly with the dry grass.",
                            "target_lang_translations": {
                                "de": "Sein Fell hatte einen deutlichen <w>falben</w> Farbton, der perfekt mit dem trockenen Gras verschmolz."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fallow deer"
                    ],
                    "target_lang_definitions": {
                        "de": "Von blassroter, gelblicher oder hellbrauner Färbung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "falb",
                                "target_lang_sense_clarification": "blassgelb bis gelblich-braun, besonders bei Tierfellen"
                            },
                            {
                                "target_lang_word": "braungelb",
                                "target_lang_sense_clarification": "in einem bräunlichen Gelb"
                            },
                            {
                                "target_lang_word": "hellbraun",
                                "target_lang_sense_clarification": "von heller, brauner Farbe"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a17ee2ba-af85-3516-845d-035aca3d055a",
                    "sense_definition": "Land that is currently not being used for farming.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "agricultural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old farm was mostly <w>fallow</w> after the owners retired.",
                            "target_lang_translations": {
                                "de": "Der alte Bauernhof war größtenteils <w>Brachland</w>, nachdem sich die Besitzer zur Ruhe gesetzt hatten."
                            }
                        },
                        {
                            "text": "They decided to turn the <w>fallow</w> into a community garden.",
                            "target_lang_translations": {
                                "de": "Sie beschlossen, die <w>Brache</w> in einen Gemeinschaftsgarten umzuwandeln."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Landfläche, die zurzeit nicht landwirtschaftlich genutzt wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Brache",
                                "target_lang_sense_clarification": "unbestelltes Feld oder unbebautes Grundstück"
                            },
                            {
                                "target_lang_word": "Brachland",
                                "target_lang_sense_clarification": "ungenutzte Fläche oder Ackerland"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "326d63d6-b3c7-3574-9673-f7e9a1d50c47",
                    "sense_definition": "The act of tilling land without planting crops for a season.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agricultural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Proper <w>fallow</w> helps to control weeds and restore nutrients to the soil.",
                            "target_lang_translations": {
                                "de": "Eine ordnungsgemäße <w>Brache</w> hilft dabei, Unkraut zu bekämpfen und dem Boden Nährstoffe zurückzugeben."
                            }
                        },
                        {
                            "text": "The summer <w>fallow</w> prepared the ground for a successful autumn harvest.",
                            "target_lang_translations": {
                                "de": "Die Sommer<w>brache</w> bereitete den Boden auf eine erfolgreiche Herbsternte vor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "summer fallow"
                    ],
                    "target_lang_definitions": {
                        "de": "Das Pflügen und Ruhenlassen von Ackerboden für eine Saison."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Brache",
                                "target_lang_sense_clarification": "die Ruhephase eines Feldes"
                            },
                            {
                                "target_lang_word": "Brachliegen",
                                "target_lang_sense_clarification": "das Ruhenlassen landwirtschaftlicher Flächen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac8f36a4-8204-3274-b70f-bee697154282",
                    "sense_definition": "To leave land unseeded for a season to restore its fertility.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agricultural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is common practice to <w>fallow</w> the fields every few years.",
                            "target_lang_translations": {
                                "de": "Es ist gängige Praxis, die Felder alle paar Jahre <w>brachzulegen</w>."
                            }
                        },
                        {
                            "text": "They <w>fallowed</w> the northern section of the farm to improve the soil.",
                            "target_lang_translations": {
                                "de": "Sie <w>legten</w> den nördlichen Teil des Hofes <w>brach</w>, um den Boden zu verbessern."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Land für eine Saison unbepflanzt lassen, damit sich der Boden erholt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "brachlegen",
                                "target_lang_sense_clarification": "ein Feld unbestellt lassen"
                            },
                            {
                                "target_lang_word": "brachliegen lassen",
                                "target_lang_sense_clarification": "den Boden ruhen lassen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}