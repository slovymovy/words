                                "target_senses": [
                                    {
                                        "sense_id": "be187db1-cbdf-34dc-92bb-d18ad9532afc",
                                        "entry_id": "60a263f3-d048-3186-a3a9-7a7f0078c84c",
                                        "glosses": [
                                            "ktoś, kto wygłasza kazania"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fd29b7e-e0a5-465a-8ff8-d2b323e06f88",
                                                "sense_id": "be187db1-cbdf-34dc-92bb-d18ad9532afc",
                                                "text": "Po wejściu kaznodziei na ambonę zapanowała głucha cisza przerywana tylko westchnieniami pań z sodalicji."
