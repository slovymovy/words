                                        "glosses": [
                                            "The quality or degree of being round.",
                                            "Synonym of rotundity."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a69086f2-3e86-40f6-9bb5-ed79503af603",
                                                "sense_id": "9482fe7a-0103-32de-a2e7-02fa5f3278cb",
                                                "text": "I gazed at her arm. Where was its wonderful roundness and beauty? It was getting thin and angular."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
