                "senses": [
                    {
                        "sense_id": "fc97d2fd-eb94-3ce6-93f5-2ef9ff4fc2bf",
                        "entry_id": "5201a039-3b4d-3e0e-afd2-222f4d6a40eb",
                        "glosses": [
                            "door sterke amoureuze gevoelens bevangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b74016d-3488-4f4d-b039-898e344dd674",
                                "sense_id": "fc97d2fd-eb94-3ce6-93f5-2ef9ff4fc2bf",
                                "text": "De verliefde jongen moest blozen toen hij het meisje van zijn dromen zag."
                            },
                            {
                                "example_id": "6ebb90b6-f06e-4590-b080-c93599bc7f1b",
                                "sense_id": "fc97d2fd-eb94-3ce6-93f5-2ef9ff4fc2bf",
                                "text": "Niet dat ik daar nou zo op zat te wachten, ik houd helemaal niet van het podium pakken, maar toen het me werd aangeboden was er iets in mijn buik opgefladderd, zoals er dingen in je lijf kriebelen wanneer je verliefd bent, of - wanneer de lente door je dakraam fluit."
                            },
                            {
                                "example_id": "3fd78343-fca1-4553-960b-48f5cf763c84",
                                "sense_id": "fc97d2fd-eb94-3ce6-93f5-2ef9ff4fc2bf",
                                "text": "Rookt sigaretten door een pijpje en is verliefd op een schaker, die zijn gereformeerde achtergrond niet kan verloochenen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a346e0d0-6ca6-4311-af32-c1cc73043966",
                        "source_entry_id": "5201a039-3b4d-3e0e-afd2-222f4d6a40eb",
                        "source_sense_id": "fc97d2fd-eb94-3ce6-93f5-2ef9ff4fc2bf",
