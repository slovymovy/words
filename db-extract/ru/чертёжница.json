                        "examples": [
                            {
                                "example_id": "6e799a2d-0f67-4fc1-8c99-1f366d657d62",
                                "sense_id": "a3589913-9dbe-33fb-bd46-58e6791c9cff",
                                "text": "Пожилая чертежница застыла с рейсфедером в руке, испуганно полуоткрыв рот."
                            },
                            {
                                "example_id": "d496d8e2-1b55-4b34-bd62-141997e05148",
                                "sense_id": "a3589913-9dbe-33fb-bd46-58e6791c9cff",
                                "text": "По утрам та чертежница занималась в Чертежно-конструкторском институте, а после, не заходя домой, сразу поспевала на работу; ночью же она старалась меньше спать, чтобы больше видеть своего ребенка."
                            }
                        ]
                    }
