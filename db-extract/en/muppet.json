                                "target_senses": [
                                    {
                                        "sense_id": "3a21d50d-ed3b-3d9f-8b64-a7287739b386",
                                        "entry_id": "9c756619-5cb1-3e72-b026-30d9c87ab814",
                                        "glosses": [
                                            "hloupá, nešikovná osoba"
                                        ],
                                        "tags": [
                                            "colloquially",
                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8550d139-6e9d-43a3-bdee-d70aff42579e",
                                                "sense_id": "3a21d50d-ed3b-3d9f-8b64-a7287739b386",
                                                "text": "Cítím se jak pako z největších pak, když mi ho vlak odnáší,…"
                                            },
                                            {
                                                "example_id": "7db159f3-3c23-456a-9ddd-4fdd34d140d0",
                                                "sense_id": "3a21d50d-ed3b-3d9f-8b64-a7287739b386",
                                                "text": "Tom a Jerry zas, bavit přišli nás, křičí jeden na druhého „ty jsi pako”, škádlí se a rvou však jenom jako."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63fe94c0-55b3-38c3-b809-3e8aedc52d00",
                                        "entry_id": "9c756619-5cb1-3e72-b026-30d9c87ab814",
                                        "glosses": [
                                            "duševně méněcenný vězeň"
                                        ],
