                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "where",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2252db86-3712-3f50-9a42-204af7751f46",
                                        "entry_id": "2d015cf9-b7f6-3b75-b985-eeaceb358492",
                                        "glosses": [
                                            "In, at or to what place."
                                        ],
                                        "tags": [
                                            "interrogative",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5f7e58f-5b2b-40c2-af96-65c65e7482d6",
                                                "sense_id": "2252db86-3712-3f50-9a42-204af7751f46",
                                                "text": "Where are you?"
                                            },
                                            {
                                                "example_id": "d498b667-bd88-4412-b585-6b7ee2ccef1f",
                                                "sense_id": "2252db86-3712-3f50-9a42-204af7751f46",
                                                "text": "He asked where I grew up."
                                            },
                                            {
                                                "example_id": "0f3293f0-3dd5-409e-9baa-6866e027b9d0",
                                                "sense_id": "2252db86-3712-3f50-9a42-204af7751f46",
                                                "text": "Where are you going?"
                                            },
                                            {
                                                "example_id": "804b89ea-ef6b-4984-8ea2-70703d7fad89",
                                                "sense_id": "2252db86-3712-3f50-9a42-204af7751f46",
                                                "text": "Where you going?"
                                            },
                                            {
                                                "example_id": "e2303776-beb8-4185-b0b9-0c4e63162950",
                                                "sense_id": "2252db86-3712-3f50-9a42-204af7751f46",
                                                "text": "I've forgotten where I was in this book, but it was probably around chapter four."
                                            },
                                            {
                                                "example_id": "bc24c4b7-f803-4772-833b-8bd22e45ed68",
                                                "sense_id": "2252db86-3712-3f50-9a42-204af7751f46",
                                                "text": "I hardly knew where I was going."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c63f119-02cf-38db-aa7c-7eba50dbe624",
                                        "entry_id": "2d015cf9-b7f6-3b75-b985-eeaceb358492",
                                        "glosses": [
                                            "In what situation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af1aa3d8-4ba4-447f-b617-6fc699791061",
                                                "sense_id": "3c63f119-02cf-38db-aa7c-7eba50dbe624",
                                                "text": "Where would we be without our parents?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c99aeb1-ee1c-3bfe-8290-b7cd7c30f8bb",
                                        "entry_id": "2d015cf9-b7f6-3b75-b985-eeaceb358492",
                                        "glosses": [
                                            "In, at or to the place (that) or a place (that)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32b5570b-ff9a-443b-bff7-15b06700ac56",
                                                "sense_id": "9c99aeb1-ee1c-3bfe-8290-b7cd7c30f8bb",
                                                "text": "Stay where you are."
                                            },
                                            {
                                                "example_id": "6ab14874-b0af-461b-9539-fdbdec7d6b55",
                                                "sense_id": "9c99aeb1-ee1c-3bfe-8290-b7cd7c30f8bb",
                                                "text": "Go back where you came from."
                                            },
                                            {
                                                "example_id": "68b9521e-79fb-48a1-9a7b-560fe2f3c263",
                                                "sense_id": "9c99aeb1-ee1c-3bfe-8290-b7cd7c30f8bb",
                                                "text": "Let's go where it's warmer."
                                            },
                                            {
                                                "example_id": "42a9334f-2a56-4ae1-9a7c-4c4536a6a9a0",
                                                "sense_id": "9c99aeb1-ee1c-3bfe-8290-b7cd7c30f8bb",
                                                "text": "Energy has seldom been found where we need it when we want it. Ancient nomads, wishing to ward off the evening chill and enjoy a meal around a campfire, had to collect wood and then spend time and effort coaxing the heat of friction out from between sticks to kindle a flame. With more settled people, animals were harnessed to capstans or caged in treadmills to turn grist into meal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b16c960b-e893-397a-a17c-9c289ac02360",
                                        "entry_id": "2d015cf9-b7f6-3b75-b985-eeaceb358492",
                                        "glosses": [
                                            "In, at or to any place (that); wherever; anywhere."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa2a53be-736e-4f89-840e-f14cac031b5d",
                                                "sense_id": "b16c960b-e893-397a-a17c-9c289ac02360",
                                                "text": "Please sit where you like."
                                            },
                                            {
                                                "example_id": "2984931f-6c90-422c-99db-c8067e6a51f1",
                                                "sense_id": "b16c960b-e893-397a-a17c-9c289ac02360",
                                                "text": "Their job is to go where they are called."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fd64166-62b2-3c5a-9f45-b3e0719854e6",
                                        "entry_id": "2d015cf9-b7f6-3b75-b985-eeaceb358492",
                                        "glosses": [
                                            "In, at or to which."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "relative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0408b74-08e5-4940-8caa-3ef2dff792de",
                                                "sense_id": "0fd64166-62b2-3c5a-9f45-b3e0719854e6",
                                                "text": "This is the place where we first met."
                                            },
                                            {
                                                "example_id": "fd17bec2-88c9-46df-9145-e21a76c6a039",
                                                "sense_id": "0fd64166-62b2-3c5a-9f45-b3e0719854e6",
                                                "text": "He is looking for a house where he can have a complete office."
                                            },
                                            {
                                                "example_id": "3e065ce1-7e7c-4767-9ced-921cd480d96b",
                                                "sense_id": "0fd64166-62b2-3c5a-9f45-b3e0719854e6",
                                                "text": "That's the place where we went on holiday."
                                            },
                                            {
                                                "example_id": "a00c08c0-9ed0-4050-9a4b-28d72d7ccc7d",
                                                "sense_id": "0fd64166-62b2-3c5a-9f45-b3e0719854e6",
                                                "text": "Here's a picture of York, where I was born."
                                            },
                                            {
                                                "example_id": "b9a83aaa-2d8b-4cb7-a7e1-6b70f6752e3a",
                                                "sense_id": "0fd64166-62b2-3c5a-9f45-b3e0719854e6",
                                                "text": "Show me an example where it happened that way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dc7caf8-ef05-3db4-a7ea-084391bf1999",
                                        "entry_id": "2d015cf9-b7f6-3b75-b985-eeaceb358492",
                                        "glosses": [
                                            "The place in, at or to which."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a588d91a-f97b-489f-9bd8-a50ce0d6e5ef",
                                                "sense_id": "1dc7caf8-ef05-3db4-a7ea-084391bf1999",
                                                "text": "He lives within five miles of where he was born."
                                            },
                                            {
                                                "example_id": "df49ce8c-3dcd-4e26-8698-9b57d604eebf",
                                                "sense_id": "1dc7caf8-ef05-3db4-a7ea-084391bf1999",
                                                "text": "This is a photo of where I went on holiday."
                                            },
                                            {
                                                "example_id": "2338ba92-153c-4b2a-9182-c253994c459e",
                                                "sense_id": "1dc7caf8-ef05-3db4-a7ea-084391bf1999",
                                                "text": "Through the open front door ran Jessamy, down the steps to where Kitto was sitting at the bottom with the pram beside him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dc75d7d-1351-3e0c-b111-628db9125b3f",
                                        "entry_id": "2d015cf9-b7f6-3b75-b985-eeaceb358492",
                                        "glosses": [
                                            "A situation or case in which."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1144a95-8955-4db6-8156-5d75f23a57cc",
                                                "sense_id": "9dc75d7d-1351-3e0c-b111-628db9125b3f",
                                                "text": "A function is where two variables are related."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd1f0b4f-e169-39e3-822d-fafbafd09f3d",
                                        "entry_id": "2d015cf9-b7f6-3b75-b985-eeaceb358492",
                                        "glosses": [
                                            "In a/the situation, position, case, etc. in which."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6326f1a-7d59-4bac-a42e-8eb03d5d5a16",
                                                "sense_id": "dd1f0b4f-e169-39e3-822d-fafbafd09f3d",
                                                "text": "You cannot be too careful where explosives are involved."
                                            },
                                            {
                                                "example_id": "abd5a76d-e0cd-4748-ba96-4f0933de5ce3",
                                                "sense_id": "dd1f0b4f-e169-39e3-822d-fafbafd09f3d",
                                                "text": "Where no provision under this Act is applicable, the case shall be decided in accordance with the customary practices."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "where",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32c117ed-546b-3abf-9eaf-2788f395de39",
                                        "entry_id": "fc6762e3-8298-3658-9d6e-01937a48cdfd",
                                        "glosses": [
                                            "While on the contrary; although; whereas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "468b5fd0-9bc7-480e-9da4-fa026cb70eef",
                                                "sense_id": "32c117ed-546b-3abf-9eaf-2788f395de39",
                                                "text": "And flight and die is death destroying death; Where fearing dying pays death servile breath."
                                            },
                                            {
                                                "example_id": "cbf33286-d33e-4e7a-a69b-a874a4fa8d3a",
                                                "sense_id": "32c117ed-546b-3abf-9eaf-2788f395de39",
                                                "text": "July 18 2012, Scott Tobias, AV Club The Dark Knight Riseshttp://www.avclub.com/articles/the-dark-knight-rises-review-batman,82624/\nWhere the Joker preys on our fears of random, irrational acts of terror, Bane has an all-consuming, dictatorial agenda that’s more stable and permanent, a New World Order that’s been planned out with the precision of a military coup."
                                            },
                                            {
                                                "example_id": "9c7398f4-cf53-460d-98ed-362123d194d4",
                                                "sense_id": "32c117ed-546b-3abf-9eaf-2788f395de39",
                                                "text": "Now we are liberal with our innermost secrets, spraying them into the public ether with a generosity our forebears could not have imagined. Where we once sent love letters in a sealed envelope, or stuck photographs of our children in a family album, now such private material is despatched to servers and clouds operated by people we don't know and will never meet."
                                            },
                                            {
                                                "example_id": "3c9d35b8-2e0b-4529-bf1a-fdcbadcacf2d",
                                                "sense_id": "32c117ed-546b-3abf-9eaf-2788f395de39",
                                                "text": "Where Susy has trouble coloring inside the lines, Johnny has already mastered shading."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04faf797-54da-332e-8b98-54726e73606d",
                                        "entry_id": "fc6762e3-8298-3658-9d6e-01937a48cdfd",
                                        "glosses": [
                                            "That."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf2fb443-03dd-44f6-87f8-b88557915abe",
                                                "sense_id": "04faf797-54da-332e-8b98-54726e73606d",
                                                "text": "I read where they caught the guy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "where",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4be00458-bfc0-3c7d-b31b-7d3cae85b533",
                                        "entry_id": "3fb93e6f-033c-376a-8570-f1547c1e0c5e",
                                        "glosses": [
                                            "What place."
                                        ],
                                        "tags": [
                                            "interrogative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6f384f4-8576-4e2c-b3d0-3817eb0a3878",
                                                "sense_id": "4be00458-bfc0-3c7d-b31b-7d3cae85b533",
                                                "text": "Do you know where you came from?"
                                            },
                                            {
                                                "example_id": "c5543b72-44b7-4e13-9d19-98e0c545bc75",
                                                "sense_id": "4be00458-bfc0-3c7d-b31b-7d3cae85b533",
                                                "text": "Where did you come from?"
                                            },
                                            {
                                                "example_id": "143b6dfc-3c06-4d96-a175-e18b4fb5e717",
                                                "sense_id": "4be00458-bfc0-3c7d-b31b-7d3cae85b533",
                                                "text": "Where are you at?"
                                            },
                                            {
                                                "example_id": "2fe8b213-5a77-46a7-8fd0-5d4791251b7c",
                                                "sense_id": "4be00458-bfc0-3c7d-b31b-7d3cae85b533",
                                                "text": "Where are you off to?"
                                            },
                                            {
                                                "example_id": "b7f72220-de14-4c78-b223-b3d00d8bf50a",
                                                "sense_id": "4be00458-bfc0-3c7d-b31b-7d3cae85b533",
                                                "text": "Where you off to?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "where",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b927812f-2b33-3a3d-bc6e-7342a4ca16af",
                                        "entry_id": "6e411349-ad81-37fa-9467-9a6a0e5ed9a6",
                                        "glosses": [
                                            "The place in which something happens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d855e90-be8f-40fe-bd43-f96a214334b1",
                                                "sense_id": "b927812f-2b33-3a3d-bc6e-7342a4ca16af",
                                                "text": "A good article will cover the who, the what, the when, the where, the why and the how."
                                            },
                                            {
                                                "example_id": "cd8c931e-7359-40ef-b1ca-3c86dc8adfc4",
                                                "sense_id": "b927812f-2b33-3a3d-bc6e-7342a4ca16af",
