    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "df47419c-853b-3a56-aa53-5be6a3a23c49",
                    "sense_definition": "Einsatzkräfte oder Helfer bei Gefahr oder einem Notfall herbeirufen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hilfe_rufen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als mein Nachbar den dichten Rauch bemerkte, <w>alarmierte</w> er sofort die Feuerwehr."
                        },
                        {
                            "text": "Ein aufmerksamer Zeuge hat nach dem Unfall rechtzeitig den Rettungsdienst <w>alarmiert</w>."
                        }
                    ],
                    "common_phrases": [
                        "die Feuerwehr alarmieren",
                        "die Polizei alarmieren"
                    ]
                },
                {
                    "sense_id": "888be0c8-8093-302b-86d2-d1a181c62ee2",
                    "sense_definition": "jemanden auf eine drohende Gefahr aufmerksam machen oder warnen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "warnen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der laute Rauchmelder <w>alarmierte</w> die schlafenden Bewohner rechtzeitig vor den Flammen."
                        },
                        {
                            "text": "Ein verdächtiges Geräusch im Garten <w>alarmierte</w> den Wachhund mitten in der Nacht."
                        }
                    ],
                    "synonyms": [
                        "warnen"
                    ]
                },
                {
                    "sense_id": "ed86d9d9-2a15-3a1d-88ac-778a577f9470",
                    "sense_definition": "jemanden in Unruhe oder Besorgnis versetzen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beunruhigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die neuen Berichte über steigende Infektionszahlen <w>alarmieren</w> die Experten sehr."
                        },
                        {
                            "text": "Die kritischen Werte der Untersuchung <w>alarmierten</w> die behandelnden Ärzte zutiefst."
                        }
                    ],
                    "synonyms": [
                        "beunruhigen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "75207ec5-06d2-33b6-bd4d-df2a3dcde599",
                    "sense_definition": "das Herbeirufen von Hilfe oder Warnen; substantivierte Form von <w>alarmieren</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das rechtzeitige <w>Alarmieren</w> der Einsatzkräfte verhinderte eine noch größere Katastrophe."
                        },
                        {
                            "text": "Beim <w>Alarmieren</w> der Feuerwehr müssen die wichtigsten Fragen präzise beantwortet werden."
                        }
                    ]
                }
            ]
        }
    ]
