                "senses": [
                    {
                        "sense_id": "a417d1da-1931-339c-9c99-7047a45da8cb",
                        "entry_id": "81b250d2-7ff0-30ef-97cc-33399b6a87f8",
                        "glosses": [
                            "verticale wind van boven naar beneden die ontstaat als koude lucht naar beneden gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cba89b6-a17e-431f-99ca-adf8026bf7e7",
                                "sense_id": "a417d1da-1931-339c-9c99-7047a45da8cb",
                                "text": "'Ineens zakten we. Alsof we in een luchtzak waren geraakt', zegt De Knecht. 'De piloot gaf vol gas. We hoorden de motoren op volle kracht draaien. Vervolgens begon het hele toestel te trillen. De staart van het vliegtuig brak af nog voordat we de grond raakten. En toen volgde die ongelooflijk harde klap. Het werd doodstil en donker. Er was geen paniek. Na een paar seconden begon het gegil.'"
                            },
                            {
                                "example_id": "f5e8f553-cc62-43d9-833e-eca42a1854be",
                                "sense_id": "a417d1da-1931-339c-9c99-7047a45da8cb",
                                "text": "Het vliegtuig schudt door een luchtzak. 12a buigt zich naar de stewardess die voor de turbulentie is teruggekeerd naar haar stoel. Die met de mooie ogen. „Kun je op het vliegveld van Istanbul een boekje krijgen, met Turkse woordjes?” De stewardess heeft geen idee wat 12a zojuist gevraagd heeft, maar knikt streng dat hij zijn riem even moet gespen. 12a zakt gerustgesteld terug in zijn stoel. Dat gaat helemaal goed komen, daar in het Babylonië op het noordelijk halfrond. Nog een stomp in de zij. „Boer soek Rus”, lacht hij. Ik lach terug. Ja, daar zouden ze een televisieprogramma over kunnen maken."
                            }
                        ]
                    },
                    {
                        "sense_id": "20e488eb-e6fa-3e88-98c3-b24f3f5d14e7",
                        "entry_id": "81b250d2-7ff0-30ef-97cc-33399b6a87f8",
                        "glosses": [
                            "longzak bij vogels"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3585eefe-8061-348e-8ab0-5d5e3e718d3e",
                        "entry_id": "81b250d2-7ff0-30ef-97cc-33399b6a87f8",
                        "glosses": [
                            "luchtbel in een waterleiding die door doorstroming belemmert"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0291e608-68ae-3b77-9f14-7566c2deb51e",
                        "entry_id": "81b250d2-7ff0-30ef-97cc-33399b6a87f8",
                        "glosses": [
                            "systeem in voertuigen waar bij een botsing snel een zak wordt opgeblazen ter bescherming van de inzittenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "497a013d-38e9-49ab-a8f6-e351cb1b3429",
                                "sense_id": "0291e608-68ae-3b77-9f14-7566c2deb51e",
                                "text": "De luchtzak is inmiddels niet meer weg te denken uit moderne auto’s. Je hebt nu vaak een airbag voor je hoofd, voor je knie en zelfs voor je koters achterin."
                            }
                        ]
                    }
