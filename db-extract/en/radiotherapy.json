                    },
                    {
                        "translation_id": "42fce8e2-4a5a-4f69-b520-34f31cc6eba8",
                        "source_entry_id": "2520b3fd-f1f3-3e4d-8182-bce99343fb62",
                        "source_sense_id": "f6a03979-06fb-30e4-83f6-99e84a385776",
