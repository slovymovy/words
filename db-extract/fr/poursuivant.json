                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verfolger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5976062e-50c4-35eb-ac55-980838941c73",
                                        "entry_id": "c13d866f-992b-37dc-8549-de7a02821c10",
                                        "glosses": [
                                            "jemand, der jemanden oder etwas verfolgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aae332f-23e0-4027-8030-45cc4db23bd4",
                                                "sense_id": "5976062e-50c4-35eb-ac55-980838941c73",
                                                "text": "Er konnte seine Verfolger nicht sehen, aber ihre Schritte im Gebüsch hören."
                                            },
                                            {
                                                "example_id": "5629a120-3147-4b46-9732-dd580c0b81b8",
                                                "sense_id": "5976062e-50c4-35eb-ac55-980838941c73",
                                                "text": "„Aber so rasch entging er dem Verfolger nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e36c490a-5154-32a5-864e-c1c55d2318ec",
                                        "entry_id": "c13d866f-992b-37dc-8549-de7a02821c10",
                                        "glosses": [
                                            "um die gleiche Position kämpfender Konkurrent, der unter beziehungsweise hinter einem liegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
