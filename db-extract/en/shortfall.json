                "senses": [
                    {
                        "sense_id": "945da834-64d0-3e93-ba4a-682c7be132ef",
                        "entry_id": "6aa25817-2554-3f18-8516-92ec7dfc7736",
                        "glosses": [
                            "An instance of falling short, of not meeting a quota, an obligation, or more generally any expected target."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd1aa231-d309-46fc-81ca-cacd73369c13",
                                "sense_id": "945da834-64d0-3e93-ba4a-682c7be132ef",
                                "text": "Due to a shortfall in revenue, we will have to make some cuts."
                            }
                        ]
                    },
                    {
                        "sense_id": "b91570a9-a3e6-3a9f-ba59-1046816fc474",
                        "entry_id": "6aa25817-2554-3f18-8516-92ec7dfc7736",
                        "glosses": [
                            "The amount by which such a quota, obligation, etc., was missed."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22fc6ef1-1852-4056-9eff-6f8eed8d601d",
                        "source_entry_id": "6aa25817-2554-3f18-8516-92ec7dfc7736",
                        "source_sense_description": "instance of not meeting a quota or of having an insufficient amount",
                        "target_lang_word": "insuffisance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insuffisance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fbda3510-dbd9-3943-a005-59a6bbcf1c4f",
                                        "entry_id": "393b815d-0e7e-3552-9d7c-47b795f9de38",
                                        "glosses": [
                                            "État de ce qui est insuffisant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faa39af9-0a6c-4842-ac6d-d34845290d18",
                                                "sense_id": "fbda3510-dbd9-3943-a005-59a6bbcf1c4f",
                                                "text": "J'ai parlé tout à l'heure de l’insuffisance du personnel à l’infirmerie de Chelsa. Que dire à ce point de vue de l’infirmerie de Gray's Inn? Pour ces 500 malades, il n'y a qu'un médecin."
                                            },
                                            {
                                                "example_id": "781f2416-3f82-4d99-9110-3eac431762b0",
                                                "sense_id": "fbda3510-dbd9-3943-a005-59a6bbcf1c4f",
                                                "text": "L’insuffisance du numéraire circulant en France étant avérée, Colbert avait résolu de protéger à outrance l'industrie du royaume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2c2db3a-4d2e-368f-92f7-d7cf0b4871db",
                                        "entry_id": "393b815d-0e7e-3552-9d7c-47b795f9de38",
                                        "glosses": [
                                            "Infériorité, inaptitude, de certaines personnes pour certaines choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "261965b6-1a9b-4f69-a06c-828703410377",
                                                "sense_id": "e2c2db3a-4d2e-368f-92f7-d7cf0b4871db",
                                                "text": "L’insuffisance de ses raisons, de ses moyens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebcb2be0-b6e0-3b36-a91a-01e2db452d71",
                                        "entry_id": "393b815d-0e7e-3552-9d7c-47b795f9de38",
                                        "glosses": [
                                            "Dysfonctionnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd4cb586-0b6c-4996-9edc-1bb0c784ded4",
                                                "sense_id": "ebcb2be0-b6e0-3b36-a91a-01e2db452d71",
                                                "text": "Chef-d'œuvre de suffisance en même temps que d’insuffisance administrative, le plan 17, en un mot, recélait autant d’impéritie, dans la préparation, qu'en devait déceler le \"plan d’opérations\" dans sa conduite."
                                            },
                                            {
                                                "example_id": "65ba5480-55f2-49d0-bcce-cac54ed2ca03",
                                                "sense_id": "ebcb2be0-b6e0-3b36-a91a-01e2db452d71",
                                                "text": "— Au point de vue pathogénèse, on doit considérer que dans les cœliaquies, il y a insuffisance primitive des fonctions du grêle. Mais un facteur constitutionnel est incontestable."
                                            },
                                            {
                                                "example_id": "49da67de-bde0-44fa-9855-4da745c2cd5e",
                                                "sense_id": "ebcb2be0-b6e0-3b36-a91a-01e2db452d71",
                                                "text": "Néanmoins, l’annuloplastie restrictive s'accompagne fréquemment d'une récurrence de l’insuffisance mitrale fonctionnelle ou d'une altération de la capacité fonctionnelle […]."
                                            },
                                            {
                                                "example_id": "ef1b4daa-e2df-4ec8-9c08-e29cbdd7be1f",
                                                "sense_id": "ebcb2be0-b6e0-3b36-a91a-01e2db452d71",
                                                "text": "Dans son jugement, Philip Barlow a établi les causes de la mort comme étant en premier une insuffisance respiratoire aiguë, en deuxième l'asthme dont souffrait la fillette et en troisième l'exposition à la pollution, qui a à la fois déclenché et aggravé sa maladie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae9437f1-ede4-4324-bb0d-813dd2151fbb",
                        "source_entry_id": "6aa25817-2554-3f18-8516-92ec7dfc7736",
                        "source_sense_description": "instance of not meeting a quota or of having an insufficient amount",
                        "target_lang_word": "manquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "657c9cc4-4afc-3bdb-bec9-4eb0cff65265",
                                        "entry_id": "9228fdd2-bc5d-30b5-ae1c-13b35b3ee3ae",
                                        "glosses": [
                                            "Action de manquer à."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa6726be-60e3-4ff0-9d3e-b76a0f11629f",
                                                "sense_id": "657c9cc4-4afc-3bdb-bec9-4eb0cff65265",
                                                "text": "Manquement de parole."
                                            },
                                            {
                                                "example_id": "b843bee3-9ee9-41c2-aab1-bfda721e6aab",
                                                "sense_id": "657c9cc4-4afc-3bdb-bec9-4eb0cff65265",
                                                "text": "Il n’y a personne qui ne soit sujet à quelque manquement."
                                            },
                                            {
                                                "example_id": "d9a52284-df4b-44b1-959d-a60b6ea47123",
                                                "sense_id": "657c9cc4-4afc-3bdb-bec9-4eb0cff65265",
                                                "text": "— Mon pauvre enfant ! Ta mère, tes maîtres, moi-même, nous t’avons assez mis en garde contre tous les manquements à la sainte vertu…"
                                            },
                                            {
                                                "example_id": "5d988f4d-5a01-4741-aff4-f54166a07276",
                                                "sense_id": "657c9cc4-4afc-3bdb-bec9-4eb0cff65265",
                                                "text": "Considérant […] que la diffusion de cette séquence, sans que soit fourni aux téléspectateurs aucun élément de contexte ni aucune information sur l'origine des images, caractérise un manquement aux stipulations précitées de l'article 15 de la convention du 29 mai 2000 ;"
                                            },
                                            {
                                                "example_id": "51fa7d16-47b7-4418-9c72-0f004e6ef8df",
                                                "sense_id": "657c9cc4-4afc-3bdb-bec9-4eb0cff65265",
                                                "text": "Dans cette affaire, le Conseil d’État raisonne en deux temps : tout d’abord, il constate que les difficultés rencontrées dans l’exécution du marché trouvent leur origine dans les fautes de la maîtrise d’œuvre et de l’entreprise chargée de la réalisation de la plateforme sur laquelle devait être édifié un nouveau sas d’urgence pour en tirer immédiatement la conséquence que dans ces conditions le maître de l’ouvrage ne pouvait être tenu pour responsable des préjudices dont les sociétés requérantes lui demandaient réparation du fait de l’allongement de la durée d’exécution du marché de travaux dès lors que ces préjudices résultent de manquements d’un autre entrepreneur ou de la maîtrise d’œuvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23fd3f9d-fa48-3612-9371-c6cd0c5a1e75",
                                        "entry_id": "9228fdd2-bc5d-30b5-ae1c-13b35b3ee3ae",
                                        "glosses": [
                                            "Manque, action de manquer de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c75eeccf-42a1-48bc-a3bd-c2e4dd998ffc",
                                                "sense_id": "23fd3f9d-fa48-3612-9371-c6cd0c5a1e75",
                                                "text": "Manquement de foi."
                                            },
                                            {
                                                "example_id": "e80f4bfe-5119-45f7-9fbb-20e4918674ef",
                                                "sense_id": "23fd3f9d-fa48-3612-9371-c6cd0c5a1e75",
                                                "text": "Manquement de respect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c53c6a5e-538d-3447-955f-3522c917bee2",
                                        "entry_id": "9228fdd2-bc5d-30b5-ae1c-13b35b3ee3ae",
                                        "glosses": [
                                            "Faute d’omission."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3310a9f-fd02-46b9-8b17-6e77ed36b078",
                                                "sense_id": "c53c6a5e-538d-3447-955f-3522c917bee2",
                                                "text": "Le soldat des guerres de la Liberté attachait une importance presque supersti­tieuse à l’accomplissement des moindres consignes. De là résulte qu'il n'éprouvait aucune pitié pour les généraux ou les fonctionnaires qu'il voyait guillotiner après quelque défaite, sous l'inculpation de manquement à leur devoir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
