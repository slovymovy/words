                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drop off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "798b6069-8daf-3b2e-8106-ed4722922fd7",
                                        "entry_id": "8e5f69b3-06e1-3c07-b22d-3a961d5b3f1a",
                                        "glosses": [
                                            "To fall asleep."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c592a283-9dab-4071-939b-f65c0d21babb",
                                                "sense_id": "798b6069-8daf-3b2e-8106-ed4722922fd7",
                                                "text": "After two glasses of whiskey, Tom soon dropped off in front of the television."
                                            },
                                            {
                                                "example_id": "e63b0b8d-eee8-4441-b791-d1b0a26f0f30",
                                                "sense_id": "798b6069-8daf-3b2e-8106-ed4722922fd7",
                                                "text": "And when the Boy dropped off to sleep, the Rabbit would snuggle down close under his little warm chin and dream, with the Boy's hands clasped close round him all night long."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1af7a41b-5926-3d21-ab32-b195de906419",
                                        "entry_id": "8e5f69b3-06e1-3c07-b22d-3a961d5b3f1a",
                                        "glosses": [
                                            "To deliver; to deposit or leave; to allow passengers to alight."
                                        ],
                                        "tags": [
                                            "US",
                                            "especially",
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df1f8abb-9873-4293-9244-74b365682191",
                                                "sense_id": "1af7a41b-5926-3d21-ab32-b195de906419",
                                                "text": "Can you drop the kids off at school?"
                                            },
                                            {
                                                "example_id": "b6245717-dc7e-43fa-9c35-e6acbfd9ac20",
                                                "sense_id": "1af7a41b-5926-3d21-ab32-b195de906419",
                                                "text": "I'll drop off your books when I see you tonight."
                                            },
                                            {
                                                "example_id": "14c3674d-6d25-43a0-8a35-0ab45f24e774",
                                                "sense_id": "1af7a41b-5926-3d21-ab32-b195de906419",
                                                "text": "After dropping off travellers at Foregate Street, my train terminates at Shrub Hill - a station which boasts one of the best selection [sic] of semaphore signals left in the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6183cc29-2909-3d71-88e8-ed961465b304",
                                        "entry_id": "8e5f69b3-06e1-3c07-b22d-3a961d5b3f1a",
                                        "glosses": [
                                            "To fall off:",
                                            "To drop from, fall from."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f5629db-87d8-4432-83b5-e492b2bfe486",
                                                "sense_id": "6183cc29-2909-3d71-88e8-ed961465b304",
                                                "text": "The leaves were slowly dropping off the tree."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7aa0a7e9-baaf-32ad-a138-6b226c750b6f",
                                        "entry_id": "8e5f69b3-06e1-3c07-b22d-3a961d5b3f1a",
                                        "glosses": [
                                            "To fall off:",
                                            "To drop, fall."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b33edf6-5a63-47fb-83f7-7b6b52c48444",
                                                "sense_id": "7aa0a7e9-baaf-32ad-a138-6b226c750b6f",
                                                "text": "The leaves hung on until the end of November, then dropped off quickly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be6f36cd-e63c-34c0-b5ad-0d6c52bcbe0a",
                                        "entry_id": "8e5f69b3-06e1-3c07-b22d-3a961d5b3f1a",
                                        "glosses": [
                                            "To end a connection with a telephone queue, either by hanging up or after being served or processed."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12bb1f42-f3c9-4038-82ce-0411e2b2d4cc",
                                                "sense_id": "be6f36cd-e63c-34c0-b5ad-0d6c52bcbe0a",
                                                "text": "As soon as a caller drops off, we'll have an open line and maybe you can reach us then."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d87f036a-0c08-3049-b430-2c6124d4e8b8",
                                        "entry_id": "8e5f69b3-06e1-3c07-b22d-3a961d5b3f1a",
                                        "glosses": [
                                            "To lessen or reduce."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0b4720c-43a9-455a-9a5b-d24d4b7ca1ab",
                                                "sense_id": "d87f036a-0c08-3049-b430-2c6124d4e8b8",
                                                "text": "Near-synonyms: taper off, dwindle"
                                            },
                                            {
                                                "example_id": "60fd1c80-375b-4338-a90f-760c3dedb6d8",
                                                "sense_id": "d87f036a-0c08-3049-b430-2c6124d4e8b8",
                                                "text": "Sales have dropped off in recent months."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "806e58d8-d47d-319c-b645-88136293a183",
                                        "entry_id": "8e5f69b3-06e1-3c07-b22d-3a961d5b3f1a",
                                        "glosses": [
                                            "To die."
                                        ],
