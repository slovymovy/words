                                        "sense_id": "d6b3189b-b065-3f79-a675-5a6fa585ae1f",
                                        "entry_id": "8df67198-5657-3ba2-9e0c-416e79ca7bbc",
                                        "glosses": [
                                            "A cheerful attitude; happiness; a good, happy, or positive mood."
