                    }
                ],
                "senses": [
                    {
                        "sense_id": "cbe26a78-0f8b-3362-800a-893dece4d5ac",
                        "entry_id": "16535ca4-7a5e-3b7d-8eb3-8b5e3f3b02bc",
                        "glosses": [
                            "An n-fold self-composition of a function."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee268d1e-98a9-4b2c-aed2-8ad92a777b04",
                                "sense_id": "cbe26a78-0f8b-3362-800a-893dece4d5ac",
                                "text": "An important example of such a semigroup in infinite dimensional Hilbert space is the weak operator closed monothetic semigroup generated by a linear operator with equibounded iterates."
                            }
                        ]
                    },
                    {
                        "sense_id": "9abd5277-2568-3971-8dc7-0e870bf82082",
                        "entry_id": "16535ca4-7a5e-3b7d-8eb3-8b5e3f3b02bc",
                        "glosses": [
                            "The image of a certain value under such a function."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "394b06c9-0fbe-49ba-af08-e915518503e0",
                                "sense_id": "9abd5277-2568-3971-8dc7-0e870bf82082",
                                "text": "f²(x₀) is the second iterate of x₀ under f."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
