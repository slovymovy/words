                    {
                        "sense_id": "52256533-d63f-354f-9a5f-c554e7762620",
                        "entry_id": "60e25705-7840-3458-a0b9-29b12bca5014",
                        "glosses": [
                            "Qualifiant un assemblage dont les composants rentrent en combustion immédiate lorsqu'ils sont mélangés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa9c8e7a-1a6f-46de-8281-ca5b67c474cd",
                                "sense_id": "52256533-d63f-354f-9a5f-c554e7762620",
                                "text": "Il peut être provoqué par différents moyens : — Soit les propergols sont hypergoliques (ils s'enflamment au contact l'un de l'autre); — Soit on utilise une réaction hypergolique auxiliaire."
                            },
                            {
                                "example_id": "f80bc437-3e06-4bae-94c6-48dc8e0a575e",
                                "sense_id": "52256533-d63f-354f-9a5f-c554e7762620",
                                "text": "Les mélanges hypergoliques sont donc plus délicats à manipuler mais ils évitent d'avoir recours à un système d'allumage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
