        "fr-extract.jsonl": [
            {
                "entry_id": "9a0e227f-256c-3cbc-8c98-5c130c0554a3",
                "word": "agiotage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6dd3ef1a-c8e1-4c49-8a53-f221aa26d140",
                        "entry_id": "9a0e227f-256c-3cbc-8c98-5c130c0554a3",
                        "tags": [
                            "plural"
                        ],
                        "form": "agiotages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a525cb0-11d1-371d-8eff-ef88740eb5dc",
                        "entry_id": "9a0e227f-256c-3cbc-8c98-5c130c0554a3",
                        "glosses": [
                            "Spéculation sur l’agio et le change, et, par extension, sur toutes les valeurs, effets de commerce ou marchandises, mais seulement quand cette spéculation est accompagnée d’actes répréhensibles ou délictueux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c4d51c0-1956-4eed-b4f5-21f8850dbb0a",
                                "sense_id": "6a525cb0-11d1-371d-8eff-ef88740eb5dc",
                                "text": "L’agiotage et le système de Law avaient doublé sa fortune déjà immense."
                            },
                            {
                                "example_id": "9893671f-6c41-46ae-aaff-fece8ca0abfd",
                                "sense_id": "6a525cb0-11d1-371d-8eff-ef88740eb5dc",
                                "text": "— Mais vous parliez d’Haïti ? dit Monte-Cristo.\n— Oh ! Haïti, c’est autre chose ; Haïti, c’est l’écarté de l’agiotage français."
                            },
                            {
                                "example_id": "5ad7664d-f3ed-43a7-a7a7-db6b558a06f0",
                                "sense_id": "6a525cb0-11d1-371d-8eff-ef88740eb5dc",
                                "text": "L’agiotage sur les pièces d’or et d’argent."
                            },
                            {
                                "example_id": "237f9500-2cae-4c4b-a1c6-91f399fc7403",
                                "sense_id": "6a525cb0-11d1-371d-8eff-ef88740eb5dc",
                                "text": "Certaines personnes se sont enrichies par l’agiotage, d’autres se sont ruinées."
                            },
                            {
                                "example_id": "4d030b86-beb7-4b25-9925-e9c464c1ca53",
                                "sense_id": "6a525cb0-11d1-371d-8eff-ef88740eb5dc",
                                "text": "Il ne faut pas confondre spéculation et agiotage, synonymes à l’origine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "352b6c52-d026-40ca-a1c3-4b1b050649bf",
                        "source_entry_id": "9a0e227f-256c-3cbc-8c98-5c130c0554a3",
                        "source_sense_id": "6a525cb0-11d1-371d-8eff-ef88740eb5dc",
                        "target_lang_word": "Agiotage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d821001a-cea8-4d46-b82e-c13f85edd8a9",
                        "source_entry_id": "9a0e227f-256c-3cbc-8c98-5c130c0554a3",
                        "source_sense_id": "6a525cb0-11d1-371d-8eff-ef88740eb5dc",
                        "target_lang_word": "Börsenschwindel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Börsenschwindel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "987730d7-2217-3975-8380-be705dc8bcee",
                                        "entry_id": "891579f1-8b9f-3669-9b3b-72283f6ecd7e",
                                        "glosses": [
                                            "Betrug am Markt für Aktien und Wertpapiere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2a1edc5-a31d-4080-9249-80b3980fcf9b",
                                                "sense_id": "987730d7-2217-3975-8380-be705dc8bcee",
                                                "text": "Mit dem Börsenschwindel ergaunerten sie viel Geld."
                                            },
                                            {
                                                "example_id": "667f0e9d-2f6c-4afc-bf40-7a08db747d37",
                                                "sense_id": "987730d7-2217-3975-8380-be705dc8bcee",
                                                "text": "„Der aus Industriepapieren erbaute Gründerturm fiel wie ein Kartenhaus zusammen: Aktien verloren bis zu 70 Prozent ihres Kurswertes, Spekulanten waren pleite, kleine Leute, die der Börsenschwindel erfaßt hatte, kamen um ihr Erspartes.“"
                                            },
                                            {
                                                "example_id": "05e60bc3-bb8b-4efd-80f3-7f509e976add",
                                                "sense_id": "987730d7-2217-3975-8380-be705dc8bcee",
                                                "text": "„Dem Börsenschwindel vermag sie in keiner Weise zu steuern; das ist anerkannt, und es wird darum nach andern Mitteln zur Bekämpfung desselben gerufen und gesucht.“"
                                            },
                                            {
                                                "example_id": "e677095f-4934-4058-bbdb-2cf6ec2fc48e",
                                                "sense_id": "987730d7-2217-3975-8380-be705dc8bcee",
                                                "text": "„Nun aber greift der ausraubende Börsenschwindel weit hinüber über das Spiel mit dem angesammelten und mit dem in Ansammlung befindlichen Capitalvermögen der Nationen.“"
                                            },
                                            {
                                                "example_id": "7d27ad0c-fc67-4017-b366-d7e8d9b8b73c",
                                                "sense_id": "987730d7-2217-3975-8380-be705dc8bcee",
                                                "text": "„Schon 1871 gab ein Artikel über »Geldschwindel und Infallibilität« in dem Würzburger Tageblatt kund, daß der unheimliche »Börsenschwindel« durch jüdische Millionäre immer mehr zunehme.“"
                                            },
                                            {
                                                "example_id": "79fe548a-2d9d-44c3-8065-eaeef554bcd2",
                                                "sense_id": "987730d7-2217-3975-8380-be705dc8bcee",
                                                "text": "„Topmanager und mittelständische Angestellte, Unternehmer und Politiker, die wegen Delikten wie Veruntreuung, Unterschlagung, Steuerhinterziehung oder Börsenschwindel verurteilt wurden.“"
                                            },
                                            {
                                                "example_id": "f5ab7ece-84e2-4928-b846-ea5822cd1db3",
                                                "sense_id": "987730d7-2217-3975-8380-be705dc8bcee",
                                                "text": "„Auch ‚Die Korrekturen‘ sind ein gesellschaftskritischer Roman, in dem es unter anderem um Scheingeschäfte, Börsenschwindel und die pharmazeutischen ‚Korrekturen‘ deprimierter Gemüter geht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "785537ba-d670-4a9a-a091-05d598e754cd",
                        "source_entry_id": "9a0e227f-256c-3cbc-8c98-5c130c0554a3",
                        "source_sense_id": "6a525cb0-11d1-371d-8eff-ef88740eb5dc",
                        "target_lang_word": "speculation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speculation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fc1bcf4-2275-3909-adfb-9743b620acd4",
                                        "entry_id": "a8f5d949-947c-3f7a-bb01-4de0b1a052c4",
                                        "glosses": [
                                            "The faculty of sight."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76981f66-d52a-4a62-94a6-6e845c1ed79c",
                                                "sense_id": "0fc1bcf4-2275-3909-adfb-9743b620acd4",
                                                "text": "Thou hast no speculation in those eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cd44360-85cc-3cfa-a37b-e60590da719b",
                                        "entry_id": "a8f5d949-947c-3f7a-bb01-4de0b1a052c4",
                                        "glosses": [
                                            "An act of looking at something; examination, observation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61a135e2-ca73-4b8f-8873-a0cf6740384a",
                                                "sense_id": "8cd44360-85cc-3cfa-a37b-e60590da719b",
                                                "text": "[T]he expression of exultation and content on their animated faces, is one of my most delicious speculations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6fbbe36-acb7-30d8-a789-41696d9c5517",
                                        "entry_id": "a8f5d949-947c-3f7a-bb01-4de0b1a052c4",
                                        "glosses": [
                                            "The process or act of thinking or meditating on a subject."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "796d8cf1-60b4-4c4e-8ad2-7fa84b8be93a",
                                                "sense_id": "b6fbbe36-acb7-30d8-a789-41696d9c5517",
                                                "text": "Thenceforth to speculations high or deep I turned my thoughts."
                                            },
                                            {
                                                "example_id": "73e1d8a7-7f6f-4ad8-a490-4e3f61f42201",
                                                "sense_id": "b6fbbe36-acb7-30d8-a789-41696d9c5517",
                                                "text": "It ſeems, the Minds of theſe People are ſo taken up with intenſe Speculations, that they neither can ſpeak, nor attend to the Diſcourſes of others, without being rouzed by ſome external Taction upon the Organs of Speech and Hearing; for which reaſon, thoſe Perſons who are able to afford it always keep a Flapper (the Original is Climenole) in their Family, as one of their Domeſticks, nor ever walk abroad or make Viſits without him."
                                            },
                                            {
                                                "example_id": "4856ab65-6b04-44a9-b6b1-718345ba37af",
                                                "sense_id": "b6fbbe36-acb7-30d8-a789-41696d9c5517",
                                                "text": "The Duke and Duchess of Cambridge have ended months of intense speculation by announcing they are expecting their first child, but were forced to share their news earlier than hoped because of the Duchess's admission to hospital on Monday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de34bf0b-b47f-3a4a-b823-1c5f642f34f9",
                                        "entry_id": "a8f5d949-947c-3f7a-bb01-4de0b1a052c4",
                                        "glosses": [
                                            "The act or process of reasoning a priori from premises given or assumed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "634421aa-d99e-3610-ae7d-3411ed5dafc9",
                                        "entry_id": "a8f5d949-947c-3f7a-bb01-4de0b1a052c4",
                                        "glosses": [
                                            "A conclusion to which the mind comes by speculating; mere theory; notion; conjecture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2627b9e9-04b2-45d6-8996-44315469bae6",
                                                "sense_id": "634421aa-d99e-3610-ae7d-3411ed5dafc9",
                                                "text": "[N]ear the Age of Socrates lived their Great and Renowned Confutius, who began the ſame Deſign, of reclaiming Men from the uſeless and endleſs Speculations of Nature, to thoſe of Morality."
                                            },
                                            {
                                                "example_id": "b7f80a86-008a-436b-a57c-f6467a8fd18a",
                                                "sense_id": "634421aa-d99e-3610-ae7d-3411ed5dafc9",
                                                "text": "To his speculations on these subjects he gave the lofty name of the \"Oracles of Reason\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7343d140-9d77-3a07-8658-165d6ae6e7af",
                                        "entry_id": "a8f5d949-947c-3f7a-bb01-4de0b1a052c4",
                                        "glosses": [
                                            "An investment involving higher-than-normal risk in order to obtain a higher-than-normal return."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "751c2081-0875-3a9e-abd9-e5c6187480ab",
                                        "entry_id": "a8f5d949-947c-3f7a-bb01-4de0b1a052c4",
                                        "glosses": [
                                            "The act or practice of buying land, goods, shares, etc., in expectation of selling at a higher price, or of selling with the expectation of repurchasing at a lower price; a trading on anticipated fluctuations in price, as distinguished from trading in which the profit expected is the difference between the retail and wholesale prices, or the difference of price in different markets."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63c85a91-ce33-4f1a-88a2-e308cf14513d",
                                                "sense_id": "751c2081-0875-3a9e-abd9-e5c6187480ab",
                                                "text": "Sudden fortunes, indeed, are sometimes made in such places, by what is called the trade of speculation."
                                            },
                                            {
                                                "example_id": "6c96b80c-2d25-4c7b-a2e6-9be7722c52ca",
                                                "sense_id": "751c2081-0875-3a9e-abd9-e5c6187480ab",
                                                "text": "Speculation, while confined within moderate limits, is the agent for equalizing supply and demand, and rendering the fluctuations of price less sudden and abrupt than they would otherwise be."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e81f228e-0015-3a50-aa84-47cf7f792de3",
                                        "entry_id": "a8f5d949-947c-3f7a-bb01-4de0b1a052c4",
                                        "glosses": [
                                            "A card game in which the players buy from one another trumps or whole hands, upon a chance of getting the highest trump dealt, which entitles the holder to the pool of stakes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5740ecf4-1716-3d5f-9308-1bcedabee78e",
                                        "entry_id": "a8f5d949-947c-3f7a-bb01-4de0b1a052c4",
                                        "glosses": [
                                            "The process of anticipating which branch of code will be chosen and executing it in advance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
