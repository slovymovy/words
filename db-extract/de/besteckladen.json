                "senses": [
                    {
                        "sense_id": "190fd595-a08b-3ad1-a4aa-a4be640d63bb",
                        "entry_id": "9275eb8f-332b-3e6f-a1c1-265d25a7746a",
                        "glosses": [
                            "Geschäft, in dem Besteck feilgeboten wird"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "83608d12-2851-42e9-b5d0-168037ba2895",
                                "sense_id": "190fd595-a08b-3ad1-a4aa-a4be640d63bb",
                                "text": "„Glücklicherweise verliert das Drama seinen Schrecken, sobald man einen Besteckladen betritt oder im Netz herumstöbert.“"
                            },
                            {
                                "example_id": "fcbed101-d398-469d-8cf4-3dbddf8eccd9",
                                "sense_id": "190fd595-a08b-3ad1-a4aa-a4be640d63bb",
                                "text": "„Du weißt, dass IVF dein Hirn erweicht hat, wenn du […] an einem WMF-Laden vorbeiläufst und aus dem Augenwinkel plötzlich denkst, warte mal, der Besteckladen heißt jetzt IVF?“"
                            },
                            {
                                "example_id": "cc963e31-c8cf-4c03-81f1-8837ed1d56ab",
                                "sense_id": "190fd595-a08b-3ad1-a4aa-a4be640d63bb",
                                "text": "Reine Besteckläden finden wir in Deutschland so gut wie gar nicht."
                            },
                            {
                                "example_id": "187e4e4e-7b55-432a-af9f-32149c0cdbd3",
                                "sense_id": "190fd595-a08b-3ad1-a4aa-a4be640d63bb",
                                "text": "„Und wir erfuhren, dass die abwesende der fotografierten Schwestern auf einem anderen Markt als gering bezahlte Angestellte den ganzen Tag in einem Geschirr- und Besteckladen auf Kunden wartete […].“"
                            },
                            {
                                "example_id": "c524cc79-e751-4e0f-a5b8-b17ed4606fba",
                                "sense_id": "190fd595-a08b-3ad1-a4aa-a4be640d63bb",
                                "text": "„Als ich davon las, kam mir doch gleich der Gedanke, dass der Besteckladen mit den drei großen Buchstaben dann wohl auch schließen muss. Was soll ich sagen? Er ist jetzt dauerhaft geschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
