                    {
                        "sense_id": "e4c0ab9d-86c9-317d-bee9-f9aa0d1c6fed",
                        "entry_id": "afda4a72-d3ac-31d9-9f42-cfdc8fdc2c26",
                        "glosses": [
                            "Titre de noblesse russe, grand-duc."
