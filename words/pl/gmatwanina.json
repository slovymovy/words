                    "sense_id": "bdbab5b1-2dbd-331c-9219-c04765f1aaa1",
                    "sense_definition": "fizyczna plątanina gęsto splecionych, poplątanych ze sobą elementów",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "plątanina_materialna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W kącie szuflady leżała bezużyteczna <w>gmatwanina</w> starych kabli od ładowarek.",
                            "target_lang_translations": {
                                "ru": "В углу ящика лежала бесполезная <w>путаница</w> старых кабелей от зарядных устройств."
                            }
                        },
                        {
                            "text": "Przedzieraliśmy się przez gęstą <w>gmatwaninę</w> gałęzi i ciernistych krzewów.",
                            "target_lang_translations": {
                                "ru": "Мы пробирались сквозь густое <w>сплетение</w> ветвей и колючих кустарников."
                            }
                        }
                    ],
                    "synonyms": [
                        "plątanina"
                    ],
                    "common_phrases": [
                        "gmatwanina kabli",
                        "gmatwanina gałęzi"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое сплетение, клубок перепутанных между собой предметов или растений"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путаница",
                                "target_lang_sense_clarification": "о спутанных нитях, проводах и т. п."
                            },
                            {
                                "target_lang_word": "клубок",
                                "target_lang_sense_clarification": "густое сплетение, ком"
                            },
                            {
                                "target_lang_word": "лабиринт",
                                "target_lang_sense_clarification": "густое переплетение ветвей, проходов"
                            },
                            {
                                "target_lang_word": "сплетение",
                                "target_lang_sense_clarification": "переплетенная масса ветвей или проводов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48b7da86-34aa-3ebb-ab61-f8766bfb69b9",
                    "sense_definition": "stan skomplikowania, bezładu, chaosu lub nagromadzenia trudnych do pojęcia spraw",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nieporządek_abstrakcyjny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trudno było znaleźć właściwe rozwiązanie w tej całej <w>gmatwaninie</w> sprzecznych przepisów.",
                            "target_lang_translations": {
                                "ru": "Трудно было найти правильное решение во всей этой <w>путанице</w> противоречивых правил."
                            }
                        },
                        {
                            "text": "Po długiej rozmowie wreszcie zacząłem rozumieć tę niesamowitą <w>gmatwaninę</w> uczuć i myśli.",
                            "target_lang_translations": {
                                "ru": "После долгого разговора я наконец начал понимать этот невероятный <w>сумбур</w> чувств и мыслей."
                            }
                        }
                    ],
                    "synonyms": [
                        "bezład",
                        "chaos",
                        "zamęt",
                        "plątanina"
                    ],
                    "common_phrases": [
                        "gmatwanina myśli",
                        "gmatwanina przepisów"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние крайней запутанности, хаоса или нагромождения сложных для понимания вещей"
                    },
                    "translations": {
                        "ru": [
                            {
