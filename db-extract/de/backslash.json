                        "glosses": [
                            "Schrägstrich, der von oben links nach unten rechts verläuft"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "59fd5cdf-245d-4a2e-98f1-446ce78a54ad",
