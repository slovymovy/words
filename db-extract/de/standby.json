                        "sense_id": "54813487-ffbb-3c8b-8e8a-e268225307de",
                        "entry_id": "3e6bdd24-6c12-3a7d-9a18-f7f090562ea7",
                        "glosses": [
                            "Zustand, in dem ein Gerät jederzeit in Betrieb genommen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c14b4de9-aa36-4d93-88f0-b062a0b3c93c",
                                "sense_id": "54813487-ffbb-3c8b-8e8a-e268225307de",
                                "text": "Auch im Standby verbrauchen elektronische Geräte immer noch Strom."
                            },
                            {
                                "example_id": "da09b87f-1b26-4727-96d8-d86c049221f0",
                                "sense_id": "54813487-ffbb-3c8b-8e8a-e268225307de",
                                "text": "„In meinem Keller horte ich kistenweise 100-Watt-Glühbirnen, und mein Fernseher läuft an Feiertagen knallhart auf Standby.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
