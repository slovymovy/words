                                                "sense_id": "3d01aa49-55cd-3e15-8eb2-1b3c76357109",
                                                "text": "„Moldawien lebt vor allem von der Landwirtschaft sowie von der damit verbundenen Industrie.“"
                                            },
                                            {
                                                "example_id": "f5c0ba23-822f-4b23-a4d5-cd189a2bb040",
                                                "sense_id": "3d01aa49-55cd-3e15-8eb2-1b3c76357109",
                                                "text": "Letzte Woche war ich in Moldawien."
                                            },
                                            {
                                                "example_id": "e8596209-a92b-4e80-8aa7-2d22f222fef7",
                                                "sense_id": "3d01aa49-55cd-3e15-8eb2-1b3c76357109",
                                                "text": "„Wo es genau hingehen sollte und was mich in Moldawien erwarten würde, wusste ich nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
