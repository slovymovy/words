                        "glosses": [
                            "A slightly crumbly brined cheese made of cow, sheep, or goatmilk, similar to feta; popular in the Balkan Peninsula."
                        ],
                        "tags": [
                            "uncommon",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ea8b891f-c8f4-48cf-baeb-b619dac84a8a",
                                "sense_id": "8895f5a3-6df2-3214-928b-a3da49836775",
                                "text": "[…] then the potato pieces were layered on top and the mess was doused with olive oil and spices and cooked for an hour. Vlado made a tomato salad, also, with sirene cheese."
                            },
                            {
                                "example_id": "f005af9d-5232-4cce-b85a-66b321951ddf",
                                "sense_id": "8895f5a3-6df2-3214-928b-a3da49836775",
                                "text": "My curiosity was now satisfied: nothing, other than potatoes, bread, garlic and sirene cheese."
                            },
                            {
                                "example_id": "3a67bad2-45e6-478a-958b-3353175dab88",
                                "sense_id": "8895f5a3-6df2-3214-928b-a3da49836775",
                                "text": "A strudel-like banitsa (pastry) is eaten, which is an interlayering of sirene cheese with phyllo pastry—though it may also contain leeks or spinach […]"
                            }
                        ]
                    }
