                "translations": [
                    {
                        "translation_id": "f3395748-f590-44b7-b889-361831bd3f2a",
                        "source_entry_id": "334a0a00-2228-34a1-bf1c-7f66b15d3a4e",
                        "source_sense_id": "6b47cfba-684b-35e1-b83d-b3c912b71d96",
                        "target_lang_word": "graveyard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graveyard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "604cd85c-8128-380e-a40e-58b8cfaee673",
                                        "entry_id": "f29dea8c-4c5b-3211-be48-575dd876c4e7",
                                        "glosses": [
                                            "A tract of land in which the dead are buried."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4263c241-734d-31c6-b7d7-04c440edd569",
                                        "entry_id": "f29dea8c-4c5b-3211-be48-575dd876c4e7",
                                        "glosses": [
                                            "A final storage place for collections of things that are no longer useful or useable.",
                                            "The discard pile, in some trading card games."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4beddd8-53cf-4373-92bb-d688050be9b3",
                                                "sense_id": "4263c241-734d-31c6-b7d7-04c440edd569",
                                                "text": "When a player does discard or use a card or when a creature also died or a spell gets destroyed, that card gets placed into the player's graveyard."
                                            },
                                            {
                                                "example_id": "887c793d-1d81-48ff-a84d-9a63a6de5259",
                                                "sense_id": "4263c241-734d-31c6-b7d7-04c440edd569",
                                                "text": "Certain cards place other cards here because such cards might have abilities deemed too strong if they sent them to the graveyard instead."
                                            },
                                            {
                                                "example_id": "058051bb-356b-474f-bc35-0a8551ef12dd",
                                                "sense_id": "4263c241-734d-31c6-b7d7-04c440edd569",
                                                "text": "If you want to be tricky, though, Rapid Decay can be a flying elbow drop out of nowhere for a surprise win against graveyard manipulation decks; they will always see a Beetles coming, remember."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5b5bdd0-a009-3a43-a8b8-c66c895bbd01",
                                        "entry_id": "f29dea8c-4c5b-3211-be48-575dd876c4e7",
                                        "glosses": [
                                            "A final storage place for collections of things that are no longer useful or useable.",
                                            "A team where players are sent when they are not useful, or a team where players become useless if sent there."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4038c5bd-16c0-3ba0-a4fd-44aecbdd12d0",
                                        "entry_id": "f29dea8c-4c5b-3211-be48-575dd876c4e7",
                                        "glosses": [
                                            "A period very early in the morning in which there is very little activity."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "022465b3-4fec-4f21-bd4d-f3721e9c2aa1",
                                                "sense_id": "4038c5bd-16c0-3ba0-a4fd-44aecbdd12d0",
                                                "text": "graveyard shift, graveyard slot, graveyard watch"
                                            },
                                            {
                                                "example_id": "1dd4bf22-a613-48e8-be65-9fd2e9b67684",
                                                "sense_id": "4038c5bd-16c0-3ba0-a4fd-44aecbdd12d0",
                                                "text": "Her husband, of course, came dressed as Herman Melville.) She's a veteran of these marathons, and warned me about the forthcoming graveyard stretch—when Moby-Dick melds with the altered brain chemistry of sleep deprivation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40b1e655-cd07-3022-b649-77da39aa0421",
                                        "entry_id": "f29dea8c-4c5b-3211-be48-575dd876c4e7",
                                        "glosses": [
                                            "Synonym of suicide (“beverage combining all available flavors at a soda fountain”)."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c079d213-3b6d-4154-8ff9-c050c05b9d44",
                        "source_entry_id": "334a0a00-2228-34a1-bf1c-7f66b15d3a4e",
                        "source_sense_id": "6b47cfba-684b-35e1-b83d-b3c912b71d96",
                        "target_lang_word": "cemetery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cemetery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c0e5fbd-9a15-314d-a31c-90714aba51b7",
                                        "entry_id": "8c9713f1-8ec3-3d7d-978b-a6cebfe10647",
                                        "glosses": [
                                            "A place where the dead are buried; a graveyard or memorial park."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "102bfd49-c854-4292-8ce0-fe39458931a9",
                                                "sense_id": "3c0e5fbd-9a15-314d-a31c-90714aba51b7",
                                                "text": "The plain around was interspersed with cemeteries, Turk, Greek, and Armenian, with their growth of cypress trees..."
                                            },
                                            {
                                                "example_id": "de62288e-1e49-4283-aa42-27d747b11c15",
                                                "sense_id": "3c0e5fbd-9a15-314d-a31c-90714aba51b7",
                                                "text": "They were probably the work of individual craftsmen working to meet the chieftains' needs. Their place in the chronology of the big cemeteries is indicated by the less richly-decorated double-springed bronze brooches which are found here."
                                            },
                                            {
                                                "example_id": "c1e582f9-976c-4a7a-b748-b89b58567c9f",
                                                "sense_id": "3c0e5fbd-9a15-314d-a31c-90714aba51b7",
                                                "text": "[…] the cemetery – which people of shattering wit like Sampson never tired of calling ‘the dead centre of town’ […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09181e7d-7abb-493a-8b91-b87a482611f8",
                        "source_entry_id": "334a0a00-2228-34a1-bf1c-7f66b15d3a4e",
                        "source_sense_id": "6b47cfba-684b-35e1-b83d-b3c912b71d96",
                        "target_lang_word": "кладбище",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кладбище",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d0eb1825-9a0c-33f2-8051-a4c4639e9b4b",
                                        "entry_id": "f04a151d-96d2-3608-91ee-37d2c1ab2712",
                                        "glosses": [
                                            "специально отведённое место, предназначенное для погребения, захоронения умерших людей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60eaca6c-5857-4c67-892b-456059fb7a82",
                                                "sense_id": "d0eb1825-9a0c-33f2-8051-a4c4639e9b4b",
                                                "text": "Государь и великий князь приехали только в церковь и на дому не были, но провожали гроб из церкви до могилы на новом кладбище и тут оставались до первой горсти земли, посыпанной на гроб."
                                            },
                                            {
                                                "example_id": "8ac3b95c-24e8-43d6-b14e-a7be7dd96d78",
                                                "sense_id": "d0eb1825-9a0c-33f2-8051-a4c4639e9b4b",
                                                "text": "На кладбище священник крестообразно посыпает землёй покрытое саваном тело покойного, совершается лития."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63892885-df6b-3497-a477-a5f9af816af6",
                                        "entry_id": "f04a151d-96d2-3608-91ee-37d2c1ab2712",
                                        "glosses": [
                                            "место массового залегания останков животных"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
