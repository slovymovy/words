                        "sense_id": "e3981664-118f-3385-8f07-7a2647ecc004",
                        "entry_id": "86089965-9146-30e5-945c-065835a68556",
                        "glosses": [
                            "Se dit d’un composé qui contient de l’iode et la plus grande proportion possible d’oxygène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c930c8d-478a-4412-9d6a-43cb62c88cab",
                                "sense_id": "e3981664-118f-3385-8f07-7a2647ecc004",
                                "text": "L’acide iodique, chauffé à une température inférieure au rouge sombre, se décompose en oxygène et en iode, sans donner d’acide periodique."
                            },
                            {
                                "example_id": "9a6f0184-ba4a-413f-bff5-30bee134fcef",
                                "sense_id": "e3981664-118f-3385-8f07-7a2647ecc004",
                                "text": "Le diol obtenu forme un ester periodique qui se décompose pour donner deux molécules d’aldéhyde."
                            },
                            {
                                "example_id": "8c051b30-29c1-4d57-9e34-3d01c5422a6e",
                                "sense_id": "e3981664-118f-3385-8f07-7a2647ecc004",
                                "text": "Le mécanisme de cette réaction fait intervenir un ester periodique cyclique, qui se décompose en fournissant deux groupes carbonyle."
                            }
                        ]
                    }
