                "translations": [
                    {
                        "translation_id": "a15f4b37-5b08-40c7-aed0-36093089a979",
                        "source_entry_id": "de42604d-ae72-31d8-8511-fb373a49c812",
                        "source_sense_id": "0b737463-97b9-37b2-9d4e-7fbdb48f2867",
                        "source_sense_description": "EDV: CD-ROM, CD",
                        "target_lang_word": "CD-ROM",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "CD-ROM",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f4b9eb7-245f-33a3-b6d7-4309f1ca4892",
                                        "entry_id": "77b0eb20-c5c8-390f-8e17-4439204fa21a",
                                        "glosses": [
                                            "scheibenförmiger Datenträger, auf dem dauerhaft digitale Daten wie Software, Texte, Tonaufnahmen und Bilder gespeichert sind und die vom Benutzer zwar gelesen, jedoch nicht bearbeitet werden können"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ca32262-e975-4013-9091-e65595fb250f",
                                                "sense_id": "1f4b9eb7-245f-33a3-b6d7-4309f1ca4892",
                                                "text": "Er legte die CD-ROM in das Computerlaufwerk."
                                            },
                                            {
                                                "example_id": "3a0ba237-4187-4582-8a4d-f16e18278aa1",
                                                "sense_id": "1f4b9eb7-245f-33a3-b6d7-4309f1ca4892",
                                                "text": "„Ohne den kleinsten Funken von Inspiration drehe ich die CD-ROM in meiner Hand hin und her und stecke sie schließlich in meine Handtasche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52b6d315-e881-4679-8841-086e1dfa27ed",
                        "source_entry_id": "de42604d-ae72-31d8-8511-fb373a49c812",
                        "source_sense_id": "0b737463-97b9-37b2-9d4e-7fbdb48f2867",
                        "source_sense_description": "EDV: CD-ROM, CD",
                        "target_lang_word": "CD",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "CD",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78f0e20a-f79c-3c55-873e-5eb31c3f8493",
                                        "entry_id": "a3f49540-6315-324d-a92b-104dddb35cf4",
                                        "glosses": [
                                            "Compact Disc"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf4c8048-9b9d-4139-9e30-52a76d373e3f",
                                                "sense_id": "78f0e20a-f79c-3c55-873e-5eb31c3f8493",
                                                "text": "Ich habe ein paar gute CDs bei mir zuhause."
                                            },
                                            {
                                                "example_id": "8b26bcf0-84ec-40b1-b92e-24aca61dbc59",
                                                "sense_id": "78f0e20a-f79c-3c55-873e-5eb31c3f8493",
                                                "text": "„Mama Eko stand auf und legte die CD ein.“"
                                            },
                                            {
                                                "example_id": "df8d764f-a52b-43c5-a42c-941440fe0df7",
                                                "sense_id": "78f0e20a-f79c-3c55-873e-5eb31c3f8493",
                                                "text": "„Dann lege ich die CD auf, die Valmont – dramaturgisch geschickt – im Schlafwagen liegen ließ.“"
                                            },
                                            {
                                                "example_id": "2adbac6e-fe62-43c8-9b53-24e66f7926b6",
                                                "sense_id": "78f0e20a-f79c-3c55-873e-5eb31c3f8493",
                                                "text": "„Aus den Lautsprechern erklang plötzlich sehr laut ein Stück klassischer Musik, das Ben hektisch leiser drehte, bevor er schnell mehrfach auf den Radioknopf drückte, sodass statt der CD nun Popgedudel zu hören war.“"
                                            },
                                            {
                                                "example_id": "b77c2957-b47b-460f-acb6-1ed04b8b3cfc",
                                                "sense_id": "78f0e20a-f79c-3c55-873e-5eb31c3f8493",
                                                "text": "„Er brachte mir eine CD dieser Band mit, ich wusste, dass ich die nicht hören würde, trotzdem legte ich sie gut sichtbar auf meinen Schreibtisch, wie einen weiteren Beweis dafür, dass Ola mir gehörte und keiner anderen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
