        "nl-extract.jsonl": [
            {
                "entry_id": "78f8f436-a732-371e-98d7-427f498dbec0",
                "word": "provocerend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a70ac5c9-9d5c-3fe7-9638-7bc793048437",
                        "entry_id": "78f8f436-a732-371e-98d7-427f498dbec0",
                        "glosses": [
                            "de bedoeling hebbend om iemand te activeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed41f1ed-9bcd-49d1-beb5-27dd0c4e80f0",
                                "sense_id": "a70ac5c9-9d5c-3fe7-9638-7bc793048437",
                                "text": "In 2002 begon Jensen zijn eigen televisieprogramma JENSEN! op Yorin, waar hij samen met de provocerende sidekick Jan Paparazzi bekende mensen en zelfs supersterren uit binnen- en buitenland het hemd van het lijf vroeg."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3869628-1896-3058-beed-f89c1063700f",
                        "entry_id": "78f8f436-a732-371e-98d7-427f498dbec0",
                        "glosses": [
                            "een negatieve reactie oproepend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "940b4cde-9e37-4e14-a981-483543edfcd5",
                                "sense_id": "c3869628-1896-3058-beed-f89c1063700f",
                                "text": "Ook benadrukt Gheiybe hoe slim hij is. Maar de man die naar eigen zeggen succesvol is in alles, speelt met vuur. Met één verkeerde klik op zijn telefoon kan hij iets essentieels verraden waardoor de politie hem toch nog te pakken krijgt. Maar voor nu neemt hij afscheid, aan het einde van zijn provocerende filmpje, met een kusgebaar."
                            },
                            {
                                "example_id": "ef8f5d8c-1be6-4bbc-92a6-8f8fdea18f9d",
                                "sense_id": "c3869628-1896-3058-beed-f89c1063700f",
                                "text": "De Partij van de Arbeid heeft talloze negatieve reacties gekregen op een provocerende foto die gisternacht op het Twitterkanaal van de partij was gezet. Op de foto poseert het Amsterdamse PvdA-raadslid Hendrik Jan Biemond samen met mensen uit de lhbti-gemeenschap in een gele boerka tijdens Pride Amsterdam."
                            }
                        ]
                    },
                    {
                        "sense_id": "023c86f2-7518-315d-a349-6bf57d0c1384",
                        "entry_id": "78f8f436-a732-371e-98d7-427f498dbec0",
                        "glosses": [
                            "seksueel prikkelend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad790ca7-19b4-4d5a-8ea5-caf95631e2ef",
                                "sense_id": "023c86f2-7518-315d-a349-6bf57d0c1384",
                                "text": "de vrouw ging provocerend gekleed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c9d2a21-d0cf-4f6b-bc2d-9dab0b733390",
                        "source_entry_id": "78f8f436-a732-371e-98d7-427f498dbec0",
                        "source_sense_id": "a70ac5c9-9d5c-3fe7-9638-7bc793048437",
                        "source_sense_description": "de bedoeling hebbend om iemand te activeren",
                        "target_lang_word": "ostentatief",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "760e9dee-d9f8-41b6-b96e-baf1a8cdc0de",
                        "source_entry_id": "78f8f436-a732-371e-98d7-427f498dbec0",
                        "source_sense_id": "a70ac5c9-9d5c-3fe7-9638-7bc793048437",
                        "source_sense_description": "de bedoeling hebbend om iemand te activeren",
                        "target_lang_word": "defiant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "defiant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4bd3469-c2f7-3d50-9504-ffac6d1795c8",
                                        "entry_id": "9bcd1d6d-7f6a-3646-9b48-5ec6288ba27f",
                                        "glosses": [
                                            "One who defies opposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c7180f8-f663-4a45-bef7-d1c7e6eccf4e",
                                                "sense_id": "f4bd3469-c2f7-3d50-9504-ffac6d1795c8",
                                                "text": "Countries condemning South Africa, Portugal and Rhodesia still find it necessary to trade with these defiants against so-called world opinion."
                                            },
                                            {
                                                "example_id": "ee53fe53-acb8-4613-b7a6-d1a64349ae6e",
                                                "sense_id": "f4bd3469-c2f7-3d50-9504-ffac6d1795c8",
                                                "text": "Damn the obedients and hail the defiants if you will; the experiment does not motivate confidence about how particular subjects would behave in markedly dissimilar situations."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "defiant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84cce714-6d87-3930-bf11-83f920e9df23",
                                        "entry_id": "9571c2c6-a668-386a-9d63-adb99c596da9",
                                        "glosses": [
                                            "Defying."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc6340aa-a26f-4ac2-aae8-72ad17ee8a40",
                                                "sense_id": "84cce714-6d87-3930-bf11-83f920e9df23",
                                                "text": "She paused and took a defiant breath. ‘If you don't believe me, I can't help it. But I'm not a liar.’ ¶ ‘No,’ said Luke, grinning at her. ‘You're not dull enough![…]What about the kid's clothes? I don't suppose they were anything to write home about, but didn't you keep anything? A bootee or a bit of embroidery or anything at all?’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4abcbb37-fc63-39e1-88cd-089b492280d9",
                                        "entry_id": "9571c2c6-a668-386a-9d63-adb99c596da9",
                                        "glosses": [
                                            "Boldly resisting opposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e5153b3-b6c1-4a04-a294-7e25b0b0b2f3",
                                                "sense_id": "4abcbb37-fc63-39e1-88cd-089b492280d9",
                                                "text": "But the demonstrators remained defiant, pouring into the streets by the thousands and venting their anger over political corruption, the high cost of living and huge public spending for the World Cup and the Olympics."
                                            },
                                            {
                                                "example_id": "0ae5141b-c04c-4bb0-aa3c-8ab402fb27ee",
                                                "sense_id": "4abcbb37-fc63-39e1-88cd-089b492280d9",
                                                "text": "Gunshots rang out in the capital Abuja and also in the neighboring Niger state as police lobbed tear gas to disperse defiant protesters. In Niger, at least six people are now feared dead, local media reported."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3430f1fb-19e8-40a2-aad2-1e61d5da6620",
                        "source_entry_id": "78f8f436-a732-371e-98d7-427f498dbec0",
                        "source_sense_id": "a70ac5c9-9d5c-3fe7-9638-7bc793048437",
                        "source_sense_description": "de bedoeling hebbend om iemand te activeren",
                        "target_lang_word": "provoking",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "provoking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1206132-a8ea-3509-a610-9be6339d4d3b",
                                        "entry_id": "f7a1ac51-1fba-3075-98ce-9c6c51820995",
                                        "glosses": [
                                            "provocation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be8135bc-b162-48cb-9a30-1bc4026a7f16",
                                                "sense_id": "e1206132-a8ea-3509-a610-9be6339d4d3b",
                                                "text": "The habit of mind so engendered is wholly demoralizing, particularly since the national political consciousness is so dependent on their provokings."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "provoking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7327d520-9096-3e4f-9041-3b32026180c5",
