                "senses": [
                    {
                        "sense_id": "8b9f21fa-943e-31fe-9231-8e5112cf938b",
                        "entry_id": "0abd5429-3f78-3811-a259-20eb5dd62f2e",
                        "glosses": [
                            "Glaskolben mit zwei Abschlusskappen; innen Anode und außen Kathode"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d695143-344e-4b6d-8dab-dac755e009ba",
                                "sense_id": "8b9f21fa-943e-31fe-9231-8e5112cf938b",
                                "text": "Eine Ionisationsröhre der bekannten Bauart, mit 1x Abschlusskappe, gibt es auch mit 2x Abschlusskappen und wird als Bipol, also Ionisationsbipolröhre bezeichnet."
                            },
                            {
                                "example_id": "8c6fab8f-7b33-43e4-a559-8b6d42572620",
                                "sense_id": "8b9f21fa-943e-31fe-9231-8e5112cf938b",
                                "text": "„4er Pack Ionisationsbipolröhre Typ A (Bipolionisationsröhre Typ A) Art.-Nr.: IR-A-070 / M4-6mm Länge: 70mmGewindezapfen: 2 x M4-6mm Hochleistungsröhre mit 24-48.000h Betriebsstunden Ausführung: Longlife durch Edelstahl, Lieferung: direkt ab Werk.“"
                            },
                            {
                                "example_id": "f93cea1a-eba8-40b6-bc2e-c91b20176375",
                                "sense_id": "8b9f21fa-943e-31fe-9231-8e5112cf938b",
                                "text": "„Ionisationsbipolröhren mit zwei Abschlusskappen an einem Stück Glasrohr, werden beidseitig gelagert und verfügen sowohl über einen Anodenanschluss als auch über einen Kathodenanschluss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
