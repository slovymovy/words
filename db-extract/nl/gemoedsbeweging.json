        "nl-extract.jsonl": [
            {
                "entry_id": "99ca8409-19f0-32d2-8984-bd3c647ab50a",
                "word": "gemoedsbeweging",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "02f0baf7-4757-498e-8ef5-7c72727b5f8e",
                        "entry_id": "99ca8409-19f0-32d2-8984-bd3c647ab50a",
                        "tags": [
                            "plural"
                        ],
                        "form": "gemoedsbewegingen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dc03c6df-06d2-3580-aca3-36f8d026a13d",
                        "entry_id": "99ca8409-19f0-32d2-8984-bd3c647ab50a",
                        "glosses": [
                            "emotionele beroering door een heftige externe prikkel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8026ebc-4157-470d-835b-db09d1815cf6",
                                "sense_id": "dc03c6df-06d2-3580-aca3-36f8d026a13d",
                                "text": "Vandaag begraaf ik mijn zoon. Het was voorlopig een constatering, nauwelijks meer dan dat. Er hoorde geen ziekmakende gemoedsbeweging bij."
                            },
                            {
                                "example_id": "db6821f8-241b-41e8-9021-6dac3d09a6e8",
                                "sense_id": "dc03c6df-06d2-3580-aca3-36f8d026a13d",
                                "text": "\"Niet strafbaar is de overschrijding van de grenzen van de noodzakelijke verdediging, indien zij het onmiddellijk gevolg is geweest van een hevige gemoedsbeweging, door de aanranding veroorzaakt\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f77f417b-0b91-4830-9486-f9f76283df1d",
                        "source_entry_id": "99ca8409-19f0-32d2-8984-bd3c647ab50a",
                        "source_sense_id": "dc03c6df-06d2-3580-aca3-36f8d026a13d",
                        "target_lang_word": "affection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7173891e-385b-3f24-8bb7-c819c812bc0b",
                                        "entry_id": "8af1ccf5-14ad-34c6-8c79-db638249d886",
                                        "glosses": [
                                            "The act of affecting or acting upon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "731106d6-e716-34f9-b582-27e0df530fc8",
                                        "entry_id": "8af1ccf5-14ad-34c6-8c79-db638249d886",
                                        "glosses": [
                                            "The state of being affected, especially: a change in, or alteration of, the emotional state of a person or other animal, caused by a subjective affect (a subjective feeling or emotion), which arises in response to a stimulus which may result from either thought or perception."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23283372-0df1-31bf-93fb-354e0f9b5ad2",
                                        "entry_id": "8af1ccf5-14ad-34c6-8c79-db638249d886",
                                        "glosses": [
                                            "An attribute; a quality or property; a condition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "094c0f8b-c0ec-4005-9443-11344823470e",
                                                "sense_id": "23283372-0df1-31bf-93fb-354e0f9b5ad2",
                                                "text": "A Porism is a proposition in which it is proposed to demonstrate that some one thing, or more things than one, are given, to which, as also to each of innumerable other things, not given indeed, but which have the same relation to those which are given, it is to be shewn that there belongs some common affection described in the proposition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88db41c7-22a5-3ef2-9e31-1b722d27a458",
                                        "entry_id": "8af1ccf5-14ad-34c6-8c79-db638249d886",
                                        "glosses": [
                                            "An emotion; a feeling or natural impulse acting upon and swaying the mind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "743bd066-64ad-4cb3-a562-9755d621f981",
                                                "sense_id": "88db41c7-22a5-3ef2-9e31-1b722d27a458",
                                                "text": "Our affections for wild animals are distributed very unevenly. Take insects."
                                            },
                                            {
                                                "example_id": "afcb332f-ff1f-4d75-85d2-00caf288a3b4",
                                                "sense_id": "88db41c7-22a5-3ef2-9e31-1b722d27a458",
                                                "text": "It is known that each individual has a variety of affections, one affection when in joy, another when in grief, another when in sympathy and compassion, another when in sincerity and truth, another when in love and charity, another when in zeal or in anger, another when in simulation and deceit, another when in quest of honor and glory, and so on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ab04238-0626-3367-bc54-83151b609e68",
                                        "entry_id": "8af1ccf5-14ad-34c6-8c79-db638249d886",
                                        "glosses": [
                                            "A feeling of love or strong attachment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a08810f-a2b9-489a-8c97-4a6ebd86e674",
                                                "sense_id": "4ab04238-0626-3367-bc54-83151b609e68",
                                                "text": "I have a lot of affection for my little sister."
                                            },
                                            {
                                                "example_id": "09e8b2bc-7b27-41ac-83bd-2fea9ebe7aab",
                                                "sense_id": "4ab04238-0626-3367-bc54-83151b609e68",
                                                "text": "The marriage therapist suggested they show each other more affection."
                                            },
                                            {
                                                "example_id": "f9fef831-3023-4cd5-9986-f1a6e23cd8f6",
                                                "sense_id": "4ab04238-0626-3367-bc54-83151b609e68",
                                                "text": "Mr. Bennet missed his second daughter exceedingly; his affection for her drew him oftener from home than anything else could do. He delighted in going to Pemberley, especially when he was least expected."
                                            },
                                            {
                                                "example_id": "78a60b5c-c12e-4e56-a09a-4bc3de6fda9d",
                                                "sense_id": "4ab04238-0626-3367-bc54-83151b609e68",
                                                "text": "What is more, they are protected from even such discomfort as the dislike of his prisoners may cause to a gaoler by the hypnotism of the convention that the natural relation between husband and wife and parent and child is one of intense affection, and that to feel any other sentiment towards a member of one's family is to be a monster."
                                            },
                                            {
                                                "example_id": "2bf64a08-5c95-420f-80ea-42da39f87a64",
                                                "sense_id": "4ab04238-0626-3367-bc54-83151b609e68",
                                                "text": "\"Did you ever like me back, Ryan? All those years, I didn't know how to show my affection for you, so I wasn't sure if you weren't getting it or you just didn't care. But I need to know which it was.\""
                                            },
                                            {
                                                "example_id": "c4795bc4-5d66-4eb5-880a-b06eebefcb14",
                                                "sense_id": "4ab04238-0626-3367-bc54-83151b609e68",
                                                "text": "Dated a girl that I hate, for the attention / She only made it two days, what a connection / It's like you'd do anything, for my affection / You're going all about it in the worst ways"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e38e657d-7419-339e-b640-65c1d5f9c49d",
                                        "entry_id": "8af1ccf5-14ad-34c6-8c79-db638249d886",
                                        "glosses": [
                                            "A disease; a morbid symptom; a malady."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69e13e11-d928-44d2-97a2-5fad30fb0e80",
                                                "sense_id": "e38e657d-7419-339e-b640-65c1d5f9c49d",
                                                "text": "a pulmonary affection"
                                            },
                                            {
                                                "example_id": "4404baa6-9f42-45e4-b339-5b6040468108",
                                                "sense_id": "e38e657d-7419-339e-b640-65c1d5f9c49d",
                                                "text": "The recedent or retrograde form is marked by a sudden subsidence of the inflammatory state of the joints, succeeded immediately by an affection of some internal part, where is thenceforth the seat of the morbid manifestations."
                                            },
                                            {
                                                "example_id": "2b5cfe34-39dc-4389-a140-41b81161d4de",
                                                "sense_id": "e38e657d-7419-339e-b640-65c1d5f9c49d",
                                                "text": "A heavy clay soil is bad for all neuralgics, and the house should be dry, and on a sandy or gravel soil. The desideratum for all neuralgic affections is perpetual summer […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "affection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdf12a52-7e63-3270-b6c4-1fb53a40a3a3",
                                        "entry_id": "00758d05-2e03-3429-8175-e539f560093d",
                                        "glosses": [
                                            "To feel affection for."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7884f88-c359-4a09-b88e-766bc9df11ff",
                                                "sense_id": "cdf12a52-7e63-3270-b6c4-1fb53a40a3a3",
                                                "text": "Why, truth is truth, I do not think my lady Isabella ever much affectioned my young lord, your son: yet he was a sweet youth as one should see."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41e249d0-ca39-4f9d-a914-56309b969f1b",
                        "source_entry_id": "99ca8409-19f0-32d2-8984-bd3c647ab50a",
                        "source_sense_id": "dc03c6df-06d2-3580-aca3-36f8d026a13d",
                        "target_lang_word": "emotion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emotion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be306bfd-e7e9-31c6-8196-6cc269783696",
                                        "entry_id": "293b426a-7dde-38fd-943a-8e2ecc3ba4a8",
                                        "glosses": [
                                            "Movement; agitation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d55ab39f-b10e-488d-956c-d0436530e31b",
                                                "sense_id": "be306bfd-e7e9-31c6-8196-6cc269783696",
                                                "text": "and the water continuing in the caverns[…]caused the emotion or earthquake"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43de13b5-d480-3950-a94c-d0cfc62b4225",
                                        "entry_id": "293b426a-7dde-38fd-943a-8e2ecc3ba4a8",
                                        "glosses": [
                                            "A person's internal state of being and involuntary physiological response to an object or a situation, based on or tied to physical state and sensory data."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "217cc845-62fe-404d-a995-4617de586558",
                                                "sense_id": "43de13b5-d480-3950-a94c-d0cfc62b4225",
                                                "text": "He was thinking; but the glory of the song, the swell from the great organ, the clustered lights, […], the height and vastness of this noble fane, its antiquity and its strength—all these things seemed to have their part as causes of the thrilling emotion that accompanied his thoughts."
                                            },
                                            {
                                                "example_id": "d860e6fb-472a-4b2d-b763-50f7e4f824ba",
                                                "sense_id": "43de13b5-d480-3950-a94c-d0cfc62b4225",
                                                "text": "“Just think about the last big decision you made. How much of it was based in emotion and how much was based in intellect? Most all big decisions are based in both.” […] Historically, placing weight on emotions has been dismissed. “What’s remarkable is that for so many years, people didn’t see emotions as conveying important messages,” he says."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f2b8287-a314-30ae-90a6-0ff90f821ac2",
                                        "entry_id": "293b426a-7dde-38fd-943a-8e2ecc3ba4a8",
                                        "glosses": [
                                            "A reaction by a non-human organism with behavioral and physiological elements similar to a person's response."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9396ba54-feaa-41b3-9841-ed3aa13b07a1",
                        "source_entry_id": "99ca8409-19f0-32d2-8984-bd3c647ab50a",
                        "source_sense_id": "dc03c6df-06d2-3580-aca3-36f8d026a13d",
                        "target_lang_word": "feeling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feeling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73f94836-7c78-3127-9f7a-d19dc4eacbc9",
                                        "entry_id": "9ebb3224-52ed-3856-8aab-05b40232fdbd",
                                        "glosses": [
                                            "Emotionally sensitive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05622ec0-ec38-44da-84c9-f9183c5dca32",
                                                "sense_id": "73f94836-7c78-3127-9f7a-d19dc4eacbc9",
                                                "text": "Despite the rough voice, the coach is surprisingly feeling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfc2ea01-2e9f-3e95-b71e-c7f436b27b7f",
                                        "entry_id": "9ebb3224-52ed-3856-8aab-05b40232fdbd",
                                        "glosses": [
                                            "Expressive of great sensibility; attended by, or evincing, sensibility."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daf42115-6f71-4fa4-94c6-438481e170b7",
                                                "sense_id": "bfc2ea01-2e9f-3e95-b71e-c7f436b27b7f",
                                                "text": "He made a feeling representation of his wrongs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "feeling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "033a9968-4b5c-379f-a3ae-74eb4a5ab44f",
                                        "entry_id": "c243cc9f-04cc-358a-af89-c4fd61d94c01",
                                        "glosses": [
                                            "Sensation, particularly through the skin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ff7d207-6ca8-4198-a4c9-37d26d10d347",
                                                "sense_id": "033a9968-4b5c-379f-a3ae-74eb4a5ab44f",
                                                "text": "The wool on my arm produced a strange feeling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8df5a620-9611-3ea6-8ad7-792c4e2b8c76",
                                        "entry_id": "c243cc9f-04cc-358a-af89-c4fd61d94c01",
                                        "glosses": [
                                            "Emotion; impression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f329c00-5a44-441e-88e4-86a14db40499",
                                                "sense_id": "8df5a620-9611-3ea6-8ad7-792c4e2b8c76",
                                                "text": "The house gave me a feeling of dread."
                                            },
                                            {
                                                "example_id": "17a943aa-01b4-4459-a799-1a3d879c3725",
                                                "sense_id": "8df5a620-9611-3ea6-8ad7-792c4e2b8c76",
                                                "text": "Part of the 'western arcade' (as it's known) is lined with delis, cafes and other shops, giving it the feeling of a bazaar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a15f4a9-6d7c-301d-8760-b6b19bea89c8",
                                        "entry_id": "c243cc9f-04cc-358a-af89-c4fd61d94c01",
                                        "glosses": [
                                            "Emotional state or well-being."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59da4146-7833-40e7-a07d-e20de896b03c",
                                                "sense_id": "8a15f4a9-6d7c-301d-8760-b6b19bea89c8",
                                                "text": "You really hurt my feelings when you said that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55b1daab-b3a9-3daf-b645-a5567a19f03e",
                                        "entry_id": "c243cc9f-04cc-358a-af89-c4fd61d94c01",
                                        "glosses": [
                                            "Emotional attraction or desire."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89f946f3-fc49-428b-af96-06d0542740ff",
                                                "sense_id": "55b1daab-b3a9-3daf-b645-a5567a19f03e",
                                                "text": "Many people still have feelings for their first love."
                                            },
                                            {
                                                "example_id": "f0a68f0e-39e1-4992-aa0a-a9901d7abd73",
                                                "sense_id": "55b1daab-b3a9-3daf-b645-a5567a19f03e",
                                                "text": "You can kiss a hundred boys in bars\nShoot another shot, try to stop the feeling\nYou can say it's just the way you are\nMake a new excuse, another stupid reason"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37b41a2c-2fbf-32bc-b0e1-a9ffeaf508aa",
                                        "entry_id": "c243cc9f-04cc-358a-af89-c4fd61d94c01",
                                        "glosses": [
                                            "Intuition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffd991c5-76b9-4983-ab99-eb08cdbc103b",
                                                "sense_id": "37b41a2c-2fbf-32bc-b0e1-a9ffeaf508aa",
                                                "text": "He has no feeling for what he can say to somebody in such a fragile emotional condition."
                                            },
                                            {
                                                "example_id": "ab4e97c1-50f7-4a4e-8bb7-9614eadf847e",
                                                "sense_id": "37b41a2c-2fbf-32bc-b0e1-a9ffeaf508aa",
                                                "text": "I've got a funny feeling that this isn't going to work."
                                            },
                                            {
                                                "example_id": "967cfed3-4668-47ac-9878-fb8bebeb8a48",
                                                "sense_id": "37b41a2c-2fbf-32bc-b0e1-a9ffeaf508aa",
                                                "text": "Got on a lucky one / Came in eighteen to one / I've got a feeling / This year's for me and you"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8e4c2c8-41b0-372c-9951-429e49c1a62c",
                                        "entry_id": "c243cc9f-04cc-358a-af89-c4fd61d94c01",
                                        "glosses": [
                                            "An opinion, an attitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8facd28-2dac-45fe-a2a9-2684d6fe2ada",
                                                "sense_id": "d8e4c2c8-41b0-372c-9951-429e49c1a62c",
                                                "text": "When you are tempted to speculate in cocoa, lie down until the feeling goes away."
                                            }
                                        ]
                                    }
                                ]
                            },
