                        "entry_id": "27de4a45-8d38-3330-b4a1-c7a4bd693a69",
                        "glosses": [
                            "Obtenir un aperçu d’une numérisation de document, avant de confirmer la numérisation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdd7791c-60ee-4f67-8518-f825215e6cf4",
                                "sense_id": "6dbf9f48-8d46-3391-af0a-17178c0a0a87",
                                "text": "En règle générale, il faut d'abord prénumériser votre image avant de lancer la numérisation ( bouton : \" previous \", \" prénumériser \" ou autre)."
                            },
                            {
                                "example_id": "193919ad-1d8f-4ccb-a63b-ab734c3d68ec",
                                "sense_id": "6dbf9f48-8d46-3391-af0a-17178c0a0a87",
                                "text": "Vous pouvez numériser une page entière ou une partie seulement en prénumérisant le document."
                            },
                            {
                                "example_id": "de63beec-0656-420e-aae5-e6f302e4a00c",
                                "sense_id": "6dbf9f48-8d46-3391-af0a-17178c0a0a87",
                                "text": "Cliquez sur \"Prénumériser\", ou \"Prévisualiser\"."
                            }
