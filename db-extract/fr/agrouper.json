                                "sense_id": "db6d43bc-a1ce-3166-a0dd-0310cf663bd2",
                                "text": "Agroupés autour de leurs délégués, les employés résolurent, dans un chahut d’invectives, de ne se remettre dans les brancards qu’ils n’eussent obtenu des garanties formelles."
                            },
                            {
                                "example_id": "6dc5f869-aa72-4d0d-baeb-9903e91acb89",
                                "sense_id": "db6d43bc-a1ce-3166-a0dd-0310cf663bd2",
                                "text": "Le son nous agroupe, nous régit, nous organise."
                            }
                        ]
                    }
