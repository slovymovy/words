                                                "sense_id": "290ffc7a-7875-3e94-ba20-2f910bfe16ef",
                                                "text": "The children die off in vast numbers: those pale roses are all nerves. Hence, will presently burst forth the epileptic dances of the fourteenth century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b83c24ce-482e-330d-8568-f9c68aa3e1a9",
                                        "entry_id": "8f6df32e-9c6c-3a59-8374-074b00a7dfc1",
                                        "glosses": [
                                            "Of or relating to an epileptic or epileptics (epileptic people)."
                                        ],
                                        "tags": [
