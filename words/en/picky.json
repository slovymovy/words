{
    "word_family": [
        "pick",
        "picker",
        "pickiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a6ea771a-ff45-3b1a-9546-5adff8619bba",
                    "sense_definition": "Hard to please and very careful about choosing only what one likes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "personality_traits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My younger brother is a very <w>picky</w> eater who refuses to eat any green vegetables.",
                            "target_lang_translations": {
                                "ru": "Мой младший брат очень <w>привередлив</w> в еде и отказывается есть любые зеленые овощи."
                            }
                        },
                        {
                            "text": "She is extremely <w>picky</w> about her clothes and spends hours choosing the right outfit.",
                            "target_lang_translations": {
                                "ru": "Она крайне <w>разборчива</w> в одежде и часами выбирает подходящий наряд."
                            }
                        }
                    ],
                    "synonyms": [
                        "choosy",
                        "finicky",
                        "fussy",
                        "particular"
                    ],
                    "antonyms": [
                        "easygoing",
                        "undemanding",
                        "unfussy"
                    ],
                    "common_phrases": [
                        "picky eater",
                        "picky about details"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кому трудно угодить, и кто очень тщательно выбирает только то, что ему нравится."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привередливый",
                                "target_lang_sense_clarification": "о человеке, которому трудно угодить"
                            },
                            {
                                "target_lang_word": "разборчивый",
                                "target_lang_sense_clarification": "тщательно выбирающий лучшее"
                            },
                            {
                                "target_lang_word": "капризный",
                                "target_lang_sense_clarification": "часто о детях или в еде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c467cad0-35fa-373b-a77d-1e0eea5d1269",
                    "sense_definition": "Describing a meal made of various small snacks or finger foods rather than a main dish.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "food_types",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Since it was too hot to cook, we just had a <w>picky</w> tea with cheese, crackers, and grapes.",
                            "target_lang_translations": {
                                "ru": "Так как было слишком жарко, чтобы готовить, мы просто устроили <w>перекус</w> с сыром, крекерами и виноградом."
                            }
                        },
                        {
                            "text": "The host served a tray of <w>picky</w> bits for everyone to snack on during the movie.",
                            "target_lang_translations": {
                                "ru": "Хозяин подал поднос с <w>закусками</w>, чтобы все могли перекусить во время фильма."
                            }
                        }
                    ],
                    "common_phrases": [
                        "picky tea",
                        "picky bits"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British English for informal meals."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает прием пищи, состоящий из различных мелких закусок, а не из основного блюда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "состоящий из закусок",
                                "target_lang_sense_clarification": "о легком перекусе из разных продуктов"
                            },
                            {
                                "target_lang_word": "фуршетный",
                                "target_lang_sense_clarification": "в контексте набора мелких блюд"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "80967ae5-477f-314c-b443-20cda836467e",
                    "sense_definition": "An informal or childish term for a picture or photograph.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "images",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child showed me the <w>picky</w> he had drawn of his family at school.",
                            "target_lang_translations": {
                                "ru": "Ребенок показал мне <w>рисунок</w>, который он нарисовал в школе со своей семьей."
                            }
                        },
                        {
                            "text": "Wait a moment while I take a few <w>pickies</w> of the garden to show my mother.",
                            "target_lang_translations": {
                                "ru": "Подожди минутку, я сделаю несколько <w>фоток</w> сада, чтобы показать маме."
                            }
                        }
                    ],
                    "synonyms": [
                        "pic"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal diminutive form."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальный или детский термин для обозначения картинки или фотографии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фотка",
                                "target_lang_sense_clarification": "разговорное сокращение от фотографии"
                            },
                            {
                                "target_lang_word": "картинка",
                                "target_lang_sense_clarification": "детское или неформальное название рисунка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}