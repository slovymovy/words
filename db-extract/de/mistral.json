                ],
                "senses": [
                    {
                        "sense_id": "bbd53888-65b1-3f19-a75f-a303c531d12f",
                        "entry_id": "084a54f1-5fd0-3fc8-a3f2-7eb6ed44b5bb",
                        "glosses": [
                            "kalter, trockener, stark wehender Nordwind bis Nordwestwind an der südfranzösischen Küste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "147bf0bd-9a79-4d5e-95fa-85570ffcb3d0",
                                "sense_id": "bbd53888-65b1-3f19-a75f-a303c531d12f",
                                "text": "Bei einem Mistral ist der Himmel meist klar und das Meer färbt sich tief dunkelblau."
                            },
                            {
                                "example_id": "720cac4d-5b60-47b5-87ce-516295d3d2e4",
                                "sense_id": "bbd53888-65b1-3f19-a75f-a303c531d12f",
                                "text": "„Karg ist das Land, das Gras verdorrt, Olivenhaine, Pinien, Zypressen – alle beugt der Mistral.“"
                            },
                            {
                                "example_id": "dc5c1d8a-4d91-43b0-9732-c7a433d3a429",
                                "sense_id": "bbd53888-65b1-3f19-a75f-a303c531d12f",
                                "text": "„Auf dem Meer dort draußen, zwei, drei Kilometer fern, wehte offenbar ein harter Wind von der unsichtbaren Rhonemündung herüber, das war der Mistral - weiße Schaumkronen in jener Überbläue.“"
                            },
                            {
                                "example_id": "c2980427-383f-4142-85a3-4a42401bbc54",
                                "sense_id": "bbd53888-65b1-3f19-a75f-a303c531d12f",
                                "text": "„Dieser Wind kommt alle Tage zur gleichen Stunde aus Nordwest und wird Mistral genannt.“"
                            },
                            {
                                "example_id": "07532c64-3593-4150-839b-f5a46e457722",
                                "sense_id": "bbd53888-65b1-3f19-a75f-a303c531d12f",
                                "text": "„Ich saß aber immer im Freien, im Winkel eines Fensters, gechützt vor dem Mistral, der einen von allen Seiten zugleich angriff.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5dc45c8-929a-4853-8aa7-55c60b389cad",
                        "source_entry_id": "084a54f1-5fd0-3fc8-a3f2-7eb6ed44b5bb",
                        "source_sense_id": "bbd53888-65b1-3f19-a75f-a303c531d12f",
                        "source_sense_description": "Meteorologie: kalter, trockener, stark wehender Nordwind bis Nordwestwind an der südfranzösischen Küste",
                        "target_lang_word": "mistral",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mistral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2c727f0-0736-39e1-9d0f-6550e5bcc1ca",
                                        "entry_id": "95ad6a68-557f-3ba3-9d6b-3939f549d8c0",
                                        "glosses": [
                                            "A strong cold north-west wind in southern France and the Mediterranean."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edbd4d6c-760c-4a6c-b868-9b615347e0c0",
                                                "sense_id": "b2c727f0-0736-39e1-9d0f-6550e5bcc1ca",
                                                "text": "I saw him, the sea gray under the mistral and foam-flecked, watching the vanishing coast of France, which he was destined never to see again; and I thought there was something gallant in his bearing and dauntless in his soul."
                                            },
                                            {
                                                "example_id": "0279f79f-0177-4ac2-bc1c-42306d802c17",
                                                "sense_id": "b2c727f0-0736-39e1-9d0f-6550e5bcc1ca",
                                                "text": "The mistral had been blowing for three days now and the sea showed more white than blue"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e429b289-69b6-450c-8c34-b32c77cb7555",
                        "source_entry_id": "084a54f1-5fd0-3fc8-a3f2-7eb6ed44b5bb",
                        "source_sense_id": "bbd53888-65b1-3f19-a75f-a303c531d12f",
                        "source_sense_description": "Meteorologie: kalter, trockener, stark wehender Nordwind bis Nordwestwind an der südfranzösischen Küste",
                        "target_lang_word": "mistral",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mistral",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d4a31b4b-5034-3d89-a55a-72b59feb754a",
                                        "entry_id": "afe3f631-a6c5-33c3-abe8-5cbf51829934",
                                        "glosses": [
                                            "Vent froid, sec et souvent violent, qui souffle du nord dans la vallée du Rhône et les zones adjacentes du Midi de la France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ba55fc2-2e82-4405-a6ea-744649dbaef0",
                                                "sense_id": "d4a31b4b-5034-3d89-a55a-72b59feb754a",
                                                "text": "Le mistral n'est qu'une façon parmi d'autres pour la nature d'exprimer sa puissance et sa joie."
                                            },
                                            {
                                                "example_id": "6728ad69-ec31-4b07-8977-b5b3e9667901",
                                                "sense_id": "d4a31b4b-5034-3d89-a55a-72b59feb754a",
                                                "text": "Alors, si le vent du nord vient à souffler, ces graux sont promptement agrandis, il s'en forme même de nouveaux, et les étangs se déchargent en peu de jours d'une grande partie de leurs eaux ; ils se vident presque entièrement si le mistral (nord-ouest) souffle assez long-temps avec son impétuosité ordinaire."
                                            },
                                            {
                                                "example_id": "fbf033c7-ab99-4fe9-8f75-3f7757e0c4c9",
                                                "sense_id": "d4a31b4b-5034-3d89-a55a-72b59feb754a",
                                                "text": "Depuis trois jours déjà, le mistral soufflait. Mais, le soir, il redoubla, avec une violence nouvelle ; et Martine annonça qu’il durerait au moins trois jours encore, suivant la croyance populaire."
                                            },
                                            {
                                                "example_id": "7068463d-a023-4278-94fb-8e9837d6e62e",
                                                "sense_id": "d4a31b4b-5034-3d89-a55a-72b59feb754a",
                                                "text": "Elle interpelle une femme maigriote et chahuteuse et lui crie avec un accent inimitable :\n— Té, ma petite, si jamais le mistral y souffle à Paris, tu vas t'envoler comme une aéroplane."
                                            },
                                            {
                                                "example_id": "2a9d62b3-2d5b-4f0b-bf56-c2632fe61f61",
                                                "sense_id": "d4a31b4b-5034-3d89-a55a-72b59feb754a",
                                                "text": "Le convoi approche maintenant d’Aix-en-Provence. La nuit est sombre et un froid mistral ratisse violemment la contrée, par rafales convulsives. Une météo sévère très dissuasive pour un émeutier."
                                            },
                                            {
                                                "example_id": "0b23ebf8-3d5f-489c-87bc-0a3d37140399",
                                                "sense_id": "d4a31b4b-5034-3d89-a55a-72b59feb754a",
                                                "text": "Quand t'es petit dans le Midi\nT'es pas petit comme ailleurs.\nTu chantes avant de dire « maman »,\nEt avant de parler, tu mens;\nEt tes colères magistrales\nTe viennent tout droit du mistral."
                                            },
                                            {
                                                "example_id": "b84b0549-87e5-4b5e-87c2-5b0ca3861a69",
                                                "sense_id": "d4a31b4b-5034-3d89-a55a-72b59feb754a",
                                                "text": "Depuis, j'ai vérifié que le vent est un grand personnage de la géographie, et que l'on s'expose à ne rien comprendre à l'histoire si l'on oublie les brises, les typhons, les mistrals et les foehns, ou bien ce vent grec qui emporta par étourderie, voilà près de trois mille ans, quelques marins de Phocée en Asie Mineure, et qui les jeta en France afin qu'ils créent la ville de Marseille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eacf7592-1ef2-376a-a5f7-11f8c8002a7e",
                                        "entry_id": "afe3f631-a6c5-33c3-abe8-5cbf51829934",
                                        "glosses": [
                                            "Officier qui regroupait les fonctions de percepteur et de juge pour le compte du seigneur local, dans la Savoie et le Dauphiné du Moyen Âge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e991e64-d663-488d-ae7c-4b4f7f9bd9ef",
                                                "sense_id": "eacf7592-1ef2-376a-a5f7-11f8c8002a7e",
                                                "text": "… le mistral était tout à la fois juge des causes moins importantes et receveur des redevances féodales ; il réunissait ainsi les fonctions de juge de mandement à celles de percepteur des contributions."
                                            },
                                            {
                                                "example_id": "b4758ea7-6feb-4e32-995b-3035e20022ef",
                                                "sense_id": "eacf7592-1ef2-376a-a5f7-11f8c8002a7e",
                                                "text": "À cette époque, un certain Johanet est mistral à Trept. Il occupe les diverses fonctions de percepteur, garde forestier et garde champêtre, représentant local des moniales, chargé de percevoir les servis et de faire respecter les droits seigneuriaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f622ad65-50da-476e-b873-7c716f99ebb2",
                        "source_entry_id": "084a54f1-5fd0-3fc8-a3f2-7eb6ed44b5bb",
