                    {
                        "translation_id": "4a23ef2d-8c73-4f57-8db0-9e31a6fd4124",
                        "source_entry_id": "01fac3c4-5b75-3496-9ae4-c04e9e95525b",
                        "source_sense_id": "16ac9746-4026-3693-bca6-9e5e4d3a8eac",
