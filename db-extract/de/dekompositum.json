                ],
                "senses": [
                    {
                        "sense_id": "41164bc7-efe6-3eb9-ae5c-1454f5081484",
                        "entry_id": "f1e8cc49-2c2d-3f06-b87c-dbaa0ad2317c",
                        "glosses": [
                            "Wort, das aus einem bereits vorhandenen Kompositum entstanden, zum Beispiel auch abgeleitet, ist"
                        ],
                        "tags": [
                            "im weiteren Sinne"
                        ],
                        "examples": [
                            {
                                "example_id": "fbd86f9e-b1b0-4959-9393-e319bb62bf64",
                                "sense_id": "41164bc7-efe6-3eb9-ae5c-1454f5081484",
                                "text": "„Einige Grammatiker bezeichnen mit dem Namen Dekompositum bloß die von Kompositis abgeleiteten Formen, z.B. aufmerksam von aufmerken, leichtsinnig von Leichtsinn.“ (1878)"
                            },
                            {
                                "example_id": "c8c630aa-7829-4af5-b561-6126a59f2a91",
                                "sense_id": "41164bc7-efe6-3eb9-ae5c-1454f5081484",
                                "text": "Beispiel: das Kompositum \"Dampfschiff\". Hieraus lassen sich immer neue Dekomposita entwickeln: \"Dampfschifffahrt\", \"Rheindampfschifffahrt\", \"Rheindampfschifffahrtskapitän\", usw."
                            },
                            {
                                "example_id": "002f3ab2-8f5f-42b3-bfb5-fc8471e71614",
                                "sense_id": "41164bc7-efe6-3eb9-ae5c-1454f5081484",
                                "text": "„Komposita mit mehr als zwei Grundmorphemen werden als Dekomposita bezeichnet.“ (2008)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "40be5174-fbe7-3ed9-a1f0-3eb3cf2667a6",
                        "entry_id": "f1e8cc49-2c2d-3f06-b87c-dbaa0ad2317c",
                        "glosses": [
                            "Kompositum, das einzig und alleine durch Komposition (Zusammensetzung) aus einem bereits vorhandenen Kompositum entstanden ist"
                        ],
                        "tags": [
                            "im engeren Sinne"
                        ],
                        "examples": [
                            {
                                "example_id": "27137b4c-017f-4ada-8538-f57492f378dd",
                                "sense_id": "40be5174-fbe7-3ed9-a1f0-3eb3cf2667a6",
                                "text": "Beispiel: das Kompositum \"Dampfschiff\". Hieraus lassen sich immer neue Dekomposita entwickeln: \"Dampfschifffahrt\", \"Rheindampfschifffahrt\", \"Rheindampfschifffahrtskapitän\", usw."
                            },
                            {
                                "example_id": "8cf66b0b-e1f7-4cac-8849-70e06f332c85",
                                "sense_id": "40be5174-fbe7-3ed9-a1f0-3eb3cf2667a6",
                                "text": "„Komposita mit mehr als zwei Grundmorphemen werden als Dekomposita bezeichnet.“ (2008)"
                            },
                            {
                                "example_id": "26461879-41ff-433d-9882-8e42a2b592b7",
                                "sense_id": "40be5174-fbe7-3ed9-a1f0-3eb3cf2667a6",
                                "text": "„Wenn an ein zusammengesetztes noch ein neues Wort von vorne angesetzt wird, so heist es dann ein Dekompositum. Dergleichen sind auferstehen, Oberhofprediger.“ (1770)"
                            },
                            {
                                "example_id": "5b9e8f58-550e-4111-9c82-e81646f81aad",
                                "sense_id": "40be5174-fbe7-3ed9-a1f0-3eb3cf2667a6",
                                "text": "Ein Dekompositum beruht auf einer Erweiterung eines bereits bestehenden Kompositums um wenigstens ein weiteres Lexem (Wort)."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
