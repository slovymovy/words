                        "glosses": [
                            "Ligne de chemin de fer qui reliait la Géorgie actuelle à l'Azerbaïdjan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d87a3ca-69e8-41e7-a0cf-4e821be9ec85",
                                "sense_id": "437d82a6-17ec-3443-a4a5-a9c928ad0526",
                                "text": "Le Transcaucasien a bouleversé cet ordre des choses, il a ouvert la Perse sur le monde, on peut désormais atteindre cet empire sans risque ni désagrément majeur, en paquebot de Bakou au port d’Enzéli, puis en une semaine sur route carrossable jusqu’à Téhéran."
                            }
                        ]
                    }
