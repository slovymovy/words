                                        "entry_id": "6c7a7868-40a0-3775-b720-a5cf53dec539",
                                        "glosses": [
                                            "jedna z trzech grup ludności zamieszkujących Rwandę i Burundi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1de0c078-59bb-4c94-a6e4-aa3dfe10f12c",
                                                "sense_id": "b6315c4e-1817-383b-bbbe-c1f7fd1d805d",
                                                "text": "Historycznie Tutsi byli związani z rwandyjską klasą rządzącą, ale zdarzało się, że z powodu ubóstwa Tutsi stawał się Hutu"
                                            },
                                            {
                                                "example_id": "4be4fdce-0672-4df9-a1e0-01e63a092378",
                                                "sense_id": "b6315c4e-1817-383b-bbbe-c1f7fd1d805d",
                                                "text": "Wkrótce zakończyć się mają ONZ-owskie rokowania pokojowe pomiędzy rebeliantami Tutsi i rządem będącym w rękach Hutu"
                                            }
                                        ],
