        "fr-extract.jsonl": [
            {
                "entry_id": "db4125f5-a665-31a2-a062-748b77b2768f",
                "word": "dégaine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "eb6b48c8-52ea-44a3-b2ca-59a0723ec4bc",
                        "entry_id": "db4125f5-a665-31a2-a062-748b77b2768f",
                        "tags": [
                            "plural"
                        ],
                        "form": "dégaines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b7ad84e-458b-3376-bd1a-f088fe1d4c0d",
                        "entry_id": "db4125f5-a665-31a2-a062-748b77b2768f",
                        "glosses": [
                            "Tournure ; façon de se tenir ; allure."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d119e591-c78a-4a9b-a5a5-38f5c4c8d079",
                                "sense_id": "2b7ad84e-458b-3376-bd1a-f088fe1d4c0d",
                                "text": "Quelle dégaine ! À voir la dégaine de cet homme, on le croirait d’une autre époque."
                            },
                            {
                                "example_id": "2d872542-5d37-4da4-b09c-b6c7d13f31bc",
                                "sense_id": "2b7ad84e-458b-3376-bd1a-f088fe1d4c0d",
                                "text": "Je suis acteur, moi. - Ah ouais, c'est vrai, t'as un peu la dégaine."
                            },
                            {
                                "example_id": "fd77aa44-f59b-4777-a70d-6d2e04af98c6",
                                "sense_id": "2b7ad84e-458b-3376-bd1a-f088fe1d4c0d",
                                "text": "(…), nous avions compris l’urgence d’agir à changer de dégaine et, (…), ces mêmes hommes (…), se muèrent en une satanée bande de gaillards, tous résolus à la victoire et je vous le garantis armés d’abattage et de formidables propos."
                            },
                            {
                                "example_id": "f89515ba-884c-43d4-8469-02849a33af82",
                                "sense_id": "2b7ad84e-458b-3376-bd1a-f088fe1d4c0d",
                                "text": "Le noctambule suivant me confirma dans l’opinion peu flatteuse que je nourrissais à l’égard de ma propre dégaine générale."
                            },
                            {
                                "example_id": "8ede6903-bfff-4e07-a078-ed105e5815ba",
                                "sense_id": "2b7ad84e-458b-3376-bd1a-f088fe1d4c0d",
                                "text": "La vie à l’étranger semble n’avoir été pour les deux sœurs qu’une longue suite de plaisanteries sur la dégaine des indigènes, l’accoutrement des femmes, la bizarrerie des coutumes alimentaires et autres ; on ressort tous les clichés qu’on a entendus sur ces sujets dans les petits théâtres ou au café-concert. (« Ils n’en ont pas en Allemagne. »)"
                            },
                            {
                                "example_id": "0f816bc3-0dcb-4d25-b12d-b87fa71c5e7e",
                                "sense_id": "2b7ad84e-458b-3376-bd1a-f088fe1d4c0d",
                                "text": "Argent pauvre nul tu m’fais un peu pitié\nT'as pas l’air très malin avec ta dégaine en papier."
                            },
                            {
                                "example_id": "dab3852f-d4ae-47f8-b964-76558a1925f5",
                                "sense_id": "2b7ad84e-458b-3376-bd1a-f088fe1d4c0d",
                                "text": "— Non non, je ne suis pas un intellectuel » insista-t-il. « J’essaie plus ou moins d’avoir une dégaine d’intellectuel des beaux quartiers, parce que c’est utile dans mon milieu, mais je n’en suis pas un, je n’ai même pas dépassé le bac."
                            }
                        ]
                    },
                    {
                        "sense_id": "85abe2c8-cb68-3f02-9e56-0a1ae269a66c",
                        "entry_id": "db4125f5-a665-31a2-a062-748b77b2768f",
                        "glosses": [
                            "Aspect général."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "84ee18a7-9827-435c-9d17-edf42d332955",
                                "sense_id": "85abe2c8-cb68-3f02-9e56-0a1ae269a66c",
                                "text": "Quelques immeubles neufs, confortables, décorent ça et là les rues avoisinant l’école, mais ils n’enlèvent pas au quartier des Plâtriers sa dégaine louche et crasseuse."
                            },
                            {
                                "example_id": "c4073e3e-ba36-41a0-94b8-9a6d941ef2a6",
                                "sense_id": "85abe2c8-cb68-3f02-9e56-0a1ae269a66c",
                                "text": "Ce supporter belge a une vraie dégaine en festival. Il porte un maillot rétro d’Anderlecht qui a une particularité assez drôle !"
                            }
                        ]
                    },
                    {
                        "sense_id": "8f52b1c4-32fd-311c-a6c0-c357281b2266",
                        "entry_id": "db4125f5-a665-31a2-a062-748b77b2768f",
                        "glosses": [
                            "Appareil de deux mousquetons reliés par une sangle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c85223e-e570-4b29-989e-b21b614c4687",
                                "sense_id": "8f52b1c4-32fd-311c-a6c0-c357281b2266",
                                "text": "De cette façon, les dos des mousquetons sont en appui contre le rocher. Cela n’est souhaitable que si, avant de mousquetonner la dégaine, vous avez pris la précaution de lire et de décoder attentivement le futur passage d’escalade."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a0a488f-5ad5-4453-933f-385085a89be4",
                        "source_entry_id": "db4125f5-a665-31a2-a062-748b77b2768f",
                        "source_sense_description": "Appareil de deux mousquetons reliés par une sangle.",
                        "target_lang_word": "getup",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "getup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "457b826d-1a9c-392a-a942-c4f2110f6491",
                                        "entry_id": "f7c1478b-025e-3b8e-8216-c8964e705c10",
                                        "glosses": [
                                            "Clothes, costume or outfit, especially one that is ostentatious or otherwise unusual."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d415f7c-c48a-41de-9c3a-f61969fecc9b",
                                                "sense_id": "457b826d-1a9c-392a-a942-c4f2110f6491",
                                                "text": "When near the buildings I met a white man, in such an unexpected elegance of get–up that in the first moment I took him for a sort of vision."
                                            },
                                            {
                                                "example_id": "a0155e55-80b0-4830-b27d-313470d6952c",
                                                "sense_id": "457b826d-1a9c-392a-a942-c4f2110f6491",
                                                "text": "The Schnitzelbank Band, each member attired in an odd getup, received many comments for the manner in which the men marched."
                                            },
                                            {
                                                "example_id": "f877f910-765a-47d3-9181-eeb200a1b0df",
                                                "sense_id": "457b826d-1a9c-392a-a942-c4f2110f6491",
                                                "text": "Oh, I forgot. She had on a get-up that took the attention of anyone that saw her, even in that crazy mob. The better to cut the wind, she had shortened sail and wore a short skirt, black tights, and a skullcap."
                                            },
                                            {
                                                "example_id": "656e5607-0875-4f9e-96a8-4edb5bc72a7e",
                                                "sense_id": "457b826d-1a9c-392a-a942-c4f2110f6491",
                                                "text": "[A] parade of costumed cadets trots by: a shark costume, an Uncle Sam getup and three young men in form-fitting bodysuits."
                                            },
                                            {
                                                "example_id": "c349b4c2-9f12-4bc0-b751-f412f681804a",
                                                "sense_id": "457b826d-1a9c-392a-a942-c4f2110f6491",
                                                "text": "They wore jorts and crop tops; or strappy, S&M-influenced getups; or pajamas emblazoned with cartoons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "599a7744-1064-3e7a-ad10-ea2f73ad5b5a",
                                        "entry_id": "f7c1478b-025e-3b8e-8216-c8964e705c10",
                                        "glosses": [
                                            "A fight or altercation."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24e3285d-7224-40da-87f1-9196a9b6f8ad",
                                                "sense_id": "599a7744-1064-3e7a-ad10-ea2f73ad5b5a",
                                                "text": "\"A bully. Picked on fellows. He loved to fight. But I never saw him in a getup with a fellow his own size.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "947aea5c-737d-3a61-ac38-8309ea24edfc",
                                        "entry_id": "f7c1478b-025e-3b8e-8216-c8964e705c10",
                                        "glosses": [
                                            "Layout and production style, as of a magazine."
                                        ],
