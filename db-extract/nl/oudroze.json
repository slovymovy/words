                                            {
                                                "example_id": "90605400-6023-4158-b5db-2a4443e98ad4",
                                                "sense_id": "dd381292-b710-333c-b1d3-3bacc23abcb4",
                                                "text": "Hast du ein altrosa Näpfchen in deinem Farbkasten?"
                                            },
                                            {
                                                "example_id": "bb7d4713-25ae-420d-9db5-f207a3dbf9fb",
                                                "sense_id": "dd381292-b710-333c-b1d3-3bacc23abcb4",
                                                "text": "„Er trägt sein fahles, ursprünglich gewelltes Haar heftig an den Kopf gescheitelt und zeigt im Gesicht jene altrosa Färbung, die auf Bluthochdruck und/oder ein zeitiges Gläschen am Morgen hinweist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
