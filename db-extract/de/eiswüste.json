                "senses": [
                    {
                        "sense_id": "08040b0e-343f-3888-afc8-786c6d22b20c",
                        "entry_id": "1d3e982f-f958-3f2b-9d8c-c5057a807e19",
                        "glosses": [
                            "Ort, an dem sich nur Eis und Schnee, aber keine Vegetation befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d86b615a-2618-4342-84c6-f19208d2427e",
                                "sense_id": "08040b0e-343f-3888-afc8-786c6d22b20c",
                                "text": "Eiswüsten gibt es zum Beispiel in Grönland und der Antarktis, aber auch auf anderen Planeten."
                            },
                            {
                                "example_id": "87759a2f-e5e9-4315-840b-28cfaed82f5e",
                                "sense_id": "08040b0e-343f-3888-afc8-786c6d22b20c",
                                "text": "Es ist nicht einfach, in einer Eiswüste zu überleben."
                            },
                            {
                                "example_id": "808c06ef-9218-40f2-9624-c3c8adeba482",
                                "sense_id": "08040b0e-343f-3888-afc8-786c6d22b20c",
                                "text": "„Wahrscheinlich wurde Beringia zu einem Refugium mit relativ gemäßigtem Klima zwischen Eiswüsten im Osten wie Westen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
