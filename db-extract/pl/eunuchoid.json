                                        "glosses": [
                                            "Resembling a eunuch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21e884f3-4e75-40b1-9287-f4053929992f",
                                                "sense_id": "6542fe97-50d5-37b7-919a-b6fed902cc57",
                                                "text": "Some we already knew, like Casimir Ava the tragic actor with his pale eunuchoid-velvet complexion and studied poses."
                                            },
                                            {
                                                "example_id": "71b8be1b-b0c9-4ebf-b88d-b9f825c6f20e",
                                                "sense_id": "6542fe97-50d5-37b7-919a-b6fed902cc57",
                                                "text": "Frontiersmen were never afraid of poetry. It was Big Business with its fear of femininity, it was the eunuchoid clergy capitulating to vulgar masculinity that made religion and art sissy things."
                                            }
                                        ]
                                    }
