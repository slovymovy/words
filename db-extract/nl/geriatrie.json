                "forms": [],
                "senses": [
                    {
                        "sense_id": "6cb36275-0e26-3f69-8b66-cd21a68fa48a",
                        "entry_id": "73565043-fa79-3c65-8fd1-f5e192c23bb4",
                        "glosses": [
                            "een geneeskundige specialisatie, speciaal gericht op oudere mensen met complexe ziekteproblemen"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "151df4cc-b842-4539-9e89-281c383cd6c4",
                        "source_entry_id": "73565043-fa79-3c65-8fd1-f5e192c23bb4",
                        "source_sense_id": "6cb36275-0e26-3f69-8b66-cd21a68fa48a",
                        "target_lang_word": "Geriatrie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geriatrie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1048c7ce-a012-3d23-9719-d7f12912ff25",
                                        "entry_id": "fcd54857-2e30-3c96-bccf-19d99641863e",
                                        "glosses": [
                                            "Wissenschaft, die sich mit Krankheiten alternder Menschen beschäftigt"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "517d745a-b087-43cf-85ba-9043ddf63b76",
                                                "sense_id": "1048c7ce-a012-3d23-9719-d7f12912ff25",
                                                "text": "„Der Sturz im Alter wird in der Geriatrie als gesondertes medizinisches Problem betont, weil ungefähr ein Drittel der Menschen über 65 Jahre mindestens einmal pro Jahr stürzt (Alterssyndrom).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4cf81e29-8c78-353d-af2c-718997a29c83",
                                        "entry_id": "fcd54857-2e30-3c96-bccf-19d99641863e",
                                        "glosses": [
                                            "Station im Krankenhaus, die auf die Bedürfnisse alter Menschen spezialisiert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9274e2aa-46b0-4a6d-ae59-9bb6558a50ae",
                                                "sense_id": "4cf81e29-8c78-353d-af2c-718997a29c83",
                                                "text": "„Während in der Geriatrie noch Betten fehlen, sollen in einzelnen Chirurgien welche gestrichen werden.“"
                                            },
                                            {
                                                "example_id": "6ace5479-6d35-40db-8d98-ebf9df7b6bbb",
                                                "sense_id": "4cf81e29-8c78-353d-af2c-718997a29c83",
                                                "text": "„Die Geriatrie ermöglicht eine individuelle, altersspezifische Behandlung der Patienten.“"
                                            },
                                            {
                                                "example_id": "c5c3de84-5c80-464e-bf20-10fa4a77e55b",
                                                "sense_id": "4cf81e29-8c78-353d-af2c-718997a29c83",
                                                "text": "„Erst wenn ein akutes Geschehen oder eine deutliche Verschlechterung des Allgemeinzustandes des älteren Menschen eine stationäre Klinikbehandlung erforderlich macht, kann nach der Stabilisierung des Patienten eine Verlegung in die Geriatrie erfolgen.“"
                                            },
                                            {
                                                "example_id": "ca796c18-3f1d-440d-b3c9-96d0581060d7",
                                                "sense_id": "4cf81e29-8c78-353d-af2c-718997a29c83",
                                                "text": "„Später erfuhr ich von einer MTA, dass die Neurologin mir diesen Termin verschafft hatte, obwohl der gesamte Montag von der Geriatrie belegt worden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c720679-06f9-4d5d-baf2-e1818e6aa8a8",
                        "source_entry_id": "73565043-fa79-3c65-8fd1-f5e192c23bb4",
                        "source_sense_id": "6cb36275-0e26-3f69-8b66-cd21a68fa48a",
