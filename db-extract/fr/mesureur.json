                "translations": [
                    {
                        "translation_id": "212d7b70-5abd-4fad-8479-9b57325bad51",
                        "source_entry_id": "9c3c2f15-dd46-3223-9585-98398351ecd6",
                        "source_sense_id": "45d666b4-c5a7-3153-83bb-4b1b7e3d5a09",
                        "source_sense_description": "personne en charge de mesurer",
                        "target_lang_word": "Messer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Messer",
