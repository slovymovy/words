                                "target_senses": [
                                    {
                                        "sense_id": "93d0590a-aae1-3669-a91a-6daeb0464dc6",
                                        "entry_id": "60fdac0b-a560-3964-a37b-fcd3dee8cd79",
                                        "glosses": [
                                            "карточная игра для двух пар игроков"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa497652-b16d-493a-9291-ecec95b2e5cc",
                                                "sense_id": "93d0590a-aae1-3669-a91a-6daeb0464dc6",
                                                "text": "Скоро всё общество разделилось на четвёртые партии в вист и расселось в разных углах генеральских комнат."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e29d6f9-3dce-33bc-bdde-6d5b1471be49",
                                        "entry_id": "60fdac0b-a560-3964-a37b-fcd3dee8cd79",
                                        "glosses": [
                                            "карт. в некоторых карточных играх (например, в преферанс) взятка вистующего игрока"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13eb0f35-2d20-4e81-81c2-550abfb8fadf",
                                                "sense_id": "6e29d6f9-3dce-33bc-bdde-6d5b1471be49",
                                                "text": "На семерной игре вистующим надо взять два виста, а не три."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43bea359-4d4c-3e1a-b7c0-d5959831d101",
                                        "entry_id": "60fdac0b-a560-3964-a37b-fcd3dee8cd79",
                                        "glosses": [
                                            "карт. (обычно во мн. ч.) место для записи очков игрока в преферанс, набранных на вистах [2] против другого игрока"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00f7580d-07b9-4c1e-a008-2de7c6ab800f",
                                                "sense_id": "43bea359-4d4c-3e1a-b7c0-d5959831d101",
                                                "text": "Пулька имеет три сегмента: гора, пуля и висты."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff43639b-6992-393d-97fa-3107ca1e19b0",
                                        "entry_id": "60fdac0b-a560-3964-a37b-fcd3dee8cd79",
                                        "glosses": [
                                            "карт. единица подсчёта выигрыша в преферанс, имеющая заранее оговорённую стоимость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e180b46-759d-4760-b597-b37f65f0e686",
                                                "sense_id": "ff43639b-6992-393d-97fa-3107ca1e19b0",
                                                "text": "В приватных беседах выяснилось, что размер ставок в игре составлял 20 центов за вист. Самым крупным выигрышем за всё время чемпионата стали 1486 вистов (297 долларов), а самым крупным проигрышем — 1523 виста (304 доллара)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64c9c2e1-e245-3c50-892c-3bf112859e95",
                                        "entry_id": "60fdac0b-a560-3964-a37b-fcd3dee8cd79",
                                        "glosses": [
                                            "возглас, подтверждающий, что игрок в вист, бостон или преферанс вистует, а не пасует"
                                        ],
                                        "tags": [
                                            "в знач. междометия"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d41732e-cb1c-4abd-8f1e-f95ce64efe07",
                                                "sense_id": "64c9c2e1-e245-3c50-892c-3bf112859e95",
                                                "text": "После того как взявший прикуп назначит игру, первый и второй игрок по очереди решают, вистовать ли им (тогда надо сказать вист) или пасовать."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
