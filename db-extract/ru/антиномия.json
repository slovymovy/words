                    {
                        "translation_id": "031b8c64-2acc-4454-95fb-8d7526fb383e",
                        "source_entry_id": "285b5bb3-1f11-36f8-bfda-253a160ffdbc",
                        "source_sense_id": "678f3dbf-170f-37b1-98dc-3adaa20aa5c9",
                        "target_lang_word": "antinomie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antinomie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ad28c9e-96d6-364a-9755-6c103c8c010f",
                                        "entry_id": "7a375cf4-d140-3901-bb15-41e2ef787c58",
                                        "glosses": [
                                            "Contradiction réelle ou apparente entre deux lois, deux principes, deux idées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "759d7a33-88ca-41fe-a886-6d55eeb7541e",
                                                "sense_id": "8ad28c9e-96d6-364a-9755-6c103c8c010f",
                                                "text": "Cette antinomie embarrasse tous les jurisconsultes."
                                            },
                                            {
                                                "example_id": "eb58c63d-5870-4576-ae11-05e5ff760846",
                                                "sense_id": "8ad28c9e-96d6-364a-9755-6c103c8c010f",
                                                "text": "Concilier des antinomies."
                                            },
                                            {
                                                "example_id": "7d1bf3af-298b-432f-b950-9ed62a6f6bb0",
                                                "sense_id": "8ad28c9e-96d6-364a-9755-6c103c8c010f",
                                                "text": "Une « guerre propre » ou un « enfer paradisiaque » ou le terme « Judéo-chrétien » sont des exemples d’antinomies."
                                            },
                                            {
                                                "example_id": "d592e965-734f-4cd1-bddc-4efd3cd0f8ff",
                                                "sense_id": "8ad28c9e-96d6-364a-9755-6c103c8c010f",
                                                "text": "Pour bien saisir lʼanalyse développée par Weber en réponse à ces deux questions, nous examinerons, dans un premier temps, lʼantinomie, tout à fait capitale, de la rationalité formelle et de la rationalité matérielle."
                                            },
                                            {
                                                "example_id": "c3cca892-3750-465f-86c4-0528681191bc",
                                                "sense_id": "8ad28c9e-96d6-364a-9755-6c103c8c010f",
                                                "text": "D'effleurements en retraits, elle pose ainsi la question centrale de son roman : que choisissent les femmes face à une antinomie irrésolue ? Intelligence ou beauté ?"
                                            },
                                            {
                                                "example_id": "424e7e77-f00e-477a-a291-65df1e996e7f",
                                                "sense_id": "8ad28c9e-96d6-364a-9755-6c103c8c010f",
                                                "text": "Antinomies et paradoxes sont nécessaires à la dynamique psychique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
