{
    "word": "grunge",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "655db1f0-4aff-30e8-b6e0-13754de5297b",
                "word": "grunge",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "97e53069-b047-30db-a08e-8f29172e057a",
                        "entry_id": "655db1f0-4aff-30e8-b6e0-13754de5297b",
                        "glosses": [
                            "Dirt or filth, especially when difficult to clean."
                        ],
                        "tags": [
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "912a057a-a18a-4cbe-ba43-ba6814375323",
                                "sense_id": "97e53069-b047-30db-a08e-8f29172e057a",
                                "text": "The cinema floor was covered in grunge deposited by the crowds."
                            }
                        ]
                    },
                    {
                        "sense_id": "4389671b-d4b7-37a7-a124-bdcc2dfb0dae",
                        "entry_id": "655db1f0-4aff-30e8-b6e0-13754de5297b",
                        "glosses": [
                            "The state of being filthy; grubbiness."
                        ],
                        "tags": [
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a2449163-9135-421d-80cc-bfecf914d47b",
                                "sense_id": "4389671b-d4b7-37a7-a124-bdcc2dfb0dae",
                                "text": "Chad used to work as a coal miner, but couldn't handle the constant grunge."
                            }
                        ]
                    },
                    {
                        "sense_id": "13607292-06ea-38d6-9e6c-93ddf239790f",
                        "entry_id": "655db1f0-4aff-30e8-b6e0-13754de5297b",
                        "glosses": [
                            "A subgenre of alternative rock, originating from Seattle, Washington in the early 1990s, which melds punk and metal."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "72e0f813-b3bb-4127-9fcf-9ebc7a3cbf72",
                                "sense_id": "13607292-06ea-38d6-9e6c-93ddf239790f",
                                "text": "Alice liked to wear plaids and ripped jeans, and listen to grunge."
                            },
                            {
                                "example_id": "5f1b5107-b356-40d3-b166-79309ae7de7e",
                                "sense_id": "13607292-06ea-38d6-9e6c-93ddf239790f",
                                "text": "Grunge was the de facto soundtrack of the early nineties. It’s also sometimes criticized for its sonic limitations—most groups played the same way, at the same speed and with the same worldview, usually mining the same handful of influences. It was, by design, a derivative musical form. But it did introduce at least one new idea to mainstream rock: a collective sense of self-aware skepticism."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af498a5f-3385-43b6-a6fb-4ee3c8bf094d",
                        "source_entry_id": "655db1f0-4aff-30e8-b6e0-13754de5297b",
                        "source_sense_description": "dirt, filth",
                        "target_lang_word": "Schmutz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmutz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a7897a3f-ca03-3d5f-9565-ef2e932545e6",
                                        "entry_id": "96a23029-7b49-3fee-8663-c7d6acf373e8",
                                        "glosses": [
                                            "Unsauberkeit, feuchter Dreck, Staub"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b82e6552-b48b-4aea-ad6c-1a5523a6ede5",
                                                "sense_id": "a7897a3f-ca03-3d5f-9565-ef2e932545e6",
                                                "text": "Nach Befahren der Uferstraße war das Auto voll Schmutz."
                                            },
                                            {
                                                "example_id": "9ae3c830-51e1-42c2-bc33-a9f65cd4c59e",
                                                "sense_id": "a7897a3f-ca03-3d5f-9565-ef2e932545e6",
                                                "text": "„Die Pferde waren nicht zu sehen, und man hörte nur, wie sie durch den unsichtbaren Schmutz stampften.“"
                                            },
                                            {
                                                "example_id": "397a6d93-261a-4ec3-aea8-62c5d81ce730",
                                                "sense_id": "a7897a3f-ca03-3d5f-9565-ef2e932545e6",
                                                "text": "„Immermann begann seine Uniform vom Schmutz zu säubern.“"
                                            },
                                            {
                                                "example_id": "b4a30508-ac7f-44e5-a2ec-de873bbebd8a",
                                                "sense_id": "a7897a3f-ca03-3d5f-9565-ef2e932545e6",
                                                "text": "„Während er aber seinem Tier die Zügel ließ, beschäftigte er sich eifrig damit, mit einer kleinen Kleiderbürste seinen Anzug vom heraufspritzenden Schmutz zu reinigen und sein langes Haar zu kämmen, soweit ihm das bei der schnellen Bewegung eines galoppierenden Pferdes und mit Hilfe eines kleinen Hohlspiegels möglich war.“"
                                            },
                                            {
                                                "example_id": "1e3db01b-3ab8-46b3-8a4e-6cb4a40131f0",
                                                "sense_id": "a7897a3f-ca03-3d5f-9565-ef2e932545e6",
                                                "text": "„An diesem Herbsttage war alles still in Skálholt, und niemand wußte, daß etwas geschehen; es begann zu frieren, und dadurch roch es nicht mehr so arg nach Kehricht und Schmutz, was sonst ein Kennzeichen dieses Ortes war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a7ad0247-1bda-3450-92f5-739d97f58434",
                                        "entry_id": "96a23029-7b49-3fee-8663-c7d6acf373e8",
                                        "glosses": [
                                            "Schundliteratur, anstößige Literatur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55f0b925-1472-4aa0-bac1-ede156e71dbe",
                                                "sense_id": "a7ad0247-1bda-3450-92f5-739d97f58434",
                                                "text": "Statt klassische Literatur las er nur Schmutz."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf32652f-7b04-465e-a1ab-1ad995d523e7",
                        "source_entry_id": "655db1f0-4aff-30e8-b6e0-13754de5297b",
                        "source_sense_description": "dirt, filth",
                        "target_lang_word": "Dreck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dreck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c69b42d-0536-3492-af8d-79cf6e0560df",
                                        "entry_id": "52a8161d-ae6d-3060-9311-d191e8f30ca9",
                                        "glosses": [
                                            "Schmutz, unerwünschte Substanz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44be2250-a388-423c-a228-ba1b1343c797",
                                                "sense_id": "3c69b42d-0536-3492-af8d-79cf6e0560df",
                                                "text": "Am selben Nachmittag noch mußten wir mit Winden und Holz dem Wagen mit den Platten entgegenfahren, er war im Dreck stecken geblieben."
                                            },
                                            {
                                                "example_id": "1e9b437a-66f6-487f-af22-0a4990cc569a",
                                                "sense_id": "3c69b42d-0536-3492-af8d-79cf6e0560df",
                                                "text": "Toni war ein Luzerner und hatte acht Kinder, alle schön, rot wie Milch und Blut, und schlank wie die Tannen im Walde, mit Zähnen weiß wie Schnee; aber mit Dreck waren alle überzogen wie mit einem Firniß, um die darunter liegende, durchschimmernde schöne, zarte Haut zu bewahren vor Kälte und Wind."
                                            },
                                            {
                                                "example_id": "b99e9560-3dc7-4bad-88f5-cc2ddee926a8",
                                                "sense_id": "3c69b42d-0536-3492-af8d-79cf6e0560df",
                                                "text": "Ich denke an wahnsinnig viel überflüssiges, glitzerndes Zeug, das viel Geld kostet und dann viel Platz braucht und bei Autos auch noch viel Dreck macht."
                                            },
                                            {
                                                "example_id": "cbb06d5b-2f53-42a7-a3df-384944deaef7",
                                                "sense_id": "3c69b42d-0536-3492-af8d-79cf6e0560df",
                                                "text": "Dreck ist wie das Schwarze unter dem Fingernagel: Materie am falschen Ort."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5660950b-2883-3b26-8d19-52a966b66b47",
                                        "entry_id": "52a8161d-ae6d-3060-9311-d191e8f30ca9",
                                        "glosses": [
                                            "etwas, was als minderwertig, wertlos angesehen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3d12695-2b90-491a-8d06-27c333016ba2",
                                                "sense_id": "5660950b-2883-3b26-8d19-52a966b66b47",
                                                "text": "Als der Feldwebel der Mannschaft die Sache vorhielt, war für einen Augenblick wieder Alles gut, bald aber wurden sie wieder rebellisch, gingen zum Feldwebel und sprachen, er könne nicht wissen, ob die Königstochter ihn und sie zu Narren halte; am Ende sei die ganze Geschichte erlogen und statt seiner Prinzessin hätte jeder einen Dreck; sie wollten sich von der Wahrheit überzeugen und ihre künftigen Gemahlinnen sehen."
                                            },
                                            {
                                                "example_id": "0366c028-13e3-45a1-899f-8e32f43d3674",
                                                "sense_id": "5660950b-2883-3b26-8d19-52a966b66b47",
                                                "text": "In der Werbung wird aber für jeden Dreck komponiert."
                                            },
                                            {
                                                "example_id": "ab477264-2e3f-4398-84ca-2bda79522735",
                                                "sense_id": "5660950b-2883-3b26-8d19-52a966b66b47",
                                                "text": "Vor ihm schon hatte der „Nörgler“ Schopenhauer sein ignorantes Verdikt ausgesprochen: „Weil die Leute, statt des Besten aller Zeiten, immer nur das Neueste lesen, bleiben die Schriftsteller im engen Kreise der circulierenden Ideen, und das Zeitalter verschlammt immer tiefer in seinem eigenen Dreck.“"
                                            },
                                            {
                                                "example_id": "a058c21b-c3aa-4961-aaf2-550e8313096c",
                                                "sense_id": "5660950b-2883-3b26-8d19-52a966b66b47",
                                                "text": "Warum muss man sich jeden Dreck von Regisseuren wie Neuenfels, für die Provokationen anscheinend Selbstzweck sind und die damit von ihrer Ideenlosigkeit ablenken wollen, gefallen lassen?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f6d937dd-b2d9-3cff-8d92-0411dd9423e8",
                                        "entry_id": "52a8161d-ae6d-3060-9311-d191e8f30ca9",
                                        "glosses": [
                                            "Ausscheidungen des Verdauungssystems"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "950d9aa3-8d48-4f36-aa12-d61b4ca24910",
                                                "sense_id": "f6d937dd-b2d9-3cff-8d92-0411dd9423e8",
                                                "text": "Am Morgen fand sich in jedem Nachttopf ein Dreck."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
