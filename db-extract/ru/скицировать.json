                "translations": [
                    {
                        "translation_id": "31887ad5-7a7d-4948-805c-2b6aa53cb926",
                        "source_entry_id": "6c0796fa-fc3b-3e32-97d6-72a2423b3c70",
                        "source_sense_id": "40746f0d-1c95-3e69-a08f-4fdf22da7b81",
                        "target_lang_word": "skizzieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skizzieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e55201d7-a51d-314c-8b92-472a663a8a0e",
                                        "entry_id": "4ad99c18-6416-36d4-bbaa-6a7874ea03e7",
                                        "glosses": [
                                            "eine mittels groben Strichen knapp gehaltene, bildliche Darstellung - die als Studie oder Vorzeichnung dienen kann - anfertigen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef1f85ee-b86d-4231-9b1c-e84af6392b70",
                                                "sense_id": "e55201d7-a51d-314c-8b92-472a663a8a0e",
                                                "text": "In der S-Bahn skizzierte sie Menschen, die ihr gegenüber saßen."
                                            },
                                            {
                                                "example_id": "eff39826-c792-47ab-b839-f3d3186f60fe",
                                                "sense_id": "e55201d7-a51d-314c-8b92-472a663a8a0e",
                                                "text": "„Von acht bis elf Uhr arbeiten wir in der Zeichenschule, dann bis eins Modellieren, nachmittags noch zwei Stunden zeichnen und dann der Abendakt. Außerdem skizzieren, soviel es geht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d08686d7-e424-3621-a191-afc596c7a345",
                                        "entry_id": "4ad99c18-6416-36d4-bbaa-6a7874ea03e7",
                                        "glosses": [
                                            "einen unausgefeilten, ungenauen Grundriss, Riss oder Schema zeichnerisch anlegen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8713e978-4535-403c-9d43-d16c63c7c8c7",
                                                "sense_id": "d08686d7-e424-3621-a191-afc596c7a345",
                                                "text": "Architekten skizzieren häufig zunächst ihre geplanten Gebäude, von denen sie später genaue Baupläne anfertigen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "747ef539-2ae0-3707-9bc1-c3d3af393137",
                                        "entry_id": "4ad99c18-6416-36d4-bbaa-6a7874ea03e7",
                                        "glosses": [
                                            "etwas gerafft, stichwortartig darstellen"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b37469d-33be-4421-9839-4bad74f1f0ac",
                                                "sense_id": "747ef539-2ae0-3707-9bc1-c3d3af393137",
                                                "text": "„Es sei mir gestattet, in Kürze mein geistiges Vorleben zu skizzieren, bevor ich es unternehme, von selbständiger Tribüne zu einem Forum zu sprechen, auf welchem Dank dem Marktgeschrei der täglich zweimal verfälschten öffentlichen Meinung der ehrliche Mann sein eigenes Wort nicht hört.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4282ebfe-b2ef-31f1-822a-45a5fe733f7a",
                                        "entry_id": "4ad99c18-6416-36d4-bbaa-6a7874ea03e7",
                                        "glosses": [
                                            "etwas konzeptuell, notizenhaft entwerfen"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d103c988-4b0e-4cd9-9e56-d56f1aa10d0e",
                                                "sense_id": "4282ebfe-b2ef-31f1-822a-45a5fe733f7a",
                                                "text": "Sie skizzierten den Text für die Rede des Präsidenten."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
