{
    "word_family": [
        "concoction",
        "concoctive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ad11c1c-9b61-39cd-bd37-1407c7a15079",
                    "sense_definition": "To prepare something by mixing different ingredients together, especially unusual foods or drinks.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mix_prepare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef decided to <w>concoct</w> a delicious new soup using leftover vegetables and herbs.",
                            "target_lang_translations": {
                                "tr": "Şef, arta kalan sebzeleri ve otları kullanarak lezzetli yeni bir çorba <w>hazırlamaya</w> karar verdi."
                            }
                        },
                        {
                            "text": "The children liked to <w>concoct</w> a strange potion using mud, petals, and rainwater.",
                            "target_lang_translations": {
                                "tr": "Çocuklar çamur, çiçek yaprakları ve yağmur suyu kullanarak tuhaf bir iksir <w>yapmayı</w> severlerdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "prepare",
                        "mix"
                    ],
                    "common_phrases": [
                        "concoct a potion",
                        "concoct a dish"
                    ],
                    "target_lang_definitions": {
                        "tr": "Farklı malzemeleri, özellikle alışılmadık yiyecek veya içecekleri bir araya getirerek karıştırıp hazırlamak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "karıştırıp hazırlamak",
                                "target_lang_sense_clarification": "yiyecek veya içecek"
                            },
                            {
                                "target_lang_word": "uydurmak",
                                "target_lang_sense_clarification": "eldeki malzemelerle ortaya bir şey çıkarmak"
                            },
                            {
                                "target_lang_word": "meczetmek",
                                "target_lang_sense_clarification": "eski dilde karıştırmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "358eb551-197c-32c4-bd1e-666de4917139",
                    "sense_definition": "To invent or contrive a story, explanation, or plan, often with the intention of deceiving someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "invent_devise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>concoct</w> an elaborate excuse to explain why he was late to the meeting.",
                            "target_lang_translations": {
                                "tr": "Toplantıya neden geç kaldığını açıklamak için ayrıntılı bir mazeret <w>uydurmayı</w> başardı."
                            }
                        },
                        {
                            "text": "The thieves had to <w>concoct</w> a plan to sneak past the guards unnoticed.",
                            "target_lang_translations": {
                                "tr": "Hırsızlar muhafızların yanından fark edilmeden gizlice geçebilmek için bir plan <w>tertip etmek</w> zorunda kaldılar."
                            }
                        }
                    ],
                    "synonyms": [
                        "contrive",
                        "plot",
                        "scheme"
                    ],
                    "common_phrases": [
                        "concoct an excuse",
                        "concoct a story",
                        "concoct a plan"
                    ],
                    "target_lang_definitions": {
                        "tr": "Genellikle birini kandırmak veya ikna etmek amacıyla bir hikâye, mazeret ya da plan uydurmak, tasarlamak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "uydurmak",
                                "target_lang_sense_clarification": "yalan, mazeret veya hikâye"
                            },
                            {
                                "target_lang_word": "düzmek",
                                "target_lang_sense_clarification": "plan ya da bahane hazırlamak"
                            },
                            {
                                "target_lang_word": "tertip etmek",
                                "target_lang_sense_clarification": "düzenlemek, plan kurmak"
                            },
                            {
                                "target_lang_word": "tasarlamak",
                                "target_lang_sense_clarification": "plan kurmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0315eac-0600-3dfd-93a2-bbfda79796d7",
                    "sense_definition": "To digest food in the stomach.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "digest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient physicians believed the stomach needed natural heat to <w>concoct</w> heavy meals properly.",
                            "target_lang_translations": {
                                "tr": "Eski hekimler, ağır yemekleri düzgün bir şekilde <w>sindirmek</w> için midenin doğal bir ısıya ihtiyaç duyduğuna inanırlardı."
                            }
                        },
                        {
                            "text": "The patient struggled to <w>concoct</w> any solid nourishment due to his weak digestive system.",
                            "target_lang_translations": {
                                "tr": "Hasta, zayıf sindirim sistemi nedeniyle katı gıdaları <w>hazmetmekte</w> zorlanıyordu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in archaic medical contexts meaning to digest"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Midede besinleri sindirmek (eski tıp terimi)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sindirmek",
                                "target_lang_sense_clarification": "midede hazmetmek"
                            },
                            {
                                "target_lang_word": "hazmetmek",
                                "target_lang_sense_clarification": "yiyeceği vücutta işlemek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6381d472-d9f1-359e-957b-bcb82bc74972",
                    "sense_definition": "A concoction; something created by mixing various elements.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mix_prepare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He looked at the bizarre <w>concoct</w> in the glass and wondered if it was safe to drink.",
                            "target_lang_translations": {
                                "tr": "Bardaktaki tuhaf <w>karışıma</w> baktı ve bunu içmenin güvenli olup olmadığını merak etti."
                            }
                        },
                        {
                            "text": "The strange tale was merely a <w>concoct</w> of his vivid imagination.",
                            "target_lang_translations": {
                                "tr": "Bu tuhaf hikâye, yalnızca onun canlı hayal gücünün bir <w>ürünüydü</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or archaic noun usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Farklı unsurların bir araya getirilmesiyle oluşturulmuş karışım veya uydurma şey (eski kullanım)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "karışım",
                                "target_lang_sense_clarification": "çeşitli şeylerin birleşimi"
                            },
                            {
                                "target_lang_word": "terkip",
                                "target_lang_sense_clarification": "bileşim"
                            },
                            {
                                "target_lang_word": "uydurma",
                                "target_lang_sense_clarification": "zihinde kurulan şey"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7bc7a949-7eb0-3a53-838e-516236b79ec4",
                    "sense_definition": "Digested or altered by heat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "digest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The alchemist examined the fully <w>concoct</w> juices after several hours over the flame.",
                            "target_lang_translations": {
                                "tr": "Simyacı, alevin üzerinde saatler geçirdikten sonra tamamen <w>olgunlaşmış</w> özleri inceledi."
                            }
                        },
                        {
                            "text": "Only food properly <w>concoct</w> by internal heat could yield healthy humors according to ancient texts.",
                            "target_lang_translations": {
                                "tr": "Kadim metinlere göre ancak içsel ısıyla düzgünce <w>sindirilmiş</w> gıdalar sağlıklı beden sıvıları üretebilirdi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Obsolete adjective meaning digested or matured by heat"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Isı ile sindirilmiş, olgunlaştırılmış veya başkalaştırılmış (eski kullanım)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sindirilmiş",
                                "target_lang_sense_clarification": "ısı vasıtasıyla hazmedilmiş"
                            },
                            {
                                "target_lang_word": "olgunlaşmış",
                                "target_lang_sense_clarification": "ısıyla dönüşmüş"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}