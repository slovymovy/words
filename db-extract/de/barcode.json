                "senses": [
                    {
                        "sense_id": "7c9b374f-9880-344d-a665-a67a2c56639f",
                        "entry_id": "f53dd63c-48fb-3054-a843-047c5ee76492",
                        "glosses": [
                            "optoelektronisch lesbare Schrift, die aus verschieden breiten, parallelen Strichen und Lücken besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9e37845-d058-4a31-9eb6-525c001ce8e5",
                                "sense_id": "7c9b374f-9880-344d-a665-a67a2c56639f",
                                "text": "Mit Barcodes kann der Normal-Sterbliche nichts anfangen."
                            },
                            {
                                "example_id": "7c08fa0d-47a2-4cf1-89b3-ff72925f1ef9",
                                "sense_id": "7c9b374f-9880-344d-a665-a67a2c56639f",
                                "text": "Auch Bücher in Bibliotheken sind heute häufig mit einem Barcode versehen, um das Ausleihen und die Rückgabe zu erleichtern."
                            },
                            {
                                "example_id": "6705b3d4-8d7a-4d46-a8ff-7cb396e97832",
                                "sense_id": "7c9b374f-9880-344d-a665-a67a2c56639f",
                                "text": "„Mittlerweile wurde dem Barcode schon mehrmals das Ableben vorausgesagt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
