                ],
                "senses": [
                    {
                        "sense_id": "a913eea2-d290-35c1-b1e4-aad653cd48e1",
                        "entry_id": "a7988536-5ccb-3c6d-a9f3-5dd05a93276a",
                        "glosses": [
                            "Silicate de magnésium et de fer très abondant dans le manteau terrestre, de formule (Mg,Fe)SiO₃."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98db0e32-3558-4161-a169-3dd41f8c7722",
                                "sense_id": "a913eea2-d290-35c1-b1e4-aad653cd48e1",
                                "text": "La bridgmanite représente plus du tiers des roches de la terre, mais elle n’existe que dans le manteau inférieur."
                            },
                            {
                                "example_id": "e28f8fc1-6f4d-4955-86fa-bcd217837008",
                                "sense_id": "a913eea2-d290-35c1-b1e4-aad653cd48e1",
                                "text": "Le passage de la zone de transition au manteau inférieur est marqué par le passage de la ringwoodite (γ-Mg₂SiO₄) à un ensemble comprenant la pérovskite magnésienne (Mg,Fe)SiO₃ comportant un peu d’aluminium, parfois appelée bridgmanite, et la magnésiowüstite (Mg,Fe)O, tandis que les grenats majorite évoluent en pérovskite calcique (Fig.2.06). La bridgmanite constituerait 93 % du manteau inférieur. Dans les parties profondes du manteau inférieur, la bridgmanite fait place à une forme de plus haute pression appelée « post-pérovskite »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "731f5106-604b-4708-b6f6-9fed6ac49f82",
                        "source_entry_id": "a7988536-5ccb-3c6d-a9f3-5dd05a93276a",
                        "source_sense_id": "a913eea2-d290-35c1-b1e4-aad653cd48e1",
                        "target_lang_word": "Bridgmanit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bridgmanit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35d448eb-a899-32f2-8c68-aed27bb31143",
                                        "entry_id": "39f0ac6e-8a85-352c-bc3f-c00a060d5b23",
                                        "glosses": [
                                            "unter extrem hohem Druck entstehendes Mineral aus der Gruppe der Silikat-Perowskite"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5966c84f-027a-4b36-85d4-34ce224861fc",
                                                "sense_id": "35d448eb-a899-32f2-8c68-aed27bb31143",
                                                "text": "Es macht fast 40 Prozent unseres Planeten aus, doch die meisten Menschen haben noch nie davon gehört: Das Mineral Bridgmanit existiert nur tief im Erdinneren - und in Meteoriten."
                                            },
                                            {
                                                "example_id": "14861642-2b39-45aa-b715-04805f8bd6de",
                                                "sense_id": "35d448eb-a899-32f2-8c68-aed27bb31143",
                                                "text": "Hinweise auf die Kristallstruktur von Bridgmanit hatten zuvor auch Versuche im Labor geliefert. Darin erhitzten Forscher in speziellen Hochdruckpressen mit Lasern eine zwischen zwei Diamantspitzen zusammengedrückte Probe eines anderen Minerals - und erzeugten so Bridgmanit."
                                            },
                                            {
                                                "example_id": "0079a928-15df-48e9-882d-7f8657faf892",
                                                "sense_id": "35d448eb-a899-32f2-8c68-aed27bb31143",
                                                "text": "Bridgmanit konnte bisher nur in Form mikrokristalliner Körner als Einschlüsse in einem in Australien niedergegangenen Meteoriten nachgewiesen werden."
                                            },
                                            {
                                                "example_id": "4ac94d5a-7cda-4083-a344-2f39777613f4",
                                                "sense_id": "35d448eb-a899-32f2-8c68-aed27bb31143",
                                                "text": "Bei späteren Analysen des Meteoriten fanden die Wissenschaftler heraus, dass dieser zum Großteil aus Silikat-Perowskit (Bridgmanit) entsteht."
                                            },
                                            {
                                                "example_id": "48675569-c381-45fd-81c1-97efb89606eb",
                                                "sense_id": "35d448eb-a899-32f2-8c68-aed27bb31143",
                                                "text": "So konnten die Wissenschaftler zeigen, dass rund drei Viertel des unteren Erdmantels bis zu einer Tiefe von 1.200 Kilometern aus aluminium- und eisenhaltigem Bridgmanit bestehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
