{
    "word_family": [
        "legitimate",
        "legitimize",
        "legitimately"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "58e71e95-641f-334c-99ab-e8f9ea927107",
                    "sense_definition": "The quality or state of being lawful, valid, or justifiable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "validity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>legitimacy</w> of the new contract was questioned by the legal team.",
                            "target_lang_translations": {
                                "zh": "法律团队对这份新合同的<w>合法性</w>提出了质疑。"
                            }
                        },
                        {
                            "text": "Experts debated the <w>legitimacy</w> of the historical documents found in the archive.",
                            "target_lang_translations": {
                                "zh": "专家们就档案中发现的历史文件的<w>合法性</w>进行了辩论。"
                            }
                        }
                    ],
                    "synonyms": [
                        "legitimateness"
                    ],
                    "antonyms": [
                        "illegitimacy"
                    ],
                    "common_phrases": [
                        "question the legitimacy",
                        "establish legitimacy"
                    ],
                    "target_lang_definitions": {
                        "zh": "指事物合法、有效或合理的性质或状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "合法性",
                                "target_lang_sense_clarification": "指符合法律规定或规则的性质。"
                            },
                            {
                                "target_lang_word": "正当性",
                                "target_lang_sense_clarification": "指符合道理或逻辑，具有合理依据的性质。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b512e07e-95c1-3946-9698-4ab42f4fd9ed",
                    "sense_definition": "Public acceptance of an institution, authority, or system as right and proper.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "validity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government struggled to maintain its <w>legitimacy</w> after the economic crisis.",
                            "target_lang_translations": {
                                "zh": "经济危机过后，政府努力维持其执政的<w>合法性</w>。"
                            }
                        },
                        {
                            "text": "The organization gained <w>legitimacy</w> through its commitment to transparent democratic processes.",
                            "target_lang_translations": {
                                "zh": "该组织通过致力于透明的民主程序获得了公众的<w>认可</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "illegitimacy"
                    ],
                    "common_phrases": [
                        "political legitimacy",
                        "lose legitimacy"
                    ],
                    "target_lang_definitions": {
                        "zh": "指公众对机构、权威或制度作为正当且合理的认可。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "合法性",
                                "target_lang_sense_clarification": "在政治或社会语境下，指政权或机构被公众认可的地位。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc2377d0-86f7-3f20-ab8e-a17dc72aceeb",
                    "sense_definition": "The state of being born to parents who are legally married to each other.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the past, the <w>legitimacy</w> of an heir was essential for inheriting royal titles.",
                            "target_lang_translations": {
                                "zh": "在过去，继承人的<w>婚生地位</w>对于继承皇室头衔至关重要。"
                            }
                        },
                        {
                            "text": "Laws regarding the <w>legitimacy</w> of children have changed significantly in modern society.",
                            "target_lang_translations": {
                                "zh": "现代社会中关于子女<w>婚生地位</w>的法律已经发生了重大变化。"
                            }
                        }
                    ],
                    "antonyms": [
                        "illegitimacy"
                    ],
                    "target_lang_definitions": {
                        "zh": "指子女出生时父母处于合法婚姻关系中的状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "婚生地位",
                                "target_lang_sense_clarification": "法律术语，指子女是否为合法婚姻所生。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}