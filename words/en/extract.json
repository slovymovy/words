{
    "word_family": [
        "extraction",
        "extractor",
        "extractive",
        "extractable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6f909efa-b6b6-3412-bad7-c4fbddf9edf2",
                    "sense_definition": "To pull out or remove something forcibly from a fixed position.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dentist had to <w>extract</w> the damaged tooth because it was causing a severe infection.",
                            "target_lang_translations": {
                                "ru": "Стоматологу пришлось <w>удалить</w> поврежденный зуб, так как он вызывал сильную инфекцию."
                            }
                        },
                        {
                            "text": "He used a pair of tweezers to <w>extract</w> a splinter from his finger after working in the garden.",
                            "target_lang_translations": {
                                "ru": "Он использовал пинцет, чтобы <w>извлечь</w> занозу из пальца после работы в саду."
                            }
                        }
                    ],
                    "synonyms": [
                        "outdraw"
                    ],
                    "common_phrases": [
                        "extract a tooth",
                        "extract a splinter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Силой вытащить или удалить что-либо из фиксированного положения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извлекать",
                                "target_lang_sense_clarification": "вынимать или вытаскивать что-либо"
                            },
                            {
                                "target_lang_word": "удалять",
                                "target_lang_sense_clarification": "о зубе или занозе"
                            },
                            {
                                "target_lang_word": "вырывать",
                                "target_lang_sense_clarification": "с усилием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5334c429-4ed4-338e-9d52-cab5540a771e",
                    "sense_definition": "To obtain a substance from something else through a chemical or mechanical process like squeezing or distillation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "extraction_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists have developed a new method to <w>extract</w> oil from these deep rock formations.",
                            "target_lang_translations": {
                                "ru": "Ученые разработали новый метод, позволяющий <w>добывать</w> нефть из этих глубоких скальных образований."
                            }
                        },
                        {
                            "text": "It is possible to <w>extract</w> essential oil from lavender plants using a simple steam distillation process.",
                            "target_lang_translations": {
                                "ru": "Можно <w>получать</w> эфирное масло из лаванды, используя простой процесс паровой дистилляции."
                            }
                        }
                    ],
                    "common_phrases": [
                        "extract oil",
                        "extract essential oil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать вещество из чего-либо другого с помощью химического или механического процесса, такого как отжим или дистилляция."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добывать",
                                "target_lang_sense_clarification": "о полезных ископаемых или ресурсах"
                            },
                            {
                                "target_lang_word": "экстрагировать",
                                "target_lang_sense_clarification": "химический процесс"
                            },
                            {
                                "target_lang_word": "извлекать",
                                "target_lang_sense_clarification": "получать путем обработки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c53d1783-f858-3b68-952b-af06d8949ec6",
                    "sense_definition": "To select and take out a specific passage or piece of information from a text or document.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "citation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researcher managed to <w>extract</w> data from several old archives to support her thesis.",
                            "target_lang_translations": {
                                "ru": "Исследователю удалось <w>извлечь</w> данные из нескольких старых архивов для подтверждения своей диссертации."
                            }
                        },
                        {
                            "text": "I will <w>extract</w> a few quotes from the speech to include in my news report.",
                            "target_lang_translations": {
                                "ru": "Я <w>выпишу</w> несколько цитат из речи, чтобы включить их в свой новостной репортаж."
                            }
                        }
                    ],
                    "synonyms": [
                        "sunder out"
                    ],
                    "common_phrases": [
                        "extract data",
                        "extract a quote"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выбирать и брать определенный отрывок или часть информации из текста или документа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извлекать",
                                "target_lang_sense_clarification": "данные или информацию"
                            },
                            {
                                "target_lang_word": "выписывать",
                                "target_lang_sense_clarification": "цитаты или фрагменты"
                            },
                            {
                                "target_lang_word": "выбирать",
                                "target_lang_sense_clarification": "нужные части из текста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c64dfcfe-3c0c-353f-b113-26d349f7fe66",
                    "sense_definition": "To derive or select specific parts, such as meaning or value, from a larger whole.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "derivation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was difficult to <w>extract</w> the positives from such a devastating defeat on the field.",
                            "target_lang_translations": {
                                "ru": "Было трудно <w>извлечь</w> что-то положительное из такого сокрушительного поражения на поле."
                            }
                        },
                        {
                            "text": "The analyst tried to <w>extract</w> meaning from the complex set of statistics provided by the government.",
                            "target_lang_translations": {
                                "ru": "Аналитик пытался <w>понять</w> смысл сложного набора статистических данных, предоставленных правительством."
                            }
                        }
                    ],
                    "common_phrases": [
                        "extract the positives",
                        "extract meaning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выводить или выбирать определенные части, такие как смысл или ценность, из более крупного целого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извлекать",
                                "target_lang_sense_clarification": "пользу, смысл или уроки"
                            },
                            {
                                "target_lang_word": "черпать",
                                "target_lang_sense_clarification": "идеи или вдохновение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b9c36e1-cda3-3198-bc81-3f8c3747f3ef",
                    "sense_definition": "To calculate or determine the mathematical root of a number.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students were asked to <w>extract</w> the cube root of twenty-seven without using a calculator.",
                            "target_lang_translations": {
                                "ru": "Студентов попросили <w>извлечь</w> кубический корень из двадцати семи без использования калькулятора."
                            }
                        },
                        {
                            "text": "In advanced algebra, you must learn how to <w>extract</w> the square root of complex equations.",
                            "target_lang_translations": {
                                "ru": "В курсе высшей алгебры вы должны научиться <w>извлекать</w> квадратный корень из сложных уравнений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "extract the root",
                        "extract the square root"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical mathematical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вычислять или определять математический корень числа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извлекать",
                                "target_lang_sense_clarification": "математический корень"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf6128b0-240e-36f9-8a2e-a30e252d9895",
                    "sense_definition": "A concentrated substance prepared by drawing out the essential constituents of a plant or other material.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recipe calls for one teaspoon of pure vanilla <w>extract</w> to enhance the flavor of the cake.",
                            "target_lang_translations": {
                                "ru": "По рецепту требуется одна чайная ложка чистого ванильного <w>экстракта</w>, чтобы улучшить вкус торта."
                            }
                        },
                        {
                            "text": "Many people use malt <w>extract</w> as a nutritional supplement or for home brewing beer.",
                            "target_lang_translations": {
                                "ru": "Многие люди используют солодовый <w>экстракт</w> в качестве пищевой добавки или для домашнего пивоварения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vanilla extract",
                        "malt extract",
                        "plant extract"
                    ],
                    "target_lang_definitions": {
                        "ru": "Концентрированное вещество, приготовленное путем извлечения основных компонентов растения или другого материала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экстракт",
                                "target_lang_sense_clarification": "концентрированное извлечение"
                            },
                            {
                                "target_lang_word": "вытяжка",
                                "target_lang_sense_clarification": "вещество, извлеченное из ткани"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca48e5e2-14c4-3c8d-8479-4fefe4205607",
                    "sense_definition": "A short passage taken from a book, piece of music, or film.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "citation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher read a short <w>extract</w> from the novel to give the students a sense of the author's style.",
                            "target_lang_translations": {
                                "ru": "Учитель прочитал короткий <w>отрывок</w> из романа, чтобы дать ученикам представление о стиле автора."
                            }
                        },
                        {
                            "text": "This <w>extract</w> of the documentary highlights the most important discoveries made during the expedition.",
                            "target_lang_translations": {
                                "ru": "Этот <w>фрагмент</w> документального фильма освещает самые важные открытия, сделанные во время экспедиции."
                            }
                        }
                    ],
                    "common_phrases": [
                        "short extract",
                        "book extract"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий отрывок, взятый из книги, музыкального произведения или фильма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрывок",
                                "target_lang_sense_clarification": "часть произведения"
                            },
                            {
                                "target_lang_word": "выдержка",
                                "target_lang_sense_clarification": "цитата или выписка из текста"
                            },
                            {
                                "target_lang_word": "фрагмент",
                                "target_lang_sense_clarification": "небольшая часть целого"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4850545f-9ce3-3468-a785-b8041848acd7",
                    "sense_definition": "A person's origin, ancestry, or descent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ancestry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a talented musician of Italian <w>extract</w> who grew up in the heart of London.",
                            "target_lang_translations": {
                                "ru": "Он талантливый музыкант итальянского <w>происхождения</w>, выросший в самом центре Лондона."
                            }
                        },
                        {
                            "text": "The family can trace their <w>extract</w> back to the early settlers of the region.",
                            "target_lang_translations": {
                                "ru": "Семья может проследить свое <w>происхождение</w> до первых поселенцев региона."
                            }
                        }
                    ],
                    "synonyms": [
                        "origin",
                        "extraction"
                    ],
                    "common_phrases": [
                        "of foreign extract"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in the phrase 'of ... extract'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Происхождение, предки или корни человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "происхождение",
                                "target_lang_sense_clarification": "корни или предки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}