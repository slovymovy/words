                            {
                                "example_id": "a62f41bd-5102-4187-8a64-7a5ef3023c17",
                                "sense_id": "f59a4241-32b0-3996-8818-ff0873bdb4e0",
                                "text": "Het was nu of voorlopig niet voor het reddingsteam bij de Tham Luang-grot in Noord-Thailand. Het waterpeil was, na twee weken pompen en afwachten, eindelijk laag genoeg voor een reddingspoging. En met succes: vier van de twaalf jonge voetballers werden bevrijd."
                            },
                            {
                                "example_id": "4dd11b91-d06b-468e-9d38-d31a805c5baf",
                                "sense_id": "f59a4241-32b0-3996-8818-ff0873bdb4e0",
                                "text": "In de Argentijnse stad Mar del Plata spoelt een walvis aan. Ondanks een reddingspoging overleeft het dier het niet"
                            }
