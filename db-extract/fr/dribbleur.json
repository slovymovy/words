                        "sense_id": "9bfa7fa4-0656-3f5f-b2d5-327f3287bf2a",
                        "entry_id": "f9c42067-f6e3-3cc9-a362-2fb7a4d41294",
                        "glosses": [
                            "Joueur qui sait bien dribbler avec la balle ou le ballon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "518a238a-e17e-44a3-a100-4698facb4b11",
                                "sense_id": "9bfa7fa4-0656-3f5f-b2d5-327f3287bf2a",
                                "text": "C’est une excellente dribbleuse, la balle semble lui coller au pied."
                            },
                            {
                                "example_id": "01b19ade-94ee-4661-8b14-a68463328465",
                                "sense_id": "9bfa7fa4-0656-3f5f-b2d5-327f3287bf2a",
                                "text": "Pita n'était-il pas brésilien, nécessairement un dribbleur hors pair et un technicien de génie ?"
                            },
                            {
                                "example_id": "0262d75f-e3d1-4e2a-b4ae-7bee9420868f",
                                "sense_id": "9bfa7fa4-0656-3f5f-b2d5-327f3287bf2a",
                                "text": "Il avait un dribble incroyable : il courait sur le flanc droit, à la limite de la ligne de touche, […]. Il a arrêté de venir aux terrains en 1991. On n’a plus jamais vu un dribbleur aussi élégant."
                            }
                        ]
                    }
                ],
