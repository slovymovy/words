                "senses": [
                    {
                        "sense_id": "bfbc68f4-440e-38a1-aa58-de2418e10272",
                        "entry_id": "8d3e00a1-d802-30d3-ba50-5943b5234657",
                        "glosses": [
                            "Längsstreifen aus dem Stamminneren der Rotangpalme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a644ca33-0915-4824-98cd-3f2782d10398",
                                "sense_id": "bfbc68f4-440e-38a1-aa58-de2418e10272",
                                "text": "Peddigrohr ist zäh, elastisch und biegsam."
                            },
                            {
                                "example_id": "da64a89e-d388-4ab7-9d9b-770ec982f14b",
                                "sense_id": "bfbc68f4-440e-38a1-aa58-de2418e10272",
                                "text": "„Das Österreichische Hilfswerk für Taubblinde und hochgradig Hör- und Sehbehinderte produziert \"Lampienta\" von Madeleine Plass, runde Körbe aus eingefärbtem Peddigrohr, die es mühelos in jedes hochwertige Wohnmagazin schaffen, und das \"AWS Designteam\" bringt mit \"Jugend am Werk Horizont\" den \"Goodspoon\" heraus, einen feschen Kochlöffel aus rohem Bambusstamm, den auch ein Jasper Morrison kaum besser hingekriegt hätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e223dfdc-8313-4a24-8887-66acbf49d622",
                        "source_entry_id": "8d3e00a1-d802-30d3-ba50-5943b5234657",
                        "source_sense_id": "bfbc68f4-440e-38a1-aa58-de2418e10272",
                        "source_sense_description": "Längsstreifen aus dem Stamminneren der Rotangpalme",
                        "target_lang_word": "rattan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rattan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afd80822-b13a-37de-8b15-a1665a2a2550",
                                        "entry_id": "44926149-19cb-324d-a838-8bdf5f98c983",
                                        "glosses": [
                                            "Any of several species of climbing palm of the genus Calamus."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a734596e-7e84-38e8-a7b9-13e46ecf5bcd",
                                        "entry_id": "44926149-19cb-324d-a838-8bdf5f98c983",
                                        "glosses": [
                                            "The plant used as a material for making furniture, baskets etc."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c476bcf9-ebb2-412a-bc89-0734b6fb9841",
                                                "sense_id": "a734596e-7e84-38e8-a7b9-13e46ecf5bcd",
                                                "text": "It took Elwood an hour to find Mr. Gladwell, who sat in a big rattan chair at the edge of the sweet potato fields."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb4908b3-f71d-36f7-991c-cbdddbb70dd2",
                                        "entry_id": "44926149-19cb-324d-a838-8bdf5f98c983",
                                        "glosses": [
                                            "A cane made from this material."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cb55925-54ab-4995-99e7-1ad7839ce2ff",
                                                "sense_id": "eb4908b3-f71d-36f7-991c-cbdddbb70dd2",
                                                "text": "He who first acts as striker asks the other how many blows of the rattan he will bear on his forearm without crying out."
                                            },
                                            {
                                                "example_id": "0f86d199-12c8-4524-bd61-af87f3774c8f",
                                                "sense_id": "eb4908b3-f71d-36f7-991c-cbdddbb70dd2",
                                                "text": "“My Continental prominence is improving,” I commented dryly. ¶ Von Lindowe cut at a furze bush with his silver-mounted rattan. ¶ “Quite so,” he said as dryly, his hand at his mustache. “I may say if your intentions were known your life would not be worth a curse.”"
                                            },
                                            {
                                                "example_id": "2bb03be6-7d9e-4a8a-8cfb-0a64bb41b41b",
                                                "sense_id": "eb4908b3-f71d-36f7-991c-cbdddbb70dd2",
                                                "text": "[…]the rattan is still a valued instrument of discipline[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rattan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99453259-b150-372f-aa08-b4bef0565b83",
                                        "entry_id": "8c777bb8-4aa6-3f47-83a1-d568e6f07edf",
                                        "glosses": [
                                            "To beat with a rattan cane."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7e2d800-62a3-42bc-b065-cecaf15f4146",
                                                "sense_id": "99453259-b150-372f-aa08-b4bef0565b83",
                                                "text": "Meanwhile Captain Colville rattaned Pearson very severely […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2190bbf6-83e8-495b-ab3c-4720ce86bf7b",
                        "source_entry_id": "8d3e00a1-d802-30d3-ba50-5943b5234657",
                        "source_sense_id": "bfbc68f4-440e-38a1-aa58-de2418e10272",
                        "source_sense_description": "Längsstreifen aus dem Stamminneren der Rotangpalme",
                        "target_lang_word": "rotin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rotin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05126af7-3a0e-3e1e-8086-ad746852a778",
                                        "entry_id": "5b6696a2-99f4-34ac-9100-3e40d1770c4a",
                                        "glosses": [
                                            "Genre de palmiers, à tige flexible et annelée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d1bf374-fbdf-4df1-b6ce-822f9d822a57",
                                                "sense_id": "05126af7-3a0e-3e1e-8086-ad746852a778",
                                                "text": "Parmi les palmiers, les rotins méritent une mention spéciale. Réunissant environ 300 espèces, dont une cinquantaine est exploitée, les rotins sont présents en Afrique et en Asie du Sud-Est."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fb26ed0-c462-3142-9cdc-871d4a3d8d5f",
                                        "entry_id": "5b6696a2-99f4-34ac-9100-3e40d1770c4a",
                                        "glosses": [
                                            "Une tige de cette plante, quand utilisée à la confection d’un objet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3b20c6d-e48c-400b-959b-22f9eca81559",
                                                "sense_id": "2fb26ed0-c462-3142-9cdc-871d4a3d8d5f",
                                                "text": "Elle déplaça son corps bouffi, le fauteuil de rotin couina comme un tout petit lapin."
                                            },
                                            {
                                                "example_id": "5da81652-b615-4d31-9ae5-09e4bbc5897e",
                                                "sense_id": "2fb26ed0-c462-3142-9cdc-871d4a3d8d5f",
                                                "text": "Je possède aussi, et suis prêt à vous céder en prime car vous m’avez l’air bonne pâte, ajouta le bateleur passant de la coque à l'âne, une très belle crèche en rotin datant de 1982, pure expression de la tradition vannière quinocéenne."
                                            },
                                            {
                                                "example_id": "a25cae6a-5e74-4ab1-a1ba-5b734d467833",
                                                "sense_id": "2fb26ed0-c462-3142-9cdc-871d4a3d8d5f",
                                                "text": "Fauteuils, têtes de lit, paniers, miroirs soleil, luminaires… on ne compte plus les déclinaisons offertes par le rotin, l’osier et autre bambou, souvent mis dans le même sac des fibres exotiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd33c32e-2737-3d5b-8a92-35bdb3199351",
                                        "entry_id": "5b6696a2-99f4-34ac-9100-3e40d1770c4a",
                                        "glosses": [
                                            "Canne en tige de rotin."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e3126e5-7e49-4e48-916d-790d41542c48",
                                                "sense_id": "bd33c32e-2737-3d5b-8a92-35bdb3199351",
                                                "text": "Il avait un puissant rotin de deux cents francs à la main."
                                            },
                                            {
                                                "example_id": "3dcc44f3-674e-411e-bcb7-08e292da183a",
                                                "sense_id": "bd33c32e-2737-3d5b-8a92-35bdb3199351",
                                                "text": "J’ai vu mon père pendu par les mains, battu à coups de rotin sur le ventre, pour qu’il avouât où son maître avait caché l’argent qu’il ne possédait pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f882e255-5714-3589-bfa1-8e0e9ff6d329",
                                        "entry_id": "5b6696a2-99f4-34ac-9100-3e40d1770c4a",
                                        "glosses": [
                                            "Sonde de jonc pour dégorger les tuyaux des égouts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "705180e1-4a93-3487-bbfc-c22b378f820c",
                                        "entry_id": "5b6696a2-99f4-34ac-9100-3e40d1770c4a",
                                        "glosses": [
                                            "Piécette, menue monnaie."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbceca32-7997-4d75-a6f1-04101a569efc",
                                                "sense_id": "705180e1-4a93-3487-bbfc-c22b378f820c",
                                                "text": "Et les quelques rotins que lui verse aujourd’hui Le Pèlerin pour ses prônes, il trouve encore moyen d’en laisser les trois quarts aux pauvres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
