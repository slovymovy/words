                "senses": [
                    {
                        "sense_id": "5f4cc7d7-d42d-3ca2-84f4-2385bfa8e2db",
                        "entry_id": "bddff5bb-aca7-3124-98ce-f3293a34a330",
                        "glosses": [
                            "besonders großes Handtuch, das als Unterlage in der Sauna benutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f774bf0-91ad-4b55-8c6e-67d0944a03a3",
                                "sense_id": "5f4cc7d7-d42d-3ca2-84f4-2385bfa8e2db",
                                "text": "„Wer auch eine Runde in der Sauna schwitzen möchte, sollte sein Saunatuch nicht vergessen.“"
                            },
                            {
                                "example_id": "0c079dd4-591c-49da-a4a9-5ba1c6faa5e4",
                                "sense_id": "5f4cc7d7-d42d-3ca2-84f4-2385bfa8e2db",
                                "text": "„Ich lernte, auf einer Schneefläche von der Größe eines Saunatuches in der Weise eines Zen-Mönches stundenlang Kreise zu ziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7991c35a-046d-3c8f-b187-96f95a68fbb4",
                        "entry_id": "bddff5bb-aca7-3124-98ce-f3293a34a330",
                        "glosses": [
                            "feuchtes Tuch, das sich der Fluggast übers Gesicht legt"
                        ],
                        "tags": [
                            "Flugwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "a9039e7e-4397-46ca-ac8e-1bf7182f5512",
                                "sense_id": "7991c35a-046d-3c8f-b187-96f95a68fbb4",
                                "text": "„Hostessen, die schon auf den Bahnhöfen eilfertig beim Ein- und Aussteigen helfen, servieren während der Fahrt in jedem Wagen Snacks und Tee, Saunatücher und Zeitschriften.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
