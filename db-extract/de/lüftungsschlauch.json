                ],
                "senses": [
                    {
                        "sense_id": "e74e184f-3bd8-30cb-9529-4f38e8b3f75c",
                        "entry_id": "7a8b2eab-6b70-38ff-9c94-fd0656215769",
                        "glosses": [
                            "flexible Leitung durch die Luft strömt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c105195c-ce28-40d4-b26c-af8693cec9ef",
                                "sense_id": "e74e184f-3bd8-30cb-9529-4f38e8b3f75c",
                                "text": "„Wie die Feuerwehr bekannt gab, war beim Schweißen an einem Schiffsneubau ein Lüftungsschlauch in Brand geraten.“"
                            },
                            {
                                "example_id": "54ec59a0-7f6c-465d-8a4c-609d2b07aa77",
                                "sense_id": "e74e184f-3bd8-30cb-9529-4f38e8b3f75c",
                                "text": "„Der Sonoduct Flexschlauch ist ein schallgedämmter, lichtundurchlässiger , flexibler Lüftungsschlauch der sich für jede Art an Belüftungssystemen eignet.“"
                            },
                            {
                                "example_id": "134cb2a4-09a9-4e0b-ae2e-208b260f922c",
                                "sense_id": "e74e184f-3bd8-30cb-9529-4f38e8b3f75c",
                                "text": "„Im Pendlerverkehr am Montagmorgen platzte zwischen dem Stuttgarter Hauptbahnhof und Stadtmitte an einer S-Bahn der Linie 3 ein Lüftungsschlauch.“"
                            },
                            {
                                "example_id": "add24b4d-2c92-4ed2-beb3-d773d452b86b",
                                "sense_id": "e74e184f-3bd8-30cb-9529-4f38e8b3f75c",
                                "text": "„Das Luftverteilsystem SF mit rundem flexiblem Lüftungsschlauch aus Aluminiumfolie mit Wärmedämmung und Dampfsperre ist zur Installation innerhalb der wärmegedämmten Gebäudehülle (z.B. in Doppeldecken oder abgehängten Decken, Hohlwänden, Kniestock) geeignet.“"
                            },
                            {
                                "example_id": "ff0ec549-8f30-495b-a2e9-189939abc162",
                                "sense_id": "e74e184f-3bd8-30cb-9529-4f38e8b3f75c",
                                "text": "„Textile Lüftungsschläuche sorgen für eine nahezu zugfreie Belüftung und ermöglichen ein angenehmes Arbeiten im Büro oder Betrieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
