                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "penultimate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dad0ab3a-a51b-382f-a6f8-56f7b0ccb96e",
                                        "entry_id": "6253f2c3-67ef-3a25-9ede-13ce7e709f93",
                                        "glosses": [
                                            "Next to last, second to last; immediately preceding the end of a sequence, list, etc."
                                        ],
                                        "tags": [
                                            "UK",
                                            "literary",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7607d04-6207-4f05-8e3e-5629f05aa9a2",
                                                "sense_id": "dad0ab3a-a51b-382f-a6f8-56f7b0ccb96e",
                                                "text": "[…] they [the sounds of an echo] next strike the ultimate secondary object, then the penultimate and antepenultimate; […]"
                                            },
                                            {
                                                "example_id": "d7e47514-b7e4-4750-877c-81bb12b9dcf8",
                                                "sense_id": "dad0ab3a-a51b-382f-a6f8-56f7b0ccb96e",
                                                "text": "But it should frequently happen that offspring should resemble its penultimate rather than its latest phase, and should thus be more like a grand-parent than a parent."
                                            },
                                            {
                                                "example_id": "6e06fc8d-53de-43ba-babb-d894fa6acd7a",
                                                "sense_id": "dad0ab3a-a51b-382f-a6f8-56f7b0ccb96e",
                                                "text": "“Your clothes don't weigh more'n seven pounds. And seven from—hum—say one hundred an' twenty-three—one hundred an' sixteen is your stripped weight.”\nBut at the penultimate word, Mary cried out with sharp reproof:\n“Why, Billy Roberts, people don't talk about such things.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40a7042b-04ca-3fd0-83e1-afd4fa68d35d",
                                        "entry_id": "6253f2c3-67ef-3a25-9ede-13ce7e709f93",
                                        "glosses": [
                                            "Of or pertaining to a penult."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a84ce812-e95b-35dc-a6d5-159b3882a474",
                                        "entry_id": "6253f2c3-67ef-3a25-9ede-13ce7e709f93",
                                        "glosses": [
                                            "Relating to or denoting an element of a related collection of curves that is arbitrarily close to a degenerate form."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8851da67-df09-334c-94b0-cef76e4dac7f",
                                        "entry_id": "6253f2c3-67ef-3a25-9ede-13ce7e709f93",
                                        "glosses": [
                                            "pre-eminent, ultimate, best; par excellence, top-quality"
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8afd0e0-a6f6-4ca2-adde-b7a5871847e5",
                                                "sense_id": "8851da67-df09-334c-94b0-cef76e4dac7f",
                                                "text": "This Book is the Proud Purple Penultimate!!"
                                            },
                                            {
                                                "example_id": "54b67c15-489b-4e9e-9851-af65a5c4ea54",
                                                "sense_id": "8851da67-df09-334c-94b0-cef76e4dac7f",
                                                "text": "This treatment, where two therapists massage the body using warm oils infused with plant extracts, is truly the penultimate experience."
                                            },
                                            {
                                                "example_id": "c9859db6-fce5-4404-bddd-3544adabe2d1",
                                                "sense_id": "8851da67-df09-334c-94b0-cef76e4dac7f",
                                                "text": "Ultimately, I reach the most penultimate existential questions: “What is the meaning of this? Is there any?”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "penultimate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21d8df38-383e-3470-8bf3-699257efb900",
                                        "entry_id": "8c2e53c2-ec8a-345b-ab70-9f51b45a999f",
                                        "glosses": [
                                            "A penult, a next to last, particularly"
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15551a29-f76a-419e-802b-e8c65dc4c944",
                                                "sense_id": "21d8df38-383e-3470-8bf3-699257efb900",
                                                "text": "Our Lutheran concern for the ultimates (the Gospel) has allowed us to neglect some of the penultimates (bodily healing), failing to stress the total implications of that ultimate Gospel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbfd653e-4b1f-3c22-ae18-93f6d1d08e1b",
                                        "entry_id": "8c2e53c2-ec8a-345b-ab70-9f51b45a999f",
                                        "glosses": [
                                            "A penult, a next to last",
                                            "The penultimate day of a month."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56f2a459-1bde-4916-8a30-8c621709d67a",
                                                "sense_id": "cbfd653e-4b1f-3c22-ae18-93f6d1d08e1b",
                                                "text": "At Woodstock, the penultimate of August."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fb58f5f-6157-33bb-8bcc-b0e37bb0a7b5",
                                        "entry_id": "8c2e53c2-ec8a-345b-ab70-9f51b45a999f",
                                        "glosses": [
                                            "A penult, a next to last",
                                            "The penultimate syllable of a word or metrical line."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f9f99b9-b124-4f32-a9b0-ba6b09f7e4b6",
                                                "sense_id": "2fb58f5f-6157-33bb-8bcc-b0e37bb0a7b5",
                                                "text": "Antepenultimate is that before the Penultimate, or the last but two."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f917746d-065f-3cb2-b55d-d3a6dfac108e",
                                        "entry_id": "8c2e53c2-ec8a-345b-ab70-9f51b45a999f",
                                        "glosses": [
                                            "A penult, a next to last",
                                            "The penultimate element of a collection of curves."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare",
                                            "uncommon"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "55ba9d38-f29a-3b1a-a90b-dbdf37454878",
                                        "entry_id": "8c2e53c2-ec8a-345b-ab70-9f51b45a999f",
                                        "glosses": [
                                            "A penult, a next to last",
                                            "The penultimate (next to lowest) card in a suit."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88dd588b-c620-4a81-8145-8f038790539f",
                                                "sense_id": "55ba9d38-f29a-3b1a-a90b-dbdf37454878",
                                                "text": "Penultimate, the. — Beginning with the lowest card but one of the suit you lead originally, if it contains more than four cards."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4f1074e-3f57-4c40-97d4-1ad626ec6926",
                        "source_entry_id": "4bf9c43a-b325-3615-b47f-a8925268e3f9",
                        "source_sense_id": "132d7986-2661-38f4-b7ee-a79ef773c0ce",
