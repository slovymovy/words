                    {
                        "sense_id": "2177e2b3-b592-3b7c-b6e1-200632844171",
                        "entry_id": "279adeef-f83b-3f70-9155-0bb88d155196",
                        "glosses": [
                            "archäologischer Fundplatz in Mexiko, während der präklassischen Periode ein wichtiges regionales Zentrum in Zentralmexiko"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f088348c-bcd1-4619-b168-b0f954aef6a6",
                                "sense_id": "2177e2b3-b592-3b7c-b6e1-200632844171",
                                "text": "„Und im zentralen Becken im Herzen Mexikos blühte ab 200 vor unserer Zeit ein Stadtstaat namens Cuicuilco auf.“"
                            },
                            {
                                "example_id": "1ff873be-b4f3-472a-afd7-c4625ccc3339",
                                "sense_id": "2177e2b3-b592-3b7c-b6e1-200632844171",
                                "text": "„Wir finden im Hochtal von Mexiko aber auch spektakuläre Zeugnisse zeitgenössischer Zivilisation, zum Beispiel die gestufte Rundpyramide in Cuicuilco, am Südrand der modernen Stadt Mexiko.“"
                            }
                        ],
