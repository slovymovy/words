                    },
                    {
                        "sense_id": "683a986e-237b-3a60-ae89-261d03148284",
                        "entry_id": "1112ef22-8ef4-3ef3-ac8e-1674fbb11a51",
                        "glosses": [
                            "istota, sedno"
                        ],
                        "tags": [],
