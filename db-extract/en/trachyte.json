                ],
                "senses": [
                    {
                        "sense_id": "3f797d69-54a6-353e-ae21-af38efe0b477",
                        "entry_id": "dd00c3c6-8fe7-32c4-bce1-0b081b57e30f",
                        "glosses": [
                            "A pale igneous rock consisting mostly of potassium feldspar and plagioclase."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5e2dddd4-ed6c-4e2f-a384-7c98845b3ae6",
                                "sense_id": "3f797d69-54a6-353e-ae21-af38efe0b477",
                                "text": "The type of rock that results is often described as trachyte and contains abundant crystals of a different kind of alkali-rich feldspar, such as sanidine, rather than plagioclase."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ecb7c2f-fc17-4891-a5a6-73aeef2d5b68",
                        "source_entry_id": "dd00c3c6-8fe7-32c4-bce1-0b081b57e30f",
                        "source_sense_id": "3f797d69-54a6-353e-ae21-af38efe0b477",
