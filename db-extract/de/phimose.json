                                        "entry_id": "3a5cd21b-3d44-32a0-978e-d57206702352",
                                        "glosses": [
                                            "A contraction of the foreskin (either as a stage of development or a pathological condition), which prevents it from being retracted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc534af2-a4fe-4bf8-8829-d826bea6de43",
                                                "sense_id": "f1d4326f-6678-3ffd-bd8c-25c64c3441e0",
                                                "text": "’Twill end in a phimosis, replied Dr. Slop."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c9022f0-c59f-44cf-86c5-374b4d9f9999",
                        "source_entry_id": "933dc6e2-ded6-319d-89f0-0925f7944e06",
                        "source_sense_id": "ad0f390f-f53e-3ae6-94a5-bd049d73d3bf",
                        "source_sense_description": "Verengung der Vorhaut",
                        "target_lang_word": "phimosis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phimosis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6cedccd3-1514-372d-92d8-f20730e0b9b8",
                                        "entry_id": "2cf3e541-1516-3960-8081-b9682efa32d9",
                                        "glosses": [
                                            "Affection, généralement congénitale, du prépuce du pénis, ou du capuchon du clitoris qui, lors de l'érection, ne peut se rétracter, le gland ne pouvant pas se décalotter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f92a741-b9f4-4842-999b-b7e320c5f660",
                                                "sense_id": "6cedccd3-1514-372d-92d8-f20730e0b9b8",
                                                "text": "Il convient d’intervenir chirurgicalement, en cas de phimosis serré, pour éviter l’étranglement éventuel du gland."
                                            },
                                            {
                                                "example_id": "96157d7f-951b-4a42-a426-e3fb0592971c",
                                                "sense_id": "6cedccd3-1514-372d-92d8-f20730e0b9b8",
                                                "text": "Comme j’avais, par ailleurs, congénitalement tendance au phimosis (ce qui me fut plus tard une grande source de honte, quand je comparais mon membre à celui des autres garçons) il fut à cette époque question de me circoncire, mais on n’eut pas besoin, en fin de compte, d’une telle intervention."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
