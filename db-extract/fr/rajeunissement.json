                "senses": [
                    {
                        "sense_id": "81ac22bc-4a5b-3fcd-b6b4-963489505a47",
                        "entry_id": "6b8483e5-60aa-32ea-b34b-21f3c67b1ad8",
                        "glosses": [
                            "Action de rajeunir ; état de celui qui est ou paraît rajeuni."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f722c39d-8981-4037-950c-5672a69f9ed4",
                                "sense_id": "81ac22bc-4a5b-3fcd-b6b4-963489505a47",
                                "text": "Pour ce rajeunissement numérique, James Cameron a utilisé des archives vidéo."
                            },
                            {
                                "example_id": "ec94ff3c-e622-475d-9eef-581879d312b3",
                                "sense_id": "81ac22bc-4a5b-3fcd-b6b4-963489505a47",
                                "text": "La vieillesse n'était pas une fatalité : elle pouvait être contrecarrée ou au moins retardée par la stimulation des facteurs de rajeunissement."
                            },
                            {
                                "example_id": "ee05a819-dc68-46c6-a232-df0c324af3e8",
                                "sense_id": "81ac22bc-4a5b-3fcd-b6b4-963489505a47",
                                "text": "Le porte-avions va être rééquipé, avec des installations dernier cri, pour repartir faire la guerre avec des moyens ultramodernes. « L’équivalent d’une greffe de cerveau », explique au « Monde » (17/6) un spécialiste du rajeunissement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c92d9b87-b0b3-4d61-a23c-11fd1f9252b1",
                        "source_entry_id": "6b8483e5-60aa-32ea-b34b-21f3c67b1ad8",
                        "source_sense_id": "81ac22bc-4a5b-3fcd-b6b4-963489505a47",
                        "target_lang_word": "rejuvenation",
