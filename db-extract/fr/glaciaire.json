                        ]
                    },
                    {
                        "translation_id": "2d25653d-29fc-43a4-8967-9f9ea2b3718d",
                        "source_entry_id": "11bd4a0a-9566-3fff-8346-c187cf3e53d8",
                        "target_lang_word": "ледниковый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ледниковый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dff65bd0-ad9d-3215-9ea0-6380f21c896f",
                                        "entry_id": "61465f1a-7004-3d1c-b748-5a4d63511412",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным ле́дник"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48671351-f472-3d0a-bb41-e3091dbe68da",
                                        "entry_id": "61465f1a-7004-3d1c-b748-5a4d63511412",
                                        "glosses": [
                                            "свойственный леднику, характерный для него"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ледниковый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3ff014a7-5148-30f5-83d7-5afbafe659b9",
                                        "entry_id": "8dce3be9-7671-3ac0-8a34-d4dc4a61261e",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным ледни́к; свойственный, характерный для ледника"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a13c926c-b041-45db-9d59-5e10a7095ede",
                                                "sense_id": "3ff014a7-5148-30f5-83d7-5afbafe659b9",
                                                "text": "Ледниковые трещины скрыты под снегом, озера подернуты тонким, надламливающимся от человеческой ноги льдом."
                                            },
                                            {
                                                "example_id": "38b4b2f2-1817-4d24-90af-54773e92c4a9",
                                                "sense_id": "3ff014a7-5148-30f5-83d7-5afbafe659b9",
                                                "text": "Опять по широким долинам Хибинских гор медленно ползли ледниковые языки, преобразуя их в широкие корытообразные троги и нагромождая у подножья гор груды моренного материала."
                                            },
                                            {
                                                "example_id": "b3decb91-51f0-4514-b206-a4898e9f4fe1",
                                                "sense_id": "3ff014a7-5148-30f5-83d7-5afbafe659b9",
                                                "text": "При обычных путешествиях по долинам и по нетрудным перевалам можно обойтись и без него, но ледниковый перевал требует уже применения ледоруба."
                                            },
                                            {
                                                "example_id": "2582ae11-d0dc-4759-81fb-14e33df7f6ed",
                                                "sense_id": "3ff014a7-5148-30f5-83d7-5afbafe659b9",
                                                "text": "Для рационального использования водных ресурсов горно-ледниковых областей необходимы учет ледников и выяснение закономерностей режима рек, питающихся талыми ледниковыми водами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d56951de-3f93-3cbb-b430-c07e9641611e",
                                        "entry_id": "8dce3be9-7671-3ac0-8a34-d4dc4a61261e",
                                        "glosses": [
                                            "образованный ледником"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba0fc1b3-df00-4ca9-af3e-e9ee1b6aa74d",
                                                "sense_id": "d56951de-3f93-3cbb-b430-c07e9641611e",
                                                "text": "Река Итья в пределах Урала, протекая по широкой ледниковой долине, имеет ряд перекатов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f15999b5-aad7-3e07-8561-7c21d82bf6cf",
                                        "entry_id": "8dce3be9-7671-3ac0-8a34-d4dc4a61261e",
                                        "glosses": [
                                            "геол. относящийся к периоду оледенения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a40348a5-8fa0-40b9-be05-fbd768574b4d",
                                                "sense_id": "f15999b5-aad7-3e07-8561-7c21d82bf6cf",
                                                "text": "Лишь на отдельных участках, преимущественно на возвышениях, волны уже успели разрушить почву и теперь размывают древние ледниковые отложения."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
