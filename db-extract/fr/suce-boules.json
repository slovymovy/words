                    {
                        "sense_id": "006517c7-e0ca-33cd-b8bd-2db24bdeb411",
                        "entry_id": "f5a72d21-018e-3dba-8b67-19689d7a76af",
                        "glosses": [
                            "Léche-cul, lèche-bottes."
