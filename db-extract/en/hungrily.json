                                "target_senses": [
                                    {
                                        "sense_id": "712da004-7033-3c82-b1ce-2c14e0c573df",
                                        "entry_id": "df0fc9ab-06bf-3aa6-88f2-46aacfd8eab0",
                                        "glosses": [
                                            "D’une manière avide ; avec avidité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "427607ab-6569-4e09-b83c-2caa4257ebe8",
                                                "sense_id": "712da004-7033-3c82-b1ce-2c14e0c573df",
                                                "text": "L’homme souleva ma tête avec des mouvements doux, me fit boire quelques gorgées d’un breuvage que j’avalai avidement."
                                            },
                                            {
                                                "example_id": "af47a634-919d-4d99-bc0f-a234c43e4f8c",
                                                "sense_id": "712da004-7033-3c82-b1ce-2c14e0c573df",
                                                "text": "On lui mit une boîte de viande entre les mains et il en dévora avidement le contenu, non sans boire à même la bouteille d’ale."
                                            },
                                            {
                                                "example_id": "0f8c299a-b36e-44e7-a617-94549cf7df6b",
                                                "sense_id": "712da004-7033-3c82-b1ce-2c14e0c573df",
                                                "text": "— Il la couvrait avidement de caresses, murmurait les mots d'amour les plus doux, et tous deux se perdaient dans une extase furieuse et passionnée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
