                                        "glosses": [
                                            "ein Gefühl auslösen, dass dem Kitzeln, sanftem Pieksen oder schwachen Nadelstichen ähnelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b090235-36e4-4e5e-b38e-3542717f972e",
                                                "sense_id": "2edb3ae4-da6e-396d-a871-80f72f985cfd",
                                                "text": "Ihre Füße prickeln vor Kälte und die Knie schlottern."
                                            },
                                            {
                                                "example_id": "bc45c321-2410-4476-a9dc-00e0fff27a2a",
                                                "sense_id": "2edb3ae4-da6e-396d-a871-80f72f985cfd",
                                                "text": "Die Eiskristalle prickeln auf der Haut."
                                            },
                                            {
                                                "example_id": "729c3c57-3193-436b-aa9c-adb21b8a97ec",
                                                "sense_id": "2edb3ae4-da6e-396d-a871-80f72f985cfd",
                                                "text": "Der Sekt prickelt auf der Zunge."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "858fd845-4366-3006-91e9-0e724ef2e1cd",
                                        "entry_id": "b1457b37-64b1-30d7-b4b7-fcbfd1a5e284",
                                        "glosses": [
                                            "ein Gefühl von Aufregung oder Erregung haben oder verursachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21d6f789-07c9-4892-b2d7-22917bde8ece",
                                                "sense_id": "858fd845-4366-3006-91e9-0e724ef2e1cd",
                                                "text": "Es hat schon etwas Prickelndes, wenn einem eine Professur angeboten wird."
                                            },
                                            {
                                                "example_id": "994ee0e1-fdc6-4f8e-9a37-8ced893b3850",
                                                "sense_id": "858fd845-4366-3006-91e9-0e724ef2e1cd",
                                                "text": "Es prickelt nicht mehr so wie früher, als wir noch nicht verheiratet waren."
                                            },
                                            {
                                                "example_id": "43133bcf-f187-4290-bb02-6c3b3fbdc57a",
                                                "sense_id": "858fd845-4366-3006-91e9-0e724ef2e1cd",
                                                "text": "„Was zum Henker ist passiert? Unbehagen prickelt am Ansatz meiner Wirbelsäule. Mein Herzschlag beschleunigt sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3df53d79-2faa-37b8-8fd7-279bdd03dc84",
                                        "entry_id": "b1457b37-64b1-30d7-b4b7-fcbfd1a5e284",
                                        "glosses": [
                                            "Bläschen produzieren, besonders solche aus Kohlensäure, die an der Oberfläche zerplatzen"
                                        ],
                                        "tags": [
                                            "Flüssigkeiten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f379c4e-9476-40eb-b85a-4982b6f95261",
                                                "sense_id": "3df53d79-2faa-37b8-8fd7-279bdd03dc84",
                                                "text": "Die Häppchen waren angerichtet und in den Gläsern prickelte der Champagner."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
