                                                "sense_id": "73721d18-23e7-3c33-8c13-41b5f82bf354",
                                                "text": "I made a goof in that last calculation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1839a7a-3409-3a88-8068-5b7721a2852d",
                                        "entry_id": "dc5e832f-19e7-3329-8216-d956259468dd",
                                        "glosses": [
                                            "A mistake or error.",
                                            "An error made during production which finds its way into the final release."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2f1d6c8-b89f-3d35-b289-060ea82902e0",
                                        "entry_id": "dc5e832f-19e7-3329-8216-d956259468dd",
                                        "glosses": [
                                            "A foolish and/or silly person; a goofball."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e3ec45f-5cc4-439c-b31d-4cfd01bb8665",
                                                "sense_id": "d2f1d6c8-b89f-3d35-b289-060ea82902e0",
                                                "text": "Your little brother is a total goof."
                                            }
                                        ]
