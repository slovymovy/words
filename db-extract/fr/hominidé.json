                        "translation_id": "fa79ecaa-db9e-4c58-9167-a1453559f608",
                        "source_entry_id": "806f3f52-90fa-3903-81df-9aaa0234641a",
                        "source_sense_id": "5c28b59c-4886-367a-be77-d27588a605d9",
                        "source_sense_description": "Être humain",
                        "target_lang_word": "человек",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
