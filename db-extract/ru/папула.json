                                    {
                                        "sense_id": "9858b9bc-9d07-326c-90f6-5301b64ff0e9",
                                        "entry_id": "e9fe6826-5ebf-386f-9286-8056ff35267c",
                                        "glosses": [
                                            "A small, inflammatory, irritated spot on the skin, similar in appearance to a pimple, but not containing pus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "554fe838-b711-4004-83a9-a7dabae3050d",
                        "source_entry_id": "780fe47c-a423-3d81-b3f9-1fd65332400f",
                        "source_sense_id": "6fca2f03-c264-3b03-8712-70f84ff4b0a0",
                        "target_lang_word": "papula",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "papula",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01605033-cc6f-3966-b122-e583f55d7096",
                                        "entry_id": "bc1122c5-5ba7-3f04-a855-2da68a193493",
                                        "glosses": [
                                            "A pimple; a small, usually conical, elevation of the cuticle, produced by congestion, accumulated secretion, or hypertrophy of tissue; a papule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acb2e09f-36fb-4d83-919a-9516520ac3df",
                                                "sense_id": "01605033-cc6f-3966-b122-e583f55d7096",
                                                "text": "Dr. Lanza stating that in Naples it is observed as an acute febrile disease, of which the papulae, pustules, and ulceration of the mouth are the sole pathognomonic signs, or anatomical character."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8c2aba5-79dc-31bd-b358-cefd625f80db",
                                        "entry_id": "bc1122c5-5ba7-3f04-a855-2da68a193493",
                                        "glosses": [
                                            "One of the numerous small hollow processes of the integument between the plates of starfishes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fc1fabf-1eb4-44e2-be07-18108cd9a430",
                        "source_entry_id": "780fe47c-a423-3d81-b3f9-1fd65332400f",
