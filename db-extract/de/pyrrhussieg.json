                        "source_sense_id": "6ec07057-31b9-32d3-940e-fa07418e46c7",
                        "source_sense_description": "ein unter (äußerst) hohem Einsatz und unter (zu großen) Opfern errungener Erfolg",
                        "target_lang_word": "victoria pírrica",
                        "target_lang_code": "es",
