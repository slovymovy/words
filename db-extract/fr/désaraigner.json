                ],
                "senses": [
                    {
                        "sense_id": "7ba86ebf-a598-3c08-a899-2cc7d471c958",
                        "entry_id": "7d7da084-58d9-3e58-9e39-d65845b7fada",
                        "glosses": [
                            "Débarrasser un endroit des araignées et des toiles d’araignée."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "fafd4416-29fe-49ae-8eb7-88d8ea4c66b1",
                                "sense_id": "7ba86ebf-a598-3c08-a899-2cc7d471c958",
                                "text": "Et les cornues desséchées sont rangées le long du rieu ; les fouloires s’imbibent ; on lave les tombereaux, les bâches ; on désaraigne, on balaie, on nettoie cuves et cuveaux ; on sort, on secoue les paniers ; on remoule les serpettes, et que sais-je encore ?"
                            },
                            {
                                "example_id": "96b7367c-f511-4cce-9e9c-3d7ab3d88e16",
                                "sense_id": "7ba86ebf-a598-3c08-a899-2cc7d471c958",
                                "text": "La troisième fois, j’avais aussi apporté de quoi désaraigner, dépoussiérer et décrasser les vitres de la fenêtre car je trouvais malheureux d’être installé face à un si beau cadre et de ne rien voir dehors."
                            }
                        ]
                    }
                ],
