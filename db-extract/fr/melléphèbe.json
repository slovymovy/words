                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "51982e04-87f6-4b92-960c-149dcb4a18d6",
                                "sense_id": "3a077be5-1b16-34d7-bac7-7c00fcb73f99",
                                "text": "[Le groupe sculpté] comprend deux figures, Aphrodite et Éros, … associé à sa mère en vue de quelque action, sous les traits d'un melléphèbe et non d'un enfant."
                            },
                            {
                                "example_id": "d2668921-e03e-42f0-8991-7154f1a80620",
                                "sense_id": "3a077be5-1b16-34d7-bac7-7c00fcb73f99",
                                "text": "Sans doute ne s'agit-il plus d'un petit garçon comme ceux que l'on voit partir pour l'outre-tombe en traînant un jouet, mais on ne saurait parler non plus d'un éphèbe ou d'un melléphèbe."
                            }
                        ]
                    }
