                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nocividad",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "43c3f936-515b-3938-8485-218e52b45406",
                                        "entry_id": "924996c4-897b-35f2-a0d6-775053677605",
                                        "glosses": [
                                            "Cualidad de lo que es nocivo o que causa daño."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ab6491d-4170-45b0-a4b4-04a73d930768",
                                                "sense_id": "43c3f936-515b-3938-8485-218e52b45406",
                                                "text": "Vemos pues cuán grande es la nocividad del lenguaje cinematográfico: el espectador no debe hacer ningún trabajo para comprender la película. Los signos del lenguaje le hacen comprender todo sin esfuerzo"
                                            }
                                        ],
