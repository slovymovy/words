                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca277f10-411c-4484-aa46-ca07affbae3c",
                                                "sense_id": "2b6c93d0-68d4-3685-b21a-6f80624e7400",
                                                "text": "„Gerne hätte ich mich von Extrembergsteigern der Küstenwache retten lassen, aber dann musste ich mit ansehen, wie ein greises Pärchen an uns vorüber zu Tal schritt, rüstig und flott, mit Kraxelstöcken und völlig schwindelfrei.“"
                                            },
                                            {
                                                "example_id": "f759e715-bc96-413f-a796-2912c56ea325",
                                                "sense_id": "2b6c93d0-68d4-3685-b21a-6f80624e7400",
                                                "text": "„Er sei flott und gescheit, manisch, cholerisch und ein bisschen größenwahnsinnig, sagen die, die für ihn arbeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
