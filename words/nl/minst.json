    "entries": [
        {
            "pos": "numeral",
            "senses": [
                {
                    "sense_id": "11b2e49c-7a30-3992-b71f-a33c6eb84544",
                    "sense_definition": "Overtreffende trap van <w>weinig</w>: het kleinste aantal of de kleinste hoeveelheid.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Van alle deelnemers heeft zij het <w>minst</w> gegeten.",
                            "target_lang_translations": {
                                "en": "Of all the participants, she ate the <w>least</w>.",
                                "ru": "Из всех участников она съела <w>меньше всего</w>.",
                                "pl": "Ze wszystkich uczestników ona zjadła <w>najmniej</w>."
                            }
                        },
                        {
                            "text": "Dit project kost op zijn <w>minst</w> drie maanden tijd.",
                            "target_lang_translations": {
                                "en": "This project will take at <w>least</w> three months.",
                                "ru": "Этот проект займет <w>как минимум</w> три месяца.",
                                "pl": "Ten projekt zajmie <w>przynajmniej</w> trzy miesiące."
                            }
                        }
                    ],
                    "synonyms": [
                        "geringst"
                    ],
                    "antonyms": [
                        "meest"
                    ],
                    "common_phrases": [
                        "op zijn minst",
                        "het minst"
                    ],
                    "target_lang_definitions": {
                        "en": "Superlative of *weinig*: the smallest number or the smallest amount.",
                        "ru": "Превосходная степень от \"weinig\": наименьшее число или количество.",
                        "pl": "Stopień najwyższy od „weinig”: najmniejsza liczba lub najmniejsza ilość."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "least",
                                "target_lang_sense_clarification": "smallest amount or quantity"
                            },
                            {
                                "target_lang_word": "fewest",
                                "target_lang_sense_clarification": "smallest number (countable)"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "меньше всего",
                                "target_lang_sense_clarification": "наименьшее количество"
                            },
                            {
                                "target_lang_word": "как минимум",
                                "target_lang_sense_clarification": "в значении \"по крайней мере\""
                            },
                            {
                                "target_lang_word": "наименее",
                                "target_lang_sense_clarification": "в наименьшей степени"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "najmniej",
                                "target_lang_sense_clarification": "najmniejsza ilość lub liczba"
                            },
                            {
                                "target_lang_word": "przynajmniej",
                                "target_lang_sense_clarification": "w wyrażeniu 'op zijn minst' (co najmniej)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ae721446-58d7-30ff-bcd5-f696e8cfe4c8",
                    "sense_definition": "Overtreffende trap van <w>weinig</w>; zeer gering in mate of omvang (vaak abstract).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij toonde niet in het <w>minst</w> interesse in het voorstel.",
                            "target_lang_translations": {
                                "en": "He did not show interest in the proposal in the <w>least</w>.",
                                "ru": "Он не проявил <w>ни малейшего</w> интереса к предложению.",
                                "pl": "Nie okazał <w>ani krzty</w> zainteresowania propozycją."
                            }
                        },
                        {
                            "text": "Bij het <w>minste</w> of geringste begint de baby te huilen.",
                            "target_lang_translations": {
                                "en": "At the <w>slightest</w> thing, the baby starts to cry.",
                                "ru": "При <w>малейшем</w> поводе ребенок начинает плакать.",
                                "pl": "Przy <w>najmniejszym</w> drobiazgu dziecko zaczyna płakać."
                            }
                        }
                    ],
                    "synonyms": [
                        "geringst"
                    ],
                    "antonyms": [
                        "meest"
                    ],
                    "common_phrases": [
                        "niet in het minst",
                        "het minste of geringste"
                    ],
                    "target_lang_definitions": {
                        "en": "Superlative of *weinig*; very slight in degree or extent (often abstract).",
                        "ru": "Превосходная степень от \"weinig\"; очень незначительный по степени или размеру (часто абстрактно).",
                        "pl": "Stopień najwyższy od „weinig”; bardzo znikomy pod względem stopnia lub zakresu (często abstrakcyjnie)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slightest",
                                "target_lang_sense_clarification": "very small degree, often used in negative contexts"
                            },
                            {
                                "target_lang_word": "least",
                                "target_lang_sense_clarification": "smallest degree"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "малейший",
                                "target_lang_sense_clarification": "самый незначительный"
                            },
                            {
                                "target_lang_word": "нисколько",
                                "target_lang_sense_clarification": "ничуть (в отрицательных конструкциях)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "najmniejszy",
                                "target_lang_sense_clarification": "najdrobniejszy, znikomy stopień"
                            },
                            {
                                "target_lang_word": "ani trochę",
                                "target_lang_sense_clarification": "w zaprzeczeniach (niet in het minst)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04494fdd-5b03-3453-8905-6d471b3be7fe",
                    "sense_definition": "Overtreffende trap van <w>min</w>; van zeer lage kwaliteit, rang of belang.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat is zeker niet de <w>minste</w> prestatie uit zijn carrière.",
                            "target_lang_translations": {
                                "en": "That is certainly not the <w>worst</w> achievement of his career.",
                                "ru": "Это, безусловно, не <w>худшее</w> достижение в его карьере.",
                                "pl": "To z pewnością nie jest <w>najgorsze</w> osiągnięcie w jego karierze."
                            }
                        },
                        {
                            "text": "Hij is niet de <w>minste</w> schaker van onze vereniging.",
                            "target_lang_translations": {
                                "en": "He is not the <w>worst</w> chess player in our club.",
                                "ru": "Он не <w>последний</w> шахматист в нашем клубе.",
                                "pl": "On wcale nie jest <w>najgorszym</w> szachistą w naszym klubie."
                            }
                        }
                    ],
                    "synonyms": [
                        "slechtst",
                        "laagst"
                    ],
                    "antonyms": [
                        "best",
                        "hoogst"
                    ],
                    "common_phrases": [
                        "niet de minste"
                    ],
                    "target_lang_definitions": {
                        "en": "Superlative of *min*; of very low quality, rank, or importance.",
                        "ru": "Превосходная степень от \"min\"; очень низкого качества, ранга или важности.",
                        "pl": "Stopień najwyższy od „min”; bardzo niskiej jakości, rangi lub o znikomym znaczeniu."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "worst",
                                "target_lang_sense_clarification": "lowest quality"
                            },
                            {
                                "target_lang_word": "lowest",
                                "target_lang_sense_clarification": "lowest rank or importance"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "худший",
                                "target_lang_sense_clarification": "самый плохой по качеству"
                            },
                            {
                                "target_lang_word": "последний",
                                "target_lang_sense_clarification": "самый низкий по рангу или значению"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "najgorszy",
                                "target_lang_sense_clarification": "najniższy jakością"
                            },
                            {
                                "target_lang_word": "pośledni",
                                "target_lang_sense_clarification": "o niskim znaczeniu, często w wyrażeniu 'niet de minste'"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}