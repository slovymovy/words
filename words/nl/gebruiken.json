                    "semantic_group_id": "use_drugs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arts vroeg hoelang de patiënt al drugs <w>gebruikt</w>.",
                            "target_lang_translations": {
                                "en": "The doctor asked how long the patient has been <w>using</w> drugs.",
                                "ru": "Врач спросил, как долго пациент уже <w>употребляет</w> наркотики.",
                                "pl": "Lekarz zapytał, jak długo pacjent już <w>bierze</w> narkotyki.",
                                "de": "Der Arzt fragte, wie lange der Patient schon Drogen <w>konsumiert</w>.",
                                "fr": "Le médecin a demandé depuis combien de temps le patient <w>consomme</w> de la drogue.",
                                "it": "Il medico ha chiesto da quanto tempo il paziente <w>assuma</w> droghe.",
                                "cs": "Lékař se zeptal, jak dlouho už pacient <w>bere</w> drogy.",
                                "tr": "Doktor, hastanın ne kadar süredir uyuşturucu <w>kullandığını</w> sordu.",
                                "es": "El médico preguntó cuánto tiempo llevaba el paciente <w>consumiendo</w> drogas."
                            }
