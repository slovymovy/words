                    }
                ],
                "senses": [
                    {
                        "sense_id": "328011d2-dd46-35e8-b113-4f58bf3f4fc2",
                        "entry_id": "c57ffe9a-00f1-397d-b4ef-3ba3ac27973a",
                        "glosses": [
                            "выслеживая, выжидая, дождаться появления кого-либо или чего-либо"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6ba8d93-ab0f-4dea-9f22-23c8595ea058",
                        "source_entry_id": "c57ffe9a-00f1-397d-b4ef-3ba3ac27973a",
                        "source_sense_id": "328011d2-dd46-35e8-b113-4f58bf3f4fc2",
                        "target_lang_word": "guetter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guetter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ffa42faa-9ed4-3ea2-9959-ea76cd66af94",
                                        "entry_id": "fff1b24f-11c7-3416-9d9c-1eed10722d16",
                                        "glosses": [
                                            "Épier, observer à dessein de surprendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cfc3a15-5412-4ad3-9a75-269193210437",
                                                "sense_id": "ffa42faa-9ed4-3ea2-9959-ea76cd66af94",
                                                "text": "Il riait de plus en plus fort, férocement joyeux, guettant les reflets de la stupéfaction sur la physionomie du journaliste."
                                            },
                                            {
                                                "example_id": "36b9ffde-05b4-4557-8075-e62130838b3d",
                                                "sense_id": "ffa42faa-9ed4-3ea2-9959-ea76cd66af94",
                                                "text": "Les assassins le guettaient."
                                            },
                                            {
                                                "example_id": "0a9d2ed4-bf93-438c-b999-83a27ea7c380",
                                                "sense_id": "ffa42faa-9ed4-3ea2-9959-ea76cd66af94",
                                                "text": "Des gendarmes le guettent."
                                            },
                                            {
                                                "example_id": "977cd964-ac04-4cd5-9023-18a055881534",
                                                "sense_id": "ffa42faa-9ed4-3ea2-9959-ea76cd66af94",
                                                "text": "On sait tous les endroits où il va, on le guette."
                                            },
                                            {
                                                "example_id": "ab98fe62-7dc4-4867-8cd7-f1518a465996",
                                                "sense_id": "ffa42faa-9ed4-3ea2-9959-ea76cd66af94",
                                                "text": "On le prit sur le fait, car on le guettait."
                                            },
                                            {
                                                "example_id": "8c32435d-be5e-4594-a0cb-2bb699d8a9d4",
                                                "sense_id": "ffa42faa-9ed4-3ea2-9959-ea76cd66af94",
                                                "text": "Le chat guette la souris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e2af076-fd09-3ee2-a568-c7b90cf1d29a",
                                        "entry_id": "fff1b24f-11c7-3416-9d9c-1eed10722d16",
                                        "glosses": [
                                            "Attendre quelqu’un à un endroit où il ne croit pas qu’on le cherche, ou l’attendre simplement à un endroit où il doit passer."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3b68eaf-16ee-4cfa-8e6f-d4f752e6f09e",
                                                "sense_id": "4e2af076-fd09-3ee2-a568-c7b90cf1d29a",
                                                "text": "Le 22, au point du jour, la cité entière, entassée sur les quais du port et sur les côtes voisines, guettait d’un œil avide et colère le steamer qui amenait à Copenhague la députation du meeting de Rendsbourg."
                                            },
                                            {
                                                "example_id": "6ffe35aa-7e5c-45f1-87c5-7cb652b29736",
                                                "sense_id": "4e2af076-fd09-3ee2-a568-c7b90cf1d29a",
                                                "text": "La porte s'ouvrit sans que j'eusse à sonner. Elle avait dû guetter mon arrivée par la fenêtre."
                                            },
                                            {
                                                "example_id": "48d2f9ae-4a85-4198-9e89-3b3212d54fb8",
                                                "sense_id": "4e2af076-fd09-3ee2-a568-c7b90cf1d29a",
                                                "text": "Avant-hier il a plu toute la journée, mais le soir, malgré le ciel couvert, tout le monde guettait anxieusement l’apparition de la lune nouvelle."
                                            },
                                            {
                                                "example_id": "5946a2d9-6cd0-4f63-bc6f-ee776e3c38e5",
                                                "sense_id": "4e2af076-fd09-3ee2-a568-c7b90cf1d29a",
                                                "text": "Le 16 novembre 1943, comme chaque jour, le train de Paris s'est arrêté à Montargis. Dans la brume, avec ta mère vous guettiez depuis longtemps l'arrivée des globes lumineux de l’autocar au gazogène qui amenait les voyageurs de Montargis à Saint-Martin-sur-Ouanne."
                                            },
                                            {
                                                "example_id": "131e078b-005d-4efc-9269-390bfc1753ac",
                                                "sense_id": "4e2af076-fd09-3ee2-a568-c7b90cf1d29a",
                                                "text": "— Je m’engageai dans la passe […]. Je devais agir avec prudence, car les pointes traîtresses du corail me guettaient sous la mer."
                                            },
                                            {
                                                "example_id": "9066b309-2bc0-42d3-ad33-28038840610c",
                                                "sense_id": "4e2af076-fd09-3ee2-a568-c7b90cf1d29a",
                                                "text": "Dans l’espace, de graves dangers nous guettent, parmi lesquels : micrométéorites, radiations cosmiques mortelles et vieillissement accéléré en apesanteur."
                                            },
                                            {
                                                "example_id": "e7b14fe6-0df1-40d9-b6ed-7dde694ea7cc",
                                                "sense_id": "4e2af076-fd09-3ee2-a568-c7b90cf1d29a",
                                                "text": "— J’avais acheté une vieille 4L dont les cardans exténués rendaient d’inquiétants sons de castagnettes et je roulais des journées entières sur des routes où la mort guettait à chaque virage."
                                            },
                                            {
                                                "example_id": "ba16317a-62a8-4b42-bf43-d25d7211a072",
                                                "sense_id": "4e2af076-fd09-3ee2-a568-c7b90cf1d29a",
                                                "text": "— La mort le guette. — La maladie le guette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28de2bc2-8faf-398e-9f87-ea7d1c50c47d",
                                        "entry_id": "fff1b24f-11c7-3416-9d9c-1eed10722d16",
                                        "glosses": [
                                            "Se tenir prêt à saisir l’occasion, le moment, de faire une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9db20f7c-6a51-42f1-b876-3def013af522",
                                                "sense_id": "28de2bc2-8faf-398e-9f87-ea7d1c50c47d",
                                                "text": "Guetter l’occasion, guetter le moment, l’instant favorable, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caec1fc5-38ec-3e70-b2ed-60336d8e2911",
                                        "entry_id": "fff1b24f-11c7-3416-9d9c-1eed10722d16",
                                        "glosses": [
                                            "Regarder, jeter un bref regard."
                                        ],
                                        "tags": [
                                            "Louisiane"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5472c620-d6d6-32ba-978b-838d5bceed6a",
                                        "entry_id": "fff1b24f-11c7-3416-9d9c-1eed10722d16",
                                        "glosses": [
                                            "Être susceptible de s'en prendre à quelqu’un, à quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91098add-5b05-4d0a-b31c-ee0212003c61",
                                                "sense_id": "5472c620-d6d6-32ba-978b-838d5bceed6a",
                                                "text": "La névrose guette la population."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea3d16e6-4723-47a8-9eec-cac73dd0bd78",
                        "source_entry_id": "c57ffe9a-00f1-397d-b4ef-3ba3ac27973a",
                        "source_sense_id": "328011d2-dd46-35e8-b113-4f58bf3f4fc2",
                        "target_lang_word": "épier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a82ec42-f627-389a-a5cc-63979c6d851d",
                                        "entry_id": "adf2b71f-a3c8-310b-b4a8-109bb7b7a5a7",
                                        "glosses": [
                                            "Observer secrètement et avec attention les actions, les discours de quelqu’un, ou ce qui se passe quelque part."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de865cbd-a248-4374-9c18-459aaaeccd71",
                                                "sense_id": "5a82ec42-f627-389a-a5cc-63979c6d851d",
                                                "text": "L'homme, qui était un garde-côte, comme le faisait voir sa cape d'uniforme, épiait toutes les manœuvres du trois-mâts et semblait en prendre note mentalement."
                                            },
                                            {
                                                "example_id": "9758e135-90f5-4d59-9b76-73aa1e54b205",
                                                "sense_id": "5a82ec42-f627-389a-a5cc-63979c6d851d",
                                                "text": "[…], j’appris qu’il était d’autres joies que celles d’épier sous un arbre l’approche d’un ramier ou de placer le soir sur un passage dans les taillis d’invisibles lacets."
                                            },
                                            {
                                                "example_id": "eeb4dc8c-a315-4ab5-91bd-bd8a565f6273",
                                                "sense_id": "5a82ec42-f627-389a-a5cc-63979c6d851d",
                                                "text": "Ainsi, l’une et l’autre nous nous épiions, sous un masque de sourires et malgré des paroles affectueuses."
                                            },
                                            {
                                                "example_id": "7ee24fa3-a3c4-438e-9970-d8eaad09aaa6",
                                                "sense_id": "5a82ec42-f627-389a-a5cc-63979c6d851d",
                                                "text": "— […], mais à Mervale les dix maisons, comme dix vieilles filles revêches, continueraient à s’épier, à s’envier, à s’enfoncer de plus en plus secrètes et solitaires, chaque mois davantage, […]."
                                            },
                                            {
                                                "example_id": "66d166ad-c39f-451a-900a-5520d349e460",
                                                "sense_id": "5a82ec42-f627-389a-a5cc-63979c6d851d",
                                                "text": "« Je dois te parler d’une conversation que j’ai pu épier.\n— Comment ça je pue des pieds ? Je les ai lavés ce matin. »"
                                            },
                                            {
                                                "example_id": "d6b219c4-264c-4267-809e-3f326355fe5e",
                                                "sense_id": "5a82ec42-f627-389a-a5cc-63979c6d851d",
                                                "text": "Et nul ne voyait ce qui crevait pourtant les yeux et que cette brave fille, Ursula, comprenait d’instinct : qu’elle était un miroir ou Stéphane et Carlotta s’épiaient, se re-connaissaient…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4371c540-cda8-3880-9575-34f7736c19f6",
                                        "entry_id": "adf2b71f-a3c8-310b-b4a8-109bb7b7a5a7",
                                        "glosses": [
                                            "Se tenir prêt à saisir l’occasion de faire quelque chose, à profiter du moment favorable."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f170e06-13ab-401e-9c32-ebea7bf905b9",
                                                "sense_id": "4371c540-cda8-3880-9575-34f7736c19f6",
                                                "text": "Pendant toute la journée du lendemain elle épia les occasions de s'assurer de son triomphe sur sa folle passion."
                                            },
                                            {
                                                "example_id": "5862c057-8484-4d0c-8ee5-c5ce214342f1",
                                                "sense_id": "4371c540-cda8-3880-9575-34f7736c19f6",
                                                "text": "Épier l’occasion, d’agir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "épier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db8a82d6-d91a-39d0-b9d5-e641aff7cbca",
                                        "entry_id": "9266c5d2-6c82-3e65-b254-4920a0c858f8",
                                        "glosses": [
                                            "Monter en épi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e849ac6e-4540-4d5f-b302-a389d8cb26aa",
                                                "sense_id": "db8a82d6-d91a-39d0-b9d5-e641aff7cbca",
                                                "text": "M. Jarrin nous écrit de Bourg (Ain) :\nLe blé a épié en avance de trois semaines sur l’an dernier; on a commencé la récolte du colza, qui est bonne. Les céréales sont plus belles qu'elles n’ont été depuis longtemps."
                                            },
                                            {
                                                "example_id": "b5a509b2-75bb-4ed9-be6a-faa11d787988",
                                                "sense_id": "db8a82d6-d91a-39d0-b9d5-e641aff7cbca",
                                                "text": "Jamais le mois de mai ne quitte sans voir le blé épié."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
