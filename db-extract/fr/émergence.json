        "fr-extract.jsonl": [
            {
                "entry_id": "9bbccf46-1ac8-3e51-873e-4c879ea5f225",
                "word": "émergence",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4035cf7e-a2c7-4ea1-99f1-b06cc2b61b7f",
                        "entry_id": "9bbccf46-1ac8-3e51-873e-4c879ea5f225",
                        "tags": [
                            "plural"
                        ],
                        "form": "émergences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "95451e8b-7a0b-3c0c-8da8-bcadee61ad34",
                        "entry_id": "9bbccf46-1ac8-3e51-873e-4c879ea5f225",
                        "glosses": [
                            "Le fait d’être émergent."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "177039f2-501e-4947-a444-34e2b3cb37d5",
                                "sense_id": "95451e8b-7a0b-3c0c-8da8-bcadee61ad34",
                                "text": "Point d’émergence, Point par lequel un rayon lumineux sort d’un milieu qu’il a traversé."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8dee865-e196-3f37-ab02-40ba36306e29",
                        "entry_id": "9bbccf46-1ac8-3e51-873e-4c879ea5f225",
                        "glosses": [
                            "Apparition, naissance, en parlant de phénomènes, et non d’êtres vivants ou d’objets matériels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fec35ae8-f67e-41a7-8162-8b3e76ee589a",
                                "sense_id": "c8dee865-e196-3f37-ab02-40ba36306e29",
                                "text": "Leurs souvenirs d’enfance se ressemblaient, comme étaient presque identiques les chemins qu’ils avaient suivis, leur lente émergence hors du milieu familial, les perspectives qu’ils semblaient s’être choisies."
                            },
                            {
                                "example_id": "bf5ef13f-f282-48f8-b0ae-ab1e2b21dc41",
                                "sense_id": "c8dee865-e196-3f37-ab02-40ba36306e29",
                                "text": "[…], néanmoins l’émergence des premières sociétés à caractère compagnonnique se situe bien dans ce champ de l'histoire où le triptyque corporations-cathédrales-croisades contribue fondamentalement à forger la première identité compagnonnale."
                            },
                            {
                                "example_id": "83cb2669-1f0c-4623-a239-f3048629bed1",
                                "sense_id": "c8dee865-e196-3f37-ab02-40ba36306e29",
                                "text": "Nous avons l’impression que, depuis quelque temps, cette émergence de maladies nouvelles survient plus fréquemment qu’autrefois."
                            },
                            {
                                "example_id": "ba4e1edc-2185-498e-8b00-2f75da278e82",
                                "sense_id": "c8dee865-e196-3f37-ab02-40ba36306e29",
                                "text": "Elles seront renforcées par l’émergence, en Mésopotamie, de l’empire néo-assyrien, dont le dieu Assour est présenté comme le seul vrai dieu."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c4f91f1-07ef-3c64-b312-400e7dd95ba1",
                        "entry_id": "9bbccf46-1ac8-3e51-873e-4c879ea5f225",
                        "glosses": [
                            "Apparition de caractéristiques nouvelles à un certain degré de complexité d’un système."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "122ed72c-887f-4477-8e51-3bca52d62e59",
                                "sense_id": "8c4f91f1-07ef-3c64-b312-400e7dd95ba1",
                                "text": "Le concept d’émergence est de plus en plus utilisé. Il repose sur la constatation que dans un ensemble formé de parties différentes, le tout est davantage que la somme des parties."
                            },
                            {
                                "example_id": "8842673b-5914-431c-967b-69d997513240",
                                "sense_id": "8c4f91f1-07ef-3c64-b312-400e7dd95ba1",
                                "text": "L’émergence est le type de réalité nouvelle, dotée de qualités et propriétés propres, qui se forme, se constitue, se concrétise à partir de l’assemblage organisateur d’éléments non dotés des qualités et propriétés de cette réalité."
                            }
                        ]
                    },
                    {
                        "sense_id": "af03088a-5d4c-3ffb-84bf-14b3ad75794f",
                        "entry_id": "9bbccf46-1ac8-3e51-873e-4c879ea5f225",
                        "glosses": [
                            "Apparition d'eau sortant du sol, quelle que soit son origine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7b31286-2bef-4e69-8bf9-414ff8ccb300",
                                "sense_id": "af03088a-5d4c-3ffb-84bf-14b3ad75794f",
                                "text": "Les exsurgences et les résurgences sont des émergences."
                            }
                        ]
                    },
                    {
                        "sense_id": "d987fe40-fc73-318a-b203-3c01b4971e97",
                        "entry_id": "9bbccf46-1ac8-3e51-873e-4c879ea5f225",
                        "glosses": [
                            "Sortie d’un jeune adulte de la cellule de couvain dans laquelle il s’est développé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20e68047-cdfb-4bd1-9e4e-b8d32893f4a6",
                                "sense_id": "d987fe40-fc73-318a-b203-3c01b4971e97",
                                "text": "D’autres études ont montre que les faux bourdons volent pour la première fois entre cinq et huit jours après leur émergence. Ces vols sont courts et semblent servir à l’orientation. Dix jours environ après l’émergence commencent les premiers vols de reproduction."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a99bd0f6-74f8-45a2-849b-da530df594fb",
                        "source_entry_id": "9bbccf46-1ac8-3e51-873e-4c879ea5f225",
                        "target_lang_word": "Emergenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Emergenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "770c998b-4f98-33bd-94b7-089cca04b03e",
                                        "entry_id": "f704cf1b-18da-3b1c-9a7d-807cf3694ffd",
                                        "glosses": [
                                            "das Phänomen, dass insbesondere in hierarchisch organisierten Systemen die neuen, zumeist höheren oder komplexeren Eigenschaften einer Organisationsebene nicht aus den Eigenschaften der interagierenden Elemente in den darunter befindlichen Ebenen vorhergesagt werden können, sondern in unvorhersehbarer Weise neu erscheinen"
                                        ],
                                        "tags": [
                                            "no-plural",
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "647ab637-3089-4134-a424-21f03b5a0218",
                                                "sense_id": "770c998b-4f98-33bd-94b7-089cca04b03e",
                                                "text": "Unter Emergenz verstehe ich ein physikalisches Ordnungsprinzip."
                                            },
                                            {
                                                "example_id": "cfc5f860-7448-43c3-a665-384835d09ab8",
                                                "sense_id": "770c998b-4f98-33bd-94b7-089cca04b03e",
                                                "text": "Man kann behaupten, dass die Aussage des griechischen Philosophen Aristoteles \"Das Ganze ist mehr als die Summe seiner Teile\" eine frühe Theorie über das Wesen der Emergenz sei."
                                            },
                                            {
                                                "example_id": "355170bf-12ec-4e33-bb89-7d2bdb636c74",
                                                "sense_id": "770c998b-4f98-33bd-94b7-089cca04b03e",
                                                "text": "Zur Erklärung der Emergenz sozialer Realitäten müssen lediglich zusätzlich Wechselwirkungen zwischen Gehirnen mitbetrachtet werden."
                                            },
                                            {
                                                "example_id": "965023d0-8c19-47fa-ad55-f72583b3de61",
                                                "sense_id": "770c998b-4f98-33bd-94b7-089cca04b03e",
                                                "text": "So macht sich die Systemtheorie schließlich die Perspektive der biologischen Evolutionstheorie zu eigen: \"Sie nimmt die Emergenz und Destruktion von Systemen mit Gleichmut hin.\""
                                            },
                                            {
                                                "example_id": "6e5bfd1a-e56d-4299-a42e-8b0e7a52c039",
                                                "sense_id": "770c998b-4f98-33bd-94b7-089cca04b03e",
                                                "text": "Übertriebene, kollektivierte Angst, kann in der Tat, so wissen wir seit den Mayas und seit Hitler, ganze Populationen in den Untergang treiben. Aber diesen dunklen Energien steht eine mächtige Gegenkraft gegenüber, die es ebenfalls zu berücksichtigen gilt, wenn wir über die Zukunft nachdenken: die Emergenz lebendiger Systeme."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d43d8a70-ff7a-33e6-876c-2ceba994400b",
                                        "entry_id": "f704cf1b-18da-3b1c-9a7d-807cf3694ffd",
                                        "glosses": [
                                            "ein Pflanzenorgan, an dessen Bildung auch Gewebe unterhalb der Epidermis beteiligt ist (z.B. die Sockel der Brennhaare der Brennnessel oder die Stacheln der Rose)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee607162-49b3-4e98-9fc7-2c7e826b3ac3",
                                                "sense_id": "d43d8a70-ff7a-33e6-876c-2ceba994400b",
                                                "text": "Brennhaare der Brennessel (z.B. Urtica dioica): Ein Brennhaar ist eigentlich eine Emergenz, es ist zweiteilig und besteht aus einem vielzelligen Sockel, an dessen Bildung auch subepidermal gelegene Zellen beteiligt sind, und einer in ihn eingelassenen Haarzelle."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a0a4be78-ac6d-32ae-9b92-99aca512a351",
                                        "entry_id": "f704cf1b-18da-3b1c-9a7d-807cf3694ffd",
                                        "glosses": [
                                            "das Auftreten neuer Qualitäten bei einer Zustandsänderung eines Systems"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5537160-af7d-439f-a4a5-6ecfc3fbc559",
                                                "sense_id": "a0a4be78-ac6d-32ae-9b92-99aca512a351",
                                                "text": "Man bezeichnet den Transformationsprozess als Emergenz, wenn der Systemzustand B nicht direkt aus Systemzustand A gefolgert werden kann."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3804ad0f-1738-3fc7-b3a7-7b4b7e3d0c53",
                                        "entry_id": "f704cf1b-18da-3b1c-9a7d-807cf3694ffd",
                                        "glosses": [
                                            "Entstehung der New Economy und des Internets mit völlig neuen Geschäftsbereichen als Übertragung des Prinzips aus ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "566ba060-4d61-414f-b95c-ff4e28d605b1",
                                                "sense_id": "3804ad0f-1738-3fc7-b3a7-7b4b7e3d0c53",
                                                "text": "Ein bewußt gefördertes, inkrementales Vorgehen, bei dem den Mitarbeitern Emergenz ermöglicht wird, ist für den Nischenanbieter empfehlenswert – und damit gezielt einsetzbar –, wenn die Komplexitätsbewältigung in kleinen, evolutionären Schritten erfolgen soll."
                                            },
                                            {
                                                "example_id": "7fba49e6-d638-4582-852d-fa23cff5a81a",
                                                "sense_id": "3804ad0f-1738-3fc7-b3a7-7b4b7e3d0c53",
                                                "text": "Der entwickelte theoretische Rahmen kann nachfolgende empirische Untersuchungen des Zusammenwirkens der Gestaltung und Emergenz von Geschäftsprozessen fundieren."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "820656fa-2aee-4891-a4a3-cb9a99ca55f7",
