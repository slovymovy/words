                        ]
                    },
                    {
                        "translation_id": "3d429a67-3c7c-45f4-b096-55cde79de99a",
                        "source_entry_id": "6e1719ee-7e77-3002-887b-4605904b40a8",
                        "source_sense_id": "b240a6fc-0e2f-3c70-9bb1-a336c0ade159",
                        "target_lang_word": "sternly",
