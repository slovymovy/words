                        "sense_id": "c735484a-6735-3c65-819b-5a86aa4fdabf",
                        "entry_id": "a242eb11-9b27-3029-a5a5-4c0e49230f30",
                        "glosses": [
                            "das Verwenden eigener, bereits publizierter wissenschaftlicher Texte, ohne dies entsprechend zu kennzeichnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfb7e8a2-86b0-4fa5-856e-8b2b3288be0e",
                                "sense_id": "c735484a-6735-3c65-819b-5a86aa4fdabf",
                                "text": "„Seine Replik ist interessant, denn sie widerspricht indirekt Pöttker, der die Magisterarbeit zuvor nicht gekannt haben will, und sie lässt auch das \"Merkblatt Plagiate\" der TU Dortmund außer Acht, das just auch Selbstplagiate auf die Tabuliste setzt.“"
                            },
                            {
                                "example_id": "3b81287d-4baf-4ef0-977a-0f6f204523bd",
                                "sense_id": "c735484a-6735-3c65-819b-5a86aa4fdabf",
                                "text": "„Da er darauf hinweise, dass die Dissertation schon als Studie veröffentlicht wurde, handle es sich um kein Selbstplagiat.“"
                            }
                        ],
