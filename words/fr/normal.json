                },
                {
                    "sense_id": "80d4a605-aebc-380a-9bf0-b7762537ed88",
                    "sense_definition": "Relatif aux écoles destinées à former les enseignants du système éducatif.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "enseignement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle prépare le concours d'entrée à l'école <w>normale</w> supérieure pour devenir professeure."
                        },
                        {
                            "text": "Mon grand-père a suivi ses études dans une école <w>normale</w> d'instituteurs avant la guerre."
