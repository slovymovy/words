                "senses": [
                    {
                        "sense_id": "c8b2e168-8e88-3262-9149-4b7db6927081",
                        "entry_id": "25a15d5d-0be7-3191-9263-f9f7fa830c5a",
                        "glosses": [
                            "kobieta lub dziewczyna prowadząca z kimś rozmowę"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "8c505d40-e08f-4008-aeb5-04891297aa1f",
                                "sense_id": "c8b2e168-8e88-3262-9149-4b7db6927081",
                                "text": "Dopiero po chwili zorientował się, że to, co wziął za kanapę, było obszernym fotelem, w którym uprzejma interlokutorka musiała ścieśnićsię z konieczności ścieśnić."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b75a539d-c262-4872-9c62-d5a098ce7398",
                        "source_entry_id": "25a15d5d-0be7-3191-9263-f9f7fa830c5a",
                        "source_sense_id": "c8b2e168-8e88-3262-9149-4b7db6927081",
                        "target_lang_word": "interlocutrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interlocutrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07f11642-5bb1-384f-b70d-224ab798ec8c",
                                        "entry_id": "e137ab0d-c681-33f9-8cec-10e9efddfaee",
                                        "glosses": [
                                            "Femme avec qui l’on converse, qui participe à une conversation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c570ebe8-28d8-45a0-b976-b47773574158",
                                                "sense_id": "07f11642-5bb1-384f-b70d-224ab798ec8c",
                                                "text": "– Ciao Valentina, come va ? demanda l’Italien en reconnaissant son interlocutrice, une spécialiste en histoire de l’art.\n– Bonjour messieurs, répondit-elle …."
                                            },
                                            {
                                                "example_id": "6df9e61d-bc0b-469a-a8ff-4b019caa9c47",
                                                "sense_id": "07f11642-5bb1-384f-b70d-224ab798ec8c",
                                                "text": "Le juge vit la déception sur le visage de son interlocutrice et comprit qu'il avait mis dans le mille."
                                            },
                                            {
                                                "example_id": "79c278d5-c7fd-460a-879c-484b60b222db",
                                                "sense_id": "07f11642-5bb1-384f-b70d-224ab798ec8c",
                                                "text": "Là-dessus, mon interlocutrice s’avança vers le feu, toute tremblante et portant la main à son côté."
                                            },
                                            {
                                                "example_id": "42f443f8-3fa2-4d91-a731-efcf0cf46712",
                                                "sense_id": "07f11642-5bb1-384f-b70d-224ab798ec8c",
                                                "text": "Les joues de Miss Bell rosissent. Assise sur le bord de sa chaise, le buste rigide, elle lui lance un regard indigné. Cox s’excuse pour la crudité de ses propos, ils ne sont pas dignes d’une interlocutrice de son rang, qu’elle le pardonne, ses nerfs sont à vif, il croule sous les doléances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc9f3b09-f4f0-32e3-b363-ea61184c8485",
                                        "entry_id": "e137ab0d-c681-33f9-8cec-10e9efddfaee",
                                        "glosses": [
                                            "Femme qu’un écrivain introduit dans un dialogue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
