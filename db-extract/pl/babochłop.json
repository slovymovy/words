                        "cross_references": [
                            {
                                "target_word": "marimacho",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "35b387ca-fec9-3b2c-affc-627accbc74f6",
                                        "entry_id": "26174562-0169-3c5a-9ee7-8fd417dae5d5",
                                        "glosses": [
                                            "Mujer de aspecto o comportamiento que recuerdan a los convencionalmente atribuídos a los varones"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c53ce872-5c58-4a54-992c-09abea2c8195",
                                                "sense_id": "35b387ca-fec9-3b2c-affc-627accbc74f6",
                                                "text": "Era de corta estatura, flaca, rubia, de azules ojos: su belleza, completamente apócrifa, consistía tan sólo en la marcialidad de su apostura y en su destreza hípica, cualidades de marimacho, no de mujer"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27bfe987-68b4-42cb-b895-5cbca85cd31e",
                        "source_entry_id": "1db77466-52a8-3265-a1ce-44c32347ecab",
                        "source_sense_id": "9a8db95e-a1ea-3fd2-99b7-d61c5b4316e9",
                        "target_lang_word": "Mannsweib",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mannsweib",
