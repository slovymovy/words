                                "target_senses": [
                                    {
                                        "sense_id": "e06a964f-803c-3535-a2ef-eedd725b1503",
                                        "entry_id": "1472c3b4-d5f0-3c49-9f74-5716e6dd780b",
                                        "glosses": [
                                            "Polymère élastique qui supporte une très grande déformation (> 100%) presque totalement réversible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e8b71e7-d11c-4ce1-8473-ff494c567b44",
                                                "sense_id": "e06a964f-803c-3535-a2ef-eedd725b1503",
                                                "text": "Les élastomères 'sont des polymères dont la température de transition vitreuse se situe au dessous de la température ambiante. De ce fait, à l'ambiante, les chaînes macromoléculaires voient tous leurs mouvements possibles libérés."
                                            },
                                            {
                                                "example_id": "b9a08e59-a553-4867-85f4-18fe68ad4890",
                                                "sense_id": "e06a964f-803c-3535-a2ef-eedd725b1503",
                                                "text": "Puis il donna un coup de poing amical sur le museau d’élastomère du requin rigolard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
