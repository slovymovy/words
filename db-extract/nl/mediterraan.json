                            {
                                "example_id": "9b109015-2156-4be7-9fa6-f1e8bb5223f3",
                                "sense_id": "0d2287d4-05b4-3d96-8964-53863919d7b2",
                                "text": "Het aangename mediterrane klimaat van de Kaap met zijn prachtige flora en fauna trekt veel bezoekers."
