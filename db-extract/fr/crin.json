        "fr-extract.jsonl": [
            {
                "entry_id": "b9b2365d-2d12-37cd-b3c3-cfedc8cb319b",
                "word": "crin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4938287d-6200-42b0-a582-156c0cc178b0",
                        "entry_id": "b9b2365d-2d12-37cd-b3c3-cfedc8cb319b",
                        "tags": [
                            "plural"
                        ],
                        "form": "crins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "37dc3e07-3bd4-3e9d-bb97-e25d0d753843",
                        "entry_id": "b9b2365d-2d12-37cd-b3c3-cfedc8cb319b",
                        "glosses": [
                            "Poil long et rude qui pousse au cou, à la queue et aux extrémités inférieures des membres de certains animaux et spécialement des chevaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a27a4fb-0e1a-4146-a778-96115e72a8a1",
                                "sense_id": "37dc3e07-3bd4-3e9d-bb97-e25d0d753843",
                                "text": "Les crins de cheval servent à faire certains tissus, en particulier pour cribles et tamis, pour presses employées dans la fabrication du cidre, pour portefeuilles, sacs de voyages, coiffes de chapeaux, pour la bourrellerie et la carrosserie, pour couvertures de sofa, coussins de wagons, tapis, etc."
                            },
                            {
                                "example_id": "a0718223-0d3f-48b0-9fe8-f3c297073e90",
                                "sense_id": "37dc3e07-3bd4-3e9d-bb97-e25d0d753843",
                                "text": "Et puis, il a desserré peu à peu le crin, dégagé le cou. Il s’est assuré que la bête est indemne, la strangulation inefficace encore."
                            }
                        ]
                    },
                    {
                        "sense_id": "de8f0bb9-2bb5-30e6-b3a7-78546b34ad78",
                        "entry_id": "b9b2365d-2d12-37cd-b3c3-cfedc8cb319b",
                        "glosses": [
                            "Cheveu, poil de barbe, poil."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "9619311a-10b3-4d82-a3d3-dd845960ebc5",
                                "sense_id": "de8f0bb9-2bb5-30e6-b3a7-78546b34ad78",
                                "text": "Au carrefour de Buci, il s’aperçut qu’un homme le suivait. La quarantaine, le teint rose, le crin gris, le bréchet important."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c5c2b36-dcbe-3644-aaa5-177ebe2912e4",
                        "entry_id": "b9b2365d-2d12-37cd-b3c3-cfedc8cb319b",
                        "glosses": [
                            "Matière composée de fibres animales ou végétales, typiquement utilisée en rembourrage ou pour le mèche d'un archet d'instrument à cordes frottées."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3eb25111-2a02-4ee1-81a4-7eb8867f4031",
                                "sense_id": "1c5c2b36-dcbe-3644-aaa5-177ebe2912e4",
                                "text": "Ayant heureusement remarqué des petits carrés de laine semés sur le parquet devant les chaises de crin, je parvins, en mettant successivement le pied sur chacun de ces îlots de tapisserie, à m’avancer jusqu’à l’angle de la cheminée où je m’assis essoufflé."
                            },
                            {
                                "example_id": "63203411-7432-4025-bb9b-0a99540af180",
                                "sense_id": "1c5c2b36-dcbe-3644-aaa5-177ebe2912e4",
                                "text": "Elle ne parla pas, alla s’asseoir à terre devant un fauteuil, dont la vieille tapisserie laissait passer le crin par une déchirure ; et, tirant de sa poche une aiguille et un écheveau de laine, elle se mit à la raccommoder."
                            },
                            {
                                "example_id": "6a52585b-563e-4a75-86ca-28994b7ea037",
                                "sense_id": "1c5c2b36-dcbe-3644-aaa5-177ebe2912e4",
                                "text": "Ils firent leurs premiers pas dans la ville arabe, achetèrent un sommier métallique, un matelas de crin, deux fauteuils de rotin, quatre tabourets de corde, deux tables, une natte épaisse d’alfa jaune, décorée de rares motifs rouges."
                            }
                        ]
                    },
                    {
                        "sense_id": "6315e8a1-eca5-3e0c-80e2-4a1513cf5281",
                        "entry_id": "b9b2365d-2d12-37cd-b3c3-cfedc8cb319b",
                        "glosses": [
                            "Plaie ouverte ou entaille à la tête."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "4cd066b6-9823-47cb-bdbd-1cb02277e3ba",
                                "sense_id": "6315e8a1-eca5-3e0c-80e2-4a1513cf5281",
                                "text": "Le bijoutier a reçu un violent coup au niveau de la tête, lui créant un crin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f026983c-d0ac-4ae6-bfaa-05a9534fd64e",
                        "source_entry_id": "b9b2365d-2d12-37cd-b3c3-cfedc8cb319b",
                        "target_lang_word": "Rosshaar",
