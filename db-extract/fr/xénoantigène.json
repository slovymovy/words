                "senses": [
                    {
                        "sense_id": "b13f13b8-7835-3de9-85b4-58bf0b2cc4b2",
                        "entry_id": "d2b208e7-f260-3448-b2b4-df0454af72b6",
                        "glosses": [
                            "Antigène extérieur à l’organisme, provenant d’une espèce différente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bb793c2-5d20-4724-8076-6e7f0f805ff6",
                                "sense_id": "b13f13b8-7835-3de9-85b4-58bf0b2cc4b2",
                                "text": "Par contre l’albumine humaine injectée au rat, au lapin, au cobaye ou à la souris est alors un xénoantigène et induit dans chacune de ces espèces la production d'Ac."
                            },
                            {
                                "example_id": "63c1936a-53e8-45ee-813e-a8ba1e480371",
                                "sense_id": "b13f13b8-7835-3de9-85b4-58bf0b2cc4b2",
                                "text": "Le xénoantigène qui chez le porc serait majoritairement responsable du phénomène de rejet chez l'homme est une molécule de nature osidique, le galactose-1,3-galactose, localisé sur la membrane plasmique des cellules endothéliales."
                            }
                        ]
                    }
