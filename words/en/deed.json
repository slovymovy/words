                {
                    "sense_id": "8cfeb725-7a77-3a02-9e53-0458f52bcbb1",
                    "sense_definition": "A brave, noteworthy, or heroic action.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_senses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight was famous throughout the kingdom for his brave <w>deeds</w>.",
