                    },
                    {
                        "translation_id": "429bc4a3-c7ff-4bb5-a507-c495bc437621",
                        "source_entry_id": "7185b886-1103-3436-9202-b337af8b2d08",
                        "source_sense_id": "74263781-f578-353b-9deb-3aa66b28269a",
                        "target_lang_word": "ксенон",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
