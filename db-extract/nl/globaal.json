                                "target_senses": [
                                    {
                                        "sense_id": "5e2d0422-e9f0-38f8-a6f6-325e59bc2374",
                                        "entry_id": "c5fdfd24-b447-3ece-ba78-060d51874db2",
                                        "glosses": [
                                            "To estimate."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "913b2b2b-acbd-4f42-85c0-898785800894",
                                                "sense_id": "5e2d0422-e9f0-38f8-a6f6-325e59bc2374",
                                                "text": "I approximated the value of pi by taking 22 divided by 7."
                                            },
                                            {
                                                "example_id": "3bb979de-2cdc-4dd5-8d4a-c00d725c2240",
                                                "sense_id": "5e2d0422-e9f0-38f8-a6f6-325e59bc2374",
                                                "text": "As yet, we don't know what the comparable figures will be like for the current financial year which ends in March 2022, but we can have a good stab at approximating them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3e4addf-d726-38d5-af2f-d97ec0eddb75",
                                        "entry_id": "c5fdfd24-b447-3ece-ba78-060d51874db2",
                                        "glosses": [
                                            "To come near to; to approach."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "925a16d4-69dc-4ef2-97fb-373767c66711",
                                                "sense_id": "e3e4addf-d726-38d5-af2f-d97ec0eddb75",
                                                "text": "When you follow two separate chains of thought, Watson, you will find some point of intersection which should approximate to the truth."
                                            },
                                            {
                                                "example_id": "bff9448e-544b-44fd-8aa5-2f69e1a84aec",
                                                "sense_id": "e3e4addf-d726-38d5-af2f-d97ec0eddb75",
                                                "text": "The telescope approximates perfection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09ac6cdb-f62b-3ccd-b2cd-c9a21c208b8b",
                                        "entry_id": "c5fdfd24-b447-3ece-ba78-060d51874db2",
                                        "glosses": [
                                            "To carry or advance near; to cause to approach."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "333e6777-246b-424a-b01e-70fe931f7129",
                                                "sense_id": "09ac6cdb-f62b-3ccd-b2cd-c9a21c208b8b",
                                                "text": "to approximate the inequality of riches to the level of nature"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
