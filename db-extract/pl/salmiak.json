                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e66a1f4-040d-4ada-921b-f5b9eb8b81b5",
                                                "sense_id": "3f142336-5b73-3b98-867e-2a311a2fab3d",
                                                "text": "Een fles met geconcentreerd zoutzuur naast één met ammonia geeft onherroepelijk een wolk salmiak."
