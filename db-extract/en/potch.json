                    {
                        "sense_id": "4dfe5009-71fc-36e0-be34-d149de964940",
                        "entry_id": "c1596d47-ef88-3d48-b5a8-bd3e50206e44",
                        "glosses": [
                            "To bleach rags in paper-making."
