                                        "sense_id": "c93adb0d-69df-39cb-93f9-b42719572812",
                                        "entry_id": "e9571054-fec4-3f33-890c-f1b0dd3acb7f",
                                        "glosses": [
                                            "A restraining belt attached to a vehicle seat and fastened around occupants in order to keep them in place and decelerate them smoothly rather than suddenly in an accident, mitigating the risk of injury from uncontrolled impact with injurious objects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96991df2-b7df-4812-8e08-0d3c931846cd",
                                                "sense_id": "c93adb0d-69df-39cb-93f9-b42719572812",
                                                "text": "\"Wearing a seat belt for drivers and front seat occupants reduces the risk of death by 45 to 50%. Just think about that for a moment. A 50% more chance of staying alive. Who wouldn't go for that?\" Michelle Yeoh, Reckless driving has 'immense' human and economic toll, Brussels, Euronews, Jorge Liboreiro, 20/9/2023"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
