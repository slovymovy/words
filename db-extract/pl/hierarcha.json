                    {
                        "sense_id": "2bb9c115-c6ce-35cd-86de-41120389a92c",
                        "entry_id": "3a21080b-aa94-32e9-825b-7a3161286afb",
                        "glosses": [
                            "wysoki dostojnik w Kościele katolickim lub wschodnich kościołach chrześcijańskich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dfb7036-94a9-4dd0-bdc0-0b9a1f25bbcd",
                                "sense_id": "2bb9c115-c6ce-35cd-86de-41120389a92c",
                                "text": "„Kościół nie jest wylęgarnią pedofilów” – hierarchowie bronią się przed oskarżeniami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23edf273-fe53-4112-8af9-42d8e6351300",
                        "source_entry_id": "3a21080b-aa94-32e9-825b-7a3161286afb",
                        "source_sense_id": "2bb9c115-c6ce-35cd-86de-41120389a92c",
                        "target_lang_word": "hiérarque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hiérarque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ed7833b-ea87-3e34-b50f-c0da49603605",
                                        "entry_id": "d707f8b0-e18e-3093-9969-a7bb488b7bea",
                                        "glosses": [
                                            "Chef d'une hiérarchie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7031ce1-eec2-45ef-aaab-be176d6ad934",
                                                "sense_id": "9ed7833b-ea87-3e34-b50f-c0da49603605",
                                                "text": "Les armées célestes des anges […] s'assemblèrent innombrables devant le trône du Tout-Puissant, sous leurs hiérarques en ordres brillans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b36187c-7b03-3ed4-b573-e9ae3439120c",
                                        "entry_id": "d707f8b0-e18e-3093-9969-a7bb488b7bea",
                                        "glosses": [
                                            "Évêque dans l'Église orthodoxe."
                                        ],
                                        "tags": [
                                            "Christianisme orthodoxe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d903e007-6b8d-4279-8a50-cb36e5423775",
                                                "sense_id": "7b36187c-7b03-3ed4-b573-e9ae3439120c",
                                                "text": "Le chef de l'Église orthodoxe russe hors frontières, le premier hiérarque, porte le titre de métropolite, avec résidence à New York."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e8b8890-b13b-3963-90fa-270c96a383e1",
                                        "entry_id": "d707f8b0-e18e-3093-9969-a7bb488b7bea",
                                        "glosses": [
                                            "Personne haut placée dans une hiérarchie."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b32e518-e1b1-4fa4-b209-3bd895392b31",
                                                "sense_id": "8e8b8890-b13b-3963-90fa-270c96a383e1",
                                                "text": "[Un commissaire et un inspecteur] avaient mis sur pied une officine « composée de plusieurs policiers constitués en réseau parallèle » qui « diffusait des informations souvent calomnieuses visant à déstabiliser un certain nombre de hiérarques de la place Beauvau »."
                                            },
                                            {
                                                "example_id": "92aba937-38cb-452e-8f23-6b1f590f32d7",
                                                "sense_id": "8e8b8890-b13b-3963-90fa-270c96a383e1",
                                                "text": "Quelques hiérarques socialistes avaient alors démenti notre information."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
