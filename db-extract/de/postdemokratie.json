                "senses": [
                    {
                        "sense_id": "9e80b6ed-3bb2-3169-b38f-235bce3f0a3f",
                        "entry_id": "38cbeea3-2f64-3b65-9945-bcdbe9e8db99",
                        "glosses": [
                            "gesellschaftliche Situation, die durch eine Verschiebung von politischen Entscheidungsprozessen weg von den Parlamenten und Parteien in einen Bereich gebrochener Transparenz ausgezeichnet ist"
                        ],
                        "tags": [
                            "Politikwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "826c7877-3b1d-4fd9-b341-fa981b3bb6e4",
                                "sense_id": "9e80b6ed-3bb2-3169-b38f-235bce3f0a3f",
                                "text": "„Wir werden noch sehen, daß gerade auch der geistige Zuschnitt unserer Zeit mit Einschluß der Verfassung des öffentlichen Lebens, für die man schon länger den Titel der „Postmoderne“, seit den 90er Jahren auch den spezielleren der „Postdemokratie“ gefunden hat, wesentlich durch eine untergründig und gelegentlich auch explizit werdende Nichtunterscheidung zwischen leerer und gehaltvoller Sprache gekennzeichnet ist.“"
                            },
                            {
                                "example_id": "1bbb793f-8bc7-4a99-8b7f-1eb3e62b00b0",
                                "sense_id": "9e80b6ed-3bb2-3169-b38f-235bce3f0a3f",
                                "text": "In der Postdemokratie werden brisante Themen aus der öffentlichen Debatte herausgehalten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
