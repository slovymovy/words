                        "examples": [
                            {
                                "example_id": "5d8ced56-52db-4118-ba8e-3f7ddf3eed25",
                                "sense_id": "dc20eef4-36eb-3eef-9e50-32a972db00fd",
                                "text": "Comme si cette surface, par rapport à la Vie, se fût trouvée alors dans un état de quasi-sursaturation amenant une prise rapide de ses éléments vitalisables en une seule même membrane, - première ébauche de ce qui, au cours des temps géologiques, devait donner « la Biosphère »."
                            },
                            {
                                "example_id": "1332a2fd-f89a-4d7d-ad36-093bdf955944",
                                "sense_id": "dc20eef4-36eb-3eef-9e50-32a972db00fd",
                                "text": "La matière est ce qui est vitalisable, la vie ce qui est spiritualisable, l'esprit ce qui est divinisable."
                            }
                        ]
                    }
