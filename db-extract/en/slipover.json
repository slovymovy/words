                                "target_senses": [
                                    {
                                        "sense_id": "3f98c738-2378-3ae5-a153-d1fb690a1a89",
                                        "entry_id": "13abb8ac-85cc-3ffe-b3c2-b9e889403fd4",
                                        "glosses": [
                                            "langärmeliges Kleidungsstück, das den Oberkörper bedeckt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1f361c8-d571-4aea-a50b-e47a187d527f",
                                                "sense_id": "3f98c738-2378-3ae5-a153-d1fb690a1a89",
                                                "text": "Er zog sich einen warmen Pullover an."
                                            },
                                            {
                                                "example_id": "093edf0b-1810-410c-be24-c82cadaf319e",
                                                "sense_id": "3f98c738-2378-3ae5-a153-d1fb690a1a89",
                                                "text": "„Zitternd vor Kälte schlüpfte Nikki in einen schwarzen Rock, einen khakifarbenen Pullover und in ihre Wildlederstiefel.“"
                                            },
                                            {
                                                "example_id": "25005ac3-cd29-4398-b684-ba44fe25ea07",
                                                "sense_id": "3f98c738-2378-3ae5-a153-d1fb690a1a89",
                                                "text": "„Ich riss mir die albernen Clownskleider herunter, zog einen Pullover Hugos über, sein Geruch besänftigte mich ein wenig, und rief Arnfrieds WG an.“"
                                            },
                                            {
                                                "example_id": "3fbae342-0876-4d6a-bac4-7198416fe6a2",
                                                "sense_id": "3f98c738-2378-3ae5-a153-d1fb690a1a89",
                                                "text": "„Der Pullover erwies sich als Corpus delicti, als der Chor ein abruptes Ende fand und nahm.“"
                                            },
                                            {
                                                "example_id": "f0a88269-620f-4222-bb4e-328372e219b5",
                                                "sense_id": "3f98c738-2378-3ae5-a153-d1fb690a1a89",
                                                "text": "„Er stand auf, zog einen anderen Pullover und seinen Cordanzug an und verließ das Zimmer – nicht ohne Mund und Rachen mit Odol gespült zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20546228-35b1-4356-a7c5-8c4df4ab4b26",
                        "source_entry_id": "0f4c80a0-7384-3889-beb9-cbd33d16193d",
                        "source_sense_id": "4e42a22f-479b-33ba-b3dd-86c771064f73",
                        "source_sense_description": "Pullunder",
                        "target_lang_word": "Pullunder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pullunder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9523b5e4-ce25-3b46-b1b0-063f303a5acd",
                                        "entry_id": "5ddf809d-ecf2-3269-877e-a63bada46b11",
                                        "glosses": [
                                            "Pullover ohne Ärmel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b7b1cc4-cc47-4e1a-aebf-6a08d7db88ac",
                                                "sense_id": "9523b5e4-ce25-3b46-b1b0-063f303a5acd",
                                                "text": "Im Winter trägt man gerne zusätzlich einen Pullunder."
                                            },
                                            {
                                                "example_id": "9d6bf93c-006f-40ed-8507-bd1a0d55b34d",
                                                "sense_id": "9523b5e4-ce25-3b46-b1b0-063f303a5acd",
                                                "text": "„Über dem Hemd mit dem großen Kragen trägt er einen Pullunder mit Rautenmuster, so wie das bei den jungen Leuten heute modern ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
