        "nl-extract.jsonl": [
            {
                "entry_id": "a65a69cb-c967-3855-a2e4-f82454cb5d15",
                "word": "kaïnsteken",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "d4c8306c-f77f-42b3-a8c5-3441235481b6",
                        "entry_id": "a65a69cb-c967-3855-a2e4-f82454cb5d15",
                        "tags": [
                            "plural"
                        ],
                        "form": "kaïnstekens"
                    },
                    {
                        "form_id": "0ec27cb4-00c5-49af-a133-a445446b08e7",
                        "entry_id": "a65a69cb-c967-3855-a2e4-f82454cb5d15",
                        "tags": [],
                        "form": "Kaïnsteken",
                        "note": "volgens de officiële spelling tot 2006"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a61e891f-f9ee-3abb-80d1-e1bf5c1ccef5",
                        "entry_id": "a65a69cb-c967-3855-a2e4-f82454cb5d15",
                        "glosses": [
                            "uiterlijk kenmerk waaruit wordt afgeleid dat iemand niet deugt of iets misdaan heeft"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d3d82734-cd65-44c5-9df4-6c0cd96bfe6a",
                                "sense_id": "a61e891f-f9ee-3abb-80d1-e1bf5c1ccef5",
                                "text": "SIMON: Valke was best een goede voetballer. Als hij die bal gewoon had weggeschoten, had Nederland waarschijnlijk het WK in 1986 gehaald, maar uiteindelijk gingen de Belgen. (…)\nDAVID: Valke pleegde als het ware per ongeluk zelfmoord, waardoor hij levenslang het kaïnsteken draagt."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e048db0-af36-3493-b1f5-9f8e645c7aec",
                        "entry_id": "a65a69cb-c967-3855-a2e4-f82454cb5d15",
                        "glosses": [
                            "benaming voor doorlopende wenkbrauwen"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "33779280-2d07-4c9f-acdd-1919263521fc",
                                "sense_id": "0e048db0-af36-3493-b1f5-9f8e645c7aec",
                                "text": "Kenmerkend voor het zogenaamde ‘lombrosotype’ zouden aaneengegroeide wenkbrauwen zijn, ook wel een ‘kaïnsteken’ genoemd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f99a328-74d9-4317-ac92-56950dc25a08",
                        "source_entry_id": "a65a69cb-c967-3855-a2e4-f82454cb5d15",
                        "target_lang_word": "brand of Cain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "88ab16c2-2b2b-4bea-8e45-cdf9ad27e265",
                        "source_entry_id": "a65a69cb-c967-3855-a2e4-f82454cb5d15",
                        "target_lang_word": "mark of Cain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mark of Cain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae460d30-7f2c-3aa3-ba0f-90c020d995b1",
                                        "entry_id": "3e174687-cb88-3cb8-a14f-92d3b35c17b6",
                                        "glosses": [
                                            "A mark of divine protection imposed on Cain, a biblical figure, for murdering his brother Abel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8a127b5-a1ab-4a95-be39-58c71bf37e80",
                                                "sense_id": "ae460d30-7f2c-3aa3-ba0f-90c020d995b1",
                                                "text": "The Bible vaguely describes the mark of Cain; it does not specify its exact nature."
                                            },
                                            {
                                                "example_id": "3a9941cd-36ff-4041-b6eb-d61c5d2b962e",
                                                "sense_id": "ae460d30-7f2c-3aa3-ba0f-90c020d995b1",
                                                "text": "If that is true, whatever the mark of Cain was, God removed His protection."
                                            },
                                            {
                                                "example_id": "d0c8ca9d-288c-4815-bfbb-25bcf97b9b59",
                                                "sense_id": "ae460d30-7f2c-3aa3-ba0f-90c020d995b1",
                                                "text": "The mark of Cain was a one-time act of mercy for a rebellious sinner, but the marks Christ bears were from a once-for-all sacrifice given for the sins of rebellious mankind."
                                            },
                                            {
                                                "example_id": "3b1fb0cc-33e2-4e63-ac40-82bdd5376a4e",
                                                "sense_id": "ae460d30-7f2c-3aa3-ba0f-90c020d995b1",
                                                "text": "The Mark of Cain was most likely a physical mark left by God on Cain’s head, which demonstrated to the world He had God’s protection; ultimately, the Bible does not need to go into more detail, because what the specific mark was is not important, rather the love of God’s forgiveness and mercy is the important message."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91aa035f-26c4-3992-ae87-61ae2d276d38",
                                        "entry_id": "3e174687-cb88-3cb8-a14f-92d3b35c17b6",
                                        "glosses": [
                                            "A stigma of shame."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8279c45-ce26-4330-869b-ca39a55ca87f",
                                                "sense_id": "91aa035f-26c4-3992-ae87-61ae2d276d38",
                                                "text": "When the engineer's design failed, he received a mark of Cain causing others to choose not to work with him."
                                            },
                                            {
                                                "example_id": "725bcb7d-2950-4155-b75f-0d4c872757ae",
                                                "sense_id": "91aa035f-26c4-3992-ae87-61ae2d276d38",
                                                "text": "A genetic defect might metaphorically be referred to as a \"Mark of Cain\""
                                            },
                                            {
                                                "example_id": "ec858de4-d242-4228-a901-575f1616952f",
                                                "sense_id": "91aa035f-26c4-3992-ae87-61ae2d276d38",
                                                "text": "Werksman called the jail clothes a “mark of Cain” that branded his client a criminal in photos and video from the courtroom."
                                            },
                                            {
                                                "example_id": "d921f2db-6b24-4bc8-aefe-6729d789373d",
                                                "sense_id": "91aa035f-26c4-3992-ae87-61ae2d276d38",
                                                "text": "Yoav Gallant, speaking after Prime Minister Benjamin Netanyahu abruptly fired him from the role of defense minister, warned that Israel would forever bear “the mark of Cain” if it abandons the hostages held in Gaza, and saluted the IDF, hostages and fallen soldiers in a forceful denunciation of the government from which he was dismissed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f47cf5d7-7b92-310e-af75-fa6b6511d066",
                                        "entry_id": "3e174687-cb88-3cb8-a14f-92d3b35c17b6",
                                        "glosses": [
                                            "The darker skin found on people of non-European descent, believed to result from being a supposed descendant of Cain."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "ethnic",
                                            "obsolete",
                                            "offensive",
                                            "slur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "001272be-e605-4ba4-9f8c-7a409f562323",
                                                "sense_id": "f47cf5d7-7b92-310e-af75-fa6b6511d066",
                                                "text": "That the descendants of Cain were black, inheriting the mark of Cain."
                                            },
                                            {
                                                "example_id": "fb0b861e-b4d1-4409-b5d5-ae018769daf6",
                                                "sense_id": "f47cf5d7-7b92-310e-af75-fa6b6511d066",
                                                "text": "He who would harbor the inhuman, sacriligious thought, let him be anathematized by heaven; let him receive the mark of Cain, and be driven from the pale of civilized society, to wander a fugitive and a vagabond on the Earth."
                                            },
                                            {
                                                "example_id": "e2bb0e86-c8c2-475b-aee8-040d8c41f670",
                                                "sense_id": "f47cf5d7-7b92-310e-af75-fa6b6511d066",
                                                "text": "And we have no more reliable evidence of any personal apportionment of the three great division of the eastern hemisphere, between the three sons of Noah, or their descendants respectively, at any period whatever, than for the very learned and discriminating hypothesis, which has attributed the sable complexion of the negro to the mark of Cain and hence deduced an argument for African enslavement!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "858a939d-b846-42a5-91ba-856e25335ad4",
                        "source_entry_id": "a65a69cb-c967-3855-a2e4-f82454cb5d15",
                        "source_sense_ids": [],
                        "linkage_type": "synonyms",
                        "word": "kaïnsmerk"
                    }
                ]
            },
            {
                "entry_id": "124b0485-88aa-3221-8380-16744d58e397",
                "word": "Kaïnsteken",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "83e7fc7a-bc41-3f7e-aa7f-afd3793ac42c",
                        "entry_id": "124b0485-88aa-3221-8380-16744d58e397",
                        "glosses": [
                            "symbool waaraan mensen konden zien dat God niet wilde dat zij Kaïn zouden doden\\nUit de tekst van Openbaringen 14:9 wordt traditioneel afgeleid dat dit teken als een schandmerk op Kaïns voorhoofd was gedrukt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "200959be-2d62-480d-bfe1-77e66e486f4b",
                                "sense_id": "83e7fc7a-bc41-3f7e-aa7f-afd3793ac42c",
                                "text": "‘Alwie Kaïn doodslaat, zal zevenvoudig gewroken worden’, zegt God ter vergoelijking van het Kaïnsteken waarmee hij Kaïn straft voor de moord op zijn broer (H)abel."
                            }
                        ]
                    },
                    {
                        "sense_id": "344311f0-d485-325d-ba9e-6ca669f7fded",
                        "entry_id": "124b0485-88aa-3221-8380-16744d58e397",
                        "glosses": [
                            "verouderde spelling of vorm van kaïnsteken tot 2006"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "fa883ef2-7d4b-48a5-be54-26cc06ff5625",
                                "sense_id": "344311f0-d485-325d-ba9e-6ca669f7fded",
                                "text": "Met 'profiel-21' of een andere indicator voor militaire ongeschiktheid als Kaïnsteken op het voorhoofd had hij weinig kans op een fatsoenlijke baan gehad."
                            }
                        ]
                    }
                ],
