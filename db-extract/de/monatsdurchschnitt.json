                "senses": [
                    {
                        "sense_id": "9ce7510c-fc39-3e51-a691-6054164e8113",
                        "entry_id": "41b3d9fd-07bc-3811-ab18-18ab9bccb5e7",
                        "glosses": [
                            "Durchschnittswert, errechnet aus den Werten, die für den Zeitraum von einem Monat vorliegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3cb57fb-5376-4826-acaa-052300190401",
                                "sense_id": "9ce7510c-fc39-3e51-a691-6054164e8113",
                                "text": "„2017 waren österreichweit im Monatsdurchschnitt 863 Journalisten arbeitslos gemeldet, um 1,3 Prozent mehr als im Jahr zuvor.“"
                            },
                            {
                                "example_id": "f9e992c5-5252-432a-888f-27aaa062bf23",
                                "sense_id": "9ce7510c-fc39-3e51-a691-6054164e8113",
                                "text": "„Im Februar stieg in diesem Gebiet die Temperatur um mehr als fünf Grad über den Monatsdurchschnitt - verglichen mit dem Monat Februar der Jahre 1981 bis 2010.“"
                            },
                            {
                                "example_id": "2f39fbf8-4f3c-494e-9ca7-21f5a5799efe",
                                "sense_id": "9ce7510c-fc39-3e51-a691-6054164e8113",
                                "text": "„Erlaubt ist ein Bruttoverdienst von 4800 Euro pro Jahr oder 400 Euro im Monatsdurchschnitt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
