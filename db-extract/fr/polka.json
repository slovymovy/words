        "fr-extract.jsonl": [
            {
                "entry_id": "3b3499da-aa92-32eb-a137-8cf934dc4bcb",
                "word": "polka",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "938f5c70-47cc-4011-890d-7880a556efda",
                        "entry_id": "3b3499da-aa92-32eb-a137-8cf934dc4bcb",
                        "tags": [
                            "plural"
                        ],
                        "form": "polkas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff9550ab-434a-3c37-8665-92badd3f73fd",
                        "entry_id": "3b3499da-aa92-32eb-a137-8cf934dc4bcb",
                        "glosses": [
                            "Danse de salon d’origine tchèque ou polonaise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67574db8-ea09-445e-b497-ee12342edcaf",
                                "sense_id": "ff9550ab-434a-3c37-8665-92badd3f73fd",
                                "text": "La polka est quelque chose de très gracieux qui aurait fort scandalisé nos aïeules."
                            },
                            {
                                "example_id": "316d15cb-3472-46da-89b2-4c678cd2602a",
                                "sense_id": "ff9550ab-434a-3c37-8665-92badd3f73fd",
                                "text": "Ces dames dansèrent. Les polkas, les valses, les mazurkas, alternèrent avec les quadrilles."
                            },
                            {
                                "example_id": "a2f8c951-ee0d-44cf-87b4-56cea6746b95",
                                "sense_id": "ff9550ab-434a-3c37-8665-92badd3f73fd",
                                "text": "Mes trois aînés avaient en commun un amour exalté de la danse. La polka pointée, la mazurka, la scottish, la valse étourdissante, la valse vertigineuse, le pas des patineurs, les quadrilles, les lanciers…, rien ne leur était inconnu."
                            }
                        ]
                    },
                    {
                        "sense_id": "a150c523-2061-3649-b084-b1765c745e87",
                        "entry_id": "3b3499da-aa92-32eb-a137-8cf934dc4bcb",
                        "glosses": [
                            "Musique à deux temps sur laquelle on exécute cette danse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08a8d081-8a4f-40de-9eb3-d222d25d6124",
                                "sense_id": "a150c523-2061-3649-b084-b1765c745e87",
                                "text": "Il passait le reste de son temps à composer des polkas de brasserie."
                            },
                            {
                                "example_id": "7b2ea166-eeb9-467c-ad23-add49c6edfb7",
                                "sense_id": "a150c523-2061-3649-b084-b1765c745e87",
                                "text": "Et personne ne pleure sinon je mets ma playlist de polkas norvégiennes version maggamuffin free jazz…"
                            },
                            {
                                "example_id": "999a70c8-c733-4c1b-b23e-a73be3f97af6",
                                "sense_id": "a150c523-2061-3649-b084-b1765c745e87",
                                "text": "Jouer une polka."
                            }
                        ]
                    },
                    {
                        "sense_id": "cdaf7fb5-9516-39d7-8b79-e0ce7615c882",
                        "entry_id": "3b3499da-aa92-32eb-a137-8cf934dc4bcb",
                        "glosses": [
                            "Coiffe traditionnelle portée en Bretagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7369c497-0ba1-4107-854a-438480ac0119",
                                "sense_id": "cdaf7fb5-9516-39d7-8b79-e0ce7615c882",
                                "text": "Sur le premier pont se tient une femme portant la polka, coiffe traditionnelle de la région de Rennes."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4084eca-bdb2-38de-9414-1585fc1996fe",
                        "entry_id": "3b3499da-aa92-32eb-a137-8cf934dc4bcb",
                        "glosses": [
                            "Marteau de tailleur de pierre à deux taillants opposés, l’un parallèle au manche, l’autre perpendiculaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9b40bd4-36d1-491e-b551-b41036148da7",
                                "sense_id": "b4084eca-bdb2-38de-9414-1585fc1996fe",
                                "text": "Le taillant à deux tranchants perpendiculaires est appelé Polka."
                            },
                            {
                                "example_id": "be0ece9b-90a9-4624-aec3-cc908d70dc4d",
                                "sense_id": "b4084eca-bdb2-38de-9414-1585fc1996fe",
                                "text": "La Polka apparaît à l'époque romaine puis disparaît pour revenir supplanter le taillant au Moyen Âge. L'outil est comparable au taillant à la différence près qu'il est muni de deux tranchants orientés différemment."
                            }
                        ]
                    },
                    {
                        "sense_id": "f58a1742-3fa4-382d-b409-645dbca3bb3b",
                        "entry_id": "3b3499da-aa92-32eb-a137-8cf934dc4bcb",
                        "glosses": [
                            "Brouette utilisée dans les champignonnières."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acffa0e1-3216-43ad-b053-188b111082da",
                                "sense_id": "f58a1742-3fa4-382d-b409-645dbca3bb3b",
                                "text": "Ainsi … dans le domaine de la mycoculture, la \"polka\" désigne une brouette utilisée en carrière pour la manutention des champignons de couche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddd3f4f1-168b-4ff3-b997-005b191a3c08",
                        "source_entry_id": "3b3499da-aa92-32eb-a137-8cf934dc4bcb",
                        "source_sense_description": "danse",
                        "target_lang_word": "Polka",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polka",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26a5148e-13a9-3989-a9a5-540f3d91e3d4",
                                        "entry_id": "3e321d00-684b-3a2d-be10-921b0422296b",
                                        "glosses": [
                                            "ein beschwingter Rundtanz aus Böhmen im lebhaften bis raschen Zweivierteltakt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43f69c7e-1249-4a33-89a7-4357f06b7439",
                                                "sense_id": "26a5148e-13a9-3989-a9a5-540f3d91e3d4",
                                                "text": "„Und langweilen tut sie sich! Sie möchte natürlich in der Stadt wohnen und Abend für Abend Polka tanzen! Arme kleine Frau! So was schnappt nach Liebe wie ein Karpfen auf dem Küchentisch nach Wasser.“"
                                            },
                                            {
                                                "example_id": "174b526b-490b-495c-9ccf-f16d18dcefe6",
                                                "sense_id": "26a5148e-13a9-3989-a9a5-540f3d91e3d4",
                                                "text": "„Von Zeit zu Zeit wandte er sich, in die Hände klatschend, zum Kapellmeister, damit dieser den Einsatz zu einer Polka oder einer Mazurka gebe, um die Wartezeit zu überbrücken.“"
                                            },
                                            {
                                                "example_id": "ac0aa141-25b4-45e6-892b-9f3ffe39157d",
                                                "sense_id": "26a5148e-13a9-3989-a9a5-540f3d91e3d4",
                                                "text": "„Der Auftritt der Blasmusiker mit Walzer, Polka, Marsch, Opernstücken und symphonischer Musik ist ein Besuchermagnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
