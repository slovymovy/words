                "senses": [
                    {
                        "sense_id": "5b1783bb-d09f-3517-afe7-d34c2b47fcc1",
                        "entry_id": "4309fff1-7902-3ca3-975c-5f2a622394cf",
                        "glosses": [
                            "Grenzbereich eines Waldes, Übergangsbereich zwischen Wald und umgebendem Gelände"
                        ],
                        "tags": [
                            "literary",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "b7ef1572-71c6-49fd-b057-84e73f347093",
                                "sense_id": "5b1783bb-d09f-3517-afe7-d34c2b47fcc1",
                                "text": "„Wenn Rehe am anderen Waldesrand gemächlich äsen, zerrt sie an der Leine, ist kaum zu halten.“"
                            },
                            {
                                "example_id": "f5d608f1-2941-40f2-955a-4d1a8e4337d5",
                                "sense_id": "5b1783bb-d09f-3517-afe7-d34c2b47fcc1",
                                "text": "„Und wie wir so schauten und starrten, kam es auf einmal ganz schwarz und blau da herein zwischen den beiden Waldesrändern. Kamen die Spanier, wohl an die hundert, herangesprungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
