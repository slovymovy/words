                        "source_sense_id": "cb2cf6ec-411a-3571-b041-af265ad0353c",
                        "source_sense_description": "Astronomie: dichter, heller Zentralbereich einer Spiralgalaxie",
                        "target_lang_word": "bulge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
