    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dc2e6317-8719-3106-b643-001dcd6b2be1",
                    "sense_definition": "Een suiker of koolhydraat omzetten door blootstelling aan de werking van een gist.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fermentatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vervolgens <w>vergisten</w> we alle aanwezige suikers tot alcohol.",
                            "target_lang_translations": {
                                "en": "Next, we <w>ferment</w> all present sugars into alcohol."
                            }
                        },
                        {
                            "text": "De brouwer laat de most langzaam <w>vergisten</w> in grote houten vaten.",
                            "target_lang_translations": {
                                "en": "The brewer lets the must <w>ferment</w> slowly in large wooden vats."
                            }
                        }
                    ],
                    "synonyms": [
                        "fermenteren"
                    ],
                    "common_phrases": [
                        "suikers vergisten tot alcohol"
                    ],
                    "target_lang_definitions": {
                        "en": "To convert a sugar or carbohydrate through exposure to the action of a yeast."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ferment",
                                "target_lang_sense_clarification": "active process of converting sugars"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "216007ce-e6fb-3717-bbe9-dbf07259dfe1",
                    "sense_definition": "Het ondergaan van een proces van omzetting van koolhydraten door gist.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fermentatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Alle suikers <w>vergistten</w> daarbij tot alcohol.",
                            "target_lang_translations": {
                                "en": "All sugars <w>fermented</w> into alcohol in the process."
                            }
                        },
                        {
                            "text": "Het sap begint spontaan te <w>vergisten</w> als het warm genoeg is.",
                            "target_lang_translations": {
                                "en": "The juice starts to <w>ferment</w> spontaneously when it is warm enough."
                            }
                        }
                    ],
                    "synonyms": [
                        "fermenteren"
                    ],
                    "common_phrases": [
                        "spontaan vergisten"
                    ],
                    "target_lang_definitions": {
                        "en": "To undergo a process of conversion of carbohydrates by yeast."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ferment",
                                "target_lang_sense_clarification": "undergoing fermentation"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "67473686-6274-3100-b6b0-2bd2c99165cd",
                    "sense_definition": "Meervoud verleden tijd van <w>vergissen</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij <w>vergisten</w> ons in de datum van de afspraak.",
                            "target_lang_translations": {
                                "en": "We <w>were mistaken</w> about the date of the appointment."
                            }
                        },
                        {
                            "text": "Zij dachten dat het gratis was, maar zij <w>vergisten</w> zich behoorlijk.",
                            "target_lang_translations": {
                                "en": "They thought it was free, but they <w>were</w> quite <w>mistaken</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich vergisten"
                    ],
                    "traits": [
