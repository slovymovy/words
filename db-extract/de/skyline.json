                "senses": [
                    {
                        "sense_id": "1eea01e4-4498-3d1e-9949-5ff463d07a0d",
                        "entry_id": "9e4120ab-a1f3-3105-90a5-0f977cc264e8",
                        "glosses": [
                            "Silhouette einer Stadt, aus der Ferne betrachtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1fa8c04-8bac-482f-a4b6-307450f129c6",
                                "sense_id": "1eea01e4-4498-3d1e-9949-5ff463d07a0d",
                                "text": "Von der Staten Island Ferry hat man einen atemberaubenden Blick auf die Skyline von Manhattan."
                            },
                            {
                                "example_id": "ef301106-a77d-4388-945b-a0d787c89af0",
                                "sense_id": "1eea01e4-4498-3d1e-9949-5ff463d07a0d",
                                "text": "Der Bildband zeigt Skylines unterschiedlicher Städte."
                            },
                            {
                                "example_id": "a1ec8e16-5bac-45da-b901-a75820bb4f96",
                                "sense_id": "1eea01e4-4498-3d1e-9949-5ff463d07a0d",
                                "text": "„Vor uns stand die Skyline der mittelalterlichen Stadt im Sonnenlicht.“"
                            },
                            {
                                "example_id": "493b55dd-255d-4128-b993-e21fc29d7bff",
                                "sense_id": "1eea01e4-4498-3d1e-9949-5ff463d07a0d",
                                "text": "„Über den dunkler werdenden westlichen Horizont zogen lange, stumpfrote Wolkenriffe. Dächer in einer niedrigen, schäbigen Skyline.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
