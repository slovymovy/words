                ],
                "senses": [
                    {
                        "sense_id": "2e9eb13a-b3b7-31ec-a304-460659641802",
                        "entry_id": "f9e47db8-4ad9-313d-97a4-db177be3467f",
                        "glosses": [
                            "paarweise seitlich am Mast befestigte Strebe, die die Want abspreizt (bei Jollen und Yachten heute meist aus Aluminium oder Kohlefaser, bei Großseglern meist aus Holz)"
                        ],
                        "tags": [
                            "Seemannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "11e5c233-bcb2-4f2f-a07d-e3c0af715069",
                                "sense_id": "2e9eb13a-b3b7-31ec-a304-460659641802",
                                "text": "Im Winterlager werden die Salinge abgeschraubt."
                            },
                            {
                                "example_id": "a63e5ec6-18d7-4f16-81c2-7ed670b65bde",
                                "sense_id": "2e9eb13a-b3b7-31ec-a304-460659641802",
                                "text": "Die Segel leiden an den Salingen, häufig gibt es Scheuerstellen."
                            },
                            {
                                "example_id": "33f9c484-d13a-4a54-a1ca-902cf7c92fc2",
                                "sense_id": "2e9eb13a-b3b7-31ec-a304-460659641802",
                                "text": "Die Salinge einer Yacht gehören zum 'stehenden Gut'."
                            },
                            {
                                "example_id": "a43f907a-fb77-411d-a465-631d5dd79ee0",
                                "sense_id": "2e9eb13a-b3b7-31ec-a304-460659641802",
                                "text": "Die Verbandsflagge des Deutschen Segler-Verbandes oder die Flagge der Kreuzer-Abteilung wird unter der Steuerbord-Saling gesetzt, im Ausland unter der Backbord-Saling."
                            },
                            {
                                "example_id": "a23e5a87-20d2-4876-adef-ffc2d1c51e1d",
                                "sense_id": "2e9eb13a-b3b7-31ec-a304-460659641802",
                                "text": "„In Boltenhagen haben die Ordnungshüter Strafanzeige gegen Eigner gestellt, die unter der Saling Flagge zeigen – aber die falsche“"
                            },
                            {
                                "example_id": "dde3290e-292a-40c6-a3d5-07139dcc0c3a",
                                "sense_id": "2e9eb13a-b3b7-31ec-a304-460659641802",
                                "text": "„Riggs mit gepfeilten Salingen, die also etwas nach achtern vom Mast wegstehen, haben einen großen Vorteil gegenüber solchen mit neutralen Salingen: Sie sind deutlich einfacher zu bedienen.“"
                            },
                            {
                                "example_id": "eb72e099-79de-4935-bde8-c5b4d6aa3033",
                                "sense_id": "2e9eb13a-b3b7-31ec-a304-460659641802",
                                "text": "„Wenige Tage vor der Bootstaufe kommt auch der Mast endlich an. Eilig werden Ober-, Unter- und Mittelwanten sowie Backstagen, Unterbackstagen und das Babystag mit den Bumerang-förmigen Salingen zusammengebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
