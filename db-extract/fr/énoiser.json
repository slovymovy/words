                "senses": [
                    {
                        "sense_id": "a7e316bc-4baf-378a-b143-88f90a42fc8f",
                        "entry_id": "aff22b7c-4422-396b-a1ec-b201a4051739",
                        "glosses": [
                            "Enlever la coquille d’une noix."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbfaed8d-ae3c-447f-b812-56ffba6f7299",
                                "sense_id": "a7e316bc-4baf-378a-b143-88f90a42fc8f",
                                "text": "Les femmes filent, les enfants énoisent, les hommes adoubent les courroies de leurs fléaux, remettent des dents à leurs râteaux ou gravent un manche de fouet, le bec d'une canne."
                            },
                            {
                                "example_id": "6a0fb442-8a80-4528-9331-768c90505d84",
                                "sense_id": "a7e316bc-4baf-378a-b143-88f90a42fc8f",
                                "text": "Les noix seraient bientôt bonnes à gauler, et nous aurions après les longues soirées à énoiser méticuleusement chaque fruit pour sa future pression au moulin."
                            }
                        ]
                    }
                ],
