{
    "word_family": [
        "culled",
        "culling",
        "culls"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c1e97314-d46b-3b36-991f-32809f79017a",
                    "sense_definition": "To pick or take someone or something from a larger group",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "selection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers <w>culled</w> the most relevant data from the massive survey results.",
                            "target_lang_translations": {
                                "tr": "Araştırmacılar, devasa anket sonuçlarından en alakalı verileri <w>seçip ayırdılar</w>."
                            }
                        },
                        {
                            "text": "We <w>culled</w> the best photographs from the collection to display in the gallery.",
                            "target_lang_translations": {
                                "tr": "Galeride sergilemek için koleksiyondaki en iyi fotoğrafları <w>seçip ayırdık</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "select",
                        "choose",
                        "pick"
                    ],
                    "common_phrases": [
                        "culled from"
                    ],
                    "target_lang_definitions": {
                        "tr": "Büyük bir gruptan birini veya bir şeyi seçip ayırmak"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "seçip ayırmak",
                                "target_lang_sense_clarification": "Bir grup içinden özenle seçmek"
                            },
                            {
                                "target_lang_word": "ayıklamak",
                                "target_lang_sense_clarification": "İstenmeyenleri çıkarıp iyileri tutmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ee44119-f9f4-3819-81c7-e69917ba2050",
                    "sense_definition": "To gather or collect information or items",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "selection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>culled</w> interesting facts from various historical documents for her essay.",
                            "target_lang_translations": {
                                "tr": "Makalesi için çeşitli tarihi belgelerden ilginç gerçekleri <w>derledi</w>."
                            }
                        },
                        {
                            "text": "The author <w>culled</w> inspiration from many different cultures during her travels.",
                            "target_lang_translations": {
                                "tr": "Yazar, seyahatleri sırasında birçok farklı kültürden ilham <w>derledi</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gather",
                        "collect",
                        "amass"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bilgi veya nesneleri çeşitli kaynaklardan toplamak veya derlemek"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "derlemek",
                                "target_lang_sense_clarification": "Farklı kaynaklardan bilgi toplamak"
                            },
                            {
                                "target_lang_word": "toplamak",
                                "target_lang_sense_clarification": "Bir araya getirmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6906a9c9-e8e8-33b5-946a-fc5af1b67dbf",
                    "sense_definition": "To select animals from a group and kill them to reduce the population size",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "killing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The park rangers had to <w>cull</w> the deer population to prevent overgrazing.",
                            "target_lang_translations": {
                                "tr": "Park görevlileri, aşırı otlamayı önlemek için geyik popülasyonunu <w>itlaf etmek</w> zorunda kaldı."
                            }
                        },
                        {
                            "text": "Local authorities decided to <w>cull</w> the infected birds to stop the disease.",
                            "target_lang_translations": {
                                "tr": "Yerel yetkililer, hastalığı durdurmak için enfekte kuşları <w>itlaf etmeye</w> karar verdi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Popülasyonu azaltmak amacıyla hayvanları gruptan seçip itlaf etmek"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "itlaf etmek",
                                "target_lang_sense_clarification": "Hastalık veya aşırı çoğalma nedeniyle hayvanları öldürmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c05d522-ad95-3932-866a-d82dcceabe2c",
                    "sense_definition": "To remove or lay off individuals to reduce the size of a group",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "selection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company had to <w>cull</w> several departments to cut operational costs.",
                            "target_lang_translations": {
                                "tr": "Şirket, operasyonel maliyetleri düşürmek için birkaç departmanı <w>ayıklamak</w> zorunda kaldı."
                            }
                        },
                        {
                            "text": "Management decided to <w>cull</w> the workforce to improve overall efficiency.",
                            "target_lang_translations": {
                                "tr": "Yönetim, genel verimliliği artırmak için iş gücünü <w>ayıklamaya</w> karar verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "dismiss",
                        "remove"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir grubun boyutunu küçültmek için bireyleri işten çıkarmak veya uzaklaştırmak"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "işten çıkarmak",
                                "target_lang_sense_clarification": "Personel sayısını azaltmak"
                            },
                            {
                                "target_lang_word": "ayıklamak",
                                "target_lang_sense_clarification": "Gruptan eleman eksiltmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8f63a19-84e2-3f91-8187-98f6e013a295",
                    "sense_definition": "To selectively exclude objects from rendering or processing in computer graphics",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "selection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engine uses frustum <w>culling</w> to avoid rendering objects outside the camera view.",
                            "target_lang_translations": {
                                "tr": "Motor, kamera görüşü dışındaki nesneleri işlememek için frustum <w>ayıklama</w> yöntemini kullanır."
                            }
                        },
                        {
                            "text": "Developers often <w>cull</w> distant polygons to maintain a high frame rate.",
                            "target_lang_translations": {
                                "tr": "Geliştiriciler, yüksek kare hızını korumak için genellikle uzak poligonları <w>ayıklarlar</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "back-face culling"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bilgisayar grafiklerinde işleme sırasında nesneleri seçici olarak hariç tutmak"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ayıklamak",
                                "target_lang_sense_clarification": "Gereksiz verileri işleme dışı bırakmak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d152be9-dca0-3598-8ff7-5fb124685484",
                    "sense_definition": "An organized killing of selected animals",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "killing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government announced a controversial <w>cull</w> of badgers to control disease.",
                            "target_lang_translations": {
                                "tr": "Hükümet, hastalığı kontrol altına almak için tartışmalı bir porsuk <w>itlafı</w> duyurdu."
                            }
                        },
                        {
                            "text": "Environmentalists protested against the planned <w>cull</w> of the local seal population.",
                            "target_lang_translations": {
                                "tr": "Çevreciler, yerel fok popülasyonunun planlanan <w>itlafına</w> karşı protesto düzenledi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Seçilen hayvanların organize bir şekilde itlaf edilmesi"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "itlaf",
                                "target_lang_sense_clarification": "Hayvan popülasyonunu kontrol amaçlı öldürme işlemi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb17f4a6-b1df-3e7c-aadf-bfd846112d9c",
                    "sense_definition": "An inferior specimen or item unfit for inclusion in a group",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "selection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer separated the <w>culls</w> from the healthy livestock.",
                            "target_lang_translations": {
                                "tr": "Çiftçi, <w>ıskartaları</w> sağlıklı hayvanlardan ayırdı."
                            }
                        },
                        {
                            "text": "Only the best products are kept, while any <w>cull</w> is discarded immediately.",
                            "target_lang_translations": {
                                "tr": "Sadece en iyi ürünler tutulurken, her türlü <w>ıskarta</w> derhal atılır."
                            }
                        }
                    ],
                    "synonyms": [
                        "reject"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir gruba dahil edilmeyecek kadar düşük nitelikli örnek veya öğe"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ıskarta",
                                "target_lang_sense_clarification": "Kalitesiz veya kusurlu olduğu için ayrılan ürün"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1233af47-1de2-3686-be5c-d4b1699afa33",
                    "sense_definition": "A surname",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The research was conducted by a professor named <w>Cull</w>.",
                            "target_lang_translations": {
                                "tr": "Araştırma, <w>Cull</w> adında bir profesör tarafından yürütüldü."
                            }
                        },
                        {
                            "text": "Mr. <w>Cull</w> is the new director of the local library.",
                            "target_lang_translations": {
                                "tr": "Bay <w>Cull</w>, yerel kütüphanenin yeni müdürüdür."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir soyadı"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Cull",
                                "target_lang_sense_clarification": "Özel isim (soyadı)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}