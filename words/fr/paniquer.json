                {
                    "sense_id": "13d93e20-55eb-3f60-87fd-e36727b5e72b",
                    "sense_definition": "Être saisi d'une peur soudaine et incontrôlable, perdre son sang-froid face à une situation angoissante.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "peur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Respire profondément et essaie de ne pas <w>paniquer</w> avant le début de l'épreuve."
                        },
                        {
                            "text": "Dès que l'alarme a sonné dans l'immeuble, tout le monde a commencé à <w>paniquer</w>."
                        }
                    ],
                    "synonyms": [
                        "s'affoler",
                        "s'alarmer",
                        "s'angoisser"
                    ],
                    "antonyms": [
                        "se calmer",
                        "se tranquilliser"
                    ],
                    "common_phrases": [
                        "ne pas paniquer"
                    ]
                },
                {
                    "sense_id": "1cb3a582-0fa9-391a-8f95-5088ec4f5d73",
                    "sense_definition": "Provoquer une grande frayeur ou un désarroi soudain chez quelqu'un ou dans un groupe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "peur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette fausse rumeur diffusée sur Internet a suffi à <w>paniquer</w> la population du village."
                        },
                        {
                            "text": "L'annonce d'une nouvelle taxe risque de <w>paniquer</w> les marchés financiers dès demain."
                        }
                    ],
                    "synonyms": [
                        "affoler",
                        "alarmer",
                        "effrayer"
                    ],
                    "antonyms": [
                        "apaiser",
                        "rassurer"
                    ],
                    "common_phrases": [
