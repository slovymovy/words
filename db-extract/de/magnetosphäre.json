                        "source_sense_id": "a4de3fb5-517b-3835-b08d-998246f1479c",
                        "source_sense_description": "Astronomie: das Raumgebiet um einen Planeten oder Stern, in dem das Magnetfeld des Objektes dominiert",
                        "target_lang_word": "магнитосфера",
                        "target_lang_code": "ru",
