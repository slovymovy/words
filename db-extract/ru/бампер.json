                    }
                ],
                "senses": [
                    {
                        "sense_id": "68c6abb4-fb1c-30e2-8ede-640eefaefe3a",
                        "entry_id": "2cc54971-9e52-3d21-90e1-269d6b8d4bb7",
                        "glosses": [
                            "автомоб. устройство, укрепляемое в передней и задней части автомобиля для предохранения кузова от повреждений при несильных столкновениях"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "614e4d85-f24c-415b-8fe3-ace46701bf2f",
                                "sense_id": "68c6abb4-fb1c-30e2-8ede-640eefaefe3a",
                                "text": "Ты бы лучше молчал. Выдумал ещё буфер какой-то. Буфер – это у вагона на железной дороге, а у автомобиля – бампер. Бампер есть и у «Москвича», и у «Волги»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c3a9c31-dbd2-415a-8dc8-49fd9e1db9fc",
                        "source_entry_id": "2cc54971-9e52-3d21-90e1-269d6b8d4bb7",
                        "source_sense_id": "68c6abb4-fb1c-30e2-8ede-640eefaefe3a",
                        "target_lang_word": "bumper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bumper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c29f54a7-a7f8-3af9-b506-f2bfcb0246a6",
                                        "entry_id": "74a44719-0957-340e-a9e4-8d3f64d31c4c",
                                        "glosses": [
                                            "Someone or something that bumps."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38dcf7d9-2ebd-37c0-8b9e-cdaef862ff86",
                                        "entry_id": "74a44719-0957-340e-a9e4-8d3f64d31c4c",
                                        "glosses": [
                                            "A drinking vessel filled to the brim."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "386bb7fe-efdc-4ae4-97f9-d282012aed09",
                                                "sense_id": "38dcf7d9-2ebd-37c0-8b9e-cdaef862ff86",
                                                "text": "[T]hey now shook hands heartily, and drank bumpers of strong beer to healths which we think proper to bury in oblivion."
                                            },
                                            {
                                                "example_id": "d748e7f3-e320-44dd-bfdf-5e6c7d837381",
                                                "sense_id": "38dcf7d9-2ebd-37c0-8b9e-cdaef862ff86",
                                                "text": "Pork ſucceeds to Beef, Pies to Puddings: The Cloth is remov'd, Madam, drench'd vvith a Bumper, drops a Courtſey, and departs; […]"
                                            },
                                            {
                                                "example_id": "5e120126-fb8d-4cbf-b31b-cafc72cca254",
                                                "sense_id": "38dcf7d9-2ebd-37c0-8b9e-cdaef862ff86",
                                                "text": "Yet can I gulp a bumper to thy name,— / O smile among the shades, for this is fame!"
                                            },
                                            {
                                                "example_id": "52e833bf-9306-4fb5-b59c-c677613b1874",
                                                "sense_id": "38dcf7d9-2ebd-37c0-8b9e-cdaef862ff86",
                                                "text": "Mr. Horrocks served myself and my pupils with three little glasses of wine, and a bumper was poured out for my lady."
                                            },
                                            {
                                                "example_id": "b95347d7-2ed7-4a14-9725-357c747bd95b",
                                                "sense_id": "38dcf7d9-2ebd-37c0-8b9e-cdaef862ff86",
                                                "text": "Sydney Carton drank the punch at a great rate; drank it by bumpers, looking at his friend."
                                            },
                                            {
                                                "example_id": "c62b4b1f-077b-4326-aaf2-cb857b100c70",
                                                "sense_id": "38dcf7d9-2ebd-37c0-8b9e-cdaef862ff86",
                                                "text": "Pour, oh, pour the pirate sherry; / Fill, O fill the pirate glass; / And, to make us more than merry, / Let the pirate bumper pass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b52a09ad-e82d-320c-a2e6-77d41d7f4068",
                                        "entry_id": "74a44719-0957-340e-a9e4-8d3f64d31c4c",
                                        "glosses": [
                                            "Anything large or successful."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea603120-d38b-3792-819f-c6daa70c9a15",
                                        "entry_id": "74a44719-0957-340e-a9e4-8d3f64d31c4c",
                                        "glosses": [
                                            "Parts at the front and back of a vehicle which are meant to absorb the impact of a collision; fender."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60eccfe9-5dec-3d24-a3bf-6d23c6207315",
                                        "entry_id": "74a44719-0957-340e-a9e4-8d3f64d31c4c",
                                        "glosses": [
                                            "Any mechanical device used to absorb an impact, soften a collision, or protect against impact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b6dcb29-e0e1-425e-88d9-70da01e2d5f5",
                                                "sense_id": "60eccfe9-5dec-3d24-a3bf-6d23c6207315",
