                "senses": [
                    {
                        "sense_id": "3a3ba5e2-2223-3ca2-b8c3-a8390f57479a",
                        "entry_id": "6353f619-dfad-3001-ac11-d6867254bb84",
                        "glosses": [
                            "Hühnerrasse oder Kreuzung, die Eier mit grüner bis türkisfarbener Eierschale legt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59717ece-badb-4852-9ecd-eac8f9828917",
                                "sense_id": "3a3ba5e2-2223-3ca2-b8c3-a8390f57479a",
                                "text": "Entstanden sind die Grünleger aus Kreuzungen zwischen Araucana-Hähnen mit andersrassigen Hennen."
                            },
                            {
                                "example_id": "1594e819-e7bd-463d-8111-4bf45baf57e8",
                                "sense_id": "3a3ba5e2-2223-3ca2-b8c3-a8390f57479a",
                                "text": "Während Blut beim Abbau verschiedene Farbvarianten blau, über grün bis gelb durchläuft, wird bei den Grünlegern die Abbauproduktion des Blutes nicht bis zum Ende durchgeführt und es kommt zu einer entsprechend grünen, bzw. blauen Eierschalenfarbe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
