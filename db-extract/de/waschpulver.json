                "senses": [
                    {
                        "sense_id": "d060e75f-b90d-3be4-afc9-0cf2bb3740b8",
                        "entry_id": "8d6e30fa-63a2-3ab7-8277-43a0efcbf918",
                        "glosses": [
                            "pulverförmiges Mittel, das Verunreinigungen löst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9911995-3d48-47ca-baa6-2d6f2706f263",
                                "sense_id": "d060e75f-b90d-3be4-afc9-0cf2bb3740b8",
                                "text": "Man muss einen Messlöffel Waschpulver in die Waschmaschine geben."
                            },
                            {
                                "example_id": "a934c041-721b-4c74-b1c9-bf72650b9237",
                                "sense_id": "d060e75f-b90d-3be4-afc9-0cf2bb3740b8",
                                "text": "„Ein geschäftstüchtiger Dorfbewohner hatte in einer der Hütten einen Lebensmittelladen eingerichtet, hier gab es Waschpulver, Tomatenpüree und kalte Cola aus einem Kühlschrank, der von einem ratternden Benzingenerator betrieben wurde.“"
                            },
                            {
                                "example_id": "76f4df63-0649-4dc1-895a-ca5740fe82da",
                                "sense_id": "d060e75f-b90d-3be4-afc9-0cf2bb3740b8",
                                "text": "„Leise murmelte er mir Dinge ins Haar, die ich nicht verstand, und ich atmete seinen Geruch ein, nach Waschpulver und Schlaf und warmer Haut, nach Ben und nach Staub, und etwas in mir hörte auf zu flattern wie ein Vogel, der zu müde zum Kämpfen war gegen den Käfig, in dem er steckte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
