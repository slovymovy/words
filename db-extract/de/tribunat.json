                    },
                    {
                        "translation_id": "39123ebf-199b-41b0-830c-b647211d86d9",
                        "source_entry_id": "631d59a9-92ec-3c44-b8d8-b7020d73aab9",
                        "source_sense_id": "1105f1f8-52f6-330d-81fd-0f2fc5621acc",
                        "source_sense_description": "Amt eines Tribuns",
                        "target_lang_word": "tribuneship",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tribuneship",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5da18142-cc00-3d01-a5b8-4d0bd2d691e1",
                                        "entry_id": "e6414e0f-b914-3676-bc1f-081d220660b6",
                                        "glosses": [
                                            "The office of tribune"
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94f7abf7-3a5e-487a-be4e-fd2c11d134fa",
                                                "sense_id": "5da18142-cc00-3d01-a5b8-4d0bd2d691e1",
                                                "text": "But the burgesses acquitted him; and now he too threw down the gauntlet, became a candidate for the tribuneship of the people, and was nominated to that office for the year 631 in an elective assembly attended by unusual numbers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9276790-c5e8-373b-ab5f-5dd9f84a60e3",
                                        "entry_id": "e6414e0f-b914-3676-bc1f-081d220660b6",
                                        "glosses": [
                                            "The period in which a person serves as tribune"
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5f150e0-23d1-4cf6-ba4c-a94be82e5cc4",
                                                "sense_id": "b9276790-c5e8-373b-ab5f-5dd9f84a60e3",
                                                "text": "The crimes which had disgraced the stormy tribuneship of Shaftesbury had been fearfully expiated."
                                            },
                                            {
                                                "example_id": "e0f87740-c6d3-46e0-a212-b846856a63e1",
                                                "sense_id": "b9276790-c5e8-373b-ab5f-5dd9f84a60e3",
                                                "text": "He also wanted to found a colony of plebeians on the ruins of Carthage, and when his tribuneship was over he went to Africa to see about it; but when he came home the patricians had arranged an attack on him, and he was insulted by the lictor of the consul Opimius."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9376d8f0-89b1-4403-a725-acbdfb38c42d",
                        "source_entry_id": "631d59a9-92ec-3c44-b8d8-b7020d73aab9",
                        "source_sense_id": "1105f1f8-52f6-330d-81fd-0f2fc5621acc",
                        "source_sense_description": "Amt eines Tribuns",
                        "target_lang_word": "tribunat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tribunat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "646165ab-322f-3dc5-ac04-422595b1a7f9",
                                        "entry_id": "7036c5b5-6858-3902-8621-a920535385ca",
                                        "glosses": [
                                            "Charge de tribun."
                                        ],
                                        "tags": [
                                            "Ancient-Roman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ebc9d29-310c-4fac-a53f-911f184d8c6c",
                                                "sense_id": "646165ab-322f-3dc5-ac04-422595b1a7f9",
                                                "text": "Le tribunat c’est la plèbe, et la plèbe, c’est le levain de Rome, le ferment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6334029-179e-389d-bc58-8972bec96e32",
                                        "entry_id": "7036c5b5-6858-3902-8621-a920535385ca",
                                        "glosses": [
                                            "Temps de l’exercice de cette charge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48b6a070-f51c-46c6-862d-bfa62d60bff0",
                                                "sense_id": "c6334029-179e-389d-bc58-8972bec96e32",
                                                "text": "Nous n’en sommes qu’au début du tribunat, et déjà nous pouvons prévoir les développements qu’il devait prendre par la suite…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb14544d-dd9d-334a-b023-eafff0111322",
                                        "entry_id": "7036c5b5-6858-3902-8621-a920535385ca",
                                        "glosses": [
                                            "Assemblée législative instituée par la constitution de l’an VIII."
                                        ],
                                        "tags": [
                                            "Histoire de France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed1a7d9c-8794-4563-97ab-84f7785fbc47",
                                                "sense_id": "cb14544d-dd9d-334a-b023-eafff0111322",
                                                "text": "Le pouvoir législatif était partagé dès lʼan VIII entre les consuls (cʼest-à-dire Bonaparte) assistés du conseil dʼÉtat, le tribunat et le corps législatif, et contrôlé par le sénat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
