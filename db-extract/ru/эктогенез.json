                "senses": [
                    {
                        "sense_id": "49bc9d43-3bff-3614-a190-029b86fbb0f3",
                        "entry_id": "3c140ceb-2776-31bf-b5cd-c1577c9a836d",
                        "glosses": [
                            "книжн. эволюционное учение, рассматривающее развитие живой природы как прямое приспособление организмов к окружающей среде, а не как результат естественного отбора"
                        ],
                        "tags": [],
