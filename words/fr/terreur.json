                    "frequency": "Middle",
                    "semantic_group_id": "politique_repression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dictateur s'est maintenu au pouvoir en instaurant un régime de <w>terreur</w>."
                        },
                        {
                            "text": "La population civile a longtemps souffert sous le joug de cette politique de <w>terreur</w>."
                        }
                    ],
                    "synonyms": [
                        "tyrannie",
                        "despotisme"
                    ],
                    "common_phrases": [
                        "régime de terreur",
                        "régner par la terreur"
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ce89f81f-8bdd-3b0c-8ad3-acb1b5f51e8c",
                    "sense_definition": "Période de la Révolution française (1793-1794) marquée par l'état d'exception et une répression judiciaire et politique impitoyable.",
