                "senses": [
                    {
                        "sense_id": "e939a40b-0708-3940-8c67-c044b8864ee0",
                        "entry_id": "6fd26f5a-9e5c-3b65-b27d-da08b9397490",
                        "glosses": [
                            "betreffende een langzame maar gestage opeenvolging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21466e75-d46a-4791-8fc9-c0e3af5b3589",
                                "sense_id": "e939a40b-0708-3940-8c67-c044b8864ee0",
                                "text": "Op de besmette bedrijven zijn de niet-drachtige dieren niet geruimd, maar ze hebben wel een levenslang fokverbod gekregen. Ook die geiten moeten dus successievelijk vervangen door nieuwe dieren om de veestapel in stand te houden."
                            },
                            {
                                "example_id": "f5499369-3f8c-47d8-85c3-8c77dbbbf384",
                                "sense_id": "e939a40b-0708-3940-8c67-c044b8864ee0",
                                "text": "Al snel voelde ze zich toch niet helemaal goed en na verschillende bezoeken aan het ziekenhuis werd ze op 20 januari weer opgenomen. Vanaf die dag ging er veel mis. Mevrouw Van Os raakte successievelijk besmet met een aantal multiresistente bacteriën."
                            }
                        ]
                    }
