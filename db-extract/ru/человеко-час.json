                                                "example_id": "4808376f-c84a-43ad-880a-5432792b3f30",
                                                "sense_id": "8906743a-214d-38a7-9d94-054bcb4f07f8",
                                                "text": "Ten workers for two days—that's 160 man-hours."
                                            },
                                            {
                                                "example_id": "6b9d4347-d84f-4346-a6d4-84ffd0b204a0",
                                                "sense_id": "8906743a-214d-38a7-9d94-054bcb4f07f8",
                                                "text": "[...] every man has tools and amenities always within one minute's walk; thus non-productive man-hours are kept to a minimum."
                                            },
                                            {
                                                "example_id": "5b6453ff-680f-46db-9ee1-b43b252c556c",
                                                "sense_id": "8906743a-214d-38a7-9d94-054bcb4f07f8",
                                                "text": "Since 1950 our agricultural output per man-hour has actually doubled!"
                                            }
