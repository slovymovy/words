                    "frequency": "Middle",
                    "semantic_group_id": "bâtiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fermier a rangé son tracteur sous le grand <w>hangar</w> pour le protéger de la pluie."
                        },
                        {
                            "text": "Les ouvriers entreposent le matériel de construction dans un <w>hangar</w> situé près du chantier."
                        }
                    ],
                    "synonyms": [
                        "entrepôt",
                        "remise"
                    ],
                    "common_phrases": [
