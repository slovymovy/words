                                    {
                                        "sense_id": "62058535-370d-3060-96b7-bc9aa11c554d",
                                        "entry_id": "9c287ba2-ec27-3ce3-b74d-66534d21caae",
                                        "glosses": [
                                            "An extensive bed of an eruptive rock intruded between, or overlying, other strata."
                                        ],
