                                                "example_id": "d2904871-dbff-4a7a-910a-e15cff40fe28",
                                                "sense_id": "2423879c-05a8-30f9-ba75-2cfe4bfc1664",
                                                "text": "La maison est toujours pleine de monde, des repas avec animation, des concours de rummikub, de boules, des conférences, la chorale, le club informatique, le karaoké…"
                                            },
                                            {
                                                "example_id": "fa89e8b0-b5c0-4ca9-8082-b388a2f4afd5",
                                                "sense_id": "2423879c-05a8-30f9-ba75-2cfe4bfc1664",
                                                "text": "Contre la timidité ou le stress de la vie professionnelle, le karaoké est au Japon un rouage social essentiel."
                                            },
                                            {
                                                "example_id": "f49922ea-f19c-45d9-a5de-5d42d421e917",
                                                "sense_id": "2423879c-05a8-30f9-ba75-2cfe4bfc1664",
                                                "text": "Entre activités à Lesneven en journée, comme le futsal, le VTT, l’escalade, ou en soirée, avec des crêp’partie, Top Chef, du karaoké, à l’extérieur, avec les vendredis du sport à Brest, la Récré des 3 curés à Milizac, ou la bouée tractée à Bertheaume, toutes les places ont été prises d’assaut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eb90e36-42e1-3a81-a835-60a10e20ca25",
                                        "entry_id": "0d10877d-cddb-3e90-aa1a-3c5eaa5b2a40",
                                        "glosses": [
                                            "Lieu où se pratique ce divertissement."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9610958e-4d7c-44d4-8ca4-28b823ffda25",
                                                "sense_id": "7eb90e36-42e1-3a81-a835-60a10e20ca25",
                                                "text": "On va au karaoké ce soir ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
