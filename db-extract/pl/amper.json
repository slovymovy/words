                                "target_senses": [
                                    {
                                        "sense_id": "ce744a31-1dd1-3019-8460-f4c2c246143e",
                                        "entry_id": "a53cb08b-03cd-3029-87c4-520ed869dba3",
                                        "glosses": [
                                            "A unit of electrical current, the standard base unit in the International System of Units; colloquially amp. Abbreviation: amp, Symbol: A"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a47be6a-0b74-4004-9bb8-9e662ad54b48",
                                                "sense_id": "ce744a31-1dd1-3019-8460-f4c2c246143e",
                                                "text": "Definition: The ampere, symbol A, is the SI unit of electric current. It is defined by taking the fixed numerical value of the elementary charge e to be 1.602 176 634 x 10⁻¹⁹ when expressed in the unit C, which is equal to A s, where the second is defined in terms of Δν_(Cs). (The International Bureau of Weights and Measures)"
                                            },
                                            {
                                                "example_id": "191f980f-9efc-4b79-a871-8587e56d01b0",
                                                "sense_id": "ce744a31-1dd1-3019-8460-f4c2c246143e",
                                                "text": "If the volt, ampere and ohm were taken as the absolute units, the practical units would be the ampere, begohm and begavolt, names just as convenient as ampere, coulomb and farad."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
