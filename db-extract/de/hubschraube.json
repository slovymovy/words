                "senses": [
                    {
                        "sense_id": "b31dbc5a-ab06-3242-adf1-4c40c20e7612",
                        "entry_id": "54373bc7-dd97-3979-981e-b43210a98f6f",
                        "glosses": [
                            "rotierender Teil einer Maschine, der diese zum Aufsteigen veranlasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98eb2867-9925-4294-b6e7-6406060ce9f1",
                                "sense_id": "b31dbc5a-ab06-3242-adf1-4c40c20e7612",
                                "text": "„Das gleiche Drehmoment des Motors, das die Hubschraube links dreht, dreht aber den Rumpf rechts herum, ohne daß der Hubschrauber steigt.“"
                            },
                            {
                                "example_id": "e6ecb3a9-7484-403d-9e31-d7d380cb4432",
                                "sense_id": "b31dbc5a-ab06-3242-adf1-4c40c20e7612",
                                "text": "„Dabei funktionierte, zwar nur theoretisch, seine konstruierte Hubschraube nach dem gleichem [sic!] Prinzip, nur das [sic!] die Wirkung nicht horizontal[,] sondern vertikal erfolgte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
