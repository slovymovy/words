                "senses": [
                    {
                        "sense_id": "103078b7-33ad-3a36-b67f-34d2ba202d82",
                        "entry_id": "0479779a-0006-39f7-9c0b-134b302e5b28",
                        "glosses": [
                            "herrschaftliches Haus auf dem Lande"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52827907-a75e-49b4-9509-a7c542838098",
                                "sense_id": "103078b7-33ad-3a36-b67f-34d2ba202d82",
                                "text": "„Mitte des 19. Jahrhunderts im viktorianischen Stil von meinem Ururgroßvater erbaut, beeindruckt das Manor die meisten Besucher durch den schlossähnlichen Charakter mit seinen Türmen, Zinnen und Rundbogenfenstern, den verspielten Erkern und Giebeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94217649-7f77-4afd-9780-d91ecc09d528",
                        "source_entry_id": "0479779a-0006-39f7-9c0b-134b302e5b28",
                        "source_sense_id": "103078b7-33ad-3a36-b67f-34d2ba202d82",
                        "source_sense_description": "herrschaftliches Haus auf dem Lande",
                        "target_lang_word": "manor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9fd5c68f-a1c1-33b3-9efd-1e9f9d794adc",
                                        "entry_id": "e5cf692f-b6f2-31c7-a915-41ae5031c32a",
                                        "glosses": [
                                            "A landed estate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d07b188-4912-4726-bfd3-2158c40405c6",
                                                "sense_id": "9fd5c68f-a1c1-33b3-9efd-1e9f9d794adc",
                                                "text": "[T]he owners of Doddington Hall, in Lincolnshire, have brought the folly into the 21st century, by building a 30ft pyramid in the grounds of the Elizabethan manor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fa84cec-5d07-3f1c-bb28-2bda84ee06d9",
                                        "entry_id": "e5cf692f-b6f2-31c7-a915-41ae5031c32a",
                                        "glosses": [
                                            "The main house of such an estate or a similar residence; a mansion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8d8c5209-e2d1-306d-ad7f-45665f227685",
                                        "entry_id": "e5cf692f-b6f2-31c7-a915-41ae5031c32a",
                                        "glosses": [
                                            "A district over which a feudal lord could exercise certain rights and privileges in medieval western Europe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "271aac71-142c-3e39-82f2-36285dfc538b",
                                        "entry_id": "e5cf692f-b6f2-31c7-a915-41ae5031c32a",
                                        "glosses": [
                                            "The lord's residence and seat of control in such a district."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25584196-d846-30fa-8c9b-6f42e9cb6d27",
                                        "entry_id": "e5cf692f-b6f2-31c7-a915-41ae5031c32a",
                                        "glosses": [
                                            "Any home area or territory in which authority is exercised, often in a police or criminal context."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1efd588-09bb-4c3a-a266-ac073e019a8f",
                                                "sense_id": "25584196-d846-30fa-8c9b-6f42e9cb6d27",
                                                "text": "'I'm a fatalist,' said Mr James Anderton, Chief Constable of Greater Manchester. [...] James Anderton in his suite of offices on the eleventh floor of the modern glass-and-concrete police building, looking out over his domain, his patch, his manor."
                                            },
                                            {
                                                "example_id": "746c0584-2c3b-466d-bd6f-d215b7f823f7",
                                                "sense_id": "25584196-d846-30fa-8c9b-6f42e9cb6d27",
                                                "text": "Dixon, who was finally promoted to sergeant in 1964, policed his 'Dock Green' manor until May 1976 and 'Evening, all' had become a national catchphrase."
                                            },
                                            {
                                                "example_id": "35b2aaee-f373-47f9-bf0b-b468f756dfd8",
                                                "sense_id": "25584196-d846-30fa-8c9b-6f42e9cb6d27",
                                                "text": "On his release from prison in Holland, Warren returned to his Merseyside 'manor' to resume his role as' King of Coke'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6191658-2530-3344-995b-ce46933d1560",
                                        "entry_id": "e5cf692f-b6f2-31c7-a915-41ae5031c32a",
                                        "glosses": [
                                            "One's neighbourhood."
                                        ],
                                        "tags": [
                                            "London",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e7bda25-93f5-413a-9b8f-08d2b9b2ba09",
                                                "sense_id": "b6191658-2530-3344-995b-ce46933d1560",
                                                "text": "And, Gold adds, he can understand that West Ham's famously dedicated supporters, Londoners though they themselves mainly are, may mistrust businessmen \"coming into the club and talking about loyalty. But this is my manor. I worked on Stratford Market, where the Olympic Stadium sits now. I remember the bomb falling on West Ham football ground and thinking: my God, they're coming after me. West Ham is my passion.\""
                                            },
                                            {
                                                "example_id": "cbc9aa5b-079e-4b09-ac5b-139d2b698d0e",
                                                "sense_id": "b6191658-2530-3344-995b-ce46933d1560",
                                                "text": "Beckham was asked what it would mean for the Olympics to be held in his old neighbourhood.\n\"You mean my manor?\" Beckham replied, in fluent East End argot. \"I'm obviously from the East End, so it would be incredible for me if it was held there. It could go down as one of the best games in history.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ba9c881-7609-41ab-9725-cd00aa7eaa12",
                        "source_entry_id": "0479779a-0006-39f7-9c0b-134b302e5b28",
                        "source_sense_id": "103078b7-33ad-3a36-b67f-34d2ba202d82",
                        "source_sense_description": "herrschaftliches Haus auf dem Lande",
                        "target_lang_word": "manoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54b4ac76-0442-34e0-bca3-a81c5533463e",
                                        "entry_id": "76f1a76e-f2a6-3ad6-82c7-0be3d0a7521b",
                                        "glosses": [
                                            "Demeure, lieu où l’on habite."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "668b04c3-a84e-4d00-b01f-fc06998fff1d",
                                                "sense_id": "54b4ac76-0442-34e0-bca3-a81c5533463e",
                                                "text": "L'idée seule du domicile présuppose une attention singulière sur soi-même ; ensuite le choix du lieu, l'art de faire son manoir, de le rendre commode, d'en dérober l'entrée, sont autant d'indices d'un sentiment supérieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fc95124-7905-3ae9-a43e-87b9c25b1517",
                                        "entry_id": "76f1a76e-f2a6-3ad6-82c7-0be3d0a7521b",
                                        "glosses": [
                                            "Petit château ; petite maison ancienne, de style, surtout à la campagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87860a00-1963-461f-8961-e7d6e768cefd",
                                                "sense_id": "4fc95124-7905-3ae9-a43e-87b9c25b1517",
                                                "text": "Front-de-Bœuf, répliqua Jean, est plutôt homme à avaler trois manoirs comme celui d’Ivanhoé que d’en dégorger un seul."
                                            },
                                            {
                                                "example_id": "74c3a539-e30c-4f6a-b603-f4d27e415e0c",
                                                "sense_id": "4fc95124-7905-3ae9-a43e-87b9c25b1517",
                                                "text": "Pour vous punir, je devrais vous cacher que vous m'avez surprise rêvant manoirs à tourelles, landes fleuries, pierres druidiques et autres curiosités bretonnes."
                                            },
                                            {
                                                "example_id": "82945f31-8e71-4c73-9f22-7b8f99e39918",
                                                "sense_id": "4fc95124-7905-3ae9-a43e-87b9c25b1517",
                                                "text": "Combien durent être rapportées sous le toit natal et redites au foyer rustique ou sous la cheminée du manoir, qui avaient été contées la première fois au désert, sous les tentes, près des fontaines !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b51ffadb-d30d-3f1e-bf36-171c56a87999",
                                        "entry_id": "76f1a76e-f2a6-3ad6-82c7-0be3d0a7521b",
                                        "glosses": [
                                            "Selon Viollet-Le-Duc il s’agissait autrefois de la demeure d'un propriétaire de fief qui toutefois n'avait pas les droits nécessaires pour faire construire des tours et un donjon fortifié."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62d7259f-eb95-391a-9f2c-cd2c46b91996",
                                        "entry_id": "76f1a76e-f2a6-3ad6-82c7-0be3d0a7521b",
                                        "glosses": [
                                            "Aristocrate qui dirige un fief ; propriétaire d’un manoir."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef108443-dad8-4818-8d14-e56cd273dcef",
                                                "sense_id": "62d7259f-eb95-391a-9f2c-cd2c46b91996",
                                                "text": "Les réformes de Henry II, en affaiblissant les nobles, les avaient rapprochés de leurs tenants. Entre le manoir et le village, les conflits devenaient plus rares."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
