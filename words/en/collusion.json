{
    "word_family": [
        "collude",
        "collusive",
        "collusionary"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c3be83ed-69dc-3c77-bb0d-11c64d1ce72f",
                    "sense_definition": "Secret cooperation or agreement between parties for a deceitful, fraudulent, or illegal purpose.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conspiracy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investigation found clear evidence of <w>collusion</w> between senior officials and organized criminals.",
                            "target_lang_translations": {
                                "zh": "调查发现了高级官员与有组织犯罪分子之间存在<w>勾结</w>的确凿证据。"
                            }
                        },
                        {
                            "text": "They were accused of acting in <w>collusion</w> to manipulate the outcome of the local election.",
                            "target_lang_translations": {
                                "zh": "他们被指控相互<w>串通</w>以操纵地方选举的结果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conspiracy",
                        "complicity",
                        "connivance",
                        "cahoots"
                    ],
                    "common_phrases": [
                        "in collusion with",
                        "act in collusion",
                        "evidence of collusion"
                    ],
                    "target_lang_definitions": {
                        "zh": "各方之间出于欺骗、欺诈或非法目的而进行的秘密合作或勾结"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "勾结",
                                "target_lang_sense_clarification": "指不正当或非法的暗中联合"
                            },
                            {
                                "target_lang_word": "串通",
                                "target_lang_sense_clarification": "指暗中互相勾结、商量作弊"
                            },
                            {
                                "target_lang_word": "共谋",
                                "target_lang_sense_clarification": "指共同秘密策划非法活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53aeb94d-6758-3465-a8a7-0f707ea15ebd",
                    "sense_definition": "A secret agreement between nominally competing entities, such as businesses, to cooperate deceitfully or fix prices.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conspiracy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regulatory authorities suspected tacit <w>collusion</w> among the major energy suppliers to keep prices artificially high.",
                            "target_lang_translations": {
                                "zh": "监管机构怀疑主要能源供应商之间存在默契的<w>串通</w>，人为维持高价。"
                            }
                        },
                        {
                            "text": "The anti-monopoly commission penalized both firms after uncovering proof of price-fixing <w>collusion</w>.",
                            "target_lang_translations": {
                                "zh": "反垄断委员会在发现两家公司操纵价格的<w>合谋</w>证据后，对它们进行了处罚。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cartelization"
                    ],
                    "common_phrases": [
                        "tacit collusion",
                        "unlawful collusion"
                    ],
                    "target_lang_definitions": {
                        "zh": "名义上相互竞争的实体（如企业）之间为欺诈性合作或操纵价格而达成的秘密协议"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "串通",
                                "target_lang_sense_clarification": "商业竞争对手暗中联合操纵市场或价格"
                            },
                            {
                                "target_lang_word": "合谋",
                                "target_lang_sense_clarification": "企业间共同策划不正当竞争行为"
                            },
                            {
                                "target_lang_word": "勾结",
                                "target_lang_sense_clarification": "指企业间非法暗中联合"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}