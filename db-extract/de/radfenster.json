                "senses": [
                    {
                        "sense_id": "a484c8f1-9c17-38ab-9154-30bf9490c3fb",
                        "entry_id": "8f8bb1d4-5de3-35d8-82ea-2f707f8bb0a6",
                        "glosses": [
                            "rundes oder ovales Fenster mit einer speichenartigen Unterteilung der großen Fensterfläche in kleinere regelmäßige Abschnitte (in der Form von Kreissektoren)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c651e0fb-29ba-4b24-b578-c51243da1dbf",
                                "sense_id": "a484c8f1-9c17-38ab-9154-30bf9490c3fb",
                                "text": "„Radfenster sind typische Fensterformen in der Architektur der Hoch- und Spätromanik.“"
                            },
                            {
                                "example_id": "4d823301-8213-4be4-b7ad-8ce6dbb56aee",
                                "sense_id": "a484c8f1-9c17-38ab-9154-30bf9490c3fb",
                                "text": "„Im übrigen ist von den Baulichkeiten alles vorhanden, was jeder Freund Tübingens kennt: das Radfenster an der Stiftskirche, zwischen dessen Speichen als grausames Maßwerk ein Mann geflochten ist […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "152b7576-3cdf-4244-9656-454b69fd10fa",
                        "source_entry_id": "8f8bb1d4-5de3-35d8-82ea-2f707f8bb0a6",
                        "source_sense_id": "a484c8f1-9c17-38ab-9154-30bf9490c3fb",
                        "target_lang_word": "rosace",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rosace",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b7a1461a-3737-3287-bacf-ff6e2c208bdf",
                                        "entry_id": "34e0599d-4dd8-33bf-8b81-a89cbebb3220",
                                        "glosses": [
                                            "Figure formée de courbes inscrites dans un cercle à partir d'un point central."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abea2545-7902-4a74-b78c-252be2a685f4",
                                                "sense_id": "b7a1461a-3737-3287-bacf-ff6e2c208bdf",
                                                "text": "Les araignées filandières s’étaient chargées de décorer le plafond, et les larges rosaces de leurs toiles se suspendaient d’une poutre à l’autre."
                                            },
                                            {
                                                "example_id": "62dbeabd-f9cc-4e38-8767-289855faee5e",
                                                "sense_id": "b7a1461a-3737-3287-bacf-ff6e2c208bdf",
                                                "text": "La clarté fumeuse des quinquets vacillait dans le nuage de poussière qui montait du plancher, bien qu’un garçon d’auberge vînt l’arroser par moments, dessinant sur le parquet un entrelacement de rosaces compliquées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efd1c2f0-b97d-353e-8552-b197618bcfb3",
                                        "entry_id": "34e0599d-4dd8-33bf-8b81-a89cbebb3220",
                                        "glosses": [
                                            "Ornement symétrique circulaire en forme de grande rose, que l’on place dans le renfoncement des caissons d’une voûte ou d’un plafond."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95679070-40a4-4a99-b918-48ba6f564207",
                                                "sense_id": "efd1c2f0-b97d-353e-8552-b197618bcfb3",
                                                "text": "On nous établit dans une chambre au rez-de-chaussée, blanchie à la chaux, et garnie pour tout meuble d’une rosace de différentes couleurs au plafond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2139472f-d7a2-3e8c-afe7-797349e084a6",
                                        "entry_id": "34e0599d-4dd8-33bf-8b81-a89cbebb3220",
                                        "glosses": [
                                            "Grande baie circulaire, ornée de vitraux, des églises et des cathédrales gothiques. — Note d’usage : On dit plus correctement rose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bd98de7-1ce3-4c1b-812f-4190e60f3115",
                                                "sense_id": "2139472f-d7a2-3e8c-afe7-797349e084a6",
                                                "text": "La Société, après avoir donné un souvenir à ces antiques paroisses, a visité l'église d’Hartennes. Cet édifice, bâti en grande partie en grès qui abondent sur ce terroir, aurait un aspect assez triste, s'il ne rachetait ce défaut par un portail de la Renaissance, en pierres de taille, décoré d'une assez jolie rosace et portant des écussons et des salamandres fantastiques."
                                            },
                                            {
                                                "example_id": "03aa4e0e-d863-479e-9a95-2d423e61cb56",
                                                "sense_id": "2139472f-d7a2-3e8c-afe7-797349e084a6",
                                                "text": "L'auteur des étranges modillons d’Ardentes est venu à Sassierges-Saint-Germain, petite localité voisine, pour réaliser le décor de la porte occidentale de l'église. Celle-ci est un reflet parfait, quoique plus simple, du portail nord de Saint-Martin : même archivolte sculptée de demi-cercles opposés deux à deux, même alignement de rosaces sur les claveaux de la voussure médiane à l'arête torique, même mouluration complexe des tailloirs."
                                            },
                                            {
                                                "example_id": "95dc1760-3c7a-40e7-af3f-62e7eddcdab2",
                                                "sense_id": "2139472f-d7a2-3e8c-afe7-797349e084a6",
                                                "text": "Attention chef-d'œuvre ! Troia, ce village anodin, possède la plus belle cathédrale romane (1039) des Pouilles. La rosace est sublime : ses onze branches rayonnent sur un treillis de pierre qui n'est pas sans évoquer les moucharabiehs arabes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf576305-227f-3165-82c7-a3b3a8c0295a",
                                        "entry_id": "34e0599d-4dd8-33bf-8b81-a89cbebb3220",
                                        "glosses": [
                                            "Sorte d'agrafe circulaire plus ou moins ornée utilisée pour décorer le clou auquel est suspendu un tableau."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22f6d567-743c-3866-b634-0f7dd4b17a85",
                                        "entry_id": "34e0599d-4dd8-33bf-8b81-a89cbebb3220",
                                        "glosses": [
                                            "Élément circulaire servant de support à un tuyau, ou de décor lors du franchissement d’un mur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fca134eb-fc92-446e-9e84-2bb3a4aebcf7",
                        "source_entry_id": "8f8bb1d4-5de3-35d8-82ea-2f707f8bb0a6",
                        "source_sense_id": "a484c8f1-9c17-38ab-9154-30bf9490c3fb",
                        "target_lang_word": "oculus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oculus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c2986fd-15d7-3596-aedf-b0d167fba01b",
                                        "entry_id": "e3b5fc25-2740-3d0f-8036-4ec2981d4fca",
                                        "glosses": [
                                            "Ouverture ovale ou ronde pratiquée dans un mur ou une coupole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f42feed8-0ebc-47cd-9299-0136ab08e756",
                                                "sense_id": "0c2986fd-15d7-3596-aedf-b0d167fba01b",
                                                "text": "Au Moyen Age^([sic]), circulaires sont l’oculus (fenêtre ronde) des églises romanes et la rosace des églises gothiques. Nous en voyons à Echillais, Esnandes, Médis, Migron, Saint-Saturnin-de-Séchaus, Talmont et à Breuillet où, prétend la tradition, « les rayons tournent », ce qui n’a rien d’étonnant, écrit Mᵐᵉ Lamontellerie, dans un pays où le soleil « dansait le matin de Pâques pour exprimer sa joie » et « trifurquait à la Trinité »."
                                            },
                                            {
                                                "example_id": "2b0d14b1-18e3-4f21-80f7-3fc751c3b655",
                                                "sense_id": "0c2986fd-15d7-3596-aedf-b0d167fba01b",
                                                "text": "Magnifiées par des vides grandioses, de grandes perspectives sillonnent le bâtiment, tandis que la structure métallique, apparente partout, agit comme un fil d’Ariane révélateur de ces verrières qu’on avait fait disparaître, des oculus qu’on avait occultés…"
                                            },
                                            {
                                                "example_id": "e31603ad-8603-4ece-bf49-6cae9700fec8",
                                                "sense_id": "0c2986fd-15d7-3596-aedf-b0d167fba01b",
                                                "text": "Un oculus est une ouverture pratiquée sur un comble. On en trouve également au centre de nombreuses coupoles."
                                            },
                                            {
                                                "example_id": "883a581f-3c2f-4def-ba43-3e1fe020c232",
                                                "sense_id": "0c2986fd-15d7-3596-aedf-b0d167fba01b",
                                                "text": "La particularité de l’abbaye de Villers-la-Ville est l’utilisation répétée des oculi à divers endroits, associés à des fenêtres en lancette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "161889be-a60d-3f59-b8aa-a6ad077a7928",
                                        "entry_id": "e3b5fc25-2740-3d0f-8036-4ec2981d4fca",
                                        "glosses": [
                                            "Ouverture dans une porte permettant de voir de l’autre côté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4aee2cc5-4a1b-4193-a822-76df9b2c0d3a",
                                                "sense_id": "161889be-a60d-3f59-b8aa-a6ad077a7928",
                                                "text": "« Ils ont installé des oculus », nous informe R. J’ignorais ce mot. Ce sont comme des hublots, carrés, en haut des portes, qui permettent de surveiller : « Ce ne sont pas vraiment des chambres d’isolement, me décrit mon guide, mais on voit à travers. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
