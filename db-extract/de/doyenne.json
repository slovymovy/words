                                        "sense_id": "0d794538-4a8d-3138-9c2e-f9d4742c4540",
                                        "entry_id": "a153e7a4-eb0c-3260-a53d-6fdb4ae37ae5",
                                        "glosses": [
                                            "Titre de la première dignité dans les facultés d’une université."
                                        ],
