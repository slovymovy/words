                    {
                        "sense_id": "f316f562-8177-3068-8015-b39398b32f6b",
                        "entry_id": "eee8182a-747c-307f-85f2-398baa55520c",
                        "glosses": [
                            "книжн. свойство по значению прилагательного лояльный; лояльное отношение к кому-либо, чему-либо верноподданство"
                        ],
                        "tags": [],
