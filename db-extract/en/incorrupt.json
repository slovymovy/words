                "senses": [
                    {
                        "sense_id": "4cae5f35-96f6-3387-9d00-893f8e51df26",
                        "entry_id": "6eab48b4-3db8-3ad5-b726-480823714267",
                        "glosses": [
                            "not corrupt, void of moral corruption"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a9a7dceb-4f82-4b87-9463-b585b68c8463",
                                "sense_id": "4cae5f35-96f6-3387-9d00-893f8e51df26",
                                "text": "He slighted the plaudits of their theatre, he abhorred their dances and their horse-races, he was abstinent even at a festival, and incorrupt himself, perpetually admonished the dissipated citizens of their impious abandonment of the laws of their country."
                            },
                            {
                                "example_id": "fdd6fca1-08f0-4b93-bd28-490562431b8c",
                                "sense_id": "4cae5f35-96f6-3387-9d00-893f8e51df26",
                                "text": "The courts of British justice are impartial and incorrupt; they respect not the persons of men; the poor man's lamb is, in their estimation, as sacred as the monarch's crown; with inflexible integrity they adjudge to every man his own."
                            },
                            {
                                "example_id": "46663985-16c6-4543-bb20-f5995f254e1f",
                                "sense_id": "4cae5f35-96f6-3387-9d00-893f8e51df26",
                                "text": "His, and NATO's, hopes of an incorrupt and credible government has been dealt a blow with the fraud-laden presidential election and Hamid Karzai's political alliances with warlords, war criminals and drug dealers."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d51ca1e-41f2-32f7-a23d-79aa187ed7c6",
                        "entry_id": "6eab48b4-3db8-3ad5-b726-480823714267",
                        "glosses": [
                            "free from physical decay"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f0652e9e-2540-4d56-80a3-6616e062ff6e",
                                "sense_id": "8d51ca1e-41f2-32f7-a23d-79aa187ed7c6",
                                "text": "His body was found incorrupt in 1063, and placed in a monument on the side of the high altar: and in 1170 it was enshrined in a silver case."
                            }
                        ]
                    }
