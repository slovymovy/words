                    {
                        "sense_id": "cd8b8c77-d4cb-3d9b-b09b-cc5bd7df7ac6",
                        "entry_id": "4830b972-003d-39e5-a6da-fab28be9402b",
                        "glosses": [
                            "die Stimulierung der weiblichen Genitalien; Lecken und Küssen der Vulva und der Klitoris mit Zunge und Lippen"
                        ],
                        "tags": [
                            "Sexualkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "5cc1fced-64c4-4d1d-b55c-87da9d2e8c04",
                                "sense_id": "cd8b8c77-d4cb-3d9b-b09b-cc5bd7df7ac6",
                                "text": "Dem Hite-Report zufolge empfinden Frauen Cunnilingus als „die aufregendste Aktivität“, auch wenn nur 42 Prozent dadurch zum Orgasmus kommen."
                            },
                            {
                                "example_id": "5271313a-0bd2-4781-9b16-bfddf9270af9",
                                "sense_id": "cd8b8c77-d4cb-3d9b-b09b-cc5bd7df7ac6",
                                "text": "Diese Schreckensmeldung über eine US-Studie macht derzeit global die Runde. Fellatio und Cunnilingus erhöhen das Risiko für Mund- und Rachenkrebs um ein Vielfaches, wird berichtet."
                            },
                            {
                                "example_id": "393a4b60-8747-415d-8758-4394dc9d8e42",
                                "sense_id": "cd8b8c77-d4cb-3d9b-b09b-cc5bd7df7ac6",
                                "text": "Klar erkennbar würden auf den Maoam-Päckchen \"unter anderem der Coitus, außerdem Fellatio und Cunnilingus und zu allem Überfluss auch polyamoröse Praktiken angedeutet\"."
                            },
                            {
                                "example_id": "bd1d307e-d26c-4d30-9b06-a8f197fb5e71",
                                "sense_id": "cd8b8c77-d4cb-3d9b-b09b-cc5bd7df7ac6",
                                "text": "„Der Leser wird sich jetzt vermutlich vorstellen können, wie der Vierundzwanzigjährige, der ich damals war, auf sein eigenes Erschrecken reagierte: Am Morgen begann ich ohne große Umstände, an ihr Cunnilingus zu praktizieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
