                "senses": [
                    {
                        "sense_id": "1043ead3-f999-36bb-8c77-081fa9e13b97",
                        "entry_id": "c6293aff-ed5b-3c48-9cc6-5ae646a03be0",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter) (cf. les citations ci-dessous pour quelques explications)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0b88fe7-92f2-4a1d-9201-00f3bbe1fe59",
                                "sense_id": "1043ead3-f999-36bb-8c77-081fa9e13b97",
                                "text": "Décompasser pour trouver l’emplacement d’un doublis entier. (en note :) Décompasser : repérer les emplacements de crochets."
                            },
                            {
                                "example_id": "6c1f6e60-6bfa-4850-aaa7-d4ac047c339b",
                                "sense_id": "1043ead3-f999-36bb-8c77-081fa9e13b97",
                                "text": "Avant d’arriver à proximité de l’autre rive (2 ou 3 mètres) il faut décompasser c’est à dire repérer les rangs d’ardoises entières ou doublis pour pouvoir commencer l’autre rive et enfin fermer."
                            },
                            {
                                "example_id": "1fcf1f31-0f87-4181-995f-6821a8e19da4",
                                "sense_id": "1043ead3-f999-36bb-8c77-081fa9e13b97",
                                "text": "Dans le cas d'une couverture dont l'égout (le bas de la couverture) est de niveau on trace au crayon sur les chevrons de rives (droite et gauche) un trait en tête (le haut) de l'ardoise, on positionne la pointe du compas sur ce trait et on fait une marque à 10,8 cm en dessous, puis on décompasse jusqu'en haut."
                            },
                            {
                                "example_id": "6cc4fd54-6a29-43b9-b1b4-74a0d82c6aff",
                                "sense_id": "1043ead3-f999-36bb-8c77-081fa9e13b97",
                                "text": "Savoir décompasser un élément pénétrant la couverture;"
                            }
                        ]
                    }
