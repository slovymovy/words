                        "entry_id": "00715dba-8897-32a4-8e8f-fdae3aa856d6",
                        "glosses": [
                            "wat door het vaste gebruik bepaald is"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f19809fe-3007-38cf-a171-12aeee888a8c",
                        "entry_id": "00715dba-8897-32a4-8e8f-fdae3aa856d6",
                        "glosses": [
                            "stijf en formeel"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7f228741-fef7-331c-9d42-af14724c0265",
                        "entry_id": "00715dba-8897-32a4-8e8f-fdae3aa856d6",
                        "glosses": [
                            "conventionele wapens: alle wapens behalve de atoomwapens, de biologische wapens en de chemische wapens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de6323b1-37c7-46fb-a4af-e83cb35f00e4",
                                "sense_id": "7f228741-fef7-331c-9d42-af14724c0265",
                                "text": "Want als de Russen ons alleen binnen zouden proberen te vallen met conventionele wapens, zoals in Hongarije, dan zouden ze een pak slaag krijgen. Ons jachtvliegtuig zou die van hen uitschakelen, onze gevechtsvliegtuigen zouden alle invasiepogingen de kop indrukken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e42e4dd-d6c6-40cd-9415-8d1e259c4e0b",
                        "source_entry_id": "00715dba-8897-32a4-8e8f-fdae3aa856d6",
                        "source_sense_id": "f9e438c6-6861-3518-b829-faa9e6ca5bf1",
                        "source_sense_description": "wat door het vaste gebruik bepaald is",
                        "target_lang_word": "conventional",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conventional",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04f359f8-43ac-3c6c-9981-cea1f9e0a7c6",
                                        "entry_id": "2c2ec2a3-5926-38d2-84e5-677b7f97ea79",
                                        "glosses": [
                                            "Pertaining to a convention, as in following generally accepted principles, methods and behaviour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f61e13a2-7876-466e-8e5a-756598dac2d9",
                                                "sense_id": "04f359f8-43ac-3c6c-9981-cea1f9e0a7c6",
                                                "text": "A “moving platform” scheme[…]is more technologically ambitious than maglev trains even though it relies on conventional rails. Local trains would use side-by-side rails to roll alongside intercity trains and allow passengers to switch trains by stepping through docking bays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3fa1937-d137-38e8-8567-914e4809d620",
                                        "entry_id": "2c2ec2a3-5926-38d2-84e5-677b7f97ea79",
                                        "glosses": [
                                            "Ordinary, commonplace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4059d24-b149-418c-bc73-342050103d77",
                                                "sense_id": "b3fa1937-d137-38e8-8567-914e4809d620",
                                                "text": "They wear conventional clothes, eat conventional food, and keep conventional hours."
                                            },
                                            {
                                                "example_id": "61f7b996-33f2-4f30-ab84-927de3fbdbc2",
                                                "sense_id": "b3fa1937-d137-38e8-8567-914e4809d620",
                                                "text": "“You’re not conventional?” Isabel gravely asked. “I like the way you utter that word! No, I’m not conventional: I’m convention itself. You don’t understand that?”"
                                            },
                                            {
                                                "example_id": "faa486b6-2bfa-4598-9272-fc1202dd0451",
                                                "sense_id": "b3fa1937-d137-38e8-8567-914e4809d620",
                                                "text": "Mother[…]considered that the exclusiveness of Peter's circle was due not to its distinction, but to the fact that it was an inner Babylon of prodigality and whoredom, from which every Kensingtonian held aloof, except on the conventional tip-and-run excursions in pursuit of shopping, tea and theatres."
                                            },
                                            {
                                                "example_id": "4fde0e6b-ae51-4dcf-a006-5f8dc6fccbe9",
                                                "sense_id": "b3fa1937-d137-38e8-8567-914e4809d620",
                                                "text": "The history of our study of our solar system shows us clearly that accepted and conventional ideas are often wrong, and that fundamental insights can arise from the most unexpected sources."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7301ffd9-f771-325c-864d-ed549d814dd1",
                                        "entry_id": "2c2ec2a3-5926-38d2-84e5-677b7f97ea79",
                                        "glosses": [
                                            "Banal, trite, hackneyed, unoriginal or clichéd."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c2d7a04-3dcb-3b76-a99d-927e5d9e7ad7",
                                        "entry_id": "2c2ec2a3-5926-38d2-84e5-677b7f97ea79",
                                        "glosses": [
                                            "Pertaining to a weapon which is not a weapon of mass destruction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9076386c-73b1-3dbb-b269-e466a5c0d3b5",
                                        "entry_id": "2c2ec2a3-5926-38d2-84e5-677b7f97ea79",
                                        "glosses": [
                                            "Making use of synthetic fertilizers and pesticides."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8662857a-b76d-38b6-b954-8d48e04ea683",
                                        "entry_id": "2c2ec2a3-5926-38d2-84e5-677b7f97ea79",
                                        "glosses": [
                                            "In accordance with a bidding convention, as opposed to a natural bid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "conventional",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d9903e3-8294-3d1f-8be0-99a989cae217",
                                        "entry_id": "c9a465b0-f00f-34d3-a8fe-be9f529bf903",
                                        "glosses": [
                                            "A conventional gilt-edged security, a kind of bond paying the holder a fixed cash payment (or coupon) every six months until maturity, at which point the holder receives the final payment and the return of the principal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44dfd65d-e252-4cc7-9f86-59ceb5820037",
                        "source_entry_id": "00715dba-8897-32a4-8e8f-fdae3aa856d6",
                        "source_sense_id": "f9e438c6-6861-3518-b829-faa9e6ca5bf1",
                        "source_sense_description": "wat door het vaste gebruik bepaald is",
                        "target_lang_word": "conventionnel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conventionnel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52009387-38db-32e4-be9e-3ae5b7e1fe5c",
                                        "entry_id": "718c8f09-973d-3667-8c76-92eb22b95817",
                                        "glosses": [
                                            "Qui résulte d’une convention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0452142-ed01-428d-9c5f-3076ce9bae0a",
                                                "sense_id": "52009387-38db-32e4-be9e-3ae5b7e1fe5c",
                                                "text": "Ce qui est pareillement decidé par plusieurs de nos Coûtumes ; & c’est ce qu’elles appellent convenance de succeder, & heritier conventionnel."
                                            },
                                            {
                                                "example_id": "2581fb42-b81a-40af-b1f9-dbba22d03328",
                                                "sense_id": "52009387-38db-32e4-be9e-3ae5b7e1fe5c",
                                                "text": "Les indices ne se laissent normalement ramener ni aux catégories du symbole, qui est un signe conventionnel, ni à celle du signal, qui est un signe intentionnel."
                                            },
                                            {
                                                "example_id": "f7a25949-17e5-472c-99c6-6713e88180e1",
                                                "sense_id": "52009387-38db-32e4-be9e-3ae5b7e1fe5c",
                                                "text": "Il est possible de qualifier cette indemnisation de conventionnelle dans la mesure où le versement est fondé sur une convention ad hoc qui n’est pas nécessairement une transaction (et ne nécessite donc pas un passage en comité ministériel des transactions pour les administrations concernées)."
                                            },
                                            {
                                                "example_id": "2c7b07de-9e03-42ae-afba-aba514cf4f45",
                                                "sense_id": "52009387-38db-32e4-be9e-3ae5b7e1fe5c",
                                                "text": "En me voyant entrer, le patron ramène ses pattes sur le bureau. Dans la pantomime conventionnelle, ça veut dire que je ne vaux pas plus qu’une crotte sur un terrain vague."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc69bc1e-0c9b-3873-96b6-38c221a9056f",
                                        "entry_id": "718c8f09-973d-3667-8c76-92eb22b95817",
                                        "glosses": [
                                            "Qui ne montre aucune originalité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "687efda5-59c0-4a84-960f-42546bbee811",
                                                "sense_id": "bc69bc1e-0c9b-3873-96b6-38c221a9056f",
                                                "text": "Pourquoi avait-il dit que, là-bas, Ferdinand comprendrait ? Parce qu’il serait entouré de ce luxe paisible et conventionnel ?"
                                            },
                                            {
                                                "example_id": "9972acdd-4990-4278-8c7a-62206c95d703",
                                                "sense_id": "bc69bc1e-0c9b-3873-96b6-38c221a9056f",
                                                "text": "Il expérimente alors la vidéo avec sa compagne Anne-Marie Miéville et intervient à la télévision pour parler de l’influence de l’image, avant de revenir à un cinéma plus conventionnel dans les années 1980 avec Sauve qui peut (la vie), mais sans retrouver la place centrale qu’il occupait dans les années 1960."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4da7f1a3-4321-3b15-8fcc-56d14d45890b",
                                        "entry_id": "718c8f09-973d-3667-8c76-92eb22b95817",
                                        "glosses": [
                                            "Relatif à la Convention."
                                        ],
                                        "tags": [
                                            "Histoire de France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca6c9e3b-3ab5-4b5d-adae-61ae6fce5647",
                                                "sense_id": "4da7f1a3-4321-3b15-8fcc-56d14d45890b",
                                                "text": "Les canonniers qui gardaient l’Hôtel de Ville se dispersèrent en apprenant que les troupes conventionnelles avançaient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af276f73-6a8f-373c-b40d-b59259793855",
                                        "entry_id": "718c8f09-973d-3667-8c76-92eb22b95817",
                                        "glosses": [
                                            "Qui est classique, traditionnel, qui n’est pas nucléaire."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90d7f42f-affb-4806-97df-9f46053094af",
                                                "sense_id": "af276f73-6a8f-373c-b40d-b59259793855",
                                                "text": "En attendant, nous perfectionnons, nous accumulons, nous disséminons des armes conventionnelles de plus en plus meurtrières, nous tentons de garder en laisse les fusées de la fin du monde, nous multiplions les Tchernobyl en puissance, nous éliminons les espèces vivantes par centaines de milliers, nous perçons les derniers atolls et nous réchauffons la planète au risque de déclencher un déluge sans pluie."
                                            },
                                            {
                                                "example_id": "bf69d5a2-5182-403f-a3c1-135414f6c79e",
                                                "sense_id": "af276f73-6a8f-373c-b40d-b59259793855",
                                                "text": "Les plans des quatre puissances occidentales prévoyaient alors une imbrication du désarmement conventionnel et nucléaire par un système d’étapes successives."
                                            },
                                            {
                                                "example_id": "cfefc758-8f89-4a26-84fd-13d6fdeffd74",
                                                "sense_id": "af276f73-6a8f-373c-b40d-b59259793855",
                                                "text": "La conscience des limites capacitaires se traduit, aussi, par la préservation d’un rôle pour les armes nucléaires dans les scénarios d’escalade d’un conflit conventionnel."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "conventionnel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd1f9974-3e84-3d71-a07d-8eb502d72ca8",
                                        "entry_id": "0ebcd51c-ee39-330e-8d0a-9fdd4049e8ca",
                                        "glosses": [
                                            "Membre de la Convention nationale."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28e5d51d-54b0-423d-9873-77bfccbee122",
                                                "sense_id": "dd1f9974-3e84-3d71-a07d-8eb502d72ca8",
                                                "text": "La férocité des conventionnels s’explique facilement par l’influence des conceptions que le Tiers État avait puisées dans les pratiques détestables de l’Ancien Régime."
                                            },
                                            {
                                                "example_id": "f61069db-b253-4361-bdef-42a970532bfe",
                                                "sense_id": "dd1f9974-3e84-3d71-a07d-8eb502d72ca8",
                                                "text": "Après avoir traversé le pont, on débouche sur place des Carmes où fut érigée, en 1885, la statue du conventionnel Grégoire. L'abbé Grégoire a la figure énergique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8121487b-70dc-327e-8d87-6eceaec045dc",
                                        "entry_id": "0ebcd51c-ee39-330e-8d0a-9fdd4049e8ca",
                                        "glosses": [
                                            "Membre d’une convention."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d06c9ed-6b88-4bb9-aaba-b92a5944bb91",
                                                "sense_id": "8121487b-70dc-327e-8d87-6eceaec045dc",
                                                "text": "La ministre n’a pas livré son sentiment sur le sort qui leur serait réservé par le chef de l’Etat, qui recevra les conventionnels le 29 juin mais, interrogée sur les propositions de référendum, elle a estimé que « quand il s’agit de transformation forte, il est important de s’assurer qu’il y a une adhésion des Français »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
