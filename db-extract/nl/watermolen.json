                "senses": [
                    {
                        "sense_id": "8b44a0fb-9608-3bed-8515-fe11b91fd5ef",
                        "entry_id": "59413420-63f7-374a-b5be-eaf29c788125",
                        "glosses": [
                            "een windmolen die tot doel heeft de waterstand in een polder te regelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e91e5f3-0705-43be-bf2d-97c5ad34dc00",
                                "sense_id": "8b44a0fb-9608-3bed-8515-fe11b91fd5ef",
                                "text": "Aan de noordzijde van den dijk neemt men een mooien ouden watermolen waar, die de \"Laagjesmolen\" wordt genoemd en even zooals vele andere lotgenooten, ten doode is opgeschreven, aangezien de polder, de Deijffelbroekschepolder, … reeds voor een groot deel ten behoeve der Rotterdamsche havenuitbreiding ongeveer tot dijkshoogte is opgespoten."
                            }
                        ]
                    },
                    {
                        "sense_id": "796637ef-fb57-3953-adc8-a84608fb9283",
                        "entry_id": "59413420-63f7-374a-b5be-eaf29c788125",
                        "glosses": [
                            "een (graan)molen die door stromend water aangedreven wordt"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac5edf51-448e-4aee-9eb6-c350aae8d6ec",
                        "source_entry_id": "59413420-63f7-374a-b5be-eaf29c788125",
                        "source_sense_id": "796637ef-fb57-3953-adc8-a84608fb9283",
                        "source_sense_description": "een molen die door stromend water aangedreven wordt",
                        "target_lang_word": "Wassermühle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wassermühle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe3df68a-7ee4-3807-a39b-551ea68611d2",
                                        "entry_id": "deff7bb2-9ef7-36b8-b402-6f8f407fdfb9",
                                        "glosses": [
                                            "eine durch Wasserkraft angetriebene Mühle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45c6b2d5-34ca-47cd-959e-f18340c5c2a5",
                                                "sense_id": "fe3df68a-7ee4-3807-a39b-551ea68611d2",
                                                "text": "Um Wassermühlen ranken sich Märchen und Sagen."
                                            },
                                            {
                                                "example_id": "fbc06b1d-2123-4b31-bc04-bfb152f96479",
                                                "sense_id": "fe3df68a-7ee4-3807-a39b-551ea68611d2",
                                                "text": "„Der Ingenieur wollte zuerst eine Wassermühle unter dem Wasserfall am Strand bauen, dann entschied man sich aber für eine Windmühle, die nach Pencroffs Ansicht auch viel besser in die Landschaft passen und lustiger aussehen würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "984ddd4f-5339-4d03-b3c9-5ede124c0e8e",
                        "source_entry_id": "59413420-63f7-374a-b5be-eaf29c788125",
                        "source_sense_id": "796637ef-fb57-3953-adc8-a84608fb9283",
                        "source_sense_description": "een molen die door stromend water aangedreven wordt",
                        "target_lang_word": "watermill",
