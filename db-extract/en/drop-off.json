                                    {
                                        "sense_id": "53f563fe-bd9c-3011-90c2-2386f6861600",
                                        "entry_id": "7d8e76fe-9500-372a-9d40-0d642e9ac3dc",
                                        "glosses": [
                                            "Veränderung, bei der etwas weniger/geringer/niedriger wird"
