                "senses": [
                    {
                        "sense_id": "59c8dcb9-2715-3888-9fb2-752d8124aa3d",
                        "entry_id": "d5ecb4fc-b871-3556-836e-2e2e316d2eed",
                        "glosses": [
                            "Orthographe ancienne de annuler."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "347b67e0-d17f-43f0-bf90-9ed1decfe46b",
                                "sense_id": "59c8dcb9-2715-3888-9fb2-752d8124aa3d",
                                "text": "Mais, en réprouvé, il veut mourir dans l’impénitence finale, déchirer, briser, lacérer, annuller, anéantir, nihiliser, détruire, adhirer, rompre, stéphaniser, mettre en pièces tous les contrats, tous les us et coutumes, toutes les chartes littéraires, et soutenir, EN ETIENNE, à la face de l’Europe, que SEUL il a fait Conaxa en cinq actes."
                            },
                            {
                                "example_id": "2557eef6-9a02-47aa-9f42-932deeefe200",
                                "sense_id": "59c8dcb9-2715-3888-9fb2-752d8124aa3d",
                                "text": "Le roi a le droit d’annuller les actes des administrateurs de département, contraires aux lois ou aux ordres qu’il leur aura adressés."
                            }
                        ]
                    }
