                "senses": [
                    {
                        "sense_id": "3cb86d03-6c52-3201-bd2c-841766311bdd",
                        "entry_id": "44878849-c3f6-3bfb-ab5a-f2dff71cc9cf",
                        "glosses": [
                            "een woord om aan te duiden dat iets zich in het verleden af heeft gespeeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d29c26f7-5ac8-4e8b-9083-ef8580c3cf8a",
                                "sense_id": "3cb86d03-6c52-3201-bd2c-841766311bdd",
                                "text": "De beroemdheden komen nog altijd. Henriroux: 'Een paar dagen geleden hadden we Stevie Wonder nog, na zijn optreden op het jazzfestival van Vienne.'"
                            },
                            {
                                "example_id": "6d0042d0-f1b1-462c-9f89-66cccc4e32ce",
                                "sense_id": "3cb86d03-6c52-3201-bd2c-841766311bdd",
                                "text": "Koning Willem-Alexander en koningin Máxima waren afgelopen weekend in Terneuzen. De koning gaf het startschot voor de viering van 75 jaar vrijheid. Want dit jaar is het 75 jaar geleden dat Nederland bevrijd werd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ed639a1-f6fd-4612-b946-04151c777ec7",
                        "source_entry_id": "44878849-c3f6-3bfb-ab5a-f2dff71cc9cf",
                        "source_sense_id": "3cb86d03-6c52-3201-bd2c-841766311bdd",
                        "source_sense_description": "een woord om aan te duiden dat iets zich in het verleden af heeft gespeeld",
                        "target_lang_word": "her",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "her",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b78799b-0743-380a-8ed3-a1c98aaf5010",
                                        "entry_id": "12ca8f32-df55-36c1-be47-7d2102a91ff1",
                                        "glosses": [
                                            "Bewegung in Richtung des Sprechenden von einem entfernteren Ort aus"
                                        ],
                                        "tags": [
                                            "räumlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "455ee7ae-6b96-4042-a743-6b82832295c5",
                                                "sense_id": "1b78799b-0743-380a-8ed3-a1c98aaf5010",
                                                "text": "„Her mit den kleinen Engländerinnen“ (Filmtitel, 1975)"
                                            },
                                            {
                                                "example_id": "2d5ce12d-59c9-4506-8cc1-2e19301174e9",
                                                "sense_id": "1b78799b-0743-380a-8ed3-a1c98aaf5010",
                                                "text": "„Bier her, Bier her, oder ich fall’ um.“ (Trinklied)"
                                            },
                                            {
                                                "example_id": "a4b6003a-fc10-458e-9e47-695ce57e363f",
                                                "sense_id": "1b78799b-0743-380a-8ed3-a1c98aaf5010",
                                                "text": "Lass dir von außen her nicht immer dreinreden!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "79a415bc-9e61-3d2b-8da4-6fa88304eb5f",
                                        "entry_id": "12ca8f32-df55-36c1-be47-7d2102a91ff1",
                                        "glosses": [
                                            "eine bestimmte Zeit zurückliegend"
                                        ],
                                        "tags": [
                                            "temporal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84c8fff4-5b02-40f7-ac56-ec62ce38e0f9",
                                                "sense_id": "79a415bc-9e61-3d2b-8da4-6fa88304eb5f",
                                                "text": "Es ist schon eine Weile her, seit wir uns das letzte Mal gesehen haben."
                                            },
                                            {
                                                "example_id": "800b01e0-a155-4322-9a18-a42694a2a238",
                                                "sense_id": "79a415bc-9e61-3d2b-8da4-6fa88304eb5f",
                                                "text": "Wir kennen uns schon von Kindertagen her."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "85cb40e0-fe06-3820-8d3d-d4123a98f025",
                                        "entry_id": "12ca8f32-df55-36c1-be47-7d2102a91ff1",
                                        "glosses": [
                                            "verstärkend in Verbindung mit Adverbien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33cdd709-3709-4435-92df-e22dce751165",
                                                "sense_id": "85cb40e0-fe06-3820-8d3d-d4123a98f025",
                                                "text": "Warum rennst du immer neben mir her?"
                                            },
                                            {
                                                "example_id": "8a42fe3f-12db-4e7f-9d01-f680eafb744a",
                                                "sense_id": "85cb40e0-fe06-3820-8d3d-d4123a98f025",
                                                "text": "Sie ist schon wieder hinter einem anderen Mann her."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02e41493-3de0-4920-9603-87b7fafc0093",
                        "source_entry_id": "44878849-c3f6-3bfb-ab5a-f2dff71cc9cf",
                        "source_sense_id": "3cb86d03-6c52-3201-bd2c-841766311bdd",
                        "source_sense_description": "een woord om aan te duiden dat iets zich in het verleden af heeft gespeeld",
                        "target_lang_word": "ago",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ago",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f6b71fa-1da2-38a8-bc3a-e7c7aaa9b41c",
                                        "entry_id": "5b91c62b-d8e0-3ab1-8f9c-501d8f2368af",
                                        "glosses": [
                                            "Before now, before the present time"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b674c7a9-b0d6-4aaa-97f0-ae4cce6a97d7",
                                                "sense_id": "2f6b71fa-1da2-38a8-bc3a-e7c7aaa9b41c",
                                                "text": "I got married ten years ago."
                                            },
                                            {
                                                "example_id": "de73bf0f-02f0-4a97-ba4c-0bbd0eabab6a",
                                                "sense_id": "2f6b71fa-1da2-38a8-bc3a-e7c7aaa9b41c",
                                                "text": "Two years ago a pair of scientists sparked fears of a devastating virus."
                                            },
                                            {
                                                "example_id": "8f97ab66-f181-464d-85d8-9a29c9e9de94",
                                                "sense_id": "2f6b71fa-1da2-38a8-bc3a-e7c7aaa9b41c",
                                                "text": "When they first met in 2000, my dad told my mom how he had gotten the money. The story begins 20 years ago."
                                            },
                                            {
                                                "example_id": "ff9fda4f-2c37-44d4-8118-987ced96aeb5",
                                                "sense_id": "2f6b71fa-1da2-38a8-bc3a-e7c7aaa9b41c",
                                                "text": "It was two weeks ago that I saw her last."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ago",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37540545-e4df-30f9-ac98-be0724e474b6",
                                        "entry_id": "50c4964a-bafc-3554-8a92-8c889e661a61",
                                        "glosses": [
                                            "Gone; gone by; gone away; passed; passed away."
                                        ],
