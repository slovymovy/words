        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c234a2f9-4ea2-3148-93a9-4cfe602e1ac6",
                "word": "gewgaw",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f4653f50-f11a-3b60-aa1e-68e0f2c9c363",
                        "entry_id": "c234a2f9-4ea2-3148-93a9-4cfe602e1ac6",
                        "glosses": [
                            "Showy; unreal; pretentious."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5a54122a-87ef-4335-9f9e-4f20a849bb74",
                                "sense_id": "f4653f50-f11a-3b60-aa1e-68e0f2c9c363",
                                "text": "The rattle of a globe to play withal,\nThis gewgaw world, and put him cheaply off;"
                            },
                            {
                                "example_id": "360f481a-5c77-40fe-9322-39e1d75fe202",
                                "sense_id": "f4653f50-f11a-3b60-aa1e-68e0f2c9c363",
                                "text": "Seeing his gewgaw castle shine,\nNew as his title, built last year."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "3ff91ef6-ef0c-48c0-ad54-a90d2e577416",
