        "fr-extract.jsonl": [
            {
                "entry_id": "4f248247-9155-39d1-9504-7d2c27f36a76",
                "word": "levantin",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b2ab482b-80ba-4e5b-b796-629878bcc38f",
