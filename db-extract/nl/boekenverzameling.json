                        "examples": [
                            {
                                "example_id": "3510c82a-7539-453d-a266-76178e52cfc2",
                                "sense_id": "251930bc-2c29-3101-bae4-9ef180e8f3fd",
                                "text": "Tsjechov heeft zijn boekenverzameling, die hij op zijn landgoed Melichovo had opgebouwd, in 1896 aan de openbare bibliotheek in Taganrog geschonken, inclusief alle boeken met opdracht die hij van andere schrijvers had gekregen."
                            },
                            {
                                "example_id": "43968577-48f2-40c5-a2d7-83721e4f0907",
                                "sense_id": "251930bc-2c29-3101-bae4-9ef180e8f3fd",
                                "text": "Komend weekeinde wordt het tweede Twents Lezersfeest gehouden in Stadstheater De Bond. Tijdens het evenement laten verschillende mensen een selectie van hun boekenverzameling zien."
                            }
                        ]
                    }
