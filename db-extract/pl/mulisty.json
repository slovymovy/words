                "senses": [
                    {
                        "sense_id": "182e3cfb-9f19-31dc-80a2-90d0e95cd26d",
                        "entry_id": "b5f68547-be51-3c7f-ad6a-8381fd1e035a",
                        "glosses": [
                            "pokryty mułem, mający konsystencję mułu, zawierający w sobie muł"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d33fa8f-1fac-4522-88b1-b6acb342f340",
                                "sense_id": "182e3cfb-9f19-31dc-80a2-90d0e95cd26d",
                                "text": "W rwącej, mulistej wodzie nie miała żadnych szans, było jedynie kwestią czasu, aby zdrętwiałe palce puściły pień, dlatego Peter trzymał ją jedną ręką."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea10a8cd-2b06-4f38-b2f6-71ed5b9eacf9",
                        "source_entry_id": "b5f68547-be51-3c7f-ad6a-8381fd1e035a",
                        "source_sense_id": "182e3cfb-9f19-31dc-80a2-90d0e95cd26d",
                        "target_lang_word": "sludgy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sludgy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45bd2209-90dd-3dc3-b32a-2df936de21f9",
                                        "entry_id": "50c1f7b0-eff2-3695-9be5-c71aea312690",
                                        "glosses": [
                                            "Characteristic of sludge; slimy or mucky"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7b75694-f16d-452d-bae7-dea8123d805d",
                        "source_entry_id": "b5f68547-be51-3c7f-ad6a-8381fd1e035a",
                        "source_sense_id": "182e3cfb-9f19-31dc-80a2-90d0e95cd26d",
                        "target_lang_word": "oozy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oozy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42a3f219-3285-32ce-9143-d9baa4fadcf9",
                                        "entry_id": "de57512e-0028-3661-8567-96db3593c2bf",
                                        "glosses": [
                                            "Of or pertaining to the quality of something that oozes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd815dc1-a569-442c-928e-feff7362e2dc",
                                                "sense_id": "42a3f219-3285-32ce-9143-d9baa4fadcf9",
                                                "text": "A daughter?\nOh heauens, that they were liuing both in Nalpes\nThe King and Queene there, that they were, I wish\nMy selfe were mudded in that oo-zie bed\nWhere my sonne lies: when did you lose your daughter?"
                                            },
                                            {
                                                "example_id": "8cc2d769-08c4-40be-98f9-65f994f590d2",
                                                "sense_id": "42a3f219-3285-32ce-9143-d9baa4fadcf9",
                                                "text": "[The rain] fell with an oozy, slushy sound among the grass; and made a muddy kennel of every furrow in the ploughed fields."
                                            },
                                            {
                                                "example_id": "3dea9c1d-14ee-43f6-82b7-bbda9ec2ebe0",
                                                "sense_id": "42a3f219-3285-32ce-9143-d9baa4fadcf9",
                                                "text": "1912, James Stephens, Mary, Mary (published in the UK as The Charwoman's Daughter), New York: Boni & Liveright, Chapter XXIV, p. 175, https://archive.org/details/marymary00stepiala\nHer vocabulary could not furnish her with the qualifying word, or rather, epithet for his bigness. Horrible was suggested and retained, but her instinct clamored that there was a fat, oozy word somewhere which would have brought comfort to her brains and her hands and feet."
                                            },
                                            {
                                                "example_id": "bc8b0960-0e57-49b4-8c73-249cf74f38f8",
                                                "sense_id": "42a3f219-3285-32ce-9143-d9baa4fadcf9",
                                                "text": "Each country is casting its net of espionage into the slimy bottom of the others, fishing for their secrets, the treacherous secrets which brew in the oozy depths of diplomacy."
                                            },
                                            {
                                                "example_id": "6b448d33-7a55-4689-92d6-10b71ef71c01",
                                                "sense_id": "42a3f219-3285-32ce-9143-d9baa4fadcf9",
                                                "text": "[…] he gulped down a chill and glutinous slice of the ice-cream brick, and cocoanut cake as oozy as shaving-cream."
                                            },
                                            {
                                                "example_id": "aac5fef8-90e2-4ede-b797-1c59e5a570bf",
                                                "sense_id": "42a3f219-3285-32ce-9143-d9baa4fadcf9",
                                                "text": "On birthdays and saints' days, Jewish musicians from the local community were invited to perform festive music and played \"an extraordinary variety of music: potpourris of famous operas, military marches, Viennese waltzes, and the ooziest gypsy songs and Jewish dances, rampant with glissandos, tremolos, and tearful vibratos.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
