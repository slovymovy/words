                "senses": [
                    {
                        "sense_id": "c8937e19-b498-3e44-a38e-e7c9df4f1319",
                        "entry_id": "e959e2f4-a4ad-363e-ae30-4e12788bc3bb",
                        "glosses": [
                            "Prêtre romain attaché au service spécial d’une divinité."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "1d307502-68d3-409a-be68-a6d3d6614066",
                                "sense_id": "c8937e19-b498-3e44-a38e-e7c9df4f1319",
                                "text": "Chacun des flamines était désigné par le nom du dieu dont il était le ministre."
                            },
                            {
                                "example_id": "d3714b64-f172-4072-aa11-1901d58df43e",
                                "sense_id": "c8937e19-b498-3e44-a38e-e7c9df4f1319",
                                "text": "Il n’y eut d’abord que trois flamines, celui de Jupiter, celui de Mars et celui de Romulus."
                            },
                            {
                                "example_id": "9e59d9d7-a54c-4f20-8d96-11b4db866947",
                                "sense_id": "c8937e19-b498-3e44-a38e-e7c9df4f1319",
                                "text": "Il faut rappeler à cet égard certaines des règles sacrées qui limitent la liberté du flamine majeur. Il lui est défendu non seulement de toucher un cadavre, mais encore d'approcher du lieu de l'incinération, d'entendre le son des flûtes funèbres, de prononcer le nom des végétaux ou des animaux qui jouent un rôle dans le culte des morts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f293c173-f9c6-4d75-a1ed-3d00a747c4ae",
                        "source_entry_id": "e959e2f4-a4ad-363e-ae30-4e12788bc3bb",
                        "source_sense_id": "c8937e19-b498-3e44-a38e-e7c9df4f1319",
