                    {
                        "sense_id": "c18dd9b3-a662-3348-b263-564fce1acb13",
                        "entry_id": "15bf6dbf-2d78-3d92-a717-e2c3d430b28f",
                        "glosses": [
                            "Long trousers/pants, as opposed to shorts."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "06ea45cf-d662-41ed-9dc6-b713885d9153",
                                "sense_id": "c18dd9b3-a662-3348-b263-564fce1acb13",
                                "text": "We then got dressed in our assault kit; one vest, two shirts, two jerseys, one lumber jacket, one pair of shorts, one pair of pajama longs, one pair of longs, one pair of snow goggles, a balaclava, two pairs of gloves, one pair of mitts […]"
                            },
                            {
                                "example_id": "d317f56e-f0ad-4ad4-a906-bcbb5f77e156",
                                "sense_id": "c18dd9b3-a662-3348-b263-564fce1acb13",
                                "text": "On the other hand, Bruce Camlin was one of the new generation of ang moh who knew their place in the new order, the post-colonial era. When he walked in on his first day, he wore longs made of coarse khaki and shirts that came off a supermarket peg."
                            }
                        ]
                    }
