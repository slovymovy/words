                                "target_senses": [
                                    {
                                        "sense_id": "6bba62a4-5548-3e51-94fd-2ce0e961942a",
                                        "entry_id": "fa5ad6e1-73a0-3b7f-b4b8-57cf0101dd7d",
                                        "glosses": [
                                            "Long ago; in the (distant) past."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39babe31-453f-4515-bfaa-45ae26a27f6a",
                                                "sense_id": "6bba62a4-5548-3e51-94fd-2ce0e961942a",
                                                "text": "I don't know why he asked me to do that, when I had long since finished it."
                                            },
                                            {
                                                "example_id": "fa751bd9-2408-4e60-a912-fe215ee518ff",
                                                "sense_id": "6bba62a4-5548-3e51-94fd-2ce0e961942a",
                                                "text": "The building has long since been demolished."
                                            },
                                            {
                                                "example_id": "b8f6c4fa-2c74-48d8-b01d-642e240ac86f",
                                                "sense_id": "6bba62a4-5548-3e51-94fd-2ce0e961942a",
                                                "text": "Reluctantly Raj used his fingernail to prise away the bogie he had long since sneezed up there and popped it in his mouth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
