                "senses": [
                    {
                        "sense_id": "79cd4961-164a-36b8-bc1a-870c1b71ad5b",
                        "entry_id": "f1b1541a-4b73-329e-9990-a1f9570a7f01",
                        "glosses": [
                            "Arbre dont les fleurs blanches et les fruits poussent directement sur le tronc, originaire du sud du Brésil, de Bolivie, du Paraguay et d’Argentine. Son nom scientifique est Myrciaria cauliflora."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "274ceb42-c262-4736-a030-b772c934145c",
                                "sense_id": "79cd4961-164a-36b8-bc1a-870c1b71ad5b",
                                "text": "La jaboticaba, cultivée au Brésil depuis les temps précolombiens, est un fruit prometteur de cette famille, très demandé dans le centre et le sud du pays."
                            }
                        ]
                    },
                    {
                        "sense_id": "b389cb09-1691-31c6-874d-d7e3a7241753",
                        "entry_id": "f1b1541a-4b73-329e-9990-a1f9570a7f01",
                        "glosses": [
                            "Fruit de couleur noire mesurant 3 à 4 cm poussant sur l’arbre du même nom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e602e4f8-f51a-459c-be3d-458ee9f5b1d3",
                                "sense_id": "b389cb09-1691-31c6-874d-d7e3a7241753",
                                "text": "Également appelé « Vigne brésilienne », le jaboticaba est un petit fruit qui ne fait rien comme les autres. Au lieu de pousser sur des branches, ce fruit de la taille d’une prune pousse directement sur des troncs d’arbres."
                            }
                        ]
                    }
