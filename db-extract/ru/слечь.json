                "senses": [
                    {
                        "sense_id": "1e0957a2-a5ff-3a61-aed4-3e4bcb32eef2",
                        "entry_id": "f6f8b9c1-d08d-3869-b5ec-c01e43da013a",
                        "glosses": [
                            "серьёзно заболеть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d57291d1-5c47-46a8-b025-fc8bf0098c0a",
                                "sense_id": "1e0957a2-a5ff-3a61-aed4-3e4bcb32eef2",
                                "text": "Мать слегла тогда тяжело, и Оленьке пришлось бросить первый курс, год пропустить, работать, потом перевестись на заочное."
                            },
                            {
                                "example_id": "f4c552cf-f326-44e2-9dc6-bde382a24c12",
                                "sense_id": "1e0957a2-a5ff-3a61-aed4-3e4bcb32eef2",
                                "text": "У Сантьяго объявился дерматит на интересном месте ― бедняга еле-еле ковылял (а назавтра совсем слёг)."
                            }
                        ]
                    }
