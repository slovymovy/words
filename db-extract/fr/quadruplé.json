                ],
                "translations": [
                    {
                        "translation_id": "54eaaf42-1224-4e6e-ac49-715637165f34",
                        "source_entry_id": "673c5a60-0cd2-3215-b931-0bbaa9efb7e6",
                        "source_sense_id": "708f80e9-4e0d-3505-b573-4c986550371a",
                        "target_lang_word": "Vierling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vierling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc2e8d53-f28d-3159-b96f-0077b8633f5e",
                                        "entry_id": "6076d869-0cc6-3f95-b15c-0d4eef2e9155",
                                        "glosses": [
                                            "eines von vier gemeinsam geborenen Geschwistern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10e64661-5af7-4651-8069-e5cae71a9f2c",
                                                "sense_id": "dc2e8d53-f28d-3159-b96f-0077b8633f5e",
                                                "text": "Vierlinge sind sehr selten. 2008 bekamen in Deutschland fast 700 000 Frauen Kinder – nur vier von ihnen Vierlinge."
                                            },
                                            {
                                                "example_id": "f6424edf-1080-4c91-aef8-3d689393a11a",
                                                "sense_id": "dc2e8d53-f28d-3159-b96f-0077b8633f5e",
                                                "text": "Denn Max ist ein Vierling – und wenn es drauf ankommt, halten er und seine Geschwister fest zusammen."
                                            },
                                            {
                                                "example_id": "b2bf4d75-98da-45b1-88a1-4f495e209e46",
                                                "sense_id": "dc2e8d53-f28d-3159-b96f-0077b8633f5e",
                                                "text": "„Diesmal in der Außenwelt: Die Frau eines Marmeladen-Fabrikanten, dessen Geschäftsinserate in allen Zeitungen erschienen, hatte irgendwann Vierlinge geboren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a5560b0-adbd-3c2d-8bf9-6e57a752f4cc",
                                        "entry_id": "6076d869-0cc6-3f95-b15c-0d4eef2e9155",
                                        "glosses": [
                                            "vier Karten des gleichen Wertes"
                                        ],
                                        "tags": [
                                            "beim Pokerspiel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e0ff5a1-788e-4fed-81e6-88b380e276ba",
                                                "sense_id": "7a5560b0-adbd-3c2d-8bf9-6e57a752f4cc",
                                                "text": "Ein Straight Flush zählt mehr als ein Vierling, ein Full House weniger."
                                            },
                                            {
                                                "example_id": "a3d45ee8-670a-4ec3-bb4e-252f1732000d",
                                                "sense_id": "7a5560b0-adbd-3c2d-8bf9-6e57a752f4cc",
                                                "text": "Der Vierling steht über dem Full House und unter einem Straight Flush. Es entscheidet die Höhe des Vierlings."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4d602dbc-d156-3be0-8823-106cfdb8c469",
                                        "entry_id": "6076d869-0cc6-3f95-b15c-0d4eef2e9155",
                                        "glosses": [
                                            "Jagdwaffe mit vier Läufen, jeweils zwei Schrot- und zwei Kugelläufe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93becc93-12c5-48fb-89f2-c8ece27e0a74",
                                                "sense_id": "4d602dbc-d156-3be0-8823-106cfdb8c469",
                                                "text": "„Die Büchsflinte hat je einen nebeneinander liegenden Kugel- und Flintenlauf, der Büchsdrilling zwei Kugelläufe und einen Flintenlauf, der Drilling einen Kugellauf und zwei Flintenläufe, der Vierling je zwei Kugel- und Flintenläufe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Vierling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a10bab5-00bb-319a-a626-a501361e320d",
                                        "entry_id": "6c046f54-5c8d-3518-a13b-cff87f9e8cbc",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61164526-9435-4c9c-bbb4-c4ba8b2e85e1",
                                                "sense_id": "6a10bab5-00bb-319a-a626-a501361e320d",
                                                "text": "Vierling gründete 1853 in Berlin den Bach-Verein und wurde 1859 Musikdirektor, später Professor und Senatsmitglied der königlichen Akademie der Künste in Berlin."
                                            }
                                        ],
