                    {
                        "translation_id": "a72f47b9-18e3-4186-9460-0b8ce5d5638a",
                        "source_entry_id": "34ebd5c6-5a51-3780-9a11-59f6d2961889",
                        "source_sense_description": "of a plant, having been fully removed",
                        "target_lang_word": "entwurzelt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entwurzelt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6cc9a89-f2de-3580-9db8-15e67416d7bb",
                                        "entry_id": "3e849a34-eedc-397f-bb15-5d348bd179dd",
                                        "glosses": [
                                            "mit der Wurzel ausgerissen"
                                        ],
                                        "tags": [
                                            "Pflanzen",
                                            "ohne Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71a3c8e2-f0cb-4e06-b536-c998bb7d72fc",
                                                "sense_id": "e6cc9a89-f2de-3580-9db8-15e67416d7bb",
                                                "text": "[Wasserschieling:] „Vegetative Vermehrung erfolgt durch entwurzelte und schwimmende Knollen.“"
                                            },
                                            {
                                                "example_id": "0c05183d-6634-47f6-877b-123865ed6350",
                                                "sense_id": "e6cc9a89-f2de-3580-9db8-15e67416d7bb",
                                                "text": "Der schwere Sturm ließ viele entwurzelte Bäume zurück."
                                            },
                                            {
                                                "example_id": "c782ab96-47a3-4d1a-8715-210dacb09e49",
                                                "sense_id": "e6cc9a89-f2de-3580-9db8-15e67416d7bb",
                                                "text": "[Taifun Meranti in Südchina 2016:] „Entwurzelte Bäume und Überschwemmungen blockierten Straßen.“"
                                            },
                                            {
                                                "example_id": "58b577fb-09c4-44e2-a70c-6d55884e92f4",
                                                "sense_id": "e6cc9a89-f2de-3580-9db8-15e67416d7bb",
                                                "text": "[Orkan Xaver im Dezember 2013:] „Noch im Sommer lagen entwurzelte Riesen - mit bis zu 8 Meter hohen Baumtellern - kreuz und quer verteilt über die 6000 Hektar.“"
                                            },
                                            {
                                                "example_id": "92805067-aba3-48fb-91d6-3e7843d2005b",
                                                "sense_id": "e6cc9a89-f2de-3580-9db8-15e67416d7bb",
                                                "text": "„Orkantief \"Zeynep\" ist mit extremen Böen über Schleswig-Holstein gezogen. Geblieben sind entwurzelte Bäume, viele Schäden - aber zum Glück offenbar keine schwer verletzten Menschen.“"
                                            },
                                            {
                                                "example_id": "544862aa-1c80-4d22-bbf7-e1befbd6245f",
                                                "sense_id": "e6cc9a89-f2de-3580-9db8-15e67416d7bb",
                                                "text": "[Nationalpark Harz:] „Zahllose tote Baumgerippe ragen in den Himmel, überall liegen entwurzelte und wild übereinander gestürzte Baumreste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "64085d62-2dac-3eb9-8687-317e1ef63999",
                                        "entry_id": "3e849a34-eedc-397f-bb15-5d348bd179dd",
                                        "glosses": [
                                            "ohne zuhause, ohne (soziale) Bindungen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b077a798-e30d-4fc5-82c4-4c281d32f0e3",
                                                "sense_id": "64085d62-2dac-3eb9-8687-317e1ef63999",
                                                "text": "„Es sind vor allem junge, vom Krieg entwurzelte Männer, die sich nach der Monarchie und einem autoritären Staat sehnen.“"
                                            },
                                            {
                                                "example_id": "8e65e6e6-e05f-403f-8bf5-b0ee7df1c47b",
                                                "sense_id": "64085d62-2dac-3eb9-8687-317e1ef63999",
                                                "text": "„Paramilitärische Freikorps – In diesen militärähnlichen Gruppierungen sammelten sich nach dem Ersten Weltkrieg etwa 400.000 vom Krieg sozial entwurzelte Männer.“"
                                            },
                                            {
                                                "example_id": "323faea2-670c-4df2-a9c6-aaf0eab1f318",
                                                "sense_id": "64085d62-2dac-3eb9-8687-317e1ef63999",
                                                "text": "„Der entwurzelte Vietnam-Veteran („Gottes einsamster Mann“) arbeitet in New York als Taxifahrer“ […]."
                                            },
                                            {
                                                "example_id": "db48e437-372b-4fe4-a5f0-d86ca3ae6501",
                                                "sense_id": "64085d62-2dac-3eb9-8687-317e1ef63999",
                                                "text": "„Entwurzelte Soldaten zogen durch die Straßen und politische Gruppierungen bekämpften sich gegenseitig, es herrschte Mord und Totschlag.“"
                                            },
                                            {
                                                "example_id": "46a2842b-ff48-493b-874e-4c48894abd78",
                                                "sense_id": "64085d62-2dac-3eb9-8687-317e1ef63999",
                                                "text": "„Hobos kamen nach dem Amerikanischen Bürgerkrieg auf, als“ […] „viele durch den Krieg entwurzelte Männer Probleme hatten, sich wieder in die Zivilgesellschaft zu integrieren.“"
                                            },
                                            {
                                                "example_id": "ababc616-327e-47e9-ab27-bf0109310207",
                                                "sense_id": "64085d62-2dac-3eb9-8687-317e1ef63999",
                                                "text": "„Anders als die Elite, suchten viele entwurzelte Bauern Halt an traditionellen islamischen Wertvorstellungen.“"
                                            },
                                            {
                                                "example_id": "4086bb48-182d-4183-9959-2e48461061ee",
                                                "sense_id": "64085d62-2dac-3eb9-8687-317e1ef63999",
                                                "text": "[Völkermord an den Armeniern:] „Als sozial und kulturell entwurzelte, überwiegend bäuerliche Landbewohner fanden sie sich nun als meist völlig mittellose Flüchtlinge in fremden Städten mit einer für sie völlig fremden Kultur und Mentalität wieder.“"
                                            },
                                            {
                                                "example_id": "1682523e-b37a-4e35-905f-51fd51d9f55c",
                                                "sense_id": "64085d62-2dac-3eb9-8687-317e1ef63999",
                                                "text": "„Besondere Aufmerksamkeit sollte der sexuellen Gewalt gegen entwurzelte Frauen und Mädchen gewidmet werden, die in systematischen Terror- und Einschüchterungskampagnen als Methode der Verfolgung eingesetzt wird“ […]."
                                            },
                                            {
                                                "example_id": "738d2c69-6517-4ee1-9e76-2765e7983244",
                                                "sense_id": "64085d62-2dac-3eb9-8687-317e1ef63999",
                                                "text": "[Syrienkrieg:] „Die schlimmsten Verlierer sind die nahezu zwei Millionen entwurzelten Kinder.“"
                                            },
                                            {
                                                "example_id": "2edc9203-6349-47c1-aca9-749629876e6f",
                                                "sense_id": "64085d62-2dac-3eb9-8687-317e1ef63999",
                                                "text": "„Vor unserer Haustür brennen die Flüchtlingsheime, der braune Mob zieht durch die Straßen und tausende entwurzelte Männer, Frauen und Kinder vegetieren dahin im Fegefeuer des deutschen Asylrechts - und das sind nur die, die es überhaupt bis hierher geschafft haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
