                    {
                        "translation_id": "110a7029-f3b5-43e0-ab65-7f23a7c7d21e",
                        "source_entry_id": "1de38cc3-1e66-30e1-9ad0-d4a0a091c3c5",
                        "target_lang_word": "familiarity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "familiarity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16dae9b4-1f0f-3fd3-a4b2-ca939563ee3d",
                                        "entry_id": "663506f5-3fbf-322e-9c46-f70549bf9418",
                                        "glosses": [
                                            "The state of being extremely friendly; intimacy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13f0d17c-ef13-4be7-a394-20a1f33e2916",
                                                "sense_id": "16dae9b4-1f0f-3fd3-a4b2-ca939563ee3d",
                                                "text": "It is also folly and injustice to deprive children[…]of their fathers familiaritie, and ever to shew them a surly, austere, grim, and disdainefull countenance, hoping thereby to keepe them in awfull feare and duteous obedience."
                                            },
                                            {
                                                "example_id": "33017085-5850-4476-b7b9-d10d253785c4",
                                                "sense_id": "16dae9b4-1f0f-3fd3-a4b2-ca939563ee3d",
                                                "text": "Do not keep familiarity with any but those, with whom you may improve your time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "380fd6fc-e200-3719-8bd5-61b3f14ff829",
                                        "entry_id": "663506f5-3fbf-322e-9c46-f70549bf9418",
                                        "glosses": [
                                            "Undue intimacy; inappropriate informality, impertinence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6c51bd8-d78f-4038-8cbb-c77a80483460",
                                                "sense_id": "380fd6fc-e200-3719-8bd5-61b3f14ff829",
                                                "text": "Murrel did not in the least object to being called a monkey, yet he always felt a slight distaste when Julian Archer called him one.[…]It had to do with a fine shade between familiarity and intimacy which men like Murrel are never ready to disregard, however ready they may be to black their faces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1831a8ab-fa15-3e6b-ad73-7cec0ddae30c",
                                        "entry_id": "663506f5-3fbf-322e-9c46-f70549bf9418",
                                        "glosses": [
                                            "An instance of familiar behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8663ec43-d4f9-3def-a344-05426264b3e5",
                                        "entry_id": "663506f5-3fbf-322e-9c46-f70549bf9418",
                                        "glosses": [
                                            "Close or habitual acquaintance with someone or something; understanding or recognition acquired from experience."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff5d50aa-18f9-4532-b768-46d8774eff90",
                                                "sense_id": "8663ec43-d4f9-3def-a344-05426264b3e5",
                                                "text": "The objects around have been seen so often, that they have at last become, as it were, unseen; their familiarity does not carry us out of ourselves, for all their associations are our own."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
