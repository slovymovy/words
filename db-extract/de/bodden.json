                                                "example_id": "5cf45bee-06af-4fcc-8326-15d0211ce097",
                                                "sense_id": "22778cf7-390a-3332-b91e-ebf6af3c9235",
                                                "text": "Wrex: And Shepard--I like what you've done with the Normandy. Got tired of always hanging around the cargo bay before."
                                            },
