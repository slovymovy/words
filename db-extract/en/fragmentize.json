                    {
                        "sense_id": "2108a797-ad12-3aac-8bd4-e8efadf5acbf",
                        "entry_id": "2be479ac-15fb-394b-b830-063b45fc662d",
                        "glosses": [
                            "To break, cut, or otherwise separate (something) into fragments."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "76d93102-705d-429e-b199-780bd30f832c",
                                "sense_id": "2108a797-ad12-3aac-8bd4-e8efadf5acbf",
                                "text": "[I]t was against fragmentizing the human soul that he was prepared to protest with the whole force of his life."
                            },
                            {
                                "example_id": "96ffffd4-3f01-42b6-b96b-6448fccf3308",
                                "sense_id": "2108a797-ad12-3aac-8bd4-e8efadf5acbf",
                                "text": "In experimental surgery, a cool laser produces shock waves that fragmentize part of the cornea."
                            }
                        ]
                    },
                    {
                        "sense_id": "5070a72a-4047-3771-8e48-5903bab44c6d",
                        "entry_id": "2be479ac-15fb-394b-b830-063b45fc662d",
                        "glosses": [
                            "To fall into or become separated into fragments."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b3ea4dfc-d39d-4a62-a3f1-5335b4c12240",
                                "sense_id": "5070a72a-4047-3771-8e48-5903bab44c6d",
                                "text": "[T]he sport has been subject to varying levels of interest. During low points the chronicle fragmentizes as the continuity of enthusiasm becomes disrupted."
                            }
                        ]
                    }
