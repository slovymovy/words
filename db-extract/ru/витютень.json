                                    {
                                        "sense_id": "66970701-f6c6-36e5-8028-1e15ae123faa",
                                        "entry_id": "96e44ab2-a1cd-3a9f-a10c-c083d3457a92",
                                        "glosses": [
                                            "A pigeon, wood pigeon or ring dove."
                                        ],
                                        "tags": [
                                            "Geordie",
                                            "Scotland",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0aa34f2-45b5-4494-a782-c3e448777d7a",
                                                "sense_id": "66970701-f6c6-36e5-8028-1e15ae123faa",
                                                "text": "Thro' lofty groves the Cuſhat roves,\nThe path of man to ſhun it"
                                            },
                                            {
                                                "example_id": "4567823f-86f4-4700-8614-ae5b2eddb5c3",
                                                "sense_id": "66970701-f6c6-36e5-8028-1e15ae123faa",
                                                "text": "[A]nd no sound falls on my ears, except the distant roar of a passing train, the song of linnets, and croodle of turtle-dove and cushat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
