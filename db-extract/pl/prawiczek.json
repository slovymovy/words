                                "target_senses": [
                                    {
                                        "sense_id": "ae87d751-c4e5-30d5-9b1e-23067d24708c",
                                        "entry_id": "d7871af3-4e2f-38cb-a063-b4023d734bc7",
                                        "glosses": [
                                            "In a state of virginity; chaste, not having had sexual intercourse."
                                        ],
