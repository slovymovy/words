                "senses": [
                    {
                        "sense_id": "ed59cba9-36c8-3e32-a4de-d25633479cd3",
                        "entry_id": "69ded31e-c05f-31cd-8e36-6e9808fbe5e3",
                        "glosses": [
                            "сленг говорить глупости, нести чушь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abed2ed4-b7d0-4ea8-bddc-b3416d1c30d2",
                                "sense_id": "ed59cba9-36c8-3e32-a4de-d25633479cd3",
                                "text": "— Мужики, хорош мудеть, на пистоле переводчик огня есть! Патрон 6,35 мм достаточно хорош, чтобы отделить душу от тела."
                            },
                            {
                                "example_id": "64040ad8-f697-440f-adc3-ff406fbd9803",
                                "sense_id": "ed59cba9-36c8-3e32-a4de-d25633479cd3",
                                "text": "Ааааа! опять этот срач… Го БОшки попинаем лучше! как в старые добрые, норт, тони? хорош мудеть, го!"
                            },
                            {
                                "example_id": "7a98d326-5aac-40ce-b0a8-d47b1c4fdcfa",
                                "sense_id": "ed59cba9-36c8-3e32-a4de-d25633479cd3",
                                "text": "хорош мудеть спи итди баиньки тоже мне"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7649eb45-78d8-4b83-9554-db2da7448c66",
                        "source_entry_id": "69ded31e-c05f-31cd-8e36-6e9808fbe5e3",
                        "source_sense_id": "ed59cba9-36c8-3e32-a4de-d25633479cd3",
                        "target_lang_word": "bullshit",
