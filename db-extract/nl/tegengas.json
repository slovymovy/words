                                    {
                                        "sense_id": "dfd272c1-d367-32d5-b05b-f21d015fe161",
                                        "entry_id": "d454fa4f-33b2-343a-a70e-ea1332663615",
                                        "glosses": [
                                            "A resistor."
                                        ],
                                        "tags": [
                                            "countable",
