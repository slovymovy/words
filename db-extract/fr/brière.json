                        "entry_id": "597d01be-b317-307c-bae0-ff06ee83f55a",
                        "glosses": [
                            "Marais et région naturelle situé au nord de l’estuaire de la Loire et de Saint-Nazaire, à l’ouest du département de la Loire-Atlantique."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "5c6a0ecf-c33f-4850-8cd9-aa27264c94a7",
                                "sense_id": "de121fad-b1bd-30da-9ecf-ba3790593995",
                                "text": "Le 5, la Brière, le second marais de France après la Camargue, un ancien golfe parsemé d’îles comblé par les alluvions, se vitrifia en une nuit."
                            },
                            {
                                "example_id": "03f3a556-ec7c-4df8-b673-f774eb4e4db4",
                                "sense_id": "de121fad-b1bd-30da-9ecf-ba3790593995",
                                "text": "Le Parc naturel régional de Brière comprend une zone humide recensée parmi les plus riches d’Europe sur le plan biologique."
                            }
                        ]
                    }
