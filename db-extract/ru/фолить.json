                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d92317f-6a42-47f9-b855-59788df4b417",
                                                "sense_id": "1b336870-f9db-3304-bcb0-7e04a6af38b6",
                                                "text": "Smith fouled within the first minute of the quarter."
                                            },
                                            {
                                                "example_id": "d400edec-411e-4a68-9db5-f71a489ce8b3",
                                                "sense_id": "1b336870-f9db-3304-bcb0-7e04a6af38b6",
                                                "text": "State begins fouling and UCLA misses a couple of front-end free throws on one-and-ones."
