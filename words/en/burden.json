{
    "word_family": [
        "burdensome",
        "unburden",
        "overburden",
        "burdenless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5579cbbb-27bc-3702-a8c2-b250942fa477",
                    "sense_definition": "A difficult duty, responsibility, or obligation that one must accept and manage.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "load_responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>burden</w> of proof lies with the prosecution in a criminal trial.",
                            "target_lang_translations": {
                                "ru": "<w>Бремя</w> доказывания в уголовном процессе лежит на стороне обвинения.",
                                "zh": "在刑事审判中，举证<w>责任</w>在控方。"
                            }
                        },
                        {
                            "text": "She felt the heavy <w>burden</w> of raising three children on her own.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала тяжкое <w>бремя</w> воспитания троих детей в одиночку.",
                                "zh": "她感到独自抚养三个孩子的沉重<w>负担</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "responsibility",
                        "onus",
                        "obligation",
                        "liability",
                        "charge"
                    ],
                    "antonyms": [
                        "privilege",
                        "advantage"
                    ],
                    "common_phrases": [
                        "burden of proof",
                        "financial burden",
                        "tax burden",
                        "bear the burden",
                        "share the burden"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжёлая обязанность, ответственность или долг, которые необходимо принять и нести.",
                        "zh": "必须接受并加以承担、处理的艰巨责任、义务或任务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бремя",
                                "target_lang_sense_clarification": "тяжёлая обязанность"
                            },
                            {
                                "target_lang_word": "груз",
                                "target_lang_sense_clarification": "ответственность"
                            },
                            {
                                "target_lang_word": "тяжесть",
                                "target_lang_sense_clarification": "гнёт ответственности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "责任",
                                "target_lang_sense_clarification": "必须承担并处理的责任或义务"
                            },
                            {
                                "target_lang_word": "重担",
                                "target_lang_sense_clarification": "沉重而难以承受的责任"
                            },
                            {
                                "target_lang_word": "负担",
                                "target_lang_sense_clarification": "强调需要承担的压力或义务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cea3381-6f52-3d40-bd86-a25ff96dc533",
                    "sense_definition": "Something oppressive or worrisome that causes distress, grief, or difficulty.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "load_responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not want to become a <w>burden</w> to my family when I get old.",
                            "target_lang_translations": {
                                "ru": "Я не хочу стать <w>обузой</w> для своей семьи, когда состарюсь.",
                                "zh": "我老了以后不想成为家人的<w>负担</w>。"
                            }
                        },
                        {
                            "text": "The debt became a terrible <w>burden</w> that kept him awake at night.",
                            "target_lang_translations": {
                                "ru": "Долг стал ужасным <w>грузом</w>, который не давал ему спать по ночам.",
                                "zh": "债务成了可怕的<w>负担</w>，让他夜里睡不着。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trouble",
                        "affliction",
                        "hardship",
                        "trial",
                        "encumbrance"
                    ],
                    "antonyms": [
                        "relief",
                        "blessing",
                        "help",
                        "comfort"
                    ],
                    "common_phrases": [
                        "be a burden",
                        "ease the burden",
                        "lift the burden",
                        "heavy burden"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то угнетающее или тревожное, причиняющее страдания или трудности.",
                        "zh": "使人感到压抑、担忧或痛苦的事物，带来困扰、悲伤或困难。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обуза",
                                "target_lang_sense_clarification": "помеха для других"
                            },
                            {
                                "target_lang_word": "бремя",
                                "target_lang_sense_clarification": "тяготы"
                            },
                            {
                                "target_lang_word": "тяжесть",
                                "target_lang_sense_clarification": "гнетущее чувство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "负担",
                                "target_lang_sense_clarification": "令人忧愁或难以承受的事物"
                            },
                            {
                                "target_lang_word": "累赘",
                                "target_lang_sense_clarification": "对别人造成拖累时常用"
                            },
                            {
                                "target_lang_word": "重担",
                                "target_lang_sense_clarification": "强调压迫感或精神沉重"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7be8404f-3454-33be-afdc-154dfcf97469",
                    "sense_definition": "A heavy physical load that is carried.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "load_responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The donkey walked slowly under the heavy <w>burden</w> on its back.",
                            "target_lang_translations": {
                                "ru": "Ослик медленно шёл под тяжёлой <w>ношей</w> на спине.",
                                "zh": "那头驴背着沉重的<w>担子</w>，慢慢地走着。"
                            }
                        },
                        {
                            "text": "He put down his <w>burden</w> and rested by the side of the road.",
                            "target_lang_translations": {
                                "ru": "Он опустил свою <w>ношу</w> и отдохнул на обочине дороги.",
                                "zh": "他放下自己的<w>担子</w>，在路边休息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "load",
                        "weight",
                        "cargo",
                        "freight"
                    ],
                    "antonyms": [
                        "lightness"
                    ],
                    "common_phrases": [
                        "beast of burden",
                        "carry a burden"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжёлый физический груз, который переносят.",
                        "zh": "被携带或搬运的沉重实物负荷。"
