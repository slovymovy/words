                "senses": [
                    {
                        "sense_id": "e798ab3c-6d4d-30d5-958c-a90163f56e3d",
                        "entry_id": "15bad09a-ec5c-3746-a898-1871dca40080",
                        "glosses": [
                            "D’une manière verbeuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad1a2af2-9228-4322-ac74-f65d94811f4f",
                                "sense_id": "e798ab3c-6d4d-30d5-958c-a90163f56e3d",
                                "text": "De plus, je ne sais que trop combien il est le plus souvent inutile d’augmenter verbeusement et sans cesse le nombre des conseils qu’on ne suit pas."
                            },
                            {
                                "example_id": "3e1a3580-fcb4-4070-affd-d755ab8af643",
                                "sense_id": "e798ab3c-6d4d-30d5-958c-a90163f56e3d",
                                "text": "Et il me raconta verbeusement ses innombrables projets, voulant faire sa fortune et la mienne, vantant son savoir-faire, sa rouerie."
                            },
                            {
                                "example_id": "0e834ed0-0e77-449c-93dd-8a07f15fc89d",
                                "sense_id": "e798ab3c-6d4d-30d5-958c-a90163f56e3d",
                                "text": "Impassible et le cerveau engourdi, elle n’écoutait plus Coco Raulin, qui continuait à dégoiser verbeusement les nouvelles rapportées du Coq-Hardi."
                            }
                        ]
                    }
                ],
