                        "examples": [
                            {
                                "example_id": "830a8bdc-70a2-44d4-b398-8c0a28200412",
                                "sense_id": "c8e22997-3417-341d-8c0c-f45130ff38a3",
                                "text": "BELOSSE, sf Prunelle, prune sauvage, fruit du prunelier. Terme suisse-roman savoisien et vieux français. A Fribourg on dit Bolosse, à Lyon et dans le Jura pelosse, en Normandie Bloche. A Reims on donne aux prunes le nom générique de balosses."
                            },
                            {
                                "example_id": "f677067e-809d-4258-9ec1-8ef1a29a0cfa",
                                "sense_id": "c8e22997-3417-341d-8c0c-f45130ff38a3",
                                "text": "Sans être particulièrement liante, elle ne m’envoie pas aux pelosses, comme on dit dans le pays natal à ma Félicie d’amour."
                            }
                        ]
                    }
