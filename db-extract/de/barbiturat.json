                "senses": [
                    {
                        "sense_id": "03ba4c8a-e689-389e-9e3f-741e84f77eec",
                        "entry_id": "a051bfaf-47dc-3152-9998-fe70af89b8ec",
                        "glosses": [
                            "aus der Barbitursäure gewonnenes Mittel, das wegen seiner dämpfenden Wirkung auf das Zentralnervensystem meist als Beruhigungs- oder Schlafmittel genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b54b273a-7b58-4a72-a78d-a86ba4c994f5",
                                "sense_id": "03ba4c8a-e689-389e-9e3f-741e84f77eec",
                                "text": "„Die Barbiturate waren bald weit verbreitet, in der Bevölkerung erfreuten sie sich großer Beliebtheit.“"
                            },
                            {
                                "example_id": "c58c8a14-c8f3-458b-9503-283316d96018",
                                "sense_id": "03ba4c8a-e689-389e-9e3f-741e84f77eec",
                                "text": "„Und wenn Christus an einer Überdosis Barbiturate gestorben wäre, allein auf dem Fußboden im Badezimmer, wäre er dann jetzt im Himmel?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed5cfcbb-3713-4faa-9d0d-9c26089e4718",
                        "source_entry_id": "a051bfaf-47dc-3152-9998-fe70af89b8ec",
