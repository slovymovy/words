{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e3fc2577-c981-3556-8425-8e8d24c7636b",
                    "sense_definition": "grube okrycie służące do przykrywania się w czasie snu lub odpoczynku; koc lub kołdra",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "okrycie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W zimowy wieczór usiadł w fotelu i owinął się ciepłą <w>deką</w>.",
                            "target_lang_translations": {
                                "ru": "Зимним вечером он сел в кресло и завернулся в тёплый <w>плед</w>."
                            }
                        },
                        {
                            "text": "Babcia wyciągnęła z szafy wełnianą <w>dekę</w>, aby przygotować posłanie dla gościa.",
                            "target_lang_translations": {
                                "ru": "Бабушка достала из шкафа шерстяное <w>одеяло</w>, чтобы подготовить постель для гостя."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ciepła deka"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "używane regionalnie, m.in. na Śląsku"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "толстое покрывало, служащее для укрывания во время сна или отдыха; плед или одеяло"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одеяло",
                                "target_lang_sense_clarification": "толстое постельное покрывало"
                            },
                            {
                                "target_lang_word": "плед",
                                "target_lang_sense_clarification": "шерстяное или теплое покрывало"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0025d440-50b7-3cef-afbe-7b803769d230",
                    "sense_definition": "płaska forma z blachy używana do pieczenia ciast lub mięsa",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "naczynie_kuchenne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed włożeniem ciasta do piekarnika mama dokładnie wysmarowała <w>dekę</w> tłuszczem.",
                            "target_lang_translations": {
                                "ru": "Перед тем как поставить пирог в духовку, мама тщательно смазала <w>противень</w> жиром."
                            }
                        },
                        {
                            "text": "Gorąca <w>deka</w> z upieczonym chlebem powoli stygła na stole kuchennym.",
                            "target_lang_translations": {
                                "ru": "Горячий <w>противень</w> с испечённым хлебом медленно остывал на кухонном столе."
                            }
                        }
                    ],
                    "synonyms": [
                        "blacha"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "regionalizm"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "плоский металлический лист для выпечки пирогов или мяса"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противень",
                                "target_lang_sense_clarification": "металлический лист для выпечки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c94b0f8-b161-3362-acfc-65e5bf61a2eb",
                    "sense_definition": "betonowa płyta stanowiąca strop między kondygnacjami budynku",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "budownictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Robotnicy rozpoczęli dzisiaj zalewanie betonem kolejnej <w>deki</w> na budowie.",
                            "target_lang_translations": {
                                "ru": "Рабочие сегодня начали заливку бетоном очередного <w>перекрытия</w> на стройке."
                            }
                        },
                        {
                            "text": "Solidna <w>deka</w> oddzielała parter od pierwszego piętra nowego domu.",
                            "target_lang_translations": {
                                "ru": "Надёжная <w>плита перекрытия</w> отделяла первый этаж от второго этажа нового дома."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "gwara Śląska Cieszyńskiego"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "бетонная плита, служащая межэтажным перекрытием в здании"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перекрытие",
                                "target_lang_sense_clarification": "межэтажное перекрытие"
                            },
                            {
                                "target_lang_word": "плита перекрытия",
                                "target_lang_sense_clarification": "железобетонная плита"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}