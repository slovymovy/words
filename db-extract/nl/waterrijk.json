                                    {
                                        "sense_id": "559fc9f1-ed4a-3c38-8e79-8b2745604143",
                                        "entry_id": "a04f7d28-9486-3ac0-83c7-abde85682618",
                                        "glosses": [
                                            "Resembling or characteristic of water."
                                        ],
                                        "tags": [],
