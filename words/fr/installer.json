    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0311a20f-81f8-3b8c-a128-677e484c284e",
                    "sense_definition": "Placer, aménager ou disposer une personne ou un objet dans un endroit déterminé.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "disposition_spatiale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous allons <w>installer</w> une tente dans le jardin pour accueillir les enfants pendant le week-end."
                        },
                        {
                            "text": "Le technicien est venu <w>installer</w> un nouvel appareil de chauffage dans le couloir."
                        }
                    ],
                    "synonyms": [
                        "disposer",
                        "mettre en place",
                        "placer"
                    ],
                    "antonyms": [
                        "déranger"
                    ],
                    "common_phrases": [
                        "installer une tente",
                        "installer un meuble"
                    ]
                },
                {
                    "sense_id": "5d8a17fc-fd3c-3a84-abc8-e45c642b272a",
                    "sense_definition": "Charger et configurer un logiciel ou une application sur un ordinateur ou un appareil mobile.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je dois <w>installer</w> une application sur mon téléphone pour pouvoir suivre l'état de ma commande."
                        },
                        {
                            "text": "Après avoir téléchargé le fichier, vous pouvez <w>installer</w> ce programme en suivant l'assistant de configuration."
                        }
                    ],
                    "common_phrases": [
                        "installer une application",
                        "installer un logiciel",
                        "installer un programme"
                    ]
                },
                {
                    "sense_id": "edcc4e6a-3759-33f6-afc5-bda1a18e4921",
                    "sense_definition": "Mettre solennellement une personne en possession d'une charge, d'une dignité ou de nouvelles fonctions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "investiture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre s'est déplacé en personne pour <w>installer</w> le nouveau préfet dans la préfecture régionale."
                        },
                        {
                            "text": "Une cérémonie officielle aura lieu demain afin d'<w>installer</w> solennellement les nouveaux magistrats au tribunal."
                        }
                    ],
                    "common_phrases": [
                        "installer dans ses fonctions"
                    ]
                },
                {
                    "sense_id": "7678ea62-7504-3a21-bc20-6e8bde40b716",
                    "sense_definition": "Chercher à en imposer, plastronner ou crâner auprès des autres.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il parlait très fort devant toute la tablée uniquement pour en <w>installer</w> auprès de ses amis."
                        },
                        {
                            "text": "Pendant toute la réunion, il n'a cessé d'en <w>installer</w> en inventant des histoires improbables."
                        }
                    ],
                    "common_phrases": [
                        "en installer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier ou populaire"
                        }
                    ]
                }
            ]
        }
    ]
}