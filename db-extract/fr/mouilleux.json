                        "glosses": [
                            "Qualifie un terrain humide, détrempé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d240412-f083-4af1-b0e5-1028131b970a",
                                "sense_id": "eb21f70d-8415-38e1-8028-de388b8bd3fe",
                                "text": "Habituellement les terrains mouilleux qu'on veut planter sont assainis au préalable et le creusement des fossés de drainage sert à faire des buttes ou des remblais."
                            },
                            {
                                "example_id": "7a04667b-4dad-4c8c-9150-5424227f1244",
                                "sense_id": "eb21f70d-8415-38e1-8028-de388b8bd3fe",
                                "text": "Dans les stations typiquement à aulne (bordures de cours d'eau, fonds mouilleux), une régénération naturelle s'installera sûrement après une coupe."
                            }
                        ]
                    }
