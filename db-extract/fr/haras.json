                                        "sense_id": "fc725f0d-686a-3cf3-9675-220d10f5c018",
                                        "entry_id": "8c0e6d83-a845-3135-ab13-19b6d23720c4",
                                        "glosses": [
                                            "het bedrijfsmatig telen van paarden"
                                        ],
                                        "tags": [
                                            "veeteelt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d83dc4f3-2921-4d63-a9f9-6525796acf0e",
                                                "sense_id": "fc725f0d-686a-3cf3-9675-220d10f5c018",
                                                "text": "De koningin, die bekendstaat als groot paardenliefhebber, genoot zichtbaar van het evenement, zeker toen er op het hoogtepunt van de show dieren uit haar eigen stoeterij voorbij werden geleid. Met een deken over haar benen en een sjaal om volgde ze de show aandachtig en knikte ze soms instemmend bij alle lof."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82aea672-d285-35dd-8f83-60eb765578e4",
                                        "entry_id": "8c0e6d83-a845-3135-ab13-19b6d23720c4",
                                        "glosses": [
                                            "de bedrijfslocatie waar paarden worden geteeld"
                                        ],
                                        "tags": [
                                            "veeteelt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5afadedd-93ac-46b2-874b-30bb184a4494",
                                                "sense_id": "82aea672-d285-35dd-8f83-60eb765578e4",
                                                "text": "Volgens de aanklagers betaalde Wildenstein jarenlang geen belasting over zijn kapitale schilderijenverzameling en vastgoedportefeuille. De miljardair bezit veel werken van rococo-schilder Jean-Honoré Fragonard en van post-impressionist Pierre Bonnard. Ook heeft hij onder meer een stoeterij met racepaarden en een landgoed in Kenia waar de film Out of Africa werd opgenomen."
                                            }
                                        ]
                                    }
                                ]
                            }
