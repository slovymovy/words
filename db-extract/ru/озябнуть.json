                ],
                "senses": [
                    {
                        "sense_id": "afd1cdfb-fc07-30e4-8ba4-3225696ce9fb",
                        "entry_id": "70b55196-35da-3cca-b086-5fb442bf8ec7",
                        "glosses": [
                            "to be cold, to freeze, to feel cold"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "528fac5f-7773-49cd-9989-a7cb4884cc88",
                                "sense_id": "afd1cdfb-fc07-30e4-8ba4-3225696ce9fb",
                                "text": "Настрое́ние ду́ха во всех нас значи́тельно пони́зилось, — осо́бенно в Ро́ське, кото́рая озя́бла и пла́кала.",
                                "translation": "Our spirits sank considerably—especially in Roska, who was cold and wept.",
                                "english": "Our spirits sank considerably—especially in Roska, who was cold and wept."
                            },
                            {
                                "example_id": "301f9f08-99fc-4b9a-b442-d0bb76a14de7",
                                "sense_id": "afd1cdfb-fc07-30e4-8ba4-3225696ce9fb",
                                "text": "В по́гребе просиде́л он день, пото́м ночь и друго́й день, си́льно озя́б и, дожда́вшись потёмок, тайко́м, как вор, пробра́лся к себе́ в ко́мнату.",
                                "translation": "He sat in the cellar all day and then all night, then another day, was fearfully cold, and waiting till dusk, stole secretly like a thief back to his room.",
                                "english": "He sat in the cellar all day and then all night, then another day, was fearfully cold, and waiting till dusk, stole secretly like a thief back to his room."
                            }
                        ]
                    }
                ],
