                },
                {
                    "sense_id": "091d07a8-01fb-3047-a5dd-311de6ee0540",
                    "sense_definition": "een openstaand bedrag of een schuld volledig vereffenen of betalen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "financieel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het bedrijf kon pas na maanden de openstaande factuur definitief <w>solderen</w>.",
                            "target_lang_translations": {
