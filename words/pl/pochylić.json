{
    "word_family": [
        "pochyły",
        "pochylenie",
        "pochylnia",
        "pochylony"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1e0af411-3d00-3f5d-9a96-ffaa76de6db5",
                    "sense_definition": "zmienić położenie czegoś tak, aby nie było w pionie, lecz pod kątem",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zmiana_położenia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musisz <w>pochylić</w> głowę, żeby przejść przez te niskie drzwi.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>наклонить</w> голову, чтобы пройти через эту низкую дверь."
                            }
                        },
                        {
                            "text": "Wiatr <w>pochylił</w> młode drzewa w stronę rzeki.",
                            "target_lang_translations": {
                                "ru": "Ветер <w>наклонил</w> молодые деревья в сторону реки."
                            }
                        }
                    ],
                    "synonyms": [
                        "skłonić",
                        "przechylić"
                    ],
                    "antonyms": [
                        "wyprostować"
                    ],
                    "common_phrases": [
                        "pochylić głowę",
                        "pochylić drzewo"
                    ],
                    "target_lang_definitions": {
                        "ru": "изменить положение предмета так, чтобы он находился не вертикально, а под углом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклонить",
                                "target_lang_sense_clarification": "изменить наклон предмета или части тела"
                            },
                            {
                                "target_lang_word": "склонить",
                                "target_lang_sense_clarification": "опустить вниз (часто о голове)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a6ccb94-bace-33ac-a366-eb52447f8b09",
                    "sense_definition": "zmienić własną postawę, zginając ciało w dół lub w bok",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zmiana_położenia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziewczyna <w>pochyliła</w> się, aby podnieść upuszczony klucz.",
                            "target_lang_translations": {
                                "ru": "Девушка <w>наклонилась</w>, чтобы поднять упавший ключ."
                            }
                        },
                        {
                            "text": "Kiedy <w>pochylił</w> się nad mapą, zauważył błąd w obliczeniach.",
                            "target_lang_translations": {
                                "ru": "Когда он <w>склонился</w> над картой, он заметил ошибку в расчетах."
                            }
                        }
                    ],
                    "synonyms": [
                        "schylić się",
                        "skłonić się"
                    ],
                    "antonyms": [
                        "wyprostować się"
                    ],
                    "common_phrases": [
                        "pochylić się nad",
                        "pochylić się nisko"
                    ],
                    "target_lang_definitions": {
                        "ru": "изменить собственную позу, согнув тело вниз или в сторону"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклониться",
                                "target_lang_sense_clarification": "изменить положение тела, согнувшись"
                            },
                            {
                                "target_lang_word": "склониться",
                                "target_lang_sense_clarification": "низко опустить корпус или голову над чем-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}