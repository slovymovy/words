                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02c9f91f-b085-482f-9e18-2f57db5ba6b3",
                                "sense_id": "d4102dba-2f4d-3c09-910a-15861b769847",
                                "text": "Bowne, Metaphysics, 106 —“ In the system, the complete ground of an event never lies in any one thing, but only in a complex of things. If a single thing were the sufficient ground of an effect, the effect would coëxist with the thing, and all effects would be instantaneously given. Hence all events in the system must be viewed as the result of the interaction of two or more things.”"
                            },
                            {
                                "example_id": "458dec1f-8724-4907-b14c-74caebff9010",
                                "sense_id": "d4102dba-2f4d-3c09-910a-15861b769847",
                                "text": "Location of coëxisting coacervates and equilibrium liquid in the cells."
                            },
                            {
                                "example_id": "4830449d-f6f7-4bd4-941f-f2b9c6db9c9b",
                                "sense_id": "d4102dba-2f4d-3c09-910a-15861b769847",
                                "text": "Is there really a difference in practice between enchantment and magic, between the production of an artistic “Secondary World” and a work whose purpose is also “alteration in the Primary World”? It would seem that in reality these two can coëxist in a single work."
                            }
                        ]
                    }
