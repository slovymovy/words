                ],
                "senses": [
                    {
                        "sense_id": "57fb2340-2e35-3cdc-ba6a-4afded3f1b67",
                        "entry_id": "30695df6-95a6-367d-b91b-da436ddd9bf9",
                        "glosses": [
                            "Action d’arracher, séparation chirurgicale d’une partie d’un corps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1efd370d-ba33-4e3c-8deb-0eecb6a5c60c",
                                "sense_id": "57fb2340-2e35-3cdc-ba6a-4afded3f1b67",
                                "text": "Le crapaud a la vie très dure. Il survit plusieurs heures à la décapitation, plusieurs jours à l’avulsion du cœur, quarante jours à l’ablation des poumons, plusieurs semaines à l’amputation du museau en arrière des yeux."
                            },
                            {
                                "example_id": "2b1a0c81-78b2-41d7-93fa-c57072814c8b",
                                "sense_id": "57fb2340-2e35-3cdc-ba6a-4afded3f1b67",
                                "text": "Si l’avulsion concerne une dent temporaire affectée par une lésion carieuse associée à une fistule, il n’y a pas d’urgence « médicale » véritable."
                            },
                            {
                                "example_id": "67a9aa42-07fc-468f-a6d3-391d8b653156",
                                "sense_id": "57fb2340-2e35-3cdc-ba6a-4afded3f1b67",
                                "text": "La méthode conventionnelle d’une avulsion dentaire consiste en la luxation de la dent et donc l’élargissement de l’alvéole, ce qui peut parfois occasionner la fracture des tables alvéolaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "43702317-5f32-3951-ad7e-fe4a54675308",
                        "entry_id": "30695df6-95a6-367d-b91b-da436ddd9bf9",
                        "glosses": [
                            "Arrachement d’une partie de la rive d’un cours d’eau."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "26ba385e-a0c6-38b7-a581-2d0e7d439ca1",
