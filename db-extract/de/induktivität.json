                        "form": "den Induktivitäten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "70c41489-c39d-3082-a9a9-da1cb4769bcc",
                        "entry_id": "9e420ac5-c1b5-3c1f-9677-35aabc3ffd4e",
                        "glosses": [
                            "Inductance, propriété d’un circuit ou d'un composant à générer une tension à partir d'une variation du courant électrique qui le traverse."
                        ],
                        "tags": [
                            "Électrotechnique"
                        ],
                        "examples": [
                            {
                                "example_id": "f30b3f39-f5d0-4527-a97f-595a8d216c2f",
                                "sense_id": "70c41489-c39d-3082-a9a9-da1cb4769bcc",
                                "text": "Der Physiker Emil Lenz hat massgeblich zum Verständnis der Induktivität beigetragen.",
                                "translation": "Le physicien Emil Lenz a contribué de manière décisive à la compréhension de l'inductance."
                            }
                        ]
                    },
                    {
                        "sense_id": "1cc8ebce-5131-3d6c-8e7e-15b5eff6dba2",
                        "entry_id": "9e420ac5-c1b5-3c1f-9677-35aabc3ffd4e",
                        "glosses": [
                            "Inductance, composant passif ayant un comportement inductif."
                        ],
                        "tags": [
                            "Électrotechnique"
                        ],
                        "examples": [
                            {
                                "example_id": "ef6a5524-88df-41b7-8db2-99fa280938cc",
                                "sense_id": "1cc8ebce-5131-3d6c-8e7e-15b5eff6dba2",
                                "text": "In einem einfachen getakteten Spannungswandler dient eine Induktivität als Energiespeicher während des Zyklus.",
                                "translation": "Dans un convertisseur de tension à découpage simple, une inductance sert de réserve d'énergie pendant le cycle."
                            },
                            {
                                "example_id": "0c3ecd5f-0908-4523-b9a8-9d5215ec51fa",
                                "sense_id": "1cc8ebce-5131-3d6c-8e7e-15b5eff6dba2",
                                "text": "Inzwischen sind kompakte oberflächenmontierte Induktivitäten erhältlich.",
                                "translation": "Entre temps, des inductances à montage en surface compactes sont disponibles."
                            }
                        ]
                    }
                ],
