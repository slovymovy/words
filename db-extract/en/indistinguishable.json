                "senses": [
                    {
                        "sense_id": "6077d070-3c21-3164-ac9b-ce30360555b4",
                        "entry_id": "cfed8093-9705-3fa3-aa6c-5b5558e62f88",
                        "glosses": [
                            "Not distinguishable; not capable of being perceived, known, or discriminated as separate and distinct"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d49be8c-9b14-493e-adb9-2533d265edbc",
                                "sense_id": "6077d070-3c21-3164-ac9b-ce30360555b4",
                                "text": "The banks of the old railway are now so thickly overgrown with trees as to be almost indistinguishable from the surrounding countryside, and the most obvious landmarks are the walls of a bridge over a lane, and stone bridge, still intact, where a cart road crosses the cutting, close to the site of the former Clifton South Junction."
                            },
                            {
                                "example_id": "be208798-847a-4d6d-8b95-a8a5c1532886",
                                "sense_id": "6077d070-3c21-3164-ac9b-ce30360555b4",
                                "text": "Any sufficiently advanced technology is indistinguishable from magic"
                            }
                        ]
                    },
                    {
                        "sense_id": "53b70c27-4d45-3f85-8fdc-154dedd27abb",
                        "entry_id": "cfed8093-9705-3fa3-aa6c-5b5558e62f88",
                        "glosses": [
                            "Not capable of being perceived or known."
                        ],
                        "tags": [],
                        "examples": []
                    }
