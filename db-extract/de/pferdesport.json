                    {
                        "sense_id": "0fad0360-1eab-3843-963a-4c28d6ad6139",
                        "entry_id": "974fb55b-972c-3cbc-9165-bda14bb75eab",
                        "glosses": [
                            "Gesamtheit aller Sportarten, bei denen Mensch und Pferd als Partner zusammenarbeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b1522c3-79de-4fb7-8268-f7993d660d69",
                                "sense_id": "0fad0360-1eab-3843-963a-4c28d6ad6139",
                                "text": "Der Pferdesport erfreut sich anhaltender Beliebtheit."
                            },
                            {
                                "example_id": "cdbf371c-d4ec-4eb4-bbb3-941396a28019",
                                "sense_id": "0fad0360-1eab-3843-963a-4c28d6ad6139",
                                "text": "„Die Geschichte des Pferdesports in Hongkong ist auch eine Geschichte des Kolonialismus.“"
                            },
                            {
                                "example_id": "2f01167b-8ab7-4a83-a645-69ef524a30d6",
                                "sense_id": "0fad0360-1eab-3843-963a-4c28d6ad6139",
                                "text": "„Am 20. August bat Thomas Lieven den Oberst um Verständnis dafür, daß er nach allen Anstrengungen trotz der angespannten Weltlage mit Mimi zur Erholung nach Chantilly fahren wolle, dem Zentrum des Pferdesports und Ausflugsort der Pariser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
