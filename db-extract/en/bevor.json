                                                "sense_id": "51e9fb6d-a617-3068-90ac-8b9dc7619c55",
                                                "text": "Unsere neue Lehrerin heißt Frau Bart."
                                            },
                                            {
                                                "example_id": "b5f320c1-0e15-4818-997d-e66e4ffdd2bf",
                                                "sense_id": "51e9fb6d-a617-3068-90ac-8b9dc7619c55",
                                                "text": "„»Was ist das für Schießen, Herr Bart?« fragte er in ängstlicher Spannung, »werden wir angegriffen?«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
