                "entry_id": "e41a91be-76a2-3973-a899-ae870d6083fe",
                "word": "abysm",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "73f0b891-6854-4a98-aa86-d126084e3afb",
                        "entry_id": "e41a91be-76a2-3973-a899-ae870d6083fe",
                        "tags": [
                            "plural"
                        ],
                        "form": "abysms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8a680b01-8872-3d4b-b01e-e77e368bfb0b",
                        "entry_id": "e41a91be-76a2-3973-a899-ae870d6083fe",
                        "glosses": [
                            "Hell; the infernal pit; the great deep; the primal chaos."
                        ],
                        "tags": [
                            "archaic",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "08e20f88-f734-416b-afe1-68357c4eec7a",
                                "sense_id": "8a680b01-8872-3d4b-b01e-e77e368bfb0b",
                                "text": "Orkney is an archipelago of 70 or so islands lying off the northeast tip of Scotland. “Everywhere in Orkney there is the sense of age, the dark backward and abysm,” the late Orcadian poet George Mackay Brown wrote. “The islands have been inhabited for a very long time, from before the day of the plough.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "b41dc460-46f4-3245-823a-b30718249b4f",
                        "entry_id": "e41a91be-76a2-3973-a899-ae870d6083fe",
                        "glosses": [
                            "An abyss; a gulf, a chasm, a very deep hole."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "b23bdf97-f4b1-451a-813e-d7afb2315ad1",
                                "sense_id": "b41dc460-46f4-3245-823a-b30718249b4f",
                                "text": "The abysm of hell."
                            },
                            {
                                "example_id": "5098fa61-82ac-49c5-b97e-f15a86b682d0",
                                "sense_id": "b41dc460-46f4-3245-823a-b30718249b4f",
                                "text": "Dr. Prunesquallor had circled around Steerpike with his head drawn back so that his cervical vertebrae rested against the near wall of his high collar, and a plumbless abysm yawned between his Adam’s apple and his pearl stud."
                            },
                            {
                                "example_id": "e990b674-93ea-4c67-bf28-c2edce771afc",
                                "sense_id": "b41dc460-46f4-3245-823a-b30718249b4f",
                                "text": "[T]he Shakespearean sonnet doesn't lend itself to a sequential narrative, because the rhymed couplet, without its paired feet trembling at that abysm of time, has to settle instead for the sound of sighing resolution, at regular intervals, over and over, before taking a deep breath and returning usually, for better or worse, to the same subject."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
