                "senses": [
                    {
                        "sense_id": "7f6e4ead-7b1a-3487-87fd-e74a3833d623",
                        "entry_id": "bd7bf71a-353b-3712-a194-088c552657bb",
                        "glosses": [
                            "groene delen van een plant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "425d07e8-ebec-4629-86b1-097162c6930c",
                                "sense_id": "7f6e4ead-7b1a-3487-87fd-e74a3833d623",
                                "text": "Maar de buren zijn Grieken die vele jaren in de VS hebben gewoond, en dus geleerd hebben het heft zelf in handen te nemen. Aan de rand van het veldje, aan de overkant van de straat tegenover hun huis, hebben ze twee jaar geleden een boompje geplant. Eén stam, twee stutten en wat groensel vanboven."
                            }
                        ]
                    },
                    {
                        "sense_id": "02fa77c3-5889-3463-adc1-ad481f613e36",
                        "entry_id": "bd7bf71a-353b-3712-a194-088c552657bb",
                        "glosses": [
                            "groene delen van planten gebruikt als voedsel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dab5a17-aefd-4642-baa7-ddcd81a6e4b9",
                                "sense_id": "02fa77c3-5889-3463-adc1-ad481f613e36",
                                "text": "Hedwig lette op het eten, gestoofd groensel met aardappelen, de pot stond op 't fornuis."
                            },
                            {
                                "example_id": "225adbe2-994a-415e-9e14-c98ae39cfc19",
                                "sense_id": "02fa77c3-5889-3463-adc1-ad481f613e36",
                                "text": "In het begin afzonderlijke, daarna tot groepen aaneengesloten, vegetariërs trachtten, zelfs bij het verkwijnen van dergelijke onder de vergankelijke mode der zedeleer staande perioden, hun groensel trouw te blijven."
                            }
                        ]
                    }
                ],
