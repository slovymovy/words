                "senses": [
                    {
                        "sense_id": "f8fa759f-a1b0-3252-aa32-f482d51f88d6",
                        "entry_id": "8d659c05-fd3c-3acd-a887-26dfe61b7167",
                        "glosses": [
                            "тот, кто выдумывает, придумывает, изобретает что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e430a0f5-604d-49fb-b5e7-9516b6e06c3f",
                                "sense_id": "f8fa759f-a1b0-3252-aa32-f482d51f88d6",
                                "text": "На это дело пошел и старший брат ― отличный рисовальщик и выдумщик разных трюков."
                            }
                        ]
                    },
                    {
                        "sense_id": "20e41561-e254-3da0-8220-9d737e0d53e6",
                        "entry_id": "8d659c05-fd3c-3acd-a887-26dfe61b7167",
                        "glosses": [
                            "лгун, обманщик"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f31453aa-230e-4af6-94e8-732a0320f224",
                                "sense_id": "20e41561-e254-3da0-8220-9d737e0d53e6",
                                "text": "Я сделаю знак, по которому он, увидя тебя за версту, сейчас догадается, что ты не выдумщик, а именно мною отправленный вестник!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
