                                "target_senses": [
                                    {
                                        "sense_id": "ef480f74-fbef-39de-8c1f-9ac6162a3446",
                                        "entry_id": "7a6f0c84-fa88-3ac8-b0c7-b86b63375856",
                                        "glosses": [
                                            "A device that encodes digital computer signals into analog telephone signals and vice versa, allowing computers to communicate over a phone line."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba0d4d58-ac1b-4bc8-8dfd-51c8736c29fe",
                                                "sense_id": "ef480f74-fbef-39de-8c1f-9ac6162a3446",
                                                "text": "Choose and rent, over PC and modem and fiber-optic line, from tens of thousands of second-run films, documentaries, the occasional sport, old beloved non—‘Happy Days’ programs, wholly new programs, cultural stuff, and c.[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "modem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66c4e5b6-2665-31b7-a791-0f3a4c7e456b",
                                        "entry_id": "ac2cd71e-de55-32af-a83d-85fb26f3dbe8",
                                        "glosses": [
                                            "To transmit by modem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86084be6-6f3b-4f2c-84b8-975aa6abb1bb",
                                                "sense_id": "66c4e5b6-2665-31b7-a791-0f3a4c7e456b",
                                                "text": "“Books” can even be faxed or modemed to you!"
                                            },
                                            {
                                                "example_id": "caf8eefc-9de9-40b5-9c6d-f5dd75ff19f7",
                                                "sense_id": "66c4e5b6-2665-31b7-a791-0f3a4c7e456b",
                                                "text": "Personal modeming is most prevalent in the U.S., where a modem generally doesn't have huge taxes slapped on it, and after-tax income is comparatively high."
                                            },
                                            {
                                                "example_id": "ed2e644b-da52-48bc-af80-20bcc9c3b4dd",
                                                "sense_id": "66c4e5b6-2665-31b7-a791-0f3a4c7e456b",
                                                "text": "He had to modem in to the agency and say that there was an emergency […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2045037-d9e9-4afc-876d-237ca1257764",
                        "source_entry_id": "6104c4b2-6b4f-3dd1-aaea-0f568353ca38",
                        "source_sense_id": "965a1b23-5663-3d16-85f7-981b120cc1f1",
                        "target_lang_word": "módem",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "módem",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "8c1b9f95-5abe-3e79-9aab-37f8a914969e",
                                        "entry_id": "76c64bdc-562c-349e-9088-d06947885b83",
                                        "glosses": [
                                            "Dispositivo que permite la comunicación entre dos ordenadores usando una línea telefónica. Al ser el ordenador un sistema digital y las líneas telefónicas convencionales analógicas, en primer lugar el módem del ordenador que envía la información ha de convertir en analógicas las señales digitales (modulación), para que sean transmitidas por la línea telefónica hasta el ordenador de destino, cuyo módem deberá reconvertirlas en digitales (demodulación)."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d209f700-8795-4735-bd8d-ce1eb9025f82",
                        "source_entry_id": "6104c4b2-6b4f-3dd1-aaea-0f568353ca38",
                        "source_sense_id": "965a1b23-5663-3d16-85f7-981b120cc1f1",
                        "target_lang_word": "Modem",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Modem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2ca5dbc-7cac-37ee-855b-6a1dce8ffad6",
                                        "entry_id": "165e6cf4-bb1a-3ad5-9357-9518f025bedb",
                                        "glosses": [
                                            "Apparat zum Übertragen (Senden und Empfangen) digitaler Daten durch analoge Signale (häufig über Telefonleitungen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "235dc564-cea5-4256-857f-2dc0d4fc87e3",
                                                "sense_id": "c2ca5dbc-7cac-37ee-855b-6a1dce8ffad6",
                                                "text": "Bei meiner ersten Internetverbindung habe ich noch ein 28k Modem benutzt; heute sind 56k üblich."
                                            },
                                            {
                                                "example_id": "7500f31e-fc29-4823-baa6-704a1855da43",
                                                "sense_id": "c2ca5dbc-7cac-37ee-855b-6a1dce8ffad6",
                                                "text": "Für Faxverbindungen der üblichen Gruppe 3 genügt ein Modem mit 9600 oder 14.400 Bit pro Sekunde."
                                            },
                                            {
                                                "example_id": "6661910a-8f0e-4fcd-b9b4-89e65da44383",
                                                "sense_id": "c2ca5dbc-7cac-37ee-855b-6a1dce8ffad6",
                                                "text": "„Um Forschung in einem Feld zu betreiben, in dem eine neue Sparte der Erzählkultur im Entstehen begriffen ist, braucht man heute seine Wohnung nicht mehr zu verlassen, die benötigten Daten werden bequem und kostenlos per Modem oder Breitbandkabelanschluss in den eigenen Rechner geliefert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0d6af383-0037-3d13-be8f-1ffcfe082371",
                                        "entry_id": "165e6cf4-bb1a-3ad5-9357-9518f025bedb",
                                        "glosses": [
                                            "Wandler (Umsetzer, Konverter) zwischen digitalen Protokollen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb04efc7-0100-4226-8064-c6ae981fdfb3",
                                                "sense_id": "0d6af383-0037-3d13-be8f-1ffcfe082371",
                                                "text": "Ein DSL-Modem wandelt zwischen den digitalen Protokollen DSL für den Ferntransport und Ethernet fürs lokale Datennetz (LAN)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
