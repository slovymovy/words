                    "sense_id": "80acb685-8272-3da5-b884-c56cc04fc07d",
                    "sense_definition": "Pijnlijk getroffen in gevoelens of eer; beledigd.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze voelde zich diep <gekwetst> door zijn harde woorden.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя глубоко <w>оскорбленной</w> его резкими словами.",
                                "en": "She felt deeply <w>hurt</w> by his harsh words.",
                                "fr": "Elle s'est sentie profondément <w>blessée</w> par ses mots durs."
                            }
                        },
                        {
                            "text": "De <gekwetste> man weigerde nog met ons te praten na het incident.",
                            "target_lang_translations": {
                                "ru": "<w>Обиженный</w> мужчина отказался разговаривать с нами после инцидента.",
                                "en": "The <w>offended</w> man refused to talk to us after the incident.",
                                "fr": "L'homme <w>blessé</w> a refusé de nous parler après l'incident."
                            }
                        }
                    ],
                    "synonyms": [
                        "beledigd",
                        "gekrenkt",
                        "geraakt"
                    ],
                    "common_phrases": [
                        "zich gekwetst voelen",
                        "diep gekwetst",
                        "gekwetste trots"
                    ],
                    "target_lang_definitions": {
