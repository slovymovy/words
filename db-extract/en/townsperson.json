                                        "entry_id": "9838ccf7-fcf3-3f19-b2c6-68a898bce732",
                                        "glosses": [
                                            "Person, die in einer Stadt lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f4f59ad-0c26-46ad-a054-7c2d58237485",
                                                "sense_id": "cedceda8-319d-3b65-b0f4-77b5f13f0219",
                                                "text": "Mein Kollege hieß Stetter und war Städter."
                                            },
                                            {
                                                "example_id": "d83ba071-970e-4af0-ab37-5e41a820c0e1",
                                                "sense_id": "cedceda8-319d-3b65-b0f4-77b5f13f0219",
                                                "text": "„Die Städter ackerten und asteten, bis sie in der grimmigen Kälte völlig durchgeschwitzt waren.“"
                                            },
                                            {
                                                "example_id": "a6e2dcbc-f2a5-4dfe-94e7-7e106b492301",
                                                "sense_id": "cedceda8-319d-3b65-b0f4-77b5f13f0219",
                                                "text": "„Ich bin nicht auf Landarbeit versessen, ich bin durch und durch Städter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
