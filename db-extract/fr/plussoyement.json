                        "examples": [
                            {
                                "example_id": "c64d3704-47e5-43f9-8464-4e795c4500ac",
                                "sense_id": "316c95b4-0218-3a65-92d7-cb2b164452e0",
                                "text": "Plussoyement intempérant!\nIl souffre de quelques défauts (toucher des potars déplorable, comme sur le P600 d'ailleurs, et un clavier Panasonic absolument désolant), mais c'est vraiment, tant du point de vue sonore qu'ergonomique ou puissance de synthèse, un instrument épatant!"
                            },
                            {
                                "example_id": "aa8b02c8-b043-4d81-81cf-837d87c03a6f",
                                "sense_id": "316c95b4-0218-3a65-92d7-cb2b164452e0",
                                "text": "Cela n'ai aucunement un troll. Et donc ton dépôt facile en quête de \"plussoyement\" est de facto déplacé et purement rétrograde.\nD'autant plus que le débat amené par cette publication à été fort intéressante à parcourir."
                            },
                            {
                                "example_id": "610b1aaf-3ec0-47c8-8f7b-665194abe712",
                                "sense_id": "316c95b4-0218-3a65-92d7-cb2b164452e0",
                                "text": "Magnifique, un plussoyement."
                            }
                        ]
                    }
