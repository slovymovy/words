                    {
                        "sense_id": "f4b7feb3-fd28-31ff-a0e0-fbc76d107f23",
                        "entry_id": "e6e3edcb-1e64-39b4-8cd1-638589c5d503",
                        "glosses": [
                            "tas die men naar school neemt voor schoolbenodigdheden en vaak ook eten en drinken voor de pauzes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fe9bdce-e3b5-4364-9cb5-d14ece7f5e6e",
                                "sense_id": "f4b7feb3-fd28-31ff-a0e0-fbc76d107f23",
                                "text": "Tegenwoordig gebruikt men vooral een rugtas als schooltas"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20f60cc5-14cf-4b65-985e-d2991fce0fd8",
                        "source_entry_id": "e6e3edcb-1e64-39b4-8cd1-638589c5d503",
                        "source_sense_id": "f4b7feb3-fd28-31ff-a0e0-fbc76d107f23",
                        "target_lang_word": "Schulranzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schulranzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d505b69f-c56c-32b5-8ec7-2667f63ff5b2",
                                        "entry_id": "d021d26a-0acc-324d-b087-1dd80caab974",
                                        "glosses": [
                                            "auf dem Rücken getragene Tasche für den Transport von Schulmaterialien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5032f4e8-f6e6-4a4f-a1d4-d7001edb2db3",
                                                "sense_id": "d505b69f-c56c-32b5-8ec7-2667f63ff5b2",
                                                "text": "Der Junge braucht einen neuen Schulranzen."
                                            },
                                            {
                                                "example_id": "1b95883a-d0c6-44a1-824c-6ea19f2ab126",
                                                "sense_id": "d505b69f-c56c-32b5-8ec7-2667f63ff5b2",
                                                "text": "„Ihre Schulranzen haben sie neben den Hauseingang geschleudert.“"
                                            },
                                            {
                                                "example_id": "58840bee-2acb-4acf-9efc-286af275c2e9",
                                                "sense_id": "d505b69f-c56c-32b5-8ec7-2667f63ff5b2",
                                                "text": "„Er hatte seinen Schulranzen in der Hand und ich meine Schippe.“"
                                            },
                                            {
                                                "example_id": "b715576d-feba-4be0-9931-679d5cc7769d",
                                                "sense_id": "d505b69f-c56c-32b5-8ec7-2667f63ff5b2",
                                                "text": "„Einige hatten sogar den Schulranzen auf dem Rücken umgeschnallt, andere bewahrten ein Spielzeug fest unter den Arm geklemmt, eine Puppe, einen Reifen oder ein kleines Schiff.“"
                                            },
                                            {
                                                "example_id": "991d0622-c5df-4244-ae32-642eb50ff269",
                                                "sense_id": "d505b69f-c56c-32b5-8ec7-2667f63ff5b2",
                                                "text": "„Amalia legte die Bücher morgens auf meinen Platz am Küchentisch oder schob sie in meinen Schulranzen oder ließ einen Stapel auf meinem Bett liegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25f65d81-c03b-40fc-8824-9ac133c21fbc",
                        "source_entry_id": "e6e3edcb-1e64-39b4-8cd1-638589c5d503",
                        "source_sense_id": "f4b7feb3-fd28-31ff-a0e0-fbc76d107f23",
                        "target_lang_word": "Schulmappe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schulmappe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7423137d-8dcf-3b1c-bb2f-01a955cc1570",
                                        "entry_id": "a0d6f69b-326c-3c63-a934-442cd1472807",
                                        "glosses": [
                                            "Mappe für Schulsachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83cf519c-ecd0-4ace-97f9-af85ef807807",
                                                "sense_id": "7423137d-8dcf-3b1c-bb2f-01a955cc1570",
                                                "text": "„Ich sah den kleinen Jungen von links die Straße heraufkommen, auf den Bahnhofsplatz zu, er war klatschnaß und hielt im strömenden Regen seine Schulmappe offen vor sich hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c909e6f-94d1-4466-81a8-ef6043db0d62",
                        "source_entry_id": "e6e3edcb-1e64-39b4-8cd1-638589c5d503",
                        "source_sense_id": "f4b7feb3-fd28-31ff-a0e0-fbc76d107f23",
                        "target_lang_word": "Schultasche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schultasche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14ac7834-218d-391b-913a-4050504f5ad9",
                                        "entry_id": "c58b53c3-eeba-37c4-99e0-31673aef2b93",
                                        "glosses": [
                                            "Tasche zum Transport von Schulsachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7baacbcc-3712-4c07-bfca-72cf8940971b",
                                                "sense_id": "14ac7834-218d-391b-913a-4050504f5ad9",
                                                "text": "Er nahm seine Schultasche und ging aus dem Haus."
                                            },
                                            {
                                                "example_id": "ba798aca-c672-4581-a4e2-db51223b9b9a",
                                                "sense_id": "14ac7834-218d-391b-913a-4050504f5ad9",
                                                "text": "„Er nahm die Schultasche unter den Arm und hinkte ein wenig mühselig die Treppe hinunter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
