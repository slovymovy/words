        "fr-extract.jsonl": [
            {
                "entry_id": "1a4a0334-bb62-3e99-9476-51bd00601654",
                "word": "bégonia",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7905f485-f8ce-44f6-85f0-953c40ebcd3a",
                        "entry_id": "1a4a0334-bb62-3e99-9476-51bd00601654",
                        "tags": [
                            "plural"
                        ],
                        "form": "bégonias"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cfc1a247-8d8c-3149-9f21-5937712859c7",
                        "entry_id": "1a4a0334-bb62-3e99-9476-51bd00601654",
                        "glosses": [
                            "Plante herbacée dont le genre Begonia est composé de plus de 900 espèces, originaires essentiellement de l’Amérique tropicale, et cultivées dans les jardins comme plantes d’agrément pour la variété et la grâce de leur feuillage et de leurs fleurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd70e478-be0a-4899-b0e4-13f0414443b4",
                                "sense_id": "cfc1a247-8d8c-3149-9f21-5937712859c7",
                                "text": "Tels les bégonias, dont on fait, dans les jardins, aujourd’hui, un si douloureux étalage. Au point que toute autre fleur en est exilée, et que toute la flore semble se restreindre à cette stupide plante, dont on dirait que les pétales sont découpés à l’emporte-pièce, dans quelque indigeste navet."
                            },
                            {
                                "example_id": "97cef08f-4da9-44d7-a751-d0bd20064775",
                                "sense_id": "cfc1a247-8d8c-3149-9f21-5937712859c7",
                                "text": "Il y a des jours où la boucherie de Léonore, ses couteaux, sa hachette, ses poumons de bœuf gonflés que le courant d’air irise et balance, roses comme la pulpe du bégonia, me plaisent à l’égal d’une confiserie."
                            },
                            {
                                "example_id": "20c0b888-c60e-46a9-b7a3-df1c9e12af92",
                                "sense_id": "cfc1a247-8d8c-3149-9f21-5937712859c7",
                                "text": "Des bégonias rose thé étaient massés sous la fenêtre de la façade et des pensées formaient un tapis circulaire au pied d'un acacia."
                            },
                            {
                                "example_id": "a6ea28c5-3924-46e7-bc3d-714bbb9c942d",
                                "sense_id": "cfc1a247-8d8c-3149-9f21-5937712859c7",
                                "text": "Lundi 29 juillet 40.– Les jardins du Centre laïque sont raides et sans grâce, comme ceux des mairies. Les massifs sont bordés de buis, pas un arbre digne de ce nom ; quelques arbustes prétentieux et des bégonias, cette fleur de la République."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f47f9d14-3c38-4b50-a2b5-461ec6a9d937",
                        "source_entry_id": "1a4a0334-bb62-3e99-9476-51bd00601654",
                        "source_sense_id": "cfc1a247-8d8c-3149-9f21-5937712859c7",
                        "target_lang_word": "Begonie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Begonie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a5c5fae4-a5f6-333c-913d-8c7831260d36",
                                        "entry_id": "5d0f1765-f654-38eb-80d1-d89b1cb33db9",
                                        "glosses": [
                                            "Zierpflanze (Begonia) aus der Familie der Schiefblattgewächse (Begoniaceae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "256ae1ac-903b-4c27-b18f-8654d2f550f1",
                                                "sense_id": "a5c5fae4-a5f6-333c-913d-8c7831260d36",
                                                "text": "Die Begonie ist eine ideale Balkonpflanze."
                                            },
                                            {
                                                "example_id": "c4ae5edd-4a4a-491e-8640-5181c6db269c",
                                                "sense_id": "a5c5fae4-a5f6-333c-913d-8c7831260d36",
                                                "text": "Ursprünglich kommt die Begonie aus dem tropischen Regenwald."
                                            },
                                            {
                                                "example_id": "f2e9c153-a473-48b3-b683-812af85b8ab1",
                                                "sense_id": "a5c5fae4-a5f6-333c-913d-8c7831260d36",
                                                "text": "„Ihre Augen füllten sich mit den leuchtenden Farben der üppig blühenden Petunien, Begonien und Rosen.“"
                                            },
                                            {
                                                "example_id": "e50db18b-2d81-458c-b4be-4ad0cb253ab6",
                                                "sense_id": "a5c5fae4-a5f6-333c-913d-8c7831260d36",
                                                "text": "„Auf dem Grab waren Begonien gepflanzt, langweilige Blumen, die Dürre und heftigen Regen vertragen konnten und die auf dem halben Friedhof verbreitet waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec2f4321-edfc-4647-b040-58c8b51233f2",
