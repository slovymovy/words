                    },
                    {
                        "translation_id": "ad7d5597-3438-445b-b68e-43b772c2317d",
                        "source_entry_id": "5a4e5939-d07d-3c14-ac13-b42cdd239cbe",
                        "source_sense_id": "0fd0ae78-a739-3821-aa5a-785132787265",
                        "target_lang_word": "Betrügerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betrügerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50478878-9fdd-33a9-988e-d136ec4ec3ce",
                                        "entry_id": "6bffc13e-7bfe-35fe-a997-9686ebde0f97",
                                        "glosses": [
                                            "weiblicher Betrüger"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e1cad21-e02e-4758-baea-b6b55a61d4df",
                                                "sense_id": "50478878-9fdd-33a9-988e-d136ec4ec3ce",
                                                "text": "Du solltest ihr nicht trauen, dieser Betrügerin!"
                                            },
                                            {
                                                "example_id": "e1fa5fc4-e952-4eaa-82b2-627007b32f9d",
                                                "sense_id": "50478878-9fdd-33a9-988e-d136ec4ec3ce",
                                                "text": "„Am 5. April 2001 erhob der Bezirksanwalt Anklage, nannte Christina Maria Kurmann aus Adliswil eine Urkundenfälscherin und Betrügerin.“"
                                            },
                                            {
                                                "example_id": "684aae1f-6f34-48fd-a58e-4bfcef887d35",
                                                "sense_id": "50478878-9fdd-33a9-988e-d136ec4ec3ce",
                                                "text": "„Da ich etwas unternehmen mußte, um die Absichten der beiden Betrügerinnen zu vereiteln, verließ ich sie wortlos und schloß mich mit Madame d'Urfé ein, um das Orakel über die Operation zu befragen, die zu ihrem Glück führen sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "627de6f6-1451-4520-8879-571305007900",
                        "source_entry_id": "5a4e5939-d07d-3c14-ac13-b42cdd239cbe",
                        "source_sense_id": "0fd0ae78-a739-3821-aa5a-785132787265",
                        "target_lang_word": "Lügnerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lügnerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "09ebfdd7-2d1e-3de7-8139-60023df467a5",
                                        "entry_id": "13795923-76b8-390c-92c0-648672ae30db",
                                        "glosses": [
                                            "eine, die lügt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71ae953b-e4f5-4634-8d45-96dab0c5a124",
                                                "sense_id": "09ebfdd7-2d1e-3de7-8139-60023df467a5",
                                                "text": "Sie war schon immer eine große Lügnerin."
                                            },
                                            {
                                                "example_id": "ad979af3-1a70-4efc-9374-54e8bdf90645",
                                                "sense_id": "09ebfdd7-2d1e-3de7-8139-60023df467a5",
                                                "text": "„Als notorische Diebin stiehlt sie die Uhr des Erzählers, als ebenso notorische Lügnerin gibt sie sich Don José gegenüber als Baskin aus.“"
                                            },
                                            {
                                                "example_id": "7d65e869-1471-419d-805d-7d1343e1b5c1",
                                                "sense_id": "09ebfdd7-2d1e-3de7-8139-60023df467a5",
                                                "text": "„Aber da brachte mich Irene zum Lachen, indem sie in gefühlvollem Ton zu mir sagte, ich dürfe nicht meinen, daß ihre Eltern sie für eine Lügnerin gehalten hätten.“"
                                            },
                                            {
                                                "example_id": "5c4fb193-8049-49d9-8f68-23a8cf168051",
                                                "sense_id": "09ebfdd7-2d1e-3de7-8139-60023df467a5",
                                                "text": "„Sie war eine lausige Lügnerin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "30795bb5-3f39-3191-afb3-d91e5a524145",
                                        "entry_id": "13795923-76b8-390c-92c0-648672ae30db",
                                        "glosses": [
                                            "eine, die häufig lügt oder zur Lüge neigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be9969fb-1971-4819-bf9f-17b366a6e1e2",
                                                "sense_id": "30795bb5-3f39-3191-afb3-d91e5a524145",
                                                "text": "„Dabei ging von ihr das Gerücht, dass sie eine Lügnerin und Diebin sei, eine »salope«, also eine Schlampe, überhaupt eine ganz schreckliche Person, die man möglichst weit von sich fernhalten solle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
