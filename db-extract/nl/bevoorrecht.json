                    {
                        "sense_id": "765319ad-3558-3d43-9bbe-71b6314ddbee",
                        "entry_id": "7c94cb05-9416-3d0b-af3a-abdd6c13259e",
                        "glosses": [
                            "rechten genietend die vele anderen niet bezitten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "301a1dc4-f3e8-44cd-8fe8-3c73359c4a96",
                                "sense_id": "765319ad-3558-3d43-9bbe-71b6314ddbee",
                                "text": "In de middeleeuwen was de adel een bevoorrechte stand."
                            }
                        ]
                    },
                    {
                        "sense_id": "17b9a40d-2231-39d0-93b0-2e2a31471d97",
                        "entry_id": "7c94cb05-9416-3d0b-af3a-abdd6c13259e",
                        "glosses": [
                            "overdrachtelijk: aangename zaken genietend die velen niet bezitten of bezaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90be4c81-afc9-4fed-acd9-c7fcc300d5b2",
                                "sense_id": "17b9a40d-2231-39d0-93b0-2e2a31471d97",
                                "text": "Iemand met haar talenten is een bevoorrecht mens."
                            },
                            {
                                "example_id": "ab19c2b5-4a5e-4609-8497-b4a856d04764",
                                "sense_id": "17b9a40d-2231-39d0-93b0-2e2a31471d97",
                                "text": "De engel van de toekomst was het Pakistaanse meisje Malala, die mij uit mijn bevoorrechte bubbel wakker schudde om meer naar de problemen van andere mensen te kijken."
                            },
                            {
                                "example_id": "40be7b53-385b-492e-94ae-9404249e8762",
                                "sense_id": "17b9a40d-2231-39d0-93b0-2e2a31471d97",
                                "text": "Zelden heeft de wereld zich meer bevoorrecht gevoeld."
                            }
                        ]
                    }
