                "senses": [
                    {
                        "sense_id": "09a01f4a-2e71-3b44-bd2d-2bac32d2aedb",
                        "entry_id": "65230a9b-5411-30c5-a3c0-1792bd6e13e4",
                        "glosses": [
                            "jemand, der in einem Weltcup an der ersten Stelle der Wertung liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0af8508b-a56a-4a18-86e6-962e3892f16f",
                                "sense_id": "09a01f4a-2e71-3b44-bd2d-2bac32d2aedb",
                                "text": "„Österreichs Jakob Schubert ist derzeit Weltcupführender und Ondras größter Herausforderer.“"
                            },
                            {
                                "example_id": "fab8af72-c28c-4c6d-a366-e21c5f2e9bb2",
                                "sense_id": "09a01f4a-2e71-3b44-bd2d-2bac32d2aedb",
                                "text": "„Als Weltcupführender startete der 26-Jährige also in Oberstdorf, zusätzlich beladen mit dem Auftrag, 16 Jahre nach dem Sieg von Sven Hannawald wieder ein deutscher Vierschanzenkönig zu werden.“"
                            },
                            {
                                "example_id": "5e0b6931-3780-425a-97ec-91dc5c9d7b33",
                                "sense_id": "09a01f4a-2e71-3b44-bd2d-2bac32d2aedb",
                                "text": "„Richard Freitag, der im vergangenen Jahr als Weltcupführender an den Start ging und am Ende Zweiter wurde, ist in diesem Jahr überraschend nur Außenseiter.“"
                            },
                            {
                                "example_id": "fd64ceb9-56c1-48a8-bdf9-51c2ccf637a6",
                                "sense_id": "09a01f4a-2e71-3b44-bd2d-2bac32d2aedb",
                                "text": "„Freitag springt so gut wie noch nie, dominiert die Konkurrenz, fährt als Weltcupführender zur Vierschanzentournee – und sucht selbst nach Worten, die seine Zauberflüge erklären.“"
                            },
                            {
                                "example_id": "edae1c17-7a0e-4542-8749-a2ec3ddd9f75",
                                "sense_id": "09a01f4a-2e71-3b44-bd2d-2bac32d2aedb",
                                "text": "„Peter Prevc, unangetasteter Weltcupführender, sagte 2014 gegenüber der Wochenzeitung ‚Die Zeit‘: ‚Er ist eine Inspiration für mich.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
