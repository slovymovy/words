                                "target_senses": [
                                    {
                                        "sense_id": "d0b7d697-d48f-3ff7-a633-cf59a3b2c06e",
                                        "entry_id": "069764b7-84f4-331b-8027-f2f736d94395",
                                        "glosses": [
                                            "A shoeshine boy; a person who shines shoes as an occupation."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1a866ad-586d-4a55-8de1-558dd2c41190",
                                                "sense_id": "d0b7d697-d48f-3ff7-a633-cf59a3b2c06e",
                                                "text": "The young negro bootblack hummed \"The Camp Meeting Blues\" and polished in rhythm to his tune, drawing the shiny shoe-rag so taut at each stroke that it snapped like a banjo string."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bootblack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59bdca0e-eb84-3f3c-8f8b-396e7a599026",
                                        "entry_id": "c3a5012e-05cf-3851-840a-cd6db4f4cc94",
                                        "glosses": [
                                            "To shine shoes."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bddd8f36-27ee-4a13-8f46-e6dc286687bb",
                        "source_entry_id": "d421ee26-c21e-39f3-a065-49d2abe385a3",
                        "source_sense_id": "3fead714-69f1-3561-9c85-0e886434d3f2",
                        "target_lang_word": "Schuhputzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schuhputzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73c646bc-7e51-3044-8068-b294c0db2505",
                                        "entry_id": "5fe82a6e-5bfa-3c5f-a116-6242c57582d5",
                                        "glosses": [
                                            "Person, die auf der Straße Passanten die Schuhe putzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d592cf30-6f1e-4881-8e93-f0b388621b78",
                                                "sense_id": "73c646bc-7e51-3044-8068-b294c0db2505",
                                                "text": "„In der Zeit von 1900 bis in die 1960er Jahre hinein prägte in Europa ein Beruf, den es heute so nicht mehr gibt, das Straßenbild. Der Schuhputzer bot seine Dienste an jeder Straßenecke an. Leider gehören diese Schuhputzer in Europa nicht mehr zum Straßenbild. Ganz anderes in den lateinamerikanischen Ländern wie Mexico, Peru, Bolivien um nur einige hier zu nennen sind die Schuhputzer überall zu finden. Ebenso in der Türkei und in Amerika, speziell in New York.“"
                                            },
                                            {
                                                "example_id": "3d2edbdc-b044-4f0f-b899-90b3b6f03673",
                                                "sense_id": "73c646bc-7e51-3044-8068-b294c0db2505",
                                                "text": "„Im echten Leben ist Negusse Schuhputzer.“"
                                            },
                                            {
                                                "example_id": "d3d799d0-5112-4620-9831-b138878b830e",
                                                "sense_id": "73c646bc-7e51-3044-8068-b294c0db2505",
                                                "text": "„Ich vergaß, die Namen der beiden Lehrjungen, der Maniküren und der Schuhputzer zu erwähnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "163bc484-331c-3a58-9530-93cf185a04f7",
                                        "entry_id": "5fe82a6e-5bfa-3c5f-a116-6242c57582d5",
                                        "glosses": [
                                            "Maschine, mit der man seine Schuhe polieren kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4bf059e-1f6a-44ae-9a44-5957efcd73ed",
                                                "sense_id": "163bc484-331c-3a58-9530-93cf185a04f7",
                                                "text": "„Im Eingang des Hotels bürsteten wir unsere Schuhe an dem elektrischen Schuhputzer ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
