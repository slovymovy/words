                        "cross_references": [
                            {
                                "target_word": "exobiologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54d45472-f089-3ad6-b793-189fe5292faa",
                                        "entry_id": "19c5040b-749d-3d58-9380-4ea2cf2ba13f",
                                        "glosses": [
                                            "Science qui a pour objet l’étude des possibilités d’apparition et d’existence de formes de vie dans l’Univers, y compris sur Terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ddd732f-8018-4981-9365-481610e16c1a",
                                                "sense_id": "54d45472-f089-3ad6-b793-189fe5292faa",
                                                "text": "L’exobiologie se présente comme un ensemble de recherches multidisciplinaires sur les origines de la Vie, son évolution et sa distribution éventuelle dans l’Univers."
                                            },
                                            {
                                                "example_id": "dcb3712c-7f23-4659-ac50-141905dbbb51",
                                                "sense_id": "54d45472-f089-3ad6-b793-189fe5292faa",
                                                "text": "Il se tourna vers Alvare, la jeune femme qui l’accompagnait, responsable scientifique de la mission, spécialiste en exobiologie et terraformation. Une belle femme brune d’ailleurs, qui, les derniers temps du voyage, n’était jamais sortie de sa réserve glaciale, comme si son cerveau et son corps n’étaient pas parvenus à se remettre de la stase cryogénique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d822f6e1-b5f0-4de7-8ac7-e74fe6fb9c3a",
                        "source_entry_id": "ed3562d0-accf-37d4-8873-11388bdc3bd1",
                        "source_sense_id": "c69dc17f-641f-3ba8-99fa-2dba0776c8fb",
