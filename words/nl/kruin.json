{
    "word_family": [
        "kruinen",
        "kruintje",
        "kruinschering"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c385502-5bc3-37e6-8c72-c8a8ba80caeb",
                    "sense_definition": "het bovenste deel van het menselijk hoofd, meestal bedekt met haar",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lichaamsdelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kapper knipte het haar op zijn <w>kruin</w> een stuk korter dan aan de zijkanten.",
                            "target_lang_translations": {
                                "en": "The barber cut the hair on the <w>crown</w> of his head a lot shorter than on the sides."
                            }
                        },
                        {
                            "text": "In sommige kloosterordes hebben de monniken een kruinschering waarbij het haar van de <w>kruin</w> wordt weggeschoren.",
                            "target_lang_translations": {
                                "en": "In some monastic orders, the monks have a tonsure where the hair is shaved off the <w>crown</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "top"
                    ],
                    "common_phrases": [
                        "kale kruin"
                    ],
                    "target_lang_definitions": {
                        "en": "the top part of the human head, usually covered with hair"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crown",
                                "target_lang_sense_clarification": "of the head"
                            },
                            {
                                "target_lang_word": "top of the head",
                                "target_lang_sense_clarification": "anatomical location"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7116aeb8-978c-34b2-ac04-c697f634075b",
                    "sense_definition": "het bovenste gedeelte van een boom waar de takken en bladeren zich bevinden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "natuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wind waaide hard door de <w>kruinen</w> van de hoge eikenbomen in het bos.",
                            "target_lang_translations": {
                                "en": "The wind blew hard through the <w>crowns</w> of the tall oak trees in the forest."
                            }
                        },
                        {
                            "text": "Vanuit het zolderraam kon je de groene <w>kruin</w> van de oude plataan goed zien.",
                            "target_lang_translations": {
                                "en": "From the attic window, you could clearly see the green <w>treetop</w> of the old plane tree."
                            }
                        }
                    ],
                    "synonyms": [
                        "boomtop",
                        "boomkroon"
                    ],
                    "common_phrases": [
                        "groene kruin",
                        "kruin van de boom"
                    ],
                    "target_lang_definitions": {
                        "en": "the upper part of a tree where the branches and leaves are located"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crown",
                                "target_lang_sense_clarification": "of a tree"
                            },
                            {
                                "target_lang_word": "treetop",
                                "target_lang_sense_clarification": "the very top of a tree"
                            },
                            {
                                "target_lang_word": "canopy",
                                "target_lang_sense_clarification": "the upper layer of a forest or tree"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}