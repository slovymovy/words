                "senses": [
                    {
                        "sense_id": "098e79bb-8885-3651-ac6a-5addb3466e47",
                        "entry_id": "57949650-c67b-3e3e-9258-3eeb7f4d0ab9",
                        "glosses": [
                            "Pour un individu, mariage avec une personne de rang social supérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbfff347-43e9-47f7-a73d-354619976810",
                                "sense_id": "098e79bb-8885-3651-ac6a-5addb3466e47",
                                "text": "Garçons comme filles subissent les conséquences de l’hypergamie féminine, c’est-à-dire de la tendance, générale en Europe des filles à épouser un garçon de leur milieu ou d’un milieu supérieur mais non d’un milieu inférieur. Il en résulte un célibat élevé des jeunes garçons au bas de l’échelle sociale et des jeunes filles au haut."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76410712-796c-4312-8206-abf6eec68b76",
                        "source_entry_id": "57949650-c67b-3e3e-9258-3eeb7f4d0ab9",
