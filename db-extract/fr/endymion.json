            {
                "entry_id": "61410b7e-f4a2-3602-9427-dfdd3df53a1c",
                "word": "Endymion",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e3c00199-c5e4-3b01-bb81-657d5f5c18c2",
                        "entry_id": "61410b7e-f4a2-3602-9427-dfdd3df53a1c",
                        "glosses": [
                            "Berger que Zeus fit tomber dans un sommeil éternel."
                        ],
                        "tags": [
                            "Mythologie grecque"
                        ],
                        "examples": [
                            {
                                "example_id": "795a2eaa-d1fc-4998-b1c1-afb464d38794",
                                "sense_id": "e3c00199-c5e4-3b01-bb81-657d5f5c18c2",
                                "text": "À onze heures, quand tout dormira sur la terre, ne craignant plus l’indiscrétion des regards humains, Diane quittera les cieux et descendra vers le berger Endymion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "162865f4-acde-4cc7-b0d5-aa075b389ace",
                        "source_entry_id": "61410b7e-f4a2-3602-9427-dfdd3df53a1c",
                        "source_sense_id": "e3c00199-c5e4-3b01-bb81-657d5f5c18c2",
                        "target_lang_word": "Endymion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Endymion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3aa7544e-925c-308c-8f61-47a19bc82ef6",
                                        "entry_id": "687a6f69-eabb-30a9-8111-73bf48cdbd89",
                                        "glosses": [
                                            "A man described variously as a handsome Aeolian shepherd, hunter, or king, who was loved by Selene or Artemis (the two being often conflated) and was said to rule and live at Olympia in Elis, as well as venerated and said to reside in Caria, southwest Asia Minor, on Mount Latmus."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cf35594-4379-4fc6-8f43-985b06076da9",
                                                "sense_id": "3aa7544e-925c-308c-8f61-47a19bc82ef6",
                                                "text": "The heavenly bodies may keep their secrets two or three thousand years yet; but one or other of them will betray them to some wakeful favorite, some Endymion beyond Latmos, perhaps in regions undiscovered, certainly in uncalculated times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dcf128a-123a-33ea-ab70-e55c496121ba",
                                        "entry_id": "687a6f69-eabb-30a9-8111-73bf48cdbd89",
                                        "glosses": [
                                            "342 Endymion, an asteroid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c25e181b-1b67-3416-b112-123a647a5e66",
                                        "entry_id": "687a6f69-eabb-30a9-8111-73bf48cdbd89",
                                        "glosses": [
                                            "A crater on the Moon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
