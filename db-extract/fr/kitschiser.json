                                "sense_id": "b662fd70-b103-3f04-b127-a01396cf4ebf",
                                "text": "Boite à mots doux ou l’art de kitschiser son intérieur."
                            },
                            {
                                "example_id": "30e0da9c-b92c-4971-bf48-0e5bdf9114d0",
                                "sense_id": "b662fd70-b103-3f04-b127-a01396cf4ebf",
                                "text": "« Kitschiser » ou « avant-gardiser » : deux stratégies culturelles."
                            },
                            {
                                "example_id": "1bad87da-549c-4054-b1ae-28ecf05a5554",
                                "sense_id": "b662fd70-b103-3f04-b127-a01396cf4ebf",
                                "text": "J’aime beaucoup jouer sur l’idée du fantasme ; prendre quelque chose de naturellement beau pour le « kitschiser »."
                            }
                        ]
                    }
