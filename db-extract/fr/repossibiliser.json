                "senses": [
                    {
                        "sense_id": "5e52b825-f03b-3029-9d3a-c35afaeff78b",
                        "entry_id": "83ffb498-647d-3048-b6d0-bde4e30d342f",
                        "glosses": [
                            "Rendre à nouveau possible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d8ddbd9-04b3-4040-b1cc-5f6588f39c0e",
                                "sense_id": "5e52b825-f03b-3029-9d3a-c35afaeff78b",
                                "text": "Mais transgresser n'est pas détruire ; c'est au contraire accroître le legs reçu, c'est le renouveler, le repossibiliser en fonction d'exigences nouvelles."
                            },
                            {
                                "example_id": "64d105e2-b162-46aa-a0ae-3fb574fff9f2",
                                "sense_id": "5e52b825-f03b-3029-9d3a-c35afaeff78b",
                                "text": "Centre de toute expérience, le corps affecté nous invite à apprendre à repossibiliser ses ressources, particulièrement dans la relation de soin."
                            }
                        ]
                    }
