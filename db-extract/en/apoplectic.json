                "senses": [
                    {
                        "sense_id": "455634cd-7ba8-384f-8c54-d9b4937ff4b7",
                        "entry_id": "8bf31196-df0e-328c-bd2d-95439aa4c996",
                        "glosses": [
                            "Of or relating to apoplexy."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "97965cd8-6f52-3e8f-a03c-695643411143",
                        "entry_id": "8bf31196-df0e-328c-bd2d-95439aa4c996",
                        "glosses": [
                            "Marked by extreme anger or fury."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b206b52b-517a-4c6b-8c63-7da3dae445a5",
                                "sense_id": "97965cd8-6f52-3e8f-a03c-695643411143",
                                "text": "Once she heard Jem refer to our father as 'Atticus' and her reaction was apoplectic."
                            },
                            {
                                "example_id": "45bed480-caed-4906-829f-13b1011b7984",
                                "sense_id": "97965cd8-6f52-3e8f-a03c-695643411143",
                                "text": "Speak of the devil—he marches through the door, and becomes apoplectic when he learns of the upheaval."
                            },
                            {
                                "example_id": "81d843ee-7b1d-4f72-a01d-8cad41674b1b",
                                "sense_id": "97965cd8-6f52-3e8f-a03c-695643411143",
                                "text": "The decision left Potters boss Tony Pulis apoplectic on the touchline, a feeling his West Ham counterpart Avram Grant was to share immediately after the break."
                            },
                            {
                                "example_id": "6390aa78-b685-4726-8fda-ede97eae5ea3",
                                "sense_id": "97965cd8-6f52-3e8f-a03c-695643411143",
                                "text": "If older man/younger women matchups make many people uncomfortable, the older man/much younger women combo tends to make them apoplectic."
                            },
                            {
                                "example_id": "557d9504-4a2a-4694-a06f-dcd5a3f34a0c",
                                "sense_id": "97965cd8-6f52-3e8f-a03c-695643411143",
                                "text": "Yet when one relistens to the original Rock, Rot & Rule broadcast, the most salient element is not the comedy. It’s the apoplectic phone calls from random WFMU listeners."
                            }
                        ]
                    },
                    {
                        "sense_id": "6651accb-35e3-3e65-82e3-6f5bd84a5c10",
                        "entry_id": "8bf31196-df0e-328c-bd2d-95439aa4c996",
                        "glosses": [
                            "Effused with blood."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": []
                    }
                ],
