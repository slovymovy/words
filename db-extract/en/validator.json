                "translations": [
                    {
                        "translation_id": "26943388-a836-4780-8da4-2bc4576d3bb7",
                        "source_entry_id": "a6643cf0-d2c2-3df1-8b51-b768e92255c9",
                        "source_sense_description": "one who validates",
                        "target_lang_word": "cachet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cachet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9bb4b1f8-65e3-33a4-9ff3-a38e673483c9",
                                        "entry_id": "d492a761-553b-3ff9-b459-204ab31d6c9f",
                                        "glosses": [
                                            "Petit objet gravé avec lequel on marque une empreinte, par exemple pour fermer une lettre, ou pour laisser une marque distinctive qui garantit l’authenticité du document, ou pour donner un renseignement, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec00c3bf-e362-401c-a1dd-fd5685c8fdf8",
                                                "sense_id": "9bb4b1f8-65e3-33a4-9ff3-a38e673483c9",
                                                "text": "Polycrate résolut de sacrifier un de ses objets les plus précieux, une émeraude montée en or, qui lui servait de cachet ; pour cela, il fit équiper un vaisseau et se fit conduire en pleine mer, d’où il lança son anneau dans les flots, à la vue de tous ceux qu’il avait menés avec lui."
                                            },
                                            {
                                                "example_id": "32a9162a-0d2c-4112-b69e-d29b6a823f7d",
                                                "sense_id": "9bb4b1f8-65e3-33a4-9ff3-a38e673483c9",
                                                "text": "Voici une lettre pour vous, madame Linton, dis-je, mettant doucement le papier dans la main qui reposait sur son genou. Il faut que vous la lisiez tout de suite ; parce qu’on attend une réponse. Dois-je briser le cachet ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f775905-22de-30f4-9899-25487253b16b",
                                        "entry_id": "d492a761-553b-3ff9-b459-204ab31d6c9f",
                                        "glosses": [
                                            "Cette empreinte même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e1a36d3-5f05-4df3-ac62-3dfd9823dc31",
                                                "sense_id": "5f775905-22de-30f4-9899-25487253b16b",
                                                "text": "Il commença par examiner le cachet de cire rouge qui la fermait et il vit que ce cachet portait des armoiries qu’il ne prit pas le temps de déchiffrer, avant de le faire sauter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05cdce6d-1eca-3ac2-a8c1-b971202a6097",
                                        "entry_id": "d492a761-553b-3ff9-b459-204ab31d6c9f",
                                        "glosses": [
                                            "Empreinte faite par le tampon de la poste."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "926f41b2-f347-4c6c-bbd9-3088009d553b",
                                                "sense_id": "05cdce6d-1eca-3ac2-a8c1-b971202a6097",
                                                "text": "Le cachet de la poste faisant foi de la date d’envoi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe37944d-8604-3835-8074-28989779d18b",
                                        "entry_id": "d492a761-553b-3ff9-b459-204ab31d6c9f",
                                        "glosses": [
                                            "Cartes sur lesquelles on met un cachet ou une marque et qui, dans un abonnement, servent à tenir compte du nombre de fois qu’une personne a fait quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc50260e-94ee-428d-a931-d1469d10cf6d",
                                                "sense_id": "fe37944d-8604-3835-8074-28989779d18b",
                                                "text": "Ce maître de danse prend cent francs pour douze cachets, pour douze leçons."
                                            },
                                            {
                                                "example_id": "ac12000d-f6ee-48a9-90b5-b2621f430f74",
                                                "sense_id": "fe37944d-8604-3835-8074-28989779d18b",
                                                "text": "Des cachets de bain."
                                            },
                                            {
                                                "example_id": "4542c9bd-cfe8-4a82-a852-f41530f8ee71",
                                                "sense_id": "fe37944d-8604-3835-8074-28989779d18b",
                                                "text": "Courir le cachet, donner des leçons en ville."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "115683df-7e34-3f60-b7b7-6984a03d9c0c",
                                        "entry_id": "d492a761-553b-3ff9-b459-204ab31d6c9f",
                                        "glosses": [
                                            "Rétribution d’un artiste par représentation, par concert."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ceaa5b2-d11c-4c4a-8a98-f0bdb27032c5",
                                                "sense_id": "115683df-7e34-3f60-b7b7-6984a03d9c0c",
                                                "text": "C’est le principe de la boule de neige : plus on joue, plus on est sollicité, jusqu’au moment où cette avalanche est trop importante pour être contenue par l’artiste seul ; en général, un agent survient, propose ses services et se rémunère (entre 10 et 20 %) sur les cachets du musicien."
                                            },
                                            {
                                                "example_id": "f7d6ee4b-a8c6-43c5-b34d-3ec255c1883a",
                                                "sense_id": "115683df-7e34-3f60-b7b7-6984a03d9c0c",
                                                "text": "Ainsi, même le musicien qui recevait un cachet pour sa participation au bal de la rosière de Trifouilly les Oies, cotisait à la CARBALAS avec son employeur d’un jour."
                                            },
                                            {
                                                "example_id": "ae04f6b3-7341-4ec9-8b33-eece749b19ef",
                                                "sense_id": "115683df-7e34-3f60-b7b7-6984a03d9c0c",
                                                "text": "En attendant, les festivals sont eux-mêmes victimes de cette course aux cachets et doivent sans cesse trouver plus de fraîche pour attirer des vedettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22a6f242-9c88-35ff-8b7b-a608557c0e63",
                                        "entry_id": "d492a761-553b-3ff9-b459-204ab31d6c9f",
                                        "glosses": [
                                            "Caractère particulier, distinctif d’un auteur, d’un artiste, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36804a13-a9e0-48b3-9475-f5d531099a6b",
                                                "sense_id": "22a6f242-9c88-35ff-8b7b-a608557c0e63",
                                                "text": "Ça donne quand même plus de cachet à la cérémonie, le live."
                                            },
                                            {
                                                "example_id": "e1a6909d-f4db-4fdf-a4a7-9fcc19e2b1d1",
                                                "sense_id": "22a6f242-9c88-35ff-8b7b-a608557c0e63",
                                                "text": "Ma mère voit que je grandis, et elle a voulu m’habiller comme un homme des classes moyennes, qui a de l’étoffe, ne vise pas au freluquet, et a pourtant son cachet à lui. J’ai du cachet — mais je suis modeste, et je préférerais vivre dans l’obscurité."
                                            },
                                            {
                                                "example_id": "86bfb42b-dc92-4f46-9e27-6fb2c6ea676b",
                                                "sense_id": "22a6f242-9c88-35ff-8b7b-a608557c0e63",
                                                "text": "Près de Toulouse, le Genêt scorpion a disparu mais il y a encore le Ciste à feuilles de Sauge qui imprime un cachet méditerranéen à côté du Genêt à balai plutôt atlantique."
                                            },
                                            {
                                                "example_id": "7592aa7f-3062-49c7-96b4-90bdaf6045a3",
                                                "sense_id": "22a6f242-9c88-35ff-8b7b-a608557c0e63",
                                                "text": "Les productions de cet artiste portent un cachet d’originalité qui les fait aisément reconnaître."
                                            },
                                            {
                                                "example_id": "397fb633-6511-42f2-bd8f-f28e019921b3",
                                                "sense_id": "22a6f242-9c88-35ff-8b7b-a608557c0e63",
                                                "text": "Cet ouvrage porte le cachet de l’époque où il fut composé."
                                            },
                                            {
                                                "example_id": "72f001aa-664c-475c-8691-5a1919a2a830",
                                                "sense_id": "22a6f242-9c88-35ff-8b7b-a608557c0e63",
                                                "text": "Avoir du cachet, avoir de l’élégance, une distinction particulière."
                                            },
                                            {
                                                "example_id": "bb4422b7-6531-4c33-8f60-bcda2d94608c",
                                                "sense_id": "22a6f242-9c88-35ff-8b7b-a608557c0e63",
                                                "text": "Les lambris sombres, ornés de photos noir et blanc de golfeurs légendaires, conféraient à la pièce un cachet ancien, britannique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4294dfe9-263a-304f-9b7e-c4297ba8e749",
                                        "entry_id": "d492a761-553b-3ff9-b459-204ab31d6c9f",
                                        "glosses": [
                                            "Capsule renfermant une dose de poudre médicamenteuse, anciennement composée de deux cupules de pain azyme soudées par humidification."
                                        ],
                                        "tags": [
                                            "Pharmacie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8a2e1b7-b3e5-4e84-9347-2d3143ba4623",
                                                "sense_id": "4294dfe9-263a-304f-9b7e-c4297ba8e749",
                                                "text": "Elle était sujette à de fréquentes insomnies et prenait régulièrement un ou deux cachets de théralène qu’elle faisait dissoudre dans un verre d’eau."
                                            },
                                            {
                                                "example_id": "fea29a3c-1e85-45cd-865c-4de78f0f9014",
                                                "sense_id": "4294dfe9-263a-304f-9b7e-c4297ba8e749",
                                                "text": "Sans mon cachet, je ne peux pas dormir."
                                            },
                                            {
                                                "example_id": "56b7d41c-635e-40d0-995d-d0da62a08e1f",
                                                "sense_id": "4294dfe9-263a-304f-9b7e-c4297ba8e749",
                                                "text": "Il est blanc comme un cachet."
                                            },
                                            {
                                                "example_id": "5592927a-4238-4b2b-a294-15204c0de4e2",
                                                "sense_id": "4294dfe9-263a-304f-9b7e-c4297ba8e749",
                                                "text": "J’attendais un miracle, un fabuleuse révélation au moment où l’Eucharistie fondrait dans ma bouche. J’appréhendais aussi de l’avaler, la sachant trop large pour mon gosier, et ignorant qu’elle fût susceptible de s’amollir, tel un cachet."
                                            },
                                            {
                                                "example_id": "0183cd70-d03d-4a45-9dd6-4e8cb4bfd622",
                                                "sense_id": "4294dfe9-263a-304f-9b7e-c4297ba8e749",
                                                "text": "Au ministère, tout le monde déplorait qu'un chirurgien de son envergure en fût réduit à prescrire des cachets d'aspirine dans un dispensaire de banlieue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6206a52-eb23-3b02-b146-465f250e27b8",
                                        "entry_id": "d492a761-553b-3ff9-b459-204ab31d6c9f",
                                        "glosses": [
                                            "Comprimé, capsule dont la forme rappelle celle d’un médicament."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67d207de-398d-4755-bb02-a451e0d6975f",
                                                "sense_id": "f6206a52-eb23-3b02-b146-465f250e27b8",
                                                "text": "Depuis le Blue Öyster, elle investissait la quasi-totalité de son énergie dans la lutte pour empêcher sa main d’aller chercher au fond de son sac un flacon sans étiquette contenant un certain nombre de cachets sans marque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
