                "senses": [
                    {
                        "sense_id": "ed8e23e3-13b9-3fde-bc89-80e299e1080c",
                        "entry_id": "29c15aff-1eb5-37f4-99bf-d3a343c8e5b0",
                        "glosses": [
                            "Fisch aus der Gattung der Pazifischen Lachse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "365bde94-4e6c-4ae0-a8c5-43f79c25b453",
                                "sense_id": "ed8e23e3-13b9-3fde-bc89-80e299e1080c",
                                "text": "Die Regenbogenforelle wurde Ende des 19. Jahrhunderts nach Europa eingeführt."
                            },
                            {
                                "example_id": "c3b32e7b-e4e6-48af-b840-67f93aeeea12",
                                "sense_id": "ed8e23e3-13b9-3fde-bc89-80e299e1080c",
                                "text": "„Ich zog eine fünfundzwanzig Zentimeter lange Regenbogenforelle heraus, warf sie aufs Gras und schlug ihr auf den Kopf.“"
                            },
                            {
                                "example_id": "5d17c28c-b947-48d7-9a32-f7f863a1a74c",
                                "sense_id": "ed8e23e3-13b9-3fde-bc89-80e299e1080c",
                                "text": "„Ich erinnere mich, wie wir unsere Obstgärten gepflegt und im Bach funkelnde Regenbogenforellen gefangen haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
