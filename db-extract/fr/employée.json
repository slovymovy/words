                "translations": [
                    {
                        "translation_id": "052798d7-7788-427d-a399-1dd42cff679f",
                        "source_entry_id": "e3c95356-01cc-34d1-b900-83688d92f7b5",
                        "target_lang_word": "Arbeitnehmerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arbeitnehmerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb3d775b-02f7-3b88-b4d8-7d47c95be72b",
                                        "entry_id": "8a82d045-3b7f-316d-8818-b4ec307667b7",
                                        "glosses": [
                                            "weibliche Person, die eine berufliche Anstellung hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1830741f-a451-4205-8b51-721c3013331f",
                                                "sense_id": "fb3d775b-02f7-3b88-b4d8-7d47c95be72b",
                                                "text": "Erika ist mit 87 Jahren unsere älteste Arbeitnehmerin."
                                            },
                                            {
                                                "example_id": "c1aca845-1211-4f67-8851-26fc6735c8fd",
                                                "sense_id": "fb3d775b-02f7-3b88-b4d8-7d47c95be72b",
                                                "text": "Die Arbeitnehmerinnen des Betriebes beklagten sich über den schlechten Zustand der Damentoilette."
                                            },
                                            {
                                                "example_id": "f5e08f9d-8bf8-4533-9bc9-50a73b15da1a",
                                                "sense_id": "fb3d775b-02f7-3b88-b4d8-7d47c95be72b",
                                                "text": "Eine insgesamt etwa dreieinhalb Monate in einem Betriebe beschäftigte Arbeitnehmerin weigerte sich trotz wiederholter Aufforderungen des Betriebsratsvorsitzenden, sich gewerkschaftlich zu organisieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99f80f08-fbec-4548-a4dc-923f9a6e3723",
                        "source_entry_id": "e3c95356-01cc-34d1-b900-83688d92f7b5",
                        "target_lang_word": "employee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "employee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a9fa2bd-77ad-388a-beea-16ca7ca64cf3",
                                        "entry_id": "b463ade8-0224-30a8-a80e-753fe0036991",
                                        "glosses": [
                                            "A person who provides labor to a company or another person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "953aab94-605b-4798-9965-e6470b33a466",
                                                "sense_id": "2a9fa2bd-77ad-388a-beea-16ca7ca64cf3",
                                                "text": "One way to encourage your employees to work harder is by giving them incentives."
                                            },
                                            {
                                                "example_id": "8401a7de-df37-4940-876c-4fa3ecf70a42",
                                                "sense_id": "2a9fa2bd-77ad-388a-beea-16ca7ca64cf3",
                                                "text": "No one, however, would have anything to do with him, as Mr. Keeson's orders in those respects were very strict ; he had often threatened any one of his employés with instant dismissal if he found him in company with one of these touts."
                                            },
                                            {
                                                "example_id": "7ef149b2-b638-4ac6-ba2d-583911ba2b24",
                                                "sense_id": "2a9fa2bd-77ad-388a-beea-16ca7ca64cf3",
                                                "text": "The concepts of emotional intelligence (EI), self-worth, authenticity and employee meditation rooms might conjure up thoughts of new age healing centers. […] Now, Nielsen is sending all hotel employees through EI training to help them become more open and confident, understand their own limitations and fears, and to boost their self-worth and comfort in dealing with other people."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6d41e43-506b-4224-ae83-0560fb9ad0fa",
                        "source_entry_id": "e3c95356-01cc-34d1-b900-83688d92f7b5",
                        "target_lang_word": "worker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "worker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                        "entry_id": "3630a45e-6c21-340b-af74-fa6cbb9ceadb",
                                        "glosses": [
                                            "One who works: a person who performs labor for a living; traditionally, especially, manual labor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13711fdb-2e40-46b9-80e0-247a5e15e7eb",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "Near-synonym: employee"
                                            },
                                            {
                                                "example_id": "5a6399c5-0b3f-4ae8-b142-5fa2bb33b805",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "Fret not thy ſelfe becauſe of euill doers, neither bee thou enuious againſt the workers of iniquitie."
                                            },
                                            {
                                                "example_id": "fbc7e998-979d-49b3-b47c-2996222eeb64",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "Writer Ta Chen, in a statistical study of industrial labor in China in 1933, recorded that 66.6 percent of the total number of workers in the four main industrial regions of Kwangtung were women. In Shun-te, 81.2 percent of the labor force were women."
                                            },
                                            {
                                                "example_id": "68875285-4c6f-47f6-81e0-48c104c9ee14",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "Manganism has been known about since the 19th century, when miners exposed to ores containing manganese […] began to totter, slur their speech and behave like someone inebriated. The poisoning was irreversible, and soon ended in psychosis and death. Nowadays workers are exposed to far lower doses and manganism is rare."
                                            },
                                            {
                                                "example_id": "9f6a7db4-d29c-4779-b9f9-7c7fad265f74",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "Although the radiation levels identified are high, a threat to human health is very unlikely because apart from workers at the site, no-one goes there."
                                            },
                                            {
                                                "example_id": "455b28ad-223f-4925-b8b4-8ab3789d13cc",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "That would allow employers to keep some tip money for themselves, as long as each worker made at least the full federal minimum wage of $7.25 an hour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de39e866-8ea3-3fd0-8c54-2ae731a05a99",
                                        "entry_id": "3630a45e-6c21-340b-af74-fa6cbb9ceadb",
                                        "glosses": [
                                            "A nonreproductive social insect, such as ant, bee, termite, or wasp."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a901efe-a474-3783-a606-47ae4f5de623",
                                        "entry_id": "3630a45e-6c21-340b-af74-fa6cbb9ceadb",
                                        "glosses": [
                                            "A nonreproductive social insect, such as ant, bee, termite, or wasp.",
                                            "A female ant, bee, termite or wasp."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
