                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verblijven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verdachte zou zich in het buitenland <w>ophouden</w>.",
                            "target_lang_translations": {
                                "en": "The suspect is said to be <w>staying</w> abroad."
                            }
                        },
                        {
                            "text": "Het volk <w>houdt zich</w> urenlang op straat <w>op</w> om een glimp van de koning op te vangen.",
                            "target_lang_translations": {
                                "en": "The people <w>are hanging out</w> on the streets for hours to catch a glimpse of the king."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich ergens ophouden"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "reflexive verb"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to be located or stay somewhere"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hang out",
                                "target_lang_sense_clarification": "to spend time in a place (informal)"
                            },
                            {
                                "target_lang_word": "stay",
                                "target_lang_sense_clarification": "to remain in a certain location"
                            },
                            {
                                "target_lang_word": "loiter",
                                "target_lang_sense_clarification": "to stand or wait around idly"
                            }
                        ]
