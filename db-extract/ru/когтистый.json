                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "armé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7b2aaa1a-92e7-37c6-8c08-25b6d9b92234",
                                        "entry_id": "a8ed9dea-f3e4-32b4-a14d-81c43af92dbd",
                                        "glosses": [
                                            "Qui est équipé d’armes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77ee51cf-0093-4a22-a31d-ae4fea30e708",
                                                "sense_id": "7b2aaa1a-92e7-37c6-8c08-25b6d9b92234",
                                                "text": "Qui aime sans être aimé, de mauvaises armes est armé."
                                            },
                                            {
                                                "example_id": "648d5af2-f725-4ad8-9186-0ec30a9735d8",
                                                "sense_id": "7b2aaa1a-92e7-37c6-8c08-25b6d9b92234",
                                                "text": "En retour, le Kremlin ne commente pas le soutien turc à l’Ukraine. Or, celui-ci inclut la livraison à Kiev de matériel militaire, dont les célèbres drones armés Barayktar, qui ont fait des dégâts depuis le 24 février dans les colonnes de tanks russes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ef9378d-dd9f-3467-964e-a3b16b3dfbec",
                                        "entry_id": "a8ed9dea-f3e4-32b4-a14d-81c43af92dbd",
                                        "glosses": [
                                            "Signifie, en parlant des choses, qui est garni, muni, pourvu de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2575a43d-2843-42a6-bb32-513e4568c15e",
                                                "sense_id": "2ef9378d-dd9f-3467-964e-a3b16b3dfbec",
                                                "text": "Un bâton armé d’une pointe de fer."
                                            },
                                            {
                                                "example_id": "32b0d4d9-da30-48a7-b355-d895b98adcac",
                                                "sense_id": "2ef9378d-dd9f-3467-964e-a3b16b3dfbec",
                                                "text": "Une plante armée d’épines, d’aiguillons."
                                            },
                                            {
                                                "example_id": "9cc6aa91-5c21-4b36-a355-857f732292b5",
                                                "sense_id": "2ef9378d-dd9f-3467-964e-a3b16b3dfbec",
                                                "text": "La gueule de cet animal est armée de dents très aiguës."
                                            },
                                            {
                                                "example_id": "6c2168a9-d7be-41bd-b54d-9f3d0705f356",
                                                "sense_id": "2ef9378d-dd9f-3467-964e-a3b16b3dfbec",
                                                "text": "Il est armé de pied en cap, : Homme qui est prêt sur tous les points d’une affaire et en état de repousser toutes les attaques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b848a4d-533b-317c-b6b7-f1e17707cf80",
                                        "entry_id": "a8ed9dea-f3e4-32b4-a14d-81c43af92dbd",
                                        "glosses": [
                                            "Renforcé par une armature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "881f984f-e475-40f0-ad7d-6c753c1a646d",
                                                "sense_id": "7b848a4d-533b-317c-b6b7-f1e17707cf80",
                                                "text": "Une dalle en béton armé."
                                            },
                                            {
                                                "example_id": "95077b44-43fa-48be-bb2e-d17af02919a9",
                                                "sense_id": "7b848a4d-533b-317c-b6b7-f1e17707cf80",
                                                "text": "L’usine […] était également outillée pour transformer le papier d’emballage en papier goudronné, entoilé, armé, huilé et paraffiné, à usage industriel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4905d79d-e911-340f-9b66-022929763c81",
                                        "entry_id": "a8ed9dea-f3e4-32b4-a14d-81c43af92dbd",
                                        "glosses": [
                                            "Qualifie les griffes d’un animal héraldique lorsqu’elles sont d’un autre émail que le corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fae5b6c-4a3b-4b2c-a3e7-5a9c4cbecc4d",
                                                "sense_id": "4905d79d-e911-340f-9b66-022929763c81",
                                                "text": "Armé : se dit de l’émail des ongles des animaux sauvages. Ce terme est encore employé pour désigner l’émail du fer des flèches lorsqu’il diffère de celui du fût, ainsi que pour indiquer qu’un homme de guerre est revêtu d’une armure ou qu’un bras est couvert de brassards ou une jambe de cuissards."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "armé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cac6729b-0ef0-3bcf-bbac-ca47984667b3",
                                        "entry_id": "5bb05c88-b6a0-3ba2-aa78-ca5ff1c572f2",
                                        "glosses": [
                                            "Participe passé masculin singulier de armer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "196136df-4ed0-4780-ad46-aaacb0fca672",
                                                "sense_id": "cac6729b-0ef0-3bcf-bbac-ca47984667b3",
                                                "text": "Michaud ne s’en vanterait pas, il politiquerait, espionnerait, et finirait par découvrir l’homme et ceux qui l’ont armé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
