                    {
                        "sense_id": "c4c4657c-20df-3f5d-bb7a-41d4417537a5",
                        "entry_id": "8ba293d0-292f-351a-ab5d-501efc8297c6",
                        "glosses": [
                            "Eschatologie; Lehre(n) bezüglich der »letzten Dinge« (Tod) für die einzelne Person und (im christlichen Kontext) der heilsgeschichtlichen Vollendung (Ende der Welt, Jüngstes Gericht, Wiederkunft Christi und eine „neue Welt“)"
                        ],
                        "tags": [
                            "Theologie"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "043d4b4a-9704-40e2-8f7f-e9b06794b21d",
                        "source_entry_id": "8ba293d0-292f-351a-ab5d-501efc8297c6",
                        "source_sense_id": "c4c4657c-20df-3f5d-bb7a-41d4417537a5",
                        "source_sense_description": "siehe deutsche Übersetzung",
                        "target_lang_word": "Eschatologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eschatologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6017ee45-1290-39f0-9609-861dc03bfd20",
                                        "entry_id": "608d32c9-4381-3ee5-9c85-3e583dc575d9",
                                        "glosses": [
                                            "Lehre von den „letzten Dingen“, das heißt die Lehre von Tod, Auferstehung und damit verbunden die Lehre vom Anbruch einer neuen Welt"
                                        ],
                                        "tags": [
                                            "Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5af9abf1-dbca-4597-ad79-f1704f2bbbff",
                                                "sense_id": "6017ee45-1290-39f0-9609-861dc03bfd20",
                                                "text": "Die Eschatologie wird heute verstanden als die Lehre von den Hoffnungen auf Vollendung des Einzelnen (individuelle Eschatologie) und der gesamten Schöpfung (universale Eschatologie), die sich aus dem Glauben ergibt."
                                            },
                                            {
                                                "example_id": "b75fa6d3-f0a8-4350-a512-9b685d9b18b3",
                                                "sense_id": "6017ee45-1290-39f0-9609-861dc03bfd20",
                                                "text": "„Das theologisch mehrdeutige Wort Eschatologie (»Lehre von den letzten Dingen«) wird, auf die allgemeine Religionsgeschichte übertragen, meist als Synonym zu Jenseitsvorstellungen benutzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
