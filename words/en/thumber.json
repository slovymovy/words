    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "009038b5-6dc7-3552-83fb-b774ac413a8f",
                    "sense_definition": "A person who thumbs a lift; a hitchhiker.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "traveler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver decided to stop and pick up the <w>thumber</w> standing by the side of the highway.",
                            "target_lang_translations": {
                                "ru": "Водитель решил остановиться и подобрать <w>автостопщика</w>, стоявшего у обочины шоссе."
                            }
                        },
                        {
                            "text": "A lonely <w>thumber</w> waited for hours in the rain, hoping for a ride to the next city.",
                            "target_lang_translations": {
                                "ru": "Одинокий <w>голосующий</w> часами ждал под дождем, надеясь доехать до следующего города."
                            }
                        }
                    ],
                    "synonyms": [
                        "hitchhiker"
                    ],
                    "common_phrases": [
                        "lonely thumber",
                        "pick up thumbers"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal term for a hitchhiker"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который ловит попутку; автостопщик."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "автостопщик",
                                "target_lang_sense_clarification": "человек, путешествующий на попутных машинах"
                            },
                            {
                                "target_lang_word": "голосующий",
                                "target_lang_sense_clarification": "человек, пытающийся остановить машину жестом руки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b6a235b-44d7-343b-9275-e223c73dd5c5",
                    "sense_definition": "A person who thumbs through something, such as a book or a dictionary, often looking for information.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reader",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a dedicated dictionary <w>thumber</w>, he spent his afternoons searching for obscure and rare words.",
                            "target_lang_translations": {
                                "ru": "Будучи заядлым <w>любителем полистать</w> словари, он проводил свои дни в поисках малоизвестных и редких слов."
                            }
                        },
                        {
                            "text": "The author was a frequent thesaurus <w>thumber</w> who always looked for the most precise adjectives.",
                            "target_lang_translations": {
                                "ru": "Автор часто <w>листал</w> тезаурус в поисках наиболее точных прилагательных."
                            }
                        }
                    ],
                    "common_phrases": [
                        "thesaurus thumber",
                        "dictionary thumber"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который быстро пролистывает что-либо (книгу, словарь), часто в поисках информации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "листающий",
                                "target_lang_sense_clarification": "тот, кто бегло просматривает страницы"
                            },
                            {
                                "target_lang_word": "читатель",
                                "target_lang_sense_clarification": "в контексте частого обращения к справочной литературе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
