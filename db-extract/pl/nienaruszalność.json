                "senses": [
                    {
                        "sense_id": "b17d12c9-dfe7-3680-8fd0-8d04bb7708bc",
                        "entry_id": "531aa33e-a2a1-32b2-b209-cde50acc109a",
                        "glosses": [
                            "cecha tego, co nienaruszalne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87d59f07-c8a3-472b-b96d-f8b2b265103b",
                                "sense_id": "b17d12c9-dfe7-3680-8fd0-8d04bb7708bc",
                                "text": "Wprowadzenie stanu wojennego między innymi powoduje czasowe zawieszenie lub ograniczenie określonych w Konstytucji Polskiej Rzeczpospolitej Ludowej podstawowych praw obywateli, a w szczególności wolności i nietykalności osobistej oraz nienaruszalności mieszkań."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfcc9ce7-6bec-4d1d-918c-b5e55d3ef095",
                        "source_entry_id": "531aa33e-a2a1-32b2-b209-cde50acc109a",
                        "source_sense_id": "b17d12c9-dfe7-3680-8fd0-8d04bb7708bc",
                        "target_lang_word": "Unverletzlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unverletzlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27cb815b-66a5-3b99-8ba6-8ac27d452905",
                                        "entry_id": "a39785a0-2006-3a6f-ae05-026c0cf77988",
                                        "glosses": [
                                            "Eigenschaft, (körperlich) nicht verletzt werden zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47debc05-f07a-4f43-8e76-916d4fd5889b",
                                                "sense_id": "27cb815b-66a5-3b99-8ba6-8ac27d452905",
                                                "text": "„Sein Mut glich dem des Achill; aber Achilles wußte um seine Unverletzlichkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b6f1748d-55d3-31cc-a0cd-bc713105d4a8",
                                        "entry_id": "a39785a0-2006-3a6f-ae05-026c0cf77988",
                                        "glosses": [
                                            "Zustand, dass bestimmte Rechte, Personen oder Institutionen gesetzlich, verfassungsrechtlich oder vertraglich vor Angriffen oder Eingriffen geschützt sind und der herrschende Zustand der Unversehrtheit nicht verändert werden darf"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9639a7cc-8cc6-4cbf-909f-242533434da0",
                                                "sense_id": "b6f1748d-55d3-31cc-a0cd-bc713105d4a8",
                                                "text": "„»Das Prinzip der Unverletzlichkeit von Grenzen gilt für jedes Land - egal ob es im Osten von uns liegt oder im Westen«, sagte der SPD-Politiker in einem kurzfristig anberaumten Pressestatement in Berlin. »Daran muss sich jeder Staat halten - egal ob es ein kleines Land ist oder ein sehr mächtiger Staat.«“"
                                            },
                                            {
                                                "example_id": "a3924f22-0e5c-4b3b-8f70-6723275d61ec",
                                                "sense_id": "b6f1748d-55d3-31cc-a0cd-bc713105d4a8",
                                                "text": "[1. August 1975, Unterzeichnung der KSZE-Schlussakte:] „Für die Garantie der Unverletzlichkeit der Grenzen und der Achtung der Souveränität ihres Herrschaftsbereichs ist die Sowjetunion bereit, die vom Westen geforderte \"Achtung und Verwirklichung der Menschenrechte und Grundfreiheiten\" zuzugestehen.“"
                                            },
                                            {
                                                "example_id": "7a553015-0276-4ce9-ac3f-92c9de1131ca",
                                                "sense_id": "b6f1748d-55d3-31cc-a0cd-bc713105d4a8",
                                                "text": "[Vertrag von Paris, 20. November 1815:] „Die Machthaber von Österreich, Grossbritannien, Portugal, Preussen und Russland respektierten, dass sich die Schweiz künftig aus militärischen Händeln heraus halten wollte. Die Mächte garantierten zudem die territoriale Unverletzlichkeit der Schweiz.“"
                                            },
                                            {
                                                "example_id": "936c0810-91b0-4e5f-9331-08ecdd84454f",
                                                "sense_id": "b6f1748d-55d3-31cc-a0cd-bc713105d4a8",
                                                "text": "[Grundgesetz:] „Artikel 17a – […] (2) Gesetze, die der Verteidigung einschließlich des Schutzes der Zivilbevölkerung dienen, können bestimmen, daß die Grundrechte der Freizügigkeit (Artikel 11) und der Unverletzlichkeit der Wohnung (Artikel 13) eingeschränkt werden.“"
                                            },
                                            {
                                                "example_id": "748ca21e-721c-47c3-9c0f-4857768b3f0e",
                                                "sense_id": "b6f1748d-55d3-31cc-a0cd-bc713105d4a8",
                                                "text": "Die Unverletzlichkeit von Abgeordneten schützt sie vor Strafverfolgung ohne Zustimmung des Parlaments."
                                            },
                                            {
                                                "example_id": "aba3c772-063a-4e01-8e09-aaa7fe7b05fd",
                                                "sense_id": "b6f1748d-55d3-31cc-a0cd-bc713105d4a8",
                                                "text": "[Wiener Übereinkommen über diplomatische Beziehungen:] „Mit der Unterzeichnung des Übereinkommens erkennen die Vertragsstaaten die besondere Stellung von Diplomaten und Diplomatinnen an, wie auch deren Immunität, Unverletzlichkeit und weitere Vorrechte.“"
                                            },
                                            {
                                                "example_id": "0e75f6d5-fc43-4d7c-95b0-bc9612fde031",
                                                "sense_id": "b6f1748d-55d3-31cc-a0cd-bc713105d4a8",
                                                "text": "„Die Unverletzlichkeit ist ein zentraler Grundsatz im Diplomatenrecht.“"
                                            },
                                            {
                                                "example_id": "03813a55-f9df-445e-ae62-1fab4c2b2653",
                                                "sense_id": "b6f1748d-55d3-31cc-a0cd-bc713105d4a8",
                                                "text": "„Während Immunität den rechtlichen Schutz vor Strafverfolgung regelt, schützt die Unverletzlichkeit Diplomat/-innen vor polizeirechtlichen Zwangsmaßnahmen.“"
                                            },
                                            {
                                                "example_id": "eb56ceb6-d0ca-4fd7-9278-7cedf5d9cf31",
                                                "sense_id": "b6f1748d-55d3-31cc-a0cd-bc713105d4a8",
                                                "text": "„Der Grundsatz der Unverletzlichkeit gilt auch für die Räumlichkeiten der Mission, also das Botschaftsgelände, sowie die Privatwohnung der Diplomat/-in und deren Gepäck.““"
                                            },
                                            {
                                                "example_id": "af5e4911-f187-46f0-8802-5534ee12655c",
                                                "sense_id": "b6f1748d-55d3-31cc-a0cd-bc713105d4a8",
                                                "text": "„Der oder die Dichter stammten aus der Jerusalemer Oberschicht und teilten die Zionstheologie, deren Vertrauen auf die Unverletzlichkeit des Tempels durch dessen Zerstörung radikal in Frage gestellt worden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
