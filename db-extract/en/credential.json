                        "examples": [
                            {
                                "example_id": "b14a0c1f-7374-48b7-8a2b-f9de55996e25",
                                "sense_id": "4d178490-9dce-3bdc-8d3e-f791c7e0b6b4",
                                "text": "May I see your credentials, please?"
