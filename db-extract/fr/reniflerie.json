                        "glosses": [
                            "Habitude de renifler."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "0f8f731a-5fe7-432e-b4c1-ddae3d95d841",
                                "sense_id": "8eb24e38-cdd1-317e-a59f-ef7764a27bdb",
                                "text": "Tout le monde s’écarte de lui à cause de sa reniflerie."
                            },
                            {
                                "example_id": "9eafee00-2a3c-4bef-91a0-9586efbff953",
                                "sense_id": "8eb24e38-cdd1-317e-a59f-ef7764a27bdb",
                                "text": "Je le voyais derrière son bureau, les deux coudes appuyés sur la table, croisant et décroisant les mains, dans une une reniflerie intermittente, tirant sur sa cigarette, avec ses tics et ses manies, rongements, grattements, petites particularités qui lui donnent un exutoire momentané, et où se manifeste jusque dans les plis de son existence végétative, la seconde scène cachée de sa nature, plus basse, plus terre à terre."
                            }
                        ]
                    }
