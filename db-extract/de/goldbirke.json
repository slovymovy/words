                "senses": [
                    {
                        "sense_id": "bd79dcde-f11a-32d6-b055-dfc04f3d614b",
                        "entry_id": "c9c69bd9-6ac0-386e-999e-85581ca7ce99",
                        "glosses": [
                            "Birkenart mit goldgelbem Herbstlaub"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf3e6c31-aea1-4c25-b5e1-8820d414b783",
                                "sense_id": "bd79dcde-f11a-32d6-b055-dfc04f3d614b",
                                "text": "„Betula ermanii, Goldbirke[,] kann ca. 20 Meter hoch werden mit runder Krone.“"
                            },
                            {
                                "example_id": "bf5081ed-31f5-4a05-a0ad-566f3d6636ac",
                                "sense_id": "bd79dcde-f11a-32d6-b055-dfc04f3d614b",
                                "text": "„Die Goldbirke, auch Steinbirke oder Yellow Birch genannt, ist eine in Sibirien und Kanada heimische Birkenart.“"
                            },
                            {
                                "example_id": "b71a9622-3728-4226-96bb-bc4c2507b63d",
                                "sense_id": "bd79dcde-f11a-32d6-b055-dfc04f3d614b",
                                "text": "„Wenn ich auch nicht ganz abgeneigt bin, die Goldbirke als eine Bastardart zu betrachten, so glaube ich es doch nicht von dieser handblättrigen Birke, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
