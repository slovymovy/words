                "senses": [
                    {
                        "sense_id": "7b54e2e8-8022-3a12-bd8d-02f40e7431b4",
                        "entry_id": "63e1c128-f1dd-3036-b38e-92b5c8b1ea53",
                        "glosses": [
                            "De l’homme de Neandertal, relatif à l’homme de Neandertal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a1f0ef4-b1b7-461f-a97d-c2df98d7ed60",
                                "sense_id": "7b54e2e8-8022-3a12-bd8d-02f40e7431b4",
                                "text": "Le chercheur retrace, dans un article publié par la revue Nature du 5 septembre, les tribulations qui ont valu à ce bébé néandertalien d’être enseveli une seconde fois avant de ressusciter à la science."
                            },
                            {
                                "example_id": "e0b7058c-aed7-4d01-b147-eb941cce866f",
                                "sense_id": "7b54e2e8-8022-3a12-bd8d-02f40e7431b4",
                                "text": "Sauf les Africains, la plupart d’entre nous porte des gênes néandertaliens. Nous avons donc en nous des traces d’hybridation passée."
                            }
                        ]
                    }
                ],
                "translations": [
