                "senses": [
                    {
                        "sense_id": "33428b11-0098-3c9e-9a54-df2013e62308",
                        "entry_id": "3b4bf005-ab32-38c6-b4fc-06823331dc97",
                        "glosses": [
                            "Wort, das aus zwei Silben besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83bc15b7-97c8-4b99-91ef-e1d09f8a6f3d",
                                "sense_id": "33428b11-0098-3c9e-9a54-df2013e62308",
                                "text": "„So beantwortet Abbildung 1 die Frage, mit wieviel Prozent die Einsilber, Zweisilber, Dreisilber undsoweiter in Werken von Goethe, Rilke, Cäsar und Sallust vorkommen.“"
                            },
                            {
                                "example_id": "2dbdff65-cbce-403f-a42d-9dbc5f061c74",
                                "sense_id": "33428b11-0098-3c9e-9a54-df2013e62308",
                                "text": "„Der minimale Fuß ist der Zweisilber aus betonter und unbetonter Silbe, der maximale der Dreisilber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
