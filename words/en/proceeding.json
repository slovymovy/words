{
    "word_family": [
        "proceed",
        "procedure",
        "procedural"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "64bdbc16-79fe-3f1c-a8d0-a7db95656748",
                    "sense_definition": "An event or happening; something that occurs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>proceeding</w> was quite unusual for such a formal event.",
                            "target_lang_translations": {
                                "zh": "对于这样正式的场合来说，这次<w>活动</w>相当不同寻常。"
                            }
                        },
                        {
                            "text": "Everyone watched the <w>proceeding</w> with great interest.",
                            "target_lang_translations": {
                                "zh": "每个人都饶有兴致地观看着整个<w>过程</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "event",
                        "happening",
                        "occurrence",
                        "incident"
                    ],
                    "common_phrases": [
                        "unusual proceeding"
                    ],
                    "target_lang_definitions": {
                        "zh": "发生的事件或活动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "活动",
                                "target_lang_sense_clarification": "指正在进行或发生的事件。"
                            },
                            {
                                "target_lang_word": "过程",
                                "target_lang_sense_clarification": "指事情发展的经过。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9b0fd65-9a06-33a1-88df-7830ffbbc3bb",
                    "sense_definition": "A specific measure or step taken in a course of business or action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided that a cautious <w>proceeding</w> was the best strategy.",
                            "target_lang_translations": {
                                "zh": "他们认为谨慎的<w>步骤</w>是最好的策略。"
                            }
                        },
                        {
                            "text": "The committee reviewed every <w>proceeding</w> to ensure compliance.",
                            "target_lang_translations": {
                                "zh": "委员会审查了每一项<w>措施</w>以确保合规。"
                            }
                        }
                    ],
                    "synonyms": [
                        "measure",
                        "step",
                        "transaction"
                    ],
                    "common_phrases": [
                        "cautious proceeding"
                    ],
                    "target_lang_definitions": {
                        "zh": "在业务或行动过程中采取的具体措施或步骤。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "步骤",
                                "target_lang_sense_clarification": "指行动中的具体环节。"
                            },
                            {
                                "target_lang_word": "措施",
                                "target_lang_sense_clarification": "指为达到目的而采取的行动。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11ead95a-37e0-3b90-9889-2e5ae55035d6",
                    "sense_definition": "A formal legal action or process.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court initiated a formal legal <w>proceeding</w> against the company.",
                            "target_lang_translations": {
                                "zh": "法院对该公司启动了正式的法律<w>诉讼</w>。"
                            }
                        },
                        {
                            "text": "He was required to attend the legal <w>proceeding</w> as a witness.",
                            "target_lang_translations": {
                                "zh": "他被要求以证人身份出席法律<w>程序</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "legal proceeding"
                    ],
                    "target_lang_definitions": {
                        "zh": "正式的法律行动或程序。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "诉讼",
                                "target_lang_sense_clarification": "指法庭上的法律程序。"
                            },
                            {
                                "target_lang_word": "程序",
                                "target_lang_sense_clarification": "指法律上的办事流程。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4e69bcc-4a22-3154-938c-09075de8a435",
                    "sense_definition": "A published collection of papers presented at an academic conference.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "academic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The research was published in the conference <w>proceeding</w> last year.",
                            "target_lang_translations": {
                                "zh": "这项研究去年发表在会议<w>论文集</w>中。"
                            }
                        },
                        {
                            "text": "She cited the academic <w>proceeding</w> in her final thesis.",
                            "target_lang_translations": {
                                "zh": "她在毕业论文中引用了那份学术<w>会议录</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "学术会议上发表的论文集。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "会议录",
                                "target_lang_sense_clarification": "指学术会议的论文汇编。"
                            },
                            {
                                "target_lang_word": "论文集",
                                "target_lang_sense_clarification": "指汇集在一起的学术文章。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "155c8cbc-e0a9-3e29-ac44-1e817f58d81f",
                    "sense_definition": "Present participle and gerund of <w>proceed</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They are <w>proceeding</w> with the plan as originally discussed.",
                            "target_lang_translations": {
                                "zh": "他们正按最初讨论的那样<w>进行</w>计划。"
                            }
                        },
                        {
                            "text": "The <w>proceeding</w> of the investigation requires more time.",
                            "target_lang_translations": {
                                "zh": "调查的<w>进行</w>需要更多时间。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 proceed 的现在分词或动名词形式，意为继续进行或开始行动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "进行",
                                "target_lang_sense_clarification": "指事情正在开展。"
                            },
                            {
                                "target_lang_word": "继续",
                                "target_lang_sense_clarification": "指行动的持续。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}