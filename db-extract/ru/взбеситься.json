                "translations": [
                    {
                        "translation_id": "21c6bb07-6479-4b53-b04a-4add4265531b",
                        "source_entry_id": "d9a3bc1b-c4c8-31fa-9ab2-b9a57f381389",
                        "source_sense_description": "прийти в крайнее раздражение, в ярость",
                        "target_lang_word": "enrager",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enrager",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6edbdea-64a2-3e66-8c2d-e02abe3549fd",
                                        "entry_id": "bbb0ce3a-d319-3a0e-977d-e236a937759d",
                                        "glosses": [
                                            "Être saisi de la rage."
                                        ],
                                        "tags": [],
                                        "note": "il n’est plus usité dans cette acception qu’au participe passé",
                                        "examples": [
                                            {
                                                "example_id": "82b9b6b3-0c9a-4a94-911b-8a862a105ea1",
                                                "sense_id": "a6edbdea-64a2-3e66-8c2d-e02abe3549fd",
                                                "text": "Un animal enragé."
                                            },
                                            {
                                                "example_id": "950321af-9d5f-4ff8-8175-5183cc38ec4c",
                                                "sense_id": "a6edbdea-64a2-3e66-8c2d-e02abe3549fd",
                                                "text": "Ce chien est enragé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d513d56-84e9-3de9-8c8b-57996d7dbae0",
                                        "entry_id": "bbb0ce3a-d319-3a0e-977d-e236a937759d",
                                        "glosses": [
                                            "Éprouver un vif déplaisir, un violent dépit de quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f143e94a-f3f7-4680-be31-b3c8024304e9",
                                                "sense_id": "3d513d56-84e9-3de9-8c8b-57996d7dbae0",
                                                "text": "Elles enrageront toutes de ne pas avoir ton goût."
                                            },
                                            {
                                                "example_id": "9f81ea81-deda-44db-ac66-65d0b117e830",
                                                "sense_id": "3d513d56-84e9-3de9-8c8b-57996d7dbae0",
                                                "text": "Les délinquants s’amusèrent à comploter des délits inconstatables, et la vieille moustache enragea de son impuissance."
                                            },
                                            {
                                                "example_id": "8c5531d0-c874-4421-95b5-ab6c0795356d",
                                                "sense_id": "3d513d56-84e9-3de9-8c8b-57996d7dbae0",
                                                "text": "Quant à ceux qui, dans ce monde de richards, n'ont pour subsister que leurs salaires, ils enragent, ils maugréent; ils se considèrent comme des déshérités."
                                            },
                                            {
                                                "example_id": "1ff43166-b0b3-4617-a4fa-41620483804c",
                                                "sense_id": "3d513d56-84e9-3de9-8c8b-57996d7dbae0",
                                                "text": "Elle enrageait de ne pas être sortie major."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52bdf52d-526c-398b-98fe-e2f77002a7d7",
                                        "entry_id": "bbb0ce3a-d319-3a0e-977d-e236a937759d",
                                        "glosses": [
                                            "S’obstiner."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5762513e-7334-4fd0-b6dd-119aa4d2fc0a",
                                                "sense_id": "52bdf52d-526c-398b-98fe-e2f77002a7d7",
                                                "text": "C’était donc fini ? Elle ne le persécuterait plus, elle ne s’enragerait plus à tout voler, à tout brûler ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab5a36d3-8f87-4fab-9580-7e4ec79ea489",
                        "source_entry_id": "d9a3bc1b-c4c8-31fa-9ab2-b9a57f381389",
                        "source_sense_description": "проявиться бурно",
                        "target_lang_word": "se déchaîner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se déchaîner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e473abe-3494-3dc1-9e0c-e12004d3e9b4",
                                        "entry_id": "e8eb6a14-7b84-39b9-92bf-2ed1fa35e2bf",
                                        "glosses": [
                                            "Faire une action soudaine, de façon véhémente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ef866de-2928-40a4-b9df-cda16c6661b2",
                                                "sense_id": "2e473abe-3494-3dc1-9e0c-e12004d3e9b4",
                                                "text": "Les colères entassées fermentant dans le silence depuis vingt ans, grondaient de toutes parts ; la pensée se déchaînait, les livres qui d’ordinaire n’entraient en France que secrètement, commençaient à s’éditer à Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88d4f888-839a-3f89-b608-a1de63de3cfe",
                                        "entry_id": "e8eb6a14-7b84-39b9-92bf-2ed1fa35e2bf",
                                        "glosses": [
                                            "S’emporter avec violence contre quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "755b7531-e5fe-4f0d-914c-7a30191d0e50",
                                                "sense_id": "88d4f888-839a-3f89-b608-a1de63de3cfe",
                                                "text": "Je ne sais pourquoi il se déchaîne si fort contre vous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
