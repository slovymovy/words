                                        "glosses": [
                                            "Estado del ánimo en el que no se siente inclinación ni rechazo a una cosa o persona."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ffc883c-5399-4bb4-ba71-817d24d547e4",
                                                "sense_id": "aa528701-3df9-3ada-81ed-8ed88d1e91ce",
                                                "text": "A todos afligió la indiferencia con que hice mi primera comunión. Jamás me conturbó un retiro, ni una prédica. ¡Dios me parecía tan lejano, y tan severo!"
                                            }
