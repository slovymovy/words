                        "examples": [
                            {
                                "example_id": "62a825c0-f00a-42e7-8d76-4ec1f7a6775a",
                                "sense_id": "a5304c2a-8ca0-3cbf-a37f-e5f0ee90447d",
                                "text": "Mais il y a une tétrachiée de trucs dont je voudrais te parler. Tu sais comment je bosse. On a besoin de les écouter ensemble."
                            },
                            {
                                "example_id": "80223118-d5cb-4acc-86b7-97a1bfecc7d2",
                                "sense_id": "a5304c2a-8ca0-3cbf-a37f-e5f0ee90447d",
                                "text": "Je ne compte plus la « tétrachiée » de sites internet spécialisés en la matière, d'articles ou de livres que j'avais assidûment parcourus puis utilisés comme torchère pour allumer mon barbecue."
                            },
                            {
                                "example_id": "10c9fc9a-4fed-4702-a8ad-42638dac990b",
                                "sense_id": "a5304c2a-8ca0-3cbf-a37f-e5f0ee90447d",
                                "text": "Heure de bureau après heure de bureau, et même le week-end, on compile à la chaîne des tétrachiées de données et des tronçons de formules toutes cuites."
                            }
                        ]
                    }
