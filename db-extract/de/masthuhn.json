                "senses": [
                    {
                        "sense_id": "38d61628-b040-3652-ac6c-5a0e81f6ec17",
                        "entry_id": "81b2c429-6c14-37a7-99c1-e6082a313074",
                        "glosses": [
                            "weibliches Huhn (Henne), das bis zum Erreichen eines bestimmten Gewichts gemästet wurde/wird/werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19c7102f-6819-4c3b-8992-8d948daa0618",
                                "sense_id": "38d61628-b040-3652-ac6c-5a0e81f6ec17",
                                "text": "Viele Masthühner sind in der Massentierhaltung schlechten Lebensbedingungen ausgesetzt."
                            },
                            {
                                "example_id": "512ae1a0-002b-47f9-bfe0-b1fdcd6adc94",
                                "sense_id": "38d61628-b040-3652-ac6c-5a0e81f6ec17",
                                "text": "Ein Masthuhn ist schon nach vier bis sechs Wochen schlachtreif."
                            },
                            {
                                "example_id": "53626725-2bbf-48e9-b41c-f68326d36dcb",
                                "sense_id": "38d61628-b040-3652-ac6c-5a0e81f6ec17",
                                "text": "„»Masthühner« leiden dabei nicht nur unter ihren Haltungsbedingungen oder einem brutalen Umgang, sondern auch unter den Folgen von Qualzucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
