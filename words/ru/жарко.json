                    "synonyms": [
                        "знойно"
                    ],
                    "antonyms": [
                        "морозно"
                    ],
                    "common_phrases": [
                        "очень жарко",
                        "на улице жарко",
                        "сегодня жарко"
                    ],
                    "target_lang_definitions": {
                        "en": "Regarding high air temperature; when the weather is very warm.",
                        "de": "Bezieht sich auf eine hohe Lufttemperatur; wenn das Wetter sehr warm ist."
                    },
                    "translations": {
                        "en": [
                            {
