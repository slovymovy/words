                                        "examples": [
                                            {
                                                "example_id": "ffc59f86-147e-4859-902b-42f32ba01c55",
                                                "sense_id": "55f96c44-d1b5-3ccc-b909-874d944d1dfd",
                                                "text": "En 2018, les états membres de l’OMS se sont mis d’accord sur une feuille de route visant à réduire la prévalence de l’inactivité physique chez les ados de 15 % d’ici à 2030."
                                            },
                                            {
                                                "example_id": "d00d0b13-c68d-4db5-82eb-851aaa7ab087",
                                                "sense_id": "55f96c44-d1b5-3ccc-b909-874d944d1dfd",
                                                "text": "Dès le début juillet, des centaines d’experts sonnaient pourtant très publiquement l’alarme auprès de l’OMS sur la propagation possible de la COVID-19 par aérosols."
                                            },
                                            {
                                                "example_id": "eaa56cb8-3120-4363-be45-8a8a560dca47",
                                                "sense_id": "55f96c44-d1b5-3ccc-b909-874d944d1dfd",
                                                "text": "Les nouvelles lignes directrices de l’OMS recommandent 150 à 300 minutes d’activité physique par semaine pour tous les adultes ainsi qu’une moyenne de 60 minutes quotidiennes pour les enfants et les adolescents."
                                            }
                                        ]
