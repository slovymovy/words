                        "glosses": [
                            "in strijd met de goede vormen en normen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0378879e-b6ef-4424-8f5a-daf6ac42bd85",
                                "sense_id": "5129eae4-46d2-32c0-964f-7317698d740e",
                                "text": "In weer een andere brief kregen we de volgende historische puntenverdeling aangereikt, toen de preek ging over de val in het paradijs: 1) valbaar geschapen, 2) herstelbaar gevallen, 3) onvalbaar hersteld. Dat doet denken aan een van de vele boeken van Willem Teellinck, waarvan de titel luidt: ”Adam rechtschapen, wanschapen, herschapen”."
                            }
                        ]
