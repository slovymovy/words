                                "target_senses": [
                                    {
                                        "sense_id": "ffa9142f-57e2-3474-a148-7d621aa1efba",
                                        "entry_id": "283fba64-bfd9-372e-b5f8-7fde62ed3889",
                                        "glosses": [
                                            "Tailler de nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "753d923a-f375-4bcc-b220-f335cb71ba06",
                                                "sense_id": "ffa9142f-57e2-3474-a148-7d621aa1efba",
                                                "text": "Les marcs ou aines, sont souvent retaillés, humectés d’un peu d’eau et repressés ; ils donnent ainsi un cidre léger, dit retaille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7840d7ca-d5e9-3372-bffb-d5aec7ab21e1",
                                        "entry_id": "283fba64-bfd9-372e-b5f8-7fde62ed3889",
                                        "glosses": [
                                            "Agir en tant que retaille, annuler au dernier moment."
                                        ],
                                        "tags": [
                                            "Lyonnais"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d5f72a6-c96a-4d75-9b2b-570c0a6da1c7",
                        "source_entry_id": "3daff1a0-bfc8-3fea-a899-a7e641ca0c8a",
                        "source_sense_description": "скроить заново, иначе",
                        "target_lang_word": "recouper",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recouper",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e580d9d3-2fc6-3359-8ae5-079e725dce49",
                                        "entry_id": "2223ed7e-f1b5-31d6-84e7-65929f3464b4",
                                        "glosses": [
                                            "Couper de nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2bdcca6-040b-4bb4-954d-7505bd01b635",
                                                "sense_id": "e580d9d3-2fc6-3359-8ae5-079e725dce49",
                                                "text": "Ce vêtement avait été mal coupé, il a fallu le recouper."
                                            },
                                            {
                                                "example_id": "6324bdda-ff0b-4c26-a19a-ec79de591bf3",
                                                "sense_id": "e580d9d3-2fc6-3359-8ae5-079e725dce49",
                                                "text": "Aux jeux de cartes, lorsqu’on n’a pas coupé net, il faut recouper."
                                            },
                                            {
                                                "example_id": "88140ba4-c5e4-42e4-afac-09f997021b0a",
                                                "sense_id": "e580d9d3-2fc6-3359-8ae5-079e725dce49",
                                                "text": "Le massif dioritique de Lesterps, que la route de Bussière-Boffy recoupe transversalement sur 3 kilomètres, est en disposition synclinale : les gneiss plongent sous la diorite aussi bien à l'Ouest, près de Lesterps, que sur la bordure est."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29d8789f-9415-3231-beb6-d9ec75abc2d1",
                                        "entry_id": "2223ed7e-f1b5-31d6-84e7-65929f3464b4",
                                        "glosses": [
                                            "Vérifier un fait ou une information en comparant deux ou plusieurs sources différentes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9a83ea8-2bc1-47c2-a5e3-c4756398e090",
                                                "sense_id": "29d8789f-9415-3231-beb6-d9ec75abc2d1",
                                                "text": "Ils avaient peiné à s’accorder sur le sommaire final, elle, brassant les informations, soucieuse de recouper les sources, et lui, récrivant les textes qu’elle lui envoyait, alors qu’elle avait l’intention de les reproduire tels quels […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95aed735-13e6-322f-8891-82afe77095cf",
                                        "entry_id": "2223ed7e-f1b5-31d6-84e7-65929f3464b4",
                                        "glosses": [
                                            "Se rencontrer, se confirmer, correspondre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "547f44fc-5175-4b44-9149-a5c9d2cd710e",
                                                "sense_id": "95aed735-13e6-322f-8891-82afe77095cf",
                                                "text": "Ces deux témoignages se recoupent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ac533d0-1882-4591-8253-f26107fd8a9d",
                        "source_entry_id": "3daff1a0-bfc8-3fea-a899-a7e641ca0c8a",
                        "source_sense_description": "подвергнуть коренной переделке",
                        "target_lang_word": "remanier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remanier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8f6dfef-dd50-3e0b-986d-008f5f6a404c",
                                        "entry_id": "488ea85e-829f-399e-963f-6c2b40105c85",
                                        "glosses": [
                                            "Manier de nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b673e472-2435-4d17-b9dc-7b4110c56319",
                                                "sense_id": "f8f6dfef-dd50-3e0b-986d-008f5f6a404c",
                                                "text": "Il a manié et remanié ces étoffes sans avoir pu se décider pour aucune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89b46279-0b1a-39ea-85ac-5533785a0487",
                                        "entry_id": "488ea85e-829f-399e-963f-6c2b40105c85",
                                        "glosses": [
                                            "Modifier, refaire d’une autre façon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfd69a26-4bdb-4b73-becc-2eb6f7ca1261",
                                                "sense_id": "89b46279-0b1a-39ea-85ac-5533785a0487",
                                                "text": "Remanier le pavage."
                                            },
                                            {
                                                "example_id": "df2a7f99-efc0-4135-b562-05d465e7e44d",
                                                "sense_id": "89b46279-0b1a-39ea-85ac-5533785a0487",
                                                "text": "Remanier la couverture d’une maison."
                                            },
                                            {
                                                "example_id": "c5d35f00-a328-4b07-aefb-9ec661fcc588",
                                                "sense_id": "89b46279-0b1a-39ea-85ac-5533785a0487",
                                                "text": "Il ne voulut rien entendre, une équipe de garçons dut remanier l’exposition des ombrelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f2a6396-6f2a-34b2-9be9-a2a479633671",
                                        "entry_id": "488ea85e-829f-399e-963f-6c2b40105c85",
                                        "glosses": [
                                            "Retoucher, retravailler, changer de façon importante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26434a71-9668-4ca9-acfd-98192618e242",
                                                "sense_id": "1f2a6396-6f2a-34b2-9be9-a2a479633671",
                                                "text": "Je l'ai remanié, corrigé, repoli de mon mieux."
                                            },
                                            {
                                                "example_id": "9a4d9286-55d8-4857-a84d-be63b6397f85",
                                                "sense_id": "1f2a6396-6f2a-34b2-9be9-a2a479633671",
                                                "text": "Un éditeur […] lui proposa de rafistoler les manuscrits d'un grand faiseur feuilletonnesque. […]. Henri se mit à la besogne, remania l'infâme et crasseuse foutaise du romancier célèbre, pimenta cette ratatouille sans goût."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c0233d8-5398-3358-9cfe-5c941d7b91ab",
                                        "entry_id": "488ea85e-829f-399e-963f-6c2b40105c85",
                                        "glosses": [
                                            "Remettre plusieurs lignes en galée pour les recomposer, souvent en raison d’une erreur (coquille, bourdon, doublon) dont la correction nécessite de changer la disposition des mots."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c217497-1e26-4a8e-9fbc-4a7aa7364c79",
                                                "sense_id": "3c0233d8-5398-3358-9cfe-5c941d7b91ab",
                                                "text": "La régularité de l'espacement ne doit pas être moins respectée à la correction qu'à la composition ; il ne faut pas serrer outre mesure les mots pour faire entrer dans la ligne les lettres omises, ni les écarter trop non plus pour combler le vide fait par une suppression. En pareil cas, il est indispensable de remanier le nombre de lignes nécessaire pour revenir à la régularité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f282849-1ed4-3c7e-81a7-1019f4fc3eba",
                                        "entry_id": "488ea85e-829f-399e-963f-6c2b40105c85",
                                        "glosses": [
                                            "Changer une organisation, reprendre en main."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a440306-df95-42c7-819b-057e7c7c5f60",
                                                "sense_id": "6f282849-1ed4-3c7e-81a7-1019f4fc3eba",
                                                "text": "Remanier le gouvernement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a34b454-64b1-4487-a9ab-e8f56a3805af",
                        "source_entry_id": "3daff1a0-bfc8-3fea-a899-a7e641ca0c8a",
                        "source_sense_description": "подвергнуть коренной переделке",
                        "target_lang_word": "refaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b1e25204-bd2d-333a-bd3e-574cbf1a9cdc",
                                        "entry_id": "82a1be5b-01c2-3c94-97f3-c30a7b1a982f",
                                        "glosses": [
                                            "Faire de nouveau ce qu’on a déjà fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50e15765-76a3-4280-b191-995fecf1499d",
                                                "sense_id": "b1e25204-bd2d-333a-bd3e-574cbf1a9cdc",
                                                "text": "— Vois-tu, cousin, tout est possible à Paris, en bien comme en mal, juste et injuste. Tout s’y fait, tout s’y défait, tout s’y refait."
                                            },
                                            {
                                                "example_id": "ae205aca-4ca4-49b0-a1b6-3c594fc11409",
                                                "sense_id": "b1e25204-bd2d-333a-bd3e-574cbf1a9cdc",
                                                "text": "Mais le Firecrest faisait toujours un peu d'eau, et je décidai de le remettre une nouvelle fois à terre et de terminer par là où j'aurais dû commencer en enlevant complétement le doublage en cuivre et en refaisant le calfatage de la coque."
                                            },
                                            {
                                                "example_id": "310467e7-e0c6-4235-9437-bf47fe36000f",
                                                "sense_id": "b1e25204-bd2d-333a-bd3e-574cbf1a9cdc",
                                                "text": "Refaire un voyage, un ouvrage, un discours."
                                            },
                                            {
                                                "example_id": "900f8811-a32c-4835-b725-7424d6332351",
                                                "sense_id": "b1e25204-bd2d-333a-bd3e-574cbf1a9cdc",
                                                "text": "C’est un homme qui passe sa vie à faire, défaire et refaire."
                                            },
                                            {
                                                "example_id": "ee45ca83-6559-458f-8de6-e347b050de7c",
                                                "sense_id": "b1e25204-bd2d-333a-bd3e-574cbf1a9cdc",
                                                "text": "Tout ce qu’il a fait est à refaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "840cb0d9-a243-3dd5-a6d6-497e48ecbde7",
                                        "entry_id": "82a1be5b-01c2-3c94-97f3-c30a7b1a982f",
                                        "glosses": [
                                            "Faire une chose pour la première fois, mais à l’imitation de quelqu’un qui l’a déjà faite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb994976-c90b-4375-bb8b-be752cac6fef",
                                                "sense_id": "840cb0d9-a243-3dd5-a6d6-497e48ecbde7",
                                                "text": "Cet auteur ne doute de rien, il a voulu refaire un Misanthrope, une Esther."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aee7f4c6-4b0c-3e6f-94e2-9a9473c9988d",
                                        "entry_id": "82a1be5b-01c2-3c94-97f3-c30a7b1a982f",
                                        "glosses": [
                                            "Réparer, raccommoder, rajuster une chose ruinée ou abîmée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "362d756d-2680-43c5-9a6e-86e03debaaf5",
                                                "sense_id": "aee7f4c6-4b0c-3e6f-94e2-9a9473c9988d",
                                                "text": "Avec les sous que nous allons recevoir du Pape, nous pourrons refaire la grange, repaver l’écurie et reblanchir la cuisine."
                                            },
                                            {
                                                "example_id": "1624fc90-4e9f-453f-ab64-8d2efc058410",
                                                "sense_id": "aee7f4c6-4b0c-3e6f-94e2-9a9473c9988d",
                                                "text": "Soucis d’argent, de santé, calculs de l’ambition et de la jalousie, tout était là, devant elle, comme ces devoirs d’écolier où le maître a écrit : à refaire."
                                            },
                                            {
                                                "example_id": "bb28ec22-4a39-417b-b4ac-6f7c20273cbd",
                                                "sense_id": "aee7f4c6-4b0c-3e6f-94e2-9a9473c9988d",
                                                "text": "Moins timides, les merlesses se refaisaient en hâte un brin de toilette sur leur branche et regardaient passer le jeune homme d’un œil frais."
                                            },
                                            {
                                                "example_id": "2d1a682e-01e1-4f17-8ab5-3c7e3e53ad48",
                                                "sense_id": "aee7f4c6-4b0c-3e6f-94e2-9a9473c9988d",
                                                "text": "Refaire un vêtement. — Se refaire une beauté. — Refaire son maquillage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df8c07f2-dc53-378f-8707-b1e0726381ee",
                                        "entry_id": "82a1be5b-01c2-3c94-97f3-c30a7b1a982f",
                                        "glosses": [
                                            "Recommencer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1fafe43-8a0f-4316-a592-54f938a40fa2",
                                                "sense_id": "df8c07f2-dc53-378f-8707-b1e0726381ee",
                                                "text": "Mermoz allait dans son bureau contempler la carte. Il faisait et refaisait les calculs. Oui, selon la direction et la force des vents, il mettrait de vingt à vingt-quatre heures pour aller de Dakar à Natal en avion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09727af4-a876-33fc-b951-92f0d7a5e260",
                                        "entry_id": "82a1be5b-01c2-3c94-97f3-c30a7b1a982f",
                                        "glosses": [
                                            "Remettre en vigueur et en bon état."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc9862c8-76dc-405d-91ac-7a2a94b5cb13",
                                                "sense_id": "09727af4-a876-33fc-b951-92f0d7a5e260",
                                                "text": "Rien n’est capable de refaire un malade comme le bon air."
                                            },
                                            {
                                                "example_id": "42c8d7c1-2793-4a4d-bbfe-0a114d91d339",
                                                "sense_id": "09727af4-a876-33fc-b951-92f0d7a5e260",
                                                "text": "Envoyer des chevaux à l’herbe pour les refaire."
                                            },
                                            {
                                                "example_id": "98117401-1ec9-4daa-8b51-010d3e8d1be7",
                                                "sense_id": "09727af4-a876-33fc-b951-92f0d7a5e260",
                                                "text": "Il va à la campagne pour se refaire."
                                            },
                                            {
                                                "example_id": "ff94cd5c-e09f-482d-b59f-6e41b2da01ff",
                                                "sense_id": "09727af4-a876-33fc-b951-92f0d7a5e260",
                                                "text": "Ce cheval s’est bien refait depuis peu."
                                            },
                                            {
                                                "example_id": "cc8adc2a-611a-40fa-95b2-b67c5dcd5a23",
                                                "sense_id": "09727af4-a876-33fc-b951-92f0d7a5e260",
                                                "text": "Cette armée s’est refaite dans ses quartiers d’hiver."
                                            },
                                            {
                                                "example_id": "cf663600-44c3-4d8a-98eb-f812a8bf1f02",
                                                "sense_id": "09727af4-a876-33fc-b951-92f0d7a5e260",
                                                "text": "Un loup chasse encore à trois cents pas à peine de la maison… Bonne chance ! frère ! tue et refais-toi. Puis, dors tout le jour, bien au chaud, sur ton lit de feuilles sèches !…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8f8c64c-efc3-339d-aff7-f702c30fa34f",
                                        "entry_id": "82a1be5b-01c2-3c94-97f3-c30a7b1a982f",
                                        "glosses": [
                                            "Réapprovisionner."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f93a00ce-45dc-4a28-83b2-b7d922313323",
                                                "sense_id": "f8f8c64c-efc3-339d-aff7-f702c30fa34f",
                                                "text": "Le train ne s’arrêtera aux stations secondaires de la ligne que le temps de refaire son eau et son combustible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b982eb27-19e5-33a9-9eba-4d1670df40d6",
                                        "entry_id": "82a1be5b-01c2-3c94-97f3-c30a7b1a982f",
                                        "glosses": [
                                            "Tromper, duper."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2ce1d8d-91ea-4d8c-83e5-4822d0d91dd3",
                                                "sense_id": "b982eb27-19e5-33a9-9eba-4d1670df40d6",
                                                "text": "Le Foirond a été refait et comment. J'ai payé les trois premières traites et j'ai laissé protester les autres, sous prétexte que le pinard tournait. Aujourd'hui je n'ai pas encore payé et je ne payerai point."
                                            },
                                            {
                                                "example_id": "a51ccb54-f483-4870-9b07-61a80e98016a",
                                                "sense_id": "b982eb27-19e5-33a9-9eba-4d1670df40d6",
                                                "text": "Il s’est déshonoré, le mec ! Pas être foutu de refaire une poule sans se faire paumer par la garde ! Et se faire allonger par un tringlot, un gars du Royal Cambouis ! C’est ça qui dépasse tout !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7a619f0-dcf5-3a93-99c8-06beaedc4928",
                                        "entry_id": "82a1be5b-01c2-3c94-97f3-c30a7b1a982f",
                                        "glosses": [
                                            "Redonner les cartes."
                                        ],
                                        "tags": [
                                            "Jeu de cartes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c3dd903-e5ef-4655-8448-9b536ebbeeb8",
                                                "sense_id": "a7a619f0-dcf5-3a93-99c8-06beaedc4928",
                                                "text": "Vous avez mal donné, il faut refaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c1dc077-dd62-3755-98d7-8baac83ae61f",
                                        "entry_id": "82a1be5b-01c2-3c94-97f3-c30a7b1a982f",
                                        "glosses": [
                                            "Rétablir sa fortune, se récupérer de ses pertes."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4d8696a-b906-4e12-b352-147acbb2589f",
                                                "sense_id": "8c1dc077-dd62-3755-98d7-8baac83ae61f",
                                                "text": "Commencer à se refaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62ee708e-a409-3ad4-9ec3-48b65a7340a9",
                                        "entry_id": "82a1be5b-01c2-3c94-97f3-c30a7b1a982f",
                                        "glosses": [
                                            "Rétablir sa fortune, se récupérer de ses pertes.",
                                            "Regagner ce qu’on avait perdu."
                                        ],
                                        "tags": [
                                            "especially",
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "69be2933-5247-3422-b610-fd95bd83109b",
                                        "entry_id": "82a1be5b-01c2-3c94-97f3-c30a7b1a982f",
                                        "glosses": [
                                            "Reregarder quelque chose."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd128b28-2dae-436a-a3cc-9646a14722eb",
                                                "sense_id": "69be2933-5247-3422-b610-fd95bd83109b",
                                                "text": "Je me refais The Walking Dead."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee714557-ccb0-49d8-9e1a-168a09ad110d",
