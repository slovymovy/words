                        "sense_id": "950f9178-e77a-39bf-9043-260568a05ef0",
                        "entry_id": "154947ad-1b39-3988-bb84-215d491e3633",
                        "glosses": [
                            "Gesamtheit der Bekleidungsstücke, die für den Sommer geeignet sind, weil sie weniger Haut bedecken und luftiger sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95f6149c-ad97-4936-a7bb-15935071ccb1",
                                "sense_id": "950f9178-e77a-39bf-9043-260568a05ef0",
                                "text": "Zur typischen Sommerkleidung gehören eine kurze Hose und Sandalen."
                            },
                            {
                                "example_id": "99e7ea02-5510-488b-b8b5-ecc01d62ccb4",
                                "sense_id": "950f9178-e77a-39bf-9043-260568a05ef0",
                                "text": "„Ich entschuldigte mich sogleich für den Ball und sagte, der Wahrheit entsprechend, ich hätte nur Sommerkleidung und einen schwarzen Rock bei mir.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
