                ],
                "senses": [
                    {
                        "sense_id": "e5cfcf76-36e0-3bc8-bd4e-d994cb17c131",
                        "entry_id": "2f049b3e-d3a0-3e65-80c0-25a6de35c8ed",
                        "glosses": [
                            "Border une voile de ralingues."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39ed055e-4fec-49d3-a0b4-0fcfe8fcaff2",
                                "sense_id": "e5cfcf76-36e0-3bc8-bd4e-d994cb17c131",
                                "text": "Les voiles sont faites, il n’y a plus qu’à les ralinguer."
                            }
                        ]
                    },
                    {
                        "sense_id": "05935185-46cf-33e4-820e-e2e17e9f8f44",
                        "entry_id": "2f049b3e-d3a0-3e65-80c0-25a6de35c8ed",
                        "glosses": [
                            "Orienter les voiles de manière à ce que leur plan se trouve dans la direction du vent."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5020458a-d2bc-3314-bdcd-18640ec8f861",
                        "entry_id": "2f049b3e-d3a0-3e65-80c0-25a6de35c8ed",
                        "glosses": [
                            "Battre, ne plus prendre le vent."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "12aa8a66-ec15-4bcd-a714-cdbf69b92118",
                                "sense_id": "5020458a-d2bc-3314-bdcd-18640ec8f861",
                                "text": "Les focs ralinguaient, tandis que le hunier et le flèche recevaient les derniers souffles venus du couchant."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f13c0eb-2eee-3c38-a12c-d92debbfb18f",
                        "entry_id": "2f049b3e-d3a0-3e65-80c0-25a6de35c8ed",
                        "glosses": [
                            "Battre au vent."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1923febc-008b-4d98-8d06-507a4968c256",
                                "sense_id": "4f13c0eb-2eee-3c38-a12c-d92debbfb18f",
                                "text": "Hormis ces gardes centrafricains en uniforme impeccable et au garde-à-vous, entonnant à l’aube l’hymne national avant d’effectuer le salut au drapeau qui ralingue au vent, sur une place en terre battue bordée de 4 × 4 et de camions cabossés, les maîtres de ces lieux sont tous occidentaux et rompus aux réalités des conflits qui ravagent le continent."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e9a4962-875e-3533-a3fb-51ff5e854698",
                        "entry_id": "2f049b3e-d3a0-3e65-80c0-25a6de35c8ed",
                        "glosses": [
                            "Frissonner de froid et trembler comme une voile qui ralingue."
                        ],
                        "tags": [
                            "analogy",
                            "familiar",
                            "figuratively",
                            "intransitive"
                        ],
                        "examples": []
                    }
