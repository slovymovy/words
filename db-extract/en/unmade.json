                    },
                    {
                        "sense_id": "d2c62e57-9e2e-3a07-a56c-a276aeeeda01",
                        "entry_id": "82cfc140-800f-3c03-9dd5-38dc8f0c15de",
                        "glosses": [
                            "Without a hard, smooth, permanent surface."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "e215a05c-7f09-4394-ae2d-d87779592a9e",
                                "sense_id": "d2c62e57-9e2e-3a07-a56c-a276aeeeda01",
                                "text": "[E]ven when it turned off the unmade road and went steeply upwards along an even more unmade track, I was still exhilarated […]."
                            },
                            {
                                "example_id": "3fc42d17-eccf-4b3b-9794-f0a3b9646917",
                                "sense_id": "d2c62e57-9e2e-3a07-a56c-a276aeeeda01",
                                "text": "It was an unexpected benefit to early rail investors that passengers had an appetite for travel, which up to then had been a tortuous experience on largely unmade roads and involving stays at coaching inns that provided variable amenities."
                            }
                        ]
                    }
