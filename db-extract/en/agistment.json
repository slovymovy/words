                        "cross_references": [
                            {
                                "target_word": "Pension",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d7bfe0d-bb28-35e9-8f50-7c745f878876",
                                        "entry_id": "c48c5eac-50fa-30e5-a4ef-ad42f01320eb",
                                        "glosses": [
                                            "kleiner Hotelbetrieb mit meist privater Atmosphäre"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5a2fc6a-be8c-431e-b4df-f834525589b1",
                                                "sense_id": "2d7bfe0d-bb28-35e9-8f50-7c745f878876",
                                                "text": "Ich übernachte in einer Pension."
                                            },
                                            {
                                                "example_id": "93697398-2fea-4407-8689-162875c2b8c1",
                                                "sense_id": "2d7bfe0d-bb28-35e9-8f50-7c745f878876",
                                                "text": "„Neben mir in der Pension wohnt eine Russin…“"
                                            },
                                            {
                                                "example_id": "b584c4a9-d684-46b2-88d2-91ae6bf72b34",
                                                "sense_id": "2d7bfe0d-bb28-35e9-8f50-7c745f878876",
                                                "text": "„Hinter dem Tor der Pension wartete ein hellgrauer Hund mit vielen schwarzen Streifen im Fell.“"
                                            },
                                            {
                                                "example_id": "96397bb5-85a5-487b-81f6-6afaf55966d0",
                                                "sense_id": "2d7bfe0d-bb28-35e9-8f50-7c745f878876",
                                                "text": "„In Köln hatten wir in einer Pension gewohnt, in Hotels gibt es nur Telefonklingeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fcc2227b-f07c-38e1-8189-c564b208c553",
                                        "entry_id": "c48c5eac-50fa-30e5-a4ef-ad42f01320eb",
                                        "glosses": [
                                            "regelmäßige Geldzahlung der Altersversorgung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5e273ad-8578-4b5f-969c-22e4b6e67f24",
                                                "sense_id": "fcc2227b-f07c-38e1-8189-c564b208c553",
                                                "text": "Die Pension der Beamten muss versteuert werden."
                                            },
                                            {
                                                "example_id": "a113f100-1735-4076-ad8f-816b45176d5c",
                                                "sense_id": "fcc2227b-f07c-38e1-8189-c564b208c553",
                                                "text": "Früher unterschied man das Altersruhegeld nach der Pension der Beamten und der Rente der Arbeitnehmer."
                                            },
                                            {
                                                "example_id": "9aec43fe-6fc9-45b7-8910-e3f7148d8351",
                                                "sense_id": "fcc2227b-f07c-38e1-8189-c564b208c553",
                                                "text": "„Da kommt ein einziger Dax-Vorstandschef Berechnungen zufolge auf Pensionszusagen von 30 Millionen Euro, insgesamt liegt die Summe der Rückstellungen für Pensionen im Dax bei sagenhaften 637 Millionen Euro.“"
                                            },
                                            {
                                                "example_id": "944a950f-2423-4aab-b4ca-db497f212687",
                                                "sense_id": "fcc2227b-f07c-38e1-8189-c564b208c553",
                                                "text": "„Er ist ebenfalls 68 Jahre alt und könnte seine Pension genießen.“"
                                            },
                                            {
                                                "example_id": "03124e9d-68ec-412b-8c6b-951d059f8094",
                                                "sense_id": "fcc2227b-f07c-38e1-8189-c564b208c553",
                                                "text": "„Knopf, der alte Militär, gibt von seiner Pension keinen Pfennig an den Haushalt ab; dafür haben die vier Frauen zu sorgen.“"
                                            },
                                            {
                                                "example_id": "78e05675-5597-4431-b82f-edfce5dbce8f",
                                                "sense_id": "fcc2227b-f07c-38e1-8189-c564b208c553",
                                                "text": "„Er selbst gab stets zur Antwort, er sei noch immer Logenbruder der Freimaurer, die ihm eine bescheidene lebenslängliche Pension ausgesetzt hätten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "88bf4620-0483-3b2e-abd9-bfab8d4b96e6",
                                        "entry_id": "c48c5eac-50fa-30e5-a4ef-ad42f01320eb",
                                        "glosses": [
                                            "Zeit nach dem aktiven Arbeits- oder Erwerbsleben, Ruhestand"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afc267b6-6c41-46f0-81bd-9644dc6523d6",
                                                "sense_id": "88bf4620-0483-3b2e-abd9-bfab8d4b96e6",
                                                "text": "Beamte gehen mit 65 Jahren in Pension."
                                            },
                                            {
                                                "example_id": "94e1d08b-5779-497e-932a-289045bad61d",
                                                "sense_id": "88bf4620-0483-3b2e-abd9-bfab8d4b96e6",
                                                "text": "Seit dem Sommer sind die beiden ältesten Reitschulpferde in Pension."
                                            },
                                            {
                                                "example_id": "b6c22719-7aa4-4a90-9628-1ccde69e30f5",
                                                "sense_id": "88bf4620-0483-3b2e-abd9-bfab8d4b96e6",
                                                "text": "„[Ferdinand Käs] leitete bis 1963 als Oberstleutnant die Gendarmerieschule und war 1963-1979 im Innenministerium tätig (ging als Sektionschef in Pension).“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "93934ac7-de4b-3238-b37b-4a4310cc0e1c",
                                        "entry_id": "c48c5eac-50fa-30e5-a4ef-ad42f01320eb",
                                        "glosses": [
                                            "Ort der vorübergehenden Unterbringung für auswärts Studierende, aber auch für Tiere oder Pflanzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4351171f-290e-440e-8100-d387cefd18a2",
                                                "sense_id": "93934ac7-de4b-3238-b37b-4a4310cc0e1c",
                                                "text": "Berliner wird den Jungen wahrscheinlich zu Dr. Pfeffer in Pension geben; dort ist es zehn Mark billiger."
                                            },
                                            {
                                                "example_id": "3fbc55da-7d3b-4c12-a814-d3193876293c",
                                                "sense_id": "93934ac7-de4b-3238-b37b-4a4310cc0e1c",
                                                "text": "Eine anständige israelitische Familie in Magdeburg will einen Knaben, der eine Schule oder ein Handlungshaus frequentiert, in Pension nehmen."
                                            },
                                            {
                                                "example_id": "7edf274e-99c1-45ac-96e6-6515227b2acd",
                                                "sense_id": "93934ac7-de4b-3238-b37b-4a4310cc0e1c",
                                                "text": "Für die Zeit ihrer Reise geben sie ihren Hund bei Nachbarn in Pension."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
