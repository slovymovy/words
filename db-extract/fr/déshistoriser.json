                "senses": [
                    {
                        "sense_id": "973f0e48-72e4-3268-9126-29bfac0b05a6",
                        "entry_id": "d721f857-2fed-360f-9d5c-90798914ef77",
                        "glosses": [
                            "Faire perdre son caractère historique à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d16d6ff1-0128-41bf-89d7-6d0b7a52aab6",
                                "sense_id": "973f0e48-72e4-3268-9126-29bfac0b05a6",
                                "text": "S’agit-il en effet d’un effort délibéré de déshistoriser la violence, de ne pas la mettre en scène dans une incarnation historiquement concrète ?"
                            },
                            {
                                "example_id": "3e369d54-2e7e-4c45-a864-5e2440cc6c0a",
                                "sense_id": "973f0e48-72e4-3268-9126-29bfac0b05a6",
                                "text": "En d’autres termes, l’évocation de l’histoire du monde dans l’essai de définition de la loi royale vise précisément à « déshistoriser » le transfert, à éviter de tenir pour un événement fondateur les Cortes de Tomar ou même la fondation miraculeuse du royaume de Portugal par Afonso Henriques."
                            },
                            {
                                "example_id": "8fe2b458-92e2-4d01-86c3-7390a6bbb79d",
                                "sense_id": "973f0e48-72e4-3268-9126-29bfac0b05a6",
                                "text": "Les « sociologues » allemands, après l’intermède que constituent le « Socialisme de la chaire » et l’ « Organicisme », vont donc s’employer à déséconomiser et déshistoriser la société."
                            }
                        ]
                    }
                ],
