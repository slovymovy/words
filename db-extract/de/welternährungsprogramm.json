                        "examples": [
                            {
                                "example_id": "50d4bd35-80d8-44aa-8e07-a5c4cc45f436",
                                "sense_id": "52531316-735b-317d-8ae5-ba32b688eb86",
                                "text": "„Eine im April 2001 in 24 Provinzen durchgeführte Untersuchung des Welternährungsprogramms ergab, dass 2001 aufgrund von Dürre und fehlendem Saatgut 50 Prozent der Agrarfläche nicht bewirtschaftet werden würde; 70 Prozent der Viehbestände waren zugrunde gegangen, weil Wasser und Weiden fehlten.“"
                            },
                            {
                                "example_id": "f8534598-4375-4468-b152-6acf0965a247",
                                "sense_id": "52531316-735b-317d-8ae5-ba32b688eb86",
                                "text": "„Vorsichtig bewege ich mich am Cherokee entlang, öffne die hintere Tür und sehe eine Plastikflasche des Welternährungsprogramms.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
