                                "target_senses": [
                                    {
                                        "sense_id": "74fad916-84bf-3181-934b-ed204be21640",
                                        "entry_id": "8e76254e-be57-331c-ac7f-e4eb04d1e90f",
                                        "glosses": [
                                            "Nom de famille, connu entre autres par le peintre Georges Mathieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6bbc9a0-d24b-4b66-ae40-f939371d6626",
                                                "sense_id": "74fad916-84bf-3181-934b-ed204be21640",
                                                "text": "Ils avaient brûlé ce qu’ils avaient adoré : les miroirs de sorcière, les billots, les stupides petits mobiles, les radiomètres, les cailloutis multicolores, les panneaux de jute agrémentés de paraphes à la Mathieu."
                                            },
                                            {
                                                "example_id": "a8e04132-44e6-47c8-b163-10d7245e6463",
                                                "sense_id": "74fad916-84bf-3181-934b-ed204be21640",
                                                "text": "Didier Éribon, Nicolas Mathieu, Ariane Ascaride et Mattia Filice répondent aux questions de l’animateur Augustin Trapenard, qui met leur actualité littéraire en perspective."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Mathieu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
