                    }
                ],
                "senses": [
                    {
                        "sense_id": "78f8ebd5-27f5-3dc2-a82b-ec3a6a3574fe",
                        "entry_id": "f82460de-506f-3c07-93d0-a3d07ab75528",
                        "glosses": [
                            "тот, кто занимается штучным или мелкосерийным производством на дому или в небольших мастерских; ремесленник"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfc2b606-b7f7-47ee-9cd2-ff0128000df0",
                                "sense_id": "78f8ebd5-27f5-3dc2-a82b-ec3a6a3574fe",
                                "text": "Скупщик одет в тёплой шубе, кустари дрожат от пронизывающего ветра. ❬…❭ Он развёртывает образцы и равнодушно отодвигает одни, назначает цену за другие."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7690013-9e30-4604-8b60-4efc160deb25",
                        "source_entry_id": "f82460de-506f-3c07-93d0-a3d07ab75528",
                        "source_sense_id": "78f8ebd5-27f5-3dc2-a82b-ec3a6a3574fe",
                        "target_lang_word": "handicraftsman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "handicraftsman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d08528d2-f479-3ff8-b346-1d01f6b51209",
                                        "entry_id": "f497c489-39bc-3b3d-ac96-3526face0882",
                                        "glosses": [
                                            "A practitioner of a handicraft, usually male."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38df3ca2-7013-40e3-b79c-e0d03f12ee08",
                                                "sense_id": "d08528d2-f479-3ff8-b346-1d01f6b51209",
                                                "text": "I knowe, that a handie-crafts-man [translating artisan] will ſcarcely looke of his worke, to gaze vpon an ordinarie man: Whereas to ſee a notable great perſon come into a towne, he will leave both worke and ſhop."
                                            },
                                            {
                                                "example_id": "04c5c75a-038f-404e-99f2-fe370a9c0ee8",
                                                "sense_id": "d08528d2-f479-3ff8-b346-1d01f6b51209",
                                                "text": "Handy-Crafts-Men, of Strong, & Manly Arts, as Smiths, Maſons, Carpenters, &c"
                                            },
                                            {
                                                "example_id": "a84832bb-7d0e-46f6-8f41-73295bd02363",
                                                "sense_id": "d08528d2-f479-3ff8-b346-1d01f6b51209",
                                                "text": "He may, among the drunkards, be a hearty fellow, and, among sober handicraftsmen, a free-spoken gentleman; but he must have some better distinction, before he is a patriot."
                                            },
                                            {
                                                "example_id": "96285f1f-118a-4bfb-98b7-aa4d53112790",
                                                "sense_id": "d08528d2-f479-3ff8-b346-1d01f6b51209",
                                                "text": "Like all native handicraftsmen he sits down at his work."
                                            },
                                            {
                                                "example_id": "e1d46958-561c-4602-8e53-fa3effa2da95",
                                                "sense_id": "d08528d2-f479-3ff8-b346-1d01f6b51209",
                                                "text": "I know that a good honest handicraftsman, Erik, the glove-maker, has been your suitor; he is a widower without children, he is well off; think whether you cannot be content with him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee0dacb3-9f20-49c6-9b8c-09477d65bd8f",
                        "source_entry_id": "f82460de-506f-3c07-93d0-a3d07ab75528",
                        "source_sense_id": "78f8ebd5-27f5-3dc2-a82b-ec3a6a3574fe",
                        "target_lang_word": "artisan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artisan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a626c0b-0adb-3559-b881-988c70f95e1d",
                                        "entry_id": "b0d691a5-5b3f-3d35-aa98-9df2a49a1144",
                                        "glosses": [
                                            "A skilled manual worker who uses tools and machinery in a particular craft."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "596b5d3f-78f8-37b0-8c8b-ead51b97f606",
                                        "entry_id": "b0d691a5-5b3f-3d35-aa98-9df2a49a1144",
                                        "glosses": [
                                            "A person who displays great dexterity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "artisan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecf0abd8-7cfe-3896-b25a-b859d9e8d040",
                                        "entry_id": "6c77b797-ccdf-31d4-9406-cca04bf28e7a",
                                        "glosses": [
                                            "Artisanal."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b48dcaa-7a82-4fdd-8b44-432ce43069e4",
                                                "sense_id": "ecf0abd8-7cfe-3896-b25a-b859d9e8d040",
                                                "text": "Bread is either cheap (soft, squishy supermarket loaves) or expensive (artisan bakery loaves)."
                                            },
                                            {
                                                "example_id": "14771eac-33d7-41d0-b979-d1d28e9e619e",
                                                "sense_id": "ecf0abd8-7cfe-3896-b25a-b859d9e8d040",
                                                "text": "Cartier and Tiffany have some unlikely new neighbours near Sloane Square — a butcher, a greengrocer and a cheesemonger. […] The row of artisan food and drink shops also includes a wine merchant. A bakery is due to open in time for Christmas and a tenant is being sought for a sixth unit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6dc928e5-b314-4f5d-8830-dcb8e33fbe42",
                        "source_entry_id": "f82460de-506f-3c07-93d0-a3d07ab75528",
                        "source_sense_id": "78f8ebd5-27f5-3dc2-a82b-ec3a6a3574fe",
                        "target_lang_word": "artisan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artisan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bdd97095-aaed-3d3c-be79-c075e7ec1129",
                                        "entry_id": "d7a36dc9-642d-301e-abb6-82fd589a3f04",
                                        "glosses": [
                                            "Qui relève d’un métier mécanique ou manuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bb5f0de-348b-4dc6-8b7f-8e2ac42dc345",
                                                "sense_id": "bdd97095-aaed-3d3c-be79-c075e7ec1129",
                                                "text": "Là, et dans l’Enclos même, était le berceau des Barbazanges, famille artisane enrichie au dernier siècle, haussée jusqu’à la bourgeoisie, et qui, depuis cent ans, donnait des consuls au municipe et des magistrats au présidial."
                                            },
                                            {
                                                "example_id": "b33b037d-2445-417a-ac02-fb59a67dcd2b",
                                                "sense_id": "bdd97095-aaed-3d3c-be79-c075e7ec1129",
                                                "text": "Souvent, il s’interrompt et sa main artisane,\nBalançant le verset qu’il scande et qu’il redit,\nFait briller en glissant sur sa barbe persane\nLa pierre où dort le feu des jardins interdits."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "artisan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2cc95c04-5e86-309b-a5ff-454575106b9b",
                                        "entry_id": "26c1c954-9e8b-31cc-9449-1e22b13c8c1c",
                                        "glosses": [
                                            "Celui qui exerce un métier mécanique ou manuel, qui suit les règles d’un art établi, par opposition aux métiers dits industriels où la production est fournie par des automates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dce30150-cbf0-47e5-b229-2e2a1571a1b0",
                                                "sense_id": "2cc95c04-5e86-309b-a5ff-454575106b9b",
                                                "text": "Dans beaucoup de cas, les artisans, obligés de se rendre aux nouvelles sources de labeur, se sont déracinés et sont devenus, loin de leur contrée natale, des sans-foyer …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df73a4ae-50b8-34c3-80ea-5c9da32d9b50",
                                        "entry_id": "26c1c954-9e8b-31cc-9449-1e22b13c8c1c",
                                        "glosses": [
                                            "Celui qui est l’auteur, l’origine de quelque chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22075be8-2d71-4689-a052-82667a20c826",
                                                "sense_id": "df73a4ae-50b8-34c3-80ea-5c9da32d9b50",
                                                "text": "Il a été l’artisan de sa fortune, l’artisan de son malheur."
                                            },
                                            {
                                                "example_id": "faaea5f5-0fdf-4827-820d-1779cc892735",
                                                "sense_id": "df73a4ae-50b8-34c3-80ea-5c9da32d9b50",
                                                "text": "C’est un artisan d’impostures, de calomnies."
                                            },
                                            {
                                                "example_id": "3370b51f-c6b0-4199-9213-20302ae2bcc7",
                                                "sense_id": "df73a4ae-50b8-34c3-80ea-5c9da32d9b50",
                                                "text": "Le Grand Artisan",
                                                "translation": "Dieu"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaf48194-65f0-3567-a04f-d9583f188c82",
                                        "entry_id": "26c1c954-9e8b-31cc-9449-1e22b13c8c1c",
                                        "glosses": [
                                            "Désignation du grade d’un membre du Corps royal canadien des ingénieurs électriciens et mécaniciens détenant le grade de soldat."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
