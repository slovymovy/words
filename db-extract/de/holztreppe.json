                ],
                "senses": [
                    {
                        "sense_id": "55a33c61-eac4-3322-acea-6c8fd06da278",
                        "entry_id": "ee732e81-a9c4-329d-b982-d4b1515ef980",
                        "glosses": [
                            "Treppe aus Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d39ef3b8-2fcf-46a0-813d-f2488aacd3de",
                                "sense_id": "55a33c61-eac4-3322-acea-6c8fd06da278",
                                "text": "„Auf das Podium führt eine kleine, verschiebbare Holztreppe.“"
                            },
                            {
                                "example_id": "bee213e8-36bf-4cb4-8ced-77c0bcd3fc0c",
                                "sense_id": "55a33c61-eac4-3322-acea-6c8fd06da278",
                                "text": "„Von hier führt eine schmale Holztreppe zu einem Zimmer im Dachgeschoss, dem Arbeitszimmer der früheren Bischöfe.“"
                            },
                            {
                                "example_id": "beb10cc9-25aa-4b39-bab8-ccf0a252c4c4",
                                "sense_id": "55a33c61-eac4-3322-acea-6c8fd06da278",
                                "text": "„Lediglich an einer Stelle knarrte die Holztreppe kurz.“"
                            },
                            {
                                "example_id": "cebb1780-5aa9-4961-9066-9be8cb8195f5",
                                "sense_id": "55a33c61-eac4-3322-acea-6c8fd06da278",
                                "text": "„Davis, ein Genetiker, der früher biochemische Forschungen betrieb, wirft die Bettdecke beiseite und eilt über eine gewundene Holztreppe hinunter ins Erdgeschoss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
