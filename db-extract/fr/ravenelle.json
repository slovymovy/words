            {
                "entry_id": "0068fd69-6e96-3ced-9e59-48b405a04c33",
                "word": "ravenelle",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dd4427f1-041b-40b9-9026-b709f56b0947",
                        "entry_id": "0068fd69-6e96-3ced-9e59-48b405a04c33",
                        "tags": [
                            "plural"
                        ],
                        "form": "ravenelles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "65486a90-68e1-3ccd-9c18-1d16f943ea0f",
                        "entry_id": "0068fd69-6e96-3ced-9e59-48b405a04c33",
                        "glosses": [
                            "Plante de la famille des Brassicacées aussi appelée radis sauvage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "718e63e2-8858-4ef9-959c-0f3bfe334977",
                                "sense_id": "65486a90-68e1-3ccd-9c18-1d16f943ea0f",
                                "text": "Les feuilles de la ravenelle sont comestibles crues ou cuites comme celles du radis cultivé."
                            },
                            {
                                "example_id": "d11b1ddb-bd04-4db7-b101-457cfd829aaa",
                                "sense_id": "65486a90-68e1-3ccd-9c18-1d16f943ea0f",
                                "text": "Les marches rompues et disjointes faisaient bascule sous le pied ou n’étaient retenues que par les filaments des mousses et des plantes pariétaires ; sur l’appui de la terrasse avaient crû des joubarbes, des ravenelles et des artichauts sauvages."
                            },
                            {
                                "example_id": "3d0f5813-711c-469d-963e-b353a5d931d5",
                                "sense_id": "65486a90-68e1-3ccd-9c18-1d16f943ea0f",
                                "text": "Les champs d’avoine sont, certaines années, envahis par des plantes nuisibles telles que les chardons, les sanves, moutardes sauvages, ravenelles."
                            },
                            {
                                "example_id": "3157b475-0b9d-472c-a396-344b671942f2",
                                "sense_id": "65486a90-68e1-3ccd-9c18-1d16f943ea0f",
                                "text": "À grands coups de faucille il abattait les herbes sèches, les ravenelles, les derniers chardons et les tiges rouillées des fougères."
                            }
                        ]
                    },
                    {
                        "sense_id": "93ea817a-03b0-35c5-a772-f043635f4442",
                        "entry_id": "0068fd69-6e96-3ced-9e59-48b405a04c33",
                        "glosses": [
                            "Plante à fleurs jaunes aussi appelée giroflée des murailles ou violier jaune."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6d8edf1-b819-4034-91a8-01a9973d7317",
                                "sense_id": "93ea817a-03b0-35c5-a772-f043635f4442",
                                "text": "Quand nous longions des jardins, nous voyions les thyrses des lilas rougir au milieu de la verdure tendre du feuillage, et si une brise agitait l’air calme, il nous tombait sur la tête, de dessus le chaperon des vieux murs, des pétales de ravenelles jaunes."
                            }
                        ]
                    }
                ],
