                        "glosses": [
                            "Maison traditionnelle burundaise et rwandaise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c56565b6-9839-4414-9596-6c58cbc72d06",
                                "sense_id": "fd202086-07b1-3c6a-94a1-c01fcce9190e",
                                "text": "Les chaises sont rares car on continue de leur préférer le confort à ras du sol des nattes et de la paille. On trouve une table dans un rugo sur cinq."
                            }
                        ]
                    },
                    {
                        "sense_id": "7752842d-8bb5-35a1-b511-6259c0786444",
