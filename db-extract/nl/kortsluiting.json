                                "target_senses": [
                                    {
                                        "sense_id": "5fd8c814-230a-388c-9b2d-e9f52bc3c022",
                                        "entry_id": "cb1b4510-8bde-37da-9ca7-b628574d0493",
                                        "glosses": [
                                            "Connexion volontaire ou accidentelle de deux points d’un circuit électrique entre lesquels il existe une différence de potentiel, par un conducteur de faible résistance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a844e5c0-5454-4b70-9bd5-72ff34d72921",
                                                "sense_id": "5fd8c814-230a-388c-9b2d-e9f52bc3c022",
                                                "text": "En fracturant la serrure, au contraire, j’ai dû déterminer un court-circuit et produire cet éclairage intensif."
                                            },
                                            {
                                                "example_id": "f90b8412-57fb-4767-8176-bcf1d5d129f9",
                                                "sense_id": "5fd8c814-230a-388c-9b2d-e9f52bc3c022",
                                                "text": "Sous l’effet de la chaleur, le boîtier plastique avait totalement fondu, ainsi que la plupart des fils qui, en entrant en contact les uns avec les autres, avaient provoqué l’un des plus somptueux courts-circuits qu’ait jamais connus l’hémisphère nord."
                                            },
                                            {
                                                "example_id": "0b1293d8-bac8-46c6-8864-3cb3f1202760",
                                                "sense_id": "5fd8c814-230a-388c-9b2d-e9f52bc3c022",
                                                "text": "Le fusible gG coupe un court-circuit de 100 A en 0,05 s. Le fusible aM, de même calibre, temporisé, ne le coupera pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
