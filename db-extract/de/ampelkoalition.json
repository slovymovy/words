                        "sense_id": "aeec8678-8038-3571-b720-27cd1a3ddd12",
                        "entry_id": "0a76195f-55e0-3f4d-8480-9efee2752415",
                        "glosses": [
                            "Coalition en feu tricolore, entre la SPD, la FDP et Die Grünen."
                        ],
                        "tags": [
                            "Allemagne"
                        ],
                        "examples": [
                            {
                                "example_id": "1273bace-2171-41e6-a466-a7a3d4f0e0b7",
                                "sense_id": "aeec8678-8038-3571-b720-27cd1a3ddd12",
                                "text": "Roth hob hervor, die Ampelkoalition habe „mit dem deutschen Sonderweg der Merkel-Jahre im Umgang mit China gebrochen“ und den „naiven Blick auf China abgelegt“.",
                                "translation": "Roth a souligné que la coalition en feu tricolore avait \"rompu avec la voie particulière suivie par l'Allemagne durant les années Merkel dans ses relations avec la Chine\" et s’était \"débarrassée de son regard naïf sur la Chine\"."
                            }
                        ]
                    }
