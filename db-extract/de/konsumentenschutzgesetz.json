                "senses": [
                    {
                        "sense_id": "15a83f37-d9b3-3370-ab20-9e5a8d980ff9",
                        "entry_id": "bd239798-5906-3489-9f1f-3b5f0de9219d",
                        "glosses": [
                            "Gesetz, dass den Konsumenten vor Benachteiligungen schützen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7b95eb6-02fb-44c1-8a49-848688292ec2",
                                "sense_id": "15a83f37-d9b3-3370-ab20-9e5a8d980ff9",
                                "text": "„Getrübt wurden die Erwartungen hinsichtlich europäischer Konsumentenschutzgesetze. Bis Ende nächsten Jahres ist lediglich mit der Erarbeitung entsprechender gesetzlicher Regelungen zu rechnen, von denen bisher wegen nationaler Widerstände schon drei Vorschläge vom Ministerrat abgelehnt worden sind.“"
                            },
                            {
                                "example_id": "1ee318c2-6c67-4376-bd2f-ee61ad5130c2",
                                "sense_id": "15a83f37-d9b3-3370-ab20-9e5a8d980ff9",
                                "text": "„Für sämtliche Rechtsbeziehungen zwischen SN und dem User gilt das sachlich zuständige Gericht der Landeshauptstadt Salzburg als vereinbart, sofern keine anderslautenden Bestimmungen nach dem Konsumentenschutzgesetz zur Anwendung gelangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
