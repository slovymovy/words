                                        "entry_id": "d9737b6e-cfbf-3bf7-8bc0-78c68d60e39e",
                                        "glosses": [
                                            "Tending to inflame or provoke somebody."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "487d42fa-4c7e-4f2c-a589-7819e73e7706",
                                                "sense_id": "39d74ed1-0da8-3b54-b9ce-63e546220479",
                                                "text": "Sam posted an inflammatory comment to the newsgroup."
                                            },
                                            {
                                                "example_id": "1d886228-8e75-45cf-b60b-de316d7c8d51",
                                                "sense_id": "39d74ed1-0da8-3b54-b9ce-63e546220479",
                                                "text": "Even in MAGA circles, Loomer is regarded as a loose cannon who loves to get attention from inflammatory comments that undermine the Republican Party."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23f6f2da-8ca2-3782-b857-a640b4996c5a",
                                        "entry_id": "d9737b6e-cfbf-3bf7-8bc0-78c68d60e39e",
                                        "glosses": [
                                            "Relating to, causing, or caused by inflammation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeb91340-3a5d-44f5-9254-ccf26970882a",
                                                "sense_id": "23f6f2da-8ca2-3782-b857-a640b4996c5a",
                                                "text": "As we age, the major arteries of our bodies frequently become thickened with plaque, a fatty material with an oatmeal-like consistency that builds up along the inner lining of blood vessels. The reason plaque forms isn’t entirely known, but it seems to be related to high levels of cholesterol inducing an inflammatory response, which can also attract and trap more cellular debris over time."
                                            }
                                        ]
                                    }
