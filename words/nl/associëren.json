{
    "word_family": [
        "associatie",
        "associatief",
        "geassocieerd"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "54c2d5c0-2865-30b2-a9f3-d2dbb93e6fbf",
                    "sense_definition": "een verband leggen tussen verschillende gedachten, begrippen of herinneringen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mentale verbinding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veel mensen <w>associëren</w> de geur van zonnebrandcrème direct met vakantie.",
                            "target_lang_translations": {
                                "en": "Many people immediately <w>associate</w> the smell of sunscreen with vacation."
                            }
                        },
                        {
                            "text": "Hij kon dat woord niet anders dan met zijn nare ervaringen <w>associëren</w>.",
                            "target_lang_translations": {
                                "en": "He couldn't help but <w>associate</w> that word with his unpleasant experiences."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbinden",
                        "koppelen"
                    ],
                    "antonyms": [
                        "scheiden",
                        "loskoppelen"
                    ],
                    "common_phrases": [
                        "met elkaar associëren",
                        "direct associëren met"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a connection between different thoughts, concepts, or memories"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "associate",
                                "target_lang_sense_clarification": "to connect in the mind"
                            },
                            {
                                "target_lang_word": "link",
                                "target_lang_sense_clarification": "to connect two things"
                            },
                            {
                                "target_lang_word": "connect",
                                "target_lang_sense_clarification": "to join ideas together"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d50242ef-ce91-3bd7-91d8-a740c339a701",
                    "sense_definition": "zich verenigen of samenwerken als partners, vaak in een zakelijke context",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "samenwerking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De twee advocaten besloten zich te <w>associëren</w> om een groter kantoor te vormen.",
                            "target_lang_translations": {
                                "en": "The two lawyers decided to <w>associate</w> to form a larger firm."
                            }
                        },
                        {
                            "text": "Het <w>associëren</w> met een ervaren partner bracht voor beide partijen voordeel.",
                            "target_lang_translations": {
                                "en": "<w>Partnering</w> with an experienced partner brought benefits to both parties."
                            }
                        }
                    ],
                    "synonyms": [
                        "samenwerken",
                        "verenigen",
                        "verbroederen"
                    ],
                    "antonyms": [
                        "ontbinden",
                        "splitsen"
                    ],
                    "common_phrases": [
                        "zich associëren met"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak reflexief gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to unite or work together as partners, often in a business context"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "associate",
                                "target_lang_sense_clarification": "to join as a partner or ally"
                            },
                            {
                                "target_lang_word": "partner",
                                "target_lang_sense_clarification": "to form a partnership"
                            },
                            {
                                "target_lang_word": "team up",
                                "target_lang_sense_clarification": "to work together"
                            }
                        ]
                    }
                }
            ]
        }
    ]
