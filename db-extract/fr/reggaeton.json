                "senses": [
                    {
                        "sense_id": "03120eab-8c88-3e1f-b9e9-1f4684918a5e",
                        "entry_id": "3294b648-0574-3bbb-bef2-6d35f9428021",
                        "glosses": [
                            "Genre musical né au début des années 2000, chanté principalement en espagnol, et dérivé du ragga avec des influences hip-hop."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d914fe6-4834-4d89-8df6-05469a78e269",
                                "sense_id": "03120eab-8c88-3e1f-b9e9-1f4684918a5e",
                                "text": "Il y a de la musique partout, traditionnelle et actuelle comme la cumbia, la puya, le reggaeton…"
                            },
                            {
                                "example_id": "b5f32d2c-3707-4777-bc4a-b9b4882dda27",
                                "sense_id": "03120eab-8c88-3e1f-b9e9-1f4684918a5e",
                                "text": "Les basses d’un reggaeton (le même que dans le solar de Murciélago ? Ou bien tous les reggaetons n’en étaient qu’un seul, ce qui expliquait qu’il ne les distingue pas ?) retentirent à un volume assourdissant, ce qui déclencha chez les neuf autres passagers du taxi, chauffeur inclus et Conde exclu, un mouvement presque coordonné des hanches et des épaules, puis ils reprirent en chœur les paroles, mot à mot ou grognement à grognement, d’une chanson que tous connaissaient (à l’exception honteuse de Conde)."
                            }
                        ]
                    }
                ],
