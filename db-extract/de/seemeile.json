                ],
                "senses": [
                    {
                        "sense_id": "3876c7d6-71e2-3438-98b6-3de286df123b",
                        "entry_id": "9b5c30fd-f5f5-378b-b4d1-0544cf0f3e9e",
                        "glosses": [
                            "Längenmaß aus der Seefahrt: entspricht 1,852 Kilometer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad2b5c55-eda0-41d3-9df1-c1a8a1fce6c9",
                                "sense_id": "3876c7d6-71e2-3438-98b6-3de286df123b",
                                "text": "5 Seemeilen sind etwa 9 Kilometer."
                            },
                            {
                                "example_id": "b8dbbd69-0e8f-47d7-ada1-334497156f26",
                                "sense_id": "3876c7d6-71e2-3438-98b6-3de286df123b",
                                "text": "„Eine Stunde später machte der Rudergänger backbord voraus in einer Entfernung von sechs Seemeilen ein anderes Schiff aus, das westlichen Kurs steuerte, ihnen also in etwa entgegenkam.“"
                            },
                            {
                                "example_id": "28961de6-7c97-4753-beca-c2dacf7f64bb",
                                "sense_id": "3876c7d6-71e2-3438-98b6-3de286df123b",
                                "text": "„In diesem Moment lagen unsere hintersten Schiffe zwei Seemeilen zurück, und der Kommodore drehte vor dem Wind und holte kreuzend auf dem anderen Gang auf.“"
                            },
                            {
                                "example_id": "c06be1de-3566-429e-93bb-4b63e04e54a6",
                                "sense_id": "3876c7d6-71e2-3438-98b6-3de286df123b",
                                "text": "„U 96 war zu diesem Zeitpunkt etwa 230 Seemeilen nordöstlich des Geleitzuges, Lehmann-Willenbrock beschloss, die Verfolgung aufzunehmen und den Konvoi anzugreifen.“"
                            },
                            {
                                "example_id": "828b2972-4a69-429e-9cc9-7653dfc1bcc5",
                                "sense_id": "3876c7d6-71e2-3438-98b6-3de286df123b",
                                "text": "„Das feste Land müßte bei etwa zehn Seemeilen Küstenabstand in Sicht kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69e47a8d-df0e-4155-9243-ca53dfb9594a",
                        "source_entry_id": "9b5c30fd-f5f5-378b-b4d1-0544cf0f3e9e",
                        "source_sense_id": "3876c7d6-71e2-3438-98b6-3de286df123b",
