                "senses": [
                    {
                        "sense_id": "be2968ea-9a52-321b-8ebc-dd4a3b3c7ed8",
                        "entry_id": "c57ebf3c-0350-3517-9557-84185fb8bf6b",
                        "glosses": [
                            "Bewegung, die (ausschließlich) mit dem Kopf gemacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fbd13ff-5867-4c8f-895f-dede34093cdf",
                                "sense_id": "be2968ea-9a52-321b-8ebc-dd4a3b3c7ed8",
                                "text": "„Martin hatte über seinen grauen Haarkranz gestrichen und mit diesen kleinen Kopfbewegungen genickt, wie er es immer tat, wenn er über ein Problem nachdachte.“"
                            },
                            {
                                "example_id": "a3cb86a0-c991-4f12-a544-adadf74937ee",
                                "sense_id": "be2968ea-9a52-321b-8ebc-dd4a3b3c7ed8",
                                "text": "„Obgleich das Haar schwer war und jeder Kopfbewegung folgte, strich sie es nicht fortwährend zurück, sondern ließ es so, wie es gerade lag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "12246003-77b9-321c-b392-4a4d837220f2",
                        "entry_id": "c57ebf3c-0350-3517-9557-84185fb8bf6b",
                        "glosses": [
                            "übertragen von [1]: als Zeichen gedachte Bewegung des Kopfes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73a3a1e6-2fac-4fba-9819-e60d66cae6a0",
                                "sense_id": "12246003-77b9-321c-b392-4a4d837220f2",
                                "text": "„Schließlich kam einer der Beamten zurück und winkte sie mit einer einzigen unfreundlichen Kopfbewegung durch.“"
                            },
                            {
                                "example_id": "ba0e1d2d-e943-4015-b4f5-5b97955a6e9c",
                                "sense_id": "12246003-77b9-321c-b392-4a4d837220f2",
                                "text": "„McKelvey sah mich an und wies mit einer Kopfbewegung auf das Ungetüm.“"
                            },
                            {
                                "example_id": "4a737ac5-cb71-4fa9-b322-7d292c54d58b",
                                "sense_id": "12246003-77b9-321c-b392-4a4d837220f2",
                                "text": "„Dann entließ er seinen Adjutanten mit einer Kopfbewegung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
