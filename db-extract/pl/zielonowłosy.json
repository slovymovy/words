                "senses": [
                    {
                        "sense_id": "4497af93-be78-3368-86f2-ee2b67775e38",
                        "entry_id": "ae791cf1-18d0-3505-b675-829b1be1ede0",
                        "glosses": [
                            "taki, który ma zielone włosy"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c2ef110f-ef99-471d-aab4-647d83f99a56",
                                "sense_id": "4497af93-be78-3368-86f2-ee2b67775e38",
                                "text": "O szalony! gdzie on goni, • Tam od ostrych słońca grotów • Głowy jego nie ochroni • Ni palma zielonowłosa, • Ni białe łono namiotów, • Tam jeden namiot – niebiosa"
                            },
                            {
                                "example_id": "f64a1002-e781-4879-a385-697a575e9559",
                                "sense_id": "4497af93-be78-3368-86f2-ee2b67775e38",
                                "text": "Bycie zielonowłosym potworem zupełnie jej nie odpowiadało"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
