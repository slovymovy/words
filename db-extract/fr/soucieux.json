                "senses": [
                    {
                        "sense_id": "920e4781-b1d2-3037-9bb1-ff3d6323fef7",
                        "entry_id": "e9dac940-7847-3f3f-ba7a-d50b27d09eaf",
                        "glosses": [
                            "starostlivý, ustaraný"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34ff294a-211d-42d3-aab0-fd06a9c1f283",
                                "sense_id": "920e4781-b1d2-3037-9bb1-ff3d6323fef7",
                                "text": "Le vieillard souriait par moments ; mais parfois aussi des expressions soucieuses attristaient passagèrement sa figure desséchée.",
                                "translation": "Staroch se chvílemi usmíval, ale občas se také jeho vysušený obličej přechodně rozesmutnil úzkostným výrazem."
                            },
                            {
                                "example_id": "0010996f-dc87-46ca-858e-94abccb52e0d",
                                "sense_id": "920e4781-b1d2-3037-9bb1-ff3d6323fef7",
                                "text": "Je suis soucieux de votre santé.",
                                "translation": "Mám starost/ Dělám si starosti o vaše zdraví."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4cde719-4246-3bd9-9164-d069301e3778",
                        "entry_id": "e9dac940-7847-3f3f-ba7a-d50b27d09eaf",
                        "glosses": [
                            "bdící, dbalý"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6b870b0-ccda-49ad-9d50-490e65df3051",
                                "sense_id": "d4cde719-4246-3bd9-9164-d069301e3778",
                                "text": "Chers riverains, nous tenons à vous prévenir qu’en date du 2 avril 2015 nous organisons une compétition de danse, entre 13 - 18h au Campus Eiffel, Rue Sextius Michel. Bien que soucieux de ne pas perturber la quiétude du quartier, et votre tranquillité, il est cependant possible que cet évènement occasionne du bruit et une animation inhabituelle.",
                                "translation": "Drazí sousedé, rádi bychom vás upozornili, že dne 2.dubna 2015 mezi 13 - 18 h pořádáme v kampusu Eiffel taneční soutěž. Jakkoliv hodláme dát pozor, abychom nenarušili pokojnost čtvrti a váš klid, je přesto možné, že tato akce způsobí hluk a neobvyklý ruch."
                            }
                        ]
                    }
