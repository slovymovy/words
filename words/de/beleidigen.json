                },
                {
                    "sense_id": "1992921b-311a-3486-a67b-99604ecb5c2a",
                    "sense_definition": "den rechtlichen Tatbestand einer Beleidigung verwirklichen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wer einen Polizisten im Dienst als „Idioten“ bezeichnet, <w>beleidigt</w> ihn im Sinne des Strafgesetzbuchs."
                        },
                        {
                            "text": "Vor Gericht bestritt der Angeklagte den Vorwurf, den Kläger vorsätzlich <w>beleidigt</w> zu haben."
