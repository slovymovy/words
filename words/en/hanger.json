{
    "word_family": [
        "hang",
        "hanging",
        "hangable",
        "hangfire",
        "hangnail"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3ae1b667-6971-357a-8f35-189c58a7d89e",
                    "sense_definition": "A device, often shaped like human shoulders, used to hang clothes to keep them from wrinkling.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "suspension_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please put your coat on a <w>hanger</w> and hang it in the closet.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, повесь пальто на <w>вешалку</w> и убери его в шкаф."
                            }
                        },
                        {
                            "text": "I need to buy more <w>clothes</w> <w>hangers</w> because I have too many shirts.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить больше <w>плечиков</w> для одежды, потому что у меня слишком много рубашек."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clothes hanger",
                        "coat hanger",
                        "plastic hanger",
                        "wooden hanger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приспособление, часто по форме напоминающее человеческие плечи, используемое для развешивания одежды, чтобы она не мялась."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вешалка",
                                "target_lang_sense_clarification": "общее название приспособления"
                            },
                            {
                                "target_lang_word": "плечики",
                                "target_lang_sense_clarification": "вешалка в форме плеч"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97f892a8-bed0-3ce8-b83a-791facffebd8",
                    "sense_definition": "A state of anger or irritability caused by being hungry.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I'm sorry I was rude earlier; it was just the <w>hanger</w> talking because I missed lunch.",
                            "target_lang_translations": {
                                "ru": "Прости, что я грубил раньше; это просто во мне говорил <w>голод</w>, потому что я пропустил обед."
                            }
                        },
                        {
                            "text": "To avoid <w>hanger</w>, she always carries a small snack in her bag.",
                            "target_lang_translations": {
                                "ru": "Чтобы не становиться <w>злой от голода</w>, она всегда носит в сумке небольшой перекус."
                            }
                        }
                    ],
                    "common_phrases": [
                        "suffer from hanger",
                        "avoid hanger"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Portmanteau of hungry and angry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние гнева или раздражительности, вызванное чувством голода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хэнгри",
                                "target_lang_sense_clarification": "сленговое заимствование"
                            },
                            {
                                "target_lang_word": "злой от голода",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0fdf737-ebd7-33e7-8c5e-8cb8313d9b1e",
                    "sense_definition": "A person who hangs something, such as wallpaper or curtains.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professional paper <w>hanger</w> finished the living room in just two hours.",
                            "target_lang_translations": {
                                "ru": "Профессиональный <w>оклейщик</w> обоев закончил гостиную всего за два часа."
                            }
                        },
                        {
                            "text": "He found work as a wallpaper <w>hanger</w> after moving to the city.",
                            "target_lang_translations": {
                                "ru": "После переезда в город он нашел работу <w>оклейщика</w> обоев."
                            }
                        }
                    ],
                    "common_phrases": [
                        "paper hanger",
                        "wallpaper hanger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который вешает что-либо, например, обои или шторы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оклейщик",
                                "target_lang_sense_clarification": "специалист по обоям"
                            },
                            {
                                "target_lang_word": "развешиватель",
                                "target_lang_sense_clarification": "тот, кто развешивает что-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41c74486-bf48-331e-a374-3d21083d081b",
                    "sense_definition": "A metal device secured to a rock face by a bolt, used by climbers to attach a carabiner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "climbing_gear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The climber clipped her rope into the steel <w>hanger</w> before continuing the ascent.",
                            "target_lang_translations": {
                                "ru": "Альпинистка вщелкнула веревку в стальное <w>ушко</w>, прежде чем продолжить восхождение."
                            }
                        },
                        {
                            "text": "In marine areas, even stainless steel bolts and <w>hangers</w> corrode rapidly.",
                            "target_lang_translations": {
                                "ru": "В морских районах даже болты и <w>планки</w> из нержавеющей стали быстро корродируют."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bolt hanger",
                        "steel hanger"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical climbing term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Металлическое устройство, закрепляемое на скале с помощью болта, используемое альпинистами для крепления карабина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ушко",
                                "target_lang_sense_clarification": "деталь шлямбура"
                            },
                            {
                                "target_lang_word": "планка",
                                "target_lang_sense_clarification": "альпинистское снаряжение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ceee45a3-1351-35be-801b-a6622ef5eaf8",
                    "sense_definition": "In baseball, a breaking ball or slider that does not break properly and stays high in the strike zone, making it easy to hit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_terminology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The batter hit a home run after the pitcher threw a <w>hanger</w> right over the plate.",
                            "target_lang_translations": {
                                "ru": "Бьющий выбил хоум-ран после того, как питчер бросил <w>зависший мяч</w> прямо над базой."
                            }
                        },
                        {
                            "text": "He regretted throwing that <w>hanger</w> as soon as it left his hand.",
                            "target_lang_translations": {
                                "ru": "Он пожалел о том, что бросил эту <w>зависшую подачу</w>, как только мяч вылетел из его руки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "throw a hanger"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "baseball terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В бейсболе: крученый мяч или слайдер, который не изменил траекторию должным образом и остался в верхней части страйк-зоны, что делает его легкой мишенью для удара."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зависшая подача",
                                "target_lang_sense_clarification": "бейсбольный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dea5d794-cfc3-3b48-a631-dd7eee14a1e4",
                    "sense_definition": "A wood or group of trees growing on a steep hillside.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient beech <w>hanger</w> looked beautiful against the autumn sky.",
                            "target_lang_translations": {
                                "ru": "Древний буковый <w>лесок на склоне</w> красиво смотрелся на фоне осеннего неба."
                            }
                        },
                        {
                            "text": "Birds often nest in the old crow's nest on a low beech in the same <w>hanger</w>.",
                            "target_lang_translations": {
                                "ru": "Птицы часто вьют гнезда в старом вороньем гнезде на низком буке в том же <w>лесу</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "beech hanger"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily British"
                        },
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лес или группа деревьев, растущих на крутом склоне холма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лесок на склоне",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c817dcb-eb7a-3f47-85a9-3872b663445d",
                    "sense_definition": "A short, broad sword that hangs from a belt, common in the 18th century.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weaponry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pirate carried a heavy <w>hanger</w> at his side for close-quarters combat.",
                            "target_lang_translations": {
                                "ru": "Пират носил на боку тяжелый <w>тесак</w> для ближнего боя."
                            }
                        },
                        {
                            "text": "He wore a broad belt and <w>hanger</w> as part of his military uniform.",
                            "target_lang_translations": {
                                "ru": "Он носил широкий пояс и <w>кортик</w> как часть своей военной формы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "belt and hanger"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical weaponry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий широкий меч, подвешиваемый к поясу, популярный в XVIII веке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кортик",
                                "target_lang_sense_clarification": "короткое клинковое оружие"
                            },
                            {
                                "target_lang_word": "тесак",
                                "target_lang_sense_clarification": "широкий короткий меч"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90249fb1-a69e-3f25-a520-6e093b5e9904",
                    "sense_definition": "A spectacular overhead mark in Australian rules football.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports_terminology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd went wild when the forward leaped over the pack to take a <w>hanger</w>.",
                            "target_lang_translations": {
                                "ru": "Толпа неистовствовала, когда нападающий перепрыгнул через группу игроков, чтобы совершить <w>хэнгер</w>."
                            }
                        },
                        {
                            "text": "That <w>hanger</w> will surely be nominated for the mark of the year.",
                            "target_lang_translations": {
                                "ru": "Этот <w>прыжок</w> наверняка будет номинирован на звание лучшего момента года."
                            }
                        }
                    ],
                    "synonyms": [
                        "spectacular mark"
                    ],
                    "common_phrases": [
                        "take a hanger"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australian"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Эффектный прыжок и ловля мяча над головами других игроков в австралийском футболе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хэнгер",
                                "target_lang_sense_clarification": "спортивный термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "af973dd0-f113-318e-89a8-cff11e2dbfba",
                    "sense_definition": "A family name or surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Hanger</w> was invited to speak at the local historical society meeting.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Хэнгер</w> был приглашен выступить на заседании местного исторического общества."
                            }
                        },
                        {
                            "text": "The <w>Hanger</w> family has lived in this county for several generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Хэнгер</w> живет в этом округе уже несколько поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хэнгер",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}