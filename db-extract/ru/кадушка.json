                "senses": [
                    {
                        "sense_id": "29f083d5-74bb-3f28-b4e7-4e34bdbbde73",
                        "entry_id": "342afffd-52b0-3595-b834-8e1de47c3108",
                        "glosses": [
                            "разг. небольшая кадка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bde2412-08b9-4981-9b40-880c29769701",
                                "sense_id": "29f083d5-74bb-3f28-b4e7-4e34bdbbde73",
                                "text": "Она и сидела день-деньской за пряжей, и всё, понимаешь, на одном месте, у кадушки с водой."
                            },
                            {
                                "example_id": "43af3366-4b73-4016-b147-7a292f9e2279",
                                "sense_id": "29f083d5-74bb-3f28-b4e7-4e34bdbbde73",
                                "text": "Здесь уже был холл с декоративными растениями в кадушках, с качалками и мягкими диванами, этим он походил на гостиницу и давал сердцу путника повод наполниться гордостью〈…〉"
                            }
                        ]
                    }
