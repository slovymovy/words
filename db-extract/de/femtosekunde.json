                "senses": [
                    {
                        "sense_id": "8730645e-fe88-3816-a83f-2f2a81ff2bb7",
                        "entry_id": "0e5abd6d-6eda-3688-b970-a0631256a394",
                        "glosses": [
                            "ein Billiardstel (10⁻¹⁵) einer Sekunde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30cfac5d-e991-45b9-9fec-1d74eccd4b20",
                                "sense_id": "8730645e-fe88-3816-a83f-2f2a81ff2bb7",
                                "text": "Das Licht legt in einer Femtosekunde etwa 0,3 Mikrometer zurück, was ungefähr der Größe eines Virus oder Bakteriums entspricht."
                            },
                            {
                                "example_id": "fc232d65-7f32-471a-892d-59fbf01f5fbb",
                                "sense_id": "8730645e-fe88-3816-a83f-2f2a81ff2bb7",
                                "text": "„Beispielsweise dauert die Reaktion eines Bariumatoms mit einem Fluormethan-Molekül nur 270 Femtosekunden - das ist fast nichts, wenn man bedenkt, dass eine Femtosekunde dem Milliardstel einer Millionstel Sekunde entspricht.“"
                            },
                            {
                                "example_id": "e953b0e7-d0ba-4b13-9591-57c9d884adf6",
                                "sense_id": "8730645e-fe88-3816-a83f-2f2a81ff2bb7",
                                "text": "„Längst können die Physiker Pulsdauern von nur noch wenigen Femtosekunden erzeugen (1 Femtosekunde ist ein Millionstel einer milliardstel Sekunde).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef1ba15c-66a3-4e48-b3fd-4db5279fd9e1",
                        "source_entry_id": "0e5abd6d-6eda-3688-b970-a0631256a394",
                        "source_sense_id": "8730645e-fe88-3816-a83f-2f2a81ff2bb7",
