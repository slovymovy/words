                                "target_senses": [
                                    {
                                        "sense_id": "bee93e7e-d6a9-33c5-a1a0-f92a4474b6d2",
                                        "entry_id": "fcd24293-cf89-3403-8e7a-fe4159943c86",
                                        "glosses": [
                                            "Sorte de trappe, ouverture carrée ou rectangulaire pratiquée dans le pont d’un navire pour descendre dans l’intérieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c0c23a9-7c7f-4565-ab69-bd27f691f144",
                                                "sense_id": "bee93e7e-d6a9-33c5-a1a0-f92a4474b6d2",
                                                "text": "Les hommes descendaient, bouchaient tour à tour l’écoutille, se laissaient glisser le long de l’échelle de fer et avec eux de l’eau saumâtre dégringolait, se formait en rigole sur le plancher.\nIl y avait toujours aussi une voix pour crier :\n— L’écoutille, nom de D… !"
                                            },
                                            {
                                                "example_id": "9adb6651-e6e4-4987-a0f4-5c297214ea5f",
                                                "sense_id": "bee93e7e-d6a9-33c5-a1a0-f92a4474b6d2",
                                                "text": "Du bout de son fouet il montra à Léda l’écoutille ouverte que deux soldats, tenant un lourd gourdin, gardaient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c124a276-ff46-3810-a577-282f15b66956",
                                        "entry_id": "fcd24293-cf89-3403-8e7a-fe4159943c86",
                                        "glosses": [
                                            "Oreille."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67e99a72-be9b-477d-86e4-4f7f5f03e2d0",
                                                "sense_id": "c124a276-ff46-3810-a577-282f15b66956",
                                                "text": "Nantes. « Johanna Rolland doit ouvrir ses écoutilles »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
