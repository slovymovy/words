                        "entry_id": "7b313eef-c46d-3f90-ac74-9fbc1548b281",
                        "glosses": [
                            "Appareil qui sert au démarrage et au test des bougies et des autres organes d’allumage d'un moteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e21a896e-39f3-43a1-bfc7-13ba59f0687f",
                                "sense_id": "8d6eb143-d83c-3f85-8647-7f4a764660c3",
                                "text": "Par contre je vais pas utiliser mon soquet habituel mais un autre que je branche sur mon power panel...beaucoup plus d’autonomie (si je laise mon pauvre soquet de 1200 mAh pendant un plein statique il va être vide en quelques minutes...)"
                            }
                        ]
                    }
