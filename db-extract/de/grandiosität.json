                "senses": [
                    {
                        "sense_id": "548d4fac-5ae9-34ff-93d0-fa9ec84bec46",
                        "entry_id": "59125905-4eaa-3409-bf3b-56b43681626e",
                        "glosses": [
                            "Eigenschaft/Handlung/Ereignis, welches einen überwältigenden (grandiosen) Eindruck macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "045cc545-f432-4d2d-a6d3-3d03785210d7",
                                "sense_id": "548d4fac-5ae9-34ff-93d0-fa9ec84bec46",
                                "text": "„Im Grunde sei eine Revolution ein naturgeschichtliches Ereignis, dessen Grandiosität man insgesamt anerkennen müsse.“"
                            },
                            {
                                "example_id": "22c07613-d4ed-405e-9648-6a0366fac3e1",
                                "sense_id": "548d4fac-5ae9-34ff-93d0-fa9ec84bec46",
                                "text": "„Männlicher und auch weiblicher Narzissmus bewegen sich grundsätzlich zwischen den zwei Polen: der Minderwertigkeit und der Grandiosität.“"
                            },
                            {
                                "example_id": "0d0b6710-58df-4628-b25d-f3f5ef18e92a",
                                "sense_id": "548d4fac-5ae9-34ff-93d0-fa9ec84bec46",
                                "text": "„Der Teufelskreis einer narzisstischen Wachstumsstörung liegt darin, dass reale Rückschritte durch imaginäre Grandiositäten kompensiert werden, welche die real möglichen Schritte immer kleiner und unattraktiver erscheinen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
