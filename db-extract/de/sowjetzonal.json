                "senses": [
                    {
                        "sense_id": "1bbfacbf-1838-36e5-ba94-056c1722386d",
                        "entry_id": "dbc9ba9e-4c1a-3699-939e-aed29be5ae55",
                        "glosses": [
                            "die Sowjetische Besatzungszone betreffend, zu ihr gehörend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "733dd1c7-61e5-4809-8743-9912809ee5ea",
                                "sense_id": "1bbfacbf-1838-36e5-ba94-056c1722386d",
                                "text": "„Die sowjetzonale Währungsreform und die zentralisierte Wirtschaftsplanung markierten eine doppelte Zäsur: Fortan konzentrierte eine sowjetisch verordnete Sparpolitik die knappen finanziellen Ressourcen auf den schwerindustriellen Aufbau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "410c6c5f-c321-3d0a-b8bf-22533d665a59",
                        "entry_id": "dbc9ba9e-4c1a-3699-939e-aed29be5ae55",
                        "glosses": [
                            "die DDR betreffend, zu ihr gehörend"
                        ],
                        "tags": [
                            "derogatory",
                            "figurative",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "5a533399-76a2-4f87-b25a-da76e5754ae3",
                                "sense_id": "410c6c5f-c321-3d0a-b8bf-22533d665a59",
                                "text": "„Die sowjetzonalen Sportfunktionäre lassen nicht locker im Bestreben, dem Hammer-und-Zirkel-Emblem Geltung zu verschaffen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
