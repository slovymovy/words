                                        "sense_id": "d4c4ce4a-d3fb-3a57-840a-95ebe32102d8",
                                        "entry_id": "27946c68-87fb-3dcf-b0f8-db95c1db64a1",
                                        "glosses": [
                                            "unbedeutende, nebensächliche Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29ab7012-7656-45dc-bdf0-c76b4234a4ff",
                                                "sense_id": "d4c4ce4a-d3fb-3a57-840a-95ebe32102d8",
                                                "text": "Ej du Statist! Rück mal beiseite, ich möchte schon gerne mal ans Buffet ran!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
