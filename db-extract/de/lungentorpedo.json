                        ],
                        "examples": [
                            {
                                "example_id": "e0b3059b-73ff-43cc-9b24-de185b6369b5",
                                "sense_id": "e2fcb1a4-8fdb-3390-a777-7f3407df901c",
                                "text": "„Die deutschen Gefangenen nennen unsere Zigaretten Lungentorpedos. Ein ziemlich gewalttätiger Ausdruck, finden Sie nicht?“"
                            },
                            {
                                "example_id": "743e3ab5-3a5d-45de-9cb1-4c5c2c38dfe8",
                                "sense_id": "e2fcb1a4-8fdb-3390-a777-7f3407df901c",
                                "text": "„Du gehst mir mal wieder tierisch auf die Eier mit deinem Gelalle. Laß lieber mal’n Lungentorpedo rüberwachsen.“"
                            },
                            {
                                "example_id": "0942a0e9-6d6c-4a73-9165-ca18ecbfb621",
                                "sense_id": "e2fcb1a4-8fdb-3390-a777-7f3407df901c",
                                "text": "„Steck deinen Lungentorpedo sofort wieder ein! Bei mir wird nicht geraucht!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
