                "senses": [
                    {
                        "sense_id": "b173164a-43a3-380e-a0b6-c060e6ac1899",
                        "entry_id": "705af256-e1d7-3086-9a6e-f3c2629f4eb0",
                        "glosses": [
                            "Marsch, bei dem die Beteiligten vom Tod bedroht/umgekommen sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97f1daa9-e00a-48d9-999a-94584fe0721e",
                                "sense_id": "b173164a-43a3-380e-a0b6-c060e6ac1899",
                                "text": "„Im Zuge dieser Todesmärsche in den ersten Monaten von 1945 dürften Hunderttausende von Menschen umgekommen sein.“"
                            },
                            {
                                "example_id": "47d20932-35df-468a-a97d-fbd584f6fddc",
                                "sense_id": "b173164a-43a3-380e-a0b6-c060e6ac1899",
                                "text": "„Auch einen zehntägigen Todesmarsch bei minus 30 Grad und ohne Essen überlebte sie, und selbst wenn es nicht genau zehn Tage und nicht genau 30 Grad gewesen sein sollten, was ändert das?“"
                            },
                            {
                                "example_id": "65278cf1-c687-4cd9-a4d9-c89f959acbb9",
                                "sense_id": "b173164a-43a3-380e-a0b6-c060e6ac1899",
                                "text": "„[Primo] Levi überlebte - und überlebte gerade auch dank der Erkrankung [Anmerkung: Scharlach], da er kurz vor der Befreiung von Auschwitz zurückgelassen und nicht mit auf die Todesmärsche genommen wurde.“"
                            },
                            {
                                "example_id": "dfcf252c-0058-42a1-8dee-bd265d09d7aa",
                                "sense_id": "b173164a-43a3-380e-a0b6-c060e6ac1899",
                                "text": "„Tausende starben auf diesem Todesmarsch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
