                        "find a purchase"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крепкий захват, опора или положение, позволяющее приложить силу или предотвратить скольжение.",
                        "tr": "Bir kişinin güç uygulamasını sağlayan veya kaymasını önleyen sağlam bir tutuş, dayanak veya konum."
                    },
