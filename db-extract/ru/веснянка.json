                        ],
                        "form": "весня́нке"
                    },
                    {
                        "form_id": "4feec459-f176-4967-86f4-23faca60d58f",
                        "entry_id": "64b7a31b-a2eb-3aa7-99d2-a350981baf31",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "весня́нках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "643f9d83-c0de-38e0-aefd-1ab8cf67f902",
                        "entry_id": "64b7a31b-a2eb-3aa7-99d2-a350981baf31",
                        "glosses": [
                            "истор. весенняя обрядовая народная песня у восточных славян"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d66b583f-fbc6-448c-8935-46a664147dcc",
                                "sense_id": "643f9d83-c0de-38e0-aefd-1ab8cf67f902",
                                "text": "Телёнка неумелого / Я с пальца напою / И с блеском зуба белого / Веснянку пропою…"
                            }
                        ]
                    },
                    {
                        "sense_id": "95142c20-c5ed-3690-b738-0a9da596fd9d",
                        "entry_id": "64b7a31b-a2eb-3aa7-99d2-a350981baf31",
                        "glosses": [
                            "сетчатокрылое земноводное насекомое, появляющееся с ранней весны"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9560cf66-7a4e-4ecc-bc41-6fbe31f5e659",
                                "sense_id": "95142c20-c5ed-3690-b738-0a9da596fd9d",
                                "text": "Черноватая веснянка, по внешнему виду напоминающая Capniella nodosa."
                            }
                        ]
                    },
                    {
                        "sense_id": "4bf673f2-f440-3a15-8907-c31d3cef71b0",
                        "entry_id": "64b7a31b-a2eb-3aa7-99d2-a350981baf31",
                        "glosses": [
                            "устар. растение ветреница, примула"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4eb0acce-9f6f-43de-a305-2700b2e87906",
                                "sense_id": "4bf673f2-f440-3a15-8907-c31d3cef71b0",
                                "text": "А на горах заметны всходы, / Покровы травок молодых, / И в них ― красивые разводы / Веснянок нежно-голубых."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f0d8c50-4290-3a19-8edd-dddffe62a546",
                        "entry_id": "64b7a31b-a2eb-3aa7-99d2-a350981baf31",
                        "glosses": [
                            "диал. весенняя лихорадка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "841a9f79-edec-4556-8a37-b6c0e528637b",
                                "sense_id": "9f0d8c50-4290-3a19-8edd-dddffe62a546",
                                "text": "Голова болит, ног под собой не чую, никак веснянка накатывает."
                            }
                        ]
                    }
                ],
