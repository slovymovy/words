                    "sense_definition": "État d'ivresse ou comportement provoqué par une consommation excessive de boisson alcoolisée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
