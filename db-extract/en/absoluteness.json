                    {
                        "sense_id": "bce03098-16b2-3b30-8438-d4b726f8f4ab",
                        "entry_id": "ff2f7ff0-1f1f-35ac-ae9a-4e3b848949c6",
                        "glosses": [
                            "The fact of being finished or perfected; completeness."
                        ],
                        "tags": [
                            "obsolete",
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6536ff1a-dabf-3db8-ad47-dfcf1d4087c0",
                        "entry_id": "ff2f7ff0-1f1f-35ac-ae9a-4e3b848949c6",
                        "glosses": [
                            "The characteristic of being absolute in nature or scope."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "87f69207-a042-447c-b9d6-bcd5c7d2c88f",
                                "sense_id": "6536ff1a-dabf-3db8-ad47-dfcf1d4087c0",
                                "text": "the absoluteness of his sovereignty, the absoluteness of his convictions"
                            }
                        ]
                    },
                    {
                        "sense_id": "d48d33c1-0c28-3e45-ae47-e71d4e822f15",
                        "entry_id": "ff2f7ff0-1f1f-35ac-ae9a-4e3b848949c6",
                        "glosses": [
                            "Absolute authority, unlimited power; absolutism, despotism."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "2a7d1f66-e821-4544-b55c-9aaf8f485c0d",
                                "sense_id": "d48d33c1-0c28-3e45-ae47-e71d4e822f15",
                                "text": "I know no man that could produce more parts, both naturall and artificiall, fit to preserve his masterie, and to maintaine his absolutenesse, than he doth; yet is hee cleane falne from them like a childe."
                            }
                        ]
                    },
                    {
                        "sense_id": "21a76717-ff90-39e1-9382-2da24bd37376",
                        "entry_id": "ff2f7ff0-1f1f-35ac-ae9a-4e3b848949c6",
                        "glosses": [
                            "The fact of being without qualifications or conditions; certainty, unconditionality."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "516859fd-3799-3b72-95ae-b73ea14f3282",
                        "entry_id": "ff2f7ff0-1f1f-35ac-ae9a-4e3b848949c6",
                        "glosses": [
                            "Independent autonomy."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bc900c7-b9a9-488a-a2f1-8eebb196a380",
                        "source_entry_id": "ff2f7ff0-1f1f-35ac-ae9a-4e3b848949c6",
                        "source_sense_description": "the fact free from any conditions or other beings",
                        "target_lang_word": "absoluutheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absoluutheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "463f7066-fc30-34e2-bc4e-449910723022",
                                        "entry_id": "7851f8c0-574a-3693-a5ee-ff4c6f5cf6e5",
                                        "glosses": [
                                            "de mate waarin iets of iemand absoluut is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ad235c7-976d-4f2f-8811-ca9dec5749ce",
                                                "sense_id": "463f7066-fc30-34e2-bc4e-449910723022",
                                                "text": "Het wegvallen van Tonio heeft, bij Mirjam nog meer dan bij mij, een heleboel levenszaken op scherp gezet. Ik bemerk bij haar soms een absoluutheid die me beangstigt."
                                            },
                                            {
                                                "example_id": "d8064e8d-1050-4d2f-8e04-6221492330f3",
                                                "sense_id": "463f7066-fc30-34e2-bc4e-449910723022",
                                                "text": "‘Iedere kabinetsformatie is in Nederland vanouds een gelegenheid voor de burgerij om zich een paar weken over te geven aan politieke beschouwingen op de manier van Hadjememaar. Dat ligt in het wezen van onze verhoudingen: nergens in een westerse democratie is de opgewekte absoluutheid van de taal der politieke leiders in de verkiezingscampagne zo ver verwijderd van de praktijk die na de verkiezingsdatum volgt: het traag geworstel om het compromis waarin de beginselen de bakens zijn die zich steeds verder verwijderen. Dat wordt de kiezers nooit goed begrepen, en de politici hebben zich daar nooit veel om bekommerd. Maar deze keer wordt het overdreven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
