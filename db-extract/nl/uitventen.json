                "senses": [
                    {
                        "sense_id": "cc29e876-9696-336b-974e-c78da5ebb26e",
                        "entry_id": "5144c571-a459-38e9-b3e3-9d3e5ea4d241",
                        "glosses": [
                            "verkopen op de markt; langs de straat verkopen; verkopen in het algemeen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baa025ba-b8c9-4d21-8a65-68f900a3af5c",
                                "sense_id": "cc29e876-9696-336b-974e-c78da5ebb26e",
                                "text": "'Ze kunnen dan meteen het Boekenweekgeschenk uitventen', verklaarde de directeur. De Boekenweek van zaterdag 16 tot en met zondag 24 maart duurt dit jaar ook negen dagen. Voorgaande jaren waren dat er 11. Van Nispen: 'We hebben er meer een week van gemaakt. We willen het helder hebben, met een kop en een staart.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "9e721c02-b0e7-3c94-8e2c-2f3551f216a2",
                        "entry_id": "5144c571-a459-38e9-b3e3-9d3e5ea4d241",
                        "glosses": [
                            "verspreiden; aanbieden aan anderen; aan de man brengen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc058ab5-8adf-4a87-b9ad-824cdb1d0520",
                                "sense_id": "9e721c02-b0e7-3c94-8e2c-2f3551f216a2",
                                "text": "Koning Willem-Alexander zei bij zijn aantreden de Nederlandse handelsbelangen in alle uithoeken van de wereld te willen uitventen. Rusland is een belangrijke handelspartner en er zijn de nodige plooien in de bilaterale relaties glad te strijken. De wijziging van zijn agenda was in dat licht bezien vanzelfsprekend."
                            },
                            {
                                "example_id": "1c179476-6a29-444e-85ae-aa8e17e90eca",
                                "sense_id": "9e721c02-b0e7-3c94-8e2c-2f3551f216a2",
                                "text": "De aanpak van overlast gevende jongeren in Twenterand verdient navolging. Twenterand kan de gebruikte methode Flashback gaan uitventen, omdat er resultaten mee worden behaald. Dat zei minister Ivo Opstelten van Veiligheid en Justitie dinsdagmiddag tijdens een werkbezoek."
                            }
                        ]
                    }
