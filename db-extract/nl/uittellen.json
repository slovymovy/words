                "senses": [
                    {
                        "sense_id": "678f584d-a271-3d08-a2de-b0a910f57217",
                        "entry_id": "b4c2d08b-5728-3343-b1c3-51fd1086792e",
                        "glosses": [
                            "al tellend betalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f735309-0f85-4a7f-8b6f-8ea0dbaa5732",
                                "sense_id": "678f584d-a271-3d08-a2de-b0a910f57217",
                                "text": "‘Het leukste vind ik pensioenen brengen: dan ben je altijd graag gezien en vaak krijg je ook iets te drinken aangeboden. Het gebeurt wel niet zo vaak meer. Ik moet nu nog maar vier mensen cash hun pensioen gaan brengen. Het is gelukkig al voorgeteld, vroeger moest je elk pensioen zelf uittellen en erover waken dat je kassa klopte tegen het eind van de dag.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "2d8e0a1e-0952-3bc2-8bc2-28f7b510b864",
                        "entry_id": "b4c2d08b-5728-3343-b1c3-51fd1086792e",
                        "glosses": [
                            "precies bepalen wat de hoeveelheid is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf799bae-1697-4016-9ea9-95c9f31f5f6c",
                                "sense_id": "2d8e0a1e-0952-3bc2-8bc2-28f7b510b864",
                                "text": "Want je kan thuis de 'schermtijd'misschien wel uittellen, maar wat doe je met de uurtjes achter het digibord op school? Ik zeg altijd: zorg dat het thuis niet dé hoofdactiviteit is, maar één van de vele activiteiten."
                            }
                        ]
                    },
                    {
                        "sense_id": "8eb6db2d-e57e-3629-aab4-f1e9b209a919",
                        "entry_id": "b4c2d08b-5728-3343-b1c3-51fd1086792e",
                        "glosses": [
                            "tellen hoelang een bokser op de grond blijft liggen, als dit te lang duurt heeft de andere bokser de wedstrijd gewonnen"
                        ],
