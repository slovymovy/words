{
    "word_family": [
        "sackcloth",
        "racksack"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "503cf67f-daf3-3f58-a851-668202351069",
                    "sense_definition": "The act of dismissing someone from their job.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His sudden <w>sacking</w> came as a complete shock to the entire office staff. ",
                            "target_lang_translations": {
                                "ru": "Его внезапное <w>увольнение</w> стало полным шоком для всего персонала офиса."
                            }
                        },
                        {
                            "text": "After a series of poor decisions, the manager faced immediate <w>sacking</w> by the board.",
                            "target_lang_translations": {
                                "ru": "После серии неудачных решений менеджеру грозило немедленное <w>увольнение</w> со стороны совета директоров."
                            }
                        }
                    ],
                    "synonyms": [
                        "firing",
                        "dismissal"
                    ],
                    "antonyms": [
                        "hiring"
                    ],
                    "common_phrases": [
                        "face immediate sacking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт увольнения кого-либо с работы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увольнение",
                                "target_lang_sense_clarification": "с работы"
                            },
                            {
                                "target_lang_word": "снятие с должности",
                                "target_lang_sense_clarification": "отстранение от работы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95448517-63fb-3f54-93d2-7b5aea1e0aee",
                    "sense_definition": "Coarse, rough material used for making sacks or bags.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old potatoes were stored in heavy bags made of <w>sacking</w>.",
                            "target_lang_translations": {
                                "ru": "Старый картофель хранился в тяжелых мешках из <w>мешковины</w>."
                            }
                        },
                        {
                            "text": "She cleared the dirt using a piece of rough <w>sacking</w> from the garden shed.",
                            "target_lang_translations": {
                                "ru": "Она убрала грязь с помощью куска грубой <w>мешковины</w> из садового сарая."
                            }
                        }
                    ],
                    "synonyms": [
                        "burlap",
                        "sackcloth"
                    ],
                    "common_phrases": [
                        "piece of sacking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубый, суровый материал, используемый для изготовления мешков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мешковина",
                                "target_lang_sense_clarification": "грубая ткань"
                            },
                            {
                                "target_lang_word": "упаковочная ткань",
                                "target_lang_sense_clarification": "для изготовления мешков"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "faed3650-25a6-30c4-a49d-8ca4bdad33a6",
                    "sense_definition": "Present participle and gerund of <w>sack</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is currently <w>sacking</w> several employees due to budget cuts.",
                            "target_lang_translations": {
                                "ru": "В настоящее время компания <w>увольняет</w> нескольких сотрудников из-за сокращения бюджета."
                            }
                        },
                        {
                            "text": "Instead of helping the team, the general was busy <w>sacking</w> the captured town.",
                            "target_lang_translations": {
                                "ru": "Вместо того чтобы помочь отряду, генерал был занят <w>разграблением</w> захваченного города."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма причастия или герундия от глагола sack (увольнять, разграблять)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увольняя",
                                "target_lang_sense_clarification": "причастие/деепричастие от увольнять"
                            },
                            {
                                "target_lang_word": "разграбление",
                                "target_lang_sense_clarification": "действие по значению разграблять"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}