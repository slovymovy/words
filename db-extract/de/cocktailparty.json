                "senses": [
                    {
                        "sense_id": "1acf955b-2305-3755-bc75-eca15abafba1",
                        "entry_id": "9c657465-35bc-3425-b2dc-fdcb00cb9f50",
                        "glosses": [
                            "Geselligkeit ohne Zwang am frühen Abend, auf der vor allem sogenannte Cocktails getrunken werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e3fc037-23d9-41ad-abc3-7da038573e87",
                                "sense_id": "1acf955b-2305-3755-bc75-eca15abafba1",
                                "text": "„Neuerdings, seit es Menschen gibt, ist das Nutzenmaximierungsprinzip auch schuld an anderem Unsinn, nach dem Muster, daß sich die Gäste auf einer Cocktailparty heiser schreien, statt sich sämtlich kraftsparend leise zu unterhalten.“"
                            },
                            {
                                "example_id": "30219b45-e9dc-415a-931e-bdca2c7d31b5",
                                "sense_id": "1acf955b-2305-3755-bc75-eca15abafba1",
                                "text": "„Wenn die Nachbarn sie zu einer Cocktailparty einluden, machten die Männer auf Ferris stets den Eindruck, als wüssten sie genau, was er wirklich tat, obwohl sie ihn niemals danach gefragt hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
