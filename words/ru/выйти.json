                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Окна моей спальни <выходят> в тихий сад.",
                            "target_lang_translations": {
                                "en": "My bedroom windows <face> a quiet garden.",
                                "de": "Die Fenster meines Schlafzimmers <gehen> zum ruhigen Garten <hinaus>.",
                                "zh": "我卧室的窗户<朝向>一个安静的花园。"
                            }
                        },
                        {
                            "text": "Балкон <выходит> на центральную площадь города.",
                            "target_lang_translations": {
                                "en": "The balcony <overlooks> the city's central square.",
                                "de": "Der Balkon <zeigt> auf den zentralen Platz der Stadt.",
                                "zh": "阳台<面向>市中心广场。"
