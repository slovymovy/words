                ],
                "senses": [
                    {
                        "sense_id": "ada3d3c4-229f-3a24-9ea8-d7114c2b8a12",
                        "entry_id": "18079bfa-a76c-3e7d-b1c0-3291502ae93e",
                        "glosses": [
                            "plötzliches Auftreten von Gewalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37985dd6-b68c-45bd-aa1d-15ecbdad7775",
                                "sense_id": "ada3d3c4-229f-3a24-9ea8-d7114c2b8a12",
                                "text": "Nachdem der König die Steuern um fünfzig Prozent erhöhte, gab es in der Stadt einen Gewaltausbruch."
                            },
                            {
                                "example_id": "1b25ff4b-217a-4e42-bcc7-b816f1be9c02",
                                "sense_id": "ada3d3c4-229f-3a24-9ea8-d7114c2b8a12",
                                "text": "„Ein plötzlicher, willkürlicher Gewaltausbruch, der sich in blindwütigem Zerstören oder auch in Angriffen gegen Unbeteiligte (bis hin zum Mord) äußert.“"
                            },
                            {
                                "example_id": "661b9a39-2b9f-435c-98d5-a3d33ecc62c0",
                                "sense_id": "ada3d3c4-229f-3a24-9ea8-d7114c2b8a12",
                                "text": "„Kolumbien ist seither nie wirklich zur Ruhe gekommen, was sich immer wieder in erschreckenden Gewaltausbrüchen zeigt.“"
                            },
                            {
                                "example_id": "a22d5610-1694-4e5e-b248-d1c01d2f4b1b",
                                "sense_id": "ada3d3c4-229f-3a24-9ea8-d7114c2b8a12",
                                "text": "„Ab Mitte der 1980er Jahre kam es im indisch kontrollierten Teil Kaschmirs vermehrt zu Gewaltausbrüchen.“"
                            },
                            {
                                "example_id": "b8d5baf1-7d42-4c9b-a758-a70fcc1e537a",
                                "sense_id": "ada3d3c4-229f-3a24-9ea8-d7114c2b8a12",
                                "text": "„Da die weißen Siedler der Vorstellung huldigten, die Afrikaner steckten tief im Zustand der «Barbarei», sahen sie sich mit jedem Aufruhr, jedem Gewaltausbruch zwischen Schwarzen in ihren Vorurteilen bestätigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
