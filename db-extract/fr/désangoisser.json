                ],
                "senses": [
                    {
                        "sense_id": "d1e3ea0c-aca7-3853-9fe6-436b6c167ac8",
                        "entry_id": "6927cf00-34c3-33c0-8cca-176221582469",
                        "glosses": [
                            "Libérer de l’angoisse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3adedb9e-5561-424d-8811-1aaf96005a99",
                                "sense_id": "d1e3ea0c-aca7-3853-9fe6-436b6c167ac8",
                                "text": "D’un regard, ils se sont convaincus que si l’inutilité de l’IRM pouvait désangoisser leur patiente, ils mettraient à profit ce temps pas forcément perdu pour solliciter l’opinion d’un spécialiste."
                            },
                            {
                                "example_id": "3ad18a67-3e88-49ef-a51b-5c1ca09eb55a",
                                "sense_id": "d1e3ea0c-aca7-3853-9fe6-436b6c167ac8",
                                "text": "Parler avec son chef désangoisse le stagiaire, lui permet de penser à autre chose qu’à la mort."
                            },
                            {
                                "example_id": "b8bf2416-8c26-497b-8955-410392c8d7c0",
                                "sense_id": "d1e3ea0c-aca7-3853-9fe6-436b6c167ac8",
                                "text": "Comme si de rien n’était, les terrasses se sont mises à éclore. Les gens à sortir. D’abord pour se désangoisser à l’air libre, puis pour fêter la fin des hostilités."
                            }
                        ]
                    }
                ],
