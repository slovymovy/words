                ],
                "senses": [
                    {
                        "sense_id": "156c858a-65b8-3b06-92b3-638e260d90b5",
                        "entry_id": "f6e1a333-7fb0-3801-92d8-0a221230ef29",
                        "glosses": [
                            "сторонник политического сепаратизма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3c76377-88cf-44cc-bce3-98c7ef1fbb34",
                                "sense_id": "156c858a-65b8-3b06-92b3-638e260d90b5",
                                "text": "Становые брали взятки, подрядчики надували и обирали казну, крестьяне копили недоимки, сепаратисты говорили: «Нет, никогда москалям не пивать таких водок, как наши малороссийские сливянка и запеканка!»"
                            },
                            {
                                "example_id": "124ae09e-a589-4298-9fd6-220af6bdf1a4",
                                "sense_id": "156c858a-65b8-3b06-92b3-638e260d90b5",
                                "text": "Благодаря стародавней оплошности нашей правящей бюрократии имя Шевченко давно уже служит знаменем для южных сепаратистов."
                            },
                            {
                                "example_id": "2b0cb676-b7ce-4b41-a7f6-ba69aeccf28e",
                                "sense_id": "156c858a-65b8-3b06-92b3-638e260d90b5",
                                "text": "Председательское место было предложено члену Думы грузинскому сепаратисту, меньшевику Чхеидзе ― ненавистнику России."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20c47db2-4611-4055-bd08-712407bb4895",
                        "source_entry_id": "f6e1a333-7fb0-3801-92d8-0a221230ef29",
                        "source_sense_id": "156c858a-65b8-3b06-92b3-638e260d90b5",
                        "target_lang_word": "Separatist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Separatist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a59f55b-23b2-30d9-86d9-9209aa612e77",
                                        "entry_id": "5762ba93-25d3-3c6a-804a-a15e5322089e",
                                        "glosses": [
                                            "Person, die nach politischer Trennung (Separation), zum Beispiel zweier Teile eines Landes, strebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5befc62e-175e-42e3-897c-73c53dcc7f89",
                                                "sense_id": "8a59f55b-23b2-30d9-86d9-9209aa612e77",
                                                "text": "\"Dass dann der Krieg kam, hat viele enttäuscht, und dass Separatisten die Autohäuser leerräumten, kam auch nicht gut an.\""
                                            },
                                            {
                                                "example_id": "67ce873f-55e8-4479-82cd-47f139b35295",
                                                "sense_id": "8a59f55b-23b2-30d9-86d9-9209aa612e77",
                                                "text": "„Der Krieg beginnt mit Erfolgen der Separatisten, die unter dem Oberkommando von Gustaf Svinhufvud den größten Teil Ostkareliens unter ihre Kontrolle bringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
