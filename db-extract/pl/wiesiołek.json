                "translations": [
                    {
                        "translation_id": "e678ae84-41d5-4a96-b124-09c849e6dd36",
                        "source_entry_id": "2042ff33-cc4f-34eb-8bde-41cef812369b",
                        "source_sense_id": "2680c80f-85b5-305d-a456-49d1d1e474b4",
                        "target_lang_word": "evening primrose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "evening primrose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5bb955c-553c-3ccf-a5cf-d1986d78d56e",
                                        "entry_id": "3d72eeae-a8b0-34ad-bd6a-a5f1e5b0d002",
                                        "glosses": [
                                            "Any of various flowering plants of the genus Oenothera or Camissonia, in the family Onagraceae,"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07e98247-f0c6-3dd9-bc5b-a5ab31f75ff3",
                                        "entry_id": "3d72eeae-a8b0-34ad-bd6a-a5f1e5b0d002",
                                        "glosses": [
                                            "Any of various flowering plants of the genus Oenothera or Camissonia, in the family Onagraceae,",
                                            "especially the common evening primrose, Oenothera biennis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3be9d0d2-b005-3055-96c0-478d844dc7e9",
                                        "entry_id": "3d72eeae-a8b0-34ad-bd6a-a5f1e5b0d002",
                                        "glosses": [
                                            "Any plant of family Onagraceae, the evening primrose family."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afc198d8-2924-42d8-8a05-52773df3f48d",
                                                "sense_id": "3be9d0d2-b005-3055-96c0-478d844dc7e9",
                                                "text": "The evening primrose plant family (Onagraceae) offers an ideal system to test predictions relating to the role of sexual recombination and segregation on diversification (Fig. 1). In many evening primrose species […]."
                                            },
                                            {
                                                "example_id": "06db23de-6bd2-4fef-85ee-c50dfcbe59e8",
                                                "sense_id": "3be9d0d2-b005-3055-96c0-478d844dc7e9",
                                                "text": "Specifically, we ask whether sexual evening primrose plant lineages (Onagraceae) have faster rates of adaptive molecular evolution and altered gene expression of a class I chitinase, a gene implicated in defence against pathogens, than functionally asexual evening primrose lineages."
                                            },
                                            {
                                                "example_id": "6e802bd5-f18f-42f2-bcb6-bcba4ce18384",
                                                "sense_id": "3be9d0d2-b005-3055-96c0-478d844dc7e9",
                                                "text": "The Myrtaceae is a dicot family in the class Rosidae which also includes the rose and mallow families and falls into the order Myrtales along with the families Lathraceae, Punicaceae (pomegranates) and Onagraceae (evening primroses)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94292e72-3262-4c4b-92f7-9a1615f729a5",
                        "source_entry_id": "2042ff33-cc4f-34eb-8bde-41cef812369b",
