                        "freiner l'élan"
                    ]
                },
                {
                    "sense_id": "2980c8f7-67c8-3dfb-8bfc-d3f7d02672ad",
                    "sense_definition": "Réduire ou modérer une consommation, une habitude ou une dépense.",
