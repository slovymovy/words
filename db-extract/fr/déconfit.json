                                    {
                                        "sense_id": "42e1e279-f287-3487-a3de-d71db0a5ca48",
                                        "entry_id": "10a982fa-41c5-3bb7-9acf-b85e1c14ac4d",
                                        "glosses": [
                                            "voltooid deelwoord van teleurstellen"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3eb8c46d-f73c-41bc-8128-6cfd7973422c",
                                                "sense_id": "42e1e279-f287-3487-a3de-d71db0a5ca48",
                                                "text": "De ANVR laat in een reactie weten teleurgesteld te zijn en overweegt een hoger beroep."
                                            },
                                            {
                                                "example_id": "1b72d784-459a-431e-bded-8d9daaf63fa4",
                                                "sense_id": "42e1e279-f287-3487-a3de-d71db0a5ca48",
                                                "text": "Het is ook niet zo dat ik teleurgesteld ben omdat mijn zoon niet 'voldoet' aan de norm die mijn dochter heeft gesteld - of andersom, dat hij het op de een of andere manier 'beter' doet dan zij."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "teleurgesteld",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6f2d53c3-3a60-3ae3-b79a-ab9f556f248a",
                                        "entry_id": "ce68ceb1-2701-3f72-8d4d-32a87d5499be",
                                        "glosses": [
                                            "een onaangenaam gevoel hebbend omdat een verwachting of hoop niet uitgekomen is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56f75f74-70df-4849-96ed-1485b44cfbe3",
                                                "sense_id": "6f2d53c3-3a60-3ae3-b79a-ab9f556f248a",
                                                "text": "De teleurgestelde kinderen begonnen luid te protesteren."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "teleurgesteld",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "71f3f404-864e-3c17-80bf-b44e45468ae8",
                                        "entry_id": "def4450c-4c56-341f-a9fb-f955ed1d5cf3",
                                        "glosses": [
                                            "verdrietig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e1f8547-f295-42c3-91e2-710ea50079b9",
                                                "sense_id": "71f3f404-864e-3c17-80bf-b44e45468ae8",
                                                "text": "Ik zakte teleurgesteld neer op een houten bankje naast het raam en opende het gastenboek van het café dat als ‘trail-register’ fungeerde."
                                            },
                                            {
                                                "example_id": "c21cf6fe-79d6-44cb-ab78-e17425468ba0",
                                                "sense_id": "71f3f404-864e-3c17-80bf-b44e45468ae8",
                                                "text": "Ruald keek een beetje teleurgesteld, maar drong niet verder aan."
                                            },
                                            {
                                                "example_id": "0f1d6a75-7cbd-49a8-a9e9-8d2f44c5ae97",
                                                "sense_id": "71f3f404-864e-3c17-80bf-b44e45468ae8",
                                                "text": "De European Broadcasting Union (EBU), die het Eurovisie Songfestival organiseert, snapt dat er in Oekraïne teleurgesteld is gereageerd op de keuze om het evenement volgend jaar niet in het door oorlog getroffen land te houden. De organisatie blijft echter bij de beslissing dat het winnende land Oekraïne momenteel niet aan de eisen voldoet om het Songfestival te organiseren, meldt ze op Twitter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
