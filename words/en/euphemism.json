                    "frequency": "Middle",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company used <w>euphemism</w> to describe the layoffs as a workforce reduction."
                        },
                        {
                            "text": "Using a <w>euphemism</w> can sometimes make a difficult conversation easier to handle."
                        }
                    ],
                    "synonyms": [
