                    {
                        "translation_id": "98bc2062-444a-4c89-9be3-f68916e0c754",
                        "source_entry_id": "6bb421b3-c304-3185-92df-013635b891a2",
                        "source_sense_id": "bd78df81-52de-32ae-9ebf-27b62fc4d952",
                        "source_sense_description": "strange; similar to the effects of a hallucinogen",
                        "target_lang_word": "bizarr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bizarr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50973839-f5b4-3059-802f-86a0e61493fe",
                                        "entry_id": "a1fa6190-b164-3365-bdec-b746efb8c0bc",
                                        "glosses": [
                                            "auf eine ausgefallene Art ungewöhnlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afa5da31-f55e-4a0b-b065-43fe0291c18a",
                                                "sense_id": "50973839-f5b4-3059-802f-86a0e61493fe",
                                                "text": "Wir sehen bizarre Felsformationen vor uns."
                                            },
                                            {
                                                "example_id": "8d28c947-fbfb-400b-be48-9f863b0a3abe",
                                                "sense_id": "50973839-f5b4-3059-802f-86a0e61493fe",
                                                "text": "Wir gerieten in eine bizarre Situation."
                                            },
                                            {
                                                "example_id": "560f704a-b5dc-4c6b-a6e0-e82767bfad1d",
                                                "sense_id": "50973839-f5b4-3059-802f-86a0e61493fe",
                                                "text": "„In der Mitte des Kataraktes ragten bizarre Felsen in die Höhe und wirkten aus der Entfernung wie riesige Reptilien aus dem Erdmittelalter.“"
                                            },
                                            {
                                                "example_id": "498590f3-0080-4e47-99c7-ed4a1776c840",
                                                "sense_id": "50973839-f5b4-3059-802f-86a0e61493fe",
                                                "text": "„Doch solche Tricks waren eine kleine Erleichterung für römische Leser, die sich ja dann im zweiten, regional gegliederten Teil des Büchleins durch einen Wust bizarrer Stammes- und Ortsnamen kämpfen mussten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "89e112e4-1243-3a34-9905-d63114bf43e8",
                                        "entry_id": "a1fa6190-b164-3365-bdec-b746efb8c0bc",
                                        "glosses": [
                                            "nicht richtig nachvollziehbar, aus einer Laune heraus entstanden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3a88f7d-efb9-4438-8401-a8466a8b8bfb",
                                                "sense_id": "89e112e4-1243-3a34-9905-d63114bf43e8",
                                                "text": "Er hat immer so bizarre Einfälle."
                                            },
                                            {
                                                "example_id": "54ce12b3-b48d-4147-97fa-acb45e9d67c6",
                                                "sense_id": "89e112e4-1243-3a34-9905-d63114bf43e8",
                                                "text": "„Seit 18 Jahren blockiert Griechenland wegen eines bizarren Namensstreits die Nato- und EU-Ambitionen der Regierung in Skopje.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
