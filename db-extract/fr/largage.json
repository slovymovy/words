        "fr-extract.jsonl": [
            {
                "entry_id": "318f1e5b-80b3-3cce-8726-cefb9e9f9225",
                "word": "largage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "58b25216-9cd5-4461-a41d-196ad9216625",
                        "entry_id": "318f1e5b-80b3-3cce-8726-cefb9e9f9225",
                        "tags": [
                            "plural"
                        ],
                        "form": "largages"
                    },
                    {
                        "form_id": "b428f143-617f-4340-a05d-f92410a7fd7d",
                        "entry_id": "318f1e5b-80b3-3cce-8726-cefb9e9f9225",
                        "tags": [],
                        "form": "larguage"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3451b4bd-4110-3ffc-ae24-dd20ddec1bc9",
                        "entry_id": "318f1e5b-80b3-3cce-8726-cefb9e9f9225",
                        "glosses": [
                            "Parachutage de personnel ou de matériel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61c0ee4e-e046-43da-8479-fa54bb05bc10",
                                "sense_id": "3451b4bd-4110-3ffc-ae24-dd20ddec1bc9",
                                "text": "Le largage des parachutistes ? Une vraie cata. Lors des essais en vol, les mannequins lâchés par les deux portes latérales se sont écrasés l’un sur l’autre."
                            }
                        ]
                    },
                    {
                        "sense_id": "a34ec73f-41d8-398b-99f5-74de9794fc8a",
                        "entry_id": "318f1e5b-80b3-3cce-8726-cefb9e9f9225",
                        "glosses": [
                            "Envoi d’une bombe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a85185e-9bca-4aac-b3df-65fa9a7e6bb6",
                                "sense_id": "a34ec73f-41d8-398b-99f5-74de9794fc8a",
                                "text": "Le largage de plusieurs centaines de tonnes de bombes sur une ville qui n’est pas un objectif militaire stratégique doit-il être qualifié de massacre ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "b360d792-c558-30f3-8b11-eb28b677a517",
                        "entry_id": "318f1e5b-80b3-3cce-8726-cefb9e9f9225",
                        "glosses": [
                            "Séparation d’avec le corps principal d’un véhicule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47c95ba6-5a78-46fa-ab39-5b90a5aa82f9",
                                "sense_id": "b360d792-c558-30f3-8b11-eb28b677a517",
                                "text": "Le largage de la sonde par la fusée s’est effectué sans problèmes."
                            },
                            {
                                "example_id": "af7d7f21-a46c-4e34-9467-b4940879ee2c",
                                "sense_id": "b360d792-c558-30f3-8b11-eb28b677a517",
                                "text": "Le fuselage de la navette a subi des dommages après le largage des propulseurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "fbae7af3-d8be-3632-8659-4465e9b28a38",
                        "entry_id": "318f1e5b-80b3-3cce-8726-cefb9e9f9225",
                        "glosses": [
                            "Rupture amoureuse décidée de façon unilatérale."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "23dea814-feb2-4dd4-9628-1af876437dc7",
                                "sense_id": "fbae7af3-d8be-3632-8659-4465e9b28a38",
                                "text": "Un largage comme ça après trois ans d’idylle, ça fait très mal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13de4f0d-5201-48f4-9020-46a8d1bdf7aa",
                        "source_entry_id": "318f1e5b-80b3-3cce-8726-cefb9e9f9225",
                        "source_sense_description": "Parachutage",
                        "target_lang_word": "Abwurf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abwurf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "476a26b6-1ca5-3009-8c32-5bb7cbd6104b",
                                        "entry_id": "8922dd7f-c615-3aa0-8968-0cb26a22e050",
                                        "glosses": [
                                            "eine Handlung, etwas von oben herab fallen zu lassen (oft in Zusammenhang mit Flugzeugen benutzt)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0d08787-e297-402e-a9ec-a9126adeee1e",
                                                "sense_id": "476a26b6-1ca5-3009-8c32-5bb7cbd6104b",
                                                "text": "Der Abwurf von propagandistischen Flugblättern brachte viele Soldaten zum Überlaufen."
                                            },
                                            {
                                                "example_id": "9038244a-bb97-4c76-9740-97c408f2cd5e",
                                                "sense_id": "476a26b6-1ca5-3009-8c32-5bb7cbd6104b",
                                                "text": "Er [ein Funktionär der Kommunistischen Partei Chinas] forderte den Abwurf von Zelten, Lebensmitteln, Medizin und Satellitenkommunikationsgeräten aus der Luft."
                                            },
                                            {
                                                "example_id": "91f3c32a-2ff5-4998-96a9-81350e908a2e",
                                                "sense_id": "476a26b6-1ca5-3009-8c32-5bb7cbd6104b",
                                                "text": "Jürgen Trittin: „Viele Menschen realisieren gar nicht, dass beispielweise jeden Tag in Deutschland deutsche Offiziere in Flugzeugen aufsteigen, um den Abwurf und Einsatz taktischer Atomwaffen zu üben.“"
                                            },
                                            {
                                                "example_id": "6cbf3f8e-aaf8-4bc5-9f1b-faec989b0429",
                                                "sense_id": "476a26b6-1ca5-3009-8c32-5bb7cbd6104b",
                                                "text": "Der Abwurf von Fassbomben ähnelt einem \"Dominospiel\": „mit möglichst wenig Aufwand möglichst viel Zerstörung“."
                                            },
                                            {
                                                "example_id": "a5c60b18-12c9-4060-be66-2cc9df1a8d3d",
                                                "sense_id": "476a26b6-1ca5-3009-8c32-5bb7cbd6104b",
                                                "text": "Heute ist es auf den Tag genau 70 Jahre her: Damals, am 6. August 1945, da wurde über der japanischen Stadt Hiroshima die Atombombe abgeworfen, der erste Abwurf einer Atombombe überhaupt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8fa43286-2437-3009-ae2e-334e264d42c6",
                                        "entry_id": "8922dd7f-c615-3aa0-8968-0cb26a22e050",
                                        "glosses": [
                                            "Teil eines Wurfes, bei dem man etwas loslässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cd27f09-74ef-4fb9-93da-e505994ec27d",
                                                "sense_id": "8fa43286-2437-3009-ae2e-334e264d42c6",
                                                "text": "Der Werfer wäre beim Abwurf fast umgefallen."
                                            },
                                            {
                                                "example_id": "a41772e5-b114-4123-960c-10d67847add1",
                                                "sense_id": "8fa43286-2437-3009-ae2e-334e264d42c6",
                                                "text": "Der Abwurf des Torwartes landete direkt beim generische Stürmer, der schoss sofort, Tor."
                                            },
                                            {
                                                "example_id": "8f9ee1ba-2bbc-455f-b045-04abc0330d92",
                                                "sense_id": "8fa43286-2437-3009-ae2e-334e264d42c6",
                                                "text": "DW: „Herr Tolan, ist es schwieriger, ein unregelmäßig geformtes Objekt wie eine Axt zu werfen als einen Ball?“ Metin Tolan: „Rein von der Physik her argumentiert: Nein. In der Praxis ist es aber deswegen schwerer, weil Sie die Axt beim Abwurf nicht so gut kontrollieren können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ae0269a2-d1c6-3843-816a-d9a12cb33dbc",
                                        "entry_id": "8922dd7f-c615-3aa0-8968-0cb26a22e050",
                                        "glosses": [
                                            "(vom Pferd) Ereignis, wenn das Pferd den Reiter hinunterstößt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "636573af-6724-4f4d-bb9e-a8b2717f5512",
                                                "sense_id": "ae0269a2-d1c6-3843-816a-d9a12cb33dbc",
                                                "text": "Dass er sein Leben im Rollstuhl verbringen muss, ist allein auf den Abwurf vom Pferde zurückzuführen."
                                            },
                                            {
                                                "example_id": "4e7f29ea-9d6b-4226-ad09-a056e65e49a5",
                                                "sense_id": "ae0269a2-d1c6-3843-816a-d9a12cb33dbc",
                                                "text": "Grundsätzlich ist Reiten keine besonders verletzungsträchtige Sportart – allerdings sind die Verletzungen durch den Abwurf vom Pferd mitunter schwerwiegend."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d74d1461-162f-3987-b28c-386bfa2237cf",
                                        "entry_id": "8922dd7f-c615-3aa0-8968-0cb26a22e050",
                                        "glosses": [
                                            "Fehler bei Sportbewerben (meist Sprungbewerben) durch das Berühren eines Hindernisses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33ea847f-e4f8-4e2d-b8ab-0b42b4b384ff",
                                                "sense_id": "d74d1461-162f-3987-b28c-386bfa2237cf",
                                                "text": "Jeder Abwurf brachte 4 Strafpunkte ein."
                                            },
                                            {
                                                "example_id": "7f16aded-9e81-4ff3-a2b9-5a8f677ab6f3",
                                                "sense_id": "d74d1461-162f-3987-b28c-386bfa2237cf",
                                                "text": "Ein Abwurf und eine langsamere Zeit als de Miranda Neto brachten Schwizer und seiner Stute Carlina Rang Zwei und 100.000 € Preisgeld ein."
                                            },
                                            {
                                                "example_id": "666bac22-51c4-44e6-8f29-c3d080be1467",
                                                "sense_id": "d74d1461-162f-3987-b28c-386bfa2237cf",
                                                "text": "Ein Abwurf in der Teamwertung weniger und Deutschland hätte Mannschaftsgold im Springreiten geholt, so [ARD-Reitexperte Marc] Eschweiler."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82db9614-ac27-4ab4-becd-a967cf8d5f06",
