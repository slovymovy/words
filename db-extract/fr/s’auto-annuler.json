                        "glosses": [
                            "S’annuler de soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53c782e3-b533-4b2a-b759-fcd4e83dd2ac",
                                "sense_id": "9f3464c1-ea7d-3b37-a986-e0f83cc4be06",
                                "text": "Les prophéties peuvent s’autoréaliser ou au contraire s’auto-annuler."
                            },
                            {
                                "example_id": "9f79c81c-8fde-468a-953b-096ed67abe02",
                                "sense_id": "9f3464c1-ea7d-3b37-a986-e0f83cc4be06",
                                "text": "La conséquence de cette position est que la doctrine de l’auto-poiésis ne peut valoir, à moins de s’auto-annuler, comme une théorie du droit en général."
                            }
