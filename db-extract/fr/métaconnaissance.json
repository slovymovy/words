                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f73ae09-c1a2-3232-a3e6-25dcb2b469c9",
                                        "entry_id": "c530b09d-2923-3416-b1b2-8b58d6d9cfba",
                                        "glosses": [
                                            "Knowledge about knowledge itself (for example, epistemologic awareness)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b23a5360-7d24-42ba-96ef-20478c3009d9",
                                                "sense_id": "4f73ae09-c1a2-3232-a3e6-25dcb2b469c9",
                                                "text": "Metaknowledge is knowledge about knowledge […] The hallmark of metaknowledge is its being a matter of knowing propositions in which one K[nowledge]-operator occurs within the scope of another. Knowledge about someone's ignorance thus counts as metaknowledge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e48310b5-4689-3704-985b-666610477153",
                                        "entry_id": "c530b09d-2923-3416-b1b2-8b58d6d9cfba",
                                        "glosses": [
                                            "Knowledge about types, domains, functions, or preconditions of knowledge."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7006c564-4b83-45ec-9baa-3561d7f3e489",
                                                "sense_id": "e48310b5-4689-3704-985b-666610477153",
                                                "text": "The acts of monitoring, hypothesizing, and verifying are internal work which require a person's metaknowledge or knowledge concerning what kind of knowledge is needed and how that knowledge is appropriately used in the situation."
                                            },
                                            {
                                                "example_id": "acd0581e-a085-4f7b-9b86-b7a7c70cb32a",
                                                "sense_id": "e48310b5-4689-3704-985b-666610477153",
                                                "text": "Meta-knowledge is knowledge about how to acquire and exploit information, rather than basic knowledge about the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
