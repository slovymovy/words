                        "examples": [
                            {
                                "example_id": "e0f488c4-531c-47dc-8b5a-9b9a1c1f9661",
                                "sense_id": "aef40360-c3ad-353d-9099-c2a1bde46767",
                                "text": "Selon un usage établi alors, il ne fit guère représenter ses pièces au cours de son directoriat, elles ont donc été un peu oubliées, et quelques-unes seulement reprises au cours de ce demi-siècle."
                            },
                            {
                                "example_id": "568a20d9-9cc7-435c-8c1c-96aad048577d",
                                "sense_id": "aef40360-c3ad-353d-9099-c2a1bde46767",
                                "text": "Cependant les trois mois du directoriat se passent, et le chancelier est encore en vie."
                            },
                            {
                                "example_id": "d0ed14c9-e966-49b6-ab0e-6799b416d84a",
                                "sense_id": "aef40360-c3ad-353d-9099-c2a1bde46767",
                                "text": "Les mécontents parmi les auteurs et les artistes dramatiques , parmi les amoureux de ces dames, parmi les aspirants au directoriat, criaient bruyamment aux oreilles du ministre."
                            },
                            {
                                "example_id": "fa4218fc-333e-4417-955e-57b7c1a39a7a",
                                "sense_id": "aef40360-c3ad-353d-9099-c2a1bde46767",
                                "text": "Il [le peintre Horace Vernet, alors directeur de la Villa Medicis à Rome] sollicita, avant la fin de son directoriat, d'être envoyé en Algérie, ce qui lui fut accordé immédiatement."
                            }
                        ]
                    }
