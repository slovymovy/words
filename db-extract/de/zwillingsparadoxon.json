                "senses": [
                    {
                        "sense_id": "b2f14238-0470-3ac0-8f4a-51ce9ae8f2c3",
                        "entry_id": "7bf8e4f0-1d7c-3c4f-ad88-53d08cc76265",
                        "glosses": [
                            "Gedankenexperiment, in welchem ein Zwilling mit nahezu Lichtgeschwindigkeit zu einem fernen Stern reist, während der andere Zwilling auf der Erde zurückbleibt und das einen scheinbaren Widerspruch in der speziellen Relativitätstheorie beschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94e0387c-a191-44ec-ac32-a13449038085",
                                "sense_id": "b2f14238-0470-3ac0-8f4a-51ce9ae8f2c3",
                                "text": "„Eine internationale Forschergruppe hat an einem Teilchenbeschleuniger der Gesellschaft für Schwerionenforschung (GSI) in Darmstadt in einem Präzisionsexperiment bestätigt, dass bewegte Uhren tatsächlich langsamer ‚ticken‘ als ruhende. Auf dieser merkwürdigen Vorhersage der Relativitätstheorie fußt beispielsweise das berühmte Zwillingsparadoxon, dem zufolge ein Raumfahrer, der in einer schnellen Rakete reist, langsamer altert als sein auf der Erde zurückbleibender Zwillingsbruder.“"
                            },
                            {
                                "example_id": "6e2f99ac-a096-41c5-953c-827605af01e9",
                                "sense_id": "b2f14238-0470-3ac0-8f4a-51ce9ae8f2c3",
                                "text": "„Die Zwillingsparadoxa zeigen das in drastischer Weise.“"
                            },
                            {
                                "example_id": "6c7fd27d-e114-4483-b8db-209d6912eb5a",
                                "sense_id": "b2f14238-0470-3ac0-8f4a-51ce9ae8f2c3",
                                "text": "„Hier ist, um das Problem der Identität in seiner Schärfe überhaupt in den Blick zu bekommen, von Translokationen (ähnlich dem ‚Beamen‘ in Raumschiff Enterprise), Zwillingsparadoxa oder Gehirntransplantationen die Rede.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
