                "translations": [
                    {
                        "translation_id": "a97a4545-08f4-4c9b-9d2f-3f875487e617",
                        "source_entry_id": "b7b7bd36-1b74-3ea2-a326-5c81d389ec66",
                        "source_sense_id": "e38c2e51-21a3-3661-953a-1548880bd4fc",
                        "source_sense_description": "Staatsbürgerin von Makedonien",
