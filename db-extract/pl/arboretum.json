                "senses": [
                    {
                        "sense_id": "6124573e-7a19-3929-b430-e1a6f60f25ad",
                        "entry_id": "d3841d26-413e-3934-8cc4-db673178df17",
                        "glosses": [
                            "wyodrębniony obszar, na którym znajduje się kolekcja drzew i krzewów, utrzymywany w celu naukowo-badawczym (np. prace nad aklimatyzacją obcych gatunków), bądź ochrony rzadkich gatunków i odmian"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c3b237c-6160-4d39-9d6a-9c5ce6df8344",
                                "sense_id": "6124573e-7a19-3929-b430-e1a6f60f25ad",
                                "text": "Naukowcy przeprowadzają badania w naszym arboretum."
                            },
                            {
                                "example_id": "8f7eeff8-94aa-44e8-850e-09aec9249c25",
                                "sense_id": "6124573e-7a19-3929-b430-e1a6f60f25ad",
                                "text": "Dodatkowe atrakcje to imponująca kolekcja drzew w przyzamkowym arboretum, zbiory Biblioteki Kórnickiej, tereny rekreacyjne, bogactwo lasów"
                            },
                            {
                                "example_id": "1a9c7633-0357-4003-8197-9d723b87ebbf",
                                "sense_id": "6124573e-7a19-3929-b430-e1a6f60f25ad",
                                "text": "Wierzby, które rodzą gruszki znaleźć można w Szczawnicy nad Dunajcem oraz w arboretum w Kórniku"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fde98aed-8e9d-4c73-8e37-cbca244def7b",
