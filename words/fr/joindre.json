    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ba0759cd-bde0-3a69-b2cc-e0d3459f8acf",
                    "sense_definition": "Entrer en contact avec quelqu'un, en particulier par téléphone, courrier ou message électronique.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai essayé de te téléphoner hier soir, mais je n'ai pas pu te <w>joindre</w>."
                        },
                        {
                            "text": "Si vous avez une question urgente, vous pouvez nous <w>joindre</w> à ce numéro."
                        }
                    ],
                    "common_phrases": [
                        "joindre quelqu'un au téléphone"
                    ],
                    "synonyms": [
                        "contacter"
                    ]
                },
                {
                    "sense_id": "fb427429-9f92-341d-ae93-70ee3e6c8a3f",
                    "sense_definition": "Ajouter un élément, en particulier un document ou une lettre, à un autre pour le compléter.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ajout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veuillez <w>joindre</w> une copie de votre pièce d'identité à votre demande d'inscription."
                        },
                        {
                            "text": "J'ai <w>joint</w> un calendrier détaillé à mon message pour préparer la réunion."
                        }
                    ],
                    "common_phrases": [
                        "joindre une pièce justificative",
                        "joindre un document"
                    ]
                },
                {
                    "sense_id": "36de4507-a650-3175-aecb-17a89afc92fd",
                    "sense_definition": "Mettre deux choses l'une contre l'autre pour qu'elles se touchent ou soient reliées physiquement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "contact_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le menuisier utilise de la colle spéciale pour <w>joindre</w> ces deux morceaux de bois."
                        },
                        {
                            "text": "L'enfant saute par-dessus le ruisseau à pieds <w>joints</w> sans hésiter."
                        }
                    ],
                    "synonyms": [
                        "unir",
                        "assembler"
                    ],
                    "common_phrases": [
                        "joindre les mains",
                        "à pieds joints"
                    ]
                },
                {
                    "sense_id": "8c29fb86-e288-3076-b475-b74b9f6c412e",
                    "sense_definition": "Associer des qualités, des actions ou des personnes pour agir ensemble de manière complémentaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "union",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce projet novateur réussit à <w>joindre</w> l'utile à l'agréable de façon remarquable."
                        },
                        {
                            "text": "Les deux associations ont décidé de <w>joindre</w> leurs efforts pour aider les sinistrés."
                        }
                    ],
                    "common_phrases": [
                        "joindre l'utile à l'agréable",
                        "joindre le geste à la parole",
                        "joindre leurs forces"
                    ]
                }
            ]
        }
    ]
}