                        "examples": [
                            {
                                "example_id": "71db631a-df42-4dee-8506-d12192e32091",
                                "sense_id": "0cf40eae-561a-371a-8537-c9a8d7e8f539",
                                "text": "The Major then went with me and Euphemia (Victoria staying at the inn) and showed us what is called the Ditch, being the fossé and ruinous banks of the old castle […] ."
                            },
                            {
                                "example_id": "7f55d0c3-0ab6-4c0c-a8cc-8b13d6bd69f3",
                                "sense_id": "0cf40eae-561a-371a-8537-c9a8d7e8f539",
                                "text": "I saw him tied up between two boards, by way of the coffin, which was to be provided by contract; and deposited in the fossé that surrounded our prison […]."
                            }
                        ]
                    }
