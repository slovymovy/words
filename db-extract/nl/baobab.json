                                    {
                                        "sense_id": "d3604adc-2aeb-3285-b6b7-7fad9f76aeba",
                                        "entry_id": "7ff50242-6e37-3f94-8e11-2b619822da28",
                                        "glosses": [
                                            "ein Baum der afrikanischen Savanne sowie trockener Gebiete Madagaskars und Australiens (Gattung Adansonia)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf925a76-b78c-493b-947b-0edebeff936b",
                                                "sense_id": "d3604adc-2aeb-3285-b6b7-7fad9f76aeba",
                                                "text": "Der Affenbrotbaum ist der Nationalbaum der Republik Kongo."
                                            },
                                            {
                                                "example_id": "1bb7a115-a96d-4158-996d-69fb3d791dca",
                                                "sense_id": "d3604adc-2aeb-3285-b6b7-7fad9f76aeba",
                                                "text": "„Goso liebte die Kinder sehr und wurde von ihnen wieder geliebt. Er versammelte täglich eine Schar von Kindern um sich unter einem Affenbrotbaum und erzählte ihnen viele schöne Geschichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bca996c0-3a50-4c3a-b700-5d07854312b1",
                        "source_entry_id": "e509fba2-6f83-3976-b9f0-b6643cdcf575",
                        "source_sense_id": "2e9af57d-29a6-3185-b5e7-1b3f1414dbf2",
                        "source_sense_description": "benaming voor dikstammige bomen uit droge, warme gebieden uit het geslacht Adansonia",
                        "target_lang_word": "Baobab",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baobab",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3676d699-edc5-3664-afc5-b64ebbc75540",
                                        "entry_id": "9d1e4143-45d6-33c2-bf06-b289d6d27a0a",
                                        "glosses": [
                                            "eine afrikanische Baumart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e2d4300-ac0b-4043-880a-79c4cbc32ef9",
                                                "sense_id": "3676d699-edc5-3664-afc5-b64ebbc75540",
                                                "text": "„Wie schon erwähnt, ist der Baobab von der Sahelzone in Westafrika über Zentral-,Ost- und Südafrika verbreitet.“"
                                            },
                                            {
                                                "example_id": "1cb9d392-31bf-4c64-b29e-e1ab14cb8f0a",
                                                "sense_id": "3676d699-edc5-3664-afc5-b64ebbc75540",
                                                "text": "„Jener Baobab, der den gesamten Kontinent repräsentiert und auf den umgekehrt der Kontinent vollständig reduziert wird, verheißt eine Ursprünglichkeit, die quer steht zur (kriegerischen) Moderne Europas.“"
                                            },
                                            {
                                                "example_id": "bb5373b6-3c25-464a-9192-c566fa0d5a6b",
                                                "sense_id": "3676d699-edc5-3664-afc5-b64ebbc75540",
                                                "text": "„Ich warf einen letzten Blick auf den gewaltigen Baobab in der Einfahrt des versandeten Hafens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
