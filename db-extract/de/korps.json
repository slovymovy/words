                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corps",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10fc57f6-d280-3236-9cbf-45cef90c6fbe",
                                        "entry_id": "a89d4103-9435-3e9d-a645-5be6af6eff97",
                                        "glosses": [
                                            "A battlefield formation composed of two or more divisions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "607d1c07-9f05-39da-b355-5d37c5cda660",
                                        "entry_id": "a89d4103-9435-3e9d-a645-5be6af6eff97",
                                        "glosses": [
                                            "An organized group of people united by a common purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ed4c442-7049-4917-9c98-2088dac68a90",
                                                "sense_id": "607d1c07-9f05-39da-b355-5d37c5cda660",
                                                "text": "diplomatic corps"
                                            },
                                            {
                                                "example_id": "db3b91ef-f8eb-4c9d-9a11-a22ae80c84a6",
                                                "sense_id": "607d1c07-9f05-39da-b355-5d37c5cda660",
                                                "text": "White House press corps"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "corps",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f58aad4a-cb3f-3d47-90d4-45c9537c602c",
                                        "entry_id": "9152a29f-1908-3e07-b985-496e4c7c46a4",
                                        "glosses": [
                                            "A corps de ballet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d39483bc-6dc0-4f25-b371-2b90584b41ed",
                                                "sense_id": "f58aad4a-cb3f-3d47-90d4-45c9537c602c",
                                                "text": "The performers were all creditable dancers as well as comedians […] even the largest of them cavorted about en pointe with wonderful ease, and the corps work was extremely precise in its inaccuracies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "corps",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1097b2ef-9d1c-3d86-b6a4-ce761b58bee4",
                                        "entry_id": "5c07d3a9-4e6a-320b-bf30-da030e81bc4f",
                                        "glosses": [
                                            "plural of corp"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "corps",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8fff9743-69d5-30b1-8c84-d98d49e96ba3",
                                        "entry_id": "66d4d8e7-8ef6-3640-b795-b3ea1f2168e7",
                                        "glosses": [
                                            "Obsolete spelling of corpse."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e76559a-dcd9-480d-8c5c-b5aa390eadd8",
                                                "sense_id": "8fff9743-69d5-30b1-8c84-d98d49e96ba3",
                                                "text": "How to keep the corps ſeven dayes from corruption by anointing and waſhing, without exenteration, were an hazardable peece of art, in our choiſeſt practiſe."
                                            },
                                            {
                                                "example_id": "cbf8796d-f92a-487f-ab40-b1f298d274fd",
                                                "sense_id": "8fff9743-69d5-30b1-8c84-d98d49e96ba3",
                                                "text": "To mee, who with eternal Famin pine, / Alike is Hell, or Paradiſe, or Heaven, / There beſt, where moſt with ravin I may meet; / Which here, though plenteous, all too little ſeems / To ſtuff this Maw, this vaſt unhide-bound Corps."
                                            },
                                            {
                                                "example_id": "5e0497a6-230a-417b-8aa8-31596f2d4cc5",
                                                "sense_id": "8fff9743-69d5-30b1-8c84-d98d49e96ba3",
                                                "text": "Did I poſſeſs the power of reſuſcitation, I would reanimate thy lifeleſs corps, and cheriſh thee in the warmeſt corner of thy favourite dwelling-place."
                                            },
                                            {
                                                "example_id": "7c29ad8f-a3d2-4241-b58d-e93dbbf24a4b",
                                                "sense_id": "8fff9743-69d5-30b1-8c84-d98d49e96ba3",
                                                "text": "The women looked like dead bodies; and never did I see such a sepulchral appearance as their dress and colourless faces exhibited, they were all dressed alike in drab gowns, white neck kerchiefs, and a cap fitting close over their ears, and fastened under the chin, the same sort as are placed on a corps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
