        "fr-extract.jsonl": [
            {
                "entry_id": "2148b3e0-3046-3d16-afd6-bcfe0912c398",
                "word": "logithèque",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b35c4c6f-1959-45ac-9193-ed242475e5f2",
                        "entry_id": "2148b3e0-3046-3d16-afd6-bcfe0912c398",
                        "tags": [
                            "plural"
                        ],
                        "form": "logithèques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d2bb70b5-6bab-34e8-982e-ca60941b6917",
                        "entry_id": "2148b3e0-3046-3d16-afd6-bcfe0912c398",
                        "glosses": [
                            "Site web où il est possible de téléverser (habituellement gratuitement) des logiciels."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "09fd4738-571c-4d7b-92c5-81bb7cecb51d",
                                "sense_id": "d2bb70b5-6bab-34e8-982e-ca60941b6917",
                                "text": "Un petit logiciel circule sur la Toile depuis quelques jours […] On le trouve aujourd’hui facilement […]. D’autant plus aisément que des sites réputés vont jusqu’à le référencer dans leur logithèque."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ba6e588-e264-398c-9063-b541537dda46",
                        "entry_id": "2148b3e0-3046-3d16-afd6-bcfe0912c398",
                        "glosses": [
                            "Lieu ou service (par exemple dans une bibliothèque) où il est possible d’essayer, d’emprunter ou d’utiliser des logiciels."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "29e8f025-03ad-47e2-9261-c4652290bf58",
                                "sense_id": "9ba6e588-e264-398c-9063-b541537dda46",
                                "text": "Enfin, à la logithèque, les Saint-Mauriens peuvent utiliser une vingtaine d’ordinateurs reliés à Internet."
                            },
                            {
                                "example_id": "79e3c570-38be-462b-ab0f-9ac798accf4e",
                                "sense_id": "9ba6e588-e264-398c-9063-b541537dda46",
                                "text": "Il s’agira d’une bibliothèque de prêt, où chacun pourra non seulement se servir et apporter chez soi un ou plusieurs des quelque 750 000 ouvrages de la collection universelle et publique mais trouver son bonheur parmi des milliers d’autres documents sur tous supports (disques, cédéroms, vidéos, etc.). Et encore ? Une vaste médiathèque des jeunes, où seront admis et animés même les poupons, des centaines de postes informatiques et d’accès à Internet, une vidéothèque, une phonothèque, une logithèque, un laboratoire de langues, une bibliothèque de livres rares et précieux, une bibliothèque d'économie et affaires, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "a15dede7-d31e-3550-9876-8957cde3e89b",
                        "entry_id": "2148b3e0-3046-3d16-afd6-bcfe0912c398",
                        "glosses": [
                            "Collection de logiciels d’un individu ou d’une organisation."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "1d2d8329-13b6-4bc4-8be4-d2159ac3d528",
                                "sense_id": "a15dede7-d31e-3550-9876-8957cde3e89b",
                                "text": "On déplore toutefois que ce magnifique outil qui, à mon pas très humble avis, se doit de prendre place dans toute bonne logithèque, ne soit pas édité en version Macintosh."
                            }
                        ]
                    }
                ],
