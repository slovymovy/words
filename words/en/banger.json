                    "frequency": "Low",
                    "semantic_group_id": "explosive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were letting off <w>bangers</w> in the street on New Year's Eve.",
                            "target_lang_translations": {
                                "ru": "В канун Нового года дети взрывали <w>петарды</w> прямо на улице.",
                                "it": "La notte di Capodanno i bambini facevano esplodere <w>petardi</w> per strada."
                            }
                        },
                        {
                            "text": "A loud <w>banger</w> startled the birds roosting in the trees.",
