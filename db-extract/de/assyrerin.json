                "senses": [
                    {
                        "sense_id": "c44ee411-71b2-337a-a052-41541cb9a081",
                        "entry_id": "8b67e3f1-36ff-3fe2-86e3-962b324aef78",
                        "glosses": [
                            "Angehörige des Volkes der Assyrer¹"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "17544712-05dd-46c4-9568-0743d22a6c0a",
                                "sense_id": "c44ee411-71b2-337a-a052-41541cb9a081",
                                "text": "„In der Frau dieser Zeit kennt man das Recht der individualen Eigenschaft, die ihr vor dem Gericht eine rechtliche Persönlichkeit zuschreibt. Nach einer Urkunde ist eine der beklagten Personen die Assyrerin namens Sat-ili (EL 245).“"
                            },
                            {
                                "example_id": "cc195eb0-2412-49ba-9a04-8a89071438f2",
                                "sense_id": "c44ee411-71b2-337a-a052-41541cb9a081",
                                "text": "„So ehelichte die Assyrerin Ištar-lamassī nach dem Tode ihres assyrischen Mannes einen Anatolier.“"
                            },
                            {
                                "example_id": "1af086fc-aa8f-49b0-89ef-e21a7b3c62cd",
                                "sense_id": "c44ee411-71b2-337a-a052-41541cb9a081",
                                "text": "„Semiramis ist ein altgriechischer Name für eine Assyrerin mit dem Namen Schammu-ramat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e0e31b20-6694-3dc1-90d2-d4756a54fd58",
                        "entry_id": "8b67e3f1-36ff-3fe2-86e3-962b324aef78",
                        "glosses": [
                            "Angehörige der christlichen Gruppe/Kultur der Assyrer²"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89ee464a-9e79-4894-87ba-67dbf01dfb0d",
                                "sense_id": "e0e31b20-6694-3dc1-90d2-d4756a54fd58",
                                "text": "„Die 19-jährige Assyrerin und der 23-jährige Halbamerikaner mussten aufgrund ihrer Kultur zunächst eine geheime Beziehung führen.“"
                            },
                            {
                                "example_id": "57f26ffb-ba25-45b0-80cf-ff8dd149bf39",
                                "sense_id": "e0e31b20-6694-3dc1-90d2-d4756a54fd58",
                                "text": "„Mit 19 Jahren verließ ich meine Heimat Syrien als Assyrerin und lebe seitdem in Gießen.“"
                            },
                            {
                                "example_id": "43a10b9c-f258-4559-aaa2-bbd2ccd5affc",
                                "sense_id": "e0e31b20-6694-3dc1-90d2-d4756a54fd58",
                                "text": "„Seine Verlobte, ebenfalls eine syrisch-orthodoxe Assyrerin, konnte jedoch als Gastarbeiterin nach Deutschland gehen.“"
                            },
                            {
                                "example_id": "2f0ab4af-d1db-4f3a-8ae5-6340ee5c16dd",
                                "sense_id": "e0e31b20-6694-3dc1-90d2-d4756a54fd58",
                                "text": "„Zum Vorsitzenden der Demokratisch autonomen Verwaltung wurde der Kurde Ekrem Heso gewählt, seine StellvertreterInnen [sic] sind die Assyrerin Elizabet Gewriyê und der Araber Husen Ezem.“"
                            },
                            {
                                "example_id": "3f582ff7-2e25-42c3-8a20-517b897a65b8",
                                "sense_id": "e0e31b20-6694-3dc1-90d2-d4756a54fd58",
                                "text": "„Als die Assyrerinnen und Assyrer verzweifelt in der Landeshauptstadt Erbil der autonomen Region Kurdistans zu protestieren versuchten, wurden sie von bewaffneten Männern der Peschmerga und der Asayish zum Schweigen gebracht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
