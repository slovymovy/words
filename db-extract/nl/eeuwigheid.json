                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a0c445a-41c8-3cda-89f7-443c0d0aa2df",
                        "entry_id": "9c417bff-a537-3278-b41c-2bfb93f0da20",
                        "glosses": [
                            "de oneindige tijd die nog zal komen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "134a897a-e05a-4464-bb0a-45d30ebf8d5c",
                                "sense_id": "6a0c445a-41c8-3cda-89f7-443c0d0aa2df",
                                "text": "Volgens sommige christenen moet je tot in de eeuwigheid branden in de hel als je niet in hun stroming van het christendom gelooft."
                            },
                            {
                                "example_id": "a4339b19-8c14-48b0-90b3-448575f65258",
                                "sense_id": "6a0c445a-41c8-3cda-89f7-443c0d0aa2df",
                                "text": "Als zij van eeuwigheid fluisterde, wist ze waarover ze het had. Ze had genoeg jurken voor alle feesten die zouden komen."
                            }
                        ]
                    },
                    {
                        "sense_id": "86525c91-02f2-395a-8a41-5d63fd5b0a47",
                        "entry_id": "9c417bff-a537-3278-b41c-2bfb93f0da20",
                        "glosses": [
                            "veel meer tijd dan gewenst"
                        ],
                        "tags": [
                            "hyperbolisch"
                        ],
                        "examples": [
                            {
                                "example_id": "420b3d5f-6790-47f0-a74b-5057f8b83289",
                                "sense_id": "86525c91-02f2-395a-8a41-5d63fd5b0a47",
                                "text": "Ik heb hier echt een eeuwigheid zitten wachten tot je eindelijk klaar was."
                            }
                        ]
                    },
                    {
                        "sense_id": "36fc3243-63bd-3c3d-a833-b2ddeb7b3402",
                        "entry_id": "9c417bff-a537-3278-b41c-2bfb93f0da20",
                        "glosses": [
                            "een gevoelsmatig lange tijd"
                        ],
                        "tags": [
                            "hyperbolisch"
                        ],
                        "examples": [
                            {
                                "example_id": "ef526aaa-a210-4edf-a72e-7ff35ce7d4e3",
                                "sense_id": "36fc3243-63bd-3c3d-a833-b2ddeb7b3402",
                                "text": "Die nachtmerrie leek wel een eeuwigheid te duren, maar in feite waren het slechts seconden."
                            },
                            {
                                "example_id": "77fa62b4-a239-4384-9fdf-ab71cefbc0d5",
                                "sense_id": "36fc3243-63bd-3c3d-a833-b2ddeb7b3402",
                                "text": "Voor vertrek kreeg ik naast enthousiaste reacties ook veel aanmerkingen. Een halfjaar weg van mijn gezin vond men wel erg lang. Toch voelde het voor mij niet als een eeuwigheid, wat zijn immers zes maanden op een mensenleven?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ab2e4ad-3a25-47d4-ba08-cf216245145d",
                        "source_entry_id": "9c417bff-a537-3278-b41c-2bfb93f0da20",
                        "source_sense_id": "6a0c445a-41c8-3cda-89f7-443c0d0aa2df",
                        "source_sense_description": "alle tijd die nog zal komen",
                        "target_lang_word": "Ewigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ewigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c1475242-488c-351e-ad6d-f1cfa6568a2e",
                                        "entry_id": "9d1bbc52-8231-37b4-a851-d6961db76ac0",
                                        "glosses": [
                                            "ein langer Zeitraum"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9e4f5bd-a82a-4f2e-ad46-438618884dba",
                                                "sense_id": "c1475242-488c-351e-ad6d-f1cfa6568a2e",
                                                "text": "Du brauchst ja wieder eine Ewigkeit, bis du endlich fertig bist."
                                            },
                                            {
                                                "example_id": "ee394a97-62f8-4ad7-acfc-caee4bf76468",
                                                "sense_id": "c1475242-488c-351e-ad6d-f1cfa6568a2e",
                                                "text": "„An der Front sei er einer brutalen Ewigkeit ausgesetzt gewesen, er habe irgendwann nicht einmal mehr Tag und Nacht unterscheiden können unter all dem Staub und Rauch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3b4ee663-3b74-343f-9b34-f70e5506c87f",
                                        "entry_id": "9d1bbc52-8231-37b4-a851-d6961db76ac0",
                                        "glosses": [
                                            "Zeitlosigkeit ohne Anfang und ohne Ende"
                                        ],
                                        "tags": [
                                            "Theologie",
                                            "Philosopie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61f709f9-1e7a-4ded-9dd8-6db0687dd6ad",
                                                "sense_id": "3b4ee663-3b74-343f-9b34-f70e5506c87f",
                                                "text": "Ewigkeit ist wie „Liebe“ – sehr real, aber schwer zu definieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7b940e78-d40b-3dc7-b9f1-c995f4291700",
                                        "entry_id": "9d1bbc52-8231-37b4-a851-d6961db76ac0",
                                        "glosses": [
                                            "Zeitlosigkeit mit Anfang, aber ohne Ende"
                                        ],
                                        "tags": [
                                            "Theologie",
                                            "Philosopie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb782bd7-7d64-44a1-b28a-5f9791a522e4",
                                                "sense_id": "7b940e78-d40b-3dc7-b9f1-c995f4291700",
                                                "text": "Da droht Verdammnis in alle Ewigkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3818f7e6-7d49-4833-bcd0-425dfb107073",
                        "source_entry_id": "9c417bff-a537-3278-b41c-2bfb93f0da20",
                        "source_sense_id": "6a0c445a-41c8-3cda-89f7-443c0d0aa2df",
                        "source_sense_description": "alle tijd die nog zal komen",
                        "target_lang_word": "eternity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eternity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e7bf054-ae51-30bf-99e0-803b8d21a163",
                                        "entry_id": "e20f5b06-750e-3b8c-8c12-a76a258707f9",
                                        "glosses": [
                                            "Existence without end, infinite time."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "125e4f7d-d323-4079-b6fb-97b4a98c27ac",
                                                "sense_id": "2e7bf054-ae51-30bf-99e0-803b8d21a163",
                                                "text": "Eternity has generally been considered as divisible into two parts; which have been termed, eternity a parte ante, and eternity a parte post: that is, in plain English, that eternity which is past, and that eternity which is to come."
                                            },
                                            {
                                                "example_id": "3c77273f-c392-4546-a95d-6110239fbacf",
                                                "sense_id": "2e7bf054-ae51-30bf-99e0-803b8d21a163",
                                                "text": "This theory regards creation as an act of God in eternity past."
                                            },
                                            {
                                                "example_id": "83c2073d-e198-4e76-a626-fd1a33e89729",
                                                "sense_id": "2e7bf054-ae51-30bf-99e0-803b8d21a163",
                                                "text": "Those who like not the company of the saints on earth will get none of it in eternity; but, as godless company is their delight now, they will afterwards get enough of it, when they have eternity to pass in the roaring and blaspheming society of devils and reprobates in hell."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3cd4137-d91f-3059-aff2-c56e1f98d2de",
                                        "entry_id": "e20f5b06-750e-3b8c-8c12-a76a258707f9",
                                        "glosses": [
                                            "Existence outside of time."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51882160-8050-4dd5-a26e-f6556a6e40b8",
                                                "sense_id": "a3cd4137-d91f-3059-aff2-c56e1f98d2de",
                                                "text": "We sometimes speak of eternity in contradistinction to time; and often say, \"through time and into eternity;\" and again \"from eternity to eternity,\" which is simply another form of expressing the same idea, and \"pass through time into eternity.\" in other words, time is a short period allotted to man in his probationary state—and we use the word time in contradistinction to the word eternity, merely for the accommodation of man in his finite sphere, that we may comprehend and learn to measure periods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72bce441-c4f1-302e-938d-a9fb09b9df76",
                                        "entry_id": "e20f5b06-750e-3b8c-8c12-a76a258707f9",
                                        "glosses": [
                                            "A period of time which extends infinitely far into the future."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2ab4ac1-94ca-4d04-b439-0785e995338d",
                                                "sense_id": "72bce441-c4f1-302e-938d-a9fb09b9df76",
                                                "text": "Every niche was filled by a funeral urn, and by marble shapes that bent down in a pale eternity of sorrow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39e194b2-eef8-3819-85df-11e19f32a873",
                                        "entry_id": "e20f5b06-750e-3b8c-8c12-a76a258707f9",
                                        "glosses": [
                                            "The remainder of time that elapses after death."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7714c53d-d7cd-45e1-92ae-206746248c4b",
                                                "sense_id": "39e194b2-eef8-3819-85df-11e19f32a873",
                                                "text": "When the wind blows not, where, then, is the wind? / Or when thou art not living, where art thou? / What should the wind care for the hours of calm or thou for death? / Thy life is long, Eternity is short. / So short that, shouldst thou die and Eternity should pass, and after the passing of Eternity thou shouldst live again, thou wouldst say: ‘I closed mine eyes but for an instant.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56227cac-0de9-3e21-9241-2b1f745edd6e",
                                        "entry_id": "e20f5b06-750e-3b8c-8c12-a76a258707f9",
                                        "glosses": [
                                            "A comparatively long time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "excessive",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e2dd0dd-e209-4af0-985c-cfd805bfd529",
                                                "sense_id": "56227cac-0de9-3e21-9241-2b1f745edd6e",
                                                "text": "It's been an eternity since we last saw each other."
                                            },
                                            {
                                                "example_id": "e3c74bd4-5e3d-4e0a-b919-0a6a0b594e2f",
                                                "sense_id": "56227cac-0de9-3e21-9241-2b1f745edd6e",
                                                "text": "I had to wait in the station for ten days - an eternity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60b82368-ac71-421c-bea6-e8f93bed54bf",
                        "source_entry_id": "9c417bff-a537-3278-b41c-2bfb93f0da20",
                        "source_sense_id": "6a0c445a-41c8-3cda-89f7-443c0d0aa2df",
                        "source_sense_description": "alle tijd die nog zal komen",
                        "target_lang_word": "éternité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éternité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b499b33-6762-3e9a-99bd-4ff4b43d5f61",
                                        "entry_id": "01043e90-65a5-34a8-8a36-392d699effec",
                                        "glosses": [
                                            "Durée qui n’a ni commencement ni fin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eef6099a-b12e-46f9-96b8-7fc73f4aa6da",
                                                "sense_id": "0b499b33-6762-3e9a-99bd-4ff4b43d5f61",
                                                "text": "Il est vrai que Fontenelle, à l’inverse de Descartes, ne tente en aucune façon de faire échapper les sciences à l’histoire en revendiquant pour elles une sorte d’éternité."
                                            },
                                            {
                                                "example_id": "708de196-75c4-4890-b0b6-a55ba685be1e",
                                                "sense_id": "0b499b33-6762-3e9a-99bd-4ff4b43d5f61",
                                                "text": "Le temps n’est qu’une partie de l’éternité."
                                            },
                                            {
                                                "example_id": "28fc6d31-9d2b-4d96-9334-9d8fa614b147",
                                                "sense_id": "0b499b33-6762-3e9a-99bd-4ff4b43d5f61",
                                                "text": "Comme si on pouvait tuer le temps sans blesser l’éternité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0ca495b-95a7-34ec-8668-9b6f6bd79f2b",
                                        "entry_id": "01043e90-65a5-34a8-8a36-392d699effec",
                                        "glosses": [
                                            "Durée qui a un commencement, mais qui n’aura pas de fin."
                                        ],
                                        "tags": [],
                                        "note": "Dans ce sens on l’emploie surtout en parlant de la vie à venir",
                                        "examples": [
                                            {
                                                "example_id": "312e6e46-8b4b-49ab-994f-17a82ae12346",
                                                "sense_id": "f0ca495b-95a7-34ec-8668-9b6f6bd79f2b",
                                                "text": "[…]; et, quand M. de Bonald est venu réclamer à la Chambre, en 1816, au nom de la religion catholique redevenue religion de l’État, le rétablissement de l’indissolubilité du mariage, il s'est bien gardé de réclamer en même temps et au même titre le rétablissement de l’éternité des vœux ecclésiastiques."
                                            },
                                            {
                                                "example_id": "ba4d4fac-03d7-4071-87b2-f52c9c652658",
                                                "sense_id": "f0ca495b-95a7-34ec-8668-9b6f6bd79f2b",
                                                "text": "[…] ils n’ignorent rien de tout cela et savent notamment fort bien que c’est en l’affirmant qu’ils créeront cette éternité de barbarie nécessaire au maintien des institutions qui leur sont chères."
                                            },
                                            {
                                                "example_id": "04ca3322-5a57-4951-99af-70ecbcfaa233",
                                                "sense_id": "f0ca495b-95a7-34ec-8668-9b6f6bd79f2b",
                                                "text": "En outre, l’organisation de la famille française s’est achevée sous l’influence du droit canon et du droit romain qui revêtaient hier encore un aspect d’éternité et qui nous surprennent aujourd’hui par l’imminence de leur déclin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1009f338-1f3b-3ec9-971f-49a7907c08da",
                                        "entry_id": "01043e90-65a5-34a8-8a36-392d699effec",
                                        "glosses": [
                                            "Temps qui semble durer trop longtemps."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "115c0e3f-0ab5-4ce8-bd43-68ea68f79273",
                                                "sense_id": "1009f338-1f3b-3ec9-971f-49a7907c08da",
                                                "text": "Le doigt sur la détente de nos armes, tous les muscles tendus, ne respirant plus, nous attendons… et il me semble qu’il se passe une éternité…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "649c350d-cc22-385c-8fed-9a301a54de37",
                                        "entry_id": "01043e90-65a5-34a8-8a36-392d699effec",
                                        "glosses": [
                                            "Caractère de ce qui est éternel."
                                        ],
                                        "tags": [
                                            "Langage savant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35234eb2-fd6a-45d6-8139-650ea7353ff0",
                                                "sense_id": "649c350d-cc22-385c-8fed-9a301a54de37",
                                                "text": "L'éternité de la matière"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af2b9bf2-bf26-3337-976c-a6c93ab341ad",
                                        "entry_id": "01043e90-65a5-34a8-8a36-392d699effec",
                                        "glosses": [
                                            "La vie éternelle après la mort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "846c4932-c90c-4332-b638-b02a791e081e",
                                                "sense_id": "af2b9bf2-bf26-3337-976c-a6c93ab341ad",
                                                "text": "Le passage de la vie à l’éternité est court mais terrible ; il ne me reste que bien peu d’instants pour me préparer à la mort."
                                            },
                                            {
                                                "example_id": "c74fcb96-5fb5-4804-b64f-bdcb865be9ee",
                                                "sense_id": "af2b9bf2-bf26-3337-976c-a6c93ab341ad",
                                                "text": "L’éternité c'est long, surtout vers la fin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3210b4a9-0534-3099-9166-107f59a41fb1",
                                        "entry_id": "01043e90-65a5-34a8-8a36-392d699effec",
                                        "glosses": [
                                            "Meuble représenté par un serpent en anneau se mordant la queue dans certaines armoiries. Cette terminologie du blason n’est utilisée que par quelques auteurs à titre symbolique. À « éternité » on préfère généralement le terme d'ouroboros ou ourobore."
                                        ],
                                        "tags": [
                                            "Très rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ce67141-b7d3-4a01-9d20-fc987b26141f",
                                                "sense_id": "3210b4a9-0534-3099-9166-107f59a41fb1",
                                                "text": "Éternité : quelques auteurs la symbolisent ainsi, avec un serpent, formant un cercle, en se mordant le bout de la queue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
