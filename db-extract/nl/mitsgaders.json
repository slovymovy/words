                                "target_senses": [
                                    {
                                        "sense_id": "9601e462-3e55-36c7-9ac5-48c65c0cc365",
                                        "entry_id": "30d0321a-c317-37d1-8086-cd1bacb917af",
                                        "glosses": [
                                            "zusammen mit, gemeinsam mit, mit allem"
                                        ],
                                        "tags": [
                                            "modale Präposition mit Dativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "386387b4-763e-4d0a-b575-af68419972b7",
                                                "sense_id": "9601e462-3e55-36c7-9ac5-48c65c0cc365",
                                                "text": "Er aß den Apfel mitsamt dem Kerngehäuse."
                                            },
                                            {
                                                "example_id": "5f7d2859-e389-49f2-ab4f-567732d9f835",
                                                "sense_id": "9601e462-3e55-36c7-9ac5-48c65c0cc365",
                                                "text": "Morgen kommt mein Bruder mitsamt seiner Familie zu Besuch."
                                            },
                                            {
                                                "example_id": "6f6a2d36-bd45-47d9-96de-9642fadc79fd",
                                                "sense_id": "9601e462-3e55-36c7-9ac5-48c65c0cc365",
                                                "text": "„Er gehe dann zu Koczulek telefonieren, spreche in einer fremden Sprache, so daß Koczulek nicht verstehen könne, was er sage, und am nächsten Tag käme wieder dieses schwarze Auto mitsamt Schofför, und dann führen sie weg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bed633b-0e46-4dd9-b27e-4cb213a3153c",
                        "source_entry_id": "e5b9ad85-74b3-3005-afbb-1dcead0754f8",
                        "source_sense_id": "c33d2adc-0dec-33a9-a9db-2701d8305b29",
                        "target_lang_word": "samt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "samt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "081991e2-7319-305c-8c34-ca67fcaec8f7",
                                        "entry_id": "f487458e-fe83-36a6-9273-b68c6759c1a4",
                                        "glosses": [
                                            "mit Dativ: zusammen mit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4717e43e-0ffd-4a33-a9d0-59c881f48f9c",
                                                "sense_id": "081991e2-7319-305c-8c34-ca67fcaec8f7",
                                                "text": "Das Hausboot wurde samt allem Inventar verkauft."
                                            },
                                            {
                                                "example_id": "56510967-1d03-431b-96f7-eb8b4cd858f2",
                                                "sense_id": "081991e2-7319-305c-8c34-ca67fcaec8f7",
                                                "text": "„Fürst Constantin Brâncoveanu, unter dem das walachische Fürstentum seinen höchsten Glanz hatte erreichen können, wurde 1714 samt seinen Söhnen in Konstantinopel hingerichtet …“"
                                            },
                                            {
                                                "example_id": "141ea6ce-8e6b-4fc5-a19e-6fd8dad62586",
                                                "sense_id": "081991e2-7319-305c-8c34-ca67fcaec8f7",
                                                "text": "„Jakob und ich bestaunen die erhabene Erscheinung dieser Troika wie kleine Jungs den Auftritt eines Weihnachtsmanns samt Rentieren.“"
                                            },
                                            {
                                                "example_id": "a260e587-6bdd-4a62-8076-93f510d1521d",
                                                "sense_id": "081991e2-7319-305c-8c34-ca67fcaec8f7",
                                                "text": "„Der Wasserspiegel ist so stark gestiegen, dass das Sonnendeck samt Reling abgebaut wurde, damit das Boot unbeschadet unter den Brücken durchkommt.“"
                                            },
                                            {
                                                "example_id": "0927c0e5-c3dd-40e8-b0db-0e8fc266238b",
                                                "sense_id": "081991e2-7319-305c-8c34-ca67fcaec8f7",
                                                "text": "„Walter Huppenkothen, Sonderkommissar im Reichssicherheitshauptamt, fährt am 7. April 1945 samt Ehefrau, Koffern, Akten und Benzin von Sachsenhausen nach Bayern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bee889d-a5a8-46eb-b70c-42c102937611",
                        "source_entry_id": "e5b9ad85-74b3-3005-afbb-1dcead0754f8",
