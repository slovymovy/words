                        "entry_id": "1d30025f-a0ae-3a0b-8540-53d73a0fc25e",
                        "glosses": [
                            "to take/swallow a mouthful (of)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "85da35a6-16d8-4453-ae72-5e1be3053bb9",
                                "sense_id": "9a27ff61-5ce8-3dae-b28c-9154e502478a",
                                "text": "хлебну́ть ли́шнего",
                                "translation": "to have a drop too much",
                                "english": "to have a drop too much"
                            },
                            {
                                "example_id": "83a14d22-f057-40f8-8bff-9c1782c0f3f3",
                                "sense_id": "9a27ff61-5ce8-3dae-b28c-9154e502478a",
                                "text": "хлебну́ть го́ря",
                                "translation": "to have seen/known much sorrow; have had one's share of trouble/grief",
                                "english": "to have seen/known much sorrow; have had one's share of trouble/grief"
                            },
                            {
                                "example_id": "f39da9e8-074a-488c-aabd-4f94a24f347b",
                                "sense_id": "9a27ff61-5ce8-3dae-b28c-9154e502478a",
                                "text": "— Хорошо бы сейчас водки хлебнуть, — сказал студент.\nМы хлебнули по глотку коньяку, и сон прошел совсем.",
                                "translation": "\"It would be good to have a drop of vodka now,\" said the student.\nWe drank a mouthful of brandy, and all sleepiness disappeared entirely.",
                                "english": "\"It would be good to have a drop of vodka now,\" said the student.\nWe drank a mouthful of brandy, and all sleepiness disappeared entirely."
                            }
                        ]
                    }
