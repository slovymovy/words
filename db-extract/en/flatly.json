                                                "sense_id": "9737d2eb-664c-3aa5-a0d4-63e825128485",
                                                "text": "Ne, rozhodně, letos to jen tak nenechám."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ba44cc8-0500-3262-8a9b-1de54e787fcf",
                                        "entry_id": "f5bcbea0-7e5c-32be-9895-947a646d7ffa",
                                        "glosses": [
                                            "vyjadřuje kladnou odpověď, o níž není pochyb"
