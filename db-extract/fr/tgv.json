        "fr-extract.jsonl": [
            {
                "entry_id": "d41ba4e8-3d75-384b-9a6d-f925704d22d4",
                "word": "TGV",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b6e38c8e-9f28-311e-a26d-4056fd8ec726",
                        "entry_id": "d41ba4e8-3d75-384b-9a6d-f925704d22d4",
                        "glosses": [
                            "Train circulant à très grande vitesse (plus de 300 km/h), et exploité par la SNCF."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c10f9d50-bf31-4bd3-9db8-a0682baaad12",
                                "sense_id": "b6e38c8e-9f28-311e-a26d-4056fd8ec726",
                                "text": "En octobre 1997, par exemple, le SERNAM inaugure un service de messagerie express par TGV sur les lignes Atlantique et Sud-Est."
                            },
                            {
                                "example_id": "3d54d49c-9283-4664-8e79-c1bf7131af13",
                                "sense_id": "b6e38c8e-9f28-311e-a26d-4056fd8ec726",
                                "text": "L’après-midi, Félix laissa ses potes à la maison pour qu’ils pussent « buller tranquilou » et il partit avec Margot à Bourg-en-Bresse acheter les billets de TGV pour Paris."
                            },
                            {
                                "example_id": "b9e308d0-c557-4acc-944f-654f772f8a6d",
                                "sense_id": "b6e38c8e-9f28-311e-a26d-4056fd8ec726",
                                "text": "Le plan d’Alvaro était limpide, échapper à l’énorme bouchon, semer ses poursuivants, se poser discrètement en rase campagne, emprunter une nouvelle bagnole, ensuite, par les départementales, rejoindre la gare Saint-Jean à Bordeaux, et puis TGV, Panam, deal et pactole."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b97a416-6802-336a-ab0f-1143bdf06574",
                        "entry_id": "d41ba4e8-3d75-384b-9a6d-f925704d22d4",
                        "glosses": [
                            "Meuble représentant le train du même nom dans les armoiries. Il est très récemment entré dans le corpus héraldique français. Il est généralement représenté par une locomotive et éventuellement un wagon. Il est posé en fasce, l’avant orienté à dextre. À rapprocher de locomotive et wagonnet."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "181c1657-bc27-45a8-b188-f74aa654f95f",
                                "sense_id": "7b97a416-6802-336a-ab0f-1143bdf06574",
                                "text": "De sinople à la barre d’argent chargée d’un TGV d’orangé, de sable et d’argent mouvant de la pointe et accompagnée en chef d’un chevalet de mine aussi de sable mouvant de la barre et brochant sur une usine de même et en pointe d’une roue dentée également de sable enclenchée à un pignon du même, le tout en barre soutenu de trois anneaux olympiques accolés d’azur, de gueules et d’or, 2 et 1 à la bordure componée de 22 pièces d’argent et de gueules, qui est de la commune de Montchanin de Saône-et-Loire"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0bd1962-f548-4d59-91d5-1fe52561e80f",
                        "source_entry_id": "d41ba4e8-3d75-384b-9a6d-f925704d22d4",
                        "source_sense_id": "b6e38c8e-9f28-311e-a26d-4056fd8ec726",
                        "source_sense_description": "Train",
                        "target_lang_word": "Hochgeschwindigkeitszug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hochgeschwindigkeitszug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5fc9b254-e681-3bf1-8d90-585b35bf2fea",
                                        "entry_id": "428dbfae-a0d6-3828-a4bc-a6a127fe0591",
                                        "glosses": [
                                            "Zug, der auf entsprechend ausgebauten Strecken mit Geschwindigkeiten von über 270 km/h fahren kann"
                                        ],
                                        "tags": [
                                            "Eisenbahn"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0625ddff-95ec-4477-95f5-2259bccd2566",
                                                "sense_id": "5fc9b254-e681-3bf1-8d90-585b35bf2fea",
                                                "text": "Hochgeschwindigkeitszüge stellen immer neue Geschwindigkeitsrekorde auf."
                                            },
                                            {
                                                "example_id": "05019ad9-d79d-4ff1-aba0-320d0e5d77b4",
                                                "sense_id": "5fc9b254-e681-3bf1-8d90-585b35bf2fea",
                                                "text": "„Doch obwohl Alstom mit dem TGV selbst einen erfolgreichen Hochgeschwindigkeitszug baut, treibt Siemens sein Konkurrenzprojekt weiter voran.“"
                                            },
                                            {
                                                "example_id": "742b8678-0734-4c70-9981-bb04a851dd6b",
                                                "sense_id": "5fc9b254-e681-3bf1-8d90-585b35bf2fea",
                                                "text": "„Der Hochgeschwindigkeitszug Fuxing bewältigt die 2230 Kilometer zwischen Peking und Hongkong in nur neun Stunden.“"
                                            },
                                            {
                                                "example_id": "aaf9f384-c301-46e0-b6af-ee633b73b5f9",
                                                "sense_id": "5fc9b254-e681-3bf1-8d90-585b35bf2fea",
                                                "text": "„Ich nahm den Hochgeschwindigkeitszug nach Lyon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
