                "senses": [
                    {
                        "sense_id": "3ba5578b-8b47-35d2-9bc1-63ecb5325b82",
                        "entry_id": "76a27f4a-f21e-3805-977f-e6f2ba630b1f",
                        "glosses": [
                            "Ajout d’une ou plusieurs lettres ou syllabes, et donc, souvent, de phonèmes, à la fin d’un mot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de3cebb6-ff77-4128-99a1-8250c39cb100",
                                "sense_id": "3ba5578b-8b47-35d2-9bc1-63ecb5325b82",
                                "text": "« Avecque » pour « avec » en français et « egomet » pour « ego » en latin sont des paragoges."
                            },
                            {
                                "example_id": "94acb3fd-fa12-4b9f-a2b5-e8134e96d2fa",
                                "sense_id": "3ba5578b-8b47-35d2-9bc1-63ecb5325b82",
                                "text": "Très en faveur dans la langue italienne des origines jusqu’au XIVᵉ siècle, l’épithèse (appelée aussi paragoge) consiste en l’ajout occasionnel de phonèmes non étymologiques à la fin d’un mot."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4fce5fc-0495-45e6-9f73-1b7f54766e6f",
                        "source_entry_id": "76a27f4a-f21e-3805-977f-e6f2ba630b1f",
                        "source_sense_id": "3ba5578b-8b47-35d2-9bc1-63ecb5325b82",
                        "source_sense_description": "(Linguistique) Ajout d’une ou plusieurs lettres ou syllabes à la fin d’un mot",
                        "target_lang_word": "Epithese",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Epithese",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ec389eb-22e8-3698-aac5-92169a37baaf",
                                        "entry_id": "b3ac35a7-1681-3d84-b919-0a68d207f798",
                                        "glosses": [
                                            "Anfügen eines Lautes am Wortende, der etymologisch nicht begründet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48e20d7e-1732-4973-86eb-ffcd9394cb55",
                                                "sense_id": "6ec389eb-22e8-3698-aac5-92169a37baaf",
                                                "text": "Zeitweilig wurden viele deutsche Verben im Präteritum mit e-Epithese verwendet, sodass Formen wie „flohe“ (statt: „floh“), „sahe“ (statt: „sah“) oder „ware“ (statt: \"war\") vorkamen."
                                            },
                                            {
                                                "example_id": "c4db3617-1596-416d-9ff1-5dfb803627ca",
                                                "sense_id": "6ec389eb-22e8-3698-aac5-92169a37baaf",
                                                "text": "Als weiteres Beispiel für Epithesen wird oft auf „niemand“ (statt vorher: „nieman“) verwiesen."
                                            },
                                            {
                                                "example_id": "c50341d3-7725-4227-b81a-1d9516c820ba",
                                                "sense_id": "6ec389eb-22e8-3698-aac5-92169a37baaf",
                                                "text": "„Die e-Epithese bei starken Verben des Deutschen ist ein Beispiel eines analogischen Sprachwandelprozesses, der sich nicht durchsetzt, sondern im Lauf der Sprachgeschichte wieder rückgängig gemacht wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9ecabf85-6051-3ee2-97e3-c08e54573dad",
                                        "entry_id": "b3ac35a7-1681-3d84-b919-0a68d207f798",
                                        "glosses": [
                                            "Objekt, das zur Kaschierung eines Körper- oder Organdefekts dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "137a9b12-5751-4a16-a837-ffa8db2f8c71",
                                                "sense_id": "9ecabf85-6051-3ee2-97e3-c08e54573dad",
                                                "text": "Um die großen Narben zu verdecken, trägt der Patient eine Epithese."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
