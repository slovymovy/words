                        "sense_id": "d6faf571-e4b6-3bff-a97a-d98009ebf900",
                        "entry_id": "2dc8e5aa-0b12-3efd-98f9-dfcaefe754cf",
                        "glosses": [
                            "spy mania, spy fever, spy hysteria, spy scare (paranoia about spies, fearmongering about the threat of foreign spies)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "936fe8fb-4b97-4da4-a31b-e37669bbf97f",
                                "sense_id": "d6faf571-e4b6-3bff-a97a-d98009ebf900",
                                "text": "Галчо́нок, я ходи́л в шко́лу в те года́, когда́ в на́шей стране́ шпионома́ния не счита́лась боле́знью.",
                                "translation": "Kid (lit.: little jackdaw), I went to school in the years when spy mania wasn't considered a disease in our country.",
                                "english": "Kid (lit.: little jackdaw), I went to school in the years when spy mania wasn't considered a disease in our country."
                            }
                        ]
