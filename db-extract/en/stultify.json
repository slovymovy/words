                        ],
                        "form": "stultifies"
                    },
                    {
                        "form_id": "79f4f083-5556-4457-91b8-070d34aa6e8b",
                        "entry_id": "c7568b71-57d5-3c23-93c5-640595c4f93b",
                        "tags": [
                            "participle",
