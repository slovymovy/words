                                    {
                                        "sense_id": "0397592b-3df0-3008-b6ac-f8817f63488d",
                                        "entry_id": "7e3e9768-bfb2-3c15-8f48-ffab23445ef7",
                                        "glosses": [
                                            "System von Elementen, die in festgelegter, vorhersehbarer Weise zusammenwirken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa678b2f-a026-43d1-a401-b23b703a0d48",
                                                "sense_id": "0397592b-3df0-3008-b6ac-f8817f63488d",
                                                "text": "Man braucht eine Weile, um den Mechanismus der Machterhaltung zu durchschauen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "007b0bd8-40e1-368b-a2f5-efe1ba00be94",
                                        "entry_id": "7e3e9768-bfb2-3c15-8f48-ffab23445ef7",
                                        "glosses": [
                                            "Komplex von Bauelementen, bei dem die Bewegung eines Teils die Bewegung anderer hervorruft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a390114-38e5-4d9f-ba15-3f77251f0ead",
                                                "sense_id": "007b0bd8-40e1-368b-a2f5-efe1ba00be94",
                                                "text": "Der Mechanismus der großen Turmuhr muss regelmäßig geschmiert werden."
                                            },
                                            {
                                                "example_id": "507fafed-0091-4b98-9b1e-5a3ee0275198",
                                                "sense_id": "007b0bd8-40e1-368b-a2f5-efe1ba00be94",
                                                "text": "„Auf dem Tisch lag jene bösartige Tellerfalle, die ihr Bein fast zerfetzt hätte, wäre der Mechanismus nicht verrostet gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8375a8a7-cc1b-35a2-8d0d-3cd348ea6bde",
                                        "entry_id": "7e3e9768-bfb2-3c15-8f48-ffab23445ef7",
                                        "glosses": [
                                            "naturphilosophische Annahme, dass alle Abläufe in der Natur kausal mechanisch erklärbar sind"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
