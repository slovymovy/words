                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31654f8c-094f-3115-88a5-a07864788e17",
                                        "entry_id": "c562f60e-f79f-3911-9789-6d0c763cfd98",
                                        "glosses": [
                                            "The act of unlawfully freeing a person, or confiscated goods, from custody."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
