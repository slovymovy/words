                ],
                "senses": [
                    {
                        "sense_id": "63871716-62c8-3837-a1f5-f4b9bf468f68",
                        "entry_id": "1b85ecb4-da9a-3ce1-b9fb-bc63a414d8a3",
                        "glosses": [
                            "Donner un caractère géosynchrone à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1b965db-37e2-46c5-8b99-dca7d212859c",
                                "sense_id": "63871716-62c8-3837-a1f5-f4b9bf468f68",
                                "text": "Oui, géosynchroniser la Lune, mieux vaudrait le faire à un endroit bien réfléchi."
                            },
                            {
                                "example_id": "5cfffd25-4a4a-47f8-8d6c-eb0db4eeaad9",
                                "sense_id": "63871716-62c8-3837-a1f5-f4b9bf468f68",
                                "text": "Cet observatoire, géosynchronisé à une altitude de 35.000 km, permettra également d’estimer la durée du prochain cycle solaire et peut-être même de savoir quand les vents solaires intenses et chargés de particules frapperont la Terre."
                            }
                        ]
                    },
