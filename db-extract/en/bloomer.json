            {
                "entry_id": "2da409d1-583e-3718-96dd-c54f09a659ec",
                "word": "bloomer",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ff87cf14-32ba-47a8-b312-dfe99db3880e",
                        "entry_id": "2da409d1-583e-3718-96dd-c54f09a659ec",
                        "tags": [
                            "plural"
