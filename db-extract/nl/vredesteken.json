                "senses": [
                    {
                        "sense_id": "2e1cb68c-583f-33e5-89aa-901757e52818",
                        "entry_id": "afa59e9f-03c8-3080-944a-749b7a41743c",
                        "glosses": [
                            "een teken waarbij men de wijs- en middelvinger gespreid strekt om iemand vrede te wensen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7d5bec5-36a3-4978-9c0e-31fbca5a1d62",
                                "sense_id": "2e1cb68c-583f-33e5-89aa-901757e52818",
                                "text": "Toen ik de volgende ochtend om 4 uur wakker werd, stond de stille jongen al op het punt te vertrekken en gaf me een appel. Hij hief zijn wijs- en middelvingers in het vredesteken en vertrok zuidwaarts, de donkere ochtend in."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbc90801-b9a8-37fd-a5a7-6403324b34d4",
                        "entry_id": "afa59e9f-03c8-3080-944a-749b7a41743c",
                        "glosses": [
                            "cirkelvormig teken met een verticale streep in het midden en een gelijkzijdige driehoek aan de onderzijde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "277f4724-6811-4699-9861-c2ec6dcad31d",
                                "sense_id": "cbc90801-b9a8-37fd-a5a7-6403324b34d4",
                                "text": "Een graffitispuiter is zaterdagavond op heterdaad betrapt in Oldenzaal. De man nam dan ook een groot risico: hij spoot met verf een vredesteken op de muur van het politiebureau."
                            }
                        ]
                    }
