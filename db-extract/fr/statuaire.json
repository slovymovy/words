                "senses": [
                    {
                        "sense_id": "97c74cbb-6e2e-3c11-bf0b-40565677bb82",
                        "entry_id": "c2be24fc-e05f-3bbd-9822-1d5d07cfcd0e",
                        "glosses": [
                            "Sculpteur qui fait des statues."
                        ],
                        "tags": [
                            "Sculpture"
                        ],
                        "examples": [
                            {
                                "example_id": "b9d56912-7014-4c5d-84a5-45f9ad2a1214",
                                "sense_id": "97c74cbb-6e2e-3c11-bf0b-40565677bb82",
                                "text": "Il savait parfaitement que Craquot, statuaire de grand talent mais de pauvres relations, incapable de décrocher une commande, mijotait dans la gêne atroce."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09ff55b0-a54f-4bb3-b98b-3f99af0de70b",
                        "source_entry_id": "c2be24fc-e05f-3bbd-9822-1d5d07cfcd0e",
                        "source_sense_id": "97c74cbb-6e2e-3c11-bf0b-40565677bb82",
                        "target_lang_word": "Bildhauer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bildhauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "31669687-6cc5-3f70-b41d-20373ed918cc",
                                        "entry_id": "aef7083e-ef09-3237-b2c7-24845c31a7b9",
                                        "glosses": [
                                            "Künstler, der plastische Figuren aus Stein herstellt oder Figuren, die in Bronze gegossen werden, aber auch aufgebaute Terrakotta und moderne Materialien benutzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e1d9cca-a2e6-492f-ac58-51ecf632d3e3",
                                                "sense_id": "31669687-6cc5-3f70-b41d-20373ed918cc",
                                                "text": "Bereits in den ersten Wochen seit der Erweiterung des Produktangebotes kann der Bildhauer und Restaurationsexperte positiven Rücklauf verzeichnen. (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "080a604b-8aba-436d-b3be-e7203c152993",
                                                "sense_id": "31669687-6cc5-3f70-b41d-20373ed918cc",
                                                "text": "„Der Bildhauer Ásmundur war, glaube ich, zehn Jahre älter als ich.“"
                                            },
                                            {
                                                "example_id": "771f3984-9727-4611-8464-7a9f5e7df293",
                                                "sense_id": "31669687-6cc5-3f70-b41d-20373ed918cc",
                                                "text": "„Es geht dem Bildhauer dort nicht so schlecht wie dem Schriftsteller.“"
                                            },
                                            {
                                                "example_id": "7e5f3499-4e0c-421f-9123-608cbcaaf098",
                                                "sense_id": "31669687-6cc5-3f70-b41d-20373ed918cc",
                                                "text": "„Jemandem, der alles vergöttlicht, konnte diese Statue sehr leicht als Abbild unseres Erlösers erscheinen, denn der Bildhauer hatte den Kopf mit einer Art Heiligenschein umgeben, mit dem die Bildhauer und Maler die Heiligen darstellen.“"
                                            },
                                            {
                                                "example_id": "1b0e1c9b-61d2-4c38-b5f6-00da64a531a9",
                                                "sense_id": "31669687-6cc5-3f70-b41d-20373ed918cc",
                                                "text": "„Damit es Eduard nicht allzusehr auffiel, hatten wir verschiedene Leute dazu benützt – den Sargtischler Wilke, den Friedhofwärter Liebermann, unseren Bildhauer Kurt Bach, Willy, ein paar andere Kriegskameraden und Geschäftsfreunde, und sogar Lisa.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "08306828-1c4e-38a0-bac7-a71c3bea6b31",
                                        "entry_id": "aef7083e-ef09-3237-b2c7-24845c31a7b9",
                                        "glosses": [
                                            "ein Sternbild des Südhimmels"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "383f7901-1437-4b69-b6d0-fdc90b16f764",
                                                "sense_id": "08306828-1c4e-38a0-bac7-a71c3bea6b31",
                                                "text": "„Die Himmelsbeobachtungen Wilhelm Herschels lassen ihn im Sternbild Bildhauer die Galaxie NGC 613 auffinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2ee081b-8f13-492d-a214-c14d4cfa7c66",
                        "source_entry_id": "c2be24fc-e05f-3bbd-9822-1d5d07cfcd0e",
