                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c885fa4f-6a54-49e6-a70b-99f28605ab40",
                                "sense_id": "5118232e-dbf6-32b7-bdc3-443717276dde",
                                "text": "Zeker 150.000 mannen gebruiken het erectiemiddel in Nederland, blijkt uit rioolwateranalyses van het Rijksinstituut voor Volksgezondheid en Milieu (RIVM), terwijl maar zo'n 45.000 mannen er een recept voor hebben. Dat zou betekenen dat ongeveer 70 procent van de gebruikte erectiepillen in Nederland illegaal wordt verkregen."
                            },
                            {
                                "example_id": "89bec589-320d-4af4-85ab-72e99e994bc9",
                                "sense_id": "5118232e-dbf6-32b7-bdc3-443717276dde",
                                "text": "Jaarlijks worden op de zwarte markt grote hoeveelheden receptgeneesmiddelen, vooral erectiemiddelen en afslankmiddelen, in beslag genomen. Het RIVM heeft nu de totale omvang geschat door zeven dagen lang naar de resten van de medicijnen in rioolwaterzuiveringsinstallaties in Amsterdam, Eindhoven en Utrecht te kijken."
                            }
                        ]
                    }
