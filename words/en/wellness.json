                },
                {
                    "sense_id": "b4e5117b-d487-3260-aa07-e9db4887c72d",
                    "sense_definition": "The active process of practicing healthy habits to achieve better physical and mental health outcomes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She made a fortune as a <w>wellness</w> guru by selling organic supplements and meditation guides.",
                            "target_lang_translations": {
                                "ru": "Она сколотила состояние как <w>велнес</w>-гуру, продавая органические добавки и руководства по медитации."
                            }
                        },
                        {
                            "text": "Many companies now offer a <w>wellness</w> program to help employees manage their stress levels.",
                            "target_lang_translations": {
                                "ru": "Многие компании сейчас предлагают программу <w>оздоровления</w>, чтобы помочь сотрудникам справляться с уровнем стресса."
                            }
                        }
                    ],
