                    "frequency": "VeryLow",
                    "semantic_group_id": "rhetoric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor delivered his lines in a ridiculously <w>bombast</w> manner."
                        },
                        {
                            "text": "She grew tired of reading his <w>bombast</w> descriptions of everyday occurrences."
                        }
                    ],
                    "synonyms": [
