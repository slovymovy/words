{
    "word_family": [
        "crumb",
        "crumbly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a5c28937-57f9-3e48-92da-cf4979650af1",
                    "sense_definition": "To break into small pieces or fall apart.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "disintegrate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old stone wall began to <w>crumble</w> after years of heavy rain.",
                            "target_lang_translations": {
                                "cs": "Stará kamenná zeď se po letech silných dešťů začala <w>drolit</w>."
                            }
                        },
                        {
                            "text": "The dry cake started to <w>crumble</w> as soon as I touched it.",
                            "target_lang_translations": {
                                "cs": "Suchý koláč se začal <w>drobit</w>, jakmile jsem se ho dotkl."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Rozpadat se na malé kousky nebo se drolit."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "drolit se",
                                "target_lang_sense_clarification": "o materiálech, které se postupně rozpadají"
                            },
                            {
                                "target_lang_word": "drobit se",
                                "target_lang_sense_clarification": "o věcech, které se lámou na drobky"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a626b780-ded0-344d-888d-f45ced65ad79",
                    "sense_definition": "To break something into small crumbs.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "disintegrate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>crumble</w> the cheese over the top of the salad.",
                            "target_lang_translations": {
                                "cs": "Prosím, <w>rozdrobte</w> sýr na salát."
                            }
                        },
                        {
                            "text": "You should <w>crumble</w> the bread to feed the birds in the park.",
                            "target_lang_translations": {
                                "cs": "Měl bys <w>rozdrobit</w> chleba, abys nakrmil ptáky v parku."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Rozdrtit nebo rozdrobit něco na malé kousky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "drobit",
                                "target_lang_sense_clarification": "aktivní činnost drcení na drobky"
                            },
                            {
                                "target_lang_word": "drolit",
                                "target_lang_sense_clarification": "aktivní činnost drcení na menší části"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b17add72-b733-3338-8b3f-37323a1314fa",
                    "sense_definition": "To mix ingredients like flour and butter with fingers to create a crumbly texture.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use your fingertips to <w>crumble</w> the butter into the flour for the pastry.",
                            "target_lang_translations": {
                                "cs": "Konečky prstů <w>mněte</w> máslo s moukou, dokud nevznikne drobenka."
                            }
                        },
                        {
                            "text": "You must <w>crumble</w> the mixture until it looks like coarse sand.",
                            "target_lang_translations": {
                                "cs": "Směs musíte <w>drolit</w> tak dlouho, dokud nebude vypadat jako hrubý písek."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "V kulinářství: prsty zapracovat tuk do mouky tak, aby vznikla drobenková směs."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "mnout",
                                "target_lang_sense_clarification": "v kontextu přípravy těsta (mnout tuk s moukou)"
                            },
                            {
                                "target_lang_word": "drolit",
                                "target_lang_sense_clarification": "vytváření drobenkové struktury"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1a3fdc67-9d35-3480-ab9f-69d263002ab5",
                    "sense_definition": "A baked dessert made of fruit covered with a crumbly mixture of flour, fat, and sugar.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We served a warm apple <w>crumble</w> with vanilla ice cream for dessert.",
                            "target_lang_translations": {
                                "cs": "Jako dezert jsme podávali teplý jablečný <w>crumble</w> s vanilkovou zmrzlinou."
                            }
                        },
                        {
                            "text": "She baked a delicious berry <w>crumble</w> for the family dinner.",
                            "target_lang_translations": {
                                "cs": "Upekla vynikající lesní <w>crumble</w> na rodinnou večeři."
                            }
                        }
                    ],
                    "synonyms": [
                        "crisp"
                    ],
                    "common_phrases": [
                        "apple crumble"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pečený dezert z ovoce pokrytý drobenkou z mouky, tuku a cukru."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "crumble",
                                "target_lang_sense_clarification": "přejatý název pro tento typ dezertu"
                            },
                            {
                                "target_lang_word": "ovocný koláč s drobenkou",
                                "target_lang_sense_clarification": "popisný název dezertu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9dcb9565-4ba5-3092-b132-a6265c621d5f",
                    "sense_definition": "A family name.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The <w>Crumble</w> family moved into the house at the end of the street.",
                            "target_lang_translations": {
                                "cs": "Rodina <w>Crumbleových</w> se nastěhovala do domu na konci ulice."
                            }
                        },
                        {
                            "text": "Mr. <w>Crumble</w> is our new history teacher this semester.",
                            "target_lang_translations": {
                                "cs": "Pan <w>Crumble</w> je náš nový učitel dějepisu v tomto semestru."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Příjmení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Crumble",
                                "target_lang_sense_clarification": "vlastní jméno, nepřekládá se"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}