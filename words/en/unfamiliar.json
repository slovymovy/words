        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d25754ef-ca74-33c9-a8a5-e73de4243ea2",
                    "sense_definition": "A person who is not known; a stranger.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guard eyed the <w>unfamiliar</w> with suspicion as he approached the gate.",
                            "target_lang_translations": {
                                "ru": "Охранник подозрительно оглядел <w>незнакомца</w>, когда тот подошёл к воротам.",
                                "de": "Der Wachmann musterte den <w>Unbekannten</w> misstrauisch, als dieser sich dem Tor näherte."
                            }
                        },
                        {
                            "text": "She found herself surrounded by total <w>unfamiliars</w> at the conference.",
                            "target_lang_translations": {
                                "ru": "На конференции она оказалась в окружении совершенно <w>незнакомых людей</w>.",
                                "de": "Auf der Konferenz fand sie sich von völlig <w>Fremden</w> umgeben."
                            }
                        }
                    ],
                    "synonyms": [
                        "stranger"
                    ],
                    "antonyms": [
                        "familiar",
                        "friend",
                        "acquaintance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неизвестный человек; посторонний или незнакомец.",
                        "de": "Eine Person, die man nicht kennt; ein Fremder oder Unbekannter."
                    },
                    "translations": {
