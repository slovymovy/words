                        "undecided",
                        "wavering"
                    ],
                    "antonyms": [
                        "resolute",
                        "determined"
                    ],
                    "target_lang_definitions": {
                        "ru": "лишённый решимости; колеблющийся или не уверенный в своих намерениях"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нерешительный",
                                "target_lang_sense_clarification": "колеблющийся в выборе"
                            },
                            {
                                "target_lang_word": "неопределившийся",
                                "target_lang_sense_clarification": "не сделавший окончательного выбора"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8d6be41c-58a5-3503-b84d-5bada002a41d",
                    "sense_definition": "simple past and past participle of <w>unresolve</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The latest court ruling <w>unresolved</w> a dispute that had been settled years ago.",
                            "target_lang_translations": {
                                "ru": "Последнее судебное постановление <w>вновь открыло</w> спор, разрешённый много лет назад."
                            }
                        },
                        {
                            "text": "The recent developments had effectively <w>unresolved</w> their previous agreement.",
                            "target_lang_translations": {
                                "ru": "Недавние события фактически <w>аннулировали</w> их прежнюю договорённость."
                            }
