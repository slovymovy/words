                ],
                "senses": [
                    {
                        "sense_id": "870027f2-7c5f-3b72-a93d-7e43529a6e4f",
                        "entry_id": "6dc7b109-2452-3929-8f0f-7c14d528e7a8",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31602184-7114-4a33-9f31-e2ac006ea7c5",
                                "sense_id": "870027f2-7c5f-3b72-a93d-7e43529a6e4f",
                                "text": "Frau Göbhard ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f48fbb20-54b1-44ba-a771-fe837ed330cb",
                                "sense_id": "870027f2-7c5f-3b72-a93d-7e43529a6e4f",
                                "text": "Herr Göbhard wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1a56421d-d600-4fa0-8f53-2eac513e13ea",
                                "sense_id": "870027f2-7c5f-3b72-a93d-7e43529a6e4f",
                                "text": "Die Göbhards fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "9eeec817-cfe7-4049-a5cf-a5de80e4460f",
                                "sense_id": "870027f2-7c5f-3b72-a93d-7e43529a6e4f",
                                "text": "Der Göbhard trägt nie die Schals, die die Göbhard ihm strickt."
                            },
                            {
                                "example_id": "3e1d8ade-2b06-46e2-a37a-16f961af50da",
                                "sense_id": "870027f2-7c5f-3b72-a93d-7e43529a6e4f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Göbhard kommt, geht der Herr Göbhard.“"
                            },
                            {
                                "example_id": "235ff05b-2920-4d2f-ae2b-231c2a8a90eb",
                                "sense_id": "870027f2-7c5f-3b72-a93d-7e43529a6e4f",
                                "text": "Göbhard kommt und geht."
                            },
                            {
                                "example_id": "53b3d8bc-827a-4f5d-a21f-c88266d86b08",
                                "sense_id": "870027f2-7c5f-3b72-a93d-7e43529a6e4f",
                                "text": "Göbhards kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
