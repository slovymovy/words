                "senses": [
                    {
                        "sense_id": "fc286443-3315-38f0-a83b-c941971d8dba",
                        "entry_id": "49b40310-04f1-30ab-b07e-3ff249564fe7",
                        "glosses": [
                            "ботан. не любящий влаги; приспособленный к произрастанию в сухой или засушливой местности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "171cb9d9-5f05-4f07-a526-a1c6de2bfe9d",
                                "sense_id": "fc286443-3315-38f0-a83b-c941971d8dba",
                                "text": "А сосна — дерево сухолюбивое."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9a2ca7c-d941-3bd6-8dea-62fbc28a2861",
                        "entry_id": "49b40310-04f1-30ab-b07e-3ff249564fe7",
                        "glosses": [
                            "зоол. приспособленный к обитанию в условиях недостатка влаги"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "376633d5-1dc1-4e4b-9d21-27c5a4dece2c",
                                "sense_id": "b9a2ca7c-d941-3bd6-8dea-62fbc28a2861",
                                "text": "Непарный шелкопряд — светолюбивый и сухолюбивый вид, поэтому успешно развивается в лесных полосах, колках, изреженных лесных массивах, т. е. в хорошо проветриваемых и пронизываемых солнечным светом насаждениях."
                            }
                        ]
                    }
