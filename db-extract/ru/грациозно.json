                        "entry_id": "635aa8dc-67d3-3bff-ace7-8b7ca361c4dd",
                        "glosses": [
                            "оценочная характеристика движений как преисполненных грации"
                        ],
                        "tags": [
                            "в знач. сказуемого"
                        ],
                        "examples": []
                    }
                ],
