                        ],
                        "examples": [
                            {
                                "example_id": "afb466b4-2e40-41d7-8628-53d7a87ca80f",
                                "sense_id": "f5dff49f-b717-325c-a1c5-d1ca1f846b24",
                                "text": "C’est quoi, c’te bébelle-là, le Cointreau ? s’étonna la marchande de pantoufles qui semblait s’être levée du pied gauche."
                            },
                            {
                                "example_id": "fe9c3bde-fe95-4cba-8b13-fbeb86be4f67",
                                "sense_id": "f5dff49f-b717-325c-a1c5-d1ca1f846b24",
                                "text": "Les attentes sont hautes, les potentiels sujets de chicanes innombrables, et la pression d’acheter des bébelles inutiles, élevée."
                            },
                            {
                                "example_id": "d3a58e38-295c-43d4-a49d-25110668d437",
                                "sense_id": "f5dff49f-b717-325c-a1c5-d1ca1f846b24",
                                "text": "Tes bébelles, pis dans ta cour! (se dit à quelqu’un qu’on veut rejeter)"
                            }
                        ]
