                "senses": [
                    {
                        "sense_id": "5f12f72c-30fd-3520-9865-65254ae18431",
                        "entry_id": "57e0f401-ab3a-37d8-bba4-eb3af31351bf",
                        "glosses": [
                            "een stevig, raak antwoord"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10d8e5e8-ddca-4cc3-bfa8-900821b64b3c",
                                "sense_id": "5f12f72c-30fd-3520-9865-65254ae18431",
                                "text": "Hij kon de bazige lerares goed van repliek dienen toen ze onterecht boos was."
                            },
                            {
                                "example_id": "3fb009e1-43c3-4359-9a5c-0feffbdb2d65",
                                "sense_id": "5f12f72c-30fd-3520-9865-65254ae18431",
                                "text": "Meestal gaat zo’n mogelijk onderzoek over de snelheid waarmee, of waarin, mijn brein werkt. Hoe het kan dat ik vaak voor het einde van de zin van de geïnterviewde of iemand uit het publiek die me van repliek durfde te voorzien, een reactie klaar heb, die vaak gepast is, inhoudelijk, scherp zelfs en in uitzonderlijke gevallen ook nog eens (en ik ga nu een wetenschappelijke comedyterm gebruiken) tyfusgrappig."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a65c8ca-a13e-44a8-a1dd-66d47ae20bdd",
                        "source_entry_id": "57e0f401-ab3a-37d8-bba4-eb3af31351bf",
                        "source_sense_id": "5f12f72c-30fd-3520-9865-65254ae18431",
                        "target_lang_word": "Konter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
