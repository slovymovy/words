                ],
                "senses": [
                    {
                        "sense_id": "33636750-5b2d-36b1-b5a9-d5687cfbfd72",
                        "entry_id": "ec54fede-4795-3e12-9e87-a7f8b5721357",
                        "glosses": [
                            "Disziplin der Linguistik, die die Möglichkeiten zur Verarbeitung natürlicher Sprachen mit dem Computer untersucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "744c053e-d648-4470-8d60-181fe8a7685f",
                                "sense_id": "33636750-5b2d-36b1-b5a9-d5687cfbfd72",
                                "text": "Zu den Anwendungsgebieten der Computerlinguistik zählt die maschinelle Übersetzung."
                            },
                            {
                                "example_id": "239663c4-3076-4fa4-9d39-8604480e06a0",
                                "sense_id": "33636750-5b2d-36b1-b5a9-d5687cfbfd72",
                                "text": "„Dennoch sind historische Wörterbücher noch selten zum Gegenstand wissenschaftlicher Forschung gemacht worden, sondern wurden vielmehr als empirische Instrumente, um nicht zu sagen: als Materialsteinbruch unterschiedlichster Ausprägungen der Sprachforschung - von der Philologie bis zur Computerlinguistik - sowie anderer Kulturwissenschaften genutzt.“"
                            },
                            {
                                "example_id": "3e1b7264-ae89-405a-a5b3-61f34ca89c32",
                                "sense_id": "33636750-5b2d-36b1-b5a9-d5687cfbfd72",
                                "text": "„Wir können hieran anschließen und speziell auf eine Reihe damals erschienener Einführungen in die Computerlinguistik verweisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "702414fb-71df-46ea-8dca-e412b9fbd474",
                        "source_entry_id": "ec54fede-4795-3e12-9e87-a7f8b5721357",
                        "source_sense_id": "33636750-5b2d-36b1-b5a9-d5687cfbfd72",
                        "source_sense_description": "Teil der Linguistik, der Möglichkeiten zur Verarbeitung natürlicher Sprachen mit Computer untersucht",
                        "target_lang_word": "computational linguistics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "computational linguistics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a03dc46-deca-3f76-b1de-f1511cb89a97",
                                        "entry_id": "7de9a4fe-68da-3cc0-94fe-7f1334cfd679",
                                        "glosses": [
                                            "An interdisciplinary field dealing with the statistical and/or rule-based modeling of natural language from a computational perspective. This modeling is not limited to any particular field of linguistics."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5534aba-777f-4bf6-8bbd-6f8c5984c6d2",
                                                "sense_id": "9a03dc46-deca-3f76-b1de-f1511cb89a97",
                                                "text": "Prolog has been used for many purposes, but its inventor, Alain Colmerauer, was interested in computational linguistics, and this remains a classic application for the language. Moreover, Prolog offers a number of tools which make life easier for computational linguists, and we are now going to start learning about one of the most useful of these: definite clause grammars, or DCGs as they are usually called."
                                            }
                                        ]
                                    }
                                ]
                            }
