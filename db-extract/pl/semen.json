                "senses": [
                    {
                        "sense_id": "901d1d54-db0a-3c1d-860e-9f6d4c69f156",
                        "entry_id": "e55c4eab-3be3-3ef8-874a-647a1118d409",
                        "glosses": [
                            "nadworny kozak na Ukrainie w XVII–XVIII wieku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64ed4bb4-cef0-4f28-b37a-f16c99cd66ab",
                                "sense_id": "901d1d54-db0a-3c1d-860e-9f6d4c69f156",
                                "text": "Semenowie książęcy sypnęli się na ratunek swego wodza, huknęły samopały…"
                            },
                            {
                                "example_id": "e9aec086-0417-4d86-b8c8-5d109e9aefb5",
                                "sense_id": "901d1d54-db0a-3c1d-860e-9f6d4c69f156",
                                "text": "Zastąpili mu drogę dwaj semenowie (…), przed samymi oczami machnęli mu nahajkami…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9ac7dd64-898b-3396-9e60-5b3f81c95e87",
                        "entry_id": "e55c4eab-3be3-3ef8-874a-647a1118d409",
                        "glosses": [
                            "żołnierz oddziałów lekkiej jazdy kozackiej w XVII-wiecznej Rzeczpospolitej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba35f19c-0d05-40f6-bcb0-41df226f78f6",
                                "sense_id": "9ac7dd64-898b-3396-9e60-5b3f81c95e87",
                                "text": "Naprzód szły dwie tatarskie chorągwie (…), górne pułki ciężkiej jazdy, chorągwie pancerne i usarskie, pochód zaś zamykała dragonia i semenowie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
