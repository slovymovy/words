                        "examples": [
                            {
                                "example_id": "bc43eae3-473e-44c3-b9fc-0ec9436817cc",
                                "sense_id": "b181bd59-5bf9-3028-bea6-37706c9a77c5",
                                "text": "En Ille-et-Vilaine, on appelle « ragosse » un chêne dont on a coupé la tête, et dont le sommet émondé dresse un éventail de branches drues et envahissantes."
                            },
                            {
                                "example_id": "07786472-5255-4776-90ed-973ce4679d77",
                                "sense_id": "b181bd59-5bf9-3028-bea6-37706c9a77c5",
                                "text": "Premier lot : sur la pièce nommée le Grand-Passoir, un hêtre, six ragosses de chêne et deux chênes à tête."
                            }
                        ]
                    }
