                        "form": "den Schindlerjuden"
                    },
                    {
                        "form_id": "d2bae84f-c39f-4f58-9ba7-b5a762f46d41",
                        "entry_id": "c7c02eb1-e839-358c-950f-21606f7b35c0",
                        "tags": [
