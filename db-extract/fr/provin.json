                        "sense_id": "9adcfa60-def1-3fe2-911b-456cba0fcc07",
                        "entry_id": "218e81d1-30fa-3922-af19-2a122c96caeb",
                        "glosses": [
                            "Rejeton d’une plante provignée, sarment de vigne ou rameau d'arbre qu'on couche en terre pour lui faire prendre racine."
                        ],
                        "tags": [
                            "Arboriculture",
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "008e87d9-75fb-4ddf-a670-c061cf7a1c23",
                                "sense_id": "9adcfa60-def1-3fe2-911b-456cba0fcc07",
                                "text": "Pour un homme qui ne pense qu’à ses provins et à ses baliveaux, il a du trait, dit Lousteau"
                            },
                            {
                                "example_id": "733a1ce1-ed15-43e7-b0b1-3fe1e2ca2241",
                                "sense_id": "9adcfa60-def1-3fe2-911b-456cba0fcc07",
                                "text": "Et l’illustre Gaudissart sortit avec monsieur Margaritis qui le promena de provin en provin, de cep en cep, dans ses vignes."
                            },
                            {
                                "example_id": "5e0f23eb-1106-42f6-9bfe-4fafef8461be",
                                "sense_id": "9adcfa60-def1-3fe2-911b-456cba0fcc07",
                                "text": "il chiffrait ses produits à un provin, à une bourrée près."
                            }
                        ]
                    }
                ],
