                        "glosses": [
                            "Équipement destiné à effectuer la pyrolyse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "103fe9c0-9455-4cae-9d19-ffc6e8962b67",
                                "sense_id": "317c0d51-d612-3b47-92bf-249f192fe6f3",
                                "text": "Direction le pyrolyseur, un grand caisson dans lequel le bois est chauffé entre 400 et 700 °C."
                            },
                            {
                                "example_id": "88f874b6-0988-48f9-8dbb-131c50dc10f3",
                                "sense_id": "317c0d51-d612-3b47-92bf-249f192fe6f3",
                                "text": "À l’inverse, la nécessité de limiter toute pénétration d’air dans l’enceinte de traitement crée des contraintes technologiques supplémentaires, particulièrement pour le cas des pyrolyseurs à four rotatif."
                            },
                            {
                                "example_id": "7887ff15-eadf-4c3a-a62a-8fead08ef1ff",
                                "sense_id": "317c0d51-d612-3b47-92bf-249f192fe6f3",
                                "text": "On étudiera entre autres les pyrolyseurs électriques, les seuils de rentabilité du fermage de la forêt, l’implantation de centres régionaux d’acheminement des déchets, le traitement, le stokage et le transport des gaz pyrolytiques."
                            }
                        ]
                    }
