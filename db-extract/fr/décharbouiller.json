                        ],
                        "examples": [
                            {
                                "example_id": "daa552c3-5a6e-48e9-a977-db7d29e4d2e4",
                                "sense_id": "d82ece5f-9a01-3077-9886-bd967f8f9e38",
                                "text": "Vacances en partie excellentes, en partie troublées par des soucis divers, surtout que voici la fin et que l’aimable bureau va reprendre ses joies. Et cependant j’ai pu, par cette courte tournée de Savoie, me décharbouiller de cette hantise et même, ce qui est mieux, considérer que tout compte fait c’était là un gagne-pain comme un autre — précieuses dispositions d’une âme forte !"
                            }
                        ]
                    }
