                ],
                "senses": [
                    {
                        "sense_id": "f4c6c29c-53d1-3830-aff6-de7abd9fc831",
                        "entry_id": "c6dc1dfb-46c3-3b91-b223-5049a3f2b365",
                        "glosses": [
                            "A native or inhabitant of the city of Marseille, Bouches-du-Rhône department, Provence-Alpes-Côte d'Azur, France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3faa6399-6c9e-4925-89ad-a0fb35c045ca",
                                "sense_id": "f4c6c29c-53d1-3830-aff6-de7abd9fc831",
                                "text": "Where ordinary Frenchmen were divided, the Marseillais were united."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf154508-5384-4c8c-851a-784b0c7ddb59",
                        "source_entry_id": "c6dc1dfb-46c3-3b91-b223-5049a3f2b365",
                        "source_sense_id": "f4c6c29c-53d1-3830-aff6-de7abd9fc831",
