                                                "sense_id": "0c3caf64-4290-3495-88a9-83f6d419b90c",
                                                "text": "Организовать колхоз."
                                            },
                                            {
                                                "example_id": "15a7db3e-2cbd-4539-9369-f57e76798f2d",
                                                "sense_id": "0c3caf64-4290-3495-88a9-83f6d419b90c",
                                                "text": "Вступить в колхоз."
                                            },
                                            {
                                                "example_id": "74069ba1-6a50-47ac-8d6b-f141610ac4c1",
                                                "sense_id": "0c3caf64-4290-3495-88a9-83f6d419b90c",
                                                "text": "Выйти из колхоза."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83bcc165-099d-3334-abc2-d40c9c61e6f8",
                                        "entry_id": "4e2f249d-993f-3b78-8e52-3194c7cdc056",
                                        "glosses": [
