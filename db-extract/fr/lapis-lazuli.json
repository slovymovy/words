                                        "sense_id": "dd88f719-80ec-3769-b87e-282aad00cf5b",
                                        "entry_id": "1533b3ce-5d71-3b05-95d7-a0ba5ea8cbf6",
                                        "glosses": [
                                            "Ein blaues glänzendes Gestein, bestehend aus einem Gemisch der Minerale Lasurit, Pyrit, Calcit, Diopsid und Sodalith."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80700813-0f3e-4cda-8881-471042eb8337",
                                                "sense_id": "dd88f719-80ec-3769-b87e-282aad00cf5b",
                                                "text": "Die alten Ägypter stellten blaue Farbe aus im Mörser zerstückelten Halbedelsteinen wie Lapislazuli und Malachit her."
                                            },
                                            {
                                                "example_id": "e303ec8a-85a4-448a-9007-c8d61df2ddd5",
                                                "sense_id": "dd88f719-80ec-3769-b87e-282aad00cf5b",
                                                "text": "„Der Boden der Eingangshalle und der Lobby ist aus Granit und Lapislazuli aus Chile angefertigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7bb9163-1cac-4f4a-8b67-629692a619b4",
