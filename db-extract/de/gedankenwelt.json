                "senses": [
                    {
                        "sense_id": "0ff10474-7ed6-3ad0-a232-19fafd8c86fd",
                        "entry_id": "24099e87-da21-3396-8852-dfa320361437",
                        "glosses": [
                            "thought-world, world of ideas"
