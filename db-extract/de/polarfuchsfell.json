                "senses": [
                    {
                        "sense_id": "d41b2cb9-5190-3008-909c-ef542d2db00c",
                        "entry_id": "d626a721-77a9-3552-8dcb-ac0e8d56da7b",
                        "glosses": [
                            "(abgezogenes) Fell einer Polarfuchses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd21a460-ae58-4042-b550-704db1769d2f",
                                "sense_id": "d41b2cb9-5190-3008-909c-ef542d2db00c",
                                "text": "„Pelzobergewand einer Frau – Es ist aus hellen und dunklen, durch Borten voneinander abgesetzten Rentierfellteilen zusammengenäht. Der Rand der Kapuze ist mit Polarfuchsfell verbrämt.“"
                            },
                            {
                                "example_id": "cfee4a2f-2202-4bdd-b71d-61499c575fef",
                                "sense_id": "d41b2cb9-5190-3008-909c-ef542d2db00c",
                                "text": "„Sie [die Felle der Pelzrobbe oder des Biberseehundes] erzielen im Großhandel wohl einen Preis von 80 bis 90 Mark pro Stück, aber die Polarfuchsfelle bis zu 200 Mark.“"
                            },
                            {
                                "example_id": "24614b9d-9b9f-4e11-9eb0-6a2bbe985574",
                                "sense_id": "d41b2cb9-5190-3008-909c-ef542d2db00c",
                                "text": "„Ihre [der Bewohner] Zahl hat sich seitdem mehr als verdoppelt und beträgt jetzt rund 650. Alljährlich einmal holt ein Schiff die Ausbeute von Eisbär- und Polarfuchsfellen ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
