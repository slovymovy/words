                "senses": [
                    {
                        "sense_id": "717a9221-272f-3b00-bce6-126a4792043a",
                        "entry_id": "d941d4fa-12a5-3ef1-8fa1-102d8f6f7375",
                        "glosses": [
                            "Personnage, souvent un enfant, qui aime à fréquenter la nature, plutôt que les hommes."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5ede9b41-6c8c-4616-8a66-c2ab04075cc4",
                                "sense_id": "717a9221-272f-3b00-bce6-126a4792043a",
                                "text": "Si le « livre de lecture » est mauvais, ce n’est pas seulement en raison de l’idéologie qu’inévitablement, sans doute, il promeut et du fait qu’un traîne-ruisseau entend parler de salle de bain […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61bd222d-009e-47b5-98c1-09d06611b39f",
                        "source_entry_id": "d941d4fa-12a5-3ef1-8fa1-102d8f6f7375",
                        "source_sense_id": "717a9221-272f-3b00-bce6-126a4792043a",
                        "target_lang_word": "ragamuffin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ragamuffin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "326ef1a3-b625-3253-a2bc-4b60af0a11e1",
                                        "entry_id": "46bddd35-f8f7-3b7f-b11b-0c3afdaba57d",
                                        "glosses": [
                                            "A dirty, shabbily-clothed child; an urchin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6dca62a-564c-4a26-9bfb-db7f234bfd9d",
                                                "sense_id": "326ef1a3-b625-3253-a2bc-4b60af0a11e1",
                                                "text": "I haue led my rag of Muffins where they are pepper'd: there's not three of my 150 left aliue; and they for the Townes end, to beg during life."
                                            },
                                            {
                                                "example_id": "30d4fe2c-f190-456d-abdf-d2fa7b9f2fc2",
                                                "sense_id": "326ef1a3-b625-3253-a2bc-4b60af0a11e1",
                                                "text": "“But may I inquire how you intend to support the establishment? If all the pupils are little ragamuffins, I’m afraid your crop won’t be profitable in a worldly sense, Mrs. Bhaer.”"
                                            },
                                            {
                                                "example_id": "03fe7113-2086-41ed-81fd-d4350d1ce7cd",
                                                "sense_id": "326ef1a3-b625-3253-a2bc-4b60af0a11e1",
                                                "text": "\"They called her a little blue raggamuffin, father,\" said Harry, who ran in, looking very angry; \"but I have given it to them, they won't insult my sister again.[…]\""
                                            },
                                            {
                                                "example_id": "d50cf210-b58e-472f-a5dd-c7dad8f383a5",
                                                "sense_id": "326ef1a3-b625-3253-a2bc-4b60af0a11e1",
                                                "text": "'Yes, he is mine—I took him, a homeless little ragamuffin, but I saw what was in him, and I said his name would be heard some day—behold him, observe him—was I right?'"
                                            },
                                            {
                                                "example_id": "e792ab14-b07c-4edc-a8b5-6f2c48542878",
                                                "sense_id": "326ef1a3-b625-3253-a2bc-4b60af0a11e1",
                                                "text": "After walking a ways, Jurgis met a little ragamuffin whom he hailed: \"Hey, sonny!\""
                                            },
                                            {
                                                "example_id": "6a8fd519-7684-4bb6-856c-1e76208555ed",
                                                "sense_id": "326ef1a3-b625-3253-a2bc-4b60af0a11e1",
                                                "text": "He had found out the house of Frau von Einem without much trouble, and had performed with his ragamuffins in the servants' quarters."
                                            },
                                            {
                                                "example_id": "a809ace8-0e32-45dd-b8c5-7a67e88e87a3",
                                                "sense_id": "326ef1a3-b625-3253-a2bc-4b60af0a11e1",
                                                "text": "A boy of the cheery gypsy ragamuffin variety."
                                            },
                                            {
                                                "example_id": "1960ff21-f107-44e2-9f87-d606bc83b276",
                                                "sense_id": "326ef1a3-b625-3253-a2bc-4b60af0a11e1",
                                                "text": "It features other small ones—a bunch of Dickensian ragamuffins and their leader played by Ron Moody in Oliver!—You've Got to Pick a Pocket Or Two."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4177a20d-ec21-302c-abb9-e149cb4cd862",
                                        "entry_id": "46bddd35-f8f7-3b7f-b11b-0c3afdaba57d",
                                        "glosses": [
                                            "A hooligan or troublemaker."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
