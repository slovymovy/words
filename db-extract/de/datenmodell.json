                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0dfb855-b79b-4aca-b773-8876d79f7b30",
                                "sense_id": "89000495-9062-3172-b79f-86bbf6e1294f",
                                "text": "„Die BIRD-Initiative hat sich zum Ziel gesetzt, ein einheitliches, EU-weit vorgegebenes Datenmodell für das aufsichtliche Meldewesen zu definieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ef07e2d4-4922-32f7-86f6-8e7b591950a9",
                        "entry_id": "5afa6c38-6537-3bd3-9325-44f428434263",
                        "glosses": [
                            "Sprache zur Beschreibung von Datenstrukturen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e141afa-eb0d-4e01-a30f-33ea5d7107ab",
                                "sense_id": "ef07e2d4-4922-32f7-86f6-8e7b591950a9",
                                "text": "„Ausgangspunkt war das hierarchische Datenmodell, das heute wegen seiner beschränkten Anwendbarkeit kaum noch in Datenbankmanagementsystemen (DBMS) verwendet wird. Das Netzwerkmodell findet für umfangreiche Datenmengen im Großrechnerbereich seine Anwendung. Das am meisten verwendete Modell ist das relationale Datenmodell.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
