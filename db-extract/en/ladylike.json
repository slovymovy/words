                "entry_id": "61301c7a-7b07-30b6-bb5c-ce3866e7e45f",
                "word": "ladylike",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "44313e58-be3f-4d19-b54d-97beec16ed0e",
                        "entry_id": "61301c7a-7b07-30b6-bb5c-ce3866e7e45f",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more ladylike"
                    },
                    {
                        "form_id": "90f755aa-e90a-4f66-a5f9-7481434e15bd",
                        "entry_id": "61301c7a-7b07-30b6-bb5c-ce3866e7e45f",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most ladylike"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "13370e44-47ac-3d53-bf61-3c7ba842c61a",
                        "entry_id": "61301c7a-7b07-30b6-bb5c-ce3866e7e45f",
                        "glosses": [
                            "Of or related to the appearance or behaviour of a well-mannered woman."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76914703-0bba-4b3f-9f2f-fe39a12fd5a7",
                                "sense_id": "13370e44-47ac-3d53-bf61-3c7ba842c61a",
                                "text": "Coniux imperioſa. Ouidius. A ladylike wife that will be obeyed. […] Dura domina, imperioſa. Cic. A rigorous and ladilike dame that will be obeyed."
                            },
                            {
                                "example_id": "c14d654f-7f59-4646-8537-c26d31906fde",
                                "sense_id": "13370e44-47ac-3d53-bf61-3c7ba842c61a",
                                "text": "Is it ladylike to giggle? / Is it ladylike to wink? / Is it ladylike to ride a horse astraddle? / Is it ladylike to wiggle? / Is it ladylike to drink? / Is it ladylike upon the beach to paddle? […]"
                            },
                            {
                                "example_id": "6f8daee8-0919-4890-bdee-32269c8b64b2",
                                "sense_id": "13370e44-47ac-3d53-bf61-3c7ba842c61a",
                                "text": "Mirrin had lifted her second cup of tea, holding it, ladylike, with finger and thumb of her right hand while her left palm supported the saucer."
                            },
                            {
                                "example_id": "f0ce2638-4762-41db-8bf1-c6030499e072",
                                "sense_id": "13370e44-47ac-3d53-bf61-3c7ba842c61a",
                                "text": "Pirates, these women, with their ladylike briefcases for the loot and their horsy, acquisitive teeth."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "132d3179-c7c7-4212-989a-d0927229a095",
                        "source_entry_id": "61301c7a-7b07-30b6-bb5c-ce3866e7e45f",
                        "source_sense_id": "13370e44-47ac-3d53-bf61-3c7ba842c61a",
                        "source_sense_description": "of or connected with the appearance or behaviour of a well-mannered woman",
                        "target_lang_word": "damenhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "damenhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18fa1b4d-5bf7-3c29-9f11-79c2e4950494",
                                        "entry_id": "6f92f0e2-9356-398a-889f-b76c5f020a8b",
                                        "glosses": [
                                            "wie eine Dame, verbunden mit den Attributen und der Erscheinung, die einer Dame zugeschrieben werden (beispielsweise Kultiviertheit, Gepflegtheit, Eleganz, Charme, Liebenswürdigkeit)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "851b69a9-b324-430d-9fa3-28c27a32d885",
                                                "sense_id": "18fa1b4d-5bf7-3c29-9f11-79c2e4950494",
                                                "text": "[Über die Schauspielerin Olivia de Havilland:] „Nachdem sie zuvor fast ausschließlich gutmütige und damenhafte Figuren gespielt hatte, nahm sie nun auch häufig dramatische Rollen mit düsteren Facetten an.“"
                                            },
                                            {
                                                "example_id": "57d23a7f-f9f2-4d8c-a295-927073953859",
                                                "sense_id": "18fa1b4d-5bf7-3c29-9f11-79c2e4950494",
                                                "text": "[Über die Schauspielerin Claude Gensac:] „Mit ihrer hochgewachsenen Figur und ihrer vornehmen, damenhaften Zurückhaltung war Gensac ein Gegenpart zum gedrungenen, cholerischen de Funès.“"
                                            },
                                            {
                                                "example_id": "1cf0fbb1-e97a-4d07-819d-888d49d9811a",
                                                "sense_id": "18fa1b4d-5bf7-3c29-9f11-79c2e4950494",
                                                "text": "„Und mal wirkt sie damenhaft, wie eine französische Schauspielerin aus fernen Zeiten: Tara Nome Doyle ist erst 21“ […]."
                                            },
                                            {
                                                "example_id": "bfa5e45b-8580-4d0d-ad63-5a8db9c9ce73",
                                                "sense_id": "18fa1b4d-5bf7-3c29-9f11-79c2e4950494",
                                                "text": "[Mode 2006:] „Das wichtigste Thema der kommenden Saison heißt Volumen: Weite Blusen zu schmalen Hosen, schwingende Röcke und lockere Mäntel sorgen für damenhaften Chic.“"
                                            },
                                            {
                                                "example_id": "34835c43-9e9f-479e-9be9-0f0fa647f1e4",
                                                "sense_id": "18fa1b4d-5bf7-3c29-9f11-79c2e4950494",
                                                "text": "[Barbie-Puppe:] „Anders als die meisten anderen Puppen spreizt sie ihre Beine beim Hinsetzen nicht, sondern hält sie damenhaft parallel“ […]."
                                            },
                                            {
                                                "example_id": "70e27f7a-1fb8-48b1-9493-58188d966015",
                                                "sense_id": "18fa1b4d-5bf7-3c29-9f11-79c2e4950494",
                                                "text": "„»Jetzt seh ich doch sehr damenhaft aus, ja? Jetzt würd ich meiner Mutter gefallen.«“"
                                            },
                                            {
                                                "example_id": "b03c2c82-0c3c-4489-8731-3a4a932fa710",
                                                "sense_id": "18fa1b4d-5bf7-3c29-9f11-79c2e4950494",
                                                "text": "„Sie 96 Jahre alt, ein Inbegriff von damenhafter Eleganz,“ […]."
                                            },
                                            {
                                                "example_id": "a5b8da71-5fa5-4728-8195-2037b97a3b3b",
                                                "sense_id": "18fa1b4d-5bf7-3c29-9f11-79c2e4950494",
                                                "text": "Karl Lagerfeld: „»Damen? Frauen! Dame ist doch längst ein Schimpfwort. Damenhaft ist ein Ausdruck von verkrampfter, unnatürlicher Anständigkeit, die sich für Eleganz hält.«“"
                                            },
                                            {
                                                "example_id": "b07c7c7b-2f22-439b-bda0-55de96c12f28",
                                                "sense_id": "18fa1b4d-5bf7-3c29-9f11-79c2e4950494",
                                                "text": "„Sie zwang sich zu einem damenhafteren Tempo und bemühte sich, ruhig zu atmen - was nicht einfach war mit diesem Korsett, das das Durchatmen verhinderte.“"
                                            },
                                            {
                                                "example_id": "109da7a4-1c1c-443a-b601-7e5d914147d8",
                                                "sense_id": "18fa1b4d-5bf7-3c29-9f11-79c2e4950494",
                                                "text": "„Seine Frau würde die gemeinsame Tochter tadeln und sie zu einem besseren, damenhafteren Betragen auffordern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
