                                                "sense_id": "8986fbc6-8d35-343d-8dc8-d88e75d0efd8",
                                                "text": "Die Funkverbindung war so schlecht, dass die Nachrichten vom anderen Ende der Welt nur unklar und verrauscht hier ankamen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
