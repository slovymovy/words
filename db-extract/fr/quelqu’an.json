                "senses": [
                    {
                        "sense_id": "43884346-4e48-34ce-8f29-27db3bd4a8c5",
                        "entry_id": "b24f1db6-318c-35fe-bfb5-2618279641a5",
                        "glosses": [
                            "Neutre singulier de quelqu’un."
                        ],
                        "tags": [
                            "Variations diaéthiques",
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "4feb0a81-b991-442d-b7d8-3982664b1af7",
                                "sense_id": "43884346-4e48-34ce-8f29-27db3bd4a8c5",
                                "text": "@44_Adrian_44 personne ne peut venir ? quelqu’an qui habite très près de chez toi par exemple ?"
                            },
                            {
                                "example_id": "c163476c-58e5-47d5-8e70-93b9889d7fa1",
                                "sense_id": "43884346-4e48-34ce-8f29-27db3bd4a8c5",
                                "text": "@CamaradeDr Je connais quelqu’an qui écrit des microfictions érotiques kinky et n’en peut plus de s’amuser d’avoir des likes de psychologues à la retraite, de juges, de hauts fonctionnaires ou autres."
                            },
                            {
                                "example_id": "40190ee5-8fe5-495b-84be-8fae9b0f413a",
                                "sense_id": "43884346-4e48-34ce-8f29-27db3bd4a8c5",
                                "text": "C’est triste, surtout de la part de quelqu’an qui dit aimer ta musique, iel n’a visiblement rien compris à tes texte.\nACAB partout ACAB toujours."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ef856fc-88ea-40ff-9f92-ec76d47c501a",
                        "source_entry_id": "b24f1db6-318c-35fe-bfb5-2618279641a5",
                        "source_sense_id": "43884346-4e48-34ce-8f29-27db3bd4a8c5",
                        "target_lang_word": "someone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "someone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2785111d-5f4e-3c3c-87cd-35260c0ff86a",
                                        "entry_id": "0546a10d-c91a-3418-88a9-d11d553917da",
                                        "glosses": [
                                            "One or some person of unspecified or indefinite identity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f22546a5-fd24-452c-ad70-686acb7ef448",
                                                "sense_id": "2785111d-5f4e-3c3c-87cd-35260c0ff86a",
                                                "text": "Can someone help me, please?"
                                            },
                                            {
                                                "example_id": "f1d71c23-76b6-4aa3-a2cd-0247c6f3ac55",
                                                "sense_id": "2785111d-5f4e-3c3c-87cd-35260c0ff86a",
                                                "text": "Can you get me someone more knowledgeable?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "someone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2451035b-d7cd-36fb-b9bd-b40552e45722",
                                        "entry_id": "58861d2e-2087-3c81-b594-d352350e32f5",
                                        "glosses": [
                                            "A partially specified but unnamed person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be01d2c2-1cde-4d03-9e98-1edd8b11c3fe",
                                                "sense_id": "2451035b-d7cd-36fb-b9bd-b40552e45722",
                                                "text": "Do you need a gift for that special someone?"
                                            },
                                            {
                                                "example_id": "71e3bf2e-91cb-4932-8df6-d9258763589d",
                                                "sense_id": "2451035b-d7cd-36fb-b9bd-b40552e45722",
                                                "text": "His ultimate concern is with being and beings, with saying something about something and not with the someones who say it and hear it—and not even with the someones whose beings are in conflict about beings in their being."
                                            },
                                            {
                                                "example_id": "f4d668ec-9e84-4171-8d71-5ecc3cffe72a",
                                                "sense_id": "2451035b-d7cd-36fb-b9bd-b40552e45722",
                                                "text": "It had never happened, it wasn't that there hadn't been any 'someones', there had actually been numerous 'someones', but not one that had gotten between him and his work."
                                            },
                                            {
                                                "example_id": "175a3926-f9eb-450e-bbaa-622e1bd81ee4",
                                                "sense_id": "2451035b-d7cd-36fb-b9bd-b40552e45722",
                                                "text": "Or rather, to someone. Many someones, in fact. But which someones? Well, the someones that benefited while wage controls were in place had to be people for whom salary was not the primary form of income."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b52bed2c-a73d-3304-93d1-b4fb50171052",
                                        "entry_id": "58861d2e-2087-3c81-b594-d352350e32f5",
                                        "glosses": [
                                            "An important person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e4f6aa3-fb5c-4d7b-b475-f0b5eca256b3",
                                                "sense_id": "b52bed2c-a73d-3304-93d1-b4fb50171052",
                                                "text": "He thinks he has become someone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8a344f3-2831-4e21-91ab-62187e85bab9",
                        "source_entry_id": "b24f1db6-318c-35fe-bfb5-2618279641a5",
                        "source_sense_id": "43884346-4e48-34ce-8f29-27db3bd4a8c5",
                        "target_lang_word": "somebody",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "somebody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "607678c5-538f-3fb7-93f6-922529b67bea",
                                        "entry_id": "a6019870-66fd-32f7-845b-e7d688e63845",
                                        "glosses": [
                                            "Some unspecified person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47515d05-91f1-4894-8e8d-813ba4137dd3",
                                                "sense_id": "607678c5-538f-3fb7-93f6-922529b67bea",
                                                "text": "Somebody has to clean this mess up."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "somebody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3463b38f-e5a7-3886-9fcc-1904e393e6c8",
                                        "entry_id": "422b1e6e-d8b2-33e0-abf5-98f0720c62ee",
                                        "glosses": [
                                            "Any person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "318dd8cd-1764-4229-83fb-693315792ac0",
                                                "sense_id": "3463b38f-e5a7-3886-9fcc-1904e393e6c8",
                                                "text": "So there, I know, was somebody or a combination of somebodys who did not know what the heck they were doing or dealing with."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deb7c061-efc7-3a63-9043-1804f0908812",
                                        "entry_id": "422b1e6e-d8b2-33e0-abf5-98f0720c62ee",
                                        "glosses": [
                                            "A recognised or important person, a celebrity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2212059f-a501-41f4-9a63-82fe74557123",
                                                "sense_id": "deb7c061-efc7-3a63-9043-1804f0908812",
                                                "text": "I'm tired of being a nobody – I want to be a somebody."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
