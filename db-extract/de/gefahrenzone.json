                                "target_senses": [
                                    {
                                        "sense_id": "ef2afbb7-ed7e-3ccc-a508-65b662ba4ba8",
                                        "entry_id": "acecc35e-022d-36d3-bab9-644afb9fd20e",
                                        "glosses": [
                                            "A specifically hazardous place to be avoided, usually demarcated, such as an area with anti-personnel mines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "630e95b7-ac2b-4721-b334-0234b8f64978",
                                                "sense_id": "ef2afbb7-ed7e-3ccc-a508-65b662ba4ba8",
                                                "text": "She has danced into the danger zone / When the dancer becomes the dance"
                                            },
                                            {
                                                "example_id": "55c42b75-2449-4e9a-b6a5-b9d61fec99b7",
                                                "sense_id": "ef2afbb7-ed7e-3ccc-a508-65b662ba4ba8",
                                                "text": "The athletic Walker, one of Tottenham's more effective attacking elements with his raids from right-back, made a timely intervention after Rose had been dispossessed and even Aaron Lennon was needed to provide an interception in the danger zone to foil another attempt by the Russians."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b2ea01d-7ac7-37fc-bc76-9aeaf6985ac6",
                                        "entry_id": "acecc35e-022d-36d3-bab9-644afb9fd20e",
                                        "glosses": [
                                            "The range of temperatures within which bacteria are likely to grow in food."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "638b0743-e536-3621-a88b-5ad54f9960cd",
                                        "entry_id": "acecc35e-022d-36d3-bab9-644afb9fd20e",
                                        "glosses": [
                                            "The genitals."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fa7cba6-8b77-4d83-b0cf-2433dc3e66ce",
                                                "sense_id": "638b0743-e536-3621-a88b-5ad54f9960cd",
                                                "text": "They say I better get a chaperone / Because I can't stop messing with the danger zone"
                                            }
                                        ]
                                    }
                                ]
