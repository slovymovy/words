                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zullen we vanavond een grote <w>patat</w> met mayonaise bestellen?",
                            "target_lang_translations": {
                                "en": "Shall we order a large portion of <w>fries</w> with mayonnaise tonight?",
                                "ru": "Может, закажем сегодня вечером большую порцию <w>картошки фри</w> с майонезом?",
                                "pl": "Czy zamówimy dziś wieczorem duże <w>frytki</w> z majonezem?",
                                "de": "Sollen wir heute Abend eine große Portion <w>Pommes</w> mit Mayonnaise bestellen?",
                                "fr": "On commande une grande portion de <w>frites</w> avec de la mayonnaise ce soir ?",
                                "it": "Ordiniamo una porzione grande di <w>patatine fritte</w> con maionese stasera?",
                                "cs": "Objednáme si dnes večer velkou porci <w>hranolek</w> s majonézou?",
                                "tr": "Bu akşam mayonezli büyük bir <w>patates kızartması</w> sipariş edelim mi?",
                                "es": "¿Pedimos una ración grande de <w>patatas fritas</w> con mayonesa esta noche?"
                            }
                        },
                        {
                            "text": "Ik eet het liefst een <w>patat</w> met satésaus bij de snackbar.",
                            "target_lang_translations": {
                                "en": "I prefer to eat <w>fries</w> with peanut sauce at the snack bar.",
                                "ru": "В закусочной я больше всего люблю есть <w>картофель фри</w> с арахисовым соусом сате.",
                                "pl": "W barze szybkiej obsługi najchętniej jem <w>frytki</w> z sosem orzechowym satay.",
                                "de": "Am liebsten esse ich eine Portion <w>Pommes</w> mit Erdnusssoße in der Imbissbude.",
                                "fr": "Je préfère manger des <w>frites</w> avec de la sauce saté au snack.",
                                "it": "Al fast food preferisco mangiare le <w>patatine fritte</w> con salsa satay.",
                                "cs": "V rychlém občerstvení si nejraději dávám <w>hranolky</w> s arašídovou omáčkou saté.",
                                "tr": "Büfede en çok sate soslu <w>patates kızartması</w> yemeyi severim.",
                                "es": "Lo que más me gusta comer en el puesto de comida rápida son las <w>patatas fritas</w> con salsa de cacahuete."
                            }
                        }
