                                "sense_id": "e3eab752-f809-3d16-a7d9-23a1bb540340",
                                "text": "L’anticipation d’un paiement est irrépétable."
                            },
                            {
                                "example_id": "f7b8030e-77f8-4a21-888e-073d0790c0dc",
                                "sense_id": "e3eab752-f809-3d16-a7d9-23a1bb540340",
                                "text": "Le paiement des legs annuels est irrépétable parce que c’est une charge des fruits qui a regardé le grevé pendant sa jouissance."
                            }
                        ]
                    }
