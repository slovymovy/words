                                "target_senses": [
                                    {
                                        "sense_id": "9cef1d8f-a6ee-3a3e-bbd1-cacf285f77a2",
                                        "entry_id": "ff2a31c2-5f74-3476-95f7-29f445796db3",
                                        "glosses": [
                                            "Untrue, not factual, factually incorrect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8510884e-9d23-4e4b-986f-b9ccc3014944",
                                                "sense_id": "9cef1d8f-a6ee-3a3e-bbd1-cacf285f77a2",
                                                "text": "Also the rule of false position, with dyuers examples not onely vulgar, but some appertaynyng to the rule of Algeber."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7257e49-9a13-3c15-95a7-284b38c07052",
                                        "entry_id": "ff2a31c2-5f74-3476-95f7-29f445796db3",
                                        "glosses": [
                                            "Based on factually incorrect premises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f038754-17be-4366-8bba-c14a090d20a1",
                                                "sense_id": "d7257e49-9a13-3c15-95a7-284b38c07052",
                                                "text": "false legislation, false punishment"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6a1cc89-27fa-398d-b1bc-5f8adcf80a43",
                                        "entry_id": "ff2a31c2-5f74-3476-95f7-29f445796db3",
                                        "glosses": [
                                            "Spurious, artificial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30d9797b-a4b5-484c-b3fa-878dea098f18",
                                                "sense_id": "c6a1cc89-27fa-398d-b1bc-5f8adcf80a43",
                                                "text": "false teeth"
                                            },
                                            {
                                                "example_id": "edaf467c-0bd6-45df-969c-75d283c462fb",
                                                "sense_id": "c6a1cc89-27fa-398d-b1bc-5f8adcf80a43",
                                                "text": "At her invitation he outlined for her the succeeding chapters with terse military accuracy; and what she liked best and best understood was avoidance of that false modesty which condescends, turning technicality into pabulum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8527bef4-224a-304f-86ec-c1baa4a3c747",
                                        "entry_id": "ff2a31c2-5f74-3476-95f7-29f445796db3",
                                        "glosses": [
                                            "Of a state in Boolean logic that indicates a negative result."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "857414e9-c804-345b-8cab-01dfcc017c65",
                                        "entry_id": "ff2a31c2-5f74-3476-95f7-29f445796db3",
                                        "glosses": [
                                            "Uttering falsehood; dishonest or deceitful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9378b38-0115-43d2-80ac-226422a53e50",
                                                "sense_id": "857414e9-c804-345b-8cab-01dfcc017c65",
                                                "text": "a false witness"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2e9affc-fe70-39b3-97d0-c49a6492c77e",
                                        "entry_id": "ff2a31c2-5f74-3476-95f7-29f445796db3",
                                        "glosses": [
                                            "Not faithful or loyal, as to obligations, allegiance, vows, etc.; untrue; treacherous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed7f291d-72df-410c-8840-ffde4a1e26b4",
                                                "sense_id": "d2e9affc-fe70-39b3-97d0-c49a6492c77e",
                                                "text": "a false friend, lover, or subject;  false to promises"
                                            },
                                            {
                                                "example_id": "ee47cedf-927f-480f-9308-ffa212a7b1d9",
                                                "sense_id": "d2e9affc-fe70-39b3-97d0-c49a6492c77e",
                                                "text": "I to my ſelf was falſe, e’re thou to me,[…]"
                                            },
                                            {
                                                "example_id": "a9e78b6c-4cf8-4ea7-89d4-82aa38eb3484",
                                                "sense_id": "d2e9affc-fe70-39b3-97d0-c49a6492c77e",
                                                "text": "She had been in Baton Rouge but a little over two weeks, when suddenly his letters ceased. She awaited in anxious suspense a whole week — no letter. Another week dragged heavily, and her anxiety became a terrible fear. Was he sick and unable to write — was he dead — or, still more terrible thought, had he proved false?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcd7ef49-983d-3f79-aade-2e472a79b9bf",
                                        "entry_id": "ff2a31c2-5f74-3476-95f7-29f445796db3",
                                        "glosses": [
                                            "Not well founded; not firm or trustworthy; erroneous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "970cd329-a58e-4f66-a305-456a27dd24c5",
                                                "sense_id": "dcd7ef49-983d-3f79-aade-2e472a79b9bf",
                                                "text": "a false conclusion;  a false construction in grammar"
                                            },
                                            {
                                                "example_id": "46847c81-0b0e-49c8-976f-5c4472d25f40",
                                                "sense_id": "dcd7ef49-983d-3f79-aade-2e472a79b9bf",
                                                "text": "So downe he fell, as an huge rockie clift, / Whoſe falſe foundacion waues haue waſht away,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a2eee24-83ee-30f8-85d5-6fd0ed469e1f",
                                        "entry_id": "ff2a31c2-5f74-3476-95f7-29f445796db3",
                                        "glosses": [
                                            "Not essential or permanent, as parts of a structure which are temporary or supplemental."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f54dd454-5a7c-3e9c-808d-417026ff3f6f",
                                        "entry_id": "ff2a31c2-5f74-3476-95f7-29f445796db3",
                                        "glosses": [
                                            "Used in the vernacular name of a species (or group of species) together with the name of another species to which it is similar in appearance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d381dcab-b15d-4581-94c9-32f5adcc9cb0",
                                                "sense_id": "f54dd454-5a7c-3e9c-808d-417026ff3f6f",
                                                "text": "false powderpost beetles (members of Bostrichidae not in Lyctinae)"
                                            },
                                            {
                                                "example_id": "dc159f33-fd85-43e2-b2b3-8cdfc8a69b1e",
                                                "sense_id": "f54dd454-5a7c-3e9c-808d-417026ff3f6f",
                                                "text": "false scorpion (an arachnid)"
                                            },
                                            {
                                                "example_id": "a35489ff-ba2c-461e-8236-12c9a4984000",
                                                "sense_id": "f54dd454-5a7c-3e9c-808d-417026ff3f6f",
                                                "text": "false killer whale (a dolphin)"
                                            }
                                        ]
                                    },
                                    {
