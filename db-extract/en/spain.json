                    {
                        "translation_id": "9da316f2-bb58-4318-9fe3-dddaeff98f56",
                        "source_entry_id": "c6411657-aabe-3e9c-b782-364bb4f63197",
                        "source_sense_description": "country in Europe",
                        "target_lang_word": "Spanje",
                        "target_lang_code": "nl",
