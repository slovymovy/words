                        "source_sense_description": "someone who skydives",
                        "target_lang_word": "Fallschirmspringer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fallschirmspringer",
                                "target_lang_code": "de",
