                    "sense_id": "9cf80ee2-402a-39f8-bbae-b606bc7d3266",
                    "sense_definition": "Proces zmian na lepsze, rozwój w jakiejś dziedzinie lub zbliżanie się do wyznaczonego celu.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzięki nowym technologiom obserwujemy ogromny <w>postęp</w> w medycynie.",
