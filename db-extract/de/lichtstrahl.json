                        ],
                        "form": "den Lichtstrahl"
                    },
                    {
                        "form_id": "e1fa68e5-2dc3-4a74-83d3-757257626b72",
                        "entry_id": "fa92572a-2491-3471-b0ab-f9c59cb36aa4",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Lichtstrahlen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4cb0df53-06b3-3793-a042-d7e58ee75182",
                        "entry_id": "fa92572a-2491-3471-b0ab-f9c59cb36aa4",
                        "glosses": [
                            "von einer Lichtquelle geradlinig ausgehendes Licht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3ec8d0f-cf9e-4103-aa5f-3016fbd4f37b",
                                "sense_id": "4cb0df53-06b3-3793-a042-d7e58ee75182",
                                "text": "„Die Vertrautheit mit den Eigenschaften der Lichtstrahlen, die wir bei der heutigen Entwicklung der Technik haben, darf uns aber nicht verleiten, Erfahrungen an Lichtstrahlen für die wesentliche Grundlage der Geometrie zu halten.“"
                            },
                            {
                                "example_id": "3cea1c56-d684-42cc-b801-16c660b67b60",
                                "sense_id": "4cb0df53-06b3-3793-a042-d7e58ee75182",
                                "text": "„Der Lichtstrahl des Scheinwerfers erfasste sie.“"
                            },
                            {
                                "example_id": "e10f0296-06bc-4007-96cb-014e95cb11c9",
                                "sense_id": "4cb0df53-06b3-3793-a042-d7e58ee75182",
                                "text": "„Es bleibt nun noch zu prüfen, ob ein schneller als der Schall sich bewegendes Signal, etwa ein Lichtstrahl, uns aus der Verlegenheit helfen könne – a priori sicherlich nicht.“"
                            },
                            {
                                "example_id": "788c816d-6f48-42a9-8d62-9303ab6e76bb",
                                "sense_id": "4cb0df53-06b3-3793-a042-d7e58ee75182",
                                "text": "„Holmes richtete den Lichtstrahl seiner Blendlaterne noch einmal auf die Fußspuren im Strauch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9ec735b-357e-4fa7-b2d7-9a944ab100cc",
                        "source_entry_id": "fa92572a-2491-3471-b0ab-f9c59cb36aa4",
                        "source_sense_id": "4cb0df53-06b3-3793-a042-d7e58ee75182",
                        "source_sense_description": "von einer Lichtquelle geradlinig ausgehendes Licht",
                        "target_lang_word": "ray of light",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ray of light",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e33ef79f-bcf8-3a9a-bb8c-929eb681ff03",
                                        "entry_id": "aea0aa67-6525-3ee8-a23f-41c9ca10b42e",
                                        "glosses": [
                                            "A path that a photon or a group of photons takes through space, visible as a column of light."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "acb1b18e-1aee-3143-b38b-9851197effa2",
                                        "entry_id": "aea0aa67-6525-3ee8-a23f-41c9ca10b42e",
                                        "glosses": [
                                            "An inspiring or enlightening person or thing."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "675fc88d-733c-4f23-9761-963604400785",
                                                "sense_id": "acb1b18e-1aee-3143-b38b-9851197effa2",
                                                "text": "I think he was somewhat lost for a political position - a simple conservatism did not attract him - and I make the guess that Arnold had been a spar that he got hold of as he struggled to find a political position. I was certainly in that position, having been persuaded by Anderson, especially at the lunch-hour meetings of his Free-thought Society, of the bankruptcy of the Left. Arnold came to me as a most welcome ray of light."
                                            },
                                            {
                                                "example_id": "5c9825ab-f6de-4d66-a976-f591b656a0f8",
                                                "sense_id": "acb1b18e-1aee-3143-b38b-9851197effa2",
                                                "text": "A ray of light amid all this nonsense was Gwyn Topham's piece in the Guardian, which was timely, measured, accurate and of appropriate tone. That this single report stood out so clearly as an exemplar is a scathing comment in itself on the volumes of drivel surrounding it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
