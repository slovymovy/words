                "senses": [
                    {
                        "sense_id": "4521660a-6d70-3985-ae38-dd6a2e1b71e7",
                        "entry_id": "69f511af-cf5d-3a70-98b7-1de57a72cc6c",
                        "glosses": [
                            "Mitglied einer Klasse (Crustacea) der Gliederfüßer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b2661ff-8fac-4a37-aba9-6f6800d4ccf8",
                                "sense_id": "4521660a-6d70-3985-ae38-dd6a2e1b71e7",
                                "text": "„Ein lebendes Fossil ist der nur zwei Millimeter große Urzeitkrebs mit dem wissenschaftlichen Namen Antrobathynella stammeri, eine Entwicklungslinie der Krebstiere, die es schon im Karbon gegeben hat.“"
                            },
                            {
                                "example_id": "b2ec33f7-85bc-41f6-a3e5-a58cd68eab45",
                                "sense_id": "4521660a-6d70-3985-ae38-dd6a2e1b71e7",
                                "text": "„Zum Spektrum der Nahrung gehören Würmer, Fischbruten, kleine Krebstiere und ähnliches.“"
                            },
                            {
                                "example_id": "a4339e88-7a19-4706-941c-9446c7192510",
                                "sense_id": "4521660a-6d70-3985-ae38-dd6a2e1b71e7",
                                "text": "„So ernährt sich beispielsweise der Krill, ein Krebstier, in der Antarktis wesentlich von diesen Einzellern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
