                "senses": [
                    {
                        "sense_id": "1508eda9-2c9d-33de-807b-bac53851b274",
                        "entry_id": "01f35d1c-ec99-3096-8afe-76af12dfd512",
                        "glosses": [
                            "een mythisch wezen dat van mens in wolf verandert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fba0c66b-69f0-479a-9495-ea6319bc403c",
                                "sense_id": "1508eda9-2c9d-33de-807b-bac53851b274",
                                "text": "In dit televisieprogramma delen een weerwolf, een vampier en een geest een huis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7562b18a-f453-4c45-8afa-99ffa883076c",
                        "source_entry_id": "01f35d1c-ec99-3096-8afe-76af12dfd512",
                        "source_sense_id": "1508eda9-2c9d-33de-807b-bac53851b274",
                        "source_sense_description": ". een mythisch wezen dat bij volle maan van mens in wolf verandert",
                        "target_lang_word": "Werwolf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Werwolf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e5f403d-66b1-37b4-bbd1-ff7599cbedf3",
                                        "entry_id": "1859e57e-8a13-3492-b819-5c4ee4f46636",
                                        "glosses": [
                                            "ein Mensch, der sich bei Vollmond in einen Wolf verwandelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3aefe83-cc3f-4e75-8d17-219cf8d7fce6",
                                                "sense_id": "5e5f403d-66b1-37b4-bbd1-ff7599cbedf3",
                                                "text": "Der Vollmond scheint, Dracula, die Werwölfe und Fritz Neugebauer erschrecken unschuldige Schulkinder, und meine Kinder verlangen auch noch, dass ich den letzten Band von Harry Potter im Morgengrauen des Samstags aus der Buchhandlung hole."
                                            },
                                            {
                                                "example_id": "bbb58f6c-958f-4b91-8a1d-fff7ea07f56b",
                                                "sense_id": "5e5f403d-66b1-37b4-bbd1-ff7599cbedf3",
                                                "text": "Darauf nahm später ein Ritual Bezug, in dem junge Männer auf dem Berg gemeinsam einen Eintopf löffelten, in dem ein Stück Menschenfleisch war. Wer das in den Mund bekam, wurde für einige Jahre zum Werwolf."
                                            },
                                            {
                                                "example_id": "ad0337fa-a1e8-4932-a65f-56ea0f4c9667",
                                                "sense_id": "5e5f403d-66b1-37b4-bbd1-ff7599cbedf3",
                                                "text": "Ich bat ihn, ihre weiche Natur zu schonen – eine zarte Blume nicht zu zertreten – und sprach zu ihm im allgemeinen, soviel ich mich erinnere, als ob er, anstatt ihr Vater, ein Werwolf oder ein giftiger Drache gewesen wäre."
                                            },
                                            {
                                                "example_id": "ab0e51dc-83fd-4219-b718-251659e22777",
                                                "sense_id": "5e5f403d-66b1-37b4-bbd1-ff7599cbedf3",
                                                "text": "Wenn über Stonehenge und über dem Tower der Mond aufgeht, wenn die Werwölfe heulen und die Schwertschwänze springen, wenn die Flut zischt und gischt, dann glotzt man romantisch, ob man will oder nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "13fa5c43-1d6a-3e85-a989-1ba29e35ba99",
                                        "entry_id": "1859e57e-8a13-3492-b819-5c4ee4f46636",
                                        "glosses": [
                                            "eine Art Partisanenverband in der letzten Phase des Dritten Reiches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecff0ef4-d705-40d8-8ee1-16d53f5cb5ca",
                                                "sense_id": "13fa5c43-1d6a-3e85-a989-1ba29e35ba99",
                                                "text": "„Ein anonymer Denunziant in der Stadt verriet den Franzosen, daß die Frauen mit den Werwölfen gekämpft hatten.“"
                                            },
                                            {
                                                "example_id": "61c22d1e-3f7d-4a50-981d-35b78ab9a143",
                                                "sense_id": "13fa5c43-1d6a-3e85-a989-1ba29e35ba99",
                                                "text": "„Angeblich halten sich in den Wäldern des Isergebirges noch vereinzelt bewaffnete Hitlerjungen versteckt, die vom Krieg nicht lassen wollen, so genannte Werwölfe.“"
                                            },
                                            {
                                                "example_id": "1caed916-38e5-49b8-bf19-22ac3a33bdaa",
                                                "sense_id": "13fa5c43-1d6a-3e85-a989-1ba29e35ba99",
                                                "text": "„Der Werwolf trollt sich und taucht nie wieder auf.“"
                                            },
                                            {
                                                "example_id": "f27296bc-59b4-481a-b209-d4e143e48163",
                                                "sense_id": "13fa5c43-1d6a-3e85-a989-1ba29e35ba99",
                                                "text": "„Damals gab es echte Angst vor deutschen Werwölfen, es gab auch bewusst erzeugte Angst vor Werwölfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
