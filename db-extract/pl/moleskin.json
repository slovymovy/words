                        ]
                    },
                    {
                        "translation_id": "d3f58a64-1089-4354-9405-59d1e201390f",
                        "source_entry_id": "5073bdb6-402b-317d-a7a7-efd70273d54c",
                        "source_sense_id": "85c51fe3-73e5-3d82-9fb5-bb6093d44444",
                        "target_lang_word": "Pilot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pilot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f23389e4-3b63-3a97-9f40-dd7da4baaf3b",
                                        "entry_id": "0952658b-1515-3267-85a6-37ffadf3be2a",
                                        "glosses": [
                                            "Person, die ein Flugzeug oder ein ähnliches Flugobjekt steuert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "379cf910-b671-4d5a-8e90-3bcac3b9dfc8",
                                                "sense_id": "f23389e4-3b63-3a97-9f40-dd7da4baaf3b",
                                                "text": "Nur Piloten dürfen ans Steuer dieses Passagierjets."
                                            },
                                            {
                                                "example_id": "6c141fb2-4774-43f4-b549-ffcb57839a2e",
                                                "sense_id": "f23389e4-3b63-3a97-9f40-dd7da4baaf3b",
                                                "text": "Der Pilot kündigte Turbulenzen während des Fluges an."
                                            },
                                            {
                                                "example_id": "6f73651c-670b-449a-97be-01ea7e099dc2",
                                                "sense_id": "f23389e4-3b63-3a97-9f40-dd7da4baaf3b",
                                                "text": "„Früher habe ich in kleinen Flugzeugen Gelegenheit gehabt, dem Piloten und dem Copiloten beim Start durch die geöffnete Kabinentür über die Schulter zu schauen.“"
                                            },
                                            {
                                                "example_id": "3c9c5501-b56d-42de-bd8b-1841d9585231",
                                                "sense_id": "f23389e4-3b63-3a97-9f40-dd7da4baaf3b",
                                                "text": "„Der zweite Pilot betrank sich in Einsamkeit und meditierte vor sich hin, bis er umfiel.“"
                                            },
                                            {
                                                "example_id": "0b0cb354-4f69-4bb9-a8b5-ddb39b46dff4",
                                                "sense_id": "f23389e4-3b63-3a97-9f40-dd7da4baaf3b",
                                                "text": "„Der Ablauf des riskanten illegalen Tiefflugs der beiden amerikanischen Piloten, die Umstände der Videoaufzeichnung, eine verbreitete Mentalität in der US-Armee, die lebendige internationale Fliegertradition legen es nahe, von einem fehlgeschlagenen Versuch auszugehen, sich mit einem beweisbaren Mutakt, dem Unterfliegen einer Seilbahn, als unverwüstliche Draufgänger auszuweisen.“"
                                            },
                                            {
                                                "example_id": "b5a82fdd-1aa4-4d1b-b0a0-6d5ab29a1a0f",
                                                "sense_id": "f23389e4-3b63-3a97-9f40-dd7da4baaf3b",
                                                "text": "„In der Kanzel erkannte man noch die verkohlten Leichen von Pilot und Kopilot, sie hatten sich nicht mehr aus der brennenden Maschine retten können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7d615c32-54e0-3d09-a9cb-6ec09ac4d4aa",
                                        "entry_id": "0952658b-1515-3267-85a6-37ffadf3be2a",
                                        "glosses": [
                                            "Person, die ein Rennfahrzeug steuert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33264d35-611b-414c-ac15-6a2dd6ac09b1",
                                                "sense_id": "7d615c32-54e0-3d09-a9cb-6ec09ac4d4aa",
                                                "text": "Die Formel-1-Piloten üben einen gefährlichen Beruf aus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7c1adf03-2edd-3d19-ad0e-46dc063cb412",
                                        "entry_id": "0952658b-1515-3267-85a6-37ffadf3be2a",
                                        "glosses": [
                                            "Person, die das seemännische Wissen hat, um Schiffe und Mannschaft ans Ziel der Reise zu bringen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a0e6ada0-06ed-3786-9e56-ab5b6197c878",
                                        "entry_id": "0952658b-1515-3267-85a6-37ffadf3be2a",
                                        "glosses": [
                                            "Stachelmakrele, welche anderer Meeresbewohner Hautschmarotzer, Speisereste und Ausscheidungen isst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b25e1ef-1e77-40d3-b0f9-69c6f170a62c",
                                                "sense_id": "a0e6ada0-06ed-3786-9e56-ab5b6197c878",
                                                "text": "Thomas hat noch nie einen Piloten gefangen, obwohl er dass immer wollte."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "f525b9e6-f423-3b3f-a26f-0717d59a1b1d",
                                        "entry_id": "0952658b-1515-3267-85a6-37ffadf3be2a",
                                        "glosses": [
                                            "Boot, welches den Lotsen von und zu einem See- oder Binnenschiff bei Lotsenstrecken auf Flüssen oder bei Hafenansteuerungen transportiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61320ddb-8507-46c8-8b34-2926fc5cf046",
                                                "sense_id": "f525b9e6-f423-3b3f-a26f-0717d59a1b1d",
                                                "text": "Der Pilot fuhr gefährlich nah am Ufer."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "926b01bb-26e1-3814-88ca-91ffee7ba9f0",
                                        "entry_id": "0952658b-1515-3267-85a6-37ffadf3be2a",
                                        "glosses": [
                                            "Film, der zur Einführung einer Fernsehserie produziert wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c9d7f7d-2973-4251-bd46-4f804c2902e6",
                                                "sense_id": "926b01bb-26e1-3814-88ca-91ffee7ba9f0",
                                                "text": "Ohne den Piloten hätte niemand die Serie angeschaut."
                                            }
                                        ],
