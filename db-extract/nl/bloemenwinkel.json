                        "entry_id": "9c6dc2b9-ab18-3cdb-9b3c-68e34ea5ba7d",
                        "glosses": [
                            "een winkel waar men bloemen verkoopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f7564b7-727c-4dbb-b4e9-afa956a53cd7",
                                "sense_id": "893af0e8-c6f8-39eb-9181-4d2cc2a200fc",
                                "text": "De bloemiste werkt in een bloemenwinkel."
                            },
                            {
                                "example_id": "295eda94-f7b3-41bb-b55f-27d1310c6885",
                                "sense_id": "893af0e8-c6f8-39eb-9181-4d2cc2a200fc",
                                "text": "Een bosje bloemen koop je in een bloemenwinkel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fcc57c5-c8fa-41a4-9d4a-3f5b5980bccc",
                        "source_entry_id": "9c6dc2b9-ab18-3cdb-9b3c-68e34ea5ba7d",
                        "source_sense_id": "893af0e8-c6f8-39eb-9181-4d2cc2a200fc",
                        "target_lang_word": "Blumenladen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blumenladen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "597eae7b-b489-395f-b1ef-254ce7a29c59",
                                        "entry_id": "b5517aad-cf72-3955-a909-53f15c30adae",
                                        "glosses": [
                                            "Geschäft, in dem es Blumen zu kaufen gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7093e45f-6c2e-4fd0-97c4-fa6a1bbf7631",
                                                "sense_id": "597eae7b-b489-395f-b1ef-254ce7a29c59",
                                                "text": "„Thomas’ neues Haus liegt, womöglich nicht ganz zufällig, dem Blumenladen gegenüber.“"
                                            },
                                            {
                                                "example_id": "e2ab1f37-f565-4292-aa72-313dae8fc57a",
                                                "sense_id": "597eae7b-b489-395f-b1ef-254ce7a29c59",
                                                "text": "„Sie schafften sich zu dem Pritschenwagen einen Ford Kombi an, mit dem Henni die Blumenläden belieferte, während Georg sich um die Baumschule und die Auftragsarbeiten von Privatkunden und Firmen kümmerte.“"
                                            },
                                            {
                                                "example_id": "c6e7b526-871c-4d0d-8acd-dd218a078e76",
                                                "sense_id": "597eae7b-b489-395f-b1ef-254ce7a29c59",
                                                "text": "„Ich kam erst zu mir, als ich geradenwegs auf einen Blumenladen zusteuerte; ich stoppte und ging hinein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "748e1ad4-ff48-4f59-a3da-192e1e34935b",
                        "source_entry_id": "9c6dc2b9-ab18-3cdb-9b3c-68e34ea5ba7d",
                        "source_sense_id": "893af0e8-c6f8-39eb-9181-4d2cc2a200fc",
                        "target_lang_word": "flower shop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d4582d0b-c3d1-48f3-989d-acecb84c9dfe",
                        "source_entry_id": "9c6dc2b9-ab18-3cdb-9b3c-68e34ea5ba7d",
                        "source_sense_id": "893af0e8-c6f8-39eb-9181-4d2cc2a200fc",
                        "target_lang_word": "fleuriste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fleuriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87643a27-68e9-39bc-a1df-efc83cbe378f",
                                        "entry_id": "cb1bf788-04e6-3909-8d37-ca74af457ba6",
                                        "glosses": [
                                            "Personne dont le métier est de vendre des fleurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32222163-9922-42cf-8612-a69749b4e1b1",
                                                "sense_id": "87643a27-68e9-39bc-a1df-efc83cbe378f",
                                                "text": "Quand Maurice aurait un peu d’argent, elle s’établirait entrepreneuse fleuriste. Elle aurait deux ouvrières qu’elle paierait vingt ou vingt-cinq sous par jour et qui lui gagneraient trois fois autant."
                                            },
                                            {
                                                "example_id": "32cb16ab-407e-4142-9f74-d0ffb3b82c93",
                                                "sense_id": "87643a27-68e9-39bc-a1df-efc83cbe378f",
                                                "text": "J’ai encore aujourd’hui du mal à considérer que les fleuristes et les coiffeurs ne sont pas des parasites, qui vivant de l’exploitation d’une nature qui appartient à tous, qui accomplissant avec force simagrées et produits odorants une tâche que j’effectue seule dans ma salle de bains avec une paire de ciseaux bien coupants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69d0c7ef-a879-35d8-a020-61ed7ada5257",
                                        "entry_id": "cb1bf788-04e6-3909-8d37-ca74af457ba6",
                                        "glosses": [
                                            "Boutique de fleuriste."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abecaa54-6b5e-43da-a9e6-609a421d0b30",
                                                "sense_id": "69d0c7ef-a879-35d8-a020-61ed7ada5257",
                                                "text": "Je vais acheter un bouquet au fleuriste."
                                            },
                                            {
                                                "example_id": "e9c53c63-f740-4a21-bb4a-a5e5d062e580",
                                                "sense_id": "69d0c7ef-a879-35d8-a020-61ed7ada5257",
                                                "text": "Certes, il est difficile d’avoir une idée très précise du niveau d’exposition et de contamination auquel est exposé quelqu’un qui travaille chez un fleuriste, mais on ne peut pas présupposer qu’il n’existe pas. Par rapport à ce qu’on peut imaginer des contaminations possibles au vu de la réglementation européenne, en particulier en matière de limite maximum de résidus autorisés sur les produits importés, il y a un décalage énorme entre cette possibilité d’exposition et cette absence de prévention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d66bfbec-176d-3458-b8de-fa3ef587c2a4",
                                        "entry_id": "cb1bf788-04e6-3909-8d37-ca74af457ba6",
                                        "glosses": [
                                            "Personne dont le métier est de cultiver des fleurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3454110-56cb-433c-b120-bb63dfc36edc",
                                                "sense_id": "d66bfbec-176d-3458-b8de-fa3ef587c2a4",
                                                "text": "Les fleuristes de la Côte d’Azur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "653ae7d5-c733-31ef-9746-2668ca02be89",
                                        "entry_id": "cb1bf788-04e6-3909-8d37-ca74af457ba6",
                                        "glosses": [
                                            "Ouvrière qui fait des fleurs artificielles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c81ca36-03de-3b91-8f05-6bae7395e0c1",
                                        "entry_id": "cb1bf788-04e6-3909-8d37-ca74af457ba6",
                                        "glosses": [
                                            "Amateur de fleurs."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fleuriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bee0a29-1fcb-3fcc-bcfe-e98da3df7187",
                                        "entry_id": "69747c76-9380-362c-849c-8e0a5221aa1b",
                                        "glosses": [
                                            "Qui est consacré aux fleurs."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0371d440-e03b-4024-ba66-e4ccce0f6850",
                                                "sense_id": "6bee0a29-1fcb-3fcc-bcfe-e98da3df7187",
                                                "text": "Parmi ces derniers se placent, en première ligne, les arborétums et les arbusteries, qui n'étaient sans doute pas entièrement inconnus au siècle dernier, mais qui n'existaient alors qu'exceptionnellement et comme simple accessoire des jardins fleuristes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
