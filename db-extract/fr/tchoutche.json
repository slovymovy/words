            {
                "entry_id": "9577a369-933d-3af8-af7e-944231a509d6",
                "word": "tchoutche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "149c1b67-b8c3-419c-8ce9-fc81d05988f0",
                        "entry_id": "9577a369-933d-3af8-af7e-944231a509d6",
                        "tags": [
