                "senses": [
                    {
                        "sense_id": "c1270a28-908a-38c9-a0ac-7351964f36dc",
                        "entry_id": "2686e53e-8956-323f-92a2-0f06f8cf33f4",
                        "glosses": [
                            "A network of criss-crossing lines, strands, cables or pipes."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "83506946-10be-4590-a2e1-c983f214ce72",
                                "sense_id": "c1270a28-908a-38c9-a0ac-7351964f36dc",
                                "text": "The students studied the reticulation of the veins in the leaf."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba29764d-35e7-338b-ac2d-ad3ab65e93f4",
                        "entry_id": "2686e53e-8956-323f-92a2-0f06f8cf33f4",
                        "glosses": [
                            "A method of copying a painting by the help of threads stretched across a frame."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4393a7b4-9fdd-4705-ab85-c3712e4088ec",
                        "source_entry_id": "2686e53e-8956-323f-92a2-0f06f8cf33f4",
                        "source_sense_description": "a network of criss-crossing lines",
                        "target_lang_word": "Netzwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Netzwerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c244ca7f-aaef-3894-ac09-e6f5a43721ca",
                                        "entry_id": "b0777612-7432-372c-8520-66716cab8a47",
                                        "glosses": [
                                            "(netzartige) Verbindung mehrerer Personen oder Objekte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b894749c-9bd1-412e-a983-b44db7a19929",
                                                "sense_id": "c244ca7f-aaef-3894-ac09-e6f5a43721ca",
                                                "text": "Im Parlament bildete sich ein Netzwerk der jüngeren Abgeordneten."
                                            },
                                            {
                                                "example_id": "81be5004-6875-43b7-bc1d-c1f93040e82f",
                                                "sense_id": "c244ca7f-aaef-3894-ac09-e6f5a43721ca",
                                                "text": "„Verstärkt genutzt werden könnten Blogs, Foren und Soziale Netzwerke.“"
                                            },
                                            {
                                                "example_id": "15d93b2d-7067-4eda-bc0e-89f6cdd45ba3",
                                                "sense_id": "c244ca7f-aaef-3894-ac09-e6f5a43721ca",
                                                "text": "„Außerdem haben Khedache und Dubreucq ein Netzwerk von Informanten und Mithelfern aufgebaut.“"
                                            },
                                            {
                                                "example_id": "c90322bb-418a-48f1-8fe3-dad2552378ed",
                                                "sense_id": "c244ca7f-aaef-3894-ac09-e6f5a43721ca",
                                                "text": "„In Belgien war wieder ein pädophiles Netzwerk aufgeflogen; diesmal waren Mitglieder der Azraëlisten darin verwickelt.“"
                                            },
                                            {
                                                "example_id": "7359349b-a297-4d7f-a2cc-9a60784ab2b0",
                                                "sense_id": "c244ca7f-aaef-3894-ac09-e6f5a43721ca",
                                                "text": "„Somit entstand ein für mich völlig neues Netzwerk an Beziehungen, ohne die das Buch in dieser Form nicht zustande gekommen wäre.“"
                                            },
                                            {
                                                "example_id": "0f58f696-96ee-45ec-a2b6-28e96dbe3d36",
                                                "sense_id": "c244ca7f-aaef-3894-ac09-e6f5a43721ca",
                                                "text": "„Das soziale Netzwerk TikTok, wo die meisten der Videos hochgeladen werden, reagiert ebenfalls auf die gefährliche Challenge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f3a16ed7-d876-3556-b7f8-edbcad4a4454",
                                        "entry_id": "b0777612-7432-372c-8520-66716cab8a47",
                                        "glosses": [
                                            "mehrere zum Datenaustausch verbundene Rechner bzw. deren Verbindung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c634d7da-4c6f-4b8a-9824-2d549ff77035",
                                                "sense_id": "f3a16ed7-d876-3556-b7f8-edbcad4a4454",
                                                "text": "„Das soziale Netzwerk TikTok, wo die meisten der Videos hochgeladen werden, reagiert ebenfalls auf die gefährliche Challenge.“"
                                            },
                                            {
                                                "example_id": "11dd2079-2bc0-4963-943f-9c4469084cec",
                                                "sense_id": "f3a16ed7-d876-3556-b7f8-edbcad4a4454",
                                                "text": "Der Rechner war zu alt, um am Netzwerk teilzunehmen."
                                            },
                                            {
                                                "example_id": "6c80bd74-8257-4d6c-8fa0-f6457c717065",
                                                "sense_id": "f3a16ed7-d876-3556-b7f8-edbcad4a4454",
                                                "text": "„Und wer so ein Netzwerk hat, braucht auch einen, der es wartet, denn Oliver und ich können lediglich ganz gut ein- und ausschalten, eventuell auch den Stecker ziehen oder einen Neustart durchführen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
