                "senses": [
                    {
                        "sense_id": "1f4cb2cd-dbd0-3137-b60c-ad4b5cf6a84f",
                        "entry_id": "7c676ec9-19cc-3086-b7d1-1a4ef60c8eec",
                        "glosses": [
                            "Se toquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00c36d60-99f4-442b-8e0e-6c6222eb53d2",
                                "sense_id": "1f4cb2cd-dbd0-3137-b60c-ad4b5cf6a84f",
                                "text": "Je veux m'encapricer des briseurs d'organon. Qui savent s'élancer ignorant les canons."
                            },
                            {
                                "example_id": "df570c04-a1ca-4066-aedc-1c80cf40e94e",
                                "sense_id": "1f4cb2cd-dbd0-3137-b60c-ad4b5cf6a84f",
                                "text": "« S'encapricer de sujets étranges », penser que ce qui est clair ne conduit à rien, tenter encore une fois de marier réalisme et magique, idéalisme et cynisme, n'est pas, même en plein romantisme, la meilleure façon de s'ouvrir une large audience."
                            }
                        ]
                    }
