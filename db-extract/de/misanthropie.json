                        "target_lang_word": "человеконенави́стничество",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "человеконенави́стничество",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "538ae089-5729-38ca-9bf9-2d3cfc3f1a63",
                                        "entry_id": "63d68e87-791b-3410-9952-b9bfa1cc7837",
                                        "glosses": [
                                            "ненависть по отношению к людям"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b1ef7bc-58ab-429d-a03d-b63e63713898",
                                                "sense_id": "538ae089-5729-38ca-9bf9-2d3cfc3f1a63",
                                                "text": "Вся история человечества — вялотекущее человеконенавистничество, иногда переходящее в ярость."
                                            },
                                            {
                                                "example_id": "b6fa25f9-e531-4c4a-9ff3-607427056b5e",
                                                "sense_id": "538ae089-5729-38ca-9bf9-2d3cfc3f1a63",
                                                "text": "Повторяю: я убеждён, что честные люди не только пребудут честными, но и победят, и что на стороне человеконенавистничества останутся лишь люди, вконец раздавленные личными интересами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2646173c-ca86-4fe6-aada-b270e77da773",
                        "source_entry_id": "6a8cf6e1-cbdb-37ae-adbf-d7e5a8a19e3c",
                        "source_sense_id": "fc5c0b02-8e38-30d2-91ff-9bebf805ba2b",
                        "source_sense_description": "bestimmendes Merkmal von Misanthropen und Misanthropinnen; unspezifischer Hass auf Menschen",
