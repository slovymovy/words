                                            {
                                                "example_id": "2d92dbf2-7e30-4978-b99e-9144834907d4",
                                                "sense_id": "9f974f57-dcdf-384a-ac2d-81950dceeca9",
                                                "text": "Des traces accusatrices."
                                            },
                                            {
                                                "example_id": "4cc49184-5d23-4338-9e95-f67259908afe",
                                                "sense_id": "9f974f57-dcdf-384a-ac2d-81950dceeca9",
                                                "text": "Il me lança un regard accusateur."
                                            },
                                            {
                                                "example_id": "2c707d38-f4f9-46ea-805a-8b0382750a44",
                                                "sense_id": "9f974f57-dcdf-384a-ac2d-81950dceeca9",
                                                "text": "Avant de devenir à son tour triomphateur et souverain, il doit subir le regard accusateur et impersonnel d'un œil étranger et omniprésent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "accusateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56776de7-dcca-3642-ab43-5a84b41b0a55",
                                        "entry_id": "73395a0f-8a82-3309-a063-e1d5deefaac3",
                                        "glosses": [
