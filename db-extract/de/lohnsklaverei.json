                "senses": [
                    {
                        "sense_id": "a2086bd8-2418-3392-be50-4042d0492982",
                        "entry_id": "dc6e2a9a-de4b-3c45-a177-fe5131b1d87a",
                        "glosses": [
                            "(oft unzumutbare) Arbeitsverhältnisse, in denen jemand in absoluter Abhängigkeit zum Arbeitgeber seinen Lebensunterhalt verdient"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "797dae0c-8c36-4591-9965-4d999ade3bc9",
                                "sense_id": "a2086bd8-2418-3392-be50-4042d0492982",
                                "text": "„Über den Weg der ökonomischen zu politischen Streiks in Verbindung mit anderen Kampfformen weisen sie den Ausweg aus der kapitalistischen Lohnsklaverei.“"
                            },
                            {
                                "example_id": "0a91b000-e94f-45db-9451-2ff9d70759c2",
                                "sense_id": "a2086bd8-2418-3392-be50-4042d0492982",
                                "text": "„Wenn die Arbeiterschaft gut organisiert und streikfähig ist, dann hat sie mehr Macht, die sie für ihre Befreiung aus der Lohnsklaverei einsetzen kann.“"
                            },
                            {
                                "example_id": "4993d055-cf30-423c-af0c-d4729ed702c9",
                                "sense_id": "a2086bd8-2418-3392-be50-4042d0492982",
                                "text": "„Ich begann mit der unmenschlichen Sklaverei bei den alten Ägyptern, warf ihm die Sklavenhalterordnung der Römer und Griechen vor und natürlich die moderne Lohnsklaverei, Ausbeutung, Kinderarbeit, Armut, Umweltzerstörung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
