                                                "sense_id": "5edd8657-19ab-396f-84b6-233c32ff293c",
                                                "text": "Er glaubt, er ist fit für die Prüfungen."
                                            },
                                            {
                                                "example_id": "d02303df-46c9-41ad-8f4d-c6407a8973cd",
                                                "sense_id": "5edd8657-19ab-396f-84b6-233c32ff293c",
                                                "text": "„Ein schwitzender, nicht besonders fitter Mann bereitet sich darauf vor, eine fitte parfümierte Frau zu umarmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
