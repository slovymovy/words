                "senses": [
                    {
                        "sense_id": "1d3ffc50-0e12-38ae-ad04-58ca61a225e5",
                        "entry_id": "53d7a455-3278-3d4f-8b0a-9cdbb8c5af15",
                        "glosses": [
                            "Faire perdre son caractère bergsonien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfc87a6e-d131-42e7-bc9b-09579f28175e",
                                "sense_id": "1d3ffc50-0e12-38ae-ad04-58ca61a225e5",
                                "text": "Au bout du compte, le lecteur attend encore, alléché par le titre, une économie, à peine évoquée, de l’attente, de l’impatience, du suicide et de l’ennui afin que soit, enfin, « débergsonisée » la durée."
                            },
                            {
                                "example_id": "5e89349b-cc94-4523-bfa7-056d8aa27873",
                                "sense_id": "1d3ffc50-0e12-38ae-ad04-58ca61a225e5",
                                "text": "Je prends aujourd’hui le relais des administrateurs précédents et je vous souhaite une excellente journée de travail, de vous bergsoniser, peut-être aussi de vous débergsoniser dans cette maison, la maison de Bergson qui vous accueille aujourd’hui avec plaisir."
                            }
                        ]
                    }
