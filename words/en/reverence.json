                    "frequency": "Low",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor made a low <w>reverence</w> to the audience after the performance."
                        },
                        {
                            "text": "He offered a quick <w>reverence</w> before leaving the royal presence."
                        }
                    ],
                    "common_phrases": [
