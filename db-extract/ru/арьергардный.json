                "senses": [
                    {
                        "sense_id": "f9bf0dbf-2d54-3716-9bff-6259e9926505",
                        "entry_id": "efaee3b1-ce55-3d1c-87e0-cfa5c81711b0",
                        "glosses": [
                            "находящийся в арьергарде"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45c0b939-0815-4fbb-bcc0-61761e455f87",
                                "sense_id": "f9bf0dbf-2d54-3716-9bff-6259e9926505",
                                "text": "Над Ершалаимом плыло уже не фиолетовое с белой опушкой покрывало, а обыкновенная серая арьергардная туча."
                            }
                        ]
                    }
                ],
