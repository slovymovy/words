                        "target_lang_word": "plongement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plongement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "246a8e7c-3129-3f17-b990-173593f0eaf8",
                                        "entry_id": "84394049-5dfd-3eec-9d37-7d4b3e7b4751",
                                        "glosses": [
                                            "Plongeon, action de plonger."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64c5502b-257c-4e65-a3ba-92df60c4771e",
                                                "sense_id": "246a8e7c-3129-3f17-b990-173593f0eaf8",
                                                "text": "Point de plongement, angle qu'une couche de roches fait avec le plan horizontal ; quantité de plongement, le nombre de degrés dont elle s'écarte de la ligne horizontale."
                                            },
                                            {
                                                "example_id": "26524d50-7c28-4b4c-a26e-22935d6754eb",
                                                "sense_id": "246a8e7c-3129-3f17-b990-173593f0eaf8",
                                                "text": "Aucun moyen de prédire la survenue d'un séisme Le dernier grand tremblement de terre survenu au Japon, à Kobe en 1995, était pour sa part lié au plongement de la plaque philippine sous l'Eurasie, un autre secteur très actif*."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a705574c-a843-346b-bba1-30a31f5d1ed9",
                                        "entry_id": "84394049-5dfd-3eec-9d37-7d4b3e7b4751",
                                        "glosses": [
                                            "Immersion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50be1514-4bd0-4849-a0e5-af56778028a9",
                                                "sense_id": "a705574c-a843-346b-bba1-30a31f5d1ed9",
                                                "text": "Le plongement dans l'eau [pour le baptême] a été en usage pendant treize cents ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2ce4cd8-f31e-3426-9f9f-ec7360e46db1",
                                        "entry_id": "84394049-5dfd-3eec-9d37-7d4b3e7b4751",
                                        "glosses": [
                                            "Objet mathématique considéré au sein d’un autre ou dans le cadre d’un autre et dont certains traits structuraux déterminés sont maintenus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0acd525-6e91-4d8a-922a-31d2c069d7c7",
                                                "sense_id": "c2ce4cd8-f31e-3426-9f9f-ec7360e46db1",
                                                "text": "On montre que les plongements élémentaires associés à un cardinal de Laver sont munis d'une opération binaire naturelle, l’application, obéissant à la loi d’autodistributivité à gauche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a36680a3-f980-4652-9956-eea056a10378",
                        "source_entry_id": "d9581b7d-1a33-3a60-aacd-d677eec6280b",
