                "senses": [
                    {
                        "sense_id": "dda84e10-50e5-32f7-b826-dae0d4f1b4f7",
                        "entry_id": "cddebcc5-6cbc-3bb9-af9f-9e3762aeba9b",
                        "glosses": [
                            "Celle qui commet des méfaits, des vols, voire des crimes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19d721da-d9b3-4812-94d2-80c0382b7e2b",
                                "sense_id": "dda84e10-50e5-32f7-b826-dae0d4f1b4f7",
                                "text": "Judith, arrêtée comme une malfaitrice, fut entraînée par une escouade jusqu’à Poitiers, où on lui fit prendre le voile de force à l’abbaye Sainte-Croix, rendue célèbre par le souvenir de sainte Radegonde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbd4b75c-a026-4188-b6cd-442030a8fdef",
                        "source_entry_id": "cddebcc5-6cbc-3bb9-af9f-9e3762aeba9b",
                        "source_sense_id": "dda84e10-50e5-32f7-b826-dae0d4f1b4f7",
                        "target_lang_word": "Übeltäterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Übeltäterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26fffc51-84c8-39c7-880f-1c1cbd7f97f3",
                                        "entry_id": "6b6a24de-7853-348e-bfb6-961e426328f9",
                                        "glosses": [
                                            "weibliche Person, die etwas Verwerfliches, Schlechtes, Gesetzeswidriges getan hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a582f9d-bc05-4eea-a842-0beb87d3b403",
                                                "sense_id": "26fffc51-84c8-39c7-880f-1c1cbd7f97f3",
                                                "text": "„Alle Übeltäterinnen wurden in den Aprilsitzungen vorgeführt, bei denen Nelly Kerwin und fünf andere zu Wasser und Brot verdonnert worden waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44bb754f-87db-4945-8d7e-80d6ddaeda0b",
                        "source_entry_id": "cddebcc5-6cbc-3bb9-af9f-9e3762aeba9b",
                        "source_sense_id": "dda84e10-50e5-32f7-b826-dae0d4f1b4f7",
