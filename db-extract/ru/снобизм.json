                ],
                "senses": [
                    {
                        "sense_id": "b8c1b857-27b1-38a7-b743-4886839c524f",
                        "entry_id": "aaa000b0-d2b1-3421-b623-42315f814d79",
                        "glosses": [
                            "snobbishness, snobbery"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a39a98c3-1def-451a-bc27-c3a9c0704b30",
                                "sense_id": "b8c1b857-27b1-38a7-b743-4886839c524f",
                                "text": "— Ничего́ не ну́жно говори́ть, — останови́л он меня́. — Хоти́те знать, почему́ большинство́ ста́рых эмигра́нтов так дру́жно ненави́дят Набо́кова? Во́все не за его́ я́кобы порнографи́чески-непристо́йную де́вочку Лоли́тку, не за его́ высокоме́рие и́ли сноби́зм, но за то, что он суме́л вы́рваться из ге́тто, из кру́га мёртвых иде́й и представле́ний.[...]",
                                "translation": "Eduard Limonov",
                                "english": "Eduard Limonov"
                            }
                        ]
                    }
                ],
