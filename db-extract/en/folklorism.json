                        "entry_id": "dedf539f-6334-3854-85e1-a9b465429adb",
                        "glosses": [
                            "Invention or adaptation of folklore, including any use of a tradition outside the cultural context in which it was created."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
