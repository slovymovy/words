{
    "word_family": [
        "dread",
        "dreadful",
        "dreadfully"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "45a461ae-6900-3a2b-b34a-9cfbc7091b19",
                    "sense_definition": "Causing fear, dread, or terror.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone feared the <w>dreaded</w> disease that spread through the village.",
                            "target_lang_translations": {
                                "nl": "Iedereen vreesde de <w>gevreesde</w> ziekte die zich door het dorp verspreidde."
                            }
                        },
                        {
                            "text": "She finally received the <w>dreaded</w> phone call about her job.",
                            "target_lang_translations": {
                                "nl": "Ze kreeg eindelijk het <w>gevreesde</w> telefoontje over haar baan."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dreaded task",
                        "dreaded day"
                    ],
                    "target_lang_definitions": {
                        "nl": "Angst of vrees inboezemend; iets waar men tegenop ziet."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gevreesd",
                                "target_lang_sense_clarification": "Iets of iemand waar mensen bang voor zijn of waar men tegenop ziet."
                            },
                            {
                                "target_lang_word": "verafschuwd",
                                "target_lang_sense_clarification": "Iets dat met grote afkeer of angst wordt bekeken."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8e6e652-67ce-3351-a79b-7958e2bd0523",
                    "sense_definition": "Having or wearing dreadlocks.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dreaded</w> musician played his guitar with great passion.",
                            "target_lang_translations": {
                                "nl": "De muzikant <w>met dreadlocks</w> speelde zijn gitaar met grote passie."
                            }
                        },
                        {
                            "text": "He looked cool with his <w>dreaded</w> hair and colorful clothes.",
                            "target_lang_translations": {
                                "nl": "Hij zag er cool uit met zijn haar <w>in dreadlocks</w> en kleurrijke kleding."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Voorzien van dreadlocks."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "met dreadlocks",
                                "target_lang_sense_clarification": "Beschrijvend voor iemand die het kapsel dreadlocks draagt."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "80c4cc5a-de01-3cb5-96a8-fbd0179938fa",
                    "sense_definition": "simple past and past participle of <w>dread</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>dreaded</w> the long walk home in the dark.",
                            "target_lang_translations": {
                                "nl": "Hij <w>vreesde</w> de lange wandeling naar huis in het donker."
                            }
                        },
                        {
                            "text": "She had always <w>dreaded</w> public speaking in front of large crowds.",
                            "target_lang_translations": {
                                "nl": "Ze had altijd <w>gevreesd</w> om in het openbaar te spreken voor grote groepen mensen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van vrezen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vreesde",
                                "target_lang_sense_clarification": "Enkelvoud verleden tijd van vrezen."
                            },
                            {
                                "target_lang_word": "gevreesd",
                                "target_lang_sense_clarification": "Voltooid deelwoord van vrezen."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}