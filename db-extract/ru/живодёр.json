                                        "sense_id": "bc5bbd7a-f03e-3cc7-872b-4de0305bfe9a",
                                        "entry_id": "aa060591-61cf-31af-894e-384f3f470f5c",
                                        "glosses": [
                                            "comparative form of butch: more butch"
