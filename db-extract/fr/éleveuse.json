                    },
                    {
                        "translation_id": "a7e0431f-b274-4bc6-bc2f-4440b8c9f062",
                        "source_entry_id": "ab8b6358-2f04-3c65-82c6-391dca00d39f",
                        "source_sense_id": "24e0c699-006c-3b99-95a1-00bab91119ab",
                        "source_sense_description": "Celle qui élève des animaux",
                        "target_lang_word": "Tierzüchterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tierzüchterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8856274-a162-3820-97a3-800d1109e02c",
                                        "entry_id": "87daf9cd-4258-3800-a7f6-cc5d8ebbb34a",
                                        "glosses": [
                                            "weibliche Person, die Tiere züchtet; die eine Tierzucht betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32608d0d-f2f3-4410-89ab-ab37b35d8d29",
                                                "sense_id": "e8856274-a162-3820-97a3-800d1109e02c",
                                                "text": "„Aufgeflogen sei alles, als die Polizei wegen einer ganz anderen Sache bei der Tierzüchterin vorbeischaute, wie Eva Dörpinghaus, Pressesprecherin des Landratsamtes Freising, sagt.“"
                                            },
                                            {
                                                "example_id": "682d2125-2486-4c0b-8371-b90bd26cb76d",
                                                "sense_id": "e8856274-a162-3820-97a3-800d1109e02c",
                                                "text": "„„Nicht auszudenken, was hätte passieren können, wenn Ziegen auf der schmalen, unbeleuchteten Straße unvermittelt vor Autos gelaufen wären“, sagt Tierzüchterin Csilla Kornbichler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fdc0f86-cd68-4bc5-80f3-3a1cc32afe67",
                        "source_entry_id": "ab8b6358-2f04-3c65-82c6-391dca00d39f",
                        "source_sense_id": "24e0c699-006c-3b99-95a1-00bab91119ab",
                        "source_sense_description": "Celle qui élève des animaux",
                        "target_lang_word": "breeder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breeder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51073815-b76d-3553-a580-82b3ef82318d",
                                        "entry_id": "369f700d-07c5-32de-967c-8d2e986202ad",
                                        "glosses": [
                                            "A person who breeds plants or animals (professionally)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b85930f4-b355-4be9-87b7-437fdf69d84b",
                                                "sense_id": "51073815-b76d-3553-a580-82b3ef82318d",
                                                "text": "Breeders have figured out that if they can take one haploid set of chromosomes from a cross and copy it (or double it creating a double haploid), they will have a pure line almost instantly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39385be9-af32-30cb-9f94-d6b86beb0268",
                                        "entry_id": "369f700d-07c5-32de-967c-8d2e986202ad",
                                        "glosses": [
                                            "Ellipsis of breeder reactor, a type of nuclear reactor that creates more fissile material than it consumes, often used for the production of atomic weapons."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dcc7da4a-8dbf-3219-8d1b-0b832394c3c4",
                                        "entry_id": "369f700d-07c5-32de-967c-8d2e986202ad",
                                        "glosses": [
                                            "A pattern that exhibits quadratic growth by generating multiple copies of a secondary pattern, each of which then generates multiple copies of a tertiary pattern."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa1a0d3b-ae0b-4178-8f87-bfa777515fc2",
                                                "sense_id": "dcc7da4a-8dbf-3219-8d1b-0b832394c3c4",
                                                "text": "I was wondering if anyone out there could mail me a base for MIT's 'breeder' - the one with 8? puffer trains forming glider-guns. I've seen in in^([sic]) a few books but can't seem to get it working ..."
                                            },
                                            {
                                                "example_id": "15508087-2a49-42e9-b889-e9f55f61de8a",
                                                "sense_id": "dcc7da4a-8dbf-3219-8d1b-0b832394c3c4",
                                                "text": "I later implemented an improved version of the algorithms on an Atari STe, this time the goal was to run the breeder, which it did at 2 gen/sec at the stage when the first glider gun has been assembled."
                                            },
                                            {
                                                "example_id": "b09b6397-f876-4d4e-8334-9b24f84ce855",
                                                "sense_id": "dcc7da4a-8dbf-3219-8d1b-0b832394c3c4",
                                                "text": "A glider-emitting breeder pattern can probably also be constructed in this rule, which would out-radiate any chaotic pattern by a considerable margin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4aff4fc-44c3-366b-bbb6-bf630f688336",
                                        "entry_id": "369f700d-07c5-32de-967c-8d2e986202ad",
                                        "glosses": [
                                            "A person who has had or who is capable of having children; a person who is focussed on the rearing of their own children."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecafbe68-f0d0-4f66-b2d1-f7a47aa49d69",
                                                "sense_id": "e4aff4fc-44c3-366b-bbb6-bf630f688336",
                                                "text": "The number of souls in this kingdom being usually reckoned one million and a half, of these I calculate there may be about two hundred thousand couple whose wives are breeders; from which number I subtract thirty thousand couples who are able to maintain their own children, although I apprehend there cannot be so many, under the present distresses of the kingdom; but this being granted, there will remain an hundred and seventy thousand breeders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f23a7813-f2ec-3d34-9437-311c0f40f147",
                                        "entry_id": "369f700d-07c5-32de-967c-8d2e986202ad",
                                        "glosses": [
                                            "A heterosexual person; one whose sexual intercourse can lead to breeding."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7466a055-fcfd-4bae-ba66-40b10d6950d1",
                                                "sense_id": "f23a7813-f2ec-3d34-9437-311c0f40f147",
                                                "text": "Since the breeders started coming here, you can never tell who likes cock."
                                            },
                                            {
                                                "example_id": "fc66ecd3-92ed-482a-aacd-5aef1196464e",
                                                "sense_id": "f23a7813-f2ec-3d34-9437-311c0f40f147",
                                                "text": "When visiting gay friends but wishing to avoid any heterosexual passersby or dinner guests of said friends, one can always call ahead and inquire, \"Are there breeders in your home?\""
                                            },
                                            {
                                                "example_id": "12a7afda-b5c3-49de-80b1-dee6047deaa8",
                                                "sense_id": "f23a7813-f2ec-3d34-9437-311c0f40f147",
                                                "text": "“Hey… what does a breeder know?”\nMichael grinned. “Where did you learn that word?”\n[…]“One of the guys at Perry's,” replied Brian. “He said that's what the faggots call us.”"
                                            },
                                            {
                                                "example_id": "39fc0f2b-d980-454f-ad42-5783899cb6c8",
                                                "sense_id": "f23a7813-f2ec-3d34-9437-311c0f40f147",
                                                "text": "What is this here natural/unnatural stuff, anyway? Seems like a rationalization to this breeder."
                                            },
                                            {
                                                "example_id": "c17c424a-5310-44f6-b800-d670e7b7ec35",
                                                "sense_id": "f23a7813-f2ec-3d34-9437-311c0f40f147",
                                                "text": "Hey, you try spending an evening with some back-slapping breeder from out of town, smoking cigars, and talking about pussy."
                                            },
                                            {
                                                "example_id": "5e227275-945d-432a-ac82-bcea65ef590d",
                                                "sense_id": "f23a7813-f2ec-3d34-9437-311c0f40f147",
                                                "text": "My father spoke in a quiet, measured voice that gradually increased in tempo and in volume, “Travis, suppose everyone at this table were gay except you, and I called you a trailer-trash breeder?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bea43432-edf6-346b-bfc1-a2f0e1816ca1",
                                        "entry_id": "369f700d-07c5-32de-967c-8d2e986202ad",
                                        "glosses": [
                                            "A 40-gallon fish tank, sometimes used to breed fish that is low in height and wide in length, typically measuring 36 inches long, 18 inches wide, and 16 inches high, making it and shallower than a typical 40-gallon aquarium."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
