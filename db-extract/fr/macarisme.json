                        "glosses": [
                            "Dans l'office des Grecs orthodoxes, hymne en l'honneur des saints ou des bienheureux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bad9cd64-907c-4436-a6dc-98ad17153ff8",
                                "sense_id": "804bf78f-9024-3623-bc04-58857f5a16a7",
                                "text": "Le Logion commence par un macarisme."
                            },
                            {
                                "example_id": "1679e793-5387-4e33-a4b6-3a43dd313f72",
                                "sense_id": "804bf78f-9024-3623-bc04-58857f5a16a7",
                                "text": "Les macarismes sont dans l’office grec des hymnes ou tropains à l’honneur des Grecs. On donne le même nom aux psaumes qui commencent en grec par le mot macarios, & aux neuf versets du chapitre cinq de l’évangile selon saint Matthieu, depuis le troisieme verset jusqu’au onzieme."
                            }
                        ]
                    }
