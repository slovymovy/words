                                    {
                                        "sense_id": "def751bc-0558-32e0-84f7-368571386bfc",
                                        "entry_id": "467a8165-ef60-3011-8611-3370de30a715",
                                        "glosses": [
                                            "ein im Wasser lebender weiblicher Elementargeist mit menschlicher Gestalt. Undine verliert ihre Unsterblichkeit durch Vermählung mit einem irdischen Mann und Geburt eines Kindes von diesem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3e9c2a0-321f-4829-8f98-10600ec7c0a8",
                                                "sense_id": "def751bc-0558-32e0-84f7-368571386bfc",
                                                "text": "Der Undine-Stoff wurde auch von Hans Christian Andersen in seinem Märchen Die kleine Seejungfrau verarbeitet."
                                            },
                                            {
                                                "example_id": "59533a2a-25b5-4358-ac97-5b4eb43e3bfc",
                                                "sense_id": "def751bc-0558-32e0-84f7-368571386bfc",
                                                "text": "„Die schöne Undine, die mir vom Mond beigesellt werden sollte, war Marcolina, und sie würde mir im Bad augenblicklich zur nötigen Zeugungskraft verhelfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
