                    },
                    {
                        "translation_id": "12d5dfba-786a-4838-970c-eafc0ba657ca",
                        "source_entry_id": "7683d891-793c-34f0-bcc5-83f08c0fe407",
                        "source_sense_id": "a02cc4ab-0820-311a-8084-ea2f2f27c3ab",
