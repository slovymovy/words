                        "zh": "动词 seat 的过去式和过去分词，意为使就座。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усадил",
                                "target_lang_sense_clarification": "помог кому-то сесть (прошедшее время)"
                            },
                            {
                                "target_lang_word": "посадил",
                                "target_lang_sense_clarification": "указал место (прошедшее время)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "安排……就座",
                                "target_lang_sense_clarification": "引导某人到座位上"
                            },
                            {
                                "target_lang_word": "坐下",
                                "target_lang_sense_clarification": "指自己坐下"
                            }
                        ]
                    }
                }
            ]
        }
    ]
