                "senses": [
                    {
                        "sense_id": "66271aaf-7153-3558-a0c0-a67d615894d3",
                        "entry_id": "d3ad012a-a037-36cd-888b-2258f942f6b2",
                        "glosses": [
                            "Witz, der sich mit den Verhältnissen in der DDR befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5611bb80-f370-4965-81e1-475d1c8c36d0",
                                "sense_id": "66271aaf-7153-3558-a0c0-a67d615894d3",
                                "text": "„Doch da es neben den Übernahmen und Anpassungen bereits vorhandener Witze auch, und zwar in gehöriger Anzahl, den originären DDR-Witz sowie den Witz der DDR-Bürgerinnen und -Bürger gab, müsste es so etwas wie eine Typik des DDR-Witzes geben, etwas Spezifisches, das gerade ihn als Witz der DDR auszeichnet.“"
                            },
                            {
                                "example_id": "de675f5f-5507-4c01-8b0d-c228377e91cd",
                                "sense_id": "66271aaf-7153-3558-a0c0-a67d615894d3",
                                "text": "„Damit begründet er schon vor der Wende die schriftliche Niederlegung des (meist politischen) DDR-Witzes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
