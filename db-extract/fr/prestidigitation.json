                                    {
                                        "sense_id": "bbe9e0fc-dae0-3f5a-ad43-9523ff554788",
                                        "entry_id": "18417590-dea2-3912-9951-6e330370e391",
                                        "glosses": [
                                            "Great; excellent."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ef6cde7-8222-4bd4-9cdb-76db5f2c2766",
                                                "sense_id": "bbe9e0fc-dae0-3f5a-ad43-9523ff554788",
                                                "text": "I cleaned up the flat while you were out. —Really? Magic!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa9690d0-b9fe-3380-a8e3-d5b495e6b1e4",
                                        "entry_id": "18417590-dea2-3912-9951-6e330370e391",
                                        "glosses": [
                                            "Describing the number of nucleons in a particularly stable isotopic nucleus; 2, 8, 20, 28, 50, 82, 126, and 184."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
