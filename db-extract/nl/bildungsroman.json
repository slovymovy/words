                        "glosses": [
                            "roman met een beschrijving van de volwassenwording van de hoofdpersoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e940c69-af64-495d-81bd-caf702fc2189",
                                "sense_id": "fcf768f8-3c11-3f78-a4d3-353cef2bb8e3",
                                "text": "Dan blijkt dat veel van wat Heinrich overkomt voorbereid is door zijn jeugd, en er soms ook een regelrechte herhaling van is. Is er dus wel zoveel geestelijke ontwikkeling mogelijk in een mensenleven? Dat is een van de kwesties die deze Bildungsroman, of misschien dus wel non-Bildungsroman, opwerpt. (Guus Middag NRC 29 april 2016)"
                            }
                        ]
                    }
