                        "examples": [
                            {
                                "example_id": "42af7663-8660-400d-8e72-de98f57e1d44",
                                "sense_id": "4b469c4a-2b3d-3056-81d4-92744afbbeaa",
                                "text": "„Die Luft stank nach angeschmortem Kunststoff und Kiefernharz.“"
                            },
                            {
                                "example_id": "f81b7eba-e761-4a61-8c69-41b9868703fb",
                                "sense_id": "4b469c4a-2b3d-3056-81d4-92744afbbeaa",
                                "text": "„Harrogate marschierte weiter, die Gleise entlang, unter die alte Stahlbrücke, aus dem Schatten des Steilufers heraus, dann an einem Holzlager und einem Schlachthof vorbei. Üppige Düfte nach Kiefernharz und Dung.“"
                            },
                            {
                                "example_id": "2022b372-0141-4a24-8858-aaa16d700bd0",
                                "sense_id": "4b469c4a-2b3d-3056-81d4-92744afbbeaa",
                                "text": "„Die Schachtel riecht nach Kiefernnadeln. Der Lagerfeuergeruch von Kiefernharz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
