{
    "word_family": [
        "defense",
        "defensive",
        "defensibility",
        "indefensible",
        "defend"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bb922f7f-bbd6-39d4-ac14-ba6e3a885cff",
                    "sense_definition": "Capable of being justified or logically supported in an argument.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "justifiable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her decision to change the policy was completely <w>defensible</w> given the sudden drop in revenue.",
                            "target_lang_translations": {
                                "tr": "Gelirdeki ani düşüş göz önüne alındığında, politikayı değiştirme kararı tamamen <w>savunulabilirdi</w>."
                            }
                        },
                        {
                            "text": "The committee presented a logically sound and easily <w>defensible</w> argument for increasing the budget.",
                            "target_lang_translations": {
                                "tr": "Komite, bütçeyi artırmak için mantıken sağlam ve kolayca <w>savunulabilir</w> bir argüman sundu."
                            }
                        }
                    ],
                    "synonyms": [
                        "defendable"
                    ],
                    "antonyms": [
                        "indefensible"
                    ],
                    "common_phrases": [
                        "morally defensible",
                        "readily defensible",
                        "rationally defensible"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir tartışmada veya mantık çerçevesinde haklı çıkarılabilen, savunulabilir."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "savunulabilir",
                                "target_lang_sense_clarification": "fikir, karar veya argüman için"
                            },
                            {
                                "target_lang_word": "haklı gösterilebilir",
                                "target_lang_sense_clarification": "gerekçelendirilebilir tutum veya davranışlar için"
                            },
                            {
                                "target_lang_word": "mantıklı",
                                "target_lang_sense_clarification": "akla yatkın, desteklenebilir"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a4d891e-fa2d-37bd-87ca-33ed5c53eee7",
                    "sense_definition": "Capable of being protected or defended against physical or military attack.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military_defense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient fortress was built high on a steep hill, making it an easily <w>defensible</w> position.",
                            "target_lang_translations": {
                                "tr": "Antik kale sarp bir tepenin yükseklerine inşa edilmişti, bu da onu kolayca <w>savunulabilir</w> bir mevzi haline getiriyordu."
                            }
                        },
                        {
                            "text": "Engineers sought to establish a more <w>defensible</w> perimeter before nightfall arrived.",
                            "target_lang_translations": {
                                "tr": "Mühendisler, gece çökmeden önce daha <w>savunulabilir</w> bir çevre hattı oluşturmaya çalıştılar."
                            }
                        }
                    ],
                    "synonyms": [
                        "defendable"
                    ],
                    "antonyms": [
                        "indefensible"
                    ],
                    "common_phrases": [
                        "defensible position",
                        "defensible perimeter"
                    ],
                    "target_lang_definitions": {
                        "tr": "Fiziksel veya askeri bir saldırıya karşı korunmaya veya savunulmaya elverişli."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "savunulabilir",
                                "target_lang_sense_clarification": "askeri mevzi veya bölge için"
                            },
                            {
                                "target_lang_word": "korunabilir",
                                "target_lang_sense_clarification": "saldırılara karşı muhafaza edilebilir"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}