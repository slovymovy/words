                        "examples": [
                            {
                                "example_id": "5f1e8751-c398-455c-a89e-380e2bcc523e",
                                "sense_id": "af11cf27-0429-3f08-90b0-08054d9e279a",
                                "text": "Au voisinage d’un plan de faille le mouvement produit localement un cisaillement simple hétérogène, avec une déformation cisaillante importante sur le plan lui-même qui décroît lorsqu’on s’en éloigne."
                            },
                            {
                                "example_id": "3d395ec6-8431-48ac-a421-cb6692855de8",
                                "sense_id": "af11cf27-0429-3f08-90b0-08054d9e279a",
                                "text": "La tendance à la généralisation des mâchoires cisaillantes se fait jour en mer (têtes de puits sous-marines) mais aussi, souvent à terre (têtes de puits aériennes) et dans tous les cas difficiles […]"
                            }
                        ]
                    }
