                                                "sense_id": "61b6a108-e218-3acb-8117-3666dfbe7e12",
                                                "text": "Als es wärmer wurde, leuchtete die Sonne durch den Nebel durch."
                                            },
                                            {
                                                "example_id": "39e7121a-29b1-406b-978e-575488ffcd12",
                                                "sense_id": "61b6a108-e218-3acb-8117-3666dfbe7e12",
                                                "text": "Ihre Herzensgüte leuchtet immer mal wieder durch die schroffe Oberfläche durch, besonders, wenn es um Kinder und deren Zukunft geht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "durchleuchten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac605ace-d532-392a-8f56-4af942b55262",
                                        "entry_id": "6bc98b00-b797-30ba-b1ff-2034f3ba6442",
                                        "glosses": [
                                            "mit Strahlen (Röntgenstrahlen) untersuchen"
                                        ],
                                        "tags": [
                                            "technisch",
                                            "medizinisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "110f4365-bab2-4a8b-abe6-36e5fdb86db2",
                                                "sense_id": "ac605ace-d532-392a-8f56-4af942b55262",
                                                "text": "Zu der Zeit wurden in Reihenuntersuchungen die Lungen aller Angestellten der Produktionsabteilungen durchleuchtet."
                                            },
                                            {
                                                "example_id": "6bb233bd-485d-40d2-af38-7db0d34ed172",
                                                "sense_id": "ac605ace-d532-392a-8f56-4af942b55262",
                                                "text": "Mit dem Computertomographen werden die archäologischen Fundstücke zuerst durchleuchtet, auch, um dadurch die Datierung zu erleichtern."
                                            },
                                            {
                                                "example_id": "f61c1fac-f048-40b3-acd1-304444c18f59",
                                                "sense_id": "ac605ace-d532-392a-8f56-4af942b55262",
                                                "text": "Spätestens am Flugplatz wirst du durchleuchtet, und dann fällt die Waffe auf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f15826f-580a-375e-913b-22b88a54b666",
                                        "entry_id": "6bc98b00-b797-30ba-b1ff-2034f3ba6442",
                                        "glosses": [
                                            "sorgsam viele Aspekte einer Sache oder Dinge im Zusammenhang mit einer Person anschauen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82f3ec1e-c562-4d6f-bdc4-ee9c2faf6db3",
                                                "sense_id": "6f15826f-580a-375e-913b-22b88a54b666",
                                                "text": "Hast du wirklich vor, den beruflichen Hintergrund deines Schwiegervaters in spe zu durchleuchten?"
                                            },
                                            {
                                                "example_id": "70b0d9f9-fae5-4245-8762-a24dde23af08",
                                                "sense_id": "6f15826f-580a-375e-913b-22b88a54b666",
                                                "text": "Am erfolgversprechendsten ist es, wenn Sie zuerst die gefundenen Hindernisse und Probleme auf ihre Ursachen hin durchleuchten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23de8803-f83d-492e-8c89-5da3fa15585a",
                        "source_entry_id": "daaf23f5-2a24-3d57-be3d-959d44e66911",
                        "source_sense_id": "418b59ec-a212-338a-ab6a-3f09e98d714c",
                        "source_sense_description": "van licht doordringen",
                        "target_lang_word": "durchscheinen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "durchscheinen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b80eaf4e-4af4-3686-8945-467b4a618bb5",
                                        "entry_id": "506cc9f5-b186-3815-9729-8cc9e99ccd95",
                                        "glosses": [
                                            "mit seinem Schein erfüllen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e6ef458-8e27-44fb-8c17-b0fae846393e",
                                                "sense_id": "b80eaf4e-4af4-3686-8945-467b4a618bb5",
                                                "text": "„Der Wagen, in dem sie allein saßen, war ganz von warmer Sonne durchschienen.“"
                                            },
                                            {
                                                "example_id": "08a3e31b-d1f8-4d4c-9e5d-a231970f6b6c",
                                                "sense_id": "b80eaf4e-4af4-3686-8945-467b4a618bb5",
                                                "text": "„Das sieht man gut am durchsichtigen Weiß des Gummibärchens: Das göttliche Licht durchscheint den Geist der Gelatine.“"
                                            },
                                            {
                                                "example_id": "cb31c5d5-691a-4727-a5f5-c289fbb64776",
                                                "sense_id": "b80eaf4e-4af4-3686-8945-467b4a618bb5",
                                                "text": "…; der Strahl der Herbstsonne durchscheint das Zimmerchen nach seiner ganzen Tiefe."
                                            },
                                            {
                                                "example_id": "f286c041-134e-4b18-8a01-303a3edb11bf",
                                                "sense_id": "b80eaf4e-4af4-3686-8945-467b4a618bb5",
                                                "text": "Nur ein matter Lichtstrahl durchschien die Fisterniß seiner Seele."
                                            },
                                            {
                                                "example_id": "ffd987a1-fe44-449a-94a5-6af98d0e9baa",
                                                "sense_id": "b80eaf4e-4af4-3686-8945-467b4a618bb5",
                                                "text": "Die Sonne durchschien die Wolken und somit konnte wieder ein Skitag bei perfekt präparierten Pisten und zarten Plusgraden abgehalten werden."
                                            },
                                            {
                                                "example_id": "caf49b32-96bd-4e77-bbdf-742485efc445",
                                                "sense_id": "b80eaf4e-4af4-3686-8945-467b4a618bb5",
                                                "text": "Doch noch vor der endgültigen Finsternis durchschienen den Wald die Lagerfeuer des Dorfes."
                                            },
                                            {
                                                "example_id": "b9c8feb4-ad2e-4f9a-aadd-887947f3c768",
                                                "sense_id": "b80eaf4e-4af4-3686-8945-467b4a618bb5",
                                                "text": "Die Grotte selbst war kreisrund und von rosigem Licht wunderbar durchschienen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "durchscheinen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b365f39-6d17-3912-86d4-210ddae8d615",
                                        "entry_id": "e2ee9715-e0fe-33c3-8d9d-834c0ad9b1ae",
                                        "glosses": [
                                            "mit seinem Schein durch etwas durchdringen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c496ffd-cfa0-46ae-996f-3cf6ae8fe0a4",
                                                "sense_id": "4b365f39-6d17-3912-86d4-210ddae8d615",
                                                "text": "Dunkelgraue Wolken verdeckten der Sonne jegliche Möglichkeit, durchzuscheinen, und das Eis unter ihren Füßen fing das Geräusch ihrer Schritte ab."
                                            },
                                            {
                                                "example_id": "1d4bc39d-0c49-4f52-a860-f0cc8af3b90a",
                                                "sense_id": "4b365f39-6d17-3912-86d4-210ddae8d615",
                                                "text": "Das Videobild selbst scheint in unserer Wahrnehmung durchzuscheinen, ein Fenster, das das Auge des Betrachters in die rekonstruierte Vergangenheit einer Aufnahme führt."
                                            },
                                            {
                                                "example_id": "3c19701c-46e7-4f98-a6e9-91701151034e",
                                                "sense_id": "4b365f39-6d17-3912-86d4-210ddae8d615",
                                                "text": "Aber dann habe ich gesehen, dass die Sonne durch den Hochnebel durchgeschienen hat."
                                            },
                                            {
                                                "example_id": "e3d22425-4b18-4567-b032-bed1fd443fd8",
                                                "sense_id": "4b365f39-6d17-3912-86d4-210ddae8d615",
                                                "text": "Die Ratlosigkeit der leitenden Funktionäre unserer Gesellschaftsordnung hat da deutlich durchgeschienen."
                                            },
                                            {
                                                "example_id": "8ee97c1a-8a90-4cd6-8f84-4b846e12c026",
                                                "sense_id": "4b365f39-6d17-3912-86d4-210ddae8d615",
                                                "text": "Das Licht des Fensters hinter ihm schien durch seine abstehenden Ohren, die blutig leuchteten, und seine Miene heischte von Diederichs eine so leichenhafte Gefügigkeit, daß Diederichs Blick die Flucht ergriff."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
