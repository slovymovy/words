    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac8e581e-2aae-3953-bbf6-4f294dc5b632",
                    "sense_definition": "Disposer une étoffe ou un vêtement de manière à lui donner des plis amples et harmonieux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "textile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La styliste <w>drape</w> soigneusement la soie autour du mannequin pour concevoir une robe de soirée."
                        },
                        {
                            "text": "Elle a <w>drapé</w> une couverture en laine sur le canapé pour créer une atmosphère chaleureuse."
                        }
                    ],
                    "synonyms": [
                        "envelopper",
                        "enrouler"
                    ],
                    "common_phrases": [
                        "draper une étoffe"
                    ]
                },
                {
                    "sense_id": "f96d0385-01f1-358f-9dd9-66f689573dba",
                    "sense_definition": "Prendre une attitude fière, offensée ou vertueuse pour se donner de la prestance ou esquiver les reproches.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face aux critiques formulées par la commission, le directeur a préféré se <w>draper</w> dans sa dignité."
                        },
                        {
                            "text": "Accusé de négligence par ses collègues, il s'est <w>drapé</w> dans un mutisme hautain."
                        }
                    ],
                    "synonyms": [
                        "se retrancher",
                        "s'abriter"
                    ],
                    "common_phrases": [
                        "se draper dans sa dignité",
                        "se draper dans le silence"
                    ]
                },
                {
                    "sense_id": "2d7059e8-f2f1-3a72-adaa-1a971f4b3e48",
                    "sense_definition": "Habiller un personnage ou représenter les plis amples de ses vêtements dans une œuvre d'art.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "arts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peintre a su admirablement <w>draper</w> le personnage principal dans une toge étincelante."
                        },
                        {
                            "text": "Le sculpteur passa plusieurs semaines à <w>draper</w> cette statue représentant une allégorie de la justice."
                        }
                    ],
                    "common_phrases": [
                        "draper une statue",
                        "draper une figure"
                    ]
                },
                {
                    "sense_id": "bec8fdb5-d28e-33c5-9553-194b837e6890",
                    "sense_definition": "Garnir ou agencer une tenture, un rideau ou un dais de manière décorative.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "textile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour la réception officielle, le décorateur a choisi de <w>draper</w> les tentures du salon d'honneur."
                        },
                        {
                            "text": "On fit <w>draper</w> une portière de velours rouge à l'entrée du grand théâtre."
                        }
                    ],
                    "common_phrases": [
                        "draper une portière"
                    ]
                },
                {
                    "sense_id": "56e74232-3fb3-3019-9636-ea2e427bbafe",
                    "sense_definition": "Arranger ses vêtements avec solennité, en parlant d'un acteur interprétant un rôle en costume d'époque.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theatre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant d'entrer en scène pour jouer la tragédie, le comédien sait admirablement se <w>draper</w>."
                        },
                        {
                            "text": "Cet acteur se <w>drape</w> parfaitement dans son costume pour incarner un sénateur romain."
