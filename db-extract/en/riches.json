                                                "sense_id": "70c070d7-92e8-3c63-a876-aebb8a0282ab",
                                                "text": "Drzewa sosnowe to wiecznie zielone drzewa z grubą korą i bogactwem żywicy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
