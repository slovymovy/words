                                "sense_id": "68bc6eb5-c71a-3d90-a625-ae6f44812028",
                                "text": "Sans vouloir partir un grand débat, ni hijacker le sujet, les exigences de transport Canada sont disponibles."
                            },
                            {
                                "example_id": "897f7f67-b748-4b47-a7a7-728584a49e78",
                                "sense_id": "68bc6eb5-c71a-3d90-a625-ae6f44812028",
                                "text": "Ce programme m’a hijacké mes fichiers."
                            }
                        ]
