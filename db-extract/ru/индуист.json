                    {
                        "translation_id": "7e40f049-58f7-4bac-a66f-f4ba0524e4fd",
                        "source_entry_id": "465a3f17-099c-3ae0-aa35-76d4f9c15cc0",
                        "target_lang_word": "Hindoo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hindoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df487c64-a105-37e6-ab9d-14a55a761029",
                                        "entry_id": "ae5ee651-c553-3c4a-b979-e7fdda5b2d15",
                                        "glosses": [
                                            "Hindu"
                                        ],
                                        "tags": [
                                            "dated",
                                            "derogatory",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b3c2aa8-fa53-4a0b-a84a-577eaf87fb24",
                                                "sense_id": "df487c64-a105-37e6-ab9d-14a55a761029",
                                                "text": "Our early popular ideas of the mildness and effeminacy of the Hindoos were derived from the Bengalees, and are by no means characteristic of the general population of India."
                                            },
                                            {
                                                "example_id": "a0d42df8-226a-4135-a627-32c1609ab96e",
                                                "sense_id": "df487c64-a105-37e6-ab9d-14a55a761029",
                                                "text": "After a week's trial at 4d. per ton his men struck, saying that the work was not fit for white men, although there were 19 whites employed for the same work which 15 Hindoos were accomplishing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba83dc93-85d7-36f3-b5ac-0054423c43b5",
                                        "entry_id": "ae5ee651-c553-3c4a-b979-e7fdda5b2d15",
                                        "glosses": [
                                            "Any subject regarding to Mughal Empire."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04f63bbc-a80e-4dd1-98f5-f1bc142f99d0",
                                                "sense_id": "ba83dc93-85d7-36f3-b5ac-0054423c43b5",
                                                "text": "Having made Calcutta the capital of their dominions, the English distinguished this city by such peculiar marks of favour, as a free people would be expected to bestow, in establishing an English Court of Judicature, and granting to all within its jurisdiction, the same civil rights as every Briton enjoys in his native country; thus putting the Natives of India in possession of such privileges as their forefathers never expected to attain, even under Hindoo Rulers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Hindoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7fdc9e6-0009-3fd8-9b42-01bdcb05266c",
                                        "entry_id": "43e5da36-f414-39f5-b776-fc026cc73a53",
                                        "glosses": [
                                            "Indians"
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29ecee8b-592b-4742-8d02-aef934e586c3",
                                                "sense_id": "e7fdc9e6-0009-3fd8-9b42-01bdcb05266c",
                                                "text": "There are brahmins of various degrees, who have the care of religion, or of the administration of the Gentoo law allotted to them. These priests are held sacred by the Indians or Hindoos."
                                            },
                                            {
                                                "example_id": "db67cb56-69a8-4c0f-8d77-4d446a6e6363",
                                                "sense_id": "e7fdc9e6-0009-3fd8-9b42-01bdcb05266c",
                                                "text": "After more than once recovering his fortunes, when they seemed to be almost desperate, he invaded Hindostan, and, in 1525, overthrew and killed sultan Ibrahim, the last Hindoo emperor of the Patan or Afghan race."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
