                "senses": [
                    {
                        "sense_id": "42709a77-4886-3a1e-b725-dd3f026ad784",
                        "entry_id": "a37cc6a3-99a3-361b-b7a6-ab06d8708c16",
                        "glosses": [
                            "Fait d’être polyploïde."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "606207b1-9517-4be6-bbf9-c85f362aed43",
                                "sense_id": "42709a77-4886-3a1e-b725-dd3f026ad784",
                                "text": "La polyploïdie induite par la duplication du génome (autoploïdie) ou par l’addition du génome (alloploïdie) s’est produite naturellement au cours de l’évolution de nombreuses espèces de plantes, y compris les cultures, ..."
                            }
                        ]
                    },
                    {
                        "sense_id": "518a3a97-00ce-3a40-94f4-918db40af90a",
                        "entry_id": "a37cc6a3-99a3-361b-b7a6-ab06d8708c16",
                        "glosses": [
                            "Multiplication au sein du noyau d’une cellule de son stock de chromosomes par un facteur supérieur à 2."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "8b109871-f55e-40ad-8d62-9de798b00248",
                                "sense_id": "518a3a97-00ce-3a40-94f4-918db40af90a",
                                "text": "La polyploïdie consiste en la multiplication du nombre de chromosomes au sein du génome."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bcf8ae29-1cf5-4235-b213-ef0b84bcff64",
                        "source_entry_id": "a37cc6a3-99a3-361b-b7a6-ab06d8708c16",
                        "target_lang_word": "Polyploidie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polyploidie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e420966a-d0d4-319e-8a73-7e3a72b7b887",
                                        "entry_id": "70a375d6-d6b5-3984-9a74-e98f1274311f",
                                        "glosses": [
                                            "Vorhandensein von mehr als zwei haploiden Sätzen homologer Chromosomen im Zellkern"
                                        ],
                                        "tags": [
                                            "Zytologie",
                                            "Genetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2786b53a-ffff-44ab-b45d-9d8de253fe08",
                                                "sense_id": "e420966a-d0d4-319e-8a73-7e3a72b7b887",
                                                "text": "„Bei Pflanzen, insbesondere Zier- und Nutzpflanzen, kommt es nicht selten zu einer Vervielfachung des gesamten Chromosomensatzes, der Polyploidie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b371ca21-f62c-4470-920c-dce9a05c7f0f",
                        "source_entry_id": "a37cc6a3-99a3-361b-b7a6-ab06d8708c16",
