{
    "word_family": [
        "gehurkt",
        "hurkzit"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2c4b9f93-75ac-3865-854c-da518d09e122",
                    "sense_definition": "met gebogen knieën laag bij de grond gaan zitten of zitten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zithouding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze <w>hurkte</w> om wat onkruid uit de tuin te wieden.",
                            "target_lang_translations": {
                                "en": "She <w>squatted</w> down to pull some weeds from the garden.",
                                "ru": "Она <w>присела на корточки</w>, чтобы прополоть сорняки в саду."
                            }
                        },
                        {
                            "text": "De burgemeester <w>hurkt</w> voor het monument om de bloemen neer te leggen.",
                            "target_lang_translations": {
                                "en": "The mayor <w>crouches</w> before the monument to lay down the flowers.",
                                "ru": "Мэр <w>приседает</w> перед монументом, чтобы возложить цветы."
                            }
                        }
                    ],
                    "synonyms": [
                        "bukken",
                        "neerhurken"
                    ],
                    "antonyms": [
                        "staan",
                        "opstaan"
                    ],
                    "common_phrases": [
                        "bij het vuur hurken",
                        "laag bij de grond hurken"
                    ],
                    "target_lang_definitions": {
                        "en": "To sit or lower oneself close to the ground with the knees bent.",
                        "ru": "Сидеть или опускаться низко к земле, согнув колени."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "squat",
                                "target_lang_sense_clarification": "to bend deeply at the knees"
                            },
                            {
                                "target_lang_word": "crouch",
                                "target_lang_sense_clarification": "to lower the body by bending the legs"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сидеть на корточках",
                                "target_lang_sense_clarification": "находиться в позе с согнутыми коленями"
                            },
                            {
                                "target_lang_word": "присесть на корточки",
                                "target_lang_sense_clarification": "опуститься в позу с согнутыми коленями"
                            },
                            {
                                "target_lang_word": "приседать",
                                "target_lang_sense_clarification": "сгибать ноги в коленях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "508223d9-e821-35e5-ac91-08ab33fc79f8",
                    "sense_definition": "zich klein maken uit angst of om niet gezien te worden",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "zithouding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bange hond <w>hurkte</w> in een hoekje van de kamer.",
                            "target_lang_translations": {
                                "en": "The frightened dog <w>cowered</w> in a corner of the room.",
                                "ru": "Испуганный пес <w>забился</w> в угол комнаты."
                            }
                        },
                        {
                            "text": "De soldaten <w>hurkten</w> achter de muur om dekking te zoeken.",
                            "target_lang_translations": {
                                "en": "The soldiers <w>crouched</w> behind the wall to seek cover.",
                                "ru": "Солдаты <w>пригнулись</w> за стеной, чтобы найти укрытие."
                            }
                        }
                    ],
                    "synonyms": [
                        "ineenkrimpen",
                        "schuilen"
                    ],
                    "common_phrases": [
                        "in een hoekje hurken"
                    ],
                    "target_lang_definitions": {
                        "en": "To make oneself small out of fear or to avoid being seen.",
                        "ru": "Сжиматься или пригибаться от страха или чтобы остаться незамеченным."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cower",
                                "target_lang_sense_clarification": "to crouch down in fear"
                            },
                            {
                                "target_lang_word": "crouch",
                                "target_lang_sense_clarification": "to stay low to avoid observation"
                            },
                            {
                                "target_lang_word": "huddle",
                                "target_lang_sense_clarification": "to curl up for protection or warmth"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пригибаться",
                                "target_lang_sense_clarification": "наклоняться к земле для укрытия"
                            },
                            {
                                "target_lang_word": "забиться",
                                "target_lang_sense_clarification": "спрятаться, сжавшись от страха"
                            },
                            {
                                "target_lang_word": "съежиться",
                                "target_lang_sense_clarification": "сжаться всем телом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "37d8cd2d-4adc-3cac-ae2f-d8d25f9a2db9",
                    "sense_definition": "een houding waarbij men met gebogen knieën op de onderbenen rust",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zithouding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij zat urenlang op zijn <w>hurken</w> om de mieren te bestuderen.",
                            "target_lang_translations": {
                                "en": "He sat on his <w>haunches</w> for hours to study the ants.",
                                "ru": "Он часами сидел на <w>корточках</w>, изучая муравьев."
                            }
                        },
                        {
                            "text": "Door de vermoeidheid zakte de wandelaar door zijn <w>hurken</w>.",
                            "target_lang_translations": {
                                "en": "Due to exhaustion, the hiker sank into a <w>squat</w>.",
                                "ru": "От усталости путник <w>опустился на корточки</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "op de hurken zitten",
                        "door de hurken zakken"
                    ],
                    "target_lang_definitions": {
                        "en": "A posture where one rests on the lower legs with bent knees.",
                        "ru": "Положение тела, при котором человек опирается на голени при согнутых коленях."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "squat",
                                "target_lang_sense_clarification": "the position of sitting on one's heels"
                            },
                            {
                                "target_lang_word": "haunches",
                                "target_lang_sense_clarification": "used in the phrase 'on one's haunches'"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "корточки",
                                "target_lang_sense_clarification": "положение сидя на согнутых ногах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "236df195-6fb1-35f1-a953-b969638e7aa3",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>hurk</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In deze oude tekst wordt gesproken over de verschillende <w>hurken</w> van het gebouw.",
                            "target_lang_translations": {
                                "en": "In this old text, the various <w>corners</w> of the building are mentioned.",
                                "ru": "В этом старом тексте говорится о различных <w>углах</w> здания."
                            }
                        },
                        {
                            "text": "De <w>hurken</w> zijn de hoeken van een constructie.",
                            "target_lang_translations": {
