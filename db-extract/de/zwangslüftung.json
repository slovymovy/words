                "senses": [
                    {
                        "sense_id": "c2331a91-b446-38cf-9334-7837ebfb354b",
                        "entry_id": "a87d015a-74ef-32f8-aba5-afbb5ec9e803",
                        "glosses": [
                            "nachträgliche Be- und Entlüftung eines dichten Raumes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db0f8159-c218-4720-bd88-72ce025597df",
                                "sense_id": "c2331a91-b446-38cf-9334-7837ebfb354b",
                                "text": "„Bei Zwangslüftung fallen zwar relativ hohe Kosten für Installation, Unterhalt und Betrieb an.“"
                            },
                            {
                                "example_id": "6f49ead2-4999-4ba8-8381-cf09a2c4ef49",
                                "sense_id": "c2331a91-b446-38cf-9334-7837ebfb354b",
                                "text": "„Die Zwangslüftung durch die ausgeschnittenen Dichtungen und die Lüftungselemente kann die Feuchte nicht senken!“"
                            },
                            {
                                "example_id": "6614e593-a1d8-463f-8e8b-6ef55c0e2d60",
                                "sense_id": "c2331a91-b446-38cf-9334-7837ebfb354b",
                                "text": "„Die Zwangslüftung dieser Art macht allerdings den dafür erforderlichen Aspekt der thermischen Isolierung zunichte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
