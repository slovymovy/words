                "senses": [
                    {
                        "sense_id": "39024b3f-86de-37ff-9f25-6163dbff517f",
                        "entry_id": "3ef671de-6f8f-369e-9d22-1148cce62586",
                        "glosses": [
                            "Gangart von Vierbeinern, bei der die rechten und linken Beine abwechselnd vorgesetzt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "905d66a2-2c11-49ee-b139-fbfe96f242af",
                                "sense_id": "39024b3f-86de-37ff-9f25-6163dbff517f",
                                "text": "Kamele und Giraffen gehen im Passgang."
                            },
                            {
                                "example_id": "ac58fedf-dfe5-44ab-ab7b-c94ce86c7142",
                                "sense_id": "39024b3f-86de-37ff-9f25-6163dbff517f",
                                "text": "„Kutusow trieb ungeduldig sein Pferd an, das in weit ausladendem Passgang die Last des schweren Mannes trug, und legte immer wieder nickend die Hand an die schirmlose, rotgeränderte weisse Chevaliergarde-Mütze, die er aufhatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c755ee08-d546-4be3-aea2-4431e2ead8f6",
                        "source_entry_id": "3ef671de-6f8f-369e-9d22-1148cce62586",
                        "source_sense_id": "39024b3f-86de-37ff-9f25-6163dbff517f",
                        "source_sense_description": "Zoologie: Gangart von Vierbeinern, bei der die rechten und linken Beine abwechselnd vorgesetzt werden",
                        "target_lang_word": "pace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4facb4d9-4642-3346-a81a-8a64f87a9cd0",
                                        "entry_id": "4083cbe5-ff3c-3d13-813d-e35af919f98a",
                                        "glosses": [
                                            "A step.",
                                            "A step taken with the foot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43c37f21-b68c-3273-9cfe-0317d45a4bd1",
                                        "entry_id": "4083cbe5-ff3c-3d13-813d-e35af919f98a",
                                        "glosses": [
                                            "A step.",
                                            "The distance covered in a step (or sometimes two), either vaguely or according to various specific set measurements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60173326-c43a-4d1b-9473-f7fc0fef60ee",
                                                "sense_id": "43c37f21-b68c-3273-9cfe-0317d45a4bd1",
                                                "text": "Even at the duel, standing 10 paces apart, he could have satisfied Aaron’s honor."
                                            },
                                            {
                                                "example_id": "c2400793-a77c-4fd4-8245-18e8f74e100a",
                                                "sense_id": "43c37f21-b68c-3273-9cfe-0317d45a4bd1",
                                                "text": "I have perambulated your field, and estimate its perimeter to be 219 paces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ee7925b-d3a8-37d9-a3a6-bae56c3a108a",
                                        "entry_id": "4083cbe5-ff3c-3d13-813d-e35af919f98a",
                                        "glosses": [
                                            "A way of stepping.",
                                            "A manner of walking, running or dancing; the rate or style of how someone moves with their feet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28c66293-49fb-4377-b18d-07690da11993",
                                                "sense_id": "2ee7925b-d3a8-37d9-a3a6-bae56c3a108a",
                                                "text": "Netherlands, one of the pre-tournament favourites, combined their undoubted guile, creativity, pace and attacking quality with midfield grit and organisation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d14305b7-f402-3bc9-a195-e124ed541c4f",
                                        "entry_id": "4083cbe5-ff3c-3d13-813d-e35af919f98a",
                                        "glosses": [
                                            "A way of stepping.",
                                            "Any of various gaits of a horse, specifically a 2-beat, lateral gait."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f79f558-b43c-31e1-bca8-30a105c0ad15",
                                        "entry_id": "4083cbe5-ff3c-3d13-813d-e35af919f98a",
                                        "glosses": [
                                            "Speed or velocity in general."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b40accf-7130-41e4-bdf1-c06fb666b7e2",
                                                "sense_id": "4f79f558-b43c-31e1-bca8-30a105c0ad15",
                                                "text": "For with ſuch puiſſance and impetuous maine / Thoſe Champions broke on them, that forſt the fly, / Like ſcattered Sheepe, whenas the Shepherds ſwaine / A Lyon and a Tigre doth eſpye, / With greedy pace forth ruſhing from the foreſt nye."
                                            },
                                            {
                                                "example_id": "0bd3649f-3f2d-49e5-8f79-af9d259dcc04",
                                                "sense_id": "4f79f558-b43c-31e1-bca8-30a105c0ad15",
                                                "text": "The fastest women runners can run a mile in well under five minutes, but in order to reach that goal they've had to train at a much slower pace over thousands of miles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1abcc19-3848-3277-91cc-e18709b46aee",
                                        "entry_id": "4083cbe5-ff3c-3d13-813d-e35af919f98a",
                                        "glosses": [
                                            "A measure of the hardness of a pitch and of the tendency of a cricket ball to maintain its speed after bouncing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb042d48-484f-4fc7-a1a9-1be74ec52157",
                                                "sense_id": "d1abcc19-3848-3277-91cc-e18709b46aee",
                                                "text": "He didn't bowl a lot of pace in the first T20I."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71f7990d-89ec-394c-ab1d-fb11caac0b73",
                                        "entry_id": "4083cbe5-ff3c-3d13-813d-e35af919f98a",
                                        "glosses": [
                                            "A group of donkeys."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d39a63b2-80a0-4b26-aafe-da62a7957dc5",
                                                "sense_id": "71f7990d-89ec-394c-ab1d-fb11caac0b73",
                                                "text": "[…] but at Broadstairs and other places along the coast, a pace of donkeys stood on the sea-shore expectant (at least, their owners were expectant) of children clamouring to ride."
                                            },
                                            {
                                                "example_id": "0305b5f7-ab12-48f3-95a9-4dca5a86462d",
                                                "sense_id": "71f7990d-89ec-394c-ab1d-fb11caac0b73",
                                                "text": "A pace of donkeys fans out in different directions."
                                            },
                                            {
                                                "example_id": "3126f911-19b3-4568-8b7d-2ece9ad220be",
                                                "sense_id": "71f7990d-89ec-394c-ab1d-fb11caac0b73",
                                                "text": "Like a small farm, the lighthouse compound had its chattering of chicks, pace of donkeys, troop of horses, and fold of sheep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c2baa4b-1221-3436-879b-fc11a6a76953",
                                        "entry_id": "4083cbe5-ff3c-3d13-813d-e35af919f98a",
                                        "glosses": [
                                            "A passage, a route.",
                                            "One's journey or route."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3c88c25-f392-3a75-84ba-82e41c8c4dc0",
                                        "entry_id": "4083cbe5-ff3c-3d13-813d-e35af919f98a",
                                        "glosses": [
                                            "A passage, a route.",
                                            "A passage through difficult terrain; a mountain pass or route vulnerable to ambush etc."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c2e29a2-e108-4ef9-8fd3-dcd1feea83c6",
                                                "sense_id": "a3c88c25-f392-3a75-84ba-82e41c8c4dc0",
                                                "text": "But when she saw them gone she forward went, / As lay her journey, through that perlous Pace [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d07cd027-879b-389f-9295-ef340e4d1cb9",
                                        "entry_id": "4083cbe5-ff3c-3d13-813d-e35af919f98a",
                                        "glosses": [
                                            "A passage, a route.",
                                            "An aisle in a church."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
