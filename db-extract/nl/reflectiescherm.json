                        "sense_id": "1b3e2279-c744-35d5-add1-a0a34b05f1c9",
                        "entry_id": "5ec32066-9312-3647-a4c8-4f6648c25950",
                        "glosses": [
                            "een scherm dat in de fotografie gebruikt wordt om licht te reflecteren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "337c7543-1cf9-41c1-9481-ae601ff6c5d5",
                                "sense_id": "1b3e2279-c744-35d5-add1-a0a34b05f1c9",
                                "text": "Op zijn voormalige kamer stond onveranderd het statief - zonder camera erop, maar met een parapluvormig reflectiescherm eraan vastgeschroefd."
                            },
                            {
                                "example_id": "52fa0917-b3ea-4cf9-8664-aec8529e5dbc",
                                "sense_id": "1b3e2279-c744-35d5-add1-a0a34b05f1c9",
                                "text": "RTL-hunk Ruben Nicolai (41) houdt ervan het nuttige met het aangename te verenigen. De presentator is op Curaçao voor de opnames van Idols. Tussen het draaien door gebruikte hij een reflectiescherm, bedoeld om mensen voor de camera in gunstig licht te zetten, om de zon perfect op zijn gelaat te laten schijnen."
                            }
                        ]
                    }
