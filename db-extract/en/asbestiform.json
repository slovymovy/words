                        "examples": [
                            {
                                "example_id": "2369a770-0828-4875-b4cd-0a6d62d2f4af",
                                "sense_id": "2b7bf729-4736-3282-bcc7-45042e3a0c9e",
                                "text": "THESE MATERIALS INCLUDE A BROAD RANGE OF ORGANIC COMPOUNDS, SUCH AS HALOGENATED PESTICIDES AND POLYHALOGENATED BIPHENYLS, AND A VARIETY OF INORGANIC SUBSTANCES, INCLUDING ASBESTIFORMS AND HEAVY METALS, SUCH AS CADMIUM AND MERCURY."
                            },
                            {
                                "example_id": "f0fcbc1c-79a2-4ec5-ab53-3476384c991c",
                                "sense_id": "2b7bf729-4736-3282-bcc7-45042e3a0c9e",
                                "text": "Vermont talc is of cosmetic grade which is low in free silica and asbestiforms."
                            },
                            {
                                "example_id": "35adb310-d883-4bc0-a6e0-db6b50937f8c",
                                "sense_id": "2b7bf729-4736-3282-bcc7-45042e3a0c9e",
                                "text": "The amphibole asbestiforms present a more difficult problem."
