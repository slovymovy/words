                "forms": [],
                "senses": [
                    {
                        "sense_id": "06eaf11e-d41a-3f45-9621-76e10b0538f1",
                        "entry_id": "cf9bea65-f8e2-3c92-b682-9219b1296000",
                        "glosses": [
                            "Région du sud-ouest de l’Italie, formant une péninsule."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "9a54df18-b956-43fe-a726-850c982b3ca6",
                                "sense_id": "06eaf11e-d41a-3f45-9621-76e10b0538f1",
                                "text": "De Brancaleone à Monasterace, tous les villages de la côte est de la Calabre connus pour être les fiefs des dix grandes « familles » de la mafia calabraise, ont été bouclés et la plupart des individus recherchés, arrêtés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76d0a161-157e-4b32-91f5-fa625976fb4c",
                        "source_entry_id": "cf9bea65-f8e2-3c92-b682-9219b1296000",
                        "source_sense_id": "06eaf11e-d41a-3f45-9621-76e10b0538f1",
                        "target_lang_word": "Kalabrien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kalabrien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e436ad9-cdc5-3ba0-a003-155d57f83c8e",
                                        "entry_id": "f8e9f37d-54b0-3ffe-b234-51ade0e815e4",
                                        "glosses": [
                                            "Region im äußersten Süden Italiens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "153a028b-14a3-4ead-b4aa-50339a179bf8",
                                                "sense_id": "3e436ad9-cdc5-3ba0-a003-155d57f83c8e",
                                                "text": "Kalabriens Hauptstadt ist Catanzaro."
                                            },
                                            {
                                                "example_id": "a74201d6-c1a5-4d1b-b1b5-b76bcae24a07",
                                                "sense_id": "3e436ad9-cdc5-3ba0-a003-155d57f83c8e",
                                                "text": "Kalabrien bildet die erdbebenreiche Südwesthalbinsel Italiens."
                                            },
                                            {
                                                "example_id": "23434228-b115-41ac-85ff-03a5e2b38627",
                                                "sense_id": "3e436ad9-cdc5-3ba0-a003-155d57f83c8e",
                                                "text": "„Die jüngere hielt es für nötig, meine Spottrede über ihr Land übelzunehmen und mir Fehde anzusagen; doch ich besänftigte sie mit den Worten, Kalabrien wäre ein wunderschönes Land, wenn wenigstens ein Viertel der Einwohner ihr ähnlich sähe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
