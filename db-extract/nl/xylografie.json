                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Xylographie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "521c6194-a543-346f-9a08-082da2f3e9b8",
                                        "entry_id": "08d09cd1-e91d-3231-9fe6-0c6123ea9738",
                                        "glosses": [
                                            "Druckverfahren, bei dem mithilfe eines Messers eine Zeichnung seitenverkehrt in einen Holzblock geschnitten wird"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "47286c81-bb7f-3b3d-98d3-a7da34e27192",
                                        "entry_id": "08d09cd1-e91d-3231-9fe6-0c6123ea9738",
                                        "glosses": [
                                            "ein durch Holzschneidekunst erzeugtes Werk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e70d4d1d-aa3a-4e99-bcda-d59f475506e1",
                                                "sense_id": "47286c81-bb7f-3b3d-98d3-a7da34e27192",
                                                "text": "„Was aber die Dämonie der hinter den zwanziger Jahren liegenden Jahrhundertwende betrifft – die hat der deutsche Erzsurrealist Max Ernst schon vor drei Jahrzehnten gespürt, als er Xylographien aus den „Illustrierten“ des ausgehenden 19. Jahrhunderts auseinanderschnitt und in unerwarteten Kombinationen wieder zusammenklebte.“"
                                            },
                                            {
                                                "example_id": "5724db3f-a67c-4ab5-968b-29878611480d",
                                                "sense_id": "47286c81-bb7f-3b3d-98d3-a7da34e27192",
                                                "text": "„Und es gab 1891 die Gartenlaube, zwar noch nicht mit Photos, aber mit Xylographien, Holzstichen also.“"
                                            },
                                            {
                                                "example_id": "f5c56270-af82-454f-93f7-501576fa6146",
                                                "sense_id": "47286c81-bb7f-3b3d-98d3-a7da34e27192",
                                                "text": "„»Übersegelt« hieß eine alte Xylographie mit dem mächtigen Bug eines Vollschiffs, der einen Fischkutter zu Trümmern zerspellte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61cfff21-f602-449a-9f36-dce14daa95e3",
                        "source_entry_id": "c45ddef0-7500-3998-95e1-908102dd966d",
                        "source_sense_id": "c176afbd-1944-31cc-94c0-d9c4d0574693",
