                                                "sense_id": "7997e67e-c9fb-37b3-b3ed-8d3edb0d5a4a",
                                                "text": "The plant's growth was stunted because it was placed in a closet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stunted",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fd61d81-01f3-30ce-aa51-6aa60c39bd26",
                                        "entry_id": "6d0ab4a5-4bab-34b5-8a91-bcafad77345e",
                                        "glosses": [
                                            "Prevented from growing or developing fully and hence shorter and stockier that usual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "869b1634-9727-4978-836b-3dc4f365c909",
                                                "sense_id": "0fd61d81-01f3-30ce-aa51-6aa60c39bd26",
                                                "text": "A poor diet leads to stunted growth."
                                            },
                                            {
                                                "example_id": "355a5aa8-5a51-4a81-baed-3360a6610ab6",
                                                "sense_id": "0fd61d81-01f3-30ce-aa51-6aa60c39bd26",
                                                "text": "Here lay a desolate valley—a shallow, narrow valley dotted with stunted trees and covered with many great bowlders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a429786b-1435-33eb-941b-b1f7f04d964a",
                                        "entry_id": "6d0ab4a5-4bab-34b5-8a91-bcafad77345e",
                                        "glosses": [
                                            "Of a person: shorter than usual for one's age."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
