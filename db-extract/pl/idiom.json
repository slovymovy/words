                "senses": [
                    {
                        "sense_id": "002cef54-5e34-369b-8b9f-88828a839650",
                        "entry_id": "e13a90ae-d73e-329d-a745-9c460526ca7f",
                        "glosses": [
                            "wyrażenie językowe, którego znaczenie jest swoiste, odmienne od znaczenia, jakie należałoby mu przypisać, biorąc pod uwagę poszczególne części składowe oraz reguły składni"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac488334-7e4d-4d40-88b8-8c846e6f5452",
                                "sense_id": "002cef54-5e34-369b-8b9f-88828a839650",
                                "text": "Idiomów nie tłumaczy się dosłownie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "12a97765-46e3-3874-8570-64d3bbe3e518",
                        "entry_id": "e13a90ae-d73e-329d-a745-9c460526ca7f",
                        "glosses": [
                            "mowa, narzecze"
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "2f34123f-d0d2-3be0-8f01-a686cdcf4998",
                        "entry_id": "e13a90ae-d73e-329d-a745-9c460526ca7f",
                        "glosses": [
                            "zespół cech charakterystycznych dla danej dziedziny sztuki, okresu artystycznego lub artysty"
                        ],
                        "tags": [],
