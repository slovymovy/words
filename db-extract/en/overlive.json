                "senses": [
                    {
                        "sense_id": "fda284de-b8ce-3e02-a058-f022a26a50df",
                        "entry_id": "d97e32ae-10ab-32f1-a5bc-1e35abdf6dd9",
                        "glosses": [
                            "To survive; to live past."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "84162216-56de-3d8b-9628-f1b44802ea89",
                        "entry_id": "d97e32ae-10ab-32f1-a5bc-1e35abdf6dd9",
                        "glosses": [
                            "To outlive; live longer than."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "aed85eea-70b4-4533-ae6d-19220a3b6357",
                                "sense_id": "84162216-56de-3d8b-9628-f1b44802ea89",
                                "text": "[M]y disease cannot survive me, I may overlive it."
                            },
                            {
                                "example_id": "c3b539e1-6400-4ca9-90ba-d9725af5e76d",
                                "sense_id": "84162216-56de-3d8b-9628-f1b44802ea89",
                                "text": "\"Her Majesty's life will never be safe for a moment while she lives; and what would become of us all did she overlive the Queen!\""
                            }
                        ]
                    },
                    {
                        "sense_id": "b7b10841-3398-3f0e-88af-d16be78b072b",
                        "entry_id": "d97e32ae-10ab-32f1-a5bc-1e35abdf6dd9",
                        "glosses": [
                            "To live too long."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "65a03186-1273-4919-a9bc-73cf6092d348",
                                "sense_id": "b7b10841-3398-3f0e-88af-d16be78b072b",
                                "text": "Why do I overlive?\nWhy am I mocked with death, and lengthened out\nto deathless pain?"
                            },
                            {
                                "example_id": "fbca9e70-aef5-415e-9c40-8e53b2c25c8d",
                                "sense_id": "b7b10841-3398-3f0e-88af-d16be78b072b",
                                "text": "The misguided youngsters are yachting, attending the races, playing the \"stage Johnny,\" automobiling, playing poker for high stakes, overliving at home, on expensive shopping tours, attending box parties to the theatre, visiting high-priced restaurants, etc., etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2f503a7-5a06-31c7-ad4a-db7f122d7031",
                        "entry_id": "d97e32ae-10ab-32f1-a5bc-1e35abdf6dd9",
                        "glosses": [
                            "To live too fast, too luxuriously, or too actively."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    }
                ],
