                        "form_id": "e3049b87-7864-416b-bfd4-8a34794152bc",
                        "entry_id": "7c4a6d2d-826a-37f9-a989-4fd4518a6d53",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more abundantly"
                    },
                    {
                        "form_id": "fc4f4d0a-e0a4-49bd-99b9-76aafeb05ae9",
                        "entry_id": "7c4a6d2d-826a-37f9-a989-4fd4518a6d53",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most abundantly"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d5a72d95-590f-3298-ac29-b45e00ebb098",
                        "entry_id": "7c4a6d2d-826a-37f9-a989-4fd4518a6d53",
                        "glosses": [
                            "In an abundant manner; in a sufficient degree; in large measure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04a2ec9b-968e-42e9-866e-b32e9fe0288c",
                                "sense_id": "d5a72d95-590f-3298-ac29-b45e00ebb098",
                                "text": "And God said, Let the waters bring foorth aboundantly the mouing creature that hath life, and foule that may flie aboue the earth in the open firmament of heauen."
                            },
                            {
                                "example_id": "173e0071-7aeb-4c60-bc64-8474a5a24fab",
                                "sense_id": "d5a72d95-590f-3298-ac29-b45e00ebb098",
                                "text": "When strata are so unsymmetrically and abundantly folded that it becomes difficult or impossible to trace out the individual flexures and crumplings — the whole forming an irregular complex of folds — they are said to be contorted […]"
                            },
                            {
                                "example_id": "022e5752-c5b2-4207-96ce-1064e5a53cca",
                                "sense_id": "d5a72d95-590f-3298-ac29-b45e00ebb098",
                                "text": "Hodgson also has Wayne Rooney to call on once he has served a two-match suspension at the start of the tournament - and it is abundantly clear England will rely as heavily as ever on his ability to shape the outcome of important games."
                            },
                            {
                                "example_id": "56672de7-f7e7-4ef3-a799-978bb9b8065e",
                                "sense_id": "d5a72d95-590f-3298-ac29-b45e00ebb098",
                                "text": "Indian English is today one of the most widespread and abundantly used varieties of English, in extensive use not only throughout South Asia but in virtually every corner of the globe."
                            }
                        ]
                    },
                    {
                        "sense_id": "acbf7f84-7531-3e99-a2ed-6b2319f59ed9",
                        "entry_id": "7c4a6d2d-826a-37f9-a989-4fd4518a6d53",
                        "glosses": [
                            "Extremely."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01ae429f-ab2a-42e0-bd4e-d548821a6f9c",
                                "sense_id": "acbf7f84-7531-3e99-a2ed-6b2319f59ed9",
                                "text": "The explosion, in other words, was unexpected, powerful, and politically diffuse; it vented sharp African frustrations with the colonial situation, but had no readily visible leadership or political goals; it made abundantly obvious the need to speed the pace of self-government"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2217a08a-b6f9-431e-878e-280fb1bd61f9",
                        "source_entry_id": "7c4a6d2d-826a-37f9-a989-4fd4518a6d53",
                        "source_sense_description": "in an abundant manner",
                        "target_lang_word": "overvloedig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overvloedig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5857f1d0-0fec-3366-8058-e1f6e54f1cf2",
                                        "entry_id": "7a7c760f-bed7-3d34-a19c-563f0eddccd2",
                                        "glosses": [
                                            "in ruime hoeveelheid aanwezig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "240916eb-4805-4c34-b9bd-0bb14ba21dd9",
                                                "sense_id": "5857f1d0-0fec-3366-8058-e1f6e54f1cf2",
                                                "text": "Je ziet ook hoe het leven langzaam uit de Route is weggetrokken. De romantiek van het verval is overvloedig aanwezig. Verlaten, met gras en onkruid overwoekerde tankstations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6f3d61a-ce8b-47c8-a84e-421f28911e63",
                        "source_entry_id": "7c4a6d2d-826a-37f9-a989-4fd4518a6d53",
                        "source_sense_description": "in an abundant manner",
                        "target_lang_word": "abondamment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abondamment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec83574a-74c7-36ac-a68d-e0ce0c6175a6",
                                        "entry_id": "7cc85cc6-d415-33c7-87a1-c7f4a40c0f69",
                                        "glosses": [
                                            "Avec abondance, de manière abondante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ee3cc99-e77b-438e-9e23-6d68152d230c",
                                                "sense_id": "ec83574a-74c7-36ac-a68d-e0ce0c6175a6",
                                                "text": "Sur le pont, en tenue légère, étaient des matelots américains, tous abondamment tatoués."
                                            },
                                            {
                                                "example_id": "ff5f4fac-3d3a-4fc8-9628-e67251a98f30",
                                                "sense_id": "ec83574a-74c7-36ac-a68d-e0ce0c6175a6",
                                                "text": "La salive contient abondamment de l’enzyme protéolytique qui attaque les albumines."
                                            },
                                            {
                                                "example_id": "63e95c34-b098-48ef-8478-19914696d58a",
                                                "sense_id": "ec83574a-74c7-36ac-a68d-e0ce0c6175a6",
                                                "text": "Cette source fournit de l'eau abondamment."
                                            },
                                            {
                                                "example_id": "e1768bd9-3fe7-4cb4-b3f7-f86b6b0debb0",
                                                "sense_id": "ec83574a-74c7-36ac-a68d-e0ce0c6175a6",
                                                "text": "Cet avocat parla plus abondamment que son adversaire."
                                            },
                                            {
                                                "example_id": "e20beb3e-11f6-4774-b65d-6272c7cf51a9",
                                                "sense_id": "ec83574a-74c7-36ac-a68d-e0ce0c6175a6",
                                                "text": "Parce qu’il ne jeûnait et qu’il ne payait si abondamment la dîme que par orgueil."
                                            },
                                            {
                                                "example_id": "3fcdf74d-b071-4b68-91ad-966a01525a7a",
                                                "sense_id": "ec83574a-74c7-36ac-a68d-e0ce0c6175a6",
                                                "text": "Le Seigneur se communiquait à eux [aux saints] plus abondamment."
                                            },
                                            {
                                                "example_id": "af411edd-f1ff-4b82-b04d-93b6d387af88",
                                                "sense_id": "ec83574a-74c7-36ac-a68d-e0ce0c6175a6",
                                                "text": "Animés plus abondamment de son esprit [on parle de Dieu]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cde98353-fb86-3cc5-8b5e-7e9cbe56c6e8",
                                        "entry_id": "7cc85cc6-d415-33c7-87a1-c7f4a40c0f69",
                                        "glosses": [
                                            "Amplement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a51139a7-cc0f-44d3-8189-9ec5cdbc843b",
                                                "sense_id": "cde98353-fb86-3cc5-8b5e-7e9cbe56c6e8",
                                                "text": "Cela est abondamment expliqué, abondamment démontré dans plusieurs livres."
                                            },
                                            {
                                                "example_id": "453c30aa-dd81-4636-a68d-5f44c6014fdf",
                                                "sense_id": "cde98353-fb86-3cc5-8b5e-7e9cbe56c6e8",
                                                "text": "Il y a dans ce sujet abondamment de quoi remplir un poème entier."
                                            },
                                            {
                                                "example_id": "6df153fe-63c2-4a7a-8699-05e7675a0b90",
                                                "sense_id": "cde98353-fb86-3cc5-8b5e-7e9cbe56c6e8",
                                                "text": "Cette question sera abondamment traitée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
