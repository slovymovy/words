                                                "sense_id": "b884d2a5-42e5-3a35-a738-86693c8ad85a",
                                                "text": "His audition was poor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "650ea33c-334b-3568-8a51-b69206c2b7f4",
                                        "entry_id": "0cc37b12-ab96-39ab-975e-719d9ec7fece",
                                        "glosses": [
                                            "An act of hearing; being heard."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8ce64b4-d5f3-40f9-b3bd-87c517a90172",
                                                "sense_id": "650ea33c-334b-3568-8a51-b69206c2b7f4",
                                                "text": "Abraham talked on, rather for the pleasure of utterance than for audition, so that his sister's abstraction was of no account."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72eb7f14-d368-3910-83a1-4888aaf7aa3f",
                                        "entry_id": "0cc37b12-ab96-39ab-975e-719d9ec7fece",
