                "senses": [
                    {
                        "sense_id": "fbbf2241-292d-3246-9717-8dd696f7ec1b",
                        "entry_id": "8bee2db7-a5be-3111-a18d-0c0b429f0e59",
                        "glosses": [
                            "Donner un caractère chirurgical à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ad10d9b-1208-4a3a-aadc-49dd9032c0e3",
                                "sense_id": "fbbf2241-292d-3246-9717-8dd696f7ec1b",
                                "text": "Il serait mesquin et irréaliste de ne pas évoquer les voix de plus en plus nombreuses qui s'élèvent cependant dans notre pays pour « chirurgicaliser » à l'extrême notre spécialité."
                            },
                            {
                                "example_id": "7a08d69b-bef6-4cd8-aec5-832d59877050",
                                "sense_id": "fbbf2241-292d-3246-9717-8dd696f7ec1b",
                                "text": "Ce DAC pourra-t-il donner un peu plus de chaleur au son que l'ampli a tendance à chirurgicaliser ?"
                            },
                            {
                                "example_id": "42381a34-e495-4713-b5b4-ad3781deeb50",
                                "sense_id": "fbbf2241-292d-3246-9717-8dd696f7ec1b",
                                "text": "Pour l'instant les choses apparaissent de manière importante puisqu'on est en train de « chirurgicaliser » le problème et d'essayer dans cette affaire des pulsions de mettre les choses plans à plans puisque comme vous avez pu le remarquer, les pulsions c'est une manœuvre d'escamotage pour retraverser non seulement toute la théorie mais toutes les théories analytiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7e34053-fc64-37e3-8763-7d709aa2ea82",
                        "entry_id": "8bee2db7-a5be-3111-a18d-0c0b429f0e59",
                        "glosses": [
                            "Opérer (chirurgicalement)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f998807f-5a00-426e-9000-4249847c42e4",
                                "sense_id": "a7e34053-fc64-37e3-8763-7d709aa2ea82",
                                "text": "Faut-il se faire chirurgicaliser esthétiquement?"
                            },
                            {
                                "example_id": "1bf4fa1e-f3b4-4a14-99bc-f20f63116d19",
                                "sense_id": "a7e34053-fc64-37e3-8763-7d709aa2ea82",
                                "text": "Je peux te chirurgicaliser le cerveau ?"
                            }
                        ]
                    }
