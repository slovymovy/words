                ],
                "senses": [
                    {
                        "sense_id": "22b8b4e8-2003-3edf-848d-3a4f6e2f618d",
                        "entry_id": "6736c55b-629a-3089-9e8d-fb58bff627a6",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cee6530-1328-4e4a-885a-cbd45c67a28e",
                                "sense_id": "22b8b4e8-2003-3edf-848d-3a4f6e2f618d",
                                "text": "Frau Ebel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5a26cbac-f201-438d-b04f-2156ee23c4b1",
                                "sense_id": "22b8b4e8-2003-3edf-848d-3a4f6e2f618d",
                                "text": "Herr Ebel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "273137d7-fa89-4f83-8ddd-952f9e0b884b",
                                "sense_id": "22b8b4e8-2003-3edf-848d-3a4f6e2f618d",
                                "text": "Die Ebels kommen heute von Borkum."
                            },
                            {
                                "example_id": "a83f7d81-6d9f-4a83-b65d-06d3918f017c",
                                "sense_id": "22b8b4e8-2003-3edf-848d-3a4f6e2f618d",
                                "text": "Der Ebel trägt nie die Schals, die die Ebel ihm strickt."
                            },
                            {
                                "example_id": "b5940eca-a249-4eb3-a04e-011786ae497a",
                                "sense_id": "22b8b4e8-2003-3edf-848d-3a4f6e2f618d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ebel kommt, geht der Herr Ebel.“"
                            },
                            {
                                "example_id": "b53a5077-c7e1-41cf-b7b0-875ba43403d1",
                                "sense_id": "22b8b4e8-2003-3edf-848d-3a4f6e2f618d",
                                "text": "Ebel kommt und geht."
                            },
                            {
                                "example_id": "beba07db-3efa-4feb-bef1-b063b746b7eb",
                                "sense_id": "22b8b4e8-2003-3edf-848d-3a4f6e2f618d",
                                "text": "Ebels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
