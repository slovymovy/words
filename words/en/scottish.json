                                "target_lang_sense_clarification": "指代苏格兰地区的英语方言"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09d4d121-b1ee-3e15-81c3-58c4dc823d85",
                    "sense_definition": "A short form of <w>Scottish Gaelic</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "language",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "He is learning to speak <w>Scottish</w> to connect with his heritage.",
                            "target_lang_translations": {
                                "ru": "Он учится говорить на <w>шотландском</w>, чтобы приобщиться к своему наследию.",
                                "zh": "他正在学习说<w>苏格兰盖尔语</w>，以传承他的文化遗产。"
                            }
