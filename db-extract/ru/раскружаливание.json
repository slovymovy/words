                                            {
                                                "example_id": "0a7c92ba-0920-43d6-b7c0-e150484049f1",
                                                "sense_id": "bd823699-09e5-3eca-aded-8f90ded58e01",
                                                "text": "Er hat seine Ausrüstung dabei."
                                            },
                                            {
                                                "example_id": "2d28223a-9014-4fcf-b58a-17ce4f37f65a",
                                                "sense_id": "bd823699-09e5-3eca-aded-8f90ded58e01",
                                                "text": "„Weickerts Leute hatten ihre Ausrüstung von drüben geholt und schliefen.“"
