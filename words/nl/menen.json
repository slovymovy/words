                    "sense_id": "af7a2452-2565-3d48-b205-a0900dd34683",
                    "sense_definition": "Serieus zijn; iets werkelijk zo bedoelen en niet als grap.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "intentie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Meen</w> je dat nou echt of maak je een grapje?",
                            "target_lang_translations": {
                                "en": "Do you really <w>mean</w> that or are you joking?",
                                "ru": "Ты действительно <w>говоришь серьезно</w> или шутишь?",
                                "pl": "<w>Mówisz</w> to naprawdę poważnie, czy żartujesz?",
                                "de": "<w>Meinst</w> du das wirklich ernst oder machst du einen Scherz?",
                                "fr": "<w>Es-tu sérieux</w> ou est-ce que tu plaisantes ?",
                                "it": "<w>Dici sul serio</w> o stai scherzando?",
                                "cs": "<w>Myslíš</w> to vážně, nebo si děláš legraci?",
                                "tr": "Bunu gerçekten <w>ciddi mi söylüyorsun</w> yoksa şaka mı yapıyorsun?",
                                "es": "¿Lo <w>dices en serio</w> o estás bromeando?",
                                "zh": "你是<w>认真</w>的吗，还是在开玩笑？"
                            }
                        },
                        {
                            "text": "Haar excuses waren duidelijk niet <w>gemeend</w>.",
                            "target_lang_translations": {
                                "en": "Her apologies were clearly not <w>sincere</w>.",
                                "ru": "Ее извинения были явно не <w>искренними</w>.",
                                "pl": "Jej przeprosiny wyraźnie nie były <w>szczere</w>.",
                                "de": "Ihre Entschuldigungen waren eindeutig nicht <w>ernst gemeint</w>.",
                                "fr": "Ses excuses n'étaient clairement pas <w>sincères</w>.",
                                "it": "Le sue scuse non erano chiaramente <w>sincere</w>.",
                                "cs": "Její omluva nebyla zjevně <w>míněna</w> upřímně.",
                                "tr": "Özürleri açıkça <w>samimi değildi</w>.",
                                "es": "Sus disculpas claramente no fueron <w>sinceras</w>.",
                                "zh": "她的道歉显然不是<w>真心</w>的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "serieus bedoelen"
                    ],
                    "common_phrases": [
                        "het goed menen",
                        "het serieus menen"
                    ],
                    "target_lang_definitions": {
                        "en": "To be serious; to really mean something and not as a joke.",
                        "ru": "Быть серьезным; действительно иметь что-то в виду, а не шутить.",
                        "pl": "Być poważnym; naprawdę coś mieć na myśli, a nie żartować.",
                        "de": "Ernst sein; etwas wirklich so meinen und nicht als Scherz.",
                        "fr": "Être sérieux ; dire quelque chose sincèrement et non pour plaisanter.",
                        "it": "Essere seri; intendere qualcosa realmente e non come uno scherzo.",
                        "cs": "Být vážný; myslet něco skutečně a ne jako vtip.",
                        "tr": "Ciddi olmak; bir şeyi şaka olarak değil, gerçekten kastetmek.",
                        "es": "Ser serio; decir algo realmente y no como una broma.",
                        "zh": "指说话或做事是认真的，不是开玩笑。"
                    },
