                                        "entry_id": "43ab85fd-b8c3-302f-80dd-a4cea8046d3e",
                                        "glosses": [
                                            "A hairstyle where the hair is pulled back and tied into a single \\\"tail\\\" which hangs down behind the head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a9d36c4-0462-4fbc-a7e6-599003dc440e",
                                                "sense_id": "116280f2-ec15-3095-a53d-d94ef000557b",
                                                "text": "The physician should evaluate for a history of tight ponytails, buns, chignons, braids, twists, weaves, cornrows, dreadlocks, sisterlocks, and hair wefts in addition to the usage of religious hair coverings."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ponytail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71853b08-7f0a-3f16-96a4-eea9a833deca",
                                        "entry_id": "f5aa39d2-61ed-37db-9fa1-d6438859d5ed",
                                        "glosses": [
                                            "To form (the hair) into a ponytail."
                                        ],
                                        "tags": [
