    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b605bbf9-9a4f-3367-b170-ec20d58ae30e",
                    "sense_definition": "niet goed bij zijn hoofd, gek of dwaas",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet wel een beetje <w>getikt</w> zijn om in dit ijskoude water te gaan zwemmen.",
                            "target_lang_translations": {
                                "en": "You must be a bit <w>crazy</w> to go swimming in this ice-cold water.",
                                "zh": "你一定有点<w>疯</w>了，才会去这种冰冷的水里游泳。"
                            }
                        },
                        {
                            "text": "Iedereen dacht dat hij helemaal <w>getikt</w> was geworden door die vreemde verhalen.",
                            "target_lang_translations": {
                                "en": "Everyone thought he had gone completely <w>nuts</w> because of those strange stories.",
                                "zh": "大家都觉得他因为那些奇怪的故事而变得完全<w>神经病</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gek",
                        "gestoord",
                        "van lotje getikt",
                        "dwaas",
                        "geschift",
                        "idioot",
                        "niet goed snik",
                        "knettergek"
                    ],
                    "antonyms": [
                        "normaal",
                        "verstandig"
                    ],
                    "common_phrases": [
                        "helemaal getikt",
                        "totaal getikt"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage for crazy"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "not right in one's head, crazy or foolish",
                        "zh": "指人精神不正常、疯狂或愚蠢"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crazy",
                                "target_lang_sense_clarification": "informal, mentally unbalanced"
                            },
                            {
                                "target_lang_word": "nuts",
                                "target_lang_sense_clarification": "informal, foolish or mad"
                            },
                            {
                                "target_lang_word": "bonkers",
                                "target_lang_sense_clarification": "informal, eccentric or crazy"
                            },
                            {
                                "target_lang_word": "cracked",
                                "target_lang_sense_clarification": "informal, slightly mad"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "疯",
                                "target_lang_sense_clarification": "形容人精神失常或行为怪异"
                            },
                            {
                                "target_lang_word": "神经病",
                                "target_lang_sense_clarification": "口语中指人行为疯狂或不可理喻"
                            },
                            {
                                "target_lang_word": "傻",
                                "target_lang_sense_clarification": "指人愚蠢或头脑不灵光"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b95bd6fe-9b09-3480-a5f8-d34f2b7b63f1",
                    "sense_definition": "met een typemachine of computer geschreven",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "writing_method",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik leverde mijn <w>getikte</w> sollicitatiebrief in bij de personeelsafdeling.",
                            "target_lang_translations": {
                                "en": "I handed in my <w>typed</w> application letter to the HR department.",
                                "zh": "我把<w>打印的</w>求职信交给了人事部门。"
                            }
                        },
                        {
                            "text": "De leraar accepteert alleen een <w>getikt</w> verslag en geen handgeschreven tekst.",
                            "target_lang_translations": {
                                "en": "The teacher only accepts a <w>typed</w> report and no handwritten text.",
                                "zh": "老师只接受<w>机打的</w>报告，不接受手写稿。"
                            }
                        }
                    ],
                    "antonyms": [
                        "handgeschreven"
                    ],
                    "common_phrases": [
                        "getikte tekst",
                        "getikte brief"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly replaced by 'getypt'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "written with a typewriter or computer",
                        "zh": "用打字机或电脑输入文字的"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "typed",
                                "target_lang_sense_clarification": "produced using a keyboard"
                            },
                            {
                                "target_lang_word": "typewritten",
                                "target_lang_sense_clarification": "specifically produced on a typewriter"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打印的",
                                "target_lang_sense_clarification": "指通过键盘输入并打印出来的文字"
                            },
                            {
                                "target_lang_word": "机打的",
                                "target_lang_sense_clarification": "强调非手写，由机器输入"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6559b9a6-2e02-3b70-83e9-d9ee1cccd5ec",
                    "sense_definition": "voltooid deelwoord van <w>tikken</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft zachtjes op het raam <w>getikt</w> om mijn aandacht te trekken.",
                            "target_lang_translations": {
                                "en": "He <w>tapped</w> gently on the window to get my attention.",
                                "zh": "他轻轻地<w>敲</w>了敲窗户以引起我的注意。"
                            }
                        },
                        {
                            "text": "De klok heeft de hele nacht hoorbaar in de gang <w>getikt</w>.",
                            "target_lang_translations": {
                                "en": "The clock <w>ticked</w> audibly in the hallway all night long.",
                                "zh": "时钟整晚在走廊里发出清晰的<w>滴答</w>声。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "op het raam getikt",
                        "op de schouder getikt"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of 'to tap' or 'to tick'",
                        "zh": "动词“轻敲”或“滴答作响”的过去分词"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tapped",
                                "target_lang_sense_clarification": "hit lightly"
                            },
                            {
                                "target_lang_word": "ticked",
                                "target_lang_sense_clarification": "made a clicking sound like a clock"
                            },
                            {
                                "target_lang_word": "knocked",
                                "target_lang_sense_clarification": "struck a surface to get attention"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敲",
                                "target_lang_sense_clarification": "指轻击物体表面"
                            },
                            {
                                "target_lang_word": "滴答",
                                "target_lang_sense_clarification": "指钟表等发出的声音"
                            }
                        ]
                    }
                }
            ]
        }
