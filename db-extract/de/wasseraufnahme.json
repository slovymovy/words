                ],
                "senses": [
                    {
                        "sense_id": "63b5db5e-189e-3a47-ab2f-4c9ef8290b58",
                        "entry_id": "63c27174-1ebe-3ff7-9fe0-35a59114904b",
                        "glosses": [
                            "Vorgang, bei dem Wasser in etwas aufgenommen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6fe0229-bd4c-4561-8a82-6511b88120fb",
                                "sense_id": "63b5db5e-189e-3a47-ab2f-4c9ef8290b58",
                                "text": "„Für die Volumenveränderungen während der Gebrauchsphase wird vornehmlich die Wasseraufnahme verantwortlich gemacht.“"
                            },
                            {
                                "example_id": "3b68b247-866d-4e1f-a56d-087cb1f38817",
                                "sense_id": "63b5db5e-189e-3a47-ab2f-4c9ef8290b58",
                                "text": "„Die Wasseraufnahme wurde bestimmt, um den Verwitterungsgrad des Materials zu ermitteln.“"
                            },
                            {
                                "example_id": "fb0472f2-636c-496d-8e35-dd23a90fbd17",
                                "sense_id": "63b5db5e-189e-3a47-ab2f-4c9ef8290b58",
                                "text": "„In der Regel ist mit der Wasseraufnahme eine größere Dehnbarkeit des Films, aber auch eine Verminderung der mechanischen Festigkeit verbunden.“"
                            },
                            {
                                "example_id": "2a98f830-7c10-4333-a861-6649c719b447",
                                "sense_id": "63b5db5e-189e-3a47-ab2f-4c9ef8290b58",
                                "text": "„Allerdings kommt es bei etwas höheren Temperaturen schon zum Schäumen, wodurch die Wasseraufnahme wieder steigt und das Raumgewicht kleiner wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
