                "senses": [
                    {
                        "sense_id": "74c5aa60-e501-3a98-bce0-1d9376a17e16",
                        "entry_id": "19f7a7e0-8b8a-3d97-97ad-e279dfe29497",
                        "glosses": [
                            "To warn in advance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d89f03cc-752e-4545-8ccd-3f5cc8c17be2",
                                "sense_id": "74c5aa60-e501-3a98-bce0-1d9376a17e16",
                                "text": "And ſure, although it was invented to eaſe his mynde of griefe, there be a number of caveats therein to forewarne other young gentlemen to foreſtand with good government their folowing yl fortunes; […]"
                            },
                            {
                                "example_id": "cc76ee51-7c8f-4eff-825d-380f965cdcda",
                                "sense_id": "74c5aa60-e501-3a98-bce0-1d9376a17e16",
                                "text": "“I came down like a wolf on the fold, didn’t I ? Why didn’t I telephone ? Strategy, my dear boy, strategy. This is a surprise attack, and I’d no wish that the garrison, forewarned, should escape.[…]”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bcd3fbca-6df7-4360-996e-ef301dc38943",
                        "source_entry_id": "19f7a7e0-8b8a-3d97-97ad-e279dfe29497",
                        "source_sense_id": "74c5aa60-e501-3a98-bce0-1d9376a17e16",
                        "source_sense_description": "to warn in advance",
                        "target_lang_word": "waarschuwen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waarschuwen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bb48da10-0522-3550-bd4d-7dcc4660c304",
                                        "entry_id": "e7c4a0a3-96ca-3768-b197-e6127f0f0beb",
                                        "glosses": [
                                            "iemand verwittigen dat er mogelijke gevaren, problemen of gevolgen zijn"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b392c558-9331-4daa-ac4f-d90bfe9ac7a3",
                                                "sense_id": "bb48da10-0522-3550-bd4d-7dcc4660c304",
                                                "text": "Hij werd gewaarschuwd dat vandalisme niet getolereerd zou worden."
                                            },
                                            {
                                                "example_id": "493a285f-7994-4413-95b1-a5267e8a701c",
                                                "sense_id": "bb48da10-0522-3550-bd4d-7dcc4660c304",
                                                "text": "Dagen achter elkaar was er niemand te bekennen, waardoor ik me nog kwetsbaarder voelde, en ik begon bij elke bocht hard te zingen om eventuele beren te waarschuwen dat ik eraan kwam."
                                            },
                                            {
                                                "example_id": "ef0bf4ce-0606-4773-8f3d-7e4aa049e6aa",
                                                "sense_id": "bb48da10-0522-3550-bd4d-7dcc4660c304",
                                                "text": "Zeebiologen waarschuwden begin vorig jaar al dat de aanhoudende recordtemperaturen van het zeewater tot grootschalige verbleking van het koraal zou leiden. Die hoge temperaturen zijn het gevolg van de klimaatverandering en het periodieke weerfenomeen El Niño, dat gepaard gaat met opwarming van het zeewater in de Stille Oceaan. De daarop volgende La Niña die op haar beurt voor afkoeling zorgt, duurde korter dan normaal, waardoor de riffen geen tijd hadden om te herstellen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdb7106c-4d3e-4fd7-a1c6-25bec3e77a44",
                        "source_entry_id": "19f7a7e0-8b8a-3d97-97ad-e279dfe29497",
                        "source_sense_id": "74c5aa60-e501-3a98-bce0-1d9376a17e16",
