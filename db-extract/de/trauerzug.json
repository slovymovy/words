                        ],
                        "form": "die Trauerzüge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "568aed1e-f5ba-3c27-9c76-bbae51ef3dc9",
                        "entry_id": "ce892e2d-7c69-3bf6-aaeb-a2cf0b4fbdaa",
                        "glosses": [
                            "Personengruppe, die eine Leiche auf ihrem letzten Weg begleitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96091d99-f6bd-40fd-a900-b059bcec90e1",
                                "sense_id": "568aed1e-f5ba-3c27-9c76-bbae51ef3dc9",
                                "text": "„Als sich am Nachmittag des 29. Juli der Trauerzug durch die Stadt schob, schienen die Bonner davon zunächst kaum Notiz zu nehmen.“"
                            },
                            {
                                "example_id": "28d91bdb-84ce-4849-9459-736c24745204",
                                "sense_id": "568aed1e-f5ba-3c27-9c76-bbae51ef3dc9",
                                "text": "„Der Trauerzug ist lang, obwohl Anna Koalik weder in Bossdom noch sonstwo Verwandte hat.“"
                            },
                            {
                                "example_id": "8b3a17da-5bb9-4f0e-8593-daf13d052d7b",
                                "sense_id": "568aed1e-f5ba-3c27-9c76-bbae51ef3dc9",
                                "text": "„Kurator und Senat der Universität empfingen den Trauerzug am Kircheneingang; der Sarg wurde auf einem Katafalk vor dem Altar aufgestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
