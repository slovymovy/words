                "senses": [
                    {
                        "sense_id": "b15f2096-626a-3a71-9063-c75f74bb2085",
                        "entry_id": "df697075-7900-3abe-adfa-03ee66e11ca5",
                        "glosses": [
                            "Mensch, der nicht ernst genommen wird"
                        ],
                        "tags": [
                            "umgangssprachlich landschaftlich",
                            "insbesondere norddeutsch & mitteldeutsch"
                        ],
                        "examples": [
                            {
                                "example_id": "bab094e0-eab9-45bb-a1f7-b8bc37ea91b0",
                                "sense_id": "b15f2096-626a-3a71-9063-c75f74bb2085",
                                "text": "Du bist vielleicht ne Flitzpiepe! Was hast du dir denn dabei gedacht?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9aeab99-8770-4411-a6f1-0baabd44d7c1",
                        "source_entry_id": "df697075-7900-3abe-adfa-03ee66e11ca5",
                        "source_sense_id": "b15f2096-626a-3a71-9063-c75f74bb2085",
                        "target_lang_word": "nitwit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nitwit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b08d83a-e744-3f08-98e7-eb01fbada80e",
                                        "entry_id": "b6cde5c8-3065-3ac5-83b1-6ca6911db751",
                                        "glosses": [
                                            "A scatterbrained or stupid person."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "392e9479-7982-4c3d-a9fb-614ffe8636df",
                                                "sense_id": "3b08d83a-e744-3f08-98e7-eb01fbada80e",
                                                "text": "If you don't remember you are a nitwit. If you do answer, well, you know what the penalty is for perjury."
                                            },
                                            {
                                                "example_id": "6b6446b2-d2b4-45e3-9ec3-c1c3f90e3106",
                                                "sense_id": "3b08d83a-e744-3f08-98e7-eb01fbada80e",
                                                "text": "\"Don't be a nitwit, honey!\" says Adele. \"Here, let me open the door! Ma be I did leave them lights on, though it ain't ike me!\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "860654bf-72f4-45f6-a7cf-03ac272cf3b0",
                        "source_entry_id": "df697075-7900-3abe-adfa-03ee66e11ca5",
                        "source_sense_id": "b15f2096-626a-3a71-9063-c75f74bb2085",
                        "target_lang_word": "birdbrain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "birdbrain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "319c9f9c-1f25-39cf-b43f-9b3d1ea5b50b",
                                        "entry_id": "d592f9fe-6624-3493-bfd7-9c42b58afeb3",
                                        "glosses": [
                                            "Someone who is not intelligent."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "065d1262-f21a-4ca2-a866-e397bbfd9ae1",
                                                "sense_id": "319c9f9c-1f25-39cf-b43f-9b3d1ea5b50b",
                                                "text": "That birdbrain just drove right through three rows of traffic cones and into the bushes."
                                            },
                                            {
                                                "example_id": "a2c6d364-6020-4b26-a343-39f439e2f8fe",
                                                "sense_id": "319c9f9c-1f25-39cf-b43f-9b3d1ea5b50b",
                                                "text": "Comedienne Carol Channing, 29, admitted that a grave personal problem had grown out of her playing the role of birdbrained Lorelei Lee in Broadway’s Gentlemen Prefer Blondes. People seemed to be convinced that she is a birdbrain offstage, too: “I won't say that people actually think I’m just two steps removed from outright idiocy, but they do seem to have adopted a protective attitude towards me...”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e9f8f63-e7bf-4bd8-86d9-f47a307231c8",
                        "source_entry_id": "df697075-7900-3abe-adfa-03ee66e11ca5",
                        "source_sense_id": "b15f2096-626a-3a71-9063-c75f74bb2085",
                        "target_lang_word": "дурак",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дурак",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "17eabad7-6779-361e-88d3-9e8776ff085b",
                                        "entry_id": "3ac19c03-a4b8-3a0d-a984-88e5789ce662",
                                        "glosses": [
                                            "разг., сниж. глупый, ограниченный, несообразительный, тупой человек; глупец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4facd414-19f3-468e-bff9-079b982b086d",
                                                "sense_id": "17eabad7-6779-361e-88d3-9e8776ff085b",
                                                "text": "Правду сказал на прошлом земском собрании граф Дублеве, что земские мосты построены для испытания умственных способностей: ежели человек объехал мост, то, стало быть, он умный, ежели же взъехал на мостик и, как водится, шею сломал, то дурак."
                                            },
                                            {
                                                "example_id": "517e7837-41f7-4400-92a9-a4ecd10b30d4",
                                                "sense_id": "17eabad7-6779-361e-88d3-9e8776ff085b",
                                                "text": "Выражение интереса немедленно исчезло с лиц присутствующих, ибо каждому было известно, что дон Сэра — знаменитый дурак и враль."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb454620-fc8b-3af8-a687-88f0b29142ce",
                                        "entry_id": "3ac19c03-a4b8-3a0d-a984-88e5789ce662",
                                        "glosses": [
                                            "разг., сниж. : глупец; недотёпа, простофиля"
                                        ],
                                        "tags": [
                                            "употребляется как порицающее или бранное слово, в том числе по отношению к самому себе"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28e7953f-b413-4e8e-8d7a-e663312605be",
                                                "sense_id": "bb454620-fc8b-3af8-a687-88f0b29142ce",
                                                "text": "— Пусть дурак, да богат, а ты и умён, да куда годен?"
                                            },
                                            {
                                                "example_id": "9a2fe95c-48e9-4b73-9667-477dc70753cf",
                                                "sense_id": "bb454620-fc8b-3af8-a687-88f0b29142ce",
                                                "text": "Это так они… притворяются для красы… Мне притворяться нечего, я — дурак… Я, брат, ничего не понимаю… я, просто, жить хочу!"
                                            },
                                            {
                                                "example_id": "c486bdf6-7b52-4d5e-9839-97cda4a848c9",
                                                "sense_id": "bb454620-fc8b-3af8-a687-88f0b29142ce",
                                                "text": "— Сижу, как дурак, и жду, а денег всё равно не заплатят."
                                            },
                                            {
                                                "example_id": "882b3117-f3e5-4b30-9d3c-47947b78bd44",
                                                "sense_id": "bb454620-fc8b-3af8-a687-88f0b29142ce",
                                                "text": "Ах, дурак, дурак, да ведь я по делу у Бакста должен был быть."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b35540d0-a253-35ec-801e-5b4fe686d710",
                                        "entry_id": "3ac19c03-a4b8-3a0d-a984-88e5789ce662",
                                        "glosses": [
                                            "разг. чудаковатый человек, отвергающий житейскую мудрость; юродивый"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f9be831-6997-34f0-a9bb-d9ea2283acfe",
                                        "entry_id": "3ac19c03-a4b8-3a0d-a984-88e5789ce662",
                                        "glosses": [
                                            "истор. придворный или домашний шут, развлекавший господ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f240a6e-30df-425a-9f29-d2a060138940",
                                                "sense_id": "0f9be831-6997-34f0-a9bb-d9ea2283acfe",
                                                "text": "Выдвигали на сцену царского дурака, и тот жаловался, кривляясь."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "дурак",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e641cb74-05cc-3aae-86b4-c80a9aedafda",
                                        "entry_id": "afde7f57-7ae1-3370-8411-5e111356d5f7",
                                        "glosses": [
                                            "разг., фам., предик. : мастер на что-либо; охотник до чего-либо; ловок на что-либо"
                                        ],
                                        "tags": [
                                            "только с отрицанием, в значении сказуемого, с инфинитивом"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00999fcb-3660-490f-ba4d-a12c2e44a15a",
                                                "sense_id": "e641cb74-05cc-3aae-86b4-c80a9aedafda",
                                                "text": "«Должно быть, и выпить не дурак, — подумал Патап Максимыч, глядя на отца игумена»."
                                            },
                                            {
                                                "example_id": "659a8c5d-a31f-452f-9ce8-328d47e7848e",
                                                "sense_id": "e641cb74-05cc-3aae-86b4-c80a9aedafda",
                                                "text": "А ваша маменька сейчас рыщет по гастрономам, и каждую добытую рыбину она поставит себе в неимоверную заслугу, а весь остальной мир в очередях стоять не любит, а пожрать не дурак!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "дурак",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ee6c70f5-dd62-3066-aaf3-74619235517d",
                                        "entry_id": "6ac122a0-6888-3d96-ba45-5e88fa9a6e68",
                                        "glosses": [
                                            "популярная карточная игра"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5084737-c9a4-4b4e-a48e-de2ad8506f3f",
                                                "sense_id": "ee6c70f5-dd62-3066-aaf3-74619235517d",
                                                "text": "В офицерском собрании играли в «дурака с Наполеоном»."
                                            },
                                            {
                                                "example_id": "c52d72b1-61fd-40df-ad0c-5079d5b1ca3d",
                                                "sense_id": "ee6c70f5-dd62-3066-aaf3-74619235517d",
                                                "text": "— А карт нету?.. Может в дурака сыграем, а?"
                                            },
                                            {
                                                "example_id": "f7590715-200c-4eea-b1d7-2baf83bd8252",
                                                "sense_id": "ee6c70f5-dd62-3066-aaf3-74619235517d",
                                                "text": "— Я ж весёлый парень, сыграем, а? В дурака, а? — Подкидного или обыкновенного?"
                                            },
                                            {
                                                "example_id": "970d1ef9-e7ad-44dc-a521-5124b9cd1f82",
                                                "sense_id": "ee6c70f5-dd62-3066-aaf3-74619235517d",
                                                "text": "Нянечки играют в «дураки», именно в «дураки», а не в «дурака»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa6b309e-0148-31a2-9a8b-33773660db42",
                                        "entry_id": "6ac122a0-6888-3d96-ba45-5e88fa9a6e68",
                                        "glosses": [
                                            "спорт. в бильярде — случайное попадание шара в лузу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0794c086-a72b-421a-988f-15d2b0edc02e",
                                                "sense_id": "fa6b309e-0148-31a2-9a8b-33773660db42",
                                                "text": "Закатить дурака."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3a32179-17f5-3a3b-8e50-25077ac05e81",
                                        "entry_id": "6ac122a0-6888-3d96-ba45-5e88fa9a6e68",
                                        "glosses": [
                                            "рассада без сердцевины, не дающая корня [Даль]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b35da82-30c6-4f36-9f17-ca36737c87d2",
                                                "sense_id": "f3a32179-17f5-3a3b-8e50-25077ac05e81",
                                                "text": "Капустный дурак."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b66f4a08-5a00-3067-b05c-8ca099843c73",
                                        "entry_id": "6ac122a0-6888-3d96-ba45-5e88fa9a6e68",
                                        "glosses": [
