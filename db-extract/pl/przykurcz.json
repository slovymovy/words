                "senses": [
                    {
                        "sense_id": "1ef56e77-b047-386a-be8b-f6323af9273b",
                        "entry_id": "772b9c15-5c0e-3c6b-9bbd-7ae392bee2b4",
                        "glosses": [
                            "zwyrodnienie mięśnia i stawu w wyniku obkurczenia włókien mięśniowych oraz więzadeł i struktur stawowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64539fde-2c43-4b90-b8ca-f34122db86e3",
                                "sense_id": "1ef56e77-b047-386a-be8b-f6323af9273b",
                                "text": "Długotrwałe utrzymywanie się przykurczu prowadzi stopniowo do utrwalenia zmian w aparacie więzadłowo-stawowym, co może uniemożliwić prawidłowe leczenie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c83137b-0228-492a-9671-10cd9bfe6a98",
                        "source_entry_id": "772b9c15-5c0e-3c6b-9bbd-7ae392bee2b4",
                        "source_sense_id": "1ef56e77-b047-386a-be8b-f6323af9273b",
                        "target_lang_word": "contracture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contracture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92fec802-fc8c-3247-b872-d596d9cbd34a",
                                        "entry_id": "a08da7c1-040d-3a36-8a2f-a5c00a8743bd",
                                        "glosses": [
                                            "An abnormal, sometimes permanent, contraction of a muscle or skin; a deformity so caused."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "852dcd7b-d84b-4011-8bfa-d864090603b7",
                                                "sense_id": "92fec802-fc8c-3247-b872-d596d9cbd34a",
                                                "text": "Even if in the initial phase of acute hand burn injury all treatment measures have been executed properly, postburn deformities still occur and are the most common cause of skin contracture in the hand. Postburn scarring and contractures affect the function as well as the aesthetic appearance of the hand and remain the most frustrating late complication of a hand burn."
                                            },
                                            {
                                                "example_id": "c9648451-feca-41f7-9530-685bd7f18610",
                                                "sense_id": "92fec802-fc8c-3247-b872-d596d9cbd34a",
                                                "text": "In general, the technique resulted in faster healing, less car formation, and less contracture than pinch grafting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d7e1ae8-4e7a-432b-baee-3f3f17ccf468",
                        "source_entry_id": "772b9c15-5c0e-3c6b-9bbd-7ae392bee2b4",
