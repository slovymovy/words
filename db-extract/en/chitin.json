{
    "word": "chitin",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f1154d10-7c1d-38c7-b59b-058a6d0707a8",
                "word": "chitin",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "40da6d47-baeb-433b-90bf-89e71b48f4fd",
                        "entry_id": "f1154d10-7c1d-38c7-b59b-058a6d0707a8",
                        "tags": [
                            "plural"
                        ],
                        "form": "chitins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "314329ef-039f-31a9-b81b-df0ee41dde33",
                        "entry_id": "f1154d10-7c1d-38c7-b59b-058a6d0707a8",
                        "glosses": [
                            "A complex polysaccharide, a polymer of N-acetylglucosamine, found in the exoskeletons of arthropods and in the cell walls of fungi; thought to be responsible for some forms of asthma in humans."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2abf7f69-701f-4340-b10f-0a1f12c0558b",
                                "sense_id": "314329ef-039f-31a9-b81b-df0ee41dde33",
                                "text": "Chitin usually occurs throughout Invertebrates in the form of an investment to the outermost cellular layer or ectoderm."
                            },
                            {
                                "example_id": "177173ec-164e-43f9-8476-00b07405e24c",
                                "sense_id": "314329ef-039f-31a9-b81b-df0ee41dde33",
                                "text": "The robot’s energy source is the sugar in the polysaccharide called chitin that makes up a fly’s exoskeleton."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "977b1959-6a55-422f-ae5a-1b9b7c428d19",
                        "source_entry_id": "f1154d10-7c1d-38c7-b59b-058a6d0707a8",
                        "source_sense_id": "314329ef-039f-31a9-b81b-df0ee41dde33",
                        "source_sense_description": "polymer of N-acetylglucosamine, found in arthropod and fungi",
                        "target_lang_word": "chitin",
