                                "target_senses": [
                                    {
                                        "sense_id": "74e00400-3028-33ba-9c13-eeaa243e004e",
                                        "entry_id": "60afb54d-2037-3d56-83de-8ecacdd5c38d",
                                        "glosses": [
                                            "An ambiguous grammatical construction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "897a8d3d-78fe-463d-8e84-9ecd947e9021",
                                                "sense_id": "74e00400-3028-33ba-9c13-eeaa243e004e",
                                                "text": "1781, Kant, \"Critique of Pure Reason,\" from John Meiklejohn 1855 translation\nWithout this reflection I should make a very unsafe use of these conceptions, and construct pretended synthetical propositions which critical reason cannot acknowledge and which are based solely upon a transcendental amphiboly, that is, upon a substitution of an object of pure understanding for a phenomenon."
                                            },
                                            {
                                                "example_id": "d440cecb-71c9-43eb-b66e-accf8e9d8800",
                                                "sense_id": "74e00400-3028-33ba-9c13-eeaa243e004e",
                                                "text": "By logical errors I mean such simple things as Equivocation, Amphiboly, and Begging the Question."
                                            },
                                            {
                                                "example_id": "2dd8bc71-66b8-4fe4-8279-f956c6cf06f4",
                                                "sense_id": "74e00400-3028-33ba-9c13-eeaa243e004e",
                                                "text": "The language might be fraught with word ambiguity or sentence amphiboly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "768d0a4a-5b39-4be8-9ea2-7d85ecbf9c35",
                        "source_entry_id": "4517cbe8-0a64-3209-bce7-e23b97129416",
                        "source_sense_id": "54579b30-2721-3dcf-b266-7b9e58bd31a8",
                        "source_sense_description": "Mehrdeutigkeit eines Ausdrucks oder einer Aussage auf Grund ihres grammatischen Aufbaus",
                        "target_lang_word": "amphibology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amphibology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10ab6a9f-d4a0-320e-a532-a0d47139ca39",
                                        "entry_id": "3d7088ca-9e3a-3260-8193-a9280f1200a1",
                                        "glosses": [
                                            "Amphiboly."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ed92c28-34b3-49e4-a842-e732b74fd568",
                                                "sense_id": "10ab6a9f-d4a0-320e-a532-a0d47139ca39",
                                                "text": "In Athens men learn'd […] to resolve a sophisticall argument, and to confound the imposture and amphibologie of words, captiously enterlaced together […]"
                                            },
                                            {
                                                "example_id": "6b4f2845-b682-4409-98b8-bfb59291814a",
                                                "sense_id": "10ab6a9f-d4a0-320e-a532-a0d47139ca39",
                                                "text": "[T]he fallacie of Æquivocation and Amphibologie, […] conclude from the ambiguity of ſome vvord, or the ambiguous ſintaxis of many put together."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d52fcda9-c3db-4d8d-8ff2-8e190dda1a42",
                        "source_entry_id": "4517cbe8-0a64-3209-bce7-e23b97129416",
                        "source_sense_id": "54579b30-2721-3dcf-b266-7b9e58bd31a8",
                        "source_sense_description": "Mehrdeutigkeit eines Ausdrucks oder einer Aussage auf Grund ihres grammatischen Aufbaus",
                        "target_lang_word": "amphibologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amphibologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "93794f6a-a8fd-30c8-9564-c7d22d651bae",
                                        "entry_id": "2ae9a038-c4c0-3931-bc7d-714f40f1fa55",
                                        "glosses": [
                                            "Arrangement des mots d’une phrase qui peut la faire interpréter en deux sens différents et même contraires."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b71b5f5f-a73c-4c3a-b782-8e0da1ed562a",
                                                "sense_id": "93794f6a-a8fd-30c8-9564-c7d22d651bae",
                                                "text": "Il y avait souvent de l’amphibologie dans les oracles."
                                            },
                                            {
                                                "example_id": "26a46aa0-3610-4b0c-aed7-7fdecf60ca41",
                                                "sense_id": "93794f6a-a8fd-30c8-9564-c7d22d651bae",
                                                "text": "Il y a dans cette phrase une amphibologie."
                                            },
                                            {
                                                "example_id": "62cfeae1-ec39-499c-99ba-6d26063c13fd",
                                                "sense_id": "93794f6a-a8fd-30c8-9564-c7d22d651bae",
                                                "text": "L’inversion produit souvent des amphibologies."
                                            },
                                            {
                                                "example_id": "d35ed629-7dfe-400d-b6ac-8b72005132ad",
                                                "sense_id": "93794f6a-a8fd-30c8-9564-c7d22d651bae",
                                                "text": "En français, des phrases comme Le chat saute sur la table., J’ai nommé mon fils Adolphe, contiennent une part d’amphibologie."
                                            },
                                            {
                                                "example_id": "18fd2894-bbda-497a-8251-92c000332b9e",
                                                "sense_id": "93794f6a-a8fd-30c8-9564-c7d22d651bae",
                                                "text": "Quoique la langue française s’énonce communément dans un ordre qui semble prévenir toute amphibologie, cependant nous n’en avons que trop d’exemples."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
