                                "example_id": "bd222ecf-80f3-450a-a7c3-eb4b850858d1",
                                "sense_id": "44bf0b2b-5c4a-3355-87db-068712729679",
                                "text": "„Der Alcalde war bereits über sechzig; als er seiner Frau zu Hilfe eilen wollte, wurde er mit einem Revolverkolben niedergeschlagen.“"
                            },
                            {
                                "example_id": "81502a86-1cdc-4b2f-90b1-e2e1fe786ef3",
                                "sense_id": "44bf0b2b-5c4a-3355-87db-068712729679",
                                "text": "„Raeseng schoss vier Mal in die gläserne Wand des Aufzugs und schlug die Scherben mit dem Revolverkolben hinaus.“"
                            }
                        ],
