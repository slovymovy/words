                "senses": [
                    {
                        "sense_id": "c1b23e16-bb06-3665-b943-712fc03478eb",
                        "entry_id": "611b43fe-c357-3afb-889a-b1f9ce6e2f80",
                        "glosses": [
                            "im Atlantischen Ozean gelegene Insel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1746b480-fa73-4e3d-b8b8-7c986f8d09e1",
                                "sense_id": "c1b23e16-bb06-3665-b943-712fc03478eb",
                                "text": "„Die größte Kegelrobbenkolonie weltweit gibt es auf der kanadischen Atlantikinsel Sable Island mit etwa 390.000 Tieren.“"
                            },
                            {
                                "example_id": "14196acf-4697-4713-bd20-eb4ae633a8b1",
                                "sense_id": "c1b23e16-bb06-3665-b943-712fc03478eb",
                                "text": "„In England, der Bretagne und auf der Atlantikinsel Madeira sorgten Schnee- und Regenfälle für zahlreiche Verkehrsstörungen, Zehntausende Haushalte waren ohne Strom.“"
                            },
                            {
                                "example_id": "af2bfab4-1a5f-46fb-9f74-021c04923cb4",
                                "sense_id": "c1b23e16-bb06-3665-b943-712fc03478eb",
                                "text": "„Später, als er auf einer Atlantikinsel viel Zeit zum Nachdenken hatte, soll er es bereut haben, Kutusow nicht verfolgt zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
