                                        "glosses": [
                                            "Falta de habilidad, talento o formación."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eef864df-3cc2-4bb3-864c-9c672ec43c8c",
                                                "sense_id": "4c35b1ca-0806-33f8-a0d8-ec1d64461870",
