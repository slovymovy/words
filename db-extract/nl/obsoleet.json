                        "cross_references": [
                            {
                                "target_word": "obsolete",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb142ec6-471f-3a4b-b00b-b09958e8638e",
                                        "entry_id": "215ba556-c617-324c-995d-d0041806151f",
                                        "glosses": [
                                            "No longer in use; gone into disuse; disused or neglected (often in favour of something newer)."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b722407-0fbc-4b72-b7ea-f538b0756682",
                                                "sense_id": "cb142ec6-471f-3a4b-b00b-b09958e8638e",
                                                "text": "Speedy, worldwide, accessible delivery of news through the Web has made newspapers obsolete."
                                            },
                                            {
                                                "example_id": "1138bc1a-3883-444a-8768-14b1820df4bb",
                                                "sense_id": "cb142ec6-471f-3a4b-b00b-b09958e8638e",
                                                "text": "Horses became obsolete means of transportation in cities in the first half of the twentieth century."
                                            },
                                            {
                                                "example_id": "9e2c6239-b557-4ce2-81e2-b6e35f83b062",
                                                "sense_id": "cb142ec6-471f-3a4b-b00b-b09958e8638e",
                                                "text": "Since the launch early last year of […] two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations. University brands built in some cases over centuries have been forced to contemplate the possibility that information technology will rapidly make their existing business model obsolete."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae080a76-afad-366d-ad2e-b661af7c0d70",
                                        "entry_id": "215ba556-c617-324c-995d-d0041806151f",
                                        "glosses": [
                                            "Imperfectly developed; not very distinct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94f90a81-19ea-435d-9019-9f8c04933c14",
                                                "sense_id": "ae080a76-afad-366d-ad2e-b661af7c0d70",
                                                "text": "These two birds somewhat closely resemble each other, but the Sedge Warbler is russet-brown above, the feathers with dark centres, the pale buff eyestripe is very clearly defined, and the underparts are buffish white; the Reed Warbler is more olive on the upper parts, the feathers having no dark centres, the underparts are more inclined to buff, and the eyestripe is nearly obsolete."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "obsolete",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4296763-f01c-32d2-a880-5538a37a5702",
                                        "entry_id": "7104a746-37f3-392f-925c-70f942a2291c",
                                        "glosses": [
                                            "To cause to become obsolete."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4557820e-4d23-42ae-b6b1-54d88008fc35",
                                                "sense_id": "b4296763-f01c-32d2-a880-5538a37a5702",
                                                "text": "This software component has been obsoleted."
                                            },
                                            {
                                                "example_id": "27e450c3-58c2-47ff-bd4c-74d1bc1c0d1e",
                                                "sense_id": "b4296763-f01c-32d2-a880-5538a37a5702",
                                                "text": "We are in the process of obsoleting this product."
                                            },
                                            {
                                                "example_id": "6c99f537-702a-404c-89cc-85d6e0af2f52",
                                                "sense_id": "b4296763-f01c-32d2-a880-5538a37a5702",
                                                "text": "Should we develop nonhuman minds that might eventually outnumber, outsmart, obsolete and replace us?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "obsolete",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe22b15c-19f1-3a0f-8ecd-1db80e00df23",
                                        "entry_id": "2d0f98e8-b5a1-3af5-8125-662949508c81",
                                        "glosses": [
                                            "An obsolete thing or person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1976900b-0e02-414a-a7eb-1fcec0198d78",
                        "source_entry_id": "18c552f9-8a78-3e9f-82be-d9d295490074",
                        "source_sense_id": "d18aff5c-e86c-34e9-837b-b100b38c9832",
                        "target_lang_word": "obsolète",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obsolète",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "275f4038-de68-34d4-ab61-27b139fe60da",
                                        "entry_id": "08b38c01-6f42-3ee3-8538-22fbe0a4ddd4",
                                        "glosses": [
                                            "Qui n’est plus utilisé, en parlant d’un mot, d’une locution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "715eb342-bf1f-4317-ada5-af5148f55113",
                                                "sense_id": "275f4038-de68-34d4-ab61-27b139fe60da",
                                                "text": "« Écornifleur » se compose du verbe « écorner » (dévaluer l’intégrité de) et du verbe obsolète « nifler », certes moins connu que son dérivé « renifler », mais de même sens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09a29e56-165c-37ae-aee6-8d005fe9c9a5",
                                        "entry_id": "08b38c01-6f42-3ee3-8538-22fbe0a4ddd4",
                                        "glosses": [
                                            "Ancien ou suranné ; qui n’est plus utilisé, qui n’a plus cours."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "193bf9d2-daae-401a-be53-e31181d69cf1",
                                                "sense_id": "09a29e56-165c-37ae-aee6-8d005fe9c9a5",
                                                "text": "Les entreprises, en particulier, risquent aujourd’hui de conserver une organisation obsolète si elles n’investissent pas sur la capacité de chacun à se poser comme porteur à part entière des projets qu’elles défendent."
                                            },
                                            {
                                                "example_id": "228662e7-c878-4d67-a0e3-3062417e00b6",
                                                "sense_id": "09a29e56-165c-37ae-aee6-8d005fe9c9a5",
                                                "text": "Et elle repose, selon le père Émile Shoufani, grec catholique, sur un concept erroné ou tout au moins obsolète : les chrétiens de Terre sainte. Un mythe."
                                            },
                                            {
                                                "example_id": "e1a2c0fc-062d-4ed8-a73b-5d5529c661b3",
                                                "sense_id": "09a29e56-165c-37ae-aee6-8d005fe9c9a5",
                                                "text": "Il est toujours possible, aujourd’hui, de dessiner et de produire des plans corrects avec une version 2000, c’est plus l’évolution de l’informatique (matériels et systèmes d’exploitation) qui rend le logiciel obsolète."
                                            },
                                            {
                                                "example_id": "457e3c52-0c71-4c9e-badb-db70f0196abf",
                                                "sense_id": "09a29e56-165c-37ae-aee6-8d005fe9c9a5",
                                                "text": "Formé sur le participe présent du latin obsolescere, le substantif obsolescence et son dérivé adjectival obsolescent sont des néologismes créés d’après l’anglais. Ils désignent tout ce qui est tombé en désuétude. Leur emprunt s’explique par le fait que l’adjectif obsolète, ayant le même sens et venu lui aussi de l’anglais d’après le latin obsoletus, a un champ d’application sémantique limité. Terme littéraire et vieilli, il se dit, non exclusivement mais surtout, de ce qui se rapporte à la langue, au vocabulaire, à la grammaire. Est obsolète ce qui est dépassé, suranné, désuet, vieillot, bref, ce qui ne fait plus partie des normes actuelles du langage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af1d1635-d303-3c07-a9f4-3348e3b20165",
                                        "entry_id": "08b38c01-6f42-3ee3-8538-22fbe0a4ddd4",
                                        "glosses": [
                                            "Peu apparent ; presque effacé."
                                        ],
                                        "tags": [
                                            "Histoire naturelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e06ef857-d433-4319-a149-22eeff6640ec",
                                                "sense_id": "af1d1635-d303-3c07-a9f4-3348e3b20165",
                                                "text": "Sur ces sillons descendent obliquement de petites côtes longitudinales obsolètes, presque effacées, et dont plusieurs individus manquent tout-à-fait."
                                            },
                                            {
                                                "example_id": "2c7dc49a-7d63-4688-a9de-33a26a9bf6be",
                                                "sense_id": "af1d1635-d303-3c07-a9f4-3348e3b20165",
                                                "text": "Dessous des inférieures d’un jaune-ochracé plus ou moins pâle, avec la bordure d’un brun pâle, précédée de deux raies maculaires plus ou moins obsolètes, de la même couleur […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
