                ],
                "senses": [
                    {
                        "sense_id": "9b9b9ea8-c798-3491-9b55-30393a6066e2",
                        "entry_id": "86ff4b24-ee07-30a0-bd9f-901fc358c226",
                        "glosses": [
                            "Maison basse et petite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff3a6afd-4ae9-496c-be22-fe64e552d6e0",
                                "sense_id": "9b9b9ea8-c798-3491-9b55-30393a6066e2",
                                "text": "Elle avait lu Paul et Virginie et elle avait rêvé la maisonnette de bambous, le nègre Domingo, le chien Fidèle."
                            },
                            {
                                "example_id": "3d4d7a6a-d90c-4218-9ca6-4f17a8707fa0",
                                "sense_id": "9b9b9ea8-c798-3491-9b55-30393a6066e2",
                                "text": "Celle-ci, mariée à un ingénieur du P.-L.-M., vivait avec ses trois enfants, dans une maisonnette que le ménage avait fait élever, après la guerre, sur un lotissement de Brunoy."
                            },
                            {
                                "example_id": "92ef4be9-4905-4d1c-8a22-d3ec4b911a64",
                                "sense_id": "9b9b9ea8-c798-3491-9b55-30393a6066e2",
                                "text": "Sur une petite colline entre Bièvres et La Ferté, non loin du couvent de Saint-Walfroy, on aperçoit une maisonnette appelée, du nom de son propriétaire, « la maison Mandelier » ."
                            },
                            {
                                "example_id": "9c5a122f-f5e6-4b3a-8240-fd64da4f1b3f",
                                "sense_id": "9b9b9ea8-c798-3491-9b55-30393a6066e2",
                                "text": "— Devant la maison il y a un gros arbre et dans cet arbre il y a une maisonnette en bois pour les petits « zozios ». Elle leur donne à manger souvent surtout en ce moment (il y a beaucoup de neige et il fait froid) […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5070a92-74ad-49b1-9e8a-f383608bb930",
                        "source_entry_id": "86ff4b24-ee07-30a0-bd9f-901fc358c226",
                        "source_sense_id": "9b9b9ea8-c798-3491-9b55-30393a6066e2",
                        "target_lang_word": "Häuschen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Häuschen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "faaee324-cb37-3e80-8fe9-67bea0b7c32f",
                                        "entry_id": "1a2be2d7-956c-3815-bdb9-9e557a1f0911",
                                        "glosses": [
                                            "kleines Haus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db3e3cde-ce78-4eb1-9654-c053fec0224d",
                                                "sense_id": "faaee324-cb37-3e80-8fe9-67bea0b7c32f",
                                                "text": "„Gegenüber am Häuschen von Radio Web - bis auf weiteres laden wir einen Akku gratis - steht ein blasses Fräulein mit einer Kappe tief ins Gesicht und scheint intensiv nachzudenken.“"
                                            },
                                            {
                                                "example_id": "0f5265fc-f734-4de1-b2fd-f33704687e43",
                                                "sense_id": "faaee324-cb37-3e80-8fe9-67bea0b7c32f",
                                                "text": "„Mein Führer brachte mich zu einem reizenden Häuschen an einer Seite des Hauptgebäudes.“"
                                            },
                                            {
                                                "example_id": "e32622a2-c55e-46df-8978-958e3a81f9bb",
                                                "sense_id": "faaee324-cb37-3e80-8fe9-67bea0b7c32f",
                                                "text": "„Das Häuschen, das mitten auf dem Olivenacker stand, war wohl eine Art Geräteschuppen.“"
                                            },
                                            {
                                                "example_id": "3fa7d870-1dc7-43ba-8b5b-b666f2bebbd7",
                                                "sense_id": "faaee324-cb37-3e80-8fe9-67bea0b7c32f",
                                                "text": "„Tobias wohnte zur Miete in einem kleinen Häuschen neben einem Kindergarten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b8f1fd7f-c770-3cef-8238-6490b46a1f0d",
                                        "entry_id": "1a2be2d7-956c-3815-bdb9-9e557a1f0911",
                                        "glosses": [
                                            "nicht im Haus gelegene, spartanische Räumlichkeit zur Verrichtung der Notdurft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd100099-bc8a-48a9-9192-f5094d7c6cdf",
                                                "sense_id": "b8f1fd7f-c770-3cef-8238-6490b46a1f0d",
                                                "text": "Es ist besser, du gehst aufs Häuschen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
