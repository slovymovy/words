                "senses": [
                    {
                        "sense_id": "4291d64b-8f33-36ae-b8c2-269aad18e525",
                        "entry_id": "e5043655-bd4b-3717-987d-b4fa435fb7db",
                        "glosses": [
                            "to get very drunk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36e810ee-62a4-48fb-930e-214ba5b8ced9",
                                "sense_id": "4291d64b-8f33-36ae-b8c2-269aad18e525",
                                "text": "— Не к чему́ мне встава́ть, — отве́тил Локонов, — всё мне опроти́вело и ста́рая жизнь, и но́вая, ничего́ не жела́ю. Мне тоже сего́дня вы́пить хо́чется, назюзю́каться. Поспеши́те, а то, чего́ до́брого, кооперати́в закро́ют. Возвраща́йтесь ми́гом сюда́. Смотри́те, не исчеза́йте.",
                                "translation": "Konstantin Vaginov",
                                "english": "Konstantin Vaginov"
                            }
                        ]
                    }
                ],
