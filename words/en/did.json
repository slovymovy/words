                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "acronym_medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The psychologist specialized in treating patients diagnosed with <w>DID</w>.",
                            "target_lang_translations": {
                                "ru": "Психолог специализировался на лечении пациентов с диагнозом <w>ДРИ</w>.",
                                "es": "El psicólogo se especializaba en tratar pacientes diagnosticados con <w>TID</w>."
                            }
                        },
                        {
                            "text": "People with <w>DID</w> may experience shifts between different personality states.",
                            "target_lang_translations": {
                                "ru": "Люди с <w>ДРИ</w> могут испытывать переключения между различными состояниями личности.",
                                "es": "Las personas con <w>TID</w> pueden experimentar cambios entre diferentes estados de personalidad."
                            }
                        }
