                    {
                        "sense_id": "f261a362-f08a-35b0-86e4-ad507bb63ff1",
                        "entry_id": "9bbc5dda-508f-33b5-8870-0455fd051c6a",
                        "glosses": [
                            "разг. ковыряя, проделать канал, отверстие в чём-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e7b2e43-0f54-42d0-bf76-0be5fa16bf11",
                                "sense_id": "f261a362-f08a-35b0-86e4-ad507bb63ff1",
                                "text": "Земля там наклонна к реке… м-да… Ежели через большую дорогу канавочку проковырять ― вода сбежит, верно!"
                            },
                            {
                                "example_id": "0775cb2a-31a4-45b3-af86-67c81f748e34",
                                "sense_id": "f261a362-f08a-35b0-86e4-ad507bb63ff1",
                                "text": "Начали стенку ножом ковырять. Проковыряли дыру…"
                            }
                        ]
                    }
