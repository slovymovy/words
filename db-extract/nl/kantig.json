                ],
                "senses": [
                    {
                        "sense_id": "ce967ab5-08b9-3271-9fb8-11034c8ebcf7",
                        "entry_id": "96cec97e-4852-3215-914d-8672303f9c90",
                        "glosses": [
                            "met veel hoeken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ae3d4e5-fce0-4a02-9f21-613aeac2fb02",
                                "sense_id": "ce967ab5-08b9-3271-9fb8-11034c8ebcf7",
                                "text": "Kasten vol identieke versies van de icosahedron (20-kantige vorm) donderen om, alsof er ooit een windhoos door het kunstenaarsatelier raasde."
                            },
                            {
                                "example_id": "5413cf50-ce3d-4dc1-9764-f65a2291df93",
                                "sense_id": "ce967ab5-08b9-3271-9fb8-11034c8ebcf7",
                                "text": "De Renegade rijdt er niet minder om. Hij stuurt zeker, zelfs met voldoende gevoel en de kantige koets blijft behoorlijk goed overeind. Bovendien duikt hij bij het remmen nauwelijks."
                            },
                            {
                                "example_id": "4b82de5e-a976-4840-931c-1779323037c9",
                                "sense_id": "ce967ab5-08b9-3271-9fb8-11034c8ebcf7",
                                "text": "De twee slachtoffers werden op hun motorjacht zwaar toegetakeld met een ‘kantig’ voorwerp. Daarna zijn ze overboord gegooid. Pas de volgende dag werden hun lichamen gevonden in het Hoendiep."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c44e7672-8d16-4bba-9538-b51ce78b77eb",
                        "source_entry_id": "96cec97e-4852-3215-914d-8672303f9c90",
                        "source_sense_id": "ce967ab5-08b9-3271-9fb8-11034c8ebcf7",
                        "target_lang_word": "rugged",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rugged",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83629a60-2d72-330b-9efd-10c84cc9d42f",
                                        "entry_id": "38438328-12c9-3e23-b813-855c510d74c6",
                                        "glosses": [
                                            "Broken into sharp or irregular points; uneven; not smooth; rough."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4af46f5d-396d-4efb-9b5e-c7578be61d33",
                                                "sense_id": "83629a60-2d72-330b-9efd-10c84cc9d42f",
                                                "text": "BY and by, after a rugged climb, we halted on the summit of a hill which commanded a far-reaching view."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96c92311-7624-33ef-ae74-6d7a44b0e271",
                                        "entry_id": "38438328-12c9-3e23-b813-855c510d74c6",
                                        "glosses": [
                                            "Not neat or regular; irregular, uneven."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9d00f48-e4ab-4b1b-badf-fb7665bc0f31",
                                                "sense_id": "96c92311-7624-33ef-ae74-6d7a44b0e271",
                                                "text": "Commercially produced yarn, such as rayon, produces a cloth with a smoother, shinier look than hand-spun cotton, but the uneven, rugged look of hand-spun cotton can be quite appealing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29d6278c-0854-30dd-b84f-75f5f3797ad9",
                                        "entry_id": "38438328-12c9-3e23-b813-855c510d74c6",
                                        "glosses": [
                                            "Rough with bristly hair; shaggy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6390043-8c22-4324-b1a2-13e8db897059",
                                                "sense_id": "29d6278c-0854-30dd-b84f-75f5f3797ad9",
                                                "text": "His hair was light and rather thin; his face strong and rugged from exposure, and his eyes narrow and observant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a826192-abe4-3167-be42-bad798c76e87",
                                        "entry_id": "38438328-12c9-3e23-b813-855c510d74c6",
                                        "glosses": [
                                            "Strong, sturdy, well-built."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57f22791-f397-488e-a53a-6340d297e614",
                                                "sense_id": "9a826192-abe4-3167-be42-bad798c76e87",
                                                "text": "Many women and men delude themselves into thinking that only the hardest and most rugged man is attractive and to many it may be the case."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a07c26f6-77b2-326f-ba3e-1c2a8559bb59",
                                        "entry_id": "38438328-12c9-3e23-b813-855c510d74c6",
                                        "glosses": [
                                            "Rocky and bare of plantlife."
                                        ],
                                        "tags": [
                                            "of land"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2ef2a0b-f4fc-42a0-b551-367814d38564",
                                                "sense_id": "a07c26f6-77b2-326f-ba3e-1c2a8559bb59",
                                                "text": "As the train wound along the river valleys through western Pennsylvania the scenery grew more rugged and the painted houses of Lancaster County gave way to dirty clapboard dwellings and shack homes clinging to the mountainside."
                                            },
                                            {
                                                "example_id": "2db356a8-eeb3-4c3c-adbe-26aa8eaed90f",
                                                "sense_id": "a07c26f6-77b2-326f-ba3e-1c2a8559bb59",
                                                "text": "Hidden within 30,000 acres of rugged private land, the ranch is cocooned by peaks and canyons in all directions."
                                            },
                                            {
                                                "example_id": "25518532-3ffd-469a-93c9-b8e00fafe138",
                                                "sense_id": "a07c26f6-77b2-326f-ba3e-1c2a8559bb59",
                                                "text": "Much of the area can be seen only by hikers who travel without trails to the higher reaches of this rugged mountain range."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4160da0-039c-35cc-bdde-4509b316192a",
                                        "entry_id": "38438328-12c9-3e23-b813-855c510d74c6",
                                        "glosses": [
                                            "Harsh; austere; hard"
                                        ],
                                        "tags": [
                                            "character"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5f13040-06f1-3a18-8d15-00d6a3f70b89",
                                        "entry_id": "38438328-12c9-3e23-b813-855c510d74c6",
                                        "glosses": [
                                            "Stormy; turbulent; tempestuous"
                                        ],
                                        "tags": [
                                            "of weather"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "934f1a92-d1fb-3fa2-89be-45b3b03e3637",
                                        "entry_id": "38438328-12c9-3e23-b813-855c510d74c6",
                                        "glosses": [
                                            "Harsh; grating; unpleasant sounding or looking"
                                        ],
                                        "tags": [
                                            "of sound"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96662b5b-8352-3a3e-a53f-0d7d1d581aab",
                                        "entry_id": "38438328-12c9-3e23-b813-855c510d74c6",
                                        "glosses": [
                                            "Sour; surly; frowning; wrinkled"
                                        ],
                                        "tags": [
                                            "of looks"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04afb919-4449-439d-a581-39f964a73292",
                                                "sense_id": "96662b5b-8352-3a3e-a53f-0d7d1d581aab",
                                                "text": "\"Ah!\" sighed the unimaginative Granby, and his honest, rugged face grew clouded. Pepper puffed in silence for a moment or two; then spoke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7d4142c-adf2-3b30-b757-9ba2f23bbb5b",
                                        "entry_id": "38438328-12c9-3e23-b813-855c510d74c6",
                                        "glosses": [
                                            "Violent; rude; boisterous"
                                        ],
                                        "tags": [
                                            "of behaviour"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "acc321de-db6f-3535-b230-2b1cd4fe284c",
                                        "entry_id": "38438328-12c9-3e23-b813-855c510d74c6",
                                        "glosses": [
                                            "Vigorous; robust; hardy"
                                        ],
                                        "tags": [
                                            "of health"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ca817c7-5598-4b3b-ae99-e3409331307c",
                                                "sense_id": "acc321de-db6f-3535-b230-2b1cd4fe284c",
                                                "text": "\"Her gaze rested for a moment on the muscular neck, heavy corded, almost bull-like, bronzed by the sun, spilling over with rugged health and strength...\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ee735c4-a77d-33f1-9c8a-163d1177cbc1",
                                        "entry_id": "38438328-12c9-3e23-b813-855c510d74c6",
                                        "glosses": [
                                            "Designed to reliably operate in harsh usage environments and conditions."
                                        ],
                                        "tags": [
                                            "of a computer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04980c38-38d5-4513-b32b-ea28d0d550cb",
                                                "sense_id": "2ee735c4-a77d-33f1-9c8a-163d1177cbc1",
                                                "text": "Psion, which supplies a range of rugged hand held computers, has lost nearly 2% after announcing a plunge into the red."
                                            }
                                        ]
                                    }
                                ]
