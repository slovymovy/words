            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "796a7d82-90ce-3f22-bc59-875ad5bcc0cf",
                    "sense_definition": "Arrogant and pretentious; smugly superior or dismissive of those perceived as socially or intellectually inferior.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had a <w>snobbish</w> attitude toward people who did not attend prestigious universities.",
                            "target_lang_translations": {
                                "zh": "她对那些没有上过名牌大学的人持有一种<w>势利的</w>态度。"
                            }
                        },
                        {
                            "text": "The restaurant was known for its <w>snobbish</w> waiters who ignored customers they deemed not wealthy enough.",
                            "target_lang_translations": {
                                "zh": "这家餐馆以其<w>势利的</w>服务员而闻名，他们对那些被认为不够富有的顾客视而不见。"
                            }
                        }
                    ],
                    "synonyms": [
                        "snobby",
                        "snobbistic",
                        "cliquish"
                    ],
                    "antonyms": [
                        "humble",
                        "unpretentious",
                        "modest"
                    ],
                    "common_phrases": [
                        "snobbish attitude",
                        "snobbish behavior"
                    ],
                    "target_lang_definitions": {
                        "zh": "势利的，自命不凡的；自以为优越而看不起在社会地位或智力水平上不如自己的人的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "势利的",
                                "target_lang_sense_clarification": "看重钱财或地位并看不起不如自己的人"
                            },
                            {
                                "target_lang_word": "自命不凡的",
                                "target_lang_sense_clarification": "自视清高，看不起他人"
                            },
                            {
                                "target_lang_word": "狗眼看人低的",
                                "target_lang_sense_clarification": "俗语，形容傲慢势利、看不起普通人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
