                                "target_senses": [
                                    {
                                        "sense_id": "292c3156-d389-3e64-a7b4-83296886f811",
                                        "entry_id": "887454e6-8894-3492-93df-cf8d4a3deedb",
                                        "glosses": [
                                            "männliches Geschlechtsorgan, ein Haut- und Muskelsack bei männlichen Säugetieren, welcher die Hoden, Nebenhoden, den Anfang des Samenleiters und das Ende des Samenstrangs enthält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4dd744b-8fda-478d-a5c4-305f2aa399ab",
                                                "sense_id": "292c3156-d389-3e64-a7b4-83296886f811",
                                                "text": "„Wie bei allen Grünmeerkatzen haben die Männchen leuchtend gefärbte Genitalien: das Skrotum ist blau und der Penis rot.“"
                                            },
                                            {
                                                "example_id": "e8de2e51-d056-4c2f-99b7-f6233df6ab92",
                                                "sense_id": "292c3156-d389-3e64-a7b4-83296886f811",
                                                "text": "„Mehr als einhundert Jahre lang waren sie im Skrotum Jüngers mit ihm durch die erschütternde Weltgeschichte geschaukelt und es bleibt eine durchweg erstaunliche Tatsache, dass seine beiden, wie man im Norddeutschen sagt, Klöten über solch einen Zeitraum ein erfolgreiches Duo bildeten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3120ba9-b9da-4626-b26b-e52605b1305f",
                        "source_entry_id": "9d07f209-309b-31dd-9cd8-f99a75d37391",
                        "source_sense_description": "the bag of the skin and muscle that contains the testicles",
                        "target_lang_word": "Hodensack",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hodensack",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e2cfc79-a354-3d91-a34d-5b727c3d54b4",
                                        "entry_id": "de7494c3-7c63-3b88-ac45-ca1558082548",
                                        "glosses": [
                                            "sackartige Hülle aus Haut und Muskeln, die die Keimdrüsen männlicher Säugetiere enthält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23f4c22a-b0e6-4166-833d-b70feb0deb51",
                                                "sense_id": "7e2cfc79-a354-3d91-a34d-5b727c3d54b4",
                                                "text": "Unter der Dusche entdeckte er einen kleinen, verdächtigen Knoten am Hodensack."
                                            },
                                            {
                                                "example_id": "d5797a30-c452-4fe8-b215-5f17640a35b8",
                                                "sense_id": "7e2cfc79-a354-3d91-a34d-5b727c3d54b4",
                                                "text": "Die Hodentemperatur wird dadurch geregelt, dass sich der Hodensack bei Kälte zusammenzieht, […]."
                                            },
                                            {
                                                "example_id": "1d8da182-c95b-4a7e-b966-ca7bc5a6d057",
                                                "sense_id": "7e2cfc79-a354-3d91-a34d-5b727c3d54b4",
                                                "text": "„Während die offenen Fenster der Bauerskirche noch immer auf Wind warteten, die Rættará in die Bucht floss und der Mond hell am Himmel stand, spürte Obram, wie sich gnadenlose Finger um seinen Hodensack legten.“"
                                            },
                                            {
                                                "example_id": "8724d79d-6dc3-4829-894f-20e7e72ff1b7",
                                                "sense_id": "7e2cfc79-a354-3d91-a34d-5b727c3d54b4",
                                                "text": "„Sein Kopf war bleischwarz, und sein Hodensack so aufgebläht, als habe er einen schweren Bruch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
