    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "77e4fc25-2754-3f82-bc6b-23f16507e6b4",
                    "sense_definition": "Processed to remove impurities or unwanted elements.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "purified",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eating too much <w>refined</w> sugar can lead to various health problems over time.",
                            "target_lang_translations": {
                                "ru": "Употребление слишком большого количества <w>рафинированного</w> сахара со временем может привести к различным проблемам со здоровьем."
                            }
                        },
                        {
                            "text": "The factory produces <w>refined</w> oil that is used for cooking and industrial purposes.",
                            "target_lang_translations": {
                                "ru": "Завод производит <w>очищенное</w> масло, которое используется в кулинарии и промышленных целях."
                            }
                        }
                    ],
                    "antonyms": [
                        "raw",
                        "crude",
                        "unprocessed"
                    ],
                    "common_phrases": [
                        "refined sugar",
                        "refined oil",
                        "refined flour"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедший обработку для удаления примесей или нежелательных элементов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рафинированный",
                                "target_lang_sense_clarification": "о сахаре, масле и т.д."
                            },
                            {
                                "target_lang_word": "очищенный",
                                "target_lang_sense_clarification": "от примесей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b5e0f44-2315-346a-86f4-ac03eb2c3ad9",
                    "sense_definition": "Having or showing good education, polite manners, and high social taste.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cultured",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was known for her <w>refined</w> manners and her ability to make everyone feel welcome.",
                            "target_lang_translations": {
                                "ru": "Она была известна своими <w>утончёнными</w> манерами и умением сделать так, чтобы каждый чувствовал себя желанным гостем."
                            }
                        },
                        {
                            "text": "The gentleman had very <w>refined</w> tastes in art and classical music.",
                            "target_lang_translations": {
                                "ru": "У джентльмена были очень <w>изысканные</w> вкусы в искусстве и классической музыке."
                            }
                        }
                    ],
                    "synonyms": [
