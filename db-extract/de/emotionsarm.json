                    }
                ],
                "senses": [
                    {
                        "sense_id": "bae50556-fe17-3107-9027-c65d7255ed06",
                        "entry_id": "af46e279-2666-3b11-b0c8-7ba1d781d9b0",
                        "glosses": [
                            "wenig Emotionen und Gefühle aufweisend, zeigend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d63f1a6b-8d8f-4518-a777-8c8e41f69a18",
                                "sense_id": "bae50556-fe17-3107-9027-c65d7255ed06",
                                "text": "„Wahrscheinlich war der Kerl genauso emotionsarm wie er selbst.“"
                            },
                            {
                                "example_id": "253ccbe0-2625-4ee0-b3e5-cf8cbd58a11b",
                                "sense_id": "bae50556-fe17-3107-9027-c65d7255ed06",
                                "text": "„Die kurzen Beziehungen unseres Lebens waren rückblickend sehr emotionsarm gewesen.“"
                            },
                            {
                                "example_id": "322946f2-3bc9-4592-bb1c-c89e6c30d60c",
                                "sense_id": "bae50556-fe17-3107-9027-c65d7255ed06",
                                "text": "„Häufig zeigt er wenig Interesse an politischen oder kulturellen Fragen, er ist emotionsarm, ichbezogen und materialistisch eingestellt.“"
                            },
                            {
                                "example_id": "486a6e56-221a-4dfe-b9b4-8af01cd56f32",
                                "sense_id": "bae50556-fe17-3107-9027-c65d7255ed06",
                                "text": "„Meine Mutter mochte vielleicht eine eher emotionsarme Frau sein, aber sie liebte und verstand mich ohne Worte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": [
