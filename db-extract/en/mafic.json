                        "sense_id": "249b1fe1-8eaf-3f94-9609-22171e2b1e8d",
                        "entry_id": "ba809df8-d233-38e1-bb26-c50534823725",
                        "glosses": [
                            "Describing rocks, such as silicate minerals, magmas, and volcanic and intrusive igneous rocks, which contain relatively high concentrations of magnesium and iron."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5242a1d-a8b8-402b-b65f-af8939c6078a",
                                "sense_id": "249b1fe1-8eaf-3f94-9609-22171e2b1e8d",
                                "text": "Much of the southern half of the southeastern body is a mafic syenite, slightly more felsic than the shonkinite."
                            },
                            {
                                "example_id": "784c3cc3-c822-4d6e-a424-27caaa924504",
                                "sense_id": "249b1fe1-8eaf-3f94-9609-22171e2b1e8d",
                                "text": "As a whole, rocks of this type are referred to as mafic, because of the importance of magnesium and iron in their composition."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa48494c-9553-4327-ab45-2dc4de3d3395",
                        "source_entry_id": "ba809df8-d233-38e1-bb26-c50534823725",
                        "source_sense_id": "249b1fe1-8eaf-3f94-9609-22171e2b1e8d",
                        "source_sense_description": "describing rocks, such as silicate minerals, magmas, and volcanic and intrusive igneous rocks, which contain relatively high concentrations of magnesium and iron",
                        "target_lang_word": "mafisch",
                        "target_lang_code": "de",
