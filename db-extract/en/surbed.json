                        "glosses": [
                            "To set (a stone) edgewise, in a position different from that which it had in the quarry."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "48c59367-35d2-4f6c-9e25-43091c3e4cf7",
                                "sense_id": "5f4d82e7-9901-3c55-b1fa-0bea073cad50",
                                "text": "Do they dip or lye in piano horizontis? Whether better surbedded, in work, or laid as they grew in the bed?"
                            },
                            {
                                "example_id": "03715d7a-d71c-44c2-bcde-b20a3073fb2e",
                                "sense_id": "5f4d82e7-9901-3c55-b1fa-0bea073cad50",
                                "text": "It is a freestone, cutting in all directions; yet has something of a grain parallel with the horizon, and therefore should not be surbedded."
                            },
                            {
                                "example_id": "09e0e45f-15ae-433d-95bf-7a18ddb71368",
                                "sense_id": "5f4d82e7-9901-3c55-b1fa-0bea073cad50",
                                "text": "400mm wide X 200mm thick, bedded and jointed in 1:3:12 white cement:lime:sand mortar, all stones to be free of quarry sap and not laid surbedded."
                            }
                        ]
