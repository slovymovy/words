                    {
                        "sense_id": "40cb64fd-d3fd-3654-b5ed-3813ab00815d",
                        "entry_id": "eb6c9bad-e81c-34c0-abe6-de6dcfe7a553",
                        "glosses": [
                            "der Zeitpunkt, an dem der Mond über dem Horizont erscheint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f92d696-8000-449d-b868-3edba377caaf",
                                "sense_id": "40cb64fd-d3fd-3654-b5ed-3813ab00815d",
