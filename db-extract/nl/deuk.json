                        "sense_id": "598db531-06f6-3d1c-b990-f989a35c8b82",
                        "entry_id": "4427850e-cf94-3c8c-9d78-9b96b174a416",
                        "glosses": [
                            "vervorming van het oppervlak van een voorwerp in de vorm van een put of uitholling, meest veroorzaakt door botsing met een ander voorwerp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76d5a10a-f35b-4032-bb24-133edcc7fee4",
                                "sense_id": "598db531-06f6-3d1c-b990-f989a35c8b82",
                                "text": "Dat auto-ongeluk veroorzaakte gelukkig alleen een paar deukjes."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf351e45-be9a-36cc-b7dc-b93c948d59c2",
                        "entry_id": "4427850e-cf94-3c8c-9d78-9b96b174a416",
                        "glosses": [
                            "psychologische schade"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e2460add-f968-4ff5-81df-e36b1fe544f2",
                                "sense_id": "bf351e45-be9a-36cc-b7dc-b93c948d59c2",
                                "text": "Door die nederlaag liep zijn eigendunk een flinke deuk op."
                            },
                            {
                                "example_id": "c97a7cae-64cb-4bf6-9585-b6e44c49a5f1",
                                "sense_id": "bf351e45-be9a-36cc-b7dc-b93c948d59c2",
                                "text": "De abrupte overgang van de woestijn naar de hoge Sierra kwam onverwacht hard aan. Drie dagen na het verlaten van Kennedy Meadows was ik Mount Whitney op geklommen waar ik een nacht in het noodweer op de top moest doorbrengen. Dit zware weer had voor een flinke deuk in mijn zelfvertrouwen gezorgd en had duidelijk sporen bij me achtergelaten."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc2fc31c-232d-39e5-acbe-6904a9bd8156",
                        "entry_id": "4427850e-cf94-3c8c-9d78-9b96b174a416",
                        "glosses": [
                            "een slappe lach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5020b360-5ca5-4a74-ac18-87ac670fee42",
                                "sense_id": "bc2fc31c-232d-39e5-acbe-6904a9bd8156",
                                "text": "Toen ik dat hoorde, lag ik in een deuk!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
