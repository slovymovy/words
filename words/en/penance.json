    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "34286ff9-9000-37f8-93f2-85cc806d2c3c",
                    "sense_definition": "A voluntary self-imposed punishment for a sinful act or wrongdoing, intended to serve as reparation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He performed a harsh <w>penance</w> for his past mistakes."
                        },
                        {
                            "text": "The monk accepted his <w>penance</w> with quiet humility."
                        }
                    ],
                    "synonyms": [
                        "penitence",
                        "atonement"
                    ],
                    "common_phrases": [
                        "do penance"
                    ]
                },
                {
                    "sense_id": "ed4f7025-dcc7-305c-82a9-e5add86d86c0",
                    "sense_definition": "The act of feeling or expressing sincere regret or remorse for one's wrongdoing.",
