                    "frequency": "Middle",
                    "semantic_group_id": "behauptung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Zeuge <w>will</w> den Täter gestern am Bahnhof gesehen haben."
                        },
                        {
                            "text": "Er <w>will</w> von den geheimen Absprachen überhaupt nichts gewusst haben."
                        }
                    ],
                    "synonyms": [
                        "behaupten"
                    ],
                    "common_phrases": [
