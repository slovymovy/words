                ],
                "senses": [
                    {
                        "sense_id": "96467d4a-30f0-3453-b954-c923ad8bc2e4",
                        "entry_id": "43ca9e41-e503-3047-a206-730e4fe709b4",
                        "glosses": [
                            "meist (oft jährlich stattfindende) Ausstellung für Bücher"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec154916-db31-47b5-ba11-b80eebaff08c",
                                "sense_id": "96467d4a-30f0-3453-b954-c923ad8bc2e4",
                                "text": "Am Abend eröffnet die Leipziger Buchmesse."
                            },
                            {
                                "example_id": "c0e728b8-5149-4626-adaa-e93a3d5e28e3",
                                "sense_id": "96467d4a-30f0-3453-b954-c923ad8bc2e4",
                                "text": "In diesem Jahr war Japan Gastland der Frankfurter Buchmesse."
                            },
                            {
                                "example_id": "9784ce56-7779-4488-a354-c4d84a28427e",
                                "sense_id": "96467d4a-30f0-3453-b954-c923ad8bc2e4",
                                "text": "Auf der Buchmesse treffen sich Autoren, Verleger, Lektoren und Leser."
                            },
                            {
                                "example_id": "ba91cbd7-52df-4f03-9481-ba54a94461a4",
                                "sense_id": "96467d4a-30f0-3453-b954-c923ad8bc2e4",
                                "text": "„Wie praktisch, dass es im Oktober die Frankfurter Buchmesse gibt und wir da ohnehin hinfahren müssen.“"
                            },
                            {
                                "example_id": "dde2d1b1-6c8e-467d-92ca-01fdc4a364d2",
                                "sense_id": "96467d4a-30f0-3453-b954-c923ad8bc2e4",
                                "text": "„Die Buchmesse Frankfurt, die als größte der Welt gilt, lädt jährlich ein Gastland ein, für 2014 Finnland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
