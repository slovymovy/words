                        "sense_id": "d347dc5f-e1cb-39c2-9e4a-998d108214d5",
                        "entry_id": "8969fbb3-b145-38b4-b0f6-f1c0e8c91099",
                        "glosses": [
                            "rózga do wymierzania kar cielesnych dzieciom"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "fc28eef4-746b-4d13-8b4b-df701d586a52",
                                "sense_id": "d347dc5f-e1cb-39c2-9e4a-998d108214d5",
                                "text": "Za mego czasu korektor był jeszcze żywem wspomnieniem, a klasyczna feruła skórzana odgrywała zaszczytnie swą straszliwą rolę."
                            },
                            {
                                "example_id": "0a403fb4-edaa-43b5-910d-c1b333c7401f",
                                "sense_id": "d347dc5f-e1cb-39c2-9e4a-998d108214d5",
                                "text": "Ordyński po prostu z pod feruły dyrektorskiej poszedł do szkół, i skończył nauki nie objawiając nadzwyczajnych talentów, ale też nigdzie niebędąc ostatnim."
                            }
                        ],
