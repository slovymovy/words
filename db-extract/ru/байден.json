                                        "sense_id": "63c67cf4-14a7-3e71-9113-0e2caa00e8dd",
                                        "entry_id": "758b31e8-97f9-3f6b-b9c6-34fc4e2c8faa",
                                        "glosses": [
                                            "A surname.",
                                            "Joe Biden, 46th president of the United States (2021–2025)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff757461-5179-499e-9f2d-79280e4c6a8a",
                                                "sense_id": "63c67cf4-14a7-3e71-9113-0e2caa00e8dd",
                                                "text": "Heading into 2016 and 2020, if you told the hotshots from Obamaworld that you thought Biden would be a good candidate, they would uniformly offer a look of infinite patience, tolerance and condescension and say something like, “Well, I could understand how someone would think that.”"
