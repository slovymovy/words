                        "word": "crâneur"
                    }
                ]
            },
            {
                "entry_id": "620b4494-09f3-3621-8834-949de1e7ece0",
                "word": "frimeur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a00e1ba5-3e39-4998-bae0-37c27d6f71b6",
                        "entry_id": "620b4494-09f3-3621-8834-949de1e7ece0",
                        "tags": [
                            "plural"
                        ],
                        "form": "frimeurs"
                    },
                    {
                        "form_id": "a2cfc278-f705-4bcf-856a-66c840ede591",
                        "entry_id": "620b4494-09f3-3621-8834-949de1e7ece0",
                        "tags": [
                            "feminine"
                        ],
                        "form": "frimeuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c08b549b-4139-3dea-b8dd-0968ea161072",
                        "entry_id": "620b4494-09f3-3621-8834-949de1e7ece0",
                        "glosses": [
                            "Personne qui frime ou qui crâne ; prétentieux."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "b2335f86-744f-4649-8127-6490a9d39286",
                                "sense_id": "c08b549b-4139-3dea-b8dd-0968ea161072",
                                "text": "Les m'as-tu-vu se recrutent dans toutes les classes. Inconnus on les appelle des frimeurs. Connus ils portent le nom de vedettes. La démarche des frimeurs vise essentiellement à accéder au vedettariat. […]. Pour être pris en considération le frimeur recourt aux signes extérieurs ambulatoires comme l'automobile et aux signes extérieurs fixes comme la maison, le fin du fin consistant à faire stationner une automobile très puissante devant une maison très chère puisque l'impact de la frime se mesure a l'importance des capitaux investis."
                            },
                            {
                                "example_id": "0a041660-3b00-4cd5-98f2-8046b9125096",
                                "sense_id": "c08b549b-4139-3dea-b8dd-0968ea161072",
                                "text": "Suivirent des frimeuses téléphonant, des cadres sportifs, des exhibeurs de pectoraux, des enfants aux sourcils froncés d'inquiétude que leurs pères tenaient par la main, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff1fb4c1-f0b3-46ca-86ae-1f8beb23e24d",
                        "source_entry_id": "620b4494-09f3-3621-8834-949de1e7ece0",
                        "source_sense_id": "c08b549b-4139-3dea-b8dd-0968ea161072",
                        "target_lang_word": "Angeber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angeber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e33aca7-15d0-37ed-99b2-30e3e3b9a7cf",
                                        "entry_id": "b03214ad-0a3e-3a7f-b121-356a75e57dd9",
                                        "glosses": [
                                            "Person, die ihre eigenen Leistungen freiwillig und unaufgefordert in den Vordergrund stellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc20af85-5b39-44ce-8343-6ce74b2d85b1",
                                                "sense_id": "7e33aca7-15d0-37ed-99b2-30e3e3b9a7cf",
                                                "text": "So ein Angeber hat mir gerade noch gefehlt!"
                                            },
                                            {
                                                "example_id": "dc28ff32-0070-4ae4-94ab-be55c7faa319",
                                                "sense_id": "7e33aca7-15d0-37ed-99b2-30e3e3b9a7cf",
                                                "text": "„Das Achtergewicht liegt nicht selten bei einem Amerikaner, der im Witz oft die Rolle eines übertrumpfungssüchtigen Angebers spielt, der alles noch schöner, noch größer und noch praktischer besitzt als sein Gegenüber aus der alten Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "699d682a-80e1-4753-93e4-0b5f01b718a0",
                        "source_entry_id": "620b4494-09f3-3621-8834-949de1e7ece0",
                        "source_sense_id": "c08b549b-4139-3dea-b8dd-0968ea161072",
                        "target_lang_word": "show-off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "show-off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d348d115-a0f4-37d0-a2d2-23b617372f21",
                                        "entry_id": "ba9cab3a-d8fe-3b35-8956-0349f2eed8c4",
                                        "glosses": [
                                            "One who shows off; a person given to egotistically demonstrating their prowess or ability."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28745b27-9973-467a-ae25-1882516dce7b",
                                                "sense_id": "d348d115-a0f4-37d0-a2d2-23b617372f21",
                                                "text": "Quit being such a show-off, before someone gets hurt."
                                            },
                                            {
                                                "example_id": "a8055650-3827-445a-b20b-cacf944fff6f",
                                                "sense_id": "d348d115-a0f4-37d0-a2d2-23b617372f21",
                                                "text": "“Don’t tell me what to do, you double-crossing little show-off!” he grated. “Here, stand aside there, and let a man pass.”"
                                            },
                                            {
                                                "example_id": "8ffda4ea-a9fb-4f2c-8c57-7142f540c7fb",
                                                "sense_id": "d348d115-a0f4-37d0-a2d2-23b617372f21",
                                                "text": "He was still a tad disgruntled about being used as a work-horse, but he allowed this feeling to be repressed in favor of the pomp and circumstance of the parade. He was, after all, a bit of a show-off when he could get away with it. And that is a real understatement!"
                                            },
                                            {
                                                "example_id": "2127bd20-1a9a-415c-930f-5524634742ec",
                                                "sense_id": "d348d115-a0f4-37d0-a2d2-23b617372f21",
                                                "text": "Totally obsessive fans are a good measure of a ride’s popularity, but they’re kind of a pain in the ass, too. They lipsynch the soundtrack, cadge souvenirs and pester you with smarmy, show-off questions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5cbd05a-b94a-4e25-a210-063d2be1c0a3",
                        "source_entry_id": "620b4494-09f3-3621-8834-949de1e7ece0",
                        "source_sense_id": "c08b549b-4139-3dea-b8dd-0968ea161072",
                        "target_lang_word": "braggart",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "braggart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51a5f380-8ed2-363d-a1a6-c1b7b4e7f874",
                                        "entry_id": "d4263855-a5b4-3026-8f30-e680ffd76e90",
                                        "glosses": [
                                            "Someone who constantly brags or boasts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45ee1c6c-31ca-432b-a027-b58643e30774",
                                                "sense_id": "51a5f380-8ed2-363d-a1a6-c1b7b4e7f874",
                                                "text": "O I could play the woman with mine eyes, / And Braggart with my tongue."
                                            },
                                            {
                                                "example_id": "8c28d36b-c048-4b66-bfc6-354dfea54a86",
                                                "sense_id": "51a5f380-8ed2-363d-a1a6-c1b7b4e7f874",
                                                "text": "Shallow water gives a great splash, and so a braggart has ever been contemptible in my eyes."
                                            },
                                            {
                                                "example_id": "a0252817-6318-4df5-bf66-61e17cd51ecd",
                                                "sense_id": "51a5f380-8ed2-363d-a1a6-c1b7b4e7f874",
                                                "text": "A very good resolve to make and keep, if you would also keep any friends you make, is never to speak of anyone without, in imagination, having them overhear what you say. One often hears the exclamation “I would say it to her face!” At least be very sure that this is true, and not a braggart’s phrase and then—nine times out of ten think better of it and refrain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "braggart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "336ff6e6-9f5d-308e-9dcd-607807d12863",
                                        "entry_id": "861e2e01-a1f5-3da6-9ac2-773aa61cf329",
                                        "glosses": [
                                            "Characterized by boasting; boastful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c1db0ef-a178-4608-a7ea-1eb19c556420",
                                                "sense_id": "336ff6e6-9f5d-308e-9dcd-607807d12863",
                                                "text": "O my fair Mistress, Truth! Shall I quit thee, / For huffing, braggart, puft Nobility?"
                                            },
                                            {
                                                "example_id": "ebb6c33c-8136-4fda-81ff-ca2f33315b95",
                                                "sense_id": "336ff6e6-9f5d-308e-9dcd-607807d12863",
                                                "text": "Captain [Benjamin] Bonneville was delighted with the game look of these cavaliers of the mountains, welcomed them heartily to his camp, and ordered a free allowance of grog to regale them, which soon put them in the most braggart spirits."
                                            },
                                            {
                                                "example_id": "22616bb0-e631-4830-8ad3-c9cdce94b965",
                                                "sense_id": "336ff6e6-9f5d-308e-9dcd-607807d12863",
                                                "text": "He took him on the long walks of which he was fond, and made him in some sort his humble confidant, talking to him of himself and his plans with large and braggart vagueness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
