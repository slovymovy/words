                                "target_lang_sense_clarification": "variety or type"
                            },
                            {
                                "target_lang_word": "type",
                                "target_lang_sense_clarification": "category or class of something"
                            },
                            {
                                "target_lang_word": "branch",
                                "target_lang_sense_clarification": "specialized division or arm, as of military forces"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8831f568-6ee7-3189-8bde-afd2ec94305e",
                    "sense_definition": "Таксономическая категория в биологии, объединяющая близкие виды.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Биологический <w>род</w> включает в себя несколько родственных видов животных.",
                            "target_lang_translations": {
                                "en": "A biological <w>genus</w> includes several related animal species."
                            }
                        },
                        {
                            "text": "Учёные решили выделить этот вид в отдельный <w>род</w> на основе генетических данных.",
                            "target_lang_translations": {
                                "en": "Scientists decided to separate this species into a distinct <w>genus</w> based on genetic data."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A taxonomic category in biology ranking below family and above species."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "genus",
                                "target_lang_sense_clarification": "biological taxonomic category"
                            }
                        ]
                    }
                }
            ]
