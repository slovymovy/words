                    "sense_definition": "Extremely good or impressive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_positive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That basketball player's dunk was absolutely <w>stupid</w>.",
