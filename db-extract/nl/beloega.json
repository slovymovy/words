                        "source_sense_description": "tandwalvis die doorgaans bij volwassenheid melkwit van kleur is, Delphinapterus leucas",
                        "target_lang_word": "white whale",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "white whale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a59d023-ddf7-3c4e-9e0f-5ee75b15caea",
                                        "entry_id": "5b82d044-e9d3-31b2-971e-8b6f1fef1144",
                                        "glosses": [
                                            "Synonym of beluga (“the beluga whale (Delphinapterus leucas), a cetacean found in the Arctic Ocean”)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0508d181-4a44-4969-afac-ca9c4d705a9c",
                                                "sense_id": "1a59d023-ddf7-3c4e-9e0f-5ee75b15caea",
                                                "text": "The English called the beluga the \"white whale\", a name often still used (and not to be confused with the white whale of Moby-Dick, which was an albino sperm whale)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c59f13c9-858c-32f5-867f-445b9453901f",
                                        "entry_id": "5b82d044-e9d3-31b2-971e-8b6f1fef1144",
                                        "glosses": [
                                            "Any whale of the family Monodontidae, which comprises the beluga whales and narwhals (Monodon monoceros), and some extinct species."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9df4fb41-ed2a-35f9-bf83-59f4c31564f5",
                                        "entry_id": "5b82d044-e9d3-31b2-971e-8b6f1fef1144",
                                        "glosses": [
                                            "An obsession, a monomania."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fead51d-5b9b-4d87-8db7-d6b677f83fc9",
                                                "sense_id": "9df4fb41-ed2a-35f9-bf83-59f4c31564f5",
                                                "text": "No … no sapphires. It looks like Lester Velasquez was chasing his white whale. There never were any sapphires inside that diner."
                                            },
                                            {
                                                "example_id": "e191eba0-d6ad-4c63-a0f4-5f2c82ea297b",
                                                "sense_id": "9df4fb41-ed2a-35f9-bf83-59f4c31564f5",
                                                "text": "For nearly four years, Snapchat has been Facebook’s white whale."
                                            },
                                            {
                                                "example_id": "1ff9db62-9395-4ae4-a066-d1e742fce7ea",
                                                "sense_id": "9df4fb41-ed2a-35f9-bf83-59f4c31564f5",
                                                "text": "After being lofted into space by a Falcon Super Heavy, his next rocket, the Starship, will light out for the moon, land there, take off and return to Earth, with no stages expended on the lunar journey. This so-called single-stage-to-orbit model has been the white whale of rocket designers for generations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5596e7cf-2d6a-31fa-81b2-80148ec422f5",
                                        "entry_id": "5b82d044-e9d3-31b2-971e-8b6f1fef1144",
                                        "glosses": [
                                            "A printing plate, used to manufacture a particular sports card, that is then issued as a collectible itself."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
