                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "75d87dac-e4c7-31ab-b8d4-989126c9cfe8",
                        "entry_id": "89bcf4e0-aa57-3de7-8bae-7995e6dd9b8d",
                        "glosses": [
                            "Infanterist"
                        ],
                        "tags": [
                            "humorous",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "0a4482dc-47d4-4cb2-b80a-bd90d92c9c25",
                                "sense_id": "75d87dac-e4c7-31ab-b8d4-989126c9cfe8",
                                "text": "„Wir lernten uns wie echte ‚Stoppelhopser‘, so wurden die Infanteristen auch genannt, zu bewegen, wurden am MG 34 gedrillt, bis wir es im Schlaf auseinandernehmen und wieder zusammensetzen konnten, lernten Angriff und Verteidigung als Infanteristen, bekamen Infanteriegeschütze an die Hand, die waren uns am schnellsten vertraut, gingen mit verschiedenen Panzerabwehrkanonen um, mit Minen, verschiedenen Handfeuerwaffen und mußten mit scharfer Munition schießen, schießen und nochmals schießen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e18981c0-9f5f-33eb-95de-281dfe683a78",
                        "entry_id": "89bcf4e0-aa57-3de7-8bae-7995e6dd9b8d",
                        "glosses": [
                            "kleiner Junge, der einen Bürstenhaarschnitt oder eine Igelfrisur hat"
                        ],
                        "tags": [
                            "veraltet (1950er Jahre)"
                        ],
                        "examples": [
                            {
                                "example_id": "38971858-cb3f-4ccf-b496-56a9c929c128",
                                "sense_id": "e18981c0-9f5f-33eb-95de-281dfe683a78",
                                "text": "„Werner, du hast ja die Haare ab! Jetzt bist du ein kleiner Stoppelhopser!“, rief die Oma ihrem Enkel schon von Weitem zu."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
