                ],
                "senses": [
                    {
                        "sense_id": "e0c3cace-19bf-328c-ab5f-195d5caabf0e",
                        "entry_id": "a617239d-42ab-36c8-89ac-2f75d82ec8af",
                        "glosses": [
                            "Construire une haie en entrelaçant les tiges d’un végétal (arbre, arbuste, etc), et/ou ses branches."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "947eaa89-4ac2-468d-994a-e24de96c338f",
                                "sense_id": "e0c3cace-19bf-328c-ab5f-195d5caabf0e",
                                "text": "Si la haie a été préalablement préparée (défrouillée), sur un bon rythme, on peut plécher environ 80 mètres dans la journée."
                            },
                            {
                                "example_id": "12231871-0360-463e-85b4-8342215ae57e",
                                "sense_id": "e0c3cace-19bf-328c-ab5f-195d5caabf0e",
                                "text": "Savez-vous plécher ?"
                            },
                            {
                                "example_id": "b10e4f4d-ff32-46c0-932e-f264b533e16d",
                                "sense_id": "e0c3cace-19bf-328c-ab5f-195d5caabf0e",
                                "text": "On voulait que les agents sachent plécher au moins pour les parcelles communales."
                            },
                            {
                                "example_id": "bed345db-3ebe-41d0-9266-73644421b920",
                                "sense_id": "e0c3cace-19bf-328c-ab5f-195d5caabf0e",
                                "text": "Le terme plesser (plécher) signifie, en dérivant de plier (ployer, fléchir, courber), coucher des tiges, des branches d’arbre au moyen de la serpe ou de la cognée pour former des clôtures."
                            }
                        ]
                    }
