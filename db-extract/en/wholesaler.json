            {
                "entry_id": "661a672c-5a97-363d-9755-2a325dc08faf",
                "word": "wholesaler",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0d3ec444-1b14-408f-8d80-1824f314942d",
                        "entry_id": "661a672c-5a97-363d-9755-2a325dc08faf",
                        "tags": [
