                "senses": [
                    {
                        "sense_id": "352adb56-66fb-3754-9982-cad1ea828ad4",
                        "entry_id": "5367d92a-8d1c-33f7-9512-b0a098f93a9e",
                        "glosses": [
                            "strook met bomen en struiken die men gebruikt voor de productie van (brand)hout en als afscheiding van landbouwpercelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c83e7653-02f5-4256-8041-00806f5af5e6",
                                "sense_id": "352adb56-66fb-3754-9982-cad1ea828ad4",
                                "text": "Maar ook op veel andere plaatsen zijn berkenzwammen te vinden, zoals op berken die in de schaduw van andere bomen in het bos of houtwal staan of op omgezaagde bomen. En wie wel eens de open haard of kachel met berkenhout stookt, weet dat je dit hout niet lange tijd in de regen moet laten liggen want ook dan slaan de zwammen snel toe."
                            },
                            {
                                "example_id": "11cb10e8-c96a-4bff-ba48-cb9a39aaf29f",
                                "sense_id": "352adb56-66fb-3754-9982-cad1ea828ad4",
                                "text": "Het beoogde zonnepark telt ruim 81.000 zonnepanelen en moet 25 jaar lang stroom opleveren. Vanwege het karakter van de omgeving steken de zonnepanelen maximaal 2 meter boven het maaiveld uit. Rondom het park komt een open hekwerk. De aanwezige houtwal wordt versterkt, open stukken worden ingevuld met beplanting. Aan de zuidoostzijde van het park, tegen de landsgrens aan, wordt ook groen aangelegd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84466692-e92f-4752-a8bc-f965e351e292",
                        "source_entry_id": "5367d92a-8d1c-33f7-9512-b0a098f93a9e",
                        "source_sense_id": "352adb56-66fb-3754-9982-cad1ea828ad4",
                        "target_lang_word": "shelter belt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shelter belt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ed0b5a5-eee1-34dc-95fd-1fab46a044b6",
                                        "entry_id": "6e752fb4-bcb9-3ad1-b79f-f2b16c44116b",
                                        "glosses": [
                                            "Alternative form of shelterbelt."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfc0557c-e1a8-4852-905f-36e281bf6d35",
                                                "sense_id": "1ed0b5a5-eee1-34dc-95fd-1fab46a044b6",
                                                "text": "A well designed shelter belt will reduce the mean wind speeds from ground level up to the full height of the protected object (eg: house, greenhouse, agricultural crop)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a1ec0f5-28a2-4b14-acea-655084f716b5",
                        "source_entry_id": "5367d92a-8d1c-33f7-9512-b0a098f93a9e",
                        "source_sense_id": "352adb56-66fb-3754-9982-cad1ea828ad4",
                        "target_lang_word": "windbreak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "windbreak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f913bd8b-5746-3cdf-a6d5-5ef33d8394a1",
                                        "entry_id": "1591933a-f8f2-3dce-906b-79c61db63a67",
                                        "glosses": [
                                            "A hedge, fence or row of trees positioned to reduce wind damage to crops."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "362a815c-3b1f-3ef6-abaf-3423d058bb59",
                                        "entry_id": "1591933a-f8f2-3dce-906b-79c61db63a67",
                                        "glosses": [
                                            "A sheet or stack of material used to protect people or fire from wind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6085be42-aec6-4987-8367-598072573d22",
                                                "sense_id": "362a815c-3b1f-3ef6-abaf-3423d058bb59",
                                                "text": "I built my windbreak on a second-story wooden deck, as you can see above, but it would work just as well at ground level."
                                            },
                                            {
                                                "example_id": "7f3df31c-5d77-41d8-bd4d-cad960480918",
                                                "sense_id": "362a815c-3b1f-3ef6-abaf-3423d058bb59",
                                                "text": "Although Birdibil was warm in his family wungkurr or windbreak that night, lying next to a crackling fire and covered with some paperbark blankets (kawan), he had little sleep."
                                            },
                                            {
                                                "example_id": "6ae7bdfc-29b9-4dc9-803b-7f8823fe60ae",
                                                "sense_id": "362a815c-3b1f-3ef6-abaf-3423d058bb59",
                                                "text": "A wide range of materials was used for windbreaks, including rigid bark sheets inserted in sand, piles of grass or foliage, and stone walls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d00aab3-283d-3a76-89ea-869236c1588c",
                                        "entry_id": "1591933a-f8f2-3dce-906b-79c61db63a67",
                                        "glosses": [
                                            "The act of breaking wind; flatulence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8478b154-9c4f-4944-93d4-e50e41d86ffc",
                                                "sense_id": "6d00aab3-283d-3a76-89ea-869236c1588c",
                                                "text": "(chapter title for chapter on flatulence)"
                                            },
                                            {
                                                "example_id": "134f05a7-fb41-4aad-a2eb-890500225562",
                                                "sense_id": "6d00aab3-283d-3a76-89ea-869236c1588c",
                                                "text": "(see chapter title)"
                                            },
                                            {
                                                "example_id": "1658470f-b4bb-45b4-91d3-aa5da3247039",
                                                "sense_id": "6d00aab3-283d-3a76-89ea-869236c1588c",
                                                "text": "(see title)"
                                            },
                                            {
                                                "example_id": "e6c3dcd2-f50d-465f-a3f8-a6227978a914",
                                                "sense_id": "6d00aab3-283d-3a76-89ea-869236c1588c",
                                                "text": "Another of Roy's room-clearing wind breaks snapped my head back."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdd2ac1b-c20e-4dd3-8c91-9bdfad0cf993",
                        "source_entry_id": "5367d92a-8d1c-33f7-9512-b0a098f93a9e",
                        "source_sense_id": "352adb56-66fb-3754-9982-cad1ea828ad4",
                        "target_lang_word": "hedgerow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hedgerow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "204434dd-d07d-32a0-9ba6-122d5320a2ba",
                                        "entry_id": "8bd9de1e-2d59-316c-a18e-9dc8d5720f76",
                                        "glosses": [
                                            "A row of closely planted bushes or trees forming a hedge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee1c8fdf-221b-4a51-acff-c07c3d762229",
                                                "sense_id": "204434dd-d07d-32a0-9ba6-122d5320a2ba",
                                                "text": "He had a suit of summer mufti, and a broad-brimmed blue beaver hat looped with leaves broken from the hedgerows in the lanes, and a Leander scarf tucked full of flowers: loosestrife, meadowrue, orchis, ragged-robin."
                                            },
                                            {
                                                "example_id": "31c56006-c6a5-4490-adf7-f6cbadd34e9a",
                                                "sense_id": "204434dd-d07d-32a0-9ba6-122d5320a2ba",
                                                "text": "If there's a bustle in your hedgerow, don't be alarmed now, it's just a spring clean for the may queen"
                                            },
                                            {
                                                "example_id": "4431c008-44e7-4066-b8d3-39d3d71c2c6d",
                                                "sense_id": "204434dd-d07d-32a0-9ba6-122d5320a2ba",
                                                "text": "In fact, a railway lined with hedgerows and shrubs would be perfect for reliability and biodiversity. Hawthorn, for example, can take a good cut and grow back strongly, while still providing shelter for creatures and acting as a natural fence line."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
