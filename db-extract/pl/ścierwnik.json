                "senses": [
                    {
                        "sense_id": "3d64be87-5072-354b-a8a7-aa06f64962bb",
                        "entry_id": "eb6077e5-55ea-3508-b08d-fafa5e79bbfb",
                        "glosses": [
                            "gatunek dużego ptaka padlinożernego z rodziny jastrzębiowatych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87826223-dee4-4805-b33c-e88edcefafa9",
                                "sense_id": "3d64be87-5072-354b-a8a7-aa06f64962bb",
                                "text": "Ścierwnik ma ciemny dziób i żółte nogi."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0c61642-8592-4755-94ef-1f723e8dfa67",
                        "source_entry_id": "eb6077e5-55ea-3508-b08d-fafa5e79bbfb",
                        "source_sense_id": "3d64be87-5072-354b-a8a7-aa06f64962bb",
                        "target_lang_word": "Aasgeier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aasgeier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19dd0ec7-3a4f-3fdf-85f0-81ddf0974146",
                                        "entry_id": "a5251ace-abf4-3dcf-8a02-9f55706b7bb7",
                                        "glosses": [
                                            "großer Raubvogel, der sich hauptsächlich von Aas ernährt (zum Beispiel Schmutzgeier oder Gänsegeier)"
                                        ],
                                        "tags": [
                                            "Trivialname"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52982489-befc-41f0-a755-218f4471fea2",
                                                "sense_id": "19dd0ec7-3a4f-3fdf-85f0-81ddf0974146",
                                                "text": "Sie stürzten sich wie die Aasgeier auf ihr Opfer."
                                            },
                                            {
                                                "example_id": "dd9673ac-b51f-4483-96d0-cc3fb7ea7833",
                                                "sense_id": "19dd0ec7-3a4f-3fdf-85f0-81ddf0974146",
                                                "text": "„Als er die Aasgeier über dem Wrack der Virginia kreisen sah, schlug ihm das Gewissen, weil er die sterbliche Hülle des Kapitäns und des Matrosen ohne Begräbnis zurückgelassen hatte.“"
                                            },
                                            {
                                                "example_id": "8acc9858-b1f6-4b2c-a58b-8708bc2c1ca8",
                                                "sense_id": "19dd0ec7-3a4f-3fdf-85f0-81ddf0974146",
                                                "text": "„Neben dem Hause aber, auf den gewaltigen, durch die Axt des Farmers getöteten Stämmen, die noch in dem nur halb urbar gemachten Felde standen, saßen eine Unmasse Aasgeier, als ob sie entweder von ihrem Raube verscheucht wären oder diesen nur verlassen hätten, um mit dem nächsten Morgen ihr ekles Mahl wieder zu beginnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2a4734c2-9710-3bd1-a785-d892c6b70475",
                                        "entry_id": "a5251ace-abf4-3dcf-8a02-9f55706b7bb7",
                                        "glosses": [
                                            "raffgieriger Mensch"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86e4d64b-ca69-48f2-ad06-5403b39ee19b",
                                                "sense_id": "2a4734c2-9710-3bd1-a785-d892c6b70475",
                                                "text": "Paul ist manchmal wie ein Aasgeier"
                                            },
                                            {
                                                "example_id": "717f4f16-0dc9-47e9-b628-ebd2bf978766",
                                                "sense_id": "2a4734c2-9710-3bd1-a785-d892c6b70475",
                                                "text": "„Sofort wurden wir von einem Schwarm flüsternder, uns wie Aasgeier belauernder Mitgefangener umringt, die uns um Essen angingen und an unserer Kleidung zerrten.“"
                                            },
                                            {
                                                "example_id": "efad120e-57d1-4a01-8f9f-2b3f1a3d98da",
                                                "sense_id": "2a4734c2-9710-3bd1-a785-d892c6b70475",
                                                "text": "„Die Menschen bereicherten sich wie Aasgeier im Wissen, dass dieser Besitz Menschen gehörte, die nicht mehr da sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
