                                "fr": "Elle s'est comportée d'une manière très <w>digne</w> pendant la cérémonie."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deftige manieren"
                    ],
                    "target_lang_definitions": {
                        "en": "composed and dignified in one's manner of acting",
                        "fr": "Retenu, mesuré et plein de dignité dans ses manières ou sa conduite."
                    },
                    "translations": {
                        "en": [
