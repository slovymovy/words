                    {
                        "translation_id": "9f6e88a0-875f-404d-93d0-0c4d1a5316fc",
                        "source_entry_id": "59286462-d72c-3901-a0fd-006a02bd41cf",
                        "source_sense_description": "образование ионов",
                        "target_lang_word": "Ionisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ionisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "25717386-5c50-3567-8217-000f35994fe0",
                                        "entry_id": "ef436ce5-144c-3484-8e5e-fabd2a10a3fe",
                                        "glosses": [
                                            "Entfernung oder Hinzufügung eines oder mehrerer Elektronen zu einem Atom oder Molekül"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfb3530e-f24b-4661-8a7a-5d98ba7663a0",
                                                "sense_id": "25717386-5c50-3567-8217-000f35994fe0",
                                                "text": "„Bringt man ionisierte Luft zwischen entgegengesetzt geladene Konduktoren (Elektroden), so verlieren beide an Ladung, d. h. es entsteht, wenn diese fortwährend ergänzt wird und auch die Ionisierung etwa durch Einwirkung von Radiumstrahlen konstant erhalten wird, ein dauern der Strom, wie beim Einbringen der Elektroden in einen Elektrolyten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "213fb5c5-ee5b-39ba-b681-97ebc40fd998",
                                        "entry_id": "ef436ce5-144c-3484-8e5e-fabd2a10a3fe",
                                        "glosses": [
                                            "Technisches Gerät mit einem Ionisator, der die Ionisierung der Luft herbeiführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5374310b-f3f4-4b6a-aedf-07fcf5b478aa",
                                                "sense_id": "213fb5c5-ee5b-39ba-b681-97ebc40fd998",
                                                "text": "„Die Ionisierung führt insbesondere zu einer Verringerung von Küchengerüchen, indem die organischen Moleküle aus der Luft entfernt werden.“"
                                            },
                                            {
                                                "example_id": "5be7e6af-01f5-4a43-bef4-3285731770ed",
                                                "sense_id": "213fb5c5-ee5b-39ba-b681-97ebc40fd998",
                                                "text": "„Für eine Sauenaufzuchtanlage mit einer Anlage zu Ionisierung der Stallluft sollten die Belastungen der Stallluft sowie der unbehandelten und behandelten Luft erhoben werden.“"
                                            },
                                            {
                                                "example_id": "7348e7ff-1131-4e79-a526-e613024deadf",
                                                "sense_id": "213fb5c5-ee5b-39ba-b681-97ebc40fd998",
                                                "text": "„In einer Ausgestaltung hat die erfindungsgemäße Ionisierungsvorrichtung zur Ionisierung von Luft den Vorteil, dass sie elektrisch mit einer Lampenfassung verbunden werden kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc5151f9-9a69-4e9e-86fb-7b3c0b7b9eeb",
                        "source_entry_id": "59286462-d72c-3901-a0fd-006a02bd41cf",
                        "source_sense_description": "образование ионов",
                        "target_lang_word": "Ionisation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ionisation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb78bc4e-eac2-3a70-b921-c6f5c15c7830",
                                        "entry_id": "1369bba9-041d-3287-aa69-e02e4313e91e",
                                        "glosses": [
                                            "die Entfernung eines oder mehrerer Elektronen aus einem Atom oder Molekül durch Energiezufuhr oder auch deren Anlagerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6033be0-4027-49a8-8501-34dd009aa97a",
                                                "sense_id": "fb78bc4e-eac2-3a70-b921-c6f5c15c7830",
                                                "text": "Natürliche Ionisation entsteht durch kosmischen Strahlung, der Strahlung radioaktiven Stoffe, der Sonnenstrahlung oder physikalischer Natureffekte wie am Wasserfall"
                                            },
                                            {
                                                "example_id": "19d47f56-a746-4b65-8ac4-07b45646e5ad",
                                                "sense_id": "fb78bc4e-eac2-3a70-b921-c6f5c15c7830",
                                                "text": "„Unter Ionisation versteht man die Erzeugung freier Elektronen und positiv geladener Atome - also Ionen.“"
                                            },
                                            {
                                                "example_id": "2d5e974b-c06c-4c24-a443-bec8774ac57d",
                                                "sense_id": "fb78bc4e-eac2-3a70-b921-c6f5c15c7830",
                                                "text": "„Unter Ionisation versteht man den Vorgang, aus elektrisch neutralen Atomen oder Molekülen positiv und negativ geladene Teilchen, also I.-Paare zu bilden“"
                                            },
                                            {
                                                "example_id": "5a6fd9e1-1b91-4c54-bc98-0d84f859f518",
                                                "sense_id": "fb78bc4e-eac2-3a70-b921-c6f5c15c7830",
                                                "text": "„Die Ionisation auf dem elektronischem Wege erfolgt so: Nach dem Prinzip der Koronaentladung wird naszierender Sauerstoff erzeugt, d. h. die Spaltung von Sauerstoffmolekülen O2 in die beiden Sauerstoffatome O* mit pos. oder neg. Ladung, die ein erhöhtes Energie- und Ladungspotenzial aufweisen.“"
                                            },
                                            {
                                                "example_id": "757ce101-706a-4aaa-b3c3-ce215ab9f153",
                                                "sense_id": "fb78bc4e-eac2-3a70-b921-c6f5c15c7830",
                                                "text": "„Durch künstliche Ionisation […] kann die natürliche Konzentration an negativen Luftionen wiederhergestellt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
