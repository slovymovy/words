                        "examples": [
                            {
                                "example_id": "4ecfe13c-5560-4857-9cc7-e03a5ae84c46",
                                "sense_id": "97ca06b1-edd9-31e0-b2b2-24af4a3acb59",
                                "text": "Le béton de miscanthus aura bientôt toute sa gamme : bloc standard, bloc poteau, planelle isolée et éléments de chaînage horizontal."
                            },
                            {
                                "example_id": "d7e401a7-2420-4057-8846-7a20bd46ca41",
                                "sense_id": "97ca06b1-edd9-31e0-b2b2-24af4a3acb59",
                                "text": "Le miscanthus, un roseau venu d’Asie, qui peut être transformé en une pâte aux applications diverses, « 100 % biosourcée, 100 % biodégradable »."
                            }
                        ]
                    }
                ],
