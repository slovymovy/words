{
    "word_family": [
        "побуждать",
        "побудительный",
        "побудитель"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b437e3f8-dbc6-3447-bace-cd0c3c078ca7",
                    "sense_definition": "Внутреннее желание, намерение или порыв сделать что-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "мотивация",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его доброе <w>побуждение</w> помочь старику было искренним и бескорыстным.",
                            "target_lang_translations": {
                                "en": "His kind <w>impulse</w> to help the old man was sincere and selfless."
                            }
                        },
                        {
                            "text": "Он действовал по собственному <w>побуждению</w>, не дожидаясь просьб со стороны окружающих.",
                            "target_lang_translations": {
                                "en": "He acted of his own <w>accord</w>, without waiting for requests from others."
                            }
                        }
                    ],
                    "synonyms": [
                        "мотивация"
                    ],
                    "common_phrases": [
                        "по собственному побуждению",
                        "благородное побуждение",
                        "внутреннее побуждение"
                    ],
                    "target_lang_definitions": {
                        "en": "An internal desire, intention, or impulse to do something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "impulse",
                                "target_lang_sense_clarification": "a sudden strong urge to act"
                            },
                            {
                                "target_lang_word": "motive",
                                "target_lang_sense_clarification": "a reason for doing something"
                            },
                            {
                                "target_lang_word": "urge",
                                "target_lang_sense_clarification": "a strong desire or impulse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddca7370-845f-3cfd-bceb-d497c24b4824",
                    "sense_definition": "Действие по значению глагола <w>побуждать</w>; склонение кого-либо к какому-либо действию.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "стимул",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Главным фактором стало <w>побуждение</w> сотрудников к более активной работе через систему премий.",
                            "target_lang_translations": {
                                "en": "The main factor was the <w>incentive</w> for employees to work more actively through a bonus system."
                            }
                        },
                        {
                            "text": "Внешнее <w>побуждение</w> к действию часто оказывается менее эффективным, чем личная заинтересованность.",
                            "target_lang_translations": {
                                "en": "External <w>motivation</w> to act often proves less effective than personal interest."
                            }
                        }
                    ],
                    "synonyms": [
                        "мотивация"
                    ],
                    "common_phrases": [
                        "побуждение к действию"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of prompting or inducing someone to take a certain action."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "incentive",
                                "target_lang_sense_clarification": "something that motivates or encourages one to do something"
                            },
                            {
                                "target_lang_word": "inducement",
                                "target_lang_sense_clarification": "a thing that persuades or influences someone to do something"
                            },
                            {
                                "target_lang_word": "motivation",
                                "target_lang_sense_clarification": "the reason or stimulus for acting in a particular way"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}