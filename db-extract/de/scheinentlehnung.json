                "senses": [
                    {
                        "sense_id": "d8767507-aa18-333f-bdaa-709ebec9e747",
                        "entry_id": "b9bb6273-6348-3417-b6c1-a130a30fb23e",
                        "glosses": [
                            "Wort, das in einer Sprache gebildet ist, aber so geformt ist, als wäre es ein Wort einer anderen Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "776c6d37-a045-4458-a5ab-587daaf10c5e",
                                "sense_id": "d8767507-aa18-333f-bdaa-709ebec9e747",
                                "text": "„Interessant ist dann der Fall der Scheinentlehnung, bei der ein fremdsprachiges Wort aufgenommen wird, das in der Ausgangssprache gar nicht existiert.“"
                            },
                            {
                                "example_id": "48ae86ed-011b-45ac-b89c-aa18ed0877c9",
                                "sense_id": "d8767507-aa18-333f-bdaa-709ebec9e747",
                                "text": "„Ein spezieller Fall lexikalischer Transferenz ist die sogenannte Schein- oder Sekundärentlehnung (Neubildung eines Wortes in der Sprache B aus Morphemen der Sprache A): ‚Twen‘, ‚Showmaster‘, ‚Dressman‘.“"
                            },
                            {
                                "example_id": "32b3d5be-4a07-459a-a070-1d7200b78177",
                                "sense_id": "d8767507-aa18-333f-bdaa-709ebec9e747",
                                "text": "„Eine Scheinentlehnung ist eine Entlehnung aus dem Gut einer fremden Sprache, wobei die Gebersprache den scheinbar entlehnten Wert nicht bereithält.“"
                            },
                            {
                                "example_id": "880bad5a-d48d-411e-aef8-274b4e374986",
                                "sense_id": "d8767507-aa18-333f-bdaa-709ebec9e747",
                                "text": "Ein besonders bekannter Fall einer Scheinentlehnung ist das Wort »Handy«, das wie ein englisches Wort aussieht, tatsächlich aber im Englischen nicht existiert."
                            },
                            {
                                "example_id": "afb93fa3-869b-4005-a2ce-b642510c7f91",
                                "sense_id": "d8767507-aa18-333f-bdaa-709ebec9e747",
                                "text": "„Am weitaus häufigsten begegnet man der Kategorie der analogen lexikalischen Scheinentlehnung.“"
                            },
                            {
                                "example_id": "2643867a-73bc-4f13-b0ed-751e03dcbef1",
                                "sense_id": "d8767507-aa18-333f-bdaa-709ebec9e747",
                                "text": "„Die Folge des so explizierten Anglizismusbegriffs ist, dass die verbreitete Rede von Pseudoanglizismen oder Scheinentlehnungen vermieden wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
