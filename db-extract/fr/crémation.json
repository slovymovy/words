                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73931a11-1e40-45ab-b4f9-0a9dc6f6a51e",
                                                "sense_id": "106255a4-1d51-3427-8bae-5b852d620bfe",
                                                "text": "Een crematorium in Purmerend is gesloten nadat bij een crematie van een kankerpatiënt radioactieve stoffen zijn vrijgekomen"
