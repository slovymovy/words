                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb83889c-9bba-35dd-8b97-b8f1ac3dfdc5",
                                        "entry_id": "261b3d23-e7a4-3dac-93e7-991d74919041",
                                        "glosses": [
                                            "Clipping of superhive."
