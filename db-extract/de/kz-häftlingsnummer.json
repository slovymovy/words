                ],
                "senses": [
                    {
                        "sense_id": "e8955779-ed56-3547-9527-83ca34b2a812",
                        "entry_id": "7dec8227-05db-32c7-a97a-b352c3a2d9ae",
                        "glosses": [
                            "Registriernummer für einen KZ-Häftling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93e3c74f-795b-443f-8231-327e2a2728e8",
                                "sense_id": "e8955779-ed56-3547-9527-83ca34b2a812",
                                "text": "„Bei einer alten Frau sah ich am Unterarm eine eintätowierte KZ-Häftlingsnummer.“"
                            },
                            {
                                "example_id": "808888a7-873d-405b-8abe-68a6b6b25422",
                                "sense_id": "e8955779-ed56-3547-9527-83ca34b2a812",
                                "text": "Das Gelsenzentrum hat eine eintätowierte Kz-Häftlingsnummer abgebildet."
                            },
                            {
                                "example_id": "b86cb86a-f3c6-4438-877d-1fcf8030635a",
                                "sense_id": "e8955779-ed56-3547-9527-83ca34b2a812",
                                "text": "„Die auf seinem Arm eintätowierte KZ-Häftlingsnummer reicht dem Rabbiner der jüdischen Gemeinde jedoch nicht als Beweis.“"
                            },
                            {
                                "example_id": "370fd5fa-aa56-4807-845e-4fd4864c1830",
                                "sense_id": "e8955779-ed56-3547-9527-83ca34b2a812",
                                "text": "„ Walter Winter, der auf dem Arm die KZ-Häftlingsnummer 3105 trägt, war fassungslos.“"
                            },
                            {
                                "example_id": "a5639c20-a8b5-4f73-bc59-85a3b021a9da",
                                "sense_id": "e8955779-ed56-3547-9527-83ca34b2a812",
                                "text": "„Er unterschrieb seine Zeitungsartikel stets mit seiner KZ-Häftlingsnummer.“"
                            },
                            {
                                "example_id": "2dd65f86-6e43-4de6-b72c-5c237628c1c9",
                                "sense_id": "e8955779-ed56-3547-9527-83ca34b2a812",
                                "text": "„Eine Schülerin ließ sich die tätowierte KZ-Häftlingsnummer 50462 auf dem Unterarm zeigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
