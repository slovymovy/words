                                "sense_id": "8b1248d7-b1e2-310d-a819-7ae3b86ee5c8",
                                "text": "My Hound then in my Lyam, I by the Woodmans art\nForecast, where I may lodge the goodly Hie-palm'd Hart,"
                            },
                            {
                                "example_id": "95cf6b2b-0c4d-4d80-8482-bb51e074d45d",
                                "sense_id": "8b1248d7-b1e2-310d-a819-7ae3b86ee5c8",
                                "text": "Bob Munchy, as a forlorn hope, once threw his clodding leister at a drowning man, floating down the Yarrow in a high flood, and hauled him out with the lyams unharmed."
                            }
                        ]
                    }
