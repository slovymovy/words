                ],
                "senses": [
                    {
                        "sense_id": "f2b2ae1c-709c-342e-b748-433052f4116a",
                        "entry_id": "6bb984ae-7876-3bcd-8f94-8c2636949752",
                        "glosses": [
                            "flugfähiger Käfer mit meist roten, schwarz gepunkteten Flügeln"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "cfaa9be7-c267-4476-afcc-581697216c98",
                                "sense_id": "f2b2ae1c-709c-342e-b748-433052f4116a",
                                "text": "Dem Glückskäfer wird auch nachgesagt, Kinder zu beschützen und zu Kranke heilen, wenn er ihnen zufliegt."
                            },
                            {
                                "example_id": "38c1d7c1-f23f-4834-a0f7-f64708fc026b",
                                "sense_id": "f2b2ae1c-709c-342e-b748-433052f4116a",
                                "text": "Erinnert sich noch jemand daran, als kannibalische Asiatische Marienkäfer unser Land befielen und versuchten, den deutschen Glückskäfer zu vertreiben? Diese Krise scheint überwunden."
                            },
                            {
                                "example_id": "a240afc3-1327-4557-b850-b7eb37f27ce5",
                                "sense_id": "f2b2ae1c-709c-342e-b748-433052f4116a",
                                "text": "Clarissa schenkte mir zum Abschied ein rotes Herz aus Krepppapier, das eine kleine Öffnung mit einer Tür hatte. Dahinter verbarg sich ein Glückskäfer aus Schokolade."
                            },
                            {
                                "example_id": "d87acf43-1883-4f12-8a0d-8bb5af99beff",
                                "sense_id": "f2b2ae1c-709c-342e-b748-433052f4116a",
                                "text": "Die Augen des Jungen strahlten vor Freude. „Ein Glückskäfer!“ jauchzt er. Und tatsächlich hat der kleine Marienkäfer grosses Glück gebracht; denn unterdessen konnten sich seine vier Freunde auf der anderen Seite des Weges in Sicherheit bringen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8911f9e9-154c-3db8-82bf-0673e6058b6c",
                        "entry_id": "6bb984ae-7876-3bcd-8f94-8c2636949752",
                        "glosses": [
                            "Käfer, der sich vom Kot pflanzenfressender Säugetiere ernährt, sowie aus diesem Kot nach der Paarung Dungkugeln formt, die er vor sich herrollt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c4528a0c-562f-499c-a1b9-8d2e6861a853",
                                "sense_id": "8911f9e9-154c-3db8-82bf-0673e6058b6c",
                                "text": "Pünktlich zu ihrem 50. Jubiläum hat die Alexander von Humboldt-Stiftung ihren ersten eigenen Glückskäfer erhalten. Eine in Costa Rica neu entdeckte Käferart aus der Gruppe der Skarabäen erhielt den wissenschaftlichen Namen Canthon humboldti, wie die Stiftung am Montag in Bonn mitteilte."
                            },
                            {
                                "example_id": "7228ba6b-df10-417f-8c01-d0136561dd24",
                                "sense_id": "8911f9e9-154c-3db8-82bf-0673e6058b6c",
                                "text": "Das Tutanchamun-Fieber steckte in den 1920er Jahren, den Roaring Twenties, alle an: Pariser Modehäuser verzierten ihre Kreationen mit handgestickten Mustern aus dem alten Ägypten, Top-Juweliere entwarfen Diamanten-Broschen mit dem Glückskäfer Skarabäus."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca0d0721-efbd-41a5-91f8-da2b84e67aff",
                        "source_entry_id": "6bb984ae-7876-3bcd-8f94-8c2636949752",
                        "source_sense_id": "f2b2ae1c-709c-342e-b748-433052f4116a",
                        "source_sense_description": "Entomologie, umgangssprachlich: flugfähiger Käfer mit meist roten, schwarz gepunkteten Flügeln",
                        "target_lang_word": "coccinelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
