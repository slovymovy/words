                    }
                ],
                "senses": [
                    {
                        "sense_id": "af4efa78-0886-3a8e-87de-8ff820b2706c",
                        "entry_id": "55088a93-ea15-3300-8405-3e4a04c3bc4d",
                        "glosses": [
                            "mit Schotter befestigter Parkplatz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dd54dfd-dbf6-43fb-bada-e91eff975717",
                                "sense_id": "af4efa78-0886-3a8e-87de-8ff820b2706c",
                                "text": "„Ein gewundener Weg führte zu einem Schotterparkplatz.“"
                            },
                            {
                                "example_id": "0908fda2-82e4-41b0-b50e-b7b400758085",
                                "sense_id": "af4efa78-0886-3a8e-87de-8ff820b2706c",
                                "text": "„Wir haben das Ronald-McDonald-Haus verlassen, und jetzt stehen wir auf dem riesigen Schotterparkplatz neben dem Fernfahrerlokal.“"
                            },
                            {
                                "example_id": "bb7665f6-c4eb-46d7-9036-186182ca39ae",
                                "sense_id": "af4efa78-0886-3a8e-87de-8ff820b2706c",
                                "text": "„Er parkte auf dem Schotterparkplatz neben dem Schnellrestaurant, und sie gingen hinein und setzten sich an einen Tisch mit roter Decke.“"
                            },
                            {
                                "example_id": "6e7ad4ff-d437-497c-aa50-8be3a669d7e0",
                                "sense_id": "af4efa78-0886-3a8e-87de-8ff820b2706c",
                                "text": "„Auf der Lichtung erwartete ihn ein Schotterparkplatz.“"
                            },
                            {
                                "example_id": "233bb189-3882-47d7-8f84-e601c3abf443",
                                "sense_id": "af4efa78-0886-3a8e-87de-8ff820b2706c",
                                "text": "„Ich fahre weiter. Irgendwohin, wo ich schwören könnte, schon mal gewesen zu sein. Irgendwo ins Grüne, irgendwo auf einen kleinen Schotterparkplatz ohne Überwachungskameras.“"
                            },
                            {
                                "example_id": "1c3bb28c-fe53-4195-b21f-79ca72287a6a",
                                "sense_id": "af4efa78-0886-3a8e-87de-8ff820b2706c",
                                "text": "„Der Mann durchwühlte ihr ganzes Gepäck und schmiss alles Mögliche aus ihren Rucksäcken einfach auf dem Schotterparkplatz vor der Jagdlodge auf einen großen Haufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
