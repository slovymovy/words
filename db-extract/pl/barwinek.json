                "translations": [
                    {
                        "translation_id": "509affab-5776-4b8c-9701-43b45ab4bc76",
                        "source_entry_id": "8c6607c7-0d5f-3c1c-9110-cffd078145ef",
                        "source_sense_id": "4ab5f9cc-caea-3f23-98af-cd7605b72095",
                        "target_lang_word": "periwinkle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "periwinkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "670d61da-6bd6-3ed0-9b44-84e49ca29c7d",
                                        "entry_id": "07f3f004-1129-3d7c-a6e4-50d7358aeb50",
                                        "glosses": [
                                            "Any of several evergreen plants of the genus Vinca with blue or white flowers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d10ef679-56f8-47c8-adce-3bb2b811424a",
                                                "sense_id": "670d61da-6bd6-3ed0-9b44-84e49ca29c7d",
                                                "text": "The Periwinkle is a great binder, staying bleeding both at mouth and nose if some of the leaves be chewed."
                                            },
                                            {
                                                "example_id": "e7d628da-b474-4cb2-9708-c3e25dc50c01",
                                                "sense_id": "670d61da-6bd6-3ed0-9b44-84e49ca29c7d",
                                                "text": "He that vvould diſcern the rudimentall ſtroak of a plant, may behold it in the Originall of Duckvveed, at the bigneſſe of a pins point, from convenient vvater in glaſſes, vvherein a vvatchfull eye may alſo diſcover the puncticular Originals of Perivvincles and Gnats."
                                            },
                                            {
                                                "example_id": "6f5a5040-7347-4d96-9bb0-8edd67cc38e6",
                                                "sense_id": "670d61da-6bd6-3ed0-9b44-84e49ca29c7d",
                                                "text": "Among herbs that have traditionally been considered to possess aphrodisiac virtue are, maidenhair, navelwort, anemone, wild poppy, valerian, cyclamen, male fern, pansy, periwinkle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5a47403-3c6a-3480-a256-0e43d79c6d8e",
                                        "entry_id": "07f3f004-1129-3d7c-a6e4-50d7358aeb50",
                                        "glosses": [
                                            "Similar plants of genus Catharanthus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c10e7ea7-bb7b-396e-8d4d-2f083fede677",
                                        "entry_id": "07f3f004-1129-3d7c-a6e4-50d7358aeb50",
                                        "glosses": [
                                            "A color with bluish and purplish hues, somewhat light."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d196039-7a7f-4cd3-b824-8beb176b0344",
                                                "sense_id": "c10e7ea7-bb7b-396e-8d4d-2f083fede677",
                                                "text": "And although we’ve certainly seen a variety of blue shades — from periwinkle to cobalt and even Dean Cain’s indigo-washed costume from the 1990’s TV show “Lois & Clark” — Superman’s uniform is still instantly recognizable across generations. In fact, there is only one film — Zack Snyder’s 2013 “Man of Steel” — in which Superman does not wear his iconic red belted trunks."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "periwinkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cb750e0-55e2-3060-a550-fcacfec18410",
                                        "entry_id": "f2f70b35-caff-3823-a5f0-b38faaf8f04a",
                                        "glosses": [
                                            "Of pale bluish purple colour."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "periwinkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93630a18-a250-341c-87a4-dfa83a67b6e0",
                                        "entry_id": "eaec4396-73de-3e5e-97f4-3a15c5de2bf4",
                                        "glosses": [
                                            "A mollusk of family Littorinidae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2162a6f2-4b34-43ce-b50f-daf16d4920e2",
                                                "sense_id": "93630a18-a250-341c-87a4-dfa83a67b6e0",
                                                "text": "He was working a pin into a periwinkle shell, turning it to extract the toothsome morsel of meat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b2d94c9-3ce9-4244-8336-f42f2f2523d9",
                        "source_entry_id": "8c6607c7-0d5f-3c1c-9110-cffd078145ef",
                        "source_sense_id": "4ab5f9cc-caea-3f23-98af-cd7605b72095",
                        "target_lang_word": "barvínek",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f1efb8cb-cccf-440a-b401-fd9c0233e926",
                        "source_entry_id": "8c6607c7-0d5f-3c1c-9110-cffd078145ef",
                        "source_sense_id": "4ab5f9cc-caea-3f23-98af-cd7605b72095",
                        "target_lang_word": "pervenche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pervenche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9eff5139-dfae-3ff9-b5fa-243e6c378fec",
                                        "entry_id": "08c70018-42c0-39af-9f4a-fe104cd20555",
                                        "glosses": [
                                            "Nom vernaculaire donné principalement aux plantes rampantes du genre Vinca (Apocynacées), aux fleurs bleues ou blanches et aux feuilles persistantes, communes dans les sous-bois d’Europe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b426480-db13-4fb4-a0e6-9cd26ddeb8b4",
                                                "sense_id": "9eff5139-dfae-3ff9-b5fa-243e6c378fec",
                                                "text": "Embaument les ravins où bleuit la pervenche."
                                            },
                                            {
                                                "example_id": "6d15f34d-e98d-433f-9dc2-1d5df45ddfc1",
                                                "sense_id": "9eff5139-dfae-3ff9-b5fa-243e6c378fec",
                                                "text": "Quels parterres auront pu ainsi être établis artificiellement dans les bois d’agrément avec les pervenches, les primevères, les scilles, les cyclamens, les sceaux de Salomon, les galanthes, les nivéoles, le saxifrage ombreux, etc…^([sic : etc.]) : il y a toute une technique de la sylviculture ornementale apparentée à l’horticulture qui est entièrement à mettre au point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1def774-7650-3714-8ee5-c080c3a9f7e4",
                                        "entry_id": "08c70018-42c0-39af-9f4a-fe104cd20555",
                                        "glosses": [
                                            "Fleur que porte cette plante, de couleur bleue, plus rarement blanche."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a7856d8-0836-44cb-ac44-af404863d86c",
                                                "sense_id": "c1def774-7650-3714-8ee5-c080c3a9f7e4",
                                                "text": "L’astre brillant qui le fait vivre, c’est le regard de mon amant, plus doux que la douce pervenche ; sa bouche y fleurit comme le pavot pourpre et la clarté de son front répand la joie dans mes parterres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37803636-0c5d-3a82-bc34-b7c79372d3db",
                                        "entry_id": "08c70018-42c0-39af-9f4a-fe104cd20555",
                                        "glosses": [
                                            "Désigne aussi la pervenche de Madagascar (Catharanthus roseus) et quelques espèces proches cultivées pour l’ornement ou la pharmacopée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43c2bed9-5cac-3935-a2be-908235cdf198",
                                        "entry_id": "08c70018-42c0-39af-9f4a-fe104cd20555",
                                        "glosses": [
                                            "Fonctionnaire de police chargée de vérifier le stationnement des voitures, contractuelle."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8ad0641-348e-4588-9f31-b2c85046eb0c",
                                                "sense_id": "43c2bed9-5cac-3935-a2be-908235cdf198",
                                                "text": "Dites-lui que, vous aussi, vous avez été pervenche, que c’est le plus beau métier du monde, que vous avez dû arrêter à cause d’un accident du travail, que vous donneriez tout pour enfiler de nouveau l’uniforme des pervenches."
                                            },
                                            {
                                                "example_id": "cc346aab-d4d5-462d-a99b-eceeb3118da7",
                                                "sense_id": "43c2bed9-5cac-3935-a2be-908235cdf198",
                                                "text": "Nouveaux termes et nouvelles pratiques depuis le premier janvier : ce ne sont plus les fameuses pervenches qui sillonnent les rues pour distribuer des prunes ; à présent ce sont les employés de sociétés privées qui circulent avec des mini-ordinateurs permettant de scanner les plaques d’immatriculation, nettement plus rapides et nettement plus efficaces, puisque dorénavant les automobilistes sont obligés de taper les numéros de leurs plaques quand ils prennent un ticket à l’horodateur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pervenche",
                                "target_lang_code": "fr",
                                "target_senses": [
