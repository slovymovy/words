                        "glosses": [
                            "luftdicht verpackt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d342edf-7b09-4a9a-b3d4-ea4e0576f596",
                                "sense_id": "d5c54f3f-916d-39ee-b94a-a485bc6b0d52",
                                "text": "„Sie holt ein vakuumverpacktes, 225 Gramm schweres Filet mignon aus dem Gefrierschrank, packt es aus und legt es zum Auftauen in eine Pfanne.“"
                            },
                            {
                                "example_id": "547890ce-f1dd-4ce7-b3df-73ee8a713a22",
                                "sense_id": "d5c54f3f-916d-39ee-b94a-a485bc6b0d52",
                                "text": "„Er füllte einen Rucksack mit Trinkwasserflaschen, vakuumverpackten Essensrationen und einer Tarnjacke.“"
                            }
                        ],
