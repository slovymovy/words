                                "target_senses": [
                                    {
                                        "sense_id": "6900cf40-59d3-309d-9d1d-4e296e24316d",
                                        "entry_id": "82597d06-6451-3d72-a564-cf6cd764b6c8",
                                        "glosses": [
                                            "A citrus fruit originating in East Asia, Citrus ichangensis x Citrus reticulata var. austera."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8712991-72f1-40f9-8841-e6977d34e6bd",
                                                "sense_id": "6900cf40-59d3-309d-9d1d-4e296e24316d",
                                                "text": "She scoops a grassy, barely sweet green-tea sorbet onto white chocolate ganache, and garnishes it with coin-size meringues that break easily, then strings syrupy, candied yuzu zest across it all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "009f45fc-64e4-42f2-9082-61ce08ccf21f",
                        "source_entry_id": "8b8ab931-32d5-3de0-bba8-40bb89c1e8ef",
                        "source_sense_id": "cbf70ac9-0480-3c67-a54b-7895dc729e33",
                        "target_lang_word": "yuzu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yuzu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02764b58-0c92-325b-abbd-8bf2aca9c052",
                                        "entry_id": "7d063921-7089-32a3-8532-c2d20eb5b21f",
                                        "glosses": [
                                            "Agrume originaire de l’est de l’Asie (Citrus junos), hybride de mandarine sauvage (C. reticulata var. austera) et de citron d’Ichang (Citrus ichangensis)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43e4352c-a920-4ed9-8f98-b903a37a9931",
                                                "sense_id": "02764b58-0c92-325b-abbd-8bf2aca9c052",
                                                "text": "Le yuzu a un goût subtil et très parfumé."
                                            },
                                            {
                                                "example_id": "626c7742-4702-4475-a23e-1ce553d1fcde",
                                                "sense_id": "02764b58-0c92-325b-abbd-8bf2aca9c052",
                                                "text": "Carpaccio de maquereau mariné au yuzu et baies de sansho, rouget dans un bouillon corsé à la feuille de « sakura », canard de Challans rôti au vieux saké."
                                            },
                                            {
                                                "example_id": "f2f09533-1dd7-4dec-9be5-39b7cef2f8dd",
                                                "sense_id": "02764b58-0c92-325b-abbd-8bf2aca9c052",
                                                "text": "Les espèces exotiques coûteuses en empreinte carbone (kumquat, yuzu, combava, etc.) sont à réserver aux repas d’exception."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
