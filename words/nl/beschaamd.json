{
    "word_family": [
        "beschamen",
        "beschaamdheid",
        "onbeschaamd"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "75fa3ca5-e1b5-35c4-94e4-a9e406824631",
                    "sense_definition": "een gevoel van schaamte of verlegenheid ervarend over iets wat men gedaan heeft",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij voelde zich erg <w>beschaamd</w> nadat hij die domme fout had gemaakt.",
                            "target_lang_translations": {
                                "en": "He felt very <w>ashamed</w> after he made 그 stupid mistake."
                            }
                        },
                        {
                            "text": "De jongen keek met een <w>beschaamde</w> blik naar zijn boze leraar.",
                            "target_lang_translations": {
                                "en": "The boy looked at his angry teacher with an <w>ashamed</w> look."
                            }
                        }
                    ],
                    "synonyms": [
                        "verlegen",
                        "bedremmeld"
                    ],
                    "antonyms": [
                        "onbeschaamd"
                    ],
                    "common_phrases": [
                        "beschaamde blik",
                        "zich beschaamd voelen"
                    ],
                    "target_lang_definitions": {
                        "en": "experiencing a feeling of shame or embarrassment about something one has done"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ashamed",
                                "target_lang_sense_clarification": "feeling shame or guilt"
                            },
                            {
                                "target_lang_word": "embarrassed",
                                "target_lang_sense_clarification": "feeling self-conscious or awkward"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad8d432d-4542-34c9-8d63-aa9c40d67a21",
                    "sense_definition": "vol met de neiging zich te verbergen voor anderen door verlegenheid",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>beschaamde</w> ouders wilden niet onderkennen dat hun jonge dochter zwanger was.",
                            "target_lang_translations": {
                                "en": "The <w>ashamed</w> parents did not want to acknowledge that their young daughter was pregnant."
                            }
                        },
                        {
                            "text": "Hij gaf een <w>beschaamd</w> antwoord toen hem naar zijn salaris werd gevraagd.",
                            "target_lang_translations": {
                                "en": "He gave a <w>bashful</w> answer when he was asked about his salary."
                            }
                        }
                    ],
                    "synonyms": [
                        "verlegen",
                        "schuchter"
                    ],
                    "antonyms": [
                        "onbeschaamd"
                    ],
                    "common_phrases": [
                        "beschaamd antwoord"
                    ],
                    "target_lang_definitions": {
                        "en": "inclined to hide from others due to shyness or embarrassment"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ashamed",
                                "target_lang_sense_clarification": "feeling shame"
                            },
                            {
                                "target_lang_word": "bashful",
                                "target_lang_sense_clarification": "shy and easily embarrassed"
                            },
                            {
                                "target_lang_word": "sheepish",
                                "target_lang_sense_clarification": "showing embarrassment from shame or lack of self-confidence"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3d42fe13-a565-3490-a204-a59e122b09c4",
                    "sense_definition": "op een manier die blijk geeft van schaamte of verlegenheid",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze keek <w>beschaamd</w> voor zich uit toen de verpleger haar kant op keek.",
                            "target_lang_translations": {
                                "en": "She looked ahead <w>ashamedly</w> when the nurse looked her way."
                            }
                        },
                        {
                            "text": "Toen hij de waarheid hoorde, boog hij <w>beschaamd</w> zijn hoofd.",
                            "target_lang_translations": {
                                "en": "When he heard the truth, he <w>shamefacedly</w> bowed his head."
                            }
                        }
                    ],
                    "synonyms": [
                        "verlegen",
                        "bedremmeld"
                    ],
                    "antonyms": [
                        "onbeschaamd"
                    ],
                    "common_phrases": [
                        "beschaamd wegkijken",
                        "beschaamd zwijgen"
                    ],
                    "target_lang_definitions": {
                        "en": "in a manner that shows shame or embarrassment"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ashamedly",
                                "target_lang_sense_clarification": "in a way that shows shame"
                            },
                            {
                                "target_lang_word": "shamefacedly",
                                "target_lang_sense_clarification": "showing shame or embarrassment"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e0fa432a-7ad7-3eb4-aaf1-8510cb2c11d5",
                    "sense_definition": "voltooid deelwoord van <w>beschamen</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn vertrouwen in de politiek is door dit schandaal diep <w>beschaamd</w>.",
                            "target_lang_translations": {
                                "en": "My trust in politics has been deeply <w>betrayed</w> by this scandal."
                            }
                        },
                        {
                            "text": "Zij heeft de hoge verwachtingen van haar ouders helaas <w>beschaamd</w>.",
                            "target_lang_translations": {
                                "en": "She has unfortunately <w>disappointed</w> her parents' high expectations."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vertrouwen beschaamd",
                        "verwachtingen beschaamd"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of 'beschamen', meaning to fail to meet expectations or to betray trust"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "betrayed",
                                "target_lang_sense_clarification": "regarding trust or confidence"
                            },
                            {
                                "target_lang_word": "disappointed",
                                "target_lang_sense_clarification": "regarding expectations"
                            }
                        ]
                    }
                }
            ]
        }
    ]
