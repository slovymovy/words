                        "examples": [
                            {
                                "example_id": "3a32f6a2-4b8e-4e2d-a1c6-baef2eaffaa3",
                                "sense_id": "bd3fd0b9-0dc3-3ab0-91f5-48bbac6c3dce",
                                "text": "Towards this end, indeed, he had purposed to introduce, in this place, a dissertation touching the divine right of beadles, and elucidative of the position, that a beadle can do no wrong."
                            },
                            {
                                "example_id": "34762f97-1cc4-40d6-9ac2-e8ceb1e169ee",
                                "sense_id": "bd3fd0b9-0dc3-3ab0-91f5-48bbac6c3dce",
                                "text": "In looking at this wreck of Governments in all European countries, there is one consideration that suggests itself, sadly elucidative of our modern epoch."
                            }
