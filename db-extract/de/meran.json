                ],
                "senses": [
                    {
                        "sense_id": "7e02b88e-bb8f-3feb-8e65-84680ca44952",
                        "entry_id": "4f3a5ef3-7db3-3cd8-9a17-13d681c22d51",
                        "glosses": [
                            "eine Stadt in Südtirol, Italien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4523d61-80fe-438d-856b-8c3e764600a2",
                                "sense_id": "7e02b88e-bb8f-3feb-8e65-84680ca44952",
                                "text": "Meran ist die zweitgrößte Stadt Südtirols."
                            },
                            {
                                "example_id": "8af2916e-a254-42f8-9a29-b8d475db9edc",
                                "sense_id": "7e02b88e-bb8f-3feb-8e65-84680ca44952",
                                "text": "Eine knappe Mehrheit der Einwohner Merans ist deutschsprachig."
                            },
                            {
                                "example_id": "954439ab-0fcc-42bc-97ba-bbdbf42c6e71",
                                "sense_id": "7e02b88e-bb8f-3feb-8e65-84680ca44952",
                                "text": "Meran mit Schloss Tirol war einst Herrschaftssitz der Grafen von Tirol, mehrere Jahrhunderte lang die mächtigen Herrscher in einem politisch bedeutenden Land in Mitteleuropa."
                            },
                            {
                                "example_id": "5f051fef-4b55-4a47-b7e0-3a65f7dfee7a",
                                "sense_id": "7e02b88e-bb8f-3feb-8e65-84680ca44952",
                                "text": "Alle Orte rund um Meran sind mit Waalwegen wohl versorgt, denn überall ist Bewässerung den ganzen heißen Sommer über nötig."
                            },
                            {
                                "example_id": "32ec8427-a917-4025-9324-1b60bc74f6f7",
                                "sense_id": "7e02b88e-bb8f-3feb-8e65-84680ca44952",
                                "text": "Im Oktober 1870 stehen Schützen in Burggräfler Tracht in Meran Spalier, Schulkinder tragen Fähnchen, 6000 Schaulustige recken die Hälse: Ganz Meran wartet auf Kaiserin Sissi, die zum ersten Mal nach Tirol kommt."
                            },
                            {
                                "example_id": "acab7c0f-1905-48a6-85bb-aca4835ab578",
                                "sense_id": "7e02b88e-bb8f-3feb-8e65-84680ca44952",
                                "text": "Meran wird hip: Im einst so braven Kurort legt ein Londoner DJ auf, und die neue Therme stammt von Matteo Thun."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
