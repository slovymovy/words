                        "glosses": [
                            "radio- of televisieuitzending speciaal gemaakt voor een jong publiek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62a5c220-4871-4a04-ba68-2c2aa13e9306",
                                "sense_id": "5745eefa-202d-3d50-ad78-b9971071acfd",
                                "text": "Hij gebruikte ook profsporters voor zijn campagnes. Zo zetten basketbalgrootheden als Stephen Curry en LeBron James zich in voor Obama's liefdadigheidsprojecten, zoals het jongerenprogramma My Brother's Keeper."
                            },
                            {
                                "example_id": "8f43f9a1-f2e2-4173-99ae-55f32f381c32",
                                "sense_id": "5745eefa-202d-3d50-ad78-b9971071acfd",
                                "text": "Na militaire dienst gaat hij Nederlands studeren omdat hij leraar wil worden. Als hij een advertentie ziet voor een opleiding tot radiocabaretier meldt hij zich echter daarvoor aan en stopt met zijn studie. In 1963 haalt hij zijn diploma en kan hij aan de slag bij het jongerenprogramma Multiplex op de radio."
                            }
                        ]
                    },
