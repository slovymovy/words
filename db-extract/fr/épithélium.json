                        "translation_id": "06d3a366-deed-48b1-bbc6-3e8d6a99e3e9",
                        "source_entry_id": "428f0202-eb4a-3710-b0b0-5c40ae9739c0",
                        "source_sense_id": "d514e2d6-2532-3e2d-bf42-de6945949b5c",
