                        "source_sense_description": "Anhängerin des Gaullismus (politische Bewegung, die die Ideen von General Charles de Gaulle vertritt)",
                        "target_lang_word": "gaulliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gaulliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efe4fbc0-300f-3578-b219-5b97b5344854",
                                        "entry_id": "93f8d27a-8375-339b-84f7-f59979958730",
                                        "glosses": [
                                            "Relatif à la doctrine politique inspirée de Charles de Gaulle ou au gaullisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81f58cd5-3576-4114-b425-2a0f06a9354f",
                                                "sense_id": "efe4fbc0-300f-3578-b219-5b97b5344854",
                                                "text": "Dans la Résistance intérieure, les éléments ex-vichyssois, les champions de l’électoralisme, les réactionnaires n'avaient qu'une minime influence. Dans l'appareil « gaulliste », au contraire, les hommes de la droite, et même d'anciens cagoulards, avaient des places éminentes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gaulliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4522c04e-f325-392b-b90f-9651cfff76fc",
                                        "entry_id": "cd787fc2-9f21-3ac6-8a12-dc65fd370e48",
                                        "glosses": [
                                            "Partisan de Charles de Gaulle ou du gaullisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14e9a92c-bda5-4dfe-809d-f62cc0194559",
                                                "sense_id": "4522c04e-f325-392b-b90f-9651cfff76fc",
                                                "text": "Celui-ci réunissait un échantillon de députés de tous bords, allant de gaullistes proarabes comme Daniel Garrigue et Patrick Ollier à des socialistes proches des thèses laïques du régime irakien tel Jean-Pierre Chevènement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
