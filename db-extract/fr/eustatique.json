                "forms": [
                    {
                        "form_id": "92880ad1-36f8-4884-9ad2-757c8138ae0d",
                        "entry_id": "f316a91e-4ed3-35b5-b0b2-d788fe8225f7",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "eustatiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c3c3a3da-13a2-3952-a8f7-539920b8bc01",
                        "entry_id": "f316a91e-4ed3-35b5-b0b2-d788fe8225f7",
                        "glosses": [
                            "Relatif au niveau global des mers, à ses mouvements de hausse ou de baisse par rapport aux continents, causés notamment par des changements climatiques ou des mouvements tectoniques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "903cff34-c0ed-458a-901c-ec0ce6166bcd",
                                "sense_id": "c3c3a3da-13a2-3952-a8f7-539920b8bc01",
                                "text": "M. Suess a créé le mot eustatiques pour les mouvements généraux que peuvent provoquer, dans la mer, soit l’affaissement de certaines parties de son lit, soit l’accumulation progressive des sédiments."
                            },
                            {
                                "example_id": "3da1b39f-005d-4fbf-b310-0578907941ad",
                                "sense_id": "c3c3a3da-13a2-3952-a8f7-539920b8bc01",
                                "text": "Les mouvements eustatiques peuvent tenir à des changements dans la forme et la profondeur des bassins océaniques."
                            },
                            {
                                "example_id": "20fc3707-b8dd-480e-bc75-9579541d2310",
                                "sense_id": "c3c3a3da-13a2-3952-a8f7-539920b8bc01",
                                "text": "Les modifications de la Terre les plus spectaculaires, les mieux reconstituées et dont l’état actuel de la planète n’est qu'un aboutissement provisoire, sont celles des successions paléogéographiques qui incluent, dans le cadre dynamique de la tectonique des plaques, les orogénèses et les variations eustatiques."
                            }
                        ]
                    }
                ],
