                    "sense_id": "10acd553-b3ae-30cd-b30b-bc5e8165729b",
                    "sense_definition": "Jeune enfant ou enfant en bas âge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>mioches</w> jouent bruyamment dans la cour depuis le début de l'après-midi.",
                            "target_lang_translations": {
                                "en": "The <w>kids</w> have been playing noisily in the courtyard since early afternoon.",
                                "ru": "<w>Малыши</w> шумно играют во дворе с раннего послеобеденного времени.",
                                "nl": "De <w>kleuters</w> spelen al sinds het begin van de middag luidruchtig op de binnenplaats.",
                                "de": "Die <w>Knirpse</w> spielen seit dem frühen Nachmittag laut auf dem Hof.",
                                "pl": "<w>Dzieciaki</w> bawią się głośno na podwórku od początku popołudnia.",
                                "it": "I <w>marmocchi</w> giocano rumorosamente in cortile dall'inizio del pomeriggio.",
                                "cs": "<w>Děcka</w> už od začátku odpoledne hlučně hrají na dvoře.",
                                "tr": "<w>Çocuklar</w> öğleden sonranın başından beri avluda gürültülü bir şekilde oynuyorlar.",
                                "es": "Los <w>críos</w> juegan ruidosamente en el patio desde primera hora de la tarde.",
                                "zh": "这群<w>小孩</w>从下午开始就一直在院子里吵吵闹闹地玩。"
                            }
                        },
                        {
                            "text": "Elle passe tout son samedi à surveiller les <w>mioches</w> de ses voisins.",
                            "target_lang_translations": {
                                "en": "She spends her whole Saturday looking after her neighbours' <w>kids</w>.",
                                "ru": "Всю субботу она проводит, присматривая за <w>малышами</w> соседей.",
                                "nl": "Ze brengt haar hele zaterdag door met het oppassen op de <w>kleuters</w> van haar buren.",
                                "de": "Sie verbringt ihren ganzen Samstag damit, auf die <w>Knirpse</w> ihrer Nachbarn aufzupassen.",
                                "pl": "Całą sobotę spędza na pilnowaniu <w>dzieciaków</w> sąsiadów.",
                                "it": "Passa tutto il sabato a badare ai <w>marmocchi</w> dei vicini.",
                                "cs": "Celou sobotu tráví hlídáním <w>děcek</w> sousedů.",
                                "tr": "Bütün cumartesi gününü komşularının <w>çocuklarına</w> bakarak geçiriyor.",
                                "es": "Pasa todo el sábado cuidando a los <w>críos</w> de sus vecinos.",
                                "zh": "她整个星期六都在照看邻居家的<w>小孩</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "môme",
                        "mouflet",
                        "moutard"
                    ],
                    "common_phrases": [
                        "garder les mioches",
