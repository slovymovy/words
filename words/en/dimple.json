{
    "word_family": [
        "dimpled",
        "dimply"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5512c8dd-8f99-349c-9b82-05f4624873cc",
                    "sense_definition": "A small natural hollow on the skin, especially on the cheeks or chin.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "facial_feature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has deep <w>dimples</w> in her cheeks when she smiles.",
                            "target_lang_translations": {
                                "ru": "У неё глубокие <w>я́мочки</w> на щеках, когда она улыбается.",
                                "cs": "Když se usměje, má ve tvářích hluboké <w>důlky</w>."
                            }
                        },
                        {
                            "text": "The baby has very cute <w>dimples</w>.",
                            "target_lang_translations": {
                                "ru": "У малыша очень милые <w>я́мочки</w>.",
                                "cs": "To miminko má moc roztomilé <w>důlky</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cute dimples",
                        "deep dimples",
                        "cheeks and dimples"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая естественная впадинка на коже, особенно на щеках или подбородке.",
                        "cs": "Malá přirozená prohlubeň na kůži, zejména na tvářích nebo bradě."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "я́мочка",
                                "target_lang_sense_clarification": "на щеках или подбородке"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "důlek",
                                "target_lang_sense_clarification": "na tvářích nebo bradě"
                            },
                            {
                                "target_lang_word": "dolík",
                                "target_lang_sense_clarification": "na tvářích nebo bradě"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8995928d-f7cf-3692-9fa6-8120587738e5",
                    "sense_definition": "A small depression or dent in the surface of an object.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "surface_indentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A golf ball is covered in tiny <w>dimples</w> to help it fly further.",
                            "target_lang_translations": {
                                "ru": "Мяч для гольфа покрыт крошечными <w>я́мками</w>, чтобы лететь дальше.",
                                "cs": "Golfový míček je pokrytý drobnými <w>důlky</w>, aby doletěl dál."
                            }
                        },
                        {
                            "text": "The hail left a small <w>dimple</w> on the hood of the car.",
                            "target_lang_translations": {
                                "ru": "Град оставил небольшую <w>вмя́тину</w> на капоте машины.",
                                "cs": "Kroupy zanechaly na kapotě auta malý <w>důlek</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dent"
                    ],
                    "common_phrases": [
                        "golf ball dimples"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое углубление или вмятина на поверхности предмета.",
                        "cs": "Malá prohlubeň nebo vryp na povrchu předmětu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "я́мка",
                                "target_lang_sense_clarification": "небольшое углубление"
                            },
                            {
                                "target_lang_word": "вмя́тина",
                                "target_lang_sense_clarification": "дефект от удара"
                            },
                            {
                                "target_lang_word": "углубле́ние",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "důlek",
                                "target_lang_sense_clarification": "malé prohloubení"
                            },
                            {
                                "target_lang_word": "výmola",
                                "target_lang_sense_clarification": "deformace povrchu"
                            },
                            {
                                "target_lang_word": "prohlubeň",
                                "target_lang_sense_clarification": "obecný termín"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4362bf5c-086f-3a80-bf1d-06ccc641bb02",
                    "sense_definition": "A small mark made on metal with a tool to guide a drill.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical_mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should make a <w>dimple</w> with a punch before you start drilling.",
                            "target_lang_translations": {
                                "ru": "Вам следует сделать <w>углубле́ние</w> кернером перед тем, как начать сверлить.",
                                "cs": "Než začneš vrtat, měl bys důlčíkem udělat <w>důlek</w>."
                            }
                        },
                        {
                            "text": "The mechanic checked the <w>dimple</w> to ensure the hole would be centered.",
                            "target_lang_translations": {
                                "ru": "Механик проверил <w>углубле́ние</w>, чтобы убедиться, что отверстие будет по центру.",
                                "cs": "Mechanik zkontroloval <w>důlek</w>, aby se ujistil, že otvor bude vycentrovaný."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая отметка на металле, сделанная инструментом для направления сверла.",
                        "cs": "Malá značka na kovu vytvořená nástrojem pro navedení vrtáku."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "углубле́ние",
                                "target_lang_sense_clarification": "техническое"
                            },
                            {
                                "target_lang_word": "лу́нка",
                                "target_lang_sense_clarification": "для сверления"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "důlek",
                                "target_lang_sense_clarification": "technické označení pro vrtání"
                            },
                            {
                                "target_lang_word": "důlčík",
                                "target_lang_sense_clarification": "značka vytvořená důlčíkem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1ea5ffd6-9f27-3a12-bba5-a5be48b0e39b",
                    "sense_definition": "To show dimples on the face, typically when smiling.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "facial_feature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her face <w>dimpled</w> with joy as she opened the present.",
                            "target_lang_translations": {
                                "ru": "Её лицо <w>покры́лось я́мочками</w> от радости, когда она открыла подарок.",
                                "cs": "Když otevírala dárek, radostí se jí ve tvářích <w>udělaly důlky</w>."
                            }
                        },
                        {
                            "text": "The child <w>dimpled</w> at the friendly stranger.",
                            "target_lang_translations": {
                                "ru": "Ребёнок <w>улыбну́лся, сверкну́в я́мочками</w>, дружелюбному незнакомцу.",
                                "cs": "Dítě se na přátelského cizince <w>usmálo tak, až se mu udělaly důlky</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dimpled with delight",
                        "cheeks dimpled"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляться в виде ямочек на лице, обычно при улыбке.",
                        "cs": "Projevovat se tvorbou důlků na obličeji, obvykle při úsměvu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покрыва́ться я́мочками",
                                "target_lang_sense_clarification": "о лице при улыбке"
                            },
                            {
                                "target_lang_word": "образо́вывать я́мочки",
                                "target_lang_sense_clarification": "появляться (о ямочках)"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "udělat se",
                                "target_lang_sense_clarification": "o důlcích ve tvářích"
                            },
                            {
                                "target_lang_word": "prohloubit se",
                                "target_lang_sense_clarification": "o tvářích při úsměvu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02689977-2516-3ac4-a098-93573237318a",
                    "sense_definition": "To create small hollows or dents in a surface.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surface_indentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy rain <w>dimpled</w> the surface of the lake.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь <w>покры́л ря́бью</w> поверхность озера.",
                                "cs": "Hustý déšť <w>udělal důlky</w> na hladině jezera."
                            }
                        },
                        {
                            "text": "The soft clay was <w>dimpled</w> by the artist's fingers.",
                            "target_lang_translations": {
                                "ru": "Мягкая глина была <w>покры́та вмя́тинами</w> от пальцев художника.",
                                "cs": "Měkká hlína byla <w>promáčknutá</w> prsty umělce."
                            }
                        }
                    ],
                    "synonyms": [
                        "dent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать небольшие углубления или вмятины на поверхности.",
                        "cs": "Vytvářet malé prohlubně nebo vrypy na povrchu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покрыва́ть ря́бью",
                                "target_lang_sense_clarification": "о воде"
                            },
                            {
                                "target_lang_word": "оставля́ть вмя́тины",
                                "target_lang_sense_clarification": "на мягкой поверхности"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "udělat důlky",
                                "target_lang_sense_clarification": "vytvořit prohlubně"
                            },
                            {
                                "target_lang_word": "promáčknout",
                                "target_lang_sense_clarification": "vytvořit vryp"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}