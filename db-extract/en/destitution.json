                                    {
                                        "sense_id": "bce812b5-e1d7-3a19-9d37-293c7db04285",
                                        "entry_id": "ca8e136b-4d91-3aec-a957-623a52ef7a12",
                                        "glosses": [
                                            "Dícese de una gran pobreza."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2662905-a4dd-42b4-8269-4e8308393ee8",
                                                "sense_id": "bce812b5-e1d7-3a19-9d37-293c7db04285",
                                                "text": "Suelen los que de sus tierras absentes se hallan considerar: de que cosa aquel lugar donde parten mayor inopia, o falta padezca:"
