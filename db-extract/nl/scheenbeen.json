                "translations": [
                    {
                        "translation_id": "0264351a-d515-47df-926b-ad5c36ca6466",
                        "source_entry_id": "3099c7a4-b89d-37ed-9b30-d54ff35be687",
                        "source_sense_id": "25b5a630-8a2a-363f-9174-9f339c39f014",
                        "target_lang_word": "Schienbein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schienbein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "340f2214-78fb-3fd6-8e9c-c4185034bf1f",
                                        "entry_id": "6f84fb94-5e94-3d5b-bf3b-490c33357acf",
                                        "glosses": [
                                            "der kräftigere der beiden Knochen des Unterschenkels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1101d972-40e3-447c-b2f7-c886eb05518a",
                                                "sense_id": "340f2214-78fb-3fd6-8e9c-c4185034bf1f",
                                                "text": "Das Skelett des Beines besteht aus dem Oberschenkelknochen, den Unterschenkelknochen (Schienbein und Wadenbein), den Fußwurzelknochen, Mittelfußknochen und den Zehenknochen."
                                            },
                                            {
                                                "example_id": "4307e5b4-934c-4923-8db8-4538309f627b",
                                                "sense_id": "340f2214-78fb-3fd6-8e9c-c4185034bf1f",
                                                "text": "Beim Fußball geht es manchmal etwas rau zu. Da wird schon mal gegen das Schienbein getreten."
                                            },
                                            {
                                                "example_id": "2cf801ce-7434-4a23-8b7b-b63501ab562f",
                                                "sense_id": "340f2214-78fb-3fd6-8e9c-c4185034bf1f",
                                                "text": "„Kurz darauf wurde Jörg B. festgenommen, wobei er einem Beamten gegen das Schienbein trat.“"
                                            },
                                            {
                                                "example_id": "2dc26328-3c2b-40f4-8971-4b61363863be",
                                                "sense_id": "340f2214-78fb-3fd6-8e9c-c4185034bf1f",
                                                "text": "„Das Kind riß sich los und versetzte der Mutter einen Tritt gegen das Schienbein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c8d2928-30a7-41c4-a04f-f2977fd1f2fd",
                        "source_entry_id": "3099c7a4-b89d-37ed-9b30-d54ff35be687",
                        "source_sense_id": "25b5a630-8a2a-363f-9174-9f339c39f014",
