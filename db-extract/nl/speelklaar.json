                        "glosses": [
                            "gereed om in een wedstrijd gebruikt te worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54d5ec8a-34ae-433d-9e4c-1533165758d2",
                                "sense_id": "0d930caa-f1bb-3bd5-862e-1acac8588a0c",
                                "text": "De afgelopen maanden zijn dan ook vooral gebruikt om de competitie op afstand speelklaar te krijgen. In de nieuwe opzet nemen spelers het vanuit huis tegen elkaar op, terwijl commentatoren in een studio live commentaar geven."
                            },
                            {
                                "example_id": "eca738d0-5c57-47ae-beb5-5d9383bc4423",
                                "sense_id": "0d930caa-f1bb-3bd5-862e-1acac8588a0c",
                                "text": "Het was lastig speelklaar te geraken voor de Nations League-wedstrijd tegen Oranje, zegt Gareth Bale. Vermoeidheid na een lang seizoen en het feestje na het behalen van het WK in Qatar speelden mee."
                            }
                        ]
                    }
