                                "target_senses": [
                                    {
                                        "sense_id": "febc976d-2f2b-3413-919f-daa232a9204b",
                                        "entry_id": "c76f8a45-8acc-3ece-9197-2a202ecabf1a",
                                        "glosses": [
                                            "Erdrutsch, bei dem ein Strom aus Schlamm und gröberem Gesteinsmaterial im Gebirge schnell talwärts fließt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6502e86-862d-4b01-8166-fcbb066024e5",
                                                "sense_id": "febc976d-2f2b-3413-919f-daa232a9204b",
                                                "text": "„Dann könnten von einem solchen See-Ausbruch den unten im Tal gelegenen Gemeinden sehr starke Flutwellen und Murgänge drohen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
