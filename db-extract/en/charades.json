                    {
                        "translation_id": "04b7ad7e-2626-4195-99f3-e64948f03d7b",
                        "source_entry_id": "7a2a4641-7b45-3791-ba54-65a37f689152",
                        "source_sense_id": "1100c853-1612-39e2-bada-6d793f16097d",
