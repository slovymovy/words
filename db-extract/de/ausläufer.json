                "senses": [
                    {
                        "sense_id": "d906f6da-dbf5-32f3-883d-a497b76e7d8c",
                        "entry_id": "82b1ca60-7c76-37c6-9d07-bf4a75850da6",
                        "glosses": [
                            "endender, auslaufender Teil, zum Beispiel eines Gebirges oder Hochdruckgebiets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55c9a0fc-525b-4f4a-8d97-8e698fe8d5c5",
                                "sense_id": "d906f6da-dbf5-32f3-883d-a497b76e7d8c",
                                "text": "„Der Hof steht am östlichen Ausläufer einer schmalen Geländerippe, die sich in der Ausdehnung einer halben Wegstunde von Abend nach Morgen erstreckt in leichtem Bogen, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bb4938cc-02a0-3a2f-afaa-d4ea06b1ae60",
                        "entry_id": "82b1ca60-7c76-37c6-9d07-bf4a75850da6",
                        "glosses": [
                            "Seitenspross von Pflanzen und Tieren zur vegetativen Fortpflanzung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25c17bb7-7e19-47da-bfcf-3fb693783915",
                                "sense_id": "bb4938cc-02a0-3a2f-afaa-d4ea06b1ae60",
                                "text": "Die Wald-Erdbeeren auf der Lichtung pflanzen sich durch Ausläufer fort."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b13c55af-58a9-3073-b16a-24de1a9f2376",
