                    },
                    {
                        "translation_id": "165435a1-32eb-4c06-b82b-2b040e65248b",
                        "source_entry_id": "1644cf4b-ab8a-3d46-8678-7dd4f6726d4b",
                        "target_lang_word": "Inszenierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Inszenierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b800e7e4-558d-3343-a3c9-42a7b8efd22f",
                                        "entry_id": "4c3aa317-395a-3c2d-9ae2-0e9b8ff53d69",
                                        "glosses": [
                                            "künstlerische Gestaltung einer Aufführung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7562a28b-682f-467e-a25a-2d3f26f7b27c",
                                                "sense_id": "b800e7e4-558d-3343-a3c9-42a7b8efd22f",
                                                "text": "Die Inszenierung des Stückes war gewöhnungsbedürftig."
                                            },
                                            {
                                                "example_id": "bb3ad05c-a750-4e4f-83e7-674ffe048962",
                                                "sense_id": "b800e7e4-558d-3343-a3c9-42a7b8efd22f",
                                                "text": "„Er denkt schon an eine große Inszenierung, nicht an eine kleine Gelegenheitssache.“"
                                            },
                                            {
                                                "example_id": "d08370a1-1bea-4034-89ab-3bc7134271b5",
                                                "sense_id": "b800e7e4-558d-3343-a3c9-42a7b8efd22f",
                                                "text": "„Er klatscht in die Hände, als gälte es eine gelungene Inszenierung zu bejubeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a200fd5-cab4-3b49-8103-8f3a54225496",
                                        "entry_id": "4c3aa317-395a-3c2d-9ae2-0e9b8ff53d69",
                                        "glosses": [
                                            "übertriebene Selbstdarstellung, Auslösung eines Skandals"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a0e495-b78a-46fd-804a-cd25729b9d29",
                                                "sense_id": "7a200fd5-cab4-3b49-8103-8f3a54225496",
                                                "text": "Ihre Inszenierung hat ihre wahren Absichten gezeigt."
                                            },
                                            {
                                                "example_id": "a0f8a328-899a-488e-8192-ae3586b2544d",
                                                "sense_id": "7a200fd5-cab4-3b49-8103-8f3a54225496",
                                                "text": "„Kurz kam ihm der Gedanke, dass das hier möglicherweise alles eine große Inszenierung war, dass die beiden ihm etwas verheimlichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed886c3a-8625-4ecb-ada7-f4eb5b7c8457",
                        "source_entry_id": "1644cf4b-ab8a-3d46-8678-7dd4f6726d4b",
                        "target_lang_word": "Bühnenbild",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bühnenbild",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93ac8068-dba7-3913-a3d7-50c5d4caae21",
                                        "entry_id": "ff03476a-62a9-3f5f-a5b6-6189fb8f3b5f",
                                        "glosses": [
                                            "Gestaltung der Bühne durch bauliche Elemente, Requisiten, Malerei und moderne Bildmedien für die jeweilige Inszenierung"
                                        ],
                                        "tags": [
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "976f5c18-2334-43b8-877c-bb629420e514",
                                                "sense_id": "93ac8068-dba7-3913-a3d7-50c5d4caae21",
                                                "text": "Das Bühnenbild ist in seiner Gestaltung von den Bühnenformen abhängig."
                                            },
                                            {
                                                "example_id": "597b6758-86db-43ee-81ae-90cd73f56fc9",
                                                "sense_id": "93ac8068-dba7-3913-a3d7-50c5d4caae21",
                                                "text": "In Deutschland stand das Bühnenbild im 20. Jahrhundert unter dem Eindruck des Expressionismus."
                                            },
                                            {
                                                "example_id": "fcddfcee-a1c2-4862-80b8-01034e823e11",
                                                "sense_id": "93ac8068-dba7-3913-a3d7-50c5d4caae21",
                                                "text": "„Bühnenbild und Requisiten sind, in großen Holzkisten verladen, im Lkw von Berlin nach Paris gefahren worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
