                            {
                                "example_id": "5048ed99-13d5-425a-be6d-3a39c43a8aae",
                                "sense_id": "41ddb076-6f8a-3d9c-af6a-75ccc391f672",
                                "text": "„Der Zwanzigtonner hat mehr PS und mehr Hubraum, aber zum Wenden braucht er den Stadionparkplatz.“"
                            },
