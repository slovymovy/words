                                    {
                                        "sense_id": "40c3079a-5075-315b-8ca4-b74a0cfcd868",
                                        "entry_id": "3152aeda-1454-309e-8f49-d1ea270933c2",
                                        "glosses": [
                                            "Technique picturale mise en place par Georges Seurat et Paul Signac consistant à rendre une couleur sur la toile en la décomposant en ses couleurs primaires et leurs complémentaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13bdbb6c-d324-4e97-b922-fb4c0e700b67",
                                                "sense_id": "40c3079a-5075-315b-8ca4-b74a0cfcd868",
                                                "text": "Comme son nom l’indique précisément, le divisionnisme est une technique picturale qui consiste à appliquer sur la toile de petites taches de couleur pure juxtaposées et reconstituant dans l’œil du spectateur une teinte obtenue par « division » et non plus, comme avant, par simple mélange sur la palette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a92dc011-64f2-3d5f-b7ca-486de07c8a20",
                                        "entry_id": "3152aeda-1454-309e-8f49-d1ea270933c2",
                                        "glosses": [
                                            "Au Rwanda, action interdite par la loi, qui consiste à séparer les ethnies (essentiellement hutue et tusie), ne serait-ce qu'administrativement ou dans le discours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c65f09ae-be34-4ba4-8ff9-138fe0e308d9",
                                                "sense_id": "a92dc011-64f2-3d5f-b7ca-486de07c8a20",
                                                "text": "« C'est comme un refrain. Quand ils ne savent pas de quoi nous accuser, ils disent en choeur “divisionnisme, divisionnisme” », rigole McDowell Kalisa, son éternel bandana rouge noué sur le crâne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
