                        "entry_id": "d7e74baf-7f06-3708-8d85-6a56d8467399",
                        "glosses": [
                            "die Eigentümerin, die Besitzerin"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdbf44c1-1e11-40d6-ae25-a155caf58177",
                        "source_entry_id": "d7e74baf-7f06-3708-8d85-6a56d8467399",
                        "source_sense_id": "475a9d95-0a37-3b73-9188-782cb14a34cf",
                        "source_sense_description": "die Eigentümerin, die Besitzerin",
                        "target_lang_word": "Eigentümerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eigentümerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66cee5b0-e599-311e-831e-9eee3f8eb605",
                                        "entry_id": "b87e458f-62f3-3550-bacd-a31a8f835e81",
                                        "glosses": [
                                            "weibliche (natürliche oder juristische) Person, welche die rechtliche Herrschaft über etwas hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ee69900-e217-4911-860b-48c733afc6ad",
                                                "sense_id": "66cee5b0-e599-311e-831e-9eee3f8eb605",
                                                "text": "Als Eigentümerin hat man sowohl Rechte als auch Pflichten."
                                            },
                                            {
                                                "example_id": "c072c1e5-7a32-413a-8f12-52c3babac6c3",
                                                "sense_id": "66cee5b0-e599-311e-831e-9eee3f8eb605",
                                                "text": "„Bis vor kurzem stand hier eine kleine Jugendstilvilla, doch die Eigentümerin hat das Grundstück verkauft.“"
                                            },
                                            {
                                                "example_id": "d9f9e76c-41f1-4234-83c7-b7cd5af75099",
                                                "sense_id": "66cee5b0-e599-311e-831e-9eee3f8eb605",
                                                "text": "„Die Stadt ist 1937 Eigentümerin geworden.“"
                                            },
                                            {
                                                "example_id": "78af45e0-4aa7-4729-8371-808c5eda700a",
                                                "sense_id": "66cee5b0-e599-311e-831e-9eee3f8eb605",
                                                "text": "„Deren Eigentümerin, die ehrgeizige Zufa Lässig, sitzt ebenfalls auf ihrer Terrasse und freut sich nicht.“"
                                            },
                                            {
                                                "example_id": "21678b91-5cfb-480e-a59a-3fbfadd16ef1",
                                                "sense_id": "66cee5b0-e599-311e-831e-9eee3f8eb605",
                                                "text": "„Die derzeitige Eigentümerin von Shakespeare and Company ist George Whitmans Tochter, die den Vornamen Sylvia trägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bbad122-5f37-444b-933d-a31695603b89",
                        "source_entry_id": "d7e74baf-7f06-3708-8d85-6a56d8467399",
                        "source_sense_id": "475a9d95-0a37-3b73-9188-782cb14a34cf",
                        "source_sense_description": "die Eigentümerin, die Besitzerin",
                        "target_lang_word": "Besitzerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Besitzerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                        "entry_id": "325cfe21-3d38-357e-9f2b-0aa46dcbeb02",
                                        "glosses": [
                                            "weibliche Person, die etwas in ihrem Besitz hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81a92702-be1c-4da7-9da1-3722458d9e8f",
                                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                                "text": "„Die Besitzerin des Geschäftes umarmte mich zum Abschied und gab mir wieder drei Schillerlocken mit.“"
                                            },
                                            {
                                                "example_id": "4f809061-d331-410a-8de8-3274aca7f639",
                                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                                "text": "„Nach vielem Hin und Her mit der Besitzerin hatte ich es geschafft, dass im Gästehaus eine Klimaanlage eingebaut wurde.“"
                                            },
                                            {
                                                "example_id": "e7fdbdcf-0cc5-4e7c-8d99-cf6bc58a43bb",
                                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                                "text": "„Die Besitzerin führte sie in einen Raum hinter dem Laden, der abgeblendet war.“"
                                            },
                                            {
                                                "example_id": "7904b344-faeb-4c40-8529-67f59b32efe5",
                                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                                "text": "„Eine Woche später waren sie stolze Besitzerinnen eines kleinen blauen Citroën.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
