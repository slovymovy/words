                        "examples": [
                            {
                                "example_id": "5502fa2b-9684-4235-a6cc-116e5982af87",
                                "sense_id": "a58d5c57-e996-3acd-b2d7-ff997bbac9a3",
                                "text": "Ik maakte notities omdat ze me er dagelijks aan herinnerden dat ik een inhoudloos leven leidde."
                            },
                            {
                                "example_id": "948ee31b-886f-42cb-9df0-dda7a36c4ade",
                                "sense_id": "a58d5c57-e996-3acd-b2d7-ff997bbac9a3",
                                "text": "Het is een moeilijk proces, zonder ego door het leven gaan, zonder ‘inhoudloos’ te worden. Mensen geloven wat je doet, en niet wat je zegt. Maar soms moet je toch zeggen wat je doet?"
                            }
                        ]
                    }
