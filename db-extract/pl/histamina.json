        "pl-extract.jsonl": [
            {
                "entry_id": "158a2ea1-b6d0-33ee-a744-229a7ae3353c",
                "word": "histamina",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e0ee5007-fcba-3432-abee-8ead26ed98e8",
                        "entry_id": "158a2ea1-b6d0-33ee-a744-229a7ae3353c",
                        "glosses": [
                            "hormon tkankowy i neuroprzekaźnik, heterocykliczna amina biogenna, organiczny związek chemiczny wytwarzany głównie przez komórki tuczne i bazofile, uczestniczący w reakcjach alergicznych, procesach zapalnych oraz w regulacji funkcji żołądka i układu nerwowego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb35c1aa-d714-46a8-9165-f2fc39226f3d",
                                "sense_id": "e0ee5007-fcba-3432-abee-8ead26ed98e8",
                                "text": "Histamina wywołuje świąd, obrzęk, rozszerzenie naczyń krwionośnych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3340d96-9965-4161-9e7c-9a7aa82d3093",
                        "source_entry_id": "158a2ea1-b6d0-33ee-a744-229a7ae3353c",
                        "source_sense_id": "e0ee5007-fcba-3432-abee-8ead26ed98e8",
                        "target_lang_word": "histamine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "histamine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15116ed5-c7b0-3266-8791-32e73c1a4123",
                                        "entry_id": "d1cde0c8-2730-3ae8-90e1-cea0322ab93d",
                                        "glosses": [
                                            "An amine, C₅H₉N₃, formed by decarboxylation of histidine, that causes dilatation of capillaries, contraction of smooth muscle, and stimulation of gastric acid secretion; it is released during allergic reactions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcc78ba2-8017-4041-ae4b-2f8624e6f432",
                                                "sense_id": "15116ed5-c7b0-3266-8791-32e73c1a4123",
                                                "text": "Mellanby and Twort have isolated from the fæces a bacillus which is able to produce from one of the amino acids normally formed in digestion of proteins a highly active body, histamine."
                                            },
                                            {
                                                "example_id": "f3a06545-f438-4fc4-9941-041f41455b4d",
                                                "sense_id": "15116ed5-c7b0-3266-8791-32e73c1a4123",
                                                "text": "The intake of food triggers a release of histamine, which activates the acid-secreting cells."
                                            },
                                            {
                                                "example_id": "cf115f04-afa3-4166-8dda-a1d219c852e1",
                                                "sense_id": "15116ed5-c7b0-3266-8791-32e73c1a4123",
                                                "text": "In a strongly ripened cheese, the casein proteins are broken down to amino acids, and the amino acids can be broken down into amines, small molecules that can serve as chemical signals in the human body. Histamine and tyramine are found in large quantities in Cheddar, blue, Swiss, and Dutch-style cheeses, and can cause a rise in blood pressure, headaches, and rashes in people who are especially sensitive to them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4df4d9a1-bc83-47c6-b41f-9c3da70452ef",
                        "source_entry_id": "158a2ea1-b6d0-33ee-a744-229a7ae3353c",
                        "source_sense_id": "e0ee5007-fcba-3432-abee-8ead26ed98e8",
                        "target_lang_word": "histamina",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "histamina",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "ab8c1b17-de9a-3ec2-a759-ed571bfb674d",
                                        "entry_id": "419baab5-4ba1-3140-bba7-772524c696ae",
                                        "glosses": [
                                            "Molécula biológica categorizada químicamente como una amina, involucrada en la respuesta inmune local. También regula funciones normales en el estómago y actúa como neurotransmisor en el sistema nervioso central."
                                        ],
                                        "tags": [],
