                    {
                        "sense_id": "cb003726-2c4b-3771-b421-3fafa330eb47",
                        "entry_id": "8a3a8e8f-c23a-3fd8-b1c9-46f35267073e",
                        "glosses": [
                            "Dans un train, voiture spécialement aménagée pour les services religieux."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "616de643-0e72-4ce9-bc60-e35fb2f54f66",
                                "sense_id": "cb003726-2c4b-3771-b421-3fafa330eb47",
                                "text": "Il n’y a plus de voiture-chapelle, ni de bibliothèque ; il ne reste pas grand-chose, sinon deux voitures-lits, très luxueuses, pleines de fanfreluches, portant encore le nom de la compagnie internationale belge qui en assurait l’exploitation."
                            },
                            {
                                "example_id": "71c26856-826e-4c53-bc19-20be01c0d9a4",
                                "sense_id": "cb003726-2c4b-3771-b421-3fafa330eb47",
                                "text": "La première voiture-chapelle de Walker fut livrée en 1890. « La voiture cathédrale », comme on l’appela, voyagea plus de 70 000 miles au cours de ses dix années de service."
                            }
                        ]
                    }
