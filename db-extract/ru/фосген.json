                                    {
                                        "sense_id": "f9ef2694-104e-377a-bd42-ff51d69ce108",
                                        "entry_id": "9997c21f-6b31-30c4-bae9-dc038213d183",
                                        "glosses": [
                                            "carbonyl chloride"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77f6a9e0-5612-43c9-aa73-b76d012199e8",
                                                "sense_id": "f9ef2694-104e-377a-bd42-ff51d69ce108",
                                                "text": "“‘Poison gas’?” A new one on Lew. But Dr. De Bottle had taken on a somber look. “Phosgene.”"
                                            },
                                            {
                                                "example_id": "804c3273-f5d7-44ef-b386-62fad55fa455",
                                                "sense_id": "f9ef2694-104e-377a-bd42-ff51d69ce108",
                                                "text": "Remote and cold, H-276 is nevertheless of interest due to phosgene gas in its thick chlorine atmosphere. This could indicate primitive chlorine-based life. However, no detailed study has been completed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
