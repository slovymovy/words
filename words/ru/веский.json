                            {
                                "target_lang_word": "heavy",
                                "target_lang_sense_clarification": "having great weight"
                            },
                            {
                                "target_lang_word": "weighty",
                                "target_lang_sense_clarification": "having a noticeable or significant physical mass"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "pesado",
                                "target_lang_sense_clarification": "Que tiene gran peso físico."
                            },
                            {
                                "target_lang_word": "de gran peso",
                                "target_lang_sense_clarification": "Que posee una masa considerable."
                            }
                        ],
                        "fr": [
                            {
