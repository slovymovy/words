                                    },
                                    {
                                        "sense_id": "672b2f31-bb06-3ab7-8fc3-6cad50817428",
                                        "entry_id": "b6106a06-4bef-3486-87eb-ed01c0c489c1",
                                        "glosses": [
                                            "nicht vernünftig; unnatürlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8457a9b2-6bd4-4eb1-917d-a152957328c1",
                                                "sense_id": "672b2f31-bb06-3ab7-8fc3-6cad50817428",
                                                "text": "Viele stürzen sich dann mit ungesundem Ehrgeiz in das Projekt Sport. (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "1b59b984-fe29-4d82-9f6a-f334d6be1b16",
                                                "sense_id": "672b2f31-bb06-3ab7-8fc3-6cad50817428",
                                                "text": "Wir haben ja in Deutschland eine ungesunde Tradition, unsere Talente früh mit überhohen Erwartungen zu befrachten. (Internetbeleg)"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
