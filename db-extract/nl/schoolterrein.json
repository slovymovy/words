                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3814f9b9-d94c-48fa-882e-79dbf09c04a3",
                                "sense_id": "a0df4742-1730-3ff2-a515-62d942f5dec9",
                                "text": "Op het schoolterrein, in de gangen, op weg naar en in de klas moeten leerlingen en docenten een mondmasker op. De deelstaat is de eerste die het voor middelbare scholieren ook verplicht maakt om kapjes in het klaslokaal te dragen. Op de regel gelden wel uitzonderingen."
                            },
                            {
                                "example_id": "5a32189d-7529-42fc-8de1-69256a7da10a",
                                "sense_id": "a0df4742-1730-3ff2-a515-62d942f5dec9",
                                "text": "Hij is aangehouden voor het negeren van een plaatselijke noodverordening en mag voorlopig niet op het schoolterrein komen."
                            }
                        ]
                    }
