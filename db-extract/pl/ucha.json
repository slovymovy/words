                    {
                        "translation_id": "61b24487-6f78-413b-b6b2-f6970151f0d7",
                        "source_entry_id": "42f87de7-f7d3-3363-9010-f48fac76d62f",
                        "source_sense_id": "ec8a3b75-8221-31a7-963c-72823c877197",
                        "target_lang_word": "уха",
                        "target_lang_code": "ru",
