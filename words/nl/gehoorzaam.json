                    "sense_definition": "gebiedende wijs van <w>gehoorzamen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verbuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Gehoorzaam</w> onmiddellijk de instructies van de brandweer!",
                            "target_lang_translations": {
