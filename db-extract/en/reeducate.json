                                "target_senses": [
                                    {
                                        "sense_id": "b5e21c27-6adb-35a0-a10c-30a554ef7c2d",
                                        "entry_id": "e5fe9cc4-a8a6-3b89-bec0-02759e544a12",
                                        "glosses": [
                                            "jemanden, unter Umständen auch unter Zwang, dazu bringen, sein Verhalten zu ändern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28388371-c6a0-4614-8b9f-d192a85d2f11",
                                                "sense_id": "b5e21c27-6adb-35a0-a10c-30a554ef7c2d",
                                                "text": "Kriegsgefangene sollten durch Zwangsarbeit umerzogen werden."
                                            },
                                            {
                                                "example_id": "952e6086-f65f-4ae8-b624-0d51124c591e",
                                                "sense_id": "b5e21c27-6adb-35a0-a10c-30a554ef7c2d",
                                                "text": "Was passierte, wenn man alle Linkshänder einfach umerzöge?"
                                            },
                                            {
                                                "example_id": "0af824f3-d85b-4194-b557-307a41b56e35",
                                                "sense_id": "b5e21c27-6adb-35a0-a10c-30a554ef7c2d",
                                                "text": "Der Braunbär „JJ1“, der als Problembär bekannt wurde, sollte zunächst umerzogen werden, wurde dann aber doch zum Abschuss freigegeben."
                                            },
                                            {
                                                "example_id": "bac80f1d-51d8-4a43-ba75-ff423128093b",
                                                "sense_id": "b5e21c27-6adb-35a0-a10c-30a554ef7c2d",
                                                "text": "Kann man einen verhaltensgestörten Hund selber umerziehen?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
