                        "glosses": [
                            "Weg, der eine Abkürzung darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6981b81a-dd28-4b63-b9f1-c62e9f61906e",
                                "sense_id": "e1b348ec-59df-3f37-8f21-17629827ba05",
                                "text": "„Als der Weg einen nackten Bergkegel hinaufgeht, wo wir ihn im Zickzack bis zum Gipfel hinauf verfolgen können, steigen wir ab und schlagen den Richtweg ein, während der Wagen sich uns nachschlängelt, bis er uns erreicht hat.“"
                            },
                            {
                                "example_id": "1b7a0ac5-41fe-4075-b925-29d5537b7043",
                                "sense_id": "e1b348ec-59df-3f37-8f21-17629827ba05",
                                "text": "„Das Hügelgräberfeld wird vom so genannten ‚Loruper Richtweg‘, einem gerade verlaufenden Heideweg tangiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
