                "senses": [
                    {
                        "sense_id": "720bdd6a-f694-3f67-8b57-a5c8956e9007",
                        "entry_id": "25159769-187b-3985-b621-f779b3390eef",
                        "glosses": [
                            "een kort uitgewerkt schema voor de handeling van een dramatisch werk, zoals een toneelstuk, opera of film"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e25fd8db-23aa-4b0f-abd9-e6436ce8e73b",
                                "sense_id": "720bdd6a-f694-3f67-8b57-a5c8956e9007",
                                "text": "Niet dat The Favourite zich iets aantrekt van de werkelijkheid, of hoe die werkelijkheid er in films over die periode doorgaans uitziet. Dat komt door het smeuïge scenario van Deborah Davis en Tony McNamara, vol seks en jaloezie, verraad en vulgariteiten. Het woord ‘kutwijf’ valt verrassend vaak."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad6365c9-affd-3516-8091-1f90866d4f6e",
                        "entry_id": "25159769-187b-3985-b621-f779b3390eef",
                        "glosses": [
                            "een samenvattend overzicht van de chronologische samenhang tussen bepaalde gebeurtenissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce169870-4aae-4168-a2aa-57e33bb65d6a",
                                "sense_id": "ad6365c9-affd-3516-8091-1f90866d4f6e",
                                "text": "Als de aarde de komende vijftig jaar in het huidige tempo blijft opwarmen, komen in het somberste scenario zo'n drie miljard mensen in de problemen: hun leefgebied is dan in 2070 te warm om er te kunnen leven."
                            },
                            {
                                "example_id": "8ca4460a-9c5f-4dd9-9a22-e0745a6e43e6",
                                "sense_id": "ad6365c9-affd-3516-8091-1f90866d4f6e",
                                "text": "De wildste scenario’s vlogen door mijn hoofd."
                            },
                            {
                                "example_id": "d7aa47bc-7e4a-4244-b77b-acbb4faad4cf",
                                "sense_id": "ad6365c9-affd-3516-8091-1f90866d4f6e",
                                "text": "Het ministerie gaat er in ieder geval van uit dat na de zomer \"de kwetsbaarsten\" opnieuw een prik kunnen krijgen. Het gaat dan vooral om ouderen. Er wordt ook rekening gehouden met een scenario waarbij de hele bevolking vanaf achttien jaar een vaccinatie wordt aangeboden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f467e030-b9e7-451b-ab21-d99586da1a29",
                        "source_entry_id": "25159769-187b-3985-b621-f779b3390eef",
                        "source_sense_id": "720bdd6a-f694-3f67-8b57-a5c8956e9007",
                        "source_sense_description": "een kort uitgewerkt schema voor de handeling van een dramatisch werk",
                        "target_lang_word": "scenario",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
