    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fed4d60a-921b-310a-95ab-887354fa33bd",
                    "sense_definition": "To throw something forcefully in a specific direction.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "throwing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fisherman <w>cast</w> his line far out into the lake.",
                            "target_lang_translations": {
                                "ru": "Рыбак <w>забросил</w> леску далеко в озеро.",
                                "zh": "渔夫把鱼线远远地<w>抛</w>进了湖里。"
                            }
                        },
                        {
                            "text": "She <w>cast</w> the stone into the river and watched the ripples.",
                            "target_lang_translations": {
                                "ru": "Она <w>бросила</w> камень в реку и смотрела на рябь.",
                                "zh": "她把石头<w>扔</w>进河里，看着水面泛起涟漪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "throw",
                        "toss",
                        "fling",
                        "hurl",
                        "pitch"
                    ],
                    "antonyms": [
                        "catch",
                        "hold"
                    ],
                    "common_phrases": [
                        "cast aside",
                        "cast away",
                        "cast off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бросать что-либо с силой в определенном направлении.",
                        "zh": "用力把某物朝某个方向扔出去。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "закидывать",
                                "target_lang_sense_clarification": "о удочке или неводе"
                            },
                            {
                                "target_lang_word": "кидать",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抛",
                                "target_lang_sense_clarification": "一般指用力朝某个方向扔出去"
                            },
                            {
                                "target_lang_word": "扔",
                                "target_lang_sense_clarification": "较口语化的“扔”"
                            },
                            {
                                "target_lang_word": "甩出",
                                "target_lang_sense_clarification": "尤指甩出鱼线、网等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e84f12b9-a1ae-3c9a-8dac-0a0e5dc75aeb",
                    "sense_definition": "To assign a specific role to an actor in a play, movie, or broadcast.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director decided to <w>cast</w> an unknown actor as the lead hero.",
                            "target_lang_translations": {
                                "ru": "Режиссер решил <w>взять на роль</w> главного героя неизвестного актера.",
                                "zh": "导演决定<w>选中</w>一位无名演员<w>饰演</w>男主角。"
                            }
                        },
                        {
                            "text": "She was <w>cast</w> in the role of the villain despite her sweet appearance.",
                            "target_lang_translations": {
                                "ru": "Её <w>утвердили</w> на роль злодейки, несмотря на её милую внешность.",
                                "zh": "尽管她外表甜美，还是被<w>选中</w><w>饰演</w>反派。"
                            }
                        }
                    ],
                    "synonyms": [
                        "select",
                        "choose",
                        "appoint",
                        "pick",
                        "assign"
                    ],
                    "common_phrases": [
                        "cast as",
                        "cast in a role"
                    ],
                    "target_lang_definitions": {
                        "ru": "Назначать актера на определенную роль в пьесе, фильме или передаче.",
                        "zh": "指定某位演员在戏剧、电影或节目中扮演某个角色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брать на роль",
                                "target_lang_sense_clarification": "нанимать актера"
                            },
                            {
                                "target_lang_word": "распределять роли",
                                "target_lang_sense_clarification": "процесс подбора"
                            },
                            {
                                "target_lang_word": "утверждать",
                                "target_lang_sense_clarification": "окончательно выбирать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "选中……饰演",
                                "target_lang_sense_clarification": "选定某人来扮演某角色"
                            },
                            {
                                "target_lang_word": "选定……出演",
                                "target_lang_sense_clarification": "正式确定演员出演某角色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f442e1e-bafe-3a9c-9c79-dc6eaf03b152",
                    "sense_definition": "To register a vote formally in an election.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "voting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every citizen has the right to <w>cast</w> a ballot in the upcoming election.",
                            "target_lang_translations": {
                                "ru": "Каждый гражданин имеет право <w>проголосовать</w> на предстоящих выборах.",
                                "zh": "每位公民都有权在即将到来的选举中<w>投票</w>。"
                            }
                        },
                        {
                            "text": "He arrived at the polling station early to <w>cast</w> his vote.",
                            "target_lang_translations": {
                                "ru": "Он прибыл на избирательный участок пораньше, чтобы <w>отдать</w> свой голос.",
                                "zh": "他早早来到投票站去<w>投下</w>自己的一票。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cast a vote",
                        "cast a ballot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально отдавать свой голос на выборах.",
                        "zh": "在选举中正式投票。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голосовать",
                                "target_lang_sense_clarification": "участвовать в выборах"
                            },
                            {
                                "target_lang_word": "отдавать голос",
                                "target_lang_sense_clarification": "фразеологизм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投票",
                                "target_lang_sense_clarification": "正式参加选举并投出选票"
                            },
                            {
                                "target_lang_word": "投下",
                                "target_lang_sense_clarification": "强调把自己的一票投出去"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d330f3fa-0cc9-379a-89c2-5569f274986c",
                    "sense_definition": "To cause light or shadow to appear on a surface.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "projection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The setting sun <w>cast</w> a long shadow across the grass.",
                            "target_lang_translations": {
                                "ru": "Заходящее солнце <w>отбрасывало</w> длинную тень на траву.",
                                "zh": "落日向草地上<w>投下</w>了一道长长的影子。"
                            }
                        },
                        {
                            "text": "The fireplace <w>cast</w> a warm glow over the entire room.",
                            "target_lang_translations": {
                                "ru": "Камин <w>отбрасывал</w> теплый отблеск на всю комнату.",
                                "zh": "壁炉向整个房间<w>洒下</w>温暖的光。"
                            }
                        }
                    ],
                    "synonyms": [
                        "project",
                        "throw"
                    ],
                    "common_phrases": [
                        "cast a shadow",
                        "cast light on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать свет или тень на поверхности.",
                        "zh": "使光或影子出现在某个表面上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отбрасывать",
                                "target_lang_sense_clarification": "о тени"
                            },
                            {
                                "target_lang_word": "проливать",
                                "target_lang_sense_clarification": "о свете"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投下",
                                "target_lang_sense_clarification": "指投下阴影、光线等"
                            },
                            {
                                "target_lang_word": "洒下",
                                "target_lang_sense_clarification": "多指光线洒向某处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b1214cf-81fe-38bf-b990-1a608666ab81",
                    "sense_definition": "To perform a magical spell.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "magic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wizard raised his staff to <w>cast</w> a powerful spell.",
                            "target_lang_translations": {
                                "ru": "Волшебник поднял посох, чтобы <w>наложить</w> мощное заклятие.",
                                "zh": "巫师举起法杖，准备<w>施展咒语</w>。"
                            }
                        },
                        {
                            "text": "In the story, the witch <w>cast</w> a curse on the sleeping kingdom.",
                            "target_lang_translations": {
                                "ru": "В сказке ведьма <w>наложила</w> проклятие на спящее королевство.",
                                "zh": "在故事里，女巫对沉睡的王国<w>下咒</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cast a spell",
                        "cast a curse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Произносить или накладывать магическое заклинание.",
                        "zh": "施放魔法咒语或诅咒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накладывать",
                                "target_lang_sense_clarification": "о заклятии или чарах"
                            },
                            {
                                "target_lang_word": "произносить",
                                "target_lang_sense_clarification": "читать заклинание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "施展咒语",
                                "target_lang_sense_clarification": "施放魔法或咒语"
                            },
                            {
                                "target_lang_word": "下咒",
                                "target_lang_sense_clarification": "对人或地方施加诅咒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7eae872d-dd50-3c0e-b569-891156203b62",
                    "sense_definition": "To direct one's eyes or look in a particular direction.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "looking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>cast</w> a quick glance at the clock to check the time.",
                            "target_lang_translations": {
                                "ru": "Она <w>бросила</w> быстрый взгляд на часы, чтобы проверить время.",
                                "zh": "她朝时钟<w>投去</w>了匆匆一瞥，想看看时间。"
                            }
                        },
                        {
                            "text": "He <w>cast</w> his eyes downward in shame when the teacher scolded him.",
                            "target_lang_translations": {
                                "ru": "Он <w>опустил</w> глаза от стыда, когда учитель ругал его.",
                                "zh": "老师责备他时，他羞愧地<w>垂下</w>了目光。"
                            }
                        }
                    ],
                    "synonyms": [
                        "direct",
                        "turn"
                    ],
                    "common_phrases": [
                        "cast a glance",
                        "cast an eye"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направлять взгляд или смотреть в определенном направлении.",
                        "zh": "把视线朝某个方向投去。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "о взгляде"
                            },
                            {
                                "target_lang_word": "опускать",
                                "target_lang_sense_clarification": "направлять глаза вниз"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投去",
                                "target_lang_sense_clarification": "多用于“投去一瞥、目光”"
                            },
                            {
                                "target_lang_word": "垂下",
                                "target_lang_sense_clarification": "指把目光向下移"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b11d4d2-c9af-3474-b641-66007d06b9bc",
                    "sense_definition": "To shape molten metal or other liquid material by pouring it into a mould.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "moulding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist <w>cast</w> the statue in bronze using a traditional method.",
                            "target_lang_translations": {
                                "ru": "Художник <w>отлил</w> статую из бронзы, используя традиционный метод.",
                                "zh": "艺术家用传统方法把这座雕像<w>铸造</w>成青铜。"
                            }
                        },
                        {
                            "text": "They <w>cast</w> the engine parts from aluminum to make them lightweight.",
                            "target_lang_translations": {
                                "ru": "Они <w>отлили</w> детали двигателя из алюминия, чтобы сделать их легкими.",
                                "zh": "他们用铝来<w>浇铸</w>发动机零件，以减轻重量。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mould",
                        "form",
                        "shape"
                    ],
                    "common_phrases": [
                        "cast in bronze",
                        "cast iron"
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать форму расплавленному металлу или другому жидкому материалу, заливая его в форму.",
                        "zh": "把熔化的金属或其他液态材料倒入模具中，使其成形。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отливать",
                                "target_lang_sense_clarification": "изготавливать литьем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铸造",
                                "target_lang_sense_clarification": "把熔化材料倒入模具成形"
                            },
                            {
                                "target_lang_word": "浇铸",
                                "target_lang_sense_clarification": "强调把液态材料浇入模具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec3c1f07-06ec-3144-bad6-1549fb4006f4",
                    "sense_definition": "To send video or audio content wirelessly from a device to a larger screen or speaker.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can <w>cast</w> the movie from your phone to the television.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>транслировать</w> фильм с телефона на телевизор.",
                                "zh": "你可以把手机里的电影<w>投屏</w>到电视上。"
                            }
                        },
                        {
                            "text": "I will <w>cast</w> my screen so everyone in the meeting can see the presentation.",
                            "target_lang_translations": {
                                "ru": "Я буду <w>транслировать</w> свой экран, чтобы все на собрании видели презентацию.",
                                "zh": "我会<w>投屏</w>，这样开会的人都能看到演示文稿。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stream",
                        "broadcast"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in technology contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать видео или аудиоконтент по беспроводной связи с устройства на большой экран или динамик.",
                        "zh": "把设备上的视频、音频或屏幕内容无线传送到更大的屏幕或扬声器上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "транслировать",
                                "target_lang_sense_clarification": "передавать сигнал на экран"
                            },
                            {
                                "target_lang_word": "стримить",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投屏",
                                "target_lang_sense_clarification": "把手机、电脑上的画面或声音传到电视等设备上"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9553040-6da2-353c-aa38-accf638bc7e0",
                    "sense_definition": "To throw off skin, horns, or leaves as a natural process.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "shedding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The snake will <w>cast</w> its skin several times a year as it grows.",
                            "target_lang_translations": {
                                "ru": "Змея <w>сбрасывает</w> кожу несколько раз в год по мере роста.",
                                "zh": "蛇在生长过程中每年会多次<w>蜕皮</w>。"
                            }
                        },
                        {
                            "text": "In autumn, the trees <w>cast</w> their leaves to prepare for winter.",
                            "target_lang_translations": {
                                "ru": "Осенью деревья <w>сбрасывают</w> листву, готовясь к зиме.",
                                "zh": "到了秋天，树木会<w>落叶</w>，为过冬做准备。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shed",
                        "moult",
                        "slough"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбрасывать кожу, рога или листья в качестве естественного процесса.",
                        "zh": "作为自然过程，脱去皮、角或叶子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбрасывать",
                                "target_lang_sense_clarification": "избавляться от покрова"
                            },
                            {
                                "target_lang_word": "линять",
                                "target_lang_sense_clarification": "о животных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蜕皮",
                                "target_lang_sense_clarification": "动物脱去皮"
                            },
                            {
                                "target_lang_word": "落叶",
                                "target_lang_sense_clarification": "树木自然掉叶子"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0349a6bd-36ac-3df4-b7d3-aa64e7791f1d",
                    "sense_definition": "The group of actors performing in a play, movie, or television show.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "performance_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire <w>cast</w> came on stage to bow at the end of the performance.",
                            "target_lang_translations": {
                                "ru": "Весь <w>актерский состав</w> вышел на сцену, чтобы поклониться в конце представления.",
                                "zh": "演出结束时，整个<w>演员阵容</w>都上台谢幕了。"
                            }
                        },
                        {
                            "text": "She was excited to join the <w>cast</w> of the new musical.",
                            "target_lang_translations": {
                                "ru": "Она была рада присоединиться к <w>труппе</w> нового мюзикла.",
                                "zh": "她很高兴能加入这部新音乐剧的<w>演员阵容</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "troupe",
                        "company",
                        "actors",
                        "performers"
                    ],
                    "antonyms": [
                        "crew",
                        "audience"
                    ],
                    "common_phrases": [
                        "all-star cast",
                        "cast member",
                        "cast list"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа актеров, играющих в пьесе, фильме или телешоу.",
                        "zh": "在戏剧、电影或电视节目中出演的那组演员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "актерский состав",
                                "target_lang_sense_clarification": "совокупность актеров"
                            },
                            {
                                "target_lang_word": "труппа",
