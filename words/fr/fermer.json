{
    "word_family": [
        "enfermer",
        "fermeture",
        "fermoir",
        "refermer",
        "renfermer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a793a57d-f083-336d-b5e2-dcf8774846e3",
                    "sense_definition": "Rabattre un battant, une porte ou un panneau de manière à boucher une ouverture.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "clôture matérielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pense à <w>fermer</w> la porte à clé avant de partir au travail ce matin."
                        },
                        {
                            "text": "Il fait très froid dehors alors nous <w>fermons</w> toutes les fenêtres du salon."
                        }
                    ],
                    "synonyms": [
                        "clore"
                    ],
                    "antonyms": [
                        "ouvrir"
                    ],
                    "common_phrases": [
                        "fermer la porte",
                        "fermer la fenêtre",
                        "fermer à clé"
                    ]
                },
                {
                    "sense_id": "533c88f9-817b-30dc-8b21-8ff080486ae6",
                    "sense_definition": "Rapprocher les parties d'une chose ouverte pour qu'elle ne le soit plus, comme les yeux, la bouche ou un livre.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "rapprochement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bébé était tellement fatigué qu'il a fini par <w>fermer</w> les yeux."
                        },
                        {
                            "text": "Tu devrais <w>fermer</w> ton livre et dormir un peu maintenant."
                        }
                    ],
                    "antonyms": [
                        "ouvrir"
                    ],
                    "common_phrases": [
                        "fermer les yeux",
                        "fermer la bouche"
                    ]
                },
                {
                    "sense_id": "0d70a15e-ed37-3b5f-ae38-a9f51dcd0266",
                    "sense_definition": "Interrompre temporairement ou définitivement l'accès du public ou l'activité d'un commerce ou d'un établissement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "activité commerciale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce supermarché <w>ferme</w> ses portes à vingt heures tous les soirs."
                        },
                        {
                            "text": "La boulangerie du quartier va <w>fermer</w> définitivement à la fin de la semaine."
                        }
                    ],
                    "synonyms": [
                        "clore"
                    ],
                    "antonyms": [
                        "ouvrir"
                    ],
                    "common_phrases": [
                        "fermer boutique",
                        "fermer ses portes"
                    ]
                },
                {
                    "sense_id": "2bcdf3c1-7698-33c4-b56b-2925a7275f97",
                    "sense_definition": "Bloquer un passage, une voie ou une issue pour empêcher toute circulation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clôture matérielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police a dû <w>fermer</w> la route à cause d'un grave accident."
                        },
                        {
                            "text": "Des barrières métalliques <w>ferment</w> l'accès aux voies piétonnes ce week-end."
                        }
                    ],
                    "antonyms": [
                        "ouvrir"
                    ],
                    "common_phrases": [
                        "fermer la route",
                        "fermer le passage"
                    ]
                },
                {
                    "sense_id": "5bbaacdc-e2a6-3d3e-a034-ab03334009a5",
                    "sense_definition": "Mettre un terme à quelque chose, en arrêter le cours ou le déroulement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "interruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le client a décidé de <w>fermer</w> son compte bancaire après plusieurs désaccords."
                        },
                        {
                            "text": "Le président a choisi de <w>fermer</w> les débats avant le vote final."
                        }
                    ],
                    "synonyms": [
                        "clore"
                    ],
                    "antonyms": [
                        "ouvrir"
                    ],
                    "common_phrases": [
                        "fermer un compte",
                        "fermer les débats"
                    ]
                },
                {
                    "sense_id": "4fba5368-7267-34d5-bde7-3a4acd63b6c4",
                    "sense_definition": "Se replier sur soi-même et refuser tout échange ou toute communication avec autrui.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès qu'on aborde ce sujet délicat, il se <w>ferme</w> complètement à toute discussion."
                        },
                        {
                            "text": "Face aux critiques sévères de ses collègues, elle s'est <w>fermée</w> immédiatement."
                        }
                    ],
                    "antonyms": [
                        "ouvrir"
                    ],
                    "common_phrases": [
                        "se fermer au dialogue"
                    ]
                }
            ]
        }
    ]
}