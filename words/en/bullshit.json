                    "sense_definition": "To have a casual conversation with no specific purpose.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We just sat around and <w>bullshitted</w> for a few hours after work.",
                            "target_lang_translations": {
                                "ru": "Мы просто сидели и <w>трепались</w> несколько часов после работы.",
                                "zh": "下班后我们就坐在那里<w>闲扯</w>了几个小时。"
                            }
                        },
