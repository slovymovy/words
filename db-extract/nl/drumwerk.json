                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24bc06e8-a3bf-4a96-993c-ac62a24d9a23",
                                "sense_id": "76f06a1f-06cf-3747-be56-bc1d95c3f9b9",
                                "text": "Een vleugje folk, makkelijk in het gehoor liggend, met lekker veel lef, sterke baslijntjes, stevig drumwerk en dat heerlijke zoete gegrom van Billy Dunne."
                            },
                            {
                                "example_id": "1f707adc-046b-452d-9135-079aa50acd30",
                                "sense_id": "76f06a1f-06cf-3747-be56-bc1d95c3f9b9",
                                "text": "Het optreden werd gered door ellenlange maar hoogstaande gitaarsolo en het betere drumwerk. 'All across the Sands' en 'She bangs the drums' zijn de enige nummers die swingen, waardoor de frontman er eindelijk zin in lijkt te krijgen. Het viertal sloot af met een lange versie van 'I am the resurrection', iets wat ze in Amsterdam nog nalieten."
                            }
                        ]
                    }
