                        "source_entry_id": "b3352b8a-f2ff-36f4-b839-24c765dff64d",
                        "source_sense_id": "4602f4b4-4135-3960-88fb-68fe795c88ce",
                        "source_sense_description": "attack made in response to a previous offensive",
                        "target_lang_word": "контрнаступле́ние",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "контрнаступле́ние",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bafa0e61-fddb-371b-967a-92e4a9cebb78",
                                        "entry_id": "f3f159d5-f4cc-3aad-8711-87df712f3f2c",
                                        "glosses": [
                                            "воен. ответное наступление на противника, подготовленное в ходе оборонительных действий"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "325c861d-d764-4992-b0ee-f5b212fdc8ee",
                                                "sense_id": "bafa0e61-fddb-371b-967a-92e4a9cebb78",
                                                "text": "Надо было думать лишь о том, чтобы сберечь армию впредь до прибытия подкреплений и возможности с помощью их перейти в контрнаступление."
                                            },
                                            {
                                                "example_id": "f56b164d-659a-4460-b52c-fcabb44887b5",
                                                "sense_id": "bafa0e61-fddb-371b-967a-92e4a9cebb78",
                                                "text": "Провалились все зимние контрнаступления, в крови утонул десант Мехлиса под Керчью (но: так как его Сталин и придумал, то никого серьёзно не наказывал), ― всё равно, не слушая возражений ставочных генералов, Верховный затеял в мае несчастную попытку вернуть Харьков ― и растранжирил бесплодно все наши резервы и усилия."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a71f2ec3-5024-38e3-903e-a00c0f92f30a",
                                        "entry_id": "f3f159d5-f4cc-3aad-8711-87df712f3f2c",
                                        "glosses": [
                                            "перен., : активное противодействие кому-, чему-либо с целью не дать добиться противоположной стороне желаемых результатов"
                                        ],
                                        "tags": [
                                            "на кого, на что"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1449ebee-92f9-4bb0-84bd-12eec09d3b09",
                                                "sense_id": "a71f2ec3-5024-38e3-903e-a00c0f92f30a",
                                                "text": "Нужно постоянно ожидать нападения контрреволюции. Но при первой её попытке сорвать съезд и перейти в наступление мы ответим контрнаступлением, которое будет беспощадным и которое мы доведём до конца."
                                            },
                                            {
                                                "example_id": "d8a27c46-4245-4e81-a8f2-9f0f7b7f410d",
                                                "sense_id": "a71f2ec3-5024-38e3-903e-a00c0f92f30a",
                                                "text": "«Поздравляю с ангелом дорогого племянника!» ― писал дядька, и Черимов понял, что Матвей Никеич в свою очередь предпринимает контрнаступление на него."
                                            }
                                        ]
                                    }
                                ]
                            }
