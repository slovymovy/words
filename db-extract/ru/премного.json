                "forms": [],
                "senses": [
                    {
                        "sense_id": "75b6d26a-559c-3a17-9b67-f454333230eb",
                        "entry_id": "92117759-db55-3248-a7c7-e5aaddd68134",
                        "glosses": [
                            "устар. очень, в высшей степени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dfe35c5-441e-4213-be58-3a77a3ec8e84",
                                "sense_id": "75b6d26a-559c-3a17-9b67-f454333230eb",
                                "text": "Оттого и уехали чужеземцы ― ошеломленные и, сдается мне, премного уязвленные."
                            },
                            {
                                "example_id": "7b617675-aef5-4fad-85c6-19a18e803b0d",
                                "sense_id": "75b6d26a-559c-3a17-9b67-f454333230eb",
                                "text": "Африканцы остались турбинами премного довольны и посетовали, что у господина Кольцова нельзя купить корабль целиком."
                            },
                            {
                                "example_id": "f64cb7f8-0027-4c67-b3f4-6586525017f8",
                                "sense_id": "75b6d26a-559c-3a17-9b67-f454333230eb",
                                "text": "Вы меня премного обяжете, если позвоните мне через пятнадцать минут."
                            }
                        ]
                    },
                    {
                        "sense_id": "8289cefd-42db-3187-bb06-31bfa6b758f2",
                        "entry_id": "92117759-db55-3248-a7c7-e5aaddd68134",
                        "glosses": [
                            "устар. очень много"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23ede941-b9e5-430c-a093-0a3a11e422de",
                                "sense_id": "8289cefd-42db-3187-bb06-31bfa6b758f2",
                                "text": "Одним словом, труда высшему правительству предстоит премного"
                            },
                            {
                                "example_id": "355cbe08-67ed-419d-bd35-ffb29f9a3c39",
                                "sense_id": "8289cefd-42db-3187-bb06-31bfa6b758f2",
                                "text": "Здесь в торговые дни бывает хуже, чем на сражении: съезжается народу премного."
                            }
                        ]
                    }
                ],
