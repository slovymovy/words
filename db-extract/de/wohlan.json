                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "now then",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a0c049d-aba0-33ff-8e19-b65ce99f2244",
                                        "entry_id": "33a12aaf-f275-318b-831d-b5712f935450",
                                        "glosses": [
                                            "Used to move or return to another subject of discussion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21096beb-fc87-4938-911a-eaf618ddadab",
                                                "sense_id": "5a0c049d-aba0-33ff-8e19-b65ce99f2244",
                                                "text": "Now then, what shall we do?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa345ed9-3b67-33de-9eca-8f5560f04d10",
                                        "entry_id": "33a12aaf-f275-318b-831d-b5712f935450",
                                        "glosses": [
                                            "A mild admonishment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faa77e2e-c445-48d7-a568-51f603103850",
                                                "sense_id": "aa345ed9-3b67-33de-9eca-8f5560f04d10",
                                                "text": "Now then, don't hit your brother!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "468158b0-ba6b-338d-9c20-6f3e4a29ca08",
                                        "entry_id": "33a12aaf-f275-318b-831d-b5712f935450",
                                        "glosses": [
                                            "A greeting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11507df5-ad23-4c40-ad7e-3e873bdc4741",
                                                "sense_id": "468158b0-ba6b-338d-9c20-6f3e4a29ca08",
                                                "text": "Now then, John, what you up to?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48597cbd-605b-4ddf-9d3e-5db3a06c46fa",
                        "source_entry_id": "f53cabb7-8a0e-3fd0-b722-06491c2b1a99",
                        "source_sense_id": "d675a144-fea3-330f-87a4-387681cdf6fa",
                        "source_sense_description": "veraltend: nun denn",
                        "target_lang_word": "eh bien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eh bien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c50d897-3e72-3e5c-966b-fc97cfae157e",
                                        "entry_id": "49f5808e-4155-3690-bfd8-70156487e82f",
                                        "glosses": [
                                            "Renforcement expressif du ressenti pour marquer la surprise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3813c5d1-cac5-4a1a-8b3a-1eae3de8baf0",
                                                "sense_id": "9c50d897-3e72-3e5c-966b-fc97cfae157e",
                                                "text": "Caroline aura peut-être un moment d’estomaquement ! Elle dira peut-être : « Eh bien !… Eh ben ! quoi donc ? » Mais elle aura du moins l’attrait de la surprise et l’effet n’aura pas été raté."
                                            },
                                            {
                                                "example_id": "899fc5a7-29b0-43ea-968f-3276d5c51c6f",
                                                "sense_id": "9c50d897-3e72-3e5c-966b-fc97cfae157e",
                                                "text": "« Eh bien, dis donc, tu ne te refuses rien ! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d1a3c04-a465-33ec-a26f-85fdbdde7724",
                                        "entry_id": "49f5808e-4155-3690-bfd8-70156487e82f",
                                        "glosses": [
                                            "Renforcement expressif du ressenti pour marquer l’admiration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e6b1388-53a4-493d-8129-8cb75e8ec49c",
                                                "sense_id": "6d1a3c04-a465-33ec-a26f-85fdbdde7724",
                                                "text": "Eh bien ! Ça en jette dis donc ! C’est toi qui l’as sculpté ?"
                                            },
                                            {
                                                "example_id": "317d4239-34ba-4dbc-97a1-8b33db8c69d4",
                                                "sense_id": "6d1a3c04-a465-33ec-a26f-85fdbdde7724",
                                                "text": "Eh bien, c’est un beau bébé que vous avez là !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f10e8883-00d6-3a6f-bdf9-f09714102504",
                                        "entry_id": "49f5808e-4155-3690-bfd8-70156487e82f",
                                        "glosses": [
                                            "Renforcement expressif du ressenti pour marquer l’interrogation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4cdbf0e-f45f-41af-a8e1-75f4e52a7452",
                                                "sense_id": "f10e8883-00d6-3a6f-bdf9-f09714102504",
                                                "text": "Eh bien ! mon bonhomme, qu’y a-t-il donc là ? demanda Blondel après un gros quart d’heure pendant lequel il n’aperçut rien qui motivât cette profonde attention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22f860cd-8cf0-3577-bfa5-94ead7b7bd81",
                                        "entry_id": "49f5808e-4155-3690-bfd8-70156487e82f",
                                        "glosses": [
                                            "Renforcement expressif du ressenti pour marquer l’irritation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51326068-9080-4263-a104-3645f1dc6b22",
                                                "sense_id": "22f860cd-8cf0-3577-bfa5-94ead7b7bd81",
                                                "text": "Et des gars flippants, qu'heureusement pour toi tu n'as jamais rencontrés, et que tu ne veux vraiment pas connaître, eh bien ces gars flippants vont s'en prendre à elle. Voilà ce que je dis."
                                            },
                                            {
                                                "example_id": "37bbd744-d7da-46a5-b41d-b117749d9ccf",
                                                "sense_id": "22f860cd-8cf0-3577-bfa5-94ead7b7bd81",
                                                "text": "Eh bien, c’est du propre tout ça, un vrai chantier. Dis-moi, tu comptes t’y mettre un de ces jours ou tu attends la Saint-Glinglin ?"
                                            },
                                            {
                                                "example_id": "a291f2a1-2b6f-4214-83cd-6b60b69bccb4",
                                                "sense_id": "22f860cd-8cf0-3577-bfa5-94ead7b7bd81",
                                                "text": "Eh bien, que veux-tu que j’y fasse ? Tu as une meilleure idée ? Non ? Bon. Bah boucle-la alors !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1017c6e-c1f9-3055-adb5-5463ed5c976f",
                                        "entry_id": "49f5808e-4155-3690-bfd8-70156487e82f",
                                        "glosses": [
                                            "Renforcement expressif du ressenti pour marquer l’ironie, en feignant un ressenti, un sentiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0818dd85-180b-471e-bd4c-b781d255e4f0",
                                                "sense_id": "a1017c6e-c1f9-3055-adb5-5463ed5c976f",
                                                "text": "Eh bien, regardez qui voilà ; ne serait-ce pas notre intrus ?"
                                            },
                                            {
                                                "example_id": "44ef2418-47d0-46c9-a1e7-f500578e2111",
                                                "sense_id": "a1017c6e-c1f9-3055-adb5-5463ed5c976f",
                                                "text": "Eh bien, ça ne m’a pas l’air de respirer la légalité tout ça, j’espère quand même que tu fais preuve de prudence dans tes affaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b655530-0118-35e4-accd-2b46cee1bb56",
                                        "entry_id": "49f5808e-4155-3690-bfd8-70156487e82f",
                                        "glosses": [
                                            "Explétif, avant des mots courts mais importants, ou pour gagner du temps lorsque l’on ne sait pas ce que l’on va dire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a2e9ace-eebe-4d81-85aa-cca65a1b552b",
                                                "sense_id": "6b655530-0118-35e4-accd-2b46cee1bb56",
                                                "text": "Eh bien, soit !"
                                            },
                                            {
                                                "example_id": "d5b7ade1-ea1f-4b4f-8d23-682f7ad46578",
                                                "sense_id": "6b655530-0118-35e4-accd-2b46cee1bb56",
                                                "text": "Eh bien, va ! Si telle est ta destinée."
                                            },
                                            {
                                                "example_id": "e1515c9c-fdf4-4706-8024-5259f6e994f4",
                                                "sense_id": "6b655530-0118-35e4-accd-2b46cee1bb56",
                                                "text": "Eh bien… je n’en ai pas la moindre idée en fait."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eh bien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00a8ae1c-bad9-3331-8fc9-89ddb471280f",
                                        "entry_id": "59ede902-2252-3aac-bd9a-46f9875bcb2c",
                                        "glosses": [
                                            "En tant que connecteur logique, sert à introduire une information, une opposition, une conclusion, en appuyant sur le fait que cette conclusion est inattendue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f5b8444-40a8-4363-a646-97f6c11b4edc",
                                                "sense_id": "00a8ae1c-bad9-3331-8fc9-89ddb471280f",
                                                "text": "- Vous chantiez, j’en suis fort aise.\nEh bien, dansez maintenant."
                                            },
                                            {
                                                "example_id": "1ac53a7a-2e8e-4a96-a92f-00b5510a64ea",
                                                "sense_id": "00a8ae1c-bad9-3331-8fc9-89ddb471280f",
                                                "text": "« En disant « S eh bien Q » Silvia montre à elle-même et à Dorante que le fait qu’elle dise « soit ! » constitue une suite « anormale » de S, que « normalement » on devrait avoir Q, c’est-à-dire le refus de la parole. »"
                                            },
                                            {
                                                "example_id": "98636dbe-c1cb-46b3-a115-a1b9a50e3fab",
                                                "sense_id": "00a8ae1c-bad9-3331-8fc9-89ddb471280f",
                                                "text": "Eh bien… ça m’a plutôt l’air d’être une bonne idée tout compte fait."
                                            },
                                            {
                                                "example_id": "20e0de6b-b2f3-4dd9-9134-131b0247d3b2",
                                                "sense_id": "00a8ae1c-bad9-3331-8fc9-89ddb471280f",
                                                "text": "Après que vous avez aidé le kebabier à tout laver, il vous remercie.\n– Eh bien, merci du coup de main."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f4fdad0-181e-304e-8fac-e32ee57252eb",
                                        "entry_id": "59ede902-2252-3aac-bd9a-46f9875bcb2c",
                                        "glosses": [
                                            "S’emploie aussi pour marquer le dépit ou la résignation, dans une décision appuyée mais prise à contre-cœur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80e63810-1714-4e99-8d00-04052057a550",
                                                "sense_id": "0f4fdad0-181e-304e-8fac-e32ee57252eb",
                                                "text": "Puisque personne n’en veut, eh bien, soit, je ne le reproposerai plus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
