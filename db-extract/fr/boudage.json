                        "examples": [
                            {
                                "example_id": "4c5759cb-9d45-463b-bc4a-2c721ec3f0f5",
                                "sense_id": "888ac7d9-54fe-30b3-a678-8817c887fb89",
                                "text": "J’en peux pus de tes crises, du chialage, de tes reproches, du boudage."
                            },
                            {
                                "example_id": "55a1e9e5-89a2-470a-85d1-24dc35469266",
                                "sense_id": "888ac7d9-54fe-30b3-a678-8817c887fb89",
                                "text": "Mais ni les larmes, ni mon boudage extrême, ni la porte que j'ai claquée n'ont eu d'effet sur l'entêtement de ma mère."
                            },
                            {
                                "example_id": "124910b5-a370-45f2-98ae-2fec9b9e7c56",
                                "sense_id": "888ac7d9-54fe-30b3-a678-8817c887fb89",
                                "text": "Et comment Dicaire aurait-elle réagi face à une situation similaire à l’approche d’un combat aussi important?\n\"J’aurai eu une bonne crise de boudage (rires). \""
                            }
                        ]
                    }
