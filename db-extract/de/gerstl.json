                        ],
                        "examples": [
                            {
                                "example_id": "0c119180-fe69-4faa-80d7-9ad585b1e0a8",
                                "sense_id": "1dc8e055-7c3c-3a16-8be8-8673903e2ed0",
                                "text": "„Zum Scheckbauern ist im Sommer eine Familie gekommen. Die war sehr vornehm, und sie ist aus Preußen gewesen. Wie ihr Gepäck gekommen ist, war ich auf der Bahn, und der Stationsdiener hat gesagt, es ist lauter Juchtenleder, die müssen viel Gerstl haben.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
