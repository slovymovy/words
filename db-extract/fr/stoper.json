                        "examples": [
                            {
                                "example_id": "9dd129e3-e43c-43db-9918-aa299101f4c9",
                                "sense_id": "f9e65323-2acf-3c9e-b422-168841bca7a5",
                                "text": "Si l’on a trouvé le moyen d’arrêter les machines à vapeur, celui de stoper la langue d’une portière épuisera le génie des inventeurs."
                            },
                            {
                                "example_id": "d13231c7-b0f1-43e4-b578-68761ff7efc2",
                                "sense_id": "f9e65323-2acf-3c9e-b422-168841bca7a5",
                                "text": "La sentinelle, qui avait sans doute entendu les paroles de Georges, crie immédiatement de stoper ; mais à peine son ordre est-il lancé, que, de l’arrière du petit bateau, part un coup de feu, et le soldat nordiste s’affaisse pour ne plus se relever."
                            },
                            {
                                "example_id": "aa4ee231-5334-40ab-b0a9-dec3a3329288",
                                "sense_id": "f9e65323-2acf-3c9e-b422-168841bca7a5",
                                "text": "On fit stoper le bâtiment et l’on envoya une chaloupe."
                            }
                        ]
