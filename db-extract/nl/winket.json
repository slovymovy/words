                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26fa76a1-8688-3497-8019-f1a7b0629f6a",
                                        "entry_id": "2d2504fb-4b6b-3d92-b581-d6fba92896da",
                                        "glosses": [
                                            "A small door or gate, especially one beside a larger one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3feae4f1-5315-42a3-9989-e55fad4b01ab",
                                                "sense_id": "26fa76a1-8688-3497-8019-f1a7b0629f6a",
                                                "text": "...and one, a cool, bold fellow, whom I know well, will unlock the town gate, and—for he has various talents—hopes, through his influence with a pretty daughter of one of the wardens, to leave unbarred a certain wicket in the postern on the seaward side."
                                            },
                                            {
                                                "example_id": "9f07d060-9279-46b7-8842-95c7f667a3c9",
                                                "sense_id": "26fa76a1-8688-3497-8019-f1a7b0629f6a",
                                                "text": "And dark in the dark old inn-yard a stable-wicket creaked / Where Tim the ostler listened; his face was white and peaked; / His eyes were hollows of madness, his hair like mouldy hay, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df8c7874-cc77-36f8-8383-73ab75ef8376",
                                        "entry_id": "2d2504fb-4b6b-3d92-b581-d6fba92896da",
                                        "glosses": [
                                            "A small window or other opening, sometimes fitted with a grating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64f47d08-7b92-44f9-be57-78c96225b57c",
                                                "sense_id": "df8c7874-cc77-36f8-8383-73ab75ef8376",
                                                "text": "As he did so he heard the shuffle of footsteps entering the chapel and the clicking of the confessional wicket."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a11c588-8793-3caa-8684-3bd9efdbfac6",
                                        "entry_id": "2d2504fb-4b6b-3d92-b581-d6fba92896da",
                                        "glosses": [
                                            "A service window, as in a bank or train station, where a customer conducts transactions with a teller"
                                        ],
                                        "tags": [
                                            "British",
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "605ae674-b450-418d-9885-2ed4fa42684d",
                                                "sense_id": "0a11c588-8793-3caa-8684-3bd9efdbfac6",
                                                "text": "Watt climbed the stone steps and stood before the wicket, looking through its bars. He admired the permanent way, stretching away on either hand, in the moonlight, and the starlight, as far as the eye could reach, as far as Watt's eye could have reached, if it had been inside the station."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "597b9a70-aa3a-361d-babf-1ca64f3e81a2",
                                        "entry_id": "2d2504fb-4b6b-3d92-b581-d6fba92896da",
                                        "glosses": [
                                            "a ticket barrier at a rail station, box office at a cinema, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a08adf3-b71f-324f-98fb-d94284b06d4f",
                                        "entry_id": "2d2504fb-4b6b-3d92-b581-d6fba92896da",
                                        "glosses": [
                                            "One of the two wooden structures at each end of the pitch, consisting of three vertical stumps and two bails; the target for the bowler, defended by the batsman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdbe95d6-c8f0-47db-b2ac-a55283dcccf9",
                                                "sense_id": "8a08adf3-b71f-324f-98fb-d94284b06d4f",
                                                "text": "The umpire placed the wickets 10 minutes before the match started."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcf1357d-d5a3-3229-a342-2df02f8b6152",
                                        "entry_id": "2d2504fb-4b6b-3d92-b581-d6fba92896da",
                                        "glosses": [
                                            "A dismissal; the act of a batsman getting out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92fcc5fa-9075-410a-a31f-daf0c3f38218",
                                                "sense_id": "bcf1357d-d5a3-3229-a342-2df02f8b6152",
                                                "text": "He kept on taking wickets and bowled the opponents team out for 84."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3600fbb-39c5-3e78-8418-58fc4a9669e4",
                                        "entry_id": "2d2504fb-4b6b-3d92-b581-d6fba92896da",
                                        "glosses": [
                                            "The job of a wicketkeeper while the team is bowling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f033da58-b5f2-4160-ab6e-5fc5317d12e8",
                                                "sense_id": "a3600fbb-39c5-3e78-8418-58fc4a9669e4",
                                                "text": "He kept the wicket."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1e4603e-1793-38d3-a385-9c3629340df7",
                                        "entry_id": "2d2504fb-4b6b-3d92-b581-d6fba92896da",
                                        "glosses": [
                                            "The period during which two batsmen bat together."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2fa7057c-4197-345b-89b1-2754c99a3541",
                                        "entry_id": "2d2504fb-4b6b-3d92-b581-d6fba92896da",
                                        "glosses": [
                                            "The pitch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43c92dc4-59fb-3802-9e41-c2a9ac10c325",
                                        "entry_id": "2d2504fb-4b6b-3d92-b581-d6fba92896da",
                                        "glosses": [
                                            "The area around the stumps where the batsmen stand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d134c3f-2a42-446a-8eb2-436c157ab5f8",
                                                "sense_id": "43c92dc4-59fb-3802-9e41-c2a9ac10c325",
                                                "text": "The captain told his fast bowler to bowl around the wicket."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3473c184-bb59-3f20-829a-9cb5a6754414",
                                        "entry_id": "2d2504fb-4b6b-3d92-b581-d6fba92896da",
                                        "glosses": [
                                            "Any of the small arches through which the balls are driven."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fea528a2-ed62-3b42-9c07-b0b77f4d8168",
                                        "entry_id": "2d2504fb-4b6b-3d92-b581-d6fba92896da",
                                        "glosses": [
                                            "A temporary metal attachment that one attaches one's lift-ticket to."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
