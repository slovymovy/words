                                "example_id": "93801d76-5fb1-4bcc-ab72-22713f185e1d",
                                "sense_id": "77b4f539-323c-3dd1-9b28-086c516e0691",
                                "text": "Normally a dead crew member would be sarcophagized and laid out in one of the smaller bays for twenty-four hours; after a formal ceremony the body was jettisoned into space."
                            },
