                    },
                    {
                        "translation_id": "db8a33ec-1ccc-49bc-8a0a-8c36ca3c0e11",
                        "source_entry_id": "350f9b26-5bc0-3adc-b9ac-d3fa68379fa9",
                        "source_sense_description": "богатый человек, занимающийся благотворительной деятельностью, покровительствующий развитию культуры, искусства, науки и оказывающий им финансовую поддержку",
                        "target_lang_word": "Mäzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mäzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "69a961f7-cb51-36a2-8563-edebbe6caf44",
                                        "entry_id": "c45a5690-0665-3fe1-bad3-7027de28bc5d",
                                        "glosses": [
                                            "vermögende Privatperson, die Kunst, Künstler oder künstlerische Tätigkeiten mit Geld unterstützt, ohne einen direkten Gegenwert zu erwarten; vergleichbar mit einem Sponsor"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "956a3efb-2d68-4e09-9b98-55648d1fc467",
                                                "sense_id": "69a961f7-cb51-36a2-8563-edebbe6caf44",
                                                "text": "Wir müssen unbedingt einen Mäzen finden."
                                            },
                                            {
                                                "example_id": "8c56240e-5f49-437a-9861-63659a418413",
                                                "sense_id": "69a961f7-cb51-36a2-8563-edebbe6caf44",
                                                "text": "„Berlin wimmelte von Mäzenen, sie gehörten zur Szenerie.“"
                                            },
                                            {
                                                "example_id": "15de701a-8464-4bb0-8e9e-f51ed1aa5860",
                                                "sense_id": "69a961f7-cb51-36a2-8563-edebbe6caf44",
                                                "text": "„Dagobert war ehemals der Mäzen, der Sibelius finanzierte und drangsalierte.“"
                                            },
                                            {
                                                "example_id": "44222030-d86a-4d3a-a4c8-df686fb4ac97",
                                                "sense_id": "69a961f7-cb51-36a2-8563-edebbe6caf44",
                                                "text": "„Die Künstler genossen das extravagante Gesellschaftsleben, das reiche Mäzene wie die Woolworth-Erbin Barbara Hutton boten.“"
                                            },
                                            {
                                                "example_id": "90e3c623-f0ba-414f-9d3e-20b38504dfb4",
                                                "sense_id": "69a961f7-cb51-36a2-8563-edebbe6caf44",
                                                "text": "„Drei Wochen später brach Medini auf und fuhr nach Deutschland, wo er seine ›Henriade‹ drucken ließ, nachdem er im Kurfürsten einen guten Mäzen gefunden hatte.“"
                                            },
                                            {
                                                "example_id": "6b3260f9-a692-4ec2-a77d-9a7e95aea851",
                                                "sense_id": "69a961f7-cb51-36a2-8563-edebbe6caf44",
                                                "text": "„Letzterer gewinnt aber auch dadurch an Bedeutung, dass vor allem Mäzene aus Saudi-Arabien und den Golfstaaten Koranschulen und Moscheen mit einem wahhabitisch angehauchten Curriculum finanzieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8446b976-a301-4cc3-a8cb-62a8bb4b5390",
                        "source_entry_id": "350f9b26-5bc0-3adc-b9ac-d3fa68379fa9",
                        "source_sense_description": "богатый человек, занимающийся благотворительной деятельностью, покровительствующий развитию культуры, искусства, науки и оказывающий им финансовую поддержку",
                        "target_lang_word": "mécène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mécène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b4568c1c-8ff2-3189-8cbd-a5f7a362b282",
                                        "entry_id": "be1ae8dc-81e4-3405-a796-50c4d6f3a897",
                                        "glosses": [
                                            "Celui qui encourage par ses libéralités les sciences, les lettres et les arts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8506114-f8b4-484e-9a2c-225e745238b7",
                                                "sense_id": "b4568c1c-8ff2-3189-8cbd-a5f7a362b282",
                                                "text": "Pour installer ce musée, il faudrait trouver un mécène."
                                            },
                                            {
                                                "example_id": "f4566526-0dac-4ffc-8533-c9120fc55971",
                                                "sense_id": "b4568c1c-8ff2-3189-8cbd-a5f7a362b282",
                                                "text": "Ce riche amateur est le mécène des artistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ac074ee-b2ea-37f7-9112-8b36d0e77e6a",
                                        "entry_id": "be1ae8dc-81e4-3405-a796-50c4d6f3a897",
                                        "glosses": [
                                            "Personne physique ou morale qui apporte un soutien matériel, sans contrepartie directe de la part du bénéficiaire, à une œuvre ou à une personne pour l’exercice d’activités présentant un intérêt général."
                                        ],
                                        "tags": [
                                            "Économie et gestion d’entreprise"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51c4deab-fabf-40fb-b1b3-817251c522ec",
                                                "sense_id": "2ac074ee-b2ea-37f7-9112-8b36d0e77e6a",
                                                "text": "À l’heure où les éditeurs migraient en masse vers le numérique, il était rassurant de voir que les scieries amazoniennes conservaient quelques mécènes."
                                            }
                                        ]
                                    }
                                ]
