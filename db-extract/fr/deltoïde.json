                "forms": [
                    {
                        "form_id": "9077cc88-86b7-48a9-8a2a-b12d621b8ce1",
                        "entry_id": "3f4e9ce9-fbc5-32eb-943c-3a0e08177b4b",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "deltoïdes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2752943d-d1b8-34a1-b578-8d1824e73040",
                        "entry_id": "3f4e9ce9-fbc5-32eb-943c-3a0e08177b4b",
                        "glosses": [
                            "Qui a la forme d’un delta."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce9432c8-e93d-4fdb-82c6-27b03017e100",
                                "sense_id": "2752943d-d1b8-34a1-b578-8d1824e73040",
                                "text": "Les douleurs postéromédiales sont en faveur d’une tendinopathie du long fléchisseur de l’hallux, alors que les douleurs davantage médiales nous orientent vers une tendinopathie du tibial postérieur, lesquelles irradient vers le naviculaire, ou une lésion du ligament deltoïde."
                            },
                            {
                                "example_id": "e25f759e-05d1-47fa-a2cc-c240d1da037a",
                                "sense_id": "2752943d-d1b8-34a1-b578-8d1824e73040",
                                "text": "Cette espèce est caractérisée par un port « coniféroïde », et par un stigmate deltoïde et fertile entouré de longs stigmates spiniformes et stériles."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "498934fb-a5f5-39aa-a351-b1b4b9e89a9b",
                "word": "deltoïde",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "40aa7040-ef61-4f9f-b395-7b01be6ea117",
                        "entry_id": "498934fb-a5f5-39aa-a351-b1b4b9e89a9b",
                        "tags": [
                            "plural"
                        ],
                        "form": "deltoïdes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0bbff3fd-f6e7-3580-9b51-9117a57d1d9a",
                        "entry_id": "498934fb-a5f5-39aa-a351-b1b4b9e89a9b",
                        "glosses": [
                            "Muscle de forme triangulaire qui relie l’humérus à la clavicule et à la scapula."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a96e379b-4451-4702-be39-1b9ca40768f5",
                                "sense_id": "0bbff3fd-f6e7-3580-9b51-9117a57d1d9a",
                                "text": "Beaucoup plus petit que les autres muscles que nous venons d’énumérer, le deltoïde est rarement utilisé pour donner une injection intramusculaire."
                            },
                            {
                                "example_id": "4baf85d8-57fe-4846-8b1b-d18789c0bd43",
                                "sense_id": "0bbff3fd-f6e7-3580-9b51-9117a57d1d9a",
                                "text": "Oyant cela, d’aucun·es – qui ont gardé le souvenir de la détermination dont a tout récemment fait preuve le même Jean Castex quand il a répété en bougeant les deltoïdes qu’il allait coûte que coûte « faire la réforme des retraites » – ont trouvé que c’était un peu spongieux et constaté qu’en somme sa seule décision était de n’en prendre aucune."
                            }
                        ]
                    },
