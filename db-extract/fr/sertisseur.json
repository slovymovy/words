                        "glosses": [
                            "Ouvrier qui sertit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74de2412-70d8-4a29-b0b9-202f4e5e76a5",
                                "sense_id": "6198739d-8cd9-3ef2-a252-9285ea251f21",
                                "text": "Selon le genre du joyau, les sertisseurs ont le choix entre les filets, les festonnés, les griffes pour assortir les sertis aux chatons, qui sont eux-mêmes gothiques, festonnés, à filet, à galerie, à griffes."
                            },
                            {
                                "example_id": "68097ef5-5edc-4766-924f-6dd3f4fac09a",
                                "sense_id": "6198739d-8cd9-3ef2-a252-9285ea251f21",
                                "text": "Il a fallu un mois de travail au sertisseur de Cartier pour réaliser le pavage en diamants de cette broche panthère."
                            },
                            {
                                "example_id": "65bbf5fa-be80-404f-9407-d25ba0586239",
                                "sense_id": "6198739d-8cd9-3ef2-a252-9285ea251f21",
                                "text": "Avant, j’avais travaillé huit jours comme sertisseur de boites de conserve : fallait casser la croûte."
                            }
                        ]
                    }
                ],
