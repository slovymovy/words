                    }
                ],
                "senses": [
                    {
                        "sense_id": "4fd40708-220e-3ec1-bdf8-8a9903c95dec",
                        "entry_id": "4b511502-6d39-346b-bb58-3cccad3d15d6",
                        "glosses": [
                            "Instrument, das die Geschwindigkeit misst/angibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c34546e0-81ba-4286-9cf2-6c27d6620986",
                                "sense_id": "4fd40708-220e-3ec1-bdf8-8a9903c95dec",
                                "text": "„Der Tachometer zeigt schließlich hundertundsechzig.“"
                            },
                            {
                                "example_id": "d872d4fe-cddf-4632-bb25-57eaf6b52f68",
                                "sense_id": "4fd40708-220e-3ec1-bdf8-8a9903c95dec",
                                "text": "„Als ich vorgestern vom Tachometer auf die Straße sah, musste ich feststellen, dass ich mich schon weit außerhalb Münchens befand und es nicht mehr weit bis Augsburg sein konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2160ff88-a2d7-4ff7-bfa3-8fed88bd62f8",
                        "source_entry_id": "4b511502-6d39-346b-bb58-3cccad3d15d6",
                        "source_sense_id": "4fd40708-220e-3ec1-bdf8-8a9903c95dec",
                        "source_sense_description": "Instrument, das die Geschwindigkeit misst/angibt",
                        "target_lang_word": "speedometer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speedometer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f5a3584-de0c-3db7-84e4-a28d4c608f25",
                                        "entry_id": "997f59bc-69da-383c-a44a-4db96d71f57a",
                                        "glosses": [
                                            "An instrument located within the dashboard of a vehicle that measures and indicates the current speed of the vehicle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92e6bd47-1cbf-427b-9632-5a7f0364dcb1",
                                                "sense_id": "9f5a3584-de0c-3db7-84e4-a28d4c608f25",
                                                "text": "Although it might be thought that drivers would naturally refer constantly to the speedometer, older drivers who come to diesel driving after years of steam experience without the help of speedometers, as well as those on steam engines which have been equipped with speedometers in recent years, have not accustomed themselves to the constant use of this instrument."
                                            },
                                            {
                                                "example_id": "7ae52438-4fb6-4487-b66d-dda38a3b2259",
                                                "sense_id": "9f5a3584-de0c-3db7-84e4-a28d4c608f25",
                                                "text": "But even Apple, the company that cast aside tradition when it reinvented phones, music players and headphones, bows to convention when it comes to speedometers. It displayed a classically-styled speedometer that reached 160 mph, an auto industry norm.\nThat’s nearly twice the highest posted speed limit in the United States, 85 mph, on a stretch of highway in Texas. Why do our speedometers stretch to a speed that’s illegal, and only race-car drivers will ever reach?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8326f22c-97cd-3959-8414-f33ef943ee7b",
                                        "entry_id": "997f59bc-69da-383c-a44a-4db96d71f57a",
                                        "glosses": [
                                            "Such a device incorporating an odometer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffae467d-7b0b-473c-8043-4a6e72070a6e",
                        "source_entry_id": "4b511502-6d39-346b-bb58-3cccad3d15d6",
                        "source_sense_id": "4fd40708-220e-3ec1-bdf8-8a9903c95dec",
                        "source_sense_description": "Instrument, das die Geschwindigkeit misst/angibt",
                        "target_lang_word": "tachymètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tachymètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "029d8488-2a16-3ad4-ad1d-41d96f785d66",
                                        "entry_id": "f362eaea-1ef3-355b-9e2a-e6ce245d0bde",
                                        "glosses": [
                                            "Appareil de mesure indiquant en continu la vitesse angulaire d’une machine tournante, par exemple l’arbre de sortie d’un moteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2052103b-20ee-4759-94a5-f3912fb32279",
                                                "sense_id": "029d8488-2a16-3ad4-ad1d-41d96f785d66",
                                                "text": "Un compte-tours moteur est une sorte de tachymètre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d706fb3b-f4e8-3254-a888-551214f91c06",
                                        "entry_id": "f362eaea-1ef3-355b-9e2a-e6ce245d0bde",
                                        "glosses": [
                                            "Instrument servant à mesurer la vitesse."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d403e1f7-0fc6-4c10-bb24-992325dfa8a1",
                                                "sense_id": "d706fb3b-f4e8-3254-a888-551214f91c06",
                                                "text": "Il a l’œil constamment rivé sur le tachymètre."
                                            },
                                            {
                                                "example_id": "5dde99d1-f19e-4763-8535-3a3e406f57ec",
                                                "sense_id": "d706fb3b-f4e8-3254-a888-551214f91c06",
                                                "text": "Le conducteur jeta un coup d’œil sur son tachymètre, où l’aiguille blanche se déplaçait en éventail, de gauche à droite, sur les chiffres verts marquant les vitesses de 20 en 20 km/h."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
