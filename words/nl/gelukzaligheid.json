            "senses": [
                {
                    "sense_id": "c5eb7e71-3310-32c7-9af2-d875b665cad2",
                    "sense_definition": "een toestand van opperste vreugde en volkomen tevredenheid",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotionele toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het winnen van de wedstrijd verkeerde het hele team in een staat van pure <w>gelukzaligheid</w>.",
                            "target_lang_translations": {
                                "en": "After winning the match, the whole team was in a state of pure <w>bliss</w>."
                            }
                        },
                        {
                            "text": "Zijn <w>gelukzaligheid</w> was haast onverdraaglijk toen hij zijn pasgeboren dochter voor het eerst vasthield.",
                            "target_lang_translations": {
                                "en": "His <w>happiness</w> was almost unbearable when he held his newborn daughter for the first time."
                            }
                        }
                    ],
                    "synonyms": [
                        "heerlijkheid"
                    ],
                    "antonyms": [
                        "ellende",
                        "wanhoop"
                    ],
                    "common_phrases": [
                        "staat van gelukzaligheid",
                        "pure gelukzaligheid"
                    ],
                    "target_lang_definitions": {
                        "en": "a state of supreme joy and complete satisfaction"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bliss",
                                "target_lang_sense_clarification": "perfect happiness"
                            },
                            {
                                "target_lang_word": "happiness",
                                "target_lang_sense_clarification": "the emotion of being happy"
                            },
                            {
                                "target_lang_word": "joy",
                                "target_lang_sense_clarification": "extreme cheerfulness"
                            },
                            {
                                "target_lang_word": "felicity",
                                "target_lang_sense_clarification": "intense happiness"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce218576-ec75-3a91-aacb-78e7da64ea93",
                    "sense_definition": "een verheven staat van geestelijk of religieus geluk",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spirituele toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In veel religies wordt de eeuwige <w>gelukzaligheid</w> beschreven als het uiteindelijke doel van de ziel.",
                            "target_lang_translations": {
                                "en": "In many religions, eternal <w>bliss</w> is described as the ultimate goal of the soul."
                            }
                        },
                        {
                            "text": "De monnik zocht naar innerlijke vrede en spirituele <w>gelukzaligheid</w> door middel van jarenlange meditatie.",
                            "target_lang_translations": {
                                "en": "The monk sought inner peace and spiritual <w>blessedness</w> through years of meditation."
                            }
                        }
                    ],
                    "synonyms": [
                        "weelde"
                    ],
                    "common_phrases": [
                        "eeuwige gelukzaligheid",
                        "spirituele gelukzaligheid"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in religieuze of literaire context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an exalted state of spiritual or religious happiness"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bliss",
                                "target_lang_sense_clarification": "spiritual joy"
                            },
                            {
