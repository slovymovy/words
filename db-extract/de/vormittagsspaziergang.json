                "senses": [
                    {
                        "sense_id": "afdfc0a2-e83b-34a9-a0e0-7e1f15995a35",
                        "entry_id": "eaf5b19b-72ab-3ae1-99ad-7c8fc2936a59",
                        "glosses": [
                            "Spaziergang am Vormittag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ad1d10f-f00c-42fe-9f2b-2b99125e4929",
                                "sense_id": "afdfc0a2-e83b-34a9-a0e0-7e1f15995a35",
                                "text": "Lass uns einen kurzen Vormittagsspaziergang in der Natur machen."
                            },
                            {
                                "example_id": "e87fcd8a-a44c-479c-8ec9-e3d8027da7e1",
                                "sense_id": "afdfc0a2-e83b-34a9-a0e0-7e1f15995a35",
                                "text": "„Nun entfiel der tägliche Vormittagsspaziergang, dafür aber ergaben sich zunächst andere Freuden.“"
                            },
                            {
                                "example_id": "2b4b5798-77f4-456a-a328-8b98088c0727",
                                "sense_id": "afdfc0a2-e83b-34a9-a0e0-7e1f15995a35",
                                "text": "„Er wohnte dort mit Frau und Töchtern, der Mittelpunkt der ganzen skandinavischen Colonie, in einer stillen Seitenstraße unweit des Bois de Boulogne, wo er seinen täglichen Vormittagsspaziergang machte.“"
                            },
                            {
                                "example_id": "377b55d8-7af3-43ad-b202-c3e9422c93c4",
                                "sense_id": "afdfc0a2-e83b-34a9-a0e0-7e1f15995a35",
                                "text": "„Ein paar Schritte von den Trampelpfaden entfernt hat man im Regelfall seine Ruhe, und die zu finden, ist das Ziel meines sommerlichen Vormittagsspaziergangs in der Innenstadt.“"
                            },
                            {
                                "example_id": "5b413fce-1959-4364-907d-d2818fde6efb",
                                "sense_id": "afdfc0a2-e83b-34a9-a0e0-7e1f15995a35",
                                "text": "„Alte Männer sitzen auf Bänken und lesen die Voz de Soria, die Stimme der Stadt, oder absolvieren mühselige Vormittagsspaziergänge, auf einen Stock gestützt.“"
                            },
                            {
                                "example_id": "bdf611a0-11aa-4cfc-b7f2-f7deddeab8d4",
                                "sense_id": "afdfc0a2-e83b-34a9-a0e0-7e1f15995a35",
                                "text": "„Auf einem seiner Vormittagsspaziergänge durch die an geschichtlichen Denkmälern so reiche Stadt war er in verschiedene Buchläden getreten, um nach dem Absatz und Erfolg des berüchtigten Schauspieles ‚Die Räuber‘ zu fragen.“"
                            },
                            {
                                "example_id": "5d89d166-2aaf-4dcc-9497-1db51ebf295b",
                                "sense_id": "afdfc0a2-e83b-34a9-a0e0-7e1f15995a35",
                                "text": "„Auch an den Vormittagsspaziergängen mit Irene nahm er jetzt teil, immer jovial, zu Späßen aufgelegt.“"
                            },
                            {
                                "example_id": "39c3d0c4-456c-4bdc-b35b-8dc3425d3952",
                                "sense_id": "afdfc0a2-e83b-34a9-a0e0-7e1f15995a35",
                                "text": "„Es war gegen zehn Uhr, welches gerade die Zeit war, die, wie wir oben sagten, Hugo gewöhnlich zu seinem Vormittagsspaziergange verwendete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
