                    {
                        "sense_id": "5e3997e8-2ead-3b26-be21-69ed9d28803e",
                        "entry_id": "b91f8584-ee69-3973-a5fd-11a5b248f090",
                        "glosses": [
                            "medisch specialist met universitair diploma op het gebied van de tandheelkunde"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "318cf0ab-7169-41ba-a896-9daf405b213a",
                                "sense_id": "5e3997e8-2ead-3b26-be21-69ed9d28803e",
                                "text": "Mijn echtgenoot is tandarts en heeft een eigen praktijk."
                            },
                            {
                                "example_id": "5ff69a7b-48bb-4851-9dcb-8b348d481acb",
                                "sense_id": "5e3997e8-2ead-3b26-be21-69ed9d28803e",
                                "text": "‘Het is vervelend, maar ik ben goddank helemaal niet bang voor de tandarts. Ik ben dolgelukkig met die lui. Man! Die pijn wíl ik verdragen. Stel dat er géén tandartsen zouden zijn, dát zou pas erg zijn.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "804cc392-b807-41ec-b13a-b44ac5659733",
                        "source_entry_id": "b91f8584-ee69-3973-a5fd-11a5b248f090",
                        "source_sense_id": "5e3997e8-2ead-3b26-be21-69ed9d28803e",
                        "source_sense_description": "een medisch specialist op het gebied van de tandheelkunde",
                        "target_lang_word": "牙科医生",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d8f72fdb-bae5-4f23-9331-690ebfe366f1",
                        "source_entry_id": "b91f8584-ee69-3973-a5fd-11a5b248f090",
                        "source_sense_id": "5e3997e8-2ead-3b26-be21-69ed9d28803e",
                        "source_sense_description": "een medisch specialist op het gebied van de tandheelkunde",
                        "target_lang_word": "Zahnarzt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zahnarzt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fca32041-7692-31d1-98e3-5369ece2bf07",
                                        "entry_id": "166dfe3f-9b1a-32a9-bb4b-083dccb2fb4c",
                                        "glosses": [
                                            "Mediziner, der sich mit der Zahnheilkunde beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "350d62e1-d4e5-40b0-a030-c2f1f53675f5",
                                                "sense_id": "fca32041-7692-31d1-98e3-5369ece2bf07",
                                                "text": "Wer geht schon gerne zum Zahnarzt?"
                                            },
                                            {
                                                "example_id": "49a07c7c-e81d-465f-baa4-03c308bd7b8c",
                                                "sense_id": "fca32041-7692-31d1-98e3-5369ece2bf07",
                                                "text": "„Wir unterhielten uns, tranken auf den Abschied, ich würde mir in Hamburg einen neuen Zahnarzt suchen müssen.“"
                                            },
                                            {
                                                "example_id": "7ba769de-a1ef-4700-97fd-f7985c20d1f7",
                                                "sense_id": "fca32041-7692-31d1-98e3-5369ece2bf07",
                                                "text": "„Erst später hatte man erfahren, dass der Zahnarzt in Hindenburg gar kein gelernter Zahnarzt war.“"
                                            },
                                            {
                                                "example_id": "43a0bbbf-c2e4-47bb-abaf-52d47be8f829",
                                                "sense_id": "fca32041-7692-31d1-98e3-5369ece2bf07",
                                                "text": "„Der Zahnarzt nickte ihnen zu.“"
                                            },
                                            {
                                                "example_id": "e1625d85-7ef5-4eec-917b-5cf27b3b37da",
                                                "sense_id": "fca32041-7692-31d1-98e3-5369ece2bf07",
                                                "text": "„Ich suchte in Addis Abeba allerlei Zahnärzte auf.“"
                                            },
                                            {
                                                "example_id": "f1e2aa46-13f4-48fc-b346-43aec83302c5",
                                                "sense_id": "fca32041-7692-31d1-98e3-5369ece2bf07",
                                                "text": "„Ein schlitzohriges schwäbisches Bäuerle sitzt beim Zahnarzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f3d9c54-fb08-46a5-bf0c-ad1779573bb7",
                        "source_entry_id": "b91f8584-ee69-3973-a5fd-11a5b248f090",
                        "source_sense_id": "5e3997e8-2ead-3b26-be21-69ed9d28803e",
