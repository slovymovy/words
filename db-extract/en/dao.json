                    {
                        "sense_id": "a1f10bec-d072-3c29-ac5c-c9ffd0d6490c",
                        "entry_id": "aa254c83-f2c0-341b-9b09-f5efcbdf129c",
                        "glosses": [
                            "Initialism of double action only, a trigger mechanism for revolving cylinder and semi-automatic firearms."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "countable",
