                "senses": [
                    {
                        "sense_id": "fe3012c7-0bfc-3f95-ae72-4b9053ee4ea6",
                        "entry_id": "f489d477-2a7b-3f0c-aef3-135e158fcfeb",
                        "glosses": [
                            "Donner un caractère opalin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad2cc72d-1239-44df-ae1c-23bf832fa57c",
                                "sense_id": "fe3012c7-0bfc-3f95-ae72-4b9053ee4ea6",
                                "text": "Si je filtre cette eau, il ne reste rien d’extraordinaire sur le papier; la matière qui opalinise l’eau est absolument impalpable."
                            },
                            {
                                "example_id": "130a861c-084a-4fef-b6db-7a129054dc9f",
                                "sense_id": "fe3012c7-0bfc-3f95-ae72-4b9053ee4ea6",
                                "text": "La transition est beaucoup plus lente et plus ménagée au printemps ; les eaux s’opalinisent petit à petit et mettent en général plusieurs semaines à perdre graduellement leur transparence pour devenir opaques."
                            }
                        ]
                    }
                ],
