                    "frequency": "High",
                    "semantic_group_id": "presentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>C'</w>est une excellente idée de préparer un pique-nique pour demain."
                        },
                        {
                            "text": "<w>Ce</w> sont mes meilleurs amis rencontrés pendant mes études."
                        }
                    ],
                    "common_phrases": [
