                    },
                    {
                        "translation_id": "55f55677-7abb-45b2-8752-1bc6330e606e",
                        "source_entry_id": "7eb2c1d0-6bdb-3a91-a3ab-0d821694053b",
                        "source_sense_id": "cbb36fdb-16fc-3cd7-8124-ffb3bf923fe2",
                        "source_sense_description": "Homme accompagnant une femme mariée",
                        "target_lang_word": "cavalier servente",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "82975939-2f3a-4456-bf5e-7d3769341a04",
                        "source_entry_id": "7eb2c1d0-6bdb-3a91-a3ab-0d821694053b",
                        "target_lang_word": "cicisbeo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cicisbeo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa38068d-ac28-36e7-ab0b-bc9e007f2a63",
                                        "entry_id": "ac71dcb6-16d7-335e-9919-a113c980d415",
                                        "glosses": [
                                            "A man who escorts a married woman to social functions, especially in 18th-century Italy; a married woman's lover."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddc7c362-37a0-4b3a-9d32-4a8e5a74cd14",
                                                "sense_id": "fa38068d-ac28-36e7-ab0b-bc9e007f2a63",
                                                "text": "My old Cicisbee says it would do: & he is (or was poor fellow!) a famous Scholar."
                                            },
                                            {
                                                "example_id": "772cb0dd-85d8-4678-8536-b0cd3b398352",
                                                "sense_id": "fa38068d-ac28-36e7-ab0b-bc9e007f2a63",
                                                "text": "The office of Cicisbeo is however an intolerably expensive one; especially to our countrymen."
                                            },
                                            {
                                                "example_id": "90b7f471-1bcc-4cc5-b707-abd6fa019bcf",
                                                "sense_id": "fa38068d-ac28-36e7-ab0b-bc9e007f2a63",
                                                "text": "Of course a cicisbeo is a normal enough figure in Alexandrian life, but things are going to become socially very boring for you if you go out with those two so much."
                                            },
                                            {
                                                "example_id": "d52cfeb8-2170-489a-99d1-b34f588e6596",
                                                "sense_id": "fa38068d-ac28-36e7-ab0b-bc9e007f2a63",
                                                "text": "He accuses the women of having cicisbei, the girls of having lovers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d85b7df0-d7c2-471b-8805-d4d81245bf17",
                        "source_entry_id": "7eb2c1d0-6bdb-3a91-a3ab-0d821694053b",
