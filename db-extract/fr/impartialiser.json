                "senses": [
                    {
                        "sense_id": "89b685cd-50d0-3c60-b76b-076dafa6e5ed",
                        "entry_id": "4cd718bd-f907-30bd-b44c-270105c3af5f",
                        "glosses": [
                            "Donner un caractère impartial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0194e74a-ac2b-4c47-abbc-3a7af369698a",
                                "sense_id": "89b685cd-50d0-3c60-b76b-076dafa6e5ed",
                                "text": "Avec son numéro du matin, on était admis le soir dans ce lieu de délices, et l’on entendait les discours de tous les fédérés, réunis, disaient-ils, dans le louable but de protéger les gouvernans et les gouvernés, d’impartialiser les lois, et d'aller chercher dans tous les coins du monde un ami de la vérité, de quelque pays, de quelque couleur, de quelque opinion qu’il fût, puis, la vérité découverte, on l’enseignerait aux hommes."
                            },
                            {
                                "example_id": "ae08ad78-c678-4629-9778-ef52803e636d",
                                "sense_id": "89b685cd-50d0-3c60-b76b-076dafa6e5ed",
                                "text": "D’où la création de ce sujet qui devait aider à \"impartialiser\" le processus, pour qu’on ne se retrouve pas avec des abus."
                            },
                            {
                                "example_id": "a9c78a9d-2b70-4af9-9f2e-04edbbe36db6",
                                "sense_id": "89b685cd-50d0-3c60-b76b-076dafa6e5ed",
                                "text": "Mais comment faire pour \"impartialiser\" la délivrance du N3 sans recourir à la lourdeur \"CTR\" ?"
                            }
                        ]
                    }
                ],
