                "senses": [
                    {
                        "sense_id": "e98fd913-918e-3d05-bd74-dad2bc538698",
                        "entry_id": "401ac04f-5e94-3168-b1ba-3a1d4ce1a68f",
                        "glosses": [
                            "bewegliches Gerät, zum Löschen eines klein- bis mittelgroßen Feuers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b130d16-756a-4f51-bafb-1faea0615f42",
                                "sense_id": "e98fd913-918e-3d05-bd74-dad2bc538698",
                                "text": "Auch Feuerlöscher haben eine Prüfplakette und müssen wiederkehrend auf Funktionssicherheit geprüft werden."
                            },
                            {
                                "example_id": "8c3c4e8c-0d82-4504-918c-dcad1e0a266c",
                                "sense_id": "e98fd913-918e-3d05-bd74-dad2bc538698",
                                "text": "Schnell! Hol den Feuerlöscher, denn es brennt!"
                            },
                            {
                                "example_id": "aec5624e-7ee7-4112-b5cf-401fa8694903",
                                "sense_id": "e98fd913-918e-3d05-bd74-dad2bc538698",
                                "text": "„Ein Mann stieg aus, der mit uns schimpfte, und mit einem Feuerlöscher Schaum auf das Feuer spritzte, bis es ausging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
