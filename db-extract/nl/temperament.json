                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ce5d3ee5-1112-30da-85a9-303f32ca6aa2",
                                        "entry_id": "cf01e450-32fb-39d3-b8ce-348bbd62c5e0",
                                        "glosses": [
                                            "A moderate and proportionable mixture of elements or ingredients in a compound; the condition in which elements are mixed in their proper proportions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19212b37-0895-4811-9711-bd8d84066839",
                                                "sense_id": "ce5d3ee5-1112-30da-85a9-303f32ca6aa2",
                                                "text": "If I will aske meere Philosophers, what the soule is, I shall finde amongst them, that will tell me, it is nothing, but the temperament and harmony, and just and equall composition of the Elements in the body, which produces all those faculties which we ascribe to the soule […]"
