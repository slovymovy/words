                        ],
                        "form": "die Jiddistik"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "befe9c15-6a43-3273-a6f0-85c31517cb69",
                        "entry_id": "b59031f1-4bb9-385c-981f-3d47fe8b6f97",
                        "glosses": [
                            "Wissenschaft, die sich der Erforschung der jiddischen Sprache, Literatur und Kultur widmet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bce19cf-1bc4-4807-b6fb-3aece0e42d4b",
                                "sense_id": "befe9c15-6a43-3273-a6f0-85c31517cb69",
                                "text": "Die Jiddistik ist ein eigenes Lehr- und Studienfach an mehreren Universitäten, auch in Deutschland."
                            },
                            {
                                "example_id": "2676a45b-fd95-4b9a-99e1-e87845e6817c",
                                "sense_id": "befe9c15-6a43-3273-a6f0-85c31517cb69",
                                "text": "„Die Jiddisten - so nennt man die Leute, die das Fach der Jiddistik wissenschaftlich betreiben - unterscheiden innerhalb des Jiddischen ein halbes bis ganzes Dutzend verschiedener Dialekte, etwa vom ‚Elsässisch-Jiddischen‘ im Westen bis zum ‚Kurländisch-Jiddischen‘ im Baltikum.“"
                            },
                            {
                                "example_id": "e582f682-ae90-45ef-85dc-ce6d7e16ab6c",
                                "sense_id": "befe9c15-6a43-3273-a6f0-85c31517cb69",
                                "text": "„Bald wurde Jiddisch - nicht zuletzt durch dieses Buch - auch Nichtjuden Mitteleuropas so vertraut und wichtig, daß deutsche Studenten die Sprache erlernten und jiddische Bücher ins Deutsche übertrugen, und daß deutsche Dozenten begannen, Jiddistik (so heißt die Fachwissenschaft vom Jiddischen) zu lehren.“"
                            },
                            {
                                "example_id": "85321cfb-08e7-4e5c-972e-08a2ad98ab1e",
                                "sense_id": "befe9c15-6a43-3273-a6f0-85c31517cb69",
                                "text": "„Vielmehr haben Sprecher des Jiddischen seit jeher ein Wissen um die Herkunft vieler Wörter aus den einzelnen Quellsprachen – sie haben, wie die Jiddistik es ausdrückt, ein erhöhtes Komponentenbewusstsein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
