                                    {
                                        "sense_id": "c6919937-7a3f-36f3-8f64-15930d168c46",
                                        "entry_id": "b6b2c790-c82f-32f6-a172-12b469d5423b",
                                        "glosses": [
                                            "Migration des globules blancs du sang hors des capillaires ; les globules passent entre les cellules épithéliales des vaisseaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30607834-51fa-43c1-973c-f0a25ad84e56",
                                                "sense_id": "c6919937-7a3f-36f3-8f64-15930d168c46",
                                                "text": "Le phénomène de diapédèse, assez complexe, permet de franchir la couche des cellules endothéliales des vaisseaux."
                                            },
                                            {
                                                "example_id": "585e5d69-9e7d-418c-923f-9b39b604e8bf",
                                                "sense_id": "c6919937-7a3f-36f3-8f64-15930d168c46",
                                                "text": "Cette puissance attractive de la cellule leucocytaire pour toute parcelle de corps étranger insoluble, puissance qui commande ces phénomènes invraisemblables de diapédèse, est l'un des phénomènes les plus fantastiques de la biologie."
                                            },
                                            {
                                                "example_id": "f9cd3eeb-c82d-4fb5-a84e-f09650827195",
                                                "sense_id": "c6919937-7a3f-36f3-8f64-15930d168c46",
                                                "text": "WALLER et CONHEIM … ont étudié ces singuliers phénomènes et ont pu se rende compte au microscope, des phases de cette migration transvasculaire des cellules blanches, qui a reçu le nom de \"diapédèse\"."
                                            }
                                        ]
                                    }
