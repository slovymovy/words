                "senses": [
                    {
                        "sense_id": "bfda983f-c634-31a3-8baf-680d9205f7ae",
                        "entry_id": "18d5ad26-ca04-3f06-81c0-a33c8e2cddc9",
                        "glosses": [
                            "gewürztes Hackfleisch vom Rind, manchmal auch mit Zwiebelstücken gemischt; kann roh gegessen oder wie Hackfleisch weiterverarbeitet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed281ab7-1297-4fd5-bb5c-a8dcdc183b67",
                                "sense_id": "bfda983f-c634-31a3-8baf-680d9205f7ae",
                                "text": "„Rustikal auch die Bewirtung: Hackepeter, Schmalzstullen gab es, Bier, ‚Rotkäppchen‘, und am Grill konnte jeder selbst Schweinekamm oder Würstchen brutzeln.“"
                            },
                            {
                                "example_id": "04d58be1-9fe5-4d5e-ab0a-04d8c7cad1d3",
                                "sense_id": "bfda983f-c634-31a3-8baf-680d9205f7ae",
                                "text": "„Ich habe heute Morgen zwei Brötchen mit Hackepeter gegessen und eine Tasse Kaffee getrunken, und damit Sie sehen, dass ich nicht lüge, kotze ich Ihnen das jetzt alles vor die Füße!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1178df9d-417b-49d1-aa3f-7fb46b85eafe",
