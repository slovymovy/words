    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cd756e93-9c02-3c50-848d-b755ab964af5",
                    "sense_definition": "Ergens boven hangend of uitstekend over iets anders heen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De tuinman moest de <w>overhangende</w> takken van de boom snoeien omdat ze het voetpad blokkeerden.",
                            "target_lang_translations": {
                                "en": "The gardener had to prune the <w>overhanging</w> branches of the tree because they were blocking the footpath."
                            }
                        },
                        {
                            "text": "We zochten beschutting tegen de regen onder een <w>overhangende</w> rots.",
                            "target_lang_translations": {
                                "en": "We sought shelter from the rain under an <w>overhanging</w> rock."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitstekend",
                        "overhellend"
                    ],
                    "common_phrases": [
                        "overhangende takken",
                        "overhangende rots"
                    ],
                    "target_lang_definitions": {
                        "en": "Hanging or projecting over something else."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "overhanging",
                                "target_lang_sense_clarification": "projecting or jutting out over something"
                            },
                            {
                                "target_lang_word": "hanging over",
                                "target_lang_sense_clarification": "suspended above something"
                            },
                            {
                                "target_lang_word": "drooping",
                                "target_lang_sense_clarification": "hanging down limply"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a1395c6c-d312-3592-8550-633ab64af6f1",
                    "sense_definition": "Onvoltooid deelwoord van <w>overhangen</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De takken, zwaar <w>overhangend</w> over de schutting, zorgden voor veel schaduw in de tuin van de buren.",
                            "target_lang_translations": {
                                "en": "The branches, <w>overhanging</w> heavily over the fence, provided a lot of shade in the neighbors' garden."
                            }
                        },
                        {
                            "text": "Met zijn lichaam gevaarlijk ver <w>overhangend</w> over de reling probeerde hij de sleutels te pakken.",
                            "target_lang_translations": {
                                "en": "With his body <w>leaning</w> dangerously far over the railing, he tried to grab the keys."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "onvoltooid deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
