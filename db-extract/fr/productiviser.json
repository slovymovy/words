                "senses": [
                    {
                        "sense_id": "4e77e9e4-2505-3ae8-866f-d2aa831c3a74",
                        "entry_id": "57219deb-d7b9-396f-8276-597d4d2e04a6",
                        "glosses": [
                            "Donner un caractère productif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03a4ad8d-32b3-4041-bb9a-ec0858c7ff1a",
                                "sense_id": "4e77e9e4-2505-3ae8-866f-d2aa831c3a74",
                                "text": "Le discours de Diamenstein annonce la politique qui sera celle du pouvoir soviétique à l’égard des Juifs jusqu’au milieu des années trente : les productiviser, les territorialiser et concurrencer le projet sioniste en le dépassant."
                            },
                            {
                                "example_id": "e75d1b52-b480-4eaa-9a7a-de128318e254",
                                "sense_id": "4e77e9e4-2505-3ae8-866f-d2aa831c3a74",
                                "text": "Longues maisons basses alignées autour du moulin à vent de pierre, totalement étranger au paysage, que le philanthrope anglo-séfarade avait construit dans une vaine tentative de « productiviser » ceux qu’il avait publiquement appelés ses « frères »."
                            }
                        ]
                    }
