                "translations": [
                    {
                        "translation_id": "50a905b5-babb-4168-8cae-002ea7bacb05",
                        "source_entry_id": "ea331cfd-d068-39ac-955c-4941858ff702",
                        "source_sense_id": "dd389873-8771-306f-ab4f-4a02b30d6487",
                        "target_lang_word": "deliberately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
