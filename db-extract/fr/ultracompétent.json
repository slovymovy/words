                "senses": [
                    {
                        "sense_id": "2fb695e8-255e-3d52-9f35-0464b0c89e4e",
                        "entry_id": "0cfb21c7-3be2-3d5f-a011-5e411a8b0edd",
                        "glosses": [
                            "Extrêmement compétent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "862fae6e-a614-4d44-8729-da9d29e467e6",
                                "sense_id": "2fb695e8-255e-3d52-9f35-0464b0c89e4e",
                                "text": "Les femmes qui ont réussi à s’imposer à la tête des entreprises de médias sont des ultras : ultracompétentes, ultraconvaincantes, ultradéterminées."
                            },
                            {
                                "example_id": "cb60e05f-f8a0-4b38-b5f7-805218c3f588",
                                "sense_id": "2fb695e8-255e-3d52-9f35-0464b0c89e4e",
                                "text": "Ultracompétente et plutôt aimable (pour peu que vous respectiez son statut), elle sait contourner le règlement pour sauver la peau d’un malade : en l'occurrence, bibi."
                            },
                            {
                                "example_id": "13dcbf02-0128-40a1-9b12-bbd783b8b7be",
                                "sense_id": "2fb695e8-255e-3d52-9f35-0464b0c89e4e",
                                "text": "L’équipe « ultracompétente » sera aussi ultraresserrée : dix-sept ministres seulement."
                            }
                        ]
                    }
                ],
