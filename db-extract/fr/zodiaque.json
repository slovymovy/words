                                "target_senses": [
                                    {
                                        "sense_id": "293f5825-1ef4-3c54-84e6-4dc81d736496",
                                        "entry_id": "10ffc1ca-9bd9-3548-b2d1-4a99fcfe0f40",
                                        "glosses": [
                                            "astrologischer Name der Ekliptik, eingeteilt in nach Sternbildern benannte Zwölftel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b33897a-7eb7-44cd-b076-2ff19c220a3e",
                                                "sense_id": "293f5825-1ef4-3c54-84e6-4dc81d736496",
                                                "text": "Im Deutschen bezeichnet „Konstellation“ die Stellung der Planeten im Tierkreis."
                                            },
                                            {
                                                "example_id": "fae91219-64f5-45a7-a54c-a4177f959c0c",
                                                "sense_id": "293f5825-1ef4-3c54-84e6-4dc81d736496",
                                                "text": "„Als Erkennungszeichen trugen die Schreiben das Symbol des Tierkreises.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d1b818c-548f-4c42-9fc9-95ec6f12445a",
                        "source_entry_id": "8699733d-0fd1-3c07-b1f4-d99656f8d129",
