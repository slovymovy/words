    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4e155393-1b60-3347-a96d-0d388d1d3c66",
                    "sense_definition": "The condition of someone who suffers; a state of pain or distress.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The war caused immense <w>suffering</w> to the civilian population.",
                            "target_lang_translations": {
                                "ru": "Война принесла огромные <w>страдания</w> гражданскому населению.",
                                "de": "Der Krieg brachte der Zivilbevölkerung unermessliches <w>Leid</w>."
                            }
                        },
                        {
                            "text": "She dedicated her life to alleviating the <w>suffering</w> of the poor and sick.",
                            "target_lang_translations": {
                                "ru": "Она посвятила свою жизнь облегчению <w>страданий</w> бедных и больных.",
                                "de": "Sie widmete ihr Leben der Linderung des <w>Leidens</w> der Armen und Kranken."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cause suffering",
                        "alleviate suffering",
                        "human suffering",
                        "unnecessary suffering",
                        "great suffering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние того, кто страдает; состояние боли или дистресса.",
                        "de": "Der Zustand einer Person, die leidet; ein Zustand von Schmerz oder Not."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страдание",
                                "target_lang_sense_clarification": "физическая или душевная боль"
                            },
                            {
                                "target_lang_word": "мука",
                                "target_lang_sense_clarification": "сильное мучение"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Leid",
                                "target_lang_sense_clarification": "seelischer oder physischer Schmerz"
                            },
                            {
                                "target_lang_word": "Leiden",
                                "target_lang_sense_clarification": "Zustand des Schmerzes oder Kranksein"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9309cdf7-379e-3b72-8323-62d2ddf05a1f",
                    "sense_definition": "Present participle and gerund of <w>suffer</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>suffering</w> from a severe headache right now.",
                            "target_lang_translations": {
                                "ru": "Сейчас он <w>страдает</w> от сильной головной боли.",
                                "de": "Er <w>leidet</w> gerade an starken Kopfschmerzen."
                            }
                        },
                        {
                            "text": "Many companies are <w>suffering</w> due to the economic downturn.",
                            "target_lang_translations": {
                                "ru": "Многие компании <w>несут убытки</w> из-за экономического спада.",
                                "de": "Viele Unternehmen <w>leiden</w> unter dem wirtschaftlichen Abschwung."
                            }
                        }
                    ],
                    "common_phrases": [
                        "suffering from",
                        "suffering in silence"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола suffer (страдать).",
                        "de": "Partizip Präsens und Gerundium von suffer (leiden)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страдающий",
                                "target_lang_sense_clarification": "в процессе переживания боли или трудностей"
                            },
                            {
                                "target_lang_word": "страдает",
                                "target_lang_sense_clarification": "форма глагола в контексте болезни или убытков"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "leidend",
                                "target_lang_sense_clarification": "im Prozess des Leidens"
                            },
                            {
                                "target_lang_word": "leidet",
                                "target_lang_sense_clarification": "Verbform in Bezug auf Krankheit oder Verluste"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3d150baa-d2b9-389c-ac2d-7ac4635ef09d",
                    "sense_definition": "Experiencing pain; characterized by suffering.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>suffering</w> animal was gently taken to the shelter for treatment.",
                            "target_lang_translations": {
                                "ru": "<w>Страдающее</w> животное осторожно отвезли в приют для лечения.",
                                "de": "Das <w>leidende</w> Tier wurde behutsam zur Behandlung ins Tierheim gebracht."
                            }
                        },
                        {
                            "text": "He looked out at the <w>suffering</w> masses and wished he could do more to help.",
                            "target_lang_translations": {
                                "ru": "Он смотрел на <w>страдающие</w> массы и хотел бы сделать больше, чтобы помочь.",
                                "de": "Er blickte auf die <w>leidenden</w> Massen und wünschte, er könnte mehr helfen."
                            }
                        }
                    ],
                    "synonyms": [
                        "in pain",
                        "pained",
                        "tormented",
                        "aching",
                        "sore"
                    ],
                    "common_phrases": [
                        "suffering humanity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий боль; характеризующийся страданием.",
                        "de": "Schmerz empfindend; durch Leiden gekennzeichnet."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страдающий",
                                "target_lang_sense_clarification": "испытывающий мучения"
                            },
                            {
                                "target_lang_word": "мучающийся",
                                "target_lang_sense_clarification": "находящийся в состоянии муки"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "leidend",
                                "target_lang_sense_clarification": "Schmerzen oder Qualen empfindend"
                            }
                        ]
                    }
                }
            ]
        }
