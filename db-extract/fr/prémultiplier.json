                ],
                "senses": [
                    {
                        "sense_id": "7b2bb7c6-d712-3f17-b518-fac7c7daaec6",
                        "entry_id": "0b1a835e-6dbc-3747-86fa-08ca16f3325d",
                        "glosses": [
                            "Assurer la prémultiplication de plants ou de semences."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7898c15-98c3-4ced-b2b7-3a5ddd2fd49b",
                                "sense_id": "7b2bb7c6-d712-3f17-b518-fac7c7daaec6",
                                "text": "Ce travail est réalisé par les pépiniéristes, les établissements agréés pour prémultiplier et les organismes situés en amont de la production (INRA, ENTAV)."
                            },
                            {
                                "example_id": "670c4f87-80bb-4381-b805-5fbbb55898be",
                                "sense_id": "7b2bb7c6-d712-3f17-b518-fac7c7daaec6",
                                "text": "Son acceptation ne devrait pas poser de difficulté et le nouveau porte-greffe sera ensuite prémultiplié et diffusé."
                            }
                        ]
                    },
                    {
                        "sense_id": "04583563-5c92-33f1-857f-a0a34fdadbbe",
                        "entry_id": "0b1a835e-6dbc-3747-86fa-08ca16f3325d",
                        "glosses": [
                            "Multiplier (une matrice A) par une autre en mettant A en deuxième dans la multiplication."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4442964-4a2a-4bda-80b2-91f276d0d700",
                                "sense_id": "04583563-5c92-33f1-857f-a0a34fdadbbe",
                                "text": "Prémultiplier une matrice X = [xᵢⱼ] de type I×J par la matrice diagonale D_I c’est multiplier chaque ligne de la matrice X par le nombre dᵢ ;"
                            },
                            {
                                "example_id": "850db5c0-74e8-4042-a913-3331c537044b",
                                "sense_id": "04583563-5c92-33f1-857f-a0a34fdadbbe",
                                "text": "Pour obtenir son image, il faut le prémultiplier par la matrice de l’application."
                            },
                            {
                                "example_id": "c6868192-91d5-4f4b-a9b7-ff7e4cb037f1",
                                "sense_id": "04583563-5c92-33f1-857f-a0a34fdadbbe",
                                "text": "Le fait qu'il soit possible de prémultiplier la matrice B par la matrice A n'implique pas qu'il soit possible de postmultiplier la matrice B par la matrice A."
                            }
                        ]
                    }
                ],
