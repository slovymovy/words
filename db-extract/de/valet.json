                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46ec957b-3875-306a-bcb3-69479499853e",
                                        "entry_id": "9259e61f-0790-3b08-9fdf-ee05a18f8285",
                                        "glosses": [
                                            "A person employed to clean or park cars."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc56a3a0-f938-3538-898b-8ab338142cf0",
                                        "entry_id": "9259e61f-0790-3b08-9fdf-ee05a18f8285",
                                        "glosses": [
                                            "A person employed to assist the jockey and trainer at a racecourse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9a79a38-492c-3c57-a064-1d6a5e4ef6cf",
                                        "entry_id": "9259e61f-0790-3b08-9fdf-ee05a18f8285",
                                        "glosses": [
                                            "A wooden stand on which to hold clothes and accessories in preparation for dressing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d54e1f7c-277b-3c1f-88e5-8816d859ca20",
                                        "entry_id": "9259e61f-0790-3b08-9fdf-ee05a18f8285",
