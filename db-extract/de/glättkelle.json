                                        "sense_id": "d01cbbbc-4b7c-3a0c-8c03-7cbf44cd8b5d",
                                        "entry_id": "6950b587-1dc6-36e3-bdac-5de16803ecac",
                                        "glosses": [
                                            "A gardener’s tool, shaped like a scoop, used in taking up plants, stirring soil etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c2711ab-f43f-4f12-b964-6e9fcbb1aa65",
                                                "sense_id": "d01cbbbc-4b7c-3a0c-8c03-7cbf44cd8b5d",
                                                "text": "I need to dig a hole for these begonias; would you pass me that trowel?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca02c51c-f0c1-3845-9004-0caaca7c6949",
                                        "entry_id": "6950b587-1dc6-36e3-bdac-5de16803ecac",
                                        "glosses": [
                                            "A tool used for smoothing a mold."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "trowel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16f26e04-3f1a-31e7-b602-0c62d7625f35",
                                        "entry_id": "7b0a3525-324a-3cd1-ad06-37a8b31c98d5",
                                        "glosses": [
                                            "To apply (a substance) with a trowel."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3404fbcb-4c1f-4b16-828d-b9df44b01197",
                                                "sense_id": "16f26e04-3f1a-31e7-b602-0c62d7625f35",
                                                "text": "He troweled the coarse mix with a twist, leaving a pattern of arcs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03113e37-ddf8-3a53-8a0e-447c3e23c578",
                                        "entry_id": "7b0a3525-324a-3cd1-ad06-37a8b31c98d5",
                                        "glosses": [
                                            "To pass over with a trowel."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93df204f-7222-4c33-afa3-5f8eb95d259c",
                                                "sense_id": "03113e37-ddf8-3a53-8a0e-447c3e23c578",
                                                "text": "Most finish coats are troweled smooth, but sometimes you will have to add cosmetic touches to make the patch match the surrounding plaster, texturing the surface randomly or uniformly with any of a variety of tools, ranging from sponges to special trowels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7e9b673-6ab6-3365-85e1-f6d7340b9cb7",
                                        "entry_id": "7b0a3525-324a-3cd1-ad06-37a8b31c98d5",
                                        "glosses": [
                                            "To apply something heavily or unsubtly."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f7b964e-208c-4ad5-bf94-67a24409fda5",
                                                "sense_id": "e7e9b673-6ab6-3365-85e1-f6d7340b9cb7",
                                                "text": "The whole Planet of the Apes set-up has been ripe for metaphor – from slavery and Afro-American revolution to European conquest of the Americas, even the war on terror. But mercifully, there's no big subtext being troweled on here."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab30dc6b-1c71-453e-be68-38e588c8b75a",
