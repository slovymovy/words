    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6c1a900a-23a7-3d67-8de5-668f85f35199",
                    "sense_definition": "Een weke, loshangende massa vet of vlees aan het lichaam.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lichaamsweefsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het grote gewichtsverlies bleef er een slappe <w>kwab</w> rond zijn buik zichtbaar.",
                            "target_lang_translations": {
                                "de": "Nach dem großen Gewichtsverlust blieb eine schlaffe <w>Falte</w> um seinen Bauch sichtbar."
                            }
                        },
                        {
                            "text": "Hij kneep bezorgd in de <w>kwab</w> vet die over zijn broekband hing.",
                            "target_lang_translations": {
                                "de": "Besorgt kniff er in den <w>Fettwulst</w>, der über seinen Hosenbund hing."
                            }
                        }
                    ],
                    "synonyms": [
                        "kwabber"
                    ],
                    "common_phrases": [
                        "kwab vet"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine weiche, herabhängende Masse aus Fett oder Fleisch am Körper."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Wulst",
                                "target_lang_sense_clarification": "Fettwulst, Hautfalte"
                            },
                            {
                                "target_lang_word": "Fettwulst",
                                "target_lang_sense_clarification": "herabhängende Fettmasse"
                            },
                            {
                                "target_lang_word": "Speckfalte",
                                "target_lang_sense_clarification": "umgangssprachlich für herabhängendes Fett"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7097275-d5df-3181-841b-f7c2d7cc2861",
                    "sense_definition": "Een anatomisch afgerond en duidelijk afgebakend gedeelte van een orgaan.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lichaamsweefsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arts wees op de scan een afwijking aan in de voorste <w>kwab</w> van de hersenen.",
                            "target_lang_translations": {
                                "de": "Der Arzt wies auf dem Scan auf eine Auffälligkeit im vorderen <w>Lappen</w> des Gehirns hin."
                            }
                        },
                        {
                            "text": "Tijdens de operatie werd een beschadigde <w>kwab</w> van de rechterlong voorzichtig verwijderd.",
                            "target_lang_translations": {
                                "de": "Während der Operation wurde ein beschädigter <w>Lappen</w> des rechten Lungenflügels vorsichtig entfernt."
                            }
                        }
                    ],
                    "synonyms": [
                        "lob"
                    ],
                    "common_phrases": [
                        "voorste kwab"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein anatomisch abgerundeter und deutlich abgegrenzter Teil eines Organs."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Lappen",
                                "target_lang_sense_clarification": "anatomisch, z. B. Hirnlappen, Lungenlappen"
                            },
                            {
                                "target_lang_word": "Lobus",
                                "target_lang_sense_clarification": "medizinischer Fachbegriff"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c13d3b23-8656-3ced-bcf5-19524fe1a065",
                    "sense_definition": "Een drijvende of weke massa van waterplanten of algen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aan het wateroppervlak van de sloot dreef een dikke, groene <w>kwab</w> van waterplanten.",
                            "target_lang_translations": {
                                "de": "Auf der Wasseroberfläche des Grabens trieb ein dicker, grüner <w>Klumpen</w> aus Wasserpflanzen."
                            }
                        },
                        {
                            "text": "De eenden zwommen moeizaam door de dichte <w>kwab</w> algen heen.",
                            "target_lang_translations": {
                                "de": "Die Enten schwammen mühsam durch den dichten <w>Algenteppich</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine schwimmende oder weiche Masse aus Wasserpflanzen oder Algen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Teppich",
                                "target_lang_sense_clarification": "Algenteppich, Wasserpflanzenteppich"
                            },
                            {
                                "target_lang_word": "Klumpen",
                                "target_lang_sense_clarification": "zusammenhängende Algenmasse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79785826-bb58-3840-b247-e6c2f7033f32",
                    "sense_definition": "Bepaalde zoetwater- of zoutwatervis die lijkt op een aal, in het bijzonder de kwabaal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De visser ving tot zijn grote verrassing een zeldzame <w>kwab</w> in het diepe meer.",
                            "target_lang_translations": {
                                "de": "Der Angler fing zu seiner großen Überraschung eine seltene <w>Quappe</w> in dem tiefen See."
                            }
                        },
                        {
                            "text": "In sommige streken wordt deze bodemvis nog steeds een <w>kwab</w> genoemd.",
                            "target_lang_translations": {
                                "de": "In einigen Regionen wird dieser Bodenfisch noch immer <w>Quappe</w> genannt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "naam voor aalachtige vissoorten"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Bestimmter Süß- oder Salzwasserfisch, der einem Aal ähnelt, insbesondere die Quappe."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Quappe",
                                "target_lang_sense_clarification": "Fischart, Aalquappe"
                            },
                            {
                                "target_lang_word": "Aalquappe",
                                "target_lang_sense_clarification": "Süßwasserfisch"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}