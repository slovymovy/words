                ],
                "senses": [
                    {
                        "sense_id": "d7182faf-d3c7-3621-89d1-4a50509bf45d",
                        "entry_id": "810252e4-63e0-3012-ae38-d4b583763494",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8646ba44-ed20-4a8a-8360-1f6cdfc41b47",
                                "sense_id": "d7182faf-d3c7-3621-89d1-4a50509bf45d",
                                "text": "Der Mainhardt trägt nie die Schals, die die Mainhardt ihm strickt."
                            },
                            {
                                "example_id": "bf21b7de-c1e1-4df9-ba28-815b33450941",
                                "sense_id": "d7182faf-d3c7-3621-89d1-4a50509bf45d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mainhardt kommt, geht der Herr Mainhardt.“"
                            },
                            {
                                "example_id": "e48642fb-4884-46d9-88fc-5616d2976dc1",
                                "sense_id": "d7182faf-d3c7-3621-89d1-4a50509bf45d",
                                "text": "Mainhardt kommt und geht."
                            },
                            {
                                "example_id": "2473329a-b89a-4759-99a3-44f27b2453c5",
                                "sense_id": "d7182faf-d3c7-3621-89d1-4a50509bf45d",
                                "text": "Mainhardts kamen, sahen und siegten."
                            },
                            {
                                "example_id": "5385622e-9c27-43e1-9219-91b2ef94002d",
                                "sense_id": "d7182faf-d3c7-3621-89d1-4a50509bf45d",
                                "text": "Frau Mainhardt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0228b6c0-c722-485e-98b9-6e1d2151b021",
                                "sense_id": "d7182faf-d3c7-3621-89d1-4a50509bf45d",
                                "text": "Herr Mainhardt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b04a8592-4cfb-476b-bb6b-50dfdd296498",
                                "sense_id": "d7182faf-d3c7-3621-89d1-4a50509bf45d",
                                "text": "Die Mainhardts fliegen heute nach La Paz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
