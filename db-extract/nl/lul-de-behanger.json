                        "examples": [
                            {
                                "example_id": "b326889c-17ef-4aa5-89c7-e7a9df64533d",
                                "sense_id": "384611eb-1f39-354e-aac0-9227cc0b9f31",
                                "text": "Als je een zenuwaanval hebt, reageer die dan af op die lul-de-behanger daar!"
                            },
                            {
                                "example_id": "2dba7033-a781-40ca-ad05-22926e440bbd",
                                "sense_id": "384611eb-1f39-354e-aac0-9227cc0b9f31",
                                "text": "'Wat voor lul-de-behanger denkt die Becker wel dat hij is!' tierde Benson. 'Dertig miljard eist die lintjesknipper, die juridische bloedzuiger... parasiteren op andermans zuurverdiende centen, dat is het enige wat die klote letseladvocaten kunnen!' tierde Benson."
                            },
                            {
                                "example_id": "500673fb-7ca8-481d-a74d-b9e4e4f2eec5",
                                "sense_id": "384611eb-1f39-354e-aac0-9227cc0b9f31",
                                "text": "Sommigen noemden hem een liberal, maar de Canastajongens van Ivor noemden hem een lachwekkende, laffe communistische lul-de-behanger, en Petes vader mocht hem ook niet."
                            }
                        ]
                    }
