                        "target_lang_word": "dickflüssig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dickflüssig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93eeae5e-6beb-378c-b440-0e7c82e567b0",
                                        "entry_id": "cd4b2e97-ec7f-3aab-827e-7c1fd13868be",
                                        "glosses": [
                                            "so, dass es zwar nicht fest ist, aber zäh fließt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd66f825-91b4-49be-b331-b16c2e4b1a84",
                                                "sense_id": "93eeae5e-6beb-378c-b440-0e7c82e567b0",
                                                "text": "Der Saft ist ausreichend eingekocht, wenn er schön dickflüssig ist."
                                            },
                                            {
                                                "example_id": "cb8cf8c8-e4e0-4d3c-bffa-7c214fe77183",
                                                "sense_id": "93eeae5e-6beb-378c-b440-0e7c82e567b0",
                                                "text": "Je größer die Viskosität, desto dickflüssiger (weniger fließfähig) ist das Fluid; je niedriger die Viskosität, desto dünnflüssiger (fließfähiger) ist es."
                                            },
                                            {
                                                "example_id": "28a2dbc8-679f-4f66-bbf2-ed327c91bc96",
                                                "sense_id": "93eeae5e-6beb-378c-b440-0e7c82e567b0",
                                                "text": "Salatsaucen auf Joghurtbasis haben einen mildsäuerlichen Grundgeschmack, sind etwas dickflüssiger und bieten sich daher auch als Dip an."
                                            },
                                            {
                                                "example_id": "4fb07fac-a7d3-452a-9203-a590e85f7835",
                                                "sense_id": "93eeae5e-6beb-378c-b440-0e7c82e567b0",
                                                "text": "„Eine dickflüssige und undurchsichtige Schicht sammelt sich auf dem Talg im Kühlschrank.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abb3802a-3b3a-4915-8612-87f3bb0e596c",
                        "source_entry_id": "92bab633-5dcd-35f1-9602-c6284d3cdf29",
                        "source_sense_id": "b54b76d8-4af5-3459-9993-667d91ccb3b2",
