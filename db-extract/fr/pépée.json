                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "2b16a4de-6573-3006-a34b-0c87ab4f96e7",
                                        "entry_id": "e70f5ae6-9e54-34f9-bd26-a39bb794b051",
                                        "glosses": [
                                            "Mädchen"
                                        ],
                                        "tags": [
                                            "casual",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2ad9598-0489-4118-bd59-bfd0960f616e",
                                                "sense_id": "2b16a4de-6573-3006-a34b-0c87ab4f96e7",
                                                "text": "Hast du die flotte Biene gesehen?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "001f05bf-39ae-4f9d-aa0e-50d2329fcdd2",
                        "source_entry_id": "5b42a124-6bcf-3fd0-b41d-c0e40e2f63a4",
                        "target_lang_word": "Mieze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mieze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "624a6e68-fd9a-31d9-bde1-edc7fccbef5d",
                                        "entry_id": "fb7669cd-de8e-3977-a837-03b958b04c85",
                                        "glosses": [
                                            "bis (niedliche) Katze"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c05af69-a41f-45b6-8853-557bef1c916a",
                                                "sense_id": "624a6e68-fd9a-31d9-bde1-edc7fccbef5d",
                                                "text": "Hast du schon diese schwarze Mieze dort gesehen, Mama?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3490ca93-4a15-33a6-b0d1-e8ff8466c28a",
                                        "entry_id": "fb7669cd-de8e-3977-a837-03b958b04c85",
                                        "glosses": [
                                            "salopp bis junge Frau"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a572b20-15f3-4617-be0a-92235b8444af",
                                                "sense_id": "3490ca93-4a15-33a6-b0d1-e8ff8466c28a",
                                                "text": "Auf der Party morgen werden sicher viele niedliche Miezen erscheinen."
                                            },
                                            {
                                                "example_id": "0a846395-727c-47a7-ada8-9012434ae81b",
                                                "sense_id": "3490ca93-4a15-33a6-b0d1-e8ff8466c28a",
                                                "text": "„Er nannte sie immer Miezen, nie Weiber oder Huren.“"
                                            }
                                        ],
