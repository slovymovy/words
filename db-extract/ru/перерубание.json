                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11c3d1e5-f16c-4261-ad01-283dcd76f377",
                                "sense_id": "c4259ae9-c4d5-3dfc-9a1f-d38ed7d7c50c",
                                "text": "В особенности вредно отражается на росте деревьев перерубание корней в летнее время, в период роста."
                            }
                        ]
                    },
                    {
                        "sense_id": "457f42a0-bdb4-320a-b280-db6f759dda43",
                        "entry_id": "df7a7f7b-1243-3296-9ff7-0c3ed355fa66",
                        "glosses": [
                            "перен., разг. разделение на части"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f23f8ef-ea4d-4c8d-a27b-7cd0bdbe9e4d",
                                "sense_id": "457f42a0-bdb4-320a-b280-db6f759dda43",
                                "text": "И Максимка, который, по странной игре случая, умел читать по складам, принимался, с обычным перерубанием слов и перестановлением ударений, выкрикивать фразы〈…〉"
                            }
                        ]
                    }
