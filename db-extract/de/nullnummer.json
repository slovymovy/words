                ],
                "senses": [
                    {
                        "sense_id": "89d4f180-01c8-3d4a-952c-435de7f80485",
                        "entry_id": "72c3a062-9429-38e8-8e43-ca82fe5813c8",
                        "glosses": [
                            "eine Nummer einer Zeitung oder Zeitschrift, die der ersten vorausgeht und die meist nicht gekauft werden kann"
                        ],
                        "tags": [
                            "Publizistik"
                        ],
                        "examples": [
                            {
                                "example_id": "ee769802-f1eb-4979-b8fc-7bd53fd4f6c9",
                                "sense_id": "89d4f180-01c8-3d4a-952c-435de7f80485",
                                "text": "Die Nullnummer [der Ver.di-Zeitung \"Publik] floppte bereits in der Vorstandsetage: Nicht bissig genug sei das Blatt, kritisierte Ver.di-Chef Frank Bsirske."
                            },
                            {
                                "example_id": "85631b8c-c046-49e8-9b0d-ec37ea8d719d",
                                "sense_id": "89d4f180-01c8-3d4a-952c-435de7f80485",
                                "text": "Die Person Jansens gilt als Gewähr dafür, daß in der Illustrierten für die rund eine Million SPD-Mitglieder nicht „Hetze auf Sozialdemokratisch\" getrieben wird, wie Wehner nach der ersten Nullnummer vom Oktober 1971 wütend monierte."
                            },
                            {
                                "example_id": "f0c8047b-5bc7-453b-a66f-6c9410cd78a8",
                                "sense_id": "89d4f180-01c8-3d4a-952c-435de7f80485",
                                "text": "Ein bei der \"Zeit\" entliehener \"Gastredakteur\" schrieb für die Nullnummer bereits einen Stimmungsbericht von der Verlagsfront: \"Eine neue Zeitung? Das wird nix!\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "544b7394-cce4-359b-92b2-0727511672a7",
                        "entry_id": "72c3a062-9429-38e8-8e43-ca82fe5813c8",
                        "glosses": [
                            "Spiel, in dem keine Tore gefallen sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5622d31-d29a-45cc-ad81-ee3dd322116c",
                                "sense_id": "544b7394-cce4-359b-92b2-0727511672a7",
                                "text": "„St. Pauli verpasste derweil durch die Nullnummer gegen Sandhausen den Sprung auf einen Aufstiegsplatz.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
