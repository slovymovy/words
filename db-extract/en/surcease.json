                "senses": [
                    {
                        "sense_id": "2b5ca1ae-5e45-3ad1-8119-bc97aa12c2ed",
                        "entry_id": "b30566b1-19ef-33b3-b69c-e521c824b228",
                        "glosses": [
                            "To come to an end; to desist."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4e2f50bd-88e4-4339-b9d8-09bab7d7d3e7",
                                "sense_id": "2b5ca1ae-5e45-3ad1-8119-bc97aa12c2ed",
                                "text": "[…] this distilled liquor drink thou off; / When presently through all thy veins shall run / A cold and drowsy humour, for no pulse / Shall keep his native progress, but surcease:"
                            },
                            {
                                "example_id": "f7b060e7-76a2-4050-a619-72f7f173b055",
                                "sense_id": "2b5ca1ae-5e45-3ad1-8119-bc97aa12c2ed",
                                "text": "1899, Zénaïde A. Ragozin, Frithjof, The Viking of Norway in Frithjof, The Viking of Norway and Roland, The Paladin of France, Tales of the Heroic Ages, New York: G.P. Putnam’s Sons, Chapter 9, p. 67,\nAnd instantly the storm surceases, the heavens clear, the sun comes forth in splendour, as a king entering the audience-hall, and sheds the glory of his presence over ship and sea and land."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d490702-2c62-3e36-8a59-5f240d3043e1",
                        "entry_id": "b30566b1-19ef-33b3-b69c-e521c824b228",
                        "glosses": [
                            "To bring to an end."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "56a23500-fd5f-4405-a402-0e6307235e58",
                                "sense_id": "4d490702-2c62-3e36-8a59-5f240d3043e1",
                                "text": "The vvaves obedient to theyr beheaſt, / Them yielded ready paſſage, and their rage ſurceaſt."
                            },
                            {
                                "example_id": "fb169f53-e62e-448a-bdb8-4bae2409861e",
                                "sense_id": "4d490702-2c62-3e36-8a59-5f240d3043e1",
                                "text": "Death dvvels vvithin vs, and if gentle Peace / Diſcend not ſoone, our ſorrovves to ſurceaſe, / Latium (alreadie quaild) vvill be deſtroyd."
                            },
                            {
                                "example_id": "6b1bec8f-94de-45e4-8c1d-8f821da5cf6f",
                                "sense_id": "4d490702-2c62-3e36-8a59-5f240d3043e1",
                                "text": "The Nations, over-avv'd, ſurceaſe the Fight, / Immoveable their Bodies, fix’d their Sight: […]"
                            }
                        ]
                    }
