                    "sense_definition": "drückt eine Gemeinschaft, Begleitung oder das Zusammensein mit Personen oder Dingen aus",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "begleitung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich gehe heute Abend <w>mit</w> meiner Schwester ins Kino."
                        },
                        {
                            "text": "Ich fahre am Wochenende gern <w>mit</w> guten Freunden aufs Land."
                        }
                    ],
                    "antonyms": [
                        "ohne"
                    ],
                    "common_phrases": [
