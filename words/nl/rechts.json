                        {
                            "text": "Ik ben <w>rechts</w>, dus ik kan niet goed met jouw linkshandige schaar knippen.",
                            "target_lang_translations": {
                                "en": "I am <w>right-handed</w>, so I can't cut well with your left-handed scissors.",
