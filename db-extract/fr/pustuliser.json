                "senses": [
                    {
                        "sense_id": "f5c2150e-dc28-33e8-a66c-15c1856f3a11",
                        "entry_id": "8e93b0e9-0c20-3f7a-93c0-04ecb4bcbb34",
                        "glosses": [
                            "Donner un caractère pustuleux à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95b10765-6365-430b-85c5-c46f447e0682",
                                "sense_id": "f5c2150e-dc28-33e8-a66c-15c1856f3a11",
                                "text": "Il faudrait de l'encre rouge Pour rouer la faux de l'âcre encens Blâmer le blase de la Blastula Pustuliser la purée des pures."
                            },
                            {
                                "example_id": "00d765e7-b819-4eee-ba61-47abe74d6856",
                                "sense_id": "f5c2150e-dc28-33e8-a66c-15c1856f3a11",
                                "text": "La coalescence de plusieurs vésicules forme une bulle.Certaines vésicules peuvent se pustuliser, le liquide n'est plus translucide mais blanc."
                            },
                            {
                                "example_id": "6687cd06-a9bc-4150-8c0c-1f50c48d12fe",
                                "sense_id": "f5c2150e-dc28-33e8-a66c-15c1856f3a11",
                                "text": "Quand une bulle a un contenu clair, si elle reste en place pendant longtemps, elle s'opacifie et se pustulise = bulle pustulisée."
                            }
                        ]
                    }
