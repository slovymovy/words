                            {
                                "target_word": "draining",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ae7c603-8738-3c2b-8151-ad9d88bf1ec9",
                                        "entry_id": "6a4dac05-080d-3482-935a-4c4b2cf3688f",
                                        "glosses": [
                                            "Designed and/or used for drainage."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3595e3e1-3128-4864-a734-6bb862d32e35",
                                                "sense_id": "8ae7c603-8738-3c2b-8151-ad9d88bf1ec9",
                                                "text": "The author of this experiment has constructed, and uses a draining wheel of cast iron, that weighs about 4 cwt ."
                                            },
                                            {
                                                "example_id": "b9556bb2-9486-4210-9fe8-9f64e26ee82b",
                                                "sense_id": "8ae7c603-8738-3c2b-8151-ad9d88bf1ec9",
                                                "text": "The mole-plough as a draining machine can never be of much utility in a country like Scotland, where alluvial deposits, though not deficient in extent, are characterized more by the abundance of stony matter than of clay in the subsoil; it is only in the few carses that such clays occur as would suit the mole plough."
                                            },
                                            {
                                                "example_id": "c9b25d22-2ed3-45ce-885f-0529d430bddd",
                                                "sense_id": "8ae7c603-8738-3c2b-8151-ad9d88bf1ec9",
                                                "text": "We made a draining rack in a few odd minutes which saved considerable time over the common method of tying in sacks."
                                            },
                                            {
                                                "example_id": "37b3fdde-a131-4b07-b8d7-07150cd55b71",
                                                "sense_id": "8ae7c603-8738-3c2b-8151-ad9d88bf1ec9",
                                                "text": "A brush support and wiping device comprising a vertical-walled skirt adapted to surround the upper periphery of a container, a draining ledge connected to the upper area of said skirt near the edge thereof and extending inwardly and downwardly therefrom at an angle of from approximately two to approximately six degrees from the horizontal , . . ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8729fbfc-429c-3038-a0b9-1fe5bf42ee61",
                                        "entry_id": "6a4dac05-080d-3482-935a-4c4b2cf3688f",
                                        "glosses": [
                                            "Causing a depletion of energy or resources; exhausting."
                                        ],
                                        "tags": [
                                            "comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97d19d02-58a1-485b-a3e7-05b13533f6dd",
                                                "sense_id": "8729fbfc-429c-3038-a0b9-1fe5bf42ee61",
                                                "text": "I was very tired; working everyday and then staying at the hospital was very draining."
                                            },
                                            {
                                                "example_id": "950d9634-c9d2-4eed-8ffe-8dc0e815938b",
                                                "sense_id": "8729fbfc-429c-3038-a0b9-1fe5bf42ee61",
                                                "text": "He was in the luxurious position of not having to hunt for girls—a process he finds very draining."
                                            },
                                            {
                                                "example_id": "35c1d9e5-9d27-4ce4-a9b0-c1a639e730e5",
                                                "sense_id": "8729fbfc-429c-3038-a0b9-1fe5bf42ee61",
                                                "text": "Not every space is going to energise you, but if you work on looking after yourself more, the tolerance levels for spaces which you found more draining will increase."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "draining",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74bc7d87-cb6f-3e9c-bce8-8f4c750b2775",
                                        "entry_id": "ee753a7d-374b-307b-a4a9-ce3a8a328e19",
                                        "glosses": [
