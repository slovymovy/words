    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c7053a26-14d5-3962-88f2-4c464879666f",
                    "sense_definition": "A long, organized journey undertaken by a group of people for a specific purpose, such as exploration, research, or war.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "journey_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientists are planning a scientific <w>expedition</w> to the Amazon rainforest.",
                            "target_lang_translations": {
                                "ru": "Ученые планируют научную <w>экспедицию</w> в тропические леса Амазонки.",
                                "zh": "科学家们正在计划前往亚马逊雨林进行一次科学<w>考察</w>。",
                                "es": "Los científicos están planeando una <w>expedición</w> científica a la selva amazónica.",
                                "tr": "Bilim insanları Amazon yağmur ormanlarına bilimsel bir <w>keşif gezisi</w> planlıyorlar.",
                                "de": "Die Wissenschaftler planen eine wissenschaftliche <w>Expedition</w> in den Amazonas-Regenwald."
                            }
                        },
                        {
                            "text": "They decided to go on an <w>expedition</w> to find the lost city.",
                            "target_lang_translations": {
                                "ru": "Они решили отправиться в <w>экспедицию</w>, чтобы найти затерянный город.",
                                "zh": "他们决定去进行一次<w>探险</w>以寻找那座失落的城市。",
                                "es": "Decidieron ir a una <w>expedición</w> para encontrar la ciudad perdida.",
                                "tr": "Kayıp şehri bulmak için bir <w>sefer</w> düzenlemeye karar verdiler.",
                                "de": "Sie beschlossen, auf <w>Expedition</w> zu gehen, um die verlorene Stadt zu finden."
                            }
                        },
                        {
                            "text": "The general led a military <w>expedition</w> across the mountains.",
                            "target_lang_translations": {
                                "ru": "Генерал возглавил военную <w>экспедицию</w> через горы.",
                                "zh": "将军率领一支军队翻越群山进行<w>远征</w>。",
                                "es": "El general dirigió una <w>expedición</w> militar a través de las montañas.",
                                "tr": "General, dağlar boyunca askeri bir <w>sefer</w> yönetti.",
                                "de": "Der General führte einen militärischen <w>Kriegszug</w> über die Berge."
                            }
                        }
                    ],
                    "synonyms": [
                        "journey",
                        "voyage",
                        "trek",
                        "mission",
                        "trip",
                        "quest"
                    ],
                    "common_phrases": [
                        "go on an expedition",
                        "scientific expedition",
                        "military expedition",
                        "mount an expedition",
                        "polar expedition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длительное организованное путешествие, предпринимаемое группой людей с определенной целью, например, для исследования, научных изысканий или военных действий.",
                        "zh": "为特定目的（如探索、研究或战争）由一群人进行的长期、有组织的旅行。",
                        "es": "Un viaje largo y organizado realizado por un grupo de personas con un propósito específico, como la exploración, la investigación o la guerra.",
                        "tr": "Belirli bir amaçla (araştırma, keşif veya savaş gibi) bir grup insan tarafından gerçekleştirilen uzun ve organize yolculuk.",
                        "de": "Eine lange, organisierte Reise, die von einer Gruppe von Menschen zu einem bestimmten Zweck unternommen wird, wie z. B. zur Erkundung, Forschung oder für militärische Zwecke."
                    },
                    "translations": {
                        "ru": [
