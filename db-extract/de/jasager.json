                "senses": [
                    {
                        "sense_id": "f4e110b9-a7ad-39a8-a9ff-93a6dfec6738",
                        "entry_id": "a28c40c4-df8b-3fd8-9e92-b5c457f039d1",
                        "glosses": [
                            "Person, die grundsätzlich zustimmt, um in der Gunst eines anderen zu stehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f979afc7-0e55-45f1-af30-a0f8184c42c0",
                                "sense_id": "f4e110b9-a7ad-39a8-a9ff-93a6dfec6738",
                                "text": "In der Firma bin ich umgeben von Jasagern, von denen keiner eine eigene Meinung zu haben scheint."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1022b096-735b-4452-a507-dd77017fbe7f",
                        "source_entry_id": "a28c40c4-df8b-3fd8-9e92-b5c457f039d1",
                        "source_sense_id": "f4e110b9-a7ad-39a8-a9ff-93a6dfec6738",
                        "source_sense_description": "Person, die grundsätzlich zustimmt, um in der Gunst eines anderen zu stehen",
                        "target_lang_word": "yes man",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yes man",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d72dcc2b-ba0d-3cc1-a8bf-afda7c7659a1",
                                        "entry_id": "3732d865-5074-3679-9be2-02b633e0046f",
                                        "glosses": [
                                            "A person who always agrees with their employer or superior."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf60830d-43d5-4620-8042-95488f5071f3",
                                                "sense_id": "d72dcc2b-ba0d-3cc1-a8bf-afda7c7659a1",
                                                "text": "Crowds of yes men elbowed one another out of the way, hoping to get a chance to kiss the boss's ring."
                                            },
                                            {
                                                "example_id": "d8645a9e-ff6c-4772-962d-678cdb34e0bf",
                                                "sense_id": "d72dcc2b-ba0d-3cc1-a8bf-afda7c7659a1",
                                                "text": "The function of a Vice-President is the job of a yes-man, as they call it in America."
                                            },
                                            {
                                                "example_id": "2325767c-3f08-4ca8-b5d8-fcfada24ea5c",
                                                "sense_id": "d72dcc2b-ba0d-3cc1-a8bf-afda7c7659a1",
                                                "text": "Rice is a \"yes man,\" says one former top government official. \"She thinks her job is just to figure out what the president is trying to say and then to say it more articulately.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcb8fab1-96a5-4b6e-933d-16c423963ebb",
                        "source_entry_id": "a28c40c4-df8b-3fd8-9e92-b5c457f039d1",
                        "source_sense_id": "f4e110b9-a7ad-39a8-a9ff-93a6dfec6738",
                        "source_sense_description": "Person, die grundsätzlich zustimmt, um in der Gunst eines anderen zu stehen",
                        "target_lang_word": "potakiwacz",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "potakiwacz",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "e34e460d-f37e-3528-8a12-78bea90bcd4f",
                                        "entry_id": "b65eb30d-9b75-39a0-b52d-d164b26159e0",
                                        "glosses": [
                                            "o kimś, kto nie wychyla się z własnym zdaniem i wszystkim potakuje"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "070c36e4-ee8b-4c83-aced-4ea9530d15e9",
                                                "sense_id": "e34e460d-f37e-3528-8a12-78bea90bcd4f",
                                                "text": "Nie bądź takim potakiwaczem, postaw się czasem."
                                            },
                                            {
                                                "example_id": "fc0c5b89-dd7b-4667-b928-254b85775ff7",
                                                "sense_id": "e34e460d-f37e-3528-8a12-78bea90bcd4f",
                                                "text": "Nawet jeśli pomysł szefa jest głupi, to grono potakiwaczy uzna go za rewelacyjny."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
