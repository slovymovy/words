    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a41af70b-41bd-314a-9008-5988598e74c8",
                "word": "bloodless",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "222d85a1-1c4e-44cf-b1cb-d25ad34cf464",
                        "entry_id": "a41af70b-41bd-314a-9008-5988598e74c8",
