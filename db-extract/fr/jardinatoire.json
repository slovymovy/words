                "senses": [
                    {
                        "sense_id": "547230f9-bb25-3602-8730-fa7facd7c705",
                        "entry_id": "2110515e-c63f-34ec-8cc3-c52c21522a92",
                        "glosses": [
                            "Relatif au jardinage des forêts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a685e27-ebe4-4581-9963-c6de9950a078",
                                "sense_id": "547230f9-bb25-3602-8730-fa7facd7c705",
                                "text": "Les coupes, de type jardinatoire, permettent la récolte des arbres mûrs, l'amélioration des peuplements et l'ouverture de taches de régénération."
                            },
                            {
                                "example_id": "e9b5afb6-862c-49f5-a3af-3a0f81cc0d65",
                                "sense_id": "547230f9-bb25-3602-8730-fa7facd7c705",
                                "text": "Lorsqu’un procès-verbal non attaqué constate que, dans une coupe jardinatoire, la souche d’un arbre coupé ne portait aucune empreinte du marteau de l’État, l’adjudicataire n’est point admissible à prouver par témoins que, lors de l’abatage, cet arbre portait une telle empreinte."
                            },
                            {
                                "example_id": "d24400ba-c3ea-4339-bd0f-9d060362d785",
                                "sense_id": "547230f9-bb25-3602-8730-fa7facd7c705",
                                "text": "Les 47 352 hectares de bois sont des forêts très irrégulières, soumises, à raison de leurs altitudes, au mode d’exploitation jardinatoire."
                            },
                            {
                                "example_id": "bdd1abae-3ae3-4229-9a20-b7445aeef891",
                                "sense_id": "547230f9-bb25-3602-8730-fa7facd7c705",
                                "text": "La forêt… sera traitée en futaie par la méthode jardinatoire et soumise à une révolution de 144 ans, divisée en douze duodécennies"
                            },
                            {
                                "example_id": "c92e21d5-00e6-4a01-a28d-da5b988d3b87",
                                "sense_id": "547230f9-bb25-3602-8730-fa7facd7c705",
                                "text": "La régénération par coupes jardinatoires présente des avantages importants."
                            },
                            {
                                "example_id": "d70a9904-c5aa-4262-b4fd-fe5780cdce50",
                                "sense_id": "547230f9-bb25-3602-8730-fa7facd7c705",
                                "text": "Dès lors, l'idée a fait son chemin et la coupe jardinatoire est admise maintenant, pour la futaie de montagne, comme offrant le plus de garanties, par tous ceux qui ont étudié sérieusement la question."
                            },
                            {
                                "example_id": "f13d617a-9eed-4fa6-bf98-0cbb5d0cd99e",
                                "sense_id": "547230f9-bb25-3602-8730-fa7facd7c705",
                                "text": "De temps immémorial, les mélézeins des Hautes-Alpes ont été exploités par la méthode jardinatoire."
                            }
                        ]
                    }
