                "senses": [
                    {
                        "sense_id": "6696860c-a8de-3c2b-93c3-7a8ca1ba7577",
                        "entry_id": "0a6ff15e-e9d8-36bc-9c47-c222616b85ba",
                        "glosses": [
                            "Route à grande circulation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6afd8b24-70f3-4837-962e-3bf56dfe6b14",
                                "sense_id": "6696860c-a8de-3c2b-93c3-7a8ca1ba7577",
                                "text": "Elle avait connu en ces temps lointains la montagne où broutent les chèvres, les aliziers vernis au tournant des grand-routes, et, le soir, l’ombre des peupliers dispersés qui s’avance en tremblant sur les prairies."
                            },
                            {
                                "example_id": "e704cae9-751b-4474-905a-e0f56d918476",
                                "sense_id": "6696860c-a8de-3c2b-93c3-7a8ca1ba7577",
                                "text": "À cause des obstacles de chaque côté de la grand-route, il éprouva des difficultés à faire tourner ses chars et half-tracks pour les lancer à l’attaque."
                            },
                            {
                                "example_id": "cbaedb18-6bb7-4dba-8e1b-980499a1b8a4",
                                "sense_id": "6696860c-a8de-3c2b-93c3-7a8ca1ba7577",
                                "text": "Il [Maigret] avait vu souvent ces camions-là, rouge et vert, traverser la ville en direction des grand-routes, et il n’avait jamais su où ils avaient leur port d’attache."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26825bf4-4e45-43d6-bda9-6e8829a78ab8",
                        "source_entry_id": "0a6ff15e-e9d8-36bc-9c47-c222616b85ba",
                        "source_sense_id": "6696860c-a8de-3c2b-93c3-7a8ca1ba7577",
                        "target_lang_word": "Hauptverkehrsstraße",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hauptverkehrsstraße",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b9806b2-8a21-3e62-9deb-565126ee55e3",
                                        "entry_id": "216f9c6d-d2e7-3155-a2c0-706d27ff8831",
                                        "glosses": [
                                            "Straße, die für den Verkehr von hoher Priorität ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64bd83e7-9832-4c30-b284-9742a32eb70e",
                                                "sense_id": "6b9806b2-8a21-3e62-9deb-565126ee55e3",
                                                "text": "„Der Rohrbruch hatte sich gegen ein Uhr nachts Ortszeit an der San Fernando Road, einer Hauptverkehrsstraße im Stadtteil Glendale, ereignet.“"
                                            },
                                            {
                                                "example_id": "445a3c0a-7322-47f7-8b14-ca007e50d936",
                                                "sense_id": "6b9806b2-8a21-3e62-9deb-565126ee55e3",
                                                "text": "„Es mag unglaublich klingen, aber in verschiedenen Großstädten verschaffen sie sich mit Hilfe sogenannter Zebrastreifen gewaltsam Zutritt zu stark befahrenen Hauptverkehrsstraßen.“"
                                            },
                                            {
                                                "example_id": "88e3c088-5fa1-479b-ae94-c32d11662cd5",
                                                "sense_id": "6b9806b2-8a21-3e62-9deb-565126ee55e3",
                                                "text": "„Ich ging inmitten einer breiten, einst lebhaft bevölkerten Hauptverkehrsstraße, heute allein auf ihrer ganzen Länge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
