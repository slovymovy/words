                "senses": [
                    {
                        "sense_id": "f2bb978e-6cab-36b8-8570-1a6bff09d3a4",
                        "entry_id": "fa2e0060-1c0f-3ce0-abba-eff7cb142aaa",
                        "glosses": [
                            "Enlever le trognon de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94b3911f-a5f2-403b-a655-60e496abc215",
                                "sense_id": "f2bb978e-6cab-36b8-8570-1a6bff09d3a4",
                                "text": "Avec un couteau pointu ou une machine à détrognonner, on enlève les trognons de choux jusqu’au cœur de la pomme, puis les choux sont coupés en lanières, comme s’il s’agissait de préparer de la choucroute."
                            },
                            {
                                "example_id": "ee99f902-005d-462c-a0ae-f00db7e51a89",
                                "sense_id": "f2bb978e-6cab-36b8-8570-1a6bff09d3a4",
                                "text": "Peler, détrognonner et couper les pommes en lamelles."
                            },
                            {
                                "example_id": "29270c7c-b52d-43b4-ab21-92ae97911341",
                                "sense_id": "f2bb978e-6cab-36b8-8570-1a6bff09d3a4",
                                "text": "Éplucher et détrognonner les pommes."
                            }
                        ]
                    }
