                        "entry_id": "c08973ff-a922-3892-a3b4-a0d5588bf72f",
                        "glosses": [
                            "de plaats waar men geboren is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bd15d0e-0008-403f-86bd-b903971d2121",
                                "sense_id": "b8ecf43e-47e6-3f15-ba83-4285f735479d",
                                "text": "\"Een van de tradities in aanloop naar het Suikerfeest is dat Indonesiërs uit de grote steden terugkeren naar hun geboortegrond. Mudik heet dat fenomeen\", vertelt Kas."
                            },
                            {
                                "example_id": "27b4853f-b7c9-4f1b-90d8-16c4a127e031",
                                "sense_id": "b8ecf43e-47e6-3f15-ba83-4285f735479d",
                                "text": "Logisch dus dat het verzet tegen de Taliban zich hier concentreert. Interim-president Saleh snelde terug naar zijn geboortegrond toen zijn voorganger Ghani het land ontvluchtte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba7aa840-0d3a-4dcf-a0e4-7342e46ac7c5",
                        "source_entry_id": "c08973ff-a922-3892-a3b4-a0d5588bf72f",
                        "source_sense_id": "b8ecf43e-47e6-3f15-ba83-4285f735479d",
                        "source_sense_description": "de plaats waar men geboren is",
                        "target_lang_word": "native soil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "native soil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2258cdc8-2fd2-3671-b065-9c5c8d54e465",
                                        "entry_id": "f2a9ffa4-68a3-3d82-9e4d-93df4bcd5faf",
                                        "glosses": [
                                            "The country or geographical region where one was born or which one considers to be one's true homeland."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf3e8daf-0696-4eb5-84d9-e3d3d03bf87d",
                                                "sense_id": "2258cdc8-2fd2-3671-b065-9c5c8d54e465",
                                                "text": "[T]hey were peculiarly honored by the unexpected presence in their midst \"of that famous son of the South, Colonel Starbottle,\" who had lately returned to his native soil from his adopted home in California."
                                            },
                                            {
                                                "example_id": "08e9057c-8a62-4a59-be82-0c856b3779ea",
                                                "sense_id": "2258cdc8-2fd2-3671-b065-9c5c8d54e465",
                                                "text": "\"Look back, Peter,\" he said, \"and you can get your last glimpse of your native soil. The black line that just shows under the sky is Sandy Hook.\""
                                            },
                                            {
                                                "example_id": "dbb4d0be-ef5e-45f7-959f-278f748f2ea6",
                                                "sense_id": "2258cdc8-2fd2-3671-b065-9c5c8d54e465",
                                                "text": "Nawaz Sharif, two-time Prime Minister of Pakistan, had planned a triumphant return to his native soil nearly seven years after choosing exile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54a2b17a-79c3-3ba2-96b5-0d2ec2407999",
                                        "entry_id": "f2a9ffa4-68a3-3d82-9e4d-93df4bcd5faf",
                                        "glosses": [
                                            "Source, place of origin, principal location, or natural habitat."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5955a309-d759-451d-ba19-2fd9af0d6ac2",
                                                "sense_id": "54a2b17a-79c3-3ba2-96b5-0d2ec2407999",
                                                "text": "[B]ut who else from seeing a plant in an herbarium can imagine its appearance when growing in its native soil?"
                                            },
                                            {
                                                "example_id": "b2428046-d4a3-47a7-b3ca-8a534b35e9a7",
                                                "sense_id": "54a2b17a-79c3-3ba2-96b5-0d2ec2407999",
                                                "text": "What a strange idea—what a needless labor—to construct artificial ruins in Rome, the native soil of ruin!"
                                            },
                                            {
                                                "example_id": "f731f495-25e0-4cfa-94a6-5d17fdd68c1b",
                                                "sense_id": "54a2b17a-79c3-3ba2-96b5-0d2ec2407999",
                                                "text": "An innate passion for all that was thus distinguished and exceptional made her revere Hillbridge as the native soil of those intellectual amenities that were of such difficult growth in the thin air of East Onondaigua."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
