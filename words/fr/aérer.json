                    "frequency": "High",
                    "semantic_group_id": "ventilation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut penser à <w>aérer</w> la chambre tous les matins."
                        },
                        {
                            "text": "J'<w>aère</w> le salon pendant dix minutes pour renouveler l'air."
                        }
                    ],
                    "common_phrases": [
