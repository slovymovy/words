                    {
                        "translation_id": "78b467ae-5e10-4e17-b4b9-a7264af827b2",
                        "source_entry_id": "3bace24e-1206-3684-89b6-7ffd715c7841",
                        "source_sense_id": "a8b91aa5-8617-3fd5-8830-65c48b7d6063",
                        "target_lang_word": "bewust",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bewust",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "42b4621f-b18c-36c6-ad9f-bfbe5447cf7e",
                                        "entry_id": "23bbf8a0-b321-3c48-ba31-b905b9cdb9dc",
                                        "glosses": [
                                            "iets waarvan kennis is genomen, iets wat met nadenken gebeurt of juist niet gebeurt, opzettelijk, expres"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ce440a4-ef7c-4dd8-88fc-2aff5fa73b61",
                                                "sense_id": "42b4621f-b18c-36c6-ad9f-bfbe5447cf7e",
                                                "text": "Het was een bewuste keuze om niet eerst langs de receptie te gaan."
                                            },
                                            {
                                                "example_id": "d6f4186e-888f-49dd-8219-b635f5b75a76",
                                                "sense_id": "42b4621f-b18c-36c6-ad9f-bfbe5447cf7e",
                                                "text": "En zo liet hij ook deze gelegenheid om over Katarina en haar kinderen te vertellen uit zijn handen glippen. Ondanks het feit dat zijn zoon, bewust Of onbewust, hem zo goed als had geprovoceerd om het onderwerp ter sprake te brengen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa3698c1-c089-36b4-9c4f-bb38e1b2f4ab",
                                        "entry_id": "23bbf8a0-b321-3c48-ba31-b905b9cdb9dc",
                                        "glosses": [
                                            "bewust van op de hoogte met iets, iets beseffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "209f584c-228a-4fd3-bcd4-cc5577e0c606",
                                                "sense_id": "aa3698c1-c089-36b4-9c4f-bb38e1b2f4ab",
                                                "text": "De zich van het pas gebeurde ongeluk niet bewuste automobilisten konden maar net een kettingbotsing vermijden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfaaf87d-f947-3aa9-bdb9-fbac06660224",
                                        "entry_id": "23bbf8a0-b321-3c48-ba31-b905b9cdb9dc",
                                        "glosses": [
                                            "predicatief met oorzakelijk voorwerp: zich iets bewust zijn op de hoogte zijn met iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ec159a6-d486-4598-8b8e-cc0f2902e27d",
                                                "sense_id": "cfaaf87d-f947-3aa9-bdb9-fbac06660224",
                                                "text": "Hij was zich dat niet bewust."
                                            },
                                            {
                                                "example_id": "6da6705e-cdbe-4313-8ebf-14fd45a5e054",
                                                "sense_id": "cfaaf87d-f947-3aa9-bdb9-fbac06660224",
                                                "text": "Teresa was zich vaag bewust van andere passagiers, achter haar op het dek, die een wandeling maakten voordat het donker werd."
                                            },
                                            {
                                                "example_id": "2f2bfe6a-2793-4303-b28e-3af2ab2672a9",
                                                "sense_id": "cfaaf87d-f947-3aa9-bdb9-fbac06660224",
                                                "text": "De winst voor een aannemer kon in zo'n project hoogstens matig worden. Daar waren beide partijen zich van bewust. Maar winst bestond niet alleen uit geld."
                                            },
                                            {
                                                "example_id": "d00ac3e4-f31a-41c3-950f-a773c32aaa9a",
                                                "sense_id": "cfaaf87d-f947-3aa9-bdb9-fbac06660224",
                                                "text": "Het was het lot tarten en daar was hij zich goed van bewust."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b960c465-dfed-3256-aca4-644a035587ae",
                                        "entry_id": "23bbf8a0-b321-3c48-ba31-b905b9cdb9dc",
                                        "glosses": [
                                            "attributief eerdergenoemd, waarover eerder is gesproken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1a58a9e-f652-4461-9c80-837d4433447e",
                                                "sense_id": "b960c465-dfed-3256-aca4-644a035587ae",
                                                "text": "Gisteren is mijn mobiele telefoon gestolen. De bewuste diefstal vond plaats in een café."
                                            },
                                            {
                                                "example_id": "09c55e7f-5fe0-4371-8e61-ae563e2b0296",
                                                "sense_id": "b960c465-dfed-3256-aca4-644a035587ae",
                                                "text": "Mijn vrouw houdt niet van vliegen waardoor zij dertig jaar geleden de bewuste keuze heeft gemaakt dat nooit meer te doen. Ze was dan ook allang blij dat ze niet met mij mee hoefde op mijn verre reizen, maar was wel vanaf het begin mijn grootste supporter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e058e3c-07d2-4733-bac0-0a5b0bb76916",
                        "source_entry_id": "3bace24e-1206-3684-89b6-7ffd715c7841",
