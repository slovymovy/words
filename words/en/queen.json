                                "target_lang_sense_clarification": "用于繁育的雌性猫"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45bc5552-abd1-369a-9f11-96a9deb1deae",
                    "sense_definition": "A homosexual man, especially one who is flamboyant or effeminate.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a total <w>queen</w> when it comes to fashion and drama.",
                            "target_lang_translations": {
                                "ru": "Он ведет себя как настоящая <w>королева</w> драмы, когда дело касается моды.",
                                "zh": "一谈到时尚和戏剧，他简直就是个<w>皇后</w>。"
                            }
                        },
                        {
                            "text": "The club was full of <w>queens</w> dressed in amazing outfits.",
                            "target_lang_translations": {
                                "ru": "В клубе было полно <w>квин</w>, одетых в потрясающие наряды.",
                                "zh": "俱乐部里到处都是穿着华丽服装的<w>皇后</w>。"
                            }
                        }
