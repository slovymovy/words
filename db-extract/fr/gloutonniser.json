                "senses": [
                    {
                        "sense_id": "2bf25801-aeb6-3768-91fe-5d7c3c03e970",
                        "entry_id": "ba4bafc1-c7d0-315d-b836-2d166b4c997e",
                        "glosses": [
                            "Avaler de façon gloutonne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcde2530-c945-4fdf-8b16-c2d9d7c9a977",
                                "sense_id": "2bf25801-aeb6-3768-91fe-5d7c3c03e970",
                                "text": "Vous êtes un homme : Attendez-vous à vous faire gloutonniser !"
                            },
                            {
                                "example_id": "652b6205-0394-4186-a5b9-91712e3099b9",
                                "sense_id": "2bf25801-aeb6-3768-91fe-5d7c3c03e970",
                                "text": "Non mais il va être gêné par la conso ! Sur les petits trajets (et on en fait beaucoup dans les campagnes) la mienne gloutonnise facilement 15 à 18 l aux 100."
                            },
                            {
                                "example_id": "d41d6a14-a0b1-45d7-95bf-3827a0f917b6",
                                "sense_id": "2bf25801-aeb6-3768-91fe-5d7c3c03e970",
                                "text": "Bref ! Me gloutonniser la coquille !"
                            }
                        ]
                    }
