                        "entry_id": "cc6080e0-5600-3369-907e-b545841f077c",
                        "glosses": [
                            "Nom générique des hydrocarbures renfermant plusieurs doubles liaisons carbone-carbone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4fb1fc7-2bc2-457d-a42a-45693e328ed0",
                                "sense_id": "8a59f4b9-625f-3b91-87cd-38729ec0ae99",
                                "text": "Le polybutadiène, répétition de plusieurs 1,4-butadiènes et 1,2-butadiènes, est un polyène."
                            },
                            {
                                "example_id": "8bc4d5f3-6a60-4651-9091-c9fa5a0494f7",
                                "sense_id": "8a59f4b9-625f-3b91-87cd-38729ec0ae99",
                                "text": "Il apparaît que l’hexatriène 24 à une certaine énergie de résonnance, ce qui traduit bien le fait que la conjugaison dans un polyène ouvert est un facteur de stabilisation thermodynamique (et non cinétique, l’hexatriène étant plus réactif que l’éthylène)."
                            }
                        ]
                    }
