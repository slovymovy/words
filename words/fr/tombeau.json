    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "803b7a87-c514-3876-8b64-ab09c3713a08",
                    "sense_definition": "Monument funéraire élevé sur une sépulture pour honorer la mémoire d'un mort.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mort_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette ancienne chapelle abrite le <w>tombeau</w> en marbre blanc d'un célèbre évêque."
                        },
                        {
                            "text": "Des centaines de touristes visitent chaque jour le <w>tombeau</w> de l'empereur dans la crypte."
                        }
                    ],
                    "synonyms": [
                        "dernière demeure",
                        "sépulcre",
                        "sépulture",
                        "tombe"
                    ],
                    "common_phrases": [
                        "tombeau de famille"
                    ]
                },
                {
                    "sense_id": "efe75538-f936-31a6-8a45-eed685c80612",
                    "sense_definition": "La mort, en tant que terme inéluctable de la vie humaine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mort_figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il lui a juré un amour éternel et une fidélité sans faille jusqu'au <w>tombeau</w>."
                        },
                        {
                            "text": "Cette terrible maladie l'a conduit prématurément au <w>tombeau</w> après des mois de souffrance."
                        }
                    ],
                    "common_phrases": [
                        "jusqu'au tombeau",
                        "descendre au tombeau",
                        "mener au tombeau"
                    ]
                },
                {
                    "sense_id": "5da8c9a8-6443-348d-b7c7-36402e379440",
                    "sense_definition": "Ce qui détruit entièrement ou précipite la ruine de quelque chose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon plusieurs historiens, la corruption généralisée a été le véritable <w>tombeau</w> de cette république."
                        },
                        {
                            "text": "Cette crise financière inattendue est devenue le <w>tombeau</w> de leurs plus grands espoirs."
                        }
                    ]
                },
                {
                    "sense_id": "99ccce00-3bd2-3cb1-b343-f280f7117cc8",
                    "sense_definition": "Œuvre poétique ou pièce musicale composée en hommage solennel à une personne disparue.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hommage_artistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'orchestre a interprété ce magnifique <w>tombeau</w> écrit en hommage à un grand compositeur baroque."
                        },
                        {
                            "text": "Les poètes de l'époque ont publié un <w>tombeau</w> littéraire pour célébrer leur défunt maître."
                        }
                    ],
                    "common_phrases": [
                        "tombeau musical",
                        "tombeau poétique"
                    ]
                }
            ]
        }
    ]
