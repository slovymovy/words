        "fr-extract.jsonl": [
            {
                "entry_id": "8223d1fb-b6cc-3a41-bd6d-39b0ef15a0ee",
                "word": "bakélite",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "54932c90-10c1-385c-a781-3fac3b885b29",
                        "entry_id": "8223d1fb-b6cc-3a41-bd6d-39b0ef15a0ee",
                        "glosses": [
                            "Matériau constitué à partir d’une résine de formaldéhyde de phénol thermodurcissable aussi appelée phénoplaste. Ce fut le premier plastique fait de polymères synthétiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "382d040f-74bf-4674-9ef9-e599bc79b38a",
                                "sense_id": "54932c90-10c1-385c-a781-3fac3b885b29",
                                "text": "Tes petits seins de Bakélite, qui s’agitent."
                            },
                            {
                                "example_id": "1b81afca-0d13-4c6d-9fdb-d345e7e77b79",
                                "sense_id": "54932c90-10c1-385c-a781-3fac3b885b29",
                                "text": "L’homme appuya sur un petit bouton en Bakélite verte, incrusté sur la droite de l’appareil."
                            },
                            {
                                "example_id": "f64595cf-7f63-4b8a-b65e-dc69c01caa0f",
                                "sense_id": "54932c90-10c1-385c-a781-3fac3b885b29",
                                "text": "Légère, résistante à la chaleur et à de nombreux produits chimiques, la bakélite est un excellent isolant électrique, qui a été rapidement adopté par l'industrie de construction électrique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce48d354-ad9e-4964-81c1-6017968fa623",
                        "source_entry_id": "8223d1fb-b6cc-3a41-bd6d-39b0ef15a0ee",
                        "source_sense_id": "54932c90-10c1-385c-a781-3fac3b885b29",
                        "target_lang_word": "Bakelit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bakelit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1262af9c-a405-394a-8297-a58ddcbf412a",
                                        "entry_id": "4dae5c8f-a2d8-3cda-90db-fa67cdb62d63",
                                        "glosses": [
                                            "fester, spröder Kunststoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64cb5b84-4b4e-462b-9050-0cc5a5dd7848",
                                                "sense_id": "1262af9c-a405-394a-8297-a58ddcbf412a",
                                                "text": "„In der Ecke steht ein Sofa, an der Fensterwand die Anrichte, daneben hängt das ovale Foto mit meiner Oma drauf als junge Dame, und auf einem Schränkchen steht das Radio aus Bakelit.“"
                                            },
                                            {
                                                "example_id": "7468b8ce-da40-40a5-a6c1-5bbb6f4b99fb",
                                                "sense_id": "1262af9c-a405-394a-8297-a58ddcbf412a",
                                                "text": "„Das neue Lenkrad war ein wenig größer, und das Bakelit war auch nicht mit Leder bezogen, so dass es nicht so gut in den Händen lag wie das alte Lenkrad.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
