                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is currently <w>arranging</w> the flowers for the wedding reception.",
                            "target_lang_translations": {
                                "ru": "Она сейчас <w>расставляет</w> цветы для свадебного банкета."
                            }
                        },
                        {
                            "text": "I am <w>arranging</w> a meeting to discuss the new project details.",
                            "target_lang_translations": {
                                "ru": "Я <w>организовываю</w> встречу, чтобы обсудить детали нового проекта."
