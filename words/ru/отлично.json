    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "eb27db25-f844-3fab-941d-1795d13c0661",
                    "sense_definition": "Очень хорошо, превосходно; наилучшим образом.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "quality_good",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я сегодня <w>отлично</w> себя чувствую после долгого сна.",
                            "target_lang_translations": {
                                "en": "I feel <w>great</w> today after a long sleep.",
                                "zh": "睡了个长觉后，我今天感觉<w>很好</w>。"
                            }
                        },
                        {
                            "text": "Они <w>отлично</w> провели время в отпуске на море.",
                            "target_lang_translations": {
                                "en": "They had an <w>excellent</w> time on vacation by the sea.",
                                "zh": "他们在海边度假时过得<w>非常愉快</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "великолепно",
                        "превосходно",
                        "прекрасно",
                        "хорошо",
                        "замечательно"
                    ],
                    "antonyms": [
                        "плохо"
                    ],
                    "common_phrases": [
