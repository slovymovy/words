                        "glosses": [
                            "A flower of genus Soldanella."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcebf673-db5f-4c92-a2e9-0ba3a81a2222",
                                "sense_id": "09f983cf-7eec-3bb2-b41a-064a25dc1657",
                                "text": "Great belts of blue gentian hang like a zone on the mountain slopes; masses of yellow globe-flower star the upland pastures; nodding heads of soldanella lurk low among the rugged boulders by the glacier's side."
                            },
                            {
                                "example_id": "540a7a81-b0b3-4e9a-a57a-727d813f0b13",
                                "sense_id": "09f983cf-7eec-3bb2-b41a-064a25dc1657",
                                "text": "Some of my own best Ski-ing days have been late in March when the crocuses and gentians were already opening to the sun on the Southern slopes, and a soldanella might be found along some tiny stream."
                            }
                        ]
                    }
