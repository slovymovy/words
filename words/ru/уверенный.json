                    "sense_definition": "Выражающий сознание собственной силы, твердости или спокойствия (о жестах, походке, взгляде).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confident_expression",
                    "name_type": "no",
                    "examples": [
