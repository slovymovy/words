                "senses": [
                    {
                        "sense_id": "cedd3305-7441-384e-bf5a-b5d43d25d976",
                        "entry_id": "97f7d49a-4e16-356d-a04b-cb3285ae8b92",
                        "glosses": [
                            "enge Mütze aus Gummi, die man beim Schwimmen trägt, um die Haare zusammenzuhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84f75210-216e-4f0a-bc37-93277a97d188",
                                "sense_id": "cedd3305-7441-384e-bf5a-b5d43d25d976",
                                "text": "Sie trug einen blauen Badeanzug und eine gleichfarbige Badekappe."
                            },
                            {
                                "example_id": "88918d20-9af6-47a4-9e65-2570be1070d8",
                                "sense_id": "cedd3305-7441-384e-bf5a-b5d43d25d976",
                                "text": "„Ein paar Haarsträhnen sind unter der Badekappe hervorgerutscht, die Myriam ihr gekauft hat.“"
                            },
                            {
                                "example_id": "01441ffe-6e0e-4aa6-9d97-837bb56755a1",
                                "sense_id": "cedd3305-7441-384e-bf5a-b5d43d25d976",
                                "text": "„'Sie hatte eine Badekappe übergezogen und tropfte vor Wasser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b0ea6b1-1215-4005-95b8-68d016194492",
                        "source_entry_id": "97f7d49a-4e16-356d-a04b-cb3285ae8b92",
                        "source_sense_id": "cedd3305-7441-384e-bf5a-b5d43d25d976",
                        "source_sense_description": "enge Mütze aus Gummi, die man beim Schwimmen trägt, um die Haare zusammenzuhalten",
                        "target_lang_word": "bathing-cap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bathing-cap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "032f05d1-c5c8-3740-946b-b2bf553de4f4",
                                        "entry_id": "5c9c673c-7573-316a-97bf-7411142693c5",
                                        "glosses": [
                                            "Dated form of bathing cap."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3b8bc50-c93e-48fc-957b-ae53f3ade3c1",
                                                "sense_id": "032f05d1-c5c8-3740-946b-b2bf553de4f4",
                                                "text": "Oiled Silk and Linen Great Coats, Cloaks, Hoods, Capuchins, Riding Aprons, Bathing-caps and Hat-caſes; […]"
                                            },
                                            {
                                                "example_id": "ad50a52f-1ee4-403b-8af5-448ba6877aa1",
                                                "sense_id": "032f05d1-c5c8-3740-946b-b2bf553de4f4",
                                                "text": "Alſo various Kinds of Perfumery, Oil’d Silk and Linen Bathing-Caps, Ladies Hoods and Hat-Covers, Gentlemens’^([sic]) Hat-Covers and Caſes, and Riding Aprons, on reaſonable Terms."
                                            },
                                            {
                                                "example_id": "1803fee8-b2de-44e3-a523-b8108cd58037",
                                                "sense_id": "032f05d1-c5c8-3740-946b-b2bf553de4f4",
                                                "text": "Beſt Oiled Lawn Bathing-Caps at 1 s. 8 d. each.—Beſt Oiled Silk Bathing-Caps at 2 s. 6 d. each."
                                            },
                                            {
                                                "example_id": "d9a9d8ff-0ace-4a57-a226-231a5b3a6009",
                                                "sense_id": "032f05d1-c5c8-3740-946b-b2bf553de4f4",
                                                "text": "The dog drew him to ſhore by ſeizing hold of his bathing-cap."
                                            },
                                            {
                                                "example_id": "630ae60e-78a8-4cf0-8ce6-aed7bce78e9f",
                                                "sense_id": "032f05d1-c5c8-3740-946b-b2bf553de4f4",
                                                "text": "From the carpet-bag she took out seven flannel nightgowns, four cotton ones, a pair of boots, a set of dominoes, two bathing-caps and a postcard album."
                                            },
                                            {
                                                "example_id": "6be8eb20-e715-4bd5-93ec-045287bbefac",
                                                "sense_id": "032f05d1-c5c8-3740-946b-b2bf553de4f4",
                                                "text": "I believe the artist counts on us to chuckle at the fact that in contrast to Michelangelo’s Christ-like titans who were sometimes constrained by classical bindings around their chests, his aerobicized new-age Christ figures suffer the indignity of too-tight bathing-caps."
                                            },
                                            {
                                                "example_id": "1c25bc06-dbcf-470e-8a55-ac8b8145a35d",
                                                "sense_id": "032f05d1-c5c8-3740-946b-b2bf553de4f4",
                                                "text": "It’s hard to pick a winner, but I have to go for the rubber bathing-cap she wore to kiss Richard Burton."
                                            },
                                            {
                                                "example_id": "b95ab254-4bf9-44af-bdbd-5871d44dd5a1",
                                                "sense_id": "032f05d1-c5c8-3740-946b-b2bf553de4f4",
                                                "text": "Morrison, the leader of their inner circle of campus radicals, in the yellow winding-sheet, his freckled face covered with pancake make-up, his red hair stuffed into a yellow bathing-cap, announcing he would immolate himself at dawn."
                                            },
                                            {
                                                "example_id": "07b6b79e-6852-42a9-87ad-7e00b4e1d125",
                                                "sense_id": "032f05d1-c5c8-3740-946b-b2bf553de4f4",
                                                "text": "Just one slab of it could have doubled as a rubber bathing-cap."
                                            },
                                            {
                                                "example_id": "e00a98d3-2488-497c-ae98-421585311a55",
                                                "sense_id": "032f05d1-c5c8-3740-946b-b2bf553de4f4",
                                                "text": "After midnight, the costumes got wilder. A full-fig Pharaoh chatted to a mad person in a baldie bathing-cap and Mr Spock ears."
                                            },
                                            {
                                                "example_id": "f7462e5e-fce3-4292-8475-f68c1c1b090d",
                                                "sense_id": "032f05d1-c5c8-3740-946b-b2bf553de4f4",
                                                "text": "Arm-bands, bathing-caps, tutus and wellies supply just enough aquatic detail for the imagination to take flight."
                                            },
                                            {
                                                "example_id": "7be6e800-bd3b-499c-aa2a-b091a1d44ba6",
                                                "sense_id": "032f05d1-c5c8-3740-946b-b2bf553de4f4",
                                                "text": "It was the colours that struck me when I first saw this: reds and pale yellows reflecting each other throughout the image, from the flowers in the woman’s bathing-cap to her red, red lips to the cushions that take us around to the dishes on the table, all perfectly set off by cool, pale blue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "655efc21-81dd-4528-86a0-58ab674aad5b",
                        "source_entry_id": "97f7d49a-4e16-356d-a04b-cb3285ae8b92",
