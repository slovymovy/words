                ],
                "senses": [
                    {
                        "sense_id": "e353525f-5118-3ead-944a-7a422bbe8992",
                        "entry_id": "d3ddbde3-4a0d-33ec-86b5-6e8606f23d4c",
                        "glosses": [
                            "technische Bestandteile einer Lüftungsanlage; Teile"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3881d0ec-ecbf-4f06-a5e6-f39ba9b212dd",
                                "sense_id": "e353525f-5118-3ead-944a-7a422bbe8992",
                                "text": "„Die Anpassung der Lüftungskomponenten auf unterschiedliche Größen, Varianten und Farben ist für DECON kein Problem.“"
                            },
                            {
                                "example_id": "459e6a9d-2ff9-4d59-a9fb-4fb6a3e74431",
                                "sense_id": "e353525f-5118-3ead-944a-7a422bbe8992",
                                "text": "„Zunächst soll hier das Grundprinzip der Volumenstromermittlung zur Auslegung der Lüftungskomponenten nach DIN 1946-6 dargestellt werden.“"
                            },
                            {
                                "example_id": "4a38d81a-e8c0-4768-bb99-3b50620a47c5",
                                "sense_id": "e353525f-5118-3ead-944a-7a422bbe8992",
                                "text": "„Als Ihr lokaler Ansprechpartner unterbreiten wir Ihnen gern Angebote für Lüftungskomponenten, wie z.B. Luftdurchlässe (für Wohn- und Nichtwohngebäude), Quellluftsysteme, Ventilatorkonvektoren (Fan Coils) und Deckenkassetten, Kühlbalken oder Volumenstromregler.“"
                            },
                            {
                                "example_id": "8247851a-d368-46a9-9970-80ede8b5a745",
                                "sense_id": "e353525f-5118-3ead-944a-7a422bbe8992",
                                "text": "„Es wird eine Lüftungskomponente vorgestellt, die zwei Funktionen übernimmt: Lufttransport und Wärmerückgewinnung.“"
                            },
                            {
                                "example_id": "99aafbac-6ceb-4c45-a051-501148afaf09",
                                "sense_id": "e353525f-5118-3ead-944a-7a422bbe8992",
                                "text": "„Die Produktlinie der Lüftungskomponenten beinhaltet verschiedene Luftauslasstypen für induzierende und laminare Lufteinführung sowie Volumenstromregler und Schalldämpfer für die Luftmengenregulierung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5adaa22e-daa8-3409-93de-57d9261ca219",
                        "entry_id": "d3ddbde3-4a0d-33ec-86b5-6e8606f23d4c",
                        "glosses": [
                            "(kPl.) Systembegriff in der Architektur für Teilbereiche eines Gebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3352de4f-55b2-4aac-9318-8f0d88ea707f",
                                "sense_id": "5adaa22e-daa8-3409-93de-57d9261ca219",
                                "text": "In einem Architekturbüro werden alle Komponenten zu einem Bauwerk kalkuliert, geplant und realisiert - so auch die Lüftungskomponente."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
