                        "translation_id": "25d9441b-74e7-47af-9b77-742519d9f3b3",
                        "source_entry_id": "e8a171e6-e9aa-3218-8014-1be8ba5cde51",
                        "source_sense_id": "5c5be25b-053e-36a7-a913-7a7674badfa5",
                        "source_sense_description": "scholar of climatology",
                        "target_lang_word": "Klimaforscher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klimaforscher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b0a7ba6-920d-304f-ae34-843dd099c0e1",
                                        "entry_id": "a5de44b6-0b44-3b94-9db5-0589e9cba502",
                                        "glosses": [
                                            "Wissenschaftler, der die Gesetzmäßigkeiten des Klimas erforscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61274842-5131-4f20-bfe2-f3752b216466",
                                                "sense_id": "4b0a7ba6-920d-304f-ae34-843dd099c0e1",
                                                "text": "Viele Klimaforscher warnen vor den Folgen der globalen Erwärmung."
                                            },
                                            {
                                                "example_id": "9d303a8b-693e-43d8-a05f-411b56d1719c",
                                                "sense_id": "4b0a7ba6-920d-304f-ae34-843dd099c0e1",
                                                "text": "„Es ist ein Rätsel, das die Klimaforscher bis heute umtreibt, auch wenn man nun einige Antworten hat: Von 1998 bis 2012 stockte die globale Erwärmung, und lange war nicht klar, was der Grund dafür gewesen sein könnte.“"
                                            },
                                            {
                                                "example_id": "21105d5b-3a45-4fb4-be3a-8c871ec4ce4f",
                                                "sense_id": "4b0a7ba6-920d-304f-ae34-843dd099c0e1",
                                                "text": "„Die Klimaforscher warnen, dass vor allem Trichlorfluormethan stark wirksam ist: Es heizt nicht nur das Klima auf, sondern zerstört zusätzlich die filternde Ozonschicht.“"
                                            },
                                            {
                                                "example_id": "9f95ae5e-03e7-4a5f-a375-c569ad7f6673",
                                                "sense_id": "4b0a7ba6-920d-304f-ae34-843dd099c0e1",
                                                "text": "„Klimaforscherinnen und Klimaforscher beschäftigen sich schon seit Jahren mit der Frage, bis wann die Welt bei Netto-Null-Emissionen ankommen muss, um den Klimawandel unter Kontrolle zu bekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c21e206b-f628-4b36-b425-cddfc3789552",
                        "source_entry_id": "e8a171e6-e9aa-3218-8014-1be8ba5cde51",
                        "source_sense_id": "5c5be25b-053e-36a7-a913-7a7674badfa5",
                        "source_sense_description": "scholar of climatology",
                        "target_lang_word": "Klimaforscherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klimaforscherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4391505-c8a9-38c8-a5f4-7892f94dfca5",
                                        "entry_id": "361c3282-4513-3a22-bcf4-9a6acbb42ad0",
                                        "glosses": [
                                            "Wissenschaftlerin, die die Gesetzmäßigkeiten des Klimas erforscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35368e0a-c0bd-44a6-ac3c-0aa6cb418003",
                                                "sense_id": "c4391505-c8a9-38c8-a5f4-7892f94dfca5",
                                                "text": "Viele Klimaforscherinnen warnen vor den Folgen der globalen Erwärmung."
                                            },
                                            {
                                                "example_id": "92f5f74a-381b-453f-824f-7b5296133b3c",
                                                "sense_id": "c4391505-c8a9-38c8-a5f4-7892f94dfca5",
                                                "text": "„Eine von ihnen, die Meteorologin und Klimaforscherin Helga Kromp-Kolb fasste die Forderungen so zusammen: \"Eine Diskussion darüber, welche Maßnahmen erforderlich sind, ist obsolet. Es sind fast alle erforderlich.\"“"
                                            },
                                            {
                                                "example_id": "2845aea9-68c0-41b1-b114-6daf25a2384a",
                                                "sense_id": "c4391505-c8a9-38c8-a5f4-7892f94dfca5",
                                                "text": "„Klimaforscherinnen und Klimaforscher beschäftigen sich schon seit Jahren mit der Frage, bis wann die Welt bei Netto-Null-Emissionen ankommen muss, um den Klimawandel unter Kontrolle zu bekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
