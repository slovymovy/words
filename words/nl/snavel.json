                    "sense_id": "a0325807-ca63-3dcf-8652-0e19a6820cf4",
                    "sense_definition": "de harde, hoornachtige bek van een vogel of een schildpad",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "anatomie van dieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bergeend heeft een opvallende rode <w>snavel</w> waarmee hij voedsel uit het water filtert.",
                            "target_lang_translations": {
                                "en": "The common shelduck has a striking red <w>bill</w> with which it filters food from the water."
                            }
                        },
                        {
                            "text": "De vogel opende zijn <w>snavel</w> om een luid lied te zingen in de vroege ochtend.",
                            "target_lang_translations": {
                                "en": "The bird opened its <w>beak</w> to sing a loud song in the early morning."
                            }
                        }
                    ],
                    "synonyms": [
                        "bek"
                    ],
                    "common_phrases": [
                        "kromme snavel",
                        "scherpe snavel"
                    ],
                    "target_lang_definitions": {
                        "en": "the hard, horny mouthpart of a bird or a turtle"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beak",
                                "target_lang_sense_clarification": "general term for the hard mouthpart of birds and turtles"
                            },
                            {
                                "target_lang_word": "bill",
                                "target_lang_sense_clarification": "often used for smaller, flatter, or softer bird mouthparts"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b831a6f-191d-3b9f-b644-d962554d5361",
                    "sense_definition": "een informele of onbeleefde manier om naar de mond van een mens te verwijzen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomie van mensen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet nu echt je <w>snavel</w> houden want ik probeer me te concentreren op mijn werk.",
                            "target_lang_translations": {
                                "en": "You really need to shut your <w>trap</w> now because I'm trying to concentrate on my work."
                            }
                        },
                        {
                            "text": "Hij hield eindelijk zijn <w>snavel</w> nadat de leraar hem streng aankeek.",
                            "target_lang_translations": {
                                "en": "He finally shut his <w>mouth</w> after the teacher gave him a stern look."
                            }
                        }
                    ],
                    "synonyms": [
                        "mond",
                        "bek",
                        "snater",
                        "waffel",
                        "klep",
                        "bakkes"
                    ],
                    "common_phrases": [
                        "je snavel houden"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in de gebiedende wijs om iemand te bevelen te zwijgen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an informal or rude way to refer to a person's mouth"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beak",
                                "target_lang_sense_clarification": "slang for a person's mouth or nose"
                            },
                            {
                                "target_lang_word": "trap",
