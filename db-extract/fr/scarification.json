                                        "examples": [
                                            {
                                                "example_id": "72c03d51-61bd-4b5f-8ff4-065eaeb98efc",
                                                "sense_id": "dfc63ab1-4e02-3e60-88ec-8b57cdeda409",
                                                "text": "De kleuter kraste maar wat met haar potlood in het schrift en de ouders dachten dat het mooie figuren waren."
                                            },
                                            {
                                                "example_id": "0849ad2e-ce72-41e5-9245-3ee877d894f2",
                                                "sense_id": "dfc63ab1-4e02-3e60-88ec-8b57cdeda409",
                                                "text": "De jongen naast me deed zijn koplamp aan waardoor de in de muur gekraste namen zichtbaar werden: hier waren al eerder mensen gestrand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10c7557c-d61b-3977-af9b-9637787f9625",
                                        "entry_id": "939dcb46-d631-33c7-959d-8343150dcb63",
