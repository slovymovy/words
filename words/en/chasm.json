{
    "word_family": [
        "chasmic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c90dda3b-43f5-3919-a4af-745dbc7d6813",
                    "sense_definition": "A deep, steep-sided rift, gap or fissure in the earth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_gap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers carefully crossed the narrow bridge over the deep <w>chasm</w>.",
                            "target_lang_translations": {
                                "zh": "徒步旅行者小心翼翼地穿过了那座横跨深<w>渊</w>的狭窄桥梁。",
                                "ru": "Туристы осторожно перешли по узкому мосту через глубокую <w>пропасть</w>."
                            }
                        },
                        {
                            "text": "A dark <w>chasm</w> opened up in the ground after the earthquake.",
                            "target_lang_translations": {
                                "zh": "地震后，地面上裂开了一道黑暗的<w>裂口</w>。",
                                "ru": "После землетрясения в земле открылась тёмная <w>расщелина</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "abyss",
                        "gorge",
                        "ravine"
                    ],
                    "common_phrases": [
                        "deep chasm",
                        "yawning chasm"
                    ],
                    "target_lang_definitions": {
                        "zh": "地表上深而陡峭的裂缝、裂口或深渊。",
                        "ru": "Глубокая и крутая трещина, разлом или расселина в земной поверхности."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "深渊",
                                "target_lang_sense_clarification": "指极深的地形裂缝。"
                            },
                            {
                                "target_lang_word": "裂口",
                                "target_lang_sense_clarification": "指地表上的裂缝或缺口。"
                            },
                            {
                                "target_lang_word": "峡谷",
                                "target_lang_sense_clarification": "指两山之间狭长而深的地形。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "про́пасть",
                                "target_lang_sense_clarification": "глубокий обрыв или расселина в земле."
                            },
                            {
                                "target_lang_word": "бе́здна",
                                "target_lang_sense_clarification": "неизмеримо глубокое пространство или расщелина."
                            },
                            {
                                "target_lang_word": "расще́лина",
                                "target_lang_sense_clarification": "узкая трещина в горной породе или земле."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c24c3681-d814-3561-9381-8334fba7e41d",
                    "sense_definition": "A significant difference or division between people, ideas, or groups.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_gap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a growing <w>chasm</w> between the rich and the poor in this country.",
                            "target_lang_translations": {
                                "zh": "这个国家的贫富之间存在着日益扩大的<w>鸿沟</w>。",
                                "ru": "В этой стране между богатыми и бедными растёт глубокая <w>пропасть</w>."
                            }
                        },
                        {
                            "text": "The political <w>chasm</w> between the two parties makes it difficult to pass new laws.",
                            "target_lang_translations": {
                                "zh": "两党之间的政治<w>分歧</w>使得通过新法律变得十分困难。",
                                "ru": "Политический <w>раскол</w> между двумя партиями затрудняет принятие новых законов."
                            }
                        }
                    ],
                    "synonyms": [
                        "divide",
                        "gulf"
                    ],
                    "antonyms": [
                        "unity"
                    ],
                    "common_phrases": [
                        "political chasm",
                        "growing chasm"
                    ],
                    "target_lang_definitions": {
                        "zh": "人、思想或群体之间巨大的差异或分歧。",
                        "ru": "Значительное различие, разделение или глубокий конфликт между людьми, идеями или группами."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "鸿沟",
                                "target_lang_sense_clarification": "比喻事物之间巨大的隔阂或分歧。"
                            },
                            {
                                "target_lang_word": "分歧",
                                "target_lang_sense_clarification": "指意见或立场上的不一致。"
                            },
                            {
                                "target_lang_word": "隔阂",
                                "target_lang_sense_clarification": "指人与人之间思想或感情上的距离。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "про́пасть",
                                "target_lang_sense_clarification": "переносное значение: коренное различие или непреодолимая дистанция."
                            },
                            {
                                "target_lang_word": "раско́л",
                                "target_lang_sense_clarification": "разделение внутри группы или общества из-за конфликта."
                            },
                            {
                                "target_lang_word": "разногла́сия",
                                "target_lang_sense_clarification": "отсутствие согласия, наличие противоречий в мнениях."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}