                "senses": [
                    {
                        "sense_id": "de25ac81-4cbd-3063-8a93-984d6765af02",
                        "entry_id": "054424a8-5d27-325a-adf5-e1381e314953",
                        "glosses": [
                            "Ne plus accélérer, ralentir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71a826a6-e1c4-4afb-8c08-9a85cd0ffb83",
                                "sense_id": "de25ac81-4cbd-3063-8a93-984d6765af02",
                                "text": "Le travail, qui consiste à transporter une masse d’un point A à un point B, coûte la quantité d’énergie nécessaire à accélérer cette masse puis à la désaccélérer pour l’arrêter au point B."
                            },
                            {
                                "example_id": "df5dec13-b748-4bb3-a84b-876b884bbfb8",
                                "sense_id": "de25ac81-4cbd-3063-8a93-984d6765af02",
                                "text": "Ralentie, oui. C’est le sentiment qu’elle lui communique. Et que ce temps déposé là, entre eux, se désaccélère."
                            }
                        ]
                    }
                ],
