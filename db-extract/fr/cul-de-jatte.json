            {
                "entry_id": "a4ff5a5e-32ee-3972-89e6-a4e78dbf0b47",
                "word": "cul-de-jatte",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "758b4177-5307-4d1d-86b5-1c5a78ead6d2",
                        "entry_id": "a4ff5a5e-32ee-3972-89e6-a4e78dbf0b47",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "culs-de-jatte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f7869bc7-62fc-3be6-a17c-77d7987bc943",
                        "entry_id": "a4ff5a5e-32ee-3972-89e6-a4e78dbf0b47",
                        "glosses": [
                            "Amputé, privé d'une partie de ses moyens."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b1a68c39-88ab-4fae-a9f6-0e202db7bac7",
                                "sense_id": "f7869bc7-62fc-3be6-a17c-77d7987bc943",
                                "text": "Cela fait des mois que la CAQ annonce sa nouvelle loi 101. Elle ne vient pas. Et il y a bien des chances qu’il s’agisse d’une loi cul-de-jatte, impuissante à renverser la dynamique d’anglicisation accélérée de Montréal et Laval."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ba44b11-c648-4c12-8165-96021d295edf",
                        "source_entry_id": "a4ff5a5e-32ee-3972-89e6-a4e78dbf0b47",
                        "source_sense_id": "f7869bc7-62fc-3be6-a17c-77d7987bc943",
                        "target_lang_word": "beinlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beinlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "49dda6ec-c8db-3e03-bd82-4f8ae53160e4",
                                        "entry_id": "b6d6fead-5708-3004-b365-1a4247c62a1d",
                                        "glosses": [
                                            "kein Bein habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2043f729-1b37-4686-8541-35a7e619a9af",
                                                "sense_id": "49dda6ec-c8db-3e03-bd82-4f8ae53160e4",
                                                "text": "Ganz klar: unsere Schlange ist beinlos, aber beim Schlangenembryo werden noch vier Beinknospen angelegt, die sich allerdings nicht zu Beinen entwickeln."
                                            },
                                            {
                                                "example_id": "0af38d47-724b-4712-a44c-5c852f30783b",
                                                "sense_id": "49dda6ec-c8db-3e03-bd82-4f8ae53160e4",
                                                "text": "Sie sind beinlos, uralt und etwas eklig: Erstmals seit Jahrzehnten haben Forscher eine neue Familie von Amphibien entdeckt."
                                            },
                                            {
                                                "example_id": "cb21d266-c0da-4198-96b3-1ece036c1afe",
                                                "sense_id": "49dda6ec-c8db-3e03-bd82-4f8ae53160e4",
                                                "text": "Frühere Angaben über Vorkommen in Nordwestafrika werden inzwischen angezweifelt und sollen auf Verwechslungen mit anderen beinlosen Echsenarten beruhen."
                                            },
                                            {
                                                "example_id": "ef76ed95-11e6-4e76-ac3f-fe6817631e20",
                                                "sense_id": "49dda6ec-c8db-3e03-bd82-4f8ae53160e4",
                                                "text": "Der beinlose Kriegsveteran bewegte dieses Vehikel mittels zweier Konstruktionen, die den Reibebrettern aus dem Baugewerbe sehr ähnlich waren."
                                            },
                                            {
                                                "example_id": "9b1d0fd7-fc96-40fe-ad43-9a3779c5d0e7",
                                                "sense_id": "49dda6ec-c8db-3e03-bd82-4f8ae53160e4",
                                                "text": "Außer Clov leben in dem Turm noch die Eltern Hamms, ein ebenfalls schwachsinniges Greisenpaar, das beinlos (sie haben ihre Beine bei einem Verkehrsunfall, verloren, als sie ihre Ferien auf einem Zweisitzerfahrrad in den Ardennen verbrachten) in zwei Mülleimern in einer Ecke des Turmgemachs haust."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "332deb76-d8ee-4dcf-a23a-d1d6325521cb",
                        "source_entry_id": "a4ff5a5e-32ee-3972-89e6-a4e78dbf0b47",
