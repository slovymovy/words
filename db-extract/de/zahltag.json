                "senses": [
                    {
                        "sense_id": "fddc9a9f-3f2e-3315-94a9-2bbf687783e7",
                        "entry_id": "7ddf8307-cf36-3562-bfba-a742d1d34800",
                        "glosses": [
                            "Tag, an dem der Lohn oder eine andere Zahlung ausgezahlt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3992f793-25fe-4c02-b503-49969c57913f",
                                "sense_id": "fddc9a9f-3f2e-3315-94a9-2bbf687783e7",
                                "text": "Am Zahltag kommt endlich wieder Geld in die Kasse."
                            },
                            {
                                "example_id": "aa1fcdc4-22b8-4e1c-8ee2-3bcf8baedd4f",
                                "sense_id": "fddc9a9f-3f2e-3315-94a9-2bbf687783e7",
                                "text": "„Jeden Freitag, am Zahltag, wartete seine Frau auf ihn und nahm ihm das Geld ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2c3f616f-a83e-3c39-b6ba-f92d1f9b441d",
                        "entry_id": "7ddf8307-cf36-3562-bfba-a742d1d34800",
                        "glosses": [
                            "Zeitpunkt des Ausgleichs für konträre Taten"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "1742f068-6d28-4cd5-ac73-c77192bf62d8",
                                "sense_id": "2c3f616f-a83e-3c39-b6ba-f92d1f9b441d",
                                "text": "Für Eure Gaunereien ist bald Zahltag."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "20719604-aea0-3bdf-802a-561b8a776812",
                        "entry_id": "7ddf8307-cf36-3562-bfba-a742d1d34800",
                        "glosses": [
                            "die Summe, die am Zahltag ^([1]) ausgezahlt wird"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "2c536309-bdd5-47c8-9856-f4312137a8c4",
                                "sense_id": "20719604-aea0-3bdf-802a-561b8a776812",
                                "text": "Für einen anständigen Zahltag arbeite ich auch gerne."
                            },
                            {
                                "example_id": "eb45fb0b-468a-4656-9e1b-dd371c2322d7",
                                "sense_id": "20719604-aea0-3bdf-802a-561b8a776812",
                                "text": "Hast du deinen Zahltag schon gekriegt?"
                            },
                            {
                                "example_id": "3eaa2642-3310-4eaa-aefe-9f2b763a9631",
                                "sense_id": "20719604-aea0-3bdf-802a-561b8a776812",
                                "text": "Er hat in einer Nacht seinen ganzen Zahltag versoffen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
