                ],
                "senses": [
                    {
                        "sense_id": "66578e7a-88ab-3381-a570-48b7233ccf0d",
                        "entry_id": "91d2548d-2f4e-3bb3-9ee7-14589ef169b7",
                        "glosses": [
                            "Strumpf aus Seide"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f09de75e-d574-41c9-a880-f15c3b3f3fdc",
                                "sense_id": "66578e7a-88ab-3381-a570-48b7233ccf0d",
                                "text": "„Zur Heerpauke wurden Strumpfhosen oder Seidenstrümpfe und eine üblicherweise gut ausgepolsterte Unterhose getragen.“"
                            },
                            {
                                "example_id": "e9ff9a9b-3780-4a8f-8360-d592c46bbac8",
                                "sense_id": "66578e7a-88ab-3381-a570-48b7233ccf0d",
                                "text": "„Sie hatte die zu weite Bluse eingenäht, den Wollrock gekürzt und sich in einem Anfall von Übermut Seidenstrümpfe gekauft.“"
                            },
                            {
                                "example_id": "1d6f597b-d350-48fc-946e-f81bfc92d811",
                                "sense_id": "66578e7a-88ab-3381-a570-48b7233ccf0d",
                                "text": "„Es regnete; ich war in Seidenstrümpfen und brauchte einen Wagen.“"
                            },
                            {
                                "example_id": "a1a91c5c-a34e-4f4f-98d3-380b0ca3c93e",
                                "sense_id": "66578e7a-88ab-3381-a570-48b7233ccf0d",
                                "text": "„Ihre ausgestreckten Beine in karamellfarbenen Seidenstrümpfen gehörten eher einem jungen Gott als einer jungen Göttin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
