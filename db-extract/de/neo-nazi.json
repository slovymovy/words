                        "examples": [
                            {
                                "example_id": "1d6f97db-ead5-4ee3-b3c5-7da01c7885df",
                                "sense_id": "8c45b49b-dcd8-3356-9caa-351b60e95c67",
                                "text": "Und der liberale »Expressen« in Stockholm fand, »daß Polizei, Richter und andere Behörden schlafen oder die Augen zudrücken, sobald sie Neo-Nazis oder andere Rechtsextremisten entdecken.«",
                                "translation": "And the liberal \"Expressen\" in Stockholm found \"that police, judges and other authorities sleep or close their eyes as soon as they uncover neo-Nazis or other right wing extremists.\"",
                                "english": "And the liberal \"Expressen\" in Stockholm found \"that police, judges and other authorities sleep or close their eyes as soon as they uncover neo-Nazis or other right wing extremists.\""
                            },
                            {
                                "example_id": "ebb968d3-a5af-4cd2-b42e-8e50bce84603",
                                "sense_id": "8c45b49b-dcd8-3356-9caa-351b60e95c67",
                                "text": "Der Ausstieg war hart. Dem Ex-Neo-Nazi ging es dabei wie vielen, die über Jahre nur in der Szene und für die Szene gelebt haben: Er musste seinen gesamten Freundeskreis aufgeben, wurde depressiv, dachte an Selbstmord.",
                                "translation": "Exiting was hard. The fomer neo-Nazi was like many who lived in the scene and for the scene for years: He had to give up his entire friend group, became depressed, thought about suicide.",
                                "english": "Exiting was hard. The fomer neo-Nazi was like many who lived in the scene and for the scene for years: He had to give up his entire friend group, became depressed, thought about suicide."
                            },
                            {
                                "example_id": "b93dc139-a8d7-4470-86bf-f99a2fb0d458",
                                "sense_id": "8c45b49b-dcd8-3356-9caa-351b60e95c67",
                                "text": "Das Web bietet Neo-Nazis eine moderne Plattform, um ihre ideologischen Inhalte zu verbreiten.",
                                "translation": "The web offers neo-Nazis a modern platform to spread their ideological content.",
                                "english": "The web offers neo-Nazis a modern platform to spread their ideological content."
                            }
                        ]
