                        "sense_id": "0394ce34-05b0-38da-8276-15715d137dea",
                        "entry_id": "3d32a941-ee3e-30ef-ad14-f6e5fe1861d4",
                        "glosses": [
                            "West Low Franconian"
                        ],
                        "tags": [
