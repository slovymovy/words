                        ]
                    },
                    {
                        "translation_id": "a7ed02f9-c71e-4a70-b58a-4e874d12216a",
                        "source_entry_id": "c9a7c3eb-a546-3e9d-bf2c-080bb982eec8",
                        "source_sense_id": "cf367b03-5a42-31dd-ace6-18f9fd9f3c54",
                        "source_sense_description": "group of ten",
                        "target_lang_word": "деся́тка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "деся́тка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "070d5f5e-5ec8-39ab-8a16-1e0ee4e58dbc",
                                        "entry_id": "7362b99f-209f-3122-b6a1-b2cc8f2ae494",
                                        "glosses": [
                                            "счётная единица, равная десяти; десять одинаковых или однородных предметов, объектов счёта"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0d05644-20a2-4d21-a2a9-39bfe15f56e8",
                                                "sense_id": "070d5f5e-5ec8-39ab-8a16-1e0ee4e58dbc",
                                                "text": "Питание не людям давали, а на десятку. Если кто из десятки умрёт — его сунут под нары и держат там, аж пока смердит. И на него получают норму."
                                            },
                                            {
                                                "example_id": "db5b8e07-dca2-458b-92bd-98901550ac21",
                                                "sense_id": "070d5f5e-5ec8-39ab-8a16-1e0ee4e58dbc",
                                                "text": "И какая-то марионетка Южная Корея… в первой десятке развитых стран мира… второе место по судостроению после Японии."
                                            },
                                            {
                                                "example_id": "820dc752-1e9d-4bf5-9361-5de251b27996",
                                                "sense_id": "070d5f5e-5ec8-39ab-8a16-1e0ee4e58dbc",
                                                "text": "Утром купался и бегал десятку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f1c2414-c337-35be-9352-320d76baf34a",
                                        "entry_id": "7362b99f-209f-3122-b6a1-b2cc8f2ae494",
                                        "glosses": [
                                            "разг. что-либо, имеющее номер десять (например, автобус на маршруте № 10)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b98d421a-d363-4b4a-96b3-b14a86aa9165",
                                                "sense_id": "0f1c2414-c337-35be-9352-320d76baf34a",
                                                "text": "В аппарате советников человек со знакомым лицом стал спрашивать, как мои дела с должностью. Я ответил, что хорошо, но только позже вспомнил, что это представитель из «десятки», из Москвы."
                                            },
                                            {
                                                "example_id": "78b23e24-1048-4836-a711-744cbab099b4",
                                                "sense_id": "0f1c2414-c337-35be-9352-320d76baf34a",
                                                "text": "Первым делом я сел на «десятку» и вернулся на Соборку, где обнаружил, что моя ночная подруга исчезла."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f381f1a1-e622-326b-86dd-3d490a661f19",
                                        "entry_id": "7362b99f-209f-3122-b6a1-b2cc8f2ae494",
                                        "glosses": [
                                            "карт. игральная карта с числом 10"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e04b843-724d-47c5-b136-d495289c075e",
                                                "sense_id": "f381f1a1-e622-326b-86dd-3d490a661f19",
                                                "text": "По второму абцугу он вскрыл одну карту, которая оказалась десяткою и уж выигравшею соника; он перегнул её и, сказав: «По прокидке», вскрыл между тем другую карту, которая тоже оказалась десяткою и, следовательно, также выигравшею, он перегнул её и положил на первую очень покойно, как будто дело шло о десятке рублей, а не о Деднове, с которым он, в случае дальнейшего проигрыша, решился расстаться."
                                            },
                                            {
                                                "example_id": "f4237b6c-a622-4846-b1dc-1a4dbc5c00aa",
                                                "sense_id": "f381f1a1-e622-326b-86dd-3d490a661f19",
                                                "text": "Мой ход; разумеется, я козыряю с маленькой, Туренин не даёт козырей, мой товарищ кладёт даму, Шахонской бьёт тузом и идёт в десятку бубён; я бью тузом и козыряю с короля."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4c80480-f7e1-3ea0-9741-60e2d8113d9e",
                                        "entry_id": "7362b99f-209f-3122-b6a1-b2cc8f2ae494",
                                        "glosses": [
                                            "разг. купюра достоинством десять денежных единиц"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb845bbf-fe90-4749-99ba-4c71c54a6ba3",
                                                "sense_id": "c4c80480-f7e1-3ea0-9741-60e2d8113d9e",
                                                "text": "Между мужиками слышится ропот на дороговизну харчей. — Ишь ведь, жид-то тя ешь, что ломит! а? за пирог десятку! Вот и кормись."
                                            },
                                            {
                                                "example_id": "d9460b86-2c13-48d9-b25f-d47d23ba7dfd",
                                                "sense_id": "c4c80480-f7e1-3ea0-9741-60e2d8113d9e",
                                                "text": "— Но мелочью у меня не наберется, — тихо сказал Романтовский. — Вот разве что разменяете десятку. Разменяли и, ухмыляясь, ушли."
                                            },
                                            {
                                                "example_id": "20f79fdf-99a9-46f9-a7f0-70e55d133b9c",
                                                "sense_id": "c4c80480-f7e1-3ea0-9741-60e2d8113d9e",
                                                "text": "За карасей Дёрганый ломит цену как в ресторане — по десятке за штуку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25031c8a-f854-3163-a4ed-00d9aa4c0f6e",
                                        "entry_id": "7362b99f-209f-3122-b6a1-b2cc8f2ae494",
                                        "glosses": [
                                            "перен., разг. центр мишени"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee4c42e2-3bdb-426d-aeec-6163cc6dfb29",
                                                "sense_id": "25031c8a-f854-3163-a4ed-00d9aa4c0f6e",
                                                "text": "Стрелять нас учили теоретически, затем выдали винтовку, один патрон и тут же повели сдавать экзамен — стрелять в мишень. Я прицелился, зажмурился, выстрелил, набил синяк на плече, оглох, закашлялся и почему-то попал в десятку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0743f118-c042-396d-b5e3-db3c10fceffd",
                                        "entry_id": "7362b99f-209f-3122-b6a1-b2cc8f2ae494",
                                        "glosses": [
                                            "юр., жарг. судебный приговор на 10 лет тюремного заключения или исправительно-трудовых лагерей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f2ff5b9-92f8-4be8-8758-a42bf5df0110",
                                                "sense_id": "0743f118-c042-396d-b5e3-db3c10fceffd",
                                                "text": "Всем религиозным давали десятку, высший тогда срок."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d644b3ff-8082-3ce2-9e46-d7dbc91524fa",
                                        "entry_id": "7362b99f-209f-3122-b6a1-b2cc8f2ae494",
                                        "glosses": [
                                            "автомоб., разг. автомобиль ВАЗ-2110 (Lada 110)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a524995a-ea87-44af-bd57-81965fecbd8f",
                                                "sense_id": "d644b3ff-8082-3ce2-9e46-d7dbc91524fa",
                                                "text": "Перед взрывом многие свидетели слышали выстрелы, а кое-кто даже видел, что возникла перестрелка между быками из «десятки» и из второй машины белого цвета, предположительно девятой модели «Жигулей»."
                                            },
                                            {
                                                "example_id": "b883da66-eacc-45f8-8114-f152bd99c428",
                                                "sense_id": "d644b3ff-8082-3ce2-9e46-d7dbc91524fa",
                                                "text": "Подождав минут десять, уехал на десятке с молодым парнем, водителем вологодской Скорой Помощи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ca4e4d0-2481-3ec9-a425-d2392274b464",
                                        "entry_id": "7362b99f-209f-3122-b6a1-b2cc8f2ae494",
                                        "glosses": [
                                            "морск., разг. десятивёсельная лодка, шлюпка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7303db5a-89e8-4ff4-b16f-87af7b15587a",
                                                "sense_id": "2ca4e4d0-2481-3ec9-a425-d2392274b464",
                                                "text": "Они привыкли каждое желание капитана считать святым, каждое слово правдивым и разом сдёрнули десятку на воду."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
