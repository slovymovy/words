                        "glosses": [
                            "Not garnered."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8dab3439-811f-479a-a4d1-67535d05d618",
                                "sense_id": "65593fef-6672-3dcd-a8a3-e402abcb3c1e",
                                "text": "It fortunately was not in the power of the Boer Government to carry off this as yet ungarnered treasure, or it would certainly have shared the fate of the cart-loads of gold in bar and coin with which President Kruger decamped from Pretoria; but it is beyond all controversy that many of that Government's officials favoured the proposal to wreck, as far as dynamite could, both the machinery and mines in mere wanton revenge on the hated Outlanders that mainly owned them."
                            },
                            {
                                "example_id": "347e56da-7e9c-4ee4-a673-5302a861c9ac",
                                "sense_id": "65593fef-6672-3dcd-a8a3-e402abcb3c1e",
                                "text": "As Symonds wrote, \"The romantic art of the modern world did not spring like that of Greece from an ungarnered field of flowers."
                            },
                            {
                                "example_id": "f526134d-c184-48fe-9b9f-f0cd1757bb52",
                                "sense_id": "65593fef-6672-3dcd-a8a3-e402abcb3c1e",
                                "text": "The lissom birch thrives ungarnered in the thicket, where grace and gentleness supply the whilom vigor of its sway."
                            }
                        ]
                    }
