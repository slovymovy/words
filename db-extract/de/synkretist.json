                                        "glosses": [
                                            "Relatif au syncrétisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f391d2d9-d0fe-4817-8088-c20f80deb2e4",
                                                "sense_id": "1695f4fc-03fe-3d70-b860-538cd1eb5234",
                                                "text": "Le relativisme syncrétiste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "syncrétiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "311fcc53-6def-3652-9958-21cb539056c6",
                                        "entry_id": "f9bbe274-97c9-35d8-a336-9456939e5f4a",
                                        "glosses": [
                                            "Partisan du syncrétisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f12f84e0-671f-4653-b6e7-07a1f45bc6b1",
                                                "sense_id": "311fcc53-6def-3652-9958-21cb539056c6",
                                                "text": "Le syncrétiste était entre les philosophes ce que serait entre les hommes qui disputent, un arbitre captieux qui les tromperait, et qui établirait entre eux une fausse paix."
                                            },
                                            {
                                                "example_id": "e4a323a8-6aaa-4f3f-b589-994b51251436",
                                                "sense_id": "311fcc53-6def-3652-9958-21cb539056c6",
                                                "text": "Les chrétiens ne reconnaissaient qu'un Dieu ; les syncrétistes, qui s'appelèrent alors éclectiques, n'admirent qu'un premier principe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
