                    "frequency": "Low",
                    "semantic_group_id": "boisson",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En hiver, elle boit souvent un <w>thym</w> bien chaud avec du miel pour apaiser sa toux."
                        },
                        {
