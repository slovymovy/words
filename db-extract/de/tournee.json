                "senses": [
                    {
                        "sense_id": "05af1cc4-2c71-32b8-bac5-963954911c89",
                        "entry_id": "c1bd0e15-4a7b-30f1-88ec-2d75c8b3eb23",
                        "glosses": [
                            "Rundreise von Künstlern oder Artisten zwecks Gastspielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c3e047e-6c8d-4012-a7d1-4d2c938617ae",
                                "sense_id": "05af1cc4-2c71-32b8-bac5-963954911c89",
                                "text": "Die Musiker starteten ihre erste US-Tournee mit ihrem neuen Dirigenten Sir Simon Rattle."
                            },
                            {
                                "example_id": "6cec2183-2804-4092-9c8d-bf968af08e53",
                                "sense_id": "05af1cc4-2c71-32b8-bac5-963954911c89",
                                "text": "Weitere Stationen der Tournee sind unter anderen Chicago, Los Angeles und San Francisco."
                            },
                            {
                                "example_id": "0a7593a6-61c8-49a8-9dc1-e282a6fbc9f2",
                                "sense_id": "05af1cc4-2c71-32b8-bac5-963954911c89",
                                "text": "„Bei der nächsten Tournee trat der Astrologe als Saxofonist in die Gruppe ein.“"
                            },
                            {
                                "example_id": "905bda1b-e1d4-4441-b561-d5925d902a35",
                                "sense_id": "05af1cc4-2c71-32b8-bac5-963954911c89",
                                "text": "„Bücher wurden im- und exportiert, Zeitungen druckten Fortsetzungsromane und Artikel von Schriftstellern ab, die in anderen Ländern lebten, beliebte Autoren gingen auf Lesereise, Schauspieler auf Tournee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
