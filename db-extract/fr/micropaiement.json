                "senses": [
                    {
                        "sense_id": "ba695a32-08b6-35bd-90ba-53d69201c1b2",
                        "entry_id": "91180c5b-157f-3297-a6ce-40bbc8af2ea7",
                        "glosses": [
                            "Paiement d’une très petite somme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a25829b5-05b2-4885-83b4-6f3536f506c5",
                                "sense_id": "ba695a32-08b6-35bd-90ba-53d69201c1b2",
                                "text": "Des discussions sont en cours avec la société de services informatiques Atos pour implémenter une solution de micropaiement permettant les achats à l’acte."
                            },
                            {
                                "example_id": "50eff23a-7b7f-41b6-8dbc-a762f76a5caf",
                                "sense_id": "ba695a32-08b6-35bd-90ba-53d69201c1b2",
                                "text": "Malgré des dénégations en demi-teinte du PDG, Eric Schmidt, Google poursuit ses investissements dans le secteur du jeu vidéo en ligne. Une orientation confirmée, d’après le site TechCrunch, par le rachat de Jambool, éditeur d’un outil de micropaiements et de monnaie virtuelle pour jeux vidéo, pour une somme estimée à 70 millions de dollars (53 millions d’euros)."
                            },
                            {
                                "example_id": "5e1af861-308c-4c2b-867c-8e26a7bca7a4",
                                "sense_id": "ba695a32-08b6-35bd-90ba-53d69201c1b2",
                                "text": "Ces deux parties s’affrontent aujourd’hui alors que Facebook cherche à imposer son service de micropaiement pour biens virtuels, les Facebook Credits."
                            }
                        ]
                    }
                ],
