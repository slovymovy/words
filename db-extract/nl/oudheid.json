                                    },
                                    {
                                        "sense_id": "f3896cd0-4d07-3e58-a204-8c25c5c06576",
                                        "entry_id": "b68bc13c-58ec-3820-a1e5-cb3c874c1915",
                                        "glosses": [
                                            "A relic or monument of ancient times, such as a coin, a statue, etc.; an ancient institution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04a2102b-de00-3096-9e30-839e652922bc",
                                        "entry_id": "b68bc13c-58ec-3820-a1e5-cb3c874c1915",
                                        "glosses": [
                                            "The state of being ancient or of ancient lineage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ed00668-8d7f-49e3-8167-91a23ae5cfec",
                                                "sense_id": "04a2102b-de00-3096-9e30-839e652922bc",
                                                "text": "He was thinking; but the glory of the song, the swell from the great organ, the clustered lights, […], the height and vastness of this noble fane, its antiquity and its strength—all these things seemed to have their part as causes of the thrilling emotion that accompanied his thoughts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44e2ce76-851e-48b3-b76c-b0000f7a8f7f",
                        "source_entry_id": "d09eb2ea-8cf4-364c-bfd1-48004bf376d8",
                        "source_sense_id": "1d43fdc8-227d-3d8a-85e7-a1b1bb09b74f",
                        "source_sense_description": "het tijdperk van de geschiedenis vóór de middeleeuwen",
                        "target_lang_word": "Antiquité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antiquité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfdef4d1-5739-37f1-8aeb-e726740e8d15",
                                        "entry_id": "1fd2c53b-5bc3-3f38-87ec-0445c1be0371",
                                        "glosses": [
                                            "Période très ancienne de l’Histoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71dc59dc-2d3a-44f4-9640-b58fe965a02f",
                                                "sense_id": "cfdef4d1-5739-37f1-8aeb-e726740e8d15",
                                                "text": "L'Antiquité est une époque où les connaissances se transmettaient oralement et étaient facilement mémorisées."
                                            },
                                            {
                                                "example_id": "3ba03429-d193-437d-bed9-d49a872e6cb5",
                                                "sense_id": "cfdef4d1-5739-37f1-8aeb-e726740e8d15",
                                                "text": "Même dans les âges d’ignorance, la lumière de l’Antiquité ne s’est jamais complètement éteinte au milieu de nous ; elle y brille parmi les ténèbres des temps les plus reculés."
                                            },
                                            {
                                                "example_id": "0d16eb75-8e95-49c0-b094-c1dd19f9d7eb",
                                                "sense_id": "cfdef4d1-5739-37f1-8aeb-e726740e8d15",
                                                "text": "C’est ainsi que, dans l’Antiquité, les riches vallées du Nil et de l’Euphrate (Mésopotamie) furent toujours convoitées par des hordes conquérantes."
                                            },
                                            {
                                                "example_id": "1c052214-ac0e-476d-a642-cfc2b9b910f4",
                                                "sense_id": "cfdef4d1-5739-37f1-8aeb-e726740e8d15",
                                                "text": "Ouvrage qui, en dévoilant le vrai que les Histoires fabuleuses ont travesti ou altéré, sert à éclaircir les Antiquités des peuples, et surtout à venger l'Histoire Sainte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97b7e18f-5dbd-3bb0-b13e-1f23b69290cd",
                                        "entry_id": "1fd2c53b-5bc3-3f38-87ec-0445c1be0371",
                                        "glosses": [
                                            "Collectif des hommes qui ont vécu à des époques anciennes."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf6e4ba3-8afa-4eae-a97f-527fe0c8d5b3",
                                                "sense_id": "97b7e18f-5dbd-3bb0-b13e-1f23b69290cd",
                                                "text": "L’Antiquité a cru que…"
                                            },
                                            {
                                                "example_id": "95077038-07d0-4025-8784-6a7de0f8ed05",
                                                "sense_id": "97b7e18f-5dbd-3bb0-b13e-1f23b69290cd",
                                                "text": "Vous ne verrez rien de pareil dans toute l’Antiquité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3bcef9f-6f96-38c1-9ca5-3d0162f906d6",
                                        "entry_id": "1fd2c53b-5bc3-3f38-87ec-0445c1be0371",
                                        "glosses": [
                                            "Ère de notre passé qui correspond à la période où les Grecs et les Romains avaient une civilisation considérée comme avancée par rapport aux nations voisines et les dominaient."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8aaff7c-05ef-4497-ac50-9ef191e5f180",
                                                "sense_id": "b3bcef9f-6f96-38c1-9ca5-3d0162f906d6",
                                                "text": "On trouve parmi les aliments les plus anciens, les fèves et toutes les légumineuses cultivées dans les champs depuis l’Antiquité en Europe : dolique, pois sec, lentille, pois chiche […]."
                                            },
                                            {
                                                "example_id": "12ab631f-188e-4095-a39d-1b23bdcb19b7",
                                                "sense_id": "b3bcef9f-6f96-38c1-9ca5-3d0162f906d6",
                                                "text": "S'il existe un groupement gallo-romain d'habitats à Montsort, à la fin de l’Antiquité, il est possible que Saint-Pierre soit un édifice christianisé, un fanum ou une autre construction de qualité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
