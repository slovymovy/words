                    {
                        "sense_id": "55f69854-d12d-3ea5-91d8-e2b1ee0cb1d6",
                        "entry_id": "f524fd3b-7add-33de-8281-a738a2684bd6",
                        "glosses": [
                            "Vacances passées à la maison."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "39a1c300-90b5-4dab-9dd6-5c610aad2cf0",
                                "sense_id": "55f69854-d12d-3ea5-91d8-e2b1ee0cb1d6",
                                "text": "Apparu dans le sillage de la crise de 2007, le globe-trotteur d’appartement s’inscrit dans le cadre d’une nouvelle pratique ­dénommée « staycation » – contraction de to stay (« rester ») et vacation (« vacances »)."
                            }
                        ]
                    }
