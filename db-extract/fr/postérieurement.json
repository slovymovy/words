            {
                "entry_id": "64df8a60-2345-3d39-9b12-7473e18db94b",
                "word": "postérieurement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "48e0039a-91a1-3914-a8d6-6be9c0b757eb",
                        "entry_id": "64df8a60-2345-3d39-9b12-7473e18db94b",
                        "glosses": [
                            "Après, plus tard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2748b65-a380-4ef9-805a-0fc495a3e8fc",
                                "sense_id": "48e0039a-91a1-3914-a8d6-6be9c0b757eb",
                                "text": "Cela s'est passé postérieurement. Cet acte a été fait postérieurement à celui dont vous parlez."
                            },
                            {
                                "example_id": "5ab31b46-4678-4505-95f0-2e3182b39aa7",
                                "sense_id": "48e0039a-91a1-3914-a8d6-6be9c0b757eb",
                                "text": "Le tribunal a établi que la présentation commerciale de l’option de sauvegarde d’OVHcloud ne correspondait pas à celle souscrite par Bati Courtage. Elle aurait été créée ou modifiée postérieurement à l’incendie et à la souscription de l’offre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ec31b62-aee5-4de1-93fa-bc9d1acb68ab",
                        "source_entry_id": "64df8a60-2345-3d39-9b12-7473e18db94b",
                        "source_sense_id": "48e0039a-91a1-3914-a8d6-6be9c0b757eb",
                        "target_lang_word": "later",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "later",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87d56250-1672-3ea1-8dc8-d546152457a6",
                                        "entry_id": "87d9e377-eebd-3233-8790-3d8fe83d33a1",
                                        "glosses": [
                                            "comparative form of late: more late"
                                        ],
                                        "tags": [
                                            "comparative",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b258d09-a7bd-4b89-b0aa-09603f776adf",
                                                "sense_id": "87d56250-1672-3ea1-8dc8-d546152457a6",
                                                "text": "You came in late yesterday and today you came in even later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2565b7b7-5b99-30a0-9c37-31878c53b671",
                                        "entry_id": "87d9e377-eebd-3233-8790-3d8fe83d33a1",
                                        "glosses": [
                                            "Afterward in time (used with than when comparing with another time)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dec679b2-6e22-4780-b009-8a8884087342",
                                                "sense_id": "2565b7b7-5b99-30a0-9c37-31878c53b671",
                                                "text": "My roommate arrived first. I arrived later."
                                            },
                                            {
                                                "example_id": "2e1942c6-e786-494f-b346-c2d275e38c82",
                                                "sense_id": "2565b7b7-5b99-30a0-9c37-31878c53b671",
                                                "text": "I arrived later than my roommate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71d057ca-a51b-3e18-9351-da624f6df269",
                                        "entry_id": "87d9e377-eebd-3233-8790-3d8fe83d33a1",
                                        "glosses": [
                                            "At some unspecified time in the future."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd576342-5c81-4ae7-91bf-d552217162e5",
                                                "sense_id": "71d057ca-a51b-3e18-9351-da624f6df269",
                                                "text": "I wanted to do it now, but I’ll have to do it later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82fa92d7-d54c-37fa-b1cc-1cf32bf83e96",
                                        "entry_id": "87d9e377-eebd-3233-8790-3d8fe83d33a1",
                                        "glosses": [
                                            "What if (something problematic or unanticipated happens); if not (something undesirable will happen)."
                                        ],
                                        "tags": [
                                            "Manglish",
                                            "Singlish"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01c17f87-4d2c-4684-a36c-fb40f1863d1f",
                                                "sense_id": "82fa92d7-d54c-37fa-b1cc-1cf32bf83e96",
                                                "text": "Compare Malay nanti (“later; if not”)"
                                            },
                                            {
                                                "example_id": "9c0c58fe-83aa-4efa-8c68-6d217c2750dd",
                                                "sense_id": "82fa92d7-d54c-37fa-b1cc-1cf32bf83e96",
                                                "text": "Later you fall asleep how?",
                                                "translation": "What if you fall asleep?",
                                                "english": "What if you fall asleep?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "later",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b60ca55b-e35a-3f43-8ac4-3e1712a5e963",
                                        "entry_id": "47214f23-1bc9-39f3-81b4-0143ee0134a4",
                                        "glosses": [
                                            "comparative form of late: more late"
                                        ],
                                        "tags": [
                                            "comparative",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e50377cd-a013-4bf6-8812-f0359a86346e",
                                                "sense_id": "b60ca55b-e35a-3f43-8ac4-3e1712a5e963",
                                                "text": "Jim was later than John."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "082d706d-6e64-383f-acb1-c1b06cff6ea1",
                                        "entry_id": "47214f23-1bc9-39f3-81b4-0143ee0134a4",
                                        "glosses": [
                                            "Coming afterward in time (used with than when comparing with another time)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7d1f7b6-3e41-445d-938f-830ff6a78bb3",
                                                "sense_id": "082d706d-6e64-383f-acb1-c1b06cff6ea1",
                                                "text": "The Victorian era is a later period of English history than the Elizabethan era."
                                            },
                                            {
                                                "example_id": "d64a2026-c8c0-420a-b1e7-3864fffd5627",
                                                "sense_id": "082d706d-6e64-383f-acb1-c1b06cff6ea1",
                                                "text": "The eldest son was usually given the name of his paternal grandfather, later children those of other relatives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11c41752-2af9-37a7-89d6-5e60fa6a12bd",
                                        "entry_id": "47214f23-1bc9-39f3-81b4-0143ee0134a4",
                                        "glosses": [
                                            "Coming afterward in distance (following an antecedent distance as embedded within an adverbial phrase)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb3ddc4d-3a3b-41f8-915e-5ec328ed8d12",
                                                "sense_id": "11c41752-2af9-37a7-89d6-5e60fa6a12bd",
                                                "text": "I felt some leg pain during the first mile of my run and I strained my calf two miles later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2d15131-4f60-3726-93de-416a1e096c14",
                                        "entry_id": "47214f23-1bc9-39f3-81b4-0143ee0134a4",
                                        "glosses": [
                                            "At some time in the future."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82931236-0961-4db0-b513-198d356296b6",
                                                "sense_id": "d2d15131-4f60-3726-93de-416a1e096c14",
                                                "text": "The meeting was adjourned to a later date."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "later",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3932ba3f-8f9f-3ee6-adcd-3a05b5d507ce",
                                        "entry_id": "ca39834d-1eca-35bd-b946-35ba65b97304",
                                        "glosses": [
                                            "See you later; goodbye."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78155214-210c-48e3-af98-19c0929612b1",
