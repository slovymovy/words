                "senses": [
                    {
                        "sense_id": "9ad1c273-69c8-33b3-ab6b-f131d8833130",
                        "entry_id": "e94a0672-9778-3580-a9e1-2f8a92c65de6",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89b8af01-c2e4-4635-b723-04e97bb18b44",
                                "sense_id": "9ad1c273-69c8-33b3-ab6b-f131d8833130",
                                "text": "Frau Vogelsgesang ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c4967f9d-a0b9-43fc-bc30-55e88f6dde76",
                                "sense_id": "9ad1c273-69c8-33b3-ab6b-f131d8833130",
                                "text": "Herr Vogelsgesang wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e383be5e-463f-41f7-988f-c181b7a7b030",
                                "sense_id": "9ad1c273-69c8-33b3-ab6b-f131d8833130",
                                "text": "Die Vogelsgesangs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "17e171d8-1b08-40dd-90ba-726a0af10c6e",
                                "sense_id": "9ad1c273-69c8-33b3-ab6b-f131d8833130",
                                "text": "Der Vogelsgesang trägt nie die Schals, die die Vogelsgesang ihm strickt."
                            },
                            {
                                "example_id": "7f30f590-9404-406a-ba3b-185e335c84f5",
                                "sense_id": "9ad1c273-69c8-33b3-ab6b-f131d8833130",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Vogelsgesang kommt, geht der Herr Voglgsangs.“"
                            },
                            {
                                "example_id": "0882a41d-35a4-49d3-9c25-803c065ba804",
                                "sense_id": "9ad1c273-69c8-33b3-ab6b-f131d8833130",
                                "text": "Vogelsgesang kommt und geht."
                            },
                            {
                                "example_id": "10b13c6c-0f55-4aec-8c4e-e83cead88daf",
                                "sense_id": "9ad1c273-69c8-33b3-ab6b-f131d8833130",
                                "text": "Vogelsgesangs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
