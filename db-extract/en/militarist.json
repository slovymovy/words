                    {
                        "translation_id": "9332c0ce-1317-43e4-bad2-b92831da10ac",
                        "source_entry_id": "76200ded-5521-36c7-9b3b-5969fa7bad0e",
                        "source_sense_id": "e16a1f84-cca5-3e67-95d9-3b9d7269e67c",
                        "source_sense_description": "one who believes in military force",
                        "target_lang_word": "militariste",
