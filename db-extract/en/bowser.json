                                                "sense_id": "c1aeb669-9fc8-3d9e-a0ca-655e0f1bafd9",
                                                "text": "An einer Tanksäule tankte er den Wagen."
                                            },
                                            {
                                                "example_id": "db2a92e2-9281-465c-9f13-18a73aabf7c4",
                                                "sense_id": "c1aeb669-9fc8-3d9e-a0ca-655e0f1bafd9",
                                                "text": "Er war geschockt vom Preis an der Tanksäule."
                                            },
                                            {
                                                "example_id": "4a81edde-7a3e-4bc9-becb-60cfe46338c1",
                                                "sense_id": "c1aeb669-9fc8-3d9e-a0ca-655e0f1bafd9",
                                                "text": "„Anse hörte die Moskitotür klappen, und Shotford trat unter dem Vordach hervor, stützte sich mit verschränkten Armen auf die Tanksäule und blickte quer über die Straße zu Anse hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
