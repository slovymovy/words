                                                "sense_id": "27c67e87-e037-3f5a-b5c6-d86d9ea867de",
                                                "text": "Imatrikulace je na letadlech viditelně vyznačena podle mezinárodních předpisů."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db8cc9b2-ae54-4565-bfce-221cd2045b61",
                        "source_entry_id": "3bbdef5f-accd-3941-b787-17eae52482ff",
                        "source_sense_description": "enrollment in a college or university",
                        "target_lang_word": "inschrijving",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inschrijving",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f7ecbce2-fcf7-316b-b6c5-3012187c1cd9",
                                        "entry_id": "440cc64f-92bd-387f-88fd-54f8c0843c2a",
                                        "glosses": [
                                            "de daad van het inschrijven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1824f73-4837-4db5-b320-ed326ed106f0",
                                                "sense_id": "f7ecbce2-fcf7-316b-b6c5-3012187c1cd9",
                                                "text": "De inschrijving van de nieuwe studenten kostte aardig wat tijd."
                                            },
                                            {
                                                "example_id": "06e7e8fc-b43f-4301-a751-f3ba1285388f",
                                                "sense_id": "f7ecbce2-fcf7-316b-b6c5-3012187c1cd9",
                                                "text": "De belangstelling voor bloemen en planten die overblijven als de Floriade in Almere binnenkort sluit, is zo groot dat de inschrijving daarvoor per direct is gesloten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0653accd-a5d2-3512-898b-f217b51b4031",
                                        "entry_id": "440cc64f-92bd-387f-88fd-54f8c0843c2a",
                                        "glosses": [
                                            "een document waarmee men zich opgeeft of inschrijft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bed151cc-f4b4-40c1-9e9d-0a2af307a555",
                                                "sense_id": "0653accd-a5d2-3512-898b-f217b51b4031",
                                                "text": "We hebben al heel veel inschrijvingen ontvangen."
                                            },
                                            {
                                                "example_id": "defccd1a-5221-4950-b060-485b0fc53140",
                                                "sense_id": "0653accd-a5d2-3512-898b-f217b51b4031",
                                                "text": "De inschrijving sloot afgelopen weekend. Het merendeel van de inzendingen is Engelstalig. Ongeveer honderd liedjes zijn in het Nederlands. Ook zijn er nummers ingestuurd met Franse, Arabische, Turkse, Spaanse en Italiaanse teksten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "352ec97d-dce5-44d4-a4a9-9b1ad6bca49b",
                        "source_entry_id": "3bbdef5f-accd-3941-b787-17eae52482ff",
                        "source_sense_description": "enrollment in a college or university",
                        "target_lang_word": "inscription",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inscription",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7008bb5a-60c6-32ab-924d-d202f247e26e",
                                        "entry_id": "accdadc3-d920-3007-824c-a0b0483048c6",
                                        "glosses": [
                                            "Action d’inscrire, résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cd5dcb7-1f2a-41f2-9cc0-a26c65e5e872",
                                                "sense_id": "7008bb5a-60c6-32ab-924d-d202f247e26e",
                                                "text": "Inscription de faux ou en faux, en termes de procédure, acte par lequel on soutient en justice qu’un pièce de la partie adverse est fausse ou falsifiée."
                                            },
                                            {
                                                "example_id": "7fcb5dad-a740-4573-ac10-84de611a6b4d",
                                                "sense_id": "7008bb5a-60c6-32ab-924d-d202f247e26e",
                                                "text": "Si vous allez tous les ans me donner du travail comme ça et des inscriptions à faire au registre des naissances, je serai obligé de demander à la commune une augmentation."
                                            },
                                            {
                                                "example_id": "400fb3fd-5a84-4afb-9d99-86f520fd8d9b",
                                                "sense_id": "7008bb5a-60c6-32ab-924d-d202f247e26e",
                                                "text": "Il a requis son inscription sur la liste des jurés, sur la liste électorale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1952248c-1474-37dd-b88d-3aea1527ef58",
                                        "entry_id": "accdadc3-d920-3007-824c-a0b0483048c6",
                                        "glosses": [
                                            "Action d’inscrire, résultat de cette action.",
                                            "Suite de caractères gravés ou fixés sur la pierre, le bois, le marbre, le cuivre, soit pour conserver la mémoire d’une personne ou d’un événement, soit pour indiquer la destination d’un édifice."
                                        ],
                                        "tags": [
                                            "Épigraphie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33a2ae96-6de9-4865-922b-338e2cc441f8",
                                                "sense_id": "1952248c-1474-37dd-b88d-3aea1527ef58",
                                                "text": "Cette chapelle renferme le tombeau de l’évêque Radulphe, dont l’inscription donne la date de 1266, comme étant celle de la mort du prélat."
                                            },
                                            {
                                                "example_id": "22a1923a-53da-40c9-9f78-6003d16cd4ea",
                                                "sense_id": "1952248c-1474-37dd-b88d-3aea1527ef58",
                                                "text": "Un jour, montant l’escalier de l’Institut, en compagnie de Renan et d’Oppert, il rencontra Marmet et lui tendit la main. Marmet refusa de la prendre et dit : « Je ne vous connais pas. — Me prenez-vous pour une inscription latine ? » répliqua Schmoll. C’est un peu de ce mot-là que le pauvre Marmet est mort et enterré."
                                            },
                                            {
                                                "example_id": "19e761b5-5a36-4bc8-aa80-7ec080c388d6",
                                                "sense_id": "1952248c-1474-37dd-b88d-3aea1527ef58",
                                                "text": "La salle de réunion du conseil municipal avait autrefois servi de salle de classe pour les enfants du village. Le frontispice de l’édifice public comportait d'ailleurs toujours l’inscription « École-Mairie »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d5ea7f2-bc55-3870-aed2-6d1406797911",
                                        "entry_id": "accdadc3-d920-3007-824c-a0b0483048c6",
                                        "glosses": [
                                            "Fait d’être inscrit sur les registres d’une faculté en vue de passer tel ou tel examen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6a629a2-19ae-4882-9fa2-71765b29e236",
                                                "sense_id": "6d5ea7f2-bc55-3870-aed2-6d1406797911",
                                                "text": "Prendre des inscriptions à la Faculté de Médecine, à la Faculté de Droit."
                                            },
                                            {
                                                "example_id": "a42f9860-452e-4774-a146-eee123a1e7db",
                                                "sense_id": "6d5ea7f2-bc55-3870-aed2-6d1406797911",
                                                "text": "Prendre une ou deux inscriptions pour la licence."
                                            },
                                            {
                                                "example_id": "25cb14de-f89f-4024-8946-8b46a1b473b9",
                                                "sense_id": "6d5ea7f2-bc55-3870-aed2-6d1406797911",
                                                "text": "Première, seconde, troisième inscription."
                                            },
                                            {
                                                "example_id": "1ca1b671-d5ef-4d8e-9d2e-5b9a028641cb",
                                                "sense_id": "6d5ea7f2-bc55-3870-aed2-6d1406797911",
                                                "text": "Après le petit déjeuner, je mis mon costume le plus propre pour me rendre au bureau du secrétaire où je devais prendre mes inscriptions."
                                            },
                                            {
                                                "example_id": "c5af2918-267e-45ff-bd20-cfbd1bb50957",
                                                "sense_id": "6d5ea7f2-bc55-3870-aed2-6d1406797911",
                                                "text": "Donc rien à faire d’autre pour l’instant que de hanter les bibliothèques et que de prendre des inscriptions, de suivre des cours, étudiant parmi les étudiants, sans que rien ne se manifeste au-dehors de ce que je porte en moi et qui ne pèse pas plus lourd sans doute que ce qui charge beaucoup d’entre eux […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38ff48e7-d954-4b28-9b11-3b1d430030a6",
                        "source_entry_id": "3bbdef5f-accd-3941-b787-17eae52482ff",
                        "source_sense_description": "enrollment in a college or university",
                        "target_lang_word": "Immatrikulation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Immatrikulation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "977d3394-4edb-34b4-aa19-24e0b2356b42",
                                        "entry_id": "daf1150f-45c0-37b3-bf15-222974e4685f",
                                        "glosses": [
                                            "die Einschreibung / Registration an einer Hochschule"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae5e60c6-4d22-4910-931c-8261938500e9",
                                                "sense_id": "977d3394-4edb-34b4-aa19-24e0b2356b42",
                                                "text": "Ich studiere ab Oktober Medizin, die Immatrikulation ist aber Mitte September."
                                            },
                                            {
                                                "example_id": "df1fcf34-9a3a-4ee1-9a56-a0842d4a4f68",
                                                "sense_id": "977d3394-4edb-34b4-aa19-24e0b2356b42",
                                                "text": "„Die Entscheidung des Rektors hat so zu erfolgen, daß dem Bewerber ausreichend Möglichkeit für die Durchführung der Immatrikulation innerhalb der hiefür vorgesehenen Fristen bleibt.“"
                                            },
                                            {
                                                "example_id": "75b3dc35-72a3-46c1-91fc-694e47f6c80e",
                                                "sense_id": "977d3394-4edb-34b4-aa19-24e0b2356b42",
                                                "text": "„Nach seiner Meldung als Freiwilliger, der vorgezogenen Abiturprüfung und der Immatrikulation an der Heidelberger Universität im Fach Zoologie beginnt Anfang Oktober die kurze Grundausbildung in Hannover.“"
                                            },
                                            {
                                                "example_id": "a4204fa2-5477-4d3f-8735-2bbab238103c",
                                                "sense_id": "977d3394-4edb-34b4-aa19-24e0b2356b42",
                                                "text": "„Die gleichzeitig mit dem Schulbeginn erfolgte Immatrikulation an der Leipziger Universität war ein Privileg, das ihm als Professorensohn zustand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c7ee1eaa-80e4-3781-82c5-0af2c81a294a",
                                        "entry_id": "daf1150f-45c0-37b3-bf15-222974e4685f",
                                        "glosses": [
                                            "amtliche Zulassung eines motorbetriebenen Fahrzeugs"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83c19902-9574-4eb7-9c0f-a4e334f0c5e0",
                                                "sense_id": "c7ee1eaa-80e4-3781-82c5-0af2c81a294a",
                                                "text": "„Nachdem im März eine starke Zunahme der Immatrikulation von Neuwagen den Konsumindikator nach oben getrieben hatte, sei der Anstieg vom April vor allem auf die deutliche Verbesserung des Geschäftsgangs im Detailhandel zurückzuführen, teilte die UBS mit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abf56683-c540-4e16-a543-50c77f1e0d9b",
                        "source_entry_id": "3bbdef5f-accd-3941-b787-17eae52482ff",
                        "source_sense_description": "enrollment in a college or university",
                        "target_lang_word": "Einschreibung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einschreibung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7056f1fd-ee1c-39a7-aa18-c86fcd098e26",
                                        "entry_id": "ae872f02-ef69-36e7-96c7-350183271a3b",
                                        "glosses": [
                                            "Aufnahme/Eintrag in eine Liste/in ein Verzeichnis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a0c61ef-527a-44be-bb16-656ef58c454d",
                                                "sense_id": "7056f1fd-ee1c-39a7-aa18-c86fcd098e26",
                                                "text": "„Er sei Mitglied der deutschen Feuerwehr und werde für die nächsten Wahlen seine Einschreibung in den deutschen Wahlkataster veranlassen.“"
                                            },
                                            {
                                                "example_id": "8eb4b60b-d5dc-4e4e-8cc7-5f8eb23eef8f",
                                                "sense_id": "7056f1fd-ee1c-39a7-aa18-c86fcd098e26",
                                                "text": "„Der Sohn meines Fahrers hatte eine zusätzliche Bitte: ob ich ihm bei der Einschreibung für Abendkurse in Biologie und Naturgeschichte behilflich sein könne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a5455f3a-1bc2-33cf-b842-ed94c5659422",
                                        "entry_id": "ae872f02-ef69-36e7-96c7-350183271a3b",
                                        "glosses": [
                                            "Eintrag in das Verzeichnis der Student(inn)en"
                                        ],
                                        "tags": [
                                            "Hochschule"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87c50860-059a-440e-9788-a216a91e5e8d",
                        "source_entry_id": "3bbdef5f-accd-3941-b787-17eae52482ff",
