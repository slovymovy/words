                "senses": [
                    {
                        "sense_id": "46c1ec34-fb26-3b95-a4ad-42343a78220b",
                        "entry_id": "cc0e44b5-afc4-3d58-bdf7-62cec2895547",
                        "glosses": [
                            "портативное беспроводное устройство для приёма и записи информации; приёмник персонального вызова"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6abed22c-c885-470b-822d-23385db3aada",
                                "sense_id": "46c1ec34-fb26-3b95-a4ad-42343a78220b",
                                "text": "Лизавета показала на пристёгнутый к ремню пейджер: — Была бы нужна, они меня мёртвой из-под земли достали бы. Запустили бы на пейджер пять-шесть сообщений с тройным повтором, и все дела."
                            }
                        ]
                    },
                    {
                        "sense_id": "808ffd06-f7b8-3040-b37f-bce41043720a",
                        "entry_id": "cc0e44b5-afc4-3d58-bdf7-62cec2895547",
                        "glosses": [
                            "комп. менеджер мгновенных сообщений"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c0b367f-4cfa-4264-b6b1-82ebf6351ff7",
                                "sense_id": "808ffd06-f7b8-3040-b37f-bce41043720a",
                                "text": "ICQ — это программа-пейджер, для обмена мгновенными сообщениями через интернет."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3456fdc2-2937-4322-9118-bfeb2c9833db",
                        "source_entry_id": "cc0e44b5-afc4-3d58-bdf7-62cec2895547",
                        "source_sense_description": "портативное беспроводное устройство для приёма и записи информации; приёмник персонального вызова",
                        "target_lang_word": "pager",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pager",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95187c5f-a807-3df5-a437-86bea9368b17",
                                        "entry_id": "1f0f98b3-073c-30e6-891d-8a419b49497b",
                                        "glosses": [
                                            "A wireless telecommunications device that receives text or voice messages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2292441-a7e1-43d7-ab3e-1cc191c838df",
                                                "sense_id": "95187c5f-a807-3df5-a437-86bea9368b17",
                                                "text": "Before he could bring it down, the pager clipped to his belt went off. Alan pushed the button that turned the hateful gadget off and stood indecisively in front of the shop door a moment longer […]"
                                            },
                                            {
                                                "example_id": "e54b6104-de94-4de9-a0ea-eb7b28aacc91",
                                                "sense_id": "95187c5f-a807-3df5-a437-86bea9368b17",
                                                "text": "I left my cell, my pager, and my home phone at the bottom / I sent two letters back in autumn, you must not've got 'em"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac8a362c-e662-3487-8ea0-fee2b04af4af",
                                        "entry_id": "1f0f98b3-073c-30e6-891d-8a419b49497b",
                                        "glosses": [
                                            "A computer program running in a text terminal, used to view (but not modify) the contents of a text file moving down the file one line or one screen at a time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "839ea39a-3950-4c87-b306-09e513942026",
                                                "sense_id": "ac8a362c-e662-3487-8ea0-fee2b04af4af",
                                                "text": "more is a pager. The basic purpose of a pager is that it lets you view the contents of a file without actually having to open the file."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6000a06-f64f-375a-bbd8-e58d9b2c7bff",
                                        "entry_id": "1f0f98b3-073c-30e6-891d-8a419b49497b",
                                        "glosses": [
                                            "Something (a document, book etc.) that has a specified number of pages."
                                        ],
                                        "tags": [
                                            "in-compounds"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60a0414b-ae3f-4004-a5f8-9bcda970b697",
                                                "sense_id": "b6000a06-f64f-375a-bbd8-e58d9b2c7bff",
                                                "text": "Sunday papers kept growing in bulk, however. The Boston Globes standard eight-page Sunday offering swelled to forty pages in 1895, and sixty pages soon after. The New York World issued a record-breaking hundred-pager' in 1893 to celebrate its tenth anniversary under Pulitzer's ownership."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75f44859-c3e9-344b-afd0-328c13eedf4c",
                                        "entry_id": "1f0f98b3-073c-30e6-891d-8a419b49497b",
                                        "glosses": [
                                            "One who makes up type into pages of a book; one who binds or sorts pages into a book."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
