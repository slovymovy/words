                "senses": [
                    {
                        "sense_id": "b427698f-d1fa-30a3-949f-fbd18d1846f5",
                        "entry_id": "86967b08-1a35-307e-908c-719a529dabcf",
                        "glosses": [
                            "große Pore mit einem Durchmesser von mehr als 50 Nanometern"
                        ],
                        "tags": [
                            "von Materialien"
                        ],
                        "examples": [
                            {
                                "example_id": "599e3171-71c8-46c1-9fc5-77e3aee27139",
                                "sense_id": "b427698f-d1fa-30a3-949f-fbd18d1846f5",
                                "text": "„In einer Bodensäule mit quadratischem Grundriß sei etwa in vertikaler Richtung eine Makropore von kreisförmigem Querschnitt (z. B. Regenwurmgang) angeordnet.“"
                            },
                            {
                                "example_id": "99c500cd-dfa2-4035-bffb-36acc19b4bba",
                                "sense_id": "b427698f-d1fa-30a3-949f-fbd18d1846f5",
                                "text": "„In der rechten oberen Ecke der Abbildung ist eine Makropore. Das Eisenoxyd am Rande der Makropore ist zum Teil zu Hämatit aufoxydiert worden.“"
                            },
                            {
                                "example_id": "02277811-201e-4ead-b4f6-4f5f27051c01",
                                "sense_id": "b427698f-d1fa-30a3-949f-fbd18d1846f5",
                                "text": "„In den knochennahen Abschnitten ist in den Makroporen auf der Keramikoberfläche Osteoid oder auch Knochen mit Osteozyten ausgebildet. Beim Osprovit sind neben bindegewebig gefüllten auch leere Makroporen vorhanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
