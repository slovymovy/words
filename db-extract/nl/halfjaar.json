                                "example_id": "5807b50f-77c9-4f06-824d-e4d68578af2c",
                                "sense_id": "ee61eca2-72be-3e5a-8bdb-bad243ddec21",
                                "text": "Eerder liep hij een halfjaar stage bij Team RadioShack."
                            },
                            {
                                "example_id": "a44732a1-46a3-4e64-8807-c531fab909d2",
                                "sense_id": "ee61eca2-72be-3e5a-8bdb-bad243ddec21",
                                "text": "Voor vertrek kreeg ik naast enthousiaste reacties ook veel aanmerkingen. Een halfjaar weg van mijn gezin vond men wel erg lang."
                            },
                            {
                                "example_id": "5ec6abaa-068e-4704-9e4e-8d14a3a7b176",
                                "sense_id": "ee61eca2-72be-3e5a-8bdb-bad243ddec21",
                                "text": "Bolin, de hofiuwelier in Stockholm, is een halfjaar bezig geweest om de stenen opnieuw te slijpen, het slot te vervangen, de zettingen te verbeteren en nog wat dingen."
                            }
                        ]
                    }
