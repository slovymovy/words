                        "glosses": [
                            "Relatif à la cité grecque antique de Crotone, et particulièrement à Milon de Crotone, athlète originaire de cette cité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9b39d00-515b-47c3-b344-c751d11018f3",
                                "sense_id": "b7de6832-f7d0-3958-bff8-73e73a7af71a",
                                "text": "« Je songe, répondit le Tyran, à Milo Crotoniate qui tua un bœuf d’un coup de poing et le mangea dans une seule journée. »"
                            },
                            {
                                "example_id": "4d4b7061-5160-49f0-9f4d-3a53b2ad7fc7",
                                "sense_id": "b7de6832-f7d0-3958-bff8-73e73a7af71a",
                                "text": "Léonard Tocheport, dit Fleur-d’Épine, avait environ trente ans, un mufle de terrier sur un torse de Crotoniate et le « mépris absolu des lois », dirait Richepin."
                            }
                        ]
                    }
