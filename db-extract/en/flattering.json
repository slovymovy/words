                                                "example_id": "3ed1c059-ddac-4f8f-9049-a649754bf2b9",
                                                "sense_id": "566648a2-9f29-3717-825c-b2902d91000d",
                                                "text": "Diese Worte sind für mich um so schmeichelhafter, als sie von einer Kennerin der Materie stammen. Danke Madam!"
                                            },
                                            {
                                                "example_id": "c8c48c92-3da9-4f57-a8ac-4108fc18dcf5",
                                                "sense_id": "566648a2-9f29-3717-825c-b2902d91000d",
                                                "text": "Der Kommentar ihres Schwiegervaters war wenig schmeichelhaft. Die verstehen sich wohl wirklich nicht so gut."
                                            }
