                                            {
                                                "example_id": "0b3f6c56-ae2c-4065-8837-934bf6659f57",
                                                "sense_id": "d1639118-2a0a-3b42-8091-bb0476df8769",
                                                "text": "In Amsterdam en Antwerpen zijn veel diamanthandelaren gevestigd"
                                            }
