                        ],
                        "examples": [
                            {
                                "example_id": "ea6bad85-43a5-4812-900d-70086d31b33b",
                                "sense_id": "057997be-8a44-3e75-b6d9-64ffd7945e17",
                                "text": "Karen a la bizarre impression d'avoir enfilé la version halloweenesque d'elle-même lorsqu'elle s'est habillée en prévision de sa rencontre avec Warren."
                            },
                            {
                                "example_id": "1e7bc512-4cbd-4765-b6cc-3b17955be0dd",
                                "sense_id": "057997be-8a44-3e75-b6d9-64ffd7945e17",
                                "text": "Nez déformé, rétréci. Oreille raccourcie, les lobes collés, les pavillons abîmés. La honte de traîner ce fardeau halloweenesque la fit se remettre au lit et Ève pleura."
                            },
                            {
                                "example_id": "a81ce087-64c7-4297-aa3d-8eab270bc819",
                                "sense_id": "057997be-8a44-3e75-b6d9-64ffd7945e17",
                                "text": "Deuxième corollaire : la quakerisation des mœurs en progression géométrique accentue une propension halloweenesque à détecter le monstre parmi nous."
                            }
                        ]
                    }
