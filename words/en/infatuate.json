                },
                {
                    "sense_id": "5d323484-f611-3e72-8452-db18a78f25f3",
                    "sense_definition": "Lacking good judgment; foolish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "foolishness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>infatuate</w> decision to invest all his savings in a failing company ruined him."
                        },
                        {
                            "text": "The king made an <w>infatuate</w> choice that led his country into a long war."
                        }
                    ],
                    "synonyms": [
                        "foolish",
                        "irrational"
                    ],
                    "antonyms": [
