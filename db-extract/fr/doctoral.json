                    {
                        "sense_id": "91e88302-235a-3e45-b538-29cf796a6498",
                        "entry_id": "2f61e368-19ad-3f07-9e07-80be1cdf0b3a",
                        "glosses": [
                            "Relatif au doctorat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44af5a21-228c-4ad6-8941-b2e4d8b5914e",
                                "sense_id": "91e88302-235a-3e45-b538-29cf796a6498",
                                "text": "École doctorale des sciences juridiques, politiques et de gestion."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b26ff60-0d0a-36da-b5ce-5477861eaca3",
                        "entry_id": "2f61e368-19ad-3f07-9e07-80be1cdf0b3a",
                        "glosses": [
                            "Qui appartient à un docteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9226f7ff-e21b-41d4-a4fb-9161dc3250f3",
                                "sense_id": "7b26ff60-0d0a-36da-b5ce-5477861eaca3",
                                "text": "Robe doctorale. - Bonnet doctoral."
                            }
                        ]
                    },
                    {
                        "sense_id": "5467b0dc-a980-335f-83ff-16043b7c9f3b",
                        "entry_id": "2f61e368-19ad-3f07-9e07-80be1cdf0b3a",
                        "glosses": [
                            "Qualifie le ton tranchant, la suffisance de certains savants."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0e6c85d0-f5a4-4b54-b86c-359cbdf37b57",
                                "sense_id": "5467b0dc-a980-335f-83ff-16043b7c9f3b",
                                "text": "Oh ! l’ignorance ! murmura le savant, et il ajouta tout haut avec ce ton de condescendance doctorale particulier aux disciples d’Esculape : mon ami, je cueille des simples que je collectionne, afin de les classer dans mon herbier ; …."
                            },
                            {
                                "example_id": "3356b8a7-d8d0-4360-b53e-ef02044c5184",
                                "sense_id": "5467b0dc-a980-335f-83ff-16043b7c9f3b",
                                "text": "La femme observa encore un silence et reprit d’une voix différente, une voix d’homme assez doctorale."
                            }
                        ]
                    }
                ],
