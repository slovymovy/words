                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachspeise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9318c24-0967-35d1-9acf-2cc76c4a0469",
                                        "entry_id": "ef029e1c-273f-3882-87ad-73ce9bbe6a27",
                                        "glosses": [
                                            "abschließender Gang eines mehrgängigen Essens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4766ce17-edb4-4db7-aeef-01135ac10fc4",
                                                "sense_id": "c9318c24-0967-35d1-9acf-2cc76c4a0469",
                                                "text": "Was nimmst du als Nachspeise?"
                                            },
                                            {
                                                "example_id": "285a6f99-8737-4c92-8efe-d86389988cb2",
                                                "sense_id": "c9318c24-0967-35d1-9acf-2cc76c4a0469",
                                                "text": "„Das würden sie so leicht nicht vergessen, doch als endlich die Nachspeise aufgetischt wurde, sahen sie schon nicht mehr ganz so geknickt aus.“"
                                            },
                                            {
                                                "example_id": "07bbaa24-9b1b-4314-9ed5-76fb11c4a662",
                                                "sense_id": "c9318c24-0967-35d1-9acf-2cc76c4a0469",
                                                "text": "„Hier aß man Fleisch, feine Suppen und Nachspeisen.“"
                                            },
                                            {
                                                "example_id": "01e7557c-9f06-4006-9475-b2f402034e23",
                                                "sense_id": "c9318c24-0967-35d1-9acf-2cc76c4a0469",
                                                "text": "„Während ich auf dem Riesenball hüpfte und mal wieder meine Nasenspitze antippen durfte, erzählte sie mir von einer Fehlgeburt, einem Computerbrand und davon, wie sehr sie die Wiener Nachspeisen liebte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
