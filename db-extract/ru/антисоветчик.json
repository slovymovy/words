                    {
                        "translation_id": "194dc1a7-ab0c-4485-bca7-591fbf3dab64",
                        "source_entry_id": "ef0d3187-b25d-3079-8446-2bc15aaa9309",
                        "source_sense_id": "944cb66b-974b-3d0e-9071-cd9c64c358f2",
                        "target_lang_word": "antisoviétique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antisoviétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc785e84-e390-3bf1-bbd4-2fee5d44080c",
                                        "entry_id": "65fd64c1-c6f1-3af7-b44f-3cf2b2322f39",
                                        "glosses": [
                                            "Opposé à l'Union des républiques socialistes soviétiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2c8bb2a-9df2-4ebf-9361-098717564210",
                                                "sense_id": "dc785e84-e390-3bf1-bbd4-2fee5d44080c",
                                                "text": "Je me rappelle maintenant qu’il n’était pas antisoviétique, non, d’ailleurs en général, ce n’est pas possible que ce couple soit collaborateur ; s’il l’était, il ne serait pas ici, mais à Paris, ou à Vichy."
                                            },
                                            {
                                                "example_id": "bb75a9df-cf62-48cc-8c42-c74a76bf6f84",
                                                "sense_id": "dc785e84-e390-3bf1-bbd4-2fee5d44080c",
                                                "text": "La « drôle de guerre » menée par la bourgeoisie française plus soucieuse de répression anticommuniste et de menées antisoviétiques que de lutte antihitlérienne oblitère pour le plus grand nombre le sens de la guerre."
                                            },
                                            {
                                                "example_id": "7aa1fb28-f2c9-4a14-ad1e-c433bc135ecd",
                                                "sense_id": "dc785e84-e390-3bf1-bbd4-2fee5d44080c",
                                                "text": "Dès sa libération, il quitte définitivement son pays pour se rendre au Pakistan, où il rejoint un jeune et riche Saoudien, Oussama Ben Laden, qui a fondé un « bureau » d'aide aux combattants afghans antisoviétiques, précurseur d'al-Qaida."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
