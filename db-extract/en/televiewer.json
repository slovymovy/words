                                "sense_id": "0ba7758c-5ddd-33e7-9638-5e32b0a9b436",
                                "text": "This article deals with the comparative psychology of the cinegoer and the televiewer."
                            },
                            {
                                "example_id": "4f1b0d3d-758a-48bf-a179-5b6764036767",
                                "sense_id": "0ba7758c-5ddd-33e7-9638-5e32b0a9b436",
                                "text": "Consequently, the televiewer sees with her own eyes what is seen by another eye."
                            }
