        "fr-extract.jsonl": [
            {
                "entry_id": "72e2c737-1b95-3ed6-8cff-cf3d27fcdecf",
                "word": "vulgairement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bf0afca6-fc0a-37df-b2a0-2f3040022011",
                        "entry_id": "72e2c737-1b95-3ed6-8cff-cf3d27fcdecf",
                        "glosses": [
                            "Communément ; dans le langage populaire ou familier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b19456aa-db0f-4822-aab7-d4165ce3763f",
                                "sense_id": "bf0afca6-fc0a-37df-b2a0-2f3040022011",
                                "text": "En 1213, le roi Jean, vulgairement nommé Jean sans Terre, et plus justement sans vertu,"
                            },
                            {
                                "example_id": "425c8a8f-74f2-4257-b17e-af92857e40ec",
                                "sense_id": "bf0afca6-fc0a-37df-b2a0-2f3040022011",
                                "text": "Le chénopode, appelé vulgairement patte d'oie ou ansérine, doit ce nom à la disposition de ses feuilles ; l’ambrosie en est une espèce."
                            },
                            {
                                "example_id": "52d2eaf7-1f00-4ff9-a8f6-014da60dbe4d",
                                "sense_id": "bf0afca6-fc0a-37df-b2a0-2f3040022011",
                                "text": "L'oxalide petite oseille, oxalis acetosella, Lin., porte vulgairement les noms de surette, alléluia, etc. Elle croit assez communément dans les bois et les lieux couverts de presque toute la France."
                            }
                        ]
                    },
                    {
                        "sense_id": "2503f383-2fc5-367b-9b31-662afaaa19c8",
                        "entry_id": "72e2c737-1b95-3ed6-8cff-cf3d27fcdecf",
                        "glosses": [
                            "D’une manière vulgaire ou triviale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1641458-75a4-44e4-bb5e-1f4eb92e4dea",
                                "sense_id": "2503f383-2fc5-367b-9b31-662afaaa19c8",
                                "text": "Apprenez, sotte, à vous énoncer moins vulgairement,"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1951b107-d7e3-4c2e-ba2b-22a0d0272345",
                        "source_entry_id": "72e2c737-1b95-3ed6-8cff-cf3d27fcdecf",
                        "source_sense_description": "dans le langage courant",
                        "target_lang_word": "commonly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commonly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12fdaeec-8c15-3724-bbff-91fb356be5da",
                                        "entry_id": "ec30230c-7d56-331a-ac5c-56cfb0dd20b9",
                                        "glosses": [
                                            "As a rule; frequently; usually."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6c41fdf-8ecc-4573-a9a8-a56295eefb80",
                                                "sense_id": "12fdaeec-8c15-3724-bbff-91fb356be5da",
                                                "text": "The class of antidepressants most commonly associated with sexual dysfunction is selective serotonin reuptake inhibitors, or SSRIs, which treat depression by ultimately increasing levels of the neurotransmitter serotonin in the brain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f9d6d52-0811-3b03-8ab4-f2ad18278546",
                                        "entry_id": "ec30230c-7d56-331a-ac5c-56cfb0dd20b9",
                                        "glosses": [
                                            "In common; familiarly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d212467b-6861-4652-9b67-f99989fe7946",
                                                "sense_id": "9f9d6d52-0811-3b03-8ab4-f2ad18278546",
                                                "text": "As he thereon stood gazing, he might see / The blessed Angels to and fro descend / From highest heaven in gladsome companee, / And with great joy into that Citie wend, / As commonly as friend does with his frend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "573a17c8-1aa1-4951-b624-762c56677369",
                        "source_entry_id": "72e2c737-1b95-3ed6-8cff-cf3d27fcdecf",
                        "source_sense_description": "dans le langage courant",
                        "target_lang_word": "popularly",
