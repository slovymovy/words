                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai un <w>rdv</w> chez le médecin demain matin à dix heures.",
                            "target_lang_translations": {
                                "en": "I have an <w>appointment</w> with the doctor tomorrow morning at ten.",
                                "ru": "У меня завтра утром в десять часов <w>приём</w> у врача.",
                                "de": "Ich habe morgen früh um zehn Uhr einen <w>Termin</w> beim Arzt.",
