                        "examples": [
                            {
                                "example_id": "aac1af54-49fd-44cc-ae6a-3bcb44eed844",
                                "sense_id": "bd225814-8a37-3ad6-8199-cd63ad8905a6",
                                "text": "Het was een waar genoegen deze oude vrienden weer eens te ontmoeten."
                            },
                            {
                                "example_id": "998daa37-120e-470c-981a-70e92767093e",
                                "sense_id": "bd225814-8a37-3ad6-8199-cd63ad8905a6",
                                "text": "Derhalve nodig ik u met veel genoegen uit om voor een proefperiode van een week de rol van typiste op u te nemen."
                            },
                            {
                                "example_id": "0b93d87e-70d5-427a-b639-c4fc6251a79a",
                                "sense_id": "bd225814-8a37-3ad6-8199-cd63ad8905a6",
                                "text": "De Brandts hebben de familie Van Loos uitgenodigd om na de ceremonie naar de Herengracht te komen, en volgens Jacob heeft de familie die uitnodiging met genoegen aangenomen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e41e5754-527e-419d-b243-e72c494fe8a2",
                        "source_entry_id": "a02a0694-8cd7-34d7-aafc-df4462b00086",
                        "source_sense_id": "bd225814-8a37-3ad6-8199-cd63ad8905a6",
