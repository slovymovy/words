        "fr-extract.jsonl": [
            {
                "entry_id": "9baa7f43-7108-3b7f-aa96-d51618f07900",
                "word": "racket",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8978fe3f-b3ef-4e3d-86f1-60a046d4f986",
                        "entry_id": "9baa7f43-7108-3b7f-aa96-d51618f07900",
                        "tags": [
                            "plural"
                        ],
                        "form": "rackets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf2f2e0e-cb96-3eeb-8b05-fdca70743331",
                        "entry_id": "9baa7f43-7108-3b7f-aa96-d51618f07900",
                        "glosses": [
                            "Forme de chantage de proximité, avec menaces de violence dans le but d’extorquer de l’argent, des objets ou des renseignements."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "957b5870-10bd-4c14-b872-8ae40296502d",
                                "sense_id": "bf2f2e0e-cb96-3eeb-8b05-fdca70743331",
                                "text": "Le racket est un délit d’extorsion puni par la loi."
                            },
                            {
                                "example_id": "67ca10fa-df7d-428d-99e5-4c8a1f07e10e",
                                "sense_id": "bf2f2e0e-cb96-3eeb-8b05-fdca70743331",
                                "text": "À Locri et à Reggio, les interrogatoires ont commencé et les 78 prévenus ont fait affluer aux alentours des palais de justice une bonne centaine d'avocats dont les honoraires se régleront, comme à l’habitude, par une recrudescence des rackets."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc77bd18-c564-4085-a0a6-eb0009102b8c",
                        "source_entry_id": "9baa7f43-7108-3b7f-aa96-d51618f07900",
                        "source_sense_id": "bf2f2e0e-cb96-3eeb-8b05-fdca70743331",
                        "target_lang_word": "Erpressung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erpressung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7930475c-2d5f-3949-aa61-93b3fec8ea15",
                                        "entry_id": "f1067bb8-0067-3af1-bf8d-9ceebfcfecef",
                                        "glosses": [
                                            "kriminelles, illegales Erzwingen eines Verhaltens oder einer Leistung durch Androhung negativer Konsequenzen bei Nichterfüllung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58e4d06b-32aa-4961-96f5-fdbfb8626b4f",
                                                "sense_id": "7930475c-2d5f-3949-aa61-93b3fec8ea15",
                                                "text": "Jeder Erpressung hat ihren Keim in krimineller Energie und persönlicher Vorteilnahme, und liegt im Glaube des Erpressten, diese anzunehmen oder gleichsam mit Nachdruck zu erwidern und gnadenlos zu ahnden."
                                            },
                                            {
                                                "example_id": "93fa96b9-4bb1-41cf-8c92-349d1f2cf532",
                                                "sense_id": "7930475c-2d5f-3949-aa61-93b3fec8ea15",
                                                "text": "Es gibt viele Formen der Erpressung, jedoch haben alle einen gemeinsamen Charakter: „Tu dieses nicht, dann tue ich jenes nicht … also gehorche mir und es wird Dir nichts geschehen!“"
                                            },
                                            {
                                                "example_id": "5bd4ebd9-1512-49d4-9973-75c070dfb201",
                                                "sense_id": "7930475c-2d5f-3949-aa61-93b3fec8ea15",
                                                "text": "Auch in einer freien Gesellschaft, ist die Erpressung ein probates Mittel, also die Fortführung einer Politik oder einer berechtigten/unberechtigten Forderung … nur mit anderen Mittel .. bis hin zum Totalverlust."
                                            },
                                            {
                                                "example_id": "20ba2dba-34e6-4446-82ac-92a74bbfff0f",
                                                "sense_id": "7930475c-2d5f-3949-aa61-93b3fec8ea15",
                                                "text": "„Ich helfe also dem indischen Staat, indem ich einen Akt von Erpressung und Korruption unterlaufe.“"
                                            },
                                            {
                                                "example_id": "48662c86-3342-42a0-b076-a81d24ad2371",
                                                "sense_id": "7930475c-2d5f-3949-aa61-93b3fec8ea15",
                                                "text": "„Er hatte sich schon an die Erpressungen gewöhnt, die alle halbe Stunde auf ihn niederprasselten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fdbad00-e900-4c95-9b0e-6a2ddcd74cb6",
                        "source_entry_id": "9baa7f43-7108-3b7f-aa96-d51618f07900",
                        "source_sense_id": "bf2f2e0e-cb96-3eeb-8b05-fdca70743331",
                        "target_lang_word": "Betrug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betrug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81352d38-0e1c-3a4c-bc2d-d40b5bd0864d",
                                        "entry_id": "3dbab1d0-60d8-3bce-99e1-326d4cff70d9",
                                        "glosses": [
                                            "vorsätzliche Täuschung und Irreführung einer anderen Person; Täuschungshandlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c11ac65-be42-4be5-860e-57eb6b9a4a31",
                                                "sense_id": "81352d38-0e1c-3a4c-bc2d-d40b5bd0864d",
                                                "text": "Der Betrug ist offensichtlich."
                                            },
                                            {
                                                "example_id": "81236fd4-11b1-43f7-8748-0cf90be81984",
                                                "sense_id": "81352d38-0e1c-3a4c-bc2d-d40b5bd0864d",
                                                "text": "Er ist nur auf Betrug aus."
                                            },
                                            {
                                                "example_id": "3ad38858-2716-46d7-8b33-cfef316e651c",
                                                "sense_id": "81352d38-0e1c-3a4c-bc2d-d40b5bd0864d",
                                                "text": "„Mary würde einen anderen Weg finden müssen, um den von ihm begangenen Betrug zu verbergen.“"
                                            },
                                            {
                                                "example_id": "665cdf9c-be3b-40d0-a836-cb4cc79c5806",
                                                "sense_id": "81352d38-0e1c-3a4c-bc2d-d40b5bd0864d",
                                                "text": "„Trotz allem Esprit der Franzosen ist und bleibt Paris immer die Stadt, wo sich Betrug lohnt.“"
                                            },
                                            {
                                                "example_id": "a869aef2-0f65-490c-b174-1a3ad7e9ca27",
                                                "sense_id": "81352d38-0e1c-3a4c-bc2d-d40b5bd0864d",
                                                "text": "„Zur Verhandlung kommt der zweite Betrug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7a07d63-0962-4ed3-871e-f5382ff7f9e0",
                        "source_entry_id": "9baa7f43-7108-3b7f-aa96-d51618f07900",
                        "source_sense_id": "bf2f2e0e-cb96-3eeb-8b05-fdca70743331",
                        "target_lang_word": "Betrügerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betrügerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "98f04729-5f61-3633-93e7-c94cd859ba5e",
                                        "entry_id": "cf583084-32b3-3b26-83ce-42213afde889",
                                        "glosses": [
                                            "mehrere/viele Handlungen, bei denen jemand/andere hinters Licht geführt und um rechtmäßigen Besitz gebracht wird/werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da65e6a9-252d-4c33-9502-008cb3ddca8a",
                                                "sense_id": "98f04729-5f61-3633-93e7-c94cd859ba5e",
                                                "text": "„Er hatte viel mehr Glück als sein Bruder Ludwig, der wegen Betrügereien im Bergwerk ins Gefängnis kam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "39fb3aae-7649-3eb4-aa1c-57a29328b486",
                                        "entry_id": "cf583084-32b3-3b26-83ce-42213afde889",
                                        "glosses": [
                                            "Handlung, die Bedeutung [1] erfüllt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16f04659-66d3-4866-9aaa-e3a61e9430a7",
                                                "sense_id": "39fb3aae-7649-3eb4-aa1c-57a29328b486",
                                                "text": "„Ich hatte ein kleines Haus gemietet, wo ich eine Pharaobank unter Halbpart-Beteiligung eines Berufsspielers auflegte, der mich vor den Betrügereien gewisser überheblicher Aristokraten schützte, denen gegenüber ein einfacher Privatmann in meinem lieben Vaterland immer unrecht hat.“"
                                            },
                                            {
                                                "example_id": "9edff040-cd4a-41c6-b912-2ab1ffac4f22",
                                                "sense_id": "39fb3aae-7649-3eb4-aa1c-57a29328b486",
                                                "text": "„Er wurde fälschlich aller möglichen Betrügereien angeklagt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f520058b-871d-4b0e-b501-27ef2413d1ed",
                        "source_entry_id": "9baa7f43-7108-3b7f-aa96-d51618f07900",
                        "source_sense_id": "bf2f2e0e-cb96-3eeb-8b05-fdca70743331",
                        "target_lang_word": "Schwindel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwindel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a7c9552-e81f-36aa-ae38-013fb64ed8a3",
                                        "entry_id": "865ef420-4556-3cb0-b619-24d71527cd05",
                                        "glosses": [
                                            "Beeinträchtigung des Gleichgewichtssinns; Gefühl zu taumeln, wanken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "767a31c5-b4e3-43ff-95ee-4ec80fc965ee",
                                                "sense_id": "3a7c9552-e81f-36aa-ae38-013fb64ed8a3",
                                                "text": "Mich überkam plötzlich ein heftiger Schwindel."
                                            },
                                            {
                                                "example_id": "8da3155c-8469-4ae8-a932-00afce640590",
                                                "sense_id": "3a7c9552-e81f-36aa-ae38-013fb64ed8a3",
                                                "text": "„Er versuchte aufzustehen, aber Schwindel und Schüttelfrost vereitelten seinen Plan.“"
                                            },
                                            {
                                                "example_id": "0d6b2d02-17ba-4402-aae1-4057126befe7",
                                                "sense_id": "3a7c9552-e81f-36aa-ae38-013fb64ed8a3",
                                                "text": "Der 65-jährige Finanzminister Rapanos klagte über Schwindel und Schweißausbrüche und wurde wegen eines Ohnmachtsanfalls zur Beobachtung in eine Privatklinik eingewiesen."
                                            },
                                            {
                                                "example_id": "d7034c1b-0dfc-49fe-8db5-f5ddeadad0aa",
                                                "sense_id": "3a7c9552-e81f-36aa-ae38-013fb64ed8a3",
                                                "text": "Anna S. ist niedergeschlagen, antriebslos. Sie hat Schlafstörungen, leidet unter Schwindel und Kopfschmerzen."
                                            },
                                            {
                                                "example_id": "e1924b17-6b01-4809-8a62-64ceadb409b0",
                                                "sense_id": "3a7c9552-e81f-36aa-ae38-013fb64ed8a3",
                                                "text": "Alles dreht sich, der Boden schwankt: Schwindel! Jeder kennt es vom Karussellfahren. Doch da geht das Gefühl zum Glück schnell vorüber. Aber was tun, wenn der Schwindel zur Qual wird?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e122b47a-b88b-324c-a5dd-bf65bdeb7794",
                                        "entry_id": "865ef420-4556-3cb0-b619-24d71527cd05",
                                        "glosses": [
                                            "(nicht sehr schwerwiegende) unwahre Aussage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f0ba11d-82d1-4a93-a0d6-006644b030fd",
                                                "sense_id": "e122b47a-b88b-324c-a5dd-bf65bdeb7794",
                                                "text": "Alles, was die machen, ist ein einziger Schwindel."
                                            },
                                            {
                                                "example_id": "4a17aa7f-f143-400c-b9b9-6b15d2d1347f",
                                                "sense_id": "e122b47a-b88b-324c-a5dd-bf65bdeb7794",
                                                "text": "Da er [Professor Harald Lesch] auch Schwindel und Irrtümer in den Naturwissenschaften aufklärt, hat er sich nicht nur Freunde gemacht."
                                            },
                                            {
                                                "example_id": "04247d3a-c785-45ca-8bbd-f964542f9b8e",
                                                "sense_id": "e122b47a-b88b-324c-a5dd-bf65bdeb7794",
                                                "text": "„Wenn entwickelte Länder sich darauf zurückziehen, dass Klimawandel ein Schwindel sei und sie keine Pflicht hätten, die Klimaziele zu erfüllen, dann ist das eine sehr ignorante Position.“"
                                            },
                                            {
                                                "example_id": "769d1b22-3c90-4f79-bb19-788cd03a311c",
                                                "sense_id": "e122b47a-b88b-324c-a5dd-bf65bdeb7794",
                                                "text": "Zu Fake News sagte man früher Schwindel"
                                            },
                                            {
                                                "example_id": "d1307c6d-0cd7-4957-9c13-7d8dbfe756c7",
                                                "sense_id": "e122b47a-b88b-324c-a5dd-bf65bdeb7794",
                                                "text": "„Es gibt kein Verbrechen, keinen Kniff, keinen Trick, keinen Schwindel, kein Laster, das nicht von Geheimhaltung lebt. Bringt diese Heimlichkeiten ans Tageslicht, beschreibt sie, macht sie vor aller Augen lächerlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9bebd7f6-29b8-464a-9692-f6448d21ffc9",
                        "source_entry_id": "9baa7f43-7108-3b7f-aa96-d51618f07900",
                        "source_sense_id": "bf2f2e0e-cb96-3eeb-8b05-fdca70743331",
                        "target_lang_word": "racket",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "racket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "913b61b9-f596-390b-bdcf-002b09df57d1",
                                        "entry_id": "8976b0e9-0360-3ca6-8869-773778cbe9bb",
                                        "glosses": [
                                            "An implement with a handle connected to a round frame strung with wire, sinew, or plastic cords, and used to hit a ball, such as in tennis or a shuttlecock in badminton."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a39edc3a-7c85-41b4-bbe0-7ee4c39306d5",
                                                "sense_id": "913b61b9-f596-390b-bdcf-002b09df57d1",
                                                "text": "He bought a new tennis racket two days ago."
                                            },
                                            {
                                                "example_id": "46ea360f-9033-453f-8905-bee3f1f2fbc5",
                                                "sense_id": "913b61b9-f596-390b-bdcf-002b09df57d1",
                                                "text": "Ivor had acquired more than a mile of fishing rights with the house ; he was not at all a good fisherman, but one must do something ; one generally, however, banged a ball with a squash-racket against a wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "318eeaa0-7dcf-375d-85cb-0a3fea0c8daf",
                                        "entry_id": "8976b0e9-0360-3ca6-8869-773778cbe9bb",
                                        "glosses": [
                                            "A snowshoe formed of cords stretched across a long and narrow frame of light wood."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d06f7de5-f648-3775-bd6d-34590b735607",
                                        "entry_id": "8976b0e9-0360-3ca6-8869-773778cbe9bb",
                                        "glosses": [
                                            "A broad wooden shoe or patten for a man or horse, to allow walking on marshy or soft ground."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "racket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5f74fbe-8842-3105-b5d5-d84e48d3d97a",
                                        "entry_id": "4fd7a80a-c0e3-3b55-83b8-d0b570fdf552",
                                        "glosses": [
                                            "To strike with, or as if with, a racket."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6db71988-e910-43b1-82b1-8d78359f3919",
                                                "sense_id": "b5f74fbe-8842-3105-b5d5-d84e48d3d97a",
                                                "text": "Poor man [is] racketed from one temptation to another."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "racket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2703304d-818a-3705-842e-c1f5313389c4",
                                        "entry_id": "d88ba854-1b98-385f-b7b0-75120f52f04a",
                                        "glosses": [
                                            "A loud noise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ea12e36-09f2-48bb-a5ee-5bbbca429e1c",
                                                "sense_id": "2703304d-818a-3705-842e-c1f5313389c4",
                                                "text": "Power tools work quickly, but they sure make a racket."
                                            },
                                            {
                                                "example_id": "6959f175-183a-4f39-a6ef-4b95fe7f7536",
                                                "sense_id": "2703304d-818a-3705-842e-c1f5313389c4",
                                                "text": "With all the racket they're making, I can't hear myself think!"
                                            },
                                            {
                                                "example_id": "27ffcdda-eca4-407a-83c2-ce13157e1f36",
                                                "sense_id": "2703304d-818a-3705-842e-c1f5313389c4",
                                                "text": "What's all this racket?"
                                            },
                                            {
                                                "example_id": "1dcd0124-4bec-4d64-85d7-d3dd23b8bcd7",
                                                "sense_id": "2703304d-818a-3705-842e-c1f5313389c4",
                                                "text": "Vast flights of starlings, fleeing the racket, beat across the sky at high speed, like Squall-clouds,— Evening at Noon-tide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50243297-5910-3a92-a909-fdb9b573ce38",
                                        "entry_id": "d88ba854-1b98-385f-b7b0-75120f52f04a",
                                        "glosses": [
                                            "An illegal scheme for profit; a fraud or swindle; or both coinstantiated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e8e5ca-de83-4728-88ff-ad59a3ce6dcd",
                                                "sense_id": "50243297-5910-3a92-a909-fdb9b573ce38",
                                                "text": "prostitution and gambling controlled by rackets"
                                            },
                                            {
                                                "example_id": "4660456e-d8b4-457b-ae8e-b13201649b12",
                                                "sense_id": "50243297-5910-3a92-a909-fdb9b573ce38",
                                                "text": "They had quite a racket devised to relieve customers of their money."
                                            },
                                            {
                                                "example_id": "efdefdc9-4636-4dfc-be7c-b821d5e58fea",
                                                "sense_id": "50243297-5910-3a92-a909-fdb9b573ce38",
                                                "text": "The following letter by William E. Lewis, Utica, published in both the Observer-Dispatch and the Daily Press, is reproduced here because of its bearing on the milk situation locally and elsewhere. Mr. Lewis' letter: […] Finally, in addition to ruinous price control, the farmer in the Mohawk Valley is up against a \"milk racket\" in Utica, a \"racket\" as heinous and disreputable as any milk racket in New York City or Chicago. There is no free market in Utica. The owner of a herd of 40 cows can't sell his milk in Utica, no matter how rich, pure and wholesome his milk may be, unless he signs a contract with the Dairymen's League (which never has distributed milk in Utica) through the farmers' contract to the dealers (who is in the milk racket) and who sells the poor pinched farmers' milk for 17¢ a quart which has cost him 3½¢ to 4½¢ per quart. It is a \"racket\" pure and simple. The Dairymen's League rakeoff is 5¢ per 100 pounds of milk and 15¢ for financing the \"business.\" How can that be, inquires the farmer with 40 cows and 500 quarts of milk daily to sell. The answer is, that about 30 months ago the largest retail dealers of Utica experienced a shortage of milk, and applied to the Dairymen's League for a relief supply of milk, which was furnished, but on condition, however, that the dealers force their producing farmers to sign contracts with the Dairymen's League or be turned out of the market. With no market to go to, the farmers stood for the \"racket,\" all except a few, who have given their choice cows to the butcher rather than submit. Among the victims of this \"turn off\" was the writer, owner of 40 cows and a farm in the Mohawk Valley. A \"racket\" is a detestable thing, if it results in 17¢ a quart to the consumer and 4½¢ price to the farmer."
                                            },
                                            {
                                                "example_id": "d3e89c37-a473-474b-bac2-d829e5e73497",
                                                "sense_id": "50243297-5910-3a92-a909-fdb9b573ce38",
                                                "text": "War is a racket. It always has been. It is possibly the oldest, easily the most profitable, surely the most vicious. It is the only one international in scope. It is the only one in which the profits are reckoned in dollars and the losses in lives... Of course, it isn't put that crudely in war time. It is dressed into speeches about patriotism, love of country, and \"we must all put our shoulders to the wheel,\" but the profits... skyrocket—and are safely pocketed."
                                            },
                                            {
                                                "example_id": "8e7eb4a9-d60d-4e84-931b-255223ae2ece",
                                                "sense_id": "50243297-5910-3a92-a909-fdb9b573ce38",
                                                "text": "In six decades he had spotted all the rackets, smelled all the rats, and he was tired of being the absolute and sick master and boss of the inner self."
                                            },
                                            {
                                                "example_id": "051fa026-317c-4ff0-a739-894c4c6f41cd",
                                                "sense_id": "50243297-5910-3a92-a909-fdb9b573ce38",
                                                "text": "Island girl,\nBlack boy want you in his island world.\nHe want to take you from the racket boss.\n He want to save you, but the cause is lost."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02287511-bf7a-327a-8747-2379654ae295",
                                        "entry_id": "d88ba854-1b98-385f-b7b0-75120f52f04a",
                                        "glosses": [
                                            "Any industry or enterprise."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc5f993d-ae9e-4890-849a-4a4081eaad3b",
                                                "sense_id": "02287511-bf7a-327a-8747-2379654ae295",
                                                "text": "They dropped out of the acting racket in 1953 and soon took up writing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cae7b8ec-90d6-345a-b309-1a771cf224a8",
