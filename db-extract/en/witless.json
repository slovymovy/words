                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c72cc2b4-40b1-4023-93b8-621a2bfbb40d",
                                                "sense_id": "304dd99e-72a9-3a1b-be8f-9a588c34b906",
                                                "text": "Für mich ist ein mit Solarzellen ausgerüsteter Regenschirm sinnfrei."
