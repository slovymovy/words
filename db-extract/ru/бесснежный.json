                        "cross_references": [
                            {
                                "target_word": "snowless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef964651-028b-319f-9a6e-70e63130e2ec",
                                        "entry_id": "eb44525d-a7e4-3f31-8699-ac5efdfff1c6",
                                        "glosses": [
                                            "Without snow, not having any snow."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2d6a1d0-c154-448f-903c-97dcfc887d3c",
                                                "sense_id": "ef964651-028b-319f-9a6e-70e63130e2ec",
                                                "text": "As the dogs were hooked up to the gangline linking them to the A.T.V. on a snowless day, the cacophony of barking built as the animals pulled at the harness to get going."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cac70495-2694-4825-80e5-a0c2a0c61c51",
                        "source_entry_id": "d3574222-af9d-34c9-86b0-98f88436f105",
                        "source_sense_id": "dea884a4-dadc-39cb-a988-f3e2134f7363",
                        "target_lang_word": "sin nieve",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d9329d6b-157f-45b1-898a-12f97f989e9f",
                        "source_entry_id": "d3574222-af9d-34c9-86b0-98f88436f105",
                        "source_sense_id": "dea884a4-dadc-39cb-a988-f3e2134f7363",
                        "target_lang_word": "schneelos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schneelos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e747871-496e-3cd8-8908-c0eeb798a31e",
                                        "entry_id": "1f182c29-2795-377b-9dd9-a0d521896b2f",
                                        "glosses": [
                                            "ohne Schnee"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0989acf2-60a3-4b88-941c-f7fd299e8701",
                                                "sense_id": "3e747871-496e-3cd8-8908-c0eeb798a31e",
                                                "text": "„Helles Mondlicht lag über der schneelosen Landschaft, doch wir verhüllten das Ding und trugen es in unserer Mitte über die verlassenen Straßen und Wiesen nach Hause, so wie wir es schon einmal, in einer schrecklichen Nacht in Arkham, mit einem ähnlichen Ding gemacht hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67bcf0a6-67e0-4254-a6d2-8804737a43e6",
                        "source_entry_id": "d3574222-af9d-34c9-86b0-98f88436f105",
                        "source_sense_id": "dea884a4-dadc-39cb-a988-f3e2134f7363",
                        "target_lang_word": "schneefrei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schneefrei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5559a1e6-701d-369e-9122-a45bc7dc91e8",
                                        "entry_id": "03b09cc4-9f31-3745-8985-5fd064040654",
                                        "glosses": [
                                            "frei von Schnee, ohne Schnee"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7af8f9b8-7675-45ca-852b-7964fa2834da",
                                                "sense_id": "5559a1e6-701d-369e-9122-a45bc7dc91e8",
                                                "text": "Die Straßen sind schneefrei, nur auf den Wiesen liegt noch etwas Schnee."
                                            },
                                            {
                                                "example_id": "96f14160-c11a-4447-9818-26cbe5876d6d",
                                                "sense_id": "5559a1e6-701d-369e-9122-a45bc7dc91e8",
                                                "text": "Die Antwort wird nicht lang auf sich warten lassen; schon wird stellenweise die braune Erde sichtbar, das matte Grün der Wintersaat wagt sich ans Licht; die Straße, die vom Dorfe her sachte ansteigt zum Pfarrhaus, ist schon ganz schneefrei, in dem Graben neben ihr rieselt munter ein schmales, schmutziges Bächlein. (Marie von Ebner-Eschenbach: Unverbesserlich)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1449c24d-ab83-3c1e-a1b9-cfad6296fc17",
                                        "entry_id": "03b09cc4-9f31-3745-8985-5fd064040654",
                                        "glosses": [
                                            "schulfrei aufgrund starker Schneefälle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8575e0f2-ecfb-47d4-a89a-3b5a588726cb",
                                                "sense_id": "1449c24d-ab83-3c1e-a1b9-cfad6296fc17",
                                                "text": "„Und dann hatten wir die Daumen so doll gedrückt, wie wir konnten, und die Ohren gespitzt und darauf gewartet, dass Mom uns zurief, wir müssten nicht zur Schule, es sei offiziell schneefrei.“"
                                            },
                                            {
                                                "example_id": "b5d80835-5c56-4762-a81c-d8f46aff83b9",
                                                "sense_id": "1449c24d-ab83-3c1e-a1b9-cfad6296fc17",
                                                "text": "„Eine ganze Woche schneefrei hat auch Schulleiter Frank Schwesig noch nicht erlebt.“"
                                            },
                                            {
                                                "example_id": "fcb34e76-69ab-49a7-91bb-bd8da8136468",
                                                "sense_id": "1449c24d-ab83-3c1e-a1b9-cfad6296fc17",
                                                "text": "„In Bayern freuen sich die Kinder über schneefrei, in Österreich wächst derweil die Sorge vor Lawinen: Die Schnee-Situation im Alpenraum wird Experten zufolge immer dramatischer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
