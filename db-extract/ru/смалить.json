                "senses": [
                    {
                        "sense_id": "1093600a-c494-3e82-b42e-c8a94033065f",
                        "entry_id": "6b2c81a5-2a36-312d-814b-1ebba497def5",
                        "glosses": [
                            "диал. опалять что-либо (в значении «подвергать действию огня»; чаще всего — тушу животного, убитого на мясо)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64927cdd-ee88-475b-a30c-42cc39711cd6",
                                "sense_id": "1093600a-c494-3e82-b42e-c8a94033065f",
                                "text": "Свинятники борова купят, режут-смалят."
                            },
                            {
                                "example_id": "5dd93817-07c6-41ea-99cb-f3e9b75e9692",
                                "sense_id": "1093600a-c494-3e82-b42e-c8a94033065f",
                                "text": "— Когда свинью смалят, ей не до поросят."
                            }
                        ]
                    },
                    {
                        "sense_id": "fdc1ea8a-c844-3ddf-b63c-c24bc03ad052",
                        "entry_id": "6b2c81a5-2a36-312d-814b-1ebba497def5",
                        "glosses": [
                            "разг. палить, стрелять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a26b234-b22f-401b-b03a-9f21730fb206",
                                "sense_id": "fdc1ea8a-c844-3ddf-b63c-c24bc03ad052",
                                "text": "В меня смалят из пулеметов, а я только спину гну да хоронюсь."
                            }
                        ]
                    },
                    {
                        "sense_id": "140aec03-cfcc-3300-a50e-052fd69b0844",
                        "entry_id": "6b2c81a5-2a36-312d-814b-1ebba497def5",
                        "glosses": [
                            "устар., рег. (сиб.) сильно бить кого-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3059b112-7205-432b-ab81-55b5f8e93fdb",
                                "sense_id": "140aec03-cfcc-3300-a50e-052fd69b0844",
                                "text": "Догнал Илья Муромец кобылу и стал смалить её по ушам."
                            }
                        ]
                    },
                    {
                        "sense_id": "7438a7d0-53bb-3745-9f6e-05592a2e0816",
                        "entry_id": "6b2c81a5-2a36-312d-814b-1ebba497def5",
                        "glosses": [
                            "курить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b152ae3-2863-486c-9108-3d5b91abef66",
                                "sense_id": "7438a7d0-53bb-3745-9f6e-05592a2e0816",
                                "text": "Всю ночь в палатках шептались, подолгу сидели в курилке, вынесенной за территорию лагеря, ведь харцеры по уставу «не смалят»."
                            }
                        ]
                    }
