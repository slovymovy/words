                            {
                                "target_lang_word": "破",
                                "target_lang_sense_clarification": "口语，表示对某物感到厌烦"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9426cc5b-ac7a-3385-a69b-1aa12e6bd6fd",
                    "sense_definition": "In a state of mental numbness or inability to think clearly, often due to shock, boredom, or tiredness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stupor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long and monotonous lecture bored me <w>stupid</w>.",
                            "target_lang_translations": {
                                "ru": "Длинная и монотонная лекция довела меня до <w>отупения</w>.",
                                "zh": "那场冗长乏味的讲座听得我都要<w>麻木</w>了。"
                            }
                        },
                        {
                            "text": "He was tired and <w>stupid</w> from lack of sleep after the journey.",
                            "target_lang_translations": {
                                "ru": "Он был уставшим и <w>отупевшим</w> от недосыпа после поездки.",
                                "zh": "旅途劳顿加上睡眠不足，他感到疲惫且<w>反应迟钝</w>。"
                            }
                        }
