                                "target_senses": [
                                    {
                                        "sense_id": "2f65910b-92f2-3c4e-9d27-2da44a013505",
                                        "entry_id": "1be8a3ea-6018-3138-a654-6c581f929481",
                                        "glosses": [
                                            "A soft crackling sound similar to the movement of dry leaves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4af3ee78-5880-4a76-a3d1-e7b51f4ef070",
                                                "sense_id": "2f65910b-92f2-3c4e-9d27-2da44a013505",
                                                "text": "He heard the silken rustle of a dressing-gown being drawn on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eeeac5c-9345-320e-9f70-819a801bb7bb",
                                        "entry_id": "1be8a3ea-6018-3138-a654-6c581f929481",
                                        "glosses": [
                                            "A movement producing such a sound."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rustle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3aff0598-2450-3b38-8563-fd6fb5f7f225",
                                        "entry_id": "0a3ab49d-07b0-3bd2-9dd7-21500fbd7038",
                                        "glosses": [
                                            "To move (something) with a soft crackling sound."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd03a0fb-4128-4447-8a6f-9488e2ff46f5",
                                                "sense_id": "3aff0598-2450-3b38-8563-fd6fb5f7f225",
                                                "text": "The next day at three o'clock we were again at the door, and the footmen as before; we heard the silk dress rustle, and the lady came down the steps and in an imperious voice, she said, \"York, you must put those horses' heads higher, they are not fit to be seen.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3d5be6e-daf2-3f3f-978e-215ab7d7a817",
                                        "entry_id": "0a3ab49d-07b0-3bd2-9dd7-21500fbd7038",
                                        "glosses": [
                                            "To make or obtain in a lively, energetic way."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "982d36d9-73ef-4d3e-9abb-6dd2ce90d938",
                                                "sense_id": "c3d5be6e-daf2-3f3f-978e-215ab7d7a817",
                                                "text": "When at last the lumber was piled again in its rightful place, and the boxes of food had been returned to the shelter from which they had been stolen, the two friends rustled a meal, and then set off on horseback […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eb0de50-dfb9-3308-9d43-ff3a9af9c952",
                                        "entry_id": "0a3ab49d-07b0-3bd2-9dd7-21500fbd7038",
                                        "glosses": [
                                            "To steal (cattle or other livestock)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbd0031a-7513-4a2b-9924-652c38f937c7",
                        "source_entry_id": "dd13173a-4ed3-34a4-88c2-253d92b0c9dd",
                        "source_sense_id": "d3011a7e-60f4-3954-8b0d-0137f9c2cf62",
                        "target_lang_word": "swish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "873e1147-19dd-36ef-a3ec-8c7b11b14f43",
                                        "entry_id": "78318a5b-37ff-3c7b-aa90-390739ff0b88",
                                        "glosses": [
                                            "sophisticated; fashionable; smooth."
                                        ],
                                        "tags": [
                                            "British",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8965571-00c0-41d3-8e55-56e9877e838c",
                                                "sense_id": "873e1147-19dd-36ef-a3ec-8c7b11b14f43",
                                                "text": "This restaurant looks very swish — it even has linen tablecloths."
                                            },
                                            {
                                                "example_id": "8db958c0-2f7b-44b2-8c6f-0f6867494ceb",
                                                "sense_id": "873e1147-19dd-36ef-a3ec-8c7b11b14f43",
                                                "text": "All the shabby railway buildings in front of the station concourse have either been removed or transformed into a shopping complex and swish homes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06850b44-265e-3509-93ed-506b513e695a",
                                        "entry_id": "78318a5b-37ff-3c7b-aa90-390739ff0b88",
                                        "glosses": [
                                            "Attractive, stylish"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "182432e7-f107-4356-b785-4310fb63e9d6",
                                                "sense_id": "06850b44-265e-3509-93ed-506b513e695a",
                                                "text": "When the boys go swish, they always score"
                                            },
                                            {
                                                "example_id": "2289e98b-4100-437a-8fb8-3fae7982cc15",
                                                "sense_id": "06850b44-265e-3509-93ed-506b513e695a",
                                                "text": "The Saints, who started the day third in the table, went marching on thanks to their own swish play and some staggering defending by the visitors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ed550f4-4f70-36c4-9748-3db2cffaf547",
                                        "entry_id": "78318a5b-37ff-3c7b-aa90-390739ff0b88",
                                        "glosses": [
                                            "Effeminate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "swish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0893fc45-c219-35c4-945e-7d3dd7ee4390",
                                        "entry_id": "e926a300-9aca-32a6-a75b-89d35fa43b73",
                                        "glosses": [
                                            "A short rustling, hissing or whistling sound, often made by friction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e672fd39-fe07-310b-8757-f8aa5710718d",
                                        "entry_id": "e926a300-9aca-32a6-a75b-89d35fa43b73",
                                        "glosses": [
                                            "A hissing, sweeping movement through the air, as of an animal's tail."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6361a68-2c4a-4e65-b9e8-0bac823829a6",
                                                "sense_id": "e672fd39-fe07-310b-8757-f8aa5710718d",
                                                "text": "As she trotted down the white path, each swish of her tail sent petals dancing through the air, falling where the bride would walk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f6c04b4-e077-3596-8710-e67580dbd048",
                                        "entry_id": "e926a300-9aca-32a6-a75b-89d35fa43b73",
                                        "glosses": [
                                            "A sound of liquid flowing inside a container."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d0c889c-d0c1-417d-b8b3-f24fcade41ba",
                                                "sense_id": "0f6c04b4-e077-3596-8710-e67580dbd048",
                                                "text": "There were four or five men in the vault already, and I could hear more coming down the passage, and guessed from their heavy footsteps that they were carrying burdens. There was a sound, too, of dumping kegs down on the ground, with a swish of liquor inside them, and then the noise of casks being moved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07a0f0c5-3552-3bfb-839c-0cd71f159967",
                                        "entry_id": "e926a300-9aca-32a6-a75b-89d35fa43b73",
                                        "glosses": [
                                            "A twig or bundle of twigs, used for administering beatings; a switch"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a884a6cf-df4f-35b5-a180-38c1abe42274",
                                        "entry_id": "e926a300-9aca-32a6-a75b-89d35fa43b73",
                                        "glosses": [
                                            "A successful basketball shot that does not touch the rim or backboard."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4203d7d-0065-321e-8295-941fb9579c4a",
                                        "entry_id": "e926a300-9aca-32a6-a75b-89d35fa43b73",
                                        "glosses": [
                                            "A rapid or careless attacking stroke by the batter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "054ea38c-0408-3d19-8b00-09ec109588a5",
                                        "entry_id": "e926a300-9aca-32a6-a75b-89d35fa43b73",
                                        "glosses": [
                                            "An effeminate male homosexual."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84b34a02-e21c-409f-8ebc-c4d29c6a1d39",
                                                "sense_id": "054ea38c-0408-3d19-8b00-09ec109588a5",
                                                "text": "\"Fairies, nances, swishes, fags, lezzes — call 'em what you please — should of course be permitted to earn honest livings […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad2c9bc8-baf3-38f4-b8ec-4ef2097280b3",
                                        "entry_id": "e926a300-9aca-32a6-a75b-89d35fa43b73",
                                        "glosses": [
                                            "Effeminacy, effeminate or homosexual demeanor."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f0c0740-530c-43b0-bb46-b59e62a1e211",
                                                "sense_id": "ad2c9bc8-baf3-38f4-b8ec-4ef2097280b3",
                                                "text": "He got a little swish downriver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cb74621-e7ef-35ac-b541-d1c744ee9182",
                                        "entry_id": "e926a300-9aca-32a6-a75b-89d35fa43b73",
                                        "glosses": [
                                            "An improvised alcoholic drink made by fermenting whatever ingredients are available."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "swish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ac46256-7a26-3b20-9ec3-eb115dd5500f",
                                        "entry_id": "e65c72e1-9022-3cb1-a993-6288e26163c8",
                                        "glosses": [
                                            "To make a rustling sound while moving."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b9a4d4a-3421-47a9-8e08-725da4baa672",
                                                "sense_id": "1ac46256-7a26-3b20-9ec3-eb115dd5500f",
                                                "text": "The cane swishes."
                                            },
                                            {
                                                "example_id": "59f5684e-39b0-4b81-880a-636845df1857",
                                                "sense_id": "1ac46256-7a26-3b20-9ec3-eb115dd5500f",
                                                "text": "In the stern of the low-laden canoe his paddle swished steadily and powerfully, with thrust of straight, stiff upper arm backed by a twisting swing of the body from the waist, and with every stroke the little craft leaped as if a giant hand had shoved her forward."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67ab5942-0f4e-3486-9bdb-d11d17ed3710",
                                        "entry_id": "e65c72e1-9022-3cb1-a993-6288e26163c8",
                                        "glosses": [
                                            "To flourish with a swishing sound."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e11092ef-a794-4114-82bb-0ca6c236b631",
                                                "sense_id": "67ab5942-0f4e-3486-9bdb-d11d17ed3710",
                                                "text": "to swish a cane back and forth"
                                            },
                                            {
                                                "example_id": "5c6c3fdf-b998-4c7e-849c-008fcf630449",
                                                "sense_id": "67ab5942-0f4e-3486-9bdb-d11d17ed3710",
                                                "text": "And backward and forward he swish'd his long tail / As a gentleman swishes his cane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd6c9bb9-f939-3067-99fc-23a2848960b5",
                                        "entry_id": "e65c72e1-9022-3cb1-a993-6288e26163c8",
                                        "glosses": [
                                            "To flog; to lash."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ab65943-7fc5-417e-95af-6a488106ab60",
                                                "sense_id": "fd6c9bb9-f939-3067-99fc-23a2848960b5",
                                                "text": "After Virginia came the twins, who were usually called \"the Star and Stripes\", as they were always getting swished."
                                            },
                                            {
                                                "example_id": "578b411d-5da6-45fc-9844-62193b3fab21",
                                                "sense_id": "fd6c9bb9-f939-3067-99fc-23a2848960b5",
                                                "text": "Doctor Wordsworth and assistants would swish that error out of him in a way that need not here be mentioned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3bfdf72-7b11-316c-9965-9eaf3aebc244",
                                        "entry_id": "e65c72e1-9022-3cb1-a993-6288e26163c8",
                                        "glosses": [
                                            "To make a successful basketball shot that does not touch the rim or backboard."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6532dd7e-077c-35de-b186-20a34ef249c5",
                                        "entry_id": "e65c72e1-9022-3cb1-a993-6288e26163c8",
                                        "glosses": [
                                            "To mince or otherwise to behave in an effeminate manner."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "469cc799-28e5-4c63-babd-d3ecba7c3031",
                                                "sense_id": "6532dd7e-077c-35de-b186-20a34ef249c5",
                                                "text": "I shall not swish; I'll merely act limp-wristed."
                                            },
                                            {
                                                "example_id": "bd9c38d6-540e-4156-9a58-d89fc845753c",
                                                "sense_id": "6532dd7e-077c-35de-b186-20a34ef249c5",
                                                "text": "Once you come to grips and accept that you are both feminine and masculine and accept that proudly, the fear can disappear and you can begin to enjoy being you! […] ¶ So you can shed tears at a movie or other significant event, you can swish (I said that) a little or a lot, you can be feminine or masculine or somewhere in-between because you will know, in your heart, this is the real you. […"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f697a306-b4df-3ce2-9e91-3a56bf74a5f8",
                                        "entry_id": "e65c72e1-9022-3cb1-a993-6288e26163c8",
                                        "glosses": [
                                            "To cause a liquid to move around in a container, or in one's mouth."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32b636d8-a3a4-4c54-98bd-6d29f2b24e36",
                                                "sense_id": "f697a306-b4df-3ce2-9e91-3a56bf74a5f8",
                                                "text": "Swish the mouthwash around the mouth and between the teeth for one minute."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "swish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d0420b3-f6ad-3dcd-ac4a-3a02d6772204",
                                        "entry_id": "9f962dec-0673-325e-9718-61055814a8e8",
                                        "glosses": [
                                            "A hissing or whistling sound of something travelling quickly through the air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e28f52a7-ff8f-416a-b703-4b9542978943",
                                                "sense_id": "4d0420b3-f6ad-3dcd-ac4a-3a02d6772204",
                                                "text": "\"Just like parade it had been a minute before then stumble, bang, swish! Wiped out!\" he said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
