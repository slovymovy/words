                ],
                "senses": [
                    {
                        "sense_id": "2242abfa-8962-3592-9823-5b021ccc8912",
                        "entry_id": "bfdbc34a-9ed8-3c44-a469-d9232953fe84",
                        "glosses": [
                            "Schlüsselanhänger mit einem passiven RFID-Transponder"
                        ],
                        "tags": [
                            "Mechatronik"
                        ],
                        "examples": [
                            {
                                "example_id": "dafc88fd-b647-4def-abbe-f78f82ddaffe",
                                "sense_id": "2242abfa-8962-3592-9823-5b021ccc8912",
                                "text": "„Die Software im Keyfob besteht insgesamt aus fünf verschiedenen Schichten: OSAL, HAL, BLE Protocol Stack, Profile und Applikationen.“"
                            },
                            {
                                "example_id": "6999eb65-d16e-4bec-b21d-ad707e780c89",
                                "sense_id": "2242abfa-8962-3592-9823-5b021ccc8912",
                                "text": "„Marktmitarbeiter können den Keyfob des Kunden (elektronischer Schlüsselanhänger, den sie anstatt einer Kundenkarte erhalten) scannen oder die Stammdaten des Kunden eingeben, um seine komplette Kaufhistorie aufzurufen […].“"
                            },
                            {
                                "example_id": "bfb54777-5441-41a0-997f-bdd2449a86ec",
                                "sense_id": "2242abfa-8962-3592-9823-5b021ccc8912",
                                "text": "„Im linken Bild ist eine sogenannter Logi Tag gezeigt, gefolgt von einem Glas Tag, einem Nail Tag (Nagel Tag) sowie einem Keyfob Tag (Schlüsselanhänger).“"
                            },
                            {
                                "example_id": "af06d29e-85a8-4e73-98f3-59545c16c3f1",
                                "sense_id": "2242abfa-8962-3592-9823-5b021ccc8912",
                                "text": "„Einfache und schnelle Zutrittskontrolle über den NFC Code Touch mit dem kleinen, robusten Schlüsselanhänger, dem NFC Keyfob – die sicherste Art ein Real Smart Home zu betreten. Das Set besteht aus 10 Key Fobs. “"
                            },
                            {
                                "example_id": "63719505-d0da-4008-b87f-7325d1676cdd",
                                "sense_id": "2242abfa-8962-3592-9823-5b021ccc8912",
                                "text": "„Ein Keyfob mit massivem Rand aus rostsicherem, poliertem Stahl. Dieser Keyfob entspricht ästhetischen Anforderungen und ist gleichzeitig praktisch und robust. Der Keyfob ist mittlerweile eine attraktive Alternative zu den klassischen kontaktlosen Karten und wird in vielen Bereichen der Sicherheitskontrollen genutzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
