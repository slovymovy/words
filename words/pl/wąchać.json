            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e34319c4-2ffe-338b-b62f-5605ebbfd655",
                    "sense_definition": "badać, odbierać lub sprawdzać zapach czegoś za pomocą nosa",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "odbieranie zapachu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziewczynka z uśmiechem <w>wącha</w> świeże kwiaty, które dostała na urodziny.",
                            "target_lang_translations": {
                                "ru": "Девочка с улыбкой <w>нюхает</w> свежие цветы, которые ей подарили на день рождения."
                            }
                        },
                        {
                            "text": "Przed zjedzeniem zupy najpierw dokładnie ją <w>wącham</w>, aby sprawdzić jej świeżość.",
                            "target_lang_translations": {
                                "ru": "Перед тем как есть суп, я сначала внимательно его <w>нюхаю</w>, чтобы проверить его свежесть."
                            }
                        }
                    ],
                    "synonyms": [
                        "niuchać"
                    ],
                    "common_phrases": [
                        "wąchać kwiaty"
                    ],
                    "target_lang_definitions": {
                        "ru": "воспринимать или проверять запах чего-либо с помощью носа"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нюхать",
                                "target_lang_sense_clarification": "воспринимать запах носом"
                            },
                            {
                                "target_lang_word": "обонять",
                                "target_lang_sense_clarification": "книжное выражение, ощущать запах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14e10efd-2668-3e24-84d3-b2f110fac2a8",
                    "sense_definition": "odurzać się oparami substancji chemicznych, takich jak klej czy rozpuszczalnik",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "odurzanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Policja zatrzymała nastolatków, którzy w opuszczonym budynku <w>wąchali</w> klej.",
                            "target_lang_translations": {
                                "ru": "Полиция задержала подростков, которые в заброшенном здании <w>нюхали</w> клей."
                            }
                        },
                        {
                            "text": "Ten mężczyzna od wielu lat niszczy swoje zdrowie, ponieważ nałogowo <w>wącha</w> szkodliwe chemikalia.",
                            "target_lang_translations": {
                                "ru": "Этот мужчина много лет губит своё здоровье, так как постоянно <w>нюхает</w> вредные химикаты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wąchać klej",
                        "wąchać rozpuszczalnik"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie specyficznego rodzaju odurzania się"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "одурманивать себя парами химических веществ (клея, растворителя и т. п.)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нюхать",
                                "target_lang_sense_clarification": "вдыхать пары химикатов для опьянения"
                            },
                            {
                                "target_lang_word": "токсикоманить",
                                "target_lang_sense_clarification": "употреблять летучие токсические вещества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff16da58-ee1d-331d-8f78-737c254bf853",
                    "sense_definition": "starać się czegoś dyskretnie dowiedzieć, węszyć lub szukać ukrytych informacji",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dowiadywanie się",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziennikarz śledczy od tygodni <w>wącha</w> wokół tej afery finansowej.",
                            "target_lang_translations": {
                                "ru": "Журналист-расследователь уже не одну неделю <w>вынюхивает</w> вокруг этой финансовой аферы."
                            }
                        },
                        {
                            "text": "Nie podoba mi się, że obcy ludzie <w>wąchają</w> w sprawach mojej rodziny.",
                            "target_lang_translations": {
                                "ru": "Мне не нравится, что посторонние люди <w>суют нос</w> в дела моей семьи."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w przenośni, potocznie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "пытаться незаметно что-то разузнать, вынюхивать или разведывать скрытую информацию"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вынюхивать",
                                "target_lang_sense_clarification": "разузнавать, тайно выискивать"
                            },
                            {
                                "target_lang_word": "нюхать",
                                "target_lang_sense_clarification": "выискивать информацию, разведывать"
                            },
                            {
                                "target_lang_word": "пронюхивать",
                                "target_lang_sense_clarification": "пытаться разузнать скрытое"
                            }
                        ]
                    }
                }
            ]
        }
    ]
