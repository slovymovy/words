            "senses": [
                {
                    "sense_id": "f4fc31e5-cfe0-3663-bf4c-90b1e7772463",
                    "sense_definition": "The act or process of defeating or gaining complete control over someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "process_defeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The history book detailed the various <w>overpowerings</w> of small tribes by the empire.",
                            "target_lang_translations": {
                                "ru": "В учебнике истории подробно описывались различные случаи <w>покорения</w> малых племен империей.",
                                "it": "Il libro di storia descriveva dettagliatamente le varie <w>sottomissioni</w> delle piccole tribù da parte dell'impero."
