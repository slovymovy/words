                "senses": [
                    {
                        "sense_id": "68fa62d3-9217-354e-85a8-fe58c95fd94c",
                        "entry_id": "fbf8784c-eaac-3db6-8902-12e5fa65e7bb",
                        "glosses": [
                            "met een kleur die een combinatie is tussen goudkleurig en bruin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a09926b8-dbff-41d9-a411-a7ecb5e1fa5a",
                                "sense_id": "68fa62d3-9217-354e-85a8-fe58c95fd94c",
                                "text": "Het goudbruine haar van het meisje straalde helemaal op de foto."
                            },
                            {
                                "example_id": "ca7223ab-f985-4e06-ac87-398b32afbd9d",
                                "sense_id": "68fa62d3-9217-354e-85a8-fe58c95fd94c",
                                "text": "Aan de andere kant van de vallei zag ik opeens bruine stipjes bewegen in een veld vol bosbessen. Het waren twee zwarte beren die door de felle zon goudbruin waren verkleurd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f928708-a59e-4714-a77e-49c7f822c48a",
                        "source_entry_id": "fbf8784c-eaac-3db6-8902-12e5fa65e7bb",
                        "source_sense_id": "68fa62d3-9217-354e-85a8-fe58c95fd94c",
                        "source_sense_description": "met een kleur die een combinatie is tussen goudkleurig en bruin",
                        "target_lang_word": "kastanienbraun",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kastanienbraun",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68028d58-fbff-3f59-9aec-dce5c2979f85",
                                        "entry_id": "a18893b0-a35f-3494-818e-4731e8867d88",
                                        "glosses": [
                                            "mittelbraun bis dunkelbraun und rötlich schimmernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d11b732-b6ff-4c53-bf1d-682ddd1d6a13",
                                                "sense_id": "68028d58-fbff-3f59-9aec-dce5c2979f85",
                                                "text": "Jeanne de la Motte war 1784 siebenundzwanzig Jahre alt, ihre Haare waren kastanienbraun und wellig, ihre Augen blau und ausdrucksvoll, ihr Lächeln berückend."
                                            },
                                            {
                                                "example_id": "88b11936-4f26-4e82-a0b2-77a3d4fde7d3",
                                                "sense_id": "68028d58-fbff-3f59-9aec-dce5c2979f85",
                                                "text": "Mit ihrem kastanienbraun gefärbten Haar und dem faltigen Gesicht könnte die Ältere ideal die Schwester des Lebemannes Saki Bey abgeben, von der es im Roman heißt, »ihre Füße steckten in Pantoffeln in der Form weißer Kaninchen«."
                                            },
                                            {
                                                "example_id": "aea485bb-2da1-4763-86a4-f66b156ea9fb",
                                                "sense_id": "68028d58-fbff-3f59-9aec-dce5c2979f85",
                                                "text": "Das orange gefärbte Gesicht wird von einem langen Backenbarte von glänzender Weisse umgeben mit einer kastanienbraunen Linie über den Augenbrauen."
                                            },
                                            {
                                                "example_id": "0b96d279-cf55-4677-96aa-3bd127de41e3",
                                                "sense_id": "68028d58-fbff-3f59-9aec-dce5c2979f85",
                                                "text": "Reimer war ein junger, schwarzbrauner Schneidersmann und hatte große kastanienbraune, immer wie mit Traum und Schlaf kämpfende Augen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b0f7b5e-a6d8-4a68-9cea-4d9adf16b330",
                        "source_entry_id": "fbf8784c-eaac-3db6-8902-12e5fa65e7bb",
                        "source_sense_id": "68fa62d3-9217-354e-85a8-fe58c95fd94c",
