{
    "word_family": [
        "bitter",
        "bitterness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "97001bf9-3fc7-3b60-b38a-3086665e8495",
                    "sense_definition": "In a way that shows strong feelings of sadness, anger, or resentment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>bitterly</w> regretted the harsh words she had spoken to her friend.",
                            "target_lang_translations": {
                                "ru": "Она <w>горько</w> сожалела о резких словах, сказанных подруге."
                            }
                        },
                        {
                            "text": "The defeated team complained <w>bitterly</w> about the referee's final decision.",
                            "target_lang_translations": {
                                "ru": "Проигравшая команда <w>с горечью</w> жаловалась на окончательное решение судьи."
                            }
                        }
                    ],
                    "synonyms": [
                        "resentfully",
                        "angrily"
                    ],
                    "common_phrases": [
                        "complain bitterly",
                        "regret bitterly"
                    ],
                    "target_lang_definitions": {
                        "ru": "С выражением глубокой печали, обиды, злости или разочарования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горько",
                                "target_lang_sense_clarification": "с глубоким огорчением или сожалением"
                            },
                            {
                                "target_lang_word": "ожесточённо",
                                "target_lang_sense_clarification": "с сильной злобой или обидой"
                            },
                            {
                                "target_lang_word": "с горечью",
                                "target_lang_sense_clarification": "испытывая чувство обиды или разочарования"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0759b316-7977-377f-b098-322a2122572d",
                    "sense_definition": "To an extreme or intense degree, especially regarding cold weather.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>bitterly</w> cold morning when we started our hike.",
                            "target_lang_translations": {
                                "ru": "Было <w>пронизывающе</w> холодное утро, когда мы отправились в поход."
                            }
                        },
                        {
                            "text": "The wind felt <w>bitterly</w> cold as we walked across the open field.",
                            "target_lang_translations": {
                                "ru": "Ветер казался <w>люто</w> холодным, пока мы шли по открытому полю."
                            }
                        }
                    ],
                    "synonyms": [
                        "extremely",
                        "intensely"
                    ],
                    "common_phrases": [
                        "bitterly cold"
                    ],
                    "target_lang_definitions": {
                        "ru": "В чрезвычайно сильной степени (особенно о холодной погоде)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пронизывающе",
                                "target_lang_sense_clarification": "о резком, сильном холоде или ветре"
                            },
                            {
                                "target_lang_word": "страшно",
                                "target_lang_sense_clarification": "в высшей степени, крайне (о холоде)"
                            },
                            {
                                "target_lang_word": "люто",
                                "target_lang_sense_clarification": "очень сильно, свирепо (о морозе, холоде)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}