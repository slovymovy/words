                "senses": [
                    {
                        "sense_id": "b5f67198-daca-365f-b238-e75508c2d734",
                        "entry_id": "c3edaba1-cf46-3e00-8773-15803906f145",
                        "glosses": [
                            "Avion qui peut voler grâce à quatre turboréacteurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39310950-c3a8-4bce-9ad0-c19462dc4434",
                                "sense_id": "b5f67198-daca-365f-b238-e75508c2d734",
                                "text": "Entré en service en 1995, le 777 a marqué une rupture dans l’aviation commerciale : pour la première fois, un biréacteur permettait de franchir des distances jusqu’alors réservées aux quadriréacteurs, grâce à un réacteur surpuissant, le GE90 du motoriste américain GE."
                            },
                            {
                                "example_id": "b9041eb5-c77a-4567-a76e-9ee487872e28",
                                "sense_id": "b5f67198-daca-365f-b238-e75508c2d734",
                                "text": "Le Concorde est un quadriréacteur dont les moteurs (4 Rolls-Royce - Snecma Olympus) sont disposés dans des fuseaux accolés sous la voilure."
                            },
                            {
                                "example_id": "ac1a7732-aa3f-4a6f-b147-dc2a137c4e78",
                                "sense_id": "b5f67198-daca-365f-b238-e75508c2d734",
                                "text": "Après avoir rebroussé chemin pendant plus de deux heures, le quadriréacteur s’est posé à la Guadeloupe pour débarquer le Vénézuelien atteint d’une péritonite aiguë."
                            }
                        ]
                    }
