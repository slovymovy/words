{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dacdf568-e29a-3668-b430-c2a99adcad25",
                    "sense_definition": "A man or a boy; a fellow.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "person_ref",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a really nice <w>guy</w> who always helps his neighbors.",
                            "target_lang_translations": {
                                "ru": "Он действительно хороший <w>парень</w>, который всегда помогает своим соседям.",
                                "zh": "他真是个很不错的<w>人</w>，总是帮助邻居。"
                            }
                        },
                        {
                            "text": "I met a <w>guy</w> at the library who recommended this book.",
                            "target_lang_translations": {
                                "ru": "Я встретил в библиотеке одного <w>парня</w>, который порекомендовал эту книгу.",
                                "zh": "我在图书馆遇到一个<w>小伙子</w>，他给我推荐了这本书。"
                            }
                        }
                    ],
                    "synonyms": [
                        "man",
                        "fellow",
                        "dude",
                        "chap",
                        "bloke",
                        "lad",
                        "fella"
                    ],
                    "antonyms": [
                        "girl",
                        "woman"
                    ],
                    "common_phrases": [
                        "nice guy",
                        "tough guy",
                        "bad guy",
                        "regular guy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужчина, парень или мальчик (разговорное).",
                        "zh": "男人或男孩；家伙。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парень",
                                "target_lang_sense_clarification": "молодой мужчина (разговорное)"
                            },
                            {
                                "target_lang_word": "мужчина",
                                "target_lang_sense_clarification": "взрослый человек мужского пола"
                            },
                            {
                                "target_lang_word": "молодой человек",
                                "target_lang_sense_clarification": "вежливое или формальное обращение"
                            },
                            {
                                "target_lang_word": "мужик",
                                "target_lang_sense_clarification": "просторечное название мужчины"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "家伙",
                                "target_lang_sense_clarification": "口语，指男人或男孩"
                            },
                            {
                                "target_lang_word": "小伙子",
                                "target_lang_sense_clarification": "指年轻男子"
                            },
                            {
                                "target_lang_word": "男人",
                                "target_lang_sense_clarification": "泛指男性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ed74e7b-05dd-315c-ac50-1df201f72b58",
                    "sense_definition": "A group of people of any gender; used as a form of address.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "person_ref",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hey <w>guys</w>, do you want to go to the cinema tonight?",
                            "target_lang_translations": {
                                "ru": "Эй, <w>ребята</w>, хотите пойти сегодня вечером в кино?",
                                "zh": "嘿，<w>大家</w>，今晚想去看电影吗？"
                            }
                        },
                        {
                            "text": "Come on, <w>guys</w>, we are going to be late for the train.",
                            "target_lang_translations": {
                                "ru": "Давайте, <w>ребята</w>, мы опоздаем на поезд.",
                                "zh": "快点，<w>大家</w>，我们的火车要赶不上了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "everyone",
                        "folks",
                        "people",
                        "everybody"
                    ],
                    "common_phrases": [
                        "you guys",
                        "hey guys",
                        "hi guys"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей любого пола; часто используется как обращение.",
                        "zh": "对一群人的称呼，可用于任何性别。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ребята",
                                "target_lang_sense_clarification": "дружеское обращение к группе людей"
                            },
                            {
                                "target_lang_word": "народ",
                                "target_lang_sense_clarification": "обращение к группе людей (разговорное)"
                            },
                            {
                                "target_lang_word": "люди",
                                "target_lang_sense_clarification": "группа лиц"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大家",
                                "target_lang_sense_clarification": "对一群人的常见口语称呼，不分性别"
                            },
                            {
                                "target_lang_word": "伙计们",
                                "target_lang_sense_clarification": "较口语的群体称呼"
                            },
                            {
                                "target_lang_word": "各位",
                                "target_lang_sense_clarification": "较正式或礼貌的群体称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9338c864-b3de-33a2-bf94-661b2bf18508",
                    "sense_definition": "A rope, cable, or wire used to steady or secure something, such as a tent or a mast.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nautical_technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to tighten the <w>guy</w> to keep the tent stable in the wind.",
                            "target_lang_translations": {
                                "ru": "Нам нужно натянуть <w>оттяжку</w>, чтобы палатка устойчиво стояла на ветру.",
                                "zh": "我们得把<w>拉绳</w>拉紧，才能让帐篷在风中保持稳固。"
                            }
                        },
                        {
                            "text": "The mast was supported by a steel <w>guy</w> attached to the deck.",
                            "target_lang_translations": {
                                "ru": "Мачта поддерживалась стальным <w>тросом</w>, прикрепленным к палубе.",
                                "zh": "桅杆由一根固定在甲板上的钢<w>支索</w>支撑着。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cable",
                        "rope",
                        "line",
                        "wire"
                    ],
                    "common_phrases": [
                        "guy rope",
                        "guy wire",
                        "guy line"
                    ],
                    "target_lang_definitions": {
                        "ru": "Веревка, трос или провод, используемые для укрепления или фиксации чего-либо (например, палатки или мачты).",
                        "zh": "用于稳住或固定某物的绳、索或钢丝，如帐篷或桅杆的拉索。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оттяжка",
                                "target_lang_sense_clarification": "трос для удержания мачты или трубы"
                            },
                            {
                                "target_lang_word": "растяжка",
                                "target_lang_sense_clarification": "крепление для фиксации"
                            },
                            {
                                "target_lang_word": "трос",
                                "target_lang_sense_clarification": "общее название каната"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉绳",
                                "target_lang_sense_clarification": "固定帐篷等用的绳子"
                            },
                            {
                                "target_lang_word": "支索",
                                "target_lang_sense_clarification": "支撑桅杆、杆塔等的索"
                            },
                            {
                                "target_lang_word": "牵索",
                                "target_lang_sense_clarification": "拉住并固定物体的绳索"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab290ec8-76da-3840-b02d-069dbfccb5da",
                    "sense_definition": "An effigy (a roughly made model of a person) of Guy Fawkes, traditionally burned on bonfires in Britain on November 5th.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_cultural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children made a <w>guy</w> out of old clothes and straw for the bonfire.",
                            "target_lang_translations": {
                                "ru": "Дети сделали <w>чучело</w> из старой одежды и соломы для костра.",
                                "zh": "孩子们用旧衣服和稻草做了一个<w>盖伊·福克斯人偶</w>，准备放到篝火里烧。"
                            }
                        },
                        {
                            "text": "We watched the <w>guy</w> burn while fireworks exploded overhead.",
                            "target_lang_translations": {
                                "ru": "Мы смотрели, как горит <w>чучело</w>, пока над головой взрывались фейерверки.",
                                "zh": "我们看着那个<w>盖伊·福克斯人偶</w>燃烧，头顶上烟花不断绽放。"
                            }
                        }
                    ],
                    "synonyms": [
                        "effigy"
                    ],
                    "common_phrases": [
                        "penny for the guy"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чучело Гая Фокса, которое традиционно сжигают на кострах в Великобритании 5 ноября.",
                        "zh": "盖伊·福克斯的人形像，英国传统上会在11月5日篝火夜焚烧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чучело",
                                "target_lang_sense_clarification": "кукла, изображающая человека"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盖伊·福克斯人偶",
                                "target_lang_sense_clarification": "英国篝火夜焚烧的盖伊·福克斯形象"
                            },
                            {
                                "target_lang_word": "人偶",
                                "target_lang_sense_clarification": "用来象征某人的焚烧用人形像"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "766187d2-2544-30af-b01f-966d083731eb",
                    "sense_definition": "A male given name.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "name_ref",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My uncle <w>Guy</w> lives in France.",
                            "target_lang_translations": {
                                "ru": "Мой дядя <w>Гай</w> живет во Франции.",
                                "zh": "我的叔叔<w>盖伊</w>住在法国。"
                            }
                        },
                        {
                            "text": "We named our son <w>Guy</w> after his grandfather.",
                            "target_lang_translations": {
                                "ru": "Мы назвали нашего сына <w>Гай</w> в честь его дедушки.",
                                "zh": "我们给儿子取名为<w>盖伊</w>，以纪念他的祖父。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя.",
                        "zh": "男性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гай",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盖伊",
                                "target_lang_sense_clarification": "男性名字"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "79c4df81-cfb6-35a2-a6ee-da1d74c0adcc",
                    "sense_definition": "To secure or steady something using a rope or cable.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nautical_technical_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>guyed</w> the antenna to the roof to withstand the storm.",
                            "target_lang_translations": {
                                "ru": "Они <w>закрепили оттяжками</w> антенну на крыше, чтобы она выдержала шторм.",
                                "zh": "他们把天线<w>用拉绳固定</w>在屋顶上，好抵御暴风雨。"
                            }
                        },
                        {
                            "text": "The workers <w>guyed</w> the tall pole to prevent it from falling.",
                            "target_lang_translations": {
                                "ru": "Рабочие <w>укрепили</w> высокий столб <w>тросами</w>, чтобы он не упал.",
                                "zh": "工人们把那根高杆<w>用支索固定</w>住，以防它倒下。"
                            }
                        }
                    ],
                    "synonyms": [
                        "secure",
                        "steady",
                        "anchor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Укреплять или фиксировать что-либо с помощью веревки или троса.",
                        "zh": "用绳索或钢缆把某物固定或稳住。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крепить оттяжками",
                                "target_lang_sense_clarification": "фиксировать тросами"
                            },
                            {
                                "target_lang_word": "укреплять",
                                "target_lang_sense_clarification": "делать устойчивым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用拉绳固定",
                                "target_lang_sense_clarification": "用拉绳把某物固定住"
                            },
                            {
                                "target_lang_word": "用支索固定",
                                "target_lang_sense_clarification": "用支索支撑并固定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a095197d-5aed-3fd0-a8d3-f14ef926fcce",
                    "sense_definition": "To make fun of or ridicule someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ridicule_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian <w>guyed</w> the politician's speech mercilessly.",
                            "target_lang_translations": {
                                "ru": "Комик безжалостно <w>высмеял</w> речь политика.",
                                "zh": "那位喜剧演员毫不留情地<w>嘲弄</w>了那位政治家的演讲。"
                            }
                        },
                        {
                            "text": "He felt he was being <w>guyed</w> by his friends for his mistake.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что друзья <w>поднимают</w> его <w>на смех</w> из-за его ошибки.",
                                "zh": "他觉得朋友们因为他的错误而在<w>嘲笑</w>他。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ridicule",
                        "mock"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высмеивать кого-либо или издеваться над кем-либо.",
                        "zh": "取笑或讥讽某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высмеивать",
                                "target_lang_sense_clarification": "подвергать насмешкам"
                            },
                            {
                                "target_lang_word": "поднимать на смех",
                                "target_lang_sense_clarification": "фразеологизм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嘲弄",
                                "target_lang_sense_clarification": "讥笑，拿别人开玩笑"
                            },
                            {
                                "target_lang_word": "嘲笑",
                                "target_lang_sense_clarification": "更常见的说法"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}