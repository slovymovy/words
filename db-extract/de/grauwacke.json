                ],
                "senses": [
                    {
                        "sense_id": "8608b30d-c40f-3366-9bb3-a823997d66d7",
                        "entry_id": "d5db756e-cbf2-3c13-b7d9-f353dca266f9",
                        "glosses": [
                            "dunkelgrau bis braungrau gefärbtes, sandsteinartiges Sedimentgestein hauptsächlich aus dem Paläozoikum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46d616ed-b0a5-4a00-997c-cb32eb049685",
                                "sense_id": "8608b30d-c40f-3366-9bb3-a823997d66d7",
                                "text": "In Deutschland kommen Grauwacken in der Eifel, Frankenwald, Harz, Lausitz, Sauerland, Siegerland, Thüringisches Schiefergebirge und Waldeck vor."
                            },
                            {
                                "example_id": "5c0d218f-76a1-4829-ae47-6c04fa4a734d",
                                "sense_id": "8608b30d-c40f-3366-9bb3-a823997d66d7",
                                "text": "Die silurische Grauwacke von Rottluf besteht aus Körnern und Geröllen von grauem Quarz, fast farblosem oder lichtfleischrothem Orthoklas, Hornblendeschiefern, Phylliten und aus einzelnen Glimmerblättchen."
                            },
                            {
                                "example_id": "531b67a6-fc55-4ed5-8c59-9636407c23ee",
                                "sense_id": "8608b30d-c40f-3366-9bb3-a823997d66d7",
                                "text": "Die oberdevonische, feinkörnige, graue bis schmutziggrüne Grauwacke lässt grössere Quarzkörner und Muscovit erkennen und enthält Zwischenlagen schwarzen Thonschiefers."
                            },
                            {
                                "example_id": "06059410-31ef-4c5f-b731-0852cd7521ef",
                                "sense_id": "8608b30d-c40f-3366-9bb3-a823997d66d7",
                                "text": "Dieses Gebirge wurde zum Fundament hin abgetragen, bis erneut Grauwacke und Granit des Grundgebirges zum Vorschein kamen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "303ce749-131a-4cb2-b277-9fbd308dd942",
                        "source_entry_id": "d5db756e-cbf2-3c13-b7d9-f353dca266f9",
                        "source_sense_id": "8608b30d-c40f-3366-9bb3-a823997d66d7",
                        "target_lang_word": "graywacke",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graywacke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ecbeb99-3acc-329a-9550-1498711c2fa0",
                                        "entry_id": "db57e971-f595-306d-80cc-ef5fcebe0e32",
                                        "glosses": [
                                            "Alternative form of greywacke."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01217992-0a4c-4d02-ba94-d426a424485b",
                                                "sense_id": "2ecbeb99-3acc-329a-9550-1498711c2fa0",
                                                "text": "Hundreds of projectile points and ceramic pieces from the island are stored in the State Museum in Albany, and archaeologists found human bones at a burial site from the early Woodland period at the back of the rock shelter, a 45-foot-long overhang of graywacke, a local sandstone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70b5d2a7-21c9-4624-8cd4-9200dd4c60dc",
                        "source_entry_id": "d5db756e-cbf2-3c13-b7d9-f353dca266f9",
                        "source_sense_id": "8608b30d-c40f-3366-9bb3-a823997d66d7",
                        "target_lang_word": "greywacke",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "greywacke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80cb01df-02ab-3f85-9e98-cc5057d31730",
                                        "entry_id": "72e49bb4-0514-39a2-a6f0-02a5de92c313",
                                        "glosses": [
                                            "A hard dark sandstone with poorly sorted angular grains of quartz, feldspar, and small rock fragments in a compact, clay-fine matrix."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c048fa26-c77f-4539-8f74-6cfc04f036f5",
                                                "sense_id": "80cb01df-02ab-3f85-9e98-cc5057d31730",
                                                "text": "Endless bleak, rounded hills composed of shales and ribs of tough ‘greywackes’ make up the Southern Uplands – all of such rocks were originally deposited under marine conditions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4728db7-e740-46ce-9186-1b6e02b34106",
                        "source_entry_id": "d5db756e-cbf2-3c13-b7d9-f353dca266f9",
                        "source_sense_id": "8608b30d-c40f-3366-9bb3-a823997d66d7",
                        "target_lang_word": "grauwacke",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grauwacke",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bac216df-d423-317a-8015-3048d029a3ad",
                                        "entry_id": "bed05ca3-82cb-34bb-a154-9a5606b0a49c",
                                        "glosses": [
                                            "Sorte de grès schisteux très fin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc0eedac-f5e1-4d55-976c-1775bbca07d9",
                                                "sense_id": "bac216df-d423-317a-8015-3048d029a3ad",
                                                "text": "Au-dessus des couches de grès et de schiste qui lui sont associés, on trouve aux environ de Rennes des grauwackes schisteuses d'un rouge lie-de-vin et vertes qui alternent ensemble un grand nombre de fois. Elles se délitent irrégulièrement, et ressemblent d'une manière frappante à certaines roches des Alpes. ."
                                            },
                                            {
                                                "example_id": "adbb422f-0384-4a63-bb2e-dd5fb49d6764",
                                                "sense_id": "bac216df-d423-317a-8015-3048d029a3ad",
                                                "text": "Une grauwacke étant formée de grains de nature et de taille variées et étant une roche rencontrée fréquemment dans les niveaux du paléozoïque, comment la différencier sur le terrain avec un grès ?"
                                            },
                                            {
                                                "example_id": "6c8b1c2f-582e-434f-aab5-951f63811f4a",
                                                "sense_id": "bac216df-d423-317a-8015-3048d029a3ad",
                                                "text": "Mais ces assises de grès et de schistes, inférieures au Silurien, n’avaient point encore livré de débris organiques et étaient désignées par les géologues anglais comme une graüwacke stérile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
