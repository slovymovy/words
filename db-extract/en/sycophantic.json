                "senses": [
                    {
                        "sense_id": "e8e251b2-2021-359b-94d3-103b1524b313",
                        "entry_id": "751001c7-3616-3923-996d-3bff88129649",
                        "glosses": [
                            "Excessively eager to please, especially for personal gain; obsequious, flattering."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ae6ef00-1b9c-474a-8e0a-0bc9846a1231",
                                "sense_id": "e8e251b2-2021-359b-94d3-103b1524b313",
                                "text": "I melt into a sycophantic soup, and all that’s left to do is giggle, fawn and swoon."
                            },
                            {
                                "example_id": "6f98ee86-b796-4ed9-af0b-eee09823e0be",
                                "sense_id": "e8e251b2-2021-359b-94d3-103b1524b313",
                                "text": "when the princess’s former nanny Marion Crawford, “Crawfie”, published an entirely anodyne and sycophantic memoir in 1950, she was cast into outer darkness by the family."
                            },
                            {
                                "example_id": "e64763e6-69bb-40c3-93c8-ddb50829c502",
                                "sense_id": "e8e251b2-2021-359b-94d3-103b1524b313",
                                "text": "Then, at the 40 minute mark, [US Vice President J.D.] Vance chimed in with some sycophantic nonsense."
                            }
                        ]
                    }
                ],
