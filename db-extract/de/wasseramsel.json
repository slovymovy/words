                        "sense_id": "ff1e229e-0b65-3dc1-b3ba-2102e6c1bd37",
                        "entry_id": "b99ac46a-fd42-3652-9370-f3c75dd7fe31",
                        "glosses": [
                            "eng an Fließgewässer gebundener Singvogel aus der Familie Cinclidae, speziell die einheimische Art Cinclus cinclus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08ef7560-39fe-4e53-94bc-e2e79848254c",
                                "sense_id": "ff1e229e-0b65-3dc1-b3ba-2102e6c1bd37",
                                "text": "Wasseramseln ernähren sich unter anderem von Köcherfliegenlarven, die sie am Gewässergrund fangen."
                            },
                            {
                                "example_id": "148c1cc8-bec0-4c0f-bf3e-ad4fda9e2c6b",
                                "sense_id": "ff1e229e-0b65-3dc1-b3ba-2102e6c1bd37",
                                "text": "„Zwar jagt die Wasseramsel hin und wieder auch Insekten in der Luft oder sammelt diese von Pflanzen, doch ihr eigentliches Element ist das Wasser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc963e2d-2206-417b-9ffe-35b008a905f9",
                        "source_entry_id": "b99ac46a-fd42-3652-9370-f3c75dd7fe31",
