                                        "examples": [
                                            {
                                                "example_id": "998ca654-2776-4e38-8aa4-01cde9525f03",
                                                "sense_id": "7a246895-7d7d-39b1-9141-041b6ca12d6d",
                                                "text": "Meine Mutter fährt jedes Jahr nach Euböa, um dort Fahrrad zu fahren."
                                            },
                                            {
                                                "example_id": "74788e3d-aca8-4307-bfcd-b314bd5908fb",
                                                "sense_id": "7a246895-7d7d-39b1-9141-041b6ca12d6d",
                                                "text": "Mein Urgroßvater verlebte nicht ein einziges Mal seinen Urlaub auf Euböa."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
