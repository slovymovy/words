{
    "word_family": [
        "specify",
        "specification",
        "speculate",
        "speculation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eb89bdba-570f-30d9-a44f-8342bdd4d3be",
                    "sense_definition": "An informal shortened form of <w>specification</w>; a detailed technical description or requirement.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "specification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The computer failed to meet the original design <w>spec</w>.",
                            "target_lang_translations": {
                                "zh": "这台电脑未能达到最初的设计<w>规格</w>。"
                            }
                        },
                        {
                            "text": "Every job <w>spec</w> should clearly outline the required skills.",
                            "target_lang_translations": {
                                "zh": "每份岗位<w>说明书</w>都应清晰列出所需的技能要求。"
                            }
                        }
                    ],
                    "synonyms": [
                        "specification",
                        "requirement"
                    ],
                    "common_phrases": [
                        "job spec",
                        "on spec",
                        "design spec"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "“specification”的口语缩写；详细的技术说明、规格或规范要求。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "规格",
                                "target_lang_sense_clarification": "产品、材料等的技术参数或要求"
                            },
                            {
                                "target_lang_word": "规范",
                                "target_lang_sense_clarification": "工程、设计或操作标准要求"
                            },
                            {
                                "target_lang_word": "说明书",
                                "target_lang_sense_clarification": "技术指标或岗位要求说明"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "073609f5-f8ab-3f6a-953a-054f09aa2935",
                    "sense_definition": "An informal shortened form of <w>speculation</w>, referring to a venture or risk taken in hopes of profit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speculation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought the empty plot of land entirely on <w>spec</w>.",
                            "target_lang_translations": {
                                "zh": "他买下那块空地完全是为了<w>碰运气</w>投资。"
                            }
                        },
                        {
                            "text": "She wrote the screenplay on <w>spec</w> without any contract in place.",
                            "target_lang_translations": {
                                "zh": "她在没有任何预先合同的情况下，<w>碰运气</w>写完了这部剧本。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gamble",
                        "speculation"
                    ],
                    "common_phrases": [
                        "on spec"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "“speculation”的口语缩写；为求营利而承担风险的投机行为或碰运气的尝试。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "碰运气",
                                "target_lang_sense_clarification": "不抱十足把握的冒险尝试"
                            },
                            {
                                "target_lang_word": "投机",
                                "target_lang_sense_clarification": "以牟利为目的的冒险行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "285b335e-64b5-3452-bce6-c439760a232c",
                    "sense_definition": "A spectacular mark or high catch in Australian rules football.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forward leapt over the defender to pull down a remarkable <w>spec</w>.",
                            "target_lang_translations": {
                                "zh": "前锋跃过防守队员，完成了一次引人注目的<w>精彩高空接球</w>。"
                            }
                        },
                        {
                            "text": "The crowd cheered wildly as he held on to an unbelievable <w>spec</w>.",
                            "target_lang_translations": {
                                "zh": "当他稳稳接住这一记令人难以置信的<w>精彩高空接球</w>时，全场观众爆发出热烈的欢呼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "specky"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australia"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "sports slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（澳式橄榄球俚语）精彩的高空接球（spectacular mark 的缩写）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "精彩高空接球",
                                "target_lang_sense_clarification": "澳式橄榄球中跃起腾空的精彩接球"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cd8853a7-a30c-3cae-8ceb-c099d56e17e3",
                    "sense_definition": "To specify, especially in a detailed or formal design document.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "specification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect will <w>spec</w> high-grade steel for the outer frame.",
                            "target_lang_translations": {
                                "zh": "建筑师将在规范中为外框<w>指定</w>使用高等级钢材。"
                            }
                        },
                        {
                            "text": "We need to clearly <w>spec</w> the software requirements before writing code.",
                            "target_lang_translations": {
                                "zh": "我们在写代码之前需要清晰地<w>明确要求</w>各项软件需求。"
                            }
                        }
                    ],
                    "synonyms": [
                        "specify",
                        "detail"
                    ],
                    "common_phrases": [
                        "spec out"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal technical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "详述；在技术或设计规范中明确指定或要求。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "明确要求",
                                "target_lang_sense_clarification": "在设计或方案中具体规定"
                            },
                            {
                                "target_lang_word": "指定",
                                "target_lang_sense_clarification": "选定具体的材质或技术参数"
                            },
                            {
                                "target_lang_word": "详述",
                                "target_lang_sense_clarification": "详细列明需求或规范"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7a26639a-f020-3202-b561-65a9f09bbce3",
                    "sense_definition": "Undertaken speculatively without a confirmed buyer or client; short for <w>speculative</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "speculation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to build a <w>spec</w> home in the new suburban development.",
                            "target_lang_translations": {
                                "zh": "他们决定在这个郊区新开发区建造一栋<w>投机性的</w>样板房待售。"
                            }
                        },
                        {
                            "text": "He submitted a <w>spec</w> script to several television production companies.",
                            "target_lang_translations": {
                                "zh": "他向几家电视制作公司提交了一份<w>自费预先制作的</w>剧本。"
                            }
                        }
                    ],
                    "synonyms": [
                        "speculative"
                    ],
                    "common_phrases": [
                        "spec house",
                        "spec script"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal industry term"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "“speculative”的缩写；（房屋、剧本等）投机性的、事先未确定买家或委约而制作的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "投机性的",
                                "target_lang_sense_clarification": "无预先订单或买家而建造或创作的"
                            },
                            {
                                "target_lang_word": "自费预先制作的",
                                "target_lang_sense_clarification": "未获预先签约而写成以供碰运气推销的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}