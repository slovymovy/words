    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "42c92fad-5e02-3306-91f7-9418c7c911f8",
                    "sense_definition": "Diriger attentivement une arme, un projectile ou son regard vers une cible déterminée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'archer prend son temps pour <w>viser</w> le centre de la cible."
                        },
                        {
                            "text": "Le tireur <w>visait</w> avec beaucoup de précision malgré le vent fort."
                        }
                    ],
                    "common_phrases": [
                        "viser le centre",
                        "viser juste"
                    ]
                },
                {
                    "sense_id": "3959060e-cc7b-30bc-acae-dbcdcc76bbc2",
                    "sense_definition": "Avoir pour objectif un résultat ou concerner directement une personne ou une situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle loi <w>vise</w> à réduire les émissions de gaz polluants."
                        },
                        {
                            "text": "La campagne publicitaire <w>visait</w> principalement les jeunes conducteurs."
                        }
                    ],
                    "common_phrases": [
                        "viser l'excellence",
                        "viser trop haut",
                        "viser à améliorer"
                    ]
                },
                {
                    "sense_id": "3580c963-e595-3d51-a687-1f1adb28990f",
                    "sense_definition": "Regarder attentivement ou jeter les yeux sur quelqu'un ou quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Vise</w> un peu cette voiture magnifique qui vient de passer dans la rue."
                        },
                        {
                            "text": "T'as <w>visé</w> la nouvelle voiture du voisin, garée juste devant chez nous ?"
                        }
                    ],
                    "synonyms": [
                        "regarder",
                        "piger"
                    ],
                    "common_phrases": [
                        "vise un peu",
                        "vise-moi ça"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier ou argotique"
                        }
                    ]
                },
                {
                    "sense_id": "cafcfbfb-2951-3ad3-8a2f-16aec0561252",
                    "sense_definition": "Examiner et valider un acte officiel, un document ou un passeport en y apposant une signature ou un visa.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "administratif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fonctionnaire doit <w>viser</w> votre passeport avant de vous laisser entrer."
                        },
                        {
                            "text": "Le directeur a refusé de <w>viser</w> ce rapport sans vérification préalable."
                        }
                    ],
                    "common_phrases": [
                        "faire viser un passeport",
                        "viser et signer"
                    ]
                }
            ]
        }
    ]
