                                        "glosses": [
                                            "Parte de la física que estudia del origen y evolución del universo."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73072bc1-7266-4e51-8310-f002f5728c9e",
                        "source_entry_id": "2546c57e-d632-3e53-87db-b386100cc89c",
                        "target_lang_word": "cosmologia",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cosmologia",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "12788b1e-3305-3d5c-bdb1-d31686a3e2b3",
                                        "entry_id": "262c4c16-4a4d-3896-9cc2-582d4f7b730d",
                                        "glosses": [
                                            "definizione mancante; se vuoi, aggiungila tu"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b22e6210-56b2-38ec-919a-bf3d3d072720",
                                        "entry_id": "262c4c16-4a4d-3896-9cc2-582d4f7b730d",
                                        "glosses": [
                                            "scienza che tenta di spiegare l'origine e l'evoluzione dell'universo"
                                        ],
                                        "tags": [],
