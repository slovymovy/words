                "senses": [
                    {
                        "sense_id": "e9809185-e7dc-3b9c-8f10-d9721e63e4d2",
                        "entry_id": "1cf7abcf-7b8f-39c4-8a74-0fca6822aba7",
                        "glosses": [
                            "Gesamtheit aller (organisatorischen) Regelungen, Bestimmungen und Vorgänge im Rahmen der Bildung an Mittelschulen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5776136-7911-46fa-8fec-e19ecbf4ff0c",
                                "sense_id": "e9809185-e7dc-3b9c-8f10-d9721e63e4d2",
                                "text": "„Das Mittelschulsystem ist differenzierter und bietet den Jugendlichen in Holland mehr Übergangsmöglichkeiten als in der BRD.“"
                            },
                            {
                                "example_id": "2c6177e6-013b-4dc9-b50b-b41320c95c40",
                                "sense_id": "e9809185-e7dc-3b9c-8f10-d9721e63e4d2",
                                "text": "„Bis 1971 bestand das Mittelschulsystem aus mehreren, bei allen vorgesehenen Übergangsmöglichkeiten selbständig in sich ruhenden Zweigen, die das neue Bildungsgesetz nun zu einer Einheit zu verschmelzen sucht.“"
                            },
                            {
                                "example_id": "11c5e6b0-3b14-4acd-ad6e-c2561804321c",
                                "sense_id": "e9809185-e7dc-3b9c-8f10-d9721e63e4d2",
                                "text": "„Das Mittelschulsystem war nach dem Gang des Lateinunterrichtes aufgebaut und enthielt gewöhnlich auch die niedrigere Bildung.“"
                            },
                            {
                                "example_id": "00cee2d2-74ed-4842-b9ba-6ca81a470f59",
                                "sense_id": "e9809185-e7dc-3b9c-8f10-d9721e63e4d2",
                                "text": "„Güll, seit 2008 Landtagsabgeordneter der SPD, ist seit jeher ein Kritiker des neuen Mittelschulsystems.“"
                            },
                            {
                                "example_id": "eea344e0-9f60-4c05-a915-4d12b8fa55d4",
                                "sense_id": "e9809185-e7dc-3b9c-8f10-d9721e63e4d2",
                                "text": "„Gegenwärtig bestehen in der USSR zwei Mittelschulsysteme und zwar mit getrenntem und gemeinsamem Schulbesuch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
