                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd0f82ce-c7ea-4b99-86bb-1e281ce0f7d5",
                        "source_entry_id": "e8dcac06-2862-3bee-b487-45c86768ca3b",
                        "source_sense_id": "59d5ed13-b5a4-3649-b11e-6f144358090d",
                        "target_lang_word": "калужница",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "калужница",
