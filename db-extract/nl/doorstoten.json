                "translations": [
                    {
                        "translation_id": "67635647-e07b-4899-9994-970c1bc3ec9c",
                        "source_entry_id": "69a165ff-4e6e-3308-941d-bc388da1d393",
                        "source_sense_id": "506f8401-b903-32d9-9e3e-d4601c107759",
                        "target_lang_word": "penetrate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "penetrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "410aa55f-30f7-3192-a57c-104cd762aeaa",
                                        "entry_id": "6093bab4-13a4-3a43-bb53-5ba8f292516f",
                                        "glosses": [
                                            "To enter into; to make way into the interior of; to pierce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef43af23-90d0-430d-8125-2678c8a15047",
                                                "sense_id": "410aa55f-30f7-3192-a57c-104cd762aeaa",
                                                "text": "Light penetrates darkness."
                                            },
                                            {
                                                "example_id": "295c97b3-b8cc-4c9f-9ae3-fedf0292a094",
                                                "sense_id": "410aa55f-30f7-3192-a57c-104cd762aeaa",
                                                "text": "He takes the prepared charcoal used by artists, brings it to a white heat, and suddenly plunges it in a bath of mercury, of which the globules instantly penetrate the pores of charcoal, and may be said to metallize it."
                                            },
                                            {
                                                "example_id": "fe0a1c03-e5c8-45c2-8353-db22c770fa69",
                                                "sense_id": "410aa55f-30f7-3192-a57c-104cd762aeaa",
                                                "text": "Considerable interest has developed within the defense community during recent years in weapons that are capable of penetrating some distance into the earth before detonating. […] To be generally effective, earth penetrating weapons (EPW) must be capable of penetrating various geologic targets, ranging from soil to rock, without producing critical damage to the payload."
                                            },
                                            {
                                                "example_id": "ed34899a-5672-4692-a196-2e9517e37c93",
                                                "sense_id": "410aa55f-30f7-3192-a57c-104cd762aeaa",
                                                "text": "and they, ... they .... fly though space, and they penetrate the atmosphere[…]after an amazing nine-month journey"
                                            },
                                            {
                                                "example_id": "870d95d6-e0a1-43b6-a892-a04e5e09fbfd",
                                                "sense_id": "410aa55f-30f7-3192-a57c-104cd762aeaa",
                                                "text": "Our results also identified the causative mutation of polydactylous Silkie was not exist in other nonpolydactyly chickens, suggesting that SNP of polydactyly in Silkie has fully penetrated all other indigenous Chinese chicken breeds."
                                            },
                                            {
                                                "example_id": "a4362efe-50f8-477f-9667-636915a8ae28",
                                                "sense_id": "410aa55f-30f7-3192-a57c-104cd762aeaa",
                                                "text": "Fire ants circumvented the problem of an ineffective sting by having an unusual and highly effective venom that when daubed or sprayed on other ants penetrates their waxy protective integumental barrier and kills or disables them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b44427c0-a261-3741-935a-fec87d47d044",
                                        "entry_id": "6093bab4-13a4-3a43-bb53-5ba8f292516f",
                                        "glosses": [
                                            "To achieve understanding of, despite some obstacle; to comprehend; to understand."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a85791a7-59e9-43e5-808f-3db4c7115cf0",
                                                "sense_id": "b44427c0-a261-3741-935a-fec87d47d044",
                                                "text": "I could not penetrate Burke's opaque rhetoric."
                                            },
                                            {
                                                "example_id": "fe7244f0-0ace-4ce9-981f-34ccc5efbd63",
                                                "sense_id": "b44427c0-a261-3741-935a-fec87d47d044",
                                                "text": "things which here were […]too subtile for us to penetrate"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e89e07cf-56ca-360c-a69c-0e045ffce396",
                                        "entry_id": "6093bab4-13a4-3a43-bb53-5ba8f292516f",
                                        "glosses": [
                                            "To affect profoundly through the senses or feelings; to move deeply."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "247c8059-8642-4385-b2b8-31fcf8bdb511",
                                                "sense_id": "e89e07cf-56ca-360c-a69c-0e045ffce396",
                                                "text": "The translator of Homer should penetrate himself with a sense of the plainness and directness of Homer's style."
                                            },
                                            {
                                                "example_id": "14c5b564-7852-4ef8-b0b2-d7c3038e1aa3",
                                                "sense_id": "e89e07cf-56ca-360c-a69c-0e045ffce396",
                                                "text": "to penetrate one's heart with pity"
                                            },
                                            {
                                                "example_id": "afb2cb8d-ba61-4a08-92bc-02f7c4f7e4b1",
                                                "sense_id": "e89e07cf-56ca-360c-a69c-0e045ffce396",
                                                "text": "I am advised to give her music o' mornings; they say it will penetrate"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "925ad562-b157-3ff2-b89d-367a9efe0785",
                                        "entry_id": "6093bab4-13a4-3a43-bb53-5ba8f292516f",
                                        "glosses": [
                                            "To infiltrate an enemy to gather intelligence."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be406c2d-8626-3333-af7b-6f473bce7d35",
                                        "entry_id": "6093bab4-13a4-3a43-bb53-5ba8f292516f",
                                        "glosses": [
                                            "To insert the penis into an orifice, such as a vagina, mouth, or anus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d16ebed-988f-4974-81bb-ac542ed0035b",
                                                "sense_id": "be406c2d-8626-3333-af7b-6f473bce7d35",
                                                "text": "a male elephant comes up and penetrates the female"
                                            },
                                            {
                                                "example_id": "9c8d49e1-655c-4f4d-a801-92e17b911391",
                                                "sense_id": "be406c2d-8626-3333-af7b-6f473bce7d35",
                                                "text": "His weapons have been destroyed; his body has been or can be penetrated. In other words, he is rapable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b943190-f091-3f1a-9104-f72aa2da30d5",
                                        "entry_id": "6093bab4-13a4-3a43-bb53-5ba8f292516f",
                                        "glosses": [
                                            "To move a piece past the defending pieces of one's opponent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
