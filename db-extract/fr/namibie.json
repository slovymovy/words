                                                "sense_id": "046ab31d-a54c-396c-aeb5-a5b822f2b6f5",
                                                "text": "Der Asteroid Namibia nähert sich der Erde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
