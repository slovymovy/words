                "senses": [
                    {
                        "sense_id": "0a18d97d-47c2-3817-9c79-d9b00258a717",
                        "entry_id": "1b24b979-1963-3ad6-8923-021be494b17c",
                        "glosses": [
                            "Relatif aux steppes, à la savane, aux prairies semidésertiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd2a8d36-3388-4faf-b523-6dd92aa3ea88",
                                "sense_id": "0a18d97d-47c2-3817-9c79-d9b00258a717",
                                "text": "L’étage alpin des hautes montagnes présente des formes steppiques à Graminées à l’Ouest et à Armoises et Astragales à l’Est."
                            },
                            {
                                "example_id": "59ce9006-4c66-41b4-9872-dc5c7953e470",
                                "sense_id": "0a18d97d-47c2-3817-9c79-d9b00258a717",
                                "text": "Le régime xérique de la côte se prolonge sur le versant occidental des Andes moyennes, où s’étend une végétation plus ou moins steppique, qui peut être parsemée d’arbustes ou de petits arbres, ou de Cactacées céréiformes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49778c86-cf28-4ad1-ba59-87d904fc8f91",
                        "source_entry_id": "1b24b979-1963-3ad6-8923-021be494b17c",
                        "source_sense_id": "0a18d97d-47c2-3817-9c79-d9b00258a717",
                        "target_lang_word": "steppic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "steppic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1248a87e-a67b-36d2-b2d0-117985d9d6f1",
                                        "entry_id": "77307fa5-f39a-3f29-8222-075abad69b79",
                                        "glosses": [
                                            "Pertaining to a steppe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f16d9fc-2a6b-46ac-a4d2-ebb1b7a622b7",
                                                "sense_id": "1248a87e-a67b-36d2-b2d0-117985d9d6f1",
                                                "text": "Of the steppic goat (the Antilope Saiga of Pallas) which is accustomed to spend its winter in the southern parts on Lake Aral, I saw numerous herds returning with the warmer season to the Northern Steppe, where, both for their skin and flesh, they become valuable objects of the chace to the Cossacks."
                                            },
                                            {
                                                "example_id": "35c6ad22-84b9-4077-a0cc-0c1428a66163",
                                                "sense_id": "1248a87e-a67b-36d2-b2d0-117985d9d6f1",
                                                "text": "The groups include a steppic, a Mediterranean / temperate forest, and a montane group for larger herbivores; a rabbit group (as they are the most numerous of the fauna and possibly the most local to the rocky cliffs and sandy foreshore in the immediate vicinity of the site); and a carnivore group (to assess the potential for non-human carnivores being responsible for the assemblage)."
                                            },
                                            {
                                                "example_id": "da82d5c3-4d01-45d1-964f-8197b0b45a53",
                                                "sense_id": "1248a87e-a67b-36d2-b2d0-117985d9d6f1",
                                                "text": "The steppic corridor opened the way to and from Inner Asia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23af1405-8c9b-4969-96a6-dd45a607d845",
                        "source_entry_id": "1b24b979-1963-3ad6-8923-021be494b17c",
