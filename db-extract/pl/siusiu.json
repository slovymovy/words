                                        "sense_id": "c27911a4-ec77-36d0-b089-44b7a94d11a6",
                                        "entry_id": "fa016188-09fc-3d4d-b12c-38426b115a3c",
                                        "glosses": [
                                            "An effeminate boy or man."
                                        ],
