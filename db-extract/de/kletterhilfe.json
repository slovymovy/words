                            {
                                "example_id": "13e1db77-74c0-4ca1-8a86-2821b8554849",
                                "sense_id": "c1fcfcb5-6a02-3583-bca4-74122186a2e7",
                                "text": "Es gibt künstliche Wände mit Kletterhilfen."
                            },
                            {
                                "example_id": "8c361537-648b-47ef-9431-3376a03217b8",
                                "sense_id": "c1fcfcb5-6a02-3583-bca4-74122186a2e7",
                                "text": "Gleich hinter dem Eingang verleiht ein wettergegerbter Signore archaisch geschnitzte Stöcke. 50 Cent das Stück. Das \"No, grazie\" hat man schnell bereut, denn so ganz ohne Kletterhilfe wird der Aufstieg schnell zur Tortur."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4195b7d0-71f2-3e21-bf81-3256d7dc2aa5",
                        "entry_id": "774cf85c-3e4f-330f-aaaf-e4da46453f24",
                        "glosses": [
                            "eine Art Gerüst, das Kletterpflanzen hilft sich an einer glatten Flächen hinaufzuwachsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61e522f6-6a75-490d-bf29-1a3e6b50fcb2",
                                "sense_id": "4195b7d0-71f2-3e21-bf81-3256d7dc2aa5",
                                "text": "Wenn der Efeu nicht am Putz haften kann, sollte man ihn mit einer Kletterhilfe unterstützen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
