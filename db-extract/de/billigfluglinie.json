                        "glosses": [
                            "Fluglinie, die ihre Flüge zu sehr niedrigen Preisen anbietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af3c8873-c59f-4871-ab02-59e5732976cd",
                                "sense_id": "c7ee9268-2e5b-34d1-b798-97a894232896",
                                "text": "Seit drei Jahren fliegen wir mit einer Billigfluglinie nach Mallorca."
                            },
                            {
                                "example_id": "ff9afc6f-12b3-4548-8b15-5e95b38a2b24",
                                "sense_id": "c7ee9268-2e5b-34d1-b798-97a894232896",
                                "text": "„In zwei Jahren solle die Wiener Basis auf 14 bis 15 Mittelstrecken-Flieger und in fünf Jahren auf 30 Jets wachsen, sagte IAG-Chef Willie Walsh am Dienstag zum Start der neuen Billigfluglinie mit zunächst vier Flugzeugen.“"
                            }
                        ],
