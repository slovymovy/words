                    "frequency": "Low",
                    "semantic_group_id": "human_father",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young prince took up the sword left behind by his noble <w>sire</w>."
                        },
                        {
                            "text": "He hoped to bring honor to the long line of his venerable <w>sires</w>."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary use for father or forefather"
                        }
                    ]
                },
                {
                    "sense_id": "df2fc027-0f98-37f7-a947-3fa28840d6a8",
                    "sense_definition": "A creator, originator, or maker of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet was honored as the true <w>sire</w> of modern lyrical drama."
                        },
                        {
                            "text": "Scholars still debate which ancient philosopher was the <w>sire</w> of this school of thought."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "figurative or literary usage"
                        }
                    ]
                },
                {
                    "sense_id": "1002bb89-fcfb-32ac-906c-4fad926b4f09",
                    "sense_definition": "In fantasy fiction, the vampire who has created another vampire by transforming them.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vampire_creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fledgling vampire was bound to obey every command given by his <w>sire</w>."
                        },
                        {
                            "text": "She vowed revenge against the cruel <w>sire</w> who had cursed her with immortality."
                        }
                    ]
                }
            ]
        },
        {
