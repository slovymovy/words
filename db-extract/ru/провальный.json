                                ]
                            },
                            {
                                "target_word": "manqué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95fd3305-4813-3d92-92fc-b455a9f6a8b0",
                                        "entry_id": "52e15b44-9854-307d-884c-a13db14a4421",
                                        "glosses": [
                                            "Participe passé masculin singulier de manquer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ef611ae-e15c-4bcf-9150-bbe94f1ee230",
                                                "sense_id": "95fd3305-4813-3d92-92fc-b455a9f6a8b0",
                                                "text": "Pour mon compte, je n'ai pas manqué une occasion de dénoncer au bon sens public ces escroqueurs de renommée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11dd61be-d09d-37db-b729-daaf49ccc9e0",
                                        "entry_id": "52e15b44-9854-307d-884c-a13db14a4421",
                                        "glosses": [
                                            "Présent à la première personne du singulier de manquer lors d’une inversion interrogative."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09ccf263-fe5d-4bc7-aaaa-8a13c233e983",
                                                "sense_id": "11dd61be-d09d-37db-b729-daaf49ccc9e0",
                                                "text": "Hélas! peut-être manqué-je de caractère, j’eusse été un mauvais soldat de Napoléon."
                                            }
                                        ]
