                                "sense_id": "1cbe87a7-845c-3c14-8247-b1478690db38",
                                "text": "Toute loi est abrogeable par le pouvoir qui l’a créée."
                            },
                            {
                                "example_id": "3145f393-e324-46d2-a846-45408f623d82",
                                "sense_id": "1cbe87a7-845c-3c14-8247-b1478690db38",
                                "text": "La loy du Souverain est donc inabrogeable par un tiers et abrogeable par le seul Souverain."
                            },
                            {
                                "example_id": "aa89a91b-453e-4164-95a0-f254bb2577fc",
                                "sense_id": "1cbe87a7-845c-3c14-8247-b1478690db38",
                                "text": "Le décret n’était pas abrogeable, mais on l’a fait quand même."
                            }
                        ]
