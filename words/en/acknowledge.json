{
    "word_family": [
        "acknowledgement",
        "acknowledgment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2c8b09c4-fcea-3b0a-b665-26c3f9c54944",
                    "sense_definition": "To accept or admit that something is true, exists, or is a fact.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "recognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She refused to <w>acknowledge</w> her mistake during the team meeting.",
                            "target_lang_translations": {
                                "de": "Sie weigerte sich, ihren Fehler während des Teammeetings <w>zuzugeben</w>."
                            }
                        },
                        {
                            "text": "It is generally <w>acknowledged</w> that a balanced diet improves health.",
                            "target_lang_translations": {
                                "de": "Es ist allgemein <w>anerkannt</w>, dass eine ausgewogene Ernährung die Gesundheit verbessert."
                            }
                        }
                    ],
                    "synonyms": [
                        "admit",
                        "concede",
                        "recognize",
                        "allow",
                        "confess",
                        "own"
                    ],
                    "antonyms": [
                        "deny"
                    ],
                    "common_phrases": [
                        "acknowledge a mistake",
                        "acknowledge the truth",
                        "generally acknowledged"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas als wahr, existierend oder als Tatsache akzeptieren oder zugeben."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zugeben",
                                "target_lang_sense_clarification": "etwas als wahr oder zutreffend einräumen"
                            },
                            {
                                "target_lang_word": "anerkennen",
                                "target_lang_sense_clarification": "einen Umstand als sachlich richtig akzeptieren"
                            },
                            {
                                "target_lang_word": "bekennen",
                                "target_lang_sense_clarification": "etwas offen zugeben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f2d3b55-9d85-38c1-91a0-d613e82ce554",
                    "sense_definition": "To report or confirm that one has received something, such as a message or letter.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>acknowledge</w> receipt of this email as soon as possible.",
                            "target_lang_translations": {
                                "de": "Bitte <w>bestätigen</w> Sie den Erhalt dieser E-Mail so bald wie möglich."
                            }
                        },
                        {
                            "text": "The office sent a formal letter to <w>acknowledge</w> my application.",
                            "target_lang_translations": {
                                "de": "Das Büro schickte einen formellen Brief, um den Eingang meiner Bewerbung zu <w>bestätigen</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "acknowledge receipt"
                    ],
                    "target_lang_definitions": {
                        "de": "Den Erhalt von etwas, wie einer Nachricht oder eines Briefes, melden oder bestätigen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "den Empfang bestätigen",
                                "target_lang_sense_clarification": "formelle Bestätigung des Eingangs"
                            },
                            {
                                "target_lang_word": "bestätigen",
                                "target_lang_sense_clarification": "den Eingang rückmelden"
                            },
                            {
                                "target_lang_word": "quittieren",
                                "target_lang_sense_clarification": "den Erhalt offiziell bestätigen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d72a8e8-6616-3dc3-9d80-97a97b4f14bb",
                    "sense_definition": "To recognize the status, authority, or rights of someone or something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "recognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government refused to <w>acknowledge</w> the new leader of the rebellion.",
                            "target_lang_translations": {
                                "de": "Die Regierung weigerte sich, den neuen Anführer der Rebellion <w>anzuerkennen</w>."
                            }
                        },
                        {
                            "text": "He is widely <w>acknowledged</w> as the best player in the history of the sport.",
                            "target_lang_translations": {
                                "de": "Er wird weithin als der beste Spieler in der Geschichte des Sports <w>anerkannt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "recognize"
                    ],
                    "common_phrases": [
                        "acknowledge as",
                        "acknowledge authority"
                    ],
                    "target_lang_definitions": {
                        "de": "Den Status, die Autorität oder die Rechte von jemandem oder etwas anerkennen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "anerkennen",
                                "target_lang_sense_clarification": "Status oder Autorität offiziell akzeptieren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f424bd6-0634-33e6-9d15-280c434a601a",
                    "sense_definition": "To express gratitude or thanks for a benefit, favor, or service.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "recognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author <w>acknowledged</w> the help of his editor in the book's preface.",
                            "target_lang_translations": {
                                "de": "Der Autor <w>würdigte</w> die Hilfe seines Lektors im Vorwort des Buches."
                            }
                        },
                        {
                            "text": "We must <w>acknowledge</w> their generous contribution to the charity project.",
                            "target_lang_translations": {
                                "de": "Wir müssen ihren großzügigen Beitrag zum Wohltätigkeitsprojekt <w>würdigen</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "acknowledge a favor",
                        "acknowledge support"
                    ],
                    "target_lang_definitions": {
                        "de": "Dankbarkeit oder Anerkennung für einen Vorteil, einen Gefallen oder eine Dienstleistung ausdrücken."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "würdigen",
                                "target_lang_sense_clarification": "jemandes Leistung öffentlich wertschätzen"
                            },
                            {
                                "target_lang_word": "anerkennen",
                                "target_lang_sense_clarification": "Leistung oder Beitrag wertschätzen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c27f5eb0-3be0-37c5-adeb-c408f72521f6",
                    "sense_definition": "To confirm the validity of a legal document or act formally.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "recognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The notary asked the witness to <w>acknowledge</w> the signature on the deed.",
                            "target_lang_translations": {
                                "de": "Der Notar bat den Zeugen, die Unterschrift auf der Urkunde zu <w>bestätigen</w>."
                            }
                        },
                        {
                            "text": "He had to <w>acknowledge</w> the legal instrument before it could be filed.",
                            "target_lang_translations": {
                                "de": "Er musste das Rechtsdokument <w>bestätigen</w>, bevor es eingereicht werden konnte."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Die Gültigkeit eines Rechtsdokuments oder einer Handlung formell bestätigen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "bestätigen",
                                "target_lang_sense_clarification": "einen Sachverhalt oder eine Handlung rechtlich erhärten"
                            },
                            {
                                "target_lang_word": "bescheinigen",
                                "target_lang_sense_clarification": "etwas schriftlich bestätigen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}