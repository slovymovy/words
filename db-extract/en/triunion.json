                            {
                                "example_id": "040e4def-cb1f-490a-9de4-c91ab8d3d8c4",
                                "sense_id": "f9c5e754-aa0f-3b31-9f90-ae3beec8d365",
                                "text": "Their government was a triunion of ecclesiastical, civil, and military power, yet all were under the supervision of their king, who reigned by virtue of the holy priesthood; […]"
                            },
                            {
                                "example_id": "6c7c1f08-0429-48a0-810c-7ee738aa4245",
                                "sense_id": "f9c5e754-aa0f-3b31-9f90-ae3beec8d365",
                                "text": "There is a triunion of action in the three prophecies, when examined in detail, side by side, so wonderfully developing an event, the like of which the world never witnessed before, and never can witness again […]"
                            }
                        ]
