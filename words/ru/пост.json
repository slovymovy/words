            "pos": "noun",
            "senses": [
                {
                    "sense_id": "03c0918a-0c67-3130-ab37-6ca98210f992",
                    "sense_definition": "Место, порученное часовому или отряду для охраны и наблюдения, а также само исполнение обязанностей по охране.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "guard_duty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Солдат стоял на <посту> и внимательно смотрел по сторонам.",
                            "target_lang_translations": {
                                "en": "The soldier stood at his <post> and looked carefully around.",
                                "zh": "士兵站在<w>岗哨</w>上，警惕地环顾四周。"
                            }
                        },
                        {
                            "text": "Полицейский <пост> находится на выезде из города.",
                            "target_lang_translations": {
                                "en": "A police <post> is located at the exit from the city.",
                                "zh": "警察<w>哨所</w>位于城外的出口处。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "стоять на посту",
                        "покинуть пост",
                        "смена постов"
                    ],
                    "target_lang_definitions": {
                        "en": "A location assigned to a sentry or unit for guarding and observation, as well as the actual performance of guard duties.",
                        "zh": "分配给哨兵或部队用于警戒、守卫和观察的地点，也指执行警戒职责本身。"
                    },
                    "translations": {
