                "senses": [
                    {
                        "sense_id": "b0ec1532-62c1-317d-b315-776d577b37ab",
                        "entry_id": "567cf4cf-1ffb-3108-adc2-145bc67ae466",
                        "glosses": [
                            "zichtbaar, iets of iemand kunnen herkennen, waarneembaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6ecb488-7f8c-4010-aeee-e1c5f2d0d550",
                                "sense_id": "b0ec1532-62c1-317d-b315-776d577b37ab",
                                "text": "Dat heb ik vaker meegemaakt, het is een herkenbare situatie."
                            },
                            {
                                "example_id": "2f7127c9-fcda-4ed9-a456-6d2e72bd2737",
                                "sense_id": "b0ec1532-62c1-317d-b315-776d577b37ab",
                                "text": "Zijn grote mond, iets te harde stem, irritante enthousiasme en overdreven positiviteit waren herkenbaar maar ook zijn ongepolijste bravoure, idealisme en romantische dromen om de wereld te verbeteren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e45a9f88-91b9-4b27-ad7c-b4949323870c",
                        "source_entry_id": "567cf4cf-1ffb-3108-adc2-145bc67ae466",
                        "source_sense_id": "b0ec1532-62c1-317d-b315-776d577b37ab",
                        "target_lang_word": "recognizable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recognizable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52d95c42-068e-3929-a95f-49f9eabd0f3e",
                                        "entry_id": "1e6880a3-581b-356e-ada8-6d61f5ec6a19",
                                        "glosses": [
                                            "Able to be recognized."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c175269-6089-4442-b25b-6110a220e52d",
                                                "sense_id": "52d95c42-068e-3929-a95f-49f9eabd0f3e",
                                                "text": "Pidgin is a combination of expressions and phrases that are recognizable to those who speak it. To non-Pidgin speakers, it may sound like slang. For example, “dat” means that and “fadda” means father or dad."
                                            },
                                            {
                                                "example_id": "4ed6fdad-ca3b-4060-ac5c-44b0c944e2c6",
                                                "sense_id": "52d95c42-068e-3929-a95f-49f9eabd0f3e",
                                                "text": "This variation is strikingly similar to the Work’s so-called “ballooned droplet” within the circle. The figure in the Work is slightly more bulbous, but it is instantly recognizable as a quotation mark."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
