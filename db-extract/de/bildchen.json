                ],
                "senses": [
                    {
                        "sense_id": "8b85f576-6735-3ea0-b0a7-604c1115c414",
                        "entry_id": "6138ac6b-3e41-3791-878e-bb924c4a5caa",
                        "glosses": [
                            "kleines Bild"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e8b4c17-83d3-4ddb-97fd-b3a174aa33c6",
                                "sense_id": "8b85f576-6735-3ea0-b0a7-604c1115c414",
                                "text": "Ich habe immer ein Bildchen meiner Frau im Portmonee."
                            },
                            {
                                "example_id": "6106533a-1f32-4b6d-8011-d4fbd222d688",
                                "sense_id": "8b85f576-6735-3ea0-b0a7-604c1115c414",
                                "text": "„Der Bruder wollte das Bildchen an sich nehmen, aber sie hielt ihn noch zurück.“"
                            },
                            {
                                "example_id": "6998431a-fded-4567-be31-ed5e81839ae3",
                                "sense_id": "8b85f576-6735-3ea0-b0a7-604c1115c414",
                                "text": "„Um die Bilderchen und ihre Goldborte herum hingen zwei dicke Immortellenkränze mit schwarzen und weißen Schleifen daran, während auf dem kleinen, niedrigen Ofen eine Vase mit Zittergras stand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
