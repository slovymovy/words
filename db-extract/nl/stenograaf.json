                        "cross_references": [
                            {
                                "target_word": "Stenograf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f97e4c46-da89-36da-8e67-e0b79f6c6522",
                                        "entry_id": "5e6e5d88-49fd-3831-9e5e-676dd6564331",
                                        "glosses": [
                                            "Person, die die Stenografie, die Kurzschrift beherrscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53427f5c-12d5-40c6-998f-e4d2cd3512be",
                                                "sense_id": "f97e4c46-da89-36da-8e67-e0b79f6c6522",
                                                "text": "„Randbegebenheiten wie die des Stenografen Vinzenz Koppert illustrieren, wie aberwitzig der Sprung der Deutschen aus der Nazidiktatur ins demokratische Deutschland anmutet. Koppert hatte 1944 den Prozess gegen die Mitglieder des Widerstands protokolliert, mitsamt der Todesurteile. Vier Jahre später wurde er Chef-Stenograf im Parlamentarischen Rat – und protokollierte die Abschaffung der Todesstrafe.“"
                                            },
                                            {
                                                "example_id": "2808f3f7-4fa1-4483-8247-5f2bd1e5c0b1",
                                                "sense_id": "f97e4c46-da89-36da-8e67-e0b79f6c6522",
                                                "text": "„Ausgehend von der Zahl der in Statistiken erfassten Lehrgangsteilnehmer kann geschätzt werden, dass sich an der Wende zum 20. Jahrhundert etwa vier Millionen systemkundige Stenografen der Gabelsbergerschen Kurzschrift bedienten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75d101d0-3575-4b51-8427-02523141c716",
                        "source_entry_id": "0129fe30-3a0b-3c2a-a44d-72b6ecb7c2e8",
                        "source_sense_id": "7bd8681b-ddb1-3582-9f0a-721a89459220",
                        "source_sense_description": "iemand die stenografische verslagen maakt",
                        "target_lang_word": "Stenograph",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stenograph",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df2c2c34-2067-366b-943d-4726891aefa4",
                                        "entry_id": "119c85e3-1ee5-3c8c-837c-13f76ba71252",
                                        "glosses": [
                                            "Person, die die Stenographie, die Kurzschrift beherrscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cdce5bd-1d12-4604-821d-b97070bf06a3",
                                                "sense_id": "df2c2c34-2067-366b-943d-4726891aefa4",
                                                "text": "„Wer selbst nicht Stenographie schreiben kann und nur beobachtet, mit welcher Mühelosigkeit ein Stenograph gesprochene Sprache aufzeichnet, wo er selbst hoffnungslos auf der Strecke bleiben würde, mag sich fragen, weshalb die Stenographie nicht unser allgemeines Schriftsystem ist, wo sie doch offenkundig so viel schneller und ökonomischer ist.“"
                                            },
                                            {
                                                "example_id": "0ecda2dc-bc2c-4e18-afaa-e59f37267018",
                                                "sense_id": "df2c2c34-2067-366b-943d-4726891aefa4",
                                                "text": "„Die Nachtreporter, leicht beschwipst, wie immer um diese Zeit, sahen dem aufnehmenden Stenographen gierig über die Schulter, die Setzer rissen ihm jedes Blatt sofort aus der Hand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
