                                        "examples": [
                                            {
                                                "example_id": "a322add8-fddd-48a4-949e-866cab1e6f98",
                                                "sense_id": "6912b9fd-a94d-388d-bffb-0e458f98367a",
                                                "text": "In a statement on its website, Southern Poverty Law Center President Richard Cohen defended the designation."
                                            }
                                        ]
                                    },
