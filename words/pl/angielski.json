                                "ru": "На завтрак я часто ем <английскую> яичницу с беконом.",
                                "en": "For breakfast, I often eat <English> scrambled eggs with bacon.",
                                "nl": "Als ontbijt eet ik vaak een <Engels> ontbijt met roerei en spek.",
                                "de": "Zum Frühstück esse ich oft <englisches> Rührei mit Speck.",
                                "fr": "Pour le petit-déjeuner, je mange souvent des œufs brouillés à l'<anglaise> avec du bacon.",
                                "it": "A colazione mangio spesso le uova strapazzate <all'inglese> con pancetta.",
                                "cs": "K snídani často jím <anglická> vajíčka se slaninou.",
                                "tr": "Kahvaltıda sık sık <İngiliz> usulü pastırmalı yumurta yerim.",
                                "es": "Para desayunar suelo comer huevos revueltos al estilo <inglés> con beicon.",
                                "zh": "我早餐经常吃<w>英式</w>培根炒蛋。"
                            }
                        }
