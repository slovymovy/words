{
    "word_family": [
        "revendication",
        "revendicatif",
        "revendicateur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f8af621a-33f0-3f66-bbe7-e04857ea334a",
                    "sense_definition": "Réclamer avec insistance un droit, un avantage ou une amélioration sociale.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "protestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les salariés en grève <w>revendiquent</w> une hausse de salaire immédiate pour faire face à l'inflation."
                        },
                        {
                            "text": "Les manifestants sont descendus dans la rue pour <w>revendiquer</w> des droits fondamentaux."
                        }
                    ],
                    "synonyms": [
                        "réclamer",
                        "exiger"
                    ],
                    "antonyms": [
                        "renoncer",
                        "céder"
                    ],
                    "common_phrases": [
                        "revendiquer des droits",
                        "revendiquer une hausse de salaire"
                    ]
                },
                {
                    "sense_id": "3f69a1ff-3989-3db1-82cc-6afdff305763",
                    "sense_definition": "Réclamer la propriété, la possession ou le contrôle légitime d'un bien ou d'un territoire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux pays continuent de <w>revendiquer</w> ce territoire frontalier depuis plusieurs décennies."
                        },
                        {
                            "text": "La famille tente de <w>revendiquer</w> la propriété de ce domaine foncier ancien devant la justice."
                        }
                    ],
                    "synonyms": [
                        "réclamer"
                    ],
                    "antonyms": [
                        "abandonner"
                    ],
                    "common_phrases": [
                        "revendiquer la propriété",
                        "revendiquer un territoire"
                    ]
                },
                {
                    "sense_id": "57a59786-b02d-3b4c-b0e2-8f047e4f58d8",
                    "sense_definition": "Déclarer formellement être l'auteur d'un acte, d'une œuvre ou d'une action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "auteur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une organisation clandestine a rapidement <w>revendiqué</w> l'attentat perpétré dans la capitale hier soir."
                        },
                        {
                            "text": "Cet écrivain discret refuse toujours de <w>revendiquer</w> la paternité de ce roman célèbre."
                        }
                    ],
                    "synonyms": [
                        "s'attribuer"
                    ],
                    "antonyms": [
                        "nier",
                        "désavouer"
                    ],
                    "common_phrases": [
                        "revendiquer un attentat",
                        "revendiquer la paternité"
                    ]
                },
                {
                    "sense_id": "d95b3042-4148-356d-b6fc-76e54e2a3505",
                    "sense_definition": "Assumer pleinement et afficher sans réserve une responsabilité, un choix ou une identité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "assumer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle refuse de se conformer aux attentes sociales et <w>revendique</w> ses choix personnels sans hésitation."
                        },
                        {
                            "text": "Cet artiste novateur <w>revendique</w> son originalité malgré les critiques négatives de la presse."
                        }
                    ],
                    "synonyms": [
                        "assumer"
                    ],
                    "antonyms": [
                        "renier"
                    ],
                    "common_phrases": [
                        "revendiquer ses choix",
                        "revendiquer son originalité"
                    ]
                },
                {
                    "sense_id": "23988d97-2eca-3d4a-b548-7ced1dc52d0f",
                    "sense_definition": "Demander à instruire ou à juger une affaire relevant de sa compétence juridique.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal de commerce a <w>revendiqué</w> cette affaire, estimant qu'elle relevait de sa compétence."
                        },
                        {
                            "text": "Les juridictions ecclésiastiques <w>revendiquaient</w> autrefois le jugement des clercs accusés de crimes."
                        }
                    ],
                    "synonyms": [
                        "réclamer"
                    ],
                    "antonyms": [
                        "décliner"
                    ],
                    "common_phrases": [
                        "revendiquer une affaire",
                        "revendiquer une cause"
                    ]
                }
            ]
        }
    ]
}