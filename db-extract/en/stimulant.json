                    }
                ],
                "senses": [
                    {
                        "sense_id": "4ff41ac6-8ff1-3dc6-bb4d-d5781029861f",
                        "entry_id": "2c489ed4-8a4d-31ec-8870-68ee03a38f64",
                        "glosses": [
                            "A substance that acts to increase physiological or nervous activity in the body."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e14f2162-9cbc-49a3-b06c-a701ca97a6fe",
                                "sense_id": "4ff41ac6-8ff1-3dc6-bb4d-d5781029861f",
                                "text": "Milk of chameleon was recommended as an erotic stimulant by Avicenna."
                            },
                            {
                                "example_id": "cffa3fe0-dfba-4923-8ea9-d1ebba053c06",
                                "sense_id": "4ff41ac6-8ff1-3dc6-bb4d-d5781029861f",
                                "text": "“Uppers” are what’s known as stimulants while “downers” are what is classified as depressants. […] Uppers increased cardiovascular and respiratory functions to dangerous degrees that can overwhelm the body. If you’ve ever felt an adrenaline rush before, you likely felt shaky, weak, or dizzy once it passed. This is similar to what stimulant drug users experience once a stimulant wears off. Feelings of exhaustion and depression set in and users seek more uppers to ward off what’s known as a “crash”."
                            }
                        ]
                    },
                    {
                        "sense_id": "58769a9c-30d7-3606-bdbc-fb424a6a6dff",
                        "entry_id": "2c489ed4-8a4d-31ec-8870-68ee03a38f64",
                        "glosses": [
                            "Something that promotes activity, interest, or enthusiasm."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c6ba4d0-2df4-40cd-ba7d-3b42516d5674",
                                "sense_id": "58769a9c-30d7-3606-bdbc-fb424a6a6dff",
                                "text": "[T]ouching the much vexed question of stimulants he relished a glass of choice old wine in season as both nourishing and bloodmaking and possessing aperient virtues (notably a good burgundy which he was a staunch believer in) […]"
                            },
                            {
                                "example_id": "22da10e2-4c84-4895-9179-c7bd98c7825d",
                                "sense_id": "58769a9c-30d7-3606-bdbc-fb424a6a6dff",
                                "text": "I was never to feel anything comparable under the influence of orthodox religious stimulants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7df708ce-8e7b-4224-a946-273b2ebe4e25",
                        "source_entry_id": "2c489ed4-8a4d-31ec-8870-68ee03a38f64",
                        "source_sense_description": "substance acting to increase physiological or nervous activity in the body",
                        "target_lang_word": "excitant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excitant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45f5a910-2120-3875-9f7f-d9103e35b312",
                                        "entry_id": "990765d5-aeec-3101-824d-2b73092b2140",
                                        "glosses": [
                                            "Qui est propre à exciter ; qui ranime les forces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "589df0ce-f246-4cdd-8e09-7cfbf2c206f7",
                                                "sense_id": "45f5a910-2120-3875-9f7f-d9103e35b312",
                                                "text": "Remède excitant."
                                            },
                                            {
                                                "example_id": "39faf439-1b92-4b1b-88e4-cfb295b1c28f",
                                                "sense_id": "45f5a910-2120-3875-9f7f-d9103e35b312",
                                                "text": "Potion excitante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81b21e38-72f7-35f8-b3ae-1883a3c564c7",
                                        "entry_id": "990765d5-aeec-3101-824d-2b73092b2140",
                                        "glosses": [
                                            "Qui éveille un sentiment vif ou passionné."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b02861b-a51a-4c30-861a-030473b25f2f",
                                                "sense_id": "81b21e38-72f7-35f8-b3ae-1883a3c564c7",
                                                "text": "J’accuse la Ligue nationale d’avoir fait de cet excitant sport qu’est le hockey le symbole de ta violence, du garrochage de rondelle et de l’accrochage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23b674b1-acb9-398b-9c33-28761f54d217",
                                        "entry_id": "990765d5-aeec-3101-824d-2b73092b2140",
                                        "glosses": [
                                            "Qui provoque à l’excitation sexuelle."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d579dcd2-b829-4350-aa8c-ae87bdea9aa2",
                                                "sense_id": "23b674b1-acb9-398b-9c33-28761f54d217",
                                                "text": "Des gens à poil galipettent, gaudriolent, turluttent et cunnilinguent à qui mieux mieux, comme bon leur semble, pour la joie rétinienne des mateurs amateurs, a priori ce n’est pas bien méchant. C’est même amusant. Et même excitant."
                                            },
                                            {
                                                "example_id": "d85e0b40-dd21-4134-9630-15a70c3e0be2",
                                                "sense_id": "23b674b1-acb9-398b-9c33-28761f54d217",
                                                "text": "C’est agréable de changer de bord, comme si un homosexuel se faisait prendre par deux blondes hypersexy et beaucoup trop excitantes pour un précoce."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "excitant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47e6e5b2-0cd2-317e-9832-96fb21e50310",
                                        "entry_id": "7ec60bff-1628-3480-9319-653766a38aec",
                                        "glosses": [
                                            "Remède destiné à provoquer une excitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1cb1b29-6ea2-48da-a2de-4c4063e3a8aa",
                                                "sense_id": "47e6e5b2-0cd2-317e-9832-96fb21e50310",
                                                "text": "Donner, administrer des excitants."
                                            },
                                            {
                                                "example_id": "48ff3557-1667-4b72-86cf-4b58843aaf2f",
                                                "sense_id": "47e6e5b2-0cd2-317e-9832-96fb21e50310",
                                                "text": "Abuser des excitants."
                                            },
                                            {
                                                "example_id": "57e0abcd-5505-4702-9654-6eb974f3e8ef",
                                                "sense_id": "47e6e5b2-0cd2-317e-9832-96fb21e50310",
                                                "text": "Le café est un excitant naturel."
                                            }
                                        ]
                                    }
                                ]
                            },
