                "senses": [
                    {
                        "sense_id": "91489479-cd35-3d52-9381-55f3c50367d1",
                        "entry_id": "b2e8b2d2-1b7f-3859-a57e-53511319f9e4",
                        "glosses": [
                            "Faire cesser d'être assommé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90d8c3d9-2906-4ea6-ad04-e31269d0918c",
                                "sense_id": "91489479-cd35-3d52-9381-55f3c50367d1",
                                "text": "Je ne suis pas assez désassommée."
                            },
                            {
                                "example_id": "7f7ed273-0929-491e-a356-57164021c183",
                                "sense_id": "91489479-cd35-3d52-9381-55f3c50367d1",
                                "text": "Vous n’aurez plus qu'à retourner à vos mobs et la sentinelle viendra d’elle-même sur vous une fois qu’elle sera « désassommée »."
                            },
                            {
                                "example_id": "d18f771c-a488-4f2e-b745-3c7c04c35c1d",
                                "sense_id": "91489479-cd35-3d52-9381-55f3c50367d1",
                                "text": "Plus aucune phrase même se met dans sa tête, comment voulez vous désassommer ?"
                            }
                        ]
                    }
