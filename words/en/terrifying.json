                                "nl": "Hij vindt het leuk om zijn jongere broertjes en zusjes <w>angst aan te jagen</w> met griezelverhalen in het donker.",
                                "pl": "Lubi <w>przerażać</w> swoje młodsze rodzeństwo strasznymi historiami w ciemności.",
                                "de": "Er genießt es, seine jüngeren Geschwister mit Gruselgeschichten im Dunkeln zu <w>erschrecken</w>.",
                                "fr": "Il aime <w>terrifier</w> ses jeunes frères et sœurs avec des histoires effrayantes dans le noir.",
                                "it": "Gli piace <w>terrorizzare</w> i suoi fratelli minori con storie di paura al buio.",
                                "cs": "Baví ho <w>děsit</w> své mladší sourozence strašidelnými příběhy ve tmě.",
                                "tr": "Karanlıkta ürkütücü hikayeler anlatarak küçük kardeşlerini <w>korkutmaktan</w> hoşlanıyor.",
                                "es": "Él disfruta <w>asustando</w> a sus hermanos menores con historias de miedo en la oscuridad.",
                                "zh": "他喜欢在黑暗中讲鬼故事来<w>吓唬</w>他的弟弟妹妹。"
                            }
                        },
                        {
                            "text": "The loud thunder was <w>terrifying</w> the poor dog hiding under the bed.",
                            "target_lang_translations": {
                                "ru": "Громкий гром <w>приводил в ужас</w> бедную собаку, прячущуюся под кроватью.",
                                "nl": "De harde donderslag <w>joeg</w> de arme hond die onder het bed zat te schuilen <w>angst aan</w>.",
                                "pl": "Głośny grzmot <w>przerażał</w> biednego psa chowającego się pod łóżkiem.",
                                "de": "Der laute Donner <w>verängstigte</w> den armen Hund, der sich unter dem Bett versteckte.",
                                "fr": "Le tonnerre bruyant <w>terrifiait</w> le pauvre chien caché sous le lit.",
                                "it": "Il forte tuono stava <w>terrorizzando</w> il povero cane che si nascondeva sotto il letto.",
                                "cs": "Hlasité hřmění <w>děsilo</w> chudáka psa schovaného pod postelí.",
                                "tr": "Gürültülü gök gürültüsü, yatağın altında saklanan zavallı köpeği <w>dehşete düşürüyordu</w>.",
                                "es": "El fuerte trueno estaba <w>aterrorizando</w> al pobre perro que se escondía debajo de la cama.",
                                "zh": "响亮的雷声把躲在床底下的那只可怜的狗<w>吓坏了</w>。"
                            }
                        }
