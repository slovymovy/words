                "senses": [
                    {
                        "sense_id": "a8ed65d2-f311-399d-9f46-1e0800dc3dee",
                        "entry_id": "d0adf8ea-2eb0-3992-8699-a22c79a85ec9",
                        "glosses": [
                            "Assemblage de poils couchés, membraneux et mous."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5d91ffb3-4975-3041-85b3-2e657b0a812b",
                        "entry_id": "d0adf8ea-2eb0-3992-8699-a22c79a85ec9",
                        "glosses": [
                            "Petites rugosités ou saillies qui couvrent certaines surfaces et qui leur donnent une apparence velue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e976386b-a83f-4b0e-bd3a-1d0f692039d4",
                                "sense_id": "5d91ffb3-4975-3041-85b3-2e657b0a812b",
                                "text": "Villosités intestinales."
                            },
                            {
                                "example_id": "39822d30-6e1b-4484-b137-651abc8461d8",
                                "sense_id": "5d91ffb3-4975-3041-85b3-2e657b0a812b",
                                "text": "Villosités choriales."
                            },
                            {
                                "example_id": "a2a5e538-f18f-43a4-aee7-ba74cb334934",
                                "sense_id": "5d91ffb3-4975-3041-85b3-2e657b0a812b",
                                "text": "Mais aussi s'émerveiller de la \"beauté\" de l'intestin grêle, long de 3 à 6 mètres, avec sa \"brillance veloutée\", ses plis et ses innombrables villosités chargées de travailler à la désintégration des aliments."
                            }
                        ]
                    },
                    {
                        "sense_id": "543fc8dd-03d8-37c6-bd6b-7df89ab416f1",
                        "entry_id": "d0adf8ea-2eb0-3992-8699-a22c79a85ec9",
                        "glosses": [
                            "État d’une surface velue."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a7deba83-a84f-4f98-817f-62c4c1f5c56a",
                                "sense_id": "543fc8dd-03d8-37c6-bd6b-7df89ab416f1",
                                "text": "Ses grègues demi-larges laissaient voir la trame et la chaîne d'une étoffe aussi claire qu'un canevas à broder, et il eût été impossible de savoir si elles avaient été en drap, en ratine ou en serge. Toute villosité avait disparu depuis longtemps de ces culottes chauves ; jamais menton d'eunuque ne fut plus glabre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61c0380d-3886-44a5-8f58-d179444e01d8",
                        "source_entry_id": "d0adf8ea-2eb0-3992-8699-a22c79a85ec9",
                        "source_sense_description": "petit poil",
                        "target_lang_word": "villus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
