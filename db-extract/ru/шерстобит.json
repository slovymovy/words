                            {
                                "example_id": "b6237dd5-5ec6-4f99-b1b3-ecdd4f6c35b9",
                                "sense_id": "4b599117-ffcb-3e0f-ba66-da7f6bd86f75",
                                "text": "У нас же дорога большая была: // Рабочего звания люди сновали // По ней без числа. // Копатель канав — вологжанин, // Лудильщик, портной, шерстобит, // А то в монастырь горожанин // Под праздник молиться катит."
                            }
                        ]
