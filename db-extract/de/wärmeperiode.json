                "senses": [
                    {
                        "sense_id": "3d056995-61b0-32ea-8a5f-89f9f1931607",
                        "entry_id": "1a14a47b-582c-3fcb-868d-72885305987e",
                        "glosses": [
                            "längerer, von warmem Wetter geprägter Zeitraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf3b6d41-2a3f-4f12-b9d3-a967516ae520",
                                "sense_id": "3d056995-61b0-32ea-8a5f-89f9f1931607",
                                "text": "„Hin nach Südwesten, weg von der sich ankündigenden Winterkälte nach einer ungewöhnlich langen Wärmeperiode.“"
                            },
                            {
                                "example_id": "cf565175-0905-4bf5-8ce9-6fa7f065432f",
                                "sense_id": "3d056995-61b0-32ea-8a5f-89f9f1931607",
                                "text": "„Der Spaß währte damals noch ein bis zwei Wochen am Stück, bevor eine kurze Wärmeperiode kam, und der Schnee schmolz.“"
                            },
                            {
                                "example_id": "eabe42e6-eaef-4cde-b2cd-7ae3ae96c569",
                                "sense_id": "3d056995-61b0-32ea-8a5f-89f9f1931607",
                                "text": "„Laut dem Leiter eines Instituts für Meteorologie und Geodynamik, Ernest Rudel, war die Nordpassage in der mittelalterlichen Wärmeperiode eisfrei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
