                                    },
                                    {
                                        "sense_id": "860f77f5-dee4-3433-b82c-8dd5b1929c6d",
                                        "entry_id": "1fdb6eba-46b0-39b4-985a-50ead7e6133d",
                                        "glosses": [
                                            "An animal's litter box."
