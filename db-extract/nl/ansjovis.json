                                        "entry_id": "d3e5fb37-3ec1-3dbf-b637-bd216e0ac9e1",
                                        "glosses": [
                                            "Any small saltwater fish of the Engraulidae family, consisting of 160 species in sixteen genera, those of the genus Engraulis being widely sold as food."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20b4f39c-74b5-4696-9e61-928311b91540",
                                                "sense_id": "16e23447-8833-3fd0-bb11-3876cd12f65a",
                                                "text": "[T]he cooks were laying a refection before him of sack and anchovies and garlic sausage and gammons of bacon and - this was the important item - a great pudding dish out of which rose the noble dome of a crisp brown pie-crust."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "822c46c5-c7a6-4a79-bf3d-0507dce5086b",
                        "source_entry_id": "5f676fb5-e220-3c97-aad5-e62334a982df",
                        "target_lang_word": "anchois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
