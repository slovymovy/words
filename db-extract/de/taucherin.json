                        "glosses": [
                            "weibliche Person, die den Tauchsport ausübt; die tauchen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa3114da-b15e-4fde-b5fb-33136931832c",
                                "sense_id": "a730e4d7-e8ca-3ac2-b669-6b18560c6149",
                                "text": "Im heutigen Tauchkurs sind vier Taucherinnen und zwei Taucher."
                            },
                            {
                                "example_id": "c760abe5-fea0-4eca-8212-e654eacc971b",
                                "sense_id": "a730e4d7-e8ca-3ac2-b669-6b18560c6149",
                                "text": "Hast du die Taucherin gesehen, die dort hinten am Strand liegt?"
                            },
                            {
                                "example_id": "6c16ebe8-850f-4918-a8de-9c61be42dfa7",
                                "sense_id": "a730e4d7-e8ca-3ac2-b669-6b18560c6149",
                                "text": "„Eine Taucherin steigt in ein Wasserbecken mit einer halben Million Liter Wasser.“"
                            }
                        ],
