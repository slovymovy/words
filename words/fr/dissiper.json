{
    "word_family": [
        "dissipateur",
        "dissipation",
        "dissipatif"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "826ea967-791f-37fa-a4e0-6849ab201de6",
                    "sense_definition": "Faire disparaître en dispersant ou chasser un ensemble d'éléments, des doutes ou des soucis.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "dispersion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent du nord souffle avec force pour <w>dissiper</w> les nuages sombres."
                        },
                        {
                            "text": "Ses explications très claires ont enfin permis de <w>dissiper</w> un malentendu tenace."
                        }
                    ],
                    "synonyms": [
                        "chasser",
                        "disperser"
                    ],
                    "common_phrases": [
                        "dissiper les doutes",
                        "dissiper un malentendu"
                    ]
                },
                {
                    "sense_id": "f4fbe6b4-25ae-3854-8eba-4d8c5afefe0d",
                    "sense_definition": "Disparaître ou s'évanouir peu à peu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dispersion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La brume matinale commence lentement à se <w>dissiper</w> avec l'arrivée des premiers rayons."
                        },
                        {
                            "text": "Après une bonne discussion, toutes ses craintes se sont <w>dissipées</w> comme par enchantement."
                        }
                    ],
                    "synonyms": [
                        "disparaître",
                        "s'évanouir"
                    ],
                    "antonyms": [
                        "apparaître"
                    ],
                    "common_phrases": [
                        "se dissiper rapidement"
                    ]
                },
                {
                    "sense_id": "ee3a725f-bf2e-3f41-bfef-8b57404b3de2",
                    "sense_definition": "Gaspiller ou consumer par des dépenses excessives et inconsidérées.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gaspillage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En multipliant les achats futiles, le jeune homme a fini par <w>dissiper</w> une fortune colossale."
                        },
                        {
                            "text": "Il a préféré <w>dissiper</w> son temps dans les cafés plutôt que de réviser son examen."
                        }
                    ],
                    "synonyms": [
                        "dilapider",
                        "gaspiller"
                    ],
                    "antonyms": [
                        "économiser",
                        "épargner"
                    ],
                    "common_phrases": [
                        "dissiper son bien",
                        "dissiper une fortune"
                    ]
                },
                {
                    "sense_id": "bc5dd672-8073-33b4-afc3-b2689394fe3a",
                    "sense_definition": "Distraire l'attention de quelqu'un et le détourner d'un travail sérieux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces bruits constants dans le couloir risquent de <w>dissiper</w> les élèves pendant le devoir."
                        },
                        {
                            "text": "Deux élèves farceurs suffisent souvent pour <w>dissiper</w> la classe entière lors du cours."
                        }
                    ],
                    "synonyms": [
                        "déconcentrer",
                        "distraire"
                    ],
                    "antonyms": [
                        "concentrer"
                    ],
                    "common_phrases": [
                        "dissiper la classe",
                        "dissiper les élèves"
                    ]
                }
            ]
        }
    ]
}