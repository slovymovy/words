                    "frequency": "Middle",
                    "semantic_group_id": "chance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce nouveau restaurant était une bonne <w>pioche</w>, nous avons très bien mangé."
                        },
                        {
                            "text": "J'ai acheté ce roman au hasard, mais c'était vraiment une mauvaise <w>pioche</w>."
