                "senses": [
                    {
                        "sense_id": "0a623d80-fbb3-3069-b9a8-0c6e0082b8c5",
                        "entry_id": "6798dd24-dd28-3d7e-b544-514eaaf03f0d",
                        "glosses": [
                            "jemand, der in einem Unternehmen der Vorstand für Entwicklung ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab3a08ac-972b-420c-96d6-e698a6c423bb",
                                "sense_id": "0a623d80-fbb3-3069-b9a8-0c6e0082b8c5",
                                "text": "„[…] Entwicklungsvorstand Ulrich Hackenberg kam schließlich noch zu einem Redaktionsbesuch vorbei.“"
                            },
                            {
                                "example_id": "6c406941-47b1-42e0-a010-72241bea3a47",
                                "sense_id": "0a623d80-fbb3-3069-b9a8-0c6e0082b8c5",
                                "text": "„Nachdem sich die Niedersachsen beim Generationswechsel des Golfs vor allem auf die Einführung des Modularen Querbaukastens konzentriert und deshalb die Hardware in den Vordergrund gestellt haben, rückt bei der Neuauflage des Passat verstärkt die Software in den Focus: Neue Assistenzsysteme, ein modernes Anzeigekonzept und ein gründliches Update fürs Infotainment sollen die achte Generation des in über 40 Jahren mehr als 22 Millionen Mal verkauften Bestsellers auf Augenhöhe mit den Premium-Modellen in der Mittelklasse bringen, sagt Entwicklungsvorstand Heinz-Jakob Neußer.“"
                            },
                            {
                                "example_id": "1ff3691d-547b-4140-bca8-776943cad3fb",
                                "sense_id": "0a623d80-fbb3-3069-b9a8-0c6e0082b8c5",
                                "text": "„Dass der neue Weltmotor Grundlage für einen Porsche-Einstieg in die Formel 1 ist, bestätigte zuletzt auch Entwicklungsvorstand Wolfgang Dürheimer am Rande des Saisonfinales der American Le Mans Series (ALMS) in Atlanta/Gerorgia.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
