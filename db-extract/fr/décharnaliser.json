                ],
                "senses": [
                    {
                        "sense_id": "f7c1b97c-ceed-3d55-b044-e02a8d7dd824",
                        "entry_id": "4ff0057b-4414-3481-8192-32efc6acb165",
                        "glosses": [
                            "Faire perdre son caractère charnel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6bcbed7-8811-4243-9acf-7ff359785940",
                                "sense_id": "f7c1b97c-ceed-3d55-b044-e02a8d7dd824",
                                "text": "Je suis très terre à terre, mais j’ai beaucoup de mal à prendre en considération un amour totalement et indéfiniment décharnalisé (je ne dis pas asexué)."
                            },
                            {
                                "example_id": "e508630e-e1dc-4786-84a8-fad356493c4c",
                                "sense_id": "f7c1b97c-ceed-3d55-b044-e02a8d7dd824",
                                "text": "Les règles morales sont intériorisées. L’amour pour les parents s’est décharnalisé."
                            },
                            {
                                "example_id": "89466ca5-bfd7-4ddd-9b8e-0e2e9d0a2da3",
                                "sense_id": "f7c1b97c-ceed-3d55-b044-e02a8d7dd824",
                                "text": "Souvent au bout d’un certain temps, avec le poids des ans, tout va se décharnaliser petit à petit et il ne subsistera plus qu’une amitié ayant un autre passé."
                            }
                        ]
                    }
                ],
