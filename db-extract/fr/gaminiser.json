                        "glosses": [
                            "Donner un caractère gamin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06843fe7-8ada-4294-866d-6e96ace6f18a",
                                "sense_id": "2ab4be8f-f15a-36e3-b74d-abb40f721564",
                                "text": "Alors de un, \"gaminiser\" un tel héros est un crime sans nom, de deux, quitte à faire appel à un mangaka, autant faire appel à un bon mangaka."
                            },
                            {
                                "example_id": "61814dd6-47ee-46ce-84bd-e874e36591ca",
                                "sense_id": "2ab4be8f-f15a-36e3-b74d-abb40f721564",
                                "text": "Et s'il était possible que les power rangers arrêtent de \"gaminiser\" les sentaï ça serait cool !"
                            },
                            {
                                "example_id": "c17be7a2-bfaa-4b23-8d86-2cbbd8b62afc",
                                "sense_id": "2ab4be8f-f15a-36e3-b74d-abb40f721564",
                                "text": "Et une licence de plus qui voit son \"design\" se \"gaminiser\" en arrivant sur DS."
                            }
                        ]
                    }
