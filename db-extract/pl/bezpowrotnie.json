                        "examples": [
                            {
                                "example_id": "c0a144c6-af09-4f06-8d24-a0fb16113809",
                                "sense_id": "0d681a92-c5ae-358b-bfa7-9bbcdaa5ab08",
                                "text": "Te czasy minęły już bezpowrotnie."
                            },
                            {
                                "example_id": "aebbe57a-16b1-42d3-b091-d33e5cea9eea",
                                "sense_id": "0d681a92-c5ae-358b-bfa7-9bbcdaa5ab08",
                                "text": "Marta utraciła go bezpowrotnie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a50c5080-6ee9-41ec-8610-785ffd54b609",
                        "source_entry_id": "39a6bd02-ffbd-3a8b-ada3-73159efa930c",
                        "source_sense_id": "0d681a92-c5ae-358b-bfa7-9bbcdaa5ab08",
                        "target_lang_word": "irrevocably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irrevocably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0b650d1-ba2a-3aa1-bc7f-f4108cf7110e",
                                        "entry_id": "75b4c700-648f-3e76-b0ff-652230a019a2",
                                        "glosses": [
                                            "In an irrevocable manner; in a manner which prevents the ability to be reverted, repealed, or undone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c17f98b3-77e9-4a0b-9684-800fdad2abf5",
                                                "sense_id": "f0b650d1-ba2a-3aa1-bc7f-f4108cf7110e",
                                                "text": "Two distinct cases must be noted: (1) rights of the beneficiary who has been named revocably, that is, with the insured retaining the right to change the beneficiary designation; and (2) rights of the beneficiary who has been named irrevocably by the insured."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "808c3308-40e4-42d0-84c3-0f7995ed4827",
                        "source_entry_id": "39a6bd02-ffbd-3a8b-ada3-73159efa930c",
                        "source_sense_id": "0d681a92-c5ae-358b-bfa7-9bbcdaa5ab08",
                        "target_lang_word": "бесповоро́тно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бесповоро́тно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "877d1204-07fb-392d-a4b8-fe63029bca51",
                                        "entry_id": "53fa8193-7eaa-3086-ba4a-d8ea6f164760",
                                        "glosses": [
                                            "не имея возможности или не желая изменить что-либо, вернуться к прежнему; окончательно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e2d4adc-6acd-4e56-97ee-4a08e0a638b1",
                                                "sense_id": "877d1204-07fb-392d-a4b8-fe63029bca51",
                                                "text": "Впрочем, в то время он очень был развлечен одним совсем посторонним обстоятельством: приехав из Москвы, он в первые же дни весь и бесповоротно отдался пламенной и безумной страсти своей к Катерине Ивановне."
                                            },
                                            {
                                                "example_id": "03c280df-b427-4351-9f40-0133dc9818f4",
                                                "sense_id": "877d1204-07fb-392d-a4b8-fe63029bca51",
                                                "text": "Да и какую роль может играть мысль о будущем, когда течение всей жизни бесповоротно и в самых малейших подробностях уже решено в уме Арины Петровны?"
                                            },
                                            {
                                                "example_id": "c12b3d35-dd68-4971-805f-650b7598cf53",
                                                "sense_id": "877d1204-07fb-392d-a4b8-fe63029bca51",
                                                "text": "Я всю жизнь свою поставил на карту… бесповоротно, бесшабашно, и предо мною нет более никакого выхода из этого положения!.."
                                            },
                                            {
                                                "example_id": "63ac20f3-194c-4384-87eb-111ead67d07d",
                                                "sense_id": "877d1204-07fb-392d-a4b8-fe63029bca51",
                                                "text": "Что издательское дело вступает в компьютерную эпоху; привычные технологии бесповоротно ушли в прошлое; через пару лет уже никто не будет работать по старинке."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
