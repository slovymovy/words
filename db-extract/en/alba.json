                                            {
                                                "example_id": "ae9ea257-4250-4e95-b972-7dc11e94f69f",
                                                "sense_id": "e5db4bcb-6644-3cfe-b9c0-a8f18c629b92",
                                                "text": "W liturgii alba jest szatą używaną przez duchownych wszystkich stopni, jak również przez osoby świeckie (np. lektorów), które spełniają określone posługi liturgiczne"
                                            },
                                            {
                                                "example_id": "86492b91-972c-46b7-bb14-cb366ef03c50",
                                                "sense_id": "e5db4bcb-6644-3cfe-b9c0-a8f18c629b92",
                                                "text": "Jeżeli alba nie osłania dokładnie zwykłego stroju koło szyi, przed włożeniem alby należy nałożyć humerał"
                                            }
                                        ],
