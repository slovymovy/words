{
    "word_family": [
        "outdoors",
        "outdoorsy",
        "outdoorsman",
        "outdoorswoman"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4e032bf2-302d-3f4e-898c-43c99e774cc1",
                    "sense_definition": "Located, used, or taking place in the open air rather than inside a building.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "open_air",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to have an <w>outdoor</w> lunch because the weather was so beautiful today.",
                            "target_lang_translations": {
                                "ru": "Мы решили пообедать <w>на открытом воздухе</w>, потому что сегодня была прекрасная погода."
                            }
                        },
                        {
                            "text": "The city is famous for its vibrant <w>outdoor</w> market where local farmers sell fresh produce.",
                            "target_lang_translations": {
                                "ru": "Город знаменит своим оживленным <w>уличным</w> рынком, где местные фермеры продают свежие продукты."
                            }
                        }
                    ],
                    "synonyms": [
                        "open-air",
                        "outside",
                        "out-of-door"
                    ],
                    "antonyms": [
                        "indoor",
                        "inside"
                    ],
                    "common_phrases": [
                        "outdoor activities",
                        "outdoor market",
                        "outdoor seating",
                        "outdoor pool"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся, используемый или происходящий на открытом воздухе, а не внутри здания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на открытом воздухе",
                                "target_lang_sense_clarification": "о мероприятии или месте"
                            },
                            {
                                "target_lang_word": "уличный",
                                "target_lang_sense_clarification": "о рынке, мебели или освещении"
                            },
                            {
                                "target_lang_word": "под открытым небом",
                                "target_lang_sense_clarification": "о расположении без крыши"
                            },
                            {
                                "target_lang_word": "наружный",
                                "target_lang_sense_clarification": "находящийся снаружи здания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e229d15f-f8c3-368a-9e64-f440f3c95369",
                    "sense_definition": "Relating to social or charitable assistance provided to people in their own homes rather than in an institution.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "charity_administration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historians often discuss the <w>outdoor</w> relief system as a precursor to modern welfare programs.",
                            "target_lang_translations": {
                                "ru": "Историки часто обсуждают систему <w>внеинституциональной</w> помощи как предшественницу современных программ социального обеспечения."
                            }
                        },
                        {
                            "text": "The local council debated whether to increase <w>outdoor</w> relief for families struggling with poverty.",
                            "target_lang_translations": {
                                "ru": "Местный совет обсуждал вопрос о том, стоит ли увеличить <w>надомные</w> пособия для семей, живущих в бедности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "outdoor relief"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Primarily used in historical contexts regarding the Poor Laws"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к социальной или благотворительной помощи, предоставляемой людям на дому, а не в специализированных учреждениях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внеинституциональный",
                                "target_lang_sense_clarification": "о системе социальной помощи на дому"
                            },
                            {
                                "target_lang_word": "надомный",
                                "target_lang_sense_clarification": "о предоставлении пособий или услуг"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "22ccfff4-af8d-3f29-b2c4-a1e8b7e2c4ed",
                    "sense_definition": "To present a child to the public or community for the first time after they have been named.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "naming_ceremony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some cultures, it is traditional to <w>outdoor</w> the infant eight days after birth.",
                            "target_lang_translations": {
                                "ru": "В некоторых культурах принято <w>выводить в свет</w> младенца через восемь дней после рождения."
                            }
                        },
                        {
                            "text": "The family gathered to <w>outdoor</w> the newborn during a formal naming ceremony.",
                            "target_lang_translations": {
                                "ru": "Семья собралась, чтобы <w>представить</w> новорожденного во время официальной церемонии наречения."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in West African English, particularly Ghana"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Впервые представить ребенка общественности или общине после того, как ему дали имя (традиция в Западной Африке)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выводить в свет",
                                "target_lang_sense_clarification": "в контексте церемонии представления младенца"
                            },
                            {
                                "target_lang_word": "проводить обряд наречения",
                                "target_lang_sense_clarification": "официально представлять ребенка общине"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}