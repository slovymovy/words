                    "sense_definition": "die Fähigkeit oder Bereitschaft besitzen, eine bestimmte Handlung auszuführen; jemanden für fähig halten, etwas Bestimmtes zu tun",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich <w>traue</w> meiner Kollegin durchaus <w>zu</w>, diese schwierige Verhandlung erfolgreich zu leiten."
                        },
                        {
                            "text": "Niemand hatte dem Außenseiter einen solchen Erfolg im Turnier <w>zugetraut</w>."
                        }
                    ],
                    "antonyms": [
                        "absprechen"
                    ],
                    "common_phrases": [
