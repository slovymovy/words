                "senses": [
                    {
                        "sense_id": "dd845446-c867-3652-8af4-7a9c5228e72a",
                        "entry_id": "180648b7-222c-3bb5-9212-30d08e077744",
                        "glosses": [
                            "Telefonnummer, die von Opfern einer Straftat angerufen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dce9da5-de69-481f-8816-6274e56dcf1e",
                                "sense_id": "dd845446-c867-3652-8af4-7a9c5228e72a",
                                "text": "„Der Opfer-Notruf ist für alle Menschen, die Opfer einer Straftat geworden sind.“"
                            },
                            {
                                "example_id": "db90ceaf-7d8f-46b0-b799-4d35c6861b99",
                                "sense_id": "dd845446-c867-3652-8af4-7a9c5228e72a",
                                "text": "„Das Justizministerium hat daher 2003 einen kostenlosen Opfer-Notruf eingerichtet, der seit 2007 von der Opferschutzeinrichtung Weißer Ring betrieben wird.“"
                            },
                            {
                                "example_id": "5abcf690-a9d3-40da-8d4e-9ecbe1f2128e",
                                "sense_id": "dd845446-c867-3652-8af4-7a9c5228e72a",
                                "text": "„Der Opfer-Notruf 0800 112 112 des Justizministeriums ist nun im Chat erreichbar.“"
                            },
                            {
                                "example_id": "38649a4a-f80e-4949-8099-70804a8741b4",
                                "sense_id": "dd845446-c867-3652-8af4-7a9c5228e72a",
                                "text": "„Der Opfer-Notruf 0800 112 112 ist österreichweit die erste Anlaufstelle für alle Opfer krimineller Handlungen.“"
                            },
                            {
                                "example_id": "fb172d6a-0fc9-4da0-aae1-034e4b8af7b7",
                                "sense_id": "dd845446-c867-3652-8af4-7a9c5228e72a",
                                "text": "„Der Opfer-Notruf des Weißen Rings könne kostenlos und rund um die Uhr in Anspruch genommen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
