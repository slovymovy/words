{
    "word_family": [
        "wee",
        "weeheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "12aeadf0-05e5-3e06-a29b-e66a4a0cdf48",
                    "sense_definition": "een flauwe, misselijkmakende en onprettige gewaarwording van geur of gevoel",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onprettige gewaarwording",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De geur van het rottende vlees was <w>weeïg</w> en een beetje zoetig.",
                            "target_lang_translations": {
                                "en": "The smell of the rotting meat was <w>sickly</w> and a bit sweet."
                            }
                        },
                        {
                            "text": "Hij kreeg een <w>weeïg</w> gevoel in zijn maag toen hij het slechte nieuws hoorde.",
                            "target_lang_translations": {
                                "en": "He got a <w>queasy</w> feeling in his stomach when he heard the bad news."
                            }
                        }
                    ],
                    "synonyms": [
                        "misselijk",
                        "flauw",
                        "onpasselijk",
                        "onfris"
                    ],
                    "common_phrases": [
                        "weeïg gevoel",
                        "weeïge geur",
                        "weeïg in de maag"
                    ],
                    "target_lang_definitions": {
                        "en": "a faint, nauseating, and unpleasant sensation of smell or feeling"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sickly",
                                "target_lang_sense_clarification": "referring to a smell or taste that causes nausea"
                            },
                            {
                                "target_lang_word": "queasy",
                                "target_lang_sense_clarification": "referring to a feeling of nausea in the stomach"
                            },
                            {
                                "target_lang_word": "faint",
                                "target_lang_sense_clarification": "referring to a weak but unpleasant sensation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b9fdeed-e398-3ced-9181-3b7e9fb16441",
                    "sense_definition": "overdreven sentimenteel of teerhartig op een manier die flauw overkomt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sentimenteel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De romantische film was een beetje te <w>weeïg</w> naar mijn smaak.",
                            "target_lang_translations": {
                                "en": "The romantic movie was a bit too <w>sappy</w> for my taste."
                            }
                        },
                        {
                            "text": "Zijn <w>weeïge</w> woorden over hun vriendschap klonken niet erg oprecht.",
                            "target_lang_translations": {
                                "en": "His <w>maudlin</w> words about their friendship did not sound very sincere."
                            }
                        }
                    ],
                    "synonyms": [
                        "teerhartig",
                        "slap",
                        "flauw"
                    ],
                    "common_phrases": [
                        "weeïge romantiek",
                        "iets te weeïg"
                    ],
                    "target_lang_definitions": {
                        "en": "excessively sentimental or tender-hearted in a way that comes across as weak or insipid"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sappy",
                                "target_lang_sense_clarification": "excessively sentimental"
                            },
                            {
                                "target_lang_word": "maudlin",
                                "target_lang_sense_clarification": "tearfully or weakly emotional"
                            },
                            {
                                "target_lang_word": "mushy",
                                "target_lang_sense_clarification": "overly sentimental or soft"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}