                "senses": [
                    {
                        "sense_id": "8bb80dee-dae0-37d2-8435-62098491b084",
                        "entry_id": "18c5aaf5-9214-3992-9482-d91da60d35d8",
                        "glosses": [
                            "Säufer, Trinker, Saufbold"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa225eb9-ef94-4ffc-a5e6-10c234889115",
                        "source_entry_id": "18c5aaf5-9214-3992-9482-d91da60d35d8",
                        "source_sense_id": "8bb80dee-dae0-37d2-8435-62098491b084",
                        "source_sense_description": "umgangssprachlich: Säufer, Trinker, Saufbold",
                        "target_lang_word": "Säufer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Säufer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0a4a4e7-9f81-351e-860d-0000bb2b812e",
                                        "entry_id": "65e6ca45-ab75-3f1b-9f10-2d559f1cda7f",
                                        "glosses": [
                                            "jemand, der zu viel alkoholische Getränke konsumiert"
                                        ],
                                        "tags": [
                                            "casual",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "633f5d89-59cf-4c6c-88dc-c000dd01f5c1",
                                                "sense_id": "c0a4a4e7-9f81-351e-860d-0000bb2b812e",
                                                "text": "Seit diesem Schicksalsschlag ist er zum Säufer geworden."
                                            },
                                            {
                                                "example_id": "fe6ee3ee-f7a2-43c0-a53b-a511f29c7ce4",
                                                "sense_id": "c0a4a4e7-9f81-351e-860d-0000bb2b812e",
                                                "text": "„Schiffsärzte wurden gemeinhin als Kurpfuscher und Säufer hingestellt.“"
                                            },
                                            {
                                                "example_id": "6a7bc510-538e-4eef-b371-c0bb25f29f67",
                                                "sense_id": "c0a4a4e7-9f81-351e-860d-0000bb2b812e",
                                                "text": "„Natürlich fielen nun sofort alle Mann über den alten Freischlucker und Säufer her, sie zogen ihn nach Kräften auf.“"
                                            },
                                            {
                                                "example_id": "0bf43a1c-19b9-4241-b381-1359d2552862",
                                                "sense_id": "c0a4a4e7-9f81-351e-860d-0000bb2b812e",
                                                "text": "„Der zweite machte ihr einen Sohn und wurde irgendwann ein Säufer, ein Loser (seine Arztpraxis wurde zwangsgeräumt), ein Schuldengangster und (Ehefrau-)Schläger.“"
                                            },
                                            {
                                                "example_id": "fd806291-9444-4592-a4e8-dbc94d88fec2",
                                                "sense_id": "c0a4a4e7-9f81-351e-860d-0000bb2b812e",
                                                "text": "„Die Wahrheit, die übrigens auch aus dem intimen Tagebuch hervorgeht, zwingt zu der Feststellung, daß er das war, was man unumwunden einen Säufer nennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a9d72bc-db58-4899-abea-88c6fdb94d98",
                        "source_entry_id": "18c5aaf5-9214-3992-9482-d91da60d35d8",
                        "source_sense_id": "8bb80dee-dae0-37d2-8435-62098491b084",
                        "source_sense_description": "umgangssprachlich: Säufer, Trinker, Saufbold",
                        "target_lang_word": "Trinker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trinker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c09e2fb-2222-3848-a798-c630ddb41e79",
                                        "entry_id": "0e2af43a-abb2-3484-9c9e-8fb97a26d61e",
                                        "glosses": [
                                            "jemand, der regelmäßig alkoholische Getränke in größeren Mengen zu sich nimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75ac07a5-5f9b-40f3-a2fc-78dd7b596ff3",
                                                "sense_id": "4c09e2fb-2222-3848-a798-c630ddb41e79",
                                                "text": "Auch gute Sänger werden leicht Trinker."
                                            },
                                            {
                                                "example_id": "95609674-2c9b-45dc-aea8-d53f78f13424",
                                                "sense_id": "4c09e2fb-2222-3848-a798-c630ddb41e79",
                                                "text": "Der Trinker aus Nothwendigkeit dagegen kann ein Mensch von liebenswürdigen Eigenschaften sein; Noth und Unglück stürzen ihn in diese unselige Gewohnheit; anstatt seine Sorgen männlich zu ertragen, will er sie vertrinken."
                                            },
                                            {
                                                "example_id": "f467f927-f688-4bda-8439-3abe94504f3b",
                                                "sense_id": "4c09e2fb-2222-3848-a798-c630ddb41e79",
                                                "text": "Einige werden Trinker aus zu großer Nachsicht in der Jugend."
                                            },
                                            {
                                                "example_id": "fe4d7cd5-5299-4e14-b2da-c8e2162f99fa",
                                                "sense_id": "4c09e2fb-2222-3848-a798-c630ddb41e79",
                                                "text": "In dem vierten Capitel: „Trunkenheit modificirt durch das Temperament“, schildert der Verf. den sanguinischen, phlegmatischen, nervösen, cholerischen und periodischen Trinker getreu nach der Natur."
                                            },
                                            {
                                                "example_id": "54aa7686-ee7a-42f4-a88c-ac30f8b8a5c1",
                                                "sense_id": "4c09e2fb-2222-3848-a798-c630ddb41e79",
                                                "text": "Was er unter dem nervösen Trinker versteht, ist uns nicht recht klar geworden."
                                            },
                                            {
                                                "example_id": "fb8a4b63-3949-4a50-8e3b-794008087115",
                                                "sense_id": "4c09e2fb-2222-3848-a798-c630ddb41e79",
                                                "text": "Wenn ein Mann einen störrischen und widerspenstigen Sohn hat, der nicht auf die Stimme seines Vaters und seiner Mutter hört, und wenn sie ihn züchtigen und er trotzdem nicht auf sie hört, dann sollen Vater und Mutter ihn packen, vor die Ältesten der Stadt und die Torversammlung des Ortes führen und zu den Ältesten der Stadt sagen: Unser Sohn hier ist störrisch und widerspenstig, er hört nicht auf unsere Stimme, er ist ein Verschwender und Trinker."
                                            },
                                            {
                                                "example_id": "b1944b5b-903d-4d92-847e-a0864e3c8ff1",
                                                "sense_id": "4c09e2fb-2222-3848-a798-c630ddb41e79",
                                                "text": "Denn ein Bischof muss unbescholten sein, weil er das Haus Gottes verwaltet; er darf nicht überheblich und jähzornig sein, kein Trinker, nicht gewalttätig oder habgierig."
                                            },
                                            {
                                                "example_id": "6ebc9137-bae9-4357-a74d-4c276e2974dc",
                                                "sense_id": "4c09e2fb-2222-3848-a798-c630ddb41e79",
                                                "text": "Wenn aber der Knecht schlecht ist und denkt: Mein Herr kommt noch lange nicht!, und anfängt, seine Mitknechte zu schlagen, wenn er mit Trinkern Gelage feiert, dann wird der Herr an einem Tag kommen, an dem der Knecht es nicht erwartet, und zu einer Stunde, die er nicht kennt; und der Herr wird ihn in Stücke hauen und ihm seinen Platz unter den Heuchlern zuweisen. Dort wird er heulen und mit den Zähnen knirschen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "84aa0706-9167-3645-9bd2-e8a7175cb88f",
                                        "entry_id": "0e2af43a-abb2-3484-9c9e-8fb97a26d61e",
                                        "glosses": [
                                            "jemand, der etwas trinkt"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9353ed38-f358-4bd8-8ea8-21a685023f5f",
                                                "sense_id": "84aa0706-9167-3645-9bd2-e8a7175cb88f",
                                                "text": "Welcher Trinker bist du; Kaffee oder lieber Tee?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a25cbf08-899b-46b8-b7bf-23e3db02023c",
                        "source_entry_id": "18c5aaf5-9214-3992-9482-d91da60d35d8",
                        "source_sense_id": "8bb80dee-dae0-37d2-8435-62098491b084",
                        "source_sense_description": "umgangssprachlich: Säufer, Trinker, Saufbold",
                        "target_lang_word": "Saufbold",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saufbold",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00c857a8-2234-36ee-ab93-410b6e2e9f46",
                                        "entry_id": "27254685-6f70-3461-9f10-f91e4ee77a80",
                                        "glosses": [
                                            "eine Person, die viel Alkohol trinkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cdcbe3f-4ab7-42f1-89ee-06310d91bf8e",
                                                "sense_id": "00c857a8-2234-36ee-ab93-410b6e2e9f46",
                                                "text": "Mit diesem Saufbold gehe ich nicht mehr in die Stadt!"
                                            },
                                            {
                                                "example_id": "51b9cccc-0e72-4b11-8c50-72b405a93955",
                                                "sense_id": "00c857a8-2234-36ee-ab93-410b6e2e9f46",
                                                "text": "„Da ich jedoch den Mann als rüpelhaften und groben Saufbold kannte, der für ein Ja oder Nein rasch mit dem Degen zur Hand war, hielt ich es für besser, zu schweigen und nicht mehr an seine Tochter zu denken; denn ich wollte mich mit einem Mann seines Schlages nicht einlassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
