                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92af4bee-1169-4837-8085-4ed9b10aac7e",
                                "sense_id": "4418222c-4aae-3423-ab57-3c992a5f8d15",
                                "text": "„Wronka befürchtet weitere Eingriffe auf die Werbefreiheit.“"
                            },
                            {
                                "example_id": "ad860f5e-db1a-4f03-8200-66fa190dc31b",
                                "sense_id": "4418222c-4aae-3423-ab57-3c992a5f8d15",
                                "text": "„Den Landesstudios sollte weiters \"dieselbe Werbefreiheit eingeräumt werden, wie im Bund\", betonte Häupl in einem Gespräch mit der \"Presse\".“"
                            },
                            {
                                "example_id": "efa239b1-db69-47f7-9231-76c8a1465250",
                                "sense_id": "4418222c-4aae-3423-ab57-3c992a5f8d15",
                                "text": "„Weiter wird den Klubs ab sofort grössere Werbefreiheit auf den Trikots und in der Halle zugestanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
