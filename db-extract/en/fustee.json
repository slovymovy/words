                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9fa0b3de-c89b-4fcf-9579-54d916b9486c",
                                "sense_id": "c1ec22d2-0d3a-31c7-a718-f1e2da622bce",
                                "text": "Figueros, the ambassador, has been instructed to provide you with a fustee or caravel for your passage to Barcelona.\n[…]\nThe fustees going to Marseilles, and being admitted into that port, king Francis redeemed for 700 ducats the Muscovite ambassador now residing at the French court, whilst Moorish and Turkish pirates are allowed shelter in French ports."
                            }
