                                "target_senses": [
                                    {
                                        "sense_id": "6419a6f6-9e83-303b-ab8d-4c2bd4d53d42",
                                        "entry_id": "7bf6155a-ad9a-3088-95c4-1b95324a36b0",
                                        "glosses": [
                                            "действие по знач. глаг.: чистить (делать чистым, то есть удалять грязь, ненужные примеси и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2989bff-6670-4f7f-9a1e-0377ac19aa33",
                                                "sense_id": "6419a6f6-9e83-303b-ab8d-4c2bd4d53d42",
                                                "text": "Предпраздничная сутолока, дни всеобщей чистки, мытья и расходов — масса мелких расходов к сочельнику, почти дочиста опустошающих карман человека, живущего на жалованье, — эти два-три дня сильно расстроили и без того не особенно крепкие нервы Павла Николаевича."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c35524b2-69cc-3c24-8706-10f09fbdd309",
                                        "entry_id": "7bf6155a-ad9a-3088-95c4-1b95324a36b0",
                                        "glosses": [
                                            "перен. моральное очищение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69da50cc-6bc2-4bd0-aa71-82f02dacbd5e",
                                                "sense_id": "c35524b2-69cc-3c24-8706-10f09fbdd309",
                                                "text": "Вместе с Фомой он шлялся до глубокой ночи по клубам, гостиницам, трактирам, всюду черпая материал для своих писаний, которые он называл «щётками для чистки общественной совести»"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4011ff2d-d88c-3035-bf7a-61f4e809eb76",
                                        "entry_id": "7bf6155a-ad9a-3088-95c4-1b95324a36b0",
                                        "glosses": [
                                            "действие по знач. глаг.: чистить (освобождать от оболочки, кожуры)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9550199-59e4-4030-acfc-a22073f92564",
                                                "sense_id": "4011ff2d-d88c-3035-bf7a-61f4e809eb76",
                                                "text": "После хозяина в номер учинили набег те краснощёкие медхен, которых мы видели за чисткою картофеля."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfd5a557-bb72-3ad5-8b4a-60822298f3b6",
                                        "entry_id": "7bf6155a-ad9a-3088-95c4-1b95324a36b0",
