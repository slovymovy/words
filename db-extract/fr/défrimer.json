                "senses": [
                    {
                        "sense_id": "d02f686f-7c7c-37f8-bec3-d6215dab25ac",
                        "entry_id": "692fad5c-02f3-3dce-80ab-8d4639f6466e",
                        "glosses": [
                            "Regarder le visage de quelqu’un, dévisager."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa98da83-632c-4b9a-9d3c-2e58f31372a9",
                                "sense_id": "d02f686f-7c7c-37f8-bec3-d6215dab25ac",
                                "text": "Ancien truand, je vous le répète, ça se voit à sa frime rapiécée comme une vieille chambre à air, à son naze écrasé, à ses étiquettes en haillons et plus encore à son regard en virgule. Je le défrime complaisamment."
                            },
                            {
                                "example_id": "0ba4ddcf-9bdf-42e1-9297-98287a8bc217",
                                "sense_id": "d02f686f-7c7c-37f8-bec3-d6215dab25ac",
                                "text": "Il restait dans l’entrée, là-bas, comme s’il voulait éviter que je le défrime de trop près."
                            }
                        ]
                    }
                ],
