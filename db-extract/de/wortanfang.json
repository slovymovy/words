                ],
                "senses": [
                    {
                        "sense_id": "15ebaabb-9608-3647-9112-73cce68c42ba",
                        "entry_id": "824acd58-ede9-33c9-9c9a-3d1466a2aca4",
                        "glosses": [
                            "erstes sprachliches Element eines Wortes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c1670f2-e19b-4869-b7a8-b14ca0310297",
                                "sense_id": "15ebaabb-9608-3647-9112-73cce68c42ba",
                                "text": "„Einzelne Vokalbuchstaben am Wortanfang oder -ende werden jedoch nicht abgetrennt.“"
                            },
                            {
                                "example_id": "01ca1ff0-e450-4c06-b9b2-05546387f6b6",
                                "sense_id": "15ebaabb-9608-3647-9112-73cce68c42ba",
                                "text": "Der Buchstabe <ß> kommt im Wortanfang deutscher Wörter nicht vor."
                            },
                            {
                                "example_id": "0d0b1e1b-888f-4bc1-9e73-2778afa0f9de",
                                "sense_id": "15ebaabb-9608-3647-9112-73cce68c42ba",
                                "text": "Der Laut [ŋ] kommt im Wortanfang deutscher Wörter nicht vor."
                            },
                            {
                                "example_id": "39699bbb-32b7-4150-97a9-1b903b45a6c9",
                                "sense_id": "15ebaabb-9608-3647-9112-73cce68c42ba",
                                "text": "„Sie besteht darin, an jedem Wortanfang einen schwungvollen Anstrich zu machen, der in einen waagerechten, gerne mehrfach gewellten Federzug nach rechts übergeht, oft von einigen Höckern oder Zacken nach oben oder unten unterbrochen ist und dann frei ausläuft.“"
                            },
                            {
                                "example_id": "f3b1db7f-58cf-409d-9ff4-caff455a600d",
                                "sense_id": "15ebaabb-9608-3647-9112-73cce68c42ba",
                                "text": "„Mit der Betonung des Wortanfangs wird bereits fast die gesamte Energie für die Aussprache eines Wortes verbraucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
