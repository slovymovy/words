    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ff040a64-1ecb-3c88-8b07-70353e2bff6a",
                    "sense_definition": "Colère extrême et violente qui pousse à des emportements ou à des actes agressifs.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "colere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est entré dans une grande <w>fureur</w> en apprenant cette mauvaise nouvelle."
                        },
                        {
                            "text": "Face aux provocations de son adversaire, il a réagi avec une folle <w>fureur</w>."
                        }
                    ],
                    "synonyms": [
                        "rage",
                        "courroux"
                    ],
                    "antonyms": [
                        "calme",
                        "sérénité"
                    ],
                    "common_phrases": [
                        "entrer en fureur",
                        "accès de fureur"
                    ]
                },
                {
                    "sense_id": "1d7ced18-788b-389d-b383-562f0ae7b0bd",
                    "sense_definition": "Déchaînement violent ou impétuosité destructrice des éléments naturels.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "violence_naturelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux navire a dû affronter la <w>fureur</w> des flots déchaînés pendant la nuit."
                        },
                        {
                            "text": "Les arbres ont été déracinés par la <w>fureur</w> du vent qui soufflait sans répit."
                        }
                    ],
                    "synonyms": [
                        "violence",
                        "déchaînement"
                    ],
                    "antonyms": [
                        "calme",
                        "accalmie"
                    ],
                    "common_phrases": [
                        "fureur des flots",
                        "fureur de la tempête"
                    ]
                },
                {
                    "sense_id": "139270b8-9aae-301e-8160-b7894cdb90e9",
                    "sense_definition": "Passion excessive, démesurée ou engouement extrême pour quelqu'un ou quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "passion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au XVIIIe siècle, la <w>fureur</w> du jeu ruina de nombreuses familles nobles."
                        },
                        {
                            "text": "Il aime la musique avec <w>fureur</w> et passe toutes ses soirées au concert."
