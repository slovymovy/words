            {
                "entry_id": "3d314763-0b53-3cdc-b4b8-dda842491d27",
                "word": "groupie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "85a23993-9c1f-43be-9dd1-059ed10acb71",
                        "entry_id": "3d314763-0b53-3cdc-b4b8-dda842491d27",
                        "tags": [
                            "plural"
                        ],
                        "form": "groupies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "00bbca38-4b05-3a90-86eb-57ae55d71d3a",
                        "entry_id": "3d314763-0b53-3cdc-b4b8-dda842491d27",
                        "glosses": [
                            "Personne gravitant dans l’entourage des célébrités de la musique populaire comme le rock ou la pop."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "346dbb4b-8525-483a-a688-78a439eee50f",
                                "sense_id": "00bbca38-4b05-3a90-86eb-57ae55d71d3a",
                                "text": "T’imagines les bragging rights quand tu remportes la médaille d’or pour le meilleur baiseur au monde ? Ou si tu reviens avec la médaille d’argent comme cunnilingueur de fond ? Il y aurait de la groupie à l’aéroport en revenant!"
                            },
                            {
                                "example_id": "523ab572-e093-4961-89c6-63b02b14a39f",
                                "sense_id": "00bbca38-4b05-3a90-86eb-57ae55d71d3a",
                                "text": "Pamela Des Barres, connue comme groupie des groupes rock dans les années 1960 et 1970, est une femme de lettres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e78f9bb-aca9-45fb-9306-42fe58891529",
                        "source_entry_id": "3d314763-0b53-3cdc-b4b8-dda842491d27",
                        "source_sense_id": "00bbca38-4b05-3a90-86eb-57ae55d71d3a",
                        "source_sense_description": "Jeune homme/fille gravitant dans l’entourage des célébrités",
                        "target_lang_word": "Groupie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Groupie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c8619a1-a98f-3139-b479-1ce990d906cf",
                                        "entry_id": "2ab689d7-f553-3603-811a-f86509c71c0d",
                                        "glosses": [
                                            "enthusiastischer, meist weiblicher Anhänger/Fan vor allem von Musikgruppen, aber auch von anderen bewunderten Personen oder Gruppen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de60b8fe-1f97-4355-bd18-550fdd22c30a",
                                                "sense_id": "5c8619a1-a98f-3139-b479-1ce990d906cf",
                                                "text": "„Gerade noch schien er Herr der Hotelhalle zu sein, da bricht es auf ihn herein. Sechs Musiker, ein Fahrer, ein Techniker, ein Komiker und ein Tourneeleiter, also zehn Personen, zwölf Koffer, fünf Taschen, sechs Großrauminstrumente und meistens acht bis neun wartende Groupies…“"
                                            },
                                            {
                                                "example_id": "e3aaaf9e-029e-4bc1-a8b0-d33acae95c87",
                                                "sense_id": "5c8619a1-a98f-3139-b479-1ce990d906cf",
                                                "text": "„Ja, wäre er eine durch Film und Fernsehen wie Presse bekannte Prominenz gewesen, so hätte sich kein Rätsel ergeben, das willige, stürmische Einverständnis der Mädchen wäre als Verhaltensweise von Groupies verständlich geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52ec25b0-3cfd-48b1-b0b4-b71e0964819c",
                        "source_entry_id": "3d314763-0b53-3cdc-b4b8-dda842491d27",
                        "source_sense_id": "00bbca38-4b05-3a90-86eb-57ae55d71d3a",
                        "source_sense_description": "Jeune homme/fille gravitant dans l’entourage des célébrités",
                        "target_lang_word": "groupie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "groupie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3141f1ea-7e80-3a55-9ac3-1449814ee16e",
                                        "entry_id": "9170902e-8534-3850-a0ae-02865f1c54b2",
                                        "glosses": [
                                            "A fan, especially a young female fan of a male singer or rock group; a person who seeks intimacy (most often physical, sometimes emotional) with a celebrity, usually a rock 'n' roll artist or band member."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3724feb-ec2a-4dd1-a7a3-ba980327fe79",
                                                "sense_id": "3141f1ea-7e80-3a55-9ac3-1449814ee16e",
                                                "text": "In mainstream rock youth culture, female fans had only submissive roles in the consumption of rock music: they could be teenyboppers, and when they grew older, groupies, with the groupie role providing a real-life extension of the sexualized hero worship of the teenybopper."
                                            },
                                            {
                                                "example_id": "88345e38-28be-4676-b73e-487ecd4ddd97",
                                                "sense_id": "3141f1ea-7e80-3a55-9ac3-1449814ee16e",
                                                "text": "2000 October, The 100 Sleaziest Moments in Rock, Spin, page 102,\nAlthough Pamela Des Barres, rock′s most famous groupie, was passed around like a loose joint at a be-in, she maintains today, “There was no hierarchy. The groupies were not considered less than the musicians. We were muses.”"
                                            },
                                            {
                                                "example_id": "1d1b53fd-ad61-4379-898a-5fe4ef205aed",
                                                "sense_id": "3141f1ea-7e80-3a55-9ac3-1449814ee16e",
                                                "text": "The groupie experience from what I′ve seen is quite similar to the experiences I′ve had as the “fat girl,” who had the good looking guy give her attention behind closed doors but never had the opportunity to be the gal on his arm, and it is that emotional integrity I brought to the book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "befa9c40-f5f6-3654-9906-a1de025bfeeb",
                                        "entry_id": "9170902e-8534-3850-a0ae-02865f1c54b2",
                                        "glosses": [
                                            "Any dedicated fan of something."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbe902fc-4b96-49f6-8fd8-440805bd6a23",
                                                "sense_id": "befa9c40-f5f6-3654-9906-a1de025bfeeb",
                                                "text": "A bit of an eclipse groupie, he had paid the thirty guineas fee to join the BAA's first expedition, to Norway, in 1896."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "groupie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b54ceaa-0bbc-33ec-ab22-1e32446f4921",
                                        "entry_id": "d19ee1d6-7572-3333-a334-b51d0bd4d67f",
                                        "glosses": [
                                            "A group photo including the photographer; a group self-portrait."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "groupie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7423f0a-5050-3d58-bca1-ba38d92f4bf2",
                                        "entry_id": "2d03b945-675d-3d79-ba9c-39d646f713c5",
                                        "glosses": [
                                            "A group captain."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "baf16c2b-0278-42d7-8b17-8bc2aba82a25",
                                                "sense_id": "d7423f0a-5050-3d58-bca1-ba38d92f4bf2",
                                                "text": "In traditional military fashion our \"Groupie\" (group captain) called us to attention, exchanged salutes with his German opposite number, then handed the parade over to him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
