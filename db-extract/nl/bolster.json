                                        "entry_id": "3193d9f7-f7b8-3adf-8463-9683567bc7b3",
                                        "glosses": [
                                            "The dry, leafy or stringy exterior of certain vegetables or fruits, which must be removed before eating the meat inside."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "350dcbc8-2812-48bc-bffd-5a1a2dbc8864",
                                                "sense_id": "d339771a-0e64-3522-9752-791c75324b68",
                                                "text": "A coconut has a very thick husk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18d0ad0a-8ddb-3000-af9a-6d110073a4b0",
                                        "entry_id": "3193d9f7-f7b8-3adf-8463-9683567bc7b3",
                                        "glosses": [
                                            "Any form of useless, dried up, and subsequently worthless exterior of something."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a45c9d38-80a0-4c48-bfcb-db655bfdcfa6",
                                                "sense_id": "18d0ad0a-8ddb-3000-af9a-6d110073a4b0",
                                                "text": "His attorney was a dried-up husk of a man."
                                            },
                                            {
                                                "example_id": "b458391b-4ae7-487a-af25-0a8da314f675",
                                                "sense_id": "18d0ad0a-8ddb-3000-af9a-6d110073a4b0",
                                                "text": "Unlike dogs, cats have retractable claws which do not wear down when walking. Instead, cats pull the old husk of nail from their claws by raking them down some convenient piece of wood, to expose a new sharp claw underneath."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdd3ae70-db44-3614-a620-cb071123df44",
                                        "entry_id": "3193d9f7-f7b8-3adf-8463-9683567bc7b3",
                                        "glosses": [
                                            "The supporting frame of a run of millstones."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "husk",
                                "target_lang_code": "en",
