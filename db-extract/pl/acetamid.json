                                "sense_id": "39933c9d-aaf1-32fd-ac8f-16ea122ecc7c",
                                "text": "Acetamid otrzymywany jest poprzez ogrzewanie octanu amonu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
