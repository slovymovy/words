                    },
                    {
                        "translation_id": "241f8079-619d-4d08-abd8-e4472fd61f1e",
                        "source_entry_id": "eed620d6-b653-3acc-9bee-10d099a907db",
                        "source_sense_id": "a7d30333-9efb-3905-951c-33de69c7816f",
