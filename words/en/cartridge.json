{
    "word_family": [
        "cartridgeless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e2fa120f-b9c5-31a1-abca-a26d7ce7e294",
                    "sense_definition": "A replaceable container that holds ink or toner for use in a computer printer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "replaceable_containers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The printer stopped working because the black ink <w>cartridge</w> was completely empty.",
                            "target_lang_translations": {
                                "ru": "Принтер перестал работать, потому что <w>картридж</w> с черными чернилами был совершенно пуст."
                            }
                        },
                        {
                            "text": "You should always keep a spare ink <w>cartridge</w> in the office cabinet for emergencies.",
                            "target_lang_translations": {
                                "ru": "На экстренный случай в офисном шкафу всегда стоит держать запасной чернильный <w>картридж</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "inkjet",
                        "toner"
                    ],
                    "common_phrases": [
                        "ink cartridge",
                        "toner cartridge",
                        "replace the cartridge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сменный контейнер, содержащий чернила или тонер для использования в компьютерном принтере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "картридж",
                                "target_lang_sense_clarification": "для принтера"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b60a6cad-659a-302d-ae88-63006b67716b",
                    "sense_definition": "A single unit of ammunition for a firearm, consisting of a casing, primer, gunpowder, and a bullet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ammunition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier loaded a fresh <w>cartridge</w> into his rifle before moving toward the target.",
                            "target_lang_translations": {
                                "ru": "Солдат зарядил новый <w>патрон</w> в винтовку, прежде чем выдвинуться к цели."
                            }
                        },
                        {
                            "text": "Police found a spent rifle <w>cartridge</w> on the ground near the entrance of the building.",
                            "target_lang_translations": {
                                "ru": "Полиция нашла на земле у входа в здание стреляный винтовочный <w>патрон</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "round",
                        "shell"
                    ],
                    "common_phrases": [
                        "rifle cartridge",
                        "spent cartridge",
                        "blank cartridge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица боеприпаса для огнестрельного оружия, состоящая из гильзы, капсюля, пороха и пули."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "патрон",
                                "target_lang_sense_clarification": "боеприпас"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41ab7161-316b-39d7-921d-cc2ac15c8299",
                    "sense_definition": "A removable plastic case containing a memory chip, used to load games or software into a console or computer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "replaceable_containers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I remember blowing on the game <w>cartridge</w> to make it work in my old console.",
                            "target_lang_translations": {
                                "ru": "Я помню, как дул на игровой <w>картридж</w>, чтобы он заработал в моей старой приставке."
                            }
                        },
                        {
                            "text": "The vintage <w>cartridge</w> contained a rare version of the game that collectors highly value.",
                            "target_lang_translations": {
                                "ru": "Винтажный <w>картридж</w> содержал редкую версию игры, которую высоко ценят коллекционеры."
                            }
                        }
                    ],
                    "synonyms": [
                        "game card",
                        "cassette"
                    ],
                    "common_phrases": [
                        "game cartridge",
                        "software cartridge",
                        "video game cartridge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Съемный пластиковый корпус с микросхемой памяти, используемый для загрузки игр или программного обеспечения в консоль или компьютер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "картридж",
                                "target_lang_sense_clarification": "игровой"
                            },
                            {
                                "target_lang_word": "кассета",
                                "target_lang_sense_clarification": "для приставки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a64b637f-7d25-3e2a-8345-f3e9d331c19b",
                    "sense_definition": "A modular, interchangeable part of a larger machine that can be easily installed or removed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mechanical_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plumber had to replace the ceramic <w>cartridge</w> inside the leaky faucet to stop the dripping.",
                            "target_lang_translations": {
                                "ru": "Сантехнику пришлось заменить керамический <w>картридж</w> внутри протекающего крана, чтобы остановить течь."
                            }
                        },
                        {
                            "text": "This industrial filter uses a disposable <w>cartridge</w> that must be changed every three months.",
                            "target_lang_translations": {
                                "ru": "В этом промышленном фильтре используется сменный <w>картридж</w>, который необходимо менять каждые три месяца."
                            }
                        }
                    ],
                    "synonyms": [
                        "module",
                        "insert"
                    ],
                    "common_phrases": [
                        "faucet cartridge",
                        "filter cartridge",
                        "replacement cartridge"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Модульная, взаимозаменяемая часть механизма, которую можно легко установить или снять."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "картридж",
                                "target_lang_sense_clarification": "технический узел, например, в смесителе"
                            },
                            {
                                "target_lang_word": "сменный блок",
                                "target_lang_sense_clarification": "деталь механизма"
                            },
                            {
                                "target_lang_word": "фильтр-патрон",
                                "target_lang_sense_clarification": "для очистки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46b24973-967f-36ee-9e9e-cea6c98d0dd6",
                    "sense_definition": "A case containing magnetic tape used for storing or backing up digital data.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "data_storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The IT department stores old server backups on a magnetic tape <w>cartridge</w> in a fireproof safe.",
                            "target_lang_translations": {
                                "ru": "ИТ-отдел хранит старые резервные копии серверов на <w>кассете</w> с магнитной лентой в огнестойком сейфе."
                            }
                        },
                        {
                            "text": "The system generates a catalogue of files stored on the <w>cartridge</w> selected by the user.",
                            "target_lang_translations": {
                                "ru": "Система создает каталог файлов, хранящихся на <w>картридже</w>, выбранном пользователем."
                            }
                        }
                    ],
                    "synonyms": [
                        "cassette",
                        "tape"
                    ],
                    "common_phrases": [
                        "tape cartridge",
                        "data cartridge",
                        "backup cartridge"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "referring to older storage technology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Корпус с магнитной лентой, используемый для хранения или резервного копирования цифровых данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "картридж",
                                "target_lang_sense_clarification": "с магнитной лентой"
                            },
                            {
                                "target_lang_word": "кассета",
                                "target_lang_sense_clarification": "для стримера"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d874e4eb-b9ec-33e2-9f85-b1cca1903abb",
                    "sense_definition": "A small paper container or wrapper used for holding specific items or materials.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "replaceable_containers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The apprentice was instructed to wrap each metal type in a paper <w>cartridge</w> for protection.",
                            "target_lang_translations": {
                                "ru": "Подмастерью было поручено завернуть каждую металлическую литеру в бумажный <w>патрон</w> для защиты."
                            }
                        },
                        {
                            "text": "Historical documents describe how workers would paper up each sort in a <w>cartridge</w> by itself.",
                            "target_lang_translations": {
                                "ru": "Исторические документы описывают, как рабочие упаковывали каждый сорт отдельно в бумажный <w>патрон</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "packet",
                        "wrapper"
                    ],
                    "common_phrases": [
                        "paper cartridge"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой бумажный контейнер или обертка, используемая для хранения определенных предметов или материалов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "патрон",
                                "target_lang_sense_clarification": "бумажный сверток"
                            },
                            {
                                "target_lang_word": "кулек",
                                "target_lang_sense_clarification": "бумажная упаковка"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
