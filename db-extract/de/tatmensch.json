                ],
                "translations": [
                    {
                        "translation_id": "60bb2e67-5da2-49f5-befe-b8bbaf8b1d8e",
                        "source_entry_id": "6774e243-ded4-32b5-bbae-687ace3d2915",
                        "source_sense_id": "276aceba-ae92-35ea-b89b-f08a890e21da",
                        "source_sense_description": "Person, die darauf ausgerichtet ist, Dinge in die Tat umzusetzen",
                        "target_lang_word": "man of action",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "man of action",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0d32f60-3fff-36fb-97f9-8cb95dbde11a",
                                        "entry_id": "fc254390-86bc-3f4d-a027-36b748e1fc73",
                                        "glosses": [
                                            "One who acts or reacts boldly, without hesitation, and often without forethought, especially in situations which are adventurous or dangerous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "309c2095-eccb-49a9-9a31-17775f640748",
                                                "sense_id": "f0d32f60-3fff-36fb-97f9-8cb95dbde11a",
                                                "text": "\"I have heard that the Scots are good men of war,\" said Hordle John. \"For axemen and for spearmen I have not seen their match,\" the archer answered. […] \"And the French?\" asked Alleyne, to whom the archer's light gossip had all the relish that the words of the man of action have for the recluse."
                                            },
                                            {
                                                "example_id": "38975db8-3b39-4119-b3d1-ec856fc4cc5f",
                                                "sense_id": "f0d32f60-3fff-36fb-97f9-8cb95dbde11a",
                                                "text": "The third was a man of action, a combatant, a bold and impatient executive, breathing fire and steel."
                                            },
                                            {
                                                "example_id": "c6f83d7f-29a1-49d9-8a57-c02ea114e7ea",
                                                "sense_id": "f0d32f60-3fff-36fb-97f9-8cb95dbde11a",
                                                "text": "The world found out last week who led the daring, destructive noonday air raid on Japan last month[:] […] pugnacious Brigadier General James Harold Doolittle, 45, speed flyer, engineer, scholar and man of action."
                                            },
                                            {
                                                "example_id": "b2986272-43b2-4e5a-8464-761b0f8425a3",
                                                "sense_id": "f0d32f60-3fff-36fb-97f9-8cb95dbde11a",
                                                "text": "Patrick Leigh Fermor […] was a man of letters but also, like his hero Byron, a man of action—a war hero and a restless adventurer, who even swam the Hellespont when he was 69."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
