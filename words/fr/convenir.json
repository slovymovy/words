{
    "word_family": [
        "convenable",
        "convenablement",
        "convenance",
        "convention",
        "conventionnel",
        "inconvénient"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1681dfdb-7bc1-3a48-9c11-782130c91e04",
                    "sense_definition": "Être agréable, approprié ou pratique pour quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "adequation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Est-ce que cette date de réunion vous <w>convient</w> ?"
                        },
                        {
                            "text": "Ce nouvel appartement ne lui <w>convient</w> pas du tout."
                        }
                    ],
                    "synonyms": [
                        "correspondre",
                        "agréer"
                    ],
                    "common_phrases": [
                        "si cela vous convient",
                        "convenir à tout le monde"
                    ]
                },
                {
                    "sense_id": "1fa3c29e-2965-34c4-930a-b66a5ca25eec",
                    "sense_definition": "Se mettre d'accord sur une décision commune, fixer ensemble.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>convenir</w> d'une date pour signer le contrat."
                        },
                        {
                            "text": "Les deux parties ont <w>convenu</w> d'un prix de vente raisonnable."
                        }
                    ],
                    "synonyms": [
                        "s'accorder",
                        "décider"
                    ],
                    "common_phrases": [
                        "convenir d'une date",
                        "convenir d'un rendez-vous"
                    ]
                },
                {
                    "sense_id": "d618ef0b-d97d-3643-aa58-e5814813ca59",
                    "sense_definition": "Reconnaître ou admettre la réalité d'un fait.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je dois <w>convenir</w> que cette tâche est plus complexe que prévu."
                        },
                        {
                            "text": "Il a fini par en <w>convenir</w> après une longue discussion."
                        }
                    ],
                    "synonyms": [
                        "admettre",
                        "reconnaître",
                        "avouer"
                    ],
                    "antonyms": [
                        "disconvenir"
                    ],
                    "common_phrases": [
                        "en convenir",
                        "convenir de son erreur"
                    ]
                },
                {
                    "sense_id": "3112cc2f-e3b5-33e9-b0ea-c69ad9faf0a3",
                    "sense_definition": "Être convenable, séant ou opportun dans une situation donnée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adequation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de commencer le travail, il <w>convient</w> de vérifier les instructions."
                        },
                        {
                            "text": "Dans cette situation délicate, il ne vous <w>convient</w> pas d'intervenir."
                        }
                    ],
                    "synonyms": [
                        "falloir",
                        "importer"
                    ],
                    "common_phrases": [
                        "il convient de",
                        "comme il convient"
                    ]
                },
                {
                    "sense_id": "287990f6-8304-379f-8fe5-bf9cf6cdc3cc",
                    "sense_definition": "Être faits pour s'entendre, être bien accordés mutuellement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "adequation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré leurs différences, ces deux collaborateurs se <w>conviennent</w> parfaitement."
                        },
                        {
                            "text": "Ils ont vite compris qu'ils ne se <w>convenaient</w> pas pour vivre ensemble."
                        }
                    ],
                    "synonyms": [
                        "s'entendre",
                        "s'accorder"
                    ],
                    "common_phrases": [
                        "se convenir mutuellement"
                    ]
                }
            ]
        }
    ]
}