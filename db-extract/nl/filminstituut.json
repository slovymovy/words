                            {
                                "example_id": "b5a5c9b2-6d4c-437a-b1a3-0b98d70dc0b8",
                                "sense_id": "7a5a5dde-195c-3f3a-97d4-dd5da8c17a78",
                                "text": "19.00 uur: Begin van de koningsvaart. Bij filminstituut EYE aan de noordoever van het IJ gaan koning Willem-Alexander en Máxima aan boord. Tijdens de vaartocht over het IJ zijn er optredens van artiesten en kan het publiek het koningspaar toezwaaien. Het paar wordt begeleid door een botenparade."
                            },
                            {
                                "example_id": "d1ab9780-a878-4a88-bb82-14192552c474",
                                "sense_id": "7a5a5dde-195c-3f3a-97d4-dd5da8c17a78",
                                "text": "Mediahistoricus Huub Wijfjes ziet het met verbijstering aan. \"We hebben instituten als Beeld en Geluid en filminstituut Eye opgericht om te voorkomen dat we niet meer de fouten van de jaren 60 en 70 zouden maken toen er van alles werd weggegooid. Nu dreigt toch weer hetzelfde te gebeuren. Ik zie gewoon mijn bronnen verloren gaan.\""
                            }
                        ]
                    }
