                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c73dc6a6-890e-455c-9370-d793a4848f51",
                                "sense_id": "c632130c-cddd-3fe4-a36b-7c4d134a3818",
                                "text": "W Warszawie odbył się pierwszy ślub pastafariański"
                            },
                            {
                                "example_id": "f1725ebb-4ca8-4a2c-86fc-43cb505223df",
                                "sense_id": "c632130c-cddd-3fe4-a36b-7c4d134a3818",
                                "text": "W sobotę w Nowej Zelandii odbyła się pierwsza, formalnie zatwierdzona i wiążąca pastafariańska ceremonia ślubna"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79b4e7bc-2bac-41a8-9880-4e8ddbb83760",
                        "source_entry_id": "64c84ebe-862f-3f8d-849e-43d5ef30fb28",
                        "source_sense_id": "c632130c-cddd-3fe4-a36b-7c4d134a3818",
                        "target_lang_word": "Pastafarian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pastafarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a90f7ef-b0c4-3a18-8ba0-bffd04f3e11f",
                                        "entry_id": "15f425a1-ee16-3c01-9308-f3feb83eae30",
                                        "glosses": [
                                            "Of or relating to Pastafarianism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93668a4a-be38-4281-9444-f1615f837cc5",
                                                "sense_id": "4a90f7ef-b0c4-3a18-8ba0-bffd04f3e11f",
                                                "text": "Something flashed by Theo and he spun to see Gabe Fenton running hell-bent-for-leather at the window, holding before him a long stainless-steel pan full of lasagna, evidently intent upon diving through the window in a pastafarian act of self-sacrifice."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Pastafarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c4ebc64-f5b5-33cc-b380-7f5a5b792c51",
                                        "entry_id": "6d7cdf32-e682-3bbc-bb3c-18967f336e31",
                                        "glosses": [
                                            "A claimed follower of Pastafarianism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eee7ac7-35fb-490e-87bb-c0a945c44c66",
                                                "sense_id": "7c4ebc64-f5b5-33cc-b380-7f5a5b792c51",
                                                "text": "\"Pastafarians\" — as followers call themselves — can also download computer screen-savers and wallpaper (one says: \"WWFSMD?\") and can sample photographs that show \"visions\" of the divinity himself."
                                            },
                                            {
                                                "example_id": "a5da97e1-13f9-44de-bd7a-64963b4d6856",
                                                "sense_id": "7c4ebc64-f5b5-33cc-b380-7f5a5b792c51",
                                                "text": "Pirates are revered as the original Pastafarians, and Pastafarians facetiously assert that a steady decline in the number of pirates has resulted in a significant rise in global temperature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
