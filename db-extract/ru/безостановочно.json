                                    {
                                        "sense_id": "b57111cb-32df-399d-b33c-2a81e071db8b",
                                        "entry_id": "67d61252-9945-34ea-a8f4-233d95259065",
                                        "glosses": [
                                            "Without pause."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a3f9061-309d-45bb-812d-f6df62058290",
                                                "sense_id": "b57111cb-32df-399d-b33c-2a81e071db8b",
                                                "text": "The river continuously flows to the sea, it will never pause to let us cross on dry land."
                                            },
                                            {
                                                "example_id": "5bf09a40-14e7-44b1-b69f-518f212f4abe",
                                                "sense_id": "b57111cb-32df-399d-b33c-2a81e071db8b",
                                                "text": "In the year 1633, the Bridget Nuns, near Xanthus, behaved like sheep, jumping about and bleating continuously."
                                            },
                                            {
                                                "example_id": "05a70050-46b3-4ba7-889e-f8bdfbe2c66c",
                                                "sense_id": "b57111cb-32df-399d-b33c-2a81e071db8b",
                                                "text": "\"We continuously strive to improve our processes and indeed have updated our systems accordingly. Ultimately, however, it is for the student to make a proper declaration to SLC [Student Loans Company]^([sic]) to draw down funding,\" LSST said in a statement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d469588d-ecc9-4879-b82c-e3aac80482db",
                        "source_entry_id": "3b6dfb04-a5df-3368-aca2-c4e3692ce744",
                        "source_sense_id": "8948278b-873e-398f-a4f7-f11e396778e6",
                        "target_lang_word": "unaufhörlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unaufhörlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ac595a9-6826-3671-be3e-a81ee58ea6c5",
                                        "entry_id": "cb7ade97-d6a7-361b-9de6-c8f6b6c37dfe",
                                        "glosses": [
                                            "ohne Unterbrechungen und kein Ende erahnen lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91289c14-d0bf-4572-97f1-d41ce5bb18e0",
                                                "sense_id": "1ac595a9-6826-3671-be3e-a81ee58ea6c5",
                                                "text": "Das Wasser fließt unaufhörlich dem Meer entgegen."
                                            },
                                            {
                                                "example_id": "0306a067-5707-45a9-9980-fd32bb90c1f2",
                                                "sense_id": "1ac595a9-6826-3671-be3e-a81ee58ea6c5",
                                                "text": "„Unzählige Gäste waren schon im Landhaus eingetroffen, aber es wurden noch immer mehr erwartet, und auf dem endlos sich hinstreckenden Weg von Kalimas nach dem Bahnhof war es ein unaufhörliches Kommen und Gehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17d1dc73-56e0-40a0-b927-364e8896ea24",
                        "source_entry_id": "3b6dfb04-a5df-3368-aca2-c4e3692ce744",
                        "source_sense_id": "8948278b-873e-398f-a4f7-f11e396778e6",
                        "target_lang_word": "ununterbrochen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ununterbrochen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa507234-bc4d-3cf8-aed2-a808c0c4e167",
                                        "entry_id": "62cd82da-0169-3e3d-b3e5-444ef3908a79",
                                        "glosses": [
                                            "fortwährend, ohne zwischendurch auszusetzen oder aufzuhören"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0fbbc4c-0ff6-4be9-b56f-bf33e21de6de",
                                                "sense_id": "fa507234-bc4d-3cf8-aed2-a808c0c4e167",
                                                "text": "Seit zwei Tagen regnet es ununterbrochen."
                                            },
                                            {
                                                "example_id": "8e522347-0b26-4bc1-884c-a50ebcf5c72a",
                                                "sense_id": "fa507234-bc4d-3cf8-aed2-a808c0c4e167",
                                                "text": "Ein 28-jähriger Südkoreaner ist nach 49 Stunden ununterbrochenen Spielens in einem Internetcafé gestorben."
                                            },
                                            {
                                                "example_id": "5a323ce0-35fc-4794-b9f1-151fa7bb22a6",
                                                "sense_id": "fa507234-bc4d-3cf8-aed2-a808c0c4e167",
                                                "text": "„Publius Cornelius Scipio kommandierte zwischen 211 und 201 v.Chr. ununterbrochen große Armeen, ähnlich wie Titus Quinctius Flamininus, der zwischen 198 und 183 v.Chr. maßgeblich Einfluss auf die römische Ostpolitik ausübte.“"
                                            },
                                            {
                                                "example_id": "eaebcd8a-7e5d-4c52-b4a1-8d4906f7fa87",
                                                "sense_id": "fa507234-bc4d-3cf8-aed2-a808c0c4e167",
                                                "text": "„Anders als fast alle männlichen Priester befanden sich die Vestalinnen ununterbrochen im Gottesdienst.“"
                                            },
                                            {
                                                "example_id": "bbc20272-d066-4a94-a26e-f32d8a91e2e9",
                                                "sense_id": "fa507234-bc4d-3cf8-aed2-a808c0c4e167",
                                                "text": "[Anm.: Die jüdischen Ärztin Lilli Jahn in ihrem letzten Brief aus Auschwitz:] „»Meine Gedanken sind ununterbrochen immer bei Euch. Hoffentlich seid Ihr alle gesund. Ich grüße und küsse jeden einzelnen tausend Mal.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05226e79-94f5-44a6-a7de-a1c3e17ff7bf",
                        "source_entry_id": "3b6dfb04-a5df-3368-aca2-c4e3692ce744",
                        "source_sense_id": "8948278b-873e-398f-a4f7-f11e396778e6",
                        "target_lang_word": "unablässig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unablässig",
