                "senses": [
                    {
                        "sense_id": "0f35cd49-4659-34e2-9a60-4d25ff53a03b",
                        "entry_id": "0a0db878-babd-317a-9998-8b2574c0e1ad",
                        "glosses": [
                            "Action de canoter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7696fece-c5b4-40c1-b04f-5a420e1333f6",
                                "sense_id": "0f35cd49-4659-34e2-9a60-4d25ff53a03b",
                                "text": "Nous ne voulons pas entrer dans la vie privée de beaucoup de canotiers; mais à en croire les apparences, le canotage ne serait, pour quelques amateurs, qu'un prétexte d'orgies, une occasion de plaisirs faciles, au lieu d'un amusement salutaire et convenable à la dignité de l'homme."
                            },
                            {
                                "example_id": "40cbd7ce-682a-485c-8768-e3780790e2dc",
                                "sense_id": "0f35cd49-4659-34e2-9a60-4d25ff53a03b",
                                "text": "Je l'entends dans les mêmes bouches depuis la constitution de la Ligue pour l'éducation physique à propos des rallie-papier, du canotage et du bicycle."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffdb4627-5cab-3396-ad0d-476f9c863230",
                        "entry_id": "0a0db878-babd-317a-9998-8b2574c0e1ad",
                        "glosses": [
                            "Activité nautique se référant à l'utilisation d'un canot, embarcation dérivée des peuples amérindiens."
                        ],
