                "senses": [
                    {
                        "sense_id": "a80fcfe8-9611-3125-a0f7-97e6b518175d",
                        "entry_id": "12c7ecdd-789f-3a47-a553-3e3607c4cef9",
                        "glosses": [
                            "Écouter un livre audio."
                        ],
                        "tags": [
                            "Livre",
                            "Audiovisuel"
                        ],
                        "examples": [
                            {
                                "example_id": "6eff36e1-53bf-4a1d-9c46-692839e73523",
                                "sense_id": "a80fcfe8-9611-3125-a0f7-97e6b518175d",
                                "text": "Grâce à Audiolib et Netgalley, j’ai eu la chance de pouvoir écoulire ce roman en audio."
                            },
                            {
                                "example_id": "3a2a4ab2-d90b-4c10-b103-5fde032f65b4",
                                "sense_id": "a80fcfe8-9611-3125-a0f7-97e6b518175d",
                                "text": "Plus sérieusement j’ai déjà croisé quelques personnes qui en écoutaient, mais absolument pas le genre à « écoulire » de la SF, alors Warhammer…"
                            },
                            {
                                "example_id": "b4d6bc28-66e7-400e-94f4-45e9be43e01f",
                                "sense_id": "a80fcfe8-9611-3125-a0f7-97e6b518175d",
                                "text": "À condition de posséder des écouteurs sans-fil, vous pourrez donc « écoulire » des livres audio sur votre montre sans devoir trainer votre iPhone."
                            },
                            {
                                "example_id": "1b2f1a8d-bda1-4d98-9ca8-5304c32f83b8",
                                "sense_id": "a80fcfe8-9611-3125-a0f7-97e6b518175d",
                                "text": "Je l’ai \"écoulu\" et j’aurais presque aimé avoir les airs d’opéra pendant la lecture."
                            }
                        ]
                    }
