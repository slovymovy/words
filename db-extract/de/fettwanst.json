                "senses": [
                    {
                        "sense_id": "7f16864c-d96a-3ad9-bf34-65ad42049253",
                        "entry_id": "6ee3193d-4a39-3067-b711-6deefcdaaf1e",
                        "glosses": [
                            "dicker Bauch"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory",
                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "c8d7edfb-f7e6-488d-b5e9-9a304beaa48b",
                                "sense_id": "7f16864c-d96a-3ad9-bf34-65ad42049253",
                                "text": "Sein Fettwanst sprengt ihm fast die Hemdknöpfe weg."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4c064bc0-0632-3f6c-b627-42a124dc68ff",
                        "entry_id": "6ee3193d-4a39-3067-b711-6deefcdaaf1e",
                        "glosses": [
                            "Person mit einem dicken Bauch"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory",
                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "84852774-d712-4b32-9466-1974c1aad9cf",
                                "sense_id": "4c064bc0-0632-3f6c-b627-42a124dc68ff",
                                "text": "Unser Nachbar ist ein unsympathischer, fauler Fettwanst."
                            },
                            {
                                "example_id": "111c6546-9903-4b91-98c6-6a28b4af621f",
                                "sense_id": "4c064bc0-0632-3f6c-b627-42a124dc68ff",
                                "text": "„Der Fettwanst schenkte sich einen Krug Bier nach dem anderen ein und tat sich an Kutteln mit Kartoffelbrei gütlich.“"
                            },
                            {
                                "example_id": "49ba5433-865d-4b08-adac-f38b4ab38745",
                                "sense_id": "4c064bc0-0632-3f6c-b627-42a124dc68ff",
                                "text": "„Das hatte der Fettwanst herausgefunden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
