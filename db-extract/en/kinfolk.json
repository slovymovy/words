                        "target_lang_word": "Verwandtschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verwandtschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da2a67c9-94ba-3201-8822-632cff3600ad",
                                        "entry_id": "00dfaf51-53c3-3866-a4a8-195666db4dd2",
                                        "glosses": [
                                            "die Tatsache, miteinander verwandt zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e18e5f7-0a09-4928-83f4-0120edbb3e0a",
                                                "sense_id": "da2a67c9-94ba-3201-8822-632cff3600ad",
                                                "text": "Die Verwandtschaft zwischen den beiden ist nicht sehr eng."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "403abb5c-f670-35af-99c9-a21f995838d1",
                                        "entry_id": "00dfaf51-53c3-3866-a4a8-195666db4dd2",
                                        "glosses": [
                                            "Personen, die miteinander oder mit jemandem verwandt sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f7abc43-af8b-4963-9a60-5247ad12847a",
                                                "sense_id": "403abb5c-f670-35af-99c9-a21f995838d1",
                                                "text": "Heute kommt unsere Verwandtschaft zu Besuch."
                                            },
                                            {
                                                "example_id": "885515af-0e17-441c-a0cd-aaae8a51d71e",
                                                "sense_id": "403abb5c-f670-35af-99c9-a21f995838d1",
                                                "text": "„Einige Gäste aus der allernächsten Verwandtschaft waren noch geblieben und sassen im grossen Salon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "558eacf6-0daf-3766-9f66-840e2f3cf9b6",
                                        "entry_id": "00dfaf51-53c3-3866-a4a8-195666db4dd2",
                                        "glosses": [
                                            "Ähnlichkeit"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "085493eb-f491-4035-b0cb-97b28300610d",
                                                "sense_id": "558eacf6-0daf-3766-9f66-840e2f3cf9b6",
                                                "text": "Tintenfische heißen wohl deshalb so, weil man zwischen ihnen und den Fischen eine gewisse Verwandtschaft sah."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca966bdf-a53a-4597-925b-f389a9557849",
                        "source_entry_id": "aad6fc33-06a8-31aa-8c22-a480c66b2679",
