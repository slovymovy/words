                ],
                "senses": [
                    {
                        "sense_id": "4d61a0b7-df28-30de-9afc-e6bd10b7d4e4",
                        "entry_id": "37c81170-b2a4-341b-96dd-7c3987644bdd",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5addaf9e-b571-41e4-82b6-f390aca7daee",
                                "sense_id": "4d61a0b7-df28-30de-9afc-e6bd10b7d4e4",
                                "text": "Frau Stehle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "92390991-5a9d-4f2b-b4a6-12cfb692f5f0",
                                "sense_id": "4d61a0b7-df28-30de-9afc-e6bd10b7d4e4",
                                "text": "Herr Stehle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fe7a4318-e348-4054-b938-5ea0d1a2823b",
                                "sense_id": "4d61a0b7-df28-30de-9afc-e6bd10b7d4e4",
                                "text": "Die Stehles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "43c1285e-54bf-4822-96d3-ec3660cb67b3",
                                "sense_id": "4d61a0b7-df28-30de-9afc-e6bd10b7d4e4",
                                "text": "Der Stehle trägt nie die Schals, die die Stehle ihm strickt."
                            },
                            {
                                "example_id": "f2506e1c-cb32-483c-a388-c9a306d01012",
                                "sense_id": "4d61a0b7-df28-30de-9afc-e6bd10b7d4e4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stehle kommt, geht der Herr Stehle.“"
                            },
                            {
                                "example_id": "f5ba7461-3b11-4bda-a3d1-d5c7f8eaae33",
                                "sense_id": "4d61a0b7-df28-30de-9afc-e6bd10b7d4e4",
                                "text": "Stehle kommt und geht."
                            },
                            {
                                "example_id": "56c06f1f-aa52-43d6-94b1-9eb36f6630fe",
                                "sense_id": "4d61a0b7-df28-30de-9afc-e6bd10b7d4e4",
                                "text": "Stehles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
