                "senses": [
                    {
                        "sense_id": "8525e5ba-9f1a-3c78-b83e-dc0262720a94",
                        "entry_id": "0372185a-e770-38ca-b6dd-ede44e465634",
                        "glosses": [
                            "Qui tourmente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "174a5499-f94d-40f4-853e-a4f6021d0ae4",
                                "sense_id": "8525e5ba-9f1a-3c78-b83e-dc0262720a94",
                                "text": "Les nuits sont infinies, visitées de rêves tourmenteurs."
                            }
                        ]
                    }
                ],
                "translations": [],
