                                "target_senses": [
                                    {
                                        "sense_id": "fa41a888-d814-3e65-9190-106bba041911",
                                        "entry_id": "5113f5f4-161a-3333-bd9c-5d4de4df6dc6",
                                        "glosses": [
                                            "Vorliebe für englische Kultureinflüsse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdebbe61-b1b6-4a75-9e72-1768de5261e8",
                                                "sense_id": "fa41a888-d814-3e65-9190-106bba041911",
                                                "text": "„Als roten Faden, der sich durch Mandelas Leben zieht, identifiziert das Buch seine Anglophilie.“"
                                            },
                                            {
                                                "example_id": "a2083dac-f8a8-4433-9073-f45f72d354cd",
                                                "sense_id": "fa41a888-d814-3e65-9190-106bba041911",
                                                "text": "„Fragt man einen England-Fan nach den Gründen für seine Anglophilie, wird man selten an erster Stelle das Wetter oder die Gastronomie genannt bekommen.“"
                                            },
                                            {
                                                "example_id": "ec2868c9-019b-4d56-8823-2ddb42b3b3e2",
                                                "sense_id": "fa41a888-d814-3e65-9190-106bba041911",
                                                "text": "„Die Eltern nennen ihn in ihrer Anglophilie nach dem englischen König Georg V.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
