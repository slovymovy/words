                    },
                    {
                        "translation_id": "c678338a-f1f4-4782-af10-2b0f84219f38",
                        "source_entry_id": "25267997-1384-34fe-a108-6728f6e7eebc",
                        "source_sense_id": "77c1a015-0b65-38ff-ab13-648d3f666e85",
                        "target_lang_word": "traumatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traumatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25fa894d-abff-3f6b-8c84-fe46c2b74f27",
                                        "entry_id": "e969d5cd-e57c-3156-84e0-bcaca6c91dee",
                                        "glosses": [
                                            "Relatif aux plaies, aux blessures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e067ece-9f2b-4dd5-83de-394631c9941d",
                                                "sense_id": "25fa894d-abff-3f6b-8c84-fe46c2b74f27",
                                                "text": "Choc traumatique. — Fièvre traumatique. — Hémorragie traumatique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "371b078e-af28-3151-8557-a2377f7d32b7",
                                        "entry_id": "e969d5cd-e57c-3156-84e0-bcaca6c91dee",
                                        "glosses": [
                                            "Relatif au trauma psychologique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be40baa4-dfb2-44f4-9a6c-1385f2ff4516",
                                                "sense_id": "371b078e-af28-3151-8557-a2377f7d32b7",
                                                "text": "Sans remonter à l’événement traumatique fondateur que furent les massacres de la Saint-Barthélemy, on rappellera que la minorité réformée fut l’objet, sous Louis XIV, d’un « mémoricide » sans précédent : […]."
                                            },
                                            {
                                                "example_id": "914a4828-a701-46a9-957a-09a4562ec47e",
                                                "sense_id": "371b078e-af28-3151-8557-a2377f7d32b7",
                                                "text": "Le thérapeute doit traduire en mots, de façon la plus juste possible, la réalité du vécu traumatique et de ses effets."
                                            },
                                            {
                                                "example_id": "4187f0fc-f172-44fa-845d-0255f100594a",
                                                "sense_id": "371b078e-af28-3151-8557-a2377f7d32b7",
                                                "text": "L’événement traumatique agit à la manière d’un « corps étranger » en soi, qui, même longtemps après l’événement, continue à agir, comme un événement présent. Il reste actuel, sans être intégré ni rattaché aux représentations."
                                            },
                                            {
                                                "example_id": "60653a74-026d-4ef5-b52e-3176b1e1d4e1",
                                                "sense_id": "371b078e-af28-3151-8557-a2377f7d32b7",
                                                "text": "Comment la victime peut-elle accéder aux représentations de l’expérience traumatique si elle n’est plus intimement assurée qu’un autre peut les entendre, les recevoir et y donner de l’importance ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
