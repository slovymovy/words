                "senses": [
                    {
                        "sense_id": "5fb42c6f-b176-30ab-86b0-74b7841e3a7b",
                        "entry_id": "a52c6a3a-881e-3410-aebc-43d1050148e4",
                        "glosses": [
                            "In a specious manner; fallaciously and erroneously, but seeming superficially to be correct."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "168a1967-b33b-47fb-bc78-6ed74ecf5524",
                                "sense_id": "5fb42c6f-b176-30ab-86b0-74b7841e3a7b",
                                "text": "Exasperated, as he might speciously allege, by the injuries of a similar nature, he hastened with a few followers to join the standard, and to betray the confidence, of his too credulous friend."
                            },
                            {
                                "example_id": "fbc32109-2b86-4b98-bc0f-2170f057752e",
                                "sense_id": "5fb42c6f-b176-30ab-86b0-74b7841e3a7b",
                                "text": "And thus his jealous soul speciously argued to excuse the separation of father and child."
                            },
                            {
                                "example_id": "fa5109a9-213d-440b-ae04-cad56369b82c",
                                "sense_id": "5fb42c6f-b176-30ab-86b0-74b7841e3a7b",
                                "text": "Once viewed—however speciously—as an escape from the wider world, American sports and politics have been explicitly entwined since athletes began protesting civil rights injustices, prodding their organisations to take a stance amid the polarising rise to power of Donald Trump."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a661409-d6df-48c9-882b-52754b8a95c1",
                        "source_entry_id": "a52c6a3a-881e-3410-aebc-43d1050148e4",
                        "source_sense_id": "5fb42c6f-b176-30ab-86b0-74b7841e3a7b",
                        "source_sense_description": "Translations",
                        "target_lang_word": "vordergründig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
