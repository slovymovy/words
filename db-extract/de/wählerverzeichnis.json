                    {
                        "translation_id": "45a927d2-4f2b-4919-9c87-9cb270a52960",
                        "source_entry_id": "a5f14705-7da5-3066-b648-ec6a25a55ff1",
                        "source_sense_id": "548f0ce0-0645-361b-9a22-36f5ba1a1309",
                        "source_sense_description": "Verzeichnis, in das alle wahlberechtigten Personen eingetragen sind",
                        "target_lang_word": "liste électorale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liste électorale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6e59421-fdd9-39d5-82c5-b3a3a2cd256c",
                                        "entry_id": "a2e73e5f-297c-3046-b8f6-14ace6b053c3",
                                        "glosses": [
                                            "Liste des citoyens aptes à voter lors d’une élection, mise à jour par le soin des mairies de chaque commune de France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "533c4414-4db6-4966-b9ac-576c1a63ad90",
                                                "sense_id": "e6e59421-fdd9-39d5-82c5-b3a3a2cd256c",
                                                "text": "La participation au vote est subordonnée à l’inscription préalable de la personne sur la liste électorale d’une commune."
                                            },
                                            {
                                                "example_id": "a1fa9d13-e67e-4274-9876-2401fe42cb79",
                                                "sense_id": "e6e59421-fdd9-39d5-82c5-b3a3a2cd256c",
                                                "text": "C’est un fait très caractéristique, nous l’avons vu, que, ni dans les listes électorales de 1790, ni dans les rôles des tailles, ni dans les registres d’état-civil antérieur à la Révolution, on ne trouve le terme de « cultivateur ». On trouve, par contre, toujours une divisions tripartie en laboureurs (ou fermier), bordagers (ou, dans le sud-ouest, closiers), journaliers. Éventuellement s’y ajoute : vignerons."
                                            },
                                            {
                                                "example_id": "6e3c9cf2-1c6d-4538-b79a-4bec0666e7d6",
                                                "sense_id": "e6e59421-fdd9-39d5-82c5-b3a3a2cd256c",
                                                "text": "L’enquêteur ne compte pas s’inscrire sur les listes électorales pour les raisons évoquées plus haut, à savoir l’impossibilité de « désélire » une personne qui n’aurait pas tenu ses promesses."
                                            }
                                        ]
                                    }
