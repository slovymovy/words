                        "examples": [
                            {
                                "example_id": "743e3a05-efc1-4eef-9fa2-586b9d773e2c",
                                "sense_id": "512a083b-50f4-37b6-8d18-4832dc17feb5",
                                "text": "Au xixᵉ siècle, la découverte des usages occidentaux incita les gens distingués à parler à table. Ils découvrirent aussitôt l’ennui de cet effort qui fut un temps dévolu aux geishas. Ces dernières ne tardèrent pas à se raréfier et l’ingéniosité japonaise trouva la solution en créant l’emploi de conversationneur."
                            },
                            {
                                "example_id": "4e29458f-d48c-45b6-a3a2-c522e5f010fc",
                                "sense_id": "512a083b-50f4-37b6-8d18-4832dc17feb5",
                                "text": "La conversation cesse faute de conversationneurs."
                            }
                        ]
                    }
