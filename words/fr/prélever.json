            "senses": [
                {
                    "sense_id": "2de4a279-99f6-3f61-91e4-14e14e57c3a4",
                    "sense_definition": "Retirer ou déduire une somme d'argent d'un compte bancaire ou d'un revenu.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La banque va <w>prélever</w> le montant de votre facture directement chaque mois.",
                            "target_lang_translations": {
                                "en": "The bank will <w>debit</w> the amount of your bill directly every month.",
                                "ru": "Банк будет <w>списывать</w> сумму по вашему счёту напрямую каждый месяц.",
                                "de": "Die Bank wird den Rechnungsbetrag jeden Monat direkt <w>abbuchen</w>.",
                                "es": "El banco <w>cargará</w> directamente el importe de su factura cada mes.",
                                "zh": "银行每个月都会直接从您的账户里<w>扣除</w>账单金额。"
                            }
                        },
                        {
                            "text": "L'administration a décidé de <w>prélever</w> les taxes à la source dès cette année.",
                            "target_lang_translations": {
                                "en": "The tax administration has decided to <w>withhold</w> taxes at source starting this year.",
                                "ru": "Налоговая служба решила с этого года <w>удерживать</w> налоги у источника.",
                                "de": "Die Steuerbehörde hat beschlossen, die Steuern ab diesem Jahr an der Quelle <w>einzubehalten</w>.",
                                "es": "La administración tributaria ha decidido <w>retener</w> los impuestos en origen a partir de este año.",
                                "zh": "税务部门决定从今年起在源头<w>扣缴</w>税款。"
                            }
                        }
                    ],
                    "synonyms": [
                        "déduire",
                        "soustraire"
                    ],
                    "antonyms": [
                        "verser",
                        "créditer"
                    ],
                    "common_phrases": [
                        "prélever une somme",
                        "prélever sur le compte"
                    ],
                    "target_lang_definitions": {
                        "en": "To withdraw or deduct a sum of money from a bank account or from income.",
                        "ru": "Снять или вычесть определённую сумму денег со счёта или из дохода.",
                        "de": "Einen Geldbetrag von einem Bankkonto oder vom Einkommen abziehen.",
                        "es": "Retirar o descontar una cantidad de dinero de una cuenta bancaria o de los ingresos.",
                        "zh": "从银行账户或收入中取走或扣除一定数额的钱。"
                    },
                    "translations": {
