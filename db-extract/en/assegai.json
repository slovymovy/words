    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0407d954-1061-36c0-8ac2-d87dafd7e635",
                "word": "assegai",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5cb87681-1120-4b68-96b6-3f473a2789b0",
                        "entry_id": "0407d954-1061-36c0-8ac2-d87dafd7e635",
                        "tags": [
                            "plural"
                        ],
                        "form": "assegais"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "04a13621-407d-308f-a442-1c587c69c878",
                        "entry_id": "0407d954-1061-36c0-8ac2-d87dafd7e635",
                        "glosses": [
                            "A slim hardwood spear or javelin with an iron tip, especially those used by Bantu peoples of Southern Africa."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cad09d4-6802-4a41-bdbf-780291cb826a",
                                "sense_id": "04a13621-407d-308f-a442-1c587c69c878",
                                "text": "But now the Moormen, stalking o'er the strand / to guard the wat'ery stores the strangers need; / this, targe on arm and assegai in hand, / that, with his bended bow, and venom'd reed[.]"
                            },
                            {
                                "example_id": "d48d13b7-cae3-43d0-aef5-0bc10fa14631",
                                "sense_id": "04a13621-407d-308f-a442-1c587c69c878",
                                "text": "My client welcomed the judge […] and they disappeared together into the Ethiopian card-room, which was filled with the assegais and exclamation point shields Mr. Cooke had had made at the sawmill at Beaverton."
                            },
                            {
                                "example_id": "30aa5bfe-eb5b-4025-b3ef-1aaef88e3677",
                                "sense_id": "04a13621-407d-308f-a442-1c587c69c878",
                                "text": "Native mats covered the clay walls; a collection of spears, assegais, shields, knives was hung up in trophies."
                            },
                            {
                                "example_id": "afb43399-ea93-4c9f-9b04-b6a64ebd7102",
                                "sense_id": "04a13621-407d-308f-a442-1c587c69c878",
                                "text": "A birdchief, bluestreaked and feathered in war panoply with his assegai, striding through a crackling canebrake over beechmast and acorns."
                            },
                            {
                                "example_id": "46ad3816-40a4-44f3-8b9e-667f048b6da5",
                                "sense_id": "04a13621-407d-308f-a442-1c587c69c878",
                                "text": "Without a word, he took my foreskin, pulled it forward, and then, in a single motion, brought down his assegai."
                            }
                        ]
                    },
                    {
                        "sense_id": "870b5062-ebd7-3e78-a5c1-59fc61c1bd9e",
                        "entry_id": "0407d954-1061-36c0-8ac2-d87dafd7e635",
                        "glosses": [
                            "The tree species Curtisia dentata, the wood of which is traditionally used to make assegais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1980547-d5dc-4d15-83d7-298731aca042",
                                "sense_id": "870b5062-ebd7-3e78-a5c1-59fc61c1bd9e",
                                "text": "In the clearing, built around the base of an assegai tree, stood a hut, plastered in cow dung."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
