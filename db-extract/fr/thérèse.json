                                "example_id": "73dc7250-aa19-4134-ae13-56122772fc95",
                                "sense_id": "df4d7a78-5bfb-3496-90a9-f77723b25417",
                                "text": "La voix aigre de Thérèse me vrille les tympans"
                            }
                        ]
