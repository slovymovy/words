                    },
                    {
                        "form_id": "6b448b16-284c-46ec-b002-7c23eaaf541d",
                        "entry_id": "d5528e38-6baa-3bb3-be82-252041cb2a74",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Naturelle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0223d3ca-693e-3566-aeaa-04fea9b60240",
                        "entry_id": "d5528e38-6baa-3bb3-be82-252041cb2a74",
                        "glosses": [
                            "eigentümliche Gemütsart, Wesensart"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "4f538269-04f5-42e8-b40a-3a20b9fcb062",
                                "sense_id": "0223d3ca-693e-3566-aeaa-04fea9b60240",
                                "text": "Elisabeth sitzt auf der Schaukel und wirkt traurig, das entspricht so gar nicht ihrem Naturell."
                            },
                            {
                                "example_id": "3fbd685e-e5cb-4fa4-93ad-c5ab758ef450",
                                "sense_id": "0223d3ca-693e-3566-aeaa-04fea9b60240",
                                "text": "„Umsichtig bis zur Verschlagenheit tritt er seinem Naturell entgegen.“"
                            },
                            {
                                "example_id": "8def0f3c-4463-41e1-82e4-68823a3efe3b",
                                "sense_id": "0223d3ca-693e-3566-aeaa-04fea9b60240",
                                "text": "„Er wird deutlicher; er hat das Naturell derer, die im Entgegenkommen einen ihnen gebührenden Zoll sehen, den sie von jedem Tag erheben möchten.“"
                            },
                            {
                                "example_id": "2b51a091-9a90-4593-8844-bfdfcd3113e7",
                                "sense_id": "0223d3ca-693e-3566-aeaa-04fea9b60240",
                                "text": "„Thomas Manns Jubiläum zu übergehen, widerstrebt seinem Naturell und würfe ein schlechtes Licht auf das deutsche Kulturleben und namentlich auf die Dichterakadmie, deren 2, Vorsitzender er jetzt ist.“"
                            },
                            {
                                "example_id": "6b6ea575-aeb5-4114-861a-3d66cff082b8",
                                "sense_id": "0223d3ca-693e-3566-aeaa-04fea9b60240",
                                "text": "„Von ihr hatte Haraldur sein fröhliches Naturell und seine Begeisterungsfähigkeit, die mehr als dreißig Jahre bäuerlicher Arbeit auf kargem Land und die Monotonie des Landlebens bei ihr ein wenig gedämpft hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
