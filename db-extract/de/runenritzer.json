                "senses": [
                    {
                        "sense_id": "a3d1406e-df95-3699-b576-1e099d0b01d8",
                        "entry_id": "dd11845b-bd43-37a3-83b3-71d91e62ac47",
                        "glosses": [
                            "Person, die in der Lage war, Runen/Runeninschriften auf dazu geeignetem Material anzubringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "697cb95c-754a-4311-bfb2-bb61fe819676",
                                "sense_id": "a3d1406e-df95-3699-b576-1e099d0b01d8",
                                "text": "„Von demselben Runenritzer Sote berichtet ein anderer fünischer Stein, der von Rønninge, daß er »Sohn des Asgøt mit dem roten Schild war«.“"
                            },
                            {
                                "example_id": "cf2a0ab0-27b7-4157-9a86-993c9a7d1e63",
                                "sense_id": "a3d1406e-df95-3699-b576-1e099d0b01d8",
                                "text": "„Zwischen Runenmeister und Runenschreiber oder Runenritzer kann, wenn es sich nicht um dieselbe Person handelt, in folgender Weise unterschieden werden: Runenmeister bezeichnet eine Person, die Kenntnis der Runen besitzt und eine Inschrift zu konzipieren vermag. Der Runenschreiber ist hingegen derjenige, der die Ausführung einer Inschrift auf einem bestimmten Gegenstand vornimmt.“"
                            },
                            {
                                "example_id": "e9dc2272-7063-4771-aa5a-7d03e7473ec6",
                                "sense_id": "a3d1406e-df95-3699-b576-1e099d0b01d8",
                                "text": "„Diese drei Runen sind zwar ein wenig kleiner als die Runen der Hauptinschrift, rühren aber bestimmt von demselben Runenritzer her.“"
                            },
                            {
                                "example_id": "70cce17e-3ce5-43f0-b4ee-4d63d457ea76",
                                "sense_id": "a3d1406e-df95-3699-b576-1e099d0b01d8",
                                "text": "„Ferner gehören in diese Gruppe wohl kurze Inschriften mit Angabe des Besitzers oder des Runenritzers auf einfachen Gebrauchsgegenständen…“"
                            },
                            {
                                "example_id": "f839a923-7333-4f88-af0f-2df825ce64f5",
                                "sense_id": "a3d1406e-df95-3699-b576-1e099d0b01d8",
                                "text": "„Und nun kam ein genialer Runenritzer auf den Gedanken, die Schrift zwischen Einfassungslinien anzubringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
