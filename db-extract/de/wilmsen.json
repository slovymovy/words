                        "examples": [
                            {
                                "example_id": "7ebe7fe8-0078-4593-9765-9a70a50cf4bd",
                                "sense_id": "f3d014d3-52e3-3c6d-b4dd-5e1b9f49bc39",
                                "text": "Herrn Wilmsen laufen immer wieder Katzen zu."
                            },
                            {
                                "example_id": "ce79d228-7211-45dc-b8f6-b3f1b8c8d5df",
                                "sense_id": "f3d014d3-52e3-3c6d-b4dd-5e1b9f49bc39",
                                "text": "Die Wilmsens wollen nach Kasachstan auswandern."
                            },
                            {
                                "example_id": "a6f27050-d7f2-47c1-a6b9-9127bf9fe0a4",
                                "sense_id": "f3d014d3-52e3-3c6d-b4dd-5e1b9f49bc39",
                                "text": "Wilmsens finanzielle Lage als desaströs zu bezeichnen, ist eine Untertreibung sondergleichen."
                            },
                            {
                                "example_id": "6000e249-25c3-4d38-8d88-1109d20ee107",
                                "sense_id": "f3d014d3-52e3-3c6d-b4dd-5e1b9f49bc39",
                                "text": "Dieser ganze Plunder gehört Frau Wilmsen."
                            }
                        ],
