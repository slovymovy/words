                        "glosses": [
                            "Économiser des petites sommes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82e71b18-3090-4107-9550-a04d778483ca",
                                "sense_id": "747ad50b-6817-302a-9a2e-19117ef45ce5",
                                "text": "D’abord, j’espère que tu guériras, et que tu nous feras encore de jolie musique ; mais, après tout, vois-tu, la vie est bien triste, les entrepreneurs chipotent, les rois carottent, les ministres tripotent, les gens riches économisotent…"
                            },
                            {
                                "example_id": "928f012a-bece-4e76-9293-2bac3596a890",
                                "sense_id": "747ad50b-6817-302a-9a2e-19117ef45ce5",
                                "text": "Le plaisir n’est pas d’économisoter, selon le mot de Balzac."
                            }
                        ]
                    }
