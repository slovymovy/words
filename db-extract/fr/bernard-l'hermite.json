                "senses": [
                    {
                        "sense_id": "6eedd5cc-58a6-3c61-aff9-82b7557767cf",
                        "entry_id": "a6e81672-931e-394d-8b41-5bf218d3b50d",
                        "glosses": [
                            "Petit crustacé qui se loge d’ordinaire dans une coquille abandonnée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "856dcaa8-afa3-4f56-915a-1a7221aa0b5e",
                                "sense_id": "6eedd5cc-58a6-3c61-aff9-82b7557767cf",
                                "text": "À travers les moirures de l’eau, le fond apparaissait nu : pas une algue, pas un bernard-l’hermite, pas même un de ces oursins à longues piques mouvantes qu’on appelle chardons noirs."
                            },
                            {
                                "example_id": "3fa67b23-1d36-4e1a-96e3-292e75a3cdf4",
                                "sense_id": "6eedd5cc-58a6-3c61-aff9-82b7557767cf",
                                "text": "Mais une des particularités les plus étranges de la vie de ce crabe, c’est qu’une sorte d’anémone (l’anémone parasite) se fixe sur sa coquille et se fait ainsi transporter par le bernard-l'hermite qui vit, d'ailleurs, en fort bonne intelligence avec elle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d58830c-f6df-4145-9451-f5b42e70a68d",
                        "source_entry_id": "a6e81672-931e-394d-8b41-5bf218d3b50d",
                        "source_sense_id": "6eedd5cc-58a6-3c61-aff9-82b7557767cf",
                        "target_lang_word": "Einsiedlerkrebs",
                        "target_lang_code": "de",
