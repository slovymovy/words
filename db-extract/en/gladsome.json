                        "glosses": [
                            "Marked by joy or gladness; happy, joyous, or light-hearted."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3291f9a1-bad1-4150-b576-7770b7a280a5",
                                "sense_id": "1b453f70-7d4f-3c8c-851f-69204b51ac1a",
                                "text": "I was not surprised, when I ran down into the hall, to see that a brilliant June morning had succeeded to the tempest of the night; and to feel, through the open glass door, the breathing of a fresh and fragrant breeze. Nature must be gladsome when I was so happy."
                            }
                        ]
