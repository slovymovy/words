                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b46683c9-fb24-341f-a3b1-62df83888162",
                        "entry_id": "9f90ada7-6584-3d60-8306-a3392282c014",
                        "glosses": [
                            "urzędnik powołany do ścigania przestępców w XIV i XV wieku w Polsce"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1d4a3ee-6abd-4227-88a9-689406a99d58",
                        "source_entry_id": "9f90ada7-6584-3d60-8306-a3392282c014",
                        "source_sense_id": "8517b7ff-f641-3201-83ef-b9db866e4be5",
                        "target_lang_word": "torturer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "torturer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e489fe2a-a162-34bf-8315-9804e36af580",
                                        "entry_id": "6d0446be-1b91-3d18-ba96-312bb83561a3",
                                        "glosses": [
                                            "Someone who tortures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f191042-a573-41e4-b0fa-08f453481a5f",
                                                "sense_id": "e489fe2a-a162-34bf-8315-9804e36af580",
                                                "text": "I play the torturer by ſmall and ſmall / To lengthen out the worſt that muſt be ſpoken: […]"
                                            },
                                            {
                                                "example_id": "15df62a3-5054-42fb-b023-14ea61417593",
                                                "sense_id": "e489fe2a-a162-34bf-8315-9804e36af580",
                                                "text": "My destruction might indeed arrive a few months sooner; but if my torturer should suspect that I postponed it, influenced by his menaces, he would surely find other, and perhaps more dreadful means of revenge."
                                            },
                                            {
                                                "example_id": "44e8c9ca-7720-4d88-bf57-51b5e065b905",
                                                "sense_id": "e489fe2a-a162-34bf-8315-9804e36af580",
                                                "text": "The torturers of any form of life torture the life. In this they are not only abominators of form, but haters of nature; and the violationist school is misozoic, life-hating; in continuation of that which it also is, misanthropic, or an enemy of mankind."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3db496f7-3b96-4df0-8d85-c5592d76dcde",
                        "source_entry_id": "9f90ada7-6584-3d60-8306-a3392282c014",
                        "source_sense_id": "8517b7ff-f641-3201-83ef-b9db866e4be5",
                        "target_lang_word": "Scharfrichter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scharfrichter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81ff953d-f451-3c78-8389-cbb4bbae4b88",
                                        "entry_id": "2acfe23d-e7d7-34e0-b0c0-dea506ac3010",
                                        "glosses": [
                                            "Person, die Hinrichtungen durchführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad33305e-40b2-441a-8d3b-ae7e4f171b3c",
                                                "sense_id": "81ff953d-f451-3c78-8389-cbb4bbae4b88",
                                                "text": "„Unten auf dem Platz trat der Scharfrichter hinter den Delinquenten.“"
                                            },
                                            {
                                                "example_id": "7d7ecb70-33b4-4c3f-993d-63762ac11c73",
                                                "sense_id": "81ff953d-f451-3c78-8389-cbb4bbae4b88",
                                                "text": "„Scharfrichter galten schlechthin als ehrlos.“"
                                            },
                                            {
                                                "example_id": "8162423e-3382-4c80-b4a2-f5fbcea16ad8",
                                                "sense_id": "81ff953d-f451-3c78-8389-cbb4bbae4b88",
                                                "text": "„Der Scharfrichter ist der einzige Mensch, der mitten im Frieden ungestraft töten darf.“"
                                            },
                                            {
                                                "example_id": "ca24e4b4-911d-4b97-8767-a72808c3cada",
                                                "sense_id": "81ff953d-f451-3c78-8389-cbb4bbae4b88",
                                                "text": "„Der Scharfrichter kam zu diesem Anlass eigens aus Conakry.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
