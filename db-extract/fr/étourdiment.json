                "forms": [],
                "senses": [
                    {
                        "sense_id": "c22bd358-faa3-3cd8-aacc-de94ac8bf961",
                        "entry_id": "4ed268d0-0aa7-3e00-843c-517e4df6b5be",
                        "glosses": [
                            "D’une façon étourdie, sans prendre de précautions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "140d1d89-c2a9-4d22-ba04-90c9e9db9070",
                                "sense_id": "c22bd358-faa3-3cd8-aacc-de94ac8bf961",
                                "text": "Il jouait bien involontairement un rôle sinistre et mystérieux – le rôle d’espion international. Il surprenait des secrets ; il menaçait, en fait, les projets d’une puissance non moindre que l’Empire Germanique ; il se jetait étourdiment dans le foyer ardent de la Welt-Politik."
                            },
                            {
                                "example_id": "bc1b7f04-1555-487e-b3b5-fb6ba1157f19",
                                "sense_id": "c22bd358-faa3-3cd8-aacc-de94ac8bf961",
                                "text": "Cloton ne peut vous faire d’autre grâce Que de filer vos jours très lentement ; Mais Cloton va toujours étourdiment,"
                            },
                            {
                                "example_id": "a64f0090-61b0-4f18-bc9f-726dbe54d7a0",
                                "sense_id": "c22bd358-faa3-3cd8-aacc-de94ac8bf961",
                                "text": "Un jeune officier d’état-major russe, à peine sorti de l’enfance, vint, en donnant étourdiment dans nos postes, se faire prendre avec ses dépêches,"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e33ddafa-e51c-4288-b283-e5d692c3feb9",
                        "source_entry_id": "4ed268d0-0aa7-3e00-843c-517e4df6b5be",
                        "source_sense_id": "c22bd358-faa3-3cd8-aacc-de94ac8bf961",
                        "target_lang_word": "rashly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rashly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76026db0-b58a-3271-ac62-81e806ed917d",
                                        "entry_id": "63102442-4ea9-3f8a-b9c8-f864203b25d7",
                                        "glosses": [
                                            "In a rash manner; hastily or without due consideration; with precipitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c65d2b1-ee07-4d65-9160-ac7603728592",
                                                "sense_id": "76026db0-b58a-3271-ac62-81e806ed917d",
                                                "text": "Alas Wat, I haue kild the kings officer in ſtriking raſhly."
                                            },
                                            {
                                                "example_id": "7e5b75de-b258-4c55-8184-b7a9511f8276",
                                                "sense_id": "76026db0-b58a-3271-ac62-81e806ed917d",
                                                "text": "VVhy do you ſpeake ſo ſtartingly and raſhly."
                                            },
                                            {
                                                "example_id": "48569775-bfcb-4071-b68f-7e5c41474d5c",
                                                "sense_id": "76026db0-b58a-3271-ac62-81e806ed917d",
                                                "text": "[H]e'll say that we're contradicting what was said just now when we rashly maintain that there are falsehoods in judgements and statements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
