                "senses": [
                    {
                        "sense_id": "30e24999-44d4-317c-9f28-49a664992042",
                        "entry_id": "2c5c145f-5958-3023-9a01-38a434c22938",
                        "glosses": [
                            "A five-Deutschmark coin."
                        ],
                        "tags": [
                            "colloquial",
                            "dated",
                            "masculine",
                            "mixed",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "5ad6d649-c7a6-4a1a-b1d6-ee7d4f96e41d",
                                "sense_id": "30e24999-44d4-317c-9f28-49a664992042",
                                "text": "So zog 1975 der damalige Minister Hans Apel das silberhaltige Fünf-Mark-Stück (sieben Gramm Silber, 4,2 Gramm Kupfer) aus dem Verkehr und drückte den Bürgern dafür den Heiermann aus Manimat, einer Legierung von Nickel und Kupfer, in die Hand.",
                                "translation": "Thus in 1975 the former minister Hans Apel demonetized the silver-containing five-Deutschmark coin (seven grams of silver, 4.4 grams of copper) and put the five-Deutschmark coin made of manimat, an alloy of nickel and copper, into the hands of the citizens.",
                                "english": "Thus in 1975 the former minister Hans Apel demonetized the silver-containing five-Deutschmark coin (seven grams of silver, 4.4 grams of copper) and put the five-Deutschmark coin made of manimat, an alloy of nickel and copper, into the hands of the citizens."
                            }
                        ]
                    }
