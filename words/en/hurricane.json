{
    "word_family": [
        "hurricanelike"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "798e30e0-2ccf-3a2a-8917-619a62b068ac",
                    "sense_definition": "A severe tropical cyclone in the North Atlantic or eastern North Pacific with sustained winds of at least 119 km/h.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "storm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>hurricane</w> season usually begins in June and lasts until November.",
                            "target_lang_translations": {
                                "ru": "Сезон <w>ураганов</w> обычно начинается в июне и длится до ноября."
                            }
                        },
                        {
                            "text": "The coastal town was evacuated before the <w>hurricane</w> made landfall.",
                            "target_lang_translations": {
                                "ru": "Прибрежный город был эвакуирован до того, как <w>ураган</w> обрушился на сушу."
                            }
                        }
                    ],
                    "synonyms": [
                        "cyclone",
                        "typhoon",
                        "tropical storm"
                    ],
                    "common_phrases": [
                        "hurricane warning",
                        "category five hurricane",
                        "eye of the hurricane"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный тропический циклон в Северной Атлантике или восточной части Тихого океана с устойчивым ветром скоростью не менее 119 км/ч."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ураган",
                                "target_lang_sense_clarification": "атмосферное явление"
                            },
                            {
                                "target_lang_word": "тропический циклон",
                                "target_lang_sense_clarification": "метеорологический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a88558d7-0076-3c76-9dbe-bcc253490b0e",
                    "sense_definition": "A great, forceful, or overwhelming onrush of something, often figurative.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician faced a <w>hurricane</w> of criticism after the scandal was revealed.",
                            "target_lang_translations": {
                                "ru": "Политик столкнулся со <w>шквалом</w> критики после того, как скандал стал достоянием общественности."
                            }
                        },
                        {
                            "text": "A <w>hurricane</w> of activity broke out in the office as the deadline approached.",
                            "target_lang_translations": {
                                "ru": "В офисе начался настоящий <w>вихрь</w> деятельности по мере приближения дедлайна."
                            }
                        }
                    ],
                    "synonyms": [
                        "torrent",
                        "whirlwind",
                        "storm"
                    ],
                    "common_phrases": [
                        "hurricane of emotions",
                        "hurricane of protest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мощный, стремительный или подавляющий поток чего-либо, часто в переносном смысле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ураган",
                                "target_lang_sense_clarification": "переносное значение, о чувствах или событиях"
                            },
                            {
                                "target_lang_word": "шквал",
                                "target_lang_sense_clarification": "о критике или аплодисментах"
                            },
                            {
                                "target_lang_word": "вихрь",
                                "target_lang_sense_clarification": "о деятельности или эмоциях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f44e3ae-bf5b-3f2b-a416-cc65e70a9cec",
                    "sense_definition": "A sweet alcoholic cocktail made with rum, lemon juice, and fruit syrup, typically served in a tall curved glass.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat by the beach and ordered a cold <w>hurricane</w> to enjoy the sunset.",
                            "target_lang_translations": {
                                "ru": "Мы сидели на пляже и заказали холодный «<w>Харрикейн</w>», чтобы насладиться закатом."
                            }
                        },
                        {
                            "text": "The bartender mixed a potent <w>hurricane</w> using two types of dark rum.",
                            "target_lang_translations": {
                                "ru": "Бармен смешал крепкий «<w>Харрикейн</w>», используя два вида темного рома."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hurricane glass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сладкий алкогольный коктейль на основе рома, лимонного сока и фруктового сиропа, обычно подаваемый в высоком изогнутом бокале."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Харрикейн",
                                "target_lang_sense_clarification": "название коктейля"
                            },
                            {
                                "target_lang_word": "ураган",
                                "target_lang_sense_clarification": "прямой перевод названия коктейля"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbbebd59-2d05-3486-a24a-c4cd527fe7c6",
                    "sense_definition": "A British single-seat fighter aircraft used by the Royal Air Force during World War II.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "aircraft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Hawker <w>Hurricane</w> played a vital role alongside the Spitfire during the war.",
                            "target_lang_translations": {
                                "ru": "Хоукер «<w>Харрикейн</w>» играл жизненно важную роль наряду со «Спитфайром» во время войны."
                            }
                        },
                        {
                            "text": "Museum visitors can see a restored <w>Hurricane</w> from the Battle of Britain.",
                            "target_lang_translations": {
                                "ru": "Посетители музея могут увидеть отреставрированный «<w>Харрикейн</w>» времен Битвы за Британию."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Британский одноместный истребитель, использовавшийся Королевскими ВВС во время Второй мировой войны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Харрикейн",
                                "target_lang_sense_clarification": "название самолета"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88970fac-e15f-378e-b67f-2d747c027d2c",
                    "sense_definition": "An acrobatic maneuver in freestyle skiing or gymnastics involving three flips and five twists.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "acrobatics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The skier successfully landed a <w>hurricane</w> to win the gold medal.",
                            "target_lang_translations": {
                                "ru": "Лыжник успешно выполнил <w>харрикейн</w> и завоевал золотую медаль."
                            }
                        },
                        {
                            "text": "Performing a <w>hurricane</w> requires incredible aerial awareness and strength.",
                            "target_lang_translations": {
                                "ru": "Выполнение <w>харрикейна</w> требует невероятной координации в воздухе и силы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "technical sports jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акробатический маневр во фристайле или гимнастике, включающий три сальто и пять винтов."
