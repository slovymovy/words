                ],
                "senses": [
                    {
                        "sense_id": "0266d066-3046-3d74-878c-4b9820b1a446",
                        "entry_id": "5def31c1-10bb-3d92-a978-fd29467a3997",
                        "glosses": [
                            "Küstenort südwestlich von Reykjavik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caf9bfdc-93d8-4e1f-a7ac-1f7bc6b8a1ec",
                                "sense_id": "0266d066-3046-3d74-878c-4b9820b1a446",
                                "text": "„Seit Ende Oktober hatten Erdbeben und Bodenbewegungen in der Region um Grindavik angezeigt, dass sich eine Masse geschmolzenen Gesteins im Untergrund von Nordosten in Richtung des Orts bewegte.“"
                            },
                            {
                                "example_id": "2237e40c-78d3-4f25-8187-d9e569d8d697",
                                "sense_id": "0266d066-3046-3d74-878c-4b9820b1a446",
                                "text": "„Während der Vulkanausbruch bei Grindavik für sich genommen keine Gefahr darstellt, ist er ein weiteres Indiz für eine potenziell besorgniserregende Entwicklung.“"
                            },
                            {
                                "example_id": "d07dd507-a6b4-4eeb-9fbf-b6fc8f41240a",
                                "sense_id": "0266d066-3046-3d74-878c-4b9820b1a446",
                                "text": "„Grindavik ist nach Angaben des Isländischen Meteorologischen Dienstes derzeit nicht durch Lava bedroht.“"
                            },
                            {
                                "example_id": "e64af8a1-9892-4062-8825-a7b2aa75b3a7",
                                "sense_id": "0266d066-3046-3d74-878c-4b9820b1a446",
                                "text": "„Die Frühwarnsysteme haben schon viele Leben gerettet: Erst im Januar 2024 brach in Island ein Vulkan in der Nähe des Küstenorts Grindavik aus, doch als der glutrote Lavastrom die ersten Häuser in Brand setzte, war die Bevölkerung dank solcher Überwachungssysteme schon in Sicherheit.“"
                            },
                            {
                                "example_id": "8543f760-9106-46f2-bb4f-61c98a972e75",
                                "sense_id": "0266d066-3046-3d74-878c-4b9820b1a446",
                                "text": "„Im isländischen Grindavik wurden die Menschen beispielsweise wegen akuter Eruptionsgefahr evakuiert, aber der eigentliche Ausbruch kam dann erst einige Tage später.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
