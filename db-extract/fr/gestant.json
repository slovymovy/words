                "senses": [
                    {
                        "sense_id": "61af140b-ecad-31c0-8c5b-113e3ab9843f",
                        "entry_id": "5aff13fe-7c1b-3a1e-aa93-96bdf9a974dc",
                        "glosses": [
                            "En gestation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3741777f-24c0-4143-8a13-6a0e78c40b07",
                                "sense_id": "61af140b-ecad-31c0-8c5b-113e3ab9843f",
                                "text": "Des palpations rectales trop brutales de l’utérus gestant entre 6 et 12 semaines causent la mort rapide de l’embryon ou du jeune fœtus, puis l’avortement au bout de quelques heures, jours ou semaines."
                            },
                            {
                                "example_id": "fe5f46da-3b02-4ff6-a36e-5807b41e09f7",
                                "sense_id": "61af140b-ecad-31c0-8c5b-113e3ab9843f",
                                "text": "À la connaissance des bactéries potentiellement infectantes pour la femme gestante et pour le fœtus ou le nouveau-né, on doit associer une approche pharmacologique de l’emploi des antibiotiques dans l’infection materno-fœtale."
                            },
                            {
                                "example_id": "52e6c0e0-1c96-4b21-8ea7-56ca675641cb",
                                "sense_id": "61af140b-ecad-31c0-8c5b-113e3ab9843f",
                                "text": "L'accident a été signalé à la police le mercredi 17 avril : un loup a été tué, percuté par une voiture dans la commune de Lenzkirch en Forêt-Noire dans le Bade-Würtemberg. Les premières constatations ont rapidement permis de déterminer qu'il s'agissait d'une femelle, et qu'elle était gestante."
                            }
                        ]
                    }
