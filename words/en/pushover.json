{
    "word_family": [
        "push",
        "over"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9614fba1-590b-3dac-9c01-edd116469546",
                    "sense_definition": "Something that is easy to do or accomplish; an easy task.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "easy_task",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The final exam was no <w>pushover</w>, requiring hours of intense concentration.",
                            "target_lang_translations": {
                                "ru": "Выпускной экзамен не был <w>простым испытанием</w> и потребовал нескольких часов предельной концентрации."
                            }
                        },
                        {
                            "text": "Winning the championship game turned out to be a complete <w>pushover</w>.",
                            "target_lang_translations": {
                                "ru": "Победа в финальной игре чемпионата оказалась <w>пустяковым делом</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "no pushover",
                        "complete pushover"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что легко сделать или выполнить; простая задача, пустяковое дело."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустяковое дело",
                                "target_lang_sense_clarification": "очень легкая задача"
                            },
                            {
                                "target_lang_word": "простая задача",
                                "target_lang_sense_clarification": "что-то, что легко дается"
                            },
                            {
                                "target_lang_word": "легкотня",
                                "target_lang_sense_clarification": "разговорное обозначение простого дела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "717d4d29-e11a-355b-b11e-7e257f542927",
                    "sense_definition": "Someone who is easily swayed or influenced to change their mind or comply.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "weak_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am a total <w>pushover</w> when it comes to buying new kitchen gadgets.",
                            "target_lang_translations": {
                                "ru": "Я совершенно <w>не могу устоять</w>, когда дело доходит до покупки новых кухонных гаджетов."
                            }
                        },
                        {
                            "text": "She tried to negotiate a better deal, knowing her boss was a <w>pushover</w>.",
                            "target_lang_translations": {
                                "ru": "Она попыталась договориться о более выгодных условиях, зная, что её босс — <w>податливый человек</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "softy"
                    ],
                    "common_phrases": [
                        "total pushover"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in informal spoken English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кто-то, кого легко убедить, склонить к какому-либо решению или заставить уступить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мягкотелый человек",
                                "target_lang_sense_clarification": "тот, кто легко уступает другим"
                            },
                            {
                                "target_lang_word": "простофиля",
                                "target_lang_sense_clarification": "доверчивый или простодушный человек, которым легко манипулировать"
                            },
                            {
                                "target_lang_word": "податливый человек",
                                "target_lang_sense_clarification": "тот, кто легко соглашается и меняет мнение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8166274b-3666-30ce-bdac-4074779aa3c0",
                    "sense_definition": "Someone who is easy to push around and to take advantage of; someone who lets themselves be picked on or bullied without defending or standing up for themselves.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "weak_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to stand up for yourself so they do not treat you like a <w>pushover</w>.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно уметь постоять за себя, чтобы с тобой не обращались как со <w>слабаком</w>."
                            }
                        },
                        {
                            "text": "He was tired of being a <w>pushover</w> and finally decided to say no.",
                            "target_lang_translations": {
                                "ru": "Ему надоело быть <w>тряпкой</w>, и он наконец решил сказать «нет»."
                            }
                        }
                    ],
                    "synonyms": [
                        "wuss",
                        "milksop"
                    ],
                    "common_phrases": [
                        "easy pushover"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in informal spoken English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кто-то, кем легко помыкать и пользоваться в своих интересах; безвольный человек, не умеющий постоять за себя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слабак",
                                "target_lang_sense_clarification": "слабовольный человек, не умеющий дать отпор"
                            },
                            {
                                "target_lang_word": "тряпка",
                                "target_lang_sense_clarification": "разговорное, пренебрежительное о бесхарактерном человеке"
                            },
                            {
                                "target_lang_word": "безответный человек",
                                "target_lang_sense_clarification": "тот, кто безропотно сносит обиды"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}