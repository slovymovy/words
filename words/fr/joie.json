                                "ru": "Дети прыгают от <w>радости</w>, открывая свои подарки.",
                                "nl": "De kinderen springen van <w>vreugde</w> als ze hun cadeaus ontdekken.",
                                "de": "Die Kinder springen vor <w>Freude</w>, wenn sie ihre Geschenke entdecken.",
                                "pl": "Dzieci skaczą z <w>radości</w>, odkrywając swoje prezenty.",
                                "it": "I bambini saltano di <w>gioia</w> quando scoprono i loro regali.",
                                "tr": "Çocuklar hediyelerini keşfederken <w>sevinçten</w> zıplıyorlar.",
                                "es": "Los niños dan saltos de <w>alegría</w> al descubrir sus regalos.",
                                "zh": "孩子们发现礼物时，满心<w>喜悦</w>地蹦跳起来。",
                                "cs": "Děti skáčou <w>radostí</w>, když objevují své dárky."
                            }
                        },
                        {
                            "text": "Elle a accepté notre invitation avec une grande <w>joie</w>.",
                            "target_lang_translations": {
                                "en": "She accepted our invitation with great <w>joy</w>.",
                                "ru": "Она с большой <w>радостью</w> приняла наше приглашение.",
                                "nl": "Ze heeft onze uitnodiging met grote <w>blijdschap</w> aanvaard.",
                                "de": "Sie hat unsere Einladung mit großer <w>Freude</w> angenommen.",
                                "pl": "Przyjęła nasze zaproszenie z wielką <w>radością</w>.",
                                "it": "Ha accettato il nostro invito con grande <w>gioia</w>.",
                                "tr": "Davetimizi büyük bir <w>sevinçle</w> kabul etti.",
                                "es": "Aceptó nuestra invitación con gran <w>alegría</w>.",
                                "zh": "她怀着极大的<w>喜悦</w>接受了我们的邀请。",
                                "cs": "Naše pozvání přijala s velkou <w>radostí</w>."
                            }
                        }
