                "senses": [
                    {
                        "sense_id": "1acc1fd5-15b2-33af-abae-8eeff6c88396",
                        "entry_id": "f1f18da3-4595-3a34-a4d6-403e5507beb4",
                        "glosses": [
                            "Donner à (quelque chose) des caractéristiques aéronavales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5e505e2-ada0-4bc3-94a0-a1aaafe69982",
                                "sense_id": "1acc1fd5-15b2-33af-abae-8eeff6c88396",
                                "text": "Mon projet le plus immédiat est d’aéronavaliser le Corsair de Parkzone (les décalques de base du kit sont assez moches de toutes manières^([sic : de toute manière]))."
                            },
                            {
                                "example_id": "6a7bd608-c31d-456e-ad9b-9d1dad4d2c60",
                                "sense_id": "1acc1fd5-15b2-33af-abae-8eeff6c88396",
                                "text": "Enfin, mariniser comme avioner^([sic : avionner]) font exploser le prix. Quant à aéronavaliser […]"
                            },
                            {
                                "example_id": "d3f14e49-2b34-4008-a2b4-79c15c9aa128",
                                "sense_id": "1acc1fd5-15b2-33af-abae-8eeff6c88396",
                                "text": "Priver ses bâtiments d’un radier entrait dans cette démarche \"d’aéronavaliser\" le combat littoral, au détriment de l’aspect amphibie, que regrette amérement (et publiquement) les Marines alors même que le premier navire de la classe n’est pas opérationnel !!"
                            }
                        ]
                    }
                ],
