                        "cross_references": []
                    },
                    {
                        "translation_id": "9d3d8e60-2515-4777-85c8-d8fcc92def44",
                        "source_entry_id": "9711238f-eac6-3703-8716-ff7d6f0eb8b5",
                        "source_sense_description": "Architecture",
                        "target_lang_word": "Stirnwand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stirnwand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f350934-e79b-354c-9898-edd9d6d63399",
                                        "entry_id": "4b8f4f2c-aaa9-3969-8223-b835e14040a7",
                                        "glosses": [
                                            "vorne befindliche, zugewandte Wand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5754a2f8-43d9-4ecb-8230-83657921c1a1",
                                                "sense_id": "1f350934-e79b-354c-9898-edd9d6d63399",
                                                "text": "„Das Steinrelief zierte die Stirnwand des Tempels.“"
                                            },
                                            {
                                                "example_id": "7811f03d-826f-4a24-ad6b-fc9265f14333",
                                                "sense_id": "1f350934-e79b-354c-9898-edd9d6d63399",
                                                "text": "„Die aus grauen länglichen Quadersteinen dicht gefügte Stirnwand wies vielfach eine ins Tintige gehende Maserung auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
