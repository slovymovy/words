                        "source_entry_id": "c342d36f-c64e-367d-ae2b-e6e2ba00aced",
                        "source_sense_id": "86bc0eb6-4c10-37cc-afdf-46f8dc333684",
                        "source_sense_description": "Zahn zum Zermahlen der Nahrung",
                        "target_lang_word": "molaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "molaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e56bd6fe-914f-3b80-b809-2089b95730d8",
                                        "entry_id": "da53caf8-646e-3ccf-a65f-8fa1819e6438",
                                        "glosses": [
                                            "Relatif à la mole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f29e886-7781-4ae2-be15-6e7eb24348b3",
                                                "sense_id": "e56bd6fe-914f-3b80-b809-2089b95730d8",
                                                "text": "Les masses atomiques et les masses molaires sont des résultats approchés. Les volumes molaires sont mesurés dans les conditions normales de température et de pression."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "molaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b85fd609-2b24-3d6c-b6c9-ad9d56e13041",
                                        "entry_id": "d129b1dc-2c1c-375d-8268-792f856f2bcc",
                                        "glosses": [
                                            "Relatif aux dents qui servent à broyer les aliments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f809b9f5-57a6-4bc7-9cd0-03748fa54cdc",
                                                "sense_id": "b85fd609-2b24-3d6c-b6c9-ad9d56e13041",
                                                "text": "Les dents molaires."
                                            },
                                            {
                                                "example_id": "360230ab-6297-4783-9acb-39c3b9476f5c",
                                                "sense_id": "b85fd609-2b24-3d6c-b6c9-ad9d56e13041",
                                                "text": "Peut-être pensait-il qu’un jour les victimes seraient récompensées à la mesure de leur sacrifice, c’est à dire à proportion des molaires abandonnées en chemin. Lui-même avait payé tribut de ses incisives et pouvait en concevoir de grandes espérances."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "molaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0b79ebb-4065-3f54-9c54-dac632186c61",
                                        "entry_id": "542f00c5-86de-3e3c-a2bb-ed96db654007",
                                        "glosses": [
                                            "Grosse dent qui sert à broyer les aliments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9871cbb-a3bd-4e34-b93c-df493c2dac9e",
                                                "sense_id": "e0b79ebb-4065-3f54-9c54-dac632186c61",
                                                "text": "Ce spécimen est une troisième molaire inférieure droite."
                                            },
                                            {
                                                "example_id": "a653a72e-6355-41b1-bfd1-337ef05d0e29",
                                                "sense_id": "e0b79ebb-4065-3f54-9c54-dac632186c61",
                                                "text": "Toutefois, diverses preuves archéologiques, notamment la découverte chypriote déjà évoquée, confirment que le lien entre l’homme et le chat est très ancien : par exemple, une molaire de chat, estimée à 9,000 ans, a été mise au jour en Israël et une autre dent, vieille de 4,000 ans, trouvée au Pakistan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
