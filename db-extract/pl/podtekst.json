                "senses": [
                    {
                        "sense_id": "a923c1e4-a73d-3472-922e-1f61f0cc8fcd",
                        "entry_id": "7c000096-4c49-3949-a8c8-97f93d52b6a8",
                        "glosses": [
                            "znaczenie tekstu niewyrażone wprost"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbfa6d02-ad16-41d8-b6ed-63453c9fa21b",
                                "sense_id": "a923c1e4-a73d-3472-922e-1f61f0cc8fcd",
                                "text": "Voyeryzm ujmowany w funkcji epistemologicznej posiada również wyraźny podtekst seksualny – tym lepiej wpisuje się również w pierwotne znaczenie terminu zaczerpniętego z psychologii."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "618bf3e4-bcf5-4964-89cd-2e4fb8bae95f",
                        "source_entry_id": "7c000096-4c49-3949-a8c8-97f93d52b6a8",
                        "source_sense_id": "a923c1e4-a73d-3472-922e-1f61f0cc8fcd",
                        "target_lang_word": "subtext",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subtext",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b523361-87e4-3afe-9495-7f6f0532a360",
                                        "entry_id": "aeae9ee1-0821-3e1a-9a9e-bddac53ad85f",
                                        "glosses": [
                                            "The implicit meaning of a text, often a literary one, or a speech or dialogue."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13f14ccc-22a0-4e32-af91-7ab41506715e",
                                                "sense_id": "7b523361-87e4-3afe-9495-7f6f0532a360",
                                                "text": "Everyone heard the announcement, but not everyone agrees on what the subtext was."
                                            },
                                            {
                                                "example_id": "725a2e07-340a-4d2a-9344-e84e8c267708",
                                                "sense_id": "7b523361-87e4-3afe-9495-7f6f0532a360",
                                                "text": "The word dick has meant penis since the 1890s, but Chester Gould’s private detective “Dick Tracy” has no puerile subtext related to this word."
                                            },
                                            {
                                                "example_id": "9a4e7a42-a9f9-4335-ad82-6cf3034ee185",
                                                "sense_id": "7b523361-87e4-3afe-9495-7f6f0532a360",
                                                "text": "While his major plays appear on the surface to have little plot, their subtext is full of overheated romance and melodrama."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "subtext",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6d719c1-01ec-3787-86ed-cab4d9cf2a5b",
                                        "entry_id": "d1e4e94f-0ca8-3de8-8316-7f5c0a5bdcd3",
                                        "glosses": [
                                            "To create or use a subtext."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e36dc9a8-06aa-40e8-83ee-8279dd2d8fff",
                                                "sense_id": "a6d719c1-01ec-3787-86ed-cab4d9cf2a5b",
                                                "text": "All the participants used subtexting as an important viewing strategy of mainstream films. We are always looking for innuendoes and cues either with certain individual characters or between female characters."
                                            },
                                            {
                                                "example_id": "ff6c4b92-d2a8-4b50-809e-d21ca0811725",
                                                "sense_id": "a6d719c1-01ec-3787-86ed-cab4d9cf2a5b",
                                                "text": "Subtexting is the technique that every author needs to know in order to create dialogue that is rich in meaning while sounding natural, for in real life, this is the way people often converse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1c38634-4e42-4953-8195-d2bd0459a611",
                        "source_entry_id": "7c000096-4c49-3949-a8c8-97f93d52b6a8",
                        "source_sense_id": "a923c1e4-a73d-3472-922e-1f61f0cc8fcd",
                        "target_lang_word": "podtext",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e5db453b-9762-40ff-afab-8e106d0baae1",
                        "source_entry_id": "7c000096-4c49-3949-a8c8-97f93d52b6a8",
                        "source_sense_id": "a923c1e4-a73d-3472-922e-1f61f0cc8fcd",
                        "target_lang_word": "подте́кст",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "подте́кст",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1f00bee9-ad32-3a8a-99e5-57fe5b1d0bd6",
                                        "entry_id": "d4d4aeea-3af1-37f5-8c27-1883b8f0487a",
                                        "glosses": [
                                            "неявный, скрытый, отличный от прямого значения высказывания смысл, который восстанавливается с учётом ситуации, контекста"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "924c59a5-2850-479c-a615-9db1f713b471",
                                                "sense_id": "1f00bee9-ad32-3a8a-99e5-57fe5b1d0bd6",
                                                "text": "Не только самостоятельное сознательное использование выразительных средств речи, но и понимание их своеобразной и насыщенной семантики, определяющей эмоциональный подтекст речи (иногда не менее существенный, чем её текст, выраженный логическим построением слов), является продуктом усвоения культуры. 〈…〉 Выразительные движения ― это выразительный «подтекст» … к некоторому тексту, который необходимо знать, чтобы правильно раскрыть смысл подтекста."
                                            },
                                            {
                                                "example_id": "55ecd14a-0c47-4685-937f-6dfb1b9ec523",
                                                "sense_id": "1f00bee9-ad32-3a8a-99e5-57fe5b1d0bd6",
                                                "text": "Драматизм этой симфонии звучит, как подтекст к основной теме."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
