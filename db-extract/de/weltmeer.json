                        ],
                        "form": "die Weltmeere"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5eb3d649-72ec-3e35-b6ee-f6c1ad082b3e",
                        "entry_id": "5608b3fe-3abc-3a77-84bc-1f98ad5b03c3",
                        "glosses": [
                            "sehr großes Meer zwischen zwei oder mehreren Kontinenten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4eecd19-1704-4b3b-af3c-4ce3672aaec0",
                                "sense_id": "5eb3d649-72ec-3e35-b6ee-f6c1ad082b3e",
                                "text": "Er ist auf allen Weltmeeren zu Hause."
                            },
                            {
                                "example_id": "fade00a9-eb36-4a39-9759-f093ecef10ac",
                                "sense_id": "5eb3d649-72ec-3e35-b6ee-f6c1ad082b3e",
                                "text": "„Mit dem Hilfskreuzer S.M.S. »Seeadler«, zwei Geschütze an Bord, durchstieß er die britische Seeblockade und begab sich auf eine kühne Kaperfahrt quer über die Weltmeere.“"
                            },
                            {
                                "example_id": "ce9c71f7-7483-4284-900a-b32f19d9d525",
                                "sense_id": "5eb3d649-72ec-3e35-b6ee-f6c1ad082b3e",
                                "text": "„Die einzige Möglichkeit, den Anstieg der Weltmeere wirklich zu begrenzen, ist aufzuhören, Kohle, Öl und Gas zu verbrennen.“"
                            },
                            {
                                "example_id": "e839b394-124c-4cac-9126-c4bdcf45198f",
                                "sense_id": "5eb3d649-72ec-3e35-b6ee-f6c1ad082b3e",
                                "text": "„Genau nach einem Jahr begannen dunkle Wolken den Himmel zu verdüstern, und die Weltmeere türmten sich empor.“"
                            },
                            {
                                "example_id": "17841946-8766-45ec-a6c5-77e1649487fe",
                                "sense_id": "5eb3d649-72ec-3e35-b6ee-f6c1ad082b3e",
                                "text": "„Fast ein halbes Jahrhundert hat er alle Weltmeere durchpflügt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
