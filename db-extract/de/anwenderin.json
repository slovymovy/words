                        "examples": [
                            {
                                "example_id": "fe7b33d9-9b90-45ba-a3ab-9ee034a19f12",
                                "sense_id": "12296aed-bf39-3b69-a65f-b9ac4892c023",
                                "text": "[…] zuerst aus dem Blickwinkel \"Die Firma als Anwenderin von Mikroelektronik und Information in ihrem Arbeitsablauf\" und nachher aus der Sicht […]",
                                "translation": "[…] first from the perspective \"The company as a user of microelectronics and information in its workflow\", and afterwards from the point of view […]",
                                "english": "[…] first from the perspective \"The company as a user of microelectronics and information in its workflow\", and afterwards from the point of view […]"
                            },
                            {
                                "example_id": "420b7bbb-3bd7-485f-8a77-9e37b5ae957d",
                                "sense_id": "12296aed-bf39-3b69-a65f-b9ac4892c023",
                                "text": "Die Presse war bald eine wichtige Anwenderin, profitierte sie doch sehr stark von der Beschleunigung der Kommunikation",
                                "translation": "The press was soon an important user, benefiting greatly from the acceleration of communication.",
                                "english": "The press was soon an important user, benefiting greatly from the acceleration of communication."
                            }
                        ]
                    }
