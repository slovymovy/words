{
    "word_family": [
        "throw",
        "thrower"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0126b1e7-3189-32d4-8835-8ba66f46f9fd",
                    "sense_definition": "To remove a government or leader from power, typically by using force.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "political_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rebels planned to <w>overthrow</w> the current government by the end of the month."
                        },
                        {
                            "text": "Many citizens feared that the military would attempt to <w>overthrow</w> the elected leader."
                        }
                    ],
                    "synonyms": [
                        "oust",
                        "subvert"
                    ],
                    "common_phrases": [
                        "overthrow the government",
                        "overthrow the regime"
                    ]
                },
                {
                    "sense_id": "98bd40f3-c2ba-399f-a6b3-8aae5050197c",
                    "sense_definition": "To knock something over or cause it to fall to the ground.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strong wind was enough to <w>overthrow</w> the small wooden shed in the garden."
                        },
                        {
                            "text": "The clumsy child managed to <w>overthrow</w> the heavy vase while running through the hall."
                        }
                    ],
                    "synonyms": [
                        "overturn"
                    ]
                },
                {
                    "sense_id": "acdd31be-2fb2-3f2d-b4c5-5c49e432132c",
                    "sense_definition": "To throw a ball or object further than the intended target.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pitcher tried to be too careful and ended up <w>overthrowing</w> the ball to first base."
                        },
                        {
                            "text": "The quarterback will <w>overthrow</w> the receiver if he does not adjust his aim for the wind."
                        }
                    ],
                    "common_phrases": [
                        "overthrow the ball"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e99a85e7-5cca-309a-a93f-bf8a25fab71a",
                    "sense_definition": "The act of removing a government or leader from power by force.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "political_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>overthrow</w> of the monarchy led to a period of great instability."
                        },
                        {
                            "text": "Historians studied the <w>overthrow</w> of the regime to understand the causes of the revolution."
                        }
                    ],
                    "synonyms": [
                        "oust"
                    ],
                    "common_phrases": [
                        "government overthrow"
                    ]
                },
                {
                    "sense_id": "3aed45e8-b762-3dc9-bfb5-d310d08a6736",
                    "sense_definition": "A throw in a sport that goes beyond the intended target.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team lost the game after a costly <w>overthrow</w> allowed the runner to score."
                        },
                        {
                            "text": "The fielder made an <w>overthrow</w> that gave the opposing team an extra base."
                        }
                    ],
                    "common_phrases": [
                        "costly overthrow"
                    ]
                }
            ]
        }
    ]
}