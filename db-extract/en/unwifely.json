                                "example_id": "f92d6525-0c66-4395-a5af-bfdbe709fd21",
                                "sense_id": "8dba8a0f-0e8b-3055-873e-9cf3aacbe499",
                                "text": "Yet every day the theme of this old troubadour's talk around the hotels is female entanglements--mendacious, unwifely, and for him unavailing."
                            }
                        ]
                    }
