                                "sense_id": "02107818-cd41-3a5d-acb3-cc80351cef2f",
                                "text": "Op vakantie slapen veel mensen op een slaapmatje."
                            },
                            {
                                "example_id": "94773cd6-9ddd-4675-8a13-0f460df0e011",
                                "sense_id": "02107818-cd41-3a5d-acb3-cc80351cef2f",
                                "text": "Naast me hoorde ik geritsel van plastic zakjes en een leeglopend slaapmatje."
                            }
                        ]
