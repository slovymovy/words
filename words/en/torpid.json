                    "frequency": "VeryLow",
                    "semantic_group_id": "dormancy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many reptiles become <w>torpid</w> during the cold months to conserve their limited body heat."
                        },
                        {
                            "text": "Bears remain largely <w>torpid</w> throughout winter, waking occasionally but eating almost nothing."
                        }
                    ],
