                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ef414e63-9989-384d-833b-c1b94aedd7db",
                                        "entry_id": "301fca0a-b958-369f-9153-4bc0e86832c3",
                                        "glosses": [
                                            "Speicherplatz für eingehende E-Mails/SMS, auf die der Adressat zugreifen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b78d72c-47a9-4c2f-a755-27a32516b4eb",
                                                "sense_id": "ef414e63-9989-384d-833b-c1b94aedd7db",
                                                "text": "„Das Postfach quoll über von E-Mails;…“"
                                            },
                                            {
                                                "example_id": "0ce8b0e6-d3c7-478a-88b9-c8d928b50646",
                                                "sense_id": "ef414e63-9989-384d-833b-c1b94aedd7db",
                                                "text": "„Seit einigen Wochen landeten sie in ihrem Postfach, und der Inhalt war immer derselbe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
