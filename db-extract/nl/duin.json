                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "241490fd-7e15-4e54-9d47-3c7339c843cc",
                                                "sense_id": "88e6ae23-b5d1-3e59-8163-f9fee98f3e51",
                                                "text": "„Auch heute kommen noch zahlreiche Badegäste und vergnügen sich vor allem auf Düne, der kleinen Nachbarinsel Helgolands, die 1720 in einer Sturmflut vom Felsen getrennt wurde.“"
                                            },
                                            {
                                                "example_id": "a85a987a-f879-46d2-a1a2-a4b00706e253",
                                                "sense_id": "88e6ae23-b5d1-3e59-8163-f9fee98f3e51",
                                                "text": "„Der Lebensraum auf der Düne unterscheidet sich komplett von dem auf der Hauptinsel.“"
                                            }
                                        ],
