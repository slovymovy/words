                        {
                            "text": "Ik <heb> veel aan jouw advies gehad.",
                            "target_lang_translations": {
                                "en": "I <got> a lot out of your advice.",
                                "ru": "Твой совет мне очень <помог>.",
                                "fr": "Ton conseil m'a beaucoup <w>aidé</w>."
                            }
