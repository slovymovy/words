{
    "word_family": [
        "replace",
        "replaceable",
        "irreplaceable",
        "replacer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f4fedf7-0ad4-36c8-9856-284d82beb2e5",
                    "sense_definition": "A person or thing that takes the place of another; a substitute.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "substitute_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to find a <w>replacement</w> for the broken printer immediately.",
                            "target_lang_translations": {
                                "ru": "Нам нужно немедленно найти <w>замену</w> сломанному принтеру.",
                                "tr": "Bozuk yazıcının yerine hemen bir <w>yedek</w> bulmamız gerekiyor.",
                                "zh": "我们需要立即为那台坏掉的打印机找到一个<w>替代品</w>。"
                            }
                        },
                        {
                            "text": "The coach sent in a <w>replacement</w> for the injured player during the second half.",
                            "target_lang_translations": {
                                "ru": "Во втором тайме тренер выпустил <w>замену</w> вместо травмированного игрока.",
                                "tr": "Koç, ikinci yarıda sakatlanan oyuncunun yerine bir <w>yedek</w> oyuna soktu.",
                                "zh": "下半场时，教练派了一名<w>替补</w>队员上场换下受伤的球员。"
                            }
                        }
                    ],
                    "synonyms": [
                        "substitute",
                        "stand-in",
                        "successor",
                        "proxy",
                        "backup",
                        "alternative"
                    ],
                    "common_phrases": [
                        "replacement part",
                        "find a replacement",
                        "temporary replacement",
                        "cheap replacement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто или то, что заменяет кого-либо или что-либо; заместитель.",
                        "tr": "Başka birinin veya bir şeyin yerini alan kişi veya şey; yedek.",
                        "zh": "指代替他人或他物的人或事物；替代品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замена",
                                "target_lang_sense_clarification": "человек или предмет"
                            },
                            {
                                "target_lang_word": "заместитель",
                                "target_lang_sense_clarification": "человек, исполняющий чьи-то обязанности"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yedek",
                                "target_lang_sense_clarification": "kişi veya eşya"
                            },
                            {
                                "target_lang_word": "yerini alan kişi",
                                "target_lang_sense_clarification": "birinin yerine geçen"
                            },
                            {
                                "target_lang_word": "yeni nesne",
                                "target_lang_sense_clarification": "değiştirilen şeyin yerine konan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "替代品",
                                "target_lang_sense_clarification": "指用来代替原有的物品"
                            },
                            {
                                "target_lang_word": "接替者",
                                "target_lang_sense_clarification": "指接替某人职位或工作的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d7744dd-16ba-38c6-984b-b47eedff747b",
                    "sense_definition": "The act of replacing something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "act_of_replacing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>replacement</w> of the old water pipes took three days to complete.",
                            "target_lang_translations": {
                                "ru": "<w>Замена</w> старых водопроводных труб заняла три дня.",
                                "tr": "Eski su borularının <w>değiştirilmesi</w> üç gün sürdü.",
                                "zh": "<w>更换</w>旧水管的工作花了三天时间才完成。"
                            }
                        },
                        {
                            "text": "Regular <w>replacement</w> of the air filter is necessary for the machine to work well.",
                            "target_lang_translations": {
                                "ru": "Для хорошей работы машины необходима регулярная <w>замена</w> воздушного фильтра.",
                                "tr": "Makinenin iyi çalışması için hava filtresinin düzenli olarak <w>değiştirilmesi</w> gerekir.",
                                "zh": "为了让机器正常运转，必须定期<w>更换</w>空气滤清器。"
                            }
                        }
                    ],
                    "synonyms": [
                        "substitution",
                        "exchange",
                        "swapping"
                    ],
                    "antonyms": [
                        "retention"
                    ],
                    "common_phrases": [
                        "replacement cost",
                        "knee replacement",
                        "hip replacement",
                        "hormone replacement therapy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по замене чего-либо.",
                        "tr": "Bir şeyi başka bir şeyle değiştirme eylemi.",
                        "zh": "更换某物的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замена",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "смена",
                                "target_lang_sense_clarification": "обновление"
                            },
                            {
                                "target_lang_word": "замещение",
                                "target_lang_sense_clarification": "формальное или техническое"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "değiştirme",
                                "target_lang_sense_clarification": "genel eylem"
                            },
                            {
                                "target_lang_word": "değişim",
                                "target_lang_sense_clarification": "yenisiyle yenileme eylemi"
                            },
                            {
                                "target_lang_word": "yenileme",
                                "target_lang_sense_clarification": "güncelleme veya bakım amacıyla değiştirme"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "更换",
                                "target_lang_sense_clarification": "指替换或调换的行为"
                            },
                            {
                                "target_lang_word": "替换",
                                "target_lang_sense_clarification": "指用新的代替旧的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de5911c7-e2c2-35fb-9a91-f4866ffa7517",
                    "sense_definition": "The removal of an edge of crystal, by one plane or more.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diagram illustrates the <w>replacement</w> of the crystal's sharp edge by a flat plane.",
                            "target_lang_translations": {
                                "ru": "На диаграмме показано <w>замещение</w> острого края кристалла плоской гранью.",
                                "tr": "Diyagram, kristalin keskin kenarının düz bir düzlemle <w>değişimini</w> göstermektedir.",
                                "zh": "该图表展示了晶体尖锐边缘被一个平面<w>置换</w>的过程。"
                            }
                        },
                        {
                            "text": "Mineralogists studied the <w>replacement</w> patterns on the surface of the specimen.",
                            "target_lang_translations": {
                                "ru": "Минералоги изучали узоры <w>замещения</w> на поверхности образца.",
                                "tr": "Mineraloglar, örneğin yüzeyindeki <w>yer değiştirme</w> desenlerini incelediler.",
                                "zh": "矿物学家研究了标本表面的<w>置换</w>模式。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс изменения формы кристалла или замещения одного минерала другим.",
                        "tr": "Bir kristal kenarının bir veya daha fazla düzlemle değiştirilmesi veya mineral dönüşümü.",
                        "zh": "指晶体边缘被一个或多个平面所取代的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замещение",
                                "target_lang_sense_clarification": "геологический термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yer değiştirme",
                                "target_lang_sense_clarification": "jeoloji/mineraloji terimi"
                            },
                            {
                                "target_lang_word": "değişim",
                                "target_lang_sense_clarification": "kristal yapısındaki değişim"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "置换",
                                "target_lang_sense_clarification": "矿物学或化学中的替换过程"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}