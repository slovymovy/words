                    {
                        "sense_id": "44b9d553-1738-366c-be76-fe1fc1e10249",
                        "entry_id": "ea19bd0a-9165-3a74-b8f3-6dc79cd1fba3",
                        "glosses": [
                            "A platform at the top of the foremast, supported by the trestle trees."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cc5b6e2-885c-4dcb-a753-aecdee72cf2d",
                                "sense_id": "44b9d553-1738-366c-be76-fe1fc1e10249",
                                "text": "His station was in the fore-top, and often from there he looked down, with the contempt of a man destined to shine in the midst of dangers, at the peaceful multitude of roofs cut in two by the brown tide of the stream, while scattered on the outskirts of the surrounding plain the factory chimneys rose perpendicular against a grimy sky, each slender like a pencil, and belching out smoke like a volcano."
                            }
                        ]
                    },
                    {
