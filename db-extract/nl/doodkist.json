                                            {
                                                "example_id": "2cd9e290-6154-4be2-b0ef-d923427d76a1",
                                                "sense_id": "db489886-e64d-34ae-bb46-b33b5dccf0cb",
                                                "text": "Indians do not hinder the progress of their dead by embalming or tight coffining."
                                            },
