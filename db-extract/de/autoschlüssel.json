                "senses": [
                    {
                        "sense_id": "ece74d96-1391-3903-82e4-42f8856f2e14",
                        "entry_id": "689ecd1b-0b61-3465-ab45-cbed522a3d16",
                        "glosses": [
                            "Schlüssel, der das Öffnen, Schließen und Anlassen eines Automobils ermöglicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48e790bc-13ee-4afd-b99a-946ee1e71b03",
                                "sense_id": "ece74d96-1391-3903-82e4-42f8856f2e14",
                                "text": "Vergiss die Autoschlüssel nicht!"
                            },
                            {
                                "example_id": "7d94dec2-8f1c-42c1-8695-fedf8f51670c",
                                "sense_id": "ece74d96-1391-3903-82e4-42f8856f2e14",
                                "text": "„Zuletzt zieht sie aus ihrer Hosentasche die Autoschlüssel und legt sie vor Anrath auf den Tisch, als wäre er der Wagenlenker.“"
                            },
                            {
                                "example_id": "b6295788-0ec2-48af-9b5c-485b1cb317d7",
                                "sense_id": "ece74d96-1391-3903-82e4-42f8856f2e14",
                                "text": "„Leo zieht den Autoschlüssel aus der Jackentasche.“"
                            },
                            {
                                "example_id": "54fe2362-bebe-4c47-89ae-7164b38fdd98",
                                "sense_id": "ece74d96-1391-3903-82e4-42f8856f2e14",
                                "text": "„Sie überlegte noch mal kurz und griff dann nach dem Autoschlüssel, um nach Reykjavík zu fahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
