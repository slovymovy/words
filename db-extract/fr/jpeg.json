                    {
                        "sense_id": "c7441423-49db-300f-a78b-80048821cdca",
                        "entry_id": "0ff07bd4-b67b-3d1c-9458-28e8ce672b16",
                        "glosses": [
                            "Format de compression en ton continu des images fixes, définie par ce groupe dont fait partie l’ISO."
                        ],
                        "tags": [
                            "Infographie"
                        ],
                        "examples": [
                            {
                                "example_id": "7059b5fd-5b4a-49ac-80a0-fa2325f783a3",
                                "sense_id": "c7441423-49db-300f-a78b-80048821cdca",
                                "text": "Je peux exporter les photos de mon appareil en JPEG."
                            },
                            {
                                "example_id": "19d0a2cf-ef83-4837-a4cc-569764f52b69",
                                "sense_id": "c7441423-49db-300f-a78b-80048821cdca",
                                "text": "La compression JPEG n'est pas la seule façon de réduire la place prise par une image sur le disque dur. Les navigateurs Web reconnaissent couramment deux autres grands formats d'image bitmap : GIF (pour Graphic Interchange Format), … et PNG (pour Portable Network Graphics), qui constitue une alternative libre à ce dernier …."
                            }
                        ]
                    },
                    {
                        "sense_id": "71ad74c2-5eca-38f6-85e5-5891d6bf73f3",
                        "entry_id": "0ff07bd4-b67b-3d1c-9458-28e8ce672b16",
                        "glosses": [
                            "Fichier dans ce format."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d6216d61-da85-4ff6-86ac-e8403b6be4fc",
                                "sense_id": "71ad74c2-5eca-38f6-85e5-5891d6bf73f3",
                                "text": "J'ai copié trois JPEG sur mon disque dur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07302bc6-320c-48b8-861e-17d145d3fac1",
                        "source_entry_id": "0ff07bd4-b67b-3d1c-9458-28e8ce672b16",
