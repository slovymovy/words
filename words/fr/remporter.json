    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ef76eafe-0f3b-37cf-837e-243acbb6fb8e",
                    "sense_definition": "Gagner ou obtenir un avantage, une distinction ou une victoire lors d'une compétition ou d'une lutte.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "victoire_succes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipe locale espère <w>remporter</w> une victoire importante ce soir.",
                            "target_lang_translations": {
                                "en": "The local team hopes to <w>win</w> an important victory tonight.",
                                "ru": "Местная команда надеется <w>одержать</w> важную победу сегодня вечером.",
                                "de": "Die Heimmannschaft hofft, heute Abend einen wichtigen Sieg zu <w>erringen</w>.",
                                "es": "El equipo local espera <w>ganar</w> una victoria importante esta noche.",
                                "zh": "当地球队希望今晚能<w>赢得</w>一场重要的胜利。"
                            }
                        },
                        {
                            "text": "Cette jeune athlète a <w>remporté</w> deux médailles d'or aux championnats du monde.",
                            "target_lang_translations": {
                                "en": "This young athlete has <w>won</w> two gold medals at the world championships.",
                                "ru": "Эта молодая спортсменка <w>завоевала</w> две золотые медали на чемпионатах мира.",
                                "de": "Diese junge Sportlerin hat bei den Weltmeisterschaften zwei Goldmedaillen <w>gewonnen</w>.",
                                "es": "Esta joven atleta ha <w>ganado</w> dos medallas de oro en los campeonatos mundiales.",
                                "zh": "这位年轻的女运动员在世界锦标赛上<w>赢得</w>了两枚金牌。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gagner",
                        "obtenir",
                        "décrocher"
                    ],
                    "antonyms": [
                        "perdre"
                    ],
                    "common_phrases": [
                        "remporter une victoire",
                        "remporter un succès",
                        "remporter le prix"
                    ],
                    "target_lang_definitions": {
                        "en": "To gain a victory, distinction or advantage in a competition or struggle.",
                        "ru": "Одержать победу, получить преимущество или награду в соревновании или борьбе.",
                        "de": "Bei einem Wettkampf oder einem Kampf einen Sieg, eine Auszeichnung oder einen Vorteil erlangen.",
                        "es": "Conseguir una victoria, un premio o una ventaja en una competición o lucha.",
                        "zh": "在比赛或斗争中取得胜利、荣誉或优势。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "win",
                                "target_lang_sense_clarification": "a competition or contest"
                            },
                            {
