                "senses": [
                    {
                        "sense_id": "34aa7ab1-5a7c-3e76-a76e-4d5e2f5a73af",
                        "entry_id": "40dac906-ad35-3bb9-adb1-5c23fb9c317b",
                        "glosses": [
                            "to dim, to cloud, to fog"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ddeb53e-2462-423e-a968-f6fd8232f160",
                                "sense_id": "34aa7ab1-5a7c-3e76-a76e-4d5e2f5a73af",
                                "text": "Я, разуме́ется, доро́гу отли́чно знал, потому́ что го́род наш небольшо́й, и я в нём роди́лся и вы́рос, но э́та темнота́ и мо́крый снег пря́мо из ко́мнатного жа́ра да из све́та то́чно у меня́ па́мять отума́нили.",
                                "translation": "Naturally, I knew the way very well, because our town isn’t big and I was born and grew up in it, but it was as if this darkness and wet snow right after the heat and light of the room dimmed my memory.",
                                "english": "Naturally, I knew the way very well, because our town isn’t big and I was born and grew up in it, but it was as if this darkness and wet snow right after the heat and light of the room dimmed my memory."
                            }
                        ]
                    }
                ],
