                "senses": [
                    {
                        "sense_id": "10f9700e-ac00-3bbe-b7a4-32c28e2d02df",
                        "entry_id": "a830778f-893d-3649-9928-23f5aee553b8",
                        "glosses": [
                            "jemand, der die Sportart Skilanglauf ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ba0a023-4ebc-45bc-ac6f-bf234cc22a44",
                                "sense_id": "10f9700e-ac00-3bbe-b7a4-32c28e2d02df",
                                "text": "„Der Skilangläufer Johannes Dürr und der Schriftsteller Martin Prinz haben zusammen ein sehr persönliches Buch geschrieben.“"
                            },
                            {
                                "example_id": "9a7c98e7-f673-43b9-9800-fd36be0d6096",
                                "sense_id": "10f9700e-ac00-3bbe-b7a4-32c28e2d02df",
                                "text": "„Im Interview beschreibt der überführte Skilangläufer Johannes Dürr, wie man sich im Spitzensportsystem Schritt für Schritt zum Doper entwickelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
