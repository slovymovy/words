                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9e4b327e-f092-4690-9123-b534651ab664",
                        "entry_id": "3d2d7553-bf7d-300a-b58b-95d27d32475c",
                        "tags": [
                            "plural"
                        ],
                        "form": "ketchups"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "69e438c8-a677-30fb-83a3-a27709c9c2db",
                        "entry_id": "3d2d7553-bf7d-300a-b58b-95d27d32475c",
                        "glosses": [
                            "Sauce sucrée à la tomate."
                        ],
                        "tags": [
                            "Sauces"
                        ],
                        "examples": [
                            {
                                "example_id": "384dddd3-a3f2-4dbe-a65b-65159b8916af",
                                "sense_id": "69e438c8-a677-30fb-83a3-a27709c9c2db",
                                "text": "Bébé déchira le sachet de ketchup avec les dents."
                            },
                            {
                                "example_id": "4bf2fc87-339b-4c86-88ac-a6898e640889",
                                "sense_id": "69e438c8-a677-30fb-83a3-a27709c9c2db",
                                "text": "Des frites, c'est bon; avec du ketchup, c'est meilleur."
                            },
                            {
                                "example_id": "304161eb-1c0b-4125-aef4-963125374801",
                                "sense_id": "69e438c8-a677-30fb-83a3-a27709c9c2db",
                                "text": "Ils prirent possession du chalet et elle descendit au village les approvisionner en junk-food à prix d'or : frites au four, nuggets surgelés, glaces, sauces samouraï, ketchup et mayonnaise."
                            },
                            {
                                "example_id": "a041287a-f48f-4c9f-9469-c2a37559e5b9",
                                "sense_id": "69e438c8-a677-30fb-83a3-a27709c9c2db",
                                "text": "Ajouter les tomates, le romarin, le sucre, le ketchup, les câpres, le vinaigre, verser la passata, saler et poivrer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc957d3b-506e-4187-abdd-8d95945d08c0",
                        "source_entry_id": "3d2d7553-bf7d-300a-b58b-95d27d32475c",
                        "source_sense_id": "69e438c8-a677-30fb-83a3-a27709c9c2db",
                        "target_lang_word": "Ketchup",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ketchup",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60a58b1f-476f-36ad-abd0-f8196259873e",
                                        "entry_id": "cbdda6af-bdb7-35fc-883a-ce2ae7fba31c",
                                        "glosses": [
                                            "Würzsoße mit den Grundbestandteilen Essig, Zucker und Tomaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fe80211-07d3-4e60-aa88-260ec63773b1",
                                                "sense_id": "60a58b1f-476f-36ad-abd0-f8196259873e",
                                                "text": "Mit Ketchup kann man sich leicht bekleckern."
                                            },
                                            {
                                                "example_id": "53e94359-8ad5-4f34-b8f1-13e2b1598d13",
                                                "sense_id": "60a58b1f-476f-36ad-abd0-f8196259873e",
                                                "text": "„Eine halbe Stunde später biss ich beherzt in einen Doppelwhopper, und Ketchup und Mayonnaise sammelten sich in meinem zotteligen Vagabundenbart“"
                                            },
                                            {
                                                "example_id": "19a56bb2-6f72-4867-973b-07a9d6e6fe1f",
                                                "sense_id": "60a58b1f-476f-36ad-abd0-f8196259873e",
                                                "text": "„Als die Shrimps gar waren, schöpften sie sie mit der Kelle aus dem Kochkessel und legten sie auf Zeitungspapier, schälten sie dann mit der Hand und stippten sie in die mit Worcestershire und Ketchup angemachte Soße.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "679d088b-27a1-4b29-bded-75a6d8cd56be",
                        "source_entry_id": "3d2d7553-bf7d-300a-b58b-95d27d32475c",
                        "source_sense_id": "69e438c8-a677-30fb-83a3-a27709c9c2db",
                        "target_lang_word": "ketchup",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
