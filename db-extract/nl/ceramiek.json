                        "sense_id": "4acaf5c4-1d1f-3aee-b578-b6263dd7ab00",
                        "entry_id": "fcf221d7-16ce-3a5d-bf17-984f3f89275b",
                        "glosses": [
                            "voorwerpen die van gebakken klei gemaakt zijn"
                        ],
