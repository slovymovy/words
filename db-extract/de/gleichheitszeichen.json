                ],
                "senses": [
                    {
                        "sense_id": "54c568ea-76d3-3c97-9f64-0f455154b28b",
                        "entry_id": "2df60c89-62ac-3cea-9bb0-151ee7b91d00",
                        "glosses": [
                            "Symbol für denselben Wert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6032d96-7c9d-4c11-ba48-06d289832421",
                                "sense_id": "54c568ea-76d3-3c97-9f64-0f455154b28b",
                                "text": "Das Gleichheitszeichen wird oft in der Mathematik verwendet."
                            },
                            {
                                "example_id": "04d3dbad-e87e-4c4b-8c61-dfe6daa022ec",
                                "sense_id": "54c568ea-76d3-3c97-9f64-0f455154b28b",
                                "text": "„Ist eine Trennung der Formel unvermeidlich, dann sollte nur am Gleichheitszeichen (oder einem ähnlichen Zeichen wie ≡, ≈, ≤, ~), wenn auch das nicht möglich ist, an einem Rechenzeichen umbrochen werden.“"
                            },
                            {
                                "example_id": "df35e8fe-5745-45d3-8a21-a29ab9728b2c",
                                "sense_id": "54c568ea-76d3-3c97-9f64-0f455154b28b",
                                "text": "„Alle Rechenbefehle in einer Tabellenkalkulation beginnen mit einem Gleichheitszeichen (\"=\"). Ohne das =Zeichen rechnet das Programm nichts!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
