                                        "sense_id": "dcc18457-24b9-3b11-8ff7-9e452a4c2a8c",
                                        "entry_id": "bd1ab85a-f38b-3f82-b18f-5c26113a0d91",
                                        "glosses": [
                                            "Einziehen der Luft in die Lunge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50fb662e-8d53-4be7-a618-aa25770a5c39",
                                                "sense_id": "dcc18457-24b9-3b11-8ff7-9e452a4c2a8c",
                                                "text": "„Asbest gilt als sehr gefährlich, weil die Fasern beim Einatmen große Lungenschädigungen verursachen können.“"
                                            },
                                            {
                                                "example_id": "99d6e0dc-cfab-4919-87a0-65585248f6d8",
                                                "sense_id": "dcc18457-24b9-3b11-8ff7-9e452a4c2a8c",
                                                "text": "„Nach einem Tauchgang von etwa drei Minuten nimmt sich die Robbe kaum zwanzig Sekunden Zeit, um das angehäufte Kohlendioxid auszuatmen und beim Einatmen ihre Sauerstoffvorräte wieder aufzufüllen.“"
                                            },
                                            {
                                                "example_id": "a65fcb9b-7ff5-4256-aa88-553812877ab6",
                                                "sense_id": "dcc18457-24b9-3b11-8ff7-9e452a4c2a8c",
                                                "text": "„Wenn wir zum Sprechen oder Singen ansetzen, schließen sich die Stimmlippen zunächst, die während des Einatmens noch weit geöffnet waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
