        "fr-extract.jsonl": [
            {
                "entry_id": "cf42d690-e93c-331f-9055-46c22b38eb5e",
                "word": "horizontalité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "db670d13-7d0e-4cb0-8e2d-1a52ba868514",
                        "entry_id": "cf42d690-e93c-331f-9055-46c22b38eb5e",
                        "tags": [
