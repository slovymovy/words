                        "glosses": [
                            "naam van een klimplant Dioscorea trifida, een soort yam die onder meer voorkomt in het noorden van Zuid-Amerika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3b080f5-1244-46ff-b1a6-8ea279da2d7f",
                                "sense_id": "f0d45306-4527-3a73-9a92-feaf08f16174",
                                "text": "Het dorp blijkt verlaten. Het heeft ongeveer vijftig huizen en er rondomheen liggen aanzienlijke kostgronden, beplant met bananen, napi, jamsi, kasaba (cassave: manihot esculenta) en mais."
                            }
                        ]
                    },
                    {
                        "sense_id": "970ed17b-13d7-32d1-8a5e-18db0e211328",
                        "entry_id": "682fc18c-1217-37e3-b3af-a40406b25e00",
                        "glosses": [
                            "langwerpige wortelknol van Dioscorea trifida, die van binnen wit, paars of zwart kan zijn en veel zetmeel bevat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e462985-2bd5-40cb-b59b-5c8a8210ce93",
                                "sense_id": "970ed17b-13d7-32d1-8a5e-18db0e211328",
                                "text": "In verminderde, zij het nog in voldoende opvallende mate, worden de talrijke aardvruchten, die vroeger de ‘bulk’ van het Creoolse dieet uitmaakten, nog gegeten; producten als tajer, napi, zoete cassave, jams en switi-patata in gekookte vorm, en vooral bananen (bana) rijpe en groene."
                            }
                        ]
                    }
