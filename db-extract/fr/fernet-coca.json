                        "glosses": [
                            "Boisson alcoolisée composée d’un mélange de Fernet et de Coca-Cola."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25027841-b959-498c-8efc-0bf6614165cf",
                                "sense_id": "18f4e056-60b8-3b83-918e-0a06f085b53b",
                                "text": "Alors que les Argentins se voyaient déjà fêter leur victoire au Fernet-Coca dans les vestiaires, on s’est dit que le coup de surin allait certainement leur être fatal."
                            },
                            {
                                "example_id": "4d97fb3d-c1aa-4670-98c4-bd8696f9022f",
                                "sense_id": "18f4e056-60b8-3b83-918e-0a06f085b53b",
                                "text": "Il appela ensuite l’employé de l'auberge qui passait par là et lui commanda un Fernet-Coca, un alcool très populaire en Argentine qui venait lui aussi d’Italie."
                            },
                            {
                                "example_id": "4f32a27e-348a-4940-845a-b5cde8766118",
                                "sense_id": "18f4e056-60b8-3b83-918e-0a06f085b53b",
                                "text": "Ángel, mouillé et vivifié, s’est dit que la balade méritait un peu plus qu’une bière et a commandé un Fernet-Coca."
                            }
                        ]
                    }
