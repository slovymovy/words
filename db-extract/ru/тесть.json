                    {
                        "translation_id": "62d6cfbd-144f-4ce9-9e62-95eeb73d71fb",
                        "source_entry_id": "b322304c-9612-3bc9-8bc7-f53fbdbe7d61",
                        "source_sense_id": "ccc3310a-370a-3e6b-b3d6-4eff1957cf10",
                        "target_lang_word": "Schwiegervater",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwiegervater",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a947b71-91d8-3c6c-b4ac-725fc1583b60",
                                        "entry_id": "be19143c-dcb6-3299-bbee-b956d0dd4be7",
                                        "glosses": [
                                            "der Vater des Ehepartners"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89896568-e458-484e-8798-7ef509646d03",
                                                "sense_id": "4a947b71-91d8-3c6c-b4ac-725fc1583b60",
                                                "text": "Mit meinem Schwiegervater verstehe ich mich gut."
                                            },
                                            {
                                                "example_id": "dd0986d9-6382-4483-a7e1-1e1a5f37b700",
                                                "sense_id": "4a947b71-91d8-3c6c-b4ac-725fc1583b60",
                                                "text": "„Da für Karl das Bündnis mit Desiderius nicht mehr von Nutzen war, verstieß er seine Frau nach kurzer Ehe und schickte sie seinem Schwiegervater zurück.“"
                                            },
                                            {
                                                "example_id": "1afb55c0-d379-4c2d-a373-06a6619612f5",
                                                "sense_id": "4a947b71-91d8-3c6c-b4ac-725fc1583b60",
                                                "text": "„Der Schwiegervater jedenfalls wagt 1043 einen Angriff auf das Großreich, scheitert aber damit.“"
                                            },
                                            {
                                                "example_id": "7a592314-9910-4308-8f33-3df543591847",
                                                "sense_id": "4a947b71-91d8-3c6c-b4ac-725fc1583b60",
                                                "text": "„Der Schwiegervater war Kunsthändler und die Wohnung der Tochter diente als Zwischenlager.“"
                                            },
                                            {
                                                "example_id": "ffd16029-687d-4dbd-8ec2-ee3cb1a4cf8b",
                                                "sense_id": "4a947b71-91d8-3c6c-b4ac-725fc1583b60",
                                                "text": "„Dabei hängen Fotos, auf denen Leni Ottos griechischen Schwiegervater in Heldenpose porträtiert hat, durchaus an Gästen zugänglichen Stellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
