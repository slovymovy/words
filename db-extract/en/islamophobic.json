                "translations": [
                    {
                        "translation_id": "77eec941-b9ba-4413-a372-79ca68fb5590",
                        "source_entry_id": "35e65fa7-031a-38d5-94dd-24aa472cd23a",
                        "source_sense_id": "a7d9baaa-cba0-30c0-b01e-e4ee9d905d70",
