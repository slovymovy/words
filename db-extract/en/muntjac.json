                                "target_senses": [
                                    {
                                        "sense_id": "e810bb68-8898-3d0f-ad6f-bc57c3391fb2",
                                        "entry_id": "e527f3a4-f5a7-3ba1-88c2-48c0eb84ebcd",
                                        "glosses": [
                                            "ein Tier der in Südasien beheimateten Hirschart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae618d47-213c-4ef4-985f-3d644ec7f6bf",
                                                "sense_id": "e810bb68-8898-3d0f-ad6f-bc57c3391fb2",
                                                "text": "Die Muntjaks gehören zu der kleinsten Hirschart."
                                            },
                                            {
                                                "example_id": "b69b0b76-34d6-4f25-ba8e-9ca8f9cad4af",
                                                "sense_id": "e810bb68-8898-3d0f-ad6f-bc57c3391fb2",
                                                "text": "„Muntjaks verfügen über Stirndrüsen und zusätzlich über sehr große, schlitzförmige und deshalb sehr auffällige Voraugendrüsen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
