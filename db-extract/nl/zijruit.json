                        "tags": [],
                        "examples": [
                            {
                                "example_id": "773c6cca-8afb-408b-a450-650aa57712d7",
                                "sense_id": "3b6268ea-0b67-33e7-a035-390c9292b997",
                                "text": "De zijruiten waren wat beslagen, maar hij had goed zicht door de voor- en achterruit."
                            },
                            {
                                "example_id": "d95432d3-4808-4a15-9d95-c522a7cc80be",
                                "sense_id": "3b6268ea-0b67-33e7-a035-390c9292b997",
                                "text": "We zaten in een geparkeerde huurauto bij Ter Apelervenen, mijn collega Christiaan en ik. (…) Mijn blik viel op een felgroen streepje onderaan de zijruit. „Hee”, zei ik, „mos!” Het rubbergootje aan de buitenkant van het portier was veranderd in een mini-plantenbak met één flinterdun strookje mos. Ik maakte een foto, toen stapten we uit."
                            }
                        ]
                    }
