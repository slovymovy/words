{
    "word_family": [
        "dead",
        "death",
        "die",
        "deadliness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "016f5403-3ce1-3691-8b9b-1c9ee96602e0",
                    "sense_definition": "Causing or capable of causing death.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "causing_death",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The snake carries a <w>deadly</w> venom that can kill a human in minutes.",
                            "target_lang_translations": {
                                "ru": "У этой змеи <w>смертельный</w> яд, который может убить человека за считанные минуты.",
                                "zh": "这条蛇带有<w>致命的</w>毒液，几分钟内就能毒死人。"
                            }
                        },
                        {
                            "text": "Police officers are authorized to use <w>deadly</w> force if their lives are threatened.",
                            "target_lang_translations": {
                                "ru": "Сотрудники полиции уполномочены применять <w>смертоносную</w> силу, если их жизни угрожает опасность.",
                                "zh": "如果生命受到威胁，警察有权使用<w>致命的</w>武力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lethal",
                        "fatal",
                        "mortal"
                    ],
                    "antonyms": [
                        "harmless",
                        "safe",
                        "nonlethal"
                    ],
                    "common_phrases": [
                        "deadly weapon",
                        "deadly disease",
                        "deadly force",
                        "deadly poison",
                        "deadly virus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий или способный вызвать смерть.",
                        "zh": "会导致死亡的；能够致死的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смертельный",
                                "target_lang_sense_clarification": "наиболее общий перевод; вызывающий смерть"
                            },
                            {
                                "target_lang_word": "смертоносный",
                                "target_lang_sense_clarification": "несущий смерть (часто об оружии, яде)"
                            },
                            {
                                "target_lang_word": "убийственный",
                                "target_lang_sense_clarification": "способный убить; крайне губительный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "致命的",
                                "target_lang_sense_clarification": "最常用，指会导致死亡"
                            },
                            {
                                "target_lang_word": "致死的",
                                "target_lang_sense_clarification": "较正式，强调造成死亡的结果"
                            },
                            {
                                "target_lang_word": "致人死亡的",
                                "target_lang_sense_clarification": "常用于武器、毒药、病毒等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99127bdd-949d-3790-bead-50f5ee8add76",
                    "sense_definition": "Aiming to destroy or deeply hostile; implacable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "hostile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Although they were once friends, they have now become <w>deadly</w> enemies.",
                            "target_lang_translations": {
                                "ru": "Хотя когда-то они были друзьями, теперь они стали <w>заклятыми</w> врагами.",
                                "zh": "虽然他们曾经是朋友，但现在已经成了<w>不共戴天的</w>敌人。"
                            }
                        },
                        {
                            "text": "The two companies are <w>deadly</w> rivals in the technology market.",
                            "target_lang_translations": {
                                "ru": "Эти две компании — <w>непримиримые</w> соперники на технологическом рынке.",
                                "zh": "这两家公司在科技市场上是<w>势不两立的</w>竞争对手。"
                            }
                        }
                    ],
                    "synonyms": [
                        "implacable",
                        "sworn",
                        "bitter"
                    ],
                    "common_phrases": [
                        "deadly enemy",
                        "deadly rival",
                        "deadly earnest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стремящийся уничтожить или глубоко враждебный; непримиримый.",
                        "zh": "抱有毁灭对方的意图或深刻敌意的；不可调和的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заклятый",
                                "target_lang_sense_clarification": "используется с существительным «враг»"
                            },
                            {
                                "target_lang_word": "непримиримый",
                                "target_lang_sense_clarification": "о соперниках или вражде"
                            },
                            {
                                "target_lang_word": "смертельный",
                                "target_lang_sense_clarification": "в контексте вражды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不共戴天的",
                                "target_lang_sense_clarification": "多用于仇敌，表示仇恨极深"
                            },
                            {
                                "target_lang_word": "势不两立的",
                                "target_lang_sense_clarification": "用于敌人、对手或竞争关系"
                            },
                            {
                                "target_lang_word": "死敌般的",
                                "target_lang_sense_clarification": "表示敌意极深、无法和解"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82696817-a28a-35e8-a4c2-73b8f6fe6b93",
                    "sense_definition": "Extremely accurate or effective, especially regarding aim.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "accurate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sniper hit the target with <w>deadly</w> accuracy from a mile away.",
                            "target_lang_translations": {
                                "ru": "Снайпер поразил цель с <w>убийственной</w> точностью с расстояния в милю.",
                                "zh": "那名狙击手在一英里外仍以<w>极精准的</w>枪法命中了目标。"
                            }
                        },
                        {
                            "text": "Her aim with the bow was <w>deadly</w>, never missing the bullseye.",
                            "target_lang_translations": {
                                "ru": "Её стрельба из лука была <w>безупречной</w>, она никогда не промахивалась мимо яблочка.",
                                "zh": "她的箭法<w>百发百中</w>，从不脱靶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unerring",
                        "precise"
                    ],
                    "antonyms": [
                        "inaccurate"
                    ],
                    "common_phrases": [
                        "deadly aim",
                        "deadly accuracy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно точный или эффективный, особенно в отношении прицеливания.",
                        "zh": "极其准确或有效的，尤其指瞄准或命中方面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убийственный",
                                "target_lang_sense_clarification": "о точности или силе удара"
                            },
                            {
                                "target_lang_word": "безупречный",
                                "target_lang_sense_clarification": "не имеющий изъянов, точный"
                            },
                            {
                                "target_lang_word": "снайперский",
                                "target_lang_sense_clarification": "очень точный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "精准的",
                                "target_lang_sense_clarification": "强调精确、命中率高"
                            },
                            {
                                "target_lang_word": "百发百中的",
                                "target_lang_sense_clarification": "常用于箭法、枪法等，表示从不失手"
                            },
                            {
                                "target_lang_word": "极精准的",
                                "target_lang_sense_clarification": "强调准头极高"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c331fe5c-39ba-3313-893a-b35d9838e671",
                    "sense_definition": "Extremely boring or tedious.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "boring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lecture was so <w>deadly</w> that half the students fell asleep.",
                            "target_lang_translations": {
                                "ru": "Лекция была такой <w>тоскливой</w>, что половина студентов уснула.",
                                "zh": "这场讲座<w>无聊透顶</w>，一半的学生都睡着了。"
                            }
                        },
                        {
                            "text": "We left the party early because the conversation was absolutely <w>deadly</w>.",
                            "target_lang_translations": {
                                "ru": "Мы ушли с вечеринки рано, потому что разговор был совершенно <w>убийственным</w>.",
                                "zh": "我们很早就离开了聚会，因为大家的谈话实在<w>闷死人</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dull",
                        "tedious",
                        "monotonous"
                    ],
                    "antonyms": [
                        "exciting",
                        "stimulating"
                    ],
                    "common_phrases": [
                        "deadly dull",
                        "deadly boring"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно скучный или утомительный.",
                        "zh": "极其无聊的；乏味得令人难以忍受的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тоскливый",
                                "target_lang_sense_clarification": "вызывающий тоску, скуку"
                            },
                            {
                                "target_lang_word": "невыносимый",
                                "target_lang_sense_clarification": "в значении «невыносимо скучный»"
                            },
                            {
                                "target_lang_word": "убийственный",
                                "target_lang_sense_clarification": "разг. крайне скучный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无聊透顶",
                                "target_lang_sense_clarification": "很常用，表示非常无聊"
                            },
                            {
                                "target_lang_word": "乏味至极",
                                "target_lang_sense_clarification": "强调沉闷乏味"
                            },
                            {
                                "target_lang_word": "闷死人",
                                "target_lang_sense_clarification": "口语色彩较强，表示无聊得让人受不了"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "241ca72e-728d-3ccd-ba34-3cb597a95499",
                    "sense_definition": "Excellent or very impressive.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "excellent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That new motorbike you bought is absolutely <w>deadly</w>!",
                            "target_lang_translations": {
                                "ru": "Тот новый мотоцикл, что ты купил, просто <w>офигенный</w>!",
                                "zh": "你买的那辆新摩托车简直<w>超棒</w>！"
                            }
                        },
                        {
                            "text": "We had a <w>deadly</w> time at the concert last night.",
                            "target_lang_translations": {
                                "ru": "Мы провели <w>потрясающее</w> время на концерте вчера вечером.",
                                "zh": "我们昨晚在演唱会上度过了一个<w>超棒的</w>夜晚。"
                            }
                        }
                    ],
                    "synonyms": [
                        "awesome",
                        "cool",
                        "fantastic"
                    ],
                    "antonyms": [
                        "terrible"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used in Irish or Australian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличный или очень впечатляющий.",
                        "zh": "非常棒的；令人印象深刻的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крутой",
                                "target_lang_sense_clarification": "сленг: отличный"
                            },
                            {
                                "target_lang_word": "офигенный",
                                "target_lang_sense_clarification": "сленг: потрясающий"
                            },
                            {
                                "target_lang_word": "великолепный",
                                "target_lang_sense_clarification": "высшая степень качества"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "超棒",
                                "target_lang_sense_clarification": "口语，表示非常好、很厉害"
                            },
                            {
                                "target_lang_word": "超酷",
                                "target_lang_sense_clarification": "口语，表示很酷、很出色"
                            },
                            {
                                "target_lang_word": "很赞",
                                "target_lang_sense_clarification": "较通用，表示令人印象深刻"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bd43eb5-be24-3f10-a333-b60ba4adf438",
                    "sense_definition": "Subject to death; mortal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mortal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient texts, humans are often described as <w>deadly</w> creatures who must eventually perish.",
                            "target_lang_translations": {
                                "ru": "В древних текстах люди часто описываются как <w>смертные</w> существа, которые в конце концов должны погибнуть.",
                                "zh": "在古代文献中，人类常被描述为<w>终有一死的</w>生物。"
                            }
                        },
                        {
                            "text": "He realized that his <w>deadly</w> body would not last forever.",
                            "target_lang_translations": {
                                "ru": "Он осознал, что его <w>смертное</w> тело не будет существовать вечно.",
                                "zh": "他意识到自己这具<w>凡人的</w>身体不会永存。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mortal"
                    ],
                    "antonyms": [
                        "immortal"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подверженный смерти; смертный.",
                        "zh": "会死的；非永生的；凡人的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смертный",
                                "target_lang_sense_clarification": "не бессмертный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "凡人的",
                                "target_lang_sense_clarification": "文雅或书面，强调非不朽"
                            },
                            {
                                "target_lang_word": "会死的",
                                "target_lang_sense_clarification": "直白表达，强调不能永生"
                            },
                            {
                                "target_lang_word": "终有一死的",
                                "target_lang_sense_clarification": "较书面，强调终究难逃一死"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c7f0f17c-692a-35a8-b5d0-6280f53b936a",
                    "sense_definition": "Extremely or incredibly; used as an intensifier.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "extremely",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>deadly</w> serious about finishing this project on time.",
                            "target_lang_translations": {
                                "ru": "Я <w>смертельно</w> серьёзен насчёт того, чтобы закончить этот проект вовремя.",
                                "zh": "我对按时完成这个项目这件事是<w>非常</w>认真的。"
                            }
                        },
                        {
                            "text": "The library was <w>deadly</w> quiet while the students were studying.",
                            "target_lang_translations": {
                                "ru": "В библиотеке было <w>мертвенно</w> тихо, пока студенты занимались.",
                                "zh": "学生们学习的时候，图书馆里<w>特别</w>安静。"
                            }
                        }
                    ],
                    "synonyms": [
                        "extremely",
                        "incredibly",
                        "terribly"
                    ],
                    "common_phrases": [
                        "deadly serious",
                        "deadly quiet",
                        "deadly dull"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно или невероятно; используется для усиления.",
                        "zh": "非常；极其；用来加强语气。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смертельно",
                                "target_lang_sense_clarification": "крайне, очень сильно"
                            },
                            {
                                "target_lang_word": "ужасно",
                                "target_lang_sense_clarification": "разг. в значении «очень»"
                            },
                            {
                                "target_lang_word": "чертовски",
                                "target_lang_sense_clarification": "разг. очень"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "非常",
                                "target_lang_sense_clarification": "最常用的程度副词"
                            },
                            {
                                "target_lang_word": "极其",
                                "target_lang_sense_clarification": "语气较强，较书面"
                            },
                            {
                                "target_lang_word": "特别",
                                "target_lang_sense_clarification": "口语常用，表示程度很高"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f112629-9e03-30bb-bf7d-d6f2cea8f8f4",
                    "sense_definition": "In a manner resembling or suggesting death.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "like_death",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her face went <w>deadly</w> pale when she heard the shocking news.",
                            "target_lang_translations": {
                                "ru": "Её лицо стало <w>мертвенно</w> бледным, когда она услышала шокирующие новости.",
                                "zh": "她听到那个令人震惊的消息后，脸色变得<w>死一般地</w>苍白。"
                            }
                        },
                        {
                            "text": "The skin of the creature was <w>deadly</w> white in the moonlight.",
                            "target_lang_translations": {
                                "ru": "Кожа существа была <w>мертвенно</w> белой в лунном свете.",
                                "zh": "那生物的皮肤在月光下<w>死一般地</w>惨白。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deathly"
                    ],
                    "common_phrases": [
                        "deadly pale",
                        "deadly white"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образом, напоминающим или предполагающим смерть.",
                        "zh": "以一种像死亡一样的方式；呈现出死亡般的样子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мертвенно",
                                "target_lang_sense_clarification": "как у мертвеца (обычно о бледности)"
                            },
                            {
                                "target_lang_word": "смертельно",
                                "target_lang_sense_clarification": "как при смерти"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "死一般地",
                                "target_lang_sense_clarification": "表示像死人一样，常用于“苍白”等"
                            },
                            {
                                "target_lang_word": "惨白地",
                                "target_lang_sense_clarification": "多用于脸色、肤色等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b844fd6c-629d-3ed8-9217-cef456969d6b",
                    "sense_definition": "In a fatal manner; so as to cause death.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fatally",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight was <w>deadly</w> wounded during the fierce battle.",
                            "target_lang_translations": {
                                "ru": "Рыцарь был <w>смертельно</w> ранен в ходе ожесточённой битвы.",
                                "zh": "那名骑士在激战中被<w>致命地</w>击伤。"
                            }
                        },
                        {
                            "text": "He feared he had been <w>deadly</w> struck by the arrow.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что был <w>смертельно</w> сражён стрелой.",
                                "zh": "他担心自己被箭<w>致命地</w>射中了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fatally",
                        "mortally"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "modern usage prefers 'mortally' or 'fatally'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фатальным образом; так, что это вызывает смерть.",
                        "zh": "以致死的方式；造成死亡地。"
