                        "glosses": [
                            "Relatif à l’histoire d’un pays avant l’arrivée des Espagnols."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02b63184-e096-49d9-8ada-f3bd0f1582b7",
                                "sense_id": "27ba7127-be0d-314e-b6bd-17d19ef06ba5",
                                "text": "Histoire préhispanique du Mexique."
                            },
                            {
                                "example_id": "75692069-5c6d-4af1-af80-86edca53fdd3",
                                "sense_id": "27ba7127-be0d-314e-b6bd-17d19ef06ba5",
                                "text": "C’est une des premières civilisations du Pérou préhispanique à avoir développé la forme politique d’un Etat et des structures urbaines autour des centres cérémoniels à l'architecture monumentale."
                            },
                            {
                                "example_id": "8e080016-bd7e-412f-9e2a-9b5588a7ca63",
                                "sense_id": "27ba7127-be0d-314e-b6bd-17d19ef06ba5",
                                "text": "\"En 1982, le vol d’un codex préhispanique à la Bibliothèque nationale de France, par un étudiant mexicain rentré au pays, avait provoqué le gel des échanges culturels entre la France et le Mexique\", raconte Daniel Leyva, poète et responsable de la culture à l'Instituto Politecnico."
                            }
                        ]
                    }
