                            {
                                "target_lang_word": "gizlice süzülmek",
                                "target_lang_sense_clarification": "sessizce ve dikkat çekmeden ilerlemek"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "skradać się",
                                "target_lang_sense_clarification": "iść cicho i niepostrzeżenie"
                            },
                            {
                                "target_lang_word": "przemykać",
                                "target_lang_sense_clarification": "przechodzić cicho i ukradkiem"
                            },
                            {
                                "target_lang_word": "myszkować",
                                "target_lang_sense_clarification": "poruszać się ukradkiem po zakamarkach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd32ad27-3738-3d4a-9f9e-c604061acefa",
                    "sense_definition": "To steal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The schoolboy was caught trying to <w>snoop</w> some sweets from the local shop.",
                            "target_lang_translations": {
                                "ru": "Школьника поймали, когда он пытался <w>стащить</w> сладости в местном магазине.",
                                "tr": "Okul çocuğu, yerel dükkandan biraz şekerleme <w>aşırmaya</w> çalışırken yakalandı.",
                                "pl": "Uczeń został przyłapany na próbie <w>podwędzenia</w> słodyczy z miejscowego sklepu."
                            }
                        },
                        {
                            "text": "You're not thinking of <w>snooping</w> his tuck, I suppose, like Bunter.",
                            "target_lang_translations": {
                                "ru": "Я полагаю, ты не думаешь <w>своровать</w> его еду, как Бантер.",
                                "tr": "Sanırım Bunter gibi onun yiyeceklerini <w>aşırmayı</w> düşünmüyorsun.",
                                "pl": "Chyba nie zamierzasz <w>zwędzić</w> mu jedzenia, tak jak Bunter."
                            }
                        }
                    ],
                    "synonyms": [
                        "swipe",
                        "pilfer",
                        "filch"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British school slang"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Украсть что-либо (британский школьный сленг).",
                        "tr": "Bir şeyi izinsiz almak veya çalmak.",
                        "pl": "Ukraść lub zwinąć coś niepostrzeżenie (brytyjski slang szkolny)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стащить",
                                "target_lang_sense_clarification": "мелкая кража"
                            },
                            {
                                "target_lang_word": "стянуть",
                                "target_lang_sense_clarification": "незаметно украсть"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "aşırmak",
