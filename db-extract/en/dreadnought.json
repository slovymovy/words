                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "358a2a32-0dfd-4f1c-806e-092f16205a07",
                        "source_entry_id": "89744083-ef69-3f9e-9851-12a3b7a829ae",
                        "source_sense_description": "battleship",
                        "target_lang_word": "slagschip",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slagschip",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4324d23c-b07b-37ba-a833-6fdafea9ae4d",
                                        "entry_id": "92d3c89b-a58f-399c-bf76-6b6d669abcd8",
                                        "glosses": [
                                            "groot schip met zware bewapening"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56275650-97df-4c7a-bc7b-55f791aafc00",
                                                "sense_id": "4324d23c-b07b-37ba-a833-6fdafea9ae4d",
                                                "text": "En ik zie nog voor me hoe Bink Young, die nu anglicaans priester is, met zijn afgetrapte gympen op tafel doodernstig een plan uitstippelt om een slagschip uit Boston Harbor te stelen. Misschien was ik als slecht getransformeerde rups wel dankbaar voor het gezelschap van echte vlinders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be0fe9c6-c3de-3daa-8c1d-d27a5e3453a3",
                                        "entry_id": "92d3c89b-a58f-399c-bf76-6b6d669abcd8",
                                        "glosses": [
                                            "vastberaden, ongenaakbare niet te stoppen vrouw van formaat"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4b60c8d-165d-4341-ae51-d62b1a536e2f",
                                                "sense_id": "be0fe9c6-c3de-3daa-8c1d-d27a5e3453a3",
                                                "text": "Een tijd geleden mocht ik op de koffie bij boerin en CDA-Kamerlid Annie Schreijer-Pierik. Zo pront als Annie worden ze in de Randstad niet meer geboren. Slagschip van het matriarchaat. Als een niet te stuiten waterval ging ze te keer over de zegen van het boerenland, de nuffigheid van Den Haag, het debiele gedachtengoed van de Partij voor de Dieren. Het leek wel opera: vrouw met riek en hooivork tussen de tanden, al bleef haar mond zacht en bij wijlen sensueel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8780a60d-2dea-32e8-84be-8a6ad0260aec",
                                        "entry_id": "92d3c89b-a58f-399c-bf76-6b6d669abcd8",
                                        "glosses": [
                                            "alles wat zeer groot en imponerend is"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff46489d-7955-42dd-a420-b9c5d089f5a8",
                                                "sense_id": "8780a60d-2dea-32e8-84be-8a6ad0260aec",
                                                "text": "Laten we het niet te moeilijk maken. We beginnen bij het begin: welke barbecue moet ik kopen? Zo’n groot slagschip op wielen? Of toch een wegwerp-bbq?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2905a12-15f5-41bb-adcc-ee8872d0e52c",
                        "source_entry_id": "89744083-ef69-3f9e-9851-12a3b7a829ae",
                        "source_sense_description": "battleship",
                        "target_lang_word": "dreadnought",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dreadnought",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99a976ad-a328-3283-9263-520d8cd769b8",
                                        "entry_id": "feccc479-e096-360a-8ccf-6fbd1729dc37",
                                        "glosses": [
                                            "Type prédominant de cuirassé utilisé au cours du XXᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4bf9204-404d-4afa-b8eb-a251389c5060",
                                                "sense_id": "99a976ad-a328-3283-9263-520d8cd769b8",
                                                "text": "Des hauteurs de Bon-Secours on distingue, dans la brume, la glorieuse cathédrale comme un dreadnought à l’ancre, comme une caravelle fantastique dominant une flotte enfumée."
                                            },
                                            {
                                                "example_id": "7ecb5f79-6a28-42f3-ae52-c6a6fe0a6b1a",
                                                "sense_id": "99a976ad-a328-3283-9263-520d8cd769b8",
                                                "text": "La prochaine guerre sera gagnée au bout du compte par les sous-marins et les avions, et nous devrions dépenser plus d’argent à les développer qu'à gaspiller nos ressources en construisant des dreadnoughts dont la seule fonction est de torpiller les cuirassés allemands et de se faire torpiller leur tour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a11ee83-6f41-4520-affd-a98ca1cb32da",
                        "source_entry_id": "89744083-ef69-3f9e-9851-12a3b7a829ae",
                        "source_sense_description": "battleship",
                        "target_lang_word": "Schlachtschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlachtschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "530856e7-4f05-3f7b-89e7-e30bf5bf664f",
                                        "entry_id": "da79c1bd-3325-3911-921f-2c1f1df70620",
                                        "glosses": [
                                            "großes Kriegsschiff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1539f31a-17f5-4d70-a126-3b26bf7eceb2",
                                                "sense_id": "530856e7-4f05-3f7b-89e7-e30bf5bf664f",
                                                "text": "Die Bismarck war ein großes deutsches Schlachtschiff."
                                            },
                                            {
                                                "example_id": "a637d63e-1257-4efc-9afd-06518a518e88",
                                                "sense_id": "530856e7-4f05-3f7b-89e7-e30bf5bf664f",
                                                "text": "„Im April 1944 bediente sich Admiral Rolf Johannesson derselben Zeilen während eines Gedenkgottesdienstes für einhundert Seeleute, die bei einem britischen Luftangriff gegen das Schlachtschiff TIRPITZ ums Leben gekommen waren.“"
                                            },
                                            {
                                                "example_id": "b9bb94f3-8a38-41ad-80b6-d66dbd41080b",
                                                "sense_id": "530856e7-4f05-3f7b-89e7-e30bf5bf664f",
                                                "text": "„Angesichts von Protesten der Mannschaften auf einigen Schlachtschiffen, die nicht sinnlos in einem längst verlorenen Krieg geopfert werden wollten, gab die Marineleitung diesen Plan wieder auf und beorderte die Schiffe zurück nach Kiel.“"
                                            },
                                            {
                                                "example_id": "070a22e5-ffad-47de-bda9-cd50c3b26ea6",
                                                "sense_id": "530856e7-4f05-3f7b-89e7-e30bf5bf664f",
                                                "text": "„Ein britischer Flottenverband, der im März aus Europa eingetroffen war, beteiligte sich mit zwei Schlachtschiffen, vier Flugzeugträgern, sechs Kreuzern und fünfzehn Zerstörern an dem Unternehmen.“"
                                            },
                                            {
                                                "example_id": "bafd7536-729e-4bfe-ae5d-39d155966433",
                                                "sense_id": "530856e7-4f05-3f7b-89e7-e30bf5bf664f",
                                                "text": "„Aber die großen Schlachtschiffe lagen offen und weitgehend ungeschützt im Naturhafen und waren den Angriffen aus der Luft schutzlos ausgeliefert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f136a3d2-5040-39fb-aae2-22370d5cc2e3",
                                        "entry_id": "da79c1bd-3325-3911-921f-2c1f1df70620",
                                        "glosses": [
                                            "üble Bezeichnung für Frau, auch für Schwiegermutter"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8a02d6f-cb88-49bb-ba58-128dd63f4c69",
                                                "sense_id": "f136a3d2-5040-39fb-aae2-22370d5cc2e3",
                                                "text": "Und meine Frau, das alte Schlachtschiff …"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5e5cd305-57cf-3cef-a723-5d131fdfb057",
                                        "entry_id": "da79c1bd-3325-3911-921f-2c1f1df70620",
                                        "glosses": [
                                            "große, als mächtig und kraftvoll oder aber protzig empfundene Fortbewegungsmittel"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a835316f-a016-400a-8127-89751d28d9aa",
                                                "sense_id": "5e5cd305-57cf-3cef-a723-5d131fdfb057",
                                                "text": "„In kleinen Autos könnte man [die Gassen] spielend passieren. Aber wenn ich vorsichtig um die Ecke biege mit meiner Mittelklasse auf vier Rädern, ist die Wahrscheinlichkeit hoch, dass mir ein Schlachtschiff entgegenwogt.“"
                                            },
                                            {
                                                "example_id": "feaf2318-49d3-4f2b-aff3-32f28e406d06",
                                                "sense_id": "5e5cd305-57cf-3cef-a723-5d131fdfb057",
                                                "text": "„Fahrdynamisch ist das Schlachtschiff schon baulich schnell an seinen Grenzen.“"
                                            },
                                            {
                                                "example_id": "06d61a8e-dcc6-4a6e-9309-2f6b72947fc8",
                                                "sense_id": "5e5cd305-57cf-3cef-a723-5d131fdfb057",
                                                "text": "„Der neue BMW X7 ist ein Koloss: Der Siebensitzer ist stolze 5,15 Meter lang, knapp zwei Meter breit und 1,80 Meter hoch – das über zwei Tonnen schwere Schlachtschiff überragt damit seinen Vorgänger deutlich.“"
                                            },
                                            {
                                                "example_id": "13ed22f3-a2f9-4dc8-baa6-061b4a555696",
                                                "sense_id": "5e5cd305-57cf-3cef-a723-5d131fdfb057",
                                                "text": "„Eine Mercedes S-Klasse war immer schon ein automobiles Schlachtschiff, aber die Ausmaße des W140 wirken mit 5,11 Metern Länge und fast zwei Metern Breite kolossal […]“"
                                            },
                                            {
                                                "example_id": "8d0832cd-3f1d-4606-9b09-34c35d7d5588",
                                                "sense_id": "5e5cd305-57cf-3cef-a723-5d131fdfb057",
                                                "text": "„[…] die SUV-Sause hat einen neuen Superlativ. Das Schlachtschiff X7 verspricht Luxus auf sieben Sitzen.“"
                                            },
                                            {
                                                "example_id": "38a3ef3e-ad0f-4114-88c7-03c42fbbb4ea",
                                                "sense_id": "5e5cd305-57cf-3cef-a723-5d131fdfb057",
                                                "text": "Hast Du schon Peters neues Auto gesehen? Mann, ist das ein Schlachtschiff: 4,80 Meter lang, 1,90 Meter breit und 1,70 Meter hoch!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
