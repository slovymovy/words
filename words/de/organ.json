            "senses": [
                {
                    "sense_id": "dedb7b3e-d0c8-3e50-8d95-a1196e69b8f0",
                    "sense_definition": "Körperteil von Menschen, Tieren oder Pflanzen mit einer abgegrenzten, lebenswichtigen Funktion",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Herz ist ein lebenswichtiges <w>Organ</w> des menschlichen Körpers."
                        },
                        {
                            "text": "Bei der Operation untersuchte die Ärztin alle betroffenen <w>Organe</w> sehr genau."
                        }
                    ],
                    "synonyms": [
                        "Körperteil"
                    ],
                    "common_phrases": [
                        "innere Organe",
                        "lebenswichtiges Organ"
                    ]
                },
                {
                    "sense_id": "331463c9-280c-3019-ab0c-9acc0609c63f",
                    "sense_definition": "Behörde, Person oder Gremium mit einem fest zugeordneten Aufgabenbereich innerhalb einer Körperschaft oder eines Staates",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Vorstand ist das geschäftsführende <w>Organ</w> dieses gemeinnützigen Vereins."
                        },
                        {
                            "text": "Die verschiedenen staatlichen <w>Organe</w> müssen eng miteinander zusammenarbeiten."
                        }
                    ],
                    "synonyms": [
                        "Behörde",
                        "Stelle"
                    ],
                    "common_phrases": [
                        "leitendes Organ"
                    ]
                },
                {
                    "sense_id": "758fccec-3935-33f6-a993-737f3c9c3389",
                    "sense_definition": "menschliche Sprech- oder Singstimme, insbesondere hinsichtlich ihrer Lautstärke oder Klangfarbe",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stimme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mit seinem kräftigen <w>Organ</w> übertönte der Redner den gesamten Saal mühelos."
                        },
                        {
                            "text": "Die Schauspielerin beeindruckte das Publikum durch ihr dunkles und klangvolles <w>Organ</w>."
                        }
                    ],
                    "synonyms": [
