                        "formuler une ordonnance",
                        "formuler un jugement"
                    ]
                },
                {
                    "sense_id": "98f3ab66-bd4c-3e4c-9222-1c5bbe51113e",
                    "sense_definition": "Élaborer un produit chimique, pharmaceutique ou cosmétique par le mélange précis de divers composants.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le laboratoire cherche à <w>formuler</w> une crème apaisante sans aucun conservateur irritant."
                        },
                        {
                            "text": "Ce médicament a été <w>formulé</w> pour améliorer la tolérance digestive des patients fragiles."
