                                "sense_id": "5d1ffb23-37b6-3e26-b78c-7bccddfd4f03",
                                "text": "Jongeheer, kom je even mee?"
                            }
                        ]
                    },
                    {
                        "sense_id": "a3b27f59-db47-3764-8bab-7079df57b878",
                        "entry_id": "31c769f7-500a-3322-ba2f-59bc52f2d067",
