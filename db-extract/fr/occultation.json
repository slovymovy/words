        "fr-extract.jsonl": [
            {
                "entry_id": "447b5431-ae99-3c64-a63b-3e3c04e2238a",
                "word": "occultation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "332cb7a0-cd12-483a-ba32-0b910bae12fa",
                        "entry_id": "447b5431-ae99-3c64-a63b-3e3c04e2238a",
                        "tags": [
                            "plural"
                        ],
                        "form": "occultations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b37537fe-384f-3c3d-aea3-9a8d67af187d",
                        "entry_id": "447b5431-ae99-3c64-a63b-3e3c04e2238a",
                        "glosses": [
                            "Disparition passagère d’un astre qui est caché par un autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2b03332-9bed-4370-9574-08fbad1b5796",
                                "sense_id": "b37537fe-384f-3c3d-aea3-9a8d67af187d",
                                "text": "[…] je demande uniquement qu’un coin du ciel, rien qu’un petit coin, celui dans lequel s’opérera l’occultation, soit pur de tout nuage, et pendant combien de temps ? pendant quatre minutes seulement !"
                            }
                        ]
                    },
                    {
                        "sense_id": "cb2fb40d-aaeb-3624-b929-8df387cf8f73",
                        "entry_id": "447b5431-ae99-3c64-a63b-3e3c04e2238a",
                        "glosses": [
                            "Dissimulation d’une réalité ou d’une vérité."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "10639999-db74-4ace-badc-3c6c7e819c68",
                                "sense_id": "cb2fb40d-aaeb-3624-b929-8df387cf8f73",
                                "text": "Entre les femmes et le libertinage, l’articulation est plus hésitante et « capricieuse » : il faut étudier les pratiques et les représentations pour faire la part des occultations vertueuses et des fabrications fantasmatiques, …."
                            }
                        ]
                    },
                    {
                        "sense_id": "af2f953d-271e-3626-8404-1320d9f6b363",
                        "entry_id": "447b5431-ae99-3c64-a63b-3e3c04e2238a",
                        "glosses": [
                            "Interdiction d’une zone aux regards extérieurs, au moyen de panneaux, rideaux etc."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "7ad67feb-b7b7-458d-bceb-7e5f071e394b",
                                "sense_id": "af2f953d-271e-3626-8404-1320d9f6b363",
                                "text": "Venez découvrir notre large choix de panneaux d’occultation : lattes pvc, lattes bois, haie artificielle..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "adc2cb7c-123d-428f-ae77-dce43b2a51b9",
                        "source_entry_id": "447b5431-ae99-3c64-a63b-3e3c04e2238a",
                        "target_lang_word": "occultation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "occultation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6145451-76af-36c1-a19e-b6abb1d0680b",
                                        "entry_id": "2dcd709e-6815-35a5-be5a-296ac5d11597",
                                        "glosses": [
                                            "An astronomical event that occurs when one celestial object is hidden by another celestial object that passes between it and the observer when the nearer object appears larger and completely hides the more distant object."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83084b2e-14fc-4e58-9286-9cd6c8db1faf",
                                                "sense_id": "f6145451-76af-36c1-a19e-b6abb1d0680b",
                                                "text": "[T]he diſtance of any place within this kingdom from it, will not much vary the manner of their Appearance in any of the Phænomena, except the Eclipſe of the Sun: for, in the Occultations, the Stars will appeare to paſs nearly under the ſame Angles and Spots of the Moon; […]"
                                            },
                                            {
                                                "example_id": "192fdc67-4b02-43be-b58f-8c755bc631b0",
                                                "sense_id": "f6145451-76af-36c1-a19e-b6abb1d0680b",
                                                "text": "The bright star Aldebaran is to be occulted by the moon on December 20th, at about 5 o'clock pm. Aldebaran is said to be eight hundred and eighty times the mass of the sun, with a diameter of over 8,000,000 miles; a distance so great that a meteor traveling at the rate of thirty miles per second, would require over three days to cross the disk of the star. Yet, notwithstanding the immense volume, the accultation will occur in a moment, so great is the distance of the star from us, and will continue for about one hour and eight minutes."
                                            },
                                            {
                                                "example_id": "db4364cb-9dfe-4250-881e-34155f0177b0",
                                                "sense_id": "f6145451-76af-36c1-a19e-b6abb1d0680b",
                                                "text": "Stellar occultations potentially provide the highest precision data for relating solar system ephemerides to the stellar reference frame. For example, occultations by the Uranian rings can define the position of the occulted star relative to the rings to better than 0.02 mas (equivalent to a few hundred meters at the distance of Uranus). Occultations by atmospheres can be less precise than occultations by symmerical solid bodies, like rings and large asteroids, with a precision on the order of 1.0 mas."
                                            },
                                            {
                                                "example_id": "a39f440b-3d1c-4469-8205-11fbee567f4e",
                                                "sense_id": "f6145451-76af-36c1-a19e-b6abb1d0680b",
                                                "text": "[…] I was thrilled at the prospect of seeing the waning crescent Moon swing over Venus in the predawn sky on Wednesday morning, April 22, 2009. While the occultation was visible from much of North America, it was only in Arizona and parts of other surrounding states, where Wendee and I live, that the ingress would take place in a completely dark sky. It would be a highlight of the International Year of Astronomy, which reached its peak during 2009."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b60013d4-f6aa-3315-bd57-2dd47e18aff3",
                                        "entry_id": "2dcd709e-6815-35a5-be5a-296ac5d11597",
                                        "glosses": [
                                            "The state of being occult (“hidden, undetected”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "547e7611-493b-41d3-8ed5-99441518611a",
                                                "sense_id": "b60013d4-f6aa-3315-bd57-2dd47e18aff3",
                                                "text": "If Mr. [Thomas] Campbell's poetry was of a kind that could be forgotten, his long fits of silence would put him fairly in the way of that misfortune. […] [T]he re-appearance of such an author, after those long periods of occultation, is naturally hailed as a novelty—and he receives the double welcome of a celebrated stranger and a remembered friend."
                                            },
                                            {
                                                "example_id": "c371ef7c-fe78-4857-b52a-ff16cee95ca9",
                                                "sense_id": "b60013d4-f6aa-3315-bd57-2dd47e18aff3",
                                                "text": "In western Europe, the most celebrated instance of the occultation of a river was that of the Rhone, near Bellegarde, on the confines of France and Savoy, about 18 miles from Geneva; but, alas, on visiting this interesting spot in the autumn of 1855, I found that the Perte du Rhone no longer exists; for the Sardinian Government, in which territory it was, had blown up the rocky roof, beneath which it had been engulfed, in order to facilitate the conveyance of timber on the river."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c14bd177-dbbb-38d1-b6b1-1fb5c82472fa",
                                        "entry_id": "2dcd709e-6815-35a5-be5a-296ac5d11597",
                                        "glosses": [
                                            "The disappearance of the Twelfth Imam, or Mahdi, who is believed alive and present in this world, but hidden until his reappearance at the end of time."
                                        ],
                                        "tags": [
                                            "Shia",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cb289eb-367b-42a1-82b5-580c81306060",
                                                "sense_id": "c14bd177-dbbb-38d1-b6b1-1fb5c82472fa",
                                                "text": "We are therefore, constantly hoping for the joy and happiness, personified in Imām al-Mahdi, the Imām who is alive at this very time, and who is himself awaiting the command of Allāh to reappear, so that he may strengthen the weak, and judge the oppressors. He will reappear \"without having done Bay'ah to any oppressor\". He went into occultation because he did not want [to] submit to any unjust ruler."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9dff74b-16d5-4065-8d4a-4f91d1b6174a",
                        "source_entry_id": "447b5431-ae99-3c64-a63b-3e3c04e2238a",
                        "target_lang_word": "ocultación",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ocultación",
