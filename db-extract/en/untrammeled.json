                                    {
                                        "sense_id": "0d3c7199-df57-32da-9af3-d04f0bbad7db",
                                        "entry_id": "7004eb75-e99c-3125-b141-1fbaa3dc42bb",
                                        "glosses": [
                                            "zonder opgelegde beperkingen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2c24d20-4696-4fcb-9010-2f188f524aea",
                                                "sense_id": "0d3c7199-df57-32da-9af3-d04f0bbad7db",
                                                "text": "De vaak ongelimiteerde toekenning van hypotheken heeft een economische crisis veroorzaakt."
                                            },
                                            {
                                                "example_id": "3e7ca8d6-2a2c-49ae-91b4-3db1b59978c7",
                                                "sense_id": "0d3c7199-df57-32da-9af3-d04f0bbad7db",
                                                "text": "Ze raken de discussie over de vrijheid van onderwijs, een van de grootste verworvenheden van onze parlementaire democratie. Maar die vrijheid is natuurlijk nooit ongelimiteerd geweest. Als je er gebruik van maakt, moet je voldoen aan de eisen die de wetgever stelt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6aa19243-3541-4099-80f6-3a9ba2023827",
                        "source_entry_id": "086c1ddf-254f-3d29-bade-d6edef383e3d",
                        "source_sense_id": "39c931d5-0ab9-32f3-b2c9-cd71eef351d7",
