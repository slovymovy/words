                                "example_id": "85d491e8-72e1-451d-ac5e-94637a63fc66",
                                "sense_id": "6276abea-1992-3c5c-9f73-475aa1ae8ac6",
                                "text": "Wir müssen die Bejagung des Niederwildes intensivieren."
