                                    {
                                        "sense_id": "0ee37db2-1c63-38a3-b29e-c6effd10efc2",
                                        "entry_id": "0891d8df-74f3-3a13-a993-20dc59601b09",
                                        "glosses": [
                                            "A nutrient or food believed to have curative properties; a food used as a drug."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a018d59-fdd9-4fad-9e81-4d0bb19d0dfa",
                                                "sense_id": "0ee37db2-1c63-38a3-b29e-c6effd10efc2",
                                                "text": "The latest nutraceutical nostrum could come from the blueberry."
                                            },
                                            {
                                                "example_id": "4fda889e-b272-4a7e-b7f2-c4884a0d6b56",
                                                "sense_id": "0ee37db2-1c63-38a3-b29e-c6effd10efc2",
                                                "text": "Japan, where the probiotic drink Yakult was invented in 1935, is regarded as the homeland of nutraceuticals. Thanks to a lighter legislative touch than in Europe it’s also relatively easy for food manufacturers to claim special powers for their products."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
