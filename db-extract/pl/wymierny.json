                "translations": [
                    {
                        "translation_id": "9bb3e02e-be33-4150-b012-40c339f2f07c",
                        "source_entry_id": "a25966d1-74e1-3f9d-ba59-3ca67872fded",
                        "source_sense_id": "c8e09ab7-a991-389f-9be2-b384d6a48654",
                        "target_lang_word": "rational",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rational",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d80cb0b-4ce5-3c9a-b505-b0aa23a52624",
                                        "entry_id": "c7b67226-e0fb-3081-9135-a24d5d356d39",
                                        "glosses": [
                                            "Capable of reasoning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce08299b-2292-4168-ab65-99645595cbf2",
                                                "sense_id": "6d80cb0b-4ce5-3c9a-b505-b0aa23a52624",
                                                "text": "Man is a rational creature."
                                            },
                                            {
                                                "example_id": "21d0f691-621a-4024-b415-c8c3f9f8a66c",
                                                "sense_id": "6d80cb0b-4ce5-3c9a-b505-b0aa23a52624",
                                                "text": "The utility of valid arguments is a monument to our frailty: to the fact that we are not completely rational beings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "482b6a15-16b2-36d2-89d0-cb4929917fa0",
                                        "entry_id": "c7b67226-e0fb-3081-9135-a24d5d356d39",
                                        "glosses": [
                                            "Logically sound; not self-contradictory or otherwise absurd."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72cdd04b-3e4e-4134-aad4-6657107b2936",
                                                "sense_id": "482b6a15-16b2-36d2-89d0-cb4929917fa0",
                                                "text": "His statements were quite rational."
                                            },
                                            {
                                                "example_id": "93be1220-8d86-425c-b1ae-7a16c123e2d6",
                                                "sense_id": "482b6a15-16b2-36d2-89d0-cb4929917fa0",
                                                "text": "Prevention for the future is now almost universally allowed to be the only rational plea for the infliction of punishment; but this, when left to the arbitrary discretion of individuals, always has been found, and always will be found, to degenerate into the exercise of revenge for the past."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04865094-1000-3d77-a384-69f51a40f8c4",
                                        "entry_id": "c7b67226-e0fb-3081-9135-a24d5d356d39",
                                        "glosses": [
                                            "Healthy or balanced intellectually; exhibiting reasonableness."
                                        ],
                                        "tags": [
                                            "of a person or personal characteristics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a811ba36-7dfb-4ead-afa9-02a602a08e9d",
                                                "sense_id": "04865094-1000-3d77-a384-69f51a40f8c4",
                                                "text": "rational conduct"
                                            },
                                            {
                                                "example_id": "aa0c1740-936b-4fd5-b23d-4bdf7f787b11",
                                                "sense_id": "04865094-1000-3d77-a384-69f51a40f8c4",
                                                "text": "Temperature 99.8 degrees. Pulse 104. She was quite conscious and rational at times, at others very noisy."
                                            },
                                            {
                                                "example_id": "0901292c-c046-4422-a4f1-790f13d88dbc",
                                                "sense_id": "04865094-1000-3d77-a384-69f51a40f8c4",
                                                "text": "The [Isaac] Newton that emerges from the [unpublished] manuscripts is far from the popular image of a rational practitioner of cold and pure reason. The architect of modern science was himself not very modern. He was obsessed with alchemy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2be147cf-a939-312d-8077-1251505aee45",
                                        "entry_id": "c7b67226-e0fb-3081-9135-a24d5d356d39",
                                        "glosses": [
                                            "Comprising, or expressible as, a ratio",
                                            "Of a number, capable of being expressed as the ratio of two integers."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32965a02-4dfa-4cad-a1c9-117ee306d57e",
                                                "sense_id": "2be147cf-a939-312d-8077-1251505aee45",
                                                "text": "¾ is a rational number, but √2 is an irrational number."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "669f4d4d-6750-3aaa-b4d7-ca02fa297c35",
                                        "entry_id": "c7b67226-e0fb-3081-9135-a24d5d356d39",
                                        "glosses": [
                                            "Comprising, or expressible as, a ratio",
                                            "Of an algebraic expression in indeterminates, or more generally a function: capable of being expressed as the ratio of two polynomials."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8c1addf-2cfd-3435-b3b3-c61ff246ab4a",
                                        "entry_id": "c7b67226-e0fb-3081-9135-a24d5d356d39",
                                        "glosses": [
                                            "Comprising, or expressible as, a ratio",
                                            "Of a variety: (informally) geometrically simple almost everywhere; (formally) birationally equivalent to projective space"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56464744-9928-30e4-b558-8c797308fd44",
                                        "entry_id": "c7b67226-e0fb-3081-9135-a24d5d356d39",
                                        "glosses": [
                                            "Comprising, or expressible as, a ratio",
                                            "Of a function between varieties: acting as a morphism on an open subset of its domain."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d578df2d-229d-3db0-bd57-27d09514d6d1",
                                        "entry_id": "c7b67226-e0fb-3081-9135-a24d5d356d39",
                                        "glosses": [
                                            "Comprising, or expressible as, a ratio",
                                            "Of a point on an algebraic variety over a field: whose coordinates belong to the field in question (in contrast to those points of the variety which are only defined over the algebraic closure of the base field)."
                                        ],
                                        "tags": [
