                        "glosses": [
                            "Puder, der aufs Gesicht aufgetragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72280474-5362-4e6c-a651-88af4b7134c3",
                                "sense_id": "99f20102-3356-3ffe-aede-d96fd55660b0",
                                "text": "„Mabel benutzte nichts dergleichen, nicht einmal Gesichtspuder.“"
                            },
                            {
                                "example_id": "b086ab25-9516-4a88-9372-05bda344ca56",
                                "sense_id": "99f20102-3356-3ffe-aede-d96fd55660b0",
                                "text": "„Eine Mauer zu ihrer Linken war mit Werbung für Zement und Gesichtspuder bemalt.“"
                            },
                            {
                                "example_id": "9de7c110-284f-4144-9a7e-d6684ee2b19a",
                                "sense_id": "99f20102-3356-3ffe-aede-d96fd55660b0",
                                "text": "„Sie beugt sich so nah an sie heran, dass sie das Gesichtspuder in Grace' Falten, in ihren Rhytiden, und die krakeligen roten Linien sehen kann, wo der Lippenstift in die Runzeln unter dem Mund gelaufen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
