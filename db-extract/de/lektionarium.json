                "senses": [
                    {
                        "sense_id": "05dcba9d-2e73-3948-acee-c80e1a34a90b",
                        "entry_id": "1abc7fdc-b5c0-3e86-9aef-4d3352584c23",
                        "glosses": [
                            "liturgisches Buch, das die biblischen Lesungen im Ablauf des Kirchenjahres zum Vortrag beim Gottesdienst enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9d5d98a-bc44-44bb-b998-e624cba880a7",
                                "sense_id": "05dcba9d-2e73-3948-acee-c80e1a34a90b",
                                "text": "„Nur die anglikanische Kirche besitzt ein vorgeschriebenes Lektionarium, dasselbe ist aber echt reformiert auf Erschöpfung und Wiederholung des gesamten biblischen Stoffes angelegt.“"
                            },
                            {
                                "example_id": "65965434-cc53-48b7-9627-7f731cfc6d1e",
                                "sense_id": "05dcba9d-2e73-3948-acee-c80e1a34a90b",
                                "text": "„In einigen wurde er auch in der Form eines Kirchenbuches oder Lektionariums aufbewahrt; denn dass die uns in dieser Form überkommenen Bücher zum kirchlichen Gebrauch wirklich angewendet worden seyn, kann ich mich nicht überreden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
