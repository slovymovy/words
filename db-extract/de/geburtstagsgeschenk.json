                "senses": [
                    {
                        "sense_id": "c55e8886-b1b0-31d3-929e-23ce918e8cfa",
                        "entry_id": "27018dff-19ff-3b28-86b3-7b1231fa62cd",
                        "glosses": [
                            "Cadeau d’anniversaire"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc7b28a7-7d92-4b1b-8999-2b7c7134e7f4",
                                "sense_id": "c55e8886-b1b0-31d3-929e-23ce918e8cfa",
                                "text": "Er hat sich sehr gefreut über sein Geburtstagsgeschenk.",
                                "translation": "Son cadeau d’anniversaire lui a beaucoup plu."
                            },
                            {
                                "example_id": "2e2f1f9e-8df3-4bb5-bf93-7a422d293bc6",
                                "sense_id": "c55e8886-b1b0-31d3-929e-23ce918e8cfa",
                                "text": "Alle Kollegen haben zusammengelegt, um Detlef ein Geburtstagsgeschenk zu kaufen.",
                                "translation": "Tous les collègues se sont cotisés pour acheter un cadeau d'anniversaire à Detlef."
                            }
                        ]
                    }
                ],
