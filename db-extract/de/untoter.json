                ],
                "senses": [
                    {
                        "sense_id": "b965dd7e-56c9-305a-baec-5e834deefe7a",
                        "entry_id": "e7bac9c9-a899-3d89-ad09-1ec5fb6fd089",
                        "glosses": [
                            "Die Leiche eines Menschen, die meist in Mythen und Sagen wegen hexischer Zauberei wiederauferstanden ist und bösen Zwecken dient; wiederbelebter Toter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4095a14d-c8a8-4465-ba10-0c91d90225fb",
                                "sense_id": "b965dd7e-56c9-305a-baec-5e834deefe7a",
                                "text": "Die Untoten schwärmten aus den Grüften heraus und begaben sich in die Nähe der Dörfer."
                            },
                            {
                                "example_id": "e9c975e3-aace-417f-a886-039379f660f6",
                                "sense_id": "b965dd7e-56c9-305a-baec-5e834deefe7a",
                                "text": "Weil weit und breit niemand in Sicht ist, der dem organisierten Liberalismus in Deutschland ein Profil verschaffen könnte, muss Angela Merkel mit politisch Untoten regieren. Außenpolitik, Wirtschaft, Justiz oder Gesundheit sind aber viel zu wichtig, um sie Zombies ohne Kompass zu überlassen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c79d2f1e-244b-4fb0-8eb9-3c3e25e9e1f5",
                        "source_entry_id": "e7bac9c9-a899-3d89-ad09-1ec5fb6fd089",
                        "source_sense_id": "b965dd7e-56c9-305a-baec-5e834deefe7a",
                        "target_lang_word": "undead",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b700733-465c-3e28-90c0-696d2b48a0ad",
                                        "entry_id": "d1a32513-1154-3643-985d-4692b397d6f5",
                                        "glosses": [
                                            "Not dead; alive."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e6d458b-59fd-3429-9e3a-74612a080b3c",
                                        "entry_id": "d1a32513-1154-3643-985d-4692b397d6f5",
                                        "glosses": [
                                            "Pertaining to a corpse, though having qualities of life."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6447c903-5bd1-396b-b658-4844ef81278b",
                                        "entry_id": "d1a32513-1154-3643-985d-4692b397d6f5",
                                        "glosses": [
                                            "Being animate, though non-living."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35fd9fbe-16f2-4dd3-8e2b-612762124596",
                                                "sense_id": "6447c903-5bd1-396b-b658-4844ef81278b",
                                                "text": "When Anna and John finally break out of their self-centered bubbles to the shock that they must battle to the death an undead neighbor in a giant snowman costume, it plays like a poignant comment on movie teenagers' tendency to indulge their inner lives, ignorant of the world around them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "undead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "767a62a7-ad33-3e2f-bff2-d3487b0fdf07",
                                        "entry_id": "ac070445-17ac-3d12-b675-20979f82d5a3",
                                        "glosses": [
                                            "A creature that is undead; that is, dead but still animate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dfbc6d0-dfae-4c25-ba1f-bb0735d2ff11",
                                                "sense_id": "767a62a7-ad33-3e2f-bff2-d3487b0fdf07",
                                                "text": "\"You will do me a service,\" the undead said to him."
                                            },
                                            {
                                                "example_id": "acb2b679-658e-418b-ba99-3e42aae0713c",
                                                "sense_id": "767a62a7-ad33-3e2f-bff2-d3487b0fdf07",
                                                "text": "In the zombie movie, an army of the undead accosted some unsuspecting teenagers."
                                            },
                                            {
                                                "example_id": "cb9a4ea5-3245-4b72-90bb-3419e5de31eb",
                                                "sense_id": "767a62a7-ad33-3e2f-bff2-d3487b0fdf07",
                                                "text": "Innocent VIII lent credibility to the actual existence of undeads, an action that perpetuated, and even stimulated, vampire hysteria."
                                            },
                                            {
                                                "example_id": "6c44b028-89b7-444d-9c07-2dff5ed1dac3",
                                                "sense_id": "767a62a7-ad33-3e2f-bff2-d3487b0fdf07",
                                                "text": "\"Were another of the Un-Dead, like him, to try to do what he has done, perhaps not all the centuries of the world that have been, or that will be, could aid him.\""
                                            },
                                            {
                                                "example_id": "73cd7e59-4765-4422-ac04-9d1ed7c71e77",
                                                "sense_id": "767a62a7-ad33-3e2f-bff2-d3487b0fdf07",
                                                "text": "Harley got devoured by the undead / Lurking down in some old wizard's tomb / You can say there's no such thing as zombies / But that's how Harley Warren met his doom"
                                            },
                                            {
                                                "example_id": "cb15cbc7-f620-45bf-882c-59b09a04ef3c",
                                                "sense_id": "767a62a7-ad33-3e2f-bff2-d3487b0fdf07",
                                                "text": "It’s an episode of characters returning to their own pasts as different people. They can retrench like Cersei, back on her bullshit, I mean, warpath. Or they can adapt, like The Hound. Neither way necessarily ensures success, but we know the archmaester isn’t unequivocally right. We’ve seen dragons reborn and armies of the undead. I wouldn’t be so sure that Wall will stand forever."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2e264b2-c6a2-4be5-830e-ff47a1f96073",
                        "source_entry_id": "e7bac9c9-a899-3d89-ad09-1ec5fb6fd089",
                        "source_sense_id": "b965dd7e-56c9-305a-baec-5e834deefe7a",
                        "target_lang_word": "mort-vivant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mort-vivant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb2847a6-4b00-3ef3-8fa4-8fa83260a981",
                                        "entry_id": "cf4c8f28-a2e9-3221-ae5f-5fd788c245c3",
                                        "glosses": [
                                            "Cadavre qui se meut comme s’il était animé."
                                        ],
                                        "tags": [
                                            "Fiction",
                                            "Fantastique",
                                            "Horreur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb861c8e-275c-4040-8e84-8dfd26a840bc",
                                                "sense_id": "eb2847a6-4b00-3ef3-8fa4-8fa83260a981",
                                                "text": "Ce film de zombies taïwanais, qui a fait scandale au festival de Gérardmer, n’a pas volé son interdiction aux moins de 16 ans ! Non seulement il est gorissime, mais il suit des morts-vivants dont la libido débordante présente des séquences à réserver aux âmes bien trempées."
                                            },
                                            {
                                                "example_id": "c795cb48-3411-47f7-a91b-9973f18a65fb",
                                                "sense_id": "eb2847a6-4b00-3ef3-8fa4-8fa83260a981",
                                                "text": "« J'aime encore plus les bonbons que les cadeaux ! » s'est exclamé Thomas , un mort-vivant de neuf ans qui passait l'Halloween non loin."
                                            },
                                            {
                                                "example_id": "9ae18580-1d18-4a53-9498-eb894d0f912f",
                                                "sense_id": "eb2847a6-4b00-3ef3-8fa4-8fa83260a981",
                                                "text": "Dans sa romance Veggy vs Zombies, Lydie Wallon a voulu donner une nouvelle chance au mort-vivant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "792ee91f-ec09-3f36-84c0-fb8a0f52a142",
                                        "entry_id": "cf4c8f28-a2e9-3221-ae5f-5fd788c245c3",
                                        "glosses": [
                                            "Personne, homme ou femme, qui est si affaiblie qu’elle semble morte ou près de mourir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10094dee-8096-49d9-af3d-bf1d08df0cc1",
                                                "sense_id": "792ee91f-ec09-3f36-84c0-fb8a0f52a142",
                                                "text": "Dans ce camp, ce n’était plus des hommes ni des femmes, c’était des morts-vivants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7849eb7-a536-3b1b-8209-a72e7c527b2f",
                                        "entry_id": "cf4c8f28-a2e9-3221-ae5f-5fd788c245c3",
                                        "glosses": [
                                            "Personne très peu active."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5047c58d-73b0-49a4-9418-0a279860e3af",
                                                "sense_id": "f7849eb7-a536-3b1b-8209-a72e7c527b2f",
                                                "text": "Il n’avais jamais compris pourquoi tous ces gens, dans les casinos, restaient longtemps autour des tables, silencieux, immobiles, avec leurs têtes de morts-vivants."
                                            },
                                            {
                                                "example_id": "6228fa4f-979c-45e9-a049-af3a85525fad",
                                                "sense_id": "f7849eb7-a536-3b1b-8209-a72e7c527b2f",
                                                "text": "Filant la métaphore d’Epinay, il reconnaissait tout de même, une semaine avant le rendez-vous d’Aubervilliers : « Nous serons peut être un théâtre d’ombres, mais ces ombres continueront à avancer. » De là à parler d’un parti de morts-vivants, il n’y a qu’un pas."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mort-vivant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d343501e-9309-3a38-92e8-4c7ed12d2069",
                                        "entry_id": "11252dae-1e81-3e69-a1ef-ce25c50c6848",
                                        "glosses": [
                                            "Qui bouge tout en étant mort. Qui est un mort-vivant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ecc8964-4e94-30ff-9af3-44c901d14255",
                                        "entry_id": "11252dae-1e81-3e69-a1ef-ce25c50c6848",
                                        "glosses": [
                                            "Qui se comporte comme un mort-vivant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
