        "de-extract.jsonl": [
            {
                "entry_id": "e8960f04-b3f2-3e55-b5a5-c9b42301c11f",
                "word": "curriculum",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6d8e1580-5ed7-3002-83e8-4b701931b4fb",
                        "entry_id": "e8960f04-b3f2-3e55-b5a5-c9b42301c11f",
                        "glosses": [
                            "Curriculum, Lehrplan, Studieninhalte"
                        ],
                        "tags": [
                            "Pädagogik"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d54a6fb-0273-4b78-a8ba-4befbb3e8bbc",
                        "source_entry_id": "e8960f04-b3f2-3e55-b5a5-c9b42301c11f",
                        "source_sense_id": "6d8e1580-5ed7-3002-83e8-4b701931b4fb",
                        "source_sense_description": "Pädagogik: Curriculum, Lehrplan, Studieninhalte",
                        "target_lang_word": "Curriculum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Curriculum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "321d726a-8db2-3856-a6b9-123e6e7750e1",
                                        "entry_id": "972307eb-8ff3-335d-80de-820874f2cb47",
                                        "glosses": [
                                            "eine präzise Regelung und Festlegung aller Lernziele und Lerninhalte sowie der zugehörigen Lernprozesse und der zugehörigen Lernorganisation für ein Unterrichtsfach und für einen bestimmten Zeitraum (Schuljahr, Semester)"
                                        ],
                                        "tags": [
                                            "Pädagogik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "607f59da-b547-47d2-8ea2-872ec8a045b3",
                                                "sense_id": "321d726a-8db2-3856-a6b9-123e6e7750e1",
                                                "text": "Für die Oberstufe wurden vollkommen neue Curricula entwickelt."
                                            },
                                            {
                                                "example_id": "9718a994-7322-4c27-976b-52d3c4cd5b9d",
                                                "sense_id": "321d726a-8db2-3856-a6b9-123e6e7750e1",
                                                "text": "„In der Literatur bisher weniger beachtet wurden die in den siebziger Jahren entwickelten Curricula […] zu einem mehrperspektivischen Unterricht […], in denen Lernen in Projekten und Kursen das grundlegende Vermittlungsverfahren ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3cc309c2-3e5d-3533-8afd-4cee50c9bbd4",
                                        "entry_id": "972307eb-8ff3-335d-80de-820874f2cb47",
                                        "glosses": [
                                            "der Lebenslauf (In international geprägten, jedoch primär deutschsprachigen Umfeldern wird „Curriculum“ oft synonym für „Lebenslauf“ als Kurzform für das aus dem Englischen übernommene curriculum vitae, das auf die gleichnamige lateinische Bezeichnung zurückzuführen ist, verwendet.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08d7c28f-0d0e-4da8-a221-e9c39d8fd70b",
                                                "sense_id": "3cc309c2-3e5d-3533-8afd-4cee50c9bbd4",
                                                "text": "Mail' mir doch bitte dein Curriculum zu."
                                            },
                                            {
                                                "example_id": "6534b456-0e0e-4c8f-8c33-48cf873b849c",
                                                "sense_id": "3cc309c2-3e5d-3533-8afd-4cee50c9bbd4",
                                                "text": "„Sie verwendete mehr Zeit und Rührung auf die Darlegung des Curriculums der Anwälte als darauf, Worte über die wiedergewonnene Anwesenheit ihre Ehemannes zu verlieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b40003a-b908-4696-a1dd-869f45bf3850",
                        "source_entry_id": "e8960f04-b3f2-3e55-b5a5-c9b42301c11f",
                        "source_sense_id": "6d8e1580-5ed7-3002-83e8-4b701931b4fb",
                        "source_sense_description": "Pädagogik: Curriculum, Lehrplan, Studieninhalte",
                        "target_lang_word": "Lehrplan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lehrplan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "320ab7f2-a394-3f06-9cf3-26308c1cd6ff",
                                        "entry_id": "90762007-eb3f-3036-9f22-78ff5fdf8202",
                                        "glosses": [
                                            "Entwurf, der Lehrziele, Lehrinhalte, didaktische und gestalterische Hinweise enthält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "161973ed-8670-4bb1-b00b-681b81373279",
                                                "sense_id": "320ab7f2-a394-3f06-9cf3-26308c1cd6ff",
                                                "text": "„Der Begriff Schulwissen bezeichnet jenes Wissen, das in Schulen nach Lehrplänen vermittelt wird.“"
                                            },
                                            {
                                                "example_id": "de842f45-9c71-4e22-be5c-4f709bc5340b",
                                                "sense_id": "320ab7f2-a394-3f06-9cf3-26308c1cd6ff",
                                                "text": "„Ungehindert verwirklichen konnte er seine Lehrpläne aber erst an der Ritterakademie zu Halle, die unter seiner Mitwirkung dann 1694 zur Universität ausgebaut wurde.“"
                                            },
                                            {
                                                "example_id": "78b086e5-9216-4714-af35-f351e6ce755f",
                                                "sense_id": "320ab7f2-a394-3f06-9cf3-26308c1cd6ff",
                                                "text": "„Nie hatte Alf jemals eine Frage über den Lehrplan gestellt - sie wußten bereits vieles, was er nicht wußte, er war nie zusammengekommen mit Aktiv und Passiv, Konditional und Gerundium, mit dem lateinischen Ablativus absolutus.“"
                                            },
                                            {
                                                "example_id": "179ba089-4ec9-4ae2-9ba8-261e83055a35",
                                                "sense_id": "320ab7f2-a394-3f06-9cf3-26308c1cd6ff",
                                                "text": "„Als der Zweite Weltkrieg in meiner Oberschule auf dem Lehrplan stand, holte meine elsässische Großmutter einen Packen Schwarzweißfotos aus einer Schublade.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
