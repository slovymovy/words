                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "organisé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d307a21f-afb8-3cfa-baf9-24404f7211a7",
                                        "entry_id": "8b5b70ca-8a30-3e9b-8d4b-c814724bbf02",
                                        "glosses": [
                                            "Qualifie une personne ou une chose faisant preuve d’organisation, de logique, de rationalité, de pragmatisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da6e6f93-9b4d-42b2-b88a-7637164690a2",
                                                "sense_id": "d307a21f-afb8-3cfa-baf9-24404f7211a7",
                                                "text": "Je sais bien que les Français peuvent, en cas de guerre , compter sur leur armée , qui est peut-être la plus brave du monde. Mais est-elle suffisamment organisée ?"
                                            },
                                            {
                                                "example_id": "cdf00c48-9a02-489a-b4fc-9ba7d68c5804",
                                                "sense_id": "d307a21f-afb8-3cfa-baf9-24404f7211a7",
                                                "text": "Autrement dit, le meilleur allié du crime organisé est l’aveuglement politico-médiatique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "748d721f-79e0-3952-8d92-c97d28c41c3c",
                                        "entry_id": "8b5b70ca-8a30-3e9b-8d4b-c814724bbf02",
                                        "glosses": [
                                            "Qualifie une personne dont l’esprit a de la justesse et de la netteté, de la force et de l’étendue."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
