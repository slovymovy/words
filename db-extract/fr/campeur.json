                    },
                    {
                        "form_id": "fee4e1c8-082d-45a0-a491-d771390629b3",
                        "entry_id": "d28fd50c-bd27-38d9-a008-3549aa7edce6",
                        "tags": [
                            "feminine"
                        ],
                        "form": "campeuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "49fc0381-bf42-33f8-ab69-5b1388634bbc",
                        "entry_id": "d28fd50c-bd27-38d9-a008-3549aa7edce6",
                        "glosses": [
                            "Personne qui campe, qui pratique le camping."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4f95bb6-b3a1-4d03-8380-f31d2c5f2b5f",
                                "sense_id": "49fc0381-bf42-33f8-ab69-5b1388634bbc",
                                "text": "Par ailleurs, les sondages effectués démontrent que l'âge moyen du campeur adulte est passé de 28 ans en 1954 à 38 ans en 1964."
                            },
                            {
                                "example_id": "3a4e6be2-e2fb-4a0e-b7b4-96837bf20596",
                                "sense_id": "49fc0381-bf42-33f8-ab69-5b1388634bbc",
                                "text": "Pour planter sa tente, comptez 6 € la nuit (seul) et 10 € à 2 personnes, en basse saison. 160 emplacements attendent les campeurs au milieu de 2 ha de verdure, sur les bords de la Charente."
                            },
                            {
                                "example_id": "e15ee5c3-64ec-4360-bcf5-892cc7c6c0ed",
                                "sense_id": "49fc0381-bf42-33f8-ab69-5b1388634bbc",
                                "text": "C’est ce que nous allons voir en étudiant les différentes modalités d’insertion des campeurs dans la nature, puis l’installation du camp en camping sauvage ou en camp recommandé par les fédérations de campeurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ce2dbce-6fff-3965-a7ba-52fd398fb2cb",
                        "entry_id": "d28fd50c-bd27-38d9-a008-3549aa7edce6",
                        "glosses": [
                            "Joueur qui reste à la même zone stratégique lui permettant d’obtenir facilement des points."
                        ],
                        "tags": [
                            "Jeux vidéo"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "089418a9-318d-4c65-baa0-77f7366521a5",
                        "source_entry_id": "d28fd50c-bd27-38d9-a008-3549aa7edce6",
                        "source_sense_description": "Personne qui campe, qui pratique le camping.",
                        "target_lang_word": "camper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b350ad95-8b2e-3352-9021-ce22559febd0",
                                        "entry_id": "ad29765f-5204-376d-9638-189fbc2d762a",
                                        "glosses": [
                                            "A person who camps, especially in a tent etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3f7165d-1b31-484a-b114-023d48849205",
                                                "sense_id": "b350ad95-8b2e-3352-9021-ce22559febd0",
                                                "text": "There were thousands of campers at the music festival."
                                            },
                                            {
                                                "example_id": "2732ca6e-fe17-40a5-891e-42396f130516",
                                                "sense_id": "b350ad95-8b2e-3352-9021-ce22559febd0",
                                                "text": "They're indispensable for backpackers, campers and anyone else who plans to be away from a power outlet for a while; indeed, both the Solar and the Eco Player are ruggedly built, with rubberized nonscratchable surfaces."
                                            },
                                            {
                                                "example_id": "3e0f35c4-b181-435f-bf5e-5566e5e5888d",
                                                "sense_id": "b350ad95-8b2e-3352-9021-ce22559febd0",
                                                "text": "To be sung to in this way by the entire faery kingdom, each member of it born from the heartsong of a camper, was truly a delight that not many, I believe, have known."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28e2ad95-51ce-3c64-aa07-99e36c26682b",
                                        "entry_id": "ad29765f-5204-376d-9638-189fbc2d762a",
                                        "glosses": [
                                            "A motor vehicle with a rear compartment for living and sleeping in."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c71358e2-0aee-46a1-89c5-d786b626df47",
                                                "sense_id": "28e2ad95-51ce-3c64-aa07-99e36c26682b",
                                                "text": "The moonshiners are now only a memory, but the sunrisers have grown into many hundreds, with trailers and campers pulling into Red Rock Canyon days early for a good parking spot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c27f187-4dfe-3c1e-990d-5f27e633ee87",
                                        "entry_id": "ad29765f-5204-376d-9638-189fbc2d762a",
                                        "glosses": [
                                            "A person who stays in one spot during a first-person shooting game, to guard an item etc."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
