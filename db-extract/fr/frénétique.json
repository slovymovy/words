                    {
                        "translation_id": "b2e305e1-0a98-4503-8233-6e958b40f773",
                        "source_entry_id": "c11f5320-906f-3792-8a4f-fb2518e29fab",
                        "source_sense_description": "atteint de frénésie",
                        "target_lang_word": "frenzied",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frenzied",
