                            "Person, die die Folgen eines negativen Ereignisses ertragen muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64d9b9f7-8e22-4bc6-898b-c109663ebfba",
                                "sense_id": "a664ae4b-938c-3173-ac33-030d76901f19",
                                "text": "„In den vergangenen fünf Jahren gingen rund 1,5 Millionen Arbeitsplätze verloren. Leidtragende sind die Jungen. 35 Prozent der Unter-24-Jährigen sind im Landesdurchschnitt ohne Job.“"
                            },
                            {
                                "example_id": "7c33acc6-7009-44f1-a500-9c6c0cd96202",
                                "sense_id": "a664ae4b-938c-3173-ac33-030d76901f19",
                                "text": "„Auch sie sind Leidtragende, aber nicht die Leidtragenden, um die es in diesem Buch gehen soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
