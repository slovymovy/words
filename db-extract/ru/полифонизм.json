                "senses": [
                    {
                        "sense_id": "4f711ba3-ee7f-3e27-aa29-f6ec2e0b20f1",
                        "entry_id": "3052acab-ee43-3a30-ac0e-3eec8af872c8",
                        "glosses": [
                            "муз. многозвучность, многоголосие, многотонность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f365744c-e89f-471d-ba5d-4085f5c8e7e4",
                                "sense_id": "4f711ba3-ee7f-3e27-aa29-f6ec2e0b20f1",
                                "text": "Разговоры велись о музыке и закончились игрой всех по очереди своих сочинений. Юра поразил своими архаическими полифонизмами. Юноша — Саша — показал какой-то робкий маршеобразный отрывок."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e1c41a2-50a3-3688-8d6a-c64e435a792a",
                        "entry_id": "3052acab-ee43-3a30-ac0e-3eec8af872c8",
                        "glosses": [
                            "перен., филол. многообразие тем литературного произведения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb526964-4f31-4707-a6c5-13d1957de4fe",
                                "sense_id": "5e1c41a2-50a3-3688-8d6a-c64e435a792a",
                                "text": "«Какие социальные факты отражались в шекспировском полифонизме?"
                            }
                        ]
                    }
