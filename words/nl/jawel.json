                {
                    "sense_id": "43e85ddb-9795-3c87-aeab-32ed76201a0a",
                    "sense_definition": "Een nadrukkelijke of beleefde vorm van bevestiging.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Jawel</w> hoor, dat mag je gerust van mij lenen.",
                            "target_lang_translations": {
                                "ru": "<w>Конечно</w>, ты можешь спокойно это у меня одолжить.",
                                "en": "<w>Yes</w> sure, you are welcome to borrow that from me.",
                                "pl": "<w>Oczywiście</w>, możesz to ode mnie śmiało pożyczyć.",
                                "de": "<w>Ja</w> klar, das darfst du gerne von mir ausleihen.",
                                "fr": "<w>Bien sûr</w>, tu peux tout à fait me l'emprunter.",
                                "it": "<w>Certamente</w>, puoi tranquillamente prenderlo in prestito da me.",
                                "cs": "<w>Samozřejmě</w>, klidně si to ode mě můžeš půjčit.",
                                "tr": "<w>Elbette</w>, onu benden gönül rahatlığıyla ödünç alabilirsin.",
                                "es": "<w>Por supuesto</w>, puedes pedírmelo prestado sin problema.",
                                "zh": "<w>当然</w>可以，你尽管拿去用吧。"
                            }
                        },
                        {
                            "text": "\"Is dat echt waar?\" vroeg hij verbaasd. — \"<w>Jawel</w>, dat is zeker waar.\"",
                            "target_lang_translations": {
                                "ru": "«Это правда?» — удивленно спросил он. — «<w>Да</w>, это совершенно точно».",
                                "en": "\"Is that really true?\" he asked in surprise. — \"<w>Yes</w>, that is certainly true.\"",
                                "pl": "„Czy to naprawdę prawda?” — zapytał zdziwiony. — „<w>Oczywiście</w>, to na pewno prawda”.",
                                "de": "„Ist das wirklich wahr?“, fragte er erstaunt. — „<w>Ja</w>, das ist sicher wahr.“",
                                "fr": "« C'est vraiment vrai ? » demanda-t-il, surpris. — « <w>Bien sûr</w>, c'est tout à fait vrai. »",
                                "it": "\"È davvero vero?\" chiese sorpreso. — \"<w>Sì</w>, è assolutamente vero.\"",
                                "cs": "„Je to opravdu pravda?“ zeptal se překvapeně. — „<w>Jistě</w>, to je naprostá pravda.“",
                                "tr": "\"Bu gerçekten doğru mu?\" diye sordu şaşkınlıkla. — \"<w>Evet</w>, kesinlikle doğru.\"",
                                "es": "—¿Es eso realmente cierto? —preguntó sorprendido. —<w>Sí</w>, es totalmente cierto.",
                                "zh": "“那是真的吗？”他惊讶地问。——“<w>没错</w>，那绝对是真的。”"
                            }
                        }
                    ],
