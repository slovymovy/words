                                                "example_id": "bdd4013d-7b3e-4f71-bb6b-8116f27392d7",
                                                "sense_id": "00bb2e37-1b3b-34de-8d85-9e02aa869225",
                                                "text": "They have a very remote chance of winning."
                                            },
                                            {
                                                "example_id": "bbce5742-b672-41a8-b92b-8a8684381fce",
                                                "sense_id": "00bb2e37-1b3b-34de-8d85-9e02aa869225",
                                                "text": "You have a remote resemblance to my grandmother."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee28b2a1-403c-3683-beca-03828c38179c",
                                        "entry_id": "fbcc191b-4e8d-31ef-93eb-7b31f5b949c2",
                                        "glosses": [
                                            "Emotionally detached."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c679a69-f83c-4764-8ec3-eb8f21991fca",
                                                "sense_id": "ee28b2a1-403c-3683-beca-03828c38179c",
                                                "text": "After her mother's death, my friend grew remote for a time while she dealt with her grief."
                                            }
                                        ]
                                    }
                                ]
                            },
