                ],
                "senses": [
                    {
                        "sense_id": "31a0bb72-9910-313f-a9d4-d1f535365c7a",
                        "entry_id": "941d9748-98f7-36fd-805b-51cf09fb7040",
                        "glosses": [
                            "Rohr oder Kanal in dem Luft strömen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31ac2e31-9e17-4ac5-9d88-fd1d4c5c8f79",
                                "sense_id": "31a0bb72-9910-313f-a9d4-d1f535365c7a",
                                "text": "„Alternativen sind die Führung der Lüftungsleitungen in einem gemeinsamen, brandschutzseitig abgetrennten Schacht oder auch in ganz separaten Schächten vom Lüftungsgerät bis in jede Wohnung.“"
                            },
                            {
                                "example_id": "48c7b377-2aee-4bc8-846c-d516d467b67b",
                                "sense_id": "31a0bb72-9910-313f-a9d4-d1f535365c7a",
                                "text": "„Die Lüftungsleitung innerhalb des Abwasserleitungssystems nimmt kein Wasser auf, sondern dient der Be- und Entlüftung der Fallleitung.“"
                            },
                            {
                                "example_id": "8795385c-9957-4bf7-a3e4-e4ce3451573d",
                                "sense_id": "31a0bb72-9910-313f-a9d4-d1f535365c7a",
                                "text": "„Diese Abstände sind nicht erforderlich, wenn diese Baustoffe von den Außenflächen der Lüftungsleitungen bis zu einem Abstand von mindestens 1,5 m gegen Brandgefahr geschützt sind (z.B. durch eine mindestens 5 cm dicke Bekiesung oder durch mindestens 3 cm dicke, fugendicht verlegte Betonplatten).“"
                            },
                            {
                                "example_id": "33189e8a-ea49-4799-819c-2b3d6198ee9f",
                                "sense_id": "31a0bb72-9910-313f-a9d4-d1f535365c7a",
                                "text": "„Unter Umlüftung versteht man eine Lüftungsleitung, die eine Einzel- bzw. Sammelanschlussleitung zusätzlich lüftet.“"
                            },
                            {
                                "example_id": "62a15fa8-1f43-454b-a3d7-d5796a315670",
                                "sense_id": "31a0bb72-9910-313f-a9d4-d1f535365c7a",
                                "text": "„In der Lüftungsleitung ist eine Brandschutzklappe (BSK) als Vorbauklappe mit teilweiser L90-Einhausung integriert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
