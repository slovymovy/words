                "senses": [
                    {
                        "sense_id": "76b936b7-3b3f-3519-8a75-7fdb9f65ddcc",
                        "entry_id": "ddd480e7-1e9e-3c25-a98d-22cc34c5918f",
                        "glosses": [
                            "einfach gestalteter Kapellenbau oder abgeteilter Bereich in einem Hospital, der für persönliche Andachten oder auch Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69016d10-9562-47ce-ad48-3e8fbb3fe265",
                                "sense_id": "76b936b7-3b3f-3519-8a75-7fdb9f65ddcc",
                                "text": "„Die Hospitalkapelle in der Oberlahnsteiner Innenstadt gelegen, kann als Veranstaltungs- oder Trauort gemietet werden.“"
                            },
                            {
                                "example_id": "cbbc5ccb-508c-4080-8bab-6b7eb50ddf11",
                                "sense_id": "76b936b7-3b3f-3519-8a75-7fdb9f65ddcc",
                                "text": "„Die kleine, ursprünglich der Heiligen Gertraud geweihte Kirche war im Mittelalter eine Hospitalkapelle und wird heute als Friedhofskapelle genutzt.“"
                            },
                            {
                                "example_id": "2d342f67-7701-4781-b44e-301ecf046f25",
                                "sense_id": "76b936b7-3b3f-3519-8a75-7fdb9f65ddcc",
                                "text": "„Vom Kloster sind heute noch die um 1484 errichtete Hospitalkapelle (Hospitalplatz 5)[138] sowie das ehemalige Konventsgebäude mit einer historischen Inschrift von 1501 (Klosterstraße 1)[139] erhalten.“"
                            },
                            {
                                "example_id": "76e2483f-4498-489f-82c1-548dfbc6dbdd",
                                "sense_id": "76b936b7-3b3f-3519-8a75-7fdb9f65ddcc",
                                "text": "„Die heutige Friedhofskapelle ist die ursprüngliche Hospitalkapelle, auch Kapelle zum Heiligen Leichnam genannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
