                ],
                "senses": [
                    {
                        "sense_id": "cfe8794c-210b-3fd8-bb52-584ef4978c10",
                        "entry_id": "37e881cf-fff7-30f2-8bad-d50be5fdfb41",
                        "glosses": [
                            "angehender Priester, der in einem Priesterseminar eine priesterliche Ausbildung erfährt; strenggenommen: jemand, der durch die Admissio die Zulassung zur Vorbereitung auf die Priesterweihe erhalten hat"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "a4b2bbdf-c14a-4eb3-9236-297625275166",
                                "sense_id": "cfe8794c-210b-3fd8-bb52-584ef4978c10",
                                "text": "„Er begann sein Philosophie- und Theologiestudium als junger Priesteramtskandidat am Turiner Priesterseminar, an dem auch, in früheren Jahren, sein Priesteronkel als Regens tätig war.“"
                            },
                            {
                                "example_id": "82b76752-330e-4f87-9322-9e4c2104f6dd",
                                "sense_id": "cfe8794c-210b-3fd8-bb52-584ef4978c10",
                                "text": "„Statt dessen meldete er sich als Priesteramtskandidat der Diözese Osnabrück (beim damaligen Bischof Helmut Hermann Wittler) ab und ging in ein strenges Benediktinerkloster der Beuroner Kongregation nach Tholey im Saarland.“"
                            },
                            {
                                "example_id": "45d2a798-cd85-4411-b011-0d14d809bf68",
                                "sense_id": "cfe8794c-210b-3fd8-bb52-584ef4978c10",
                                "text": "„Damit soll der Tatsache Rechnung getragen werden, dass der Entscheid für eine Weihe reifen müsse und es nicht für alle leicht sei, sich von Beginn des Studiums an als Priesteramtskandidat zu bezeichnen.“"
                            },
                            {
                                "example_id": "2808f71c-1ff5-48e2-a3b1-ffdb45a0f476",
                                "sense_id": "cfe8794c-210b-3fd8-bb52-584ef4978c10",
                                "text": "„Infolgedessen ist die Vorbereitung der Priesteramtskandidaten auf die seelsorglichen Aufgaben in diesem Bereich reicher und realistischer geworden, als dies früher der Fall war.“"
                            },
                            {
                                "example_id": "94874c31-4e32-4ce4-abeb-97b381a0e8f4",
                                "sense_id": "cfe8794c-210b-3fd8-bb52-584ef4978c10",
                                "text": "„Im Herbst 2008 trat ich als Priesteramtskandidat in das Priesterseminar von Eichstätt ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
