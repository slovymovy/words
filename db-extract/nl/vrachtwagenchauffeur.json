                                    {
                                        "sense_id": "0a2a7e0a-af50-35a0-ae58-53debd720b17",
                                        "entry_id": "3b1f939e-11bc-304e-9698-30bc4c865356",
                                        "glosses": [
                                            "Person, die einen Lastkraftwagen steuert/fährt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f56adbe-aae2-4f4c-8781-3c288e607c86",
                                                "sense_id": "0a2a7e0a-af50-35a0-ae58-53debd720b17",
                                                "text": "„Es ist nicht einfach, Frauen aufzureißen, wenn sich bärtige LKW-Fahrer um einen drängen, die alles versuchen, um einem den Schädel abzulecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
