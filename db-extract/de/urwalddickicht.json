                    {
                        "sense_id": "bd76f47a-6d1d-37ff-a3c4-55c49973964b",
                        "entry_id": "b710028b-210c-399e-8e96-007aa3fe6746",
                        "glosses": [
                            "dichtes Gestrüpp, wie es sich in einem Urwald entwickeln kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff1e0519-4c48-4d76-b8e1-aa29dc291ac7",
                                "sense_id": "bd76f47a-6d1d-37ff-a3c4-55c49973964b",
                                "text": "„Denissow verzog das Gesicht zu einer Art von Grinsen, das seine kurzen, kräftigen Zähne sichtbar werden liess, und begann mit beiden kurzfingerigen Händen im Urwalddickicht seiner schwarzen Haare zu wühlen.“"
                            },
                            {
                                "example_id": "76790041-00dd-488c-b96a-45c95cc38257",
                                "sense_id": "bd76f47a-6d1d-37ff-a3c4-55c49973964b",
                                "text": "„Um Mitternacht glitt das Schiff von Rankling Sahib, geführt von Amina, durch das Labyrinth aus Urwalddickicht und Wasserläufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
