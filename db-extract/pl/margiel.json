                    {
                        "translation_id": "3a13bc71-5f26-4bad-904c-12ea28558353",
                        "source_entry_id": "06be24f8-e51f-3984-9bec-86143a171854",
                        "source_sense_id": "3e8d3118-a110-3bdd-b372-389a90060b33",
                        "target_lang_word": "Mergel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mergel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f721217f-5a09-3663-894d-15ad0b9ff015",
                                        "entry_id": "b44c6327-dfeb-3764-96c0-fbf7316ca9a6",
                                        "glosses": [
                                            "aus Ton, Kalk und Sand bestehendes Sedimentgestein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ffb52c2-99aa-4b14-b0d2-27fa98f7025d",
                                                "sense_id": "f721217f-5a09-3663-894d-15ad0b9ff015",
                                                "text": "„Ein fehlerhafter Zustand des beigemischten Humus kommt bei diesem Boden fast gar nicht vor und kann nur bei fortgesetztem Übermaaß der Feuchtigkeit durch Übergang in die sogenannte, sich durch kohlenschwarze Farbe bekundene ‚Verkohlung‘ des Humus entstehen, die durch Trockenlegung, fleißige, lüftende Bearbeitung und Anwendung von Kalk und Mergel gehoben werden kann.“"
                                            },
                                            {
                                                "example_id": "3a4ea34e-88ae-4341-a02c-e282f5a4e7f6",
                                                "sense_id": "f721217f-5a09-3663-894d-15ad0b9ff015",
                                                "text": "„Die hierbei entstandenen Ablagerungen setzen sich an einigen Stellen des Alpenrandes aus groben. stark verkitteten Konglomeraten, der Nagelfluh, an andren aus Sandsteinen und Mergeln zusammen.“"
                                            },
                                            {
                                                "example_id": "229aa208-d705-4eb4-be87-565d1942d912",
                                                "sense_id": "f721217f-5a09-3663-894d-15ad0b9ff015",
                                                "text": "„Es war keine geringe Arbeit, vor dem Aufkleben der Etiketten die Namen der Gesteine festzustellen; die Verschiedenheit der Farben und des Korns ließ sie Tonerde und Mergel, Granit und Gneis, Quarz und Kalkstein verwechseln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abde4f11-1c16-44b7-87f5-cb3fcb2db8d5",
                        "source_entry_id": "06be24f8-e51f-3984-9bec-86143a171854",
