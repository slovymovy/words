                        "glosses": [
                            "Bauernhof in einer Heide"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff10e877-b673-4a9a-951a-63cac9e186b7",
                                "sense_id": "0a0eed86-260b-3b44-8d59-b5a6b833639e",
                                "text": "„Sobald er gesättigt, ging er zuerst in der Richtung nach den Bauernhöfen; als er jedoch nicht länger vom Heidehof aus gesehen werden konnte, bog er oberhalb der Täler nach Ok ab und bestieg den Jökull, um sich abzukühlen und herauszufinden, welche Richtung er einschlagen sollte, denn vom Gipfel des Jökulls konnte man den ganzen Weg nach Norden überblicken.“"
                            }
                        ],
