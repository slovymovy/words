                        "examples": [
                            {
                                "example_id": "81e87ec1-3479-404a-a3db-8e9dd50f6e0b",
                                "sense_id": "c4978c3f-6b56-37f6-b150-2c0812bc09b6",
                                "text": "De provincie Groningen heeft een brandbrief gestuurd naar de Duitse buurprovincie Nedersaksen. Daarin wordt de oosterburen gevraagd om nieuwe megastallen voortaan verder van de grens te bouwen."
                            },
                            {
                                "example_id": "e9f1b326-5552-4b40-b41c-7a09394a85cb",
                                "sense_id": "c4978c3f-6b56-37f6-b150-2c0812bc09b6",
                                "text": "Volgens enkele bronnen in Jemen zitten al-Qaida-terroristen achter de aanslag, maar het is nog onduidelijk of dat echt zo is. Het militaire konvooi was op weg naar de buurprovincie Abyan. Strijders van al-Qaida grepen daar ongeveer twee maanden geleden de macht."
                            }
                        ]
