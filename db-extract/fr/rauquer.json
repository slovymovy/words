                ],
                "senses": [
                    {
                        "sense_id": "c275afef-388f-38da-91af-8ba579b31733",
                        "entry_id": "824ca0cb-0583-305e-9f5b-03058a229b65",
                        "glosses": [
                            "Crier avec une voix rauque, en particulier pour le tigre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2817f28-b4cb-487b-818d-ab16d48a4941",
                                "sense_id": "c275afef-388f-38da-91af-8ba579b31733",
                                "text": "Le jaguar de la belle Indienne, sentant son ennemi sous le vent, se mit à rauquer sourdement, et ses prunelles rondes scintillèrent comme des émeraudes."
                            },
                            {
                                "example_id": "6dc66d19-ad83-475e-b74e-ea461ac3a2c4",
                                "sense_id": "c275afef-388f-38da-91af-8ba579b31733",
                                "text": "– Come in ! … rauqua une voix."
                            },
                            {
                                "example_id": "924b253d-c15b-4048-993d-c4ee4488d98f",
                                "sense_id": "c275afef-388f-38da-91af-8ba579b31733",
                                "text": "Mais voilà que la toux s’est abattue sur elle… et qu’elle s’est mise à rauquer, à se démancher les poumons…"
                            }
                        ]
                    },
                    {
                        "sense_id": "336f53a9-e99d-321c-ba16-b05d6dd68fd7",
                        "entry_id": "824ca0cb-0583-305e-9f5b-03058a229b65",
                        "glosses": [
                            "Produire des sons rauques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb395817-5feb-4aa6-ae42-7b8675c2c582",
                                "sense_id": "336f53a9-e99d-321c-ba16-b05d6dd68fd7",
                                "text": "Malgré le grincement affreux des roues, qui sanglotaient, miaulaient, rauquaient, râlaient, tout le monde s’endormit d’un sommeil pénible, entremêlé de rêves incohérents et bizarres, où les bruits du chariot se transformaient en ululations de bêtes féroces ou en cris d’enfants égorgés."
                            }
                        ]
                    }
