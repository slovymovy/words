                "senses": [
                    {
                        "sense_id": "2ca21213-d63a-335d-a442-5e21ab0044dd",
                        "entry_id": "27bbf9cd-8c2a-3f6f-8932-fd5e4de27386",
                        "glosses": [
                            "Einkaufsstelle für Wiederverkäufer, an der Waren in größeren Mengen gehandelt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6009f0bf-3f77-4b4d-a6a4-92d0411c92d4",
                                "sense_id": "2ca21213-d63a-335d-a442-5e21ab0044dd",
                                "text": "Die Stückpreise im Großmarkt sind meist geringer, weil die Waren in großen Mengen vom Hersteller abgenommen werden."
                            },
                            {
                                "example_id": "37c12be6-7695-4c00-9b83-0a2db613cc76",
                                "sense_id": "2ca21213-d63a-335d-a442-5e21ab0044dd",
                                "text": "Der Großmarkt beliefert den Einzelhandel mit Gewinn."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b97f6f10-2c73-3413-87d5-601f9b25c30c",
                        "entry_id": "27bbf9cd-8c2a-3f6f-8932-fd5e4de27386",
                        "glosses": [
                            "sehr großer Einzelhändler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e30e7bb2-0108-4cde-9f10-cdfdaa0f8566",
                                "sense_id": "b97f6f10-2c73-3413-87d5-601f9b25c30c",
                                "text": "Gestern war beim Großmarkt der Kaffee im Angebot, da habe ich gleich 10 Pfund gekauft."
                            },
                            {
                                "example_id": "a49959d3-0ae7-46ae-b745-2aa7493bba8d",
                                "sense_id": "b97f6f10-2c73-3413-87d5-601f9b25c30c",
                                "text": "An der Autobahnabfahrt soll ein neuer Großmarkt gebaut werden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
