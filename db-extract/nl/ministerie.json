                    },
                    {
                        "translation_id": "4d8cddb0-b4b0-4369-ae5e-2cf747188e6e",
                        "source_entry_id": "a7138713-b963-3daf-8781-f11a67a72b53",
                        "source_sense_id": "cf5e0007-a979-3865-8069-846b8157214e",
                        "source_sense_description": "een afdeling van een overheid waar het beleid van de regering wordt uitgevoerd",
                        "target_lang_word": "department",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "department",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d3571ab-daaf-3ac2-82b4-0f18673a27df",
                                        "entry_id": "726d92be-aaeb-35ec-b1a4-078eec12642c",
                                        "glosses": [
                                            "A part, portion, or subdivision."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "003e6889-a58d-3d7e-95cb-a266be27a472",
                                        "entry_id": "726d92be-aaeb-35ec-b1a4-078eec12642c",
                                        "glosses": [
                                            "A distinct course of life, action, study, or the like."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc325b33-90f0-43dd-b7dc-b3122218a6bd",
                                                "sense_id": "003e6889-a58d-3d7e-95cb-a266be27a472",
                                                "text": "Technical things are not his department; he's a people person."
                                            },
                                            {
                                                "example_id": "4473d68b-b09d-4dc8-acd9-ff195abd53fe",
                                                "sense_id": "003e6889-a58d-3d7e-95cb-a266be27a472",
                                                "text": "Flair and invention were very much at a premium, suffocated by the relentless pace and often fractious nature of proceedings. The absence of James Morrison from the centre of Scotland’s midfield, the West Brom man ruled out on the morning of the game by illness, had already diminished the creative capacity of the home side in that department."
                                            },
                                            {
                                                "example_id": "5a8bdf69-e466-4f2a-9e37-c1bc73520c8a",
                                                "sense_id": "003e6889-a58d-3d7e-95cb-a266be27a472",
                                                "text": "superior to Pope in Pope's own peculiar department of literature"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ffedcec-2ed4-313c-af89-9eea62d6e77c",
                                        "entry_id": "726d92be-aaeb-35ec-b1a4-078eec12642c",
                                        "glosses": [
                                            "A specified aspect or quality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ae403d3-4ec7-41f6-a9b2-b7b0b09b40ca",
                                                "sense_id": "4ffedcec-2ed4-313c-af89-9eea62d6e77c",
                                                "text": "The 2012 Boston Marathon was outstanding in the temperature department; runners endured temperatures of no less than 88 degrees Fahrenheit."
                                            },
                                            {
                                                "example_id": "89b10538-dec6-415e-acfb-2a18862e78af",
                                                "sense_id": "4ffedcec-2ed4-313c-af89-9eea62d6e77c",
                                                "text": "While the Chiefs superstar trails legendary quarterback Tom Brady in the Super Bowl wins department – the former Patriot and Tampa Bay Buccaneer has seven to Mahomes’ three – the chatter will only get louder and louder as to whether or not the 2023 Super Bowl MVP is the greatest of all time or not as he continues his career."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a6b4a70-7bc4-32cc-8c3c-9b0e06146bb3",
                                        "entry_id": "726d92be-aaeb-35ec-b1a4-078eec12642c",
                                        "glosses": [
                                            "A subdivision of an organization.",
                                            "One of the principal divisions of executive government"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f66d2829-f0f3-4b8f-aaea-7c16206a6774",
                                                "sense_id": "0a6b4a70-7bc4-32cc-8c3c-9b0e06146bb3",
                                                "text": "the Treasury Department; the Department of Agriculture; police department"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08f4e1d1-3505-304d-9431-5ac1ca8a8540",
                                        "entry_id": "726d92be-aaeb-35ec-b1a4-078eec12642c",
                                        "glosses": [
                                            "A subdivision of an organization.",
                                            "One of the divisions of instructions"
                                        ],
                                        "tags": [
                                            "in a university"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23db4992-b531-41f6-8f75-0489982ee2c2",
                                                "sense_id": "08f4e1d1-3505-304d-9431-5ac1ca8a8540",
                                                "text": "the physics department; the history department; the math department"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5349a5a6-1f15-3fb2-be99-48aee93d8c6d",
                                        "entry_id": "726d92be-aaeb-35ec-b1a4-078eec12642c",
                                        "glosses": [
                                            "A territorial division; a district; especially, in France, one of the districts into which the country is divided for governmental purposes, similar to a county in the UK and in the USA. France is composed of 101 départements organized in 18 régions, each department is divided into arrondissements, in turn divided into cantons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b3c1a64-650a-4ffd-8086-1c16a186e95c",
                                                "sense_id": "5349a5a6-1f15-3fb2-be99-48aee93d8c6d",
                                                "text": "The departments were the bricks from which the edifice of the nation was to be constructed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaec19ca-c05a-382d-8efa-313638189816",
                                        "entry_id": "726d92be-aaeb-35ec-b1a4-078eec12642c",
                                        "glosses": [
                                            "A military subdivision of a country"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7abbeed4-03d3-4314-b0a5-cca46f16e9a5",
                                                "sense_id": "aaec19ca-c05a-382d-8efa-313638189816",
                                                "text": "the Department of the Potomac"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33f76709-ba29-3b28-97ec-90cc75cf0981",
                                        "entry_id": "726d92be-aaeb-35ec-b1a4-078eec12642c",
                                        "glosses": [
                                            "Act of departing; departure."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d97a7af-0216-4ad6-baae-661c27f83667",
                                                "sense_id": "33f76709-ba29-3b28-97ec-90cc75cf0981",
                                                "text": "For though Contraria iuxta ſe poſita magis illuceſcunt [opposites placed next to each other shine more brightly] (by an olde Rule) yet it hath beene ſubtilly, and indeede truely noted that our Sight, is not vvell contented, vvith thoſe ſudden departments, from one extreame to another; Therefore let them haue, rather a Duskiſh Tincture, then an abſolute blacke."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fdf44c6-d9ef-417d-98b3-dbe52ab62737",
                        "source_entry_id": "a7138713-b963-3daf-8781-f11a67a72b53",
                        "source_sense_id": "cf5e0007-a979-3865-8069-846b8157214e",
                        "source_sense_description": "een afdeling van een overheid waar het beleid van de regering wordt uitgevoerd",
                        "target_lang_word": "ministère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ministère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2acdd4db-dcfc-327c-b1d4-775743a71b10",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Emploi ou charge qu’on exerce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0467c75-dc92-4317-8722-348872e5fa41",
                                                "sense_id": "2acdd4db-dcfc-327c-b1d4-775743a71b10",
                                                "text": "Ces sortes d'affaires s'instruisent sans huissiers ni défenseurs. Le ministère de ceux-ci est déclaré n'être pas obligatoire, et le surcroît de frais qu'il eût occasionné être irrépétible."
                                            },
                                            {
                                                "example_id": "43d19ae9-58c9-416e-b254-f23e4befae73",
                                                "sense_id": "2acdd4db-dcfc-327c-b1d4-775743a71b10",
                                                "text": "Satisfaire aux obligations, remplir les devoirs de son ministère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88301569-c87d-3e4a-afae-e96b8555fc11",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Fonction d’un huissier."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3a747b0-021f-44ab-a213-0c0085580f58",
                                                "sense_id": "88301569-c87d-3e4a-afae-e96b8555fc11",
                                                "text": "Opérer une saisie par ministère d’huissier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87e712f1-897a-3c57-8de5-4e33b9bc7802",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Fonctions dans l’Église, notamment d’un prêtre (sacerdoce)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b727188-3ac6-483b-a485-f3c6bf29eb74",
                                                "sense_id": "87e712f1-897a-3c57-8de5-4e33b9bc7802",
                                                "text": "Je fus un instant sur le point de céder, et de me servir de son ministère, non point pour lui dire ce qu'il attendait sans doute, un grand secret, mais afin de m'éprouver moi-même, et de savoir ce que ces secours religieux produiraient sur mon esprit."
                                            },
                                            {
                                                "example_id": "4e06afa6-a18d-44d6-9b3a-4c01a33bed3e",
                                                "sense_id": "87e712f1-897a-3c57-8de5-4e33b9bc7802",
                                                "text": "Jacques Monceau de Tournai avait étudié à Genève en 1566 et y avait exercé le ministère ; appelé au pastorat d’Anvers, il vint visiter Lille."
                                            },
                                            {
                                                "example_id": "e6a5025f-b44f-4910-9ba7-eb15b91147fe",
                                                "sense_id": "87e712f1-897a-3c57-8de5-4e33b9bc7802",
                                                "text": "Il faut rappeler qu’en 1972, Paul VI avait créé les ministères laïcs d’acolyte et de lecteur, fonctions relevant auparavant du sacrement de l’ordination, avec son motu proprio Ministeria quaedam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "674ae61d-3274-3607-9fdb-c4e19b5eecc4",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Entremise de quelqu’un dans une affaire, le service qu’on rend à une autre personne dans quelque emploi, dans quelque fonction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "142c53e9-20b7-4ed3-99ed-daddd6df837e",
                                                "sense_id": "674ae61d-3274-3607-9fdb-c4e19b5eecc4",
                                                "text": "Il nous a offert, il nous a prêté son ministère. — Vous pouvez compter sur son ministère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1377ebb8-29ac-3c03-b17d-b40e7ad92c45",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Fonction des ministres chargés du soin des affaires publiques et dont l’ensemble constitue le gouvernement."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08ba8a1f-e5ad-3e97-945a-12d4203cd50a",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Le département qu’ils administrent."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c8a76eb-3c2e-4763-9691-0a4764ec67a6",
                                                "sense_id": "08ba8a1f-e5ad-3e97-945a-12d4203cd50a",
                                                "text": "La première escarmouche se produit avec la discussion relative aux crédits nécessités par la création de deux ministères nouveaux : celui des Postes et Télégraphes et celui des Beaux-Arts."
                                            },
                                            {
                                                "example_id": "4ed1258a-2b39-4acf-9a68-3a9e8531065f",
                                                "sense_id": "08ba8a1f-e5ad-3e97-945a-12d4203cd50a",
                                                "text": "Ripont — […]. Commune entièrement détruite pendant la guerre de 1914-18. Son territoire est administré en 1919, par le \"ministère du blocus et des régions libérées\" puis par les Domaines."
                                            },
                                            {
                                                "example_id": "b431e478-b385-438f-b489-f2d42ecb8195",
                                                "sense_id": "08ba8a1f-e5ad-3e97-945a-12d4203cd50a",
                                                "text": "Il faudrait représenter Rabourdin habillé en boucher, mais bien ressemblant, chercher des analogies entre un bureau et une cuisine, lui mettre à la main un tranche-lard, peindre les principaux employés des ministères en volailles, les encager dans une immense souricière sur laquelle on écrirait : Exécutions administratives, et il serait censé leur couper le cou un à un."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cbc0719-6378-3dc8-a6aa-490cb89073ff",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Temps pendant lequel la personne dont on parle a été ministre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31537d85-2f26-40b4-8ebd-c965a731e80d",
                                                "sense_id": "0cbc0719-6378-3dc8-a6aa-490cb89073ff",
                                                "text": "Il s’est fait de grandes choses pendant son ministère."
                                            }
                                        ]
                                    },
                                    {
