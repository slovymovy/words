                        ]
                    },
                    {
                        "translation_id": "11771bf1-d7b2-4560-9906-50b1be1645d8",
                        "source_entry_id": "f3a2d48c-b6c0-32ff-8e72-983ba1f0bace",
                        "source_sense_id": "ae8d8e21-b95e-3103-89f5-58c299e19bab",
                        "source_sense_description": "greatest in age or seniority",
                        "target_lang_word": "aîné",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aîné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd0c2a80-814c-368f-b531-a9dfc2d1f1b0",
                                        "entry_id": "5e82d59c-1044-31df-8ffa-c74970e030ac",
                                        "glosses": [
                                            "Qui est né avant un autre enfant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee647195-a808-45b5-a2ce-d3555ea76a48",
                                                "sense_id": "bd0c2a80-814c-368f-b531-a9dfc2d1f1b0",
                                                "text": "Le bercement des nourrices, les câlineries maternelles, les chatteries des sœurs, surtout des sœurs aînées, espèce de mères diminutives, transforment, pour ainsi dire, en la pétrissant, la pâte masculine."
                                            },
                                            {
                                                "example_id": "3e420b53-8a87-4f77-9adc-124767e447ef",
                                                "sense_id": "bd0c2a80-814c-368f-b531-a9dfc2d1f1b0",
                                                "text": "En pensant à ses deux filles aînées toujours en fuite, Marianna sort de son berceau la dernière-née."
                                            },
                                            {
                                                "example_id": "0ecd3191-d15b-4630-b8fe-5b84fffe664f",
                                                "sense_id": "bd0c2a80-814c-368f-b531-a9dfc2d1f1b0",
                                                "text": "Elie lui apprend les rudiments de la gastronomie locale (pas les saucisses), à protéger sa chambre des intrusions nocturnes des autres collégiens (une chaise posée sur deux pieds, coincée sous la poignée de la porte, les deux autres pieds calés par des livres), les cours sans intérêt, les enseignants dont il faut se méfier, les horaires (et comment profiter de ceux-ci), bref, il joue son rôle d'aîné. Il protège, partage, initie, taquine un peu, entoure avec patience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f16f5e9-7b00-3d53-99b7-1e2e355bf9c5",
                                        "entry_id": "5e82d59c-1044-31df-8ffa-c74970e030ac",
                                        "glosses": [
                                            "Qui est le premier, la première d'une fratrie."
                                        ],
                                        "tags": [
                                            "Famille"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3da53a5-4d2a-43e6-9a93-85bdc912fcf2",
                                                "sense_id": "5f16f5e9-7b00-3d53-99b7-1e2e355bf9c5",
                                                "text": "Son fils aîné, sa fille aînée."
                                            },
                                            {
                                                "example_id": "d59f4e5c-6200-43cf-909d-ea9c11ff062b",
                                                "sense_id": "5f16f5e9-7b00-3d53-99b7-1e2e355bf9c5",
                                                "text": "Il est l’aîné de tous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ff76525-03f3-3e17-b5ee-68adc531dfb3",
                                        "entry_id": "5e82d59c-1044-31df-8ffa-c74970e030ac",
                                        "glosses": [
                                            "Relatif au premier-né."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9168ebe8-ffd2-4eb0-978b-e7a00c8a1809",
                                                "sense_id": "2ff76525-03f3-3e17-b5ee-68adc531dfb3",
                                                "text": "La branche aînée, la lignée familiale qui a un aîné pour tige, qui descend de l’aîné."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aîné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb36c8d6-25df-3051-9872-27b53e52af62",
                                        "entry_id": "137571a6-1e73-3686-99b8-0df934b17e2f",
                                        "glosses": [
                                            "Enfant le plus âgé d'une famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "964cd717-7e54-49c7-af82-1a4908800650",
                                                "sense_id": "cb36c8d6-25df-3051-9872-27b53e52af62",
                                                "text": "Contrairement à ses frères, Joseph Antoine l’aîné, Vincent et Nicolas, les deux puînés, qui marchaient dans les pas de leur géniteur, Michele ne se voyait pas toute sa vie garder les chèvres et les mulets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54905349-a59d-3263-bf72-3c38cd1b88cc",
                                        "entry_id": "137571a6-1e73-3686-99b8-0df934b17e2f",
                                        "glosses": [
                                            "Second enfant à l’égard d’un troisième, et ainsi des autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61035b84-b160-4af4-87b3-fa5220fe4dfe",
                                                "sense_id": "54905349-a59d-3263-bf72-3c38cd1b88cc",
                                                "text": "Il est mon aîné et je suis le vôtre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8ab95f3-00ed-3969-915b-d297b8ec8cbf",
                                        "entry_id": "137571a6-1e73-3686-99b8-0df934b17e2f",
                                        "glosses": [
                                            "Toute personne plus âgée qu’une autre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4db53ad-ded8-4f55-9217-fa99c92153e8",
                                                "sense_id": "a8ab95f3-00ed-3969-915b-d297b8ec8cbf",
                                                "text": "Espérant une réponse rassérénante, nous interrogeons un second moutard, il pêche aussi celui-là, et à quelque pas de lui un troisième, un quatrième, toute une série de mioches dont l’aîné a peut-être sept ans."
                                            },
                                            {
                                                "example_id": "e949b431-fe16-4ad8-be82-d1b4b169a0e6",
                                                "sense_id": "a8ab95f3-00ed-3969-915b-d297b8ec8cbf",
                                                "text": "Ces paroles m’étaient adressées […], par l’un de mes aînés, un artiste naguère si complètement parisianisé que j’avais ignoré, pendant trente ans, son origine alsacienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "126d7add-688d-3e5a-896a-15eb5093dfab",
                                        "entry_id": "137571a6-1e73-3686-99b8-0df934b17e2f",
                                        "glosses": [
                                            "Personne âgée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0155d055-bfce-44a4-a0e8-977626e95790",
                                                "sense_id": "126d7add-688d-3e5a-896a-15eb5093dfab",
                                                "text": "Un aîné sur deux n’est pas satisfait par sa pension de retraite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
