                    },
                    {
                        "translation_id": "6b87c4ef-c364-492e-9a91-cfa748e56709",
                        "source_entry_id": "be8e0701-5a25-31eb-bd9d-93b9f64b0cb5",
                        "source_sense_description": "Feutré",
                        "target_lang_word": "ватный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ватный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0d43e126-bc74-375c-97c0-dd9cfbd82824",
                                        "entry_id": "d64223e6-89ae-30d4-a86f-002df9336ec2",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным вата"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42f7970a-64c6-4014-959e-13f0b0d0e23e",
                                                "sense_id": "0d43e126-bc74-375c-97c0-dd9cfbd82824",
                                                "text": "〈…〉 Я, объясняет, дачу купил не вдали от шоссе и хочу там ватный завод строить»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c13aa6e-811c-3281-8a1f-7c3b098b96df",
                                        "entry_id": "d64223e6-89ae-30d4-a86f-002df9336ec2",
                                        "glosses": [
                                            "сделанный из ваты или с ватой, подбитый ватой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93020fbe-e752-4bf9-b47d-c29a05e10423",
                                                "sense_id": "8c13aa6e-811c-3281-8a1f-7c3b098b96df",
                                                "text": "Барин надел ватный кашемировый халат и подпоясался, а барыня сняла со шкафа бутыль с зоревой настойкой и нацедила два графинчика водки."
                                            },
                                            {
                                                "example_id": "ed1f4458-ac0f-42b4-b6c6-9111f5fd24ac",
                                                "sense_id": "8c13aa6e-811c-3281-8a1f-7c3b098b96df",
                                                "text": "Они получают ― кто валенки, кто телогрейку (ватный пиджачок), кто рваный бушлат."
                                            },
                                            {
                                                "example_id": "2ae9f689-4d65-4e54-bbfa-f9e9ac319833",
                                                "sense_id": "8c13aa6e-811c-3281-8a1f-7c3b098b96df",
                                                "text": "Припев. Ватный снег на иголках не тает, // Как сосульки, блестят леденцы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8246053-80a1-3a19-b94b-826d6a21f915",
                                        "entry_id": "d64223e6-89ae-30d4-a86f-002df9336ec2",
                                        "glosses": [
                                            "внешним видом похожий на вату"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e895df4-552e-4071-ad2f-d781660ea90e",
                                                "sense_id": "d8246053-80a1-3a19-b94b-826d6a21f915",
                                                "text": "Он съел всю солонину, обрезая ватный жир, допил водку."
                                            },
                                            {
                                                "example_id": "be93f447-c3b8-4aa3-b023-a02ff4d987fd",
                                                "sense_id": "d8246053-80a1-3a19-b94b-826d6a21f915",
                                                "text": "В окно полз туман лохматый, ватный: ну просто не продыхнуть."
                                            },
                                            {
                                                "example_id": "4625ace6-1128-439b-9d90-f1ed690914f6",
                                                "sense_id": "d8246053-80a1-3a19-b94b-826d6a21f915",
                                                "text": "Через закрытое окно Софья услышала пухлый, ватный выстрел, потом скоро другой и третий ― должно быть в Неве подымалась вода."
                                            },
                                            {
                                                "example_id": "f6e08de7-acd7-4483-a9db-06064b4c5f54",
                                                "sense_id": "d8246053-80a1-3a19-b94b-826d6a21f915",
                                                "text": "Пока же была кругом сумеречная муть, глухой ватный воздух."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e38df80-aec4-3554-9d1a-437f91f60a38",
                                        "entry_id": "d64223e6-89ae-30d4-a86f-002df9336ec2",
                                        "glosses": [
                                            "перен. расслабленный, неспособный напрячься (обычно о руках, ногах)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f13c0f01-75f5-46a6-ac45-69cd6fafb030",
                                                "sense_id": "8e38df80-aec4-3554-9d1a-437f91f60a38",
                                                "text": "Одно без другого не полно, а оба изменения вместе превращают живого человека в ватный мешок."
                                            },
                                            {
                                                "example_id": "1b06dbf1-fa93-4e5b-b04a-a6eb44d851a9",
                                                "sense_id": "8e38df80-aec4-3554-9d1a-437f91f60a38",
                                                "text": "У тебя, грю, чо, кулак-то ватный, ли чо ли?"
                                            },
                                            {
                                                "example_id": "8882fa0e-c58c-402a-b54c-9e43de451dc6",
                                                "sense_id": "8e38df80-aec4-3554-9d1a-437f91f60a38",
                                                "text": "«Полусонность чувств и полная спячка мыслей», «ватный темп», «мышление рапидом», «разжиженность», «вялость», «тепловатость» ― все эти атрибуты мнимого «реализма» вызывали у него почти тошноту."
                                            },
                                            {
                                                "example_id": "0507f751-5f2a-4abc-a1c5-a612c31c6139",
                                                "sense_id": "8e38df80-aec4-3554-9d1a-437f91f60a38",
                                                "text": "Егерь приблизился первым и ткнул его сапогом в ватный бок."
                                            },
                                            {
                                                "example_id": "4197465c-9311-4c68-b327-708e1bf8799f",
                                                "sense_id": "8e38df80-aec4-3554-9d1a-437f91f60a38",
                                                "text": "Я деревенею рядом с такими красивыми. Язык делается ватный. Что ни скажи ― глупо."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
