                                "sense_id": "1b14f44d-a5fe-388a-ae0b-d00bb23f0504",
                                "text": "Lekkoduch goni za przysmakami życia."
                            },
                            {
                                "example_id": "ae365b59-0d66-4781-b0c0-3d286fdd2686",
                                "sense_id": "1b14f44d-a5fe-388a-ae0b-d00bb23f0504",
                                "text": "Babka Anzelma uważała go za lekkoducha, często komentowała jego trzpiotowski styl życia."
                            }
                        ],
