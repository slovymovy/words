        "pl-extract.jsonl": [
            {
                "entry_id": "2083c0d5-5038-3815-b03d-7cf9cdb30b70",
                "word": "specjał",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fde240b5-efdf-3b81-a7d1-5013b2553466",
                        "entry_id": "2083c0d5-5038-3815-b03d-7cf9cdb30b70",
                        "glosses": [
                            "bardzo smaczna lub wyszukana potrawa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94e1c8f8-09a9-4b3e-a5a9-36e8fb907da3",
                                "sense_id": "fde240b5-efdf-3b81-a7d1-5013b2553466",
                                "text": "Mariola przygotowała dla nas liczne specjały à la kuchnia kresowa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "986128df-1bed-49ce-8094-dc288400d7a5",
                        "source_entry_id": "2083c0d5-5038-3815-b03d-7cf9cdb30b70",
                        "source_sense_id": "fde240b5-efdf-3b81-a7d1-5013b2553466",
                        "target_lang_word": "specialty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "specialty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c75c44c-780e-3442-834d-67a76cb0b06b",
                                        "entry_id": "c985c54a-6180-3435-b916-a68a528e03c8",
                                        "glosses": [
                                            "That in which one specializes; a chosen expertise or talent; bailiwick."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56fa4254-d00d-476e-9ca3-40a46eee1a08",
                                                "sense_id": "5c75c44c-780e-3442-834d-67a76cb0b06b",
                                                "text": "Near-synonym: discipline"
                                            },
                                            {
                                                "example_id": "e20d5560-8db7-4df4-b622-f2901291f511",
                                                "sense_id": "5c75c44c-780e-3442-834d-67a76cb0b06b",
                                                "text": "medical specialty"
                                            },
                                            {
                                                "example_id": "44001f4d-4a3d-4756-83d8-0f46b52c15ff",
                                                "sense_id": "5c75c44c-780e-3442-834d-67a76cb0b06b",
                                                "text": "academic specialty"
                                            },
                                            {
                                                "example_id": "59cec589-1590-4787-9993-0ddde792d0cd",
                                                "sense_id": "5c75c44c-780e-3442-834d-67a76cb0b06b",
                                                "text": "They cook well overall, but their true specialty is pasta."
                                            },
                                            {
                                                "example_id": "66501535-35a1-4f1c-9ea0-92dda95c788c",
                                                "sense_id": "5c75c44c-780e-3442-834d-67a76cb0b06b",
                                                "text": "The doctor ordered a consultation with another doctor in a different specialty."
                                            },
                                            {
                                                "example_id": "f4f224fa-9f9a-49f8-9c0d-e36cb7397341",
                                                "sense_id": "5c75c44c-780e-3442-834d-67a76cb0b06b",
                                                "text": "Even men of boundless knowledge, like Humboldt, must have had once their speciality, their pet subject, or they would have, strictly speaking, no knowledge at all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edd8fe0d-6d20-3405-be7e-b02d915c585f",
                                        "entry_id": "c985c54a-6180-3435-b916-a68a528e03c8",
                                        "glosses": [
                                            "A product that originates in and is characteristic of a place."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4a88a8d-7f98-38b4-a4dd-e3b29ff7cbc6",
                                        "entry_id": "c985c54a-6180-3435-b916-a68a528e03c8",
                                        "glosses": [
                                            "Particularity."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af7dea03-e622-4e1b-ad26-d69aa22dec28",
                                                "sense_id": "b4a88a8d-7f98-38b4-a4dd-e3b29ff7cbc6",
                                                "text": "The specialty of rule hath been neglected:\nAnd, look, how many Grecian tents do stand\nHollow upon this plain, so many hollow factions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2919d9e3-4f89-304e-bc6b-d81109c0c53e",
                                        "entry_id": "c985c54a-6180-3435-b916-a68a528e03c8",
                                        "glosses": [
                                            "A particular or peculiar case."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31607742-ded2-3f07-8b9e-00420cef2a23",
                                        "entry_id": "c985c54a-6180-3435-b916-a68a528e03c8",
                                        "glosses": [
                                            "An attribute or quality peculiar to a species."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c5bb456-ab58-3a9c-bce8-dc001ec1f1a5",
                                        "entry_id": "c985c54a-6180-3435-b916-a68a528e03c8",
                                        "glosses": [
                                            "A contract or obligation under seal; a contract by deed; a writing, under seal, given as security for a debt particularly specified."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a06912b-afac-4180-8745-ba0692bb44cf",
                                                "sense_id": "2c5bb456-ab58-3a9c-bce8-dc001ec1f1a5",
                                                "text": "Let specialties be therefore drawne betweene vs,\nThat couenants may be kept on either hand."
                                            },
                                            {
                                                "example_id": "e03cecd1-065e-4b72-b26a-489341e4a9a7",
                                                "sense_id": "2c5bb456-ab58-3a9c-bce8-dc001ec1f1a5",
                                                "text": "1812, Joseph Chitty, A Treatise on Pleading, with a Collection of Practical Precedents, and Notes Thereon, 2nd American edition, edited by Thomas Day, New York, Volume 2, section 456, note c,\n[…] in a plea to an action of debt on specialty, it is still necessary to show that the debt on which the judgment was recovered was a specialty, or to aver that the judgment was recovered before the defendant had notice of the plaintiff’s demand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34b255b8-6b1f-4cb8-b9f0-b8ff7f85cc69",
                        "source_entry_id": "2083c0d5-5038-3815-b03d-7cf9cdb30b70",
                        "source_sense_id": "fde240b5-efdf-3b81-a7d1-5013b2553466",
                        "target_lang_word": "dainty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dainty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45c0aabb-a31a-3cc3-a194-e17288a93b56",
                                        "entry_id": "e4689122-81f2-3dbc-9854-71cf98a939e6",
                                        "glosses": [
                                            "Elegant; delicately small and pretty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56426bca-5f3e-412d-8f96-70c5fe8ab0b8",
                                                "sense_id": "45c0aabb-a31a-3cc3-a194-e17288a93b56",
                                                "text": "As for thoſe People of the Eaſt, (Goa, Calecute, Malaca,) they vvere a Fine, and Dainty People; Frugall, and yet Elegant, though not Militar."
                                            },
                                            {
                                                "example_id": "e2b5c91e-3204-45d7-9161-2a76577bccea",
                                                "sense_id": "45c0aabb-a31a-3cc3-a194-e17288a93b56",
                                                "text": "Those dainty limbs which nature lent / For gentle usage and soft delicacy.",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            },
                                            {
                                                "example_id": "cb2ae621-cc88-409c-809d-c3e36bd4a47d",
                                                "sense_id": "45c0aabb-a31a-3cc3-a194-e17288a93b56",
                                                "text": "However, with the dainty volume my quondam friend sprang into fame. At the same time he cast off the chrysalis of a commonplace existence."
                                            },
                                            {
                                                "example_id": "7c5090d9-591a-4081-9162-7f5c77bb1e7e",
                                                "sense_id": "45c0aabb-a31a-3cc3-a194-e17288a93b56",
                                                "text": "The cutting sides were gay with heather in bloom, and masses of dainty Scots bluebells, while patches of clear sky overhead were bringing life and colour to the sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99b31e42-086f-3d8c-9e9f-e898f34f3f4a",
                                        "entry_id": "e4689122-81f2-3dbc-9854-71cf98a939e6",
                                        "glosses": [
                                            "Fastidious and fussy, especially when eating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f5c5f1c-5323-49bb-bddc-ee50ba38a164",
                                                "sense_id": "99b31e42-086f-3d8c-9e9f-e898f34f3f4a",
                                                "text": "UUho when he ſhal embrace you in his arms\nUUil tell how many thouſand men he ſlew.\nAnd when you looke for amorous diſcourſe,\nWill rattle foorth his facts of war and blood:\nToo harſh a ſubiect for your daintie eares."
                                            },
                                            {
                                                "example_id": "4d95cf78-5ebb-4ecb-91dc-05df58392cc5",
                                                "sense_id": "99b31e42-086f-3d8c-9e9f-e898f34f3f4a",
                                                "text": "And let us not be dainty of leave taking, / But shift away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7341f5ce-1952-3219-91f0-f897a11794fd",
                                        "entry_id": "e4689122-81f2-3dbc-9854-71cf98a939e6",
                                        "glosses": [
                                            "Excellent; valuable, fine."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3954f6ef-1ad3-443e-a730-c599a44b40df",
                                                "sense_id": "7341f5ce-1952-3219-91f0-f897a11794fd",
                                                "text": "Heliogabalus the most dissolute man of the world, amidst his most riotous sensualities, intended, whensoever occasion should force him to it, to have a daintie death."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dainty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f71e5abb-2110-320c-af78-75119bf49663",
                                        "entry_id": "2106fa64-b571-362e-9518-7af92439172d",
                                        "glosses": [
                                            "A delicacy (choice or pleasing food)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbb51b77-b8d5-4c7e-a816-ead9239195a3",
                                                "sense_id": "f71e5abb-2110-320c-af78-75119bf49663",
                                                "text": "And she receyued hym with grete Ioye and made hym to sytte doune by her and soo was he sette to soupe with flesshe and many deyntees\nAnd she received him with great joy, and made him to sit down by her, and so was he set to sup with flesh and many dainties."
                                            },
                                            {
                                                "example_id": "c0211ce7-e6b8-449a-bcf4-302f8bd8745d",
                                                "sense_id": "f71e5abb-2110-320c-af78-75119bf49663",
                                                "text": "[…]my case was deplorable enough, yet I had great cause for thankfulness that I was not driven to any extremities for food, but had rather plenty, even to dainties."
                                            },
                                            {
                                                "example_id": "e53ac4ee-905f-465c-9104-d3b6f0ffa057",
                                                "sense_id": "f71e5abb-2110-320c-af78-75119bf49663",
                                                "text": "And now a maiden […] ſupplied them, next, / With a reſplendent table, which the chaſte / Directreſs of the ſtores furniſh'd with bread / And dainties, remnants of the laſt regale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea93feb0-7f4e-33de-93d7-61a810510246",
                                        "entry_id": "2106fa64-b571-362e-9518-7af92439172d",
                                        "glosses": [
                                            "A fancy cookie, pastry, or square, frequently homemade, served at a social event."
                                        ],
                                        "tags": [
                                            "British-Columbia",
                                            "Canadian-Prairies",
                                            "Northwestern",
                                            "Ontario",
                                            "plural-normally"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "196aa388-c1e6-3baf-ba5a-c3240bbebdbb",
                                        "entry_id": "2106fa64-b571-362e-9518-7af92439172d",
                                        "glosses": [
                                            "Esteem, honour."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e1544c3-923a-3a46-8f1b-96fa0f0cd249",
                                        "entry_id": "2106fa64-b571-362e-9518-7af92439172d",
                                        "glosses": [
                                            "An affectionate term of address."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10cf6854-ccfa-4b4b-aae7-c2b324dfe57b",
                                                "sense_id": "7e1544c3-923a-3a46-8f1b-96fa0f0cd249",
                                                "text": "I am not eager at forbidden dainties"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61094ba7-1527-45ff-9170-4e0763a3537f",
                        "source_entry_id": "2083c0d5-5038-3815-b03d-7cf9cdb30b70",
                        "source_sense_id": "fde240b5-efdf-3b81-a7d1-5013b2553466",
                        "target_lang_word": "cate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59635d6b-e040-3716-acf3-28f3ecebeead",
                                        "entry_id": "f61aefb5-691a-3e3f-930e-8ccb7e9eb6cb",
                                        "glosses": [
                                            "A delicacy or item of food."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e2c2ad1-0a49-4bf7-a63c-94186f05f68a",
                                                "sense_id": "59635d6b-e040-3716-acf3-28f3ecebeead",
                                                "text": "Kate of Kate-hall, my super-daintie Kate, / For dainties are all Kates, and therefore Kate / Take this of me, Kate of my consolation […]"
                                            },
                                            {
                                                "example_id": "191abd65-cd4e-407b-9ca8-24d50732ecb5",
                                                "sense_id": "59635d6b-e040-3716-acf3-28f3ecebeead",
                                                "text": "Have we not heard of divers most fertile regions, plenteously yeelding al maner of necessary victuals, where neverthelesse the most ordinary cates [translating méz] and daintiest dishes, were but bread, water-cresses, and water?"
                                            },
                                            {
                                                "example_id": "ff131a83-4472-496d-bb45-a37f34639355",
                                                "sense_id": "59635d6b-e040-3716-acf3-28f3ecebeead",
                                                "text": "All cates and dainties shall be stored there / Quickly on this feast-night: [...]"
                                            },
                                            {
                                                "example_id": "e204899c-dc1d-4909-ade4-179ee71f257c",
                                                "sense_id": "59635d6b-e040-3716-acf3-28f3ecebeead",
                                                "text": "He did not at first produce the cates and vintages they expected; they looked, most of them, puzzled at the lack of materials of revelry."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
