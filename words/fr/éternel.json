                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "Dans ce récit biblique, l'<w>Éternel</w> s'adresse au prophète pour lui révéler ses volontés."
                        },
                        {
                            "text": "L'homme implora le pardon de l'<w>Éternel</w> pour toutes les fautes qu'il avait commises."
