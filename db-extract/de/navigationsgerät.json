                                    {
                                        "sense_id": "bab07cec-5b3a-37aa-8a98-75683aa84f05",
                                        "entry_id": "d4e24d79-25e1-3ce6-9906-bae5967ac51b",
                                        "glosses": [
                                            "Variante de traçant."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9a649e4-ca79-47d3-a96a-8f5b3ab8e8a0",
                                                "sense_id": "bab07cec-5b3a-37aa-8a98-75683aa84f05",
                                                "text": "Il voit partir vers lui les projectiles traceurs : « La plaine crépite tout entière de courtes mèches lumineuses »"
                                            },
                                            {
                                                "example_id": "d000fa57-c9d7-4ea0-995d-550b0175eec6",
                                                "sense_id": "bab07cec-5b3a-37aa-8a98-75683aa84f05",
                                                "text": "Un vrai feu d’artifice avec les balles traceuses des mitrailleuses qui filent dans la nuit et semblent danser quand elles ricochent sur un obstacle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "traceur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f442afc-7c57-378c-ab32-a59af7c10e71",
                                        "entry_id": "37525036-cbac-3519-a226-f1a7ce7b77f9",
                                        "glosses": [
                                            "Celui qui trace."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b14ed3ad-4544-312d-8680-07a4dba5550e",
                                        "entry_id": "37525036-cbac-3519-a226-f1a7ce7b77f9",
                                        "glosses": [
                                            "Procédé permettant de suivre optiquement la trajectoire d’un projectile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b4805c0-d507-4779-90ac-cd29efcb7e71",
                                                "sense_id": "b14ed3ad-4544-312d-8680-07a4dba5550e",
                                                "text": "Ce projectile est chargé d’explosif fondu (TNT) et muni d’un traceur visible jour et nuit qui cause l’explosion au bout de la trace si aucun choc ne s’est produit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b12f15de-7523-3378-b1a1-f16ad09f1c05",
                                        "entry_id": "37525036-cbac-3519-a226-f1a7ce7b77f9",
                                        "glosses": [
                                            "Marqueur permettant de suivre certaines molécules."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1a1a742-35a8-3f36-9e97-b876616a46f0",
                                        "entry_id": "37525036-cbac-3519-a226-f1a7ce7b77f9",
                                        "glosses": [
                                            "Presse qui permet d’imprimer les grands formats."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e48a41ec-999f-416a-87e3-54b23c3e3984",
                                                "sense_id": "f1a1a742-35a8-3f36-9e97-b876616a46f0",
                                                "text": "Un traceur A0."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22f36e41-afb6-3296-a6bf-4c3da7b172d4",
                                        "entry_id": "37525036-cbac-3519-a226-f1a7ce7b77f9",
                                        "glosses": [
                                            "Instrument équipé d’un réservoir d’encre et comportant une plume cylindrique calibrée, permettant le dessin d’un trait d’épaisseur déterminée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bdf2c60f-d58a-3ff6-8feb-43b438d6cac2",
                                        "entry_id": "37525036-cbac-3519-a226-f1a7ce7b77f9",
                                        "glosses": [
                                            "Tout outil permettant le dessin de trait."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "295cf96b-2e63-34b5-aa1e-a7abec36a62c",
                                        "entry_id": "37525036-cbac-3519-a226-f1a7ce7b77f9",
                                        "glosses": [
                                            "Appareil servant à effectuer la conversion numérique-graphique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "baed6216-9ed9-363c-a855-821adf95431c",
                                        "entry_id": "37525036-cbac-3519-a226-f1a7ce7b77f9",
                                        "glosses": [
                                            "Appareil permettant de suivre à distance et d’enregistrer des déplacements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9584677-0b0f-4b5f-b12e-1fa7fe1d365e",
                                                "sense_id": "baed6216-9ed9-363c-a855-821adf95431c",
                                                "text": "Choisir un mini traceur gps, c’est avant tout faire le choix de la miniaturisation. L’opérateur du traceur souhaite souvent que le traceur reste le plus discret possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a1b17ec-6c9f-387b-918b-599904050a5e",
                                        "entry_id": "37525036-cbac-3519-a226-f1a7ce7b77f9",
                                        "glosses": [
                                            "Ouvrier spécialisé effectuant le traçage d’une infrastructure."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f81bc0a-58a9-48f2-914f-642d62db9756",
                                                "sense_id": "1a1b17ec-6c9f-387b-918b-599904050a5e",
                                                "text": "Dans d’autres branches comme l’aéronautique, la mécanique de précision, l’armement, ce besoin est encore très grand : il faut des tourneurs et ajusteurs pour la grosse mécanique, des traceurs dans les chantiers navals."
                                            },
                                            {
                                                "example_id": "c141c843-9210-4e16-bf73-c0d886508aef",
                                                "sense_id": "1a1b17ec-6c9f-387b-918b-599904050a5e",
                                                "text": "Eh bien, d’après Drake, dit-il, Nelson avait commencé par entrer aux chantiers navals comme traceur, travaillant sur des épures et des projets de construction, et apprenant comme un fou tout ce qu’il pouvait des techniciens russes qui étaient arrivés en foule depuis la victoire de Mao."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2d30be2-50d3-36aa-aaa9-19fa68e2c97f",
                                        "entry_id": "37525036-cbac-3519-a226-f1a7ce7b77f9",
                                        "glosses": [
                                            "Pratiquant du parkour ; yamakasi."
                                        ],
                                        "tags": [
                                            "Parkour"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ec19b16-26b1-4840-b3fe-afd869a6b867",
                                                "sense_id": "d2d30be2-50d3-36aa-aaa9-19fa68e2c97f",
                                                "text": "Le traceur (personne pratiquant le parkour) essaie de trouver un chemin passant par des endroits que personne n’emprunterait normalement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26154611-48d9-34e9-975b-a27ac4a83895",
                                        "entry_id": "37525036-cbac-3519-a226-f1a7ce7b77f9",
                                        "glosses": [
                                            "Celui qui établit la piste de compétition."
                                        ],
                                        "tags": [
                                            "Sports de glisse"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
