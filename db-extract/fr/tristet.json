                        "sense_id": "80f710eb-3b9a-3ee9-b118-9d52766065d6",
                        "entry_id": "52be6f9b-338c-37b4-80b8-55598db1a2c5",
                        "glosses": [
                            "Un peu triste ; un peu triste d'aspect ; tristounet."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9b065952-1f6a-43df-9a50-78b8141991b1",
                                "sense_id": "80f710eb-3b9a-3ee9-b118-9d52766065d6",
                                "text": "Sur le dossier de la chaise, comme il fait fatigué, tristet, mon petit tailleur de confection !"
                            },
                            {
                                "example_id": "b5301212-34ae-4d2e-a180-973a77ecef9f",
                                "sense_id": "80f710eb-3b9a-3ee9-b118-9d52766065d6",
                                "text": "J’ai lu des vers de lui, des vers onduleux, un peu tristets, pas trop, tout à fait à mon goût."
                            },
                            {
                                "example_id": "6542f98c-2acd-4c14-b6bb-4b3171f55cd1",
                                "sense_id": "80f710eb-3b9a-3ee9-b118-9d52766065d6",
                                "text": "C'est gentil Lucie de Lammermoor !, un peu tristet sans doute, mais d'une musique si facile et si familière !"
                            },
                            {
                                "example_id": "0f7ffb44-8c81-4af5-bd9a-036c4626cdc0",
                                "sense_id": "80f710eb-3b9a-3ee9-b118-9d52766065d6",
                                "text": "Le carnaval. — C'est fini ! Le voilà mort et enterré. Qu’est-ce qu'a été son existence ? Oh ! une vie bien morne et assez tristette."
                            }
                        ]
                    }
