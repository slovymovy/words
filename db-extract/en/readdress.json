                                "sense_id": "a13a3cf7-981e-3aa9-91f1-e9b10813178d",
                                "text": "Her latest paper readdresses some old problems in philosophy."
                            },
                            {
                                "example_id": "28b9a82e-8f34-4049-a33d-e7f7c9b5eebb",
                                "sense_id": "a13a3cf7-981e-3aa9-91f1-e9b10813178d",
                                "text": "“Evenin', Commander,” Clarke said with mock cheerfulness. “How's it goin'?” Gadsby ignored this overture, turned away, and readdressed himself to his drink."
                            }
                        ]
                    },
                    {
                        "sense_id": "83ffd9c1-9189-30e6-b585-d7b17fd06aec",
                        "entry_id": "4face7c5-2c0f-3ed6-b70a-1e8fe261cc9e",
                        "glosses": [
