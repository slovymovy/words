                        "examples": [
                            {
                                "example_id": "d65aa9ae-bef1-4131-b53c-90a7756076e2",
                                "sense_id": "bbbf5d54-259d-3ad2-b3fa-cf7cfce87f95",
                                "text": "[…] on en était demeuré dans l’ère des bombardiers, mais on passait à l’ère des fusées, c’est-à-dire que la temporalité abrégée de la salve, sa délocalisation et son imparabilité ne permettaient plus à trois caractères de la guerre clausewitzienne de subsister : […]."
                            },
                            {
                                "example_id": "d3b73423-4820-4048-8362-0f3ab65fd73b",
                                "sense_id": "bbbf5d54-259d-3ad2-b3fa-cf7cfce87f95",
                                "text": "Un semestre après qu'elle eut éclaté avec l’imparabilité de la foudre, il m'en reste, au vrai, comme une angoisse."
                            },
                            {
                                "example_id": "2da64489-da9e-4852-9d05-551a050f6db2",
                                "sense_id": "bbbf5d54-259d-3ad2-b3fa-cf7cfce87f95",
                                "text": "Il est d'avis que ça nous implique, puisque aux trois caractéristiques de l'inexorable rouleau compresseur, ectoplasme du temps, sa survenue, son imparabilité et son imprévisibilité, il ajoute la participation du moi."
                            }
                        ]
                    }
