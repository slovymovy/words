    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "82fa96f1-2bd4-370c-9ae1-e15114037932",
                    "sense_definition": "À un endroit plus élevé dans l'espace ; plus haut qu'un point de référence.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avion vole maintenant très haut <w>au-dessus</w> des nuages blancs."
                        },
                        {
                            "text": "Une belle lampe est suspendue juste <w>au-dessus</w> de la table à manger."
                        }
                    ],
                    "synonyms": [
                        "en haut"
                    ],
                    "antonyms": [
                        "au-dessous",
                        "en dessous",
                        "en bas"
                    ],
                    "common_phrases": [
                        "au-dessus de la tête",
                        "au-dessus des nuages"
                    ]
                },
                {
                    "sense_id": "7d7fb02a-70d7-339e-9d48-88e76f3e4a01",
                    "sense_definition": "Plus grand ou supérieur en quantité, en valeur, en degré ou en mesure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les températures de cet été sont restées bien <w>au-dessus</w> de la moyenne de saison."
                        },
                        {
                            "text": "Le prix de cet appartement est largement <w>au-dessus</w> de notre budget maximal."
                        }
                    ],
                    "antonyms": [
                        "au-dessous",
                        "en dessous"
                    ],
                    "common_phrases": [
                        "au-dessus de la moyenne",
                        "au-dessus de zéro"
                    ]
                },
                {
                    "sense_id": "18e3e0ed-90ca-3a82-9089-c11409c0d5b2",
                    "sense_definition": "Qui l'emporte en qualité, en mérite, en rang ou qui dépasse les capacités d'une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "superiorite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce travail difficile était malheureusement bien <w>au-dessus</w> de ses forces actuelles."
                        },
                        {
                            "text": "Le comportement exemplaire de cette femme la place <w>au-dessus</w> de tout soupçon."
                        }
                    ],
                    "antonyms": [
                        "au-dessous"
                    ],
                    "common_phrases": [
                        "au-dessus de tout soupçon",
                        "au-dessus de ses forces"
                    ]
                },
                {
                    "sense_id": "292dc761-6503-3b27-b2bd-4dd1d0888c0b",
                    "sense_definition": "Indifférent, insensible ou qui refuse d'être affecté par des attaques ou des mesquineries.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "superiorite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré les attaques répétées, le directeur reste totalement <w>au-dessus</w> des critiques publiques."
                        },
                        {
                            "text": "Il a choisi de rester <w>au-dessus</w> des insultes pour préserver la paix."
                        }
                    ],
                    "common_phrases": [
                        "au-dessus des critiques",
                        "au-dessus des insultes"
                    ]
                }
            ]
        }
    ]
