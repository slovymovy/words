                "senses": [
                    {
                        "sense_id": "ac3e3f3c-7a39-3fa0-9bc6-cdac9c0d9b23",
                        "entry_id": "992c5835-6e13-3dd7-9882-312ac7515ae3",
                        "glosses": [
                            "vernetzte Einrichtung zur schnellen Übertragung von Daten wie Sprache, Bild, Text und Ton"
                        ],
                        "tags": [
                            "metaphorisch"
                        ],
                        "examples": [
                            {
                                "example_id": "4f071ac3-25e8-4a5f-a26e-28ef9e2156b1",
                                "sense_id": "ac3e3f3c-7a39-3fa0-9bc6-cdac9c0d9b23",
                                "text": "„Der Stau auf der Datenautobahn behindert auch eine Druckerei und einen Dachdecker, der sich die Ausschreibungen für neue Aufträge nicht online herunterladen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "687d4c8e-5b39-4dcb-9060-3b350d05e463",
                        "source_entry_id": "992c5835-6e13-3dd7-9882-312ac7515ae3",
                        "source_sense_id": "ac3e3f3c-7a39-3fa0-9bc6-cdac9c0d9b23",
                        "source_sense_description": "metaphorisch: vernetzte Einrichtung zur schnellen Übertragung von Daten wie Sprache, Bild, Text und Ton",
                        "target_lang_word": "information superhighway",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "information superhighway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae74a060-8525-37be-8d07-b05a6a66a5a5",
                                        "entry_id": "ee5f983c-baf4-3174-b18c-ba97a496fb4d",
                                        "glosses": [
                                            "The Internet and all other computer networks in the 1990s."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d31cce0-00e0-4f68-a3f9-64ef4be5d427",
                                                "sense_id": "ae74a060-8525-37be-8d07-b05a6a66a5a5",
                                                "text": "Developed nations also are moving at high speed toward the information superhighway being spearheaded by telephone technology. Britain, France, Germany, and other European nations are experimenting with high-tech phonery."
                                            },
                                            {
                                                "example_id": "81edd486-6ca6-49f9-9d25-3b94682360b8",
                                                "sense_id": "ae74a060-8525-37be-8d07-b05a6a66a5a5",
                                                "text": "Internet technologies and various software platforms make it much easier to communicate and find information about others' online communication. a For many – especially the younger generation – the “sacred precincts” of private life have extended onto the information superhighway."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aec6036b-4fa3-4e89-b223-a7b5efbb2811",
                        "source_entry_id": "992c5835-6e13-3dd7-9882-312ac7515ae3",
                        "source_sense_id": "ac3e3f3c-7a39-3fa0-9bc6-cdac9c0d9b23",
                        "source_sense_description": "metaphorisch: vernetzte Einrichtung zur schnellen Übertragung von Daten wie Sprache, Bild, Text und Ton",
                        "target_lang_word": "autoroute de l’information",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autoroute de l’information",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c88e0e89-3c4c-3d26-b4c0-d8b1149808a7",
                                        "entry_id": "f48b7960-423d-3cec-a4dd-fa694f3ba410",
                                        "glosses": [
                                            "Usage singulier de autoroutes de l’information."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6b777b0-0c31-41f9-8145-6d05f67c2436",
                                                "sense_id": "c88e0e89-3c4c-3d26-b4c0-d8b1149808a7",
                                                "text": "Outre les infrastructures matérielles classiques, on observe un gonflement de la demande pour de nouveaux types d’investissement destinés à développer la société de l’information, notamment par la mise en place d’une autoroute de l’information, la création de pépinières d’entreprises, de centres d’accès, etc."
                                            },
                                            {
                                                "example_id": "4704e56e-6969-404a-9b17-cae31c8f9bb9",
                                                "sense_id": "c88e0e89-3c4c-3d26-b4c0-d8b1149808a7",
                                                "text": "Certes, ce sont bien des ingénieurs et des techniciens, avec les logiques propres à leur rationalité technique, avec leur propre modèle du réseau, qui dessinent et construisent ces nouvelles autoroutes de l'information. Mais, quels qu'en soient les ancrages historiques, ce modèle ne peut pas ne pas être affecté par cette double rupture, quant à la \"matière\" à véhiculer, et quant aux canaux qui la transportent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
