                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68401af4-a77e-316e-bca1-773a564c2192",
                                        "entry_id": "17f38f7b-5530-3dee-8ab4-cf01efe02c0b",
                                        "glosses": [
                                            "That which has not been used or expended."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0492e82-e2ef-3140-987b-e5a389dd6cef",
                                        "entry_id": "17f38f7b-5530-3dee-8ab4-cf01efe02c0b",
                                        "glosses": [
                                            "A spare part, especially a spare tire."
                                        ],
                                        "tags": [],
