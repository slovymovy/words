                                                "sense_id": "3326421b-60c1-3029-bad0-4e2164450c16",
                                                "text": "„Hüben wird auf der roten und drüben auf der blauen Seite der Kontrakt eingezeichnet, der eben seinen Besitzer gewechselt hat.“"
                                            },
                                            {
                                                "example_id": "4ab13a63-bb25-4094-b946-ecc9b2ddeb52",
                                                "sense_id": "3326421b-60c1-3029-bad0-4e2164450c16",
                                                "text": "„Natürlich wird Karnej trotz meines Kontraktes und meines bestimmten Auftretens doch erst um sechs Uhr kommen.“"
                                            },
                                            {
                                                "example_id": "c949052a-27ee-4773-97e2-70c4cbc17c30",
                                                "sense_id": "3326421b-60c1-3029-bad0-4e2164450c16",
                                                "text": "„Er hatte schon einmal einen Kontrakt besessen, auf den Kontrakt ein Visum, auf das Visum das Transit.“"
                                            },
                                            {
                                                "example_id": "f9a0f3d6-b366-4d39-8f49-97231ad1932b",
                                                "sense_id": "3326421b-60c1-3029-bad0-4e2164450c16",
                                                "text": "„Über einen Kontrakt zwischen Adam und dem Teufel stand nichts in der Bibel zu lesen.“"
                                            }
