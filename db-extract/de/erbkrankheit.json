                "senses": [
                    {
                        "sense_id": "ad51b59c-2363-3279-b8bc-9477948c01aa",
                        "entry_id": "3d838387-2636-3799-bd98-52f2820cb6b3",
                        "glosses": [
                            "Krankheit, die durch Vererbung an die Nachkommen weitergegeben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f58dfe57-d6d8-41c4-9161-aa18174a4fac",
                                "sense_id": "ad51b59c-2363-3279-b8bc-9477948c01aa",
                                "text": "Zu den Erbkrankheiten gehört neben vielen anderen die Mukoviszidose."
                            },
                            {
                                "example_id": "56bf06d3-7b5f-42e8-8259-e7398807a1bf",
                                "sense_id": "ad51b59c-2363-3279-b8bc-9477948c01aa",
                                "text": "Viele Krankheiten sind in dem Sinne Erbkrankheiten, dass man durch erbliche Veranlagung eine erhöhte Anfälligkeit besitzt, an ihnen zu erkranken; dazu gehört etwa die Adipositas."
                            },
                            {
                                "example_id": "86540c8c-e23a-4fcb-bb59-d8a6d893b642",
                                "sense_id": "ad51b59c-2363-3279-b8bc-9477948c01aa",
                                "text": "„Ein Schweizer Wissenschafterteam hat einen Schnelltest für die bisher unheilbare Erbkrankheit Chorea Huntington vorgestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
