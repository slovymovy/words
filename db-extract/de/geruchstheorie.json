                "senses": [
                    {
                        "sense_id": "3c894f2f-00b3-38b2-986d-058ccff51b73",
                        "entry_id": "3769d5f9-91d7-3413-a7c2-71ff1704d772",
                        "glosses": [
                            "Gedankenmodell zum Erklären von Geruchserscheinungen oder zur Konstruktion neuer Geruchswelten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64246a94-bc14-4f33-b474-c1e573bd881f",
                                "sense_id": "3c894f2f-00b3-38b2-986d-058ccff51b73",
                                "text": "„Nach der stereochemischen Geruchstheorie von Amoore kann der Mensch nur sieben Einzelgerüche wahrnehmen:",
                                "translation": "7. blumig (beispielsweise Rosen)“"
                            },
                            {
                                "example_id": "9c2da1c3-22c9-4698-9e77-6bcfc3229892",
                                "sense_id": "3c894f2f-00b3-38b2-986d-058ccff51b73",
                                "text": "„Nach der stereochemischen Geruchstheorie von Amoore korreliert der Geruch einer Verbindung mit ihrer Molekülform.“"
                            },
                            {
                                "example_id": "28a64620-5ee6-447e-8311-cb6c5a940264",
                                "sense_id": "3c894f2f-00b3-38b2-986d-058ccff51b73",
                                "text": "„Relativ kleine Moleküle sind es jedenfalls, aber hochspezialisiert, falls die Geruchstheorie des Forschers stimmt.“"
                            },
                            {
                                "example_id": "600759b9-f94c-434a-be80-a0a4c0a1c30f",
                                "sense_id": "3c894f2f-00b3-38b2-986d-058ccff51b73",
                                "text": "„Amoore stellte eine Geruchstheorie auf,nach der es eine Korrelation zwischen dem Geruch und der dazugehörigen Molekülform zugeben schien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8d667cc1-85d4-3bcf-9e5f-590d6de75e50",
                        "entry_id": "3769d5f9-91d7-3413-a7c2-71ff1704d772",
                        "glosses": [
                            "Gesamtheit eines gedanklich konstruierten Geruchsbildes, im Gegensatz zur Praxis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e4ca395-b95a-49a7-ad26-17b6ad104120",
                                "sense_id": "8d667cc1-85d4-3bcf-9e5f-590d6de75e50",
                                "text": "„Neben der Auseinandersetzung mit verschiedenen Geruchstheorien wird der methodische Aufbau eines Mantrailers von den Anfängen bis zum fertig ausgebildeten, einsatzfähigen Hund gezeigt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
