                "senses": [
                    {
                        "sense_id": "fe1da8c4-b201-3a48-a1d8-7fa828572c26",
                        "entry_id": "94cdcfcb-5f85-3bc8-be2d-97d39cb6b77f",
                        "glosses": [
                            "Prozess der Entwicklung von Software"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe7ca918-2a04-4de1-8554-4253976aa153",
                                "sense_id": "fe1da8c4-b201-3a48-a1d8-7fa828572c26",
                                "text": "Wer den Beruf wechseln will, sollte jedoch nach seinen persönlichen Vorlieben gehen und nicht nach dem Angebot auf dem Jobmarkt, warnt Karriereexpertin Madeleine Leitner. Seiteneinstieg in die Finanzwirtschaft: \"Besonders leicht fällt dies derzeit Internet- und Multimediafachleuten für Content, Gestaltung, Softwareentwicklung und Computertechnik\", heißt es auf der Homepage des Unicum-Magazins."
                            },
                            {
                                "example_id": "9f05fa4c-de5b-464e-a5b5-340266498aa4",
                                "sense_id": "fe1da8c4-b201-3a48-a1d8-7fa828572c26",
                                "text": "„In der Siemens-Konzernzentrale in München gab man sich angesichts der Beendigung der Softwareentwicklung für Toll Collect gelassen: \"Wir haben einen wesentlichen Beitrag zum erfolgreichen Start des Maut-Systems geleistet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
