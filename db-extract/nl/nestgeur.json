                        "examples": [
                            {
                                "example_id": "d5858ccd-492b-4a8a-8fa2-462a6588ff9a",
                                "sense_id": "b91b838a-7039-3459-8107-b65f3434e7ba",
                                "text": "De kitten ervaart de nestgeur als veilig.",
                                "translation": "The kitten regards the smell of its nest as safe.",
                                "english": "The kitten regards the smell of its nest as safe."
                            },
                            {
                                "example_id": "bbc82686-ece4-4e9a-af5c-8c3b33ddd0d8",
                                "sense_id": "b91b838a-7039-3459-8107-b65f3434e7ba",
                                "text": "Als kind hield ik van mijn eigen knusse, muffe nestgeur.",
                                "translation": "As a child I loved the comfy, musky smell of my own bed.",
                                "english": "As a child I loved the comfy, musky smell of my own bed."
                            }
                        ]
                    },
                    {
                        "sense_id": "19344643-d2ae-3cfb-9eb4-ab0247a5574f",
                        "entry_id": "52b9329a-adf7-3537-a569-91b664fdf8aa",
                        "glosses": [
                            "an atmosphere of comfort (comfort zone) or of comfortable lull or stagnation"
                        ],
                        "tags": [
