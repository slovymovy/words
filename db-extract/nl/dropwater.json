                    {
                        "sense_id": "77929e97-d7c9-32aa-a9aa-ba8e763c64ea",
                        "entry_id": "205aa6bc-3cdb-3283-ae87-1f2141b9a73d",
                        "glosses": [
                            "oplossing van drop in water gebruikt als snoepgoed en als hoestdrankje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe7f39ea-364d-440a-ae00-7b74dad94373",
                                "sense_id": "77929e97-d7c9-32aa-a9aa-ba8e763c64ea",
                                "text": "De meeste mensen worden ziek ín de vakantie: laat lós dat werk en ja hoor. Geef ze eens de kost die snotterig ter strande arriveren of hoestend over de heuvelen gaan. Het vliegtuig naar de zon, met of zonder sneeuw, zit steevast vol met dat soort volk. Stewardessen sjouwen met glaasjes dropwater en de turbulentie is goed voor een kordon kotsende passagiers. Enfin, ellende en zuur bier."
                            },
                            {
                                "example_id": "2d7c46ed-a027-40d9-8979-6b07d5139232",
                                "sense_id": "77929e97-d7c9-32aa-a9aa-ba8e763c64ea",
                                "text": "Je kunt ook een flesje kopen om zelf dropwater te maken. Dat was voor veel Nederlandse kinderen vroeger de lekkerste traktatie, die bovendien zou helpen tegen de hoest."
                            }
                        ]
                    }
