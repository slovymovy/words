{
    "word_family": [
        "twirler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d37cfaa1-891d-3c89-8ef6-a2437aa90404",
                    "sense_definition": "To turn around and around quickly, or to make something do this.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little girl likes to <w>twirl</w> around in her new dress.",
                            "target_lang_translations": {
                                "ru": "Маленькой девочке нравится <w>кружиться</w> в своём новом платье.",
                                "cs": "Holčička se ráda <w>točí</w> ve svých nových šatech."
                            }
                        },
                        {
                            "text": "The drum major can <w>twirl</w> the baton with great skill.",
                            "target_lang_translations": {
                                "ru": "Тамбурмажор умеет мастерски <w>вертеть</w> жезлом.",
                                "cs": "Tambor dokáže velmi obratně <w>kroutit</w> hůlkou."
                            }
                        }
                    ],
                    "synonyms": [
                        "twizzle"
                    ],
                    "common_phrases": [
                        "twirl around",
                        "twirl a baton"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро кружиться или заставлять что-то вращаться.",
                        "cs": "Rychle se otáčet nebo způsobit, že se něco otáčí."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кружи́ться",
                                "target_lang_sense_clarification": "вращаться вокруг своей оси (о человеке)"
                            },
                            {
                                "target_lang_word": "верте́ть",
                                "target_lang_sense_clarification": "быстро вращать предмет в руках"
                            },
                            {
                                "target_lang_word": "враща́ть",
                                "target_lang_sense_clarification": "приводить в круговое движение"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "točit se",
                                "target_lang_sense_clarification": "otáčet se kolem své osy (o osobě)"
                            },
                            {
                                "target_lang_word": "otáčet",
                                "target_lang_sense_clarification": "uvádět předmět do kruhového pohybu"
                            },
                            {
                                "target_lang_word": "kroutit",
                                "target_lang_sense_clarification": "rychle otáčet předmětem v ruce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80875100-ee80-3cef-81d0-bf3997e96ef3",
                    "sense_definition": "To twist or wind something repeatedly, especially with the fingers.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to <w>twirl</w> his moustache while he thought about the answer.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>подкручивать</w> усы, обдумывая ответ.",
                                "cs": "Začal si <w>kroutit</w> knír, zatímco přemýšlel o odpovědi."
                            }
                        },
                        {
                            "text": "She nervously <w>twirled</w> a lock of hair around her finger.",
                            "target_lang_translations": {
                                "ru": "Она нервно <w>накручивала</w> прядь волос на палец.",
                                "cs": "Nervózně si <w>namotávala</w> pramen vlasů na prst."
                            }
                        }
                    ],
                    "common_phrases": [
                        "twirl one's hair",
                        "twirl a moustache"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крутить или наматывать что-либо, обычно пальцами.",
                        "cs": "Opakovaně něco kroutit nebo namotávat, obvykle prsty."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накру́чивать",
                                "target_lang_sense_clarification": "навивать (волосы на палец)"
                            },
                            {
                                "target_lang_word": "крути́ть",
                                "target_lang_sense_clarification": "вертеть в пальцах"
                            },
                            {
                                "target_lang_word": "подкру́чивать",
                                "target_lang_sense_clarification": "поправлять, закручивая (усы)"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "namotávat",
                                "target_lang_sense_clarification": "navíjet vlasy na prst"
                            },
                            {
                                "target_lang_word": "kroutit",
                                "target_lang_sense_clarification": "otáčet něco v prstech"
                            },
                            {
                                "target_lang_word": "natáčet",
                                "target_lang_sense_clarification": "upravovat si vousy kroucením"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e66002d1-5627-35b5-8a76-f8862835b767",
                    "sense_definition": "To pitch the ball in a game of baseball.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager decided to let the rookie <w>twirl</w> for the final inning.",
                            "target_lang_translations": {
                                "ru": "Менеджер решил дать новичку <w>подавать</w> в последнем иннинге.",
                                "cs": "Manažer se rozhodl nechat nováčka <w>nadhazovat</w> v poslední směně."
                            }
                        },
                        {
                            "text": "He was known to <w>twirl</w> a great game back in the day.",
                            "target_lang_translations": {
                                "ru": "Было известно, что в своё время он отлично <w>подавал</w>.",
                                "cs": "Bylo o něm známo, že kdysi <w>nadhazoval</w> skvělé zápasy."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "baseball context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подавать мяч (в бейсболе).",
                        "cs": "Nadhazovat míč v baseballu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подава́ть",
                                "target_lang_sense_clarification": "бросать мяч бьющему"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "nadhazovat",
                                "target_lang_sense_clarification": "házet míč pálkaři v baseballu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8df0c1fd-0a30-392f-b609-d4dbb7af5f30",
                    "sense_definition": "An act of spinning or turning around quickly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She did a happy <w>twirl</w> to show off her skirt.",
                            "target_lang_translations": {
                                "ru": "Она сделала радостный <w>пируэт</w>, чтобы показать свою юбку.",
                                "cs": "Radostně se <w>otočila</w>, aby předvedla svou sukni."
                            }
                        },
                        {
                            "text": "With a quick <w>twirl</w> of his cane, the performer left the stage.",
                            "target_lang_translations": {
                                "ru": "Быстрым <w>вращением</w> трости артист покинул сцену.",
                                "cs": "Rychlým <w>otočením</w> své hůlky umělec opustil pódium."
                            }
                        }
                    ],
                    "common_phrases": [
                        "give a twirl"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт быстрого вращения или оборот вокруг своей оси.",
                        "cs": "Akt rychlého otáčení nebo otočka kolem své osy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "враще́ние",
                                "target_lang_sense_clarification": "процесс кругового движения"
                            },
                            {
                                "target_lang_word": "пируэ́т",
                                "target_lang_sense_clarification": "круговое движение в танце"
                            },
                            {
                                "target_lang_word": "оборо́т",
                                "target_lang_sense_clarification": "полный круг вращения"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "otočka",
                                "target_lang_sense_clarification": "rychlý pohyb kolem své osy"
                            },
                            {
                                "target_lang_word": "pirueta",
                                "target_lang_sense_clarification": "kruhové otočení v tanci"
                            },
                            {
                                "target_lang_word": "točení",
                                "target_lang_sense_clarification": "proces kruhového pohybu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e303261e-73af-39ea-ab03-b3d81f4254e0",
                    "sense_definition": "A small spiral or coil shape, often of a soft substance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baker added a <w>twirl</w> of chocolate frosting to the cupcake.",
                            "target_lang_translations": {
                                "ru": "Пекарь добавил <w>завиток</w> шоколадной глазури на кекс.",
                                "cs": "Pekař přidal na košíček <w>závitek</w> čokoládové polevy."
                            }
                        },
                        {
                            "text": "She drew a decorative <w>twirl</w> on the corner of the page.",
                            "target_lang_translations": {
                                "ru": "Она нарисовала декоративный <w>завиток</w> в углу страницы.",
                                "cs": "V rohu stránky nakreslila ozdobný <w>závitek</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chocolate twirl"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой завиток или спираль, часто из мягкого вещества.",
                        "cs": "Malý spirálovitý tvar, často z měkké hmoty."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завито́к",
                                "target_lang_sense_clarification": "спиралевидная форма"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "závitek",
                                "target_lang_sense_clarification": "spirálovitý tvar"
                            },
                            {
                                "target_lang_word": "spirála",
                                "target_lang_sense_clarification": "křivka ve tvaru závitu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f9fa517-ce03-370c-bf03-10741d618e99",
                    "sense_definition": "A prison guard.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The inmates stopped talking as soon as the <w>twirl</w> walked by.",
                            "target_lang_translations": {
                                "ru": "Заключенные замолчали, как только мимо прошел <w>вертухай</w>.",
                                "cs": "Vězni přestali mluvit, jakmile šel kolem <w>bachař</w>."
                            }
                        },
                        {
                            "text": "He tried to hide the contraband from the <w>twirl</w> during inspection.",
                            "target_lang_translations": {
                                "ru": "Он пытался спрятать контрабанду от <w>вертухая</w> во время осмотра.",
                                "cs": "Během prohlídky se snažil před <w>bachařem</w> schovat kontraband."
                            }
                        }
                    ],
                    "synonyms": [
                        "screw"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "prison slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тюремный надзиратель.",
                        "cs": "Vězeňský dozorce."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вертуха́й",
                                "target_lang_sense_clarification": "тюремный жаргон"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "dozorce",
                                "target_lang_sense_clarification": "pracovník věznice"
                            },
                            {
                                "target_lang_word": "bachař",
                                "target_lang_sense_clarification": "slangové označení pro dozorce"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}