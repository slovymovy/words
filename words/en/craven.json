    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6c00b57f-e95a-3a2b-a7e7-2ddee11631d5",
                    "sense_definition": "Extremely cowardly and lacking any courage.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cowardice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>craven</w> soldier abandoned his post during the heat of the battle.",
                            "target_lang_translations": {
                                "de": "Der <w>feige</w> Soldat verließ seinen Posten mitten im Gefecht."
                            }
                        },
                        {
                            "text": "His <w>craven</w> behavior during the crisis disappointed all his supporters.",
                            "target_lang_translations": {
                                "de": "Sein <w>feiges</w> Verhalten während der Krise enttäuschte alle seine Unterstützer."
                            }
                        }
                    ],
                    "synonyms": [
                        "cowardly",
                        "spineless",
                        "pusillanimous"
                    ],
                    "antonyms": [
                        "brave",
                        "courageous"
                    ],
                    "common_phrases": [
                        "craven behavior",
                        "craven act"
                    ],
                    "target_lang_definitions": {
                        "de": "Äußerst feige und ohne jeglichen Mut."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "feige",
                                "target_lang_sense_clarification": "Adjektiv zur Beschreibung von Personen, die keinen Mut zeigen."
                            },
                            {
                                "target_lang_word": "hinterhältig",
                                "target_lang_sense_clarification": "Beschreibt eine feige und zugleich heimtückische Art."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a4cbb63-6a1b-3346-aeaa-977f8548315e",
                    "sense_definition": "A person who is extremely cowardly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cowardice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Only a <w>craven</w> would hide while others face the danger.",
                            "target_lang_translations": {
                                "de": "Nur ein <w>Feigling</w> würde sich verstecken, während andere sich der Gefahr stellen."
                            }
                        },
                        {
                            "text": "He was branded a <w>craven</w> for refusing to stand up for his beliefs.",
                            "target_lang_translations": {
                                "de": "Er wurde als <w>Feigling</w> abgestempelt, weil er sich weigerte, für seine Überzeugungen einzustehen."
                            }
                        }
                    ],
                    "synonyms": [
                        "coward",
                        "recreant"
                    ],
                    "antonyms": [
                        "hero"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person, die extrem feige ist."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Feigling",
                                "target_lang_sense_clarification": "Die gebräuchlichste Bezeichnung für eine ängstliche oder risikoscheue Person."
                            },
                            {
                                "target_lang_word": "feiger Hund",
                                "target_lang_sense_clarification": "Eine abwertende, umgangssprachliche Bezeichnung für einen Feigling."
                            }
                        ]
                    }
                }
            ]
        },
