                    {
                        "sense_id": "6c07990c-2b70-397e-a735-3a1829661feb",
                        "entry_id": "a934e74b-52f2-35bf-996b-de6e520ccaa8",
                        "glosses": [
                            "Tube périscopique permettant à un sous-marin d’alimenter ses moteurs diesel en air sans avoir à émerger. Il sert aussi pour un char d’assaut à franchir une rivière sous l’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae0fbf74-c525-4f4b-bbe9-3fa0972a19e2",
                                "sense_id": "6c07990c-2b70-397e-a735-3a1829661feb",
                                "text": "Le fût du schnorchel remonte. La différence de pression se révèle par un mugissement. Nouvelle plongée, suivie d'une montée, et cela continue sans trêve. Les tympans font mal. Ce sport au schnorchel manque de charme."
                            },
                            {
                                "example_id": "5fa6b507-936f-4879-81f1-b5479d1cc95e",
                                "sense_id": "6c07990c-2b70-397e-a735-3a1829661feb",
                                "text": "Il n'y avait aucun risque de collision, car le schnorchel avait été rentré pour cette raison même, et le submersible vivait sur ses réserves d'air."
                            }
                        ]
                    }
                ],
