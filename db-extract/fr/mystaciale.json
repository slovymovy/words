                "senses": [
                    {
                        "sense_id": "c295abfa-244b-3d94-8d1a-446d8cfca875",
                        "entry_id": "aad96923-6d03-393b-8147-e774959e6b2b",
                        "glosses": [
                            "De la lèvre supérieure"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0544f848-5365-4eb2-9b75-85f869c5036d",
                                "sense_id": "c295abfa-244b-3d94-8d1a-446d8cfca875",
                                "text": "Les vibrisses mystaciales du morse sont des poils raides et érectiles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8fdc18c6-569d-4699-8ab9-fe30aa4c4d35",
                        "source_entry_id": "aad96923-6d03-393b-8147-e774959e6b2b",
                        "source_sense_id": "c295abfa-244b-3d94-8d1a-446d8cfca875",
                        "target_lang_word": "mystacial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mystacial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1930f93a-2d92-3ede-b8f8-51c4444539eb",
                                        "entry_id": "341ba196-3b5f-37ea-9666-ba0cf198cd0c",
                                        "glosses": [
                                            "Having a fringe of hairs suggestive of a moustache."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f435a31-cc6d-3bd1-b74c-480474e53bbf",
                                        "entry_id": "341ba196-3b5f-37ea-9666-ba0cf198cd0c",
                                        "glosses": [
                                            "Pertaining to the area around the vibrissae on either side of the muzzle of a mammal such as a rodent or cat."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cb6b95a-a4bd-4411-885d-4b5672998eba",
                                                "sense_id": "4f435a31-cc6d-3bd1-b74c-480474e53bbf",
                                                "text": "The mystacial pads are large and fleshy, extending beyond the nostrils."
                                            },
                                            {
                                                "example_id": "b666bcde-25e6-4434-9a6d-7de0d752838c",
                                                "sense_id": "4f435a31-cc6d-3bd1-b74c-480474e53bbf",
                                                "text": "The vibrissal system of the rat is an example of active tactile sensing, and has recently been used as a prototype in construction of touch-oriented robots. Active vibrissal exploration and touch are enabled and controlled by musculature of the mystacial pad."
                                            },
                                            {
                                                "example_id": "e149229b-6f17-4b54-baa0-6a0cd790ab49",
                                                "sense_id": "4f435a31-cc6d-3bd1-b74c-480474e53bbf",
                                                "text": "Harbor seals use their mystacial vibrissae in a cold environment."
                                            },
                                            {
                                                "example_id": "cce9e033-d6ef-48c1-877b-5fda540b7906",
                                                "sense_id": "4f435a31-cc6d-3bd1-b74c-480474e53bbf",
                                                "text": "In group I (anatomic study group, n=8), Lewis rats were subject to harvesting technique trialing and the mystacial vascular network was drawn"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mystacial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e3da00e-2f60-3ec0-9782-24d673767ea5",
                                        "entry_id": "aa340b8a-03d6-373b-97e8-55d816498ed7",
                                        "glosses": [
                                            "Any of the large rigid whiskers (vibrissae) that appear on the fleshy pads on either side of the muzzle of an animal such as a cat or rodent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd948fb5-4457-4935-958f-d17606d742db",
                                                "sense_id": "1e3da00e-2f60-3ec0-9782-24d673767ea5",
                                                "text": "During the third week, the mystacials and ulnarcarpals are the first to form."
                                            },
                                            {
                                                "example_id": "39c819d4-1932-4e20-b2ea-abeaff44e53c",
                                                "sense_id": "1e3da00e-2f60-3ec0-9782-24d673767ea5",
                                                "text": "Pocock (1926, pp. 1040-41) described the facial vibrissae in the adult animal and he too found that the mystacials are greatly reduced in number and length, a condition which is common to all the ant-eating mammals (Pocock, 1914)."
                                            },
                                            {
                                                "example_id": "9588dbb2-7500-40b9-9408-5dc6c4215f90",
                                                "sense_id": "1e3da00e-2f60-3ec0-9782-24d673767ea5",
                                                "text": "The superciliary whiskers above the eyes and the genal whiskers on the cheeks are less rigid and distinctly less mobile than the mystacials."
                                            },
                                            {
                                                "example_id": "0e6c018f-3e97-483a-a6d6-063ea573ada4",
                                                "sense_id": "1e3da00e-2f60-3ec0-9782-24d673767ea5",
                                                "text": "The large amount of nervous tissue devoted to processing and integrating information coming from the mystacials indicates their importance as sense organs, perhaps most importantly when the snout is being directed towards prey."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
