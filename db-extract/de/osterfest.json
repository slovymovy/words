                    {
                        "translation_id": "39ea14ea-56df-4b0b-9496-717c048c2924",
                        "source_entry_id": "c0a4802f-61f0-38d4-a1b1-eac4146f10bb",
                        "source_sense_id": "e71fddc3-2fce-3558-9d39-f454dbe6d600",
                        "source_sense_description": "festlich begangenes Ostern",
                        "target_lang_word": "Pâques",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pâques",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63b03a00-4a8c-3a00-bc44-2f49ca08fbd5",
                                        "entry_id": "c345c735-d33f-307c-bc2c-797184f32593",
                                        "glosses": [
                                            "Fête que les chrétiens solennisent tous les ans en mémoire de la résurrection de Jésus-Christ, et qu’ils célèbrent le premier dimanche qui suit la pleine lune de l’équinoxe de printemps."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b11b48dd-5d92-4b15-92c6-38bceb11fccc",
                                                "sense_id": "63b03a00-4a8c-3a00-bc44-2f49ca08fbd5",
                                                "text": "Pâques était déjà passé."
                                            },
                                            {
                                                "example_id": "a582bb48-0658-4e1d-9ed5-81478803ef3c",
                                                "sense_id": "63b03a00-4a8c-3a00-bc44-2f49ca08fbd5",
                                                "text": "Vacances de Pâques."
                                            },
                                            {
                                                "example_id": "3c842c3e-4e60-425e-882d-c62265fa1932",
                                                "sense_id": "63b03a00-4a8c-3a00-bc44-2f49ca08fbd5",
                                                "text": "Elle ne mettait plus les pieds à l’église, ne priait plus, et deux Pâques se succédèrent, sans qu’on la vît s’approcher de la sainte table."
                                            },
                                            {
                                                "example_id": "31f825c5-4555-467d-9210-670e5330a9fd",
                                                "sense_id": "63b03a00-4a8c-3a00-bc44-2f49ca08fbd5",
                                                "text": "Au temps où il combattit pour le pouvoir, le bourgeois se passa de son âme : […]. Le 14 Juillet n’est pour lui qu’un symbole du temps, comme Pâques, comme la Nativité, le dimanche des Rameaux. Le commencement des vacances."
                                            },
                                            {
                                                "example_id": "a8429e53-cf10-4aa1-b482-310f25aa5baa",
                                                "sense_id": "63b03a00-4a8c-3a00-bc44-2f49ca08fbd5",
                                                "text": "Juste après les Pâques russes qu'ils fêtèrent avec Mary, Brossier leur fixa rendez-vous au bureau de « Jeunesse-Échanges franco-anglais », en face de l'Opéra-Comique."
                                            },
                                            {
                                                "example_id": "fbed78e0-5576-4978-a3c3-5fb0b86c7da2",
                                                "sense_id": "63b03a00-4a8c-3a00-bc44-2f49ca08fbd5",
                                                "text": "Pâques ne peut pas être plus tôt que le 22 mars, ni plus tard que le 25 avril."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a71bb761-85de-3b5e-9ccc-f7fd92aaca4f",
                                        "entry_id": "c345c735-d33f-307c-bc2c-797184f32593",
                                        "glosses": [
                                            "Dimanche auquel tombe la fête de Pâques."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a3a5350-c034-45f5-841a-5f872a5a40a9",
                                                "sense_id": "a71bb761-85de-3b5e-9ccc-f7fd92aaca4f",
                                                "text": "Que fais-tu à Pâques toi ?"
                                            },
                                            {
                                                "example_id": "c7baaf8b-7c90-464d-a560-253974367fee",
                                                "sense_id": "a71bb761-85de-3b5e-9ccc-f7fd92aaca4f",
                                                "text": "Joyeuses Pâques !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
