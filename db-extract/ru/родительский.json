                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paternal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a440d48f-8939-3b65-82f5-d74ba84353fe",
                                        "entry_id": "dc10194c-d9ad-39d1-b396-053b21079ae3",
                                        "glosses": [
                                            "Of or pertaining to one's father, his genes, his relatives, or his side of a family."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "175ecaae-f125-4971-be61-2335b7021081",
                                                "sense_id": "a440d48f-8939-3b65-82f5-d74ba84353fe",
                                                "text": "paternal grandfather"
                                            },
                                            {
                                                "example_id": "e222baf8-84ed-4c1e-b450-dc7ca78deddc",
                                                "sense_id": "a440d48f-8939-3b65-82f5-d74ba84353fe",
                                                "text": "It was with a natural touch of pride that Norbourne Courtenaye paced his paternal hall, while waiting for his uncle, with whom he was going to ride."
                                            },
                                            {
                                                "example_id": "62676159-06fc-4967-a6e9-8643b8976216",
                                                "sense_id": "a440d48f-8939-3b65-82f5-d74ba84353fe",
                                                "text": "The eldest son was usually given the name of his paternal grandfather, later children those of other relatives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94daffec-039e-3cc6-8c2e-56d639f069dd",
                                        "entry_id": "dc10194c-d9ad-39d1-b396-053b21079ae3",
                                        "glosses": [
                                            "Fatherly; behaving as or characteristic of a father."
                                        ],
