                    {
                        "translation_id": "80e51619-5484-4d81-bc9f-9913d877374e",
                        "source_entry_id": "0cfcb7eb-8588-3498-a748-cd0ecf86d11f",
                        "source_sense_id": "3a024f12-3613-3bb2-85a9-fad5b9750b71",
                        "source_sense_description": "Lower the morale of",
                        "target_lang_word": "ontmoedigen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ontmoedigen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "05e52043-afa5-333c-aa73-7fe9e325e8c7",
                                        "entry_id": "1719349e-ca0b-3e5c-a48c-ae148485fecd",
                                        "glosses": [
                                            "de moed ontnemen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "223edcbb-d029-4a85-b6df-db17f778915e",
                                                "sense_id": "05e52043-afa5-333c-aa73-7fe9e325e8c7",
                                                "text": "De mensen die demonstreerden op het plein lieten zich zelfs door grof geweld niet ontmoedigen hun eisen te blijven stellen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e24bc0c9-a4af-466f-bead-f9e100be24d5",
                        "source_entry_id": "0cfcb7eb-8588-3498-a748-cd0ecf86d11f",
                        "source_sense_id": "3a024f12-3613-3bb2-85a9-fad5b9750b71",
                        "source_sense_description": "Lower the morale of",
                        "target_lang_word": "décourager",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décourager",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "883963af-c01d-3ac9-9611-a4ae7d21fd9d",
                                        "entry_id": "493e0615-a20a-349d-8198-42a449ca241b",
                                        "glosses": [
                                            "Dépourvoir de courage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3e615d1-def0-4ed4-b853-38562b1b8049",
                                                "sense_id": "883963af-c01d-3ac9-9611-a4ae7d21fd9d",
                                                "text": "Mais il ne se laissa pas décourager : si tous les bras retombaient impuissants devant l'œuvre à accomplir, si personne ne donnait le bon exemple, le mal triompherait toujours, incurable."
                                            },
                                            {
                                                "example_id": "74f7896f-1c04-48da-89cf-b93f1f038fe1",
                                                "sense_id": "883963af-c01d-3ac9-9611-a4ae7d21fd9d",
                                                "text": "Celui-là est défendu contre les quémandeurs trop opiniâtres par une sorte de femelle revêche, bourrue, grimaçante, qui s'entend à merveille à décourager les volontés les plus obstinées."
                                            },
                                            {
                                                "example_id": "20120d3b-cd84-46df-a57b-a4a2b03f5641",
                                                "sense_id": "883963af-c01d-3ac9-9611-a4ae7d21fd9d",
                                                "text": "Devant la réprobation presque unanime qui accueillit mon exposé, je me décourageai et me ralliai à l'interprétation probabiliste de Born, Bohr et Heisenberg […]."
                                            },
                                            {
                                                "example_id": "922f8872-4e9c-4c1d-9f6b-e59c43a60a56",
                                                "sense_id": "883963af-c01d-3ac9-9611-a4ae7d21fd9d",
                                                "text": "Seul, malade, et décourageant de moi comme j’avais le secret — et le talent — de le faire, je trouvais enfin l’extrême, vers où je tendais aveuglément."
                                            },
                                            {
                                                "example_id": "301b0ce8-cad9-4e0c-b868-429109201403",
                                                "sense_id": "883963af-c01d-3ac9-9611-a4ae7d21fd9d",
                                                "text": "Tenez vos engagements. Cela découragera totalement vos adversaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89eba79a-dd77-4fcf-ba4d-e604879e6c74",
                        "source_entry_id": "0cfcb7eb-8588-3498-a748-cd0ecf86d11f",
                        "source_sense_id": "3a024f12-3613-3bb2-85a9-fad5b9750b71",
                        "source_sense_description": "Lower the morale of",
                        "target_lang_word": "entmutigen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entmutigen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4301aa5-9518-3691-a4c6-a07a8c2a6fe6",
                                        "entry_id": "5db89f19-d900-38de-9dac-62452784af03",
                                        "glosses": [
                                            "den Mut nehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e783c9c-6f2c-4bab-81be-9049ae82322c",
                                                "sense_id": "c4301aa5-9518-3691-a4c6-a07a8c2a6fe6",
                                                "text": "Leider werden junge Leute ständig dabei entmutigt, ehrlich zu sein, und mit dem bedroht, was wir Moral nennen. Zuerst durch die Familien, dann die Religionen und schließlich auch durch die Psychiatrie."
                                            },
                                            {
                                                "example_id": "956e5363-c5bb-4a30-a3ba-c250ad7c3e1c",
                                                "sense_id": "c4301aa5-9518-3691-a4c6-a07a8c2a6fe6",
                                                "text": "Meine Eltern haben mir beigebracht, hart zu arbeiten. Und Geduld zu haben, um die Ziele, die man sich setzt, zu erreichen. Ich brauchte lange Zeit, um zu verstehen, dass man Geduld braucht, dass man sich nicht entmutigen lassen darf, wenn es nicht sofort klappt."
                                            },
                                            {
                                                "example_id": "c46dc626-3e12-4079-888b-8e2d231bef15",
                                                "sense_id": "c4301aa5-9518-3691-a4c6-a07a8c2a6fe6",
                                                "text": "Emerson hat jene gütige und geistreiche Heiterkeit, welche allen Ernst entmutigt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
