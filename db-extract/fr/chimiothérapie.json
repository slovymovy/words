                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d30d834e-9f5f-3c50-9f78-5c1d6594cdfe",
                        "entry_id": "ae679936-54dc-39e6-b1ef-c3fe49fede7f",
                        "glosses": [
