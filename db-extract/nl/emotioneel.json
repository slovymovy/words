                ],
                "senses": [
                    {
                        "sense_id": "4000f3fe-30aa-3c0e-8ae5-0e8a28be245f",
                        "entry_id": "90b83405-25f0-3936-8872-0700303897d8",
                        "glosses": [
                            "zeer vatbaar voor gevoelens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73defc02-f05a-43a1-8928-21ebcc6418f5",
                                "sense_id": "4000f3fe-30aa-3c0e-8ae5-0e8a28be245f",
                                "text": "Het emotionele meisje wist haar gevoeligheid toch onder controle te krijgen."
                            }
                        ]
                    },
                    {
                        "sense_id": "cda6d96b-2117-3d34-8204-fce6e268adc3",
                        "entry_id": "90b83405-25f0-3936-8872-0700303897d8",
                        "glosses": [
                            "sterke gevoelens oproepend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df233d88-4f49-4b02-b76c-efb4e20d7d94",
                                "sense_id": "cda6d96b-2117-3d34-8204-fce6e268adc3",
                                "text": "Een stuk plastic dat niet meer dan 1 cent waard was. Waarschijnlijk was ze hem bij de laatste waterbron vergeten, meer dan 10 kilometer terug. ‘Ach, je kan wel een nieuwe in het volgende dorp kopen,’ probeerde ik nog. Maar nee, ze moest en zou haar fles terugvinden. De fles had veel emotionele waarde voor haar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f19b141b-70c6-474c-8688-106600849d4a",
                        "source_entry_id": "90b83405-25f0-3936-8872-0700303897d8",
                        "source_sense_id": "4000f3fe-30aa-3c0e-8ae5-0e8a28be245f",
                        "source_sense_description": "zeer vatbaar voor gevoelens",
                        "target_lang_word": "emotional",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emotional",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2c63bb3-a860-3263-af72-832ff80aa107",
                                        "entry_id": "d520ec13-1dc6-3264-be78-48072a1be23d",
                                        "glosses": [
                                            "mit Gefühlen (Emotionen) zu tun habend"
                                        ],
                                        "tags": [
                                            "nicht steigerbar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5deb7cb-12e8-4c79-a22a-6af9a249e5de",
                                                "sense_id": "e2c63bb3-a860-3263-af72-832ff80aa107",
                                                "text": "Trotz der emotionalen Spannungen war es ein konstruktives Gespräch."
                                            },
                                            {
                                                "example_id": "89f10330-e814-4827-9bfd-57cc8b2398d3",
                                                "sense_id": "e2c63bb3-a860-3263-af72-832ff80aa107",
                                                "text": "Emotionales Verhalten geht von der Empfindung aus, rationales vom Verstand."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "874bd1de-a762-3fd8-8a86-e79b1046a52d",
                                        "entry_id": "d520ec13-1dc6-3264-be78-48072a1be23d",
                                        "glosses": [
                                            "Emotionen zeigend; oft vorwurfsvoll: (über-)empfindlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63e96556-b770-49ea-b2a3-bfc9d810d9db",
                                                "sense_id": "874bd1de-a762-3fd8-8a86-e79b1046a52d",
                                                "text": "Sie ist ein sehr emotionaler Mensch und fängt recht schnell an zu weinen."
                                            },
                                            {
                                                "example_id": "07bd3f46-1bd6-454b-9ecc-fe2aa15c62ba",
                                                "sense_id": "874bd1de-a762-3fd8-8a86-e79b1046a52d",
                                                "text": "Sei nicht immer so emotional, wenn ich dir erkläre, wieso du wieder mal Unrecht hast!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ef683a6-03a1-468f-a896-abc6584698c3",
                        "source_entry_id": "90b83405-25f0-3936-8872-0700303897d8",
                        "source_sense_id": "4000f3fe-30aa-3c0e-8ae5-0e8a28be245f",
