                                "sense_id": "d9d40d99-64d3-35b9-8502-a633f0fee0fd",
                                "text": "Seit Jahrzehnten fährt Olga mit ihrem Mann Hubertus zum Zelten nach Kärnten."
                            },
                            {
                                "example_id": "b5f967e2-84ac-4a76-ae25-a238ad7d8eed",
                                "sense_id": "d9d40d99-64d3-35b9-8502-a633f0fee0fd",
                                "text": "Ohne einen Tropfen Alkohol angerührt zu haben, fuhr Olga mit ihrem Traktor Schlangenlinien auf der Hauptstraße."
                            },
                            {
                                "example_id": "76814f3f-12ea-42dd-a0e9-5a82d635f1d7",
                                "sense_id": "d9d40d99-64d3-35b9-8502-a633f0fee0fd",
                                "text": "Wir haben Olgas Stiftung in ihrem Sinne weitergeführt."
                            }
                        ],
                        "sense_index_json": "\"1\""
