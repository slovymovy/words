                ],
                "translations": [
                    {
                        "translation_id": "334f08fe-1e05-45fa-a7f4-4ad9a29b7f45",
                        "source_entry_id": "a4184a16-8ecf-3777-a519-c61f52b2cbfb",
                        "source_sense_id": "bf547289-affd-3ebe-a0fb-2bb065b0faf7",
                        "target_lang_word": "Amelia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amelia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0fe2b64-f7f4-37f6-a165-0e70e8a74d63",
                                        "entry_id": "5352d6dc-5708-3a25-b60a-86e3e16d521f",
                                        "glosses": [
                                            "A female given name from the Germanic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c725845-a7b1-4cb1-b622-ee41dcfa5b85",
                                                "sense_id": "b0fe2b64-f7f4-37f6-a165-0e70e8a74d63",
                                                "text": "By their dresses, their names, and the airs of quality they give themselves, I am rendered ridiculous among all my acquaintance. My wife, who is a very plain good woman, and whose name is Amey, has been new-christened, and is called Amelia; and my little daughter, a child of a year old, is no longer Polly, but Maria."
                                            },
                                            {
                                                "example_id": "abb9a66b-33f6-4b7f-b253-931758e45c04",
                                                "sense_id": "b0fe2b64-f7f4-37f6-a165-0e70e8a74d63",
                                                "text": "We must have heard it first on the battery radio, the news about Amelia Earhart, lost over the ocean. […] Air Heart, I saw it spelled, Amelia ... a name like a soft, bold bird."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc3b8f85-77a9-3fe4-9e6e-f3bc6cd19dda",
                                        "entry_id": "5352d6dc-5708-3a25-b60a-86e3e16d521f",
                                        "glosses": [
                                            "The alternative name for Amelia Courthouse, Amelia County, Virginia, US."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d2e8128-c003-48e9-bb6a-f6df6ab226eb",
                        "source_entry_id": "a4184a16-8ecf-3777-a519-c61f52b2cbfb",
                        "source_sense_id": "bf547289-affd-3ebe-a0fb-2bb065b0faf7",
                        "target_lang_word": "Amélie",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amélie",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "698156fb-6eef-3fd9-bc7a-b8052c7bde34",
                                        "entry_id": "fccc5aa1-6f58-344c-a203-30708829b3d7",
                                        "glosses": [
                                            "ženské křestní jméno"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cbf7d2a-8793-4e07-8e14-e192712155c8",
                        "source_entry_id": "a4184a16-8ecf-3777-a519-c61f52b2cbfb",
                        "source_sense_id": "bf547289-affd-3ebe-a0fb-2bb065b0faf7",
                        "target_lang_word": "Amélie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amélie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f341828f-d06a-3191-9678-7570f6687ea4",
                                        "entry_id": "998aa8dd-7057-3135-9a34-2ff292039305",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7dbc5a6-8eb0-40d4-900f-265ce722a9c0",
                                                "sense_id": "f341828f-d06a-3191-9678-7570f6687ea4",
                                                "text": "Elle se révolta. Elle n’admettait pas qu’Amélie Pouilly souffrît par le fait d’un Bergeret."
                                            },
                                            {
                                                "example_id": "43d1d11f-89c4-450d-8f92-c0cd5db920b4",
                                                "sense_id": "f341828f-d06a-3191-9678-7570f6687ea4",
                                                "text": "Nous avions à ce moment une servante qui s’appelait Amélie, nous disions « la Mélie » ; elle avait une figure d’homme, une large bouche et les dents cariées ; elle était laide et avait, depuis plusieurs années, coiffé sainte Catherine."
                                            },
                                            {
                                                "example_id": "aed316e7-66de-4e0e-8c8d-ab4c3c5ae225",
                                                "sense_id": "f341828f-d06a-3191-9678-7570f6687ea4",
                                                "text": "Bonne tante Amélie, oui, archi-bonne !"
                                            },
                                            {
                                                "example_id": "2821b3dd-cba6-46a9-b7b0-2bf44b855a98",
                                                "sense_id": "f341828f-d06a-3191-9678-7570f6687ea4",
                                                "text": "« Pour serrer les prix, nous misons sur la vente directe dans notre shop à Paris ou en ligne, et sur l’utilisation au maximum de pièces standards du marché dont la fiabilité a été approuvée », explique Amélie Guicheney, l’une des créatrices."
                                            },
                                            {
                                                "example_id": "cdd70644-227d-4964-8496-d792c406c5ef",
                                                "sense_id": "f341828f-d06a-3191-9678-7570f6687ea4",
                                                "text": "La maire de Pleyben, Amélie Caro, se dit ravie de l'arrivée d’Eurofins dans sa commune."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Amélie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd6333f9-986f-347b-af74-208775a0fdf3",
                                        "entry_id": "ecde6aa4-7f30-3c41-85d9-d8875196b31a",
                                        "glosses": [
                                            "Nom d’un astéroïde, découvert en 1922 par Josep Comas i Solá^([*])."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
