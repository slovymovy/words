                "entry_id": "5d8f4b6d-f767-35c2-8b41-34d51526a810",
                "word": "sciage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "463cbd90-1b1e-4af6-a31d-a651762d6373",
                        "entry_id": "5d8f4b6d-f767-35c2-8b41-34d51526a810",
                        "tags": [
                            "plural"
                        ],
                        "form": "sciages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "32dc1438-3ff3-3ca8-9218-a1abbd7f2e4b",
                        "entry_id": "5d8f4b6d-f767-35c2-8b41-34d51526a810",
                        "glosses": [
                            "Action, travail de celui qui scie du bois ou de la pierre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e0b9076-1b3b-4bbd-b3c2-e3ebdf60cbf1",
                                "sense_id": "32dc1438-3ff3-3ca8-9218-a1abbd7f2e4b",
                                "text": "Ce mode de sciage peut être manuel ou mécanique et se rencontre aussi sur des machines électroportatives (machines « scie sauteuse », « scie sabre ») ; dans ce cas, la lame n'est maintenue que par une seule extrémité."
                            },
                            {
                                "example_id": "a25ed239-20bd-4ae6-b5fa-c2a8c68a268b",
                                "sense_id": "32dc1438-3ff3-3ca8-9218-a1abbd7f2e4b",
                                "text": "Il en a coûté tant pour le sciage de ce bloc de marbre, de cette voie de bois."
                            },
                            {
                                "example_id": "028cbeca-bec8-481b-b3a6-ec5d65828258",
                                "sense_id": "32dc1438-3ff3-3ca8-9218-a1abbd7f2e4b",
                                "text": "Bois de sciage, Celui qui provient d’une pièce de bois refendue dans sa longueur."
                            }
                        ]
                    },
                    {
                        "sense_id": "e99a91d7-8def-34ac-a93f-d44ebaf3fd24",
                        "entry_id": "5d8f4b6d-f767-35c2-8b41-34d51526a810",
                        "glosses": [
                            "Sciure de bois."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b5758945-13cc-4d93-bd7d-42d18deaa09d",
                                "sense_id": "e99a91d7-8def-34ac-a93f-d44ebaf3fd24",
                                "text": "Je me roulai dans le sciage et m’amusai à en remplir mes poches ; puis je fis une provision de copeaux de choix ; et, enfin, je dis timidement que je voulais m’en aller."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6fa5159-5128-460d-8112-71eb65d2a31a",
