                ],
                "senses": [
                    {
                        "sense_id": "5034eb12-e36a-3a37-9018-22ed0aa0bb62",
                        "entry_id": "6903ef01-7713-36f3-95bc-eadde2038325",
                        "glosses": [
                            "Betriebszustand einer Heizanlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d59c5d42-d40b-4cdf-a431-fc56a7652b01",
                                "sense_id": "5034eb12-e36a-3a37-9018-22ed0aa0bb62",
                                "text": "„Im Heizungsbetrieb bläst die Heizung ihre Warmluft erst durch den Boiler und dann in den Van.“"
                            },
                            {
                                "example_id": "60af07cf-f9ad-4363-adab-f7582f865dc1",
                                "sense_id": "5034eb12-e36a-3a37-9018-22ed0aa0bb62",
                                "text": "„Für den Heizungsbetrieb stehen sowohl fossile als auch regenerative Energieträger zur Verfügung.“"
                            },
                            {
                                "example_id": "9fdb2935-08e1-49d6-8122-2b45fc46b84f",
                                "sense_id": "5034eb12-e36a-3a37-9018-22ed0aa0bb62",
                                "text": "„In den letzten Jahren wurden von mehreren Herstellern Wärmepumpen für den Heizungsbetrieb entwickelt.“"
                            },
                            {
                                "example_id": "517678c6-a1f8-4543-bafa-5cc8d42f80bb",
                                "sense_id": "5034eb12-e36a-3a37-9018-22ed0aa0bb62",
                                "text": "„Um eine möglichst hohe Leistungsaufnahme der elektrischen Verbraucher zu erzielen, wird beim Heizungsbetrieb eine Zieltemperatur von 36 °C und beim Klimaanlagenbetrieb eine Zieltemperatur von 16 °C eingestellt.“"
                            },
                            {
                                "example_id": "a25d4a8b-9783-4eeb-94ad-cd0a73de7436",
                                "sense_id": "5034eb12-e36a-3a37-9018-22ed0aa0bb62",
                                "text": "„Die Kunden erwarten von ihrer Heizanlage primär einen störungsfreien, ökologischen und effizienten Heizungsbetrieb.“"
                            },
                            {
                                "example_id": "d030c4d6-6828-4374-804d-1ca03ed811a1",
                                "sense_id": "5034eb12-e36a-3a37-9018-22ed0aa0bb62",
                                "text": "„Bernds Vater arbeitete als Installateur in einem Heizungsbetrieb in der Gemeinde, seine Mutter als Verkäuferin in einer Bäckerei im Dorf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a4ca3af0-015d-32d3-82fd-98df6da3841b",
                        "entry_id": "6903ef01-7713-36f3-95bc-eadde2038325",
                        "glosses": [
                            "Unternehmen, das im Bereich der Heiztechnik tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27b06607-2b17-4433-b90c-ede841652261",
                                "sense_id": "a4ca3af0-015d-32d3-82fd-98df6da3841b",
                                "text": "„Vor eineinhalb Jahren stellte ihn ein Sanitär- und Heizungsbetrieb in Reichenbach an der Fils als Mitarbeiter an.“"
                            },
                            {
                                "example_id": "59505195-b6df-4839-8210-f1e29de9a151",
                                "sense_id": "a4ca3af0-015d-32d3-82fd-98df6da3841b",
                                "text": "„Aufgewachsen mit zwei Geschwistern in Friesland, in einem Örtchen namens Sande, hat Steck als Jugendlicher im Heizungsbetrieb seines Vaters mitgearbeitet.“"
                            },
                            {
                                "example_id": "6609795e-ceae-4184-a240-7cbe4d241162",
                                "sense_id": "a4ca3af0-015d-32d3-82fd-98df6da3841b",
                                "text": "„Unser Sanitär und Heizungsbetrieb kann mit seinen ‚älteren Mitarbeitern‘ gute Beratung und Erfahrung anbieten.“"
                            },
                            {
                                "example_id": "debfebb6-ae7b-4851-8198-4143e7cfbf96",
                                "sense_id": "a4ca3af0-015d-32d3-82fd-98df6da3841b",
                                "text": "„Der Kunde geht bei einer Anfrage davon aus, dass ihm der Heizungsbetrieb eine passende Heizung verkauft.“"
                            },
                            {
                                "example_id": "0b0dc6e1-9c9a-41ca-8252-95186bba12e6",
                                "sense_id": "a4ca3af0-015d-32d3-82fd-98df6da3841b",
                                "text": "„Wenn der alte Chef in den Ruhestand geht, wird Jakob Schröder den Sanitär- und Heizungsbetrieb Freese in Nürnberg übernehmen.“"
                            },
                            {
                                "example_id": "6d77920c-0a12-401d-b9d4-620d647aa089",
                                "sense_id": "a4ca3af0-015d-32d3-82fd-98df6da3841b",
                                "text": "„Wenn die Heizungsbetriebe weiter Heizungen verkaufen wollen, dürfen diese nicht zu teuer sein, denn sonst könnten die Hauseigentümer sich sagen, dass sie die.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
