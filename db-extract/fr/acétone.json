                "senses": [
                    {
                        "sense_id": "798b6bd9-d25f-37b8-84a7-eae124db52e2",
                        "entry_id": "7dbd8094-d1c4-3b1c-a2fc-b58468c0b594",
                        "glosses": [
                            "Composé le plus simple de la famille des cétones de formule CH₃COCH₃."
                        ],
                        "tags": [
                            "common"
                        ],
                        "examples": [
                            {
                                "example_id": "e220af3e-7046-4d54-b21c-4eafc77247d8",
                                "sense_id": "798b6bd9-d25f-37b8-84a7-eae124db52e2",
                                "text": "Pour enlever les taches qui peuvent être faites sur les doigts avec le désensibilisateur, il suffit de les frotter avec un tampon d’ouate imbibé d’acétone."
                            },
                            {
                                "example_id": "a40c659c-00c9-4d3c-ae02-43f650746ab0",
                                "sense_id": "798b6bd9-d25f-37b8-84a7-eae124db52e2",
                                "text": "Le paracrésol est facilement transformé entre 200° et 230° en paraméthylcyclohexanol, contenant seulement des traces d’acétone, faciles à éliminer par le bisulfite."
                            },
                            {
                                "example_id": "7f815a0e-aa59-44f3-821c-85559f9728eb",
                                "sense_id": "798b6bd9-d25f-37b8-84a7-eae124db52e2",
                                "text": "Plus récemment, à Barcelone, les terroristes avaient acheté, on ne sait où, pas moins de 500 litres d’acétone pour faire la bombe."
                            }
                        ]
                    }
                ],
