                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lotterie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74e13b5b-0966-3371-adb3-c911943b10b0",
                                        "entry_id": "65ec63dc-8046-3c85-9195-7a5d1622bbcf",
                                        "glosses": [
                                            "Glücksspiel in Form einer Auslosung von Gewinnen und Nieten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93533bc2-d667-4349-8325-7b3249fcdebc",
                                                "sense_id": "74e13b5b-0966-3371-adb3-c911943b10b0",
                                                "text": "Kaufen Sie ein Los unserer Lotterie."
                                            },
                                            {
                                                "example_id": "c8062212-8e7c-4d76-80eb-8ab66e5f4290",
                                                "sense_id": "74e13b5b-0966-3371-adb3-c911943b10b0",
                                                "text": "„Man bot mir sechs Annahmebüros und viertausend Francs jährliche Vergütung aus der Lotterie selbst; ich nahm sofort an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b4e9a88-c55a-4b76-916e-f1f5de2bc76a",
                        "source_entry_id": "8df4f130-89c6-3630-9632-8b05efbe68ed",
                        "source_sense_id": "46d55df5-9ba5-3210-96f8-775e2a55cdca",
                        "target_lang_word": "лотерея",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лотерея",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "afa3dd0d-c297-3e8b-a9bc-0b018094a882",
                                        "entry_id": "cdccbcf4-cbb7-3bb6-973d-6e5fff2db390",
                                        "glosses": [
                                            "форма добровольного привлечения (государством или проводящей лотерею [1] организацией) денежных средств населения путём продажи специальных (лотерейных) нумерованных билетов одинаковой стоимости с последующим розыгрышем вещей и/или денежных сумм"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2155440-36bb-4bb3-a2f2-49de4a042a47",
                                                "sense_id": "afa3dd0d-c297-3e8b-a9bc-0b018094a882",
                                                "text": "В начале мая, посмотрев в таблицу выигрышей в лотерею Государственного Дворянского банка, я заметил, что выиграл пятьсот рублей."
                                            },
                                            {
                                                "example_id": "b7b45227-8136-4146-9da2-f28a30516a5b",
                                                "sense_id": "afa3dd0d-c297-3e8b-a9bc-0b018094a882",
                                                "text": "Главным управлением спортивных лотерей подведены итоги 51 тиража лотереи «Спорт-прогноз», состоявшегося с 19 по 20 декабря 1987 года."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9cd3667-f41c-3170-97ee-e470318805d2",
                                        "entry_id": "cdccbcf4-cbb7-3bb6-973d-6e5fff2db390",
                                        "glosses": [
                                            "перен., разг. нечто неопределённое или с непредсказуемым результатом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8414528-e196-40f1-879b-d2c9af3afd66",
                                                "sense_id": "c9cd3667-f41c-3170-97ee-e470318805d2",
                                                "text": "Игнация советовала сыну своему жениться, но он в том ей не повиновался. — Матушка, — говорил он ей, — женитьба есть не иное что, как лотерея, в которой пустых билетов очень много."
                                            },
                                            {
                                                "example_id": "545ca827-0095-40af-82fe-b45f725fbc65",
                                                "sense_id": "c9cd3667-f41c-3170-97ee-e470318805d2",
                                                "text": "Выйдешь завтра утром на улицу и встретишь свою судьбу. Лотерея. Будущее — всегда загадка."
                                            },
                                            {
                                                "example_id": "9e2547b4-91bd-4f3d-ba21-b0d48c9c3668",
                                                "sense_id": "c9cd3667-f41c-3170-97ee-e470318805d2",
                                                "text": "Какая лошадь кому попадётся, никто не знает. Это лотерея. Спортсмен может быть лидером после фехтования и плавания, а после конку́ра уйти на задний план."
