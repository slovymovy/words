                            "text": "The computer program will <w>truncate</w> the result to two decimal places."
                        },
                        {
                            "text": "You should <w>truncate</w> the value instead of rounding it for this calculation."
                        }
                    ],
                    "synonyms": [
                        "round down"
                    ],
                    "common_phrases": [
