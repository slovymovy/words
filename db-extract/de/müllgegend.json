                "senses": [
                    {
                        "sense_id": "0812bda0-4167-36ba-a09f-89dbd9cfe961",
                        "entry_id": "c7efe482-1ece-31f4-ba0b-6adbc8bc6a5e",
                        "glosses": [
                            "Bereich, der von Müll übersät ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f84a387-a5c1-45d7-944a-2f6711fb45cc",
                                "sense_id": "0812bda0-4167-36ba-a09f-89dbd9cfe961",
                                "text": "„Ein Ausbildungszentrum ist geplant, damit die Menschen bessere Perspektiven haben und aus der Müllgegend wegkommen.“"
                            },
                            {
                                "example_id": "bf8de9a5-5cb7-4736-b06e-f95c6210b03c",
                                "sense_id": "0812bda0-4167-36ba-a09f-89dbd9cfe961",
                                "text": "„Trotzdem gibt es natürlich einige markante Orte, an denen die Geschehnisse des Films sich abspielen, so die Stadt, ein Häuschen mitten im Nichts oder beispielsweise eine kleie [sic] Müllgegend, wo Eli anfangs von Banditen überfallen wird.“"
                            },
                            {
                                "example_id": "d06e9904-ab1d-44a3-820d-2928643eb18f",
                                "sense_id": "0812bda0-4167-36ba-a09f-89dbd9cfe961",
                                "text": "„Vision wöchentlich ein zweistündiges Programm für durchschnittlich 40 Kinder an nur einem Standort – der „Müllgegend“ im Stadtteil Inayawan von Cebu City.“"
                            },
                            {
                                "example_id": "64758823-dee6-470a-ae63-1fa45b5e454f",
                                "sense_id": "0812bda0-4167-36ba-a09f-89dbd9cfe961",
                                "text": "In der Müllgegend gibt es keine Schule. Nach der Schule geht es wieder auf den Müllberg."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
