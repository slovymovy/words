                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adbe9c85-b97b-486c-a389-321f849665d0",
                                "sense_id": "af76fb8d-f627-321e-b001-7fe7fe2f75bc",
                                "text": "Cet aménagement a été demandé par les élèves du lycée Barbanceys dans le cadre du Conseil de vie lycéenne (CVL) afin d’améliorer leur cadre de vie à l’internat."
                            },
                            {
                                "example_id": "6aac4ba6-061a-4c0b-96d0-8611c0877db8",
                                "sense_id": "af76fb8d-f627-321e-b001-7fe7fe2f75bc",
                                "text": "Le CVL est composé de 10 élus lycéens, de 10 personnels du lycée et de parents d’élèves."
                            },
                            {
                                "example_id": "4e735463-b1cb-4cb8-ae7f-bafa5f98747d",
                                "sense_id": "af76fb8d-f627-321e-b001-7fe7fe2f75bc",
                                "text": "Le CVL est compétent pour débattre des questions sur le travail scolaire et les conditions de vie des élèves dans les lycées."
                            }
