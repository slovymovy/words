                    {
                        "translation_id": "93bffb6e-38d6-4aa9-8bd4-10ef66e743a4",
                        "source_entry_id": "de22f33e-4101-38c2-8e17-75a949268435",
                        "source_sense_id": "fa9fecfe-2fa9-3649-8be7-3f2c21abcbaa",
                        "source_sense_description": "langdurig verlies van vrijheid als gevolg van een schuld die niet kan worden afgelost",
