                ],
                "translations": [
                    {
                        "translation_id": "a72bd9e2-8d30-481e-a24d-0a0201fd09f7",
                        "source_entry_id": "f2c06e14-3d79-3f76-bd22-0668a25138fc",
                        "source_sense_id": "6b5d77d9-33b0-315f-9e87-2600ffcf26e0",
                        "source_sense_description": "umgangssprachlich, salopp: kühn, mutig, gewagt",
                        "target_lang_word": "kühn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kühn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "276ce1b0-bb93-3059-b511-1c4fc7cad936",
                                        "entry_id": "65a3be51-6f36-3696-87bf-c31938187e98",
                                        "glosses": [
                                            "der Gefahr trotzend und ihr entschlossen entgegentretend"
                                        ],
                                        "tags": [
                                            "über Personen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "244b44b5-c091-4260-8474-40d9f03c9576",
                                                "sense_id": "276ce1b0-bb93-3059-b511-1c4fc7cad936",
                                                "text": "„… indem sie die Augen kurz aufriß, sie dann jedoch zwischen den wieder verengten Lidern traumhaft verschwimmen ließ, sprach sie das Wort: ‚Du entkleidest mich, kühner Knecht?‘“"
                                            },
                                            {
                                                "example_id": "cb1ae821-6b71-412e-9405-262fb46441f5",
                                                "sense_id": "276ce1b0-bb93-3059-b511-1c4fc7cad936",
                                                "text": "„Sie brachte aus ihren Reihen schließlich auch kühne Eroberer hervor, diese unterstanden jedoch der Kontrolle eines Direktoriums im fernen London, das immer den Rechenstift zur Hand hatte und auf «shareholder value» achtete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "79b0b383-efe3-3c67-b4b3-122bd8d62cd5",
                                        "entry_id": "65a3be51-6f36-3696-87bf-c31938187e98",
                                        "glosses": [
                                            "über ein anerkanntes Maß hinausgehend, gewagt, ungesichert"
                                        ],
                                        "tags": [
                                            "über Handlungen",
                                            "Äußerungen",
                                            "Gedanken"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c85e353d-6e3f-4b15-a2bf-879b2dd69ef2",
                                                "sense_id": "79b0b383-efe3-3c67-b4b3-122bd8d62cd5",
                                                "text": "Unzählige erfolgversprechende Projekte, die sich die Träumer früherer Zeiten nicht in ihren kühnsten Träumen hätten vorstellen können!"
                                            },
                                            {
                                                "example_id": "2c6ea331-90f6-4154-ac79-92e844b42223",
                                                "sense_id": "79b0b383-efe3-3c67-b4b3-122bd8d62cd5",
                                                "text": "Jede kühne Tat ehrt ihren Täter."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f61644c1-03fb-45f8-876b-ebd685cd8b1d",
                        "source_entry_id": "f2c06e14-3d79-3f76-bd22-0668a25138fc",
                        "source_sense_id": "6b5d77d9-33b0-315f-9e87-2600ffcf26e0",
                        "source_sense_description": "umgangssprachlich, salopp: kühn, mutig, gewagt",
                        "target_lang_word": "mutig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mutig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2e0ea7f-53a1-364d-b840-103a54c229c7",
                                        "entry_id": "89093b04-94dc-3414-a109-30686ac9f9cf",
                                        "glosses": [
                                            "voller Mut, Mut aufbringend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5af10f5e-bbac-466e-b183-8f6b7bf053fd",
                                                "sense_id": "f2e0ea7f-53a1-364d-b840-103a54c229c7",
                                                "text": "Sei mutig!"
                                            },
                                            {
                                                "example_id": "151b9f94-b0b2-4219-a13d-9238a8b9e098",
                                                "sense_id": "f2e0ea7f-53a1-364d-b840-103a54c229c7",
                                                "text": "„Der Schiläufer, der ein steiles Gelände sicher hinabfahren will, muss Schutzreflexe abbauen. […] Er muss das Schutzstreben in die Rücklage aufgeben und mutig die Vorlage suchen, um seine Schier sicher führen zu können.“"
                                            },
                                            {
                                                "example_id": "256a45a8-6758-4242-a6fe-3a722198eb39",
                                                "sense_id": "f2e0ea7f-53a1-364d-b840-103a54c229c7",
                                                "text": "„Erst wenn die Mutigen klug und die Klugen mutig geworden sind, wird das zu spüren sein, was irrtümlicherweise schon oft festgestellt wurde: ein Fortschritt der Menschheit.“"
                                            },
                                            {
                                                "example_id": "ebed669d-c699-4458-85ff-ef6d97b655e6",
                                                "sense_id": "f2e0ea7f-53a1-364d-b840-103a54c229c7",
                                                "text": "„Doch selbst für mutige Spitzenreiter wie ihn wird einmal die Zeit kommen, vom Risikosport Abschied zu nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
