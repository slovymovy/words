                                    {
                                        "sense_id": "90f3b4f0-7ffc-3d88-aa2c-aaf100f02eb2",
                                        "entry_id": "ad68eba6-f0ef-350d-88c2-f50978087c35",
                                        "glosses": [
                                            "Easily broken into small fragments, crumbled, or reduced to powder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9445d226-dc62-4541-8868-38357cbebe4f",
                                                "sense_id": "90f3b4f0-7ffc-3d88-aa2c-aaf100f02eb2",
                                                "text": "Spiders had woven their vague trapezes between the friable heads of dead peonies in enormous glass jars streaked with tide marks where the water had evaporated long ago."
                                            },
                                            {
                                                "example_id": "a37725c6-4d6f-4818-ad34-88a1fa923412",
                                                "sense_id": "90f3b4f0-7ffc-3d88-aa2c-aaf100f02eb2",
                                                "text": "This light, friable type of material offered excellent insulation against both desert heat and also the cold of darkness during the winter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6481505e-c865-3119-a973-7934de83193f",
                                        "entry_id": "ad68eba6-f0ef-350d-88c2-f50978087c35",
                                        "glosses": [
                                            "Of soil, loose and large-grained in consistency."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "551c1b1e-29a5-4115-8ec9-d4fc4047f385",
                                                "sense_id": "6481505e-c865-3119-a973-7934de83193f",
                                                "text": "So while two men under his directions were digging the grave with sticks in the friable granitic soil, he superintended the costume of the other actors in the drama."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea138453-3fa3-3a89-a15d-b56b49ec211c",
                                        "entry_id": "ad68eba6-f0ef-350d-88c2-f50978087c35",
                                        "glosses": [
                                            "Of a poison, likely to crumble and become airborne, thus becoming a health risk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "442fe08a-ba20-4bc2-bb1e-03cf6943f2ca",
                                                "sense_id": "ea138453-3fa3-3a89-a15d-b56b49ec211c",
                                                "text": "It is when asbestos-containing products are friable that hazardous asbestos fibers are likely to be released and sent airborne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ac5b9ee-621a-3363-8643-a284418f6b75",
                                        "entry_id": "ad68eba6-f0ef-350d-88c2-f50978087c35",
                                        "glosses": [
                                            "Of a number: smooth, that factors completely into small prime numbers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
