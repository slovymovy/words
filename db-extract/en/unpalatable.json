                                                "sense_id": "b3a35217-cf5d-3bad-8f0f-4bb81c66ce53",
                                                "text": "Il arrive bien des choses dégoutantes dans la vie."
                                            },
                                            {
                                                "example_id": "1481756c-20d2-4dd2-afca-5534a9d560df",
                                                "sense_id": "b3a35217-cf5d-3bad-8f0f-4bb81c66ce53",
