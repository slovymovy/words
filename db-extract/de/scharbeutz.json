                "senses": [
                    {
                        "sense_id": "237ea060-1059-379c-b588-3cc87669f3bc",
                        "entry_id": "5f72413f-a289-30d3-a51d-d54508cc6076",
                        "glosses": [
                            "Gemeinde im Kreis Ostholstein in Schleswig-Holstein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ae02da1-b354-4fd7-9961-592a04f5661d",
                                "sense_id": "237ea060-1059-379c-b588-3cc87669f3bc",
                                "text": "Scharbeutz ist ein beliebtes Ostseebad."
                            },
                            {
                                "example_id": "e5d7d25a-f810-4e67-a7da-71c62ce8eb1f",
                                "sense_id": "237ea060-1059-379c-b588-3cc87669f3bc",
                                "text": "Er macht mit seiner Familie im Sommer in Scharbeutz Urlaub."
                            },
                            {
                                "example_id": "54b620e9-7072-4453-a97b-af0a74318e69",
                                "sense_id": "237ea060-1059-379c-b588-3cc87669f3bc",
                                "text": "„Mit meinen alten Kumpels aus Berlin telefonierte ich des Öfteren und irgendjemand kam auf die Idee, diesen Vatertag 1971 in Scharbeutz an der Ostsee zu feiern.“"
                            },
                            {
                                "example_id": "9ca7696e-6986-45da-bf31-a27c1122fdbd",
                                "sense_id": "237ea060-1059-379c-b588-3cc87669f3bc",
                                "text": "„Scharbeutz zeigt sich als moderner Küstenort mit Promenade und anspruchsvollen Freizeiteinrichtungen, Haffkrug präsentiert sich im positiven Sinne ruhig und familiär.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
