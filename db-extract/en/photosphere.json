                "senses": [
                    {
                        "sense_id": "cf3a2b93-c465-35b6-a423-0b60a462cfd2",
                        "entry_id": "552e4073-e48e-39fa-a5df-9a63b039e8d1",
                        "glosses": [
                            "A visible surface layer of a star, and especially that of a sun."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c97749d8-d87a-4b5f-a69a-538b86a2cc13",
                        "source_entry_id": "552e4073-e48e-39fa-a5df-9a63b039e8d1",
                        "source_sense_id": "cf3a2b93-c465-35b6-a423-0b60a462cfd2",
                        "source_sense_description": "A visible surface layer of a star",
                        "target_lang_word": "Photosphäre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Photosphäre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e15401fe-a6e8-300d-9b24-c77f6e25e235",
                                        "entry_id": "769a75ae-af93-3330-962d-8c9a6a5341db",
                                        "glosses": [
                                            "Licht- und Wärmestrahlung aussendende Schicht einer Sternatmosphäre. Für den mit optischen Hilfsmitteln ausgestatteten Beobachter stellt die Photosphäre die sichtbare Sternoberfläche dar."
                                        ],
                                        "tags": [
                                            "Astrophysik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f306080-bf47-4dc3-b6b4-12d0c452e541",
                                                "sense_id": "e15401fe-a6e8-300d-9b24-c77f6e25e235",
                                                "text": "„Das kontinuierliche Spektrum einer Photosphäre ist in allererster Näherung das eines schwarzen Strahlers mit der sogenannten Effektiven Temperatur des Sterns, das allerdings sowohl durch kontinuierliche Absorption, zum Beispiel des neutralen Wasserstoffatoms, sowie durch die Linienabsorption der Spektrallinien modifiziert wird.“"
                                            },
                                            {
                                                "example_id": "77096ca5-57bb-4109-9761-1b0c2a917f54",
                                                "sense_id": "e15401fe-a6e8-300d-9b24-c77f6e25e235",
                                                "text": "„Die Photosphäre erscheint weitgehend gleichmäßig hell, lediglich unterbrochen durch Sonnenflecken und Flares.“"
                                            },
                                            {
                                                "example_id": "1e308823-d114-488a-a7e5-78c661f9ee8d",
                                                "sense_id": "e15401fe-a6e8-300d-9b24-c77f6e25e235",
                                                "text": "„Über der Photosphäre erstrecken sich die Chromosphäre (Dicke: 5000 km; Temperatur: bis 20000 °C) und die Korona (Temperatur: bis 2 Mio. °C), die die Sonnenatmosphäre bilden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
