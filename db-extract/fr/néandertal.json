                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76b843fc-799f-4bba-8fba-c34c3c46d37d",
                                                "sense_id": "dd96c9cf-fefa-3e8b-82e4-56e5a1d50b6a",
                                                "text": "The capacity of the Neanderthal skull was 10% larger than that of modern humans."
                                            },
                                            {
                                                "example_id": "f7ffd7ae-b41f-42cc-881c-e0b6aba5bba7",
                                                "sense_id": "dd96c9cf-fefa-3e8b-82e4-56e5a1d50b6a",
                                                "text": "[…]In short, many assessments conclude that East Asians have more Neanderthal ancestry than Europeans, who have more Neanderthal ancestry than people in the Middle East."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d39c0ac8-6408-3c5b-830b-cff91bae7a3c",
                                        "entry_id": "386d8293-da2d-3d45-a0f7-75a0ca6c6e90",
                                        "glosses": [
                                            "Old-fashioned, opposed to change."
                                        ],
                                        "tags": [
                                            "broadly",
