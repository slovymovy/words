                                        "entry_id": "ebca26b1-ecf7-3765-95db-e26770f07ad5",
                                        "glosses": [
                                            "mit einem solchen Plan für die Handlungen, mit denen man ein militärisches, politisches oder wirtschaftliches Ziel erreichen will"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1692efe4-9908-469e-ae53-a5ceaa27d7c8",
                                                "sense_id": "80f37f0e-804f-376d-b1c8-aa756091037b",
                                                "text": "Es war strategisch gesehen eine Fehlentscheidung."
                                            },
                                            {
                                                "example_id": "47c0b2d6-c2a8-4216-8d6f-85707ada47f5",
                                                "sense_id": "80f37f0e-804f-376d-b1c8-aa756091037b",
                                                "text": "„Danach setzte er sich von Abydos aus im Gebiet der thrakischen Chersones fest (196 v.Chr.), womit er die strategisch wichtige Meerenge am Bosporus unter seine Kontrolle brachte.“"
                                            },
                                            {
                                                "example_id": "774cad44-e64c-4dd9-aca5-60a07a66d8af",
                                                "sense_id": "80f37f0e-804f-376d-b1c8-aa756091037b",
                                                "text": "„Auch Stalin grollte im Kreml. Denn ihm paßte die Kapitulation der deutschen Heeresgruppe in Italien überhaupt nicht in seine strategischen Überlegungen.“"
                                            },
                                            {
                                                "example_id": "fa6c86f5-0826-4d20-b3da-a05d09bc2e6d",
                                                "sense_id": "80f37f0e-804f-376d-b1c8-aa756091037b",
                                                "text": "„Die Einnahme der prachtvollen Großstadt ist symptomatisch für Geiserichs strategisches Geschick.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
