                "senses": [
                    {
                        "sense_id": "cc51d636-20b4-3fe9-9ed1-a0a4685a2a24",
                        "entry_id": "afe7ce93-e840-3570-b784-cc72e332b4a9",
                        "glosses": [
                            "Eigenschaft, leicht aufgeregt/erregt werden zu können/leicht reizbar zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0c8edf9-034e-4693-a1a6-640886ff9684",
                                "sense_id": "cc51d636-20b4-3fe9-9ed1-a0a4685a2a24",
                                "text": "„Seine Reizbarkeit nahm zu, und seine grundlosen Wutausbrüche gingen jetzt grösstenteils auf die Prinzessin Marja nieder.“"
                            },
                            {
                                "example_id": "927be16e-198a-42b9-b0e7-e7c2ed6651ec",
                                "sense_id": "cc51d636-20b4-3fe9-9ed1-a0a4685a2a24",
                                "text": "„Aber seine Reizbarkeit nahm mit jedem Monat zu, man kann auch sagen mit jedem Tag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
