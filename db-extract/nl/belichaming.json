                        "examples": [
                            {
                                "example_id": "e6553b59-7292-488c-8317-3cb78eb455f3",
                                "sense_id": "5522c95d-4982-380f-92b1-baf1a49ce226",
                                "text": "Het korte zwart-witfilmpje (alleen de lippen van de vrouw, Kyliáns vrouw en muze Sabine Kupferberg, zijn rood) is van markante grafische schoonheid. Donkere schaduwen, onheilspellend en hoekig vervormd, kruipen de trap op en af. Maar het mooist zijn Kupferberg en haar tegenspeler Peter Jolesch, die de belichaming lijken van Brels Vieux Amants (Kylián gebruikt in Scalamare overigens muziek van Han Otten en flarden Mantovani)."
                            }
                        ]
                    }
