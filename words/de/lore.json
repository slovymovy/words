                    "sense_id": "f54fb213-cbdd-3856-9ba2-bc8b6d7c2e27",
                    "sense_definition": "Kleines Schienenfahrzeug zum Transport von Schüttgut im Bergbau oder auf Baustellen, das oft seitlich gekippt werden kann",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Bergleute schoben die schwere <w>Lore</w> voller Kohle durch den schmalen Stollen."
                        },
                        {
                            "text": "Die Arbeiter beluden eine <w>Lore</w> mit frischem Sand für die Baustelle."
                        }
                    ],
                    "synonyms": [
                        "Güterlore",
                        "Kipplore"
                    ],
                    "common_phrases": [
