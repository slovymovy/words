                        "form": "кого́рте"
                    },
                    {
                        "form_id": "6971a6fc-d803-4a0d-ad64-c7ce7c8349d5",
                        "entry_id": "3fffdf12-6923-3bc4-9828-bccac68aae23",
                        "tags": [
                            "plural",
