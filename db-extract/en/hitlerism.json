                        "target_lang_word": "гитлери́зм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гитлери́зм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "080a3947-86e1-35f1-9d42-0de84faa6544",
                                        "entry_id": "bdf3cf51-a869-3404-a7f2-ad31e5959eac",
                                        "glosses": [
                                            "полит. национал-социалистическая диктатура в Германии, возглавлявшаяся Гитлером в 1933—1945 годах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4b3a390-9f5a-42f6-bd36-a300aa1f99b2",
                                                "sense_id": "080a3947-86e1-35f1-9d42-0de84faa6544",
                                                "text": "Для Штирлица было едино горе Минска, Бабьего Яра или Ковентри: те, кто сражался против гитлеризма, были для него братьями по оружию."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3568936b-d27f-3eb7-8e96-d59ca382d150",
                                        "entry_id": "bdf3cf51-a869-3404-a7f2-ad31e5959eac",
                                        "glosses": [
                                            "идеология такой диктатуры"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "598fc1cb-25a6-4ae0-99af-5aebc68ac511",
                                                "sense_id": "3568936b-d27f-3eb7-8e96-d59ca382d150",
                                                "text": "В полном созвучии с политическими чаяниями гитлеризма, он принялся энергично чистить государственный аппарат от веймарских демократических элементов."
                                            },
                                            {
                                                "example_id": "6fcb9449-9d88-4698-a66a-ef20939e01ac",
                                                "sense_id": "3568936b-d27f-3eb7-8e96-d59ca382d150",
                                                "text": "Гитлеризм не совместим с христианством; более того, он прямо противоположен ему."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
