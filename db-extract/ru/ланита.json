                ],
                "senses": [
                    {
                        "sense_id": "38fc7216-318f-39b6-bcca-a8b4b311eeae",
                        "entry_id": "bc758258-23af-35ab-ae93-aec1ff203b86",
                        "glosses": [
                            "устар., поэт., щека"
                        ],
                        "tags": [
                            "обычно мн. ч."
                        ],
                        "examples": [
                            {
                                "example_id": "3e7c615a-ec6f-4269-b0db-ee5511f67218",
                                "sense_id": "38fc7216-318f-39b6-bcca-a8b4b311eeae",
                                "text": "Узрело воинство плен своего повелителя, и бледность покрыла ланиты неустрашимых, мечи и копья опустились, и робкие предались бегству."
                            },
                            {
                                "example_id": "881d0550-4bbe-4f4c-a217-8ae970fcea2b",
                                "sense_id": "38fc7216-318f-39b6-bcca-a8b4b311eeae",
                                "text": "Она едва-едва коснулась моей ланиты, и рой блаженства облепил все мое естество."
                            },
                            {
                                "example_id": "bfa0d3c8-4eb4-4322-b8fd-669d9db300b0",
                                "sense_id": "38fc7216-318f-39b6-bcca-a8b4b311eeae",
                                "text": "Поцеловал он нежные ланиты ― // И краски жизни им возвращены."
                            }
                        ]
                    }
                ],
