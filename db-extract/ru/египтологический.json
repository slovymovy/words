                "senses": [
                    {
                        "sense_id": "661fc367-41a4-3eb4-aa01-4e09a5d7c70f",
                        "entry_id": "6d7f369b-aa87-3591-9bd6-7b7f90722cab",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным египтология; свойственный, характерный для египтологии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee69dd45-2fda-48ab-bb89-1c0059367836",
                                "sense_id": "661fc367-41a4-3eb4-aa01-4e09a5d7c70f",
                                "text": "Но в Петербурге в египтологическом кабинете университета знали студента Шилейко."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "102b7a8c-a4a8-48b7-92b2-d9bafdff8fb2",
                        "source_entry_id": "6d7f369b-aa87-3591-9bd6-7b7f90722cab",
                        "source_sense_id": "661fc367-41a4-3eb4-aa01-4e09a5d7c70f",
                        "target_lang_word": "Egyptological",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Egyptological",
