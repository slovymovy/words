                "senses": [
                    {
                        "sense_id": "e7ea41b8-33fe-3d23-a428-129e575bd4f5",
                        "entry_id": "e267143b-0504-3d08-8300-f348a8eb446e",
                        "glosses": [
                            "een politiek-economische ordening van de maatschappij waarin de wet van vraag en aanbod leidend is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc81ae1d-1866-4f7d-b203-1145259166c6",
                                "sense_id": "e7ea41b8-33fe-3d23-a428-129e575bd4f5",
                                "text": "Ruim 70 procent pleit voor maatregelen. Zo vindt iemand dat beleggers alleen zouden mogen kopen als er geen andere koper is, maar anderen merken op dat zoiets in onze vrijemarkteconomie uit den boze is. „Gewone kopers voorrang bieden betekent wellicht mensen dwingen een lagere prijs te accepteren voor hun huis en ik weet niet of dat juridisch haalbaar is.”"
                            },
                            {
                                "example_id": "58f7148b-3321-4a49-a425-aa7c47b8d905",
                                "sense_id": "e7ea41b8-33fe-3d23-a428-129e575bd4f5",
                                "text": "Hij was negen jaar parlementsvoorzitter en van 1989 tot 1997 president. Hij was voorstander van een vrijemarkteconomie en probeerde conflicten met de Verenigde Staten en het Westen te vermijden."
                            },
                            {
                                "example_id": "ab43c4ce-02dd-4d3b-a9ed-86f97774dafd",
                                "sense_id": "e7ea41b8-33fe-3d23-a428-129e575bd4f5",
                                "text": "De afgelopen jaren is de financiële markt langzaam getransformeerd van een vrijemarkteconomie gebaseerd op vraag en aanbod naar een centraal geleide markt die wordt gestuurd door overheden, centrale banken en multinationals."
                            }
                        ]
                    }
