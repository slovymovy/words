                        "source_sense_id": "dadd7fe0-fd03-3e16-be38-5e6861fb8589",
                        "source_sense_description": "Wirtschaft: Preis, der in einer Liste angegeben ist",
                        "target_lang_word": "catalogusprijs",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catalogusprijs",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ba3ddf46-58ea-3397-aa94-3b813f17df38",
                                        "entry_id": "c34c5c15-7a6f-35fb-9a9b-9321807536e0",
                                        "glosses": [
                                            "prijs zoals deze in een catalogus wordt vermeld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa59fa5c-3e3b-48b1-867c-fa35af266813",
                                                "sense_id": "ba3ddf46-58ea-3397-aa94-3b813f17df38",
                                                "text": "Mensen die een auto van de zaak leasen, betalen daarvoor extra belasting als ze de auto meer dan 500 kilometer per jaar privé gebruiken. Ze moeten bij de belastingaangifte een percentage van de catalogusprijs van de auto bij hun inkomen optellen. Dit wordt bijtelling genoemd. Het maakt voor de hoogte van de bijtelling dus nauwelijks uit of leaserijders heel veel of juist weinig privé rijden."
                                            },
                                            {
                                                "example_id": "308b1843-d7da-43c9-8438-cf9ca517814b",
                                                "sense_id": "ba3ddf46-58ea-3397-aa94-3b813f17df38",
                                                "text": "Een investeringsaftrekpost voor bedrijven is de slagroom op de taart. Tijdschrift Autoweek rekende uit dat een zzp'er in theorie een Prius-plug-in op de kop kan tikken voor minder dan 8.000 euro. Nog geen kwart van de catalogusprijs. \"Om er vervolgens privé in te rijden met 0 procent bijtelling. Tel uit je winst.\""
                                            }
                                        ]
                                    }
