    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8f97c232-e778-33e8-859f-43770fc122eb",
                "word": "patroness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "57430204-12de-4e64-85a0-9e2f16f23858",
                        "entry_id": "8f97c232-e778-33e8-859f-43770fc122eb",
                        "tags": [
                            "plural"
                        ],
