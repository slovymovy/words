                    {
                        "sense_id": "53384df7-ac02-3eee-9731-03fb23e8749a",
                        "entry_id": "cfd5b571-1383-34d0-ba41-e175f3e7cb71",
                        "glosses": [
                            "Act or practice of seeking a spouse of higher socioeconomic status or caste status than oneself."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "b2e5f0af-5651-4060-8733-1fa86f1f61e4",
                                "sense_id": "53384df7-ac02-3eee-9731-03fb23e8749a",
                                "text": "From 1940 to the mid-1970s, the tendency for men to marry down educationally became more pronounced and the cultural ideal of hypergamy — that women must marry up — became more insistent."
                            },
                            {
                                "example_id": "8fc9d27f-4b18-4a26-bb91-0d4210378f09",
                                "sense_id": "53384df7-ac02-3eee-9731-03fb23e8749a",
                                "text": "A lawsuit against David Geffen mentions a website where hypergamy — dating above your station — is celebrated. But the word carries darker intonations."
                            }
                        ]
                    }
                ],
