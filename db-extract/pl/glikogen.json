                "translations": [
                    {
                        "translation_id": "9a6d0003-0764-40ab-90bf-3dfdd26d3405",
                        "source_entry_id": "f012c6e3-5e90-391e-b365-0c7ab849a7e5",
                        "source_sense_id": "f2e0a397-0967-3d75-86d8-2dbbff55e3b5",
                        "target_lang_word": "glycogen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glycogen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9f05f5e-6981-344e-ae18-5f6a7722e0b6",
                                        "entry_id": "9dddb439-db3a-3a8a-9db7-c9b59198be94",
                                        "glosses": [
                                            "A polysaccharide that is the main form of carbohydrate storage in animals; converted to glucose as needed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cad596f-bbf8-44a2-b1a3-9a4294b5e9c5",
                                                "sense_id": "e9f05f5e-6981-344e-ae18-5f6a7722e0b6",
                                                "text": "Specifically the liver converts glucose into glycogen — a more compact chemical. It is a little bit like shrink-wrapping food so you can pack more of it into your freezer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06a0f636-98d3-4f8c-a566-4c114e1e3be3",
                        "source_entry_id": "f012c6e3-5e90-391e-b365-0c7ab849a7e5",
                        "source_sense_id": "f2e0a397-0967-3d75-86d8-2dbbff55e3b5",
                        "target_lang_word": "glycogène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glycogène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81fb21b8-5816-33e0-b5c1-7c3dde22303e",
                                        "entry_id": "4217dbea-d4c6-3846-baf9-857608caecc6",
                                        "glosses": [
                                            "Glucide complexe polymère du glucose."
                                        ],
                                        "tags": [
                                            "Chimie organique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d845dda7-5431-42a3-9896-4fd38f807311",
                                                "sense_id": "81fb21b8-5816-33e0-b5c1-7c3dde22303e",
                                                "text": "Le glycogéne est utilisé par les animaux pour stocker de l'énergie."
                                            },
                                            {
                                                "example_id": "1ca183ef-28d8-4aed-a184-654d23a92e7d",
                                                "sense_id": "81fb21b8-5816-33e0-b5c1-7c3dde22303e",
                                                "text": "Pendant cette période le corps peut plus rapidement convertir les glucides en glycogène musculaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
