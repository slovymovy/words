                    },
                    {
                        "translation_id": "df683f4b-0a18-4e4b-9a02-10003f5fd5c7",
                        "source_entry_id": "27007309-0b9a-3111-9327-3bb3fab034e1",
                        "source_sense_id": "b781c7ac-4275-3a66-b1d7-828290ac559c",
