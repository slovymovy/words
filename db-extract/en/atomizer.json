                                            {
                                                "example_id": "0d5d82a2-970f-4bb1-b422-330865d319a0",
                                                "sense_id": "0a7b2db5-2cc8-3e0e-9c5f-2cf83aebb5b2",
                                                "text": "Les soufreuses, boilles et pulvérisateurs ont cédé la place à l'atomiseur, à la motopompe à haute pression, au turbodiffuseur, et quand cela se peut, à l'hélicoptère."
                                            }
