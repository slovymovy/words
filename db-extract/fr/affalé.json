                ],
                "senses": [
                    {
                        "sense_id": "9cc27cde-faf1-34be-8c69-2a9c2f771ea3",
                        "entry_id": "381945cd-eb1b-3e6b-9f8d-a210872ebc9f",
                        "glosses": [
                            "Se dit d’un navire qui est poussé à la côte sans qu’il puisse s’en éloigner, étant donné sa position par rapport à cette côte et au vent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdff7a6a-a84a-404c-b993-afcdcd7e384e",
                                "sense_id": "9cc27cde-faf1-34be-8c69-2a9c2f771ea3",
                                "text": "Elle longea jusqu’à l’étrave le navire affalé."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea68de6c-e382-3266-89e6-500085604bd3",
                        "entry_id": "381945cd-eb1b-3e6b-9f8d-a210872ebc9f",
                        "glosses": [
                            "Assis, allongé, couché d’une manière totalement relâchée, négligée, détendue en parlant d’une personne ou d’un animal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33e26eb9-986b-4e0e-ad41-d2203987c204",
                                "sense_id": "ea68de6c-e382-3266-89e6-500085604bd3",
                                "text": "Vous m’avez dit : « Cette dame, peinte par Siccardi, ressemble à la mère d’André Chénier. » Je vous ai répondu : « C’est l’aïeule de mon mari. Comment était la mère d’André Chénier ? » Et vous avez dit : « On a son portrait : une Levantine affalée. »"
                            },
                            {
                                "example_id": "bef16e0c-9636-4a9f-830f-3b208bb10266",
                                "sense_id": "ea68de6c-e382-3266-89e6-500085604bd3",
                                "text": "À côté de lui, un gars affalé sur le dos boulottait une pomme en lisant des récits héroïques dans un magazine dont la couverture partait en lambeaux."
                            },
                            {
                                "example_id": "6bfe2d6a-a4c1-4f96-b721-ad1f6a26b6a8",
                                "sense_id": "ea68de6c-e382-3266-89e6-500085604bd3",
                                "text": "Il avait en effet l’air effondré ; affalé dans un fauteuil, mal rasé, le col défait, presque débraillé, il ne s’arracha pas un sourire."
                            }
                        ]
                    }
                ],
