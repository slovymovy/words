                                "target_senses": [
                                    {
                                        "sense_id": "5933d394-dc88-344b-927f-505997185e37",
                                        "entry_id": "cf061feb-63ed-3d69-b858-fc56f0d64be5",
                                        "glosses": [
                                            "50 km langer Eisenbahntunnel unter der Straße von Dover zwischen Folkestone (Vereinigtes Königreich) und Coquelles (Frankreich)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7620e461-ce16-430a-80e8-3cafb9145e00",
                                                "sense_id": "5933d394-dc88-344b-927f-505997185e37",
                                                "text": "„Der Betreiber des Eurotunnels unter dem Ärmelkanal hat erstmals einen kräftigen Gewinn gemacht.“"
                                            },
                                            {
                                                "example_id": "ac1b1205-ea82-48e4-a8d9-d17dad518177",
                                                "sense_id": "5933d394-dc88-344b-927f-505997185e37",
                                                "text": "„Das Jahrhundertbauwerk wurde nach rund achtjähriger Bauzeit fertig gestellt und ist mit 34,6 Kilometern Länge bis zur Eröffnung des Gotthard-Basistunnels 2016 der längste Eisenbahntunnel der Schweiz und nach dem Seikan-Tunnel in Japan und dem Eurotunnel zwischen Großbritannien und dem europäischen Festland der drittlängste der Welt.“"
                                            },
                                            {
                                                "example_id": "cd0f58bb-3c72-45a8-bc35-3d2ab57ed4df",
                                                "sense_id": "5933d394-dc88-344b-927f-505997185e37",
                                                "text": "„Der Eurotunnel unter dem Ärmelkanal ist zu einer wichtigen Verkehrsverbindung zwischen dem europäischen Festland und Großbritannien geworden.“"
                                            },
                                            {
                                                "example_id": "e3c17cb3-2c57-4d6f-8c56-a42d98dbc8d2",
                                                "sense_id": "5933d394-dc88-344b-927f-505997185e37",
                                                "text": "„Da der Eurotunnel als ein mögliches Ziel eines Terroranschlags gilt, sind Sicherheitskontrollen ähnlich wie beim Flugzeug vorgeschrieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
