                        "examples": [
                            {
                                "example_id": "4dd53883-1997-44b6-8ebb-464ad17e3505",
                                "sense_id": "ced32b9e-d4c4-3239-9128-c0d74d63bb6e",
                                "text": "I’ve flown in flimsy microlights, soaring serenely above rich farmland. I’ve ridden tactical combat helicopters missions, skimming the desert floor and banking hard around sand dunes."
                            },
                            {
                                "example_id": "0fc2383b-23d6-4c31-b58f-413ddfeaa725",
                                "sense_id": "ced32b9e-d4c4-3239-9128-c0d74d63bb6e",
                                "text": "Ruling in the immunity case, Chief Justice John Roberts seemed to serenely arrogate to the Court an immense power to determine whether the president might ever face criminal consequence without worrying whether the emboldening of a rampaging executive might at some point place the authority of the judiciary in danger."
                            }
                        ]
                    }
