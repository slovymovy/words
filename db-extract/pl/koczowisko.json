                ],
                "translations": [
                    {
                        "translation_id": "86793a6a-2834-4c00-bb94-b583075ee513",
                        "source_entry_id": "fd44d2dc-bdd4-3922-b38e-55b6b2c0d09d",
                        "source_sense_id": "1c932acf-4335-3d05-bc2f-deab5475fd6c",
                        "target_lang_word": "encampment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encampment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fab3212-8c42-3803-846d-ff00d18cb7f5",
                                        "entry_id": "f7ed661d-37a4-3869-ab6a-b81d4bb19e94",
                                        "glosses": [
                                            "A place where people (such as displaced people, soldiers, or travellers) encamp, that is, stay in tents or other temporary structures; a camp or campsite."
                                        ],
                                        "tags": [
                                            "countable",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99218e6e-3321-480b-8e5e-c5f66c9268c0",
                                                "sense_id": "1fab3212-8c42-3803-846d-ff00d18cb7f5",
                                                "text": "As ſoon as he came to the top of thoſe Hills he plainly diſcovered the Creek or Harbour vvhere the Pyrate Ships lay, and vvhere they had form'd their Encampment on the Shore."
                                            },
                                            {
                                                "example_id": "d7bb0a76-4713-4040-8061-9dc93a5682c3",
                                                "sense_id": "1fab3212-8c42-3803-846d-ff00d18cb7f5",
                                                "text": "One of the greatest dangers that beset the travellers in this part of their expedition, was the vast number of rattlesnakes which infested the rocks about the rapids and portages, and on which the men were in danger of treading. They were often found, too, in quantities about the encampments."
                                            },
                                            {
                                                "example_id": "c72635fb-8439-4d8d-939b-c9aaaff04361",
                                                "sense_id": "1fab3212-8c42-3803-846d-ff00d18cb7f5",
                                                "text": "[P]erhaps, had the Moors passed these gates, and reached the Christian encampment, lulled, as it was, in security and sleep, that wild army of twenty thousand desperate men might have saved Granada; and Spain might, at this day, possess the only civilised empire which the faith of Mahomet ever founded."
                                            },
                                            {
                                                "example_id": "18621b85-38b5-4411-979f-b03e77aab3e9",
                                                "sense_id": "1fab3212-8c42-3803-846d-ff00d18cb7f5",
                                                "text": "Shortly after leaving the station, the train passes the site of a small halt, built in August, 1889, to serve a large army encampment situated nearby."
                                            },
                                            {
                                                "example_id": "78cb2bda-5b73-4b19-b8a4-470055133726",
                                                "sense_id": "1fab3212-8c42-3803-846d-ff00d18cb7f5",
                                                "text": "In Mississippi, Tom turned an encampment of do-gooder burners into an organization he dubbed Burners Without Borders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "620816e7-cc9d-3cee-b0bd-7c5954e326e9",
                                        "entry_id": "f7ed661d-37a4-3869-ab6a-b81d4bb19e94",
                                        "glosses": [
                                            "A place where people or things stay temporarily."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7180f212-7c30-42ee-81d2-ebf649d0c6d7",
                                                "sense_id": "620816e7-cc9d-3cee-b0bd-7c5954e326e9",
                                                "text": "This was an ancient lobster's house, / A lobster of prodigious nous, / So old that barnacles had spread / Their white encampments o'er its head,— […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd38c66c-bcc3-3902-8067-e87780a01158",
                                        "entry_id": "f7ed661d-37a4-3869-ab6a-b81d4bb19e94",
                                        "glosses": [
                                            "An enclosed or fortified prehistoric site, especially a European Iron Age hill-fort."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7fd2c3f6-aefb-3779-9108-8d6e26858dda",
                                        "entry_id": "f7ed661d-37a4-3869-ab6a-b81d4bb19e94",
                                        "glosses": [
                                            "A meeting of Freemasons."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5bb269a-1816-39bb-8f11-969aa9292fc7",
                                        "entry_id": "f7ed661d-37a4-3869-ab6a-b81d4bb19e94",
                                        "glosses": [
                                            "The act of encamping or setting up a camp; also, the state of being encamped or in a camp."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "480fbab5-6ca3-45a4-9357-fe92c2b2b030",
                                                "sense_id": "d5bb269a-1816-39bb-8f11-969aa9292fc7",
                                                "text": "Mars Triumphant; or London's Glory: Being the whole art of encampment, with the method of embattling armies, marching them off, posting the officers, forming hollow squares, and the various ways of paying the salute with the half-pike; […]"
                                            },
                                            {
                                                "example_id": "be8fff1e-e6a6-4dcb-baf5-7ba39f7cb753",
                                                "sense_id": "d5bb269a-1816-39bb-8f11-969aa9292fc7",
                                                "text": "[F]rom the fate of vvar they vvere once more obliged to forſake culture for encampment, the ſvveets of rural life for their ſhocks of battle."
                                            },
                                            {
                                                "example_id": "12855631-e9e9-4336-8dd4-c0c265e4897b",
                                                "sense_id": "d5bb269a-1816-39bb-8f11-969aa9292fc7",
                                                "text": "The camp of a Roman legion preſented the appearance of a fortified city. […] Its form vvas an exact quadrangle; and vve may calculate, that a ſquare of about ſeven hundred yards vvas ſufficient for the encampment of tvventy thouſand Romans; though a ſimilar number of our ovvn troops vvould expoſe to the enemy a front of more than treble that extent."
                                            },
                                            {
                                                "example_id": "a183d1da-abfd-4f95-8088-e0ea5d36d2b0",
                                                "sense_id": "d5bb269a-1816-39bb-8f11-969aa9292fc7",
                                                "text": "As Carriere, the Canadian straggler did not make his appearance for two days after the encampment in the valley, two men were sent on horseback in search of him. They returned, however, without success."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
