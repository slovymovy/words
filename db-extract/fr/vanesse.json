                "senses": [
                    {
                        "sense_id": "49ad847a-c2b8-3a70-910f-962877998465",
                        "entry_id": "b80e7695-d604-320b-8868-4223d367dcd2",
                        "glosses": [
                            "Papillon de la famille des nymphalidés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2543e3be-762b-4dfd-86f1-ab2699af9ad7",
                                "sense_id": "49ad847a-c2b8-3a70-910f-962877998465",
                                "text": "Et le premier souffle chasse devant lui le bruissement de troupeaux invisibles pérégrinant quelque part au flanc bleu des alpages. Le second, le cri aigre d’un klaxon. Le troisième, une vanesse aux brillantes couleurs qui erre éperdument le long des pierres inhospitalières, danse un instant avec son ombre, et que le ciel aspire à nouveau."
                            },
                            {
                                "example_id": "15e5784c-02a3-4872-bc35-3858cebe5ef8",
                                "sense_id": "49ad847a-c2b8-3a70-910f-962877998465",
                                "text": "De grands papillons, des vanesses pénétraient par couples entre les courtines, et s’entre-poursuivaient là."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a39c5d5e-88be-4828-9024-398c1f0fb9c8",
