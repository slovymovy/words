                    {
                        "sense_id": "863a93a6-33a7-3ea4-abe1-a23dc5dcee8a",
                        "entry_id": "f93851a3-b314-3b7b-8eca-369fc7efa7d8",
                        "glosses": [
                            "groep van muzikanten die rapmuziek maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ccf97d9-c347-4b30-b216-b7616b842a03",
                                "sense_id": "863a93a6-33a7-3ea4-abe1-a23dc5dcee8a",
                                "text": "Dat binnen de opsporingsdiensten het vermoeden heerst dat wit en zwart geld rondom de artiesten makkelijk vermengd raken, is niet verwonderlijk. In een zaak tegen Barry I., de oprichter en tegenwoordig manager van rapgroep SFB (Strictly Family Business), maakte justitie die verdenking concreet."
                            },
                            {
                                "example_id": "837554c2-df05-41d8-b0f0-8eb2de2cda77",
                                "sense_id": "863a93a6-33a7-3ea4-abe1-a23dc5dcee8a",
                                "text": "Het is een morgen een spannende dag voor de jonge Almelose rapgroep Famway. Hun eerste videoclip komt uit. Rond het middaguur is de release op YouTube."
                            },
                            {
                                "example_id": "e07b9c11-e405-40ea-bb89-872bbd700d36",
                                "sense_id": "863a93a6-33a7-3ea4-abe1-a23dc5dcee8a",
                                "text": "De Nederlandse rapgroep kwam over een strook aangelopen richting het verhoogde podium, maar Willie Wartaal viel daar vanaf. \"Hij lazerde zo van 2,5 meter naar beneden, het ging echt hard\", vertelt een omstander."
                            }
                        ]
                    }
