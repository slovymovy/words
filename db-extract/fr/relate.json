                                        ]
                                    },
                                    {
                                        "sense_id": "5e7c52a2-1e32-3a0c-89a6-90a72b691dcd",
                                        "entry_id": "ba8b4985-3083-36f1-8fd3-905aaaaf8978",
                                        "glosses": [
                                            "To bring back; to restore."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fde2ddff-2339-4d05-b023-c589cfea8c48",
                                                "sense_id": "5e7c52a2-1e32-3a0c-89a6-90a72b691dcd",
                                                "text": "Abate your zealous haste, till morrow next again / Both light of heaven and strength of men relate."
