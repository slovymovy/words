                "senses": [
                    {
                        "sense_id": "ca2f331a-a0b6-3f74-ade2-2f3b99d2101f",
                        "entry_id": "5a3d4eed-0a6a-3923-820b-cac17f97aaa1",
                        "glosses": [
                            "ein im Museumsdienst oder in der Denkmalspflege (Landeskonservator) tätiger Beamter, dem die Pflege und Restaurierung von Kunstwerken untersteht."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b75ba8bb-59de-4d8f-a81d-640c1b55a3f8",
                                "sense_id": "ca2f331a-a0b6-3f74-ade2-2f3b99d2101f",
                                "text": "Die Konservatoren haben die Aufgabe, wertvolle Gegenstände vor dem Verfall zu bewahren."
                            },
                            {
                                "example_id": "06452c95-d3fc-4346-8fd9-ff129e0206ac",
                                "sense_id": "ca2f331a-a0b6-3f74-ade2-2f3b99d2101f",
                                "text": "„In der Stimme des Konservators schwingt echte Anerkennung für den mittelalterlichen Bischof Azelin mit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccca2d84-bb44-499c-8812-a52c1fc2340c",
                        "source_entry_id": "5a3d4eed-0a6a-3923-820b-cac17f97aaa1",
                        "source_sense_id": "ca2f331a-a0b6-3f74-ade2-2f3b99d2101f",
                        "target_lang_word": "conservator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conservator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7a05923-3d8e-3202-8ad2-90f1d3188de7",
                                        "entry_id": "efe74ece-0c65-3bef-8d1c-d3673b72874f",
                                        "glosses": [
                                            "One who conserves, preserves or protects something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d73ab03a-6ca7-4d10-8938-05644cd7fb1a",
                                                "sense_id": "e7a05923-3d8e-3202-8ad2-90f1d3188de7",
                                                "text": "2014, Paul Salopek, Blessed. Cursed. Claimed., National Geographic (December 2014)https://web.archive.org/web/20150212214621/http://ngm.nationalgeographic.com/2014/12/pilgrim-roads/salopek-text\nChlouveraki, a tenacious archaeological conservator, has salvaged antiquities all over the Middle East."
                                            },
                                            {
                                                "example_id": "8f808808-2d78-4543-bad0-67a408a1fcff",
                                                "sense_id": "e7a05923-3d8e-3202-8ad2-90f1d3188de7",
                                                "text": "the great Creator and Conservator of the world"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb278cbe-c6b8-3087-8858-8ae94054a5ee",
                                        "entry_id": "efe74ece-0c65-3bef-8d1c-d3673b72874f",
                                        "glosses": [
                                            "A person appointed by a court to manage the affairs of another; similar to a guardian but with some powers of a trustee."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73f09cb4-3e34-4f86-96a8-986d105895b9",
                                                "sense_id": "eb278cbe-c6b8-3087-8858-8ae94054a5ee",
                                                "text": "The lords of the secret council were likewise made conservators of the peace of the two kingdoms."
                                            },
                                            {
                                                "example_id": "62a9f27b-4655-42a6-8df2-32335421edd1",
                                                "sense_id": "eb278cbe-c6b8-3087-8858-8ae94054a5ee",
                                                "text": "The Governor [of Missouri] is […] the conservator of the peace"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03b01946-f119-3073-9e6e-1af36e142165",
                                        "entry_id": "efe74ece-0c65-3bef-8d1c-d3673b72874f",
                                        "glosses": [
                                            "An officer in charge of preserving the public peace, such as a justice or sheriff."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b4d71a0-26bc-3728-848d-412f65294b1e",
                                        "entry_id": "efe74ece-0c65-3bef-8d1c-d3673b72874f",
                                        "glosses": [
                                            "A judge delegated by the pope to defend certain privileged classes of persons from manifest or notorious injury or violence, without recourse to a judicial process."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c393101f-59c7-35e1-8c5d-cbdf7045e3a8",
                                        "entry_id": "efe74ece-0c65-3bef-8d1c-d3673b72874f",
                                        "glosses": [
                                            "A professional who works on the conservation and restoration of objects, particularly artistic objects."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02fbbd1e-9491-41ea-993c-a32d34ea98b2",
                        "source_entry_id": "5a3d4eed-0a6a-3923-820b-cac17f97aaa1",
                        "source_sense_id": "ca2f331a-a0b6-3f74-ade2-2f3b99d2101f",
                        "target_lang_word": "restaurateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "restaurateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "363be921-875e-3898-ac84-6056a295efb5",
                                        "entry_id": "0045172c-5621-3cbc-a083-de0eb451b672",
                                        "glosses": [
                                            "Celui qui répare, qui rétablit."
                                        ],
                                        "tags": [],
                                        "note": "Il s’emploie surtout au figuré et ne se dit guère, au sens propre, qu’en parlant des villes, des monuments publics ou des œuvres d’art",
                                        "examples": [
                                            {
                                                "example_id": "b9fd7768-845f-4c23-8f09-ae532e3c59ba",
                                                "sense_id": "363be921-875e-3898-ac84-6056a295efb5",
                                                "text": "Après avoir enlevé la bronzine pour la remplacer par de la dorure, les restaurateurs découvrent la polychromie originelle."
                                            },
                                            {
                                                "example_id": "4161944c-80c8-44e7-a6ff-bb714016d8dc",
                                                "sense_id": "363be921-875e-3898-ac84-6056a295efb5",
                                                "text": "Avec ses recettes, Lamberti est devenu le patriarche des restaurateurs de peinture."
                                            },
                                            {
                                                "example_id": "d46fdc80-b380-4cd8-8abb-4b6d793c8fc6",
                                                "sense_id": "363be921-875e-3898-ac84-6056a295efb5",
                                                "text": "[…] un petit vieillard vêtu d’une houppelande […] surveillait son restaurateur, un peintre occupé à réparer des tableaux."
                                            },
                                            {
                                                "example_id": "e553d5bb-ac4f-4924-a4d1-2002be72af68",
                                                "sense_id": "363be921-875e-3898-ac84-6056a295efb5",
                                                "text": "Voilà l'ancien révolutionnaire, député de la Convention sous Robespierre, enrôlé sous la bannière de l’auteur du coup d’État du 2 décembre, restaurateur d'une monarchie !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8841286f-de29-3e5a-84e9-87f998f9d64d",
                                        "entry_id": "0045172c-5621-3cbc-a083-de0eb451b672",
                                        "glosses": [
                                            "Celui qui tient un restaurant, s’occupe de le gérer ou préparer les repas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "162063de-6602-4383-9ebe-1ca77f9051f3",
                                                "sense_id": "8841286f-de29-3e5a-84e9-87f998f9d64d",
                                                "text": "Trévise, quant à elle, est formelle, c’est à la signora Alba, épouse du restaurateur Campeol, que revient la conception, dans les années 1960, de l’actuel tiramisu : la finaude sut transformer une erreur, du mascarpone versé par inadvertance dans un sabayon, en recette miraculeuse enrichie au cacao et au café."
                                            }
                                        ]
                                    }
                                ]
                            },
