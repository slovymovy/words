{
    "word_family": [
        "dignify",
        "dignified",
        "dignitary"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "39dbc146-e63b-3015-9882-ba49de1dc384",
                    "sense_definition": "The quality of being worthy of honor, respect, or esteem.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "quality_worth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every person deserves to be treated with <w>dignity</w> and respect.",
                            "target_lang_translations": {
                                "ru": "Каждый человек заслуживает, чтобы к нему относились с <w>достоинством</w> и уважением.",
                                "de": "Jeder Mensch verdient es, mit <w>Würde</w> und Respekt behandelt zu werden."
                            }
                        },
                        {
                            "text": "She lost her home, but she never lost her <w>dignity</w>.",
                            "target_lang_translations": {
                                "ru": "Она лишилась дома, но так и не потеряла своего <w>достоинства</w>.",
                                "de": "Sie verlor ihr Zuhause, aber sie verlor nie ihre <w>Würde</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "worth",
                        "worthiness"
                    ],
                    "common_phrases": [
                        "human dignity",
                        "with dignity",
                        "beneath one's dignity",
                        "loss of dignity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество, делающее кого-либо достойным чести, уважения или почтения.",
                        "de": "Die Eigenschaft, Ehre, Respekt oder Wertschätzung zu verdienen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достоинство",
                                "target_lang_sense_clarification": "самоуважение, моральная ценность"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Würde",
                                "target_lang_sense_clarification": "moralischer Wert und Selbstachtung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ca91e28-f90e-3b89-a579-2297a0e548e3",
                    "sense_definition": "A serious, calm, and controlled manner or behavior that commands respect.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He accepted the award with quiet <w>dignity</w>.",
                            "target_lang_translations": {
                                "ru": "Он принял награду со спокойным <w>достоинством</w>.",
                                "de": "Er nahm die Auszeichnung mit stiller <w>Würde</w> entgegen."
                            }
                        },
                        {
                            "text": "The old building still possesses an air of <w>dignity</w> despite its age.",
                            "target_lang_translations": {
                                "ru": "Старое здание всё ещё сохраняет вид, полный <w>достоинства</w>, несмотря на свой возраст.",
                                "de": "Das alte Gebäude besitzt trotz seines Alters immer noch eine gewisse <w>Würde</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quiet dignity",
                        "air of dignity",
                        "maintain dignity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Серьезная, спокойная и сдержанная манера поведения, вызывающая уважение.",
                        "de": "Eine ernste, ruhige und kontrollierte Art oder Verhaltensweise, die Respekt einflößt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достоинство",
                                "target_lang_sense_clarification": "манера держаться, благородство"
                            },
                            {
                                "target_lang_word": "величавость",
                                "target_lang_sense_clarification": "внешнее величие"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Würde",
                                "target_lang_sense_clarification": "gehobene, respektvolle Haltung"
                            },
                            {
                                "target_lang_word": "Erhabenheit",
                                "target_lang_sense_clarification": "majestätische, beeindruckende Ausstrahlung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fc22a13-9cc9-3e42-b66b-7b32be4fd729",
                    "sense_definition": "A high rank, office, or position.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "rank_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king bestowed a new <w>dignity</w> upon the loyal knight.",
                            "target_lang_translations": {
                                "ru": "Король пожаловал верному рыцарю новый <w>титул</w>.",
                                "de": "Der König verlieh dem treuen Ritter eine neue <w>Würde</w>."
                            }
                        },
                        {
                            "text": "He rose to a position of great <w>dignity</w> within the government.",
                            "target_lang_translations": {
                                "ru": "Он поднялся до положения высокого <w>ранга</w> в правительстве.",
                                "de": "Er stieg innerhalb der Regierung in eine Position von großer <w>Würde</w> auf."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокий ранг, должность или положение.",
                        "de": "Ein hoher Rang, ein Amt oder eine offizielle Stellung."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сан",
                                "target_lang_sense_clarification": "высокий чин, часто духовный"
                            },
                            {
                                "target_lang_word": "звание",
                                "target_lang_sense_clarification": "титул, ранг"
                            },
                            {
                                "target_lang_word": "титул",
                                "target_lang_sense_clarification": "почетное звание"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Amt",
                                "target_lang_sense_clarification": "offizielle Stellung oder Funktion"
                            },
                            {
                                "target_lang_word": "Würde",
                                "target_lang_sense_clarification": "hoher Rang oder Titel (gehoben)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3cf60dd-b469-35c7-934d-2df491cb5a2e",
                    "sense_definition": "A person holding a high rank or office; a dignitary.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person_rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>dignities</w> gathered in the hall for the ceremony.",
                            "target_lang_translations": {
                                "ru": "Местные <w>сановники</w> собрались в зале на церемонию.",
                                "de": "Die örtlichen <w>Würdenträger</w> versammelten sich für die Zeremonie im Saal."
                            }
                        },
                        {
                            "text": "He spoke respectfully to the assembled <w>dignities</w> of the church.",
                            "target_lang_translations": {
                                "ru": "Он почтительно говорил с собравшимися церковными <w>иерархами</w>.",
                                "de": "Er sprach respektvoll zu den versammelten <w>Würdenträgern</w> der Kirche."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Modern usage prefers 'dignitary'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, занимающее высокий ранг или должность; сановник.",
                        "de": "Eine Person, die einen hohen Rang oder ein Amt innehat; ein Würdenträger."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сановник",
                                "target_lang_sense_clarification": "высокопоставленное лицо"
                            },
                            {
                                "target_lang_word": "высокопоставленное лицо",
                                "target_lang_sense_clarification": "официальное лицо"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Würdenträger",
                                "target_lang_sense_clarification": "Person in hoher offizieller Position"
                            },
                            {
                                "target_lang_word": "Amtsträger",
                                "target_lang_sense_clarification": "Person, die ein öffentliches Amt bekleidet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "978cd10a-729c-3488-9014-ec37f601606e",
                    "sense_definition": "A fundamental principle, axiom, or maxim.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "principle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher based his arguments on ancient <w>dignities</w>.",
                            "target_lang_translations": {
                                "ru": "Философ основывал свои аргументы на древних <w>аксиомах</w>.",
                                "de": "Der Philosoph stützte seine Argumente auf antike <w>Prinzipien</w>."
                            }
                        },
                        {
                            "text": "In that era, scientific <w>dignities</w> were rarely questioned by students.",
                            "target_lang_translations": {
                                "ru": "В ту эпоху научные <w>принципы</w> редко подвергались сомнению студентами.",
                                "de": "In jener Ära wurden wissenschaftliche <w>Prinzipien</w> von Studenten selten infrage gestellt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Historical or technical usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фундаментальный принцип, аксиома или максима.",
                        "de": "Ein grundlegendes Prinzip, Axiom oder eine Maxime."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аксиома",
                                "target_lang_sense_clarification": "неоспоримая истина"
                            },
                            {
                                "target_lang_word": "принцип",
                                "target_lang_sense_clarification": "основополагающее правило"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Prinzip",
                                "target_lang_sense_clarification": "grundlegende Regel oder Leitsatz"
                            },
                            {
                                "target_lang_word": "Axiom",
                                "target_lang_sense_clarification": "als wahr anerkannter Grundsatz"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}