                    "examples": [
                        {
                            "text": "Zij hebben een nieuw huis gekocht in de Zwolse wijk <w>Geren</w>.",
                            "target_lang_translations": {
                                "en": "They bought a new house in the Zwolle district of <w>Geren</w>."
