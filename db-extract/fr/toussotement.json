                ],
                "senses": [
                    {
                        "sense_id": "7f40362c-f9d3-329a-8f0e-9e6ba2cec27d",
                        "entry_id": "36ad9b1d-dfba-3b70-be11-fa288c10f6fb",
                        "glosses": [
                            "Action de toussoter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1900982a-90ec-4a1e-ab97-77d72dd323e6",
                                "sense_id": "7f40362c-f9d3-329a-8f0e-9e6ba2cec27d",
                                "text": "Le moindre toussotement résonnait sous le ciel comme sous un cloître."
                            },
                            {
                                "example_id": "fa8d98d4-dbe1-4192-a5d4-0993f8f57c16",
                                "sense_id": "7f40362c-f9d3-329a-8f0e-9e6ba2cec27d",
                                "text": "De petits oiseaux roux étaient perchés sur les pieux des claies qui jalonnaient le chemin. Ils surveillaient la jeune fille. Une fois, elle s’arrêta. Celui devant lequel elle fit halte s’envola, avec un mince cri, semblable à un toussotement."
                            },
                            {
                                "example_id": "df7bb646-dbe7-47f3-8bf8-8613974f3fd0",
                                "sense_id": "7f40362c-f9d3-329a-8f0e-9e6ba2cec27d",
                                "text": "Il se fit dans l’assistance comme un frémissement d’attention, et des toussotements çà et là s’étouffèrent dans l’ombre."
                            }
                        ]
                    }
                ],
