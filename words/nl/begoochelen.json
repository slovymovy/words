                {
                    "sense_id": "78cd00ba-5569-327a-999f-a9359678fb09",
                    "sense_definition": "Iemand misleiden of verblinden, zodat die in een waan/illusie gaat geloven.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "misleiden en verblinden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij liet zich niet <w>begoochelen</w> door alle schone praat en stelde een paar harde vragen.",
                            "target_lang_translations": {
                                "en": "He did not let himself be <w>beguiled</w> by all the smooth talk and asked a few tough questions."
                            }
                        },
                        {
                            "text": "Laat je niet <w>begoochelen</w> door mooie cijfers; kijk ook naar de voorwaarden.",
                            "target_lang_translations": {
                                "en": "Don't let yourself be <w>dazzled</w> by pretty figures; look at the terms and conditions as well."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedriegen"
                    ],
                    "common_phrases": [
                        "zich laten begoochelen",
                        "niet laten begoochelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "vooral literair"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To mislead or dazzle someone so that they believe in a delusion or illusion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to beguile",
                                "target_lang_sense_clarification": "to charm or enchant someone, sometimes in a deceptive way"
                            },
                            {
                                "target_lang_word": "to dazzle",
                                "target_lang_sense_clarification": "to impress someone so much that they are unable to think clearly"
                            },
                            {
                                "target_lang_word": "to delude",
                                "target_lang_sense_clarification": "to impose a misleading belief upon someone; deceive"
                            },
                            {
                                "target_lang_word": "to bewitch",
                                "target_lang_sense_clarification": "to cast a spell over or enchant someone"
                            }
                        ]
                    }
                }
            ]
        }
    ]
