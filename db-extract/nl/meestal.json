                                    {
                                        "sense_id": "6fbf7c1b-92ab-3c27-b719-11bd5114bbcc",
                                        "entry_id": "74896cec-338e-335e-b25a-72c38322722a",
                                        "glosses": [
                                            "in der Regel; fast immer, sehr oft, am häufigsten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f3bb61d-89ae-494c-93e5-54a7cdb12045",
                                                "sense_id": "6fbf7c1b-92ab-3c27-b719-11bd5114bbcc",
                                                "text": "Nachts schlafe ich meistens."
                                            },
                                            {
                                                "example_id": "c21ceef1-7dd3-47f4-8bd2-84e0dbfff6e3",
                                                "sense_id": "6fbf7c1b-92ab-3c27-b719-11bd5114bbcc",
                                                "text": "Im Winter ist es meistens kalt, nur in diesem Jahr nicht."
                                            },
                                            {
                                                "example_id": "6f863490-db69-4f71-9f34-db02ba104e69",
                                                "sense_id": "6fbf7c1b-92ab-3c27-b719-11bd5114bbcc",
                                                "text": "Meistens steht er zeitig auf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
