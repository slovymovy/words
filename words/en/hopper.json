{
    "word_family": [
        "hop",
        "hopping",
        "hopscotch"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e27a309b-518e-36c6-adf1-fd58b36d4d14",
                    "sense_definition": "A person or animal that <w>hops</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little rabbit is a fast <w>hopper</w> that can disappear into the bushes in seconds.",
                            "target_lang_translations": {
                                "ru": "Маленький кролик — быстрый <w>прыгун</w>, который может исчезнуть в кустах за считанные секунды."
                            }
                        },
                        {
                            "text": "The children watched the energetic <w>hopper</w> as it jumped across the playground.",
                            "target_lang_translations": {
                                "ru": "Дети наблюдали за энергичным <w>прыгуном</w>, когда тот скакал по игровой площадке."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или животное, которое прыгает."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прыгун",
                                "target_lang_sense_clarification": "тот, кто совершает прыжки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6710aa5e-8845-3190-86a5-5b20ca4f9634",
                    "sense_definition": "A container for loose material, such as grain or coal, that is typically funnel-shaped and empties from the bottom.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer poured the grain into the large <w>hopper</w> to feed the processing machine.",
                            "target_lang_translations": {
                                "ru": "Фермер засыпал зерно в большой <w>бункер</w>, чтобы подать его в перерабатывающую машину."
                            }
                        },
                        {
                            "text": "Make sure the storage <w>hopper</w> is clean before you add the new batch of plastic pellets.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что накопительный <w>бункер</w> чист, прежде чем добавлять новую партию пластиковых гранул."
                            }
                        }
                    ],
                    "synonyms": [
                        "feedbin",
                        "feeder"
                    ],
                    "common_phrases": [
                        "storage hopper",
                        "grain hopper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Контейнер для сыпучих материалов, таких как зерно или уголь, обычно воронкообразной формы, который опорожняется снизу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бункер",
                                "target_lang_sense_clarification": "для сыпучих материалов"
                            },
                            {
                                "target_lang_word": "загрузочная воронка",
                                "target_lang_sense_clarification": "конусообразная емкость"
                            },
                            {
                                "target_lang_word": "хоппер",
                                "target_lang_sense_clarification": "технический термин для емкости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53c35cf3-8e7e-3389-bbf2-873e17138d1f",
                    "sense_definition": "A thin, bowl-shaped Sri Lankan pancake made from fermented rice flour and coconut milk.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ordered an egg <w>hopper</w> for breakfast at the local Sri Lankan restaurant.",
                            "target_lang_translations": {
                                "ru": "Мы заказали <w>хоппер</w> с яйцом на завтрак в местном шри-ланкийском ресторане."
                            }
                        },
                        {
                            "text": "The chef prepared a fresh <w>hopper</w> by swirling the batter in a small, deep pan.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил свежий <w>хоппер</w>, вращая тесто в маленькой глубокой сковороде."
                            }
                        }
                    ],
                    "common_phrases": [
                        "egg hopper",
                        "string hopper"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Sri Lanka"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий чашеобразный шри-ланкийский блин из ферментированной рисовой муки и кокосового молока."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хоппер",
                                "target_lang_sense_clarification": "блюдо шри-ланкийской кухни"
                            },
                            {
                                "target_lang_word": "аппам",
                                "target_lang_sense_clarification": "другое название этого блюда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edda00f3-ba18-3d80-8ccd-8810c76cbfb1",
                    "sense_definition": "An insect that moves by jumping, especially a grasshopper or a locust.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was full of every kind of <w>hopper</w> during the hot summer months.",
                            "target_lang_translations": {
                                "ru": "В жаркие летние месяцы сад был полон всевозможных <w>кузнечиков</w>."
                            }
                        },
                        {
                            "text": "A green <w>hopper</w> landed on the leaf and stayed perfectly still.",
                            "target_lang_translations": {
                                "ru": "Зеленый <w>кузнечик</w> сел на лист и замер."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Насекомое, которое передвигается прыжками, особенно кузнечик или саранча."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кузнечик",
                                "target_lang_sense_clarification": "прыгающее насекомое"
                            },
                            {
                                "target_lang_word": "прыгающее насекомое",
                                "target_lang_sense_clarification": "общее описание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66736c6d-fd97-3ac8-9e9c-6742e647d979",
                    "sense_definition": "A freight car with a floor sloping to one or more gates for discharging its load by gravity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long train consisted mostly of a <w>hopper</w> car carrying coal to the power plant.",
                            "target_lang_translations": {
                                "ru": "Длинный состав состоял в основном из <w>вагонов-хопперов</w>, перевозивших уголь на электростанцию."
                            }
                        },
                        {
                            "text": "Workers opened the bottom of the <w>hopper</w> to let the gravel fall onto the tracks.",
                            "target_lang_translations": {
                                "ru": "Рабочие открыли дно <w>хоппера</w>, чтобы гравий высыпался на пути."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hopper car"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грузовой вагон с полом, наклоненным к одному или нескольким люкам для разгрузки груза под действием силы тяжести."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хоппер",
                                "target_lang_sense_clarification": "тип железнодорожного вагона"
                            },
                            {
                                "target_lang_word": "вагон-хоппер",
                                "target_lang_sense_clarification": "саморазгружающийся вагон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbd75824-cb71-3d07-bde0-6a66be0adfef",
                    "sense_definition": "A slang or informal term for a toilet.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "bathroom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was sitting on the <w>hopper</w> when he heard a strange noise in the hallway.",
                            "target_lang_translations": {
                                "ru": "Он сидел на <w>толчке</w>, когда услышал странный шум в коридоре."
                            }
                        },
                        {
                            "text": "The plumber had to fix the leak coming from the base of the <w>hopper</w>.",
                            "target_lang_translations": {
                                "ru": "Сантехнику пришлось устранять течь у основания <w>унитаза</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое или неформальное обозначение туалета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толчок",
                                "target_lang_sense_clarification": "сленг для туалета"
                            },
                            {
                                "target_lang_word": "сортир",
                                "target_lang_sense_clarification": "грубо-просторечное"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "867eac4e-1f2b-3786-9e29-f48bf254736b",
                    "sense_definition": "A common English <w>surname</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Edward <w>Hopper</w> was a famous American painter known for his realistic depictions of urban life.",
                            "target_lang_translations": {
                                "ru": "Эдвард <w>Хоппер</w> был известным американским художником, известным своими реалистичными изображениями городской жизни."
                            }
                        },
                        {
                            "text": "The <w>Hopper</w> family has lived in this town for over three generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Хоппер</w> живет в этом городе уже более трех поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенная английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хоппер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55675c88-7270-309b-862a-afa1b1102e27",
                    "sense_definition": "The name of several small unincorporated communities in the United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small community of <w>Hopper</w> is located in Henderson County, Illinois.",
                            "target_lang_translations": {
                                "ru": "Небольшая община <w>Хоппер</w> расположена в округе Хендерсон, штат Иллинойс."
                            }
                        },
                        {
                            "text": "They drove through <w>Hopper</w> while exploring the rural roads of West Virginia.",
                            "target_lang_translations": {
                                "ru": "Они проезжали через <w>Хоппер</w>, исследуя сельские дороги Западной Вирджинии."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название нескольких небольших невключенных общин в США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хоппер",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}