                    }
                ],
                "translations": [
                    {
                        "translation_id": "924d1eee-644a-46b1-9f05-a9d7a1e4d74e",
                        "source_entry_id": "8d9a6a9d-7951-3636-aaa7-31fb3bc79e90",
                        "source_sense_id": "14d51efa-986a-315a-91e9-c0bbfd039159",
                        "source_sense_description": "veraltet, Luftfahrt: Flughafen",
                        "target_lang_word": "Flughafen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flughafen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e616656-1c82-342d-babc-9ecd0a36fbf6",
                                        "entry_id": "cb08544a-94cc-3634-a6b5-15e681a5645e",
                                        "glosses": [
                                            "Start- und Landeplatz für Flugzeuge"
                                        ],
                                        "tags": [
                                            "Luftfahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcf4f702-00a0-44b5-ad80-b6fd116df033",
                                                "sense_id": "3e616656-1c82-342d-babc-9ecd0a36fbf6",
                                                "text": "Für uns am nächsten ist der Flughafen Hannover."
                                            },
                                            {
                                                "example_id": "63f17b9e-f913-4e4d-bb26-678335c86df1",
                                                "sense_id": "3e616656-1c82-342d-babc-9ecd0a36fbf6",
                                                "text": "„Gustav würde sie bis zur Bahnstation bringen, von wo sie mit dem Zug zum Flughafen fahren konnten.“"
                                            },
                                            {
                                                "example_id": "316caf90-ee66-4728-8274-3f73889d5e2d",
                                                "sense_id": "3e616656-1c82-342d-babc-9ecd0a36fbf6",
                                                "text": "„Überall auf den Flughäfen protestierten Zehntausende gegen das Einreiseverbot für Menschen aus sieben vorwiegend muslimischen Ländern.“"
                                            },
                                            {
                                                "example_id": "27b9d8e7-1fe9-4b05-b685-ba2837a69482",
                                                "sense_id": "3e616656-1c82-342d-babc-9ecd0a36fbf6",
                                                "text": "„Nicht nur die Städte sind größer geworden, auch der Flughafen in Keflavík ist gewachsen.“"
                                            },
                                            {
                                                "example_id": "df05f6e3-cc29-4f60-bfc2-7e326d52f1fd",
                                                "sense_id": "3e616656-1c82-342d-babc-9ecd0a36fbf6",
                                                "text": "„Es begann in Kastrup, dem Flughafen außerhalb von Kopenhagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
