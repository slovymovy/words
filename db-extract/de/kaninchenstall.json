                            {
                                "example_id": "32c8eebe-7573-483b-946f-95ce26f3091c",
                                "sense_id": "f3c24a20-64a4-3817-8852-fcb98ecd1cbd",
                                "text": "„Die Perle stand am Kaninchenstall und hatte einen Finger durchs Gitter gesteckt, an dem ein weißes Kaninchen schnupperte.“"
