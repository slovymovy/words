                        "glosses": [
                            "Enlever l’albumine de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bddfd1a8-613d-4709-a941-afc795410c3c",
                                "sense_id": "bbf60081-5842-3d92-b515-f3b3b4148db1",
                                "text": "Mac Lean au fond dans sa technique ne modifie que d’une façon minime celle de Bang, remplaçant, pour désalbuminer, le chlorure de potassium par l’hydrate de fer colloïdal."
                            },
                            {
                                "example_id": "7c305910-8c4a-4925-bd92-a20bbfae5dbb",
                                "sense_id": "bbf60081-5842-3d92-b515-f3b3b4148db1",
                                "text": "Nous avons opéré nos dosages sur le liquide désalbuminé à l’acide trichloracétique et soigneusement neutralisé par le carbonate de lithine pur."
                            }
                        ]
                    }
