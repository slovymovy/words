                            "accusative",
                            "singular"
                        ],
                        "form": "den Günstling"
                    },
                    {
                        "form_id": "87c780ee-40e4-45d3-99cc-bad4cf97a453",
                        "entry_id": "96089c1d-e8f2-3c5b-a408-e4c51f91780d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Günstlinge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d86c6d0-453f-3e61-8378-6aa96268ad6f",
                        "entry_id": "96089c1d-e8f2-3c5b-a408-e4c51f91780d",
                        "glosses": [
                            "jemand, der wohlwollend von jemand anderem behandelt und bevorzugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22e2432c-cb83-4f36-98b9-6f397440442b",
                                "sense_id": "3d86c6d0-453f-3e61-8378-6aa96268ad6f",
                                "text": "„Aber unter seinen Günstlingen war auch nicht ein wirklich tüchtiger Mensch.“"
                            },
                            {
                                "example_id": "97dcb056-7b8a-4dfe-ade7-b67abd734f60",
                                "sense_id": "3d86c6d0-453f-3e61-8378-6aa96268ad6f",
                                "text": "„Zuspruch sucht der verwaiste König bei Günstlingen.“"
                            },
                            {
                                "example_id": "30bafdd7-3b28-46d5-aa07-e226441e107d",
                                "sense_id": "3d86c6d0-453f-3e61-8378-6aa96268ad6f",
                                "text": "„Noch in der Hauptstadt hatte der Haushalter Di-Tjän dem Musterprüfling Zai mitgeteilt, daß in Klarenfluß ein Tausendschaftsführer und Günstling seiner Durchlaucht namens Simen lebe, der einer bedeutenden, reichen und wohlgesitteten Familie angehöre.“"
                            },
                            {
                                "example_id": "f3ebd9a7-26e9-4bec-a1cf-2dca6f63cf2a",
                                "sense_id": "3d86c6d0-453f-3e61-8378-6aa96268ad6f",
                                "text": "„Nachdem ich Zeuge dieser Szenen gewesen und der Senator mich mit diesem Gespräch beehrt hatte, wurde ich sein Günstling.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "994f042c-82f4-4901-acae-248bb8d9d689",
                        "source_entry_id": "96089c1d-e8f2-3c5b-a408-e4c51f91780d",
                        "source_sense_id": "3d86c6d0-453f-3e61-8378-6aa96268ad6f",
                        "source_sense_description": "jemand, der wohlwollend von jemand anderem behandelt und bevorzugt wird",
                        "target_lang_word": "protégé",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protégé",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f2826de-6242-3fdf-b244-15236b4e7bab",
                                        "entry_id": "66bbdee9-c42e-36d2-894f-654816c70d8d",
                                        "glosses": [
                                            "A person who is guided and supported by an older and more experienced person (a protector or mentor)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2261276f-497c-48d1-8abb-fc5e721e35d3",
                                                "sense_id": "3f2826de-6242-3fdf-b244-15236b4e7bab",
                                                "text": "His status as a protégé of the great artist had many benefits, but was ultimately a burden."
                                            },
                                            {
                                                "example_id": "2a742b8f-cd12-4edd-8915-f63c2388c0c1",
                                                "sense_id": "3f2826de-6242-3fdf-b244-15236b4e7bab",
                                                "text": "While Yau was in China, he visited Xi-Ping Zhu, a protégé of his who was now chairman of the mathematics department at Sun Yat-sen University."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
