                        ],
                        "examples": [
                            {
                                "example_id": "b992acd7-aa53-48f5-94c7-4fdee5776e8e",
                                "sense_id": "dc6f4295-5554-3a95-b25f-c03d6c38db46",
                                "text": "Der Prisenoffizier war ein früherer Mit-Einjähriger von 1,92 Meter Höhe, dem ich zufällig auf einem Dock begegnete. Auf meine Frage: »Willst du mit?« meinte er: »Ist es ein Himmelfahrtskommando?« »Ja!« »Da mache ich mit. Pries heiße ich und Prisen brauchst du, da bin ich doch der Richtige.«"
                            }
                        ]
                    },
