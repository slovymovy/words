                        ],
                        "zh": [
                            {
                                "target_lang_word": "最少",
                                "target_lang_sense_clarification": "数量上的最少"
                            },
                            {
                                "target_lang_word": "最小",
                                "target_lang_sense_clarification": "程度或规模上的最小"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b6697e9a-ea9e-3ce9-bdbc-17f37d3ab0b5",
                    "sense_definition": "Superlative form of <w>little</w>: smallest in size, extent, or significance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lowest_degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I haven't the <w>least</w> idea where she went.",
                            "target_lang_translations": {
                                "ru": "У меня нет ни <w>малейшего</w> представления, куда она пошла.",
                                "zh": "我<w>丝毫</w>不知道她去了哪里。"
                            }
                        },
                        {
                            "text": "Even the <w>least</w> noise wakes the baby up at night.",
                            "target_lang_translations": {
                                "ru": "Даже <w>малейший</w> шум будит ребенка ночью.",
                                "zh": "晚上即使是<w>丝毫</w>的响动也会把婴儿吵醒。"
                            }
                        }
                    ],
                    "synonyms": [
                        "smallest",
                        "slightest",
                        "tiniest"
                    ],
                    "antonyms": [
                        "most"
                    ],
                    "common_phrases": [
