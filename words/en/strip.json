                    "target_lang_definitions": {
                        "ru": "Длинный узкий участок земли или определенная узкая территория.",
                        "zh": "长而窄的土地或特定区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полоса",
                                "target_lang_sense_clarification": "узкий участок земли"
                            },
                            {
                                "target_lang_word": "клочок",
                                "target_lang_sense_clarification": "маленький узкий участок земли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地带",
                                "target_lang_sense_clarification": "长条形的区域"
                            },
                            {
                                "target_lang_word": "狭长地块",
                                "target_lang_sense_clarification": "狭窄的土地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9dc2535a-5cd3-3826-9993-d03e1355577e",
                    "sense_definition": "A sequence of drawings in a newspaper or magazine that tells a story.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I always read the comic <w>strip</w> in the Sunday newspaper.",
