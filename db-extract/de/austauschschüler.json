                "senses": [
                    {
                        "sense_id": "802ec5b2-64f5-3a06-ac59-2ab980b9aea2",
                        "entry_id": "a9902a3d-0c77-3adc-95be-61952a675933",
                        "glosses": [
                            "Élève d'échange."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "812dc7f1-c3d1-46dd-8c9c-fe0d6aff5562",
                                "sense_id": "802ec5b2-64f5-3a06-ac59-2ab980b9aea2",
                                "text": "Als ich 16 Jahre alt war, habe ich zwei Wochen lang als Austauschschüler bei einer französischen Gastfamilie gelebt und ein französisches Gymnasium besucht.",
                                "translation": "Quand j'avais 16 ans, j'ai vécu, en tant qu'élève d'échange, pendant deux semaines dans une famille d'accueil française et fréquenté un lycée français."
                            },
                            {
                                "example_id": "e2020ec1-4ae9-4f4c-829b-bf36d710c6b6",
                                "sense_id": "802ec5b2-64f5-3a06-ac59-2ab980b9aea2",
                                "text": "Die Gasteltern haben den Austauschschüler sehr gut aufgenommen.",
                                "translation": "Les parents de la famille d’accueil ont très bien accueilli l'élève d'échange."
                            }
                        ]
                    }
                ],
