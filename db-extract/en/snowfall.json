                "senses": [
                    {
                        "sense_id": "97a335ea-f377-3920-8713-1b69a6ee2173",
                        "entry_id": "078d9110-6436-3abd-8ba2-91fd8c0b5574",
                        "glosses": [
                            "der Umstand, dass Schnee fällt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a4ef17e-1c56-401d-9400-3e014947017f",
                                "sense_id": "97a335ea-f377-3920-8713-1b69a6ee2173",
                                "text": "A huge early season storm began to develop over the Great Basin on the 10th and snowfall spread through the Idaho mountains and into Montana."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7edddc9c-349a-3abc-806b-edf8f78a59f4",
                        "entry_id": "078d9110-6436-3abd-8ba2-91fd8c0b5574",
                        "glosses": [
                            "die Menge an Schnee, die zu einer gewissen Zeit fiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b863451d-ec68-44a7-838f-42b7bf446c50",
                                "sense_id": "7edddc9c-349a-3abc-806b-edf8f78a59f4",
                                "text": "An average year in Milwaukee sees 34.81 inches (884.2 mm) of precipitation, with a yearly average snowfall of 47.0 inches (119 cm)."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9de795d-f13e-42ec-8174-5c0848b129e7",
                        "source_entry_id": "078d9110-6436-3abd-8ba2-91fd8c0b5574",
                        "source_sense_id": "97a335ea-f377-3920-8713-1b69a6ee2173",
                        "source_sense_description": "der Umstand, dass Schnee fällt",
                        "target_lang_word": "Schneefall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schneefall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a92a9e53-da8c-3db0-a4c9-ed4e7e5a4b07",
                                        "entry_id": "e1104ca8-b6a1-3b13-a10e-b4846be9ac90",
                                        "glosses": [
                                            "das Herabfallen von Schnee, Niederschlag in Form von Schnee"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8375111c-923c-4c99-834b-95f6d34a81cf",
                                                "sense_id": "a92a9e53-da8c-3db0-a4c9-ed4e7e5a4b07",
                                                "text": "„Kaum war der Zug über die Vorstädte und die kleinen Villenorte hinausgeflogen, so setzte ein leichter, allmählich dichter werdender Schneefall ein, so daß Wald, Hügel, Landstraße und Dächer bald in einem linden, herzberuhigenden Weiß schimmerten.“"
                                            },
                                            {
                                                "example_id": "f403320a-fcdf-462b-af78-1ae27dd5d4be",
                                                "sense_id": "a92a9e53-da8c-3db0-a4c9-ed4e7e5a4b07",
                                                "text": "„Interessant sind aber Wochenschaueinblendungen, die den mit der Hakenkreuzfahne bekleideten Sarg bei Schneefall zeigen.“"
                                            },
                                            {
                                                "example_id": "03d6e24c-9faa-4892-af77-f9d56cdc799c",
                                                "sense_id": "a92a9e53-da8c-3db0-a4c9-ed4e7e5a4b07",
                                                "text": "Morgen ist mit starkem Schneefall zu rechnen."
                                            },
                                            {
                                                "example_id": "39b94e9a-45bf-4426-83e4-331f9a3204c6",
                                                "sense_id": "a92a9e53-da8c-3db0-a4c9-ed4e7e5a4b07",
                                                "text": "„Der Schneefall wurde immer dichter.“"
                                            },
                                            {
                                                "example_id": "621c2669-15ac-47ec-82e7-cca45c5fd238",
                                                "sense_id": "a92a9e53-da8c-3db0-a4c9-ed4e7e5a4b07",
                                                "text": "„Dann setzte der erwartete Schneefall ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
