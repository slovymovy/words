                        "entry_id": "0b1a8cfb-527a-3b5a-b8f7-0daeb8f2b2b6",
                        "glosses": [
                            "recht op zelfbeschikking van volken: het recht voor een volk om te bepalen onder welke soevereiniteit het wil vallen, (zelfbeschikkingsrecht voor volken)"
                        ],
                        "tags": [
