                ],
                "senses": [
                    {
                        "sense_id": "00ddfebf-2474-3409-adbb-bcfd618c6505",
                        "entry_id": "edebd37f-f6de-3fa0-8d2f-850ada8edc84",
                        "glosses": [
                            "Person, die Kritiken/Rezensionen zu literarischen Werken verfasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f950b8e5-8a74-4833-bbe3-ad7e71e8bfb0",
                                "sense_id": "00ddfebf-2474-3409-adbb-bcfd618c6505",
                                "text": "„Dieser Fehler spiegelt nicht nur die Kurzsichtigkeit des Literaturkritikers wider, mit der er sich selbst zum Gespött der französischen Literaturwelt machte, sondern auch, wie mühelos sich das Buch ohne diesen Buchstaben liest.“"
                            },
                            {
                                "example_id": "d285fd89-986a-458a-b6f7-f83265c3e2bc",
                                "sense_id": "00ddfebf-2474-3409-adbb-bcfd618c6505",
                                "text": "„Literaturkritiker und Pädagogen diskutierten die Märchen der Gebrüder Grimm, die ihrer Meinung nach eine Frischkur benötigten.“"
                            },
                            {
                                "example_id": "f623c692-89bd-4eaf-aa1f-2f36866fa510",
                                "sense_id": "00ddfebf-2474-3409-adbb-bcfd618c6505",
                                "text": "„Lektoren, Literaturkritiker und Literaturwissenschaftler haben einen chronischen Adjektiv-Komplex.“"
                            },
                            {
                                "example_id": "a174dcbc-19bb-4bca-8da7-998dbbe50fb3",
                                "sense_id": "00ddfebf-2474-3409-adbb-bcfd618c6505",
                                "text": "„Vielleicht war auch manch seriöser Literaturkritiker froh, dem etwas fragwürdigen Busch den würdigen Schopenhauer an die Seite stellen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
