                        "glosses": [
                            "To grow incorrectly or amiss."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "84dc4ac3-2885-4e07-8868-398af708045c",
                                "sense_id": "71e8b276-6a16-3abd-8953-cc7e3e1ce4bb",
                                "text": "Fingers or toes may misgrow club-like together. One kidney may fail. The head may contain practically no brain."
                            },
                            {
                                "example_id": "322e8bf8-ca20-451a-8333-3bd359cab660",
                                "sense_id": "71e8b276-6a16-3abd-8953-cc7e3e1ce4bb",
                                "text": "The notion was that thereafter the first poetic language decayed and misgrew into workaday language, of merely instrumental usefulness, and only from time to time was it by the miracle of genius rediscovered by some few who were able to [...]"
                            },
                            {
                                "example_id": "a51f2ce0-f43e-4303-8ada-91a35d9091f2",
                                "sense_id": "71e8b276-6a16-3abd-8953-cc7e3e1ce4bb",
                                "text": "The Spring Burials Violets growing through the asphalt mean the usual of spring's predicament: how, busy getting born, still wings and green will falter, twist, misgrow their management and die."
                            }
                        ]
                    }
