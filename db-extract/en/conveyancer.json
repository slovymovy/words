                        "glosses": [
                            "An attorney who passes transfer of immovable property from one party to another."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3ec961c2-2eb1-3abe-ab15-7d7945b41583",
                        "entry_id": "2d5aec19-9b3b-3c0c-97eb-71d5e5d704eb",
                        "glosses": [
                            "A pickpocket."
                        ],
                        "tags": [
                            "UK",
                            "obsolete",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "59c45e67-5d74-445e-8f1d-86e4578f5c91",
                                "sense_id": "3ec961c2-2eb1-3abe-ab15-7d7945b41583",
                                "text": "The wind-up is, that the father becomes bankrupt; the wife and daughters town-traders; the sons Greeks, Fancy-swells, Conveyancers (pickpockets), or Cracksmen (house breakers), and the New Drop is the last drop they ever take."
                            },
                            {
                                "example_id": "a227a065-1011-478d-bada-a0b4f09621f3",
                                "sense_id": "3ec961c2-2eb1-3abe-ab15-7d7945b41583",
                                "text": "Then will Lincoln's Inn change its sombre hue to Lincoln green. There will be no conveyancers, i. e. no thieves, no pickpockets."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23c42e49-6c83-4331-956d-af428515775c",
                        "source_entry_id": "2d5aec19-9b3b-3c0c-97eb-71d5e5d704eb",
                        "source_sense_description": "attorney",
                        "target_lang_word": "Notar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Notar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2aa1d7ff-4bad-38f9-acca-6a93ec5bdde5",
                                        "entry_id": "fd1b688e-d70e-32fe-ae18-57bfd5f510a5",
                                        "glosses": [
                                            "unparteiischer Jurist, der Rechtsgeschäfte beurkundet und Unterschriften beglaubigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f318fabe-cb40-43b1-9a29-d4f6302c9c6a",
                                                "sense_id": "2aa1d7ff-4bad-38f9-acca-6a93ec5bdde5",
                                                "text": "Den Kaufvertrag für das Haus unterschreibt der Käufer beim Notar."
                                            },
                                            {
                                                "example_id": "ac66e5f9-214e-4471-b65c-50f200c7e5be",
                                                "sense_id": "2aa1d7ff-4bad-38f9-acca-6a93ec5bdde5",
                                                "text": "Tante Erna hat ihr Testament beim Notar hinterlegt."
                                            },
                                            {
                                                "example_id": "64c3c12a-d1ef-4cfe-9bed-dcf66bf29189",
                                                "sense_id": "2aa1d7ff-4bad-38f9-acca-6a93ec5bdde5",
                                                "text": "„Das Guinness Buch der Rekorde wird den von einem Notar beglaubigten Weltrekordversuch aus Bremerhaven nun prüfen.“"
                                            },
                                            {
                                                "example_id": "9d8ebb7f-3400-4796-92dd-0275657be1ef",
                                                "sense_id": "2aa1d7ff-4bad-38f9-acca-6a93ec5bdde5",
                                                "text": "„Ein reicher Notar aus Nantes kaufte alles auf und vermietete das Café wieder an meine Großmutter.“"
                                            },
                                            {
                                                "example_id": "6640babb-43ec-42ee-81dd-9c3cdea0f04a",
                                                "sense_id": "2aa1d7ff-4bad-38f9-acca-6a93ec5bdde5",
                                                "text": "„Zum mindesten mußte man einen Notar zu Rate ziehen.“"
                                            },
                                            {
                                                "example_id": "d7c8ffe0-ee21-4c42-adcd-d2360807c9a5",
                                                "sense_id": "2aa1d7ff-4bad-38f9-acca-6a93ec5bdde5",
                                                "text": "„Bei den Notaren und Grundbuchämtern Ostpreußens herrschte Hochbetrieb.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
