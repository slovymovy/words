                                        "glosses": [
                                            "kulturelle Fähigkeit der Schriftbenutzung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
