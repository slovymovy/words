                ],
                "senses": [
                    {
                        "sense_id": "f6a9744d-5ecd-3cd0-8fb0-2bfc63134afa",
                        "entry_id": "7b4dab69-6794-3818-bf8c-4a9962a989d9",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным шинель; свойственный, характерный для шинели"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d7787b0-2316-4fec-8fbc-882adc36de46",
                                "sense_id": "f6a9744d-5ecd-3cd0-8fb0-2bfc63134afa",
                                "text": "Изредка мешал ему, однако же, порывистый ветер, который, выхватившись вдруг бог знает откуда и невесть от какой причины, так и резал в лицо, подбрасывая ему туда клочки снега, хлобуча, как парус, шинельный воротник или вдруг с неестественною силою набрасывая ему его на голову и доставляя, таким образом, вечные хлопоты из него выкарабкиваться."
                            },
                            {
                                "example_id": "9d73e122-b49a-4ab5-bccf-945d11c92671",
                                "sense_id": "f6a9744d-5ecd-3cd0-8fb0-2bfc63134afa",
                                "text": "Воздух весь пропитан тяжелыми человеческими испарениями, едким дымом махорки, кислой затхлостью шинельного сукна и густым запахом невыпеченного хлеба."
                            },
                            {
                                "example_id": "f80a19a3-a9e8-4ac5-b04a-c648e849530b",
                                "sense_id": "f6a9744d-5ecd-3cd0-8fb0-2bfc63134afa",
                                "text": "Вощеные лучшие нитки лопнули с треском, причем правый погон отлетел с шинельным мясом."
                            },
                            {
                                "example_id": "514ee0d4-2899-4c29-a6b5-488c695f5d24",
                                "sense_id": "f6a9744d-5ecd-3cd0-8fb0-2bfc63134afa",
                                "text": "Шинельная пуговица, конечно, на вороте пришита крупная."
                            },
                            {
                                "example_id": "932d6334-7cc2-4fc0-a49e-952bce002a47",
                                "sense_id": "f6a9744d-5ecd-3cd0-8fb0-2bfc63134afa",
                                "text": "Ветхая, шинельного цвета, одежонка покрылась пылью."
                            }
                        ]
                    },
                    {
                        "sense_id": "a50b3d27-2dee-35d2-873c-9aa720496422",
                        "entry_id": "7b4dab69-6794-3818-bf8c-4a9962a989d9",
                        "glosses": [
                            "предназначенный для изготовления шинелей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0aae3f4-a4df-44a3-8d12-28d52105bb8b",
                                "sense_id": "a50b3d27-2dee-35d2-873c-9aa720496422",
                                "text": "Из соседней комнаты вышел плотный казачок в козьей серой папахе, сбитой на затылок, в куртке из шинельного сукна и казачьих с лампасами шароварах, заправленных в белые шерстяные чулки."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e6727fa-410d-30eb-8cc7-f8365a273eac",
                        "entry_id": "7b4dab69-6794-3818-bf8c-4a9962a989d9",
                        "glosses": [
                            "устар. гардеробный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f2d720c-e64b-478f-a686-1261279e540b",
                                "sense_id": "8e6727fa-410d-30eb-8cc7-f8365a273eac",
                                "text": "Пробежав спальню и узкий шинельный коридорчик, Александров с разбега ворвался в дежурную комнату; она же была и учительской."
                            }
                        ]
                    }
                ],
