                {
                    "sense_id": "d5cf85a1-447c-3390-be02-c52889fdc143",
                    "sense_definition": "W większości przypadków, zazwyczaj.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W weekendy <w>przeważnie</w> odpoczywam w domu i czytam książki.",
                            "target_lang_translations": {
                                "ru": "По выходным я <w>в основном</w> отдыхаю дома и читаю книги.",
                                "en": "On weekends I <w>usually</w> rest at home and read books.",
                                "zh": "周末我<w>通常</w>在家里休息看书。"
                            }
                        },
                        {
                            "text": "Do pracy jeżdżę <w>przeważnie</w> autobusem, bo tak jest szybciej.",
                            "target_lang_translations": {
                                "ru": "На работу я езжу <w>чаще всего</w> на автобусе, потому что так быстрее.",
                                "en": "I <w>mostly</w> take the bus to work because it's faster that way.",
                                "zh": "我上班<w>大多</w>坐公交车，因为这样更快。"
                            }
                        }
                    ],
                    "synonyms": [
                        "zazwyczaj",
                        "zwykle",
                        "na ogół",
                        "z reguły",
                        "najczęściej"
                    ],
                    "antonyms": [
                        "rzadko"
                    ],
                    "common_phrases": [
                        "przeważnie tak",
                        "przeważnie nie"
                    ],
                    "target_lang_definitions": {
