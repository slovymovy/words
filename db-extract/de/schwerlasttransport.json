                "senses": [
                    {
                        "sense_id": "304320b2-489a-3ea8-ac02-dc3e0ca372ad",
                        "entry_id": "785d3d39-93c0-3c32-8103-965f554f0675",
                        "glosses": [
                            "großes, zur Beförderung von Gütern von sehr hohem Gewicht und Ausmaß genutztes Fahrzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13802c4f-ef9b-4726-b251-e075b8b7719c",
                                "sense_id": "304320b2-489a-3ea8-ac02-dc3e0ca372ad",
                                "text": "„Wegen eines ungewöhnlich großen Schwerlasttransports kommt es am Wochenende und zu Wochenbeginn zu Verkehrsbehinderungen im Süden Sachsen-Anhalts.“"
                            },
                            {
                                "example_id": "0bd85fee-80c6-4e99-b27c-5d8562e03f55",
                                "sense_id": "304320b2-489a-3ea8-ac02-dc3e0ca372ad",
                                "text": "„Drei Mann waren eineinhalb Tage damit beschäftigt, die Äste an den Stamm zu binden, damit die Krone auf einen normalen Lastwagen passt und kein teurer Schwerlasttransport nötig ist.“"
                            },
                            {
                                "example_id": "33a47f9b-faf7-4087-aecb-029cf0e045e5",
                                "sense_id": "304320b2-489a-3ea8-ac02-dc3e0ca372ad",
                                "text": "„Erhebliche Mängel hat die Autobahnpolizei bei der Kontrolle eines Schwerlasttransports auf der Autobahn 9 im Landkreis Wittenberg festgestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
