                "senses": [
                    {
                        "sense_id": "1c5218ea-f670-3753-a6c8-4f421d98a073",
                        "entry_id": "2f67b57b-1280-36cc-9f04-860b9dd81b9b",
                        "glosses": [
                            "meist veraltet oder verächtlich: gesellschaftliches Ereignis mit dem Zweck, möglichst viel Alkohol zu konsumieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "243d3230-7e48-41d5-adef-a9cd2d831568",
                                "sense_id": "1c5218ea-f670-3753-a6c8-4f421d98a073",
                                "text": "Sie konnte seine nächtlichen Trinkgelage nicht mehr ertragen und verließ ihn schließlich."
                            },
                            {
                                "example_id": "90251ef3-d301-424d-87df-d6fbc78db7c7",
                                "sense_id": "1c5218ea-f670-3753-a6c8-4f421d98a073",
                                "text": "„Außerdem eignete sich die Hauptstadt besser für fürstliche Lebensweise, Trinkgelage und großes Gehabe.“"
                            },
                            {
                                "example_id": "bdb75273-d329-4a63-bc45-0622f6e05136",
                                "sense_id": "1c5218ea-f670-3753-a6c8-4f421d98a073",
                                "text": "„Anatol versäumte kein Trinkgelage bei Danilow und anderen Moskauer Zechbrüdern, trank ganze Nächte durch, bis alle anderen unter dem Tisch lagen, und zeigte sich auf allen Soireen und Bällen der ganzen Gesellschaft.“"
                            },
                            {
                                "example_id": "881d5bf7-ddef-429a-9244-c1dc719fc588",
                                "sense_id": "1c5218ea-f670-3753-a6c8-4f421d98a073",
                                "text": "„Der Maler beurlaubte sich, um sich in dem alten Empfangssaal, der früher einmal Trinkgelagen diente, aber seit langem nicht mehr benutzt wurde, mit den Fresken zu beschäftigen.“"
                            },
                            {
                                "example_id": "29db432e-bc0c-4901-86a6-93b67e937082",
                                "sense_id": "1c5218ea-f670-3753-a6c8-4f421d98a073",
                                "text": "„Er ist mit der Arbeit unzufrieden, weiß nur zu genau, daß er durch die vielen Reisen und die nächtlichen Trinkgelage mit zu großen Unterbrechungen und wenig konzentriert am Schreibtisch sitzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6e25705-e960-4874-9b58-1f5e1b3ffef5",
                        "source_entry_id": "2f67b57b-1280-36cc-9f04-860b9dd81b9b",
                        "source_sense_id": "1c5218ea-f670-3753-a6c8-4f421d98a073",
                        "target_lang_word": "carousal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carousal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d386504-227f-3f92-b187-80862e9c6d9e",
                                        "entry_id": "7d324af7-4202-3370-b9d8-04a62dbad172",
                                        "glosses": [
                                            "A noisy feast or social gathering, often with much alcohol consumption."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b7ff5f9-fa91-4bcd-9dff-49a6c07877f3",
                                                "sense_id": "3d386504-227f-3f92-b187-80862e9c6d9e",
                                                "text": "When Alcohol ursurps the throne, and Sober Rationality is ejected, every other consideration is lost; that of having a regular ‘spree’ alone prevails:—the excited passions proclaim for a grand carousal."
                                            },
                                            {
                                                "example_id": "ab3de1c7-e993-4114-9b82-43974029fe0e",
                                                "sense_id": "3d386504-227f-3f92-b187-80862e9c6d9e",
                                                "text": "The earth-spirit of Tema, who loved carousals, heard from afar the songs and laughter of the people on Nassau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4bfba4e-108e-45d0-9262-5a74c5ef5d60",
                        "source_entry_id": "2f67b57b-1280-36cc-9f04-860b9dd81b9b",
                        "source_sense_id": "1c5218ea-f670-3753-a6c8-4f421d98a073",
                        "target_lang_word": "binge drinking",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "binge drinking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4859959f-54fb-3392-9d61-f92adfaba477",
                                        "entry_id": "5e54e919-24c2-3fde-b4fd-51c23e2af5e1",
                                        "glosses": [
                                            "The consumption of excessive amounts of alcohol in a short period of time."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d182d18-5650-420e-b644-79e777cb9fad",
                                                "sense_id": "4859959f-54fb-3392-9d61-f92adfaba477",
                                                "text": "Fights caused by binge drinking are a major problem in Cardiff."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3188b324-637a-40de-82c6-571a079fb82d",
                        "source_entry_id": "2f67b57b-1280-36cc-9f04-860b9dd81b9b",
                        "source_sense_id": "1c5218ea-f670-3753-a6c8-4f421d98a073",
                        "target_lang_word": "beuverie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beuverie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c822addd-9b00-33ce-a51c-c3e77ce6c66e",
                                        "entry_id": "5efad8d2-bf3a-3dec-8ce0-df2453443d27",
                                        "glosses": [
                                            "Pratique de boire en groupe des boissons alcooliques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13c42c21-e80d-4899-93e0-507ceaa6b901",
                                                "sense_id": "c822addd-9b00-33ce-a51c-c3e77ce6c66e",
                                                "text": "Ce fut une époque de beuveries à décarcasser un veau, parmi les vapeurs des pipes et les proclamations d'esthètes crasseux, toutes lavallières dehors."
                                            },
                                            {
                                                "example_id": "1a37472f-2b63-4a42-88c2-a82f926f80ab",
                                                "sense_id": "c822addd-9b00-33ce-a51c-c3e77ce6c66e",
                                                "text": "Ne s'organise-t-il pas, assez souvent, de ces beuveries monstrueuses, du genre de celles que le préfet du Morbihan crut devoir, au début de la présente année, dénoncer, dans une lettre adressée aux maires ?"
                                            },
                                            {
                                                "example_id": "a8f5126b-d88b-435b-9126-67505d8959bd",
                                                "sense_id": "c822addd-9b00-33ce-a51c-c3e77ce6c66e",
                                                "text": "Je n’ai qu’un pauvre lopin de terre, mes paysans se croisent les bras, ne rêvent que de beuveries …"
                                            },
                                            {
                                                "example_id": "3e394313-d078-4a8b-b9a1-8d6a210c857e",
                                                "sense_id": "c822addd-9b00-33ce-a51c-c3e77ce6c66e",
                                                "text": "Ted n'avait jamais vraiment prêté attention à son apparence jusqu'à un soir de beuverie où elle avait accepté en titubant d'affronter une belle blonde du LAPD lors d'un concours de T-shirt mouillé."
                                            },
                                            {
                                                "example_id": "b026c35e-bd74-4f42-bbdd-2dfae5b03667",
                                                "sense_id": "c822addd-9b00-33ce-a51c-c3e77ce6c66e",
                                                "text": "Beuverie et sexe : curieux rite de l'Égypte antique:\nOn se soûle sans retenue, puis on défile en ville en chantant et en dansant. Il est même permis de se livrer à quelques débauches sexuelles, avant de s’en retourner le lendemain à la vie ordinaire. Non, ceci n’est pas le récit d’une récente soirée de débauche. La scène se passe en 1470 avant J.-C. en Égypte. Il s’agit d’un rituel – la cérémonie de l’ivresse, célébrée tous les ans dans l’Égypte pharaonique – qui était destiné au… salut de l’humanité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
