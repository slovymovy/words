                        "examples": [
                            {
                                "example_id": "dac312fa-b357-4e67-a904-549059d68f69",
                                "sense_id": "e2321f40-fb29-3bbf-bd0e-412a4d5b6443",
                                "text": "Het reservoir is van een fabriek nabij een inmiddels gesloten fosfaatmijn in de buurt van de stad Tampa. Het water is een mix van zout water, gemengd met afval- en regenwater. Volgens het milieudepartement van Florida bevat het verhoogde niveaus van fosfor en stikstof en is het water relatief zuur, maar is het hoogstwaarschijnlijk niet giftig."
                            },
                            {
                                "example_id": "58bfe31e-34ea-4816-b666-c910c4306e6d",
                                "sense_id": "e2321f40-fb29-3bbf-bd0e-412a4d5b6443",
                                "text": "De ontvoering was in de buurt van de stad Kidal, in het noorden van Mali. Daar is het al een week onrustig. Vrijdag was er een zelfmoordaanslag bij een fosfaatmijn. Daarbij vielen verder geen slachtoffers."
                            }
                        ]
