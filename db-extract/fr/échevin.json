                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bc954af-c303-405a-a0f1-c4c5fe65f163",
                                                "sense_id": "b538e515-3ea1-38c9-888d-fdd328b02db2",
                                                "text": "Giorgos zoekt oogcontact als het meisje vertelt hoe er tijdens de beruchte Slag om Kreta een heroïsche stroom van duizenden geallieerde soldaten op gang kwam: het merendeel van hen wist met schepen via de zuidkant van het eiland te ontsnappen naar Egypte, maar er waren er ook die zich aansloten bij de partizanen."
                                            },
                                            {
                                                "example_id": "481f1f5b-3080-444f-8025-4748665bb3d3",
                                                "sense_id": "b538e515-3ea1-38c9-888d-fdd328b02db2",
                                                "text": "Ze wandelden naar de haven, waar ze op een terras limonade dronken en zich afvroegen welk van de reusachtige schepen hun bedrieglijke pakket vervoerde."
                                            },
                                            {
                                                "example_id": "ff64a029-8ae2-42df-a5dc-3d9a445dae44",
                                                "sense_id": "b538e515-3ea1-38c9-888d-fdd328b02db2",
                                                "text": "De schepen waarvan de zeilen gehesen zijn, zien eruit alsof ze in bloei staan, klaar om de passaat te vangen en hun bemanning ver weg te voeren."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "schepen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ebb531f5-dba7-34f6-9ba8-83b0f3cb3fa8",
                                        "entry_id": "f6255258-1900-3c5e-9321-cfded3ad64e3",
                                        "glosses": [
                                            "zich inschepen"
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a75e18fd-4a77-4be1-9b97-643cf3b763ad",
                                                "sense_id": "ebb531f5-dba7-34f6-9ba8-83b0f3cb3fa8",
                                                "text": "Wie met de Duivel gescheept is, moet met hem over."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d3a71a3-e6d8-3d8d-bbb4-8b8b7946e5d8",
                                        "entry_id": "f6255258-1900-3c5e-9321-cfded3ad64e3",
                                        "glosses": [
                                            "inschepen, aan boord gaan, aan boord brengen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0bc8d46-e0c6-4dd2-8545-70b70f21ff56",
                                                "sense_id": "1d3a71a3-e6d8-3d8d-bbb4-8b8b7946e5d8",
                                                "text": "Het vlees wordt niet ingevroren maar vacuüm verpakt en gekoeld gescheept."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c6bff88-a109-3960-b904-aa9c9f798203",
                                        "entry_id": "f6255258-1900-3c5e-9321-cfded3ad64e3",
                                        "glosses": [
                                            "per schip vervoeren, verschepen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01a5ef78-c1b5-4de2-8ba7-eab519862b53",
                                                "sense_id": "7c6bff88-a109-3960-b904-aa9c9f798203",
                                                "text": "..ende dat dies niet jegenstaende verschieden perthien van terruwe ende rogge buiten de geunieerde provincien nae andere landen gescheept ende vervoert worden.."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
