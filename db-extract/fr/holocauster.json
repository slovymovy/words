                "senses": [
                    {
                        "sense_id": "af395e2c-aa15-3ba1-818b-3d175a14ce41",
                        "entry_id": "9c12b1dd-bf3e-3394-9f38-8d1261c6ef06",
                        "glosses": [
                            "Offrir en holocauste."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "562215cb-9835-4645-9089-5c152e6870ac",
                                "sense_id": "af395e2c-aa15-3ba1-818b-3d175a14ce41",
                                "text": "Comme s’ils se fussent doutés Qu'ils devaient être holocaustés."
                            },
                            {
                                "example_id": "42abe2ed-0437-494c-a3d9-defbbb1e31ec",
                                "sense_id": "af395e2c-aa15-3ba1-818b-3d175a14ce41",
                                "text": "Notre bureau évaluation des pertes n’a pas vocation d’holocauster, mais de révisionnaliser le prévisionnisme holocaustien du plan Marshall."
                            },
                            {
                                "example_id": "0ec753df-ad32-42a7-92c7-eea3574c5e78",
                                "sense_id": "af395e2c-aa15-3ba1-818b-3d175a14ce41",
                                "text": "«Faites payer les riches tant que vous voulez, écrasez-les, précipitez-les dans la géhenne, expulsez-les, holocaustez-les, vous ne réglez rien, absolument rien», avait-il écrit^([Claude Picher]) dans ce même esprit tout en nuances des autres parvenus déjà cités."
                            },
                            {
                                "example_id": "659bd8a6-5e8c-4bf7-9883-fd73704be8d8",
                                "sense_id": "af395e2c-aa15-3ba1-818b-3d175a14ce41",
                                "text": "Il est impossible de récuser l'ingérence du druida, en présence de ce tanas d'osier où l'on holocaustait les criminels et les animaux impurs pour la magie."
                            }
                        ]
                    }
                ],
