                        "examples": [
                            {
                                "example_id": "269b1b10-babf-4a77-8d84-3a3c879aed10",
                                "sense_id": "7450e079-8146-3217-9859-f2fd2870e23d",
                                "text": "The patient justifiedly becomes uneasy and rebellious under very hot and cold fire and the attempted desiccation is tedious, painful and inoperative[...]."
                            },
                            {
                                "example_id": "9097038c-adec-4124-bd51-9fd2b6c2f628",
                                "sense_id": "7450e079-8146-3217-9859-f2fd2870e23d",
                                "text": "Here Leslie shows his unhappiness with the imaginative treatment of angels in Paradise Lost, a treatment he perhaps justifiedly thought people read as truth."
                            },
                            {
                                "example_id": "4890cd67-1edb-4c5a-8704-1e07909df978",
                                "sense_id": "7450e079-8146-3217-9859-f2fd2870e23d",
                                "text": "If I know something is so, then it is true, whereas I can justifiedly believe something false."
                            }
                        ]
                    }
