                                        "entry_id": "bf3f4cf2-7cb5-3b6e-8fe2-6956f25ad6d0",
                                        "glosses": [
                                            "The process by which an emulsion is formed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b370a692-7861-4ee9-a38b-0c995704fb85",
                                                "sense_id": "3663667b-1a31-3220-a315-93d1dea7a82b",
                                                "text": "Mayonnaise is made by the emulsification of oil and vinegar."
                                            },
                                            {
                                                "example_id": "8ad065af-3b39-43c2-ab06-96c0dfd9d371",
                                                "sense_id": "3663667b-1a31-3220-a315-93d1dea7a82b",
                                                "text": "The oil bath, which is a feature of the original locomotives, has led to an excessive use of oil and also corrosion of the steel motion details because of the entry of water, causing emulsification. The oil bath has thus been dispensed with, and the motion and valve gear of the inside cylinder are no longer completely enclosed, enabling the various working parts to be readily examined."
                                            }
                                        ]
                                    }
