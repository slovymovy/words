                        "sense_id": "ccb2967b-e1aa-37ac-94ea-63023713dfe7",
                        "entry_id": "49161775-5fb3-37ac-89cc-47abf19331e7",
                        "glosses": [
                            "auf die Scholastik (spezielle Denkweise, um durch Logik inhaltliche, semantische Fragen zu klären) bezogen; der Scholastik und ihrer Theorie folgend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64211e37-550d-4ac6-a918-624587f341a5",
                                "sense_id": "ccb2967b-e1aa-37ac-94ea-63023713dfe7",
                                "text": "Im Mittelalter kam die scholastische Beweisführung auf."
                            },
                            {
                                "example_id": "463d7d6a-483e-4c0f-854f-0242916681c1",
                                "sense_id": "ccb2967b-e1aa-37ac-94ea-63023713dfe7",
                                "text": "„Trotzdem blieb scholastisches Denken bis weit in die Neuzeit hinein grundlegender Bestandteil des wissenschaftlichen Arbeitens und des universitären Lehrbetriebs in allen Disziplinen.“"
                            }
                        ],
