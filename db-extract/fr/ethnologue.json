                "senses": [
                    {
                        "sense_id": "403410a1-65b3-3e2d-b6d6-b2c9b2387382",
                        "entry_id": "aa969d23-b70f-3a28-8ff8-dfda59b93ff1",
                        "glosses": [
                            "Celui, celle qui s’occupe d’ethnologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2359e98-ee8d-4f35-8110-77b4fe98a22d",
                                "sense_id": "403410a1-65b3-3e2d-b6d6-b2c9b2387382",
                                "text": "J’ai rejoint une population qui avait longtemps refusé tout contact pacifique avec l’extérieur et n’avait croisé les premiers missionnaires que peu de temps avant mon arrivée (les ethnologues arrivent toujours après les missionnaires !)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "781aaaa0-25e0-4aaa-85e2-37ee86450a60",
                        "source_entry_id": "aa969d23-b70f-3a28-8ff8-dfda59b93ff1",
                        "source_sense_id": "403410a1-65b3-3e2d-b6d6-b2c9b2387382",
                        "target_lang_word": "Ethnologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ethnologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4da1f7c-cf6c-35e9-b512-8658bf2f26f0",
                                        "entry_id": "7a50b49c-53f8-3387-b673-892a3d8e76ca",
                                        "glosses": [
                                            "Wissenschaftler, der sich mit der Ethnologie (Völkerkunde) beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6180eb47-f3ef-45ea-b32e-53ed8d360d48",
                                                "sense_id": "b4da1f7c-cf6c-35e9-b512-8658bf2f26f0",
                                                "text": "„Der norwegische Ethnologe Thor Heyerdahl erbrachte 1970 den Beweis, daß mit einem nach altägyptischen Vorlagen gebauten Papyrusschiff Amerika von Nordafrika aus erreicht werden konnte.“"
                                            },
                                            {
                                                "example_id": "16bc2fed-0cff-4d6a-88eb-bcb8ecdfe8d7",
                                                "sense_id": "b4da1f7c-cf6c-35e9-b512-8658bf2f26f0",
                                                "text": "„Lips' Arbeit war auch deshalb so brisant, weil die allermeisten deutschen Ethnologen mit ihrer Forschung damals als Verstärker für das rassistische Weltbild fungierten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eba71e49-9fca-4e6b-923a-99b2ea34a779",
                        "source_entry_id": "aa969d23-b70f-3a28-8ff8-dfda59b93ff1",
                        "source_sense_id": "403410a1-65b3-3e2d-b6d6-b2c9b2387382",
