                "senses": [
                    {
                        "sense_id": "a5ec1b7b-70a5-342a-a248-72f98a68415d",
                        "entry_id": "a04e285a-76a3-3a82-a8e9-6745e0700040",
                        "glosses": [
                            "iemand die actuele gebeurtenissen van commentaar voorziet in de media"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "3c3ea3d1-d113-466e-bca0-2644f986fa6a",
                                "sense_id": "a5ec1b7b-70a5-342a-a248-72f98a68415d",
                                "text": "- De commentator kon zijn oren niet geloven toen hij de ware reden te horen kreeg."
                            },
                            {
                                "example_id": "5b7ef23a-a9f4-456e-a5f6-304bad1b81a8",
                                "sense_id": "a5ec1b7b-70a5-342a-a248-72f98a68415d",
                                "text": "- Max Verstappen lijkt nog niet te beseffen wat hij heeft losgemaakt. Als jongste grand prix-winnaar ooit en als enige Nederlander schreef hij op zondagmiddag historie op het circuit van Barcelona. Formule 1-commentator bij Ziggo Sport, Olav Mol, hield het dan ook niet droog. Met overslaande stem doet hij verslag van de laatste meters van Verstappen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38aaa941-dd5f-444e-9419-8342be395431",
                        "source_entry_id": "a04e285a-76a3-3a82-a8e9-6745e0700040",
                        "source_sense_id": "a5ec1b7b-70a5-342a-a248-72f98a68415d",
                        "target_lang_word": "Kommentator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kommentator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f0d9175-552a-363b-9b95-967ac1230232",
                                        "entry_id": "66ac9bd3-9f3c-382a-86a5-ea154b50f86d",
                                        "glosses": [
                                            "Person, die etwas bespricht, wobei sie es zugleich auch beurteilt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a98cc550-5b1d-4ed2-9b9a-df0f8415f6d6",
                                                "sense_id": "3f0d9175-552a-363b-9b95-967ac1230232",
                                                "text": "„Das war den Kommentatoren in den Foren der Online-Zeitungen nicht genug.“"
                                            },
                                            {
                                                "example_id": "3273ea58-221f-4347-8474-ef18909b97e4",
                                                "sense_id": "3f0d9175-552a-363b-9b95-967ac1230232",
                                                "text": "„Was die Kommentatoren am meisten frappierte, war das Selbstbewusstsein der Beschuldigten.“"
                                            },
                                            {
                                                "example_id": "48b79b37-a8fb-4940-98e9-2c6a5f52fa79",
                                                "sense_id": "3f0d9175-552a-363b-9b95-967ac1230232",
                                                "text": "„Nur ein paar wenige Oppositionspolitiker und konservative Kommentatoren stimmten ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a836db0f-4ac3-4043-8fe0-571404f686b3",
                        "source_entry_id": "a04e285a-76a3-3a82-a8e9-6745e0700040",
                        "source_sense_id": "a5ec1b7b-70a5-342a-a248-72f98a68415d",
                        "target_lang_word": "commentator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commentator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33a2e9c8-095f-3a48-aa75-c687f92dd730",
                                        "entry_id": "1b605842-52e2-34d5-b379-7c03243bfb28",
                                        "glosses": [
                                            "A person who makes a commentary, particularly"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cb453a0-7729-4dab-a531-7877b5f5cb51",
                                                "sense_id": "33a2e9c8-095f-3a48-aa75-c687f92dd730",
                                                "text": "He was a commentator for football two years before retiring."
                                            },
                                            {
                                                "example_id": "d4ca3f88-0f00-4162-b552-b1dbbeb6c351",
                                                "sense_id": "33a2e9c8-095f-3a48-aa75-c687f92dd730",
                                                "text": "Specifically, and unforgivably, she restarted the Heathrow Third Runway bandwagon, which had been stalled for more than a decade and even declared dead by most commentators."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb89546c-7160-338a-a49c-f5819d899f83",
                                        "entry_id": "1b605842-52e2-34d5-b379-7c03243bfb28",
                                        "glosses": [
                                            "A person who makes a commentary, particularly",
                                            "Synonym of historian or chronicler, a person who compiles an annotated history."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7bf2f0d-b348-320b-8569-642df43cab1a",
                                        "entry_id": "1b605842-52e2-34d5-b379-7c03243bfb28",
                                        "glosses": [
                                            "A person who makes a commentary, particularly",
                                            "A person who compiles explanations and critical notes on a text."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae0a37d8-78b2-334c-865f-8e51c16a0d70",
                                        "entry_id": "1b605842-52e2-34d5-b379-7c03243bfb28",
                                        "glosses": [
                                            "A person who makes a commentary, particularly",
                                            "A person who compiles explanations of the law, particularly (historical) comparatively innovative European jurists in the 14th century, as opposed to earlier glossators."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd34c356-c2f4-4f7b-b27d-11645ffe19f1",
                                                "sense_id": "ae0a37d8-78b2-334c-865f-8e51c16a0d70",
                                                "text": "It would be well into the fourteenth century before the commentators came into their own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23cee1f2-9e0e-3fc0-9069-b4b83d2b7714",
                                        "entry_id": "1b605842-52e2-34d5-b379-7c03243bfb28",
                                        "glosses": [
                                            "A person who makes a commentary, particularly",
                                            "A person who compiles explanations of biblical passages."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "353966ef-0532-3cad-8963-d9a76c7724b0",
                                        "entry_id": "1b605842-52e2-34d5-b379-7c03243bfb28",
                                        "glosses": [
                                            "A person who makes a commentary, particularly",
                                            "A person who provides an instantaneous description of a public event, particularly a sporting event, for a mass media audience."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02fd0665-7f1e-3f76-9566-62630c7272bd",
                                        "entry_id": "1b605842-52e2-34d5-b379-7c03243bfb28",
                                        "glosses": [
                                            "A person who makes a commentary, particularly",
                                            "A person who provides analysis or opinion on current events, especially for a mass media audience."
