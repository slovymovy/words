                                "sense_id": "142d3249-2be2-3b71-971f-e2e66a988893",
                                "text": "Beyond this, to produce belleek, ground flint glass is introduced."
                            },
                            {
                                "example_id": "986d39b5-78a2-4df3-85e3-e9452471da9c",
                                "sense_id": "142d3249-2be2-3b71-971f-e2e66a988893",
                                "text": "No deposit work is done here, but some belleek is obtained from this establishment for that kind of work."
                            },
                            {
                                "example_id": "35d7149a-4cd1-4d24-833e-07d9043078d2",
                                "sense_id": "142d3249-2be2-3b71-971f-e2e66a988893",
                                "text": "A belleek body is one of the mysteries of modern Ceramics."
                            }
                        ]
                    }
