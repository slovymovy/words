                                "example_id": "90e71404-353c-46d2-9a2f-697f0adc3204",
                                "sense_id": "045fb81d-5960-336d-a865-4a493b3ff4a8",
                                "text": "C’est une fouille préventive, menée en 2002 sous l’ancien cinéma Olympia, qui révèle l’importance du monument mais aussi le potentiel des archives photographiques, seuls témoins de l’état du temple après-guerre et de ses parties architecturales détruites ou restées enfouies."
                            },
                            {
                                "example_id": "98767c2c-bc80-4a68-9e84-b84cfe8d0aba",
                                "sense_id": "045fb81d-5960-336d-a865-4a493b3ff4a8",
                                "text": "Il justifie les violations du droit international au nom de la guerre préventive et les exactions au titre de la légitime défense."
                            }
                        ]
                    }
