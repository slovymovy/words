        "fr-extract.jsonl": [
            {
                "entry_id": "731df8d1-aa13-3552-9b76-3a485036a441",
                "word": "clarinette",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "40804094-40ad-3d7d-b9a1-5efa9954f540",
                        "entry_id": "731df8d1-aa13-3552-9b76-3a485036a441",
                        "glosses": [
                            "Déformation plaisante de clair et net."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "3017fd68-91dc-499b-a752-bb6e71a5995d",
                                "sense_id": "40804094-40ad-3d7d-b9a1-5efa9954f540",
                                "text": "… te souviens-tu d’une boutade lancée par notre professeur: « c’est clair, c’est net... c’est clarinette…»"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "7b6111a1-8f54-3935-9385-9149632ca992",
                "word": "clarinette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7aaee9d2-39d0-4493-b4d4-4fb723b7de68",
                        "entry_id": "7b6111a1-8f54-3935-9385-9149632ca992",
                        "tags": [
                            "plural"
                        ],
                        "form": "clarinettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "398417d4-1be9-3387-8ef9-3fe4fface5c7",
                        "entry_id": "7b6111a1-8f54-3935-9385-9149632ca992",
                        "glosses": [
                            "Instrument à vent, à bec, à anche et à clefs de la famille des \\\"bois\\\"."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5ac8e31-ca20-4eba-8c6b-01e2bb1df605",
                                "sense_id": "398417d4-1be9-3387-8ef9-3fe4fface5c7",
                                "text": "On distinguait le ronflement sonore de la basse, s’essoufflant à suivre le nasillement de la clarinette."
                            },
                            {
                                "example_id": "f48fd6e2-b493-44d0-8180-70691348b8f3",
                                "sense_id": "398417d4-1be9-3387-8ef9-3fe4fface5c7",
                                "text": "Jean Dousteyssier a commencé la musique par la clarinette, au conservatoire de Bordeaux."
                            },
                            {
                                "example_id": "c2055a53-c4b9-4252-899e-572f50b1f8d3",
                                "sense_id": "398417d4-1be9-3387-8ef9-3fe4fface5c7",
                                "text": "Dans la partition musicale de « Pierre et le Loup », le chat est représenté par une clarinette."
                            },
                            {
                                "example_id": "c2726fc6-508c-4d89-aef6-1c2a8c6caa2f",
                                "sense_id": "398417d4-1be9-3387-8ef9-3fe4fface5c7",
                                "text": "Star incontestable d’un jazz désormais « classique », la clarinette, malgré sa couleur et son expressivité exceptionnelles, apparaît au moment du bebop comme l’emblème d’une musique dépassée. Exit la clarinette."
                            },
                            {
                                "example_id": "e785af6e-3067-40fe-9a75-326cb94e252c",
                                "sense_id": "398417d4-1be9-3387-8ef9-3fe4fface5c7",
                                "text": "La clarinette est un tuyau qui parle du nez et que la détresse des aveugles a rendu fameux."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba6fe003-07b0-3e83-9680-b5f009c3b9d1",
                        "entry_id": "7b6111a1-8f54-3935-9385-9149632ca992",
                        "glosses": [
                            "Musicien qui joue de cet instrument : un/une clarinettiste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "471520c1-74b3-4ef3-bb12-bbea602952b2",
                                "sense_id": "ba6fe003-07b0-3e83-9680-b5f009c3b9d1",
                                "text": "Et puis, supposons que tu te sois marié, Kasper, je n’aurais jamais trouvé d’aussi bon clarinette que toi ; de cette manière tout est bien : nous pourrons faire de la musique ensemble, et traîner la semelle jusqu’à la fin de nos jours."
                            }
                        ]
                    },
                    {
                        "sense_id": "f20ce789-b429-3e49-ae25-0ecc94633535",
                        "entry_id": "7b6111a1-8f54-3935-9385-9149632ca992",
                        "glosses": [
                            "Dispositif composé d'un tube fermé et de vannes manuelles permettant d'isoler des appareils, facilitant ainsi la condamnation pour intervention."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "da0528cd-bd53-4b03-97f1-dec9c0bd8673",
                                "sense_id": "f20ce789-b429-3e49-ae25-0ecc94633535",
                                "text": "L'air qui pilote la vanne de régulation pneumatique provient d'une clarinette d'air située sur le même niveau."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1f12369-7d00-3c7f-bd26-ec1ee8bea105",
                        "entry_id": "7b6111a1-8f54-3935-9385-9149632ca992",
                        "glosses": [
                            "Fusil."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "23091435-98da-4c3a-8628-916ac71f5a7a",
                                "sense_id": "d1f12369-7d00-3c7f-bd26-ec1ee8bea105",
                                "text": "Il porte un mauser en bandoulière.\n- J’ai une clarinette avec six chargeurs pleins de bastos, crois-tu qu’on me les laissera emporter ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "af655e98-c8b0-3530-806f-2f226d7cf40c",
                        "entry_id": "7b6111a1-8f54-3935-9385-9149632ca992",
                        "glosses": [
                            "Pénis."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b1010aa9-13bf-4c61-b89c-b2a7fef694c7",
                                "sense_id": "af655e98-c8b0-3530-806f-2f226d7cf40c",
                                "text": "Y fait ni une ni deux, y quitte son bénard, s’couche à côté de la bonne femme, lui p’lote les miches, sort sa clarinette, et entreprend d’l’enfiler en levrette à la surprenante."
                            }
                        ]
                    },
                    {
                        "sense_id": "70680d31-fe19-3424-99f5-65e875e0742b",
                        "entry_id": "7b6111a1-8f54-3935-9385-9149632ca992",
                        "glosses": [
                            "Bout de tuyau en cuivre, d'environ 12 cm de long, coudé de manière à sauter par dessus un autre tuyau et dont l'un des côtés est destiné à être abouté perpendiculairement à un autre tuyau. (Note : il ne doit pas être confondu avec le chapeau de gendarme qui lui ressemble.)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a93df81-7797-4a81-a15e-1f14ddc89274",
                        "source_entry_id": "7b6111a1-8f54-3935-9385-9149632ca992",
