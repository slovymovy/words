                                "target_senses": [
                                    {
                                        "sense_id": "7b343a36-72ce-3674-97d7-629f227b6c67",
                                        "entry_id": "b4f6e95f-b5cb-3ffa-960e-a86297868d83",
                                        "glosses": [
                                            "waarbij geweld gebruikt wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff3d26d8-9c4b-4648-97ab-01ea4cc89bc5",
                                                "sense_id": "7b343a36-72ce-3674-97d7-629f227b6c67",
                                                "text": "De politie trachtte op een gewelddadige wijze de bezetting van het plein te beëindigen."
                                            },
                                            {
                                                "example_id": "16734c25-0c12-4863-9657-6be043946b3c",
                                                "sense_id": "7b343a36-72ce-3674-97d7-629f227b6c67",
                                                "text": "Onze complete misdadigheid beperkte zich tot onwettig affiches ophangen, demonstreren zonder politietoestemming, ongehoorzaamheid ten opzichte van de politie, scheldwoorden ((belediging') gericht tegen dezelfde politie gepaard aan gewelddadig verzet wanneer de agenten optraden tegen de scheldwoorden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ba079e2-3087-3194-9fe1-f6af71705075",
                                        "entry_id": "b4f6e95f-b5cb-3ffa-960e-a86297868d83",
                                        "glosses": [
                                            "geneigd geweld te gebruiken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c4e215f-9e8e-4a34-adfd-5e85a92d5472",
                                                "sense_id": "0ba079e2-3087-3194-9fe1-f6af71705075",
                                                "text": "Hij stond bekend als een gewelddadig man."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95b75f1e-7727-48e9-9892-e299cff90f7b",
                        "source_entry_id": "48c52294-30d9-3e15-a396-debae509a617",
                        "source_sense_description": "in a violent manner",
                        "target_lang_word": "violemment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "violemment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a07051ba-bd32-3a80-8f19-ce3b15ea4635",
                                        "entry_id": "0668e7cf-9962-36e7-ad21-89f31f87a23e",
                                        "glosses": [
                                            "Avec violence ; avec impétuosité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6997dfe-4d15-4938-afe6-606dc8975a6e",
                                                "sense_id": "a07051ba-bd32-3a80-8f19-ce3b15ea4635",
                                                "text": "Tout à la fois thriller haletant et chronique d’une Amérique en crise, le dernier roman de Douglas Kennedy nous plonge dans les réalités socio-économiques d’un pays où les idéologies extrêmes s’affrontent violemment."
                                            },
                                            {
                                                "example_id": "0ee1e1d0-8c55-4658-b6e2-eba3e0d07a10",
                                                "sense_id": "a07051ba-bd32-3a80-8f19-ce3b15ea4635",
                                                "text": "Elle tenta d’entraîner François et, comme celui-ci l'envoyait paître, elle l’abandonna, ouvrit la porte et la referma violemment."
                                            },
                                            {
                                                "example_id": "dffc036c-b5f7-46f4-83de-735d36188827",
                                                "sense_id": "a07051ba-bd32-3a80-8f19-ce3b15ea4635",
                                                "text": "Cédric Hapère claqua violemment la porte de la salle d’interrogatoire et se dirigea vers la machine à café en pestant : cette vieille pie les faisait tourner en bourrique !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c0eb2bd-4ee9-389d-aa0c-7ffd19dea206",
                                        "entry_id": "0668e7cf-9962-36e7-ad21-89f31f87a23e",
                                        "glosses": [
                                            "Avec ardeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0adad220-19a8-4aae-a62d-361c784264ac",
                                                "sense_id": "0c0eb2bd-4ee9-389d-aa0c-7ffd19dea206",
                                                "text": "Haïr violemment."
                                            },
                                            {
                                                "example_id": "1bc34a8a-cfa6-40a9-a91e-a3ad341cd05a",
                                                "sense_id": "0c0eb2bd-4ee9-389d-aa0c-7ffd19dea206",
                                                "text": "Si je suis dieu, vous cesserez de m’aimer, ou du moins vous ne m’aimerez plus avec tant d’ardeur ; car il s'en faut bien qu’on aime les dieux aussi violemment que les hommes,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d29d254-e494-3a9e-81f9-49a852ed712d",
                                        "entry_id": "0668e7cf-9962-36e7-ad21-89f31f87a23e",
                                        "glosses": [
                                            "Très fortement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f431d74-51bf-4f45-8113-4624239f2155",
                                                "sense_id": "6d29d254-e494-3a9e-81f9-49a852ed712d",
                                                "text": "L'abbé Têtu a été violemment occupé pour le mariage de M. de Chapes et de Mlle d’Humières,"
                                            },
                                            {
                                                "example_id": "13b17d09-0de1-440d-a0dd-c94f5367ebd4",
                                                "sense_id": "6d29d254-e494-3a9e-81f9-49a852ed712d",
                                                "text": "Un homme violemment soupçonné d’un crime qui méritait la mort,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
