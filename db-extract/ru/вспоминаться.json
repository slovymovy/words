                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d79a90d-6df7-4f32-a1b5-fd2e17d0f3b7",
                                                "sense_id": "db9b864c-7e5c-3f22-b9c4-842dabfd8a8f",
                                                "text": "Il serait maintenant impossible à aucun de nous de se rien rappeler de lui"
                                            },
                                            {
                                                "example_id": "477ddb24-c933-4268-8ace-9ade2937deb2",
                                                "sense_id": "db9b864c-7e5c-3f22-b9c4-842dabfd8a8f",
                                                "text": "Je me rappelle l’inquiétude qui s’était emparée de moi en voyant combien ce fameux « bon français », qui était notre langue écrite, était incapable de nous exprimer et de m’exprimer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba4f8f64-b31a-3bc4-9e26-e0c0a79a0cf2",
