        "fr-extract.jsonl": [
            {
                "entry_id": "f6d9dfd0-95a2-3a30-932d-f11c19bb657d",
                "word": "parloir",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0d5bc89d-f53c-4dc2-a537-f80228376397",
                        "entry_id": "f6d9dfd0-95a2-3a30-932d-f11c19bb657d",
                        "tags": [
                            "plural"
                        ],
                        "form": "parloirs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6f7e8fb4-40e9-3da2-8b2c-d845c6ca1b55",
                        "entry_id": "f6d9dfd0-95a2-3a30-932d-f11c19bb657d",
                        "glosses": [
                            "Lieu où, dans les communautés religieuses, dans les collèges, dans les hôpitaux, dans les prisons, etc., les religieux ou religieuses, les élèves internes, les malades, les détenus, etc., viennent parler aux personnes du dehors."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82c534e7-5d95-4790-bf3e-e834958c7c50",
                                "sense_id": "6f7e8fb4-40e9-3da2-8b2c-d845c6ca1b55",
                                "text": "Une servante effarée prit ma carte et m’abandonna sans un mot d’espoir dans un froid parloir où je respirai cette odeur fade particulière aux réfectoires des maisons d’éducation. Le plancher de ce parloir avait été ciré avec une si impitoyable énergie que je pensai rester en détresse sur le seuil."
                            },
                            {
                                "example_id": "ec15a3e7-1531-4369-a903-c12edc5bc832",
                                "sense_id": "6f7e8fb4-40e9-3da2-8b2c-d845c6ca1b55",
                                "text": "J’ai quelques visites, et, ma foi ! comme on ne me traite pas trop mal, je reçois les gens dans un petit parloir, sans grilles, sans guichetier tendant l’oreille."
                            },
                            {
                                "example_id": "eb05823c-5a4f-43d0-a431-45a12b4cefec",
                                "sense_id": "6f7e8fb4-40e9-3da2-8b2c-d845c6ca1b55",
                                "text": "Alors que des incidents ont éclaté dans plusieurs établissements pénitentiaires, où les parloirs sons suspendus, l’administration dit avoir identifié les « meneurs » et promis des sanctions."
                            },
                            {
                                "example_id": "da57d72a-07e8-4959-a733-f759c36e46c9",
                                "sense_id": "6f7e8fb4-40e9-3da2-8b2c-d845c6ca1b55",
                                "text": "Vous vous intriguerez pour avoir entrée au parloir de quelque couvent ; le bavardage de ces recluses ne nous sera pas inutile."
                            },
                            {
                                "example_id": "acd84c84-0888-4397-9437-4a12f2be971c",
                                "sense_id": "6f7e8fb4-40e9-3da2-8b2c-d845c6ca1b55",
                                "text": "Après qu’on l’a franchie, on trouve à sa droite le poste des surveillants-concierges qui communique directement avec une pièce destinée aux commissionnaires spécialement attachés à la maison, et aux personnes munies de permissions pour visiter les prisonniers, et attendant, suivant leur numéro d’ordre, leur tour d’aller au parloir."
                            }
                        ]
                    },
                    {
                        "sense_id": "67e5291a-0847-3520-a91b-a70fc27af8eb",
                        "entry_id": "f6d9dfd0-95a2-3a30-932d-f11c19bb657d",
                        "glosses": [
                            "Funérarium, chambre funéraire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8295c57-3a57-4a78-b4e0-cabf6838ced4",
                                "sense_id": "67e5291a-0847-3520-a91b-a70fc27af8eb",
                                "text": "Beaucoup de fils d’entrepreneurs de pompes funèbres la courtisaient, essayant de l’amadouer pour que le parloir de leur père ait une meilleure position dans les pages nécrologiques ou au moins une extension du temps de parution."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4856a163-ca07-4fd1-86be-e02adaa4017e",
                        "source_entry_id": "f6d9dfd0-95a2-3a30-932d-f11c19bb657d",
                        "source_sense_description": "1",
                        "target_lang_word": "Besucherzimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Besucherzimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d1f6510-23a9-3818-8a72-4b232ba602f8",
                                        "entry_id": "54bfb87c-e428-3bfa-82c9-672dd6b69e25",
                                        "glosses": [
                                            "Raum, in dem sich Besucher vorübergehend aufhalten können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14c5b1a1-237d-48af-af3f-15e3b43aa1ca",
                                                "sense_id": "7d1f6510-23a9-3818-8a72-4b232ba602f8",
                                                "text": "„Die junge Schwester, die danach vor der Pforte heransegelte, führte ihn über mehrere Flure in das Besucherzimmer der Klinik.“"
                                            },
                                            {
                                                "example_id": "2b0b77f5-b5f2-44fd-9e22-920cf3072f8c",
                                                "sense_id": "7d1f6510-23a9-3818-8a72-4b232ba602f8",
                                                "text": "„Das Besucherzimmer war klein.“"
                                            },
                                            {
                                                "example_id": "543c55a9-179b-4206-babd-1986ad30ef1a",
                                                "sense_id": "7d1f6510-23a9-3818-8a72-4b232ba602f8",
                                                "text": "„Das Besucherzimmer war versperrt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c35e35e-aa4e-4a5a-a4f7-f398d92a32e6",
                        "source_entry_id": "f6d9dfd0-95a2-3a30-932d-f11c19bb657d",
                        "source_sense_description": "1",
                        "target_lang_word": "Besuchszimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Besuchszimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "452b8092-c9e3-36ff-af25-42290a6fe508",
                                        "entry_id": "35795df6-5f1b-3a5f-9457-4c4a07e9964c",
                                        "glosses": [
                                            "Raum in einer öffentlichen Einrichtung, in dem Besuch empfangen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7935900d-8547-4bef-b82a-3c46ab261771",
                                                "sense_id": "452b8092-c9e3-36ff-af25-42290a6fe508",
                                                "text": "„Dann, eines Tages, ließ er Lea zu sich kommen, blieb im Besuchszimmer lange vor ihr stehen, legte endlich den Arm um ihre Schulter.“"
                                            },
                                            {
                                                "example_id": "42964c04-3d79-43e2-9a48-a9ff454abf74",
                                                "sense_id": "452b8092-c9e3-36ff-af25-42290a6fe508",
                                                "text": "„Dieses Drawingroom oder Besuchszimmer, durch zwei große Flügeltüren in zwei gleiche Hälften geteilt, schien, die Wahrheit zu gestehen, um vieles weniger republikanisch zu sein als sein schlichter, obgleich würdevoller Besitzer, der Oberst Parker.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55920ddb-b139-4dc2-adcc-32dc859e6020",
                        "source_entry_id": "f6d9dfd0-95a2-3a30-932d-f11c19bb657d",
