                                "target_senses": [
                                    {
                                        "sense_id": "2ecb1d1d-f78a-3439-bd58-d04af47ada12",
                                        "entry_id": "d24d1366-eb60-39d0-8804-22f72260b91c",
                                        "glosses": [
                                            "Fine; of superior quality."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3eb5549-50bf-40b1-8115-1d32b39b4194",
                                                "sense_id": "2ecb1d1d-f78a-3439-bd58-d04af47ada12",
                                                "text": "We need to go to the gourmet grocery store to get the exotic ingredients for this recipe."
                                            },
                                            {
                                                "example_id": "1330b9c6-491e-47a0-b449-cb4c5b5dc8b2",
                                                "sense_id": "2ecb1d1d-f78a-3439-bd58-d04af47ada12",
                                                "text": "The restaurant offered gourmet coffee and cigars after the meal."
                                            },
                                            {
                                                "example_id": "9e5aec0e-c632-4d54-835f-8971da4aac12",
                                                "sense_id": "2ecb1d1d-f78a-3439-bd58-d04af47ada12",
                                                "text": "[On the coffee] Mmm! God damn, Jimmie! This is some serious gourmet shit!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gourmet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f0c8fff-5e43-35ca-958e-70807c0838f5",
                                        "entry_id": "51a1c672-b4fd-3e9e-927f-fca8da74fb6e",
                                        "glosses": [
                                            "A connoisseur in eating and drinking; someone who takes their food seriously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04fa427a-dca3-4b85-b58b-682a927e2942",
                                                "sense_id": "7f0c8fff-5e43-35ca-958e-70807c0838f5",
                                                "text": "The vulvae of the sow were popular as a gourmet's dish. Credited with erotic effects."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a6c5334-a68f-40ae-b473-f0b9a7365277",
                        "source_entry_id": "911f75fc-5aba-3856-9996-6d023644a950",
                        "source_sense_id": "df2ea665-c0a0-3516-9c64-13b230ee3dec",
                        "target_lang_word": "gourmet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gourmet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea596c95-7907-312b-a036-ecea71f1dc75",
                                        "entry_id": "2ae72b6d-7515-3677-8391-5c9353cf407c",
                                        "glosses": [
                                            "Qui sait apprécier les vins, en a une bonne connaissance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9bd348c-8362-4667-b2a2-8d9893b50eb3",
                                                "sense_id": "ea596c95-7907-312b-a036-ecea71f1dc75",
                                                "text": "Les autres ne travaillent, au contraire, que pour obtenir des produits abondans, parce que la classe des acheteurs, sur lesquels ils fondent leur spéculation, est toujours assez nombreuse et assez peu gourmette, pour rendre certaine la vente des récoltes les plus abondantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b25f8a6d-b25c-34d9-b2ff-e6fb31d058d3",
                                        "entry_id": "2ae72b6d-7515-3677-8391-5c9353cf407c",
                                        "glosses": [
                                            "Qui apporte dans les choses de la table une recherche de délicatesse et de raffinement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "849d493c-d198-4f79-bcd9-f6adc03a078c",
                                                "sense_id": "b25f8a6d-b25c-34d9-b2ff-e6fb31d058d3",
                                                "text": "Mon estomac, remarquablement conservé, est celui d’une bourgeoise gourmette et gourmande."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gourmet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26e38318-c0db-3d8d-88eb-72d52b1a3234",
                                        "entry_id": "2f483c7b-0d26-3eb1-952e-3fc3bf2ca035",
                                        "glosses": [
                                            "Celui qui, en dégustant le vin, sait en déterminer la provenance, la date et les diverses caractéristiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec931bdd-ed2c-4c99-9cb1-43fadacb6587",
                                                "sense_id": "26e38318-c0db-3d8d-88eb-72d52b1a3234",
                                                "text": "Il y avait à Bercy des gourmets, courtiers piqueurs de vin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15ba7526-7d55-391a-b325-918eeef8d4a1",
                                        "entry_id": "2f483c7b-0d26-3eb1-952e-3fc3bf2ca035",
                                        "glosses": [
                                            "Celui qui apporte dans les choses de la table une recherche de délicatesse et de raffinement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f909522c-ac4f-42dc-98d5-ff8120c6a7d2",
                                                "sense_id": "15ba7526-7d55-391a-b325-918eeef8d4a1",
                                                "text": "On pêche fréquemment dans le Rhône le barbeau et le goujon, quelquefois la truite ordinaire, la truite saumonée et même le saumon, le plus souvent la carpe, le brochet et les deux espèces d'anguilles de nos marais , que distinguent fort bien nos pêcheurs et mieux encore nos gourmets."
                                            },
                                            {
                                                "example_id": "0095d4ee-96a9-4932-b4e5-d6b2fd777f9c",
                                                "sense_id": "15ba7526-7d55-391a-b325-918eeef8d4a1",
                                                "text": "Fins gourmets, les Chinois se délectent d'une holothurie vivant dans les eaux tropicales, la bêche-de-mer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
