                                                "example_id": "e4a0fb72-a78b-4c43-a77d-ea2f78a567a8",
                                                "sense_id": "82e45c2e-478f-3ee1-b29e-f938f16dcb17",
                                                "text": "Wien ist etwa 60 km von Pressburg entfernt."
                                            },
                                            {
                                                "example_id": "baeff010-5114-4d29-b5f7-a80e20e4ac6b",
                                                "sense_id": "82e45c2e-478f-3ee1-b29e-f938f16dcb17",
                                                "text": "In Pressburg schlossen 1805 Österreich und Frankreich Frieden."
                                            },
                                            {
                                                "example_id": "6516e816-6625-4731-88f6-413cb6165fd4",
                                                "sense_id": "82e45c2e-478f-3ee1-b29e-f938f16dcb17",
                                                "text": "„Er schreibt für Zeitungen in Pressburg und Olmütz, wird Sekretär der Liga für Menschenrechte in Brünn, findet seine erste große Liebe, wird ohne Mühe wegen seines eher zufälligen Geburtsorts Deutsch-Diosek bei Pressburg tschechoslowakischer Staatsbürger, holt seine Eltern und vier Geschwister zu sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfc709de-adb3-445f-8b19-d8bddbefe851",
                        "source_entry_id": "8f32da01-8cc0-3349-8215-942b2ad5fe95",
                        "source_sense_id": "1ee0932c-0966-3195-b7ca-024380a879a9",
