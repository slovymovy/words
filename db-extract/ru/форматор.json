                "senses": [
                    {
                        "sense_id": "3034addb-98fa-3764-8e14-0016d3023730",
                        "entry_id": "f15b323c-8f53-34a5-a958-ac285079de6e",
                        "glosses": [
                            "спец. специалист по отливке статуй"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec3fd7b3-aaa8-4f58-9df2-e34595d34614",
                                "sense_id": "3034addb-98fa-3764-8e14-0016d3023730",
                                "text": "Сейчас в мастерской работает форматор Толя Челноков, формует памятник Володе Полетаеву."
                            }
                        ]
                    },
                    {
                        "sense_id": "09e44042-e12f-3abd-ab3f-6699cfa814e7",
                        "entry_id": "f15b323c-8f53-34a5-a958-ac285079de6e",
                        "glosses": [
                            "полит. в Нидерландах: лицо, назначенное королём для формирования кабинета министров; впоследствии, как правило, лично возглавляет кабинет в качестве премьер-министра, однако может занять в кабинете и другую должность, либо же не занимать никакой"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e46c0c4-020f-44e4-9228-d26d0fdee1e3",
                        "source_entry_id": "f15b323c-8f53-34a5-a958-ac285079de6e",
                        "target_lang_word": "shaper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shaper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3c2094e-1139-3934-990a-2fe9b2619e45",
                                        "entry_id": "18960e89-f3c4-3563-8987-6541a856550b",
                                        "glosses": [
                                            "Any agent that shapes (something), whether literally or figuratively."
                                        ],
                                        "tags": [
                                            "agent"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c08a7424-50ae-4227-a1b6-3b24a7e3d613",
                                                "sense_id": "f3c2094e-1139-3934-990a-2fe9b2619e45",
                                                "text": "one's birth is a shaper of one's fortunes"
                                            },
                                            {
                                                "example_id": "31cacf05-d25d-4d3b-b0f4-5f310d90526f",
                                                "sense_id": "f3c2094e-1139-3934-990a-2fe9b2619e45",
                                                "text": "Considered merely as works of art, these products of the Greek imagination [i.e., Greek tragedies] satisfy our highest conception of form. […] The secret of those old shapers died with them; their wand is broken, their book sunk deeper than ever plummet sounded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3d6c2e5-11c6-3f10-90aa-e9e4e12160a9",
                                        "entry_id": "18960e89-f3c4-3563-8987-6541a856550b",
                                        "glosses": [
                                            "Any agent that shapes (something), whether literally or figuratively.",
                                            "A person who designs and builds surfboards."
                                        ],
                                        "tags": [
                                            "agent"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "802768a7-cd47-3f23-8cb8-4791bebe4b89",
                                        "entry_id": "18960e89-f3c4-3563-8987-6541a856550b",
                                        "glosses": [
                                            "Any agent that shapes (something), whether literally or figuratively.",
                                            "A machine tool in which a single-point cutting tool mounted on a reciprocating ram is traversed across the workpiece linearly. Shapers can generate various shapes, but were most especially employed in generating flat surfaces and keyways. The shaper is nowadays obsolescent, most of its applications being served by milling machines."
                                        ],
                                        "tags": [
                                            "agent"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
