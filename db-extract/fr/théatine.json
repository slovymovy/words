                        "glosses": [
                            "Membre d’un ordre religieux féminin, fondé en 1583 par Ursule Benincasa, et dirigé par les théatins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "395bbd3c-c512-4d45-b0a9-c94791eca0e2",
                                "sense_id": "cdd5eabb-35cb-35a0-8c1f-f63afa81e30a",
                                "text": "On distingue les théatines de la conception et les théatines de l’ermitage. Les unes et les autres ont pour fondatrice la vénérable mère Ursule Bonincasa, née à Naples en 1550. Elle était âgée de trente-trois ans, lorsqu’en 1583 elle donna commencement à son ordre, avec deux de ses sœurs et six de ses nièces."
                            }
                        ]
                    }
