{
    "word_family": [
        "commute",
        "commuter",
        "commutation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f4bdcacb-ec1c-3c9e-bb51-92337107f285",
                    "sense_definition": "The act of traveling regularly between one's home and place of work.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Long daily <w>commuting</w> can be very tiring for office workers.",
                            "target_lang_translations": {
                                "zh": "对于上班族来说，每天长距离的<w>通勤</w>会让人非常疲惫。"
                            }
                        },
                        {
                            "text": "Many people find that <w>commuting</w> by train allows them to read or relax.",
                            "target_lang_translations": {
                                "zh": "许多人发现乘火车<w>通勤</w>时可以阅读或放松。"
                            }
                        }
                    ],
                    "synonyms": [
                        "travel"
                    ],
                    "common_phrases": [
                        "daily commuting",
                        "long commuting"
                    ],
                    "target_lang_definitions": {
                        "zh": "往返于家和工作地点之间的日常通勤行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "通勤",
                                "target_lang_sense_clarification": "指往返于居住地与工作地之间的交通行为。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9616148-23be-3f50-a61b-dcee02ad7380",
                    "sense_definition": "The act of traveling using public transportation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some cities, <w>commuting</w> via jeepney is the most common way to get around.",
                            "target_lang_translations": {
                                "zh": "在一些城市，乘坐吉普尼车<w>公共交通出行</w>是最常见的出行方式。"
                            }
                        },
                        {
                            "text": "The city is trying to improve public <w>commuting</w> options for all residents.",
                            "target_lang_translations": {
                                "zh": "该市正努力为所有居民改善<w>公共交通出行</w>的选择。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in the Philippines"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使用公共交通工具出行的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "公共交通出行",
                                "target_lang_sense_clarification": "指利用公共交通系统进行日常往返。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d19cdf21-23a3-31f7-bf08-619f4b11e9ff",
                    "sense_definition": "Present participle and gerund of <w>commute</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>commuting</w> to the city center every morning for her job.",
                            "target_lang_translations": {
                                "zh": "她每天早上都<w>通勤</w>到市中心上班。"
                            }
                        },
                        {
                            "text": "He spends two hours <w>commuting</w> by bus to reach the university.",
                            "target_lang_translations": {
                                "zh": "他每天花两个小时乘公交车<w>通勤</w>去大学。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指往返于家和工作或学习地点。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "通勤",
                                "target_lang_sense_clarification": "动词用法，指往返于工作或学习地点。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "de1cd2ef-44a4-31c5-bea1-57a753fc6f15",
                    "sense_definition": "Relating to the process of changing or reducing a penalty or obligation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge considered the <w>commuting</w> sentence as part of the legal review.",
                            "target_lang_translations": {
                                "zh": "法官将<w>减刑</w>判决视为法律审查的一部分。"
                            }
                        },
                        {
                            "text": "There was a <w>commuting</w> agreement between the two parties to settle the debt.",
                            "target_lang_translations": {
                                "zh": "双方达成了一项关于<w>减轻</w>债务义务的协议。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "与减刑或减轻义务相关的过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "减刑的",
                                "target_lang_sense_clarification": "法律术语，指减轻刑罚或义务。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}