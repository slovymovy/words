                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a355c53-db8e-4358-a6d5-961478e69d11",
                                                "sense_id": "2ae47598-9736-3ae9-88e5-0349e74fd43b",
                                                "text": "Dorsett came up the stairs, buggy whip in hand. He bustled into the office in his usual self-important way. Frank noticed that the old clerk sat down on him promptly. He was not one bit impressed with the bombastic visitor from Greenville."
                                            }
