                                        "entry_id": "3859dd93-feb9-3756-9a68-0c09425f287a",
                                        "glosses": [
                                            "Remède contre le tétanos."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
