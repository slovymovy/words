    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "43796fcc-0947-3227-94ed-70a474d06a2a",
                    "sense_definition": "Abbreviation of <w>corporal</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military_rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Cpl</w> gave orders to the squad during the training exercise.",
                            "target_lang_translations": {
                                "ru": "<w>Капрал</w> отдал приказы отряду во время тренировочных учений."
                            }
                        },
                        {
                            "text": "A <w>Cpl</w> is responsible for leading a small team of soldiers.",
                            "target_lang_translations": {
                                "ru": "<w>Капрал</w> отвечает за руководство небольшой группой солдат."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Cpl Smith"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used primarily in military contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от звания капрал."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капрал",
                                "target_lang_sense_clarification": "воинское звание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc2e3f6e-21f1-30d6-a723-832c8cd947cc",
                    "sense_definition": "Abbreviation of <w>couple</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will be there in a <w>cpl</w> of minutes.",
                            "target_lang_translations": {
                                "ru": "Я буду там через <w>пару</w> минут."
                            }
                        },
                        {
                            "text": "He finished a <w>cpl</w> of tasks before lunch.",
                            "target_lang_translations": {
                                "ru": "Он закончил <w>несколько</w> задач перед обедом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "a cpl of"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in informal writing or text messaging."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от слова пара или несколько."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пара",
                                "target_lang_sense_clarification": "небольшое количество"
                            },
                            {
                                "target_lang_word": "несколько",
                                "target_lang_sense_clarification": "неопределенное количество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc58968d-3009-3589-9f2a-256e094580ff",
                    "sense_definition": "Initialism of concealed pistol license.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must carry your <w>CPL</w> whenever you are carrying a concealed weapon.",
                            "target_lang_translations": {
                                "ru": "Вы должны иметь при себе <w>разрешение на скрытое ношение оружия</w>, когда носите скрытое оружие."
                            }
                        },
                        {
                            "text": "The application process for a <w>CPL</w> requires a background check.",
                            "target_lang_translations": {
                                "ru": "Процесс подачи заявления на <w>разрешение на скрытое ношение оружия</w> требует проверки биографических данных."
                            }
                        }
                    ],
                    "common_phrases": [
                        "apply for CPL"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицензия на скрытое ношение оружия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрешение на скрытое ношение оружия",
                                "target_lang_sense_clarification": "юридический документ"
                            }
                        ]
                    }
                }
            ]
        },
        {
