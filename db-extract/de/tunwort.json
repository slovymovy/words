                ],
                "senses": [
                    {
                        "sense_id": "95d905b8-4925-32c7-8979-8c64407ee306",
                        "entry_id": "e29b0c5d-f76a-3d15-9931-eb4c5eee18bc",
                        "glosses": [
                            "Wort, mit dem eine Handlung (zum Beispiel spielen, lachen, werfen), ein Zustand (glänzen, sich auflösen) oder ein Geschehen (regnen, schneien) ausgedrückt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a064a17-a30f-4fab-8445-3e555a55bc71",
                                "sense_id": "95d905b8-4925-32c7-8979-8c64407ee306",
                                "text": "In dem Satz „Ich gehe nach Hause“ ist „gehe“ das Tunwort."
                            },
                            {
                                "example_id": "976fa3de-3b92-4aaa-8373-46cfe6ecacae",
                                "sense_id": "95d905b8-4925-32c7-8979-8c64407ee306",
                                "text": "Tunwort bedeutet, dass diese Wörter vielfach eine Handlung, ein Tun, bezeichnen."
                            },
                            {
                                "example_id": "ee0d6e29-cb0c-4d9f-8deb-0e419565b5f6",
                                "sense_id": "95d905b8-4925-32c7-8979-8c64407ee306",
                                "text": "Tunwörter konjugieren nach Person, Numerus, Tempus und Modus."
                            },
                            {
                                "example_id": "74223370-4c46-4116-b976-d2121dc95cf1",
                                "sense_id": "95d905b8-4925-32c7-8979-8c64407ee306",
                                "text": "Die Ausdrücke Tunwort und Tuwort werden vor allem im Anfangsunterricht in Grammatik verwendet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
