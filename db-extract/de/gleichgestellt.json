                            {
                                "example_id": "29289b9e-adf4-4968-a6dd-be1b7badd14b",
                                "sense_id": "c5544de4-2500-3d52-9e5b-5d99d031a547",
                                "text": "„Um sich für eine bessere Bezahlung einsetzen zu können, müssten gerade Berufseinsteiger aber wissen, was gleichgestellte Kollegen verdienen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
