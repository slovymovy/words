    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1622e3bf-360a-30f5-9b74-78848a20c748",
                    "sense_definition": "Designed so that either side can be worn or used facing outward.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reversible_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a <w>reversible</w> jacket that is black on one side and red on the other."
                        },
                        {
                            "text": "This <w>reversible</w> belt has a rotating buckle so you can switch between brown and black."
                        }
                    ],
                    "common_phrases": [
                        "reversible jacket",
                        "reversible belt"
                    ]
                },
                {
                    "sense_id": "71db960d-3dbd-39b4-bd74-1fa6be450dbe",
                    "sense_definition": "Capable of returning to the original condition, or able to be undone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "undoable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fortunately, the damage caused by the medication was mild and completely <w>reversible</w>."
                        },
                        {
                            "text": "Early stages of the disease can cause changes that are still <w>reversible</w> with proper treatment."
                        }
                    ],
                    "antonyms": [
                        "irreversible"
                    ],
                    "common_phrases": [
                        "reversible damage",
                        "reversible change"
                    ]
                },
                {
                    "sense_id": "a17bb327-6cb0-39fd-a75d-c134ad75785c",
                    "sense_definition": "Capable of proceeding, operating, or traveling in either direction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "two_directional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city introduced a <w>reversible</w> lane to ease morning traffic heading into downtown."
                        },
                        {
                            "text": "In a <w>reversible</w> chemical reaction, the products can react together to form the original reactants."
                        }
                    ],
                    "common_phrases": [
                        "reversible lane",
                        "reversible reaction"
                    ]
                },
                {
                    "sense_id": "bf7ff374-370e-326e-9d07-4a2ed7b0731e",
                    "sense_definition": "Referring to an idealized thermodynamic process that can be reversed without net increase of entropy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "scientific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A Carnot cycle consists of four ideally <w>reversible</w> processes occurring in sequence."
                        },
                        {
                            "text": "No real thermodynamic system is completely <w>reversible</w> due to friction and other dissipations."
                        }
                    ],
                    "antonyms": [
                        "irreversible"
                    ],
                    "common_phrases": [
                        "reversible process"
                    ]
                },
                {
                    "sense_id": "bf42e1e4-8483-320e-a986-1bfb0e6f2f99",
                    "sense_definition": "Serious enough to justify an appellate court overturning a lower court's judgment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge's failure to instruct the jury on self-defense constituted <w>reversible</w> error."
                        },
                        {
                            "text": "The defense attorney argued that admitting the contested evidence was a <w>reversible</w> mistake."
                        }
                    ],
                    "common_phrases": [
                        "reversible error"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a8adfdc1-9ef4-3bac-b670-4ab5bf91dec9",
                    "sense_definition": "A garment, such as a coat or vest, made to be worn with either side turned outwards.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "reversible_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She packed light for the trip by taking a warm <w>reversible</w> with contrasting patterns."
                        },
                        {
                            "text": "This stylish <w>reversible</w> provides two distinct looks while keeping you warm."
                        }
                    ]
                }
            ]
        }
    ]
