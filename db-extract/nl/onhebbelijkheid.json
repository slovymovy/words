                "senses": [
                    {
                        "sense_id": "9c201883-f92c-3c21-b8b3-8da32853cb9a",
                        "entry_id": "834ee6fc-9e8d-3198-a5a1-b97ff340280c",
                        "glosses": [
                            "het ongemanierd, onvriendelijk, onaangenaam en onbeschoft zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e40374c2-4124-4f5b-9226-9082fd01805a",
                                "sense_id": "9c201883-f92c-3c21-b8b3-8da32853cb9a",
                                "text": "En hij neuriede tijdens het spelen, een ongeneeslijke onhebbelijkheid, je kunt het horen op zijn studio-opnames, misschien wel het duidelijkst op de Goldbergvariaties van 1981, een bijna rampzalig storend geneurie, of een soort onbewust meezingen, het dreef de geluidstechnici tot wanhoop"
                            },
                            {
                                "example_id": "631164d4-9045-446e-99e8-d5aeec34c165",
                                "sense_id": "9c201883-f92c-3c21-b8b3-8da32853cb9a",
                                "text": "De voetbalcarrière van Maradona werd ontsierd door twee schorsingen wegens cocaïnegebruik, een onhebbelijkheid die zich voortzette nadat hij zijn actieve loopbaan had beëindigd. Hij haalde meer dan eens het nieuws door gezondheidsproblemen, het gevolg van zijn ongezonde levensstijl, en extraverte gedrag in en buiten (schieten naar paparazzi) de stadions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db7a5ae2-a6a3-46e8-b53e-8ffc7713a634",
                        "source_entry_id": "834ee6fc-9e8d-3198-a5a1-b97ff340280c",
                        "source_sense_id": "9c201883-f92c-3c21-b8b3-8da32853cb9a",
                        "source_sense_description": "het ongemanierd, onvriendelijk, onaangenaam en onbeschoft zijn",
                        "target_lang_word": "rudeness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rudeness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                        "entry_id": "f0e42476-f1ad-301d-bb2a-41a87e183248",
                                        "glosses": [
                                            "The property of being rude."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42eb88f4-086a-4f56-b6fa-59ec8f692701",
                                                "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                                "text": "His rudeness was inexcusable."
                                            },
                                            {
                                                "example_id": "46cde39f-45b4-4e68-9e66-24bd843d8d29",
                                                "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                                "text": "The rudeness of the cabin gave it a rustic charm but little comfort."
                                            },
                                            {
                                                "example_id": "e833ba91-26f7-4879-87c3-1d4c4a3e8e16",
                                                "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                                "text": "The house was apparently very old; it had an almost prehistoric look about it, so rude and weatherbeaten was it, but the rudeness of the masonry and the lichening of the stones were no real indications of antiquity […]"
                                            },
                                            {
                                                "example_id": "e4afbf98-c900-4029-988c-7bdc0b17f05e",
                                                "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                                "text": "The woman who deliberately yelled out in the second set, when Henin was about to serve at 5-3 for the championship, was the epitome of the absolute self-centered rudeness that was exhibited at the Open, as well as in our society today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b803c9e7-fa71-326d-a3c5-b8686d5737eb",
                                        "entry_id": "f0e42476-f1ad-301d-bb2a-41a87e183248",
                                        "glosses": [
                                            "A rude remark or behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0c48072-9ab4-4cfb-884d-38226ad61fea",
                                                "sense_id": "b803c9e7-fa71-326d-a3c5-b8686d5737eb",
                                                "text": "I'm sick of his rudenesses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ba816ed-a495-45e6-aeb5-df63179b0a58",
                        "source_entry_id": "834ee6fc-9e8d-3198-a5a1-b97ff340280c",
                        "source_sense_id": "9c201883-f92c-3c21-b8b3-8da32853cb9a",
                        "source_sense_description": "het ongemanierd, onvriendelijk, onaangenaam en onbeschoft zijn",
                        "target_lang_word": "unmannerliness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unmannerliness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9182e817-634b-3575-91a9-6603864e41c8",
                                        "entry_id": "f49585c2-612c-3c66-a1c8-4fe441b55038",
                                        "glosses": [
                                            "The quality of being unmannerly; rudeness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14efb3b3-c1ff-4a5b-9495-2db1b0395e14",
                                                "sense_id": "9182e817-634b-3575-91a9-6603864e41c8",
                                                "text": "Half-scornful amusement, perhaps, and the contempt of the man who has done what man may do for the yoke-fellow who habitually made claim to supernatural prowess; in addition to the scholar's condemnation of blatant ignorance, the courtier's dislike of unmannerliness, the soldier's scorn of unproved deeds, athwart all the philosophic smile!"
                                            },
                                            {
                                                "example_id": "4d190933-5240-487f-a4f3-08d6ff495ea2",
                                                "sense_id": "9182e817-634b-3575-91a9-6603864e41c8",
                                                "text": "That's what I say!\" Mr. Vetch did his best to soothe his angry spouse; I fear he suffered a good deal at times from her unmannerliness, though to be sure she was an excellent housewife and had a heart of gold."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
