                    "frequency": "VeryLow",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die arrogante <w>snoeshaan</w> liep de hele avond over zijn rijkdom op te scheppen.",
                            "target_lang_translations": {
                                "fr": "Cet arrogant <w>fanfaron</w> a passé toute la soirée à se vanter de sa richesse."
