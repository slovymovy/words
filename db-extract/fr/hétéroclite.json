                    {
                        "translation_id": "f191a5c3-235a-4ed6-b35a-6bf847035852",
                        "source_entry_id": "337ac1c5-3e6a-3b9b-baf3-36121ed2a055",
                        "source_sense_id": "275b6a4a-5f07-31d4-bfea-27d8c0263c9a",
