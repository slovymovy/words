    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9bf02c5b-e35d-398a-8d79-1eb9078d0d37",
                "word": "bondman",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5b206ed8-839f-40c0-9f9a-77fc73042bf9",
                        "entry_id": "9bf02c5b-e35d-398a-8d79-1eb9078d0d37",
                        "tags": [
                            "plural"
                        ],
                        "form": "bondmen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eeceaa06-af8b-335f-a193-4dc7f05068a8",
                        "entry_id": "9bf02c5b-e35d-398a-8d79-1eb9078d0d37",
                        "glosses": [
                            "A man who is bound in servitude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bf14b3c-294e-4b72-a128-8ec4d50150ae",
                                "sense_id": "eeceaa06-af8b-335f-a193-4dc7f05068a8",
                                "text": "Shall I bend low, and in a bond-mans key\n With bated breath, and whiſpring humbleneſſe,\n Say this:"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39c5d304-9d46-4c78-8a7f-45d53f2dd27d",
                        "source_entry_id": "9bf02c5b-e35d-398a-8d79-1eb9078d0d37",
                        "source_sense_id": "eeceaa06-af8b-335f-a193-4dc7f05068a8",
                        "source_sense_description": "man bound in servitude",
                        "target_lang_word": "esclave",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esclave",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f529d847-cfbe-324b-9e0d-cbc0ae240ae7",
                                        "entry_id": "448ed1d1-3a5f-36da-bb3e-ab8707d4eb32",
                                        "glosses": [
                                            "Celui ou celle qui par sa naissance ou par sa capture n’est pas de condition libre ou que la violence a mis sous la puissance absolue d’un maître."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9043ce8-29ca-4bd4-a7ef-3459c61edda2",
                                                "sense_id": "f529d847-cfbe-324b-9e0d-cbc0ae240ae7",
                                                "text": "Le second document n’est pas plus exact que le premier, car il ne dit pas si tous les esclaves entrés dans le port de Rio ont été le produit d’un commerce direct entre cette place et l’Afrique."
                                            },
                                            {
                                                "example_id": "ca8f630e-e621-4af7-b8be-f74a2adc2290",
                                                "sense_id": "f529d847-cfbe-324b-9e0d-cbc0ae240ae7",
                                                "text": "Dans les premiers âges historiques, on ne voit pas seulement les maîtres frapper et fouetter leurs esclaves ; les rois eux-mêmes administrent le supplice de la bastonnade."
                                            },
                                            {
                                                "example_id": "619dc973-498a-42f2-88ea-af184348c750",
                                                "sense_id": "f529d847-cfbe-324b-9e0d-cbc0ae240ae7",
                                                "text": "Le Concile de Mâcon (581) recommande aux chrétiens de racheter les esclaves chrétiens servant chez les juifs, pour le prix de 12 sols."
                                            },
                                            {
                                                "example_id": "117c9017-8f29-4a03-87dc-c1206f4f77bd",
                                                "sense_id": "f529d847-cfbe-324b-9e0d-cbc0ae240ae7",
                                                "text": "Les marchés d’esclaves les plus importants étaient ceux de Fez et de Marrakech. Je n’ai vu que ce dernier."
                                            },
                                            {
                                                "example_id": "94bb3472-b00c-4d6c-b9c5-4a9f7e697262",
                                                "sense_id": "f529d847-cfbe-324b-9e0d-cbc0ae240ae7",
                                                "text": "La masse servile, issue des deux dernières castes, représente près de 10 % de la population, faisant de la Mauritanie le pays qui connaît le taux d’esclaves le plus élevé au monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86e933bf-dcc4-36de-bc82-1b13a14ddfd7",
                                        "entry_id": "448ed1d1-3a5f-36da-bb3e-ab8707d4eb32",
                                        "glosses": [
                                            "Prolétaire opprimé et exploité."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "994290bd-0fca-4c1d-a370-68c0346cbcd5",
                                                "sense_id": "86e933bf-dcc4-36de-bc82-1b13a14ddfd7",
                                                "text": "Enfin, c’est celui qui veut remplacer la loi tutélaire de la majorité par l'arbitraire tyrannique du petit nombre, faire le peuple esclave du parti & écraser la démocratie tout entière sous une despotique kakistocratie."
                                            },
                                            {
                                                "example_id": "cb73b4c4-5cc1-4f1b-b129-1486f1d0a4f5",
                                                "sense_id": "86e933bf-dcc4-36de-bc82-1b13a14ddfd7",
                                                "text": "Au vrai j’entrevoyais que le conflit politique était le même en tous pays, et qu’il n’était autre qu’une révolte des esclaves contre les maîtres, chose qu’il fallait attendre, après cette tuerie imbécile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bffe65ae-623c-396a-91bb-75d0504bab06",
                                        "entry_id": "448ed1d1-3a5f-36da-bb3e-ab8707d4eb32",
                                        "glosses": [
                                            "Personne qu'on traite comme étant entièrement à sa disposition, sans liberté aucune."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2d294b3-6d4c-42af-89ba-c61681c672cd",
                                                "sense_id": "bffe65ae-623c-396a-91bb-75d0504bab06",
                                                "text": "« Il place ses amis, on est dégoûtés! De toute façon, tu ne peux être que son ennemi ou son esclave », fulmine l'un, outré de la nomination de deux très proches de Wauquiez, …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4911297f-ae4b-3bc7-bf20-3deb5f443944",
                                        "entry_id": "448ed1d1-3a5f-36da-bb3e-ab8707d4eb32",
                                        "glosses": [
                                            "Personne qui, par amour, se met dans la dépendance de quelqu’un et suit aveuglément ses volontés."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cb8e8ec-ec42-4d26-8dee-d3b37666587d",
                                                "sense_id": "4911297f-ae4b-3bc7-bf20-3deb5f443944",
                                                "text": "Yasmina pria Chérif de répondre à Jacques qu’elle aussi l’aimait toujours, qu’elle lui resterait fidèle tant qu’elle vivrait, qu’elle restait son esclave soumise et aimante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f88b5ad-c5b0-3e67-a50d-5e920c8f3616",
                                        "entry_id": "448ed1d1-3a5f-36da-bb3e-ab8707d4eb32",
                                        "glosses": [
                                            "Personne ayant apparemment abandonné sa liberté au profit d'une passion, d'une idée, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d181824-09e9-433b-a0db-49a5341a688e",
                                                "sense_id": "7f88b5ad-c5b0-3e67-a50d-5e920c8f3616",
                                                "text": "Doux esclave de ses habitudes, l’idée seule de l’imprévu le faisait se recroqueviller prudemment, comme si quelque gros nuage menaçait de répandre son déluge sur la divine monotonie des choses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c73fcd60-89e2-3ec4-8ee2-6c0810e1f62e",
                                        "entry_id": "448ed1d1-3a5f-36da-bb3e-ab8707d4eb32",
                                        "glosses": [
                                            "Élément vers lequel on synchronise, par opposition au maître."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "esclave",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0a91252-ac8b-32e7-a1be-a7835f7a552b",
                                        "entry_id": "edd3df41-8078-3491-b87e-93e2efe6355d",
                                        "glosses": [
                                            "Langue amérindienne de la famille dénée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beaf0830-e710-4950-a3d7-12e8aac30860",
                                                "sense_id": "b0a91252-ac8b-32e7-a1be-a7835f7a552b",
                                                "text": "La plupart des langues dénées (ou athabascanes) sont menacées, même si le chipewyan, l’esclave, le dogrib et le gwich’in sont langues officielles dans les Territoires du Nord-Ouest."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "esclave",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e878f564-f5f7-3945-902d-603ee7ae9828",
                                        "entry_id": "a66a4811-a883-36cd-a3d8-e544fd294263",
                                        "glosses": [
                                            "Soumis, servile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0236ebe8-ed87-4afe-aec6-0aab940adf02",
                                                "sense_id": "e878f564-f5f7-3945-902d-603ee7ae9828",
                                                "text": "Avoir une âme esclave."
                                            },
                                            {
                                                "example_id": "93dd4bcf-fe4e-49cd-838f-b3f78c4ef4f2",
                                                "sense_id": "e878f564-f5f7-3945-902d-603ee7ae9828",
                                                "text": "Être esclave, être tellement attaché au service de quelqu’un, ou à quelque emploi, qu’on ne peut s’éloigner, ni faire autre chose."
                                            },
                                            {
                                                "example_id": "6a497d1a-9621-49ae-bc9e-2b663c301d2f",
                                                "sense_id": "e878f564-f5f7-3945-902d-603ee7ae9828",
                                                "text": "On est esclave auprès de ce maître-là."
                                            },
                                            {
                                                "example_id": "84410221-e1e3-4d24-9e47-708d0480b34b",
                                                "sense_id": "e878f564-f5f7-3945-902d-603ee7ae9828",
                                                "text": "Être esclave de la faveur, être esclave de ses intérêts, de ses passions, faire tout pour la faveur, pour ses intérêts, pour satisfaire ses passions."
                                            },
                                            {
                                                "example_id": "d022f99a-be00-47a4-abf5-1465f99f6eb1",
                                                "sense_id": "e878f564-f5f7-3945-902d-603ee7ae9828",
                                                "text": "Elles étaient vêtues à la mode de la saison prochaine, chose fatale, menaçant toute étrangère esclave de certains journaux, qui ont plutôt pour habitude de prédire les modes que de les indiquer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "939dc452-a550-312b-b2ee-e71da94b2c06",
                                        "entry_id": "a66a4811-a883-36cd-a3d8-e544fd294263",
                                        "glosses": [
                                            "Qualifie une personne est attachée à ses devoirs ou à ses promesses."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5679e075-d8ec-46e1-8bb6-b743d808d3be",
                                                "sense_id": "939dc452-a550-312b-b2ee-e71da94b2c06",
                                                "text": "Il savait que son futur beau-père était avant tout l’homme du devoir, esclave de tous ses engagements et incapable de manquer à un rendez-vous d’affaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7cb0307-cf07-4b55-9e3e-de4b21e766a8",
                        "source_entry_id": "9bf02c5b-e35d-398a-8d79-1eb9078d0d37",
                        "source_sense_id": "eeceaa06-af8b-335f-a193-4dc7f05068a8",
                        "source_sense_description": "man bound in servitude",
                        "target_lang_word": "serf",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "serf",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3de29fee-904c-3bbb-b43e-d1c7e92df0ec",
                                        "entry_id": "bcfefaae-c40c-35db-b1cc-ac47999866c6",
                                        "glosses": [
                                            "Homme attachés au domaine qu’ils cultivent moyennant redevance au seigneur qui en est le propriétaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "811f33c8-9f1c-441f-a17c-fdc6f98ed282",
                                                "sense_id": "3de29fee-904c-3bbb-b43e-d1c7e92df0ec",
                                                "text": "Je suis riche, Hedwige, immensément riche, mais à la façon des seigneurs moldaves : riche de terres, de troupeaux, de serfs. Eh bien ! j’ai vendu au monastère de Hango pour un million de terres, de troupeaux, de villages."
                                            },
                                            {
                                                "example_id": "b0dceed4-e377-467f-b193-328f04e09f85",
                                                "sense_id": "3de29fee-904c-3bbb-b43e-d1c7e92df0ec",
                                                "text": "[…], et la plupart d’entre eux, au XIIᵉ siècle surtout, sont encore des serfs : dans la commune de Senlis, fondée par le roi en 1173, l’évêque a encore des mainmortables ; […]."
                                            },
                                            {
                                                "example_id": "94e5ec89-9b27-4fca-9ab8-8c096b25e421",
                                                "sense_id": "3de29fee-904c-3bbb-b43e-d1c7e92df0ec",
                                                "text": "Selon la coutume qui avait encore force de loi en Franche-Comté (et cela, disait Voltaire, est contradictoire avec le nom de cette province), il y avait des serfs, c'est-à-dire des gens de mainmorte, dont la condition était de ne pouvoir disposer de leurs biens et de leur personne."
                                            },
                                            {
                                                "example_id": "e225b977-be94-406f-a7f9-ba86aec66ce7",
                                                "sense_id": "3de29fee-904c-3bbb-b43e-d1c7e92df0ec",
                                                "text": "Il était difficile aux juifs d’échapper à leur sort, car, étant serfs de leurs seigneurs, ils n’avaient pas le droit de se déplacer comme ils l’auraient voulu."
                                            },
                                            {
                                                "example_id": "fb4eea63-ed55-4d21-b838-cc13806fc06d",
                                                "sense_id": "3de29fee-904c-3bbb-b43e-d1c7e92df0ec",
                                                "text": "Les serfs travaillaient sans rémunération sur des terres appartenant à de grands propriétaires terriens."
                                            },
                                            {
                                                "example_id": "d32375b0-2256-4fc6-8b52-0d04eb4bc429",
                                                "sense_id": "3de29fee-904c-3bbb-b43e-d1c7e92df0ec",
                                                "text": "Mais elles vont bientôt se courber et s’asseoir,\nServes du champ pénible et des vives aiguilles ;\nLes vierges ne sont pas, dans les pauvres familles,\nDes colombes qu’un grain nourrit de l’aube au soir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "serf",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6234f82d-75bc-307e-8643-50021439590b",
                                        "entry_id": "42f5d8e9-d82a-3891-82b6-e96a89ed2111",
                                        "glosses": [
                                            "Relatif au servage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d49d069-147b-46c1-9b5e-9b2371859ce8",
                                                "sense_id": "6234f82d-75bc-307e-8643-50021439590b",
                                                "text": "Dans ce monde de pasteurs, la femme n’a nullement la vie serve qu’elle mène dans celui de chasse et de guerre."
                                            },
                                            {
                                                "example_id": "01bf1a8e-9fdd-4e82-a0f7-a81e13a48ac2",
                                                "sense_id": "6234f82d-75bc-307e-8643-50021439590b",
                                                "text": "Ces braves gens devaient être merveilleusement incorporés à la glèbe, et notre ancienne noblesse n’éprouvait assurément que liesse et contentement à tailler et mortailler une nature aussi débonnairement serve."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9eb98335-78f0-4787-84ae-34bd2a961bda",
                        "source_entry_id": "9bf02c5b-e35d-398a-8d79-1eb9078d0d37",
                        "source_sense_id": "eeceaa06-af8b-335f-a193-4dc7f05068a8",
                        "source_sense_description": "man bound in servitude",
                        "target_lang_word": "niewolnik",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "niewolnik",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "807a5351-7aa9-34ee-be58-1293dccc33c2",
                                        "entry_id": "b630e410-f550-37f4-965e-7447cca0ed4e",
                                        "glosses": [
                                            "osoba będąca w niewoli"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2523af4-a728-4abb-b24b-6531ebb67a0b",
                                                "sense_id": "807a5351-7aa9-34ee-be58-1293dccc33c2",
                                                "text": "Niewolnik dzisiaj ciężko pracuje."
                                            },
                                            {
                                                "example_id": "a9dcaac1-3fa7-4e64-959d-329cfd44c1f6",
                                                "sense_id": "807a5351-7aa9-34ee-be58-1293dccc33c2",
                                                "text": "Jednakże ten, u którego puchar się znajdzie, zostanie niewolnikiem, wy zaś będziecie wolni od winy"
                                            },
                                            {
                                                "example_id": "19b27981-54e9-4c31-9587-340dbc6dd953",
                                                "sense_id": "807a5351-7aa9-34ee-be58-1293dccc33c2",
                                                "text": "W Brazylii nie wrócono jeszcze wolności dawnym niewolnikom, ale dzieci ich są już wolne"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "20c105d9-170d-37c4-8bc1-77060cec1710",
                                        "entry_id": "b630e410-f550-37f4-965e-7447cca0ed4e",
                                        "glosses": [
                                            "osoba poddająca się czemuś bezwolnie"
                                        ],
                                        "tags": [
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "793ffa16-facc-4209-ad53-afc5b5875cd0",
                                                "sense_id": "20c105d9-170d-37c4-8bc1-77060cec1710",
                                                "text": "Biedni niewolnicy nikotynizmu zaraz pognali do palarni."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03ddc68d-7618-404a-a488-8bd2d2ce35aa",
                        "source_entry_id": "9bf02c5b-e35d-398a-8d79-1eb9078d0d37",
                        "source_sense_id": "eeceaa06-af8b-335f-a193-4dc7f05068a8",
                        "source_sense_description": "man bound in servitude",
                        "target_lang_word": "раб",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "раб",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e00fb26e-3cd8-364a-9108-206561f6b5c0",
                                        "entry_id": "dd369ed8-3316-3ae8-89ed-cdd981ed050c",
                                        "glosses": [
                                            "истор. представитель низших слоёв общества, бесправный человек, являющийся собственностью рабовладельца"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82499256-9fbc-4e5c-93e0-48b9bd1b9bd2",
                                                "sense_id": "e00fb26e-3cd8-364a-9108-206561f6b5c0",
                                                "text": "«Скажи, что делает твой господин?» ― спросили раба его."
                                            },
                                            {
                                                "example_id": "885b9f9b-8556-47e5-baae-d919ce86c376",
                                                "sense_id": "e00fb26e-3cd8-364a-9108-206561f6b5c0",
                                                "text": "Если кто-то нарушит это предписание, свободный гражданин заплатит штраф, а раба высекут на месте преступления."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab7c8d74-1695-3fac-a4ee-f7a49cc102d7",
                                        "entry_id": "dd369ed8-3316-3ae8-89ed-cdd981ed050c",
                                        "glosses": [
                                            "перен. человек, попавший в зависимость от чего-либо или в подчинение кому-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14b640e2-fc55-4751-a3fc-131ea8f78aac",
                                                "sense_id": "ab7c8d74-1695-3fac-a4ee-f7a49cc102d7",
                                                "text": "Раб привычки."
                                            },
                                            {
                                                "example_id": "bd71634d-4c4d-490d-b50b-05cc57d1c18e",
                                                "sense_id": "ab7c8d74-1695-3fac-a4ee-f7a49cc102d7",
                                                "text": "Раб страстей."
                                            },
                                            {
                                                "example_id": "ffcc205c-80fb-4f21-8df3-10bcf4828930",
                                                "sense_id": "ab7c8d74-1695-3fac-a4ee-f7a49cc102d7",
                                                "text": "Раб идеи."
                                            },
                                            {
                                                "example_id": "43cde596-52d4-4301-ac68-87e0a060e0cf",
                                                "sense_id": "ab7c8d74-1695-3fac-a4ee-f7a49cc102d7",
                                                "text": "Однако мне всегда было странно: я никогда не делался рабом любимой женщины."
                                            },
                                            {
                                                "example_id": "7fb7e482-cc89-46e8-8fa1-a3a5dd4843ba",
                                                "sense_id": "ab7c8d74-1695-3fac-a4ee-f7a49cc102d7",
                                                "text": "― Что же он велел передать тебе, раб? ― Я не раб, ― всё более озлобляясь, ответил Левий Матвей, ― я его ученик."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
