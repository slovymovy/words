                                                "sense_id": "eec327d7-ed3d-32ca-8fe0-a23a7590a505",
                                                "text": "„Dabei häuft sich im Bohrloche ein feiner Staub, das Bohrmehl, an, welches der Arbeiter von Zeit zu Zeit mit dem Krätzer heraus zieht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7bdc934d-0138-32b8-a8ac-98e398258a28",
                                        "entry_id": "c27a533a-600e-369e-8fb5-96e0cfe15643",
                                        "glosses": [
