                                        "glosses": [
                                            "zu Köln gehörig, sich auf diesen Ort beziehend, in der Art und Weise dieses Ortes, aus Köln kommend, stammend, Köln betreffend, zu Köln gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63e668a0-4368-426e-a79a-1eea40bb1719",
                                                "sense_id": "de74b821-91dd-38ce-bbc4-88e4eb6982b8",
                                                "text": "Ein typisches Beispiel für Straßennamen ist „Kölner Straße“."
                                            },
                                            {
                                                "example_id": "69baae48-b061-481c-b263-099a31f4a486",
                                                "sense_id": "de74b821-91dd-38ce-bbc4-88e4eb6982b8",
                                                "text": "„In der Kölner Südstadt gibt es das noch: einen verqualmten Stammtisch wie anno Tobak.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
