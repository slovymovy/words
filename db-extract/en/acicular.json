                    {
                        "translation_id": "12e267dd-50de-417d-8aa0-59ad64225155",
                        "source_entry_id": "0e05fda4-04d2-3c77-81e1-efa5f827f803",
                        "source_sense_description": "having sharp points",
                        "target_lang_word": "остроконечный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "остроконечный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3407ea91-e29d-3cb1-b401-eee52213d8e4",
                                        "entry_id": "8e5c3a5f-1cbd-3b15-9a4d-b49bfb3594ea",
                                        "glosses": [
                                            "имеющий острый или заострённый конец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "747c92fe-956e-441e-8dbd-e30b2736b6a6",
                                                "sense_id": "3407ea91-e29d-3cb1-b401-eee52213d8e4",
                                                "text": "В правой, карающей длани шахиншах держал судейский жезл, в левой ― остроконечный посох с бирюзовым набалдашником."
                                            },
                                            {
                                                "example_id": "d41f1f6f-7a70-488c-99f4-4c2ab67cfae2",
                                                "sense_id": "3407ea91-e29d-3cb1-b401-eee52213d8e4",
                                                "text": "Остроконечный пик, подобно сужающейся колонне, уперся в тяжелую ливневую тучу, словно удерживая её от падения на косматую поверхность океана."
                                            },
                                            {
                                                "example_id": "e3d0e1cb-1ee0-4875-b6c6-0f760823f429",
                                                "sense_id": "3407ea91-e29d-3cb1-b401-eee52213d8e4",
                                                "text": "Само капище представляло из себя частокол резных идолов, за которыми возвышался остроконечный колпак крыши на двенадцати столбах."
                                            },
                                            {
                                                "example_id": "da040ab9-6416-4c23-a392-5b64d9f84e66",
                                                "sense_id": "3407ea91-e29d-3cb1-b401-eee52213d8e4",
                                                "text": "В Древней Греции широкое распространение получил остроконечный фетровый колпак, получивший название «фригийский»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
