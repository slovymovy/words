{
    "word_family": [
        "nest",
        "nested",
        "nester",
        "nestle"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "70cd1bd7-5f4e-39fc-ae2a-21798c17d180",
                    "sense_definition": "The process or activity of a bird or other animal building and using a nest.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "biological_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the spring, we observed the <w>nesting</w> habits of the local robins.",
                            "target_lang_translations": {
                                "ru": "Весной мы наблюдали за повадками местных малиновок во время <w>гнездования</w>."
                            }
                        },
                        {
                            "text": "The beach was closed to protect the <w>nesting</w> grounds of the sea turtles.",
                            "target_lang_translations": {
                                "ru": "Пляж был закрыт для защиты мест <w>гнездования</w> морских черепах."
                            }
                        }
                    ],
                    "synonyms": [
                        "nestage"
                    ],
                    "common_phrases": [
                        "nesting season"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или деятельность птицы или другого животного по строительству и использованию гнезда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнездование",
                                "target_lang_sense_clarification": "биологический процесс"
                            },
                            {
                                "target_lang_word": "витье гнезд",
                                "target_lang_sense_clarification": "процесс постройки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e47c10d-abe6-3d71-8b1a-42fea6d1d070",
                    "sense_definition": "An arrangement where objects are placed one inside another, often to save space.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "arrangement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>nesting</w> of Russian dolls is a classic example of this design.",
                            "target_lang_translations": {
                                "ru": "<w>Вкладывание</w> русских матрешек друг в друга — классический пример такой конструкции."
                            }
                        },
                        {
                            "text": "These <w>nesting</w> tables are perfect for small apartments because they stack together.",
                            "target_lang_translations": {
                                "ru": "Эти <w>вкладывающиеся</w> столики идеально подходят для маленьких квартир, так как они складываются вместе."
                            }
                        }
                    ],
                    "synonyms": [
                        "imbrication"
                    ],
                    "common_phrases": [
                        "nesting tables",
                        "nesting dolls"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположение, при котором предметы вкладываются один в другой, часто для экономии места."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вкладывание",
                                "target_lang_sense_clarification": "один в другой"
                            },
                            {
                                "target_lang_word": "матрешечный принцип",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "600dc291-69b4-301f-b68e-0ad9714d5b6b",
                    "sense_definition": "The practice of placing one self-contained element of code or data inside another of the same type.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Excessive <w>nesting</w> of loops can make your code very difficult to read.",
                            "target_lang_translations": {
                                "ru": "Чрезмерная <w>вложенность</w> циклов может сделать ваш код очень трудным для чтения."
                            }
                        },
                        {
                            "text": "The programmer used deep <w>nesting</w> to organize the complex data structure.",
                            "target_lang_translations": {
                                "ru": "Программист использовал глубокую <w>вложенность</w> для организации сложной структуры данных."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nesting level"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Практика размещения одного автономного элемента кода или данных внутри другого того же типа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вложенность",
                                "target_lang_sense_clarification": "в программировании"
                            },
                            {
                                "target_lang_word": "инкапсуляция",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "36cb073c-ad0b-3ce3-bc5e-e7b4cfe0452d",
                    "sense_definition": "The present participle and gerund of <w>nest</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The birds are <w>nesting</w> in the old oak tree behind our house.",
                            "target_lang_translations": {
                                "ru": "Птицы <w>вьют гнезда</w> на старом дубе за нашим домом."
                            }
                        },
                        {
                            "text": "She spent the weekend <w>nesting</w> by cleaning and organizing the nursery.",
                            "target_lang_translations": {
                                "ru": "Она провела выходные, <w>обустраивая уют</w>, занимаясь уборкой и организацией детской комнаты."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «гнездиться» или «обустраивать уют»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнездящийся",
                                "target_lang_sense_clarification": "о птицах"
                            },
                            {
                                "target_lang_word": "обустройство дома",
                                "target_lang_sense_clarification": "о подготовке к рождению ребенка"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "3176ef59-3ef7-3f2e-9719-743534d26ec2",
                    "sense_definition": "A parish located on the east coast of Mainland in the Shetland Islands, Scotland.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The historic church in <w>Nesting</w> offers a beautiful view of the North Sea.",
                            "target_lang_translations": {
                                "ru": "Из исторической церкви в <w>Нестинге</w> открывается прекрасный вид на Северное море."
                            }
                        },
                        {
                            "text": "Many tourists visit <w>Nesting</w> to experience the rugged beauty of the Shetland coastline.",
                            "target_lang_translations": {
                                "ru": "Многие туристы посещают <w>Нестинг</w>, чтобы насладиться суровой красотой побережья Шетландских островов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Scotland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приход, расположенный на восточном побережье острова Мейнленд в составе Шетландских островов, Шотландия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Нестинг",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ]
                    }
                }
            ]
        }
    ]
