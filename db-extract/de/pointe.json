                "senses": [
                    {
                        "sense_id": "54adc0ce-c896-3121-b985-f7d957c5aa3c",
                        "entry_id": "eaf63d28-c20c-3d6f-8557-8e1144d59d1a",
                        "glosses": [
                            "aufschlussreicher, unvorhergesehener Gipfel/Kulminationspunkt einer Erzählung/Entwicklung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80cac55b-dcd2-4e7f-bb3e-91a67b26377e",
                                "sense_id": "54adc0ce-c896-3121-b985-f7d957c5aa3c",
                                "text": "„Schon die erste Pointe, eigentlich war es nur eine Anspielung, wurde durch ein Gelächter vorweggenommen, das mich erschreckte.“"
                            },
                            {
                                "example_id": "e6187fab-5064-43d7-8d23-e5ddbff48908",
                                "sense_id": "54adc0ce-c896-3121-b985-f7d957c5aa3c",
                                "text": "„Er schwieg, wartete auf die Pointe.“"
                            },
                            {
                                "example_id": "93c921aa-8ff1-4653-9ea8-019b29a80b30",
                                "sense_id": "54adc0ce-c896-3121-b985-f7d957c5aa3c",
                                "text": "„Dieser Punkt ist nicht so bekannt wie die Pointe.“"
                            },
                            {
                                "example_id": "236df982-cfd7-4a41-831c-38526ea60759",
                                "sense_id": "54adc0ce-c896-3121-b985-f7d957c5aa3c",
                                "text": "„Meine Großmutter kniff mir während der Pointe immer in den Oberarm und wiederholte sie mindestens drei Mal.“"
                            },
                            {
                                "example_id": "7b6600ed-2f5b-49df-b3ca-9b47ebec84a0",
                                "sense_id": "54adc0ce-c896-3121-b985-f7d957c5aa3c",
                                "text": "„Der Witzerzähler kann zwar die Witzfabel ändern, doch die Pointe muß stimmen und ist nur bedingt variierbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3db1f3a9-1b58-4277-99de-8cd928585ec8",
                        "source_entry_id": "eaf63d28-c20c-3d6f-8557-8e1144d59d1a",
                        "source_sense_id": "54adc0ce-c896-3121-b985-f7d957c5aa3c",
                        "source_sense_description": "aufschlussreicher, unvorhergesehener Gipfel/Kulminationspunkt einer Erzählung/Entwicklung",
                        "target_lang_word": "punch line",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "punch line",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa058571-cdba-328a-95cc-e338a93d1f00",
                                        "entry_id": "5d0a55b9-4730-30f0-bcfc-451a7f026f32",
                                        "glosses": [
                                            "The final part of a joke; the word, sentence, or exchange of sentences that is intended to be funny and provokes laughter from the listeners."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97a95661-e1a8-4fa0-9b34-81ff3c7569fa",
                                                "sense_id": "fa058571-cdba-328a-95cc-e338a93d1f00",
                                                "text": "That was quite a build-up for such a puny punch line."
                                            },
                                            {
                                                "example_id": "a92e49d6-a566-4217-b3d5-1b1c2bd5cc21",
                                                "sense_id": "fa058571-cdba-328a-95cc-e338a93d1f00",
                                                "text": "While explaining a punchline might initially kill the joke, Roberts claims it can shed light on the use of humour in language and help students remember the gag for future use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdb4c213-2ee8-34c1-bb36-b06724c1a86f",
                                        "entry_id": "5d0a55b9-4730-30f0-bcfc-451a7f026f32",
                                        "glosses": [
                                            "The butt of a joke; laughing stock."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c358db0c-f7fe-4aee-9274-442e10a7ca16",
                                                "sense_id": "bdb4c213-2ee8-34c1-bb36-b06724c1a86f",
                                                "text": "The women are a phenomenon; the men are a punchline."
                                            },
                                            {
                                                "example_id": "51588a03-f38c-49ed-b9b9-52ae1401c0b0",
                                                "sense_id": "bdb4c213-2ee8-34c1-bb36-b06724c1a86f",
                                                "text": "(It didn’t help when Microsoft relaunched its Bing search engine with OpenAI’s technology inside, instantly ending Bing’s decade-long run as a punchline.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c9066b1-c2c6-36d8-b502-dc0764de44bf",
                                        "entry_id": "5d0a55b9-4730-30f0-bcfc-451a7f026f32",
                                        "glosses": [
                                            "A final, concluding statement that an explanation has been leading up to; a conclusion."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "414bb981-bff1-483c-99d2-c932c21b58a8",
                                                "sense_id": "7c9066b1-c2c6-36d8-b502-dc0764de44bf",
                                                "text": "The final, the Munich-based liberal newspaper writes, was a “fitting punchline” to a great tournament."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3977ac9b-8bbc-4027-bd4b-a328ddf7e7fb",
                        "source_entry_id": "eaf63d28-c20c-3d6f-8557-8e1144d59d1a",
                        "source_sense_id": "54adc0ce-c896-3121-b985-f7d957c5aa3c",
                        "source_sense_description": "aufschlussreicher, unvorhergesehener Gipfel/Kulminationspunkt einer Erzählung/Entwicklung",
