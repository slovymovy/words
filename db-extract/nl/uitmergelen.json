                                        "entry_id": "abecaa70-e2b2-3f19-a2ba-438aa35dbc1c",
                                        "glosses": [
                                            "Making a person seem or become slimmer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4518d16-0af8-4c94-8728-6237f6e28423",
                                                "sense_id": "2e34e68c-9c37-3f33-ae6e-fc32c77eb784",
                                                "text": "She bought the jeans without trying them on because the salesperson said they were slimming."
                                            },
                                            {
                                                "example_id": "4fc087e6-2771-49c6-a2d3-1e8442d8fa46",
                                                "sense_id": "2e34e68c-9c37-3f33-ae6e-fc32c77eb784",
                                                "text": "He's trying to lose weight by drinking slimming tea."
                                            },
                                            {
                                                "example_id": "72f7de31-a23c-4d86-a0f7-626119ed3bd7",
                                                "sense_id": "2e34e68c-9c37-3f33-ae6e-fc32c77eb784",
                                                "text": "That dress is very slimming on you."
                                            }
                                        ]
                                    }
