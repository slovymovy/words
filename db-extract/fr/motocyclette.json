        "fr-extract.jsonl": [
            {
                "entry_id": "1274876c-80ca-3dfb-b4b1-231d2d7867fd",
                "word": "motocyclette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ef87a36f-0887-4e18-80f2-7f543b107d1e",
                        "entry_id": "1274876c-80ca-3dfb-b4b1-231d2d7867fd",
                        "tags": [
                            "plural"
                        ],
                        "form": "motocyclettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ac7587e2-10ad-3aad-8b75-9f563c85f80b",
                        "entry_id": "1274876c-80ca-3dfb-b4b1-231d2d7867fd",
                        "glosses": [
                            "Véhicule à deux roues, disposé comme une bicyclette et actionné par un moteur."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "719462ba-f72f-46a3-a497-dacfcf798d4b",
                                "sense_id": "ac7587e2-10ad-3aad-8b75-9f563c85f80b",
                                "text": "L’alcool aidant, le Vélosolex n’arrivait pas à tenir debout ou peut-être son conducteur n’était pas en état de monter sur sa motocyclette."
                            },
                            {
                                "example_id": "5435116d-b39a-4795-a730-d9b36c3b84f9",
                                "sense_id": "ac7587e2-10ad-3aad-8b75-9f563c85f80b",
                                "text": "Il s'agissait de gants, de pompes à vélo, de sacs ou d'écharpes. Jamais encore on n'avait découvert deux motocyclettes."
                            },
                            {
                                "example_id": "a52d7ff1-271b-44a7-88bb-eb02c44ab430",
                                "sense_id": "ac7587e2-10ad-3aad-8b75-9f563c85f80b",
                                "text": "Sans doute étonné par l'absence de nouvelles de Ned, George Brough, le constructeur de motocyclettes, lui a proposé, il y a quelques semaines, la dernière-née de ses ateliers : une nouvelle version du modèle Brough SS 100."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82efb138-4c8b-428d-94ee-79e174dc0801",
                        "source_entry_id": "1274876c-80ca-3dfb-b4b1-231d2d7867fd",
                        "source_sense_id": "ac7587e2-10ad-3aad-8b75-9f563c85f80b",
                        "target_lang_word": "Motorrad",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Motorrad",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "782d42c9-d816-387f-a0b0-91cfbbaaef36",
                                        "entry_id": "510d7e44-7f7f-372b-bf30-e44af4f17092",
                                        "glosses": [
                                            "zweirädriges, einspuriges Fahrzeug mit Antriebsmotor"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74cec6de-8da7-4baa-b6bd-9d1b4241beae",
                                                "sense_id": "782d42c9-d816-387f-a0b0-91cfbbaaef36",
                                                "text": "Das Motorrad stand mitten im Weg."
                                            },
                                            {
                                                "example_id": "fab983d6-6f19-4f4d-bab6-63a1b2a53e72",
                                                "sense_id": "782d42c9-d816-387f-a0b0-91cfbbaaef36",
                                                "text": "„Und während in den Fünfzigern Motorräder fast immer schwarz waren, so fällt die Herz-Kronen-Vespa schon dadurch auf, dass sie weiß ist.“"
                                            },
                                            {
                                                "example_id": "e164d7a6-9002-495c-9b18-7b0c4309fee6",
                                                "sense_id": "782d42c9-d816-387f-a0b0-91cfbbaaef36",
                                                "text": "„Siavasch schaute zu mir rüber und übersah dabei die vierköpfige Familie, die auf einem Motorrad auf die Kreuzung zusteuerte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ecd676bf-ff9d-47c6-9837-acc4e9612908",
                        "source_entry_id": "1274876c-80ca-3dfb-b4b1-231d2d7867fd",
                        "source_sense_id": "ac7587e2-10ad-3aad-8b75-9f563c85f80b",
                        "target_lang_word": "motorcycle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "motorcycle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "909dfb2c-b535-3c90-9c61-44deac7c2321",
                                        "entry_id": "fd771cbc-a0aa-3292-ae23-e244fd87c508",
                                        "glosses": [
                                            "An open-seated motor vehicle with handlebars instead of a steering wheel, and having two (or sometimes three) wheels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87ccff51-dec1-46a0-aa18-375e64215c7a",
                                                "sense_id": "909dfb2c-b535-3c90-9c61-44deac7c2321",
                                                "text": "Her big mission is to recover the precious Blue Star (a glowing rock in a box), which leads to a Western shoot-out, a space-age motorcycle gang, and an unamusing Darth Vader-esque villain."
                                            },
                                            {
                                                "example_id": "46acbbac-bc09-409c-832e-7300790dd444",
                                                "sense_id": "909dfb2c-b535-3c90-9c61-44deac7c2321",
                                                "text": "That last problem did intrude on Hazzard’s roamings, and when she refers to the living city it is with periodic references to thefts of cars and wallets, with a warning not to carry anything “snatchable” by the thieves on motorcycles who whiz through the streets."
                                            },
                                            {
                                                "example_id": "b293e0a2-f640-4a0b-aff5-de202aefd45b",
                                                "sense_id": "909dfb2c-b535-3c90-9c61-44deac7c2321",
                                                "text": "Vern rubbed her hands along the motorcycles, admiring their size and power, their silver and black sleekness."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "motorcycle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2880c684-9101-3883-9eed-01c3171a9641",
                                        "entry_id": "872565ad-1305-38c0-886d-6b11a1a9e44f",
                                        "glosses": [
                                            "To ride a motorcycle."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71363f68-edf8-46f9-a0e9-1501e9fbcc45",
                        "source_entry_id": "1274876c-80ca-3dfb-b4b1-231d2d7867fd",
                        "source_sense_id": "ac7587e2-10ad-3aad-8b75-9f563c85f80b",
                        "target_lang_word": "motorbike",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "motorbike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed7adc14-9abc-3de7-b2ca-369d40024720",
                                        "entry_id": "dcf3dcf2-a457-3df3-88c1-697967af0e1b",
                                        "glosses": [
                                            "A motorcycle."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d19e19b3-4fda-45cb-a961-6b3aab65bef1",
                                                "sense_id": "ed7adc14-9abc-3de7-b2ca-369d40024720",
                                                "text": "Driving fuel-efficient vehicles and using motorbikes when possible to replace or supplement vehicles are two of the ways Department of Fish, Wildlife and Parks employees are attempting to become less fuelish and to lower transportation costs."
                                            },
                                            {
                                                "example_id": "c10171ad-a135-4e00-b561-cfcd9e32fa7f",
                                                "sense_id": "ed7adc14-9abc-3de7-b2ca-369d40024720",
                                                "text": "Jumping on the Metro and than a local train, we headed out to National Central University at Jhongli, where I had been invited to take a look at a motorbike powered by compressed air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c580830a-d550-3f54-93cb-a32a2539a7c1",
                                        "entry_id": "dcf3dcf2-a457-3df3-88c1-697967af0e1b",
                                        "glosses": [
                                            "A small and light motorcycle."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "motorbike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8480526-569d-349a-b75d-0ec13f53a200",
                                        "entry_id": "fda5e286-661c-3517-a191-8b0acb36b6e0",
                                        "glosses": [
                                            "To ride a motorbike; to travel by motorbike."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a44ccae1-7e9b-49ef-a2d0-e4bbfa021bc4",
                                                "sense_id": "d8480526-569d-349a-b75d-0ec13f53a200",
                                                "text": "We motorbiked all over the US that summer."
                                            },
                                            {
                                                "example_id": "2841b422-c17e-4b87-a62c-77885e81f0eb",
                                                "sense_id": "d8480526-569d-349a-b75d-0ec13f53a200",
                                                "text": "Bart Groothuijze, who runs the Castodian foundation promoting safer motorbiking, blames a misplaced sense of freedom and vanity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
