{
    "word_family": [
        "malted",
        "malting",
        "maltster",
        "malty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "86488653-b2c7-3dbb-beeb-fc763a28d981",
                    "sense_definition": "Grain, usually barley, that has been sprouted and then dried, used primarily in brewing beer or distilling spirits.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "brewing_ingredients",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brewery uses high-quality <w>malt</w> to give the beer its distinct roasted flavor.",
                            "target_lang_translations": {
                                "ru": "Пивоварня использует высококачественный <w>солод</w>, чтобы придать пиву характерный жареный вкус."
                            }
                        },
                        {
                            "text": "Farmers often sell their barley to be processed into <w>barley</w> <w>malt</w> for the beverage industry.",
                            "target_lang_translations": {
                                "ru": "Фермеры часто продают ячмень для переработки в ячменный <w>солод</w> для индустрии напитков."
                            }
                        }
                    ],
                    "common_phrases": [
                        "barley malt",
                        "malt extract",
                        "crushed malt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зерно (обычно ячмень), которое было проращено, а затем высушено; используется в основном в пивоварении или производстве спиртных напитков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солод",
                                "target_lang_sense_clarification": "проращённое и высушенное зерно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92718a3f-552d-37a9-ac07-0669d9e49923",
                    "sense_definition": "A drink made from malted grain, especially malt whisky or strong beer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "alcoholic_beverages",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He preferred a <w>single</w> <w>malt</w> over any other type of whisky.",
                            "target_lang_translations": {
                                "ru": "Он предпочитал односолодовый <w>виски</w> любому другому виду виски."
                            }
                        },
                        {
                            "text": "After a long day of work, they enjoyed a glass of fine <w>malt</w> by the fireplace.",
                            "target_lang_translations": {
                                "ru": "После долгого рабочего дня они наслаждались бокалом отличного <w>солодового виски</w> у камина."
                            }
                        }
                    ],
                    "common_phrases": [
                        "single malt",
                        "malt whisky",
                        "malt liquor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напиток, приготовленный из солодового зерна, особенно солодовый виски или крепкое пиво."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солодовый виски",
                                "target_lang_sense_clarification": "крепкий алкогольный напиток"
                            },
                            {
                                "target_lang_word": "солодовое пиво",
                                "target_lang_sense_clarification": "напиток на основе солода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf5a623d-a180-3cec-9c0b-a61769e6c79d",
                    "sense_definition": "A milkshake made with malted milk powder for a specific sweet and nutty flavor.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beverages",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kids ordered a chocolate <w>malt</w> at the old-fashioned diner.",
                            "target_lang_translations": {
                                "ru": "Дети заказали шоколадный <w>солодовый коктейль</w> в старомодной закусочной."
                            }
                        },
                        {
                            "text": "She sat in the drugstore sucking a <w>chocolate</w> <w>malt</w> through a straw.",
                            "target_lang_translations": {
                                "ru": "Она сидела в аптеке, потягивая шоколадный <w>солодовый коктейль</w> через соломинку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chocolate malt",
                        "vanilla malt"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Молочный коктейль с добавлением порошка солодового молока, обладающий специфическим сладким и ореховым вкусом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солодовый коктейль",
                                "target_lang_sense_clarification": "молочный коктейль с солодом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5c3c3c1-2d58-3815-b989-929ebf9b931a",
                    "sense_definition": "A type of sugar, specifically maltose, that is derived from malted grain.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recipe calls for <w>malt</w> syrup to provide a rich, complex sweetness to the bread.",
                            "target_lang_translations": {
                                "ru": "По рецепту требуется <w>солодовый</w> сироп, чтобы придать хлебу насыщенную, сложную сладость."
                            }
                        },
                        {
                            "text": "During the mashing process, enzymes convert the starch into <w>malt</w> sugar.",
                            "target_lang_translations": {
                                "ru": "В процессе затирания ферменты превращают крахмал в солодовый <w>сахар</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "malt sugar",
                        "malt syrup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип сахара, в частности мальтоза, получаемый из солодового зерна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солодовый сахар",
                                "target_lang_sense_clarification": "мальтоза"
                            },
                            {
                                "target_lang_word": "мальтоза",
                                "target_lang_sense_clarification": "химическое название сахара"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fb6a5c3-31bf-3da5-9bf6-7afa04dee44a",
                    "sense_definition": "An abbreviation for mucosa-associated lymphoid tissue, a part of the immune system.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medicine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor explained that <w>MALT</w> lymphoma is a type of cancer that affects the immune tissue.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил, что <w>MALT</w>-лимфома — это тип рака, поражающий иммунную ткань."
                            }
                        },
                        {
                            "text": "Research shows that <w>MALT</w> plays a crucial role in protecting the body's mucosal surfaces.",
                            "target_lang_translations": {
                                "ru": "Исследования показывают, что <w>MALT</w>-ткань играет решающую роль в защите слизистых поверхностей организма."
                            }
                        }
                    ],
                    "common_phrases": [
                        "MALT lymphoma"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура для мукоза-ассоциированной лимфоидной ткани, части иммунной системы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "MALT-ткань",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6c0b2812-b1b5-377f-847d-6f9ba02f9d51",
                    "sense_definition": "To convert grain into malt by soaking it in water to sprout and then drying it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "brewing_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The facility is designed to <w>malt</w> barley on a massive industrial scale.",
                            "target_lang_translations": {
                                "ru": "Предприятие предназначено для того, чтобы <w>солодить</w> ячмень в огромных промышленных масштабах."
                            }
                        },
                        {
                            "text": "They <w>malt</w> the grain for several days before it is ready for the kiln.",
                            "target_lang_translations": {
                                "ru": "Они <w>солодят</w> зерно в течение нескольких дней, прежде чем оно будет готово для обжига."
                            }
                        }
                    ],
                    "common_phrases": [
                        "malt the barley",
                        "malt the grain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Превращать зерно в солод путем замачивания в воде для прорастания и последующей сушки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солодить",
                                "target_lang_sense_clarification": "превращать в солод"
                            },
                            {
                                "target_lang_word": "приготовлять солод",
                                "target_lang_sense_clarification": "процесс производства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22d64c11-947c-3f51-a962-0354a844c0e4",
                    "sense_definition": "To undergo the process of becoming malt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "brewing_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grain began to <w>malt</w> quickly due to the high humidity in the room.",
                            "target_lang_translations": {
                                "ru": "Зерно начало быстро <w>солодеть</w> из-за высокой влажности в помещении."
                            }
                        },
                        {
                            "text": "If the conditions are right, the seeds will <w>malt</w> within a few days.",
                            "target_lang_translations": {
                                "ru": "Если условия будут подходящими, семена <w>прорастут</w> в солод в течение нескольких дней."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проходить процесс превращения в солод."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солодеть",
                                "target_lang_sense_clarification": "становиться солодом"
                            },
                            {
                                "target_lang_word": "прорастать",
                                "target_lang_sense_clarification": "о зерне в процессе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72a8c63c-9c1f-3d44-a97b-d64d1727ad72",
                    "sense_definition": "To consume or drink malt liquor or whisky.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old friends would gather every Friday night to <w>malt</w> and share stories.",
                            "target_lang_translations": {
                                "ru": "Старые друзья собирались каждую пятницу вечером, чтобы <w>выпить</w> и поделиться историями."
                            }
                        },
                        {
                            "text": "He spent the evening <w>malting</w> at the local pub with his colleagues.",
                            "target_lang_translations": {
                                "ru": "Он провел вечер, <w>попивая виски</w> в местном пабе со своими коллегами."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Rarely used in modern speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Употреблять солодовые напитки или виски."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпивать",
                                "target_lang_sense_clarification": "употреблять спиртное"
                            },
                            {
                                "target_lang_word": "пить виски",
                                "target_lang_sense_clarification": "конкретный вид напитка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}