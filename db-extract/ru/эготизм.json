                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d26c8eae-1db4-4618-8898-374b05c32a3f",
                                                "sense_id": "b047eb9b-b44b-3a5d-9592-5e2ceda55581",
                                                "text": "Mich nervt der Egotismus mancher Leute."
                                            },
                                            {
                                                "example_id": "b5c4723f-247d-4ee2-a940-f9b851e9ab12",
                                                "sense_id": "b047eb9b-b44b-3a5d-9592-5e2ceda55581",
                                                "text": "„Hinter der als Antisemitismus bezeichneten soziologischen Erscheinung […] steht also durchaus nicht allein der böse Wille, der nationale Egotismus, oder der Neid und Hass des völkischen Wettbewerbs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74e0ba75-5cc5-44f9-80a2-07c25e192847",
