                ],
                "senses": [
                    {
                        "sense_id": "6a307c03-2b49-3fb5-aca8-de59409dbac0",
                        "entry_id": "081779f9-7fbd-3a6c-9244-caf045397d5f",
                        "glosses": [
                            "Waterfall; cataract."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa43b87a-7e5f-4bb8-ad91-d6643c2a046b",
                                "sense_id": "6a307c03-2b49-3fb5-aca8-de59409dbac0",
                                "text": "Yet was not this all; for hither to the north boiled the majestic cataract in unimaginable grandiloquence, and thither to the south sparkled the gentle catadupe in serene and incandescent tranquillity, whilst far and near the halcyon brooklet flowed between!"
                            },
                            {
                                "example_id": "6dff872f-4167-4c36-802b-b13d7b0936f3",
                                "sense_id": "6a307c03-2b49-3fb5-aca8-de59409dbac0",
                                "text": "It happens oftentimes that in the church of God, where the waters of Siloam should run with silence, there is nothing heard but the tempestuous roaring of some gulf or catadupe."
                            },
                            {
                                "example_id": "7fd65b3f-458f-484d-b415-a430a9d4947b",
                                "sense_id": "6a307c03-2b49-3fb5-aca8-de59409dbac0",
                                "text": "It sounds just like storing up more catadupes of undigested data."
                            }
                        ]
                    }
                ],
