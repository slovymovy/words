                    },
                    {
                        "translation_id": "37720c83-b892-4257-8e6f-e7bd7ce0f61c",
                        "source_entry_id": "ad4f1f65-1251-3d72-9caa-7bca53e5ca92",
                        "source_sense_id": "c13d6363-5407-38c0-9b1e-1143ce93e1a0",
                        "target_lang_word": "Christina",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Christina",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b29ef530-feec-3e85-95a8-59a6c5ceae31",
                                        "entry_id": "46fe78bd-2cc7-3941-85f0-d6bb59ba5a51",
                                        "glosses": [
                                            "A female given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da1a73d9-162a-43ac-98df-eecf3c3c3ab3",
                                                "sense_id": "b29ef530-feec-3e85-95a8-59a6c5ceae31",
                                                "text": "For never yet that maiden's woes\nTo check our social pleasure rose,\nHer joy she shares, her grief's her own,\nCHRISTINA CHRISTIAN weeps alone."
                                            },
                                            {
                                                "example_id": "c4944a20-9069-4aad-87cd-997743d02e00",
                                                "sense_id": "b29ef530-feec-3e85-95a8-59a6c5ceae31",
                                                "text": "Her name \"Christina\" was derived from one of the Bonaparte family, Lady Dudley Stuart"
                                            },
                                            {
                                                "example_id": "eafea963-19cf-4dbb-90fd-4b2721a7f6a5",
                                                "sense_id": "b29ef530-feec-3e85-95a8-59a6c5ceae31",
                                                "text": "She was born on Christmas Day. I wanted to name her Holly. But with the last name of Wood, your mama wouldn't go for that. So we named her Christina."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
