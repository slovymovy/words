                ],
                "senses": [
                    {
                        "sense_id": "4cb4a54d-34dc-32ff-9d6e-d67960dd1774",
                        "entry_id": "8c378029-1a3b-3a0c-9071-018d69323f63",
                        "glosses": [
                            "Synonym of Madrilenian; of or pertaining to Madrid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8da79704-7d23-4574-b475-59855ff057a0",
                                "sense_id": "4cb4a54d-34dc-32ff-9d6e-d67960dd1774",
                                "text": "The Puerta del Sol was entirely deserted — though the weather was of enchanting warmth and beauty —and the quintessence of the excitable Madrilene populace was assembled in front of the Theatre del Oriente, near the Palace, where the Sessions of the Congress are provisionally held."
                            },
                            {
                                "example_id": "5b634c82-27e2-40c3-a788-da35b24e04b6",
                                "sense_id": "4cb4a54d-34dc-32ff-9d6e-d67960dd1774",
                                "text": "He recounts how years ago some of his Madrilene friends got tattoos with Liverpool's slogan, 'You'll never walk alone'."
                            },
                            {
                                "example_id": "40a5745b-541f-427c-bfc4-d76c854ff4ee",
                                "sense_id": "4cb4a54d-34dc-32ff-9d6e-d67960dd1774",
                                "text": "Following in Wicht's footsteps, Durand-Ruel tried to obtain El Greco's Cardinal from Juan de Zabala y Guzmán, 14th Duke of Nájera and Earl of Paredes de Nava (1844–1910), living in Palacio de Oñate, his Madrilene mansion."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "dfbc5c1a-2f70-444a-ac42-d70328792739",
