            {
                "entry_id": "14229d9a-23e5-3236-9deb-51fc8d4401d2",
                "word": "kikuyu",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "37a4e4b1-395b-441b-b0d5-d60a1fc4ad51",
                        "entry_id": "14229d9a-23e5-3236-9deb-51fc8d4401d2",
                        "tags": [],
                        "form": "kikouyou"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "28557cf2-3050-3e70-945b-b0de8e8f0374",
                        "entry_id": "14229d9a-23e5-3236-9deb-51fc8d4401d2",
                        "glosses": [
                            "Langue parlée au Kenya et appartenant aux langues bantoues."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32df8faa-696b-4315-89b4-aef186cdfcd2",
                                "sense_id": "28557cf2-3050-3e70-945b-b0de8e8f0374",
                                "text": "Le kikuyu possède trois dialectes principaux mutuellement intelligibles."
                            },
                            {
                                "example_id": "2891ea38-0df9-4701-9a06-4fca9b2e28af",
                                "sense_id": "28557cf2-3050-3e70-945b-b0de8e8f0374",
                                "text": "La police commença dès cet instant à se faire pressante, ce qui conduit le leader kikuyu à faire le signe de la victoire en criant en anglais « Plus de partis », puis en kikuyu « On veut le multipartisme »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6a768fd-7b37-4604-acf3-1a54fdd152ee",
                        "source_entry_id": "14229d9a-23e5-3236-9deb-51fc8d4401d2",
                        "source_sense_id": "28557cf2-3050-3e70-945b-b0de8e8f0374",
                        "target_lang_word": "Kikuyu",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kikuyu",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22ab714c-b957-39aa-bdde-aa6055a162d4",
                                        "entry_id": "2784473e-5fda-35ca-8ba2-e388327f9e9b",
                                        "glosses": [
                                            "eine in Kenia gesprochene Bantusprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e08e74b1-d392-4e7a-9391-dd6b07359331",
                                                "sense_id": "22ab714c-b957-39aa-bdde-aa6055a162d4",
                                                "text": "„Ich werde Eskimo, Kikuyu (aus der Familie der Bantusprachen) und Englisch zum Sprachvergleich heranziehen.“"
                                            },
                                            {
                                                "example_id": "5544f459-ccfe-441d-899c-474c84b7a0fc",
                                                "sense_id": "22ab714c-b957-39aa-bdde-aa6055a162d4",
                                                "text": "„Sie geben sich betreten die Hand, dann stimmen sie mit den Neuankömmlingen gemeinsam ein Kirchenlied an – nicht in der Sprache der Luo, schon gar nicht auf Kikuyu, sondern auf Suaheli.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dec658e1-5dd2-4cd5-9d4d-9e0858fa1fd6",
                        "source_entry_id": "14229d9a-23e5-3236-9deb-51fc8d4401d2",
