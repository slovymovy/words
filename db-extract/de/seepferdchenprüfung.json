                ],
                "senses": [
                    {
                        "sense_id": "2e8ee1ed-7904-369a-96af-6e3dced7c0bb",
                        "entry_id": "a4b15cd8-398d-39c6-9bc3-3b61baab5883",
                        "glosses": [
                            "Überprüfung (in Deutschland), ob jemand die Grundfertigkeiten des Schwimmens beherrscht (meist für Kinder)"
                        ],
                        "tags": [
                            "Schwimmen"
                        ],
                        "examples": [
                            {
                                "example_id": "d0d04193-9885-41bc-b071-180edca1bdd9",
                                "sense_id": "2e8ee1ed-7904-369a-96af-6e3dced7c0bb",
                                "text": "Immer weniger Kinder können eine Seepferdchenprüfung ablegen, weil die Kommunen immer mehr Schwimmbäder schließen."
                            },
                            {
                                "example_id": "19db9930-2632-438a-ba67-d314f58d0050",
                                "sense_id": "2e8ee1ed-7904-369a-96af-6e3dced7c0bb",
                                "text": "„»Wir haben ein achtjähriges Kind dabei, das war zuvor noch nie im Schwimmbad, ist mit uns zum ersten Mal im Wasser gewesen und hat nach drei Tagen die Seepferdchenprüfung bestanden«, sagt der Wasserwachtchef“ […]."
                            },
                            {
                                "example_id": "b458004a-c632-43cb-a85b-3e8939ebabd8",
                                "sense_id": "2e8ee1ed-7904-369a-96af-6e3dced7c0bb",
                                "text": "[Der Schwimmer und Weltrekordler] „Paul Biedermann fiel als Kind durch die Seepferdchenprüfung.“"
                            },
                            {
                                "example_id": "fc434064-36a4-4925-af7d-e06b16252665",
                                "sense_id": "2e8ee1ed-7904-369a-96af-6e3dced7c0bb",
                                "text": "„Seepferdchen mit Currywurst geht nicht, aber Currywurst nach der Seepferdchenprüfung: versprochen!“"
                            },
                            {
                                "example_id": "c2b5597f-3a37-40f4-8e42-7940756b790c",
                                "sense_id": "2e8ee1ed-7904-369a-96af-6e3dced7c0bb",
                                "text": "„Nächsten Freitag ist Seepferdchenprüfung, aber Ida (Name geändert) will nicht.“"
                            },
                            {
                                "example_id": "a85b894c-a017-4636-86c9-c0aade493101",
                                "sense_id": "2e8ee1ed-7904-369a-96af-6e3dced7c0bb",
                                "text": "„Als Ausbilderin vertieft sie das Schwimmen nach der Seepferdchenprüfung.“"
                            },
                            {
                                "example_id": "b70e1c1a-c9d0-4b7f-ab0c-8b0872b497fe",
                                "sense_id": "2e8ee1ed-7904-369a-96af-6e3dced7c0bb",
                                "text": "„Ihr Kind […] kann sich ggf. auf den darauf aufbauenden Anfängerschwimmkurs mit abschließender Seepferdchenprüfung des LSV vorbereiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
