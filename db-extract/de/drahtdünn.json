                ],
                "senses": [
                    {
                        "sense_id": "3222a465-e4ef-3e51-9983-1e057ccdfb91",
                        "entry_id": "0f56cc73-15d6-326c-a6c8-e124dd1fee11",
                        "glosses": [
                            "so dünn wie ein Draht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ce67c93-203e-4cad-91ab-7ad3c5e6220b",
                                "sense_id": "3222a465-e4ef-3e51-9983-1e057ccdfb91",
                                "text": "„Am Horizont kitzelte ein winziger, drahtdünner Blitz die entlegenen Vorstädte, und lange Augenblicke später erreichte uns der Donner, ein schwacher, dumpfer Schlag.“"
                            },
                            {
                                "example_id": "564a8a80-467a-4c9c-a49d-8e911a7e299d",
                                "sense_id": "3222a465-e4ef-3e51-9983-1e057ccdfb91",
                                "text": "„Da schrumpfte auf einmal das Licht, und Finsternis brach herein wie ein Schrei. Überkroch zuletzt auch die drahtdünne Korona.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
