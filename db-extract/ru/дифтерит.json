                            {
                                "example_id": "bfa130ae-c3a1-4545-b51e-f6c7ddb61932",
                                "sense_id": "7d11804c-a8aa-35b6-984c-c4d93f69a7eb",
                                "text": "Вспомним брюшной тиф, холеру, дифтерит, натуральную оспу и вообще всю группу острых заразных болезней;"
                            },
                            {
                                "example_id": "cc3b4a1f-a4bd-4c20-a30e-84a9be18c547",
                                "sense_id": "7d11804c-a8aa-35b6-984c-c4d93f69a7eb",
                                "text": "Врачи сказали: «Ангина!» Его лечили от ангины, а это оказался дифтерит."
                            }
                        ]
                    }
