                        "source_sense_id": "53097e09-b702-3fa8-b371-02936e953c7e",
                        "target_lang_word": "fringe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fringe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "560dd055-7030-33f3-8a10-f6d9239593a7",
                                        "entry_id": "b1a27d22-7179-36f0-9378-b5739635888f",
                                        "glosses": [
                                            "A decorative border."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e20a4499-fcb5-4096-bb67-945546623fbd",
                                                "sense_id": "560dd055-7030-33f3-8a10-f6d9239593a7",
                                                "text": "the fringe of a picture"
                                            },
                                            {
                                                "example_id": "b6fe2377-e94e-429d-8504-18775101f6b8",
                                                "sense_id": "560dd055-7030-33f3-8a10-f6d9239593a7",
                                                "text": "The walls were hung with blue silk, edged with silver fringe; and the closely-drawn blue velvet curtains swept the ground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "601314d7-a0c8-383d-b727-1de304394768",
                                        "entry_id": "b1a27d22-7179-36f0-9378-b5739635888f",
                                        "glosses": [
                                            "A decorative border.",
                                            "A border or edging."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9234d452-f201-48a2-9034-7d578be9eb88",
                                                "sense_id": "601314d7-a0c8-383d-b727-1de304394768",
                                                "text": "He walked up the heath’s western edge, beside a fringe of scrub where hogweed grew in tangles and brambles rose taller than him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "712d0096-6db9-3dcc-a9c5-e19064f2a994",
                                        "entry_id": "b1a27d22-7179-36f0-9378-b5739635888f",
                                        "glosses": [
                                            "A marginal or peripheral part."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb77aa38-6b71-45ad-887d-b27be8143ea3",
                                                "sense_id": "712d0096-6db9-3dcc-a9c5-e19064f2a994",
                                                "text": "the confines of grace and the fringes of repentance"
                                            },
                                            {
                                                "example_id": "64aacf76-c02f-4109-a725-33af8b0ac083",
                                                "sense_id": "712d0096-6db9-3dcc-a9c5-e19064f2a994",
                                                "text": "Dos Santos, who has often been on the fringes at Spurs since moving from Barcelona, whipped in a fantastic cross that Pavlyuchenko emphatically headed home for his first goal of the season."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6537dae-933d-3e0d-9929-34cf5a63926a",
                                        "entry_id": "b1a27d22-7179-36f0-9378-b5739635888f",
                                        "glosses": [
                                            "A group of people situated on the periphery of a larger community."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46d9adea-929a-4372-a80f-279afaa0559c",
                                                "sense_id": "e6537dae-933d-3e0d-9929-34cf5a63926a",
                                                "text": "About an hour later, the two were sitting at a comparatively isolated table in a restaurant called Sickler’s, downtown, a highly favored place among, chiefly, the intellectual fringe of students at the college—the same students, more or less, who, had they been Yale or Harvard men, might rather too casually have steered their dates away from Mory’s or Cronin’s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5542a283-0915-3c17-a4b3-ed20b0c0162f",
                                        "entry_id": "b1a27d22-7179-36f0-9378-b5739635888f",
                                        "glosses": [
                                            "A group of people situated on the periphery of a larger community.",
                                            "Those members of a political party, or any social group, holding extremist or unorthodox views."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2763a64b-d1cd-4138-ac1e-7e0ecea57431",
                                                "sense_id": "5542a283-0915-3c17-a4b3-ed20b0c0162f",
                                                "text": "a fringe group of the party"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdb13ac7-60cf-37d7-8c31-b38dd9202ea4",
                                        "entry_id": "b1a27d22-7179-36f0-9378-b5739635888f",
                                        "glosses": [
                                            "The periphery of an area, especially a town or city."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb573e83-3732-4ed8-9f22-e069fc60fe9e",
                                                "sense_id": "cdb13ac7-60cf-37d7-8c31-b38dd9202ea4",
                                                "text": "He lives on the fringe of London."
                                            },
                                            {
                                                "example_id": "6453fd4d-fec6-4648-abe1-d344f3aed971",
                                                "sense_id": "cdb13ac7-60cf-37d7-8c31-b38dd9202ea4",
                                                "text": "Moreover, although a number of lines penetrate to the fringes of the English Lake District, this is the only one which actually passes through it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a5f6ce4-ba98-3362-b8b5-30b569fa83af",
                                        "entry_id": "b1a27d22-7179-36f0-9378-b5739635888f",
                                        "glosses": [
                                            "The periphery of an area, especially a town or city.",
                                            "Used attributively with reference to Aboriginal people living on the edge of towns etc."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f76e1265-e214-4fc7-bf7f-bc69f0c811c7",
                                                "sense_id": "4a5f6ce4-ba98-3362-b8b5-30b569fa83af",
                                                "text": "All the fringe people thought it was such a good house, ingenious in fact, and erected similar makeshift housing for themselves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaaf8db8-41e3-33b4-a5a3-fb6e068e6ebb",
                                        "entry_id": "b1a27d22-7179-36f0-9378-b5739635888f",
                                        "glosses": [
                                            "Synonym of bangs: hair hanging over the forehead, especially a hairstyle where it is cut straight across."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e070a28-f8df-4f2f-9862-24ba6e2ec317",
                                                "sense_id": "eaaf8db8-41e3-33b4-a5a3-fb6e068e6ebb",
                                                "text": "Her fringe is so long it covers her eyes."
                                            },
                                            {
                                                "example_id": "7e5db9e6-0735-4f33-be26-6716b48c7e19",
                                                "sense_id": "eaaf8db8-41e3-33b4-a5a3-fb6e068e6ebb",
                                                "text": "In a few minutes Mrs. Athelny appeared. She had taken her hair out of the curling pins and now wore an elaborate fringe."
                                            },
                                            {
                                                "example_id": "b4669619-d179-4661-be8f-4b6cc68816b7",
                                                "sense_id": "eaaf8db8-41e3-33b4-a5a3-fb6e068e6ebb",
                                                "text": "Fayne in the photograph had a fringe, hair frizzed over hidden ears, sleeves over-ornate, the whole thing out of keeping."
                                            },
                                            {
                                                "example_id": "57635b34-a274-4216-b902-37aba46f9066",
                                                "sense_id": "eaaf8db8-41e3-33b4-a5a3-fb6e068e6ebb",
                                                "text": "Ingeborg knew she wasn′t ready for fringes or short hair like some of the women she′d seen, and she hoped her daughter wasn′t either.\n“No.” Astrid′s tone dismissed Sophie and the fringe as she galloped off to a new topic."
                                            },
                                            {
                                                "example_id": "5b983d9d-8f2a-4a9f-8872-de38b34a31b6",
                                                "sense_id": "eaaf8db8-41e3-33b4-a5a3-fb6e068e6ebb",
                                                "text": "Set against the seductive visual and textual imagery of these soft-focus fantasy worlds, the stock list details offer the reader a very real solution to achieving the look themselves, ‘Hair, including coloured fringes (obtainable from Joseph, £3.50) by Paul Nix’ (Baker 1972a: 68)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4ba80ee-12b7-382a-a677-a036df43e59b",
                                        "entry_id": "b1a27d22-7179-36f0-9378-b5739635888f",
                                        "glosses": [
                                            "A light or dark band formed by the diffraction of light."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f886806-774d-408d-b82c-2b36324c4855",
                                                "sense_id": "a4ba80ee-12b7-382a-a677-a036df43e59b",
                                                "text": "interference fringe"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1e39f87-3e1a-3e6f-ae8f-6caeb611f7bc",
                                        "entry_id": "b1a27d22-7179-36f0-9378-b5739635888f",
                                        "glosses": [
                                            "Non-mainstream theatre."
                                        ],
                                        "tags": [],
