                                        "glosses": [
                                            "jeszcze raz, ponownie, na nowo, znów, powtórnie, apiać"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3e2b73a-ba52-4fdc-984a-11a86277a86f",
                                                "sense_id": "d22d82c7-f62e-320e-9bf5-68c081ddee09",
                                                "text": "Nauczyciele znowu strajkują."
                                            },
                                            {
                                                "example_id": "13cb6c44-a54a-4875-9866-6f4430fe16cd",
                                                "sense_id": "d22d82c7-f62e-320e-9bf5-68c081ddee09",
                                                "text": "Ten głupi samochód znowu się uszkodził!"
