                        "sense_id": "fa23cfb2-9df1-3418-9caa-cd7a9b9964db",
                        "entry_id": "e568955a-0bf5-3fa3-b639-e15f663537ba",
                        "glosses": [
                            "État du cerf dans la saison où il est le plus gras et le meilleur à manger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "115f1199-e29f-4f57-bc6b-78ad21ae3b8f",
                                "sense_id": "fa23cfb2-9df1-3418-9caa-cd7a9b9964db",
                                "text": "On dit que le Cerf est en Cervaison, lorsqu’il est en gras & en venaison."
                            },
                            {
                                "example_id": "2926fc92-1f30-4278-aa02-43fabe52f64d",
                                "sense_id": "fa23cfb2-9df1-3418-9caa-cd7a9b9964db",
                                "text": "Lorsqu’un cerf est bien gras, on dit : il est en pleine cervaison."
                            }
                        ]
                    },
                    {
                        "sense_id": "659dd2a9-7db6-3682-ba5b-f9346adb1201",
                        "entry_id": "e568955a-0bf5-3fa3-b639-e15f663537ba",
                        "glosses": [
                            "Temps de l’année où le cerf est gras et bon à chasser."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f75ce010-5bd4-40ca-a50b-cb3dedefeed6",
                                "sense_id": "659dd2a9-7db6-3682-ba5b-f9346adb1201",
                                "text": "C’est de juin à septembre que le cerf est en pleine prospérité et que cette cervaison ou venaison (la saison du cerf) atteint son maximum."
                            }
                        ]
                    }
                ],
