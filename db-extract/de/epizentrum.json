                        "entry_id": "96ad24eb-ee6e-3760-bb26-1ae2bcf4b16e",
                        "glosses": [
                            "Startpunkt eines Erdbebens an der Erdoberfläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a112d503-7e01-43d1-88e8-d80ed386aeee",
                                "sense_id": "cc082d7c-1f36-38d8-acb1-81d6d712eee3",
                                "text": "Das Epizentrum des Tōhoku-Erdbebens befand sich an der Pazifikküste bei Japan."
                            },
                            {
                                "example_id": "74120733-dca4-4fbc-84a5-7a45b9d950f1",
                                "sense_id": "cc082d7c-1f36-38d8-acb1-81d6d712eee3",
                                "text": "übertragen: „Gleich ums Eck liegt das Epizentrum des weltweiten Handels mit den edlen Steinen.“"
                            },
                            {
                                "example_id": "cd176053-f6d8-4421-b574-0190515af38c",
                                "sense_id": "cc082d7c-1f36-38d8-acb1-81d6d712eee3",
                                "text": "übertragen: „Das Land und damit auch die touristischen Epizentren beginnen hinter den letzten großen Städten im Süden.“"
                            },
                            {
                                "example_id": "b00dec79-19d1-4a8d-b019-b2bbd0d792b5",
                                "sense_id": "cc082d7c-1f36-38d8-acb1-81d6d712eee3",
                                "text": "übertragen: „Das Epizentrum dieses Geräusches wanderte in meinem Schädel herum, wurde lauter und leiser.“"
                            }
                        ],
