                                            {
                                                "example_id": "ac5d367b-f439-45d9-8c00-4b4164699ddd",
                                                "sense_id": "4f3cbc29-caea-31e0-894d-c2285e2a507b",
                                                "text": "Als je gezond wil blijven is een simpele vuistregel het eten van meer levend voedsel: fruit en groente."
                                            },
                                            {
                                                "example_id": "35a40ca7-d779-4242-bcf2-642ef9803f25",
                                                "sense_id": "4f3cbc29-caea-31e0-894d-c2285e2a507b",
                                                "text": "Een slordige honderd onbewoonde eilanden worden geëxploiteerd als hotel. Als vuistregel geldt: één eiland, één resort, iets wat de Malediven een unieke en daarmee ook populaire vakantiebestemming maakt."
                                            }
