                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4069b6d-a0a1-4edd-b1e5-0bb451ff3681",
                                                "sense_id": "36205998-2b36-3ef4-88cc-a2fd9f3b5054",
                                                "text": "Die achthonderd kunnen onmogelijk een complete brigade met tanks tegenhouden."
                                            }
