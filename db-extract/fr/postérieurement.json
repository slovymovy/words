                                        "sense_id": "3503f998-e574-3926-aca1-515a575f8661",
                                        "entry_id": "21cb8174-e395-3990-b181-22b37018172b",
                                        "glosses": [
                                            "Following, afterwards in either time or place."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b35cf6b-7386-47b2-970d-f7a0e45d8d8c",
                                                "sense_id": "3503f998-e574-3926-aca1-515a575f8661",
                                                "text": "It will be recollected that the ill-fated Halloway...distinctly stated the voice of the individual who had approached his post...to have been that of a female, and that the language in which they subsequently conversed was that of the Ottawa Indians."
                                            },
                                            {
                                                "example_id": "6c45b930-05ac-4489-ab60-626e50a43df0",
                                                "sense_id": "3503f998-e574-3926-aca1-515a575f8661",
                                                "text": "“There the cause of death was soon ascertained ; the victim of this daring outrage had been stabbed to death from ear to ear with a long, sharp instrument, in shape like an antique stiletto, which […] was subsequently found under the cushions of the hansom.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5065abe8-213b-3ca0-9efe-698508679f10",
                                        "entry_id": "21cb8174-e395-3990-b181-22b37018172b",
                                        "glosses": [
                                            "Accordingly, therefore (implying a logical connection or deduction), consequently."
                                        ],
