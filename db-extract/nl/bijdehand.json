                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0946d91b-5411-36d5-93e4-8795c095a715",
                                        "entry_id": "84ecd8fe-54c2-3a14-8830-93798b9daad3",
                                        "glosses": [
                                            "Que tiene inteligencia rápida y astucia para prever, entender o actuar."
                                        ],
                                        "tags": [
                                            "se emplea generalmente con el verbo \\\"ser\\"
                                        ],
                                        "examples": [
                                            {
