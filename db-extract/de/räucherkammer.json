                "senses": [
                    {
                        "sense_id": "712cae4d-eb7a-365a-85f4-9a90115526f3",
                        "entry_id": "511b7a88-f36d-3afb-b6dc-924efe096d38",
                        "glosses": [
                            "Raum, in dem Fisch oder Fleisch geräuchert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45899eba-ed08-4807-8b5a-35a85d45f745",
                                "sense_id": "712cae4d-eb7a-365a-85f4-9a90115526f3",
                                "text": "„Im geruhsam ländlichen Hinterpommern der Vorkriegszeit war der Winter die Zeit der verlockenden Düfte: vom Bratapfel in der Ofenröhre, von Würsten, Schinken, Gänsebrüsten, die in der Räucherkammer reiften, vom selbstgerösteten Kaffee, vom Pfefferkuchen.“"
                            },
                            {
                                "example_id": "2feb6aca-1b73-4412-81e5-8e2ce9224b60",
                                "sense_id": "712cae4d-eb7a-365a-85f4-9a90115526f3",
                                "text": "„Davon abgetrennt befand sich eine Räucherkammer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
