                                "example_id": "323510c6-d0ff-4cab-b608-15bf07514dd5",
                                "sense_id": "c5655587-72a3-3bcd-95c7-227740ea77f2",
                                "text": "„Schriftliche Belege dafür gibt es nicht, denn die Kinder aus solchen Beziehungen wurden oft als weiß ins Geburtsregister eingetragen - nach der Zahlung eines Schmiergeldes.“"
                            },
                            {
                                "example_id": "138887a1-3135-45ba-b2d8-b71e729bed2d",
                                "sense_id": "c5655587-72a3-3bcd-95c7-227740ea77f2",
                                "text": "„Das Geburtsregister weist den Sohn als einen Sachsen aus, doch Sachse war er nur durch Zufall.“"
                            }
                        ],
