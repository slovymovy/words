{
    "word_family": [
        "growth",
        "growable",
        "outgrow",
        "regrow",
        "overgrow"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c80d3d48-cebb-36b0-b5a3-6a1b27c2ef6a",
                    "sense_definition": "A person, such as a farmer, who cultivates and produces plants or crops.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "cultivation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local apple <w>grower</w> sells his fresh fruit at the market every Saturday morning.",
                            "target_lang_translations": {
                                "ru": "Местный <w>садовод</w>, выращивающий яблоки, каждое субботнее утро продает свои свежие фрукты на рынке."
                            }
                        },
                        {
                            "text": "He was a successful orange <w>grower</w> from Florida who owned several large groves.",
                            "target_lang_translations": {
                                "ru": "Он был успешным <w>производителем</w> апельсинов из Флориды и владел несколькими большими рощами."
                            }
                        }
                    ],
                    "synonyms": [
                        "cultivator",
                        "farmer",
                        "producer"
                    ],
                    "common_phrases": [
                        "orange grower",
                        "local grower",
                        "commercial grower"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, например фермер, который выращивает и производит растения или сельскохозяйственные культуры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "производитель",
                                "target_lang_sense_clarification": "сельскохозяйственной продукции"
                            },
                            {
                                "target_lang_word": "садовод",
                                "target_lang_sense_clarification": "человек, выращивающий фрукты или цветы"
                            },
                            {
                                "target_lang_word": "фермер",
                                "target_lang_sense_clarification": "занимающийся растениеводством"
                            },
                            {
                                "target_lang_word": "выращиватель",
                                "target_lang_sense_clarification": "редко используемый термин для того, кто растит что-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07f9cc58-d869-3f8c-950b-fad53f818f75",
                    "sense_definition": "A plant or organism that develops or increases in size in a specified way.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "growth_rate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These colorful garden flowers are fast <w>growers</w> and will cover the fence in no time.",
                            "target_lang_translations": {
                                "ru": "Эти яркие садовые цветы — быстрорастущие <w>растения</w>, они вмиг покроют весь забор."
                            }
                        },
                        {
                            "text": "The gardener warned me that this particular shrub is a slow <w>grower</w> in shady areas.",
                            "target_lang_translations": {
                                "ru": "Садовник предупредил меня, что этот конкретный кустарник — медленнорастущий <w>сорт</w> для тенистых мест."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fast grower",
                        "slow grower",
                        "strong grower"
                    ],
                    "target_lang_definitions": {
                        "ru": "Растение или организм, который развивается или увеличивается в размерах определенным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растение",
                                "target_lang_sense_clarification": "с определенной скоростью роста"
                            },
                            {
                                "target_lang_word": "сорт",
                                "target_lang_sense_clarification": "характеризующийся темпами роста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2fd4b4a-7163-3d50-9c39-0ab52cab700a",
                    "sense_definition": "Something, such as a song or a person, that becomes more appealing or liked as time passes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "appreciation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I didn't like the new album at first, but it is a real <w>grower</w> after a few listens.",
                            "target_lang_translations": {
                                "ru": "Сначала мне не понравился новый альбом, но после нескольких прослушиваний он <w>начинает по-настоящему нравиться</w>."
                            }
                        },
                        {
                            "text": "The movie's subtle humor makes it a <w>grower</w> that you appreciate more each time you watch it.",
                            "target_lang_translations": {
                                "ru": "Тонкий юмор этого фильма делает его <w>вещью, которую ценишь больше</w> с каждым просмотром."
                            }
                        }
                    ],
                    "common_phrases": [
                        "real grower",
                        "bit of a grower"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used for music or art"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то (например, песня или человек), что начинает нравиться больше с течением времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вещь, которая нравится не сразу",
                                "target_lang_sense_clarification": "о музыке или искусстве"
                            },
                            {
                                "target_lang_word": "то, к чему нужно привыкнуть",
                                "target_lang_sense_clarification": "прежде чем оно полюбится"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37450bce-1b6f-3f98-af46-dd8ef67ade68",
                    "sense_definition": "A man whose penis increases significantly in size when erect compared to its flaccid state.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He described himself as a <w>grower</w> rather than a shower during the candid conversation.",
                            "target_lang_translations": {
                                "ru": "В ходе откровенного разговора он назвал себя скорее <w>гровером</w>, чем шоуером."
                            }
                        },
                        {
                            "text": "The article explained the physiological differences between men who are <w>growers</w> and those who are showers.",
                            "target_lang_translations": {
                                "ru": "В статье объяснялись физиологические различия между мужчинами-<w>гроверами</w> и теми, кто относится к типу «шоуер»."
                            }
                        }
                    ],
                    "antonyms": [
                        "shower"
                    ],
                    "common_phrases": [
                        "grower not a shower"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal anatomical reference"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужчина, чей пенис значительно увеличивается в размерах в состоянии эрекции по сравнению с расслабленным состоянием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гровер",
                                "target_lang_sense_clarification": "сленговый термин в данном контексте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}