                "senses": [
                    {
                        "sense_id": "298950eb-e83b-3f23-9246-15af15e3c30f",
                        "entry_id": "4381b26c-cb89-3343-a189-5f0a864cdfe3",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8c26701-4a61-40bb-8fb5-cbc832d33e9e",
                                "sense_id": "298950eb-e83b-3f23-9246-15af15e3c30f",
                                "text": "Frau Schwöble ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2f659032-b81a-4188-bbfc-75523faf07bc",
                                "sense_id": "298950eb-e83b-3f23-9246-15af15e3c30f",
                                "text": "Herr Schwöble wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "052bfee0-6c42-46f6-8ad2-7ff9f7177fdf",
                                "sense_id": "298950eb-e83b-3f23-9246-15af15e3c30f",
                                "text": "Die Schwöbles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "05ac1fb2-bcb9-4711-81f5-acd3649b7114",
                                "sense_id": "298950eb-e83b-3f23-9246-15af15e3c30f",
                                "text": "Der Schwöble trägt nie die Pullover, die die Schwöble ihm strickt."
                            },
                            {
                                "example_id": "99cf0ad6-d161-4b7a-aa05-175073d305ba",
                                "sense_id": "298950eb-e83b-3f23-9246-15af15e3c30f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schwöble kommt, geht der Herr Schwöble.“"
                            },
                            {
                                "example_id": "bf673aad-5a2a-4328-8b79-7b8ccab0a33d",
                                "sense_id": "298950eb-e83b-3f23-9246-15af15e3c30f",
                                "text": "Schwöble kommt und geht."
                            },
                            {
                                "example_id": "3376a630-5119-4e65-abb4-11f445a897a9",
                                "sense_id": "298950eb-e83b-3f23-9246-15af15e3c30f",
                                "text": "Schwöbles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
