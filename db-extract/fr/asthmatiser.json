                                "example_id": "a72fbac9-5701-48fa-9f83-36cce8881524",
                                "sense_id": "b39e1f57-abe5-32bd-988e-bf26a91cf3b9",
                                "text": "Elle hoquette (sur glace), suffoque, s’ébroue, asthmatise."
                            }
