                ],
                "senses": [
                    {
                        "sense_id": "3ad3adb7-09be-3b27-a941-36b7548228e4",
                        "entry_id": "bfdd2227-0044-3782-a797-274deaeaa1a4",
                        "glosses": [
                            "Gattungsbezeichnung der Spielwissenschaft für eine Gruppe von Spielen, die elektronische Medien nutzen für das spielerische Agieren in virtuellen Welten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07ee3db9-c70a-4e4b-9362-ca376bf96224",
                                "sense_id": "3ad3adb7-09be-3b27-a941-36b7548228e4",
                                "text": "„Eine historisch zu verfolgende Faszination für das Automatische (angefangen von den Uhrwerkspielen bis zu den Flipper-Automaten) mag die rasante Verbreitung von Elektronikspielen noch begünstigt haben.“"
                            },
                            {
                                "example_id": "e5f9c4b1-9d29-400f-aebe-ed623f11dfe4",
                                "sense_id": "3ad3adb7-09be-3b27-a941-36b7548228e4",
                                "text": "„Wie bei anderen Sinngebungen des Spielens, dürfte auch bei den Elektronikspielen die kritische Auswahl und der ausgewogene, maßvolle Umgang mit dem Spielangebot letztlich über Wert oder Unwert für den Spielenden entscheiden.“"
                            },
                            {
                                "example_id": "d91e64cd-b04b-49fc-9125-3e1117bc17f0",
                                "sense_id": "3ad3adb7-09be-3b27-a941-36b7548228e4",
                                "text": "„Die heimische Konkurrenz ist groß: Nintendo und Sega beherrschen den Weltmarkt der Elektronikspiele.“"
                            },
                            {
                                "example_id": "94bf3880-1844-4d10-a076-659f4db72d57",
                                "sense_id": "3ad3adb7-09be-3b27-a941-36b7548228e4",
                                "text": "„Dabei handelt es sich bei Elektronikspielen auch heute noch größtenteils um reine Reaktionsspiele, bei denen irgendwann der Zeitpunkt kommt, wo der Spieler das System des Computers im Griff – besser gesagt: im Finger – hat.“"
                            },
                            {
                                "example_id": "50117ab2-37ce-4dcb-bf02-a3c1fc6c3d68",
                                "sense_id": "3ad3adb7-09be-3b27-a941-36b7548228e4",
                                "text": "„Elektronikspiele, Telespiele, ferngesteuerte Gefährte und Schach-Computer sollen dieses Weihnachtsfest groß und klein erfreuen.“"
                            },
                            {
                                "example_id": "d26a305b-55d8-44cc-9027-fd7e9ce26751",
                                "sense_id": "3ad3adb7-09be-3b27-a941-36b7548228e4",
                                "text": "„Als Computerspiele, Telespiele, elektronische Spiele werden sehr verschiedene Spiel- und Lernmittel bezeichnet, die man, nach ihrer Technik und nach ihrer Spielqualität, durchaus unterscheiden muß.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
