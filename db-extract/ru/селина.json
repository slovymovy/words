                    {
                        "translation_id": "b8f3c676-708b-440f-8f3c-73cdb3882809",
                        "source_entry_id": "d966d612-292d-3253-a865-3624e8fa8c24",
                        "source_sense_id": "dd20eead-fb84-37ed-afa1-9f568ab18067",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Céline",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Céline",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db29185f-d25b-330f-97ba-fe8b861b4f98",
                                        "entry_id": "61edc3e0-480c-3a68-881b-d164a89d83f4",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c57ee401-c151-4373-a2d2-8c57ea069400",
                                                "sense_id": "db29185f-d25b-330f-97ba-fe8b861b4f98",
                                                "text": "Les grammairiens se sont passé le mot pendant des siècles pour « muettiser » les femmes, estime Céline Labrosse, auteur de Pour une grammaire non sexiste. Il faut donc « dégenriser », dit-elle, abolir la prépondérance du masculin."
                                            },
                                            {
                                                "example_id": "dad78cb1-84ee-4d13-96f8-3001c1bd556f",
                                                "sense_id": "db29185f-d25b-330f-97ba-fe8b861b4f98",
                                                "text": "Pour la septième semaine, Céline Parzys mettra à l’honneur le patrimoine culinaire de la Charente-Maritime."
                                            },
                                            {
                                                "example_id": "8ea0ea6e-1d99-40db-9db5-d8258ebe9bf6",
                                                "sense_id": "db29185f-d25b-330f-97ba-fe8b861b4f98",
                                                "text": "Dis-moi, Céline, les années ont passé\n Pourquoi n'as-tu jamais pensé à te marier ?\n De tout's mes sœurs qui vivaient ici\n Tu es la seule sans mari."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Céline",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4249b09a-52be-348b-baec-cd1dcc1cc68f",
                                        "entry_id": "da6e0d3c-07cd-312a-81ab-2a85a4bbc54a",
                                        "glosses": [
                                            "Pseudonyme de Louis-Ferdinand Destouches, écrivain français plus connu sous l’appellation de Louis-Ferdinand Céline."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
