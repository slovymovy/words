                        "glosses": [
                            "zawodowy rzecznik czyichś interesów wywierający wpływ na władze publiczne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85881fda-852e-4d01-988b-2469bf4843ba",
                                "sense_id": "ca75bea3-9ee8-38c8-892c-4c524fd62a06",
                                "text": "W polskim parlamencie zawód lobbysty wykonuje 16 osób, w brytyjskim 3 tys., a w europejskim – 15 tys.."
                            },
                            {
                                "example_id": "e13f0ea1-957b-42d8-ba65-2fb8e579204f",
                                "sense_id": "ca75bea3-9ee8-38c8-892c-4c524fd62a06",
                                "text": "Scena z filmu: w luksusowej brukselskiej restauracji mężczyzna z arogancją opowiada o swojej działalności lobbysty."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
