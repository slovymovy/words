                "senses": [
                    {
                        "sense_id": "aa9006d4-084c-3c39-aee6-73591098fd1e",
                        "entry_id": "a0bf5327-d115-397f-95e1-60ee4a3f7aef",
                        "glosses": [
                            "op Mexico betrekking hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeabd5ca-f324-41d6-85e7-af90a588b509",
                                "sense_id": "aa9006d4-084c-3c39-aee6-73591098fd1e",
                                "text": "Er waren maar drie regels in haar Hippie Daycare: iedereen moest een Hawaii shirt aan tijdens het verblijf in haar tuin, je kon tegen een kleine donatie ’s avonds Mexicaans mee-eten en om tien uur moest je stil zijn voor de buren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86abcc94-eb5b-460b-84de-52fecb1ccba8",
                        "source_entry_id": "a0bf5327-d115-397f-95e1-60ee4a3f7aef",
                        "source_sense_id": "aa9006d4-084c-3c39-aee6-73591098fd1e",
                        "target_lang_word": "Mexican",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mexican",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d0c983b-edce-3976-af11-240a83d2829d",
                                        "entry_id": "bc334921-447f-3765-b959-0d5c8fb4848e",
                                        "glosses": [
                                            "A Mexica; an Aztec."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4c1cf63-3536-48e0-acc7-79b0cd0ea169",
                                                "sense_id": "4d0c983b-edce-3976-af11-240a83d2829d",
                                                "text": "Surely, nature it ſelf calls to us for this reſpect to a deity, even the very ſavage Indians may teach us this point of religion; amongſt whom we find the Mexicans, a people that had never had any intercourſe with the other three parts of the World, Eminent in this kinde; what ſumptuous, and ſtately Temples had they erected to their Devils: How did they enrich their miſ-called Gods with Magazins of their treaſure?"
                                            },
                                            {
                                                "example_id": "3d259e86-8668-4a14-9db4-b7bb23b8f00d",
                                                "sense_id": "4d0c983b-edce-3976-af11-240a83d2829d",
                                                "text": "Not unlike to this were thoſe morſels of Paſte, which the Mexicans uſed in their Religious Feaſts, which they laid at their Idols Feet, conſecrating them by Singing and other Ceremonies, and then they called them the Fleſh and Bones of their God Vitziliputzli"
                                            },
                                            {
                                                "example_id": "20ae9a92-5024-40a7-84e0-4462ea66d95f",
                                                "sense_id": "4d0c983b-edce-3976-af11-240a83d2829d",
                                                "text": "The Aztecheſe, or Mexicans, were the laſt who arrived in Anahuac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56f1c4c2-0449-3599-9995-9fdacfcc3463",
                                        "entry_id": "bc334921-447f-3765-b959-0d5c8fb4848e",
                                        "glosses": [
                                            "The Nahuatl language."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53f665b5-5f85-4477-b29b-0997210d5e2c",
                                                "sense_id": "56f1c4c2-0449-3599-9995-9fdacfcc3463",
                                                "text": "Painala was in the Mexican province of Coatzacualco: she was accordingly able to speak Mexican."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51598839-2cf2-3a9e-b7db-8a32e5a64441",
                                        "entry_id": "bc334921-447f-3765-b959-0d5c8fb4848e",
                                        "glosses": [
                                            "A person from the country of Mexico or of Mexican descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddb18c63-3964-4297-8522-90f097650a73",
                                                "sense_id": "51598839-2cf2-3a9e-b7db-8a32e5a64441",
                                                "text": "The Mexican levelled nine minutes from time after Steven Gerrard, making his first start since undergoing groin surgery in April, put Liverpool ahead with a 68th-minute free-kick."
                                            },
                                            {
                                                "example_id": "70c0fd72-c585-432b-9adb-5b7ac8a0ece7",
                                                "sense_id": "51598839-2cf2-3a9e-b7db-8a32e5a64441",
                                                "text": "When Google announced it was complying with US President Donald Trump’s executive order to rename the Gulf of Mexico to the Gulf of America, many Mexicans responded with a laugh and a long, exhausted sigh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18aca676-3804-38f8-a539-95b5f79d671a",
                                        "entry_id": "bc334921-447f-3765-b959-0d5c8fb4848e",
                                        "glosses": [
                                            "The Mexican dialect of Spanish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f09eadb-f8f7-4660-8669-5f7ac3783307",
                                                "sense_id": "18aca676-3804-38f8-a539-95b5f79d671a",
                                                "text": "\"You see, I never learned to speak Spanish, but speak Mexican fluently,\" he says disarmingly."
                                            },
                                            {
                                                "example_id": "53400b8b-eabb-4bde-8828-3d34b224066a",
                                                "sense_id": "18aca676-3804-38f8-a539-95b5f79d671a",
                                                "text": "You really scare me when you speak Mexican."
                                            },
                                            {
                                                "example_id": "d82049c6-df83-457c-84e9-259f17176142",
                                                "sense_id": "18aca676-3804-38f8-a539-95b5f79d671a",
                                                "text": "I didn't speak much Mexican, but I savvied a lot more than I could speak and picked the word banditos out of their conversation."
                                            },
                                            {
                                                "example_id": "f5cbb0fe-92b9-4272-90dd-18672b332637",
                                                "sense_id": "18aca676-3804-38f8-a539-95b5f79d671a",
                                                "text": "DON COLLIER: Hey, you want to talk Mexican, join another tank, a Mexican tank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca85d8fc-ec6c-3b0e-adca-50fbeea7b486",
                                        "entry_id": "bc334921-447f-3765-b959-0d5c8fb4848e",
                                        "glosses": [
                                            "A person from, or of descent from, any Spanish-speaking country."
                                        ],
                                        "tags": [
                                            "US",
                                            "offensive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a37fd397-4328-4b16-91cc-4fb0a0cd1e72",
                                                "sense_id": "ca85d8fc-ec6c-3b0e-adca-50fbeea7b486",
                                                "text": "Fox News issued an apology on Sunday for an on-screen graphic that mistakenly indicated President Donald Trump was reducing aid to \"three Mexican countries.\""
                                            },
                                            {
                                                "example_id": "6f83b962-b652-4d5c-9531-89b3b5203202",
                                                "sense_id": "ca85d8fc-ec6c-3b0e-adca-50fbeea7b486",
                                                "text": "What kind of Mexican are you?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c490e5ed-83f8-30ca-98ac-9ea2f8d3813a",
                                        "entry_id": "bc334921-447f-3765-b959-0d5c8fb4848e",
                                        "glosses": [
                                            "A Victorian (a person from the state of Victoria)."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-South-Wales",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
