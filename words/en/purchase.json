                {
                    "sense_id": "b1412cd6-a4d9-37e4-adc6-1b5ebeaa0326",
                    "sense_definition": "Something that has been bought or acquired.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "noun_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She carried her new <w>purchases</w> home in a large paper bag.",
                            "target_lang_translations": {
                                "ru": "Она несла свои новые <w>покупки</w> домой в большом бумажном пакете.",
                                "tr": "Yeni <w>aldıklarını</w> eve büyük bir kağıt torbada taşıdı.",
                                "zh": "她用一个大纸袋把新<w>买的商品</w>带回了家。"
                            }
                        },
                        {
                            "text": "He was very pleased with his latest <w>purchase</w> from the electronics store.",
                            "target_lang_translations": {
                                "ru": "Он был очень доволен своим последним <w>приобретением</w> в магазине электроники.",
                                "tr": "Elektronik mağazasından yaptığı son <w>alışverişten</w> çok memnun kaldı.",
                                "zh": "他对最近在电子产品商店<w>买的东西</w>非常满意。"
                            }
                        }
