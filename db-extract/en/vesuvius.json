                "word": "Vesuvius",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "244b8d59-4c87-3a20-b527-2650cc342a3f",
                        "entry_id": "d10fa92f-863f-354c-9f44-06a96cf148e6",
                        "glosses": [
                            "A volcanic mountain located on the Gulf of Naples in Italy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73268301-ed34-4f73-a6e4-c5ce7ec3c136",
                                "sense_id": "244b8d59-4c87-3a20-b527-2650cc342a3f",
                                "text": "Hecla bellowed until the Icelanders feared a cataclysm. Vesuvius blew its head off."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ba8c7d2-787a-4f48-b239-e7c54d7dc212",
