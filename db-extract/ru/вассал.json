                                        "entry_id": "beb58f3a-be83-39f3-ab65-968687198891",
                                        "glosses": [
                                            "A male vassal (subject of a sovereign or lord)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e709b28-0fc1-4414-94ce-779b56636191",
                                                "sense_id": "06881a88-a608-3300-90cf-92b1947b0231",
                                                "text": "Three belied you, three betrayed you! One you betrayed was three times true! Lord Voryn Dagoth, Dagoth Ur, steadfast liegeman, faithful friend, bids you come and climb Red Mountain!"
                                            }
                                        ]
                                    }
                                ]
