                    {
                        "translation_id": "4ee22e11-da16-401c-b095-3e733288422d",
                        "source_entry_id": "79fa2b97-adc8-33be-b47a-626df70a3b23",
                        "source_sense_id": "b663a7cd-7835-3072-bf91-4731f6d57c42",
                        "target_lang_word": "pusher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pusher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6a31c54-9776-3dce-b7ce-b0cfdcdc5dd3",
                                        "entry_id": "1f0956ae-f7ce-3888-a6ec-e93a11aca3ea",
                                        "glosses": [
                                            "Someone or something that pushes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f107eacf-1b3a-3410-8f92-0b5196297956",
                                        "entry_id": "1f0956ae-f7ce-3888-a6ec-e93a11aca3ea",
                                        "glosses": [
                                            "A person employed to push passengers onto trains at busy times, so they can depart on schedule."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0cabd2fd-7490-38a4-8c76-31b589709d91",
                                        "entry_id": "1f0956ae-f7ce-3888-a6ec-e93a11aca3ea",
                                        "glosses": [
                                            "A girl or woman."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "143f4b8f-64af-4cbe-b428-8a5e5e7c39b2",
                                                "sense_id": "0cabd2fd-7490-38a4-8c76-31b589709d91",
                                                "text": "‘You should a seed some o' the pushers. Girls o' seventeen painted worse nor any Gerties I'd ever knowed.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a369b516-8c67-3875-86d5-cff0caa475a8",
                                        "entry_id": "1f0956ae-f7ce-3888-a6ec-e93a11aca3ea",
                                        "glosses": [
                                            "A drug dealer."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8b38b9f-1306-4763-8a28-0d05812d8e47",
                                                "sense_id": "a369b516-8c67-3875-86d5-cff0caa475a8",
                                                "text": "But the pusher don't care / Ah, if you live or if you die / God damn, the pusher / God damn, I say the pusher"
                                            },
                                            {
                                                "example_id": "d5d0d162-58b0-40e1-8b52-7d59c0ae1d71",
                                                "sense_id": "a369b516-8c67-3875-86d5-cff0caa475a8",
                                                "text": "My campaign against drug will not stop until the, until the end of my term. That will be six years from now. Until the last pusher and the last drug lord are – [applause]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19a1e7f8-148b-373e-b916-aad88edf3df1",
                                        "entry_id": "1f0956ae-f7ce-3888-a6ec-e93a11aca3ea",
                                        "glosses": [
                                            "An aircraft with the propeller behind the fuselage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04a0ef34-945c-32db-856e-215a88c3239f",
                                        "entry_id": "1f0956ae-f7ce-3888-a6ec-e93a11aca3ea",
                                        "glosses": [
                                            "A device that one pushes in order to transport a baby while on foot, such as a stroller or pram (as opposed to a carrier such as a front or back pack)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76e8965a-148e-42c9-9bb9-e719b554fdf0",
                                                "sense_id": "04a0ef34-945c-32db-856e-215a88c3239f",
                                                "text": "You have two flights of stairs and no elevator. As you get closer to your due date that will be awkward, and once the baby arrives a pusher would never make it up there. You can hardly carry a fully loaded pram and baby up two flights."
                                            },
                                            {
                                                "example_id": "ba142941-e63d-4668-9e89-1097876e3d04",
                                                "sense_id": "04a0ef34-945c-32db-856e-215a88c3239f",
                                                "text": "Two of the participants even decided to purchase a carrier instead of a pusher as they wanted to “permanently hold their baby”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cfaeb8a-090d-3d1e-ab75-f84a532695d2",
                                        "entry_id": "1f0956ae-f7ce-3888-a6ec-e93a11aca3ea",
                                        "glosses": [
                                            "A defensive player who does not attempt to hit winners, instead playing slower shots into the opponent's court."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c3f62f7-cd00-3b64-b353-f602cf7966a8",
                                        "entry_id": "1f0956ae-f7ce-3888-a6ec-e93a11aca3ea",
                                        "glosses": [
                                            "A tolkach."
                                        ],
                                        "tags": [
                                            "historical",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f310899-9275-4b6b-abf3-ca5bd9b238fe",
                                                "sense_id": "4c3f62f7-cd00-3b64-b353-f602cf7966a8",
                                                "text": "Time-and-motion study meant objective (that is, testable) standards for setting the pace of work so that, when workers complained of speedup, it was now less out of outrage that the foreman was a \"pusher\" than that the system itself was being violated or manipulated."
                                            },
                                            {
                                                "example_id": "51e1fd4d-58df-4741-88b5-caa30f5dc42e",
                                                "sense_id": "4c3f62f7-cd00-3b64-b353-f602cf7966a8",
                                                "text": "Large factories use “pushers” who cajole, threaten, wine, dine, and bribe those in whose hands rests the power to allocate needed resources, machinery, raw materials, or spare parts. It is often the only way to cross the bureaucratic thicket, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2c66597-7f42-36ce-af88-3dfccfee996b",
                                        "entry_id": "1f0956ae-f7ce-3888-a6ec-e93a11aca3ea",
                                        "glosses": [
                                            "Synonym of banker (“type of railway locomotive”)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e599ecd1-a22c-357f-8fe6-b445c5ee3fa2",
                                        "entry_id": "1f0956ae-f7ce-3888-a6ec-e93a11aca3ea",
                                        "glosses": [
                                            "A device in a coke oven for levelling the coal, traditionally operated by a pusherman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2fc39a5-6afd-4c64-9aa0-9af5aec91fa5",
                        "source_entry_id": "79fa2b97-adc8-33be-b47a-626df70a3b23",
