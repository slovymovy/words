                        "glosses": [
                            "Wind mit abwärts gerichteter Windströmung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f4802b0-1201-486d-8a16-01740dd1ec16",
                                "sense_id": "49bb1a2e-0899-3b72-8d69-8f6dd0677bcf",
                                "text": "„20 bis 40 Besatzungsmitglieder waren sowohl in der Lage, die Boote in schützende Buchten bei starken Fallwinden oder bei Flauten zu rudern., als auch Landung oder Wasserung zu vollziehen.“"
                            },
                            {
                                "example_id": "69a76d8b-81a2-4fc4-9881-c6f4b24cc8ae",
                                "sense_id": "49bb1a2e-0899-3b72-8d69-8f6dd0677bcf",
                                "text": "„Im gesamten Winterhalbjahr kann einen der launische Fallwind Bora erwischen, der mit über dreißig Metern pro Sekunde aus den Bergen im Nordosten weht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
