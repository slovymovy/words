                    {
                        "sense_id": "2c3cb153-072d-3909-a120-dba28f3cf0ea",
                        "entry_id": "ef15c602-afea-3a69-8797-d25444fcd5f1",
                        "glosses": [
                            "A person's mouth or tongue."
                        ],
                        "tags": [
                            "UK",
                            "obsolete",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "e15b28ec-f3e4-4094-8496-bf69febe4b12",
                                "sense_id": "2c3cb153-072d-3909-a120-dba28f3cf0ea",
                                "text": "\"Shut your dubber. Think you're a regular duchess, you do, eh? I ain't answering no more questions.\""
                            },
                            {
                                "example_id": "39100b5c-7601-4d46-8f37-530794268ef3",
                                "sense_id": "2c3cb153-072d-3909-a120-dba28f3cf0ea",
                                "text": "\"Well, Sal, you mum your dubber pretty generally, but when you do slacken your glib you may as well do it civilly.\""
                            }
                        ]
                    }
