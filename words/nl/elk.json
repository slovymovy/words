                                "target_lang_word": "apiece",
                                "target_lang_sense_clarification": "for each one"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "каждому",
                                "target_lang_sense_clarification": "поровну на человека"
                            },
                            {
                                "target_lang_word": "на каждого",
                                "target_lang_sense_clarification": "в расчете на одного"
                            }
                        ]
                    }
                }
            ]
        }
    ]
