                "senses": [
                    {
                        "sense_id": "03d0802a-e82d-38fc-a2d7-9389b300a5dd",
                        "entry_id": "4cd31e08-0846-32a7-aca9-8ca4e75fd6dd",
                        "glosses": [
                            "Poststempel, der die Form eines Halbkreises aufweist"
                        ],
                        "tags": [
                            "Philatelie"
                        ],
                        "examples": [
                            {
                                "example_id": "4e1e31c9-e44c-4b71-b025-dd45f0480964",
                                "sense_id": "03d0802a-e82d-38fc-a2d7-9389b300a5dd",
                                "text": "„Wenn der Halbkreiser auch die häufigste Stempelform ist, so hat doch auch sie ihre Raritäten.“"
                            },
                            {
                                "example_id": "a7205612-fd44-4f96-b947-93c001b6e522",
                                "sense_id": "03d0802a-e82d-38fc-a2d7-9389b300a5dd",
                                "text": "„Ein Dienstbrief mit bayerischem Halbkreiser von Gersfeld wurde am 20.12.1866 (!) geschrieben - der Inhalt betrifft ‚Einquartierung‘.“"
                            },
                            {
                                "example_id": "0ea94bba-f5e6-4a19-8709-82ab331f8f4f",
                                "sense_id": "03d0802a-e82d-38fc-a2d7-9389b300a5dd",
                                "text": "„Beide Briefe sind jeweils frankiert mit einer MiNr. 4 I mit ausgefüllten Ecken und mit einem sauberen Halbkreiser von Hassloch entwertet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
