{
    "word_family": [
        "kijken",
        "bekijken",
        "nakijken",
        "uitkijken",
        "toekijken",
        "omkijken",
        "afkijken",
        "inkijken"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a99023cd-b0de-3590-9a40-8b8a11b7bce1",
                    "sense_definition": "de blik omhoog richten of stoppen met wat je doet om te kijken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visuele actie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij zat rustig te lezen maar <w>keek</w> even <w>op</w> toen zij de kamer binnenkwam.",
                            "target_lang_translations": {
                                "en": "He was reading quietly but <w>looked up</w> for a moment when she entered the room."
                            }
                        },
                        {
                            "text": "Je moet niet de hele tijd naar de grond <w>opkijken</w> als je wandelt.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>look up</w> from the ground all the time when you are walking."
                            }
                        }
                    ],
                    "synonyms": [
                        "omhoogkijken"
                    ],
                    "antonyms": [
                        "neerkijken"
                    ],
                    "common_phrases": [
                        "even opkijken",
                        "van een boek opkijken"
                    ],
                    "target_lang_definitions": {
                        "en": "to direct one's gaze upwards or to stop what one is doing to look"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "look up",
                                "target_lang_sense_clarification": "to raise one's eyes"
                            },
                            {
                                "target_lang_word": "glance up",
                                "target_lang_sense_clarification": "to look up briefly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f864e4cb-d02c-3120-bc3f-a08a53cf9633",
                    "sense_definition": "iemand met veel respect en bewondering behandelen of beschouwen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bewondering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veel jonge meisjes <w>kijken</w> enorm naar haar <w>op</w> omdat ze een groot idool is.",
                            "target_lang_translations": {
                                "en": "Many young girls <w>look up to</w> her immensely because she is a great idol."
                            }
                        },
                        {
                            "text": "Het is belangrijk dat kinderen naar hun ouders kunnen <w>opkijken</w> voor inspiratie.",
                            "target_lang_translations": {
                                "en": "It is important that children can <w>look up to</w> their parents for inspiration."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewonderen",
                        "opzien"
                    ],
                    "antonyms": [
                        "neerkijken"
                    ],
                    "common_phrases": [
                        "naar iemand opkijken",
                        "tegen iemand opkijken"
                    ],
                    "target_lang_definitions": {
                        "en": "to treat or regard someone with great respect and admiration"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "look up to",
                                "target_lang_sense_clarification": "to admire someone as a role model"
                            },
                            {
                                "target_lang_word": "admire",
                                "target_lang_sense_clarification": "to regard with respect"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb5c3592-ad83-3941-8a51-f5b492efeb39",
                    "sense_definition": "verrast of verbaasd zijn over een onverwachte gebeurtenis",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verrassing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>keek</w> er vreemd van <w>op</w> dat ik zonder hulp geslaagd was voor het examen.",
                            "target_lang_translations": {
                                "en": "He <w>was surprised</w> that I had passed the exam without help."
                            }
                        },
                        {
                            "text": "Ik <w>keek</w> ervan <w>op</w> toen iemand mij plotseling inhaalde tijdens de wedstrijd.",
                            "target_lang_translations": {
                                "en": "I <w>was surprised</w> when someone suddenly overtook me during the race."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ervan opkijken",
                        "vreemd opkijken"
                    ],
                    "target_lang_definitions": {
                        "en": "to be surprised or amazed by an unexpected event"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be surprised",
                                "target_lang_sense_clarification": "to feel wonder or astonishment"
                            },
                            {
                                "target_lang_word": "be taken aback",
                                "target_lang_sense_clarification": "to be shocked or surprised"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "266c0f82-905c-3dde-81b1-b7b4f999eb33",
                    "sense_definition": "met tegenzin of angst verwachten dat iets gaat gebeuren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tegenzin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kijk</w> er echt tegen <w>op</w> om na de vakantie weer te gaan werken.",
                            "target_lang_translations": {
                                "en": "I am really <w>dreading</w> going back to work after the holiday."
                            }
                        },
                        {
                            "text": "Zij <w>kijkt</w> erg tegen het moeilijke gesprek met haar baas <w>op</w>.",
                            "target_lang_translations": {
                                "en": "She is <w>dreading</w> the difficult conversation with her boss."
                            }
                        }
                    ],
                    "synonyms": [
                        "opzien"
                    ],
                    "common_phrases": [
                        "tegen iets opkijken",
                        "er tegenop kijken"
                    ],
                    "target_lang_definitions": {
                        "en": "to anticipate something with reluctance or fear"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dread",
                                "target_lang_sense_clarification": "to anticipate with great fear or reluctance"
                            },
                            {
                                "target_lang_word": "look forward to with dread",
                                "target_lang_sense_clarification": "to anticipate something unpleasant"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}