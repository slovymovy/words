                                        "glosses": [
                                            "heen en weer bewegen, zwalken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "450f3360-79b4-45a4-b4a6-9ca6853c294d",
                                                "sense_id": "38ecb928-c8eb-3b4d-942b-d22cc986d814",
                                                "text": "Hoe hij destijds ook zo heen en weer aan het zwabberen was met zijn armen uitgestrekt, toen we in een ander land woonden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f28b9e52-3723-33a6-b9ba-4a06528290df",
                                        "entry_id": "ce6f5b3e-6c98-3751-a310-8740cd80ac70",
                                        "glosses": [
                                            "het reinigen met een zwabber"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91221da5-0e84-4912-87ad-34f5aad8643d",
                                                "sense_id": "f28b9e52-3723-33a6-b9ba-4a06528290df",
                                                "text": "Die huisvrouw zwabbert elke dag."
                                            },
                                            {
                                                "example_id": "e305dd0c-deb5-4ead-af94-84546971b0c9",
                                                "sense_id": "f28b9e52-3723-33a6-b9ba-4a06528290df",
                                                "text": "Wanneer ik daar zat, verscheen elke morgen een man in een blauwe overall die het dek kwam zwabberen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
