                "senses": [
                    {
                        "sense_id": "5befa2c0-0a68-34c5-a4e1-e833bbe9e571",
                        "entry_id": "652f42a1-1974-3401-a1f2-7746311efbff",
                        "glosses": [
                            "Panzer, der mit Waffen zur Abwehr feindlicher Luftfahrzeuge und Flugkörper ausgerüstet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50e7914a-c5a5-4b0b-a346-2a32bc3b8cb1",
                                "sense_id": "5befa2c0-0a68-34c5-a4e1-e833bbe9e571",
                                "text": "„21 Flugabwehrpanzer vom Typ M 42 verloren im Juni 1960 auf dem Marsch von Lüneburg nach Rendsburg insgesamt 95 Kettenpolster.“"
                            },
                            {
                                "example_id": "fd13bddb-6c63-4755-888d-13935e201b0d",
                                "sense_id": "5befa2c0-0a68-34c5-a4e1-e833bbe9e571",
                                "text": "„Allein das Heer wird Mitte dieses Jahrzehnts, wenn der Leopard-2-Panzer bei der Truppe ist und zugleich die Wehrpflichtigen knapp werden, 4837 Kampf- und 3432 Schützen-, Jagd-, Späh- und Flugabwehrpanzer sowie Zehntausende geländegängige Last- und Personenwagen fahren, pflegen und instandsetzen müssen.“"
                            },
                            {
                                "example_id": "5affed24-e685-4de0-873f-849c6b5b49dc",
                                "sense_id": "5befa2c0-0a68-34c5-a4e1-e833bbe9e571",
                                "text": "„Deutschland verkauft seine ausrangierten Flugabwehrpanzer Gepard nach Brasilien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
