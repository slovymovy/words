                ],
                "senses": [
                    {
                        "sense_id": "d29763b6-3fdd-3f2c-a6cd-eabfc97be47f",
                        "entry_id": "e83380ef-22ef-36ca-a80b-4a78cc86d06e",
                        "glosses": [
                            "Eigenschaft/Tatsache, nicht den Gesetzen des Landes unterworfen zu sein, auf dessen Territorium man/etwas sich befindet"
                        ],
                        "tags": [
                            "Völkerrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "1ebe5ad6-3b5b-435c-bb69-2fd181730f40",
                                "sense_id": "d29763b6-3fdd-3f2c-a6cd-eabfc97be47f",
                                "text": "„Der Ausdruck Exterritorialität ist aber nicht dahin zu verstehen, daß sich die Personen und Sachen, denen Rechte der Exterritorialität zustehen, außerhalb des Gebietes des Empfangsstaates befinden.“"
                            },
                            {
                                "example_id": "16063279-281e-4aa3-bc6f-5f388155432c",
                                "sense_id": "d29763b6-3fdd-3f2c-a6cd-eabfc97be47f",
                                "text": "„Demgemäß muß unterschiedslos einem fremden Staatshaupt im Ausland der Anspruch auf Unverletzlichkeit, dh. erhöhten strafrechtlichen Schutz und Exterritorialität zugebilligt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
