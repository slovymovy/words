                "senses": [
                    {
                        "sense_id": "ce3782ac-ce9b-376c-ac04-e857377266c7",
                        "entry_id": "1a25afc8-2bfd-3740-98f6-4388ddf1e3b1",
                        "glosses": [
                            "eurasische Giftschlange aus der Familie der Vipern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "790e4abd-3276-4f79-b46c-c73763e009eb",
                                "sense_id": "ce3782ac-ce9b-376c-ac04-e857377266c7",
                                "text": "Die Kreuzotter ist die einzige Schlange, die auch nördlich des nördlichen Polarkreises vorkommt."
                            },
                            {
                                "example_id": "879bd57d-126b-42ea-99b7-adf56d6ab32b",
                                "sense_id": "ce3782ac-ce9b-376c-ac04-e857377266c7",
                                "text": "„Während wir langsam durch den Wald spazierten, trafen wir sogar auf eine giftige Kreuzotter, aber die schlängelte schnell weg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
