                "senses": [
                    {
                        "sense_id": "07e481ca-2f87-3bd4-8ec7-e7e46481ec4e",
                        "entry_id": "2b732b4e-0080-3159-a069-49846930c95c",
                        "glosses": [
                            "Qui se fait deux fois par jour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b59acb92-0f4a-453d-a0ca-0f82c9c234fb",
                                "sense_id": "07e481ca-2f87-3bd4-8ec7-e7e46481ec4e",
                                "text": "Un rinçage bijournalier est recommandé."
