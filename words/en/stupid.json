                                "target_lang_word": "超级",
                                "target_lang_sense_clarification": "口语，表示程度高"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d276dd43-ee0e-3a33-ac96-03f6e15db8a5",
                    "sense_definition": "A person who lacks intelligence or acts foolishly.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a <w>stupid</w>, come back here and help me.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>дураком</w>, вернись и помоги мне.",
                                "zh": "别当<w>傻瓜</w>了，快回来帮我。"
                            }
                        },
                        {
                            "text": "I felt like a <w>stupid</w> when I realized I had the wrong date.",
                            "target_lang_translations": {
                                "ru": "Я чувствовал себя <w>дураком</w>, когда понял, что перепутал дату.",
                                "zh": "当我意识到日期搞错时，觉得自己像个<w>笨蛋</w>。"
                            }
