                ],
                "senses": [
                    {
                        "sense_id": "ea665668-2ad8-3cf9-8781-c71f4549e4db",
                        "entry_id": "4fc8bb0e-6889-3e8f-a956-e617fda08a8c",
                        "glosses": [
                            "Menge zusammengehöriger Sprachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c2582ed-f4f5-4bd8-9e81-40c897f812f7",
                                "sense_id": "ea665668-2ad8-3cf9-8781-c71f4549e4db",
                                "text": "„Bei den inselkeltischen Sprachen wiederum unterscheidet man die goidelische Sprachgruppe mit den Sprachen Irisch, Gälisch und Manx und die britannische Sprachgruppe mit den Sprachen Kymrisch, Kumbrisch, Kornisch und Bretonisch.“"
                            },
                            {
                                "example_id": "636685a6-0f59-459b-bdaa-837a639a8ea5",
                                "sense_id": "ea665668-2ad8-3cf9-8781-c71f4549e4db",
                                "text": "„Sie alle teilen sich in große Sprachgruppen, etwa in die der Niloten im erweiterten Einzugsgebiet des Weißen Nil, der Bantu-Sprecher in Zentral- und Ostafrika oder der Khoisan im äußersten Süden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "55037764-1deb-317a-bc08-d2e4dcec0ae7",
                        "entry_id": "4fc8bb0e-6889-3e8f-a956-e617fda08a8c",
                        "glosses": [
                            "Menschen gleicher Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8082cf6-3f77-4d84-af21-5d69c25aabc4",
                                "sense_id": "55037764-1deb-317a-bc08-d2e4dcec0ae7",
                                "text": "Die beiden großen Sprachgruppen in Belgien tun sich schwer miteinander."
                            },
                            {
                                "example_id": "4d854822-3f55-4058-ad53-9f44f5120b62",
                                "sense_id": "55037764-1deb-317a-bc08-d2e4dcec0ae7",
                                "text": "„Siedeln zwei Sprachgruppen auf demselben Grund und Boden, wird sich die Sprache der Gruppe mit dem höheren Prestige durchsetzen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
