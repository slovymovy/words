    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b491c745-3eda-3690-8a24-cc82a01df0fb",
                    "sense_definition": "Full completely to the top edge, often so full that contents threaten to spill over; overflowing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fullness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She carefully carried a <w>brimming</w> cup of tea into the living room.",
                            "target_lang_translations": {
                                "nl": "Voorzichtig droeg ze een <w>boordevol</w> kopje thee naar de woonkamer."
                            }
                        },
                        {
                            "text": "His eyes were <w>brimming</w> with tears as he listened to the moving story.",
                            "target_lang_translations": {
                                "nl": "Zijn ogen <w>stonden vol</w> tranen toen hij naar het ontroerende verhaal luisterde."
                            }
                        }
                    ],
                    "synonyms": [
                        "overflowing",
                        "brimful"
                    ],
                    "antonyms": [
                        "empty"
                    ],
                    "common_phrases": [
                        "brimming with confidence",
                        "brimming with tears",
                        "brimming with excitement"
                    ],
                    "target_lang_definitions": {
                        "nl": "Helemaal vol tot aan de rand, vaak zó vol dat het bijna overloopt; overvol."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "boordevol",
                                "target_lang_sense_clarification": "tot aan de boord of rand gevuld"
                            },
                            {
                                "target_lang_word": "overvol",
                                "target_lang_sense_clarification": "zo vol dat het bijna overloopt"
                            },
                            {
                                "target_lang_word": "afgeladen vol",
                                "target_lang_sense_clarification": "helemaal vol"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c17b6fa4-fc7b-339b-b56f-efcf7707edc6",
                    "sense_definition": "present participle and gerund of <w>brim</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fullness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river was <w>brimming</w> over its banks after the heavy winter rains.",
                            "target_lang_translations": {
                                "nl": "De rivier <w>stroomde over</w> haar oevers na de zware winterregens."
                            }
                        },
                        {
                            "text": "She could not speak because she was <w>brimming</w> with intense emotion.",
                            "target_lang_translations": {
                                "nl": "Ze kon niet praten omdat ze <w>overliep</w> van intense emotie."
                            }
