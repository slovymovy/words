{
    "word_family": [
        "annulation",
        "annulable",
        "annulatif",
        "annulateur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fc6b531c-8e86-394e-b90b-0153110473f4",
                    "sense_definition": "Décider qu'un événement prévu n'aura pas lieu, ou supprimer une commande, une réservation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "suppression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En raison du mauvais temps, la compagnie a décidé d'<w>annuler</w> notre vol pour Rome."
                        },
                        {
                            "text": "Je dois <w>annuler</w> un rendez-vous chez le médecin car je suis retenu au travail."
                        }
                    ],
                    "synonyms": [
                        "décommander",
                        "supprimer"
                    ],
                    "antonyms": [
                        "maintenir",
                        "confirmer"
                    ],
                    "common_phrases": [
                        "annuler un rendez-vous",
                        "annuler un vol",
                        "annuler une réservation"
                    ]
                },
                {
                    "sense_id": "88326038-6cd9-3c4f-a75c-a0a212d0b913",
                    "sense_definition": "Déclarer légalement nul, priver de valeur ou d'effet juridique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal a décidé d'<w>annuler</w> un contrat signé sous la contrainte."
                        },
                        {
                            "text": "Le juge a officiellement <w>annulé</w> cette vente en raison d'un vice caché."
                        }
                    ],
                    "synonyms": [
                        "invalider",
                        "casser",
                        "révoquer"
                    ],
                    "antonyms": [
                        "valider",
                        "entériner"
                    ],
                    "common_phrases": [
                        "annuler un contrat",
                        "annuler un jugement",
                        "annuler une élection"
                    ]
                },
                {
                    "sense_id": "771d1da7-ae2d-300f-b737-06e7d51c58be",
                    "sense_definition": "Se neutraliser mutuellement, perdre tout effet sous l'action d'une force contraire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "neutralisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces deux forces de direction opposée s'<w>annulent</w> complètement."
                        },
                        {
                            "text": "Tous leurs arguments contradictoires s'<w>annulent</w> mutuellement sans convaincre personne."
                        }
                    ],
                    "synonyms": [
                        "se neutraliser",
                        "se compenser"
                    ],
                    "common_phrases": [
                        "s'annuler mutuellement"
                    ]
                },
                {
                    "sense_id": "dba7b049-b11c-362e-be2e-0b3507f41256",
                    "sense_definition": "Prendre la valeur zéro, devenir nul en mathématiques.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette fonction mathématique s'<w>annule</w> lorsque la variable x est égale à un."
                        },
                        {
                            "text": "Le polynôme s'<w>annule</w> pour trois valeurs distinctes données par le calcul."
                        }
                    ]
                },
                {
                    "sense_id": "e1bdcc10-bad4-3ef9-aa65-f0abcc965a95",
                    "sense_definition": "Boycotter ou exclure socialement une personne publique en raison de propos ou d'actes jugés inacceptables.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ostracisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les internautes ont cherché à <w>annuler</w> cet artiste après ses déclarations polémiques."
                        },
                        {
                            "text": "Certains créateurs de contenu ont peur de se faire <w>annuler</w> sur les réseaux sociaux."
                        }
                    ],
                    "synonyms": [
                        "boycotter",
                        "bannir"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "calque de l'anglais cancel culture"
                        }
                    ]
                }
            ]
        }
    ]
}