                },
                {
                    "sense_id": "5bd2ebe6-9eb8-3f8b-be77-568a1d57a2ed",
                    "sense_definition": "rozpoczynać żęcie lub koszenie i wyprzedzać żniwiarza idącego z przodu",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rolnictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas żniw najsilniejszy kosiarz szybko zaczął <w>zażywać</w> innych pracowników na polu.",
                            "target_lang_translations": {
                                "ru": "Во время жатвы самый сильный косарь быстро стал <w>обгонять</w> других работников в поле."
                            }
                        },
                        {
                            "text": "Na wąskim zagonie nie należało <w>zażywać</w> sąsiada, aby uniknąć kłótni.",
                            "target_lang_translations": {
                                "ru": "На узкой полосе не следовало <w>зажинать</w> соседа, чтобы избежать ссоры."
                            }
                        }
                    ],
                    "traits": [
