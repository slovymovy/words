                                    {
                                        "sense_id": "199f5a4d-eb86-3d01-bfa3-448354aa2b04",
                                        "entry_id": "3cfc0663-b0d5-3704-b5ad-f0b4e6edd430",
                                        "glosses": [
                                            "ein im Bundesland Brandenburg (Deutschland) geborener oder dort auf Dauer lebender Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "795fc147-2af5-42b7-8d60-bd42c1f576e4",
                                                "sense_id": "199f5a4d-eb86-3d01-bfa3-448354aa2b04",
                                                "text": "Wer in Brandenburg das Wahlrecht hat, gilt als Brandenburger."
                                            },
                                            {
                                                "example_id": "e11e5bc1-eca8-41a1-8ebd-973ff1b15a73",
                                                "sense_id": "199f5a4d-eb86-3d01-bfa3-448354aa2b04",
                                                "text": "Was, du bist Brandenburger?"
                                            },
                                            {
                                                "example_id": "0b71c158-5975-4244-9f02-a6f98cc59aad",
                                                "sense_id": "199f5a4d-eb86-3d01-bfa3-448354aa2b04",
                                                "text": "Seit 1989 ist Gerald ein Brandenburger."
                                            },
                                            {
                                                "example_id": "ea2d8cd7-ca80-4b39-87e9-0db5cbfe39aa",
                                                "sense_id": "199f5a4d-eb86-3d01-bfa3-448354aa2b04",
                                                "text": "Wir haben im Urlaub eine Familie waschechter Brandenburger getroffen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a060b879-c3c3-3e64-b630-ce165b4d94a0",
                                        "entry_id": "3cfc0663-b0d5-3704-b5ad-f0b4e6edd430",
                                        "glosses": [
                                            "ein in der Stadt Brandenburg an der Havel geborener oder dort auf Dauer lebender Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae84b82e-05ff-4191-bb24-51c3ce121ee5",
                                                "sense_id": "a060b879-c3c3-3e64-b630-ce165b4d94a0",
                                                "text": "Wer in Brandenburg das Wahlrecht hat, gilt als Brandenburger."
                                            },
                                            {
                                                "example_id": "2d277386-b73b-4f8f-bd49-02ce0bb40d80",
