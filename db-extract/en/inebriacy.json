                                "sense_id": "467b3b4e-eddc-381c-8fac-52fe520bb1d2",
                                "text": "WICHITA, Kan., June 1—George Bradshaw, son of a prominent resident here, died yesterday from causes alleged to have been brought about by the treatment he was taking for the cure of inebriacy."
                            },
                            {
                                "example_id": "ba1ed74d-74f0-49de-9c83-76c1e4cf4ca8",
                                "sense_id": "467b3b4e-eddc-381c-8fac-52fe520bb1d2",
                                "text": "\"I have had a remarkable case of inebriacy under my personal observation. The patient drank heavily for fifteen years and reach a degraded condition.\""
                            }
                        ]
