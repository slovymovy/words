                "entry_id": "00abcfc5-ba63-3c4c-839c-37e1ed4752bd",
                "word": "jérémiade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a1870da8-592c-46f3-85a1-dd4c324b7843",
                        "entry_id": "00abcfc5-ba63-3c4c-839c-37e1ed4752bd",
                        "tags": [
                            "plural"
                        ],
                        "form": "jérémiades"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aafc5876-3ac6-320f-acce-ec8285694ea5",
                        "entry_id": "00abcfc5-ba63-3c4c-839c-37e1ed4752bd",
                        "glosses": [
                            "Plainte fréquente et importune."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "1ce2cd15-0c4b-43f5-b14e-07f6b90b3079",
                                "sense_id": "aafc5876-3ac6-320f-acce-ec8285694ea5",
                                "text": "Partant de ce point, ne sommes-nous pas autorisé à nous demander ce que signifient ces jérémiades forcées qui consistent à déplorer continuellement le sort de nos anciennes races ?"
                            },
                            {
                                "example_id": "e2fd29a0-aee0-4057-a0b0-d6888155f889",
                                "sense_id": "aafc5876-3ac6-320f-acce-ec8285694ea5",
                                "text": "Seulement celles-ci sont subordonnées à une histoire d'amour; le mythe permet d'éviter la jérémiade syndicaliste."
                            },
                            {
                                "example_id": "63c6d202-0a0e-4bfa-8022-1f78a8275261",
                                "sense_id": "aafc5876-3ac6-320f-acce-ec8285694ea5",
                                "text": "Entre jérémiades et désinformation, le président sortant a-t-il servi la cause des deux candidats républicains qui espèrent s’emparer des derniers sièges du Sénat?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec249527-8298-42f3-a762-e9a31903b1fa",
                        "source_entry_id": "00abcfc5-ba63-3c4c-839c-37e1ed4752bd",
                        "source_sense_id": "aafc5876-3ac6-320f-acce-ec8285694ea5",
                        "target_lang_word": "Jeremiade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jeremiade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "24a67072-8997-31e3-85df-8f61a12b1fb0",
                                        "entry_id": "b9b2a1c4-2037-33c8-9d7e-d5c09f0a9f81",
                                        "glosses": [
                                            "eine wortreiche, bewegte Klage"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d6a397e-5a4a-4363-9f3d-9c7d67426459",
                                                "sense_id": "24a67072-8997-31e3-85df-8f61a12b1fb0",
                                                "text": "Ich wollte mir nicht weiter die Jeremiaden dieses alten Mannes anhören."
                                            },
                                            {
                                                "example_id": "096da950-4058-4328-8e24-1586ce67be30",
                                                "sense_id": "24a67072-8997-31e3-85df-8f61a12b1fb0",
                                                "text": "„Ihre unaufhörlichen Jeremiaden hatten die Geduld des Advokaten auf eine so harte Probe gestellt, daß er die Gelegenheit seiner Berufung an das Gericht in Insterburg dazu benutzte, seiner quengelnden Gefährtin mit den allzu sauber gebürsteten Kleidern und der von Tränen ewig geröteten Nase endgültig zu entfliehen.“"
                                            },
                                            {
                                                "example_id": "ef0dc506-b7cd-48af-8ac8-3359fa4dcd08",
                                                "sense_id": "24a67072-8997-31e3-85df-8f61a12b1fb0",
                                                "text": "„Außerdem ging es in einer seiner liebsten Jeremiaden um den unweigerlichen Rückgang an »Menschen, die ernsthafte Bücher ernsthaft und verlässlich lesen« – kurz gesagt, um Roth-Leser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82cf9481-a0ca-4a26-86ef-ecf114c870c9",
                        "source_entry_id": "00abcfc5-ba63-3c4c-839c-37e1ed4752bd",
                        "source_sense_id": "aafc5876-3ac6-320f-acce-ec8285694ea5",
                        "target_lang_word": "Gejammer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gejammer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bdd08294-5272-3f22-9d70-5ee2d5ceb517",
                                        "entry_id": "d71eb6b2-69c5-3061-9c33-e2c0fdbb8de5",
                                        "glosses": [
                                            "anhaltendes Jammern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e83cea5c-a762-49b4-a1e7-56d5c6760e1a",
                                                "sense_id": "bdd08294-5272-3f22-9d70-5ee2d5ceb517",
                                                "text": "„Jetzt aber, in dem Erdbeben, in dem Geheul der Fliegersirenen, in dem Gejammer der flüchtenden Herden, wünsche ich mir das gewöhnliche Leben herbei wie Brot und Wasser.“"
                                            },
                                            {
                                                "example_id": "f593d4a1-7045-45bc-b667-f69051bc419f",
                                                "sense_id": "bdd08294-5272-3f22-9d70-5ee2d5ceb517",
                                                "text": "„Das 'Gejammer anderer Leute hatte ich schon mein Leben lang gehört.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
