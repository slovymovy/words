                        "glosses": [
                            "Sack, für den Transport und die Lagerung von Zement"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15529eea-6d93-481d-98e1-f189d68c4838",
                                "sense_id": "a7c6afdd-79d7-38d8-b628-d4d76ea12b60",
                                "text": "Die leeren Zementsäcke lagen in einer Ecke der Lagerhalle."
                            },
                            {
                                "example_id": "37129b20-bd97-4e51-8e89-462015e61e28",
                                "sense_id": "a7c6afdd-79d7-38d8-b628-d4d76ea12b60",
                                "text": "„Zementsäcke sollen nicht nur möglichst reißfest, sondern auch besonders porös sein, zwei diametral entgegengesetzte Eigenschaften.“"
                            },
                            {
                                "example_id": "1360ff9e-484d-4218-b075-b986f64931ba",
                                "sense_id": "a7c6afdd-79d7-38d8-b628-d4d76ea12b60",
                                "text": "„Die bunte Tasche beispielsweise war früher ein Zementsack.“"
                            }
                        ],
