                "senses": [
                    {
                        "sense_id": "540eebeb-871b-3f3a-9d5e-6275bdc39477",
                        "entry_id": "d295977b-05cb-313d-b180-0056d04121ba",
                        "glosses": [
                            "Besuch durch eine Frau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aab59b2b-cfb7-411a-b9e5-5e9e07ef29fc",
                                "sense_id": "540eebeb-871b-3f3a-9d5e-6275bdc39477",
                                "text": "„In den Stunden vor Barbaras erstem Besuch bei mir räumte ich so säuberlich auf, wie es Woody Allen in seiner eigenen Bude in ‚Play It Again, Sam‘ getan hatte, bevor der Damenbesuch anrollte.“"
                            },
                            {
                                "example_id": "2337467f-b2ae-43d6-87f8-9ec8a948e98d",
                                "sense_id": "540eebeb-871b-3f3a-9d5e-6275bdc39477",
                                "text": "„Damenbesuch wurde im Divinity House ebenso wenig geduldet wie bei Mrs. Purnell, und so musste Roth sie durch den Keller hineinschmuggeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
