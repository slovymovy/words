                "senses": [
                    {
                        "sense_id": "1b04de00-fcdc-3123-8426-e2caec6f03c8",
                        "entry_id": "f09e87b0-3208-3ea1-ad57-0fa587ee5cf6",
                        "glosses": [
                            "A female given name from the Slavic languages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0c611ac-6541-4856-80ec-36dfb05ef053",
                                "sense_id": "1b04de00-fcdc-3123-8426-e2caec6f03c8",
                                "text": "At the end of the evening―and remember it was a sad occasion―Auntie Fanny says, 'Shoiley, do me a favour, ask Myla'―she never called her Mila―'for the recipe.'"
                            },
                            {
                                "example_id": "455d5f76-2d24-411e-9489-2b38583eb162",
                                "sense_id": "1b04de00-fcdc-3123-8426-e2caec6f03c8",
                                "text": "My name is Mila. Mila is the name others gave me. The ones who found me. Mila is miracle."
                            },
                            {
                                "example_id": "c2513bbc-af90-4f69-b01b-45584a3e8e2d",
                                "sense_id": "1b04de00-fcdc-3123-8426-e2caec6f03c8",
                                "text": "And she persisted in calling me Mila after I had decreed that people should now use my full name: Sharmila."
                            }
                        ]
                    },
                    {
                        "sense_id": "94271fa7-1713-3172-8ad2-ea81f4bb1a8f",
                        "entry_id": "f09e87b0-3208-3ea1-ad57-0fa587ee5cf6",
