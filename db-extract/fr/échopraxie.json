                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "echopraxia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae8d300c-29be-3000-bda7-813827ab4bff",
                                        "entry_id": "4ad6b2a5-aabc-39b8-a7c4-e79befecef12",
                                        "glosses": [
                                            "The involuntary repetition or imitation of the observed movements of another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c6d0230-f280-4639-b8cf-74358857afce",
                                                "sense_id": "ae8d300c-29be-3000-bda7-813827ab4bff",
                                                "text": "For example, a tic is an automatic form of echopraxia, involving to some slight degree the emotions and the volition and having been originally acquired by suggestion and imitation."
                                            },
                                            {
                                                "example_id": "52e82ab1-464b-479a-bb81-60e51becc406",
                                                "sense_id": "ae8d300c-29be-3000-bda7-813827ab4bff",
                                                "text": "1964, Digest of Neurology and Psychiatry, Volumes 32-33, Institute of Living, page 260,\nEcholalia and echopraxia have been recognized as symptoms of seriously disturbed behavior in adults for over a century."
                                            },
                                            {
                                                "example_id": "c9791eed-a856-4b0f-a9fb-4ccb0b8f3a31",
                                                "sense_id": "ae8d300c-29be-3000-bda7-813827ab4bff",
                                                "text": "Several patients, after repeated experience of echopraxia and pantomime, had the delusion that they could communicate with others without using words—merely transmitting ideas by a bodily movement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
