{
    "word_family": [
        "mosaical",
        "mosaicism",
        "mosaicist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bedabbc7-be94-3ad7-b5f4-ec47daedd4b1",
                    "sense_definition": "A work of art made by arranging small colored pieces, usually tiles, to form a picture or pattern.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "art_image_composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed a Roman <w>mosaic</w> near the entrance.",
                            "target_lang_translations": {
                                "zh": "博物馆在入口附近展出了一件罗马<w>马赛克</w>。"
                            }
                        },
                        {
                            "text": "She spent weeks making a floor <w>mosaic</w> for the kitchen.",
                            "target_lang_translations": {
                                "zh": "她花了几个星期为厨房制作了一幅地面<w>镶嵌画</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Roman mosaic",
                        "floor mosaic",
                        "wall mosaic"
                    ],
                    "target_lang_definitions": {
                        "zh": "用小块彩色材料（通常是瓷砖）拼贴而成的艺术品或图案。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "马赛克",
                                "target_lang_sense_clarification": "指拼贴画或镶嵌艺术。"
                            },
                            {
                                "target_lang_word": "镶嵌画",
                                "target_lang_sense_clarification": "指用小块材料拼成的画作。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0df29358-2f47-3fc5-8bb4-a455e425628d",
                    "sense_definition": "A composite picture created from overlapping photographs.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "art_image_composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist created a photo <w>mosaic</w> from hundreds of travel pictures.",
                            "target_lang_translations": {
                                "zh": "这位艺术家用数百张旅行照片创作了一幅<w>照片拼贴</w>。"
                            }
                        },
                        {
                            "text": "At the exhibition, one large <w>mosaic</w> showed a face built from many overlapping photos.",
                            "target_lang_translations": {
                                "zh": "在展览会上，一幅大型<w>照片拼贴</w>展示了一张由许多重叠照片构成的脸。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "photo mosaic"
                    ],
                    "target_lang_definitions": {
                        "zh": "由多张重叠照片组成的合成图像。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "照片拼贴",
                                "target_lang_sense_clarification": "指由多张照片组合而成的图像。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "603df709-d6e9-3fec-84f5-47edd3dd39f7",
                    "sense_definition": "Pixelization used to blur or censor part of an image or video.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "art_image_composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The video editor added a digital <w>mosaic</w> to hide private details.",
                            "target_lang_translations": {
                                "zh": "视频剪辑师添加了数字<w>马赛克</w>来隐藏私人细节。"
                            }
                        },
                        {
                            "text": "In the TV clip, a <w>mosaic</w> blur covered the license plate.",
                            "target_lang_translations": {
                                "zh": "在电视片段中，车牌被<w>马赛克</w>遮住了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pixelization"
                    ],
                    "common_phrases": [
                        "digital mosaic",
                        "mosaic blur"
                    ],
                    "target_lang_definitions": {
                        "zh": "用于模糊或遮盖图像或视频部分内容的像素化处理。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "马赛克",
                                "target_lang_sense_clarification": "指视频或图像中的模糊遮盖效果。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a20bc2c-d939-3c50-8a05-3af48c45eee6",
                    "sense_definition": "Any composite whole made from diverse different elements.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "composite_mixture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city is a cultural <w>mosaic</w> of languages and traditions.",
                            "target_lang_translations": {
                                "zh": "这座城市是一个语言和传统交织的文化<w>多元组合</w>。"
                            }
                        },
                        {
                            "text": "Her essay described the neighborhood as a social <w>mosaic</w> shaped by immigration.",
                            "target_lang_translations": {
                                "zh": "她的文章将这个社区描述为一个由移民塑造的社会<w>多元组合</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cultural mosaic",
                        "social mosaic"
                    ],
                    "target_lang_definitions": {
                        "zh": "由多种不同元素构成的复合整体。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "多元组合",
                                "target_lang_sense_clarification": "指由多种元素构成的复杂整体。"
                            },
                            {
                                "target_lang_word": "大杂烩",
                                "target_lang_sense_clarification": "指多种事物混合在一起的集合。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c431983-b0cc-3551-aeca-43580f7cef5a",
                    "sense_definition": "An individual whose body contains two or more cell lines with different genetic or chromosomal makeup, all originating from the same zygote.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "genetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doctors explained that the child was a genetic <w>mosaic</w> with two cell lines.",
                            "target_lang_translations": {
                                "zh": "医生解释说，这个孩子是一个拥有两个细胞系的遗传<w>嵌合体</w>。"
                            }
                        },
                        {
                            "text": "The report described the patient as a chromosomal <w>mosaic</w> after further testing.",
                            "target_lang_translations": {
                                "zh": "经过进一步检查，报告将该患者描述为染色体<w>嵌合体</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "genetic mosaic",
                        "chromosomal mosaic"
                    ],
                    "target_lang_definitions": {
                        "zh": "指一个个体，其体内含有来自同一受精卵但遗传或染色体构成不同的两种或多种细胞系。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嵌合体",
                                "target_lang_sense_clarification": "生物学中指具有不同基因型细胞的个体。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f1c3855-f78a-3419-93cf-935f0b18e6a5",
                    "sense_definition": "Any of several viral plant diseases that cause mosaic-like patterns on leaves.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "plant_disease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers feared tobacco <w>mosaic</w> after strange patterns appeared on the leaves.",
                            "target_lang_translations": {
                                "zh": "在叶片上出现奇怪的斑纹后，农民们担心是烟草<w>花叶病</w>。"
                            }
                        },
                        {
                            "text": "The scientist tested the plants for <w>mosaic</w> before moving them to the greenhouse.",
                            "target_lang_translations": {
                                "zh": "科学家在将植物移入温室之前，对它们进行了<w>花叶病</w>检测。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tobacco mosaic",
                        "mosaic virus"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种导致植物叶片出现类似马赛克斑纹的病毒性疾病。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "花叶病",
                                "target_lang_sense_clarification": "植物病毒引起的叶片斑驳病害。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b5ada63c-3f47-338c-ae7b-5d765dfdf057",
                    "sense_definition": "Relating to Moses or to the laws, writings, and traditions attributed to him.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious_biblical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor discussed <w>Mosaic</w> law in the history lecture.",
                            "target_lang_translations": {
                                "zh": "教授在历史课上讨论了<w>摩西的</w>法律。"
                            }
                        },
                        {
                            "text": "Many readers compare the <w>Mosaic</w> account of creation with other ancient texts.",
                            "target_lang_translations": {
                                "zh": "许多读者将<w>摩西的</w>创世记述与其他古代文献进行了比较。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Mosaic"
                    ],
                    "common_phrases": [
                        "Mosaic law",
                        "Mosaic account",
                        "Mosaic code"
                    ],
                    "target_lang_definitions": {
                        "zh": "与摩西或归于他的法律、著作及传统有关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "摩西的",
                                "target_lang_sense_clarification": "指与圣经人物摩西相关的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d99d919-658f-392b-add0-a0463280ec2f",
                    "sense_definition": "Having cells with different genetic constitutions within the same organism.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "genetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lab found <w>mosaic</w> cells during the genetic analysis.",
                            "target_lang_translations": {
                                "zh": "实验室在基因分析中发现了<w>嵌合的</w>细胞。"
                            }
                        },
                        {
                            "text": "Researchers studied a <w>mosaic</w> pattern in the embryo's chromosomes.",
                            "target_lang_translations": {
                                "zh": "研究人员研究了胚胎染色体中的<w>嵌合的</w>模式。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mosaic cells",
                        "mosaic pattern"
                    ],
                    "target_lang_definitions": {
                        "zh": "指同一生物体内含有不同遗传构成的细胞。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嵌合的",
                                "target_lang_sense_clarification": "形容具有不同基因型细胞的生物特征。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a48c8430-1879-3b04-885f-43848a6b15f9",
                    "sense_definition": "To arrange or decorate in the form of a mosaic.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "art_image_composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team will <w>mosaic</w> the courtyard wall with blue and gold tiles.",
                            "target_lang_translations": {
                                "zh": "团队将用蓝色和金色的瓷砖<w>镶嵌</w>庭院墙壁。"
                            }
                        },
                        {
                            "text": "Students learned how to <w>mosaic</w> a tabletop in art class.",
                            "target_lang_translations": {
                                "zh": "学生们在美术课上学习了如何<w>镶嵌</w>桌面。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mosaic a wall",
                        "mosaic a floor",
                        "mosaic a tabletop"
                    ],
                    "target_lang_definitions": {
                        "zh": "以马赛克形式进行排列或装饰。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "镶嵌",
                                "target_lang_sense_clarification": "指用小块材料进行装饰的动作。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}