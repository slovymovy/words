                                            {
                                                "example_id": "6b0e5a2a-d096-490e-aa29-109dfa028b00",
                                                "sense_id": "f51b0e39-d883-3fcc-acf9-e3733dd15e0e",
                                                "text": "« Enfin, tu trottines », précise Denise, sa femme."
                                            },
