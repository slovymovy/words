                    {
                        "translation_id": "f44f43f6-1867-4bed-8f7b-3eab36e53f91",
                        "source_entry_id": "1fb3bd5e-7847-3dc7-bcdb-a27c7d19fe75",
                        "source_sense_description": "Accident en série dans lequel des véhicules se percutent l’un l’autre",
                        "target_lang_word": "pile-up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
