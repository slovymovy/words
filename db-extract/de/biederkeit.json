                ],
                "senses": [
                    {
                        "sense_id": "b655865d-9b77-3121-b6c6-5e473c0cf513",
                        "entry_id": "6f8df1f6-42f7-334f-bfa4-5c167315914d",
                        "glosses": [
                            "die Eigenschaft, bieder zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3e7f2d8-01c3-42c8-afcf-430c8d680490",
                                "sense_id": "b655865d-9b77-3121-b6c6-5e473c0cf513",
                                "text": "„Und alle die schönen Eigenschaften des Gemütes, Treue, rechtliche Ehrlichkeit, gutmütige Biederkeit, Bescheidenheit, Moralität gehören mit zu unserm Charakter.“ (1885)"
                            },
                            {
                                "example_id": "be7837b4-08f1-4183-ae9e-5b5f7d8914bb",
                                "sense_id": "b655865d-9b77-3121-b6c6-5e473c0cf513",
                                "text": "Eure ganze Biederkeit kotzt mich an!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c11a1568-8fe1-4568-9025-e8a8d46d7e38",
                        "source_entry_id": "6f8df1f6-42f7-334f-bfa4-5c167315914d",
                        "source_sense_id": "b655865d-9b77-3121-b6c6-5e473c0cf513",
                        "source_sense_description": "die Eigenschaft, bieder zu sein",
                        "target_lang_word": "honesty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honesty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e80cd6b9-7701-3879-8300-c71dcca0f7b5",
                                        "entry_id": "36d6c2c4-3fd8-33bc-9ad0-042dffe99026",
                                        "glosses": [
                                            "The act, quality, or condition of being honest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4624d23-fd06-4138-a1ed-2b4235cd29bd",
                                                "sense_id": "e80cd6b9-7701-3879-8300-c71dcca0f7b5",
                                                "text": "academic / artistic / emotional / intellectual honesty"
                                            },
                                            {
                                                "example_id": "28a4c0d2-e815-4417-98bd-d99cd49c90a1",
                                                "sense_id": "e80cd6b9-7701-3879-8300-c71dcca0f7b5",
                                                "text": "brutal / devastating / searing honesty"
                                            },
                                            {
                                                "example_id": "da12768b-a5e1-49c3-9a8f-780441a2eae0",
                                                "sense_id": "e80cd6b9-7701-3879-8300-c71dcca0f7b5",
                                                "text": "There’s no trust, / No faith, no honesty in men; all perjured, / All forsworn, all naught, all dissemblers."
                                            },
                                            {
                                                "example_id": "3e75e1cb-2086-4789-baa9-c802ae305533",
                                                "sense_id": "e80cd6b9-7701-3879-8300-c71dcca0f7b5",
                                                "text": "1787, George Colman, Junior, Inkle and Yarico, London: G.G.J. & J. Robinson, Act 2, p. 45,\nO give me your plain dealing Fellows\nWho never from honesty shrink;\nNot thinking on all they shou’d tell us,\nBut telling us all that they think."
                                            },
                                            {
                                                "example_id": "92a4bd1c-8abf-4ced-b7f9-f27347896b62",
                                                "sense_id": "e80cd6b9-7701-3879-8300-c71dcca0f7b5",
                                                "text": "[…] Are you honest, boy? / Then be not spendthrift of your honesty, / But keep it to yourself; in Padua / Men think that honesty is ostentatious, so / It is not of the fashion."
                                            },
                                            {
                                                "example_id": "2aa4285a-cb24-4c72-a4c8-3f74a6d24289",
                                                "sense_id": "e80cd6b9-7701-3879-8300-c71dcca0f7b5",
                                                "text": "To those who knew her and to the greatly enlarged circle who were electrified by her last poems and sudden death, she had come to signify the specific honesties and risks of the poet’s condition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54867009-155e-3a51-b913-bc7b2af10a8e",
                                        "entry_id": "36d6c2c4-3fd8-33bc-9ad0-042dffe99026",
                                        "glosses": [
                                            "Honor; decency, propriety."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02012f49-789c-40fc-ba29-63f2420e14ec",
                                                "sense_id": "54867009-155e-3a51-b913-bc7b2af10a8e",
                                                "text": "Have ye no wit, manners, nor honesty, but to gabble like tinkers at this time of night?"
                                            },
                                            {
                                                "example_id": "dc6092e2-0f95-4858-8843-ff0301c35d90",
                                                "sense_id": "54867009-155e-3a51-b913-bc7b2af10a8e",
                                                "text": "Fellovves in armes faithfull and valiant, / I thanke you for your paines and honeſties, […]"
                                            },
                                            {
                                                "example_id": "49ba45f2-5759-45ea-9e80-dbb5c1a7444a",
                                                "sense_id": "54867009-155e-3a51-b913-bc7b2af10a8e",
                                                "text": "[…] that we may lead a quiet and peaceable life in all godliness and honesty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5a23389-9d2f-355b-8058-3c90f96cdb72",
                                        "entry_id": "36d6c2c4-3fd8-33bc-9ad0-042dffe99026",
                                        "glosses": [
                                            "Chastity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8045188-c6bf-4549-935e-2749d4b8e2f7",
                                                "sense_id": "f5a23389-9d2f-355b-8058-3c90f96cdb72",
                                                "text": "[…] spend all I have; only give me so much of your time in exchange of it, as to lay an amiable siege to the honesty of this Ford’s wife […]"
                                            },
                                            {
                                                "example_id": "29be6351-5bf4-470c-8105-a647778c1529",
                                                "sense_id": "f5a23389-9d2f-355b-8058-3c90f96cdb72",
                                                "text": "c. 1625, John Fletcher, The Fair Maid of the Inn, Act V, Scene 1, in Alexander Dyce (editor), The Works of Beaumont and Fletcher, New York: Appleton, 1890, Volume 2, p. 669,\n[…] Oh, these vild women,\nThat are so ill preservers of men’s honours,\nThey cannot govern their own honesties!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f0b303d-a491-3a70-bcc5-67f73ed9518b",
                                        "entry_id": "36d6c2c4-3fd8-33bc-9ad0-042dffe99026",
                                        "glosses": [
                                            "Any of various crucifers in the genus Lunaria, several of which are grown as ornamentals, particularly annual honesty (Lunaria annua)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89822d94-5d5a-4824-8f57-123216c31c54",
                                                "sense_id": "4f0b303d-a491-3a70-bcc5-67f73ed9518b",
                                                "text": "Various measures were taken to avoid it, most popular being the suspension of certain herbs and tree branches over the doorways of dwellings and stables. Commonly used greenery were tansy, honesty, garlic, St. John's Wort, mountain ash, roadside verbena."
                                            },
                                            {
                                                "example_id": "d135cff8-2a6f-438a-aa8b-ed5f8ab09c62",
                                                "sense_id": "4f0b303d-a491-3a70-bcc5-67f73ed9518b",
                                                "text": "She thought a minute, then stepped nimbly back into her cottage; and what she came out with at last was, a sprig of dry leaves, round as shillings, white as paper, quivering on a few thin stalks that looked ready to snap. / It was honesty."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f972b73f-9c7e-4c0e-bda8-ed332645e550",
                        "source_entry_id": "6f8df1f6-42f7-334f-bfa4-5c167315914d",
                        "source_sense_id": "b655865d-9b77-3121-b6c6-5e473c0cf513",
                        "source_sense_description": "die Eigenschaft, bieder zu sein",
                        "target_lang_word": "honnêteté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honnêteté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fdd30f33-812c-3e37-8029-818593d179a9",
                                        "entry_id": "955c818f-b225-3cb1-a58a-37dd9d53c115",
                                        "glosses": [
                                            "État moral constitué par l’instinct ou l’habitude de la vertu, de la probité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b6106b1-e7d8-4d47-b761-4a2fceac4ae6",
                                                "sense_id": "fdd30f33-812c-3e37-8029-818593d179a9",
                                                "text": "Des actions d’une grande honnêteté. — L’honnêteté de son âme, de sa conduite. — L’honnêteté de ses principes."
                                            },
                                            {
                                                "example_id": "bf5d25fb-ea4e-4db8-8eb5-0d3b309ee040",
                                                "sense_id": "fdd30f33-812c-3e37-8029-818593d179a9",
                                                "text": "— Ça fleure l’honnêteté bourgeoise. C'est, en somme, du vice utilitaire. Tout est garanti, normal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2626b457-28f0-3ce2-91a3-a1c1862590fb",
                                        "entry_id": "955c818f-b225-3cb1-a58a-37dd9d53c115",
                                        "glosses": [
                                            "Chasteté, pudeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c94782e-addf-42b5-b019-4126a7c4b91b",
                                                "sense_id": "2626b457-28f0-3ce2-91a3-a1c1862590fb",
                                                "text": "[…] François se dévoyait auprès des filles publiques, rien que pour faire diversion à la monotonie d'un mariage banal. On dit que ces professionnelles ont des charmes secrets, des recettes magiques pour exaspérer la volupté de leurs clients et leur procurer des extases sans pareilles que honnêteté de leurs épouses est incapable de leur offrir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6732be9-e7cc-381f-982f-87427167690f",
                                        "entry_id": "955c818f-b225-3cb1-a58a-37dd9d53c115",
                                        "glosses": [
                                            "Bienséance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d78c9afa-d0f9-43e9-a538-5fe7e355c533",
                                                "sense_id": "e6732be9-e7cc-381f-982f-87427167690f",
                                                "text": "Chacun a l'impression qu'il nous manquait deux heures pour être vraiment prêts à la guerre. Mais avec conscience les hommes regagnent le temps perdu.[…]. L'honnêteté du régiment se rétablit, […]."
                                            },
                                            {
                                                "example_id": "2e1d11e9-e240-4b51-b89e-d9a98155bbb3",
                                                "sense_id": "e6732be9-e7cc-381f-982f-87427167690f",
                                                "text": "Il n’est pas de l’honnêteté d’en user si familièrement avec des gens à qui on doit du respect."
                                            },
                                            {
                                                "example_id": "833c0274-bf7a-4a27-959e-40d2c7da0eaf",
                                                "sense_id": "e6732be9-e7cc-381f-982f-87427167690f",
                                                "text": "Cela est contre les règles de l’honnêteté."
                                            },
                                            {
                                                "example_id": "adcde825-eeee-4436-8832-8df5d6c13d84",
                                                "sense_id": "e6732be9-e7cc-381f-982f-87427167690f",
                                                "text": "Blesser les règles de l’honnêteté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aeb68b8-0293-3189-bd9b-8ed43f098bbc",
                                        "entry_id": "955c818f-b225-3cb1-a58a-37dd9d53c115",
                                        "glosses": [
                                            "Civilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb808bc2-3e21-45eb-9b49-5b779d6d3e37",
                                                "sense_id": "5aeb68b8-0293-3189-bd9b-8ed43f098bbc",
                                                "text": "Il n’a pas eu l’honnêteté de l’aller voir."
                                            },
                                            {
                                                "example_id": "31ff2fc0-c448-4c25-8972-b146a7d73dbc",
                                                "sense_id": "5aeb68b8-0293-3189-bd9b-8ed43f098bbc",
                                                "text": "Il a beaucoup d’honnêteté pour tous ceux qui ont affaire à lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "617f70d3-c7f4-32ac-97e1-dc9561463d59",
                                        "entry_id": "955c818f-b225-3cb1-a58a-37dd9d53c115",
                                        "glosses": [
                                            "Actes de civilité, des politesses que l’on fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34920276-9514-40c8-a2aa-9aad96468000",
                                                "sense_id": "617f70d3-c7f4-32ac-97e1-dc9561463d59",
                                                "text": "Il ne lui a pas fait la moindre honnêteté."
                                            },
                                            {
                                                "example_id": "aa99e319-473c-4451-8f00-53fdf39e735a",
                                                "sense_id": "617f70d3-c7f4-32ac-97e1-dc9561463d59",
                                                "text": "Il le reçut, il le traita avec toutes sortes d’honnêtetés."
                                            },
                                            {
                                                "example_id": "3e2a9dd5-5cff-4b84-abc2-267aec12391a",
                                                "sense_id": "617f70d3-c7f4-32ac-97e1-dc9561463d59",
                                                "text": "Il lui a fait mille honnêtetés, toutes les honnêtetés imaginables."
                                            },
                                            {
                                                "example_id": "9b4a5cfb-2bda-4dcf-82ac-991547f22842",
                                                "sense_id": "617f70d3-c7f4-32ac-97e1-dc9561463d59",
                                                "text": "— Il faut payer ces roses d’une pièce de six sous et dire une parole d’honnêteté à la jolie demoiselle."
                                            },
                                            {
                                                "example_id": "1d9797d1-9dab-4ea0-a8e2-f5b989a5170c",
                                                "sense_id": "617f70d3-c7f4-32ac-97e1-dc9561463d59",
                                                "text": "Mes parents te font bien leurs honnêtetés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16a00242-0c2d-32ca-bce9-6002efccfbbd",
                                        "entry_id": "955c818f-b225-3cb1-a58a-37dd9d53c115",
                                        "glosses": [
                                            "Manière d’agir obligeante et courtoise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45e465cf-f9bd-45ea-bdc6-5688bf5e0013",
                                                "sense_id": "16a00242-0c2d-32ca-bce9-6002efccfbbd",
                                                "text": "Il en a usé avec la plus grande honnêteté."
                                            },
                                            {
                                                "example_id": "b871f296-d284-4e33-93a7-c86e63b7e66b",
                                                "sense_id": "16a00242-0c2d-32ca-bce9-6002efccfbbd",
                                                "text": "L’honnêteté de son procédé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8342974b-9c00-3b41-9a0e-ffa1b9562244",
                                        "entry_id": "955c818f-b225-3cb1-a58a-37dd9d53c115",
                                        "glosses": [
                                            "Présent qu’on fait par reconnaissance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7857d40-8796-46cf-a49a-f7c920eb7f1f",
                                                "sense_id": "8342974b-9c00-3b41-9a0e-ffa1b9562244",
                                                "text": "Il m’avait rendu un service, et je lui ai fait une honnêteté."
                                            },
                                            {
                                                "example_id": "e250e5e4-472c-4e4c-9a1b-0c4217a8fefb",
                                                "sense_id": "8342974b-9c00-3b41-9a0e-ffa1b9562244",
                                                "text": "Cela mérite bien une honnêteté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
