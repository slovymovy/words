                                "target_senses": [
                                    {
                                        "sense_id": "05753e28-80d7-3779-bb66-16b54242b3fe",
                                        "entry_id": "4cd0ca0b-5d6c-3ac1-978a-34f62b226f41",
                                        "glosses": [
                                            "Action de terrasser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a2e77f6-5af8-4d47-814b-61fe8bb90c65",
                                                "sense_id": "05753e28-80d7-3779-bb66-16b54242b3fe",
                                                "text": "Suivront les travaux de gros œuvre : reprise en sous-œuvre, modification des murs porteurs, démolitions de planchers, terrassements, etc."
                                            },
                                            {
                                                "example_id": "4202a438-e478-49b4-8912-3c718e2b4773",
                                                "sense_id": "05753e28-80d7-3779-bb66-16b54242b3fe",
                                                "text": "Le boulevard Malesherbes, qui abattait des hôtels superbes, dans les rues d’Anjou et de la Ville-l’Évêque, et qui nécessitait des travaux de terrassement considérables, devait être troué un des premiers."
                                            },
                                            {
                                                "example_id": "32e83a3a-53d2-4dc6-b3fd-d3a69c4ffacf",
                                                "sense_id": "05753e28-80d7-3779-bb66-16b54242b3fe",
                                                "text": "Les thèmes de prédilection sont l’arpentage, les constructions en briques, les travaux de terrassement, le creusement des canaux, la répartition du travail et des salaires entre travailleurs, les taux d’intérêt et les problèmes d’héritage."
                                            }
                                        ]
                                    }
