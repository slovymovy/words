{
    "word_family": [
        "like",
        "unlike",
        "likeness",
        "liken"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "715983d1-b35f-3e70-b592-343062f728f3",
                    "sense_definition": "Very similar to each other in appearance, nature, or form.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two brothers look very much <w>alike</w> despite the age difference.",
                            "target_lang_translations": {
                                "ru": "Два брата очень <w>похожи</w> друг на друга, несмотря на разницу в возрасте.",
                                "zh": "尽管年龄有差距，但两兄弟看起来非常<w>相像</w>。"
                            }
                        },
                        {
                            "text": "My sister and I are <w>alike</w> in many ways, especially in our sense of humor.",
                            "target_lang_translations": {
                                "ru": "Мы с сестрой во многом <w>похожи</w>, особенно чувством юмора.",
                                "zh": "我和我姐姐在很多方面都很<w>相似</w>，尤其是在幽默感上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "similar",
                        "comparable",
                        "indistinguishable",
                        "the same",
                        "matching"
                    ],
                    "antonyms": [
                        "unlike"
                    ],
                    "common_phrases": [
                        "look alike",
                        "very much alike",
                        "be alike"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень похожие друг на друга по внешнему виду, характеру или форме.",
                        "zh": "指在外观、性质或形式上非常相似。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "похожий",
                                "target_lang_sense_clarification": "имеющий сходство"
                            },
                            {
                                "target_lang_word": "одинаковый",
                                "target_lang_sense_clarification": "полностью совпадающий, идентичный"
                            },
                            {
                                "target_lang_word": "схожий",
                                "target_lang_sense_clarification": "обладающий сходством"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相似",
                                "target_lang_sense_clarification": "指彼此之间有共同点"
                            },
                            {
                                "target_lang_word": "相像",
                                "target_lang_sense_clarification": "指外观或特征上很像"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f1580fbb-15a9-31a6-b010-a53ec6ea59f1",
                    "sense_definition": "Used after mentioning two or more people or groups to show that something applies equally to them.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "adv_equal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new museum exhibit is popular with children and adults <w>alike</w>.",
                            "target_lang_translations": {
                                "ru": "Новая музейная выставка <w>одинаково</w> популярна среди детей и взрослых.",
                                "zh": "新的博物馆展览在儿童和成人中<w>同样</w>受欢迎。"
                            }
                        },
                        {
                            "text": "This difficult situation challenges managers and employees <w>alike</w>.",
                            "target_lang_translations": {
                                "ru": "Эта сложная ситуация бросает вызов менеджерам и сотрудникам <w>в равной степени</w>.",
                                "zh": "这种困境对经理和员工<w>同样</w>构成了挑战。"
                            }
                        }
                    ],
                    "synonyms": [
                        "equally"
                    ],
                    "common_phrases": [
                        "young and old alike",
                        "friends and family alike",
                        "rich and poor alike"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется после упоминания двух или более людей или групп, чтобы показать, что нечто относится к ним в равной степени.",
                        "zh": "用于提及两个或多个群体，表示某事对他们同样适用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одинаково",
                                "target_lang_sense_clarification": "в равной мере"
                            },
                            {
                                "target_lang_word": "в равной степени",
                                "target_lang_sense_clarification": "в той же мере"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "同样",
                                "target_lang_sense_clarification": "表示程度或性质一致"
                            },
                            {
                                "target_lang_word": "一视同仁",
                                "target_lang_sense_clarification": "指对不同的人同样看待"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01a17a37-5d3b-3889-adf3-cccca6139156",
                    "sense_definition": "In the same way or manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adv_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Great minds think <w>alike</w>, so it is no surprise we had the same idea.",
                            "target_lang_translations": {
                                "ru": "Великие умы мыслят <w>одинаково</w>, поэтому неудивительно, что нам пришла в голову одна и та же идея.",
                                "zh": "英雄所见略同，所以我们有<w>同样</w>的想法并不奇怪。"
                            }
                        },
                        {
                            "text": "The twins were dressed <w>alike</w> in matching red sweaters.",
                            "target_lang_translations": {
                                "ru": "Близнецы были одеты <w>одинаково</w>, в одинаковые красные свитера.",
                                "zh": "这对双胞胎穿着<w>一样</w>的红色毛衣。"
                            }
                        }
                    ],
                    "synonyms": [
                        "similarly",
                        "identically"
                    ],
                    "common_phrases": [
                        "think alike",
                        "dress alike",
                        "treat alike"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тем же образом или в той же манере.",
                        "zh": "以相同的方式或态度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одинаково",
                                "target_lang_sense_clarification": "тем же образом"
                            },
                            {
                                "target_lang_word": "точно так же",
                                "target_lang_sense_clarification": "идентичным образом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一样",
                                "target_lang_sense_clarification": "指方式或状态相同"
                            },
                            {
                                "target_lang_word": "同样",
                                "target_lang_sense_clarification": "指行为方式一致"
                            }
                        ]
                    }
                }
            ]
        },
        {
