                "translations": [
                    {
                        "translation_id": "b7818a3d-a841-4f20-a927-3473b182c6e6",
                        "source_entry_id": "d90f2e5e-8e1b-31fa-afa1-faf0b1b7bac7",
                        "source_sense_id": "3e545f07-7ca6-305f-b18e-481b288c9a5b",
                        "target_lang_word": "pingelig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pingelig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c84d4e00-76e2-3f96-a5c6-78b3531398da",
                                        "entry_id": "27dc4380-97b6-38fa-b730-0ff1a6836847",
                                        "glosses": [
                                            "sehr differenziert, sehr genau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30a01629-335a-4011-ba58-cfb5c3446bfe",
                                                "sense_id": "c84d4e00-76e2-3f96-a5c6-78b3531398da",
                                                "text": "„Unser neuer Chef ist aber pingelig!“"
                                            },
                                            {
                                                "example_id": "9095e356-51e4-4eab-b185-a0db4d7b87c1",
                                                "sense_id": "c84d4e00-76e2-3f96-a5c6-78b3531398da",
                                                "text": "„Da muss ich nun aber zunächst etwas pingelig ins Lautliche einsteigen, weil dieses hier mit dem Inhaltlichen, wie mir scheint, zu tun hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9daf9887-1ebd-4cbe-96f6-fbc0993929fc",
                        "source_entry_id": "d90f2e5e-8e1b-31fa-afa1-faf0b1b7bac7",
                        "source_sense_id": "3e545f07-7ca6-305f-b18e-481b288c9a5b",
                        "target_lang_word": "schikanieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schikanieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "63e549dd-c28d-39ff-84ff-5cb4c40ee16e",
                                        "entry_id": "2c6586d5-5621-3640-b910-eee9a7913078",
                                        "glosses": [
                                            "eine Person (in der Öffentlichkeit) terrorisieren, gegen sie intrigieren oder sie mobben; mit unnötigen Aufgaben (Schikanen) quälen"
                                        ],
                                        "tags": [
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94d21b27-8e40-49b4-972c-03eedd7b89d5",
                                                "sense_id": "63e549dd-c28d-39ff-84ff-5cb4c40ee16e",
                                                "text": "Elisabeth wird von ihrem kleinen Bruder ständig schikaniert."
                                            },
                                            {
                                                "example_id": "caee66ca-0db3-4056-9f2f-c5235721dc5d",
                                                "sense_id": "63e549dd-c28d-39ff-84ff-5cb4c40ee16e",
                                                "text": "Der Ausbilder liebte es, die neuen Wehrpflichtigen mit Gewaltmärschen zu schikanieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2bb52be1-d7fe-4601-a288-f878a8ef5b8b",
                        "source_entry_id": "d90f2e5e-8e1b-31fa-afa1-faf0b1b7bac7",
                        "source_sense_id": "3e545f07-7ca6-305f-b18e-481b288c9a5b",
                        "target_lang_word": "to nitpick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "15a12575-21be-4c2f-9e5e-81de2973f3ad",
                        "source_entry_id": "d90f2e5e-8e1b-31fa-afa1-faf0b1b7bac7",
                        "source_sense_id": "3e545f07-7ca6-305f-b18e-481b288c9a5b",
                        "target_lang_word": "chicaner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chicaner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "538d22d6-6c45-3edf-a7f0-5efdc8be86f4",
                                        "entry_id": "fd8bc9fb-a93f-3cbf-8888-e96f992d1b5c",
                                        "glosses": [
                                            "Soulever, dans un procès, un point mineur de droit pour embrouiller l’affaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c75a3098-4fe9-408c-8d7c-f0e8766ab722",
                                                "sense_id": "538d22d6-6c45-3edf-a7f0-5efdc8be86f4",
                                                "text": "Item, à maistre Jehan Cotard,\nMon procureur en Court d’Eglise,\nDevoye environ ung patard,\nCar à present bien m’en advise,\nQuant chicanner me feit Denise,\nDisant que l’avoye mauldite;\nPour son ame, qu’ès cieulx soit mise!\nCeste Oraison j’ay cy escripte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "805f17f4-1ef9-3473-9705-7b934f0a99a2",
                                        "entry_id": "fd8bc9fb-a93f-3cbf-8888-e96f992d1b5c",
                                        "glosses": [
                                            "Créer des difficultés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e97dbdf-04e6-423f-be35-5fd4bf218037",
                                                "sense_id": "805f17f4-1ef9-3473-9705-7b934f0a99a2",
                                                "text": "Chicaner le terrain, le disputer pied à pied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "feaba0c4-170e-3973-b01a-db2f4503cdbe",
                                        "entry_id": "fd8bc9fb-a93f-3cbf-8888-e96f992d1b5c",
                                        "glosses": [
                                            "Serrer le vent le plus près possible, comme en lui disputant, parce qu’il est défavorable, une pleine action sur les voiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "448c5b86-9264-4e2c-a24e-dcf5ce0a589b",
                                                "sense_id": "feaba0c4-170e-3973-b01a-db2f4503cdbe",
                                                "text": "Chicaner le vent, gouverner au plus près du vent, presque à ralinguer."
                                            },
                                            {
                                                "example_id": "ed341dac-36bf-41ab-928d-ac2bf0c9c84a",
                                                "sense_id": "feaba0c4-170e-3973-b01a-db2f4503cdbe",
                                                "text": "Un navire qui chicane le vent diminue son sillage et augmente sa dérive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb7db415-c4ca-37d0-b12f-20a3ad8de259",
                                        "entry_id": "fd8bc9fb-a93f-3cbf-8888-e96f992d1b5c",
                                        "glosses": [
                                            "Se servir de subtilités captieuses, contester sans fondement, en quelque matière que ce soit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbb59da4-8b3c-471b-afdf-29df51a927e1",
                                                "sense_id": "fb7db415-c4ca-37d0-b12f-20a3ad8de259",
                                                "text": "Il chicane, ergote sur tout, à propos de tout."
                                            },
                                            {
                                                "example_id": "a9837654-d783-4ae0-a69b-23fc856e3c4b",
                                                "sense_id": "fb7db415-c4ca-37d0-b12f-20a3ad8de259",
                                                "text": "Quelles gens ! disait-il, bon Dieu ! quelles gens ! Avec les uns il faut finir par se battre ; les autres ergotent comme des pédans, chicanent comme des procureurs, et puis s’endorment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec2a1bcc-9818-3276-ad2c-39b8ffbd2a10",
                                        "entry_id": "fd8bc9fb-a93f-3cbf-8888-e96f992d1b5c",
                                        "glosses": [
                                            "Chercher noise à quelqu’un."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65abf1f3-9314-47ff-970d-581e8c755cfe",
                                                "sense_id": "ec2a1bcc-9818-3276-ad2c-39b8ffbd2a10",
                                                "text": "Cet homme chicane tous ses voisins."
                                            },
                                            {
                                                "example_id": "0ad62f20-49d9-4d55-9ac6-6546c7310c8d",
                                                "sense_id": "ec2a1bcc-9818-3276-ad2c-39b8ffbd2a10",
                                                "text": "Monsieur, vous avez mangé de la mortadelle, vos papiers d’identité, s’il vous plaît ! Je leur ai donc dit que quand on avait dîné comme ils avaient dîné, on ne venait pas chicaner les gens pour une rondelle de saucisson et leur demander les papiers d’identité…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a4694bb-5bff-3cf9-a56e-2885342d9cf7",
                                        "entry_id": "fd8bc9fb-a93f-3cbf-8888-e96f992d1b5c",
                                        "glosses": [
                                            "Reprendre, critiquer mal à propos et sur des bagatelles."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ed14cde-5069-4663-ab51-f0eb633bc8b3",
                                                "sense_id": "4a4694bb-5bff-3cf9-a56e-2885342d9cf7",
                                                "text": "Cessez de le chicaner à tout propos."
                                            },
                                            {
                                                "example_id": "9d29e4ab-3909-445d-80ee-cd755f75e438",
                                                "sense_id": "4a4694bb-5bff-3cf9-a56e-2885342d9cf7",
                                                "text": "La feue Reine-mère, de son côté, ne vivoit pas trop bien avec le Roi : elle le chicanoit en toutes choses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad4c2ec9-8be3-3eb4-9341-058364e91c74",
                                        "entry_id": "fd8bc9fb-a93f-3cbf-8888-e96f992d1b5c",
                                        "glosses": [
                                            "Se chamailler, se quereller."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3561666-d725-4524-8c95-fc146b3ebf95",
                                                "sense_id": "ad4c2ec9-8be3-3eb4-9341-058364e91c74",
                                                "text": "Ils ne cessent de se chicaner."
                                            },
                                            {
                                                "example_id": "8277bb6e-6194-42bb-b724-189b54c9cb2c",
                                                "sense_id": "ad4c2ec9-8be3-3eb4-9341-058364e91c74",
                                                "text": "Ici, les enfants se chicanent pour des bêtises, pas pour autre chose."
                                            },
                                            {
                                                "example_id": "4933e4d8-7134-4fc2-a97f-2d2e093d9f1c",
                                                "sense_id": "ad4c2ec9-8be3-3eb4-9341-058364e91c74",
                                                "text": "Imaginez un enfant qui se chicane avec ses parents le matin à table. Il emmagasine ainsi du stress, de l’énergie dans le ventre."
                                            },
                                            {
                                                "example_id": "8e082c85-2d6c-4b42-8813-55161b4b3334",
                                                "sense_id": "ad4c2ec9-8be3-3eb4-9341-058364e91c74",
                                                "text": "Eh ! conscience ou esprit, qu'importe ! Ne chicanons pas sur les mots, je vous prie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d0225c8-75e7-3aee-afb6-866cd7a65b09",
                                        "entry_id": "fd8bc9fb-a93f-3cbf-8888-e96f992d1b5c",
                                        "glosses": [
                                            "Gronder, admonester, enguirlander."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0391f827-10fb-48bb-ada2-818fe9546c5b",
                                                "sense_id": "7d0225c8-75e7-3aee-afb6-866cd7a65b09",
                                                "text": "«J'ai comme eu l'impression qu'on retourne dans les années 1950, à l'époque du \"Speak White\", où on se faisait chicaner parce qu'on parlait en français», lance la députée Ruba Ghazal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "050820e8-eb9f-426d-a83f-5b227b3f9afc",
                        "source_entry_id": "d90f2e5e-8e1b-31fa-afa1-faf0b1b7bac7",
                        "source_sense_id": "3e545f07-7ca6-305f-b18e-481b288c9a5b",
                        "target_lang_word": "pinailler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pinailler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0cf35219-6794-339e-9d18-13146dc46950",
                                        "entry_id": "279bff68-269f-342d-a2e7-b437e53440be",
                                        "glosses": [
                                            "S’attarder sur des détails sans intérêt, argumenter avec des précisions superflues, de façon mesquine."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f4f1b24-5e7f-4cea-aac5-c0196ecdf164",
                                                "sense_id": "0cf35219-6794-339e-9d18-13146dc46950",
                                                "text": "On ne va tout de même pas pinailler pour si peu !"
                                            },
                                            {
                                                "example_id": "1d7c5a43-beb2-4234-ab9b-82cd6337ea68",
                                                "sense_id": "0cf35219-6794-339e-9d18-13146dc46950",
                                                "text": "Quand tu auras fini de pinailler, nous parlerons sérieusement."
                                            },
                                            {
                                                "example_id": "f57bb6e4-bbb7-4d10-b46b-1c1727258b8a",
                                                "sense_id": "0cf35219-6794-339e-9d18-13146dc46950",
                                                "text": "Il pinaillait sans cesse, à propos de tout et de rien, sans jamais emporter le morceau."
                                            },
                                            {
                                                "example_id": "e264b3e1-d72e-41ed-a230-955544769c1d",
                                                "sense_id": "0cf35219-6794-339e-9d18-13146dc46950",
                                                "text": "Il n’était pas de ceux qui pinaillent, qui tergiversent, qui mégotent. Les petits-bras, les mesquins, les frileux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f55243b0-b875-4f77-9cbb-c586182ba93b",
                        "source_entry_id": "d90f2e5e-8e1b-31fa-afa1-faf0b1b7bac7",
                        "source_sense_id": "3e545f07-7ca6-305f-b18e-481b288c9a5b",
                        "target_lang_word": "enculer les mouches",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enculer les mouches",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96db131a-2be5-3681-ad8a-491afc4893be",
                                        "entry_id": "a6abcb49-95df-31d0-89af-bc253cdef933",
                                        "glosses": [
                                            "Apporter des précisions et détails inutiles dans une discussion, chicaner, se montrer tatillon."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cb96429-500f-4bfe-9103-c732a703261c",
                                                "sense_id": "96db131a-2be5-3681-ad8a-491afc4893be",
                                                "text": "Il ne fait qu’enculer les mouches. On perd des heures à se mettre d’accord sur des détails, et sur le fond on n’avance pas."
                                            },
                                            {
                                                "example_id": "4d89b103-9af2-4922-8856-6aef6aed9e0d",
                                                "sense_id": "96db131a-2be5-3681-ad8a-491afc4893be",
                                                "text": "« Cessez d’enculer les mouches ! » leur lança un jour le secrétaire général du parti. « Camarade, nous nous battons aussi pour la liberté et la dignité des mouches. »"
                                            },
                                            {
                                                "example_id": "7e25e69e-2284-4785-9a9b-aab82c5602be",
                                                "sense_id": "96db131a-2be5-3681-ad8a-491afc4893be",
                                                "text": "Il y a deux façons d’enculer les mouches : avec ou sans leur consentement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
