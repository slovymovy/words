                "senses": [
                    {
                        "sense_id": "d2621140-9360-3682-906d-88e3444b9017",
                        "entry_id": "fcc3b3a8-6a3d-3b8c-84db-0f6d88e52290",
                        "glosses": [
                            "systematische Bestrebung eines zumindest teilweisen sozialen Ausschlusses von Personen oder Organisationen, denen bestimmte Aussagen beziehungsweise Handlungen vorgeworfen werden, die nach Ansicht der Personen, die den Ausschluss betreiben, unerwünscht sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3729007-58d5-4ae1-b776-b8b9f905a03c",
                                "sense_id": "d2621140-9360-3682-906d-88e3444b9017",
                                "text": "„Der Begriff beschreibt das Phänomen einer Zensur- oder Löschkultur, insofern als die Argumente von Gegnern systematisch sozial und medial ausgeschlossen werden.“"
                            },
                            {
                                "example_id": "2cb3cd8f-9c64-4b30-b8c6-a29e49b999f8",
                                "sense_id": "d2621140-9360-3682-906d-88e3444b9017",
                                "text": "„Die Löschkultur (Cancel Culture) hat an Universitäten eine lange Tradition und zu gravierenden Folgen für die Gesellschaft und für den Einzelnen geführt.“"
                            },
                            {
                                "example_id": "eac8a122-6e4f-4dfa-bd6c-6fae8579d991",
                                "sense_id": "d2621140-9360-3682-906d-88e3444b9017",
                                "text": "„Die ‹Cancel Culture› oder ‹Löschkultur› stellt mittlerweile eine echte Bedrohung für die intellektuelle Freiheit in den USA dar.“"
                            },
                            {
                                "example_id": "81743a01-131a-47cb-b71c-0654a161ef5b",
                                "sense_id": "d2621140-9360-3682-906d-88e3444b9017",
                                "text": "„Immer öfter werden Literaturklassiker zum Opfer der Löschkultur.“"
                            },
                            {
                                "example_id": "48b21e67-471e-40c0-be73-13e7f9b300b9",
                                "sense_id": "d2621140-9360-3682-906d-88e3444b9017",
                                "text": "„Ein Klassiker, der vor Zensur warnt, wird Opfer der ‚Löschkultur‘: Die Universität Northampton stuft Orwells ‚1984‘ als gefährlich ein, weil der Roman ‚beleidigend und verstörend‘ wirken könnte.“"
                            },
                            {
                                "example_id": "5c187baf-698e-4527-a39e-cfeb13f3aebd",
                                "sense_id": "d2621140-9360-3682-906d-88e3444b9017",
                                "text": "„Die Löschkultur prangert an, grenzt aus und vernichtet nicht in ihren Normen denkende Menschen, wenn auch (noch) nicht physisch, so doch virtuell.“"
                            },
                            {
                                "example_id": "9c081fe2-b076-42c2-9fcb-6a999777691c",
                                "sense_id": "d2621140-9360-3682-906d-88e3444b9017",
                                "text": "„Wird heute ein Profi mit einer Zigarette erwischt, wird er vom Wutbürgertum bei X erst auf seine Pflichten als Vorbild hingewiesen und dann im Namen der Löschkultur vernichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "25426edb-c879-3621-9442-3590789920d0",
                        "entry_id": "fcc3b3a8-6a3d-3b8c-84db-0f6d88e52290",
                        "glosses": [
                            "(meist als unberechtigt und übertrieben empfundene) Herangehensweise von Netzwerkbetreibern an die Löschung von Beiträgen, die rechtswidrig sein könnten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e55ced30-accf-4d87-8248-93f36240b674",
                                "sense_id": "25426edb-c879-3621-9442-3590789920d0",
                                "text": "„Grundsätzlich sehen wir bei starren Fristen die Gefahr der wahllosen Löschkultur, sogenannte Chilling Effects.“"
                            },
                            {
                                "example_id": "c67d231b-1e73-4112-a889-5a60d6c78219",
                                "sense_id": "25426edb-c879-3621-9442-3590789920d0",
                                "text": "„Es werden aber auch zahlreiche weitere Inhalte erfasst, die einer eingehenderen Überprüfung bedürften, nun aber womöglich einer Löschkultur zum Opfer fallen, die sich rasch etablieren könnte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0eb6e730-a2d8-4238-b7bd-553f0a99c9fd",
                        "source_entry_id": "fcc3b3a8-6a3d-3b8c-84db-0f6d88e52290",
                        "source_sense_id": "d2621140-9360-3682-906d-88e3444b9017",
                        "source_sense_description": "Bestrebung zum sozialen Ausschluss",
                        "target_lang_word": "cancel culture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cancel culture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38d54e98-ebbf-3a86-a347-4f9a889e2d65",
                                        "entry_id": "9b40c089-d29b-32e7-91d3-b7fd5281e2ce",
                                        "glosses": [
                                            "The cultural phenomenon of publicly shaming, rejecting, and ceasing to provide support to people, companies, stores, etc. that are deemed unacceptable, and calling on others to boycott them."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "neologism",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6b6264f-996f-41c3-a815-6d98fbd7c17f",
                                                "sense_id": "38d54e98-ebbf-3a86-a347-4f9a889e2d65",
                                                "text": "An unfair journalistic hit has now cost a capable attorney his job. It’s absurd. Cancel culture has reared its ugly head ... again."
                                            },
                                            {
                                                "example_id": "f0c39049-630a-4130-83ef-51ec26d60828",
                                                "sense_id": "38d54e98-ebbf-3a86-a347-4f9a889e2d65",
                                                "text": "With roots in Black Twitter, cancel culture is an unavoidable mainstay of our infotainment age. In an era of too much everything—TV, opinions, news—we’ve come to rely on a vocabulary of consolidation: likes, tweets, emoji. Cancel culture is one of these argots—a governor, a self-regulatory device I have come to wield with pride (if infrequent recklessness). In the collective, the gesture is absolute: we can’t. We’re done. And so we asphyxiate support from a notable cause or figure. Roseanne Barr referred to Valerie Jarrett as an ape? Cancelled. Harvey Weinstein was outed as a sexual predator? Cancelled."
                                            },
                                            {
                                                "example_id": "ca9b5a98-6281-41b8-8e2c-42345f8b9ff6",
                                                "sense_id": "38d54e98-ebbf-3a86-a347-4f9a889e2d65",
                                                "text": "In the past, we dismissed people and institutionalized doing so as law and unwritten laws. Today, I fear that we are making dismissing people the cool thing to do with “cancel culture.”"
                                            },
                                            {
                                                "example_id": "4881dc01-e2b5-44c4-8b8f-e9ad8496c015",
                                                "sense_id": "38d54e98-ebbf-3a86-a347-4f9a889e2d65",
                                                "text": "\"[…] Many students have adopted the posture of cancel culture, preventing people they don’t agree with from speaking,” Mr. Finkielkraut told me last month."
                                            },
                                            {
                                                "example_id": "9fce513a-d41a-4300-bae6-a5f01d2a10e9",
                                                "sense_id": "38d54e98-ebbf-3a86-a347-4f9a889e2d65",
                                                "text": "One of their political weapons is cancel culture, driving people from their jobs, shaming dissenters, and demanding total submission from anyone who disagrees."
                                            },
                                            {
                                                "example_id": "19771fa1-0271-4781-a8bb-343a039f7827",
                                                "sense_id": "38d54e98-ebbf-3a86-a347-4f9a889e2d65",
                                                "text": "In a statement condemning “cancel culture,” Stewart warned taking down the monument would set a bad precedent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a53b6e8c-6388-432c-98ba-420b4ff1afc4",
                        "source_entry_id": "fcc3b3a8-6a3d-3b8c-84db-0f6d88e52290",
                        "source_sense_id": "d2621140-9360-3682-906d-88e3444b9017",
