                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "inns",
                                "target_lang_sense_clarification": "plural of a place providing lodging and food"
                            },
                            {
                                "target_lang_word": "hostels",
                                "target_lang_sense_clarification": "plural of inexpensive lodging"
                            }
                        ]
                    }
                }
            ]
        }
