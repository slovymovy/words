                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fb28819-8e48-499e-a1f3-abf873e600be",
                                                "sense_id": "71239523-9e46-3a74-ac62-97b5c366db3d",
                                                "text": "There are some cultural details in Schissel’s story that are specific to the Jewish community: the family sits shive (seven days of mourning for the dead), and the preference for silence at that time."
                                            }
                                        ]
