                },
                {
                    "sense_id": "2979cb20-fd42-3646-ab6f-7aaa4e3eac7a",
                    "sense_definition": "En parlant de l'aiguille d'une boussole, qui oscille sans réussir à indiquer le nord.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette région riche en minerais de fer, l'aiguille <w>affolée</w> tournait sans cesse.",
                            "target_lang_translations": {
                                "en": "In this region rich in iron ore, the <w>erratic</w> needle kept turning constantly.",
                                "ru": "В этом районе, богатом железной рудой, <w>сбесившаяся</w> стрелка вращалась беспрерывно.",
                                "de": "In dieser eisenerzreichen Gegend spielte die Nadel unablässig <w>verrückt</w>.",
                                "es": "En esta región rica en mineral de hierro, la aguja <w>enloquecida</w> giraba sin cesar.",
                                "zh": "在这个铁矿石丰富的地区，那根<w>失灵</w>的磁针一直不停地转动。"
                            }
                        },
                        {
                            "text": "Le navigateur constata avec inquiétude que sa boussole <w>affolée</w> ne lui servait plus à rien.",
                            "target_lang_translations": {
                                "en": "The navigator noted with unease that his <w>deranged</w> compass was no longer any use to him.",
                                "ru": "Штурман с тревогой заметил, что его <w>сбесившийся</w> компас больше ни на что не годился.",
                                "de": "Der Seefahrer stellte besorgt fest, dass sein <w>gestörter</w> Kompass ihm nichts mehr nützte.",
                                "es": "El navegante constató con preocupación que su brújula <w>enloquecida</w> ya no le servía de nada.",
                                "zh": "航海家忧心地发现，他那只<w>失灵</w>的罗盘已经毫无用处了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "déréglé"
                    ],
                    "common_phrases": [
                        "aiguille affolée",
                        "boussole affolée"
                    ],
                    "target_lang_definitions": {
                        "en": "Describing a compass needle that swings about without being able to point north.",
                        "ru": "О стрелке компаса, которая колеблется и не может указать на север.",
                        "de": "Von einer Kompassnadel gesagt, die hin- und herschwankt und nicht mehr nach Norden zeigen kann.",
                        "es": "Dicho de la aguja de una brújula que oscila sin lograr señalar el norte.",
                        "zh": "形容罗盘指针胡乱摆动，无法指示北方。"
