                                                "example_id": "169a5c3e-9eaa-499a-ad6e-b77d2a25ce0c",
                                                "sense_id": "4e021d21-44ad-31e7-9b75-667f4878067b",
                                                "text": "Rozhodně zasáhlo Bavorsko v osudy Čech za vévody Maximiliana, vítěze Bělohorského."
                                            }
                                        ]
                                    }
                                ]
                            },
