                ],
                "senses": [
                    {
                        "sense_id": "49cd1314-d499-35f1-9c9e-a94bd3d8dadb",
                        "entry_id": "99cb6c1d-3bd8-3be6-8810-6e2b7d7c55c5",
                        "glosses": [
                            "alle weichen nichtepithelialen, extraskelettären Körpergewebe, mit Ausnahme des Monozyten-Makrophagen-Systems, der Epithelien, der Gliagewebe und der Stützgewebe spezifischer Organe und Eingeweide"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a04f5b7-2a68-4215-a374-5c724bfa774d",
                                "sense_id": "49cd1314-d499-35f1-9c9e-a94bd3d8dadb",
                                "text": "Die formgebenden Elemente der Weichteile sind Kollagen und Elastin."
                            },
                            {
                                "example_id": "25cdb689-8e9a-4bb6-8c75-665eb28c963f",
                                "sense_id": "49cd1314-d499-35f1-9c9e-a94bd3d8dadb",
                                "text": "Das Klarzellensarkom der Weichteile gehört zu den neuroektodermalen Tumoren. Früher wurde es als „malignes Melanom der Weichteile“ bezeichnet […]."
                            },
                            {
                                "example_id": "1038aa70-a8ab-42fb-bb01-7bf64a1703d9",
                                "sense_id": "49cd1314-d499-35f1-9c9e-a94bd3d8dadb",
                                "text": "Der Rheumatismus der Weichteile des Körpers befällt die Sehnen und Muskeln."
                            },
                            {
                                "example_id": "ecb09724-cba0-45dd-a7f3-0e46be4646e1",
                                "sense_id": "49cd1314-d499-35f1-9c9e-a94bd3d8dadb",
                                "text": "Weichteile sind nur dann für die Röntgendiagnostik zugänglich, wenn der Weichteilschatten in Abhängigkeit vom Bildkontrast erkennbar ist oder sich Verkalkungen, Metalle oder freie Gelenkkörper in den Weichteilen finden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c78dcab4-33b5-3577-bcdb-5f7f4ecafe4e",
                        "entry_id": "99cb6c1d-3bd8-3be6-8810-6e2b7d7c55c5",
                        "glosses": [
                            "die (männlichen) Genitalien"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3af594bd-0aa3-40c9-8d5d-7d17d4362bff",
                                "sense_id": "c78dcab4-33b5-3577-bcdb-5f7f4ecafe4e",
                                "text": "Neben anderen Techniken würden sie aber auch den Tritt in die männlichen Weichteile nach Abschluß des 21-Stunden-Kurses (Lehrgangskosten: 495 Dollar) \"gekonnt beherrschen\"."
                            },
                            {
                                "example_id": "5e3ccbf0-dc0d-470c-86b5-3bd43b6b36cc",
                                "sense_id": "c78dcab4-33b5-3577-bcdb-5f7f4ecafe4e",
                                "text": "Gestern schien es nun so, als wollte sich der Portugiese dafür rächen. Denn erst zweieinhalb Monate nach dem angeblichen Angriff auf seine Weichteile erstattet der Mann Anzeige."
                            },
                            {
                                "example_id": "2a03b51e-57d2-43cc-bb2f-23a403857ac1",
                                "sense_id": "c78dcab4-33b5-3577-bcdb-5f7f4ecafe4e",
                                "text": "„Er brüllte, griff sich an die Weichteile und ging zu Boden.“"
                            },
                            {
                                "example_id": "14ed8ae9-2e97-4e5f-947d-7e248cce7880",
                                "sense_id": "c78dcab4-33b5-3577-bcdb-5f7f4ecafe4e",
                                "text": "„Mit aller Kraft ramme ich ihm mein Knie in die Weichteile.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
