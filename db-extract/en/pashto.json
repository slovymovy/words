                        "entry_id": "0c43eb8a-4568-3216-a039-efc72e21edf8",
                        "glosses": [
                            "The native Indo-Iranian language of the Pashtun people; an official language of Afghanistan and Khyber Pakhtunkhwa, Pakistan."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "33743e32-9c95-4da4-a247-c2eed54ff0d7",
                                "sense_id": "7bea453e-f2bc-3d34-a196-33a3e63d09a6",
                                "text": "Tariq clenched his teeth and muttered something to himself in Pashto that Laila didn’t catch."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bb2cf7b-c5a1-4111-8e49-eb8d8c712408",
