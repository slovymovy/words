{
    "word_family": [
        "abyssal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "340e25e4-231f-3fac-8a5e-401c543fed3f",
                    "sense_definition": "A bottomless or unfathomed depth, gulf, or chasm.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "depth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers peered down into the dark <w>abyss</w> of the deep canyon.",
                            "target_lang_translations": {
                                "ru": "Туристы заглянули вниз в тёмную <w>про́пасть</w> глубокого каньона."
                            }
                        },
                        {
                            "text": "They stood at the edge of the <w>abyss</w> and looked at the <w>gulf</w> below.",
                            "target_lang_translations": {
                                "ru": "Они стояли на краю <w>про́пасти</w> и смотрели на бездну внизу."
                            }
                        }
                    ],
                    "synonyms": [
                        "gulf"
                    ],
                    "common_phrases": [
                        "stare into abyss",
                        "edge of abyss"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бездонная или неизмеримая глубина, пропасть или расселина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "про́пасть",
                                "target_lang_sense_clarification": "глубокий обрыв или расселина"
                            },
                            {
                                "target_lang_word": "бе́здна",
                                "target_lang_sense_clarification": "пространство с неведомой, огромной глубиной"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fb1d9d2-ab66-302d-86aa-828e9901de47",
                    "sense_definition": "A state of extreme moral or intellectual decline.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country was sliding into an <w>abyss</w> of economic despair.",
                            "target_lang_translations": {
                                "ru": "Страна скатывалась в <w>бе́здну</w> экономического отчаяния."
                            }
                        },
                        {
                            "text": "He felt he was falling into an <w>abyss</w> of addiction and hopelessness.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что падает в <w>бе́здну</w> зависимости и безнадёжности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "abyss of despair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние глубокого морального или интеллектуального упадка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бе́здна",
                                "target_lang_sense_clarification": "переносное значение, обозначающее крайнюю степень чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3184ba6-60b0-35f7-8fa4-54b03d0e339c",
                    "sense_definition": "An impending catastrophic situation or event.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company stood on the <w>abyss</w> of total bankruptcy.",
                            "target_lang_translations": {
                                "ru": "Компания стояла на краю <w>про́пасти</w> полного банкротства."
                            }
                        },
                        {
                            "text": "Diplomats worked hard to pull the nations back from the <w>abyss</w> of war.",
                            "target_lang_translations": {
                                "ru": "Дипломаты упорно работали, чтобы удержать нации от <w>бе́здны</w> войны."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brink of abyss"
                    ],
                    "target_lang_definitions": {
                        "ru": "Надвигающаяся катастрофическая ситуация или событие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "про́пасть",
                                "target_lang_sense_clarification": "переносное значение, безвыходное положение"
                            },
                            {
                                "target_lang_word": "бе́здна",
                                "target_lang_sense_clarification": "переносное значение, край гибели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b7c5a03-25ff-3bb8-8476-d2ec4803e828",
                    "sense_definition": "A bottomless pit or hell, often used in religious or mythological contexts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "depth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient legends spoke of a dark <w>abyss</w> where lost souls wandered.",
                            "target_lang_translations": {
                                "ru": "Древние легенды рассказывали о тёмной <w>бе́здне</w>, где блуждали потерянные души."
                            }
                        },
                        {
                            "text": "He feared the <w>abyss</w> that awaited him after his wicked deeds.",
                            "target_lang_translations": {
                                "ru": "Он боялся <w>бе́здны</w>, которая ждала его после совершённых им злых дел."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in literary or religious contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бездонная яма или ад, часто используемые в религиозном или мифологическом контексте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бе́здна",
                                "target_lang_sense_clarification": "устаревшее, переносное значение ада"
                            },
                            {
                                "target_lang_word": "про́пасть",
                                "target_lang_sense_clarification": "глубокая бездна"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}