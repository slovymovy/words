                    "sense_definition": "Relating to Finland, its people, or their culture.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed a relaxing evening in a traditional <w>Finnish</w> sauna.",
