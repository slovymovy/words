                        "form_id": "c2372667-8d0e-4958-899c-ac470427c743",
                        "entry_id": "b767ff22-f701-3381-b0fc-8e73aaef7849",
                        "tags": [
                            "plural"
                        ],
                        "form": "rubalises"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "72daa764-112a-34d6-9458-fc12d2166a46",
                        "entry_id": "b767ff22-f701-3381-b0fc-8e73aaef7849",
                        "glosses": [
                            "Ruban, généralement en matière plastique (du polyéthylène), servant à baliser, à délimiter, ou interdire l’accès dans une zone particulière telle que, par exemple, un chantier, une zone minée après un conflit, une scène de crime lors d’une enquête, une zone dangereuse, etc. Elle est généralement de couleurs voyantes, parfois possède du texte ou des symboles normalisés ou non, dont le but est de donner une indication sur les raisons du balisage, de l’interdiction d’accès, ou du danger."
                        ],
                        "tags": [
                            "Marque commerciale"
                        ],
                        "examples": [
                            {
                                "example_id": "93d3c86a-cd7b-4f96-9f94-7c9f17ed867e",
                                "sense_id": "72daa764-112a-34d6-9458-fc12d2166a46",
                                "text": "Pelles et balais en main, Yann et trois autres marins-pompiers enjambent la rubalise du périmètre de sécurité, avant de disparaître derrière un drap occultant le chantier de déblaiement des numéros 15, 17 et 19 de la rue de Tivoli."
                            },
                            {
                                "example_id": "9a0d6813-ab80-4af7-a23c-ae6a05aed42b",
                                "sense_id": "72daa764-112a-34d6-9458-fc12d2166a46",
                                "text": "Une foule de curieux s’est instantanément massée aux abords des rubalises pour s’enquérir de la situation."
                            },
                            {
                                "example_id": "d712415d-38c2-4409-8d8f-af54f58e206d",
                                "sense_id": "72daa764-112a-34d6-9458-fc12d2166a46",
                                "text": "Il clique à nouveau. Un paragraphe apparaît, illustré de trois photos. Sur la première, une scène de crime. Rubalises, voitures de flics, on distingue un corps au sol."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4ba8657-a1b0-4d0f-bbca-52d6e24b4360",
                        "source_entry_id": "b767ff22-f701-3381-b0fc-8e73aaef7849",
                        "source_sense_id": "72daa764-112a-34d6-9458-fc12d2166a46",
                        "source_sense_description": "Ruban utilisé pour baliser les chantiers",
                        "target_lang_word": "Absperrband",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Absperrband",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "240f61e9-a362-3af5-9893-f9f83cd759de",
                                        "entry_id": "d8582cc6-f14b-333d-b92a-0259dc240a29",
                                        "glosses": [
                                            "farbiges Band zur Abgrenzung eines Bereichs, meist um eine mögliche Gefahrenquelle zu signalisieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a09cf75-a2e7-4357-a206-90bfcf3b565b",
                                                "sense_id": "240f61e9-a362-3af5-9893-f9f83cd759de",
                                                "text": "„Die Schola Armatorum ist mit Absperrbändern gesichert, seit sie 2010 in sich zusammenstürzte – zur ‚nationalen Schande‘ Italiens, so damals der Staatspräsident.“"
                                            },
                                            {
                                                "example_id": "2acd8ae7-4fa5-4255-91a4-2a0ee5460408",
                                                "sense_id": "240f61e9-a362-3af5-9893-f9f83cd759de",
                                                "text": "„Ich sah mich um und stieg unbemerkt über ein Absperrband.“"
                                            },
                                            {
                                                "example_id": "eb964734-4885-4e8d-a973-0569f1da3e81",
                                                "sense_id": "240f61e9-a362-3af5-9893-f9f83cd759de",
                                                "text": "„Man hatte Ständer aufgestellt und so mit gelbem Absperrband verbunden, dass sie einen Korridor mit labyrinthartigen Kehrtwendungen bildeten.“"
                                            },
                                            {
                                                "example_id": "ef73c766-8c7f-46cb-a902-9db56c1c5258",
                                                "sense_id": "240f61e9-a362-3af5-9893-f9f83cd759de",
                                                "text": "„Ein gelbes Absperrband der Polizei war quer über den Parkplatz beim neuen Leuchtturm gespannt, und etwas weiter weg, auf den Felsen beim alten Leuchtturm, sah sie die Spurensicherung bei der Arbeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47846a51-f8c0-43eb-9c09-1eab8db2d19a",
                        "source_entry_id": "b767ff22-f701-3381-b0fc-8e73aaef7849",
                        "source_sense_id": "72daa764-112a-34d6-9458-fc12d2166a46",
                        "source_sense_description": "Ruban utilisé pour baliser les chantiers",
                        "target_lang_word": "Flatterband",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flatterband",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1cf643af-84a9-3af7-b8ab-70ca0bb377a3",
                                        "entry_id": "4106c716-65a4-3a85-99de-aaa7e14ff755",
                                        "glosses": [
                                            "dünnes (bei Wind flatterndes) Absperrband"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "672e28dd-5d0b-4b8f-8279-eda73bb7a5e5",
                                                "sense_id": "1cf643af-84a9-3af7-b8ab-70ca0bb377a3",
                                                "text": "„Er hatte Nadias Wohnung mit gelbem Flatterband abgesperrt und dem Hausmeister Hölle und Verdammnis angedroht, falls er jemanden reinließe.“"
                                            },
                                            {
                                                "example_id": "d0f95ea6-6148-49e6-b183-59a45af4c79a",
                                                "sense_id": "1cf643af-84a9-3af7-b8ab-70ca0bb377a3",
                                                "text": "„Ein gelbes Flatterband sperrte den Eingangsbereich des Gebäudes ab, und die drei Polizisten, die dahinter standen, passten auf, dass niemand versuchte, es zu durchbrechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
