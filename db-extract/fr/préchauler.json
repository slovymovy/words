                "senses": [
                    {
                        "sense_id": "cdffc991-ac05-3b90-82a7-b54b8646dc2a",
                        "entry_id": "28944eed-3415-3c33-8d18-0b0e0da5f475",
                        "glosses": [
                            "Ajouter au préalable de la chaux à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3f3f79e-57c0-4fdb-b9a4-532c927a050d",
                                "sense_id": "cdffc991-ac05-3b90-82a7-b54b8646dc2a",
                                "text": "Le procédé de préparation d'une solution purifiée d'inuline à partir du jus de chicorée, consiste à préchauler le jus de chicorée jusqu'à un pH ne dépassant pas 11, puis à le chauler et à le carbonater simultanément et de manière que le pH du jus ne dépasse pas 11."
                            },
                            {
                                "example_id": "bcbe79a0-d93a-4755-b4cd-2bc18511d6be",
                                "sense_id": "cdffc991-ac05-3b90-82a7-b54b8646dc2a",
                                "text": "Le jus produit par les râperies est préchaulé et pompé dans des conduites souterraines vers la centrale où il est travaillé."
                            }
                        ]
                    }
