                                                "example_id": "8cd11348-6bbc-4041-9253-ef3fcf248447",
                                                "sense_id": "323eb04f-5e94-3416-bffd-e3f005664890",
                                                "text": "Réduire une luxation."
                                            },
                                            {
                                                "example_id": "a0ee617e-44b8-42ee-ad07-832d385738b7",
                                                "sense_id": "323eb04f-5e94-3416-bffd-e3f005664890",
                                                "text": "Le pronostic est toujours très grave, car même réduite, la luxation détermine une boiterie."
                                            },
                                            {
                                                "example_id": "f0b50a8b-86b5-45fa-946d-1bd0cb78beb5",
                                                "sense_id": "323eb04f-5e94-3416-bffd-e3f005664890",
                                                "text": "La luxure n’est pas une luxation. C’est cependant une entorse à la chasteté."
                                            }
                                        ]
                                    },
