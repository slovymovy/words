                    {
                        "translation_id": "16c0a094-b14b-4ab3-8405-5d2099c2ac5e",
                        "source_entry_id": "56f963e0-0180-3af7-9693-3a4f31221a46",
                        "source_sense_description": "beaming with vivacity and happiness",
                        "target_lang_word": "solaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3bd45980-ec44-34cc-a618-30c822f1d0ea",
                                        "entry_id": "cce055f5-5fb2-3f07-8c03-e05c02ce33ca",
                                        "glosses": [
                                            "Qui concerne le soleil, qui a rapport au soleil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2885cd57-3aba-4158-adb0-ea38f7c7a9e3",
                                                "sense_id": "3bd45980-ec44-34cc-a618-30c822f1d0ea",
                                                "text": "Pour les chauffe-eau solaires monobloc, des avis techniques et des certificats de contrôle de qualité (CSTBat) sont délivrés par le Centre Scientifique et Technique du Bâtiment. Chaque chauffe-eau solaire doit comporter un marquage sur lequel sont consignés : […]."
                                            },
                                            {
                                                "example_id": "6ade7fc9-c628-4ec4-9794-436bcdff1e00",
                                                "sense_id": "3bd45980-ec44-34cc-a618-30c822f1d0ea",
                                                "text": "Par régulation thermostatique, la chaudière se déclenche seulement si la chaleur solaire est insuffisante; néanmoins l’eau caloporteuse est préchauffée et réduit l’augmentation de température nécessaire."
                                            },
                                            {
                                                "example_id": "2a4c4a04-ec5a-48bb-85ba-adda42cc31c2",
                                                "sense_id": "3bd45980-ec44-34cc-a618-30c822f1d0ea",
                                                "text": "Cette fête, appelée Khánh Ha, se déroule du 12e au 14e jour du 4e mois lunaire (qui tombe généralement au mois de mai solaire)."
                                            },
                                            {
                                                "example_id": "c832023d-2680-4028-8cd5-753c7a51fda3",
                                                "sense_id": "3bd45980-ec44-34cc-a618-30c822f1d0ea",
                                                "text": "Justin Anderson consulte de manière obsessionnelle la météo solaire. \"Presque toute la journée, tous les jours, je surveille la météo pour m’assurer que s’il y a des chances d’en voir, je serai au courant\", raconte-t-il."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8364788e-fded-300a-866f-6a04ae9598f4",
                                        "entry_id": "cce055f5-5fb2-3f07-8c03-e05c02ce33ca",
                                        "glosses": [
                                            "Qui tire profit des apports du soleil pour le confort thermique et lumineux et pour la maîtrise des consommations énergétiques de l’habitat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef27bd5a-b651-4784-acb9-ec3675d82f04",
                                                "sense_id": "8364788e-fded-300a-866f-6a04ae9598f4",
                                                "text": "Architecture solaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6792635f-97ca-32fb-9f8d-a6e56c62c4fa",
                                        "entry_id": "cce055f5-5fb2-3f07-8c03-e05c02ce33ca",
                                        "glosses": [
                                            "Qui s’épanouit pendant que le soleil est sur l’horizon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2abb3028-f86d-42ee-89b5-b0a843184450",
                                                "sense_id": "6792635f-97ca-32fb-9f8d-a6e56c62c4fa",
                                                "text": "Fleurs solaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "188ffc72-56f0-3bec-a8eb-d7f1ba6f61ae",
                                        "entry_id": "cce055f5-5fb2-3f07-8c03-e05c02ce33ca",
                                        "glosses": [
                                            "Qui appartient à la région abdominale du système nerveux sympathique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42026d9b-6c5d-40ed-82aa-aaebfa650f5d",
                                                "sense_id": "188ffc72-56f0-3bec-a8eb-d7f1ba6f61ae",
                                                "text": "Plexus solaire."
                                            },
                                            {
                                                "example_id": "a414071d-65b4-4ef2-8a59-ca898cce5d42",
                                                "sense_id": "188ffc72-56f0-3bec-a8eb-d7f1ba6f61ae",
                                                "text": "Syndrome solaire, trouble nerveux de cette région."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "534a7b03-5d68-3d42-8ddc-76b13f5512f8",
                                        "entry_id": "cce055f5-5fb2-3f07-8c03-e05c02ce33ca",
                                        "glosses": [
                                            "Radieux, rayonnant."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b75c699-f8e7-480d-9ce5-f461b9547ec0",
                                                "sense_id": "534a7b03-5d68-3d42-8ddc-76b13f5512f8",
                                                "text": "Malgré les drames qui se jouent en coulisses, Lady Diana reste solaire. Elle a gagné le cœur des Anglais et d'une grande partie du monde."
                                            },
                                            {
                                                "example_id": "96972b41-1351-4f56-9b80-97df3361d3c6",
                                                "sense_id": "534a7b03-5d68-3d42-8ddc-76b13f5512f8",
                                                "text": "C’est avec une musique qualifiée « d’afro-disco feel good et contagieuse » que les six musiciens nantais évoluent sur scène avec une énergie solaire, une façon de passer d’une esthétique ou d’une ambiance à une autre sans complexe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c05dbdb-f268-39ed-b70a-7a62f341884b",
                                        "entry_id": "cce055f5-5fb2-3f07-8c03-e05c02ce33ca",
                                        "glosses": [
                                            "Qualifie les quatorze consonnes coronales de l'arabe (t, ṯ, d, ḏ, r, z, s, š, ṣ, ḍ, ṭ, ẓ, l, n) qui provoquent l'assimilation du l de l’article al, comme avec le soleil الشمس où \\\"al-šams\\\" se prononce \\\"aš-šams\\\". Ceci contrairement aux consonnes dites lunaires."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8679ccb5-b266-38f2-8af7-17ed063c0242",
                                        "entry_id": "cce055f5-5fb2-3f07-8c03-e05c02ce33ca",
                                        "glosses": [
                                            "Variante orthographique de sol-air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f76419d-6d3b-4dde-b882-d59d1e986c3d",
                                                "sense_id": "8679ccb5-b266-38f2-8af7-17ed063c0242",
                                                "text": "MBDA espère décrocher d’ici la fin de cette année une commande de missiles solaires de « plusieurs milliards de FF » de la part de la Malaisie, a-t-il détaillé."
                                            },
                                            {
                                                "example_id": "d75e569b-a0bb-44e7-ace6-4e11416d2b8c",
                                                "sense_id": "8679ccb5-b266-38f2-8af7-17ed063c0242",
                                                "text": "L’Allemagne va pour sa part envoyer en Ukraine 1 000 lance-roquettes et 500 missiles solaires."
                                            },
                                            {
                                                "example_id": "7ab97272-5bff-4053-a403-31dd9650e6d8",
                                                "sense_id": "8679ccb5-b266-38f2-8af7-17ed063c0242",
                                                "text": "Des chars, des lance-roquettes et des missiles solaires devraient être fournis à l’armée ukrainienne, d’ici la fin du mois d’avril, comme l’ont promis les États-Unis et plusieurs pays européens."
                                            }
                                        ]
                                    }
                                ]
                            },
