                ],
                "senses": [
                    {
                        "sense_id": "b2ce3516-866f-3ab0-9508-864ba01ad3b1",
                        "entry_id": "76645ff8-34c7-39d8-ad8d-aee9dcfa6894",
                        "glosses": [
                            "Handlung/Vorgang, etwas flacher zu machen oder flach zu werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b88f5cb-7106-4d50-b125-6b49a8e1c735",
                                "sense_id": "b2ce3516-866f-3ab0-9508-864ba01ad3b1",
                                "text": "„Eine im Fließgewässer ablaufende Hochwasserwelle verändert durch die Retentionswirkung (Gerinnerückhalt) mit zunehmender Laufzeit ihre Form, d.h. es findet eine Abflachung des Scheitels und eine Verbreiterung der Welle statt.“"
                            },
                            {
                                "example_id": "2e76bf47-ec02-49d1-b10a-1da85676f308",
                                "sense_id": "b2ce3516-866f-3ab0-9508-864ba01ad3b1",
                                "text": "„Larven, die in Fließgewässern leben, weisen bei starker Strömung eine Abflachung des Körpers auf.“"
                            },
                            {
                                "example_id": "e70af3da-e238-47c2-9b53-8debf3ebb2cd",
                                "sense_id": "b2ce3516-866f-3ab0-9508-864ba01ad3b1",
                                "text": "„Bei der glatten Zungenatrophie findet sich eine Abflachung der Zungenpapillen mit Verlust der Sekundärpapillen.“"
                            },
                            {
                                "example_id": "4e80b2eb-28a7-42a2-ab56-08985a83903b",
                                "sense_id": "b2ce3516-866f-3ab0-9508-864ba01ad3b1",
                                "text": "„Die ellipsenartige Abflachung der Augenlinse wird durch den Zug der ringförmigen Zonulafasern bewirkt, ihre Kontraktion zur Kugel durch den Ziliarmuskel.“"
                            },
                            {
                                "example_id": "f0d29222-abce-4569-91e1-1826ef7aa65b",
                                "sense_id": "b2ce3516-866f-3ab0-9508-864ba01ad3b1",
                                "text": "„Zum Jahreswechsel treten in der Bundesrepublik Deutschland mehrere Gesetzesänderungen in Kraft, u. a. eine Abflachung der Steuerprogression bei der Lohn- und Einkommensteuer und eine Verlängerung des Erziehungsurlaubs von zehn auf zwölf Monate.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
