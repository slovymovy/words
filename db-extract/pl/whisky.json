                                        "sense_id": "5efc9efc-9be4-3d2d-b39d-9f1179aaac9d",
                                        "entry_id": "c553e168-e304-3617-a4b5-804e6dca97e2",
                                        "glosses": [
                                            "A liquor distilled from the fermented mash of grain (as rye, corn, or barley)."
                                        ],
