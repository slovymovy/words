                        "examples": [
                            {
                                "example_id": "f963b2d9-6f4b-4f84-b944-a1828f3ae3f7",
                                "sense_id": "d5568f3e-47ed-3b47-a9b5-68d0555e0f45",
                                "text": "In de zaak is vorige week een 36-jarige werkneemster van het champignonbedrijf aangehouden, zegt de politie. Zij wordt net als haar baas verdacht van betrokkenheid bij uitbuiting."
                            },
                            {
                                "example_id": "1d9915fd-e2f5-4f70-b932-3bef80018124",
                                "sense_id": "d5568f3e-47ed-3b47-a9b5-68d0555e0f45",
                                "text": "Het Noord-Limburgse champignonbedrijf Prime Champ is failliet. De rechtbank in Den Bosch heeft vandaag het faillissement uitgesproken van de onderneming, die met 750 werknemers een van de grootste champignonbedrijven van Europa was."
                            }
                        ]
