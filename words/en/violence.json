{
    "word_family": [
        "violent",
        "violently"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8ba5ef35-8bbc-34ee-bbf0-d5f335fcd031",
                    "sense_definition": "Physical action which causes destruction, harm, pain, or suffering.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_harm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must work together to prevent <w>violence</w> in our schools.",
                            "target_lang_translations": {
                                "ru": "Мы должны работать вместе, чтобы предотвратить <w>насилие</w> в наших школах.",
                                "zh": "我们必须共同努力，防止校园内出现<w>暴力</w>事件。"
                            }
                        },
                        {
                            "text": "The film contains scenes of extreme physical <w>violence</w>.",
                            "target_lang_translations": {
                                "ru": "Фильм содержит сцены крайней физической <w>жестокости</w>.",
                                "zh": "这部电影包含极度身体<w>暴力</w>的场景。"
                            }
                        }
                    ],
                    "synonyms": [
                        "brutality",
                        "aggression"
                    ],
                    "antonyms": [
                        "peace",
                        "nonviolence"
                    ],
                    "common_phrases": [
                        "domestic violence",
                        "act of violence",
                        "physical violence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое действие, причиняющее разрушение, вред, боль или страдание.",
                        "zh": "旨在造成破坏、伤害、痛苦或折磨的身体行为。"
                    },
                    "translations": {
                        "ru": [
                            {
