                "senses": [
                    {
                        "sense_id": "7f4eac25-a1a8-3eae-a3cc-378978baef90",
                        "entry_id": "e40a6aea-2b9b-3a0f-8da2-2c95fe087fb1",
                        "glosses": [
                            "Form des Passivs, die einen Vorgang/Prozess beschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "547d5fc9-fffc-4b70-bf6d-eed17188ad6f",
                                "sense_id": "7f4eac25-a1a8-3eae-a3cc-378978baef90",
                                "text": "„Der Satz Das Fenster ist gestrichen kann als Zustandspassiv analog zu Das Fenster wird gestrichen (Vorgangspassiv) gelesen werden.“"
                            },
                            {
                                "example_id": "69cb10cc-1d4a-4fd6-8edb-3a651e9eab48",
                                "sense_id": "7f4eac25-a1a8-3eae-a3cc-378978baef90",
                                "text": "„Die Verwendung des Vorgangspassivs (VP) und des Zustandpassivs (ZP) im Deutschen stellt eine bedeutende Fehlerquelle im Deutschunterricht mit tschechischen Lernerinnen und Lernern dar.“"
                            },
                            {
                                "example_id": "deeacf46-fa5a-4037-9d5a-8df67dec0005",
                                "sense_id": "7f4eac25-a1a8-3eae-a3cc-378978baef90",
                                "text": "„Das Vorgangspassiv ist immer: täterzugewandt, vorgangsorientiert; der Täter muß genannt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
