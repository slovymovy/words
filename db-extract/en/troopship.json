                "senses": [
                    {
                        "sense_id": "82cf0a4d-75d3-3bd3-976a-233a2179ffa2",
                        "entry_id": "a0479324-43b3-3006-aeaf-9aa403d331b3",
                        "glosses": [
                            "A ship used to transport military troops."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1204ca4c-7c52-43c9-831b-64da7dcaa0ce",
                                "sense_id": "82cf0a4d-75d3-3bd3-976a-233a2179ffa2",
                                "text": "The former, on the other hand, would put his troopships safely out of its reach."
                            },
                            {
                                "example_id": "c4d52074-5093-4dd9-abae-36dd1646bae5",
                                "sense_id": "82cf0a4d-75d3-3bd3-976a-233a2179ffa2",
                                "text": "[…] the Duke of Rothesay and the Duke of York, however, are serving as troopships to and from Harwich, and it is unlikely that they will be released for some time to come."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2782cf2c-28c6-4c81-8f95-fb76409dfc54",
                        "source_entry_id": "a0479324-43b3-3006-aeaf-9aa403d331b3",
                        "source_sense_id": "82cf0a4d-75d3-3bd3-976a-233a2179ffa2",
                        "source_sense_description": "ship used to transport military troops",
                        "target_lang_word": "troepenschip",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "troepenschip",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "58f0abd9-93ed-3c65-ba01-b1bbc0135517",
                                        "entry_id": "55835010-14b7-30cc-9081-4649f08cbc98",
                                        "glosses": [
                                            "schip waarmee men troepen over zee naar het slagveld vervoert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "572592f2-7c51-4b93-b9ea-45c35d3736ee",
                                                "sense_id": "58f0abd9-93ed-3c65-ba01-b1bbc0135517",
                                                "text": "Toen het troepenschip de Natural Selection naderde en de enorme afmetingen van de ijzeren berg geleidelijk aan zichtbaar werden, kwam het beeld van de Ming in Zhang Beihai's gedachten op."
                                            },
                                            {
                                                "example_id": "f8fce994-821a-4824-a391-0a8c31221cf5",
                                                "sense_id": "58f0abd9-93ed-3c65-ba01-b1bbc0135517",
                                                "text": "De voorbereiding in Nederland was in de meeste gevallen beperkt. Twee keer naar de schietbaan in Roermond, waar niet geschoten kon worden vanwege de drukte. Exerceren in de sneeuw. Wat toevallige instructies van een oudgediende die op het troepenschip tijdens de heenreis enkele ervaringen deelde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
