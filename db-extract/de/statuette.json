                ],
                "senses": [
                    {
                        "sense_id": "338fbd95-96dc-3a48-9869-6d4359b36bae",
                        "entry_id": "b982b5cf-c76b-3ec2-bf4f-91ea8690dbcc",
                        "glosses": [
                            "kleine Statue"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a33ff6f8-488c-498a-b184-0ecf3f3f7e33",
                                "sense_id": "338fbd95-96dc-3a48-9869-6d4359b36bae",
                                "text": "„Kleinplastiken (Figurinen bzw. Statuetten) sind einer der diagnostischen Marker der Donauzivilisation.“"
                            },
                            {
                                "example_id": "aefa0651-463e-443e-a52d-3bea296a0e3c",
                                "sense_id": "338fbd95-96dc-3a48-9869-6d4359b36bae",
                                "text": "„Auf einem Regal stand eine Statuette Unserer Allergnädigsten Majestät zu Pferde.“"
                            },
                            {
                                "example_id": "0757691a-6689-4f1a-b53c-3935d52362e4",
                                "sense_id": "338fbd95-96dc-3a48-9869-6d4359b36bae",
                                "text": "„Er stellte sie sich vor wie Statuetten, die er dann im Wohnzimmer seines Elternhauses plazierte.“"
                            },
                            {
                                "example_id": "b171a594-d595-4a39-96bc-651d76a82d57",
                                "sense_id": "338fbd95-96dc-3a48-9869-6d4359b36bae",
                                "text": "„Im Regal standen nach wie vor die alten Bücher und daneben ein paar Statuetten und alte Bilder, die ihre Mutter dort abstellte, wenn sie im Wohnzimmer keinen Platz fand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4732e73-829d-4b25-9d7a-49883267943e",
                        "source_entry_id": "b982b5cf-c76b-3ec2-bf4f-91ea8690dbcc",
                        "source_sense_id": "338fbd95-96dc-3a48-9869-6d4359b36bae",
                        "source_sense_description": "kleine Statue",
                        "target_lang_word": "statuette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "statuette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6697bea5-136e-34e4-88a1-cb2004e7a634",
                                        "entry_id": "d6510b96-cb8f-3f8f-aaa1-1b9b7ba24dcc",
                                        "glosses": [
                                            "A small statue, usually a figure much less than life size, especially when of marble or bronze, or of plaster or clay as a preparation for the marble or bronze, as distinguished from a figure in terra cotta etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e1179c4-a395-4a8c-952d-79679cb2c569",
                                                "sense_id": "6697bea5-136e-34e4-88a1-cb2004e7a634",
                                                "text": "[…] may be discovered not far from a charming statuette of Queen Alexandra, and there is also the figurette of King George's elder brother."
                                            },
                                            {
                                                "example_id": "a7e3b7e2-9ff9-431d-a000-3c5f32bacf4e",
                                                "sense_id": "6697bea5-136e-34e4-88a1-cb2004e7a634",
                                                "text": "Some statuettes are not monochrome but represent characters. That is why they are called nanofigures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "294b4b0e-0846-4eb3-b084-bbc513e2b538",
                        "source_entry_id": "b982b5cf-c76b-3ec2-bf4f-91ea8690dbcc",
                        "source_sense_id": "338fbd95-96dc-3a48-9869-6d4359b36bae",
                        "source_sense_description": "kleine Statue",
                        "target_lang_word": "statuette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "statuette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b313dc2a-5852-331b-9f98-195ce673e4d4",
                                        "entry_id": "5fa9a7fc-00a6-34a0-b16d-d92ea81d6be4",
                                        "glosses": [
                                            "Petite statue."
                                        ],
                                        "tags": [
                                            "Sculpture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ebe1c78-8155-42fd-b46b-dc4622185063",
                                                "sense_id": "b313dc2a-5852-331b-9f98-195ce673e4d4",
                                                "text": "Réexaminons en premier lieu le groupe bien connu des statuettes de terre cuite attiques, conservé à New York, qui révèle une stylisation indéniable des masques comiques dès la fin du Vᵉ siècle av. J.-C."
                                            },
                                            {
                                                "example_id": "21baf6fc-a6bf-45b1-b97b-ff82bc21de4e",
                                                "sense_id": "b313dc2a-5852-331b-9f98-195ce673e4d4",
                                                "text": "En juin, une statuette anthropomorphe au faciès joufflu en serpentine a ainsi été adjugée pour 399 900 euros chez Binoche et Giquello."
                                            },
                                            {
                                                "example_id": "a448c5f4-49f4-4572-b7d4-7f65e7129ec0",
                                                "sense_id": "b313dc2a-5852-331b-9f98-195ce673e4d4",
                                                "text": "Commana s’inquiète pour son petit patrimoine : la statuette de la croix de Quillidiec vient de disparaître."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
