                "senses": [
                    {
                        "sense_id": "b0679423-3061-35fb-b92b-69b45a6175f9",
                        "entry_id": "62219ec2-2833-3f9d-80f5-eaca746a18a1",
                        "glosses": [
                            "bezkrytyczne podporządkowywanie się normom, wartościom i poglądom uznanym za obowiązujące w danej grupie"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [
                            {
                                "example_id": "c44021e4-3497-4ad5-9c1f-06c393918375",
                                "sense_id": "b0679423-3061-35fb-b92b-69b45a6175f9",
                                "text": "W niektórych sytuacjach bezrefleksyjny konformizm może być tragiczny w skutkach, trzeba pamiętać, że czasem warto pozwolić sobie na zachowanie nonkonformistyczne"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ecdceca-f846-4384-bcf0-db995749d7b8",
                        "source_entry_id": "62219ec2-2833-3f9d-80f5-eaca746a18a1",
                        "source_sense_id": "b0679423-3061-35fb-b92b-69b45a6175f9",
                        "target_lang_word": "conformity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conformity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1dcf1674-f608-327a-8d68-013d6df47b56",
                                        "entry_id": "b9049223-5fd5-354f-af01-0af7a73ff969",
                                        "glosses": [
                                            "The state of things being similar or identical."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f94a1f6-2712-379a-bf70-307849d332ca",
                                        "entry_id": "b9049223-5fd5-354f-af01-0af7a73ff969",
                                        "glosses": [
                                            "A point of resemblance; a similarity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0bc8b66f-3f7b-3e05-b4c0-f14a5a19e707",
                                        "entry_id": "b9049223-5fd5-354f-af01-0af7a73ff969",
                                        "glosses": [
                                            "The state of being conforming, of complying with a set of rules, with a norm or standard."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a94040b5-8c91-3bd3-bfff-d4961efaf4ed",
                                        "entry_id": "b9049223-5fd5-354f-af01-0af7a73ff969",
                                        "glosses": [
                                            "The ideology of adhering to one standard or social uniformity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "256f9ee4-e216-4321-92a3-f98904c2ac63",
                                                "sense_id": "a94040b5-8c91-3bd3-bfff-d4961efaf4ed",
                                                "text": "How far should one accept the rules of the society in which one lives? To put it another way: at what point does conformity become corruption? Only by answering such questions does the conscience truly define itself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4fbd6ce8-a7f9-460d-a95b-5ff4bacb2c00",
                        "source_entry_id": "62219ec2-2833-3f9d-80f5-eaca746a18a1",
                        "source_sense_id": "b0679423-3061-35fb-b92b-69b45a6175f9",
                        "target_lang_word": "konformismus",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "01de2264-bba9-4a77-847c-65750927b988",
                        "source_entry_id": "62219ec2-2833-3f9d-80f5-eaca746a18a1",
                        "source_sense_id": "b0679423-3061-35fb-b92b-69b45a6175f9",
                        "target_lang_word": "conformisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conformisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8883417-ccb0-38f0-a7f6-0ad91bfff78b",
                                        "entry_id": "37388ecd-0811-3dc4-9555-3845d8a55c63",
                                        "glosses": [
                                            "Tendance à se conformer aux idées, aux modes, aux mœurs, au langage du milieu dans lequel on vit, du groupe auquel on appartient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96ccdbda-4c1b-4511-aa1e-f23008837bf1",
                                                "sense_id": "d8883417-ccb0-38f0-a7f6-0ad91bfff78b",
                                                "text": "L’art qui se soumet à une orthodoxie, fût-elle celle de la plus saine des doctrines, est perdu. Il sombre dans le conformisme."
                                            },
                                            {
                                                "example_id": "bf688e75-5c08-437f-a4d9-0725bbfd3227",
                                                "sense_id": "d8883417-ccb0-38f0-a7f6-0ad91bfff78b",
                                                "text": "Il intéressait toujours les gens que ne rebutait pas la nouveauté car, ne visant pas l’originalité, il ne tombait dans aucun conformisme."
                                            },
                                            {
                                                "example_id": "52a7be61-5c4b-45a8-9b72-a1e4e885520e",
                                                "sense_id": "d8883417-ccb0-38f0-a7f6-0ad91bfff78b",
                                                "text": "L’homme, libre de se soumettre au conformisme ambiant, bombe le torse, étale ses décorations sur sa poitrine, fait le beau et peut ainsi satisfaire l’image idéale de lui qu'il s’est faite en regardant son reflet."
                                            },
                                            {
                                                "example_id": "f57e007e-3aef-4c59-9493-a9aaa7edc6be",
                                                "sense_id": "d8883417-ccb0-38f0-a7f6-0ad91bfff78b",
                                                "text": "Loin des réalités du front, les civils se laissaient plus facilement bourrer le crâne, selon l'expression familière aux combattants. À moins qu'ils n'aient adopté, par conformisme, le langage imposé par la société."
                                            },
                                            {
                                                "example_id": "c5af27f9-41a9-47fb-b697-c2c0e280be7b",
                                                "sense_id": "d8883417-ccb0-38f0-a7f6-0ad91bfff78b",
                                                "text": "Plus encore, par son style et sa défense du langage, le satiriste nous met en garde contre un phénomène qui requiert toute notre vigilance : « le fait que les soumissions et les conformismes ordinaires des situations ordinaires annoncent les soumissions extraordinaires des situations extraordinaires » (Bourdieu)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15a70800-5766-4f4d-8e1e-4a0e6aa40470",
                        "source_entry_id": "62219ec2-2833-3f9d-80f5-eaca746a18a1",
