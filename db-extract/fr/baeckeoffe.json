                "senses": [
                    {
                        "sense_id": "123291db-4fb6-34e8-a36c-fa8e583968af",
                        "entry_id": "fb2f9c15-3acf-3692-b1bb-f5002c875da2",
                        "glosses": [
                            "Plat alsacien composé généralement de trois viandes différentes (porc, mouton et bœuf), de pommes de terre et d’oignons, le tout arrosé de vin blanc et cuit au four, à l’étouffée, dans un plat traditionnel spécial pour cet usage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fde00dbf-e2de-437b-be62-90904d71ceb2",
                                "sense_id": "123291db-4fb6-34e8-a36c-fa8e583968af",
                                "text": "Le baeckeoffe (qu’on écrit aussi baeckeofe) est un plat traditionnel alsacien. Il se compose de viandes diverses (agneau, porc, bœuf) marinées au vin blanc et cuites longuement en terrine avec des tranches de pommes de terre."
                            }
                        ]
                    }
