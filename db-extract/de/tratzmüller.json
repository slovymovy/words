                "senses": [
                    {
                        "sense_id": "c84a880a-7886-3a73-9f2e-39e20b2a69d4",
                        "entry_id": "cd2b3444-5f5d-3398-9a87-c06073453ccf",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "748178dc-a4bf-4cca-b2c7-59427747b684",
                                "sense_id": "c84a880a-7886-3a73-9f2e-39e20b2a69d4",
                                "text": "Frau Tratzmüller ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "651578eb-6feb-4dc0-b761-45e2f367dbdb",
                                "sense_id": "c84a880a-7886-3a73-9f2e-39e20b2a69d4",
                                "text": "Herr Tratzmüller wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6659eb97-b66e-4b1a-a819-708f4ee4d271",
                                "sense_id": "c84a880a-7886-3a73-9f2e-39e20b2a69d4",
                                "text": "Die Tratzmüllers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7f1e004b-2cf6-43b9-89e4-885ae7b67cae",
                                "sense_id": "c84a880a-7886-3a73-9f2e-39e20b2a69d4",
                                "text": "Der Tratzmüller trägt nie die Schals, die die Tratzmüller ihm strickt."
                            },
                            {
                                "example_id": "b53a3b05-ed5f-46d1-8eb0-c8606bdada06",
                                "sense_id": "c84a880a-7886-3a73-9f2e-39e20b2a69d4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Tratzmüller kommt, geht der Herr Tratzmüller.“"
                            },
                            {
                                "example_id": "359e6920-710a-4566-87c0-91b7081a2d76",
                                "sense_id": "c84a880a-7886-3a73-9f2e-39e20b2a69d4",
                                "text": "Tratzmüller kommt und geht."
                            },
                            {
                                "example_id": "f1744f24-aaf5-4bb3-970f-66c585d985aa",
                                "sense_id": "c84a880a-7886-3a73-9f2e-39e20b2a69d4",
                                "text": "Tratzmüllers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
