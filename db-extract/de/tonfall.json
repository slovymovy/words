                        ],
                        "form": "den Tonfall"
                    },
                    {
                        "form_id": "35b511be-b43c-421f-b07a-94bedb99174e",
                        "entry_id": "0791b240-e6b5-3567-bb45-c475b5ddd135",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Tonfälle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2902f86a-e94a-3926-86cf-9a820878cb96",
                        "entry_id": "0791b240-e6b5-3567-bb45-c475b5ddd135",
                        "glosses": [
                            "Art und Weise, wie etwas ausgesprochen wird, zum Beispiel zum Ausdruck von Gefühlen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdc5a603-ab0f-40a4-905d-99747856ed04",
                                "sense_id": "2902f86a-e94a-3926-86cf-9a820878cb96",
                                "text": "Er brachte seine Kritik in einem sehr sarkastischen Tonfall vor."
                            },
                            {
                                "example_id": "b3506cf1-81f6-423d-82a8-329e47a40daf",
                                "sense_id": "2902f86a-e94a-3926-86cf-9a820878cb96",
                                "text": "„Sein Tonfall duldete keinen Widerspruch, er ging sogleich zurück in sein Zimmer, das neben meinem lag.“"
                            },
                            {
                                "example_id": "d556f8b7-9fd0-4273-9eb6-d5b316f8d703",
                                "sense_id": "2902f86a-e94a-3926-86cf-9a820878cb96",
                                "text": "„Nach Ronalds verwundertem Tonfall hatte er dieses Fremdwort noch nie gehört.“"
                            },
                            {
                                "example_id": "022a36ee-660f-43a7-bc16-76df8a20a0c2",
                                "sense_id": "2902f86a-e94a-3926-86cf-9a820878cb96",
                                "text": "„Es hätte in meiner Jugend als eine Lästerung gegolten, wenn man das Gotteswort in einem anderen Tonfall vorgetragen hätte, als es der Brauch vorschrieb.“"
                            },
                            {
                                "example_id": "0a329894-7963-49f5-8a70-daac31bd18e4",
                                "sense_id": "2902f86a-e94a-3926-86cf-9a820878cb96",
                                "text": "„Meine Beobachtungen aus Schweden und aus der BRD zeigen, daß man schon in den ersten Schuljahren charakteristische Unterschiede in der Verwendung von Füllwörtern, Schimpf- und Fluchwörtern und in paralinguistischen Verhaltensweisen wie Tonfall, Sprechtempo, Lachen, feststellen kann.“"
                            },
                            {
                                "example_id": "a95d1e11-4e6e-4205-97f1-ffa15e3ced41",
                                "sense_id": "2902f86a-e94a-3926-86cf-9a820878cb96",
                                "text": "„Ihr Tonfall ist distanziert, auf Gerbers Fragen geht sie nicht ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5696bb73-6412-39b0-aa6d-e003740f7df4",
                        "entry_id": "0791b240-e6b5-3567-bb45-c475b5ddd135",
                        "glosses": [
                            "Veränderung der Tonhöhe beim Sprechen"
                        ],
                        "tags": [
                            "Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "d1144f0f-2bbd-4cb7-8b30-efd5789a49a3",
                                "sense_id": "5696bb73-6412-39b0-aa6d-e003740f7df4",
                                "text": "Briten und Amerikaner kann man schon am Tonfall sehr gut unterscheiden."
                            },
                            {
                                "example_id": "22838a50-aea2-490f-a9b0-85ecc3f27457",
                                "sense_id": "5696bb73-6412-39b0-aa6d-e003740f7df4",
                                "text": "„Es ist nicht Kloses Stimme, diese ein wenig dröhnende, ein wenig rauhe Stimme im Berliner Tonfall, es ist eine gepflegte, harte, sachliche, ein wenig manirierte Stimme, die eines geübten, routinierten Sprechers.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
