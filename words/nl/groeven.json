    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "523827d4-a331-3d1c-a0ba-70af1bf89dd4",
                    "sense_definition": "meervoud verleden tijd van <w>graven</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "graven_vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen <w>groeven</w> een diepe kuil in het zand op het strand.",
                            "target_lang_translations": {
                                "de": "Die Kinder <w>gruben</w> ein tiefes Loch in den Sand am Strand."
                            }
                        },
                        {
                            "text": "De archeologen <w>groeven</w> voorzichtig naar oude overblijfselen van de stad.",
                            "target_lang_translations": {
                                "de": "Die Archäologen <w>gruben</w> vorsichtig nach alten Überresten der Stadt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verleden tijd meervoud"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Plural Präteritum von 'graven' (graben)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gruben",
                                "target_lang_sense_clarification": "Präteritum Plural von graben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd27198b-3fb7-3e38-ad4f-b00676cc50db",
                    "sense_definition": "een groef of inkeping maken in een oppervlak of voorwerp",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "groeven_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De timmerman moet de houten planken eerst nauwkeurig <w>groeven</w> voordat hij ze in elkaar kan zetten.",
                            "target_lang_translations": {
                                "de": "Der Tischler muss die Holzbretter zuerst genau <w>nuten</w>, bevor er sie zusammenbauen kann."
                            }
                        },
                        {
                            "text": "De diepe rimpels leken het gezicht van de oude man te <w>groeven</w>.",
                            "target_lang_translations": {
                                "de": "Die tiefen Falten schienen das Gesicht des alten Mannes zu <w>furchen</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "eine Rille, Fuge oder Furche in eine Oberfläche ritzen oder schneiden"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "nuten",
                                "target_lang_sense_clarification": "in der Holz- oder Metallverarbeitung"
                            },
                            {
                                "target_lang_word": "furchen",
                                "target_lang_sense_clarification": "z. B. das Gesicht oder den Boden"
                            },
                            {
                                "target_lang_word": "einkerben",
                                "target_lang_sense_clarification": "Einkerbungen machen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "97fad4cb-ea88-3602-b17f-a5b9003ebd45",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>groef</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "groef_mv",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude grammofoonplaat had diepe <w>groeven</w> waardoor de naald steeds oversprong.",
                            "target_lang_translations": {
                                "de": "Die alte Schallplatte hatte tiefe <w>Rillen</w>, wodurch die Nadel ständig sprang."
                            }
                        },
                        {
                            "text": "De banden van de auto moeten voldoende diepe <w>groeven</w> hebben voor grip op de weg.",
                            "target_lang_translations": {
                                "de": "Die Autoreifen müssen ausreichend tiefe <w>Rillen</w> für Bodenhaftung auf der Straße haben."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "meervoud"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Plural des Substantivs 'groef' (Rille, Furche, Nut)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Rillen",
                                "target_lang_sense_clarification": "feine Vertiefungen, z. B. bei Schallplatten"
                            },
                            {
                                "target_lang_word": "Furchen",
                                "target_lang_sense_clarification": "tiefere Linien oder Falten"
                            },
                            {
                                "target_lang_word": "Nuten",
                                "target_lang_sense_clarification": "längliche Vertiefungen im Handwerk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97e2fa72-2174-3ec7-90d8-f72c9fcb9b90",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>groeve</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "groeve_mv",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het zuiden van het land bezochten we oude ondergrondse <w>groeven</w>.",
                            "target_lang_translations": {
                                "de": "Im Süden des Landes besuchten wir alte unterirdische <w>Gruben</w>."
                            }
                        },
                        {
                            "text": "Er werd eeuwenlang kalksteen gewonnen in de verschillende <w>groeven</w> rondom het dorp.",
                            "target_lang_translations": {
                                "de": "In den verschiedenen <w>Steinbrüchen</w> rund um das Dorf wurde jahrhundertelang Kalkstein abgebaut."
                            }
                        }
                    ],
                    "synonyms": [
                        "groeves"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "meervoud"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Plural des Substantivs 'groeve' (Steinbruch, Grube)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Steinbrüche",
                                "target_lang_sense_clarification": "Orte zum Abbau von Stein"
                            },
                            {
                                "target_lang_word": "Gruben",
                                "target_lang_sense_clarification": "Abbaustellen von Bodenschätzen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}