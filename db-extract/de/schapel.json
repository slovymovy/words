                "senses": [
                    {
                        "sense_id": "7e3059a5-b2ee-358d-82b5-d37db29e89fc",
                        "entry_id": "25358e2f-6eff-3629-ad48-795eb23ace4a",
                        "glosses": [
                            "im 12. Jahrhundert aufgekommener reifenförmiger Kopfschmuck für Männer und Frauen aus Metall oder Blumen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18775459-42c6-4964-b560-f79fb3f46ef1",
                                "sense_id": "7e3059a5-b2ee-358d-82b5-d37db29e89fc",
                                "text": "So kommt sie im 12. Jahrhundert mit dem altfranzösischen Namen als schapel, schappel, tschapelfoi nach Deutschland, in kostbarer wie in schlichterer Gestalt; und nicht nur selbständig tritt der Schapel auf, sondern auch im Verein mit anderer Kopfbedeckung."
                            },
                            {
                                "example_id": "94a740a9-e298-4ff9-a5e5-94705c6b2361",
                                "sense_id": "7e3059a5-b2ee-358d-82b5-d37db29e89fc",
                                "text": "Ein strikter grundsätzlicher Unterschied ist überhaupt zwischen Hut und Schapel nicht, es lassen sich Übergänge zwischen beiden erkennen."
                            },
                            {
                                "example_id": "89bff876-f4fd-4a87-a54a-48e1bb61a5bf",
                                "sense_id": "7e3059a5-b2ee-358d-82b5-d37db29e89fc",
                                "text": "Das kostbarste Schapel wohl, welches sich am meisten der Krone nähert, ist dasjenige, welches nach der eben angeführten Stelle Schionatulauder als Geschenk Sigunens auf seinen Helm befestigt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c07de714-642f-4fca-a8d6-d4480646ab88",
                        "source_entry_id": "25358e2f-6eff-3629-ad48-795eb23ace4a",
