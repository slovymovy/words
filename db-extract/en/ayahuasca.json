    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3b3f7ac6-3369-3bb3-94fe-7cd152806fde",
                "word": "ayahuasca",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4ae14eab-3eee-4b4d-9d96-7f06d642f3df",
                        "entry_id": "3b3f7ac6-3369-3bb3-94fe-7cd152806fde",
                        "tags": [
                            "plural"
                        ],
                        "form": "ayahuascas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "021a504c-573c-3ae7-83de-e7244b9439cf",
                        "entry_id": "3b3f7ac6-3369-3bb3-94fe-7cd152806fde",
                        "glosses": [
                            "A giant vine native to South America (especially Banisteriopsis caapi), noted for its psychotropic properties."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c3e4daee-cc3b-3902-9aad-1a383f172094",
                        "entry_id": "3b3f7ac6-3369-3bb3-94fe-7cd152806fde",
                        "glosses": [
                            "Any of various psychoactive infusions or decoctions prepared from this vine."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "fec3f383-3306-406c-aeb3-c4596f248faa",
                                "sense_id": "c3e4daee-cc3b-3902-9aad-1a383f172094",
                                "text": "They make use of a narcotic drink called Ayahuasca, which produces effects similar to those of opium."
                            },
                            {
                                "example_id": "3e17a871-69e4-4f50-9468-4648b729b632",
                                "sense_id": "c3e4daee-cc3b-3902-9aad-1a383f172094",
                                "text": "As the Amazon forest people would take ayahuasca and enter into that place of Group Mind where they would make decisions for the tribe, the psychedelic shamanic acts that McKenna was promulgating would involve the experience of ecstasy and the contemplation of wholeness."
                            },
                            {
                                "example_id": "88579440-4f97-49a4-91a8-acb3eaf034be",
                                "sense_id": "c3e4daee-cc3b-3902-9aad-1a383f172094",
                                "text": "Like many young women in that cultural era, she was excited to explain ayahuasca, and informed me that her appointment was scheduled for next week, when she would be leaving New York to visit family in Rio."
                            },
                            {
                                "example_id": "af6a06d5-ced5-4abd-bd25-cfa5fdc0fe88",
                                "sense_id": "c3e4daee-cc3b-3902-9aad-1a383f172094",
                                "text": "Police in eastern Spain have arrested three people and seized 11 litres of ayahuasca, 117 San Pedro cactus plants and several bottles of toad poison after raiding two rural properties that were used to host lucrative spiritual retreats promising “astral journeys”."
                            }
                        ]
                    }
                ],
