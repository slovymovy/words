                        "entry_id": "2e68cd98-da45-305c-ae73-371ceafecbdb",
                        "glosses": [
                            "Initialism of Food and Drug Administration, a United States federal regulatory body."
                        ],
                        "tags": [
                            "US",
                            "abbreviation",
                            "alt-of",
