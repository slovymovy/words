                    "sense_id": "69b7a996-c1a8-301a-b3f9-3557a2b7b85e",
                    "sense_definition": "A female given name from Ancient Greek, the Spanish and Italian form of <w>Theresa</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My husband always calls me by my full name, <w>Teresa</w>, instead of a nickname.",
                            "target_lang_translations": {
                                "ru": "Мой муж всегда называет меня полным именем, <w>Тереза</w>, а не прозвищем.",
                                "zh": "我丈夫总是叫我的全名<w>特蕾莎</w>，而不是叫我的昵称。"
                            }
                        },
                        {
                            "text": "Many people around the world admire the charitable work of Mother <w>Teresa</w>.",
                            "target_lang_translations": {
                                "ru": "Многие люди во всем мире восхищаются благотворительной деятельностью Матери <w>Терезы</w>.",
                                "zh": "全世界有许多人都十分敬佩<w>德兰</w>修女的慈善工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Theresa"
                    ],
                    "common_phrases": [
                        "Mother Teresa"
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя древнегреческого происхождения, испанский и итальянский вариант имени Тереза.",
                        "zh": "源自古希腊语的女性教名，为Theresa的西班牙语和意大利语形式（常译为特蕾莎或德兰）。"
                    },
                    "translations": {
