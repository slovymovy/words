                    }
                ],
                "senses": [
                    {
                        "sense_id": "e41da15d-7082-3109-827d-65ecd0ec0a34",
                        "entry_id": "a0603b62-6681-3f6c-bc0c-952d13f94dac",
                        "glosses": [
                            "входящий в коллекцию, пригодный для коллекции, либо имеющий к коллекции иное непосредственное отношение. Автомобиль приобретался, эксплуатировался и хранился, как коллекционный."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02e0ed5a-0833-4c68-815d-3b1837a6d784",
                        "source_entry_id": "a0603b62-6681-3f6c-bc0c-952d13f94dac",
                        "source_sense_id": "e41da15d-7082-3109-827d-65ecd0ec0a34",
                        "target_lang_word": "collection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "collection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ba8fd29-9d45-3eda-8b48-5d4972b39e5f",
                                        "entry_id": "01657fee-51e4-3863-b8f5-11aeaca27ce6",
                                        "glosses": [
                                            "A set of items or amount of material procured, gathered or presented together."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "930830be-7592-4b27-ad7c-83b711501bf7",
                                                "sense_id": "6ba8fd29-9d45-3eda-8b48-5d4972b39e5f",
                                                "text": "The attic contains a remarkable collection of antiques, oddities, and random junk."
                                            },
                                            {
                                                "example_id": "fdf0842c-04e9-46f4-936f-22a905183fa5",
                                                "sense_id": "6ba8fd29-9d45-3eda-8b48-5d4972b39e5f",
                                                "text": "The asteroid belt consists of a collection of dust, rubble, and minor planets."
                                            },
                                            {
                                                "example_id": "ee03fd50-3c02-456f-896a-f006272e0aae",
                                                "sense_id": "6ba8fd29-9d45-3eda-8b48-5d4972b39e5f",
                                                "text": "This year's Summer Collection will include a wide range of evening wear."
                                            },
                                            {
                                                "example_id": "c118d158-7d3e-462d-9e9a-1596d4607645",
                                                "sense_id": "6ba8fd29-9d45-3eda-8b48-5d4972b39e5f",
                                                "text": "He has a big collection of stamps."
                                            },
                                            {
                                                "example_id": "21bb0f60-a99e-4a83-b2b4-cb1a10940303",
                                                "sense_id": "6ba8fd29-9d45-3eda-8b48-5d4972b39e5f",
                                                "text": "He has a superb coin collection."
                                            },
                                            {
                                                "example_id": "e783e06c-ccdd-4bdb-8d85-1d72dfcc2490",
                                                "sense_id": "6ba8fd29-9d45-3eda-8b48-5d4972b39e5f",
                                                "text": "Secondly, I continue to base my concepts on intensive study of a limited suite of collections, rather than superficial study of every packet that comes to hand."
                                            },
                                            {
                                                "example_id": "cdc2ce49-0b3c-4827-b2b3-57dfe3381b28",
                                                "sense_id": "6ba8fd29-9d45-3eda-8b48-5d4972b39e5f",
                                                "text": "collections of moisture"
                                            },
                                            {
                                                "example_id": "da8c0e21-3a20-4c1d-b8a4-242c4a72d82b",
                                                "sense_id": "6ba8fd29-9d45-3eda-8b48-5d4972b39e5f",
                                                "text": "a purulent collection"
                                            },
                                            {
                                                "example_id": "97457347-f340-4a16-8a03-438c6ad7770d",
                                                "sense_id": "6ba8fd29-9d45-3eda-8b48-5d4972b39e5f",
                                                "text": "Of all the queer collections of humans outside of a crazy asylum, it seemed to me this sanitarium was the cup winner. […] When you're well enough off so's you don't have to fret about anything but your heft or your diseases you begin to get queer, I suppose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be280f98-4598-3b11-98b6-497c0a6e1297",
                                        "entry_id": "01657fee-51e4-3863-b8f5-11aeaca27ce6",
                                        "glosses": [
                                            "A set of pitch classes used by a composer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96996b87-4b35-4748-8477-6ca8dd05aaa9",
                                                "sense_id": "be280f98-4598-3b11-98b6-497c0a6e1297",
                                                "text": "The \"collectional information\" one receives is ambiguous since the collection { C, E, F, G, A } occurs in the key of C and in the key of F."
                                            },
                                            {
                                                "example_id": "7e6534e8-c95c-468f-ab39-c630e20224d0",
                                                "sense_id": "be280f98-4598-3b11-98b6-497c0a6e1297",
                                                "text": "In fact, students are often taught that specific collections—diatonic, octatonic, and whole-tone, etc.—typify these composers' compositional language."
                                            },
                                            {
                                                "example_id": "ace9cd0b-9241-4396-872a-df9435e97f07",
                                                "sense_id": "be280f98-4598-3b11-98b6-497c0a6e1297",
                                                "text": "Simply put, the realm of available collections in a largely diatonic environment is much smaller than it is in truly atonal one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56b3902c-83c3-32d5-9d11-4c2c44470467",
                                        "entry_id": "01657fee-51e4-3863-b8f5-11aeaca27ce6",
                                        "glosses": [
                                            "The activity of collecting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ecc03cd-2573-43d5-a7de-84cd65911173",
                                                "sense_id": "56b3902c-83c3-32d5-9d11-4c2c44470467",
                                                "text": "Collection of trash will occur every Thursday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff8f79ef-2c90-329f-a05d-b0d51467bd16",
                                        "entry_id": "01657fee-51e4-3863-b8f5-11aeaca27ce6",
                                        "glosses": [
                                            "A set of sets; used because such a thing is in general too large to comply with the formal definition of a set."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af838664-db9b-3426-bcd9-84337a178840",
                                        "entry_id": "01657fee-51e4-3863-b8f5-11aeaca27ce6",
                                        "glosses": [
                                            "A gathering of money for charitable or other purposes, as by passing a contribution box for donations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "014eadae-6eed-4c43-aea3-70ede63fbc02",
                                                "sense_id": "af838664-db9b-3426-bcd9-84337a178840",
                                                "text": "The people here are very good to each other, too. When someone's house burned down, when someone was in the hospital, they took up collections for the people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78b4f17e-d057-32c0-b72c-ca886dbda4a1",
                                        "entry_id": "01657fee-51e4-3863-b8f5-11aeaca27ce6",
                                        "glosses": [
                                            "Debt collection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "abb35057-06c6-3395-8b16-5f23639cc214",
                                        "entry_id": "01657fee-51e4-3863-b8f5-11aeaca27ce6",
                                        "glosses": [
                                            "The act of inferring or concluding from premises or observed facts; also, that which is inferred."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1801ed7d-0e6e-415b-b821-8991af9d2cf0",
                                                "sense_id": "abb35057-06c6-3395-8b16-5f23639cc214",
                                                "text": "We may safely say thus, that wrong collections have been hitherto made out of those words by modern divines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0344b116-9904-3b86-b248-4fc38edbaa2c",
                                        "entry_id": "01657fee-51e4-3863-b8f5-11aeaca27ce6",
                                        "glosses": [
                                            "The jurisdiction of a collector of excise."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "434ac9d0-6087-3e05-8968-3a06a8594150",
                                        "entry_id": "01657fee-51e4-3863-b8f5-11aeaca27ce6",
                                        "glosses": [
                                            "A set of college exams generally taken at the start of the term."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural-normally",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e7d7ca9-3eee-3ce0-9641-1886b7d83806",
                                        "entry_id": "01657fee-51e4-3863-b8f5-11aeaca27ce6",
                                        "glosses": [
                                            "The quality of being collected; calm composure."
                                        ],
                                        "tags": [
                                            "countable",
