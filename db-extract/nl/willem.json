                        "examples": [
                            {
                                "example_id": "ceb6aaf5-e8b0-4c31-9f7a-5713cc172252",
                                "sense_id": "512843a1-75e3-3848-bac5-d04ee9d6d486",
                                "text": "Willem ging meestal met de motor naar zijn werk."
                            },
                            {
                                "example_id": "781ce908-2277-4223-9960-96828d736d65",
                                "sense_id": "512843a1-75e3-3848-bac5-d04ee9d6d486",
                                "text": "Er stond steevast een stapel dozen: Willem II, Karel I, Washington, Ritmeester, Hofnar, Velasquez, Agio."
                            },
                            {
                                "example_id": "cf4fc816-eeb9-452f-a269-ca6cd75dc2fd",
                                "sense_id": "512843a1-75e3-3848-bac5-d04ee9d6d486",
                                "text": "Die nadruk op fysieke ontwikkeling blijft een constante: of we nu de levensbeschrijving lezen van een twaalfde-eeuwse ridder als Willem de Maarschalk of de veertiende-eeuwse Jean le Meingre of Boucicaut, hun jonge jaren waren gevuld met een zwaar fysiek programma."
                            }
                        ]
                    },
                    {
                        "sense_id": "f93047c8-bbb2-3fe5-b2e0-7b0df2943d6c",
