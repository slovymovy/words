                "senses": [
                    {
                        "sense_id": "f68aa34f-ce35-3721-afcb-ecdcb403a281",
                        "entry_id": "1a5a230b-dfda-3625-b742-3b9facc5fe57",
                        "glosses": [
                            "fächerübergreifendes komplexes Lernvorhaben im Spielbereich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69db9847-2fb1-4a10-b72e-78211f42399d",
                                "sense_id": "f68aa34f-ce35-3721-afcb-ecdcb403a281",
                                "text": "„Bei den spielzentrierten, situationsbezogenen Arbeitsmethoden […] sollen aus Spielinitiativen der Kinder heraus umfassende Spielprojekte entstehen, die auch die Aufteilung des Kindergartenhalbtags in Freispiel und strukturiertes Lernangebot überwinden können.“"
                            },
                            {
                                "example_id": "64da1667-c817-4974-919d-52e71630880e",
                                "sense_id": "f68aa34f-ce35-3721-afcb-ecdcb403a281",
                                "text": "„Der Verein ‚Spiel des Jahres’ nimmt bis zum 30. November 2015 Anträge zur Förderung von Spielprojekten in Ganztagsschulen entgegen.“"
                            },
                            {
                                "example_id": "50de20ed-924f-45ab-8fc1-7465869da698",
                                "sense_id": "f68aa34f-ce35-3721-afcb-ecdcb403a281",
                                "text": "„Die Abenteuer des Odysseus werden in mehreren Spielstunden durchgespielt (Spielprojekt).“"
                            },
                            {
                                "example_id": "beb8c09a-a03b-47af-adbd-ea4ab7bd35b5",
                                "sense_id": "f68aa34f-ce35-3721-afcb-ecdcb403a281",
                                "text": "„Als sie nach einigen Besuchen beim Arbeitsamt das Gefühl hatte, daß sie da in irgendeiner Kartei verschwinde und es ganz hoffnungslos ist, jemals ein Angebot zu bekommen, suchte sie sich einen Job als Erziehungsbeistand, arbeitete für wenig Geld als Kinderbetreuerin bei einem Spielprojekt.“"
                            },
                            {
                                "example_id": "668444e4-3196-4e2d-93c9-3c3720f7358a",
                                "sense_id": "f68aa34f-ce35-3721-afcb-ecdcb403a281",
                                "text": "„Es gibt viele Spielprojekte, zum Beispiel für Handpuppen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
