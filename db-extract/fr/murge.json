                        ],
                        "examples": [
                            {
                                "example_id": "7663475e-911e-45cd-80c7-d18448509bfc",
                                "sense_id": "0fc55321-9292-3d76-8798-1a88e3531c30",
                                "text": "Je me suis pris une sacrée murge, samedi dernier, je te dis pas!",
                                "translation": "Ik heb me zwaar bezat, afgelopen zaterdag, ik zeg het je!"
                            },
                            {
                                "example_id": "1a59287c-f6da-47e7-be81-4f0540944797",
                                "sense_id": "0fc55321-9292-3d76-8798-1a88e3531c30",
                                "text": "Le vendredi soir, on se tape une murge pour commencer le week-end en beauté.",
                                "translation": "Vrijdagavond gaan we ons flink bezatten om het weekend in schoonheid te beginnen."
                            }
                        ]
                    }
                ],
