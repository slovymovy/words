                ],
                "senses": [
                    {
                        "sense_id": "eace7163-7e1b-3289-9aeb-fca81c58c38e",
                        "entry_id": "b04a89fa-dbb3-39bb-bd45-22a3d068096b",
                        "glosses": [
                            "A pale yellow oily liquid, containing phenols and similar compounds, obtained by the destructive distillation of wood tar, once used medicinally."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f35a8058-00b4-317c-ba96-f53dad11ddd1",
                        "entry_id": "b04a89fa-dbb3-39bb-bd45-22a3d068096b",
                        "glosses": [
                            "A similar brown liquid obtained from coal tar used as a wood preservative."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3e6d31dd-432e-3869-9e0a-838388ab1ced",
                        "entry_id": "b04a89fa-dbb3-39bb-bd45-22a3d068096b",
                        "glosses": [
                            "The creosote bush."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "70cdade8-22cc-43fb-baad-8a268f956110",
                                "sense_id": "3e6d31dd-432e-3869-9e0a-838388ab1ced",
                                "text": "On Shaw Butte, as elsewhere in the Phoenix area, creosotes are abundant, producing a plethora of small yellow flowers in late March and April."
                            }
                        ]
                    },
                    {
                        "sense_id": "a46ece71-8918-3b72-b77a-5c5bd39f2d63",
                        "entry_id": "b04a89fa-dbb3-39bb-bd45-22a3d068096b",
                        "glosses": [
                            "A flammable black porous brittle glassy byproduct of wood burning, typically formed inside chimneys."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8381a16-4568-4b14-9c21-b55951cb2213",
                        "source_entry_id": "b04a89fa-dbb3-39bb-bd45-22a3d068096b",
                        "source_sense_description": "liquid obtained from wood or tar",
                        "target_lang_word": "créosote",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "créosote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c999d458-444a-334e-a094-8151670e30dc",
                                        "entry_id": "93caf448-98c7-3bc2-b8eb-56465eed5315",
                                        "glosses": [
                                            "Mélange complexe de substances phénolées, de crésol, de gaïcaol, etc., de saveur caustique produit par la distillation du bois ou de la houille. Il s’agit d’un produit toxique et cancérigène dont l'usage est remplacé par le targobois®."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02f5f11e-52f2-4931-aba5-8c6063724253",
                                                "sense_id": "c999d458-444a-334e-a094-8151670e30dc",
                                                "text": "Quelquefois on remplace le sulfate de cuivre par la créosote, huile très-caustique que l’on obtient par la distillation du goudron de houille."
                                            },
                                            {
                                                "example_id": "a47d9aad-f8a4-48b3-8f33-bca9089da9a8",
                                                "sense_id": "c999d458-444a-334e-a094-8151670e30dc",
                                                "text": "Aux quais, on respire, mais l’haleine de mai fleure ici le bitume et la créosote, hélas !"
                                            },
                                            {
                                                "example_id": "8d360755-8f80-4f1f-af42-c7a80a8695ff",
                                                "sense_id": "c999d458-444a-334e-a094-8151670e30dc",
                                                "text": "Il était certain que Galswinthe allait mieux. L’odeur sinistre de la créosote avait à peu près disparu de sa chambre. Le docteur Barradère, à partir de juin, ne vint plus qu’une fois par semaine à la Pelouse."
                                            },
                                            {
                                                "example_id": "f8bd96f9-988c-4131-88a3-f7bcef225bd7",
                                                "sense_id": "c999d458-444a-334e-a094-8151670e30dc",
                                                "text": "Un goût infect dans la bouche. À quoi bon ce supplice supplémentaire ? N’ai jamais rien espéré de cette potion à la créosote, qui rappelle le dentiste, qui m’enlève tout désir de manger."
                                            },
                                            {
                                                "example_id": "747c50da-4b32-4cd1-98a7-582155623511",
                                                "sense_id": "c999d458-444a-334e-a094-8151670e30dc",
                                                "text": "Pour ma part, j’adorais décoller sur les poteaux des gouttes solidifiées de créosote à la consistance de réglisse, dure & brillante, voire un peu molle si la goutte était épaisse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "feaebf3d-5eef-30f4-8118-3deb1e604452",
                                        "entry_id": "93caf448-98c7-3bc2-b8eb-56465eed5315",
                                        "glosses": [
                                            "Huile de créosote : Produit de la distillation du créosotier (Larrea tridentata)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
