                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d888b228-6a4f-48d1-93d4-65486fa5eefd",
                        "source_entry_id": "5735c4cc-c415-3385-8936-d22d105469e7",
                        "source_sense_id": "b99fda74-6663-3973-b68f-e4ffda310faf",
                        "source_sense_description": "Unterschied zwischen Hoch- und Niedrigwasser bei den Gezeiten",
                        "target_lang_word": "estran",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "estran",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56c5a7b0-61d2-3d8f-b820-ef23e42cb0ed",
                                        "entry_id": "823466d7-cb66-37a0-87c9-185353ac4ec8",
                                        "glosses": [
                                            "Bande de terre qui est couverte à marée haute et découverte par la mer à marée basse ; zone de marnage. Il est divisé entre slikke et schorre."
                                        ],
                                        "tags": [
                                            "Hydrobiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e586157-2ed5-4237-b65e-66657d20047b",
                                                "sense_id": "56c5a7b0-61d2-3d8f-b820-ef23e42cb0ed",
                                                "text": "Le bécasseau variable picore son estran au gré des marées, tel un Sisyphe des sables."
                                            },
                                            {
                                                "example_id": "cc357990-5248-4a92-afc6-e8793f5fc2d0",
                                                "sense_id": "56c5a7b0-61d2-3d8f-b820-ef23e42cb0ed",
                                                "text": "Les mangroves sont des écosystèmes forestiers couvrant près des trois quarts des côtes tropicales, où leur capacité à s’adapter leur permet de prospérer dans des estrans soumis aux variations des courants marins, des flux sédimentaires et de la salinité."
                                            },
                                            {
                                                "example_id": "3f9bf488-aeb7-4916-9810-7279ae6e6e6c",
                                                "sense_id": "56c5a7b0-61d2-3d8f-b820-ef23e42cb0ed",
                                                "text": "Mais la mer n’est pas un non-lieu, pas plus qu’elle est un espace indéterminé, une continuité fluide – c’est une chose que tu devrais savoir non ? aurait dit mon père, moqueur ou agacé - : en elle coexistent des zones diverses, de l’estran familier au gouffre de l’inconnu – grève, bande des rouleaux, mer côtière, mer libre et grand large -, en elle cohabitent différents espaces régis par le droit maritime – mer territoriale, zone contiguë, zone économique exclusive, plateaux continentaux, haute mer."
                                            },
                                            {
                                                "example_id": "60a7ef76-4943-42c3-ab21-765e67bb2469",
                                                "sense_id": "56c5a7b0-61d2-3d8f-b820-ef23e42cb0ed",
                                                "text": "Elle regarde les vagues et l’écume molle et irisée qui s’abat sur l’estran."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a97bef1-603a-3a72-9549-ef447873d71c",
                                        "entry_id": "823466d7-cb66-37a0-87c9-185353ac4ec8",
                                        "glosses": [
                                            "Différence entre le plus haut et le plus bas niveau de la mer visible en fonction de la marée en un point précis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c52615e-964f-4f99-9855-d26db6155293",
                                                "sense_id": "5a97bef1-603a-3a72-9549-ef447873d71c",
                                                "text": "Dans l’Aven, l’estran est de six mètres."
                                            },
                                            {
                                                "example_id": "3902c19e-2e9a-49a3-9b11-34c141a3e03b",
                                                "sense_id": "5a97bef1-603a-3a72-9549-ef447873d71c",
                                                "text": "L'immensité de l'estran désert, l'élasticité ferme des sables ourlés d'écume, les cris des mouettes dans le vent, les grosses méduses échouées sur lesquelles nous sautions à pieds joints, tout était nôtre, et la liberté même."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9fb1dc9-56c6-3265-ad3a-d4934f53899c",
                                        "entry_id": "823466d7-cb66-37a0-87c9-185353ac4ec8",
                                        "glosses": [
                                            "Partie de la surface terrestre alternativement immergée ou émergée par suite de la marée astronomique, limitée par les plus grandes hautes mers et les plus grandes basses mers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8976b937-d978-4e17-9318-a19f6d32554a",
                        "source_entry_id": "5735c4cc-c415-3385-8936-d22d105469e7",
                        "source_sense_id": "b99fda74-6663-3973-b68f-e4ffda310faf",
                        "source_sense_description": "Unterschied zwischen Hoch- und Niedrigwasser bei den Gezeiten",
                        "target_lang_word": "marnage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marnage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22c47817-d908-3bd1-894a-ee66e7569a63",
                                        "entry_id": "ee20fa1e-3fff-3a11-9ae6-50cc3060a286",
                                        "glosses": [
                                            "Opération qui consiste à mêler à la terre arable une certaine quantité de marne pour amender le sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f46c06a-4968-4e4d-8805-c88b8e4bdfaf",
                                                "sense_id": "22c47817-d908-3bd1-894a-ee66e7569a63",
                                                "text": "Plusieurs auteurs ont attaché une importance exclusive au point de vue du marnage à la composition physique des calcaires, c'est-à dire à la proportion relative de la partie délitable et de la partie non délitable dans l'eau."
                                            },
                                            {
                                                "example_id": "fb7e27f2-b2b0-4706-a2d0-5f1ae4cc3878",
                                                "sense_id": "22c47817-d908-3bd1-894a-ee66e7569a63",
                                                "text": "Mais la terre jaunâtre et glaiseuse du Perche, désignée dans le pays sous le nom de gruette ou de bournais, exige périodiquement des marnages, en raison de son acidité."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marnage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca255ea9-aeb1-369d-896b-220f1f27ef97",
                                        "entry_id": "191d7afd-1162-356b-aeec-873c35ad80bf",
                                        "glosses": [
                                            "Amplitude entre la zone de basse marée et de haute marée définissant l’estran."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "723c2d24-ac74-488c-b9ed-33c978d70513",
                                                "sense_id": "ca255ea9-aeb1-369d-896b-220f1f27ef97",
                                                "text": "On distingue ainsi la zone supratidale, cette portion côtière émergée en permanence et sur laquelle sont souvent campées des dunes côtières, la zone mésotidale, qui correspond à la zone de battement des marées ou de marnage, et enfin la zone infratidale localisée en dessous de la marée basse et s’étendant jusqu’à la limite de la zone euphotique, là où il n’y a plus de lumière."
                                            },
                                            {
                                                "example_id": "08ed439f-665a-4227-b2a1-2721f2783cd6",
                                                "sense_id": "ca255ea9-aeb1-369d-896b-220f1f27ef97",
                                                "text": "L’amplitude ou marnage est un caractère essentiel des marées qui varie dans le temps (pendant les mortes-eaux le marnage est plus faible que pendant les vives-eaux) et dans l’espace (côtes microtidales avec un marnage moyen inférieur à 2 m, côtes mésotidales avec un marnage moyen compris entre 2 et 4 m, côtes macrotidales avec un marnage moyen supérieur à 4 m)."
                                            },
                                            {
                                                "example_id": "de952470-f35a-4133-83a1-b1f4b7f74c86",
                                                "sense_id": "ca255ea9-aeb1-369d-896b-220f1f27ef97",
                                                "text": "Elle [la digue] assombrissait les lieux bien qu’une mousse d’algues d’un vert émeraude, quasi fluorescent, recouvrît sa paroi jusqu’à mi-corps, suivant la hauteur de la ligne de marnage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "234a16f5-de58-3619-b566-0602095f5b0b",
                                        "entry_id": "191d7afd-1162-356b-aeec-873c35ad80bf",
                                        "glosses": [
                                            "Différence de hauteur d’eau en un lieu, due à la marée astronomique, entre une pleine mer et une basse mer consécutives."
                                        ],
                                        "tags": [
                                            "Carte marine"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "marnage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59d8e48e-400a-3653-8f5c-b03dd1a783c6",
                                        "entry_id": "f51a6ffd-80bb-3e21-83f5-584164a144ee",
                                        "glosses": [
                                            "Variante de maronage."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "901e627e-8fc6-4d03-966e-31e32a0b7a41",
                                                "sense_id": "59d8e48e-400a-3653-8f5c-b03dd1a783c6",
                                                "text": "Bois de marronage, (on dit aussi bois de marnage), bois à bâtir auxquels les usagers ont droit dans certaines forêts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "072ad55b-63ea-46d8-bb01-de4957e1158d",
                        "source_entry_id": "5735c4cc-c415-3385-8936-d22d105469e7",
                        "source_sense_id": "b99fda74-6663-3973-b68f-e4ffda310faf",
                        "source_sense_description": "Unterschied zwischen Hoch- und Niedrigwasser bei den Gezeiten",
                        "target_lang_word": "getijdenverschil",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "getijdenverschil",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a1eadfdc-89d8-3fa0-87b0-a3634671426b",
                                        "entry_id": "12d671fb-ea8b-3365-aa51-78b35b64e7ca",
                                        "glosses": [
                                            "het verschil in het niveau van het water bij eb en bij vloed"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f309afd7-72b0-4081-b602-37afb05a6e8c",
                                                "sense_id": "a1eadfdc-89d8-3fa0-87b0-a3634671426b",
                                                "text": "50 centimeter getijdenverschil betekent dat er twee keer per dag miljoenen liters door de Brouwersdam moeten gaan stromen."
                                            },
                                            {
                                                "example_id": "37ee8e04-98d7-4c8a-96c1-83931f22775c",
                                                "sense_id": "a1eadfdc-89d8-3fa0-87b0-a3634671426b",
                                                "text": "Daarvoor waarschuwen het Wereld Natuur Fonds, de Vogelbescherming en de Zeeuwse Milieufederatie het kabinet. In de Brouwersdam, die Zeeland en Zuid-Holland met elkaar verbindt, worden buizen geslagen waardoor vers zeewater uit de Noordzee naar binnen stroomt. Dat moet een getijdenverschil van een halve meter gaan opleveren. Vandaag (donderdag) wordt daarover een akkoord gesloten tussen het Rijk en de provincie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
