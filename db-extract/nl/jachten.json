                "senses": [
                    {
                        "sense_id": "f0f93115-73ad-3dd6-8257-dcc263873ed9",
                        "entry_id": "88223cde-86d2-383a-a3c2-d7077e4dae4e",
                        "glosses": [
                            "to be hasty, hurry up"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "316abf12-6eef-443d-aa59-c6b02512ac84",
                                "sense_id": "f0f93115-73ad-3dd6-8257-dcc263873ed9",
                                "text": "Hij jachtte door het station om zijn trein te halen.",
                                "translation": "He hurried through the station to catch his train.",
                                "english": "He hurried through the station to catch his train."
                            },
                            {
                                "example_id": "7dbe50ef-a8ed-474e-bd33-19bc0e1899e6",
                                "sense_id": "f0f93115-73ad-3dd6-8257-dcc263873ed9",
                                "text": "Ze jachtte naar de winkel voordat die sloot.",
                                "translation": "She hastened to the store before it closed.",
                                "english": "She hastened to the store before it closed."
                            },
                            {
                                "example_id": "ed28d12b-4969-4a7a-a833-27b094b09aaa",
                                "sense_id": "f0f93115-73ad-3dd6-8257-dcc263873ed9",
                                "text": "Stop met jachten, we hebben genoeg tijd.",
                                "translation": "Stop hurrying, we have plenty of time.",
                                "english": "Stop hurrying, we have plenty of time."
                            }
                        ]
                    }
