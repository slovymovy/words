                    },
                    {
                        "sense_id": "93ee2828-6eb5-32b4-8d51-19335d14c7d0",
                        "entry_id": "05389263-e626-33c7-bbd6-401c6dc2a61c",
                        "glosses": [
                            "Ort, an dem Dinge ausprobiert/getestet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e489ebc-04e4-48c0-84bc-2b680dc8ab33",
                                "sense_id": "93ee2828-6eb5-32b4-8d51-19335d14c7d0",
                                "text": "„Der weltweit nördlichste Reifenhersteller baute das Testcenter in Ivalo bereits Mitte der 1980er.“"
                            }
                        ],
