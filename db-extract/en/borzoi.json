                        "entry_id": "96823541-e87e-315a-aac3-64889c306ac7",
                        "glosses": [
                            "A dog of a particular breed, similar in shape to a greyhound but with longer silkier hair."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eef1c145-dbba-444b-a521-923a623dc3ca",
                                "sense_id": "489c3acf-b29d-3b14-9e1b-abbd106f4b21",
                                "text": "Pia loves Rob, she had written it with her lipstick on the walls of the vespasienne in the Rue Colombe, waiting for him to finish, holding her pampered borzoi on the leash."
                            }
                        ]
                    }
                ],
