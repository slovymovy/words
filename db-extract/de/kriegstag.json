                "senses": [
                    {
                        "sense_id": "37ee2a51-3429-30bb-b531-fcd91a9b3b61",
                        "entry_id": "40b2be31-8844-3548-84c9-4a68297b5c35",
                        "glosses": [
                            "Tag, an dem Krieg herrscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b6949a9-c34a-4ace-95ba-b62176629dae",
                                "sense_id": "37ee2a51-3429-30bb-b531-fcd91a9b3b61",
                                "text": "„Meine Mutter hat immer gesagt, wenn die Deutschen kommen, werden wir frei. Sie hat es vom ersten Kriegstag an gesagt.“"
                            },
                            {
                                "example_id": "db9ffab0-c4b1-4b6a-b191-c4094be7466a",
                                "sense_id": "37ee2a51-3429-30bb-b531-fcd91a9b3b61",
                                "text": "„Dort hatte die SS in den letzten Kriegstagen tschechische Geiseln erschossen, auch einen Cousin von Josef.“"
                            },
                            {
                                "example_id": "2e060c0b-5686-4585-ab2c-bebb3a56a7d5",
                                "sense_id": "37ee2a51-3429-30bb-b531-fcd91a9b3b61",
                                "text": "„Schließlich zog meine Mutter mit ihrem zweiten Sohn wieder ganz zurück in die Heimat, während mein Vater noch in den letzten Kriegstagen des Jahres 1945 beim Endkampf um Berlin schwer verwundet wurde.“"
                            },
                            {
                                "example_id": "55478d3e-b425-423b-bd6c-93250128af40",
                                "sense_id": "37ee2a51-3429-30bb-b531-fcd91a9b3b61",
                                "text": "„Hier konzentrierte sich 1914 bis 1918 das politische Geschehen, erreichte die Revolution in den letzten Kriegstagen ihren ersten Höhepunkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
