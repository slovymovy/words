                "senses": [
                    {
                        "sense_id": "65e6a092-c3f7-32a7-81ea-cf19d1a79cee",
                        "entry_id": "1fd51f90-7812-3a17-9718-05528f6d12f5",
                        "glosses": [
                            "Of or pertaining to pangamic acid or its derivatives."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5bb331f3-8628-4ea6-8aaf-8bcdb7f08cd1",
                                "sense_id": "65e6a092-c3f7-32a7-81ea-cf19d1a79cee",
                                "text": "Alfalfa tea was added to her fare and it helped further, then rice water because of its pangamic content — all these drinks just warm and never drunk hot, or taken cool if desired and without fail sipped slowly, not gulped down the throat."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed30d554-4237-3248-bf7d-f62a05365a48",
                        "entry_id": "1fd51f90-7812-3a17-9718-05528f6d12f5",
                        "glosses": [
                            "Mating in an indiscriminate or random manner."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e4855add-dac5-47c6-98de-b546ede9ffe0",
                                "sense_id": "ed30d554-4237-3248-bf7d-f62a05365a48",
                                "text": "Yes, there is, in the pangamic system of marriage."
                            },
                            {
                                "example_id": "48da8c8e-957e-43ff-a9d2-259fe4c654e1",
                                "sense_id": "ed30d554-4237-3248-bf7d-f62a05365a48",
                                "text": "[…] which means that in the case of pangamic mating the variability is reduced only about 11 per cent by selecting the entire ancestry."
                            },
                            {
                                "example_id": "aedb9247-b5f9-4fbe-91b1-e917f5cc5f3f",
                                "sense_id": "ed30d554-4237-3248-bf7d-f62a05365a48",
                                "text": "The chances of conjugal union of persons of the same colour class, if the mating occurs at random or is pangamic, are greater than if they lived all together as one group in a densely populated town."
                            },
                            {
                                "example_id": "fdabcaf4-1b8d-4242-94e8-2e85a1be2c5b",
                                "sense_id": "ed30d554-4237-3248-bf7d-f62a05365a48",
                                "text": "The attempt at conscious selection and segregation, especially in the presence of heterogeneous social strata, which intensified the risks of pangamic or indiscriminate mating, need not be condemned off-hand […]"
                            }
                        ]
                    }
                ],
