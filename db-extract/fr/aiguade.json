        "fr-extract.jsonl": [
            {
                "entry_id": "1b40396b-df98-347f-9fce-4e6122b33cd4",
                "word": "aiguade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4649a51a-9263-4699-9547-6026fdc1b94c",
                        "entry_id": "1b40396b-df98-347f-9fce-4e6122b33cd4",
                        "tags": [
                            "plural"
                        ],
                        "form": "aiguades"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a2eb06ff-f3a0-303a-a5bc-179c0a0ff921",
                        "entry_id": "1b40396b-df98-347f-9fce-4e6122b33cd4",
                        "glosses": [
                            "Provision d’eau que l’on va prendre à terre pour les bâtiments, lorsqu’ils en manquent dans le cours de leur voyage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8685b87f-d306-482b-acee-0c89465c807e",
                                "sense_id": "a2eb06ff-f3a0-303a-a5bc-179c0a0ff921",
                                "text": "Ensuite, en allant faire aiguade, les matelots furent attaqués et quatre d’entre eux lardés de flèches."
                            },
                            {
                                "example_id": "0b54da56-52d7-4d21-899d-1a54d554e51d",
                                "sense_id": "a2eb06ff-f3a0-303a-a5bc-179c0a0ff921",
                                "text": "— C’est un lieu où il y a bonne aiguade."
                            },
                            {
                                "example_id": "efa8c288-02c4-4d41-95c5-a09475bd5d0c",
                                "sense_id": "a2eb06ff-f3a0-303a-a5bc-179c0a0ff921",
                                "text": "Ils mouillèrent en face d’une côte au relief marqué où l’on pouvait espérer découvrir des ruisseaux convenables pour l’aiguade."
                            },
                            {
                                "example_id": "6ab2913a-dc6b-4b1a-bbf5-31500c105e18",
                                "sense_id": "a2eb06ff-f3a0-303a-a5bc-179c0a0ff921",
                                "text": "Une petite lumière brille quelquefois dans toute cette intensité de noir, marquant le point où je pourrais toucher terre : — c’est l’aiguade ; des matelots sont là souvent, Anglais ou étrangers, attardés à faire provision d’eau aux lanternes. — J’accoste au milieu d’eux, et mon canot s’en retourne à bord."
                            }
                        ]
                    },
                    {
                        "sense_id": "25108347-96d6-3e9d-a612-b4834535db40",
                        "entry_id": "1b40396b-df98-347f-9fce-4e6122b33cd4",
                        "glosses": [
                            "Endroit où l’on peut faire provision d'eau."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "038f7473-2b33-413e-84a5-18d99815cf6e",
                                "sense_id": "25108347-96d6-3e9d-a612-b4834535db40",
                                "text": "À nous trois, ajouta-t-il, nous serons bien maladroits si nous ne découvrons pas quelque aiguade fraîche et limpide."
                            },
                            {
                                "example_id": "ecdb18eb-4fc0-4a7e-a2b3-e33f00e053de",
                                "sense_id": "25108347-96d6-3e9d-a612-b4834535db40",
                                "text": "Jan-Mayen n'offre aucun abri sûr ni aucune aiguade pratique."
                            }
                        ]
                    }
                ],
