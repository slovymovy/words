                "senses": [
                    {
                        "sense_id": "cce26fc8-bd79-3834-9d0e-f52659128853",
                        "entry_id": "b305b3ce-8468-3824-ac4c-aa02189847fb",
                        "glosses": [
                            "eine bestimmte Art von Hutschmuck mit Rückenhaaren erwachsener Gamsböcke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4a6b3bd-4ed2-47d3-863e-bf47a58cfd30",
                                "sense_id": "cce26fc8-bd79-3834-9d0e-f52659128853",
                                "text": "„Ein Gamsbart ist die Zierde auf dem Hut eines jeden Trachtlers.“"
                            },
                            {
                                "example_id": "23a9692e-4d07-4c91-b52f-fe56d5baed43",
                                "sense_id": "cce26fc8-bd79-3834-9d0e-f52659128853",
                                "text": "Er will ihm nach, aber zwei Autos kommen, er schwenkt die Arme, und als er sich wieder umsieht, ist der Herr mit dem Gamsbart verschwunden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
