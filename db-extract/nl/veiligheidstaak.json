                "senses": [
                    {
                        "sense_id": "cea4619e-e57e-3d0d-962c-793bdb00a470",
                        "entry_id": "9ff1b6ab-128d-3f78-a399-35cdde94e8fd",
                        "glosses": [
                            "opdracht om personen en zaken te beschermen tegen geweld, spionage of andere schadelijke invloeden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c7f1a66-a03f-4d4e-89c0-8e5de2e4f92d",
                                "sense_id": "cea4619e-e57e-3d0d-962c-793bdb00a470",
                                "text": "„Wat betreft de impact van de cao-acties op de veiligheidstaken die aan de politie zijn opgedragen, heeft de korpsleiding een eigen verantwoordelijkheid”, legt een woordvoerder uit. „Die heeft haar ertoe bewogen om wat betreft één cao-actie een kort geding aan te spannen.”"
                            },
                            {
                                "example_id": "319f241f-da75-4aad-b9fd-6e5206a988a1",
                                "sense_id": "cea4619e-e57e-3d0d-962c-793bdb00a470",
                                "text": "Tientallen agenten die in het Amerikaanse Witte Huis een veiligheidstaak hebben, zijn onvoldoende onderzocht door de autoriteiten. Het zijn pas gerekruteerde agenten van de Secret Service die nog geen belangrijke veiligheidstest hebben ondergaan, maar in het Witte Huis wel vergaderingen hebben bijgewoond waar staatsgeheimen werden besproken. Dat hebben twee regeringsbronnen gezegd tegen de krant The Washington Post."
                            },
                            {
                                "example_id": "c198d2f7-a9fa-465c-be8d-41546ed8dd2c",
                                "sense_id": "cea4619e-e57e-3d0d-962c-793bdb00a470",
                                "text": "Die organisatie telt 340.000 medewerkers en legt verantwoording af aan president Poetin. De pas twee jaar geleden opgerichte garde staat los van de strijdkrachten. Ze heeft veel veiligheidstaken die vroeger onder Binnenlandse Zaken vielen."
                            }
                        ]
                    }
