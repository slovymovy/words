                                        "sense_id": "7ab98c05-889d-3beb-bb02-2396bd3b305e",
                                        "entry_id": "3f1e5454-5689-3868-8cd2-46a64149daa3",
                                        "glosses": [
                                            "klasifikační známka, dříve druhá po eminenci"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da119fc0-1d37-469f-8230-21df473f1aa1",
                                                "sense_id": "7ab98c05-889d-3beb-bb02-2396bd3b305e",
                                                "text": "„Vaše komposice zasluhuje eminenc, než dopustil jste se porovnávati nešťastnou vlast svou. Komposice přijde na vrch, direktor ji bude čísti a budete ze škol vyhnán. Dám-li vám prvníčku, přijde vaše vypracování do prostřed a nebude povšimnuto – nyní volte, eminenc aneb prvníčku?“"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fadadbaf-594e-437b-8401-3b32e54aeb70",
                        "source_entry_id": "bd43ba10-2183-3da6-af52-209302eacba8",
                        "source_sense_id": "c8b6dafe-774e-3544-bdad-76919a9ff326",
