                        "sense_id": "639f8f31-5a3c-36a2-86ae-3e1e3f96b1f1",
                        "entry_id": "524a8bae-8cff-3906-902a-e932e16183a0",
                        "glosses": [
                            "Alliage de zinc (7% à 11%) et de cuivre (89% à 93%) imitant l'or."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07538003-c892-4ffb-981e-5a62681f6ff6",
                                "sense_id": "639f8f31-5a3c-36a2-86ae-3e1e3f96b1f1",
                                "text": "Le métal du prince Robert, le pinchbeck , l'or de Manheim, le tombac, le chrysocal et le similor , ne sont que des composés de zinc et de cuivre, dans des proportions particulières, et dont on se sert dans la fabrication de la fausse bijouterie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a3c7c60-c407-4e41-b357-bdd6748b65ef",
                        "source_entry_id": "524a8bae-8cff-3906-902a-e932e16183a0",
                        "source_sense_id": "639f8f31-5a3c-36a2-86ae-3e1e3f96b1f1",
