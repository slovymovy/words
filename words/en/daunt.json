{
    "word_family": [
        "daunting",
        "dauntless",
        "undaunted",
        "dauntingly",
        "dauntlessness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "12ace0fc-3a28-392f-94de-56fc6440d2a8",
                    "sense_definition": "To make someone feel intimidated, apprehensive, or discouraged.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intimidate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheer size of the project did not <w>daunt</w> the ambitious young architect.",
                            "target_lang_translations": {
                                "ru": "Огромный масштаб проекта не <w>устрашил</w> амбициозного молодого архитектора."
                            }
                        },
                        {
                            "text": "She refused to let the <w>daunt</w> of the difficult task stop her from trying.",
                            "target_lang_translations": {
                                "ru": "Она не позволила <w>трудности</w> сложной задачи помешать её попыткам."
                            }
                        }
                    ],
                    "synonyms": [
                        "intimidate",
                        "discourage",
                        "dishearten",
                        "dismay"
                    ],
                    "antonyms": [
                        "encourage",
                        "hearten",
                        "embolden"
                    ],
                    "common_phrases": [
                        "nothing could daunt",
                        "refuse to be daunted"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-либо почувствовать страх, неуверенность или уныние перед лицом трудностей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устрашать",
                                "target_lang_sense_clarification": "внушать страх или опасения"
                            },
                            {
                                "target_lang_word": "пугать",
                                "target_lang_sense_clarification": "вызывать тревогу или нежелание действовать"
                            },
                            {
                                "target_lang_word": "обескураживать",
                                "target_lang_sense_clarification": "лишать уверенности или решимости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56d561e4-e244-3db9-9e85-751163763591",
                    "sense_definition": "To overcome or overwhelm someone's spirit or resolve.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intimidate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complexity of the legal system can easily <w>daunt</w> those without proper representation.",
                            "target_lang_translations": {
                                "ru": "Сложность правовой системы может легко <w>обескуражить</w> тех, у кого нет надлежащего представительства."
                            }
                        },
                        {
                            "text": "He was <w>daunted</w> by the massive amount of work required to finish the book.",
                            "target_lang_translations": {
                                "ru": "Он был <w>подавлен</w> огромным объёмом работы, необходимым для завершения книги."
                            }
                        }
                    ],
                    "synonyms": [
                        "overwhelm",
                        "subdue",
                        "overpower"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подавить чей-либо дух или решимость, сделать задачу кажущейся невыполнимой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устрашить",
                                "target_lang_sense_clarification": "ослабить решимость, вызвав опасения"
                            },
                            {
                                "target_lang_word": "подавлять",
                                "target_lang_sense_clarification": "действовать угнетающе на волю"
                            },
                            {
                                "target_lang_word": "запугивать",
                                "target_lang_sense_clarification": "делать робким перед масштабом задачи"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b261e114-e9b4-3c4a-9d49-debd4f7da5a8",
                    "sense_definition": "A surname originating from Middle English.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local history museum has several records mentioning the <w>Daunt</w> family.",
                            "target_lang_translations": {
                                "ru": "В местном краеведческом музее есть несколько записей, упоминающих семью <w>Донт</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Daunt</w> was known throughout the village for his extensive library.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Донт</w> был известен на всю деревню своей обширной библиотекой."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, происходящая из среднеанглийского языка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Донт",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}