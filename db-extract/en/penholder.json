                    {
                        "translation_id": "201110e0-fca3-4751-ad32-a889c550c27e",
                        "source_entry_id": "f5d09f43-40d8-3a56-8234-59bdec3bc318",
                        "source_sense_id": "d2d31baa-0c0f-3be6-b50a-478e5e2bc3e7",
