                "senses": [
                    {
                        "sense_id": "8c195f00-0499-33a9-8276-e43e687b1f5d",
                        "entry_id": "a128715d-b9c1-38de-af0e-b6f5ae532c36",
                        "glosses": [
                            "geologisch tijdperk met grote verscheidenheid van leven in de zeeën, eerste era van het fanerozoïcum; van ongeveer 541 tot 242 miljoen jaar geleden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9efcfb45-32d1-4393-b4f2-31677488b5b1",
                                "sense_id": "8c195f00-0499-33a9-8276-e43e687b1f5d",
                                "text": "De oudste massieven dateren uit het paleozoïcum (Sudeten), terwijl de hogere Karpaten bestaan uit jongere bergen van het alpiene type uit het tertiair."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb22e43a-4320-4179-b6b7-e39bf09b8279",
                        "source_entry_id": "a128715d-b9c1-38de-af0e-b6f5ae532c36",
                        "source_sense_id": "8c195f00-0499-33a9-8276-e43e687b1f5d",
