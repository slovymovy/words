                        "examples": [
                            {
                                "example_id": "6f9f96c4-3814-438e-8911-79aa3378a7cc",
                                "sense_id": "affb920b-6adc-3b98-94bb-0e2e6fffc0b9",
                                "text": "Het Historisch Centrum Overijssel beschikt over een grote collectie oude filmbeelden. De oudste bekende beelden uit die collectie zijn de beelden uit Enschede. De 35 mm stadsfilm is gemaakt door de Haghe Filmfabriek van Willy Mullens in Den Haag."
