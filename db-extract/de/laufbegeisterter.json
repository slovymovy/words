                "senses": [
                    {
                        "sense_id": "da90f6ac-fec4-33c2-9dbc-292ee2befdc4",
                        "entry_id": "e5a6c0c2-f122-3df6-a4e9-ea7aa813baef",
                        "glosses": [
                            "Person, die eine Leidenschaft für das Laufen/Joggen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf7980a1-7f46-492f-a34f-19d50d234604",
                                "sense_id": "da90f6ac-fec4-33c2-9dbc-292ee2befdc4",
                                "text": "„Ein Beispiel ist ein Programm, das Laufbegeisterten – auf einem Laufband mit Sicherung – erlaubt, ihre Joggingrunde in einer variablen virtuellen Umgebung zu absolvieren.“"
                            },
                            {
                                "example_id": "4043deb0-45c2-4e22-9673-7a023d0d2772",
                                "sense_id": "da90f6ac-fec4-33c2-9dbc-292ee2befdc4",
                                "text": "„Gerade in der ansonsten laufarmen Jahreszeit ist dieses Event mit dem Sechs- und Zehn-Kilometer-Lauf eine willkommene Abwechslung für die Laufbegeisterten.“"
                            },
                            {
                                "example_id": "1e8178d9-1c16-4f3b-84d1-2c4276d0d6c7",
                                "sense_id": "da90f6ac-fec4-33c2-9dbc-292ee2befdc4",
                                "text": "„Bis zum 4. Dezember können sich alle Laufbegeisterten online für den Adventslauf anmelden.“"
                            },
                            {
                                "example_id": "cfa1b7bb-8e02-42b9-84d3-16cdec57868a",
                                "sense_id": "da90f6ac-fec4-33c2-9dbc-292ee2befdc4",
                                "text": "„Dieses Geschenk an alle Laufbegeisterten ließe sich, so Vetter, abschließend aber auch nur mit Hilfe der zahlreichen Osterlauf-Sponsoren realisieren.“"
                            },
                            {
                                "example_id": "d73fee75-f05f-4053-90ad-204626045510",
                                "sense_id": "da90f6ac-fec4-33c2-9dbc-292ee2befdc4",
                                "text": "„Wir möchten dadurch allen Laufbegeisterten die Möglichkeit bieten, ihr Training durch wissenschaftlich geschulte Trainer zu verbessern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
