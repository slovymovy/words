                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8321d76-eaac-41fd-93f5-456ef8e5e454",
                                "sense_id": "bb8af7d9-8b67-3ceb-b173-e2695168e581",
                                "text": "„Das von dem US-Amerikaner Samuel Pierpont Langley entwickelte Motorflugzeug \"Aerodrome\" stürzt nach einem missglückten Katapultstart von einem Hausboot in den Potomac-Fluss bei Washington.“"
                            },
                            {
                                "example_id": "a3a5f9e3-6b4a-4035-a4b1-7600aa3a216a",
                                "sense_id": "bb8af7d9-8b67-3ceb-b173-e2695168e581",
                                "text": "„Die US-amerikanische Marine präsentiert Pressevertretern eine neu entwickelte Startmöglichkeit für Militärflugzeuge, den sog. Katapultstart.“"
                            }
                        ],
