                "senses": [
                    {
                        "sense_id": "55ad4999-e3ba-326a-8537-92977703202b",
                        "entry_id": "96634daa-38c9-3389-a60c-56646409f321",
                        "glosses": [
                            "Gehalt (Konzentration) des Stoffes Calcium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a843586d-e3db-4952-a210-4330a6880465",
                                "sense_id": "55ad4999-e3ba-326a-8537-92977703202b",
                                "text": "„Die Regulation der Calciumkonzentration im Blut ist in vielerlei Hinsicht enorm wichtig.“"
                            },
                            {
                                "example_id": "8cf172da-f57b-464a-9450-e7bcba917045",
                                "sense_id": "55ad4999-e3ba-326a-8537-92977703202b",
                                "text": "„Die Calciumkonzentration spielt für viele zelluläre Vorgänge eine bedeutende Rolle.“"
                            },
                            {
                                "example_id": "c56039b9-0fad-4961-b11a-cfd573c900f3",
                                "sense_id": "55ad4999-e3ba-326a-8537-92977703202b",
                                "text": "„Die Calciumkonzentration außerhalb der Zelle ist zu hoch und wirkt sich als Ablagerung auch in Form von Steinen aus, da der Organismus mit einem Zuviel an Calciumionen außerhalb der Zelle überfordert ist.“"
                            },
                            {
                                "example_id": "f8ed3d4c-38e7-42f6-8b43-76401f617d1b",
                                "sense_id": "55ad4999-e3ba-326a-8537-92977703202b",
                                "text": "„Gleichzeitig wird in Phasen anhaltender Muskelanspannung Calcium aus den Körperspeichern freigesetzt – es kommt zu einem Anstieg der intrazellulären Calciumkonzentration um 300 bis 10 000 Prozent.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
