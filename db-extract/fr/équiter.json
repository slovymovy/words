                ],
                "senses": [
                    {
                        "sense_id": "c152002f-5767-33e6-a0b9-0c3e735438db",
                        "entry_id": "d83e91a9-41cf-3fe9-adbb-87edb0b9fd92",
                        "glosses": [
                            "Chevaucher."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5f63d26f-c544-49b3-8456-6088f74a453a",
                                "sense_id": "c152002f-5767-33e6-a0b9-0c3e735438db",
                                "text": "Depuis que nous avons voulu prendre leurs cravates, leurs fracs, nous coiffer comme eux, équiter comme eux, enfin les singer dans toutes leurs manières, nous croyons qu’il n’y a plus rien de bien que ce qu’ils sont."
                            },
                            {
                                "example_id": "b6bd8514-a49d-4c49-9aeb-6289efe73817",
                                "sense_id": "c152002f-5767-33e6-a0b9-0c3e735438db",
                                "text": "Le petit bohème, heureux et fier d’équiter à lui tout seul un si grand dada, avait gentiment persuadé au carrosseux de lui laisser tenir le bridon."
                            },
                            {
                                "example_id": "1a624432-f7f4-4a8e-a086-f2717c105370",
                                "sense_id": "c152002f-5767-33e6-a0b9-0c3e735438db",
                                "text": "J’avoue même que, s’il m’était possible d’équiter comme autrefois, j’aurais toujours comme montures des chevaux de pur sang."
                            }
                        ]
                    }
                ],
