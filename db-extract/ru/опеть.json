                "senses": [
                    {
                        "sense_id": "32d2c35f-005b-37c0-9cca-e301607005f3",
                        "entry_id": "509c3065-8b55-3121-8dca-c60902c8a5aa",
                        "glosses": [
                            "устар. воспеть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fadfee7-bdf7-491f-a0f5-e18c8b679548",
                                "sense_id": "32d2c35f-005b-37c0-9cca-e301607005f3",
                                "text": "Мы решили пробыть тут день до конца и ночь: посмотреть, какова она, куликовская ночь, опетая Блоком."
                            }
                        ]
                    },
                    {
                        "sense_id": "751ad731-9731-3bf3-a4e6-7e658e0089de",
                        "entry_id": "509c3065-8b55-3121-8dca-c60902c8a5aa",
                        "glosses": [
                            "устар. обольстить словами, пением"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ae3be52b-daab-3cef-8865-754a3044ee8f",
                        "entry_id": "509c3065-8b55-3121-8dca-c60902c8a5aa",
                        "glosses": [
                            "диал. пением наводить или изгонять порчу (о птице)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5d972be-dfee-49f9-a5c3-c0407650e612",
                                "sense_id": "ae3be52b-daab-3cef-8865-754a3044ee8f",
                                "text": "И тётушка Анна отрез / Снесла под куриный навес, / Чтоб петел обновку опел, / Где дух некрещёный сидел."
                            },
                            {
                                "example_id": "5e8b6eac-557e-4c43-906c-a948bd265db6",
                                "sense_id": "ae3be52b-daab-3cef-8865-754a3044ee8f",
                                "text": "Утром воду на Великий четверг носили, пока ворона не опела её, не скаркала."
                            }
                        ]
                    }
                ],
