                    {
                        "translation_id": "137b6ead-12e6-4410-996a-18f7a441adfa",
                        "source_entry_id": "65885819-06fd-3636-b3e9-49295d993db7",
                        "source_sense_id": "9ea550f1-1949-352a-9f6d-8d34cc196a12",
                        "source_sense_description": "Schein mit Parkberechtigung",
                        "target_lang_word": "parkeerkaart",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parkeerkaart",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a79c7a9e-b55c-3228-a813-2d886dcb3b94",
                                        "entry_id": "ff18a77f-607e-33a5-a638-985bbf092dd6",
                                        "glosses": [
                                            "kaartje waarmee je, als je de parkeerkosten hebt voldaan, een parkeerplaats kunt verlaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5efd6150-dca6-400a-b7ca-9efd8d9ea086",
                                                "sense_id": "a79c7a9e-b55c-3228-a813-2d886dcb3b94",
                                                "text": "Ze is aan de beurt, duwt haar parkeerkaart in de gleuf en sluit het autoraampje."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bea16b5f-a45c-3d23-a4e4-1a10712b036f",
                                        "entry_id": "ff18a77f-607e-33a5-a638-985bbf092dd6",
                                        "glosses": [
                                            "kaart die aangeeft dat men ergens mag parkeren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7073eb6f-f44e-40f1-9ef9-c6cbf064613a",
                                                "sense_id": "bea16b5f-a45c-3d23-a4e4-1a10712b036f",
                                                "text": "De Rijksdienst voor het Wegverkeer (RDW) begint in de zomer met een experiment om misbruik van invalidenparkeerkaarten tegen te gaan. De kentekens van auto's van gehandicapten worden gekoppeld aan hun parkeerkaarten. Nu bestaat die koppeling nog niet en wordt er in toenemende mate met de kaarten gefraudeerd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b56ea1e-48cb-456d-a920-187987ec8636",
                        "source_entry_id": "65885819-06fd-3636-b3e9-49295d993db7",
