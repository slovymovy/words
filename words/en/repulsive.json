    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "44ab5308-f3bf-3c57-a9d0-889e25351c32",
                    "sense_definition": "Causing strong dislike or disgust.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disgusting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garbage left in the sun had a <w>repulsive</w> smell.",
                            "target_lang_translations": {
                                "zh": "在太阳下暴晒的垃圾散发出一种<w>令人作呕</w>的气味。"
                            }
                        },
                        {
                            "text": "He found the <w>repulsive</w> behavior of the crowd very upsetting.",
                            "target_lang_translations": {
                                "zh": "他觉得人群那种<w>令人作呕</w>的行为非常令人心烦。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disgusting",
                        "vile",
                        "repellent"
                    ],
                    "antonyms": [
                        "attractive"
                    ],
                    "common_phrases": [
                        "repulsive smell",
                        "repulsive behavior"
                    ],
                    "target_lang_definitions": {
                        "zh": "引起强烈反感或厌恶的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "令人作呕",
                                "target_lang_sense_clarification": "形容事物极其令人厌恶"
                            },
                            {
                                "target_lang_word": "讨厌",
                                "target_lang_sense_clarification": "形容令人反感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fa82b7f-2939-3efd-95a5-84fd9b8d57f2",
                    "sense_definition": "Cold, reserved, or unfriendly in manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unfriendly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave him a <w>repulsive</w> look when he tried to start a conversation.",
                            "target_lang_translations": {
                                "zh": "当他试图搭话时，她给了他一个<w>冷漠</w>的眼神。"
                            }
                        },
                        {
                            "text": "His <w>repulsive</w> attitude made it difficult for anyone to approach him.",
                            "target_lang_translations": {
                                "zh": "他那<w>冷漠</w>的态度让别人很难接近他。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "repulsive attitude"
                    ],
                    "target_lang_definitions": {
                        "zh": "态度冷淡、不友好的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "冷漠",
                                "target_lang_sense_clarification": "形容态度冷淡"
                            },
                            {
                                "target_lang_word": "拒人于千里之外",
                                "target_lang_sense_clarification": "形容态度极其不友好"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "431900bf-6fe3-3c63-8b48-3b2b81876313",
                    "sense_definition": "Having the physical power to push away or repel.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two magnets exerted a <w>repulsive</w> force on each other.",
                            "target_lang_translations": {
                                "zh": "两块磁铁之间产生了相互<w>排斥</w>的力。"
                            }
                        },
                        {
                            "text": "Scientists studied the <w>repulsive</w> effect between the charged particles.",
                            "target_lang_translations": {
                                "zh": "科学家们研究了带电粒子之间的<w>排斥</w>效应。"
                            }
                        }
                    ],
                    "antonyms": [
                        "attractive"
                    ],
                    "common_phrases": [
                        "repulsive force"
                    ],
                    "target_lang_definitions": {
                        "zh": "具有排斥力的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "排斥",
                                "target_lang_sense_clarification": "物理学中指相互推开的力"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}