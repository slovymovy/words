                        "translation_id": "dce38ab3-97f0-42c8-8837-5e7ba7157b7c",
                        "source_entry_id": "c2f83871-9464-3b7c-ba6e-67c30eda6aba",
                        "source_sense_id": "006bd092-9544-39b0-829a-b3dc6558beca",
                        "target_lang_word": "antinatalist",
