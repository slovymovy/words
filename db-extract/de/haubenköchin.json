                "senses": [
                    {
                        "sense_id": "2baf372a-92ed-3736-9b10-0d733a62b85b",
                        "entry_id": "ec220473-1d65-396e-9560-131a1a62df54",
                        "glosses": [
                            "Köchin, die mit einer oder mehreren Hauben ausgezeichnet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b94f3bc-c665-4596-b786-0a8bd866efbd",
                                "sense_id": "2baf372a-92ed-3736-9b10-0d733a62b85b",
                                "text": "„Die ORF-Moderatorinnen Vera Russwurm, Barbara Karlich, Elisabeth Engstler, Christa Kummer, die Schauspielerinnen Barbara Wussow, Maria Köstlinger und Proschat Madani, Haubenköchin Elisabeth Wagner-Bacher sowie die medizinische Leiterin des Programms, Dr. Marianne Bernhart tragen ein grünes Band zur Erinnerung für regelmäßiges Screening.“"
                            },
                            {
                                "example_id": "9557a609-c99f-4f85-9b6a-7e391581b00b",
                                "sense_id": "2baf372a-92ed-3736-9b10-0d733a62b85b",
                                "text": "„Ich bin im niederösterreichischen Mautern geboren und ich habe nicht vor, jemals von dort wegzuziehen\", betonte Haubenköchin Lisl Wagner-Bacher, die für Elisabeth Gürtlers Sommerball am 27. Juni ihre \"Heimat\" Niederösterreich verlassen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
