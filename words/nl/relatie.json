                    "sense_id": "62c72c87-c0d5-3e95-a21f-24daace92d58",
                    "sense_definition": "Een persoonlijke en vaak romantische verhouding tussen twee mensen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "persoonlijke verbinding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij hebben al drie jaar een vaste <w>relatie</w>.",
                            "target_lang_translations": {
                                "en": "They have been in a steady <w>relationship</w> for three years already.",
                                "ru": "У них уже три года постоянные <w>отношения</w>."
                            }
                        },
                        {
                            "text": "Na de ruzie besloten ze hun <w>relatie</w> te verbreken.",
                            "target_lang_translations": {
                                "en": "After the argument, they decided to break off their <w>relationship</w>.",
                                "ru": "После ссоры они решили разорвать свои <w>отношения</w>."
                            }
                        }
