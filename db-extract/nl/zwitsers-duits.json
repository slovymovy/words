                                        "sense_id": "21834f29-4fbc-30b9-961e-64f7003a3abc",
                                        "entry_id": "d10257e8-6bff-3e63-9ff2-7a1fe0bec002",
                                        "glosses": [
                                            "The varieties of Alemannic German spoken in Switzerland."
