                "senses": [
                    {
                        "sense_id": "efee0b33-dca6-3c6c-9eab-45a2d4efa049",
                        "entry_id": "3abf2dd5-0f21-37ab-b5dd-8d357381ac6b",
                        "glosses": [
                            "iets waarvan men een groter aantal heeft dan men nodig heeft; te veel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "651dee0f-8708-460c-ba68-caaa3ed1fe5a",
                                "sense_id": "efee0b33-dca6-3c6c-9eab-45a2d4efa049",
                                "text": "Als er niks gebeurt staan de 55 medewerkers van het Defensiecomplex Almelo per 1 januari volgend jaar op straat. Want dan wordt hun eenheid opgeheven. Maar het personeel van de opslag- en werkplaats voor overtallig legermaterieel op het Bedrijvenpark Twente houdt hoop."
                            },
                            {
                                "example_id": "ec8c7f12-8182-4454-8d92-ec35540c5b0c",
                                "sense_id": "efee0b33-dca6-3c6c-9eab-45a2d4efa049",
                                "text": "Op deze grond kunnen de productiemedewerkers worden ontslagen. De werkgever moet wel aantonen dat de robot nodig is voor een doelmatige bedrijfsvoering en dat de arbeidsplaatsen hierdoor vervallen. Ook moet hij aantonen dat hij zijn best heeft gedaan om de zes overtallige productiemedewerkers - eventueel met behulp van scholing - binnen zijn onderneming te herplaatsen."
                            }
                        ]
                    }
