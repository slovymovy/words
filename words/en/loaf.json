{
    "word_family": [
        "loafer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eca4dc2f-bc7a-3390-bf27-08675b8ebc5c",
                    "sense_definition": "A shaped block of bread produced by baking.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "food_block",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a fresh <w>loaf</w> of bread at the bakery this morning.",
                            "target_lang_translations": {
                                "it": "Questa mattina ha comprato una <w>pagnotta</w> fresca al panificio."
                            }
                        },
                        {
                            "text": "Please slice the <w>loaf</w> so we can make sandwiches for lunch.",
                            "target_lang_translations": {
                                "it": "Per favore, affetta la <w>pagnotta</w> così possiamo preparare i panini per pranzo."
                            }
                        }
                    ],
                    "common_phrases": [
                        "loaf of bread"
                    ],
                    "target_lang_definitions": {
                        "it": "Un blocco di pane dalla forma definita prodotto tramite cottura al forno."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "pagnotta",
                                "target_lang_sense_clarification": "Pane di forma rotonda o irregolare."
                            },
                            {
                                "target_lang_word": "pane in cassetta",
                                "target_lang_sense_clarification": "Pane cotto in uno stampo rettangolare, spesso usato per i sandwich."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "310c8007-f929-35a4-8568-d3f59b7764b9",
                    "sense_definition": "A solid, shaped block of food, such as meat or sugar.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food_block",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef prepared a delicious meat <w>loaf</w> for the dinner party.",
                            "target_lang_translations": {
                                "it": "Lo chef ha preparato un delizioso polpettone per la cena."
                            }
                        },
                        {
                            "text": "The old recipe required a solid <w>loaf</w> of sugar to be crushed.",
                            "target_lang_translations": {
                                "it": "La vecchia ricetta richiedeva di frantumare un <w>panetto</w> di zucchero solido."
                            }
                        }
                    ],
                    "common_phrases": [
                        "meat loaf"
                    ],
                    "target_lang_definitions": {
                        "it": "Un blocco solido e sagomato di cibo, come carne o zucchero."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "panetto",
                                "target_lang_sense_clarification": "Quantità di sostanza confezionata in forma di parallelepipedo o cilindro."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52cd4e1c-4c8b-34f7-b18d-8eb24986e064",
                    "sense_definition": "The human head or brain.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You really need to use your <w>loaf</w> before making such a risky decision.",
                            "target_lang_translations": {
                                "it": "Dovresti davvero usare la <w>capoccia</w> prima di prendere una decisione così rischiosa."
                            }
                        },
                        {
                            "text": "He just stood there and scratched his <w>loaf</w> in confusion.",
                            "target_lang_translations": {
                                "it": "È rimasto lì impalato a grattarsi la <w>capoccia</w> confuso."
                            }
                        }
                    ],
                    "synonyms": [
                        "head",
                        "noggin",
                        "nut",
                        "skull"
                    ],
                    "common_phrases": [
                        "use one's loaf"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "La testa o il cervello umano (termine gergale)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "capoccia",
                                "target_lang_sense_clarification": "Termine colloquiale o gergale per indicare la testa."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "81d4f328-704d-36d8-8bc9-1289d4df7dab",
                    "sense_definition": "To spend time in an idle or lazy manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inactivity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They like to <w>loaf</w> around the park on sunny Sunday afternoons.",
                            "target_lang_translations": {
                                "it": "A loro piace <w>bighellonare</w> al parco nei soleggiati pomeriggi domenicali."
                            }
                        },
                        {
                            "text": "It is nice to <w>loaf</w> about the house after a very busy week.",
                            "target_lang_translations": {
                                "it": "È bello <w>oziare</w> per casa dopo una settimana molto intensa."
                            }
                        }
                    ],
                    "synonyms": [
                        "idle",
                        "laze",
                        "lounge"
                    ],
                    "common_phrases": [
                        "loaf around",
                        "loaf about"
                    ],
                    "target_lang_definitions": {
                        "it": "Passare il tempo in modo ozioso o pigro."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "oziare",
                                "target_lang_sense_clarification": "Stare senza fare nulla."
                            },
                            {
                                "target_lang_word": "bighellonare",
                                "target_lang_sense_clarification": "Girovagare senza una meta precisa perdendo tempo."
                            },
                            {
                                "target_lang_word": "trastullarsi",
                                "target_lang_sense_clarification": "Passare il tempo in attività poco impegnative o divertenti."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}