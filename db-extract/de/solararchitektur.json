                "senses": [
                    {
                        "sense_id": "a6cd337b-8ccd-3e32-bc98-1dac468239aa",
                        "entry_id": "cc96ae6b-fb6b-338a-a82c-8e1bfd6f5ba4",
                        "glosses": [
                            "Architektur, die besonderen Wert auf die Nutzung der Sonnenenergie legt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ed73b73-2276-4a62-a9a9-8f9aaf9ee7ef",
                                "sense_id": "a6cd337b-8ccd-3e32-bc98-1dac468239aa",
                                "text": "„Dabei sind ein Veteran der Solararchitektur, der Freiburger Rolf Disch, sowie große, international agierende Planer aus dem boomenden Geschäft des Öko-Bauwesens.“"
                            },
                            {
                                "example_id": "1317b350-db70-4f25-843f-a2f1c048b32c",
                                "sense_id": "a6cd337b-8ccd-3e32-bc98-1dac468239aa",
                                "text": "„Bei einem von der Energieallianz organisierten Vortrag referiert der Architekt Andrea Rüedi über Solararchitektur.“"
                            },
                            {
                                "example_id": "f532e0e3-14c9-48f4-b661-f772350f797e",
                                "sense_id": "a6cd337b-8ccd-3e32-bc98-1dac468239aa",
                                "text": "„Ein Goldenes Verdienstzeichen der Republik Österreich wurde vor Kurzem nach Deutschland „verschickt“ – für den gebürtigen St. Antoner Hans Peter Gamsjäger, der sich mit einem Planungsbüro für Solararchitektur in seiner Wahlheimat Bayern einen Namen gemacht hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
