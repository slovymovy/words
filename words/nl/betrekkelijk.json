    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ddd31355-198a-3cd3-8dbe-e494eba2a203",
                    "sense_definition": "slechts waarde of betekenis hebbend in vergelijking met iets anders",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relativiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Of een huis groot is, blijft een <w>betrekkelijk</w> begrip afhankelijk van je gezinssituatie.",
                            "target_lang_translations": {
                                "en": "Whether a house is large remains a <w>relative</w> concept depending on your family situation."
                            }
                        },
                        {
                            "text": "De waarde van geld is vaak <w>betrekkelijk</w> als je kijkt naar wat je er echt voor kunt kopen.",
                            "target_lang_translations": {
                                "en": "The value of money is often <w>relative</w> when you look at what you can actually buy with it."
                            }
                        }
                    ],
                    "synonyms": [
                        "relatief"
                    ],
                    "antonyms": [
                        "absoluut"
                    ],
                    "common_phrases": [
                        "betrekkelijk begrip",
                        "betrekkelijke waarde"
                    ],
                    "target_lang_definitions": {
                        "en": "only having value or meaning in comparison with something else"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "relative",
                                "target_lang_sense_clarification": "not absolute"
                            },
                            {
                                "target_lang_word": "comparative",
                                "target_lang_sense_clarification": "measured by comparison"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d2eff6f-48de-3444-aa98-8dc9cdf4a1cd",
                    "sense_definition": "verwijzend naar een eerder genoemd woord of zinsdeel in de grammatica",
