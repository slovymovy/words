                    {
                        "sense_id": "15a28186-a096-3ee2-a393-6c4ae4f2f5ab",
                        "entry_id": "89a344cc-8111-3c6d-9451-60161da6580c",
                        "glosses": [
                            "Polymère issu de la polycondensation par liaisons de type amide : polyamide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99a0cfdb-e948-4b82-8c62-f32bfac6e19b",
                                "sense_id": "15a28186-a096-3ee2-a393-6c4ae4f2f5ab",
                                "text": "Die konventionelle Abkürzung für Polyamid in der Kunststoffindustrie ist «PA».",
                                "translation": "Le sigle conventionnel pour le polyamide dans l'industrie des matières plastiques est « PA »."
                            },
                            {
                                "example_id": "44f01949-642f-4399-aedd-bbbd268beeab",
                                "sense_id": "15a28186-a096-3ee2-a393-6c4ae4f2f5ab",
                                "text": "Aramide sind aromatische Polyamide, die aus den anderen durch ihre hohen mechanischen Festigkeit hervorragen.",
                                "translation": "Les aramides sont des polyamides aromatiques qui se démarquent des autres par leur haute résistance mécanique."
                            }
                        ]
                    }
                ],
