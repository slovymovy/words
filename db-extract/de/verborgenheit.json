                "senses": [
                    {
                        "sense_id": "6936d180-7917-3848-9e16-be7997ac65b8",
                        "entry_id": "cfdb2746-fa5f-3a8c-a7ee-45fa7dd9f3d5",
                        "glosses": [
                            "Zustand, nicht (oder wenigstens kaum) wahrnehmbar zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec1c430a-5ad5-43cc-954c-40a09b04c3e0",
                                "sense_id": "6936d180-7917-3848-9e16-be7997ac65b8",
                                "text": "„Robinson zog sich noch mehrmals in die Verborgenheit der Höhle zurück, aber durch die Kornernte und die Heumahd wurde er davon abgelenkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aad6f443-2266-4f8d-8a24-b45463833515",
                        "source_entry_id": "cfdb2746-fa5f-3a8c-a7ee-45fa7dd9f3d5",
                        "source_sense_id": "6936d180-7917-3848-9e16-be7997ac65b8",
                        "source_sense_description": "Zustand, nicht (oder wenigstens kaum) wahrnehmbar zu sein",
                        "target_lang_word": "obscurity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obscurity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e10f7a33-3184-3d75-88ec-e1bf221c0b04",
                                        "entry_id": "c0629424-e489-3db3-8f15-ee43c1e7e676",
                                        "glosses": [
                                            "Darkness; the absence of light."
                                        ],
                                        "tags": [
                                            "countable",
                                            "literary",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "756659b2-3262-42e8-b74d-d68d4994d16d",
                                                "sense_id": "e10f7a33-3184-3d75-88ec-e1bf221c0b04",
                                                "text": "The night was considerably clearer than anybody on board her desired when the schooner Ventura headed for the land. It rose in places, black and sharp against the velvety indigo, over her dipping bow, though most of the low littoral was wrapped in obscurity."
                                            },
                                            {
                                                "example_id": "c4036c52-8d6b-47bc-bd27-18ef8ab2c654",
                                                "sense_id": "e10f7a33-3184-3d75-88ec-e1bf221c0b04",
                                                "text": "I walked in, and Stroeve followed me. The room was in darkness. I could only see that it was an attic, with a sloping roof; and a faint glimmer, no more than a less profound obscurity, came from a skylight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dfa7139-38f2-33bd-bbe7-e3194f58f7b8",
                                        "entry_id": "c0629424-e489-3db3-8f15-ee43c1e7e676",
                                        "glosses": [
                                            "The state of being unknown; a thing that is unknown."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0efaf3bd-3f27-4e3f-bbf0-972e139b2d07",
                                                "sense_id": "4dfa7139-38f2-33bd-bbe7-e3194f58f7b8",
                                                "text": "The departure was not unduly prolonged.[…]Within the door Mrs. Spoker hastily imparted to Mrs. Love a few final sentiments[…]; a deep, guttural instigation to the horse; and the wheels of the waggonette crunched heavily away into obscurity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69c96b4f-9704-34fc-83c1-8e8e64f248d9",
                                        "entry_id": "c0629424-e489-3db3-8f15-ee43c1e7e676",
                                        "glosses": [
                                            "The quality of being difficult to understand; a thing that is difficult to understand."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
