                                "target_senses": [
                                    {
                                        "sense_id": "c1b41a7c-751c-3bec-a588-e5c1e69e4907",
                                        "entry_id": "0e7d0719-819a-366f-a9f9-1e81f32a77d4",
                                        "glosses": [
                                            "übertrieben starkes inneres Bedürfnis, zu gefallen"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0691e9d2-b903-415a-bf9e-5b1a65d3247d",
                                                "sense_id": "c1b41a7c-751c-3bec-a588-e5c1e69e4907",
                                                "text": "„Sie will mir gefallen und ist doch ohne rechte Gefallsucht.“"
