                "senses": [
                    {
                        "sense_id": "177c4708-c5fb-3e0a-b1ba-3b44889784d5",
                        "entry_id": "26daf28b-bb3b-348f-8f44-dd49645c78a9",
                        "glosses": [
                            "het geluid dat kinderen met hun mond maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34703636-34d5-428d-920a-fac76f0b16fd",
                                "sense_id": "177c4708-c5fb-3e0a-b1ba-3b44889784d5",
                                "text": "Noorlander belt op een rustig moment, hij heeft ondertussen een vaste lijn gevonden bij het vliegveld, naar huis. \"Een kinderstem op dat moment horen, is wel heel bijzonder. Daar kan geen redenering tegen op.\""
                            },
                            {
                                "example_id": "f730095c-16c8-4287-bc4f-00acaeae1cb9",
                                "sense_id": "177c4708-c5fb-3e0a-b1ba-3b44889784d5",
                                "text": "Zijn noodkreet had effect. \"De commandant hoorde opeens een kinderstem. Hij keek op en ik zag zijn gezicht. Het was een vriendelijk gezicht, niet dat van een monster."
                            }
                        ]
                    },
                    {
                        "sense_id": "281b47f7-6352-30ed-9a42-99f02f25cc82",
                        "entry_id": "26daf28b-bb3b-348f-8f44-dd49645c78a9",
                        "glosses": [
                            "de mening van jonge mensen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bef604f6-d522-4bc5-936e-79d95a9c4e7c",
                                "sense_id": "281b47f7-6352-30ed-9a42-99f02f25cc82",
                                "text": "Voor de rubriek De Kinderstem op NPO Radio 1 stellen kinderen vragen aan lijsttrekkers. Vandaag was het de beurt aan Gert-Jan Segers van de ChristenUnie, die geïnterviewd werd door Joep, Jesse en Rick."
                            }
                        ]
                    }
