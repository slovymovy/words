                "senses": [
                    {
                        "sense_id": "c684fb23-6ac4-3f6f-a0ca-3cc2aa931dc3",
                        "entry_id": "e512c146-56b1-3574-9cf1-25f5360e16c7",
                        "glosses": [
                            "systematische Überprüfung der Ausrüstung, häufig als Vorbereitung auf eine anspruchsvolle Aktivität (zum Beispiel Bergsteigen, Skifahren, Mountainbiking), um sicherzustellen, dass alle Ausrüstungsgegenstände vollständig, funktionstüchtig und korrekt angepasst sind"
                        ],
                        "tags": [
                            "insbesondere",
                            "Outdooraktivitäten"
                        ],
                        "examples": [
                            {
                                "example_id": "b938a690-bca9-4a34-bd15-5cafc687a419",
                                "sense_id": "c684fb23-6ac4-3f6f-a0ca-3cc2aa931dc3",
                                "text": "„Der obligatorische Ausrüstungscheck durch die Amerikanischen Guides verlief am Samstag ohne größere Probleme, da sich alle Teilnehmer gut auf die Expedition vorbereitet hatten und entsprechend der Ausrüstungslisten von K&P eingepackt hatten.“"
                            },
                            {
                                "example_id": "429ea734-957a-43ed-afe8-4528da8ebf5f",
                                "sense_id": "c684fb23-6ac4-3f6f-a0ca-3cc2aa931dc3",
                                "text": "„Nach einem kurzen Ausrüstungscheck geht es mit dem Zug hinunter nach Pontresina.“"
                            },
                            {
                                "example_id": "8f0960d7-a634-4219-8f57-98d1f3320e3e",
                                "sense_id": "c684fb23-6ac4-3f6f-a0ca-3cc2aa931dc3",
                                "text": "„Ein genauer Ausrüstungscheck und die Tourbesprechung erfolgt bereits am Vorabend beim Bergführerhäusl-Info Tisch.“"
                            },
                            {
                                "example_id": "46abf13c-1564-4251-9cc1-b913dcd5ec98",
                                "sense_id": "c684fb23-6ac4-3f6f-a0ca-3cc2aa931dc3",
                                "text": "„Der Deutsche Skilehrerverband (DSLV) gibt Ratschläge zum passenden Skigebiet, zum Ausrüstungscheck und zum rechtzeitigen Trainieren im Sommer – damit Wintersportfans gut gerüstet sind, wenn die kalte Jahreszeit vor der Tür steht.“"
                            },
                            {
                                "example_id": "b66b0180-cecc-40e1-ae3e-ef81d7e4f7d6",
                                "sense_id": "c684fb23-6ac4-3f6f-a0ca-3cc2aa931dc3",
                                "text": "„Nach dem gemeinsamen Abendessen erfolgt der Ausrüstungscheck bzw. das Anpassen der Leihausrüstung und die Absprachen für den nächsten Tag. 2. – 3. Tag: Im Toprope frischen wir unser Können auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
