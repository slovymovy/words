            {
                "entry_id": "c859c92e-ff6a-3efe-859b-a7c5fb322252",
                "word": "bleue",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fd176f52-7772-4c4d-8a01-8a6a30472786",
                        "entry_id": "c859c92e-ff6a-3efe-859b-a7c5fb322252",
                        "tags": [
