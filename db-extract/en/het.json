            {
                "entry_id": "831e185f-8cf5-3bff-ab4f-68eabf787f76",
                "word": "het",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "96c1a20f-c1af-455c-a1b6-45d9edb5de00",
                        "entry_id": "831e185f-8cf5-3bff-ab4f-68eabf787f76",
                        "tags": [
                            "plural"
                        ],
                        "form": "hets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9765a0ee-cc6d-31a4-993c-754f6b6e7555",
                        "entry_id": "831e185f-8cf5-3bff-ab4f-68eabf787f76",
                        "glosses": [
                            "A heterosexual person."
                        ],
                        "tags": [
                            "countable",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "1af10907-ac83-49b5-9d24-50efe3075944",
                                "sense_id": "9765a0ee-cc6d-31a4-993c-754f6b6e7555",
                                "text": "See how you like that you townie het from southeastern MA / Saying \"fairy\" and \"Mark Wahlberg\" like it's southie any day"
                            }
                        ]
                    },
                    {
                        "sense_id": "eda4c83a-f496-3d1c-b3ab-d8cb7d739c33",
                        "entry_id": "831e185f-8cf5-3bff-ab4f-68eabf787f76",
                        "glosses": [
                            "Fan fiction involving characters in an opposite-sex romantic or sexual relationship."
                        ],
                        "tags": [
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "04fae323-8f40-4a70-b8d4-b82c02f5122a",
                                "sense_id": "eda4c83a-f496-3d1c-b3ab-d8cb7d739c33",
                                "text": "Mary Ellen Curtin presented a paper at the 2002 Popular Culture Association conference in which she studied fanfiction archives to discover that black characters appeared far less in both het and slash fiction than white or even Latino/a characters."
                            },
                            {
                                "example_id": "8dd75a4c-3ade-4296-8522-d75ea8fc0422",
                                "sense_id": "eda4c83a-f496-3d1c-b3ab-d8cb7d739c33",
                                "text": "The vast majority of fan fiction is het or slash, and these types are usually defined against each other as approaches to romance and porn, marginalizing gen as something outside of the dominant concerns of fan fiction."
                            },
                            {
                                "example_id": "f834cd81-2767-4b3e-af78-5afef535206b",
                                "sense_id": "eda4c83a-f496-3d1c-b3ab-d8cb7d739c33",
                                "text": "Other studies explore why some women write het, or fictions with heterosexual pairings of certain couples, within canons such as Star Trek Voyager that generally inspire slash fiction (Somogyi, 2002)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "5fd73cd6-32f4-435a-b4c6-09598971323a",
                        "source_entry_id": "831e185f-8cf5-3bff-ab4f-68eabf787f76",
                        "source_sense_ids": [
                            "eda4c83a-f496-3d1c-b3ab-d8cb7d739c33"
                        ],
