                "senses": [
                    {
                        "sense_id": "dcd25ff0-718e-32fe-929c-17c18aa5f991",
                        "entry_id": "0a843a82-2290-3ed2-bfaa-2922d4f6b728",
                        "glosses": [
                            "betrokken bij de defensie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf6e011b-c05d-49aa-a84b-4c3b64c4c6b3",
                                "sense_id": "dcd25ff0-718e-32fe-929c-17c18aa5f991",
                                "text": "Aston Villa blijft maar spelers kopen. Vanochtend werd doelman Tom Heaton vastgelegd en nu is Marvelous Nakamba alweer de volgende aankoop van de club uit Birmingham. De 25-jarige verdedigende middenvelder uit Zimbabwe wordt voor 12 miljoen euro overgenomen van Club Brugge, dat eerder op de dag al Arnaut Danjuma Groeneveld voor 15 miljoen euro aan Bournemouth verkocht."
                            },
                            {
                                "example_id": "f3fde966-b30f-4f0f-ba6f-5e18862fea02",
                                "sense_id": "dcd25ff0-718e-32fe-929c-17c18aa5f991",
                                "text": "Manchester City-trainer 'Pep’ Guardiola is, als we Sunday Express mogen geloven, hard op zoek naar versterking voor zijn Manchester City. De landskampioen van Engeland is op zoek naar een verdediger én een middenvelder. Voor de verdedigende optie zou de club zijn uitgekomen bij Nathan Aké, de Nederlander van Bournemouth."
                            }
                        ]
                    }
