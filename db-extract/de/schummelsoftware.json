                "senses": [
                    {
                        "sense_id": "ab8c7f21-14fa-30f5-bf29-57187a23ba95",
                        "entry_id": "38322b6b-0066-3675-9645-b500fd05a85f",
                        "glosses": [
                            "technische Vorrichtung, mit der (besonders bei Fahrzeugmotoren) etwas manipuliert werden kann"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "8c8bddb8-1989-4f73-b452-309c8c15c525",
                                "sense_id": "ab8c7f21-14fa-30f5-bf29-57187a23ba95",
                                "text": "„Gezielte Manipulationen der Abgastechnik mit einer Schummelsoftware, wie sie bei Volkswagen zum Einsatz kam, hatte Daimler jedoch stets zurückgewiesen.“"
                            },
                            {
                                "example_id": "2372b28d-227f-47b9-9a43-bbb632ddbe4a",
                                "sense_id": "ab8c7f21-14fa-30f5-bf29-57187a23ba95",
                                "text": "„Und zu allem Übel hat der Bundesgerichtshof gerade entschieden, die Manipulation von VW-Dieselfahrzeugen durch Schummelsoftware ‚objektiv als sittenwidrig zu qualifizieren‘.“"
                            },
                            {
                                "example_id": "a9c83948-5f23-4cef-98a1-b257f9106491",
                                "sense_id": "ab8c7f21-14fa-30f5-bf29-57187a23ba95",
                                "text": "„Als die Behörde im September VW erstmals den Einsatz von Schummelsoftware vorwarf, war es noch um Autos mit Zwei-Liter-Dieselmotoren gegangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
