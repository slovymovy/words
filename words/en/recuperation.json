{
    "word_family": [
        "recuperate",
        "recuperative",
        "recuperator"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cd3eabdb-ffde-35b8-a409-a01682a6ffac",
                    "sense_definition": "The process of gradual restoration to health and strength after an illness or injury.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "health recovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the major surgery, the patient required several weeks of quiet <w>recuperation</w> at home.",
                            "target_lang_translations": {
                                "ru": "После серьезной операции пациенту потребовалось несколько недель спокойного <w>восстановления</w> дома."
                            }
                        },
                        {
                            "text": "The doctor emphasized that a period of <w>recuperation</w> is essential for a full return to physical activity.",
                            "target_lang_translations": {
                                "ru": "Врач подчеркнул, что период <w>выздоровления</w> необходим для полного возвращения к физической активности."
                            }
                        }
                    ],
                    "synonyms": [
                        "convalescence",
                        "healing",
                        "recovery"
                    ],
                    "common_phrases": [
                        "period of recuperation",
                        "speedy recuperation",
                        "complete recuperation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс постепенного восстановления здоровья и сил после болезни или травмы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстановление",
                                "target_lang_sense_clarification": "сил и здоровья"
                            },
                            {
                                "target_lang_word": "выздоровление",
                                "target_lang_sense_clarification": "после болезни"
                            },
                            {
                                "target_lang_word": "реабилитация",
                                "target_lang_sense_clarification": "медицинская"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1880d717-bdc8-36a8-b0b0-10f97541ec2d",
                    "sense_definition": "The act or an instance of recovering or getting back something that was lost, such as money or resources.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "recovery of assets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company focused on the <w>recuperation</w> of lost capital through more aggressive investment strategies.",
                            "target_lang_translations": {
                                "ru": "Компания сосредоточилась на <w>возмещении</w> потерянного капитала с помощью более агрессивных инвестиционных стратегий."
                            }
                        },
                        {
                            "text": "Legal experts are working on the <w>recuperation</w> of funds stolen during the cyberattack.",
                            "target_lang_translations": {
                                "ru": "Юристы работают над <w>возвратом</w> средств, украденных во время кибератаки."
                            }
                        }
                    ],
                    "synonyms": [
                        "recovery"
                    ],
                    "common_phrases": [
                        "recuperation of losses",
                        "recuperation of costs"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in financial or formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт или случай возвращения чего-либо утраченного, например, денег или ресурсов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возмещение",
                                "target_lang_sense_clarification": "убытков или затрат"
                            },
                            {
                                "target_lang_word": "возврат",
                                "target_lang_sense_clarification": "утерянных средств"
                            },
                            {
                                "target_lang_word": "рекуперация",
                                "target_lang_sense_clarification": "энергии или ресурсов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d77dab4d-7a23-3268-84a1-6d468a59ceaa",
                    "sense_definition": "The process by which radical or subversive ideas and images are co-opted and neutralized by mainstream society or capitalism.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sociopolitical co-option",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>recuperation</w> of punk rock by the fashion industry turned a rebellion into a commercial trend.",
                            "target_lang_translations": {
                                "ru": "<w>Рекуперация</w> панк-рока индустрией моды превратила бунт в коммерческий тренд."
                            }
                        },
                        {
                            "text": "Sociologists study the <w>recuperation</w> of revolutionary symbols when they appear on mass-produced consumer goods.",
                            "target_lang_translations": {
                                "ru": "Социологи изучают <w>ассимиляцию</w> революционных символов, когда они появляются на товарах массового потребления."
                            }
                        }
                    ],
                    "antonyms": [
                        "detournement"
                    ],
                    "common_phrases": [
                        "spectacular recuperation",
                        "cultural recuperation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс, посредством которого радикальные или подрывные идеи и образы поглощаются и нейтрализуются мейнстримным обществом или капитализмом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рекуперация",
                                "target_lang_sense_clarification": "в социологии и политике"
                            },
                            {
                                "target_lang_word": "ассимиляция",
                                "target_lang_sense_clarification": "радикальных идей обществом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}