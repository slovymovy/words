                                        "entry_id": "5bab20ee-cf00-3764-a735-7daab3695eb0",
                                        "glosses": [
                                            "большой круглый или продолговатый сочный плод этого растения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "603d83dd-c475-46bb-84b9-dac74a81f628",
                                                "sense_id": "e54e9acf-73fb-38f2-bade-0984b642966e",
                                                "text": "После полдника стал дед потчевать гостей дынями."
                                            },
                                            {
                                                "example_id": "a224343c-a7c9-480d-add4-be5dde61aacc",
                                                "sense_id": "e54e9acf-73fb-38f2-bade-0984b642966e",
                                                "text": "После вареников Марта вынесла миску слив и жёлтую душистую дыню; покушали и слив, и дыни немного."
                                            }
                                        ]
                                    }
                                ]
