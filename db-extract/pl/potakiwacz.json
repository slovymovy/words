                "senses": [
                    {
                        "sense_id": "e34e460d-f37e-3528-8a12-78bea90bcd4f",
                        "entry_id": "b65eb30d-9b75-39a0-b52d-d164b26159e0",
                        "glosses": [
                            "o kimś, kto nie wychyla się z własnym zdaniem i wszystkim potakuje"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "070c36e4-ee8b-4c83-aced-4ea9530d15e9",
                                "sense_id": "e34e460d-f37e-3528-8a12-78bea90bcd4f",
                                "text": "Nie bądź takim potakiwaczem, postaw się czasem."
                            },
                            {
                                "example_id": "fc0c5b89-dd7b-4667-b928-254b85775ff7",
                                "sense_id": "e34e460d-f37e-3528-8a12-78bea90bcd4f",
                                "text": "Nawet jeśli pomysł szefa jest głupi, to grono potakiwaczy uzna go za rewelacyjny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
