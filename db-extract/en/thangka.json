                    {
                        "sense_id": "10370b83-8a83-32a3-ac84-5d89c281a315",
                        "entry_id": "b29738f8-983d-31d3-a9b7-1c73bc3be932",
                        "glosses": [
                            "A painted or embroidered linen banner, usually depicting Buddhist themes, originating in Tibet; a prayer flag."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d47847a-4418-4684-80a3-00c455c552f6",
                                "sense_id": "10370b83-8a83-32a3-ac84-5d89c281a315",
                                "text": "When the talks by Lama Thubten Yeshe on Buddhist and Christian meditation were published, the text included a reproduction of a Christian icon and a Tibetan thangka."
                            },
                            {
                                "example_id": "c55302a9-1ddc-4bc3-9218-30a66c1fcea7",
                                "sense_id": "10370b83-8a83-32a3-ac84-5d89c281a315",
                                "text": "Like so many things in Nepal, thangka—Tibetan ritual paintings—are now cranked out for the tourist market, yet the best ones remain undiminished by commercialization, and even the cheapest can't hide the dense Buddhist symbolism inherent in the form."
                            }
                        ]
                    }
