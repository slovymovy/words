                    }
                ],
                "translations": [
                    {
                        "translation_id": "249937fa-c57d-4cd6-a87b-d2e904233250",
                        "source_entry_id": "1c8afb44-beae-303a-be98-380f93f1a4a6",
                        "source_sense_description": "small, fleshy excrescence on an animal — see also wattle",
                        "target_lang_word": "caroncule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caroncule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80a71b6b-eaa8-38da-bd5b-97bbcc532216",
                                        "entry_id": "2031ae35-06ff-3572-a777-58d87c08e423",
                                        "glosses": [
                                            "Petite excroissance charnue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a5645da-e16f-44f0-a6fa-4d9b7f2b3395",
                                                "sense_id": "80a71b6b-eaa8-38da-bd5b-97bbcc532216",
                                                "text": "[…] ils ont vu quelquefois, mais bien rarement, une membrane qui unissait des protubérances charnues, qu'ils ont appelées caroncules myrtiformes, mais ils soutiennent que cette membrane était contre l'état naturel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7189876-9ec4-39f2-b22f-6bc7c055de9c",
                                        "entry_id": "2031ae35-06ff-3572-a777-58d87c08e423",
                                        "glosses": [
                                            "Certaines excroissances charnues qui se voient au front, à la gorge, aux sourcils des oiseaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a889d72f-1d1d-427f-9f65-c5fdbd63d76b",
                                                "sense_id": "e7189876-9ec4-39f2-b22f-6bc7c055de9c",
                                                "text": "L’oiseau possède donc un élément qui pend sous le bec : une caroncule."
                                            },
                                            {
                                                "example_id": "b02bef6f-1a4a-41d5-953e-66b78816ae9b",
                                                "sense_id": "e7189876-9ec4-39f2-b22f-6bc7c055de9c",
                                                "text": "Les caroncules sont les attributs les plus visibles à longue distance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a924e70-4e6d-3e80-a602-4b19111f3b65",
                                        "entry_id": "2031ae35-06ff-3572-a777-58d87c08e423",
                                        "glosses": [
                                            "Excroissance dure sur le bec d’une tortue, utilisé pour casser la coquille de l’œuf au moment de l’éclosion ; dent de l’œuf."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
