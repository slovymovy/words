                        "sense_id": "c9987abe-efce-3ab2-8989-deacb4c1b720",
                        "entry_id": "ca66252b-3d77-34db-afc1-544eae04994f",
                        "glosses": [
                            "To take the edge off (someone's) hunger; to satiate."
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3257d48c-2695-46bd-b2bf-f9eb7f06dcee",
                                "sense_id": "c9987abe-efce-3ab2-8989-deacb4c1b720",
                                "text": "I grieve myself / To think, when thou shalt be disedged by her / That now thou tirest on, how thy memory / Will then be pang'd by me."
                            }
                        ]
                    }
