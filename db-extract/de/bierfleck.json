                            {
                                "example_id": "358d2679-3dbd-42d2-a718-5bed9f0df3e2",
                                "sense_id": "03e4d170-9982-39ca-9501-05883bb106dc",
                                "text": "„Ein Blick über die schmutzigen Finger hinaus ließ ihn einen Bierfleck wie Pisse auf seiner Brust bemerken.“"
                            },
                            {
                                "example_id": "4a65670d-cd75-433a-a9e0-f649a256b993",
                                "sense_id": "03e4d170-9982-39ca-9501-05883bb106dc",
                                "text": "„Obwohl es erst sechs Uhr war, waren sie schon betrunken und ihre Uniformen voller Bierflecken.“"
                            }
