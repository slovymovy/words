                                                "example_id": "cbf06cd8-0a9a-42a8-98c5-e9200731678b",
                                                "sense_id": "d87f3316-4d44-37aa-8b18-7819e70b5f25",
                                                "text": "The rose blanches in the sun."
                                            },
