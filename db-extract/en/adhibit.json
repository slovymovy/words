                    {
                        "translation_id": "22d0e60f-ab00-4ecf-9ecf-3a1a21ae9828",
                        "source_entry_id": "2bc977f7-e8ce-36e0-8555-6b920bfa1214",
                        "source_sense_id": "46679e1b-2fd7-34ea-a111-69f421e6343f",
