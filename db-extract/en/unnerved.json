                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc16bf77-926e-4243-a394-d6f70636b9c4",
                                "sense_id": "f59235a5-7441-3ca8-bb9d-53bd79c0e4f6",
                                "text": "`Surely he dieth even now.' `True,' she said, with a start. `Oh, why did I not come before! I am unnerved - my hand trembles, even mine - and yet it is very easy.'"
                            },
                            {
                                "example_id": "3c24bf06-5217-406e-93fb-5e91f1097310",
                                "sense_id": "f59235a5-7441-3ca8-bb9d-53bd79c0e4f6",
                                "text": "[…]Wrapped in around itself and self-befriended,\nHis science needn't get him so unnerved.\nHe had been too all out , too much extended .\nHe slapped his breast to verify his purse\nAnd hugged himself for all his universe . […]"
                            }
                        ]
                    }
