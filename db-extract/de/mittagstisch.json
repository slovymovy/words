                "senses": [
                    {
                        "sense_id": "4b59191d-3abb-3fbe-8d11-630fe3746677",
                        "entry_id": "11eadb6f-c48e-38c6-b8ee-692ca4e3a457",
                        "glosses": [
                            "zur Mittagsmahlzeit gedeckter Tisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e8a8dd3-f64f-43fa-8162-419a29b12c84",
                                "sense_id": "4b59191d-3abb-3fbe-8d11-630fe3746677",
                                "text": "„In der Station mußte man sich ohne die beiden an den Mittagstisch setzen.“"
                            },
                            {
                                "example_id": "07b987d0-a101-4d41-b821-016f5cf285b3",
                                "sense_id": "4b59191d-3abb-3fbe-8d11-630fe3746677",
                                "text": "„Am Mittagstisch der Pension Charlotte spielte die Mutter eine geachtete, aber nicht eine dominierende Rolle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a152cd7c-bd4c-32e5-b4fc-9f98460be605",
                        "entry_id": "11eadb6f-c48e-38c6-b8ee-692ca4e3a457",
                        "glosses": [
                            "Mahlzeit zu Mittag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea62db28-38ca-4df3-9011-c221ae4bc08d",
                                "sense_id": "a152cd7c-bd4c-32e5-b4fc-9f98460be605",
                                "text": "„Sonntags begann man mit dem Frühschoppen, bei dem man auch den Mittagstisch einnehmen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f58a34c6-5472-38de-9b79-5f1669bb5a29",
                        "entry_id": "11eadb6f-c48e-38c6-b8ee-692ca4e3a457",
                        "glosses": [
                            "Angebot von günstigem Mittagessen im Sinne einer speziellen Speisekarte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efaec9e1-c5cc-41ad-9d14-92d765b1b897",
                                "sense_id": "f58a34c6-5472-38de-9b79-5f1669bb5a29",
                                "text": "„Auf der anderen Seite des Platzes trat der Wirt der Weißen Rose aus dem Tor, um lautstark seinen Mittagstisch anzupreisen.“"
                            },
                            {
                                "example_id": "24dde383-b322-49b2-bf26-d9a20ca992c4",
                                "sense_id": "f58a34c6-5472-38de-9b79-5f1669bb5a29",
                                "text": "„Die wohl extrovertierteste der Damen sieht mich an und fragt: „Sie bieten einen Mittagstischan?“"
                            },
                            {
                                "example_id": "dd8a5b44-668d-47df-9dd9-51de18ad29b7",
                                "sense_id": "f58a34c6-5472-38de-9b79-5f1669bb5a29",
                                "text": "„Ihe Gewohnheiten änderten sich, sie gaben ihren bürgerlichen Mittagstisch auf und aßen schließlich alle Tage zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "0aa7866c-151c-398f-8b61-f460b78e7f8f",
                        "entry_id": "11eadb6f-c48e-38c6-b8ee-692ca4e3a457",
                        "glosses": [
                            "Schweiz: schulinternes Angebot zur kostengünstigen Verpflegung der Schüler während der Mittagszeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82d52254-c5d5-4e84-b848-e9497e682bdd",
                                "sense_id": "0aa7866c-151c-398f-8b61-f460b78e7f8f",
                                "text": "„Der Mittagstisch ermöglicht die Betreuung und Verpflegung von Kindern in Kinder- und Schulalter zwischen dem Unterricht am Morgen und am Nachmittag.“"
                            },
                            {
                                "example_id": "4acc2c05-a0f1-444a-be13-40a65ad874ab",
                                "sense_id": "0aa7866c-151c-398f-8b61-f460b78e7f8f",
                                "text": "„Mittagstische gehören zu den schulergänzenden Betreuungsmassnahmen für Kinder ausserhalb der eigentlichen Unterrichtszeit.“"
                            },
                            {
                                "example_id": "da66ba7a-20a1-4c45-b5e6-fbc66de07052",
                                "sense_id": "0aa7866c-151c-398f-8b61-f460b78e7f8f",
                                "text": "„Die Standards für den betreuten Mittagstisch ergänzen oder vertiefen bestehende Ressourcen wie z.B. pädagogische Qualitätsrahmen für Tagesstrukturen, kantonale und kommunale Vorgaben/Leitlinien für Ernährung in Tagesstrukturen oder bilden die Basis für Labels und Beratung wie Fourchette verte – Ama terra.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
