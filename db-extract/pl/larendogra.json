                "senses": [
                    {
                        "sense_id": "49149eeb-5f28-3978-a83a-621d9f526f6c",
                        "entry_id": "eef24b83-8f63-354d-95e9-fbe7acacb85d",
                        "glosses": [
                            "woda toaletowa o zapachu rozmarynu albo lawendy, szczególnie popularna w XVII-XVIII wieku"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "612ed459-b771-4ed5-bb5f-3383701c7fd4",
                                "sense_id": "49149eeb-5f28-3978-a83a-621d9f526f6c",
                                "text": "Poruszyła się żywo i chwyciwszy ze stołu flaszeczkę larendogry, przyłożyła ją do twarzy, aby orzeźwiającym jej zapachem odetchnąć"
                            },
                            {
                                "example_id": "efec9d57-792f-4e73-9c16-7261a06f5358",
                                "sense_id": "49149eeb-5f28-3978-a83a-621d9f526f6c",
                                "text": "Stara sługa księżnej (…) dobyła flaszki z larendogrą i oblewać ją poczęła a trzeźwić"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1da52926-492b-4548-8d26-505c70e90332",
                        "source_entry_id": "eef24b83-8f63-354d-95e9-fbe7acacb85d",
                        "source_sense_id": "49149eeb-5f28-3978-a83a-621d9f526f6c",
                        "target_lang_word": "Hungary water",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hungary water",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1b4c32f-8a5e-3283-b3d6-844936a3c00a",
                                        "entry_id": "9963d3e9-5060-3431-b910-866678c79d88",
                                        "glosses": [
                                            "One of various early modern perfumes and elixirs made of rosemary, camomile or later lavender infused in various alcohols."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95077110-ef09-451e-9223-513a3c88dcb5",
                                                "sense_id": "a1b4c32f-8a5e-3283-b3d6-844936a3c00a",
                                                "text": "...Your Bottle of Hungry Water to your Lady..."
                                            },
                                            {
                                                "example_id": "5f313bd0-cd4e-48ec-a5c2-5fec13e42f15",
                                                "sense_id": "a1b4c32f-8a5e-3283-b3d6-844936a3c00a",
                                                "text": "Certain unscrupulous men may call upon you here in your dressing-room. They will lavish you with flowers, with compliments, with phials of Hungary water and methuselahs of the costliest champagne. You must be wary of such men, my hearts, they are not to be trusted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70a3f0cf-917a-4165-a217-acf642ffc03c",
                        "source_entry_id": "eef24b83-8f63-354d-95e9-fbe7acacb85d",
