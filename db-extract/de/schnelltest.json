                "senses": [
                    {
                        "sense_id": "2070e2c5-939f-3bc5-9e11-aea0fbf7351c",
                        "entry_id": "90bd0b34-0582-3a58-9bc0-1cd696ef4e6f",
                        "glosses": [
                            "Prüfverfahren, mit dem auf einfache Weise in kurzer Zeit ein Ergebnis gefunden werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8352f5fe-71f5-4ce4-865e-a9c872b09c4f",
                                "sense_id": "2070e2c5-939f-3bc5-9e11-aea0fbf7351c",
                                "text": "„Ein Schweizer Wissenschafterteam hat einen Schnelltest für die bisher unheilbare Erbkrankheit Chorea Huntington vorgestellt.“"
                            },
                            {
                                "example_id": "fd8f53eb-d30d-42af-8e6d-a10e6754d75f",
                                "sense_id": "2070e2c5-939f-3bc5-9e11-aea0fbf7351c",
                                "text": "„Eine deutsche Firma hat nach eigenen Angaben einen Schnelltest entwickelt. Anhand von nur zwei Tropfen Blut könnte die Diagnose binnen 20 Minuten gestellt werden, heißt es in einer Mitteilung des Unternehmens.“"
                            },
                            {
                                "example_id": "085e9f8c-8261-4668-82bf-36d13ea9e75f",
                                "sense_id": "2070e2c5-939f-3bc5-9e11-aea0fbf7351c",
                                "text": "„Schnelltests auf Drogen lösen oft Fehlalarm aus. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
