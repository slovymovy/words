                ],
                "senses": [
                    {
                        "sense_id": "8cf9d007-aa1c-30da-a3db-32217e70203d",
                        "entry_id": "9ded23b4-a06c-305f-a91c-eb5dff99af0e",
                        "glosses": [
                            "Kappe für den Schutz oder die Therapie des vorderen Teiles eines Fußes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baa9b0a9-bbe7-42d0-a780-6819aff3f4d3",
                                "sense_id": "8cf9d007-aa1c-30da-a3db-32217e70203d",
                                "text": "Um die Füße wickelten sie sonst Gras, oder trugen auch Fußkappen oder Stiefeln auf den bloßen Füßen; jetzt haben die meisten Strümpfe."
                            },
                            {
                                "example_id": "b83798f0-3ca6-4721-8dcc-312ea19afff0",
                                "sense_id": "8cf9d007-aa1c-30da-a3db-32217e70203d",
                                "text": "Die Orthopädietechnik bietet die meisten Möglichkeiten: Einlagen mit Abstützung hinter den Mittelfußköpfchen, geweitete Fußkappe, Schienen und Verbände zur Stellungskorrektur, Orthesen."
                            },
                            {
                                "example_id": "3c5e8ffb-6729-4f18-832a-e9690d9dd71a",
                                "sense_id": "8cf9d007-aa1c-30da-a3db-32217e70203d",
                                "text": "Therapie (oft schwierig!): … Vorsichtig gesteigerte medikomechanische Nachbehandlung; beim Gehen zunächst noch Stützung (elastische Wicklung oder Fußkappe) nebst passendem Schuhwerk."
                            },
                            {
                                "example_id": "c007d6c5-afca-4452-9298-1eb3e13ebf6b",
                                "sense_id": "8cf9d007-aa1c-30da-a3db-32217e70203d",
                                "text": "Ist statt dessen die Fußkappe, wie so häufig, in der Mitte am höchsten, so wird dorthin die große Zehe gewaltsam abgedrängt; gleichgültig ob das Vorderende des Schuhwerkes spitz oder breit gearbeitet ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "80ae0d02-94a1-357e-b2f5-0c1fc1880388",
                        "entry_id": "9ded23b4-a06c-305f-a91c-eb5dff99af0e",
                        "glosses": [
                            "Kappe meistens aus Kunststoff als Abschluss für Stuhlbeine oder andere metallische Rohre"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31a97490-f5ec-45c7-a87b-e90fe9ce8e6d",
                                "sense_id": "80ae0d02-94a1-357e-b2f5-0c1fc1880388",
                                "text": "Fußkappen schließen scharfe und unsaubere Kanten ab und schonen das Material, das mit ihnen in Berührung kommt."
                            },
                            {
                                "example_id": "5752f51b-4b80-499d-a426-567945b759f7",
                                "sense_id": "80ae0d02-94a1-357e-b2f5-0c1fc1880388",
                                "text": "Einsatzbereiche dieser Kunststoffkappen sind z.B. als Fußkappen für Stühle, Tische, Gartenmöbel und Schulmöbel, aber auch als Zierkappen, Endkappen oder Schutzkappen für Konstruktionen und im Zaunbaubereich."
                            },
                            {
                                "example_id": "6f6d7491-9c4f-490f-9889-763006caf85d",
                                "sense_id": "80ae0d02-94a1-357e-b2f5-0c1fc1880388",
                                "text": "Die Fußkappen schützen sowohl den Boden vor Kratzern und Abnutzung wie auch die Möbelfüße vor Feuchtigkeit, Nässe und Dreck."
                            },
                            {
                                "example_id": "13f2ff38-8731-420d-868d-dc718ea7701a",
                                "sense_id": "80ae0d02-94a1-357e-b2f5-0c1fc1880388",
                                "text": "Das Rohr b (…) enthält eine Kopfkappe, eine Fußkappe sowie 2 Zwischenböden, wodurch drei Kammern gebildet werden."
                            },
                            {
                                "example_id": "d413fd50-a0c6-4436-8bd4-b318e8a62724",
                                "sense_id": "80ae0d02-94a1-357e-b2f5-0c1fc1880388",
                                "text": "Bei der Kopframmung ist das Rammrohr durch eine verlorene Spitze bzw. Platte (…) oder durch eine Fußkappe nach unten verschlossen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
