                            {
                                "target_word": "importun",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "934fcacd-1918-3e1e-86d9-1d79131ae9ff",
                                        "entry_id": "2dae8ac2-d355-31f6-8c4f-844601d0deb6",
                                        "glosses": [
                                            "Qui déplaît, qui ennuie, qui fatigue par des assiduités, par des discours, par des demandes, par une présence hors de propos, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b965a044-3151-42b3-92fd-89f932c17159",
                                                "sense_id": "934fcacd-1918-3e1e-86d9-1d79131ae9ff",
                                                "text": "Quoique très instruite, elle n'avoit ni les caprices, ni l’humeur qu'on attribue aux gens de lettres, qui tantôt se livrent à une loquacité importune, tantôt se renferment dans un silence méprisant."
                                            },
                                            {
                                                "example_id": "81bf4eea-546b-4300-ad2c-58709fe137da",
                                                "sense_id": "934fcacd-1918-3e1e-86d9-1d79131ae9ff",
                                                "text": "Un torse rond, des épaules droites, des seins gorgés comme des pastèques, des jambes longues et bien en chair se délivrèrent agilement d'un linge multiple importun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a42fcad4-10ab-337c-a1b4-075c79fe3086",
                                        "entry_id": "2dae8ac2-d355-31f6-8c4f-844601d0deb6",
                                        "glosses": [
                                            "Qui déplait, qui fatigue parce que cela est, ou semble, hors de propos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1af4693-0074-49e9-ac3a-582b1245277e",
                                                "sense_id": "a42fcad4-10ab-337c-a1b4-075c79fe3086",
                                                "text": "Flatteries importunes. — Questions importunes. — Arrivée importune. — D’importuns souvenirs. — La vérité lui est importune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89b895c6-b221-39f8-908f-47381716095d",
                                        "entry_id": "2dae8ac2-d355-31f6-8c4f-844601d0deb6",
                                        "glosses": [
                                            "ou Qui est insupportable par sa continuité, sa fréquence."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively",
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa6122f3-1a47-4c14-8c81-5dc0540a4c25",
                                                "sense_id": "89b895c6-b221-39f8-908f-47381716095d",
                                                "text": "Le fanon musculeux ballottait de droite et de gauche […], tandis que la queue vigilante voltigeait sans relâche alentour de leurs cuisses et de leurs flancs, chassant les taons assoiffés de sang et les mouches importunes."
                                            },
                                            {
                                                "example_id": "93c340d0-c9a3-47dc-9c10-d7b4a6cc4930",
                                                "sense_id": "89b895c6-b221-39f8-908f-47381716095d",
                                                "text": "Une pluie importune. — Il a un babil importun. — Ses fréquentes visites sont importunes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "importun",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a875937d-cf7e-3a78-9698-f601e711bf36",
                                        "entry_id": "42fb8681-d704-3379-a004-1f7057797a3e",
                                        "glosses": [
                                            "Celui qui importune"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cf63fdc-5691-461c-84a2-26359953ec1d",
                                                "sense_id": "a875937d-cf7e-3a78-9698-f601e711bf36",
                                                "text": "L’altiste a donné des coups de pied évoquant les ruades d’un mulet qui veut chasser un importun."
                                            },
                                            {
                                                "example_id": "ba72bb17-2569-426c-9d9e-33ba3dcce2f1",
                                                "sense_id": "a875937d-cf7e-3a78-9698-f601e711bf36",
                                                "text": "Un soir au coucher du soleil, assis auprès de son amie, au fond du verger, loin des importuns, il rêvait profondément."
                                            },
                                            {
                                                "example_id": "4ff5eb5b-9e88-456b-b9fc-890fc810a7b4",
                                                "sense_id": "a875937d-cf7e-3a78-9698-f601e711bf36",
                                                "text": "Il songe à faire défiler sous les yeux de ses spectateurs toutes sortes de types de fâcheux, c'est-à-dire d’importuns, de gêneurs, de raseurs, de barbeurs, — le nom change, selon l'époque — mais ce genre de personnage reste toujours « fâcheux »."
                                            },
                                            {
                                                "example_id": "ea49e68b-4478-4be3-a07b-4ea9df497504",
                                                "sense_id": "a875937d-cf7e-3a78-9698-f601e711bf36",
                                                "text": "Fort en train de travailler ce matin; quelques importuns me dérangent. Ne rangeons pas parmi ces derniers le très sympathique Pierre Cornu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "959d8d9c-c4f4-4d6d-8af1-19d57bc4070a",
                        "source_entry_id": "42a6aac9-2ade-38e5-a8b9-b1f12dc00549",
                        "source_sense_id": "76e0b0d1-0cd4-30cc-b107-158573bb229b",
                        "target_lang_word": "gêneur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gêneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d64fcb18-195f-3bbf-ba0d-365d6390986a",
                                        "entry_id": "8ced0eae-d34a-3f57-a5f1-da627f730036",
                                        "glosses": [
                                            "Celui qui est habituellement ou accidentellement gênant."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3e1ff34-2b33-4b8a-96ca-ed3b31b3bd57",
                                                "sense_id": "d64fcb18-195f-3bbf-ba0d-365d6390986a",
                                                "text": "C'est bon, je n'aime pas à jouer les gêneurs. Je vais faire un tour au foyer, pendant que tu diras ton couplet."
                                            },
                                            {
                                                "example_id": "943fb2e7-ab1d-4968-a419-8b4dcc4f2ede",
                                                "sense_id": "d64fcb18-195f-3bbf-ba0d-365d6390986a",
                                                "text": "Il songe à faire défiler sous les yeux de ses spectateurs toutes sortes de types de fâcheux, c'est-à-dire d’importuns, de gêneurs, de raseurs, de barbeurs, — le nom change, selon l'époque — mais ce genre de personnage reste toujours « fâcheux »."
                                            },
                                            {
                                                "example_id": "61398bf7-8c00-4ef3-b655-d904c5925364",
                                                "sense_id": "d64fcb18-195f-3bbf-ba0d-365d6390986a",
                                                "text": "Elle se montrait si ironique dans ses propos qu'elle était bien capable de lui gâcher le plaisir de la promenade. Aussitôt, il décida d'ignorer cette gêneuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69044d47-2be2-42cf-aa00-0b52dad3863c",
                        "source_entry_id": "42a6aac9-2ade-38e5-a8b9-b1f12dc00549",
                        "source_sense_id": "76e0b0d1-0cd4-30cc-b107-158573bb229b",
                        "target_lang_word": "нахал",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нахал",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5c90cf99-db38-3f4e-8747-b4041f6e244a",
                                        "entry_id": "0688d47d-2a9e-3c43-85aa-35b57ba487a6",
                                        "glosses": [
                                            "разг. беззастенчивый, грубо бесцеремонный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02b3ae04-e1e3-426f-83a9-c84ee674eb31",
                                                "sense_id": "5c90cf99-db38-3f4e-8747-b4041f6e244a",
                                                "text": "Я не желаю разговаривать с нахалами! Извольте убираться вон!"
                                            },
                                            {
                                                "example_id": "2601f327-b01e-4910-ad41-7f086c5e7053",
                                                "sense_id": "5c90cf99-db38-3f4e-8747-b4041f6e244a",
                                                "text": "Самое большое зло нашего времени, нашей культуры, что дураку и нахалу теперь везде ход, и он чувствует себя все равно как и гений, и нет средств никаких усмирить его."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
