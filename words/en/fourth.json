                            },
                            {
                                "target_lang_word": "четвёртая часть",
                                "target_lang_sense_clarification": "доля от целого"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57b615f7-2078-34c2-a596-54a756411118",
                    "sense_definition": "The person or thing in the fourth position.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need a <w>fourth</w> for our bridge game tonight.",
                            "target_lang_translations": {
                                "ru": "Нам нужен <w>четвёртый</w> для игры в бридж сегодня вечером."
                            }
                        },
                        {
                            "text": "The <w>fourth</w> from the left is the one I want to buy.",
                            "target_lang_translations": {
                                "ru": "<w>Четвёртый</w> слева — это тот, который я хочу купить."
                            }
                        }
                    ],
                    "common_phrases": [
