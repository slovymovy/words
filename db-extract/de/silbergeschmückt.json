                "senses": [
                    {
                        "sense_id": "e2f79b21-3143-374e-9ba2-1a8e3a390550",
                        "entry_id": "d8a532db-2d79-35dc-bc05-431c8020e21b",
                        "glosses": [
                            "(zur Verschönerung) mit Silber, Silberschmuck oder etwas Silberfarbenem versehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "960e6e68-b646-465a-976b-1dd7b5ef159b",
                                "sense_id": "e2f79b21-3143-374e-9ba2-1a8e3a390550",
                                "text": "„Schnellen Schrittes huscht lautlos ein Trupp Araber vorbei, sechs oder sieben gleiten vorüber, einer hinter dem anderen, wie in Säcke gekleidet, aber den vielfarbigen Turban kunstgerecht geschlungen und über dem elenden Gewande den Gürtel mit dem blitzenden, haarscharfen Krummdolch in silbergeschmückter Scheide.“"
                            },
                            {
                                "example_id": "22c8990a-aa05-4c7f-838f-2d59194c635e",
                                "sense_id": "e2f79b21-3143-374e-9ba2-1a8e3a390550",
                                "text": "„Der rieſige keltiſche Häuptling Viridomar, ein Ritter in gold- und ſilbergeſchmückter Rüſtung, war im Einzelkampfe von der Hand des Conſuls [Scipio] ſelbſt gefallen.“ [1879]"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
