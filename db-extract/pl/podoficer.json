                                        "entry_id": "812b3220-12da-3939-a6ab-981d166f34bd",
                                        "glosses": [
                                            "A person of authority in the military who has not received a commission (a direct conveyance of authority from the sovereign government); as such they can have charge or control but not command in the most technical use of the word."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb43f941-7c0f-45a8-ae2f-f2d4698f01f6",
                                                "sense_id": "b3051a18-4f86-3837-9911-3045a88ca726",
                                                "text": "A platoon sergeant may only be a non-commissioned officer but he's the one his men look to when the bullets start flying."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
