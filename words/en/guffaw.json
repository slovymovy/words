    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c56adc8f-48a6-3b76-998c-822e410db0d2",
                    "sense_definition": "A loud, boisterous laugh.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "laughter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian's joke was so funny that it triggered a loud <w>guffaw</w> from the entire audience.",
                            "target_lang_translations": {
                                "de": "Der Witz des Komikers war so lustig, dass er ein <w>schallendes Gelächter</w> beim gesamten Publikum auslöste."
                            }
                        },
                        {
                            "text": "He let out a sudden <w>guffaw</w> when he heard the ridiculous news.",
                            "target_lang_translations": {
                                "de": "Er stieß ein plötzliches <w>schallendes Lachen</w> aus, als er die lächerlichen Nachrichten hörte."
                            }
                        }
                    ],
                    "synonyms": [
                        "belly laugh"
                    ],
                    "common_phrases": [
                        "loud guffaw"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein lautes, ausgelassenes Lachen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schallendes Gelächter",
                                "target_lang_sense_clarification": "Bezeichnet ein lautes, herzhaftes Lachen."
                            },
                            {
                                "target_lang_word": "Lachsalve",
                                "target_lang_sense_clarification": "Ein plötzlicher, heftiger Ausbruch von Lachen."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
