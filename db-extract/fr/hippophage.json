                        "glosses": [
                            "Celui ou celle qui mange de la viande de cheval."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ae4fdae-7d7d-491a-9e2e-92ca5fe488bb",
                                "sense_id": "8ad70a24-ef6c-323c-95db-bf7ad0505ed1",
                                "text": "La viande de cheval commence, parait-il, à être goûtée comme elle le mérite : après les hippophages de Lyon, voici les hippophages de Paris. Un banquet a réuni ces derniers au Grand-Hôtel, […]."
                            },
                            {
                                "example_id": "09fd34c3-58c2-42d1-8e2f-7d03527932f0",
                                "sense_id": "8ad70a24-ef6c-323c-95db-bf7ad0505ed1",
                                "text": "Je vous l'ai dit au départ, seul était visé Dominique Valche, un hippophage cynique."
                            }
                        ]
                    }
