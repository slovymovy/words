                                            {
                                                "example_id": "ebaeabc3-8d17-4113-9d93-93a1c51870a5",
                                                "sense_id": "18641268-6e88-3713-914c-f790faf8110c",
                                                "text": "Now thinkes he that her husbands ſhallow tongue, / The niggard prodigall that praiſde her ſo: / In that high task hath done her Beauty wrong."
                                            },
                                            {
                                                "example_id": "c4237dbd-c045-4aa7-9389-c3f185c5fa94",
                                                "sense_id": "18641268-6e88-3713-914c-f790faf8110c",
                                                "text": "Change into extremity is very frequent and easy. As when a beggar suddenly grows rich, he commonly becomes a prodigal; for, to obscure his former obscurity, he puts on riot and excess."
                                            }
                                        ]
                                    }
