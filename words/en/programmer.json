{
    "word_family": [
        "program",
        "programmable",
        "programming",
        "reprogram",
        "programmatic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6cb91d1c-0ba8-3838-930f-ffe716803378",
                    "sense_definition": "A person who writes, tests, and maintains computer software or code.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing_profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>programmer</w> spent all night fixing a bug in the new application.",
                            "target_lang_translations": {
                                "ru": "<w>Программист</w> провел всю ночь, исправляя ошибку в новом приложении."
                            }
                        },
                        {
                            "text": "A skilled <w>computer</w> <w>programmer</w> can work with many different coding languages.",
                            "target_lang_translations": {
                                "ru": "Опытный компьютерный <w>программист</w> может работать со многими различными языками программирования."
                            }
                        }
                    ],
                    "synonyms": [
                        "coder#Noun",
                        "computer programmer"
                    ],
                    "common_phrases": [
                        "senior programmer",
                        "software programmer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который пишет, тестирует и поддерживает компьютерное программное обеспечение или код."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "программист",
                                "target_lang_sense_clarification": "специалист по разработке ПО"
                            },
                            {
                                "target_lang_word": "разработчик",
                                "target_lang_sense_clarification": "создатель программного обеспечения"
                            },
                            {
                                "target_lang_word": "кодер",
                                "target_lang_sense_clarification": "разговорное обозначение программиста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2632b461-6a11-3bd5-8275-c42ee529f0e7",
                    "sense_definition": "A person who selects and schedules content for a radio or television station.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "media_profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The radio <w>programmer</w> decided to play more classic rock during the morning show.",
                            "target_lang_translations": {
                                "ru": "Радио <w>программатор</w> решил ставить больше классического рока во время утреннего шоу."
                            }
                        },
                        {
                            "text": "A television <w>programmer</w> must understand what the audience wants to watch at night.",
                            "target_lang_translations": {
                                "ru": "Телевизионный <w>программный директор</w> должен понимать, что аудитория хочет смотреть по ночам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "radio programmer",
                        "television programmer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который отбирает и планирует контент для радио- или телестанции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "программный директор",
                                "target_lang_sense_clarification": "руководитель сетки вещания"
                            },
                            {
                                "target_lang_word": "программатор",
                                "target_lang_sense_clarification": "специалист по составлению программ эфира"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a98106e-88e6-303c-91c2-7bff1b33879d",
                    "sense_definition": "An electronic device used to set or control the operation of another machine, such as a boiler or a chip.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "control_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can set the heating <w>programmer</w> to turn on the boiler at six in the morning.",
                            "target_lang_translations": {
                                "ru": "Вы можете настроить отопительный <w>программатор</w>, чтобы он включал котел в шесть утра."
                            }
                        },
                        {
                            "text": "The technician used an EPROM <w>programmer</w> to upload the data to the chip.",
                            "target_lang_translations": {
                                "ru": "Техник использовал <w>программатор</w> EPROM для загрузки данных в микросхему."
                            }
                        }
                    ],
                    "common_phrases": [
                        "heating programmer",
                        "central heating programmer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Электронное устройство, используемое для настройки или управления работой другой машины, например, котла или микросхемы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "программатор",
                                "target_lang_sense_clarification": "устройство для записи данных или управления режимами"
                            },
                            {
                                "target_lang_word": "контроллер",
                                "target_lang_sense_clarification": "устройство управления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49f18176-e3d7-308e-94c8-10d6a6f2914b",
                    "sense_definition": "A low-budget film produced to fill out a double feature or a specific time slot in a cinema program.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "film_industry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the golden age of Hollywood, a <w>programmer</w> was often shown before the main feature.",
                            "target_lang_translations": {
                                "ru": "В золотой век Голливуда перед основным фильмом часто показывали <w>проходную картину</w>."
                            }
                        },
                        {
                            "text": "The studio produced this cheap <w>programmer</w> just to keep the theaters busy.",
                            "target_lang_translations": {
                                "ru": "Студия выпустила этот дешевый <w>фильм-заполнитель</w> только для того, чтобы занять кинотеатры."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical cinema practices"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Малобюджетный фильм, созданный для заполнения двойного сеанса или определенного временного интервала в программе кинотеатра."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проходной фильм",
                                "target_lang_sense_clarification": "второстепенная кинокартина для заполнения эфира"
                            },
                            {
                                "target_lang_word": "фильм категории B",
                                "target_lang_sense_clarification": "малобюджетное кино"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}