                    {
                        "sense_id": "f3af4728-85cd-3813-9204-c304c87deeea",
                        "entry_id": "ce27320c-6864-3c54-ba3e-b42218166eb3",
                        "glosses": [
                            "Espèce de grand singe d’Indonésie, de la famille des gibbons ; individu de cette espèce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ece0c03-1b72-4f78-8b6e-758f74d07ade",
                                "sense_id": "f3af4728-85cd-3813-9204-c304c87deeea",
                                "text": "Les siamangs, grands singes noirs, au poil irisé comme des moutons d’Astrakan, aux bras énormes, troublent seuls de leurs cris mélancoliques le silence des hautes futaies."
                            },
                            {
                                "example_id": "e7b9ac08-5ff4-4c68-941e-4e3f0b581a80",
                                "sense_id": "f3af4728-85cd-3813-9204-c304c87deeea",
                                "text": "Les siamangs ont conservé une taille analogue chez les deux sexes, ce sont les plus grands de tous les gibbons. Ils ont acquis un sac laryngé qui sert de caisse de résonance et augmente la portée des cris."
                            }
                        ]
                    }
                ],
