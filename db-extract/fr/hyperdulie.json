                                    {
                                        "sense_id": "e044e9bd-55f8-3f50-8c8f-6895be768a96",
                                        "entry_id": "ac392b70-fe37-33fe-be56-7c4c61723114",
                                        "glosses": [
                                            "A level of veneration higher than dulia but less than latria, properly given to the Virgin Mary only."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee805f93-e49a-4714-935b-9004434eb106",
                                                "sense_id": "e044e9bd-55f8-3f50-8c8f-6895be768a96",
                                                "text": "By the thirteenth century, the growth of devotion to Mary, the Mother of God, in both East and West led John of Damascus's admirer Thomas Aquinas to formalize a further refinement: the concept of an exceptional sort of veneration, hyperdulia, offered only to the greatest of God's creations, Mary, the mother of Jesus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
