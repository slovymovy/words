                            "Rhône-Alpes",
                            "Lorraine"
                        ],
                        "examples": [
                            {
                                "example_id": "5b04ff4e-ebc4-4cab-b1c0-004a6bd34fad",
                                "sense_id": "74d3d657-6f69-301b-a358-128defa82a72",
                                "text": "Envoyer, lancer des fions : faire des allusions ou des remarques désagréables."
                            },
                            {
                                "example_id": "6843d317-ef9f-4d37-9aea-2c6b6efc860d",
                                "sense_id": "74d3d657-6f69-301b-a358-128defa82a72",
                                "text": "Si Monsieur et Madame préfèrent s’envoyer des fions dans l’intimité, je peux aussi me retirer."
                            }
                        ]
                    },
