                "senses": [
                    {
                        "sense_id": "c4bf3f9a-1c69-328d-90a9-eee373dc0828",
                        "entry_id": "5bf35cc2-d01f-3134-a465-65b3e19854b4",
                        "glosses": [
                            "Qualité de ce qui est limpide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f05e344b-9d48-4fad-aa53-9ef86d54ebd6",
                                "sense_id": "c4bf3f9a-1c69-328d-90a9-eee373dc0828",
                                "text": "La limpidité du style, de la pensée."
                            },
                            {
                                "example_id": "47b01ed5-5652-40e5-aac7-3d9a0593e8ab",
                                "sense_id": "c4bf3f9a-1c69-328d-90a9-eee373dc0828",
                                "text": "Sur la rive droite, les affluents les plus importants […] présentent sensiblement les mêmes caractères que la Lanterne au double point de vue de la limpidité des eaux et de leur minéralisation."
                            },
                            {
                                "example_id": "613e5f8a-56fc-4038-be30-f5f03086b9b2",
                                "sense_id": "c4bf3f9a-1c69-328d-90a9-eee373dc0828",
                                "text": "Dans le fond, au-dessus du vilain toit de tuiles rondes, qui a remplacé les poutres de cèdre et les tuiles dorées de la toiture arabe, s’élève majestueusement la tour de Comares, dont les créneaux découpent leurs dentelures vermeilles dans l’admirable limpidité du ciel."
                            }
                        ]
                    }
                ],
                "translations": [
