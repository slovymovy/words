                        "glosses": [
                            "een zeilvaartuig zonder verdek, sterk gelijkend op de Arabische dhow"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "877d1d4a-7ad0-4158-8554-9c360b3764d6",
                                "sense_id": "d27f922c-3b30-30ff-a7b1-2b9e5bc81f4d",
                                "text": "Zowel op de Nijl als op de Arabische Zee zijn feloeken aan te treffen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ef269ba-6fc8-41e4-8b03-7f6a560b399d",
                        "source_entry_id": "c2b9a5f3-8cbb-3d22-840e-a03fdff98f7d",
                        "source_sense_id": "d27f922c-3b30-30ff-a7b1-2b9e5bc81f4d",
