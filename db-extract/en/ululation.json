                        "target_lang_word": "улюлю́канье",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "улюлю́канье",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "de224f46-7686-3358-a03d-35a9d5e4fb18",
                                        "entry_id": "0c2c434e-0272-3f99-a4ab-353e68c73b88",
                                        "glosses": [
                                            "поэт. и разг. то же, что улюлюкание; действие по значению гл. улюлюкать"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bcf75866-6a75-3198-bdca-fd3256d377c0",
                                        "entry_id": "0c2c434e-0272-3f99-a4ab-353e68c73b88",
                                        "glosses": [
                                            "поэт. и разг. то же, что улюлюкание; звуки, возникающие в процессе такого действия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65c4f89a-26d8-466d-885d-c2f50526d196",
                                                "sense_id": "bcf75866-6a75-3198-bdca-fd3256d377c0",
                                                "text": "И только потом, когда Ельцин пошёл к выходу, в спину ему понеслись улюлюканье, свист и разного рода зловонные возгласы."
                                            },
                                            {
                                                "example_id": "394ac9c6-0986-49b3-bbf7-a9028ee23013",
                                                "sense_id": "bcf75866-6a75-3198-bdca-fd3256d377c0",
                                                "text": "Старому Мартину пришлось-таки ретироваться во дворец, под смех и улюлюканье толпы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
