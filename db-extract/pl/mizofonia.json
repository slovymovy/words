                    {
                        "translation_id": "c18b7553-6e3d-4613-a403-fe11e4b9d16f",
                        "source_entry_id": "8680a3e6-e814-3efd-be43-a210f38102df",
                        "source_sense_id": "c9b92db2-9f29-371f-8e86-2a276ab0861a",
                        "target_lang_word": "Misophonie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Misophonie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2090afea-18c9-38f3-bad1-45086ce6ef4e",
                                        "entry_id": "fc287865-5bce-3195-892c-53cfaf1770a5",
                                        "glosses": [
                                            "verminderte Geräuschtoleranz gegenüber bestimmten, insbesondere von Menschen verursachten, Geräuschen"
                                        ],
                                        "tags": [
                                            "Psychiatrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af5240ad-9d56-4b3b-942d-7f3612a63fc2",
                                                "sense_id": "2090afea-18c9-38f3-bad1-45086ce6ef4e",
                                                "text": "Es hatte Jahre gedauert, bis er herausfand, dass er selbst an Misophonie litt: Er hasste Kau- und Essgeräusch, Niesen und Schniefen, manchmal sogar das Atmen, ganz gleich, wer es fabrizierte."
                                            },
                                            {
                                                "example_id": "6f80dbb3-6006-43f1-b81b-eca8b98e3528",
                                                "sense_id": "2090afea-18c9-38f3-bad1-45086ce6ef4e",
                                                "text": "Generell ist Misophonie ein extremer Beziehungskiller."
                                            },
                                            {
                                                "example_id": "69253aa8-892f-4b23-9c58-0e6bd8ed953d",
                                                "sense_id": "2090afea-18c9-38f3-bad1-45086ce6ef4e",
                                                "text": "Im Alltag begegnen uns ständig irgendwelche Geräusche. Was für die meisten Menschen nicht weiter schlimm ist, ist für Menschen die unter Misophonie leiden extrem belastend."
                                            },
                                            {
                                                "example_id": "fff450b6-5dcb-4796-a33a-548b413ac832",
                                                "sense_id": "2090afea-18c9-38f3-bad1-45086ce6ef4e",
                                                "text": "Das Amsterdamer Institut ist europaweit der einzige Ort, der Behandlungen anbietet und Misophonie als eine Krankheit anerkennt."
                                            },
                                            {
                                                "example_id": "43ad5dd7-06a8-40d8-a35c-06dad51fe66e",
                                                "sense_id": "2090afea-18c9-38f3-bad1-45086ce6ef4e",
                                                "text": "Forscher des AMC veröffentlichten 2013 zwar einen Diagnosebericht zur Misophonie, dieser wird jedoch weder in den Registern des DSM-5 noch im ICD-10 erwähnt."
                                            },
                                            {
                                                "example_id": "ad3371ad-8d2b-4ba7-bde2-7d16f97e51b8",
                                                "sense_id": "2090afea-18c9-38f3-bad1-45086ce6ef4e",
                                                "text": "Je nach Schwere der Erkrankung sind mehrere Hypnosesitzungen nötig, um Misophonie in den Griff zu bekommen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
