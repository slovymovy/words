                "senses": [
                    {
                        "sense_id": "d8b5f83e-bd43-3758-b1dc-d9ba6efe40f4",
                        "entry_id": "4a3aa033-1f73-3386-9cb2-eecea349d7a3",
                        "glosses": [
                            "iemand bij de politie die misdaden door speurwerk opheldert"
                        ],
                        "tags": [
                            "beroep",
                            "oorspronkelijke betekenis"
                        ],
                        "examples": [
                            {
                                "example_id": "3df31e3c-aefa-4183-8492-502f274061d6",
                                "sense_id": "d8b5f83e-bd43-3758-b1dc-d9ba6efe40f4",
                                "text": "De detective arresteerde de moordenaar na twee jaar onderzoek."
                            }
                        ]
                    },
                    {
                        "sense_id": "01fd537f-975e-3926-94b4-c0267433fc08",
                        "entry_id": "4a3aa033-1f73-3386-9cb2-eecea349d7a3",
                        "glosses": [
                            "speurder die tracht misdaden op te lossen of bewijsmateriaal te verzamelen"
                        ],
                        "tags": [
                            "beroep",
                            "algemeen"
                        ],
                        "examples": [
                            {
                                "example_id": "5cd26e20-3ce0-4771-b4bd-2b13ac4ec03e",
                                "sense_id": "01fd537f-975e-3926-94b4-c0267433fc08",
                                "text": "Het vrouw huurde een detective in om de ontrouw van haar man te bewijzen."
                            }
                        ]
                    },
                    {
                        "sense_id": "82fd8a17-40d6-34b2-b420-6ff987333f2e",
                        "entry_id": "4a3aa033-1f73-3386-9cb2-eecea349d7a3",
                        "glosses": [
                            "boek of programma over mensen die trachten misdaden op te lossen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8c4ca18-a2da-4cc3-8cb2-c9e3a52388cb",
                                "sense_id": "82fd8a17-40d6-34b2-b420-6ff987333f2e",
                                "text": "Hij zat een detective te lezen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f7398e5-3ae4-49b2-a654-82fb49a0ceeb",
                        "source_entry_id": "4a3aa033-1f73-3386-9cb2-eecea349d7a3",
                        "source_sense_id": "01fd537f-975e-3926-94b4-c0267433fc08",
                        "source_sense_description": "speurder die tracht misdaden op te lossen of bewijsmateriaal te verzamelen",
                        "target_lang_word": "Detektiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Detektiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f37c4b76-7d9a-3bbd-9189-68094b8ebdb7",
                                        "entry_id": "6fb164bd-cced-37d4-9e94-49365d17b5c7",
                                        "glosses": [
                                            "(meist privater) Ermittler, der nach Beweismitteln für etwas sucht"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24e29ca4-198e-4b04-a42d-47b8ddcd3f40",
                                                "sense_id": "f37c4b76-7d9a-3bbd-9189-68094b8ebdb7",
                                                "text": "Wir sollten zuerst einen Detektiv beauftragen, bevor wir die Polizei einschalten."
                                            },
                                            {
                                                "example_id": "731a2371-6134-4a6b-86d9-e67e9d7ab8ad",
                                                "sense_id": "f37c4b76-7d9a-3bbd-9189-68094b8ebdb7",
                                                "text": "„Ich war ein Detektiv, der für nichts eine Lösung fand.“"
                                            },
                                            {
                                                "example_id": "deade15d-ee13-4873-ba52-7bd1615b26e3",
                                                "sense_id": "f37c4b76-7d9a-3bbd-9189-68094b8ebdb7",
                                                "text": "„Zwei Schutzleute bewachten das schmale Pförtchen, aber sie ließen mich mit dem Hund passieren, als ich des Detektivs Namen nannte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "309bd3aa-1410-42c8-973b-142bcafc8e93",
                        "source_entry_id": "4a3aa033-1f73-3386-9cb2-eecea349d7a3",
                        "source_sense_id": "01fd537f-975e-3926-94b4-c0267433fc08",
                        "source_sense_description": "speurder die tracht misdaden op te lossen of bewijsmateriaal te verzamelen",
                        "target_lang_word": "detective",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "detective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac0d7032-d2cc-3404-8d9d-6fc8db137537",
                                        "entry_id": "779c07ee-4176-3f33-b3d8-4d57a7797c7e",
                                        "glosses": [
                                            "A police officer tasked with collecting evidence and information in order to solve a crime; an investigator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e666d4b6-86fc-4c54-ac7f-d5ce987d4b23",
                                                "sense_id": "ac0d7032-d2cc-3404-8d9d-6fc8db137537",
                                                "text": "He worked as a detective with the agency for five years."
                                            },
                                            {
                                                "example_id": "8c672101-edfe-487c-b534-c0b93d831170",
                                                "sense_id": "ac0d7032-d2cc-3404-8d9d-6fc8db137537",
                                                "text": "The detective kept them in view. He made his way casually along the inside of the shelter until he reached an open scuttle close to where the two men were standing talking. Eavesdropping was not a thing Larard would have practised from choice, but there were times when, in the public interest, he had to do it, and this was one of them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ed320a4-b114-3fda-8cb2-b0edf5071157",
                                        "entry_id": "779c07ee-4176-3f33-b3d8-4d57a7797c7e",
                                        "glosses": [
                                            "A person employed to find information not otherwise available to the public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "731c8447-2ae4-4687-8444-fb8d144bad78",
                                                "sense_id": "9ed320a4-b114-3fda-8cb2-b0edf5071157",
                                                "text": "[…] Sherlock Holmes remarked calmly. […] \"Well, I have a trade of my own. I suppose I am the only one in the world. I'm a consulting detective, if you can understand what that is. Here in London we have lots of Government detectives and lots of private ones. When these fellows are at fault they come to me, and I manage to put them on the right scent. They lay all the evidence before me, and I am generally able, by the help of my knowledge of the history of crime, to set them straight. There is a strong family resemblance about misdeeds, and if you have all the details of a thousand at your finger ends, it is odd if you can't unravel the thousand and first.[…]\""
                                            },
                                            {
                                                "example_id": "ab590508-4839-40b0-bc94-30ddd0c2c236",
                                                "sense_id": "9ed320a4-b114-3fda-8cb2-b0edf5071157",
                                                "text": "Had they responded this way in France or America, this wouldn't have surprised me, but wasn't everyone in England supposed to be a detective? Wasn't every crime, no matter how complex, solved in a timely fashion by either a professional or a hobbyist? That's the impression you get from British books and TV shows. Sherlock Holmes, Miss Marple, Hetty Wainthropp, Inspector George Gently: they come from every class and corner of the country. There’s even Edith Pargeter's Brother Cadfael, a Benedictine monk who solved crimes in twelfth-century Shrewsbury. No surveillance cameras, no fingerprints, not even a telephone, and still he cracked every case that came his way."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "detective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c024667-c8d4-323c-b8c2-032947f6a4a3",
                                        "entry_id": "d11b29b5-19f6-3c2e-a199-3bc07730f717",
                                        "glosses": [
                                            "Employed in detecting."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
