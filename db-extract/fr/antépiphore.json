                        "glosses": [
                            "Figure de style qui consiste en une répétition d’un même groupe de mots (ou d’un même vers) au début et à la fin d’un paragraphe (ou d’une strophe)."
                        ],
                        "tags": [
                            "rhetoric"
                        ],
                        "examples": [
                            {
                                "example_id": "ca553599-3d13-4bd8-9737-9d71f74b9b4a",
                                "sense_id": "afcd93ff-9344-384a-a5d7-bea3f172dcfc",
                                "text": "L’antépiphore permet, d’attirer l’attention, de mettre une idée en valeur."
                            },
                            {
                                "example_id": "9eb4f74a-616f-4b2f-9d77-800b075a21d1",
                                "sense_id": "afcd93ff-9344-384a-a5d7-bea3f172dcfc",
                                "text": "Onze ans cela fait déjà onze ans"
                            },
                            {
                                "example_id": "98105627-61a5-456f-933b-9d972fc4ed29",
                                "sense_id": "afcd93ff-9344-384a-a5d7-bea3f172dcfc",
                                "text": "Il a fermé ses yeux, car au loin, de la ville,\nLes vierges, en chantant, d’un pas lent et tranquille.\nVenaient ; il entrevoit le chœur religieux,\nC’est pourquoi, plein de crainte, il a fermé ses yeux."
                            }
                        ]
                    }
