                "senses": [
                    {
                        "sense_id": "7848f852-db71-3ff9-bc07-acab9c011d4f",
                        "entry_id": "1e037ae2-3897-3ba9-aba6-b99f5f057e1c",
                        "glosses": [
                            "an einer Stadtmauer/Schlossmauer angefügter überdachter Weg, auf dem die Verteidiger stehen konnten"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "d15c5967-ce39-4a7c-98a9-4981577cac42",
                                "sense_id": "7848f852-db71-3ff9-bc07-acab9c011d4f",
                                "text": "„Bei schönem Wetter wird das Frühstück auf dem Wehrgang der Burgmauer serviert.“"
                            },
                            {
                                "example_id": "20e8efb5-cbe8-4b7e-aa4a-97d283c98e0a",
                                "sense_id": "7848f852-db71-3ff9-bc07-acab9c011d4f",
                                "text": "„Zwischen ihnen verlief der Wehrgang, auf dem bewaffnete Posten patrouillierten.“"
                            },
                            {
                                "example_id": "d389353e-386c-412f-b5a1-b89b5ef9c2b3",
                                "sense_id": "7848f852-db71-3ff9-bc07-acab9c011d4f",
                                "text": "„War der Burgherr in Fehde und hatte gerade Waffenknechte angeheuert, wurde auf den Wehrgängen ›patrouilliert‹.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
