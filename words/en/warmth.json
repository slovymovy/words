                                "es": "Su sonrisa estaba llena de <w>calidez</w> y comprensión.",
                                "nl": "Haar glimlach was vol <w>warmte</w> en begrip.",
                                "pl": "Jej uśmiech był pełen <w>ciepła</w> i zrozumienia.",
                                "de": "Ihr Lächeln war voller <w>Wärme</w> und Verständnis.",
                                "fr": "Son sourire était plein de <w>chaleur</w> et de compréhension.",
                                "it": "Il suo sorriso era pieno di <w>calore</w> e comprensione.",
                                "cs": "Její úsměv byl plný <w>vřelosti</w> a pochopení.",
                                "tr": "Gülümsemesi <w>sıcaklık</w> ve anlayış doluydu."
                            }
