                                "target_senses": [
                                    {
                                        "sense_id": "61f430e5-c848-33d6-9fb3-3c4508652e2d",
                                        "entry_id": "a5c41f43-0707-3709-8d77-47b311cf0ac4",
                                        "glosses": [
                                            "To finish; to make done; to reach the end."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcc1e400-d1fd-4fec-8911-355d353fcbf2",
                                                "sense_id": "61f430e5-c848-33d6-9fb3-3c4508652e2d",
                                                "text": "He completed the assignment on time."
                                            },
                                            {
                                                "example_id": "c692b001-75d5-4f18-ad59-58612868fe61",
                                                "sense_id": "61f430e5-c848-33d6-9fb3-3c4508652e2d",
                                                "text": "How far are you willing to reach?\n While you're coveting outcomes that you can't achieve\n Now you're on a mission, but you won't complete\n Shouldn't hold on to me, hold on to me\n Try to let go of me, let go of me"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21380046-56a3-3458-bca8-cc4f6cbf3f14",
                                        "entry_id": "a5c41f43-0707-3709-8d77-47b311cf0ac4",
                                        "glosses": [
                                            "To make whole or entire."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a5e1743-a781-40af-a88a-79ddf4bb0927",
                                                "sense_id": "21380046-56a3-3458-bca8-cc4f6cbf3f14",
                                                "text": "The last chapter completes the book nicely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2df3d079-f137-3581-ab4e-c8191bd7c998",
                                        "entry_id": "a5c41f43-0707-3709-8d77-47b311cf0ac4",
                                        "glosses": [
                                            "To call from the small blind in an unraised pot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "complete",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03e34b02-804e-37e4-87a8-8d6d71d8c272",
                                        "entry_id": "ce9533ba-5e62-39fb-b58f-18e3e0768105",
                                        "glosses": [
                                            "With all parts included; with nothing missing; full."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89bbaf31-ffcb-423d-9f07-cfd91be1eec8",
                                                "sense_id": "03e34b02-804e-37e4-87a8-8d6d71d8c272",
                                                "text": "My life will be complete once I buy this new television."
                                            },
                                            {
                                                "example_id": "3f71b96e-2d67-49c7-b82b-2620f1781bfd",
                                                "sense_id": "03e34b02-804e-37e4-87a8-8d6d71d8c272",
                                                "text": "She offered me complete control of the project."
                                            },
                                            {
                                                "example_id": "cc93003a-109a-434e-9656-0e187d00885e",
                                                "sense_id": "03e34b02-804e-37e4-87a8-8d6d71d8c272",
                                                "text": "After she found the rook, the chess set was complete."
                                            },
                                            {
                                                "example_id": "ca75730a-d97b-4067-9ec8-bf6023529144",
                                                "sense_id": "03e34b02-804e-37e4-87a8-8d6d71d8c272",
                                                "text": "[…]and two enormous Scottish poems, the Buik of Alexander, which has been improbably ascribed to Barbour, and Sir Gilbert Hay's Buik of Alexander the Conquerour; one nearly complete Prose Life of Alexander and fragments of four others; a stanzaic translation of the Fuerres de Gadres which survives only in a fragment, the Romance of Cassamus, and three separate translations of the Secreta Secretorum."
                                            },
                                            {
                                                "example_id": "f52ed4d3-08d8-4e40-a93c-f75c45327426",
                                                "sense_id": "03e34b02-804e-37e4-87a8-8d6d71d8c272",
                                                "text": "Creating a complete map of the human connectome would therefore be a monumental milestone but not the end of the journey to understanding how our brains work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac44245b-6259-3009-833c-2fe00dbf77f2",
                                        "entry_id": "ce9533ba-5e62-39fb-b58f-18e3e0768105",
                                        "glosses": [
                                            "Finished; ended; concluded; completed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5829bd2-4a20-4829-8fa4-9aa54084155b",
                                                "sense_id": "ac44245b-6259-3009-833c-2fe00dbf77f2",
                                                "text": "When your homework is complete, you can go and play with Martin."
                                            },
                                            {
                                                "example_id": "d1aeb964-4c56-4494-9d02-6f90d9d43e2a",
                                                "sense_id": "ac44245b-6259-3009-833c-2fe00dbf77f2",
                                                "text": "In the eyes of Mr. Farquhar Fenelon Cooke the apotheosis of the Celebrity was complete. The people of Asquith were not only willing to attend the house-warming, but had been worked up to the pitch of eagerness. The Celebrity as a matter of course was master of ceremonies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "633143a9-941c-3932-8319-ae47f24c5810",
                                        "entry_id": "ce9533ba-5e62-39fb-b58f-18e3e0768105",
                                        "glosses": [
                                            "Generic intensifier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e3f3dc9-7b38-43a0-bde3-647a93387568",
                                                "sense_id": "633143a9-941c-3932-8319-ae47f24c5810",
                                                "text": "He is a complete bastard!"
                                            },
                                            {
                                                "example_id": "a831b447-c4d8-47eb-9256-e0a172c2a67a",
                                                "sense_id": "633143a9-941c-3932-8319-ae47f24c5810",
                                                "text": "It was a complete shock when he turned up on my doorstep."
                                            },
                                            {
                                                "example_id": "b1324e32-6e52-4225-b39a-b457cfad889b",
                                                "sense_id": "633143a9-941c-3932-8319-ae47f24c5810",
                                                "text": "Our vacation was a complete disaster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f22b1cb-ad0f-36bb-b0f2-e195f11ed6a8",
                                        "entry_id": "ce9533ba-5e62-39fb-b58f-18e3e0768105",
                                        "glosses": [
                                            "In which every Cauchy sequence converges to a point within the space."
                                        ],
                                        "tags": [
                                            "of a metric space or topological group"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef678d60-8869-372b-ac6f-d5c7b0febbd7",
                                        "entry_id": "ce9533ba-5e62-39fb-b58f-18e3e0768105",
                                        "glosses": [
                                            "Complete as a topological group with respect to its m-adic topology, where m is its unique maximal idea."
                                        ],
                                        "tags": [
                                            "of a local ring"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "830b4629-668b-3bdf-b589-49cf0d64d06b",
                                        "entry_id": "ce9533ba-5e62-39fb-b58f-18e3e0768105",
                                        "glosses": [
                                            "In which every set with a lower bound has a greatest lower bound."
                                        ],
                                        "tags": [
                                            "of a lattice"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "91ffae4e-a588-3632-bc65-39303f46e43c",
                                        "entry_id": "ce9533ba-5e62-39fb-b58f-18e3e0768105",
                                        "glosses": [
                                            "In which all small limits exist."
                                        ],
                                        "tags": [
                                            "of a category"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90e87e5c-77de-3dfd-bb59-b04cc7ad9f3e",
                                        "entry_id": "ce9533ba-5e62-39fb-b58f-18e3e0768105",
                                        "glosses": [
                                            "In which every semantically valid well-formed formula is provable."
                                        ],
                                        "tags": [
                                            "of a proof system of a formal system with respect to a given semantics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d982e26a-b427-4789-b2cf-38a09dbdabb2",
                                                "sense_id": "90e87e5c-77de-3dfd-bb59-b04cc7ad9f3e",
                                                "text": "Gödel's first incompleteness theorem showed that Principia could not be both consistent and complete. According to the theorem, for every sufficiently powerful logical system (such as Principia), there exists a statement G that essentially reads, \"The statement G cannot be proved.\" Such a statement is a sort of Catch-22: if G is provable, then it is false, and the system is therefore inconsistent; and if G is not provable, then it is true, and the system is therefore incomplete.ᵂᴾ"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0ee11e4-ebab-34c1-8af0-746b1b0f6fc8",
                                        "entry_id": "ce9533ba-5e62-39fb-b58f-18e3e0768105",
                                        "glosses": [
                                            "That is in a given complexity class and is such that every other problem in the class can be reduced to it (usually in polynomial time or logarithmic space)."
                                        ],
                                        "tags": [
                                            "of a problem"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "537fe31b-3440-46ee-9bf1-292132a15fd0",
                                                "sense_id": "d0ee11e4-ebab-34c1-8af0-746b1b0f6fc8",
                                                "text": "QMA arises naturally in the study of quantum computation, and it also has a complete problem, Local Hamiltonian, which is a generalization of k-SAT."
                                            },
                                            {
                                                "example_id": "f648a60e-78a8-4707-98e8-562764d36358",
                                                "sense_id": "d0ee11e4-ebab-34c1-8af0-746b1b0f6fc8",
                                                "text": "BPP behaves differently in some ways from other classes we have seen. For example, we know of no complete languages for BPP."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "complete",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d1ea27c-0be8-3c1b-9a42-fa1baa011bd9",
                                        "entry_id": "95a8de02-b31e-3370-b89c-f6b0fa231f5d",
                                        "glosses": [
                                            "A completed survey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e18fc226-ed0d-46e0-b665-db1d0d7b9640",
                                                "sense_id": "4d1ea27c-0be8-3c1b-9a42-fa1baa011bd9",
                                                "text": "“If SSI says we're going to get two completes an hour, the sample will yield two Qualifieds to do the survey with us.”"
                                            },
                                            {
                                                "example_id": "c0a89617-4786-4e5d-bd19-985fd7a18f94",
                                                "sense_id": "4d1ea27c-0be8-3c1b-9a42-fa1baa011bd9",
                                                "text": "…our market research professionals continue to advise us that providing the level of detail necessary to customize to each typical customer type would require the survey to be too lengthy and it would be difficult to get enough completes."
                                            },
                                            {
                                                "example_id": "da5c0058-ed0f-45c7-bc1c-d8ed4d17785a",
                                                "sense_id": "4d1ea27c-0be8-3c1b-9a42-fa1baa011bd9",
                                                "text": "2016, \"Perceptions of Oral Cancer Screenings Compared to Other Cancer Screenings: A Pilot Study\", thesis for Idaho State University by M. Colleen Stephenson.\n“Don’t get discouraged if you’re on a job that is difficult to get completes on! Everyone else on the job is most likely struggling, and there will be easier surveys that you will dial on.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
