{
    "word_family": [
        "premiere",
        "premiership"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4d1df891-a86f-3673-b4d4-fe4e63710dd9",
                    "sense_definition": "First in status, rank, importance, or quality; foremost.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "rank_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel is known as the <w>premier</w> destination for luxury travelers in the region.",
                            "target_lang_translations": {
                                "ru": "Этот отель известен как <w>лучшее</w> место для роскошного отдыха в регионе.",
                                "zh": "这家酒店被公认为该地区豪华旅客的<w>首选</w>目的地。"
                            }
                        },
                        {
                            "text": "She plays for the country's <w>premier</w> soccer team and has won many awards.",
                            "target_lang_translations": {
                                "ru": "Она играет за <w>ведущую</w> футбольную команду страны и завоевала множество наград.",
                                "zh": "她效力于该国<w>一流</w>的足球队，并赢得了许多奖项。"
                            }
                        }
                    ],
                    "antonyms": [
                        "secondary",
                        "minor",
                        "inferior"
                    ],
                    "common_phrases": [
                        "premier league",
                        "premier division",
                        "premier destination",
                        "world's premier"
                    ],
                    "target_lang_definitions": {
                        "ru": "Первый по статусу, рангу, важности или качеству; ведущий.",
                        "zh": "在地位、等级、重要性或质量上居于首位；最重要的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ведущий",
                                "target_lang_sense_clarification": "занимающий первое место, главный"
                            },
                            {
                                "target_lang_word": "первоклассный",
                                "target_lang_sense_clarification": "высшего качества"
                            },
                            {
                                "target_lang_word": "главный",
                                "target_lang_sense_clarification": "основной, важнейший"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "首屈一指",
                                "target_lang_sense_clarification": "居于第一位，最好的"
                            },
                            {
                                "target_lang_word": "一流",
                                "target_lang_sense_clarification": "最高等级或质量"
                            },
                            {
                                "target_lang_word": "主要",
                                "target_lang_sense_clarification": "最重要的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b47e4cf-b98b-3a88-b2e2-bc2855a2f90d",
                    "sense_definition": "Earliest in time or order; most ancient.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "rank_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historian wrote a book about the <w>premier</w> barons of the medieval kingdom.",
                            "target_lang_translations": {
                                "ru": "Историк написал книгу о <w>первых</w> баронах средневекового королевства.",
                                "zh": "这位历史学家写了一本关于中世纪王国<w>最初</w>几位男爵的书。"
                            }
                        },
                        {
                            "text": "He holds the title of the <w>premier</w> duke due to his family's long lineage.",
                            "target_lang_translations": {
                                "ru": "Он носит титул <w>первого</w> герцога благодаря древности своего рода.",
                                "zh": "由于家族历史悠久，他拥有<w>最古老</w>公爵的头衔。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly used in historical or heraldic contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Самый ранний по времени или порядку; старейший.",
                        "zh": "在时间或顺序上最早的；最古老的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "первый",
                                "target_lang_sense_clarification": "по времени возникновения или порядку"
                            },
                            {
                                "target_lang_word": "старейший",
                                "target_lang_sense_clarification": "самый древний"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最初",
                                "target_lang_sense_clarification": "时间上最早的"
                            },
                            {
                                "target_lang_word": "最古老",
                                "target_lang_sense_clarification": "历史最悠久的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "54b8e69b-a639-3bb7-91e4-7d484a18b8a3",
                    "sense_definition": "The head of the government of a province or state, or the prime minister of a country.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "political_leader",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>premier</w> announced a new budget plan to improve public schools.",
                            "target_lang_translations": {
                                "ru": "<w>Премьер-министр</w> объявил о новом бюджетном плане для улучшения государственных школ.",
                                "zh": "<w>总理</w>宣布了一项旨在改善公立学校的新预算计划。"
                            }
                        },
                        {
                            "text": "She served as <w>premier</w> of the province for two consecutive terms.",
                            "target_lang_translations": {
                                "ru": "Она служила <w>премьером</w> провинции два срока подряд.",
                                "zh": "她连续两届担任该省<w>省长</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prime minister",
                        "first minister"
                    ],
                    "common_phrases": [
                        "state premier",
                        "deputy premier",
                        "former premier"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глава правительства провинции, штата или премьер-министр страны.",
                        "zh": "省、州政府的首脑，或国家的总理。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "премьер-министр",
                                "target_lang_sense_clarification": "глава правительства страны"
