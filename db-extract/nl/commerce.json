                "forms": [],
                "senses": [
                    {
                        "sense_id": "fbefd4fa-d294-3607-8935-49f3113c4c6d",
                        "entry_id": "2d2b5e82-8b72-3b07-b883-9e028740b5af",
                        "glosses": [
