                "senses": [
                    {
                        "sense_id": "40b1e5a6-86ca-3484-84b0-5c32e0da4b64",
                        "entry_id": "0d97c939-be0a-39f7-a2c5-47bc85cfa238",
                        "glosses": [
                            "Faire revenir (un téléphone portable) à sa version de base, sans la surcouche rajoutée par un opérateur téléphonique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6cc74cf-1de6-4311-96f7-7cd058ef5d63",
                                "sense_id": "40b1e5a6-86ca-3484-84b0-5c32e0da4b64",
                                "text": "Je vous propose avec ce tuto d’installer une ROM stock, et de « débrander » votre M8 – c’est à dire de transformer votre téléphone Orange, SFR ou Bouygues par la version « nue » HTC, comme si vous l’aviez acheté en magasin."
                            },
                            {
                                "example_id": "8020546d-1ac5-43d5-b94b-9f3000a6968e",
                                "sense_id": "40b1e5a6-86ca-3484-84b0-5c32e0da4b64",
                                "text": "Nous avons enfin la possibilité de rendre notre Nokia Lumia nu, débrandé ou détagué selon votre jargon !"
                            },
                            {
                                "example_id": "ac05b184-104e-492e-a172-4e6f39d6fe72",
                                "sense_id": "40b1e5a6-86ca-3484-84b0-5c32e0da4b64",
                                "text": "Comment \"débrander\" ou \"détaguer\" mon windowsphone ?"
                            }
                        ]
                    }
