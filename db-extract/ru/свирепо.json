                ],
                "translations": [
                    {
                        "translation_id": "091ef9cf-4f70-4b4c-9246-14fa6ccfad69",
                        "source_entry_id": "5393ac83-8546-3ce6-b426-76c3f058551e",
                        "source_sense_id": "ad9a0a31-119f-338d-9a8a-b22cebab4059",
                        "target_lang_word": "ferociously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ferociously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a20b3212-61df-3ff1-b347-a6617371f9cd",
                                        "entry_id": "a3f54456-04e1-3c42-be1d-e6323c95cb12",
                                        "glosses": [
                                            "In a ferocious manner, particularly violent and aggressive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dbfdb10-124b-45ba-9bc8-32185cb12fa1",
                                                "sense_id": "a20b3212-61df-3ff1-b347-a6617371f9cd",
                                                "text": "Challenger snorted ferociously as he looked at it, and his thick black hair seemed to bristle up in his wrath."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0869d87-d191-322e-847c-9e4c758b7824",
                                        "entry_id": "a3f54456-04e1-3c42-be1d-e6323c95cb12",
                                        "glosses": [
                                            "Intensely or extremely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cd04e52-151e-4c7a-9022-c38fb765e24f",
                                                "sense_id": "d0869d87-d191-322e-847c-9e4c758b7824",
                                                "text": "To get a Times review, a gay book generally must be by a well-known writer preferably not performing at his best, or be so ferociously learned, like John Boswell's Christianity, Social Tolerance, and Homosexuality, that the Times would lose intellectual credibility by not noticing it."
                                            },
                                            {
                                                "example_id": "e31e6313-3750-4396-ba91-706cdc26fa67",
                                                "sense_id": "d0869d87-d191-322e-847c-9e4c758b7824",
                                                "text": "a ferociously fast pace"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2c70508-7720-4c5c-afe7-67acd770af5c",
                        "source_entry_id": "5393ac83-8546-3ce6-b426-76c3f058551e",
                        "source_sense_id": "ad9a0a31-119f-338d-9a8a-b22cebab4059",
                        "target_lang_word": "férocement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "férocement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "645b5335-c492-3c9a-9be0-e5192fe335cf",
                                        "entry_id": "9fe36cf1-30cc-384d-9037-63d334396101",
                                        "glosses": [
                                            "D’une manière féroce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd97c233-68a0-4812-be10-4bc1cc782225",
                                                "sense_id": "645b5335-c492-3c9a-9be0-e5192fe335cf",
                                                "text": "De leurs fleurs férocement bariolées et tigrées […] s'exhalent des parfums âcres, pénétrants, vertigineux."
                                            },
                                            {
                                                "example_id": "27a26139-aea1-43de-8a74-28ff8dc52712",
                                                "sense_id": "645b5335-c492-3c9a-9be0-e5192fe335cf",
                                                "text": "Le capitalisme n'a pas arraché la femme au foyer domestique et ne l'a pas lancée dans la production sociale pour l'émanciper, mais pour l'exploiter encore plus férocement que l'homme ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0410ad3a-66fd-3c11-8383-5a06094758be",
                                        "entry_id": "9fe36cf1-30cc-384d-9037-63d334396101",
                                        "glosses": [
                                            "Avec dureté"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "744acef0-9641-4962-a723-906f636c1098",
                                                "sense_id": "0410ad3a-66fd-3c11-8383-5a06094758be",
                                                "text": "Il riait de plus en plus fort, férocement joyeux, guettant les reflets de la stupéfaction sur la physionomie du journaliste."
                                            },
                                            {
                                                "example_id": "b1112b5c-e767-4d98-8661-571d5e4bd8bb",
                                                "sense_id": "0410ad3a-66fd-3c11-8383-5a06094758be",
                                                "text": "Les années de famine, se déroulent des scènes effroyables, émeutes férocement réprimées, meurtres d'enfants, nécrophagies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fe19977-b8bb-4d00-a051-d00e20ddeef3",
                        "source_entry_id": "5393ac83-8546-3ce6-b426-76c3f058551e",
                        "source_sense_id": "ad9a0a31-119f-338d-9a8a-b22cebab4059",
                        "target_lang_word": "furieusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "furieusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e625a16-59b6-3357-ace9-4b1012e308ef",
                                        "entry_id": "906057af-dea9-3d6e-90f5-145f39af1a2d",
                                        "glosses": [
                                            "Avec furie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "072e5f68-bc7a-42b9-8c62-e28aed736daf",
                                                "sense_id": "7e625a16-59b6-3357-ace9-4b1012e308ef",
                                                "text": "Vous ne savez pas comment les Jansénistes les tiennent en échec et les pressent si furieusement que, la moindre parole qui leur échappe contre les principes des pères, on les voit incontinent accablés par des volumes entiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42d43339-1a60-376d-9a89-1325f2ea9352",
                                        "entry_id": "906057af-dea9-3d6e-90f5-145f39af1a2d",
                                        "glosses": [
                                            "Extrêmement, excessivement."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ea33034-4fd3-4900-b8e1-c7e310be3987",
                                                "sense_id": "42d43339-1a60-376d-9a89-1325f2ea9352",
                                                "text": "Vous donnez furieusement dans le marquis."
                                            },
                                            {
                                                "example_id": "0a88d1e9-7d30-41f7-880b-ee578e8c78e8",
                                                "sense_id": "42d43339-1a60-376d-9a89-1325f2ea9352",
                                                "text": "C'est que vous êtes furieusement difficile."
                                            },
                                            {
                                                "example_id": "70033c3f-9259-47ad-bca1-a090af874a7b",
                                                "sense_id": "42d43339-1a60-376d-9a89-1325f2ea9352",
                                                "text": "Je suis furieusement tombé, et il n'y a plus de société pour moi."
                                            },
                                            {
                                                "example_id": "404ac2ec-0660-4301-8e15-8f6cde692510",
                                                "sense_id": "42d43339-1a60-376d-9a89-1325f2ea9352",
                                                "text": "Avoir donné le fouet jadis à un duc et pair, cela vous pousse furieusement."
                                            },
                                            {
                                                "example_id": "0c94935b-d4f2-4d72-84a1-74f1c9fc1acf",
                                                "sense_id": "42d43339-1a60-376d-9a89-1325f2ea9352",
                                                "text": "Elle eût donné dix ans de sa vie pour posséder une de ces habitations. La maison qui formait le coin de gauche, et dans laquelle logeait le receveur particulier, la tentait surtout furieusement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e99f5fc3-b53b-475b-ae22-903bd4876251",
                        "source_entry_id": "5393ac83-8546-3ce6-b426-76c3f058551e",
                        "source_sense_id": "ad9a0a31-119f-338d-9a8a-b22cebab4059",
                        "target_lang_word": "sauvagement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sauvagement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "937ddf83-dee1-37ec-ba3f-8ee47b75db0d",
                                        "entry_id": "deaa19e8-70b3-3ac2-ab2f-da2aeb3741a9",
                                        "glosses": [
                                            "D’une manière sauvage ; avec sauvagerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4395993c-d138-453c-8d7a-583105b5942b",
                                                "sense_id": "937ddf83-dee1-37ec-ba3f-8ee47b75db0d",
                                                "text": "L’infortuné n’avait pas eu le temps de presser ce bouton. Déjà ses assaillants le frappaient, sauvagement, par derrière."
                                            },
                                            {
                                                "example_id": "afe656ca-360f-40fb-96a1-482ff9b12817",
                                                "sense_id": "937ddf83-dee1-37ec-ba3f-8ee47b75db0d",
                                                "text": "M. Boileau [non le poète] vivait claquemuré et le plus sauvagement du monde dans son cloître Saint-Honoré,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
