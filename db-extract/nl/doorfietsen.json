                "senses": [
                    {
                        "sense_id": "dd27efa7-f2b9-3ae3-a7f9-6e63421ff7c0",
                        "entry_id": "d61eb858-d796-3fbe-9510-c6ecf1c294a6",
                        "glosses": [
                            "to keep on cycling"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4f26dac3-03f4-4a95-a211-2641e40329b6",
                                "sense_id": "dd27efa7-f2b9-3ae3-a7f9-6e63421ff7c0",
                                "text": "Je moet nog driehonderd meter doorfietsen om bij de juiste afslag te komen.",
                                "translation": "You'll have to cycle on for three hundred more meters to reach the correct road exit.",
                                "english": "You'll have to cycle on for three hundred more meters to reach the correct road exit."
                            }
                        ]
                    },
                    {
                        "sense_id": "e062a844-0093-390e-89aa-1230a718c3c4",
                        "entry_id": "d61eb858-d796-3fbe-9510-c6ecf1c294a6",
                        "glosses": [
                            "to cycle at pace, cycle steadily"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "caae7b67-565c-4269-9f24-a412be5f018c",
                                "sense_id": "e062a844-0093-390e-89aa-1230a718c3c4",
                                "text": "Als je nog op tijd wil zijn ga je flink moeten doorfietsen.",
                                "translation": "If you still want to arrive in time you'll have to cycle at pace.",
                                "english": "If you still want to arrive in time you'll have to cycle at pace."
                            }
                        ]
                    }
                ],
