                    {
                        "sense_id": "0352105a-487e-3c17-8323-bb456970f55e",
                        "entry_id": "a1292337-c259-3351-bfe0-7b169cfde956",
                        "glosses": [
                            "Feuerwerksrakete, die an Silvester abgeschossen wird"
