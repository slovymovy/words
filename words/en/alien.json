                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иноплане́тный",
                                "target_lang_sense_clarification": "связанный с другими планетами"
                            },
                            {
                                "target_lang_word": "чужо́й",
                                "target_lang_sense_clarification": "неземной, пугающе незнакомый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外星的",
                                "target_lang_sense_clarification": "与外星球相关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b647ba80-f029-3f5d-883c-6d31f7f8c85b",
                    "sense_definition": "Belonging to a foreign country or nation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "foreign_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The refugees found themselves in an <w>alien</w> land with no money.",
                            "target_lang_translations": {
                                "ru": "Беженцы оказались в <w>чужой</w> стране без денег.",
                                "zh": "难民们发现自己身处<w>异域</w>，身上分文皆无。"
                            }
                        },
                        {
                            "text": "They were traveling through <w>alien</w> territory during the war.",
                            "target_lang_translations": {
                                "ru": "Во время войны они путешествовали по <w>чужой</w> территории.",
                                "zh": "战争期间，他们正穿行在<w>外国</w>领土上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "foreign",
                        "overseas"
                    ],
                    "antonyms": [
                        "native",
                        "domestic"
                    ],
                    "common_phrases": [
                        "alien culture",
                        "alien soil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принадлежащий чужой стране или нации.",
                        "zh": "属于外国或外民族的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чужо́й",
                                "target_lang_sense_clarification": "не свой, принадлежащий другим"
                            },
                            {
                                "target_lang_word": "чужезе́мный",
                                "target_lang_sense_clarification": "книжное/устаревшее: из чужой земли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外国的",
                                "target_lang_sense_clarification": "属于其他国家的"
                            },
                            {
                                "target_lang_word": "异域的",
                                "target_lang_sense_clarification": "带有陌生感的外国风情"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86b384ff-cf7f-3add-9a6f-8e1956a42d5b",
                    "sense_definition": "Unfamiliar, strange, or inconsistent with one's own nature or experience.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "strange_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The concept of dishonesty was completely <w>alien</w> to him.",
                            "target_lang_translations": {
                                "ru": "Понятие нечестности было ему совершенно <w>чуждо</w>.",
                                "zh": "不诚实的概念对他来说完全是<w>格格不入</w>的。"
                            }
                        },
                        {
                            "text": "She felt <w>alien</w> in the big city after living in a small village all her life.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя <w>чужой</w> в большом городе, прожив всю жизнь в маленькой деревне.",
                                "zh": "在小村庄生活了一辈子后，她在大城市里感到十分<w>陌生</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strange",
                        "unfamiliar",
                        "bizarre"
                    ],
                    "antonyms": [
                        "familiar",
                        "normal"
                    ],
                    "common_phrases": [
                        "alien to me",
                        "alien concept"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незнакомый, странный или несовместимый с собственной природой или опытом.",
                        "zh": "不熟悉的、奇怪的，或与个人的本性或经验不相符的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чу́ждый",
                                "target_lang_sense_clarification": "далекий по духу, несвойственный"
                            },
                            {
                                "target_lang_word": "чужо́й",
                                "target_lang_sense_clarification": "посторонний, не вписывающийся в окружение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陌生的",
                                "target_lang_sense_clarification": "不熟悉的"
                            },
                            {
                                "target_lang_word": "格格不入的",
                                "target_lang_sense_clarification": "与环境或本性不符的"
                            }
                        ]
                    }
                }
