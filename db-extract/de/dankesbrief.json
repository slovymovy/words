                            {
                                "example_id": "d06262d5-2173-406e-a010-cd3d18689b83",
                                "sense_id": "9d32112a-5426-3742-9b76-089fdf1fc314",
                                "text": "„Als der Geburtstag vorbei war, schrieb die Mutter ihre Dankesbriefe an die drei Söhne.“"
                            },
                            {
                                "example_id": "2cda0ab9-45a7-42f6-aac2-6999760df43f",
                                "sense_id": "9d32112a-5426-3742-9b76-089fdf1fc314",
                                "text": "„Die Osnabrücker erhalten trotzdem einen herzlichen Dankesbrief für ihren Auftritt.“"
                            }
                        ],
