                ],
                "senses": [
                    {
                        "sense_id": "813f6fd4-fea3-37b8-834d-7dd4aa27efb4",
                        "entry_id": "427ea74a-9bd3-3f23-858a-ca19c4efabc2",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b40ac8d-b0ed-49ca-b8cf-4c149aeaa100",
                                "sense_id": "813f6fd4-fea3-37b8-834d-7dd4aa27efb4",
                                "text": "Frau Mergle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3fbea2e5-8d7b-435d-8c2c-3506b0301d36",
                                "sense_id": "813f6fd4-fea3-37b8-834d-7dd4aa27efb4",
                                "text": "Herr Mergle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b7736792-3531-4b87-8e40-c4fcd51f14cb",
                                "sense_id": "813f6fd4-fea3-37b8-834d-7dd4aa27efb4",
                                "text": "Die Mergles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "3187929a-2b40-4360-917b-30a4953f5cfa",
                                "sense_id": "813f6fd4-fea3-37b8-834d-7dd4aa27efb4",
                                "text": "Der Mergle trägt nie die Schals, die die Mergle ihm strickt."
                            },
                            {
                                "example_id": "3c8e45bb-8880-49ef-8595-8c7e595df669",
                                "sense_id": "813f6fd4-fea3-37b8-834d-7dd4aa27efb4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mergle kommt, geht der Herr Mergle.“"
                            },
                            {
                                "example_id": "ffebc19f-0374-4406-a113-7759f1938579",
                                "sense_id": "813f6fd4-fea3-37b8-834d-7dd4aa27efb4",
                                "text": "Mergle kommt und geht."
                            },
                            {
                                "example_id": "4a27c3b0-e8c3-4287-ad80-504693056e75",
                                "sense_id": "813f6fd4-fea3-37b8-834d-7dd4aa27efb4",
                                "text": "Mergles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
