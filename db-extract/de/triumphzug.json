                ],
                "senses": [
                    {
                        "sense_id": "bd2549e0-0202-3356-9293-bd77b1b0cc25",
                        "entry_id": "f6e1f82c-7d69-3e4a-8d98-e6afd5043377",
                        "glosses": [
                            "großer Umzug, um einen Sieg zu feiern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "256442db-3416-47df-971b-d9fce4348eb5",
                                "sense_id": "bd2549e0-0202-3356-9293-bd77b1b0cc25",
                                "text": "„Am 23. Dezember 176 ließen sich der Kaiser und sein Sohn Commodus in Rom mit einem Triumphzug feiern.“"
                            },
                            {
                                "example_id": "d4dc88f0-6e8f-41f9-ac2f-3ff0350134ef",
                                "sense_id": "bd2549e0-0202-3356-9293-bd77b1b0cc25",
                                "text": "„Am 1. Januar 1959 flüchtete Batista in die USA, sieben Tage später traf Castro nach einem Triumphzug durchs gesamte Land in Havanna ein.“"
                            },
                            {
                                "example_id": "ea938e09-7864-4c77-a535-be4ad02aa3d7",
                                "sense_id": "bd2549e0-0202-3356-9293-bd77b1b0cc25",
                                "text": "„Der Häuptling wurde wenig später von den Briganten ausgeliefert und im Triumphzug durch Rom geführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
