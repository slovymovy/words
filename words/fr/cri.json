                    ]
                },
                {
                    "sense_id": "ccdff9d8-1de0-32e3-9d65-b8b3e0c2d4a0",
                    "sense_definition": "Parole brève ou formule prononcée à haute voix pour servir de signal, d'avertissement ou de mot d'ordre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les soldats ont poussé leur <w>cri</w> de guerre avant d'avancer."
                        },
                        {
                            "text": "Cette phrase est devenue le véritable <w>cri</w> de ralliement des manifestants."
                        }
                    ],
                    "common_phrases": [
                        "cri de ralliement",
                        "cri de guerre"
                    ]
                },
                {
                    "sense_id": "36a3371c-b46d-33d4-abf5-2b21e9377b6b",
                    "sense_definition": "Mouvement intérieur ou élan sincère et spontané de la conscience ou du cœur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son appel à l'aide était un véritable <w>cri</w> du cœur."
                        },
                        {
                            "text": "Il n'a pas pu étouffer le <w>cri</w> de sa conscience face à cette injustice."
                        }
                    ],
                    "common_phrases": [
                        "cri du cœur",
                        "cri de la conscience"
                    ]
                },
                {
                    "sense_id": "e7299ed1-ce44-3b2f-b448-da40a86bf674",
                    "sense_definition": "Protestation collective, revendication vive ou opinion exprimée publiquement avec force.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a enfin entendu le <w>cri</w> des citoyens en colère."
                        },
                        {
                            "text": "Un <w>cri</w> d'indignation s'est élevé dans toute la salle après son discours."
                        }
                    ],
                    "common_phrases": [
                        "cri d'indignation",
                        "cri de protestation"
                    ]
                }
            ]
        },
