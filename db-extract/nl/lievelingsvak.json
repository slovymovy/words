                        "examples": [
                            {
                                "example_id": "2cbf7283-553c-43fc-8b86-476afa511eb2",
                                "sense_id": "94891546-99fe-35d8-91a4-124d064664ef",
                                "text": "Ook is het voor kinderen van ouders met een verslaving goed als ze gezien worden om wie ze zelf zijn, bijvoorbeeld door te vragen hoe het op school was of wat hun lievelingsvak is. Een luisterend oor geeft al veel steun."
                            },
                            {
                                "example_id": "1723b1a7-3907-40c1-a139-0430a71a672a",
                                "sense_id": "94891546-99fe-35d8-91a4-124d064664ef",
                                "text": "Safa’a is een tikje ongemakkelijk. Ze geeft korte antwoorden, er vallen stiltes. Dus begin ik over school. Wat is je lievelingsvak? “Arabisch.” Schrijf je zelf ook? “Ja.” Wat schrijf je? “Gedichten.”"
                            }
                        ]
