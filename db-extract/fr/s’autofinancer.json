                ],
                "senses": [
                    {
                        "sense_id": "230bfc62-069b-31c7-9f97-a7d2751e78d6",
                        "entry_id": "c4cdbfc8-0dfb-3984-b424-020baa7a79ad",
                        "glosses": [
                            "Financer ses propres projets sans recours à l’endettement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f27d9ebf-7209-4e13-8695-386608c8b26a",
                                "sense_id": "230bfc62-069b-31c7-9f97-a7d2751e78d6",
                                "text": "Si, en revanche, l’entreprise ne distribue pas de dividendes (ou peu), elle peut indiquer par là qu’elle désire s’autofinancer pour se développer."
                            },
                            {
                                "example_id": "e6348e69-c902-4f59-9fc0-14b4c0e5b148",
                                "sense_id": "230bfc62-069b-31c7-9f97-a7d2751e78d6",
                                "text": "Afin de permettre à cette activité de s’autofinancer, il faut recourir à des subventions croisées : les familles riches qui peuvent payer le prix normal d’une greffe de moelle osseuse contribueront au financement des interventions dont bénéficieront les patients les plus démunis."
                            }
                        ]
                    }
                ],
