{
    "word_family": [
        "striped",
        "striping",
        "stripy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5baaabd9-78af-311a-9635-f25f41d70b45",
                    "sense_definition": "A long region of a single colour in a repeating pattern of similar regions.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visual_pattern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The zebra has black and white <w>stripes</w> all over its body.",
                            "target_lang_translations": {
                                "ru": "У зебры черные и белые <w>полоски</w> по всему телу."
                            }
                        },
                        {
                            "text": "She wore a blue shirt with thin white <w>stripes</w> for the interview.",
                            "target_lang_translations": {
                                "ru": "На интервью она надела синюю рубашку в тонкую белую <w>полоску</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "band",
                        "streak",
                        "line"
                    ],
                    "common_phrases": [
                        "vertical stripes",
                        "horizontal stripes",
                        "racing stripes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная область одного цвета в повторяющемся узоре из подобных областей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полоса",
                                "target_lang_sense_clarification": "линия в узоре"
                            },
                            {
                                "target_lang_word": "полоска",
                                "target_lang_sense_clarification": "узкая линия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9edab044-1a0d-3fd9-9c3b-36e2177ed31f",
                    "sense_definition": "A long, relatively straight region against a different coloured background.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visual_pattern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a single white <w>stripe</w> painted down the middle of the road.",
                            "target_lang_translations": {
                                "ru": "Посередине дороги была проведена одна белая <w>полоса</w>."
                            }
                        },
                        {
                            "text": "The skunk is easily recognized by the white <w>stripe</w> on its back.",
                            "target_lang_translations": {
                                "ru": "Скунса легко узнать по белой <w>полосе</w> на спине."
                            }
                        }
                    ],
                    "synonyms": [
                        "streak",
                        "band"
                    ],
                    "common_phrases": [
                        "white stripe",
                        "yellow stripe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная, относительно прямая область на фоне другого цвета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полоса",
                                "target_lang_sense_clarification": "на дороге или теле животного"
                            },
                            {
                                "target_lang_word": "полоска",
                                "target_lang_sense_clarification": "узкая черта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e06e0134-6350-35d2-b9e1-3654b33daff6",
                    "sense_definition": "The badge worn by certain officers in the military or other forces to indicate rank.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rank_insignia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of hard work, he finally earned his third <w>stripe</w> and became a sergeant.",
                            "target_lang_translations": {
                                "ru": "После многих лет упорного труда он наконец заслужил третью <w>лычку</w> и стал сержантом."
                            }
                        },
                        {
                            "text": "The officer proudly displayed the <w>stripes</w> on his uniform sleeve.",
                            "target_lang_translations": {
                                "ru": "Офицер с гордостью демонстрировал <w>нашивки</w> на рукаве своей формы."
                            }
                        }
                    ],
                    "synonyms": [
                        "chevron",
                        "insignia"
                    ],
                    "common_phrases": [
                        "earn your stripes",
                        "sergeant stripes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знак различия, носимый офицерами в армии или других структурах для обозначения звания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нашивка",
                                "target_lang_sense_clarification": "знак различия на форме"
                            },
                            {
                                "target_lang_word": "шеврон",
                                "target_lang_sense_clarification": "V-образный знак различия"
                            },
                            {
                                "target_lang_word": "лычка",
                                "target_lang_sense_clarification": "разг., полоска на погонах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7152b8ab-c4f5-3e57-a65d-4b2c6486bb7a",
                    "sense_definition": "A distinguishing characteristic, sign, or sort; often used to describe a person's political or ideological nature.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "character_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Politicians of every <w>stripe</w> gathered to discuss the new environmental policy.",
                            "target_lang_translations": {
                                "ru": "Политики всех <w>толков</w> собрались, чтобы обсудить новую экологическую политику."
                            }
                        },
                        {
                            "text": "He is a traditionalist of the old <w>stripe</w> who prefers letters over emails.",
                            "target_lang_translations": {
                                "ru": "Он традиционалист старой <w>закалки</w>, который предпочитает письма электронной почте."
                            }
                        }
                    ],
                    "synonyms": [
                        "ilk",
                        "kind",
                        "sort",
                        "type"
                    ],
                    "common_phrases": [
                        "of every stripe",
                        "political stripe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличительная черта, признак или сорт; часто используется для описания политических или идеологических взглядов человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толк",
                                "target_lang_sense_clarification": "направление или сорт людей"
                            },
                            {
                                "target_lang_word": "масть",
                                "target_lang_sense_clarification": "перен., категория или тип"
                            },
                            {
                                "target_lang_word": "направление",
                                "target_lang_sense_clarification": "политическое или идеологическое"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3596f97f-5f41-3348-9afc-53728ec32e82",
                    "sense_definition": "Any of the balls marked with stripes in the game of pool.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Since my opponent hit a solid ball, I have to aim for the <w>stripes</w>.",
                            "target_lang_translations": {
                                "ru": "Так как мой оппонент попал по цельному шару, мне нужно целиться в <w>полосатые</w>."
                            }
                        },
                        {
                            "text": "He managed to sink two <w>stripes</w> with a single powerful shot.",
                            "target_lang_translations": {
                                "ru": "Ему удалось забить два <w>полосатых</w> шара одним мощным ударом."
                            }
                        }
                    ],
                    "antonyms": [
                        "solids",
                        "spots"
                    ],
                    "common_phrases": [
                        "solids and stripes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой из шаров с полосой в игре на бильярде (пуле)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полосатый",
                                "target_lang_sense_clarification": "бильярдный шар с полосой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "341a108c-d07c-33b5-990f-999649c68499",
                    "sense_definition": "A long, narrow mark or wound left by striking someone with a whip or stick.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner's back was covered in bloody <w>stripes</w> from the lashing.",
                            "target_lang_translations": {
                                "ru": "Спина заключенного была покрыта кровавыми <w>рубцами</w> от ударов плетью."
                            }
                        },
                        {
                            "text": "In ancient times, a criminal might be sentenced to forty <w>stripes</w> as punishment.",
                            "target_lang_translations": {
                                "ru": "В древние времена преступника могли приговорить к сорока <w>ударам</w> плетью в качестве наказания."
                            }
                        }
                    ],
                    "synonyms": [
                        "welt",
                        "lash",
                        "wheal"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical forms of corporal punishment"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный узкий след или рана, оставленная ударом кнута или палки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рубец",
                                "target_lang_sense_clarification": "след от удара"
                            },
                            {
                                "target_lang_word": "полоса",
                                "target_lang_sense_clarification": "след от плети"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "965cb140-d2e8-3349-8e2f-f958b3ae1199",
                    "sense_definition": "A portion of data distributed across several separate physical disks for the sake of redundancy or performance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The RAID controller writes a data <w>stripe</w> across all available drives in the array.",
                            "target_lang_translations": {
                                "ru": "RAID-контроллер записывает <w>страйп</w> данных на все доступные диски в массиве."
                            }
                        },
                        {
                            "text": "If one disk fails, the system can reconstruct the missing <w>stripe</w> from parity data.",
                            "target_lang_translations": {
                                "ru": "Если один диск выйдет из строя, система сможет восстановить недостающий <w>блок</w> данных из данных четности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "data stripe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Порция данных, распределенная по нескольким физическим дискам для обеспечения избыточности или производительности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страйп",
                                "target_lang_sense_clarification": "в ИТ, сегмент данных RAID"
                            },
                            {
                                "target_lang_word": "полоса",
                                "target_lang_sense_clarification": "блок данных"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "78e26712-221b-3f6a-9222-47a240780e7f",
                    "sense_definition": "To mark or decorate something with stripes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "marking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sunlight filtered through the blinds to <w>stripe</w> the floor with shadows.",
                            "target_lang_translations": {
                                "ru": "Солнечный свет просачивался сквозь жалюзи, <w>разлиновывая</w> пол тенями."
                            }
                        },
                        {
                            "text": "Workers will <w>stripe</w> the newly paved parking lot tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Завтра утром рабочие нанесут <w>разметку</w> на недавно заасфальтированную парковку."
                            }
                        }
                    ],
                    "synonyms": [
                        "streak",
                        "band"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помечать или украшать что-либо полосами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разлиновывать",
                                "target_lang_sense_clarification": "наносить линии"
                            },
                            {
                                "target_lang_word": "чертить полосы",
                                "target_lang_sense_clarification": "рисовать полоски"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b2e7aba-49f3-308f-a669-ea16bf45e42d",
                    "sense_definition": "To lash or beat someone with a whip or strap, leaving marks.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cruel master would <w>stripe</w> the backs of those who disobeyed him.",
                            "target_lang_translations": {
                                "ru": "Жестокий хозяин <w>порол</w> спины тех, кто ему не подчинялся."
                            }
                        },
                        {
                            "text": "He was terrified that the guard would <w>stripe</w> his legs for talking back.",
                            "target_lang_translations": {
                                "ru": "Он был в ужасе от того, что охранник <w>отхлещет</w> его по ногам за дерзость."
                            }
                        }
                    ],
                    "synonyms": [
                        "whip",
                        "flog",
                        "lash"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical corporal punishment"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бить или пороть кого-либо кнутом или ремнем, оставляя следы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пороть",
                                "target_lang_sense_clarification": "наносить удары плетью"
                            },
                            {
                                "target_lang_word": "истязать",
                                "target_lang_sense_clarification": "оставлять рубцы ударами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36d98336-4f93-3d64-8068-37aa701894a8",
                    "sense_definition": "To distribute data across several separate physical disks to reduce the time to read and write.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The server is configured to <w>stripe</w> data across four high-speed SSDs.",
                            "target_lang_translations": {
                                "ru": "Сервер настроен на <w>чередование</w> данных между четырьмя высокоскоростными SSD."
                            }
                        },
                        {
                            "text": "When you <w>stripe</w> the drives, you significantly increase the overall throughput of the system.",
                            "target_lang_translations": {
                                "ru": "Когда вы <w>объединяете</w> диски в страйп, вы значительно увеличиваете общую пропускную способность системы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распределять данные по нескольким физическим дискам для сокращения времени чтения и записи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чередовать",
                                "target_lang_sense_clarification": "распределять данные (striping)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}