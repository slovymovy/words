                {
                    "sense_id": "b420f58c-bd9b-3efa-9570-d04d54f030fb",
                    "sense_definition": "Дать возможность жидкости, газу или пару выйти наружу.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "release_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нужно <выпустить> воздух из надувного матраса, чтобы сложить его.",
                            "target_lang_translations": {
                                "en": "You need to <let> the air <out> of the air mattress to fold it.",
