{
    "word_family": [
        "age",
        "ageless",
        "aging",
        "ageing",
        "overage",
        "underage"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4deb22dd-cc0e-3dba-bf6f-40c1a61219a7",
                    "sense_definition": "Having the specific age of a certain number of years.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "age_specification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The program is designed specifically for children <w>aged</w> five to ten.",
                            "target_lang_translations": {
                                "ru": "Программа разработана специально для детей <w>в возрасте</w> от пяти до десяти лет.",
                                "zh": "该项目专为五到十<w>岁</w>的儿童设计。"
                            }
                        },
                        {
                            "text": "He left home <w>aged</w> eighteen to travel across the world.",
                            "target_lang_translations": {
                                "ru": "Он ушел из дома в <w>восемнадцать лет</w>, чтобы путешествовать по миру.",
                                "zh": "他十八<w>岁</w>时离家去环游世界。"
                            }
                        }
                    ],
                    "synonyms": [
                        "-year-old"
                    ],
                    "common_phrases": [
                        "aged eighteen",
                        "children aged",
                        "people aged"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий определенный возраст в количестве лет.",
                        "zh": "指具有特定的岁数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в возрасте",
                                "target_lang_sense_clarification": "указывает на количество лет"
                            },
                            {
                                "target_lang_word": "лет",
                                "target_lang_sense_clarification": "используется при указании возраста"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "岁",
                                "target_lang_sense_clarification": "用于表示年龄"
                            },
                            {
                                "target_lang_word": "……岁",
                                "target_lang_sense_clarification": "表示特定年龄段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "845fa1e8-ad59-3530-9871-efc99bf7fd05",
                    "sense_definition": "Having lived for a long time; being old.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "elderly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An <w>aged</w> man with a long white beard sat on the park bench.",
                            "target_lang_translations": {
                                "ru": "<w>Престарелый</w> мужчина с длинной белой бородой сидел на скамейке в парке.",
                                "zh": "一位留着长白胡子的<w>年迈</w>男子坐在公园长椅上。"
                            }
                        },
                        {
                            "text": "She spent her afternoons caring for her <w>aged</w> parents at their home.",
                            "target_lang_translations": {
                                "ru": "Она проводила дни, ухаживая за своими <w>пожилыми</w> родителями у них дома.",
                                "zh": "她下午都在家里照顾她<w>年迈</w>的父母。"
                            }
                        }
                    ],
                    "synonyms": [
                        "old",
                        "hoary"
                    ],
                    "antonyms": [
                        "young",
                        "youthful"
                    ],
                    "common_phrases": [
                        "aged parents",
                        "aged relative"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проживший долгую жизнь; старый или пожилой.",
                        "zh": "指活了很长时间；年老。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "престарелый",
                                "target_lang_sense_clarification": "очень старый человек"
                            },
                            {
                                "target_lang_word": "пожилой",
                                "target_lang_sense_clarification": "человек в возрасте"
                            },
                            {
                                "target_lang_word": "старый",
                                "target_lang_sense_clarification": "проживший много лет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "年迈的",
                                "target_lang_sense_clarification": "形容人年纪很大"
                            },
                            {
                                "target_lang_word": "老年的",
                                "target_lang_sense_clarification": "指处于老年阶段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12ba9853-1702-302c-9628-f2f7fe1d8133",
                    "sense_definition": "Having undergone a process of maturation over time to improve quality or flavor.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "maturation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This <w>aged</w> cheese has a much stronger and sharper flavor than the fresh version.",
                            "target_lang_translations": {
                                "ru": "Этот <w>выдержанный</w> сыр имеет гораздо более сильный и острый вкус, чем свежий.",
                                "zh": "这种<w>熟成</w>奶酪比新鲜的口感更浓郁、更辛辣。"
                            }
                        },
                        {
                            "text": "He poured a glass of <w>aged</w> whiskey to celebrate the occasion.",
                            "target_lang_translations": {
                                "ru": "Он налил стакан <w>выдержанного</w> виски, чтобы отпраздновать это событие.",
                                "zh": "他倒了一杯<w>陈年</w>威士忌来庆祝这个场合。"
                            }
                        }
                    ],
                    "synonyms": [
                        "matured"
                    ],
                    "antonyms": [
                        "fresh",
                        "unaged"
                    ],
                    "common_phrases": [
                        "aged whiskey",
                        "aged cheese",
                        "aged beef"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедший процесс созревания или выдержки для улучшения вкуса или качества.",
                        "zh": "指经过一段时间的成熟过程以改善品质或风味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдержанный",
                                "target_lang_sense_clarification": "о вине, сыре или виски"
                            },
                            {
                                "target_lang_word": "зрелый",
                                "target_lang_sense_clarification": "достигший нужной кондиции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陈年的",
                                "target_lang_sense_clarification": "指酒类等经过长期存放"
                            },
                            {
                                "target_lang_word": "熟成的",
                                "target_lang_sense_clarification": "指食品经过发酵或成熟过程"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba27d523-c1f6-3347-a8aa-9e7c4d1c56ad",
                    "sense_definition": "Old people considered as a collective group.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "elderly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is looking for new ways to provide better healthcare for the <w>aged</w>.",
                            "target_lang_translations": {
                                "ru": "Правительство ищет новые способы обеспечения лучшего медицинского обслуживания для <w>престарелых</w>.",
                                "zh": "政府正在寻找新途径为<w>老年人</w>提供更好的医疗保健。"
                            }
                        },
                        {
                            "text": "The charity provides hot meals and social activities for the <w>aged</w> in the community.",
                            "target_lang_translations": {
                                "ru": "Благотворительная организация предоставляет горячее питание и досуг для <w>стариков</w> в округе.",
                                "zh": "该慈善机构为社区里的<w>老年人</w>提供热餐和社交活动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "elderly"
                    ],
                    "antonyms": [
                        "youth"
                    ],
                    "common_phrases": [
                        "the aged",
                        "care for the aged",
                        "home for the aged"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used with 'the'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старики или пожилые люди как социальная группа.",
                        "zh": "指作为一个群体的老年人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "престарелые",
                                "target_lang_sense_clarification": "люди преклонного возраста"
                            },
                            {
                                "target_lang_word": "старики",
                                "target_lang_sense_clarification": "пожилые люди"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "老年人",
                                "target_lang_sense_clarification": "指代高龄群体"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0468068d-5f49-3621-b0f9-55110e90b6b4",
                    "sense_definition": "Simple past and past participle of <w>age</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stress of the last few months has <w>aged</w> him significantly.",
                            "target_lang_translations": {
                                "ru": "Стресс последних нескольких месяцев значительно его <w>состарил</w>.",
                                "zh": "过去几个月的压力让他明显<w>显老</w>了。"
                            }
                        },
                        {
                            "text": "The wine <w>aged</w> in oak barrels for several years before being bottled.",
                            "target_lang_translations": {
                                "ru": "Вино <w>выдерживалось</w> в дубовых бочках в течение нескольких лет перед розливом в бутылки.",
                                "zh": "葡萄酒在装瓶前在橡木桶中<w>陈化</w>了几年。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "aged rapidly",
                        "aged well"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время или причастие прошедшего времени от глагола «стареть» или «выдерживать».",
                        "zh": "动词 age 的过去式和过去分词，意为变老或使成熟。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "состарился",
                                "target_lang_sense_clarification": "стал выглядеть старше"
                            },
                            {
                                "target_lang_word": "выдерживался",
                                "target_lang_sense_clarification": "о процессе созревания продукта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使显老",
                                "target_lang_sense_clarification": "指导致某人看起来更老"
                            },
                            {
                                "target_lang_word": "陈化",
                                "target_lang_sense_clarification": "指物品经过时间沉淀"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}