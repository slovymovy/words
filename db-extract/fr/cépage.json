                                    {
                                        "sense_id": "0996e17a-62d3-3b35-bbcb-c21e8c432abc",
                                        "entry_id": "13a2c8db-fedf-3649-a4bb-9ad1e96eb99d",
                                        "glosses": [
                                            "een bepaald ras van de wijnstok en de vruchten daarvan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a6550f6-0b84-4fcf-921d-af4ef2244dc9",
                                                "sense_id": "0996e17a-62d3-3b35-bbcb-c21e8c432abc",
                                                "text": "De reden dat we een blauwe of paarsgekleurde mond krijgen ligt aan de kleurstof anthocyanen en aan de stof tannine. Deze zitten in de schil, pitjes en steeltjes van de druif waar de wijn van wordt gemaakt. Dit is echter niet het geval bij iedere wijn. Het hangt af van de druivensoort en de dikte van de schil van de druif."
                                            },
                                            {
                                                "example_id": "e7fcfc8f-f8e3-49d2-93b2-00c925104339",
                                                "sense_id": "0996e17a-62d3-3b35-bbcb-c21e8c432abc",
                                                "text": "De gratis te downloaden Wine 101 van Wine Folly beschrijft kort de bekendste wijnsoorten. Een van die soorten is Cabernet sauvignon. Volgens het boek is dit de meest geplante druivensoort ter wereld."
                                            }
