                        "entry_id": "5d804c06-b64f-3939-9606-acb600f0b542",
                        "glosses": [
                            "Qualité d'une pensée, du style, qui fait que l'esprit voit à travers, clarté, netteté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d741c5ca-0503-4557-b809-5f1e8291c444",
                                "sense_id": "679cd86b-74d9-3ee3-a931-6139afaaf209",
                                "text": "C'est [la foi] une vision de ce qui ne se voit point, une perspicuité des choses obscures."
                            },
                            {
                                "example_id": "653fd2c3-dc80-48f0-8967-46b52fb4afbd",
                                "sense_id": "679cd86b-74d9-3ee3-a931-6139afaaf209",
                                "text": "La fin de son art oratoire [d'Épicure], qui estoit perspicuité de langage seulement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe4947f0-7b69-469e-acf5-9210712ed576",
                        "source_entry_id": "5d804c06-b64f-3939-9606-acb600f0b542",
                        "source_sense_id": "679cd86b-74d9-3ee3-a931-6139afaaf209",
