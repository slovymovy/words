{
    "word_family": [
        "uitvinder",
        "uitvinding",
        "vinden",
        "vondst"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c8c29fb9-de88-3f0e-a3a7-c50367b2ab8b",
                    "sense_definition": "iets nieuws bedenken of maken dat nog niet bestond, zoals een apparaat of methode",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "creatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thomas Edison heeft de gloeilamp <w>uitgevonden</w>.",
                            "target_lang_translations": {
                                "en": "Thomas Edison <w>invented</w> the light bulb."
                            }
                        },
                        {
                            "text": "Wie heeft eigenlijk het internet <w>uitgevonden</w>?",
                            "target_lang_translations": {
                                "en": "Who actually <w>invented</w> the internet?"
                            }
                        },
                        {
                            "text": "Je hoeft het wiel niet opnieuw <w>uit</w> te <w>vinden</w> voor dit project.",
                            "target_lang_translations": {
                                "en": "You don't have to <w>reinvent</w> the wheel for this project."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedenken",
                        "ontwerpen"
                    ],
                    "common_phrases": [
                        "het wiel opnieuw uitvinden",
                        "een machine uitvinden"
                    ],
                    "target_lang_definitions": {
                        "en": "To think of or create something new that did not exist before, such as a device or method"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "invent",
                                "target_lang_sense_clarification": "to create a new process or mechanism"
                            },
                            {
                                "target_lang_word": "devise",
                                "target_lang_sense_clarification": "to plan or invent a complex system or method"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6beb8a08-6161-3415-8c72-37ce9245db29",
                    "sense_definition": "door onderzoek of nadenken achter de waarheid of een oplossing komen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ontdekking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik moet nog <w>uitvinden</w> hoe dit nieuwe programma precies werkt.",
                            "target_lang_translations": {
                                "en": "I still have to <w>find out</w> exactly how this new program works."
                            }
                        },
                        {
                            "text": "We zullen snel <w>uitvinden</w> wie de dader is.",
                            "target_lang_translations": {
                                "en": "We will soon <w>find out</w> who the culprit is."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontdekken",
                        "achterhalen",
                        "uitzoeken"
                    ],
                    "common_phrases": [
                        "de waarheid uitvinden",
                        "hoe het werkt uitvinden"
                    ],
                    "target_lang_definitions": {
                        "en": "To find out the truth or a solution through research or thinking"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "find out",
                                "target_lang_sense_clarification": "to discover information or facts"
                            },
                            {
                                "target_lang_word": "figure out",
                                "target_lang_sense_clarification": "to understand or solve something by thinking"
                            },
                            {
                                "target_lang_word": "discover",
                                "target_lang_sense_clarification": "to find something that was unknown"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}