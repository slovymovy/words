                "senses": [
                    {
                        "sense_id": "58f0da0f-0a41-3553-a7c1-ad0a7d5ba57a",
                        "entry_id": "89a07bc1-480c-39ae-a45a-9722bd00865f",
                        "glosses": [
                            "одним, обычно большим, глотком проглотить что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb230da8-5860-468c-a080-2046db243560",
                                "sense_id": "58f0da0f-0a41-3553-a7c1-ad0a7d5ba57a",
                                "text": "― Я видел, как карась в Волхове щуку сглотнул…"
                            },
                            {
                                "example_id": "4051e4da-e829-4e59-9623-045cb1aabd5b",
                                "sense_id": "58f0da0f-0a41-3553-a7c1-ad0a7d5ba57a",
                                "text": "Зверь поднял лапу ударить и опустил, фыркнув носом, жадно схватил кусок, сглотнул не жуя."
                            }
                        ]
                    },
                    {
                        "sense_id": "200286ec-50ab-3704-94b6-d13479b929b2",
                        "entry_id": "89a07bc1-480c-39ae-a45a-9722bd00865f",
                        "glosses": [
                            "сделать глотательное движение, преодолевая спазму в горле"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "673b520f-65ec-450d-81ec-d4447c7fc579",
                                "sense_id": "200286ec-50ab-3704-94b6-d13479b929b2",
                                "text": "Кэт посмотрела ему вслед и медленно сглотнула тяжелый комок в горле."
                            }
                        ]
                    }
