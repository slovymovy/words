                        "sense_id": "b1b42b91-2927-36f4-adf9-263af64c1725",
                        "entry_id": "c0c5ae6f-8a0a-3501-8c0e-e2fb144cfb68",
                        "glosses": [
                            "behandeling met behulp van zeer krachtige lichtstralen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ef6efda-f168-458a-bcf1-b521b1ed0c0a",
                                "sense_id": "b1b42b91-2927-36f4-adf9-263af64c1725",
                                "text": "Laserbehandelingen mogen als het aan minister Schippers ligt alleen nog worden uitgevoerd door artsen of huidtherapeuten. Ze dient daarvoor een wetswijziging in bij de Tweede Kamer."
                            },
                            {
                                "example_id": "9b9f5493-9004-41c7-8079-84f7e732554b",
                                "sense_id": "b1b42b91-2927-36f4-adf9-263af64c1725",
                                "text": "Over andere complicaties zoals de veel voorkomende droge ogen, schitteringen en lichtkringen wordt op de voorlichtingsbijeenkomsten gezegd dat die meestal vanzelf overgaan. Volgens de NGRC komen droge ogen na een laserbehandeling bij ongeveer één op de vijfhonderd patiënten voor. De vereniging baseert zich op een review, een onderzoek waarin de resultaten van andere onderzoeken op een rij gezet worden."
                            },
                            {
                                "example_id": "4ff1e833-195d-4ee4-a851-b195dcc02465",
                                "sense_id": "b1b42b91-2927-36f4-adf9-263af64c1725",
                                "text": "Zijn stichting krijgt wekelijks vele mails van mensen bij wie de laserbehandeling flink is misgegaan, vertelt Han in het NOS Radio 1 Journaal: \"Compleet met foto's van verbrande huid, rode wonden, blaren, littekens. Die mensen kon ik voorheen niet helpen, want ik bhandel geen mensen met brandwonden of littekens.\""
                            }
                        ]
                    }
