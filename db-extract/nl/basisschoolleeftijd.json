                        "examples": [
                            {
                                "example_id": "a8fa8276-b0ec-4244-8b43-08956ab38a36",
                                "sense_id": "e23600df-31a4-352c-89c4-8bfaa78c385f",
                                "text": "De rechercheurs herkenden de grafisch vormgever op een van die opnamen. Ze concludeerden ook dat de beelden in Oostenrijk waren gemaakt en zochten contact met het OM in Wenen. Omdat er kinderen in de basisschoolleeftijd op de beelden te zien waren, besloot het Oostenrijkse OM foto's van de kinderen voor te leggen aan alle basisscholen."
                            },
                            {
                                "example_id": "d43774e9-0962-4135-b299-c414b5680bf9",
                                "sense_id": "e23600df-31a4-352c-89c4-8bfaa78c385f",
                                "text": "Het gaat om incidenten die jaren geleden zijn voorgevallen. De slachtoffers waren toen niet in de basisschoolleeftijd. Het gaat dus niet om leerlingen die op dit moment op de school in Leiderdorp zitten, benadrukt het OM."
                            }
                        ]
