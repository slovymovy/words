                        "entry_id": "cbbc9c95-70d0-34c4-93be-474f1e746d07",
                        "glosses": [
                            "zonder dat er een vraag of verzoek was"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5fe6020-89c3-480a-b979-9a830192d8a5",
                                "sense_id": "e47d4637-596c-3532-b2d4-24401d7234b8",
                                "text": "Hij kreeg zeer veel ongevraagd commentaar op zijn werk."
                            },
                            {
                                "example_id": "ed9d3cb3-e3bd-49d9-bffc-cdc46ddc95e1",
                                "sense_id": "e47d4637-596c-3532-b2d4-24401d7234b8",
                                "text": "Mensen die je leven in komen en die ongevraagd veel geven zoals een boodschap of een inzicht, vragen om over na te denken, bescherming of waarschuwingen."
                            }
                        ]
                    }
