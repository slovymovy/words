                        ],
                        "examples": [
                            {
                                "example_id": "e6f6469e-9507-4442-9566-17389099a59e",
                                "sense_id": "f6b67d1a-5598-3f74-a14e-59ed599ff8cb",
                                "text": "— À la bonne heure, mam’selle Marie, répondit Jeanne en embrassant la main délicate de Marie, posée sur son épaule."
                            },
                            {
                                "example_id": "c8a588d0-532e-4476-ba50-f2df690f5ecc",
                                "sense_id": "f6b67d1a-5598-3f74-a14e-59ed599ff8cb",
                                "text": "C’est Cadichon, l’âne de c’te pauvre mam’selle Pauline."
                            },
                            {
                                "example_id": "5bfa7276-a4dd-458b-95be-978253a984a8",
                                "sense_id": "f6b67d1a-5598-3f74-a14e-59ed599ff8cb",
                                "text": "Il joua […] les amoureux de campagne qui roulent des yeux bêtes en disant : « Mam’selle, j’vous aimons ben !… heulla ! Ben vrai, j’vous aimons tout plein ! »"
                            }
                        ]
                    }
