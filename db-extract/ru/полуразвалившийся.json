                "translations": [
                    {
                        "translation_id": "32de6613-23c8-42f0-8d11-09d83f2848fa",
                        "source_entry_id": "8517ebd6-4c9b-3f2f-a9be-9b319d850886",
                        "source_sense_id": "f74fa1bd-d1dd-3ffc-800e-4adf70b16cba",
                        "target_lang_word": "half",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "half",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52205e46-2008-3f93-a383-b90a5bf1a2a5",
                                        "entry_id": "b6c67694-3e25-3ac9-a840-483ed1125bca",
                                        "glosses": [
                                            "One of two usually roughly equal parts into which anything may be divided, or considered as divided."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c57c871-492f-448f-abc7-b7c8df0e5fc7",
                                                "sense_id": "52205e46-2008-3f93-a383-b90a5bf1a2a5",
                                                "text": "I ate the smaller half of the apple."
                                            },
                                            {
                                                "example_id": "7ee51a20-2691-4a4e-8450-f22f45830b11",
                                                "sense_id": "52205e46-2008-3f93-a383-b90a5bf1a2a5",
                                                "text": "You don’t know the half of it."
                                            },
                                            {
                                                "example_id": "f39d0b52-dc9d-4c8d-a517-3a50cae4cba4",
                                                "sense_id": "52205e46-2008-3f93-a383-b90a5bf1a2a5",
                                                "text": "Of the passengers on the plane, half were English."
                                            },
                                            {
                                                "example_id": "391d26a6-f7d2-4baf-85a4-3075d087ae48",
                                                "sense_id": "52205e46-2008-3f93-a383-b90a5bf1a2a5",
                                                "text": "The cake was delicious: half was vanilla and half was chocolate."
                                            },
                                            {
                                                "example_id": "64e0baac-84b6-46c9-b838-cd5097ab23e0",
                                                "sense_id": "52205e46-2008-3f93-a383-b90a5bf1a2a5",
                                                "text": "Half (of) my friends live abroad."
                                            },
                                            {
                                                "example_id": "1fdcb4c6-6dba-4c6e-870b-101851055208",
                                                "sense_id": "52205e46-2008-3f93-a383-b90a5bf1a2a5",
                                                "text": "I’ve bought some chocolate. You can have half."
                                            },
                                            {
                                                "example_id": "a119b5f4-0702-4582-aa56-131cfdbded25",
                                                "sense_id": "52205e46-2008-3f93-a383-b90a5bf1a2a5",
                                                "text": "One and a half miles equals a mile and a half."
                                            },
                                            {
                                                "example_id": "2071d2fd-55ff-4cad-948e-f5bc2f43996a",
                                                "sense_id": "52205e46-2008-3f93-a383-b90a5bf1a2a5",
                                                "text": "Not half his riches known, and yet despised.",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            },
                                            {
                                                "example_id": "73d20c9e-44ad-4095-8823-3a91ccff65fa",
                                                "sense_id": "52205e46-2008-3f93-a383-b90a5bf1a2a5",
                                                "text": "I and he, / Brothers in Art; a friendship so complete / Portion'd in halves between us, […]"
                                            },
                                            {
                                                "example_id": "695fd6d7-0519-4b56-84fb-9654a74f325c",
                                                "sense_id": "52205e46-2008-3f93-a383-b90a5bf1a2a5",
                                                "text": "Both halves feature lyrics that are so teen-girly they sound like they were written in pink ink in a padlocked diary with hearts and frowny faces for punctuation."
                                            },
                                            {
                                                "example_id": "b55dd9c7-b0ae-4b25-9b2f-00606ae6ef8f",
                                                "sense_id": "52205e46-2008-3f93-a383-b90a5bf1a2a5",
                                                "text": "The Biden administration finalized the first national standard to limit dangerous “forever chemicals” found in nearly half of the drinking water in the United States."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "678856e2-a27b-3d44-8093-a028fad96576",
                                        "entry_id": "b6c67694-3e25-3ac9-a840-483ed1125bca",
                                        "glosses": [
                                            "One of two usually roughly equal parts into which anything may be divided, or considered as divided.",
                                            "One of two equal periods into which a game is divided."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faf9171a-265b-48ec-8c98-430313d4cc45",
                                                "sense_id": "678856e2-a27b-3d44-8093-a028fad96576",
                                                "text": "An association football match usually consists of two halves of 45 minutes each."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3609e9c-fb67-3d09-82d5-2071a1620d4b",
                                        "entry_id": "b6c67694-3e25-3ac9-a840-483ed1125bca",
                                        "glosses": [
                                            "One of two usually roughly equal parts into which anything may be divided, or considered as divided.",
                                            "One of the two opposite parts of the playing field of various sports, in which each starts the game."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb788dbf-0d15-45c1-9a43-55c689dc35fa",
                                                "sense_id": "a3609e9c-fb67-3d09-82d5-2071a1620d4b",
                                                "text": "However, the hosts hit back and hit back hard, first replacement hooker Andrew Hore sliding over, then Williams careering out of his own half and leaving several defenders for dead before flipping the ball to Nonu to finish off a scintillating move."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54907559-f808-37f0-b4fb-7edb05a62fae",
                                        "entry_id": "b6c67694-3e25-3ac9-a840-483ed1125bca",
                                        "glosses": [
                                            "Half of a standard measure, chiefly:",
                                            "half a pint of beer or cider. (Refusing a pint) Just a half, thank you. (Offering to top up a pint glass) Do you want a half in that? (Minimizing the amount of drink taken) A swift half at the Pear Tree."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dd031cf-339b-45a0-8686-bec3d2c8a72a",
                                                "sense_id": "54907559-f808-37f0-b4fb-7edb05a62fae",
                                                "text": "He came back with a pint of Guinness for me and a half of bitter for Wendy."
                                            },
                                            {
                                                "example_id": "63f1ac95-45aa-4bff-9cd3-a46dacf3b99f",
                                                "sense_id": "54907559-f808-37f0-b4fb-7edb05a62fae",
                                                "text": "I accepted a half of bitter from him."
                                            },
                                            {
                                                "example_id": "97668acc-1ed4-4c34-a870-2cdb1e44a588",
                                                "sense_id": "54907559-f808-37f0-b4fb-7edb05a62fae",
                                                "text": "I went to the bar where I bought a pint and two large brandies. ... \"Not brandy,\" she replied, \"but I could use a long drink - maybe a half of lager.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "556f27d1-0ac0-32d9-8bd9-6dca228b6a5a",
                                        "entry_id": "b6c67694-3e25-3ac9-a840-483ed1125bca",
                                        "glosses": [
                                            "Half of a standard measure, chiefly:",
                                            "A barrel measure of 27 gallons (half a hogshead)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a72d15ed-e41f-43a8-a0b2-c092197800cf",
                                                "sense_id": "556f27d1-0ac0-32d9-8bd9-6dca228b6a5a",
                                                "text": "Barrels came in firkins, nine gallons; kilderkins, eighteen gallons; halves, twenty-seven gallons; barrels, thirty-six gallons and hogsheads, fifty-four."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91c0cde8-3617-3dd7-9c3d-d588b61bb34b",
                                        "entry_id": "b6c67694-3e25-3ac9-a840-483ed1125bca",
                                        "glosses": [
                                            "The fraction obtained by dividing 1 by 2."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19cefb74-cb0e-44bd-bad1-2e6ace1e756a",
                                                "sense_id": "91c0cde8-3617-3dd7-9c3d-d588b61bb34b",
                                                "text": "Three-quarters minus a quarter is a half."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "873a283e-f77b-31c1-82c9-44fd92688eaa",
                                        "entry_id": "b6c67694-3e25-3ac9-a840-483ed1125bca",
                                        "glosses": [
                                            "Any of the three terms at Eton College, for Michaelmas, Lent, and summer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e21cdb9-7485-32be-a121-85d6cde041b4",
                                        "entry_id": "b6c67694-3e25-3ac9-a840-483ed1125bca",
                                        "glosses": [
                                            "A half sibling."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c026327c-7e6c-4592-a6a0-dc9af4026fc6",
                                                "sense_id": "6e21cdb9-7485-32be-a121-85d6cde041b4",
                                                "text": "So for Richard and Barbara, Jeff and Kari, the impossibly varied collection of steps and halves that is another legacy of my father."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca4e66c2-90ec-30fd-9e2f-3096329c1448",
                                        "entry_id": "b6c67694-3e25-3ac9-a840-483ed1125bca",
                                        "glosses": [
                                            "A child ticket. Two and a half to Paddington."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dated"
                                        ],
                                        "examples": []
                                    },
