                            {
                                "example_id": "40f5562f-9f73-46b5-b8dc-92d9317dcd1d",
                                "sense_id": "316f0fd8-b148-3dd3-915f-6b511efece6f",
                                "text": "Et, sans plus de façons, le juge de Valognes y avait pris place, dès potron-minet, alors que les dernières étoiles se miraient encore dans les eaux lourdes du bassin saint-vaastais mêlant leurs éclats pâlis à ceux du feu de la jetée, des phares de Jonville et Gatteville, aux deux clignots vert et rouge du brise-lame."
                            },
                            {
                                "example_id": "89d20769-f407-4dca-a463-36e4afbe641b",
                                "sense_id": "316f0fd8-b148-3dd3-915f-6b511efece6f",
                                "text": "Pendant quelques interminables minutes, l’ex-inspecteur-chef Alcazar laissa errer son regard sur la houle qui s’éteignait paisiblement sur le brise-lame."
                            }
                        ]
                    }
