                                        "entry_id": "eff3250f-bedd-36b4-a1c3-e82db2c674c7",
                                        "glosses": [
                                            "elk van de alternatieve uitvoeringen van een gen, die allemaal in homologe chromosomen op dezelfde plaats liggen"
                                        ],
                                        "tags": [],
