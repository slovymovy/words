        "nl-extract.jsonl": [
            {
                "entry_id": "81924ed4-633a-3f1b-acc2-3c1c2ce337dc",
                "word": "dankzij",
                "pos": "prep",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e5d98fc6-1085-39fe-b60c-10237475518d",
                        "entry_id": "81924ed4-633a-3f1b-acc2-3c1c2ce337dc",
                        "glosses": [
                            "door de positieve werking van"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "342d4046-109b-498d-a112-0dca48df6c60",
                                "sense_id": "e5d98fc6-1085-39fe-b60c-10237475518d",
                                "text": "Dankzij mijn vrouw is er nog iets van mij terecht gekomen."
                            },
                            {
                                "example_id": "e7365449-0b76-4d00-b267-f0b62dd63a7d",
                                "sense_id": "e5d98fc6-1085-39fe-b60c-10237475518d",
                                "text": "Was hun koning, Willem de Veroveraar, niet tijdens een geweldige storm, dankzij de heilige Nicolaas, veilig van Normandië naar Engeland gevaren? Want Nicolaas was in staat de wind en de onstuimige kracht der golven te doen bedaren!"
                            },
                            {
                                "example_id": "b91dbebd-c9ff-4328-b806-5887c83a7c3e",
                                "sense_id": "e5d98fc6-1085-39fe-b60c-10237475518d",
                                "text": "Er was weinig tot geen beschutting tegen de bloedhete zon en ik klapte al snel mijn zilveren paraplu uit. Paraplu? Ja dat vond ik zelf eerst ook raar, maar dankzij de schaduw van mijn paraplu ging mijn lichaamstemperatuur aanzienlijk omlaag."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "117cf07e-2dba-49f6-9b25-f5abb0bf62ad",
                        "source_entry_id": "81924ed4-633a-3f1b-acc2-3c1c2ce337dc",
                        "source_sense_id": "e5d98fc6-1085-39fe-b60c-10237475518d",
                        "source_sense_description": "door de positieve werking van",
                        "target_lang_word": "dank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f8faa01-36a1-39f0-bbab-8037b317a68c",
                                        "entry_id": "88c55be7-2b17-387e-a644-8d6d9bc7d36a",
                                        "glosses": [
                                            "durch etwas oder jemanden; aufgrund etwas oder jemandes"
                                        ],
                                        "tags": [
                                            "genitive prepositional",
                                            "with-dative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2ede6a1-e99f-4b07-b353-f810e3aa4bfc",
                                                "sense_id": "0f8faa01-36a1-39f0-bbab-8037b317a68c",
                                                "text": "„Drachenfliegen ist heute mindestens ebenso sicher wie Segelfliegen – dank enormer technischer Entwicklungen.“"
                                            },
                                            {
                                                "example_id": "2007af46-3630-40a7-ade3-59f8e1cb0eb1",
                                                "sense_id": "0f8faa01-36a1-39f0-bbab-8037b317a68c",
                                                "text": "Ich bin nun schlauer – dank dem Internet."
                                            },
                                            {
                                                "example_id": "f3864626-48fc-46c8-8af4-0348d0c87483",
                                                "sense_id": "0f8faa01-36a1-39f0-bbab-8037b317a68c",
                                                "text": "Dank ihrer Schnelligkeit kann die Feuerwehr mehr Leben retten."
                                            },
                                            {
                                                "example_id": "17f853c7-c9e6-4dc4-8f01-aa41f1fea404",
                                                "sense_id": "0f8faa01-36a1-39f0-bbab-8037b317a68c",
                                                "text": "Mein Buch konnte dank deiner Hilfe schneller fertig werden."
                                            },
                                            {
                                                "example_id": "14ce6ab4-a3ac-4270-956b-d11b775c1ac6",
                                                "sense_id": "0f8faa01-36a1-39f0-bbab-8037b317a68c",
                                                "text": "Dank des Vaters konnten wir eine gute Ausbildung absolvieren."
                                            },
                                            {
                                                "example_id": "b67008bc-6f7b-4efc-a5e0-1eabf149c256",
                                                "sense_id": "0f8faa01-36a1-39f0-bbab-8037b317a68c",
                                                "text": "Dank dem Vater konnten wir eine gute Ausbildung absolvieren."
                                            },
                                            {
                                                "example_id": "5f6a8e8c-a4e9-43df-a13b-5c833722f817",
                                                "sense_id": "0f8faa01-36a1-39f0-bbab-8037b317a68c",
                                                "text": "„Zum einen sind die Abgeordneten dank dem Grundgesetz allein ihrem Gewissen verpflichtet und in diesen Sonderfällen tatsächlich frei von Weisungen ihrer Fraktions- und Parteiführungen.“"
                                            },
                                            {
                                                "example_id": "68d83442-daa0-4fbf-85e5-79206c084b9a",
                                                "sense_id": "0f8faa01-36a1-39f0-bbab-8037b317a68c",
                                                "text": "„Boris hatte es im Laufe seiner Dienstzeit dank den Bemühungen Anna Michailownas, dank seinen eigenen guten Formen und dank der Eigenart seines Charakters – kluger Zurückhaltung – verstanden, sich eine in jeder Hinsicht hervorragende dienstliche Stellung zu verschaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "dank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3120f4a-1a67-30c5-a673-3aa3a149782f",
                                        "entry_id": "f0417170-058a-3645-b7c6-e781f036cd79",
