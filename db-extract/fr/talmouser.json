                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3da0b34a-9694-4e0d-936f-99b46c715960",
                                "sense_id": "503d72ca-bae9-3299-ab9e-bb5c6f943f31",
                                "text": "Salomon a talmousé, le 3 juin, une petite bande de Brigands au village de Saint-Martin-la-Fougereuse : il ne doute point d'aisément vergeter l'armée Catholique."
                            },
                            {
                                "example_id": "b6fe55ea-ef94-4466-8eca-291b2f823663",
                                "sense_id": "503d72ca-bae9-3299-ab9e-bb5c6f943f31",
                                "text": "D'autres se plaisaient davantage sur les champs de batailles ; talmouser les anges et écraser les humains, voilà qui était bien plus rigolo."
                            }
                        ]
                    }
