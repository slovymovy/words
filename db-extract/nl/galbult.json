                "senses": [
                    {
                        "sense_id": "9068b88c-e950-3d1c-87ec-6b37fb6a73dd",
                        "entry_id": "e0fb1674-a23b-3791-9c7e-06096753b5d9",
                        "glosses": [
                            "in korte tijd ontwikkelende, vaak heftige jeukende uitslag van de huid, die begint met rode vlekken en daarna in verdikte, bleke plekken kan overgaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10cabf28-49aa-4f3a-b79d-4ef140d619b7",
                                "sense_id": "9068b88c-e950-3d1c-87ec-6b37fb6a73dd",
                                "text": "Last van klachten als jeuk, ademhalingsproblemen, galbulten, netelroos, braakneigingen en het gevoel flauw te vallen tijdens het sporten? Dit wordt ook wel ’exercise-induced anaphylaxis’ genoemd, oftewel de allergie voor sporten."
                            },
                            {
                                "example_id": "b7da5525-4751-4668-a00a-b05e441b14ae",
                                "sense_id": "9068b88c-e950-3d1c-87ec-6b37fb6a73dd",
                                "text": "CSU is een ernstige en belastende huidaandoening die wordt gekenmerkt door rode, gezwollen, jeukende en soms pijnlijke netelroos of galbulten op de huid die spontaan optreden en gedurende meer dan zes weken aanhouden. Een groot deel van deze patiënten ervaart ook angio-oedeem, een zwelling in de diepe lagen van de huid."
                            },
                            {
                                "example_id": "539be04e-384c-489a-8a40-1091597a5838",
                                "sense_id": "9068b88c-e950-3d1c-87ec-6b37fb6a73dd",
                                "text": "Artsen van verschillende Nederlandse universiteitsziekenhuizen gaan de omvang in kaart brengen van het aantal patiënten met extreem pijnlijke jeuk door netelroos en galbulten (’urticaria’)."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f3315fb-4113-36e4-aab5-1649ac5b1c51",
                        "entry_id": "e0fb1674-a23b-3791-9c7e-06096753b5d9",
                        "glosses": [
                            "ergens geïrriteerd op reageren"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "af852898-b9ea-4ce9-9ea0-c4688403542c",
                                "sense_id": "6f3315fb-4113-36e4-aab5-1649ac5b1c51",
                                "text": "Vroeger kreeg ik galbulten van zweverige teksten, tegenwoordig vind ik ze wel wat hebben."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f35ec07-cb81-43ca-8add-0e04e2dd0130",
                        "source_entry_id": "e0fb1674-a23b-3791-9c7e-06096753b5d9",
                        "source_sense_id": "9068b88c-e950-3d1c-87ec-6b37fb6a73dd",
