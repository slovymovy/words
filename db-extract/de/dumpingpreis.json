                    {
                        "sense_id": "9012d87d-630e-3f9a-8063-fec8fb9141ee",
                        "entry_id": "2e639e04-ebec-3040-a592-6ed1ddfac882",
                        "glosses": [
                            "dumping price"
                        ],
