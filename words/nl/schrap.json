                    "sense_id": "60ba307d-d7cc-3e26-83e8-bd3cfa348398",
                    "sense_definition": "zich schrap houdend; voorbereid op een fysieke impact of weerstand",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met de voeten stevig op de grond bleef hij <w>schrap</w> staan.",
                            "target_lang_translations": {
                                "en": "With his feet firmly on the ground, he remained <w>braced</w>."
                            }
                        },
                        {
                            "text": "De matrozen hielden zich <w>schrap</w> toen de grote golf het schip raakte.",
                            "target_lang_translations": {
                                "en": "The sailors <w>braced</w> themselves when the large wave hit the ship."
