        "fr-extract.jsonl": [
            {
                "entry_id": "bf3dee1a-9342-3c4b-bb9b-eb561bd8c0e2",
                "word": "fumigène",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0ae71fc5-5495-4df2-afbc-3a582c08deb8",
                        "entry_id": "bf3dee1a-9342-3c4b-bb9b-eb561bd8c0e2",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "fumigènes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0f17bf20-52ab-327e-8c29-f104bc92a741",
                        "entry_id": "bf3dee1a-9342-3c4b-bb9b-eb561bd8c0e2",
                        "glosses": [
                            "Qui génère de la fumée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffc21521-1c96-4d0a-9536-7ea5a4c3c0fa",
                                "sense_id": "0f17bf20-52ab-327e-8c29-f104bc92a741",
                                "text": "Seize personnes […] auraient été arrêtées par la police qui a utilisé des bombes fumigènes."
                            },
                            {
                                "example_id": "f8e2a5ec-85c8-4ac7-a873-456cba670168",
                                "sense_id": "0f17bf20-52ab-327e-8c29-f104bc92a741",
                                "text": "Les observatoires de la colline de Saint-Walfroy, située à l'est, de l'autre côté de la Chiers, seront aveuglés par des tirs fumigènes qui seront poursuivis jusqu'à la tombée de la nuit."
                            },
                            {
                                "example_id": "32205117-b4d9-43cf-a582-9d3dad8811de",
                                "sense_id": "0f17bf20-52ab-327e-8c29-f104bc92a741",
                                "text": "Elle insulta un piéton qui traversait et se faufila en donnant des coups de klaxon indignés dans l’étroit passage laissé par un taxi et un bus fumigène."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "9a617376-45ef-3c60-b755-093e0a7f7113",
                "word": "fumigène",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0bc27f1e-e072-47dd-ba23-93ce4a7ed020",
                        "entry_id": "9a617376-45ef-3c60-b755-093e0a7f7113",
                        "tags": [
                            "plural"
                        ],
                        "form": "fumigènes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "06c468ba-edad-334d-bef7-9cfdd1e8a1bc",
                        "entry_id": "9a617376-45ef-3c60-b755-093e0a7f7113",
                        "glosses": [
                            "Objet destiné à produire de la fumée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0726ea76-9e08-4aae-ad0c-fc204eb62a93",
                                "sense_id": "06c468ba-edad-334d-bef7-9cfdd1e8a1bc",
                                "text": "D’énormes fumigènes rouges et une bombe agricole illuminèrent le virage de Boulogne, et différents projectiles fusèrent en direction du terrain sous les cris de : « CRS marseillais ! » Des agents de sécurité couraient dans tous les sens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20c87396-bd6d-4df3-9f24-86ae7aaeaf31",
                        "source_entry_id": "9a617376-45ef-3c60-b755-093e0a7f7113",
                        "source_sense_id": "06c468ba-edad-334d-bef7-9cfdd1e8a1bc",
                        "target_lang_word": "Nebelkerze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nebelkerze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b67a85e-4e9f-3517-9ecf-6810748469d0",
                                        "entry_id": "bb0ccd09-bf6d-3812-b7b1-b84ba0b5ca38",
                                        "glosses": [
                                            "Wurfgeschoss zur Erzeugung von Rauch oder Nebel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d784a03d-955e-4859-9049-24642cbd8c0f",
                                                "sense_id": "0b67a85e-4e9f-3517-9ecf-6810748469d0",
                                                "text": "Eine Nebelkerze bildet normalerweise im Freien eine Tarnwand von zehn Meter Höhe, zehn Meter Tiefe und 50 bis 90 Meter Breite."
                                            },
                                            {
                                                "example_id": "e094bdb0-4578-4148-8aa7-36c06edc5281",
                                                "sense_id": "0b67a85e-4e9f-3517-9ecf-6810748469d0",
                                                "text": "Als Silke schrie, hatten die SEK-Leute den Fluchtwagen auf der A 3 im Siebengebirge schon gerammt. Kugeln peitschten, Rauch von Nebelkerzen verdunkelte die Luft."
                                            },
                                            {
                                                "example_id": "5fe2f08f-3007-4e00-9356-659adae022df",
                                                "sense_id": "0b67a85e-4e9f-3517-9ecf-6810748469d0",
                                                "text": "Am Tatort wurden später zwei Kalaschnikow-Sturmgewehre, eine Panzerfaust, Nebelkerzen sowie eine Granate am Körper eines der Getöteten aufgefunden."
                                            },
                                            {
                                                "example_id": "c4beac59-0ad7-411c-a36e-b30b548f3a35",
                                                "sense_id": "0b67a85e-4e9f-3517-9ecf-6810748469d0",
                                                "text": "Wenn wir uns nicht, wie zuletzt in Ungarn, hinter Stacheldrahtverhauen mit Wasserwerfern, Nebelkerzen und Blendgranaten verteidigen oder am Ende gar auf Flüchtlinge schießen wollen, dann werden wir auch künftig mit einem starken Flüchtlingsaufkommen in Europa und Deutschland leben müssen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7d740e4a-23e6-3911-8c56-8a5ee0d32f4e",
                                        "entry_id": "bb0ccd09-bf6d-3812-b7b1-b84ba0b5ca38",
                                        "glosses": [
                                            "sprachliches Mittel, um etwas zu verschleiern"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "306cd2bf-50ad-4049-a00b-1e073d9fe84e",
                                                "sense_id": "7d740e4a-23e6-3911-8c56-8a5ee0d32f4e",
                                                "text": "„In der DDR diente ‘Ich sag mal so’ als Nebelkerze, um nicht auf eine Äußerung festgenagelt zu werden. Heute kaschiert die Floskel die Unfähigkeit, klar zu denken.“"
                                            },
                                            {
                                                "example_id": "7b5a1a7e-e3fa-4c40-8221-93e2f5757e07",
                                                "sense_id": "7d740e4a-23e6-3911-8c56-8a5ee0d32f4e",
                                                "text": "Der Vater glaubt, „dass das Unglück Folge einer technischen Unzulänglichkeit der Maschine oder eines unzureichenden Flugmanövers war. Das Flugzeug wurde letztlich über dem Limit beansprucht und dürfte bereits in der Luft zerbrochen sein.“ […] Die anfängliche Blitzschlag-Erklärung der Air France nennt er \"lächerlich, eine Nebelkerze, eine Beruhigungspille, ein Ablenkungsmanöver\"."
                                            },
                                            {
                                                "example_id": "a72429b7-5085-4ee4-a2b4-dee3d823338d",
                                                "sense_id": "7d740e4a-23e6-3911-8c56-8a5ee0d32f4e",
                                                "text": "„Eine der Trumpschen Nebelkerzen lautet zum Beispiel „alternative Fakten“. Alles schreit auf und diskutiert das Thema tagelang, während Trump im Hintergrund Politik macht, die der Schlagzeilen würdiger wäre: Reduzierung der Mittel für Frauengesundheit weltweit, Kappen der Gesundheitsversorgung für Amerikaner, Rücknahme der Entscheidung Obamas gegen die Keystone-Pipeline. Es erstaunt mich, wie sich die Medien von Trumps Nebelkerzen ködern lassen.“"
                                            },
                                            {
                                                "example_id": "7b28f31a-b62e-42f2-bcfc-dce3cb698fa3",
                                                "sense_id": "7d740e4a-23e6-3911-8c56-8a5ee0d32f4e",
                                                "text": "„Die Diskussion über Sterbehilfe ist eine große Nebelkerze“, sagt der Palliativarzt Gian Domenico Borasio. Denn sie lenkt von den wahren Bedrohungen am Lebensende ab."
                                            },
                                            {
                                                "example_id": "eb9fcbe2-041d-49c9-9d66-162f5403ff7b",
                                                "sense_id": "7d740e4a-23e6-3911-8c56-8a5ee0d32f4e",
                                                "text": "Das Verfahren gegen die kranke ukrainische Ex-Regierungschefin ist auf die Zeit nach der Fußball-EM vertagt worden. Als Nebelkerze für die Weltöffentlichkeit dient dabei eine amtsärztliche Untersuchung Timoschenkos."
                                            },
                                            {
                                                "example_id": "6270eb64-2bca-4899-b966-2c1067daaabd",
                                                "sense_id": "7d740e4a-23e6-3911-8c56-8a5ee0d32f4e",
                                                "text": "Kritik übte er [der Bündnis 90/Die Grünen-Politiker Sven Giegold] auch an Bundeswirtschaftsminister Sigmar Gabriel (SPD). Dessen Aussage, die TTIP-Verhandlungen seien \"de facto gescheitert\", sei nur eine Nebelkerze, um gleichzeitig das CETA-Abkommen mit Kanada gegenüber der SPD durchzusetzen. Die Sozialdemokraten sollten stattdessen gemeinsam mit den Grünen eine \"Paralleljustiz\" in Europa verhindern."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8a89a93-330b-4239-80c4-1c54d2a69e6d",
                        "source_entry_id": "9a617376-45ef-3c60-b755-093e0a7f7113",
                        "source_sense_id": "06c468ba-edad-334d-bef7-9cfdd1e8a1bc",
                        "target_lang_word": "smoke bomb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smoke bomb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b843d59e-b252-3cde-9016-48cc972e7bbc",
                                        "entry_id": "21303a59-a18b-37cd-acc2-182865daeeba",
                                        "glosses": [
                                            "A firework designed to produce smoke upon ignition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "131a7157-f4ba-4d39-8082-a029f99def29",
                                                "sense_id": "b843d59e-b252-3cde-9016-48cc972e7bbc",
                                                "text": "It was the morning of the Fourth of July and kids were lighting smoke bombs, sulfurous coils of red and green, the colors dense and bright like concentrated dye blooming through water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a45ff6b-45f6-3dd1-a9cd-1193d2639771",
                                        "entry_id": "21303a59-a18b-37cd-acc2-182865daeeba",
                                        "glosses": [
                                            "An explosive or incendiary device designed to emit smoke in order to mark a position or produce a smokescreen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bac6f591-7626-4053-b58f-8986e5bca4fe",
                                                "sense_id": "9a45ff6b-45f6-3dd1-a9cd-1193d2639771",
                                                "text": "Smoke bombs would be used. The thick fumes resulting from their explosion between the lines would cover our advance."
                                            },
                                            {
                                                "example_id": "8f3bec0e-c32f-469c-b6eb-76a6bdfee43d",
                                                "sense_id": "9a45ff6b-45f6-3dd1-a9cd-1193d2639771",
                                                "text": "Over every German battery would soar the observation plane indicating by tinsel or smoke bombs the location of the guns […]"
                                            },
                                            {
                                                "example_id": "46cf9936-e5cf-4e4a-89a5-7607b2d86962",
                                                "sense_id": "9a45ff6b-45f6-3dd1-a9cd-1193d2639771",
                                                "text": "Margot would plant smoke-bombs in Kuno’s bedroom and then rush in to rescue him from the fumes."
                                            },
                                            {
                                                "example_id": "5753c341-4ad9-4220-8cf3-afacdac367ee",
                                                "sense_id": "9a45ff6b-45f6-3dd1-a9cd-1193d2639771",
                                                "text": "The agent gave them the two camera-cases you saw. […] He told them that the blue case contained a very powerful smoke-bomb. The red case was the explosive. As one of them threw the red case, the other was to press a switch on the blue case and they would escape under cover of the smoke."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
