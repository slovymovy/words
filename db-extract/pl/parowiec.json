                                        "glosses": [
                                            "A ship or vessel propelled by steam power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20204c86-2525-4f5d-8ffa-50804c5fe17e",
                                                "sense_id": "8bafaa82-0a05-3252-81bb-d8aa7e3af1c0",
                                                "text": "Steamship arrivals, however, are less predictable and the best arrangements of shipping companies and the railway operating department may be upset by weather and tide."
                                            },
                                            {
                                                "example_id": "06b0d395-69d7-4b43-8a41-b74cc1529460",
                                                "sense_id": "8bafaa82-0a05-3252-81bb-d8aa7e3af1c0",
                                                "text": "The shipwreck is the earliest examples yet found of a propeller-driven steamship on the Great Lakes."
                                            },
                                            {
                                                "example_id": "b54548e2-c6ed-4e84-b423-54f35e2bb863",
                                                "sense_id": "8bafaa82-0a05-3252-81bb-d8aa7e3af1c0",
                                                "text": "India’s half-hour zone dates back to colonial rule of India and the era when ever-faster steamships and trains were shrinking the world."
                                            }
