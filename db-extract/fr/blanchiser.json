                "senses": [
                    {
                        "sense_id": "db2c4a1e-20b2-3f97-a525-ab1b1fbd4ad7",
                        "entry_id": "d58d8f71-2aa1-3379-a0bf-e8fea57f10d9",
                        "glosses": [
                            "Rendre blanc (au sens racial du terme)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22d2b7c4-4691-4469-adb1-9df7fd321b38",
                                "sense_id": "db2c4a1e-20b2-3f97-a525-ab1b1fbd4ad7",
                                "text": "Et tandis que nous parlions, je ne fis pas attention à l’avant-dernière cliente, la Négresse blanchisée à l’Ultraclear."
                            },
                            {
                                "example_id": "405fbece-f9ac-4f82-997b-2b7f3309d2c4",
                                "sense_id": "db2c4a1e-20b2-3f97-a525-ab1b1fbd4ad7",
                                "text": "Comme le note Frantz Fanon dans son ouvrage Peaux noires, masques blancs, le Nègre utilise toutes les lotions, toutes les crèmes, toutes les poudres, se défrise les cheveux pour accéder à la race blanche, pour se « blanchiser »."
                            }
                        ]
                    }
