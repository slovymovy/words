                        "examples": [
                            {
                                "example_id": "956d6e3a-3c3a-4a33-b49a-ff2b707ab928",
                                "sense_id": "df883dac-1e7b-357d-b894-5c45fc4e6f13",
                                "text": "Het Stade Yves du Manoir in Parijs barstte donderdagavond uit zijn voegen nadat Duco Telgenkamp in de olympische hockeyfinale de beslissende shoot-out had binnengeschoten. De hockeyers stortten zich vooral op de gevierde doelman Pirmin Blaak, die in de door Oranje gewonnen shoot-out tegen Duitsland een hoofdrol speelde."
                            },
                            {
                                "example_id": "e06ba68a-addf-4f04-ad81-9cc6b11d8173",
                                "sense_id": "df883dac-1e7b-357d-b894-5c45fc4e6f13",
                                "text": "De reactie van Xan de Waard na de olympische hockeyfinale, die werd gewonnen van China. Oranje-keepster Anne Veenendaal stopte drie van de vier shoot-outs."
                            }
