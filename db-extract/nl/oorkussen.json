                    {
                        "sense_id": "7dbb02b6-68e0-3359-9acb-6db4e998fda2",
                        "entry_id": "d55ed04d-5798-3495-add3-4594a1fab04c",
                        "glosses": [
                            "het zachte deel van een hoofdtelefoon dat tegen of om het oor zit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a64452b-06de-4d1e-84ce-c531bc61aadf",
                                "sense_id": "7dbb02b6-68e0-3359-9acb-6db4e998fda2",
                                "text": "De Q Adapt valt meteen op door het strakke, minimalistische design. Ondanks de kleine oorkussens heeft deze hoofdtelefoon een mooie geluidsweergave. Bij diverse typen muziek konden we de verschillende klanken goed onderscheiden. Zeker voor een on-ear model is ook de noise cancelling verrassend goed."
                            }
                        ]
                    },
