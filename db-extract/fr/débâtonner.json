                "senses": [
                    {
                        "sense_id": "2cb16511-a4c5-3dec-aebe-0358c48d1224",
                        "entry_id": "5f5c1bfe-bc98-362a-bd06-9c64e9c15205",
                        "glosses": [
                            "Enlever du bâton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc0a0d04-d0e1-44e7-ab4f-eb47dabdba8f",
                                "sense_id": "2cb16511-a4c5-3dec-aebe-0358c48d1224",
                                "text": "Une machine teignant cent kilos de matière est conduite par un seul ouvrier qui a le temps, pendant la durée de la passe, de préparer la matière pour la passe suivante et de débâtonner ensuite la matière teinte."
                            },
                            {
                                "example_id": "2664709f-865f-43ba-a4b2-28c6b962e548",
                                "sense_id": "2cb16511-a4c5-3dec-aebe-0358c48d1224",
                                "text": "En effet, dans les procédés ordinaires, il faut après chaque opération débâtonner la soie, la tordre, l’essorer ou diabler, puis la remettre en bâton."
                            }
                        ]
                    }
