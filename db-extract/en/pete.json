                "senses": [
                    {
                        "sense_id": "e5ad6d1d-96b3-3f18-bd7a-fc43334da2fb",
                        "entry_id": "5f03f6ea-4a91-31cb-ba82-704126cc3ac7",
                        "glosses": [
                            "A diminutive of the male given name Peter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a64dc5f-9576-4459-b1af-8d426618c251",
                                "sense_id": "e5ad6d1d-96b3-3f18-bd7a-fc43334da2fb",
                                "text": "“Where’s Pete?” Pearce asked him. / “Pete?” Shortarse’s mouth stretched and slackened and stretched again. You couldn’t tell if he’d just stubbed his toe, or if he was about to burst into hysterical laughter. / “How many Petes you got working here?” / Shortarse shrugged. […] “Thompson,” Pearce said with his eyes closed. “Thompson,” he said again. He opened his eyes and stared. “I’d like to see Pete Thompson.”"
                            },
                            {
                                "example_id": "bae3771f-3f41-492a-b4c8-154242fa0d56",
                                "sense_id": "e5ad6d1d-96b3-3f18-bd7a-fc43334da2fb",
                                "text": "According to the Atlantic, national security adviser Mike Waltz earlier this month convened a text conversation with top US officials, including Vice President JD Vance, Defense Secretary Pete Hegseth and Secretary of State Marco Rubio, to discuss strikes on Houthi militants in Yemen who had been threatening international shipping in the Red Sea. Waltz, apparently accidentally, added Atlantic editor in chief Jeffrey Goldberg to the chain."
                            }
                        ]
                    },
                    {
                        "sense_id": "251f2d28-b465-3df0-9799-6fe76fe6c910",
                        "entry_id": "5f03f6ea-4a91-31cb-ba82-704126cc3ac7",
                        "glosses": [
                            "A Peterbilt truck."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d623dc66-c1e2-48fe-a4e5-4b38ad3942eb",
                                "sense_id": "251f2d28-b465-3df0-9799-6fe76fe6c910",
                                "text": "Was the dark of the moon on the sixth of June\nIn a Kenworth pullin' logs.\nCab-over Pete with a reefer on\nAnd a Jimmy haulin' hogs."
                            }
                        ]
                    }
