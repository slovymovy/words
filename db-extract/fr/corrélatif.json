                                        "entry_id": "97674c07-9a5c-34ab-8d71-a4e6f232df0a",
                                        "glosses": [
                                            "Término o elemento que se relaciona con otro u otros en sucesión, correspondencia o influencia recíproca, de tal modo que hace parte de una correlación o serie lógica."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "365934ec-440d-4b74-bd10-4e964707ba9d",
                                                "sense_id": "02a2c30b-2cda-38f0-b079-71297069a129",
                                                "text": "* Los adverbios \"aquí\" y \"allá\" son correlatos en la indicación de lugar."
                                            },
                                            {
                                                "example_id": "5f212b68-8c60-4ab7-84ab-eace0af86338",
                                                "sense_id": "02a2c30b-2cda-38f0-b079-71297069a129",
                                                "text": "* La suerte es un correlato del talento para obtener un buen ingreso."
                                            },
                                            {
                                                "example_id": "fcf12378-b3be-437d-a3e3-3f590a2577b7",
                                                "sense_id": "02a2c30b-2cda-38f0-b079-71297069a129",
                                                "text": "* El término \"tanto...\" es correlato de \"como...\" en la frase \"Tanto ella como él juegan al fútbol\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
