                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19237cc1-752b-4dd7-903e-9a3bab11a791",
                                                "sense_id": "f8fa6537-0f0f-3ba0-af39-d5bee89ff287",
                                                "text": "Or perhaps your Islamophobism is keeping you these \"disease\" filled masses called Muslims? :o I know of no harm that has come to us from non Muslims of other lands. It is only the Islamists who have take a vow to fight us and with Bush's blessing they may even prevail."
                                            },
                                            {
                                                "example_id": "eb74fa79-c989-4b41-ae68-be3e4b300548",
                                                "sense_id": "f8fa6537-0f0f-3ba0-af39-d5bee89ff287",
                                                "text": "Islamophobism is a disease, much like Hitler's Jew-hating was a disease."
                                            },
                                            {
                                                "example_id": "9ce77964-abc5-40a5-962f-42f392272dd0",
                                                "sense_id": "f8fa6537-0f0f-3ba0-af39-d5bee89ff287",
                                                "text": "Or perhaps your Islamophobism is keeping you these \"disease\" filled masses called Muslims? :o Let the West leave alone those whom they consider \"inferior\" and I will show you how prosperous they become. Muslims used to be in the lead of science. Non-Muslims came from all corners of the world to be educated by Muslims (see \"Islam, an Empire of Faith.\")"
                                            }
                                        ]
                                    }
                                ]
                            }
