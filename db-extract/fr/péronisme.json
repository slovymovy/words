                        "entry_id": "593f27db-f4eb-393f-b27e-d7dc5bc434af",
                        "glosses": [
                            "Doctrine politique du président argentin, Juan Perón ou de sa femme Eva Duarte de Perón et de leurs successeurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "393734ad-ec48-4629-a0f9-babffd34bba9",
                                "sense_id": "4f0d9e4c-5c89-3941-99aa-7b8fc8107a34",
                                "text": "Le péronisme est une nouvelle doctrine politique qui rejette les défauts de la politique des temps révolus."
                            }
                        ]
                    }
                ],
