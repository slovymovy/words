        "fr-extract.jsonl": [
            {
                "entry_id": "1135d4a7-1cd0-3bf9-9363-f51f5214e18b",
                "word": "Électre",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a5778ebb-9129-317a-bcad-5600d02eb97f",
                        "entry_id": "1135d4a7-1cd0-3bf9-9363-f51f5214e18b",
                        "glosses": [
                            "Membre de la famille des Atrides, fille d’Agamemnon, sœur d’Oreste et d’Iphigénie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e3e4867-91e2-43a1-9794-a7f2ba2c5029",
                                "sense_id": "a5778ebb-9129-317a-bcad-5600d02eb97f",
                                "text": "Ô daigne accomplir ma prière, Maître de l’Olympe et des dieux ! Que je voie Électre et son frère, exaucés dans leurs justes vœux !"
                            }
                        ]
                    },
                    {
                        "sense_id": "116565fd-3d0f-3ce0-96f1-5aabbd3a2793",
                        "entry_id": "1135d4a7-1cd0-3bf9-9363-f51f5214e18b",
                        "glosses": [
                            "Une des sept Pléiades, mère de Dardanos."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "106b7b5c-28e5-3f7e-89b0-e8c2990a5d50",
                        "entry_id": "1135d4a7-1cd0-3bf9-9363-f51f5214e18b",
                        "glosses": [
                            "Une Océanide, mère d’Iris, Arcé et des Harpies."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fc42f436-6054-3b21-baa9-6b654050a32f",
                        "entry_id": "1135d4a7-1cd0-3bf9-9363-f51f5214e18b",
                        "glosses": [
                            "Une Danaïde, fille de Danaos et de Polyxo, qui tua son époux Péristhène."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a50b53d5-30d5-3462-9066-283ba571ddb7",
                        "entry_id": "1135d4a7-1cd0-3bf9-9363-f51f5214e18b",
                        "glosses": [
                            "En mythologie grecque, fille d’Agénor, sœur de Cadmos."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7ddfc295-e77f-3798-b1b6-8c93fc309fd5",
                        "entry_id": "1135d4a7-1cd0-3bf9-9363-f51f5214e18b",
                        "glosses": [
                            "En mythologie grecque, suivante d’Hélène de Troie."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "84f3bb3b-146f-3a19-a9d8-f296f5d41a1e",
                        "entry_id": "1135d4a7-1cd0-3bf9-9363-f51f5214e18b",
                        "glosses": [
                            "En mythologie grecque, fille de Latinos (ou Latinus)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a03a1b0b-e070-3ff3-a388-f9cb06c74d89",
                        "entry_id": "1135d4a7-1cd0-3bf9-9363-f51f5214e18b",
                        "glosses": [
                            "Une des plus grosses étoiles de l’amas des Pléiades, dans la constellation du Taureau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4e01434-955f-48f3-b58f-2e3835736fcb",
                                "sense_id": "a03a1b0b-e070-3ff3-a388-f9cb06c74d89",
                                "text": "Les étoiles les plus visibles de ce groupe sont nommées comme les Sept Sœurs, dans la mythologie grecque : Astérope, Mérope, Électre, Maïa, Taygète, Célaéno et Alcyone avec leur parents, Atlas et Pléioné."
                            }
                        ]
                    },
                    {
                        "sense_id": "18829299-5f25-3daa-8894-d1e9578ec420",
                        "entry_id": "1135d4a7-1cd0-3bf9-9363-f51f5214e18b",
                        "glosses": [
                            "(130) Électre, internationalement (130) Elektra, un astéroïde de la ceinture principale découvert par Christian Peters le 17 février 1873."
                        ],
                        "tags": [],
                        "examples": []
                    }
