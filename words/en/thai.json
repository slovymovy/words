                {
                    "sense_id": "71d06aae-aeab-326e-b560-3502bb98772e",
                    "sense_definition": "Thai cuisine; traditional Thai food.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to eat <w>Thai</w> instead of Italian tonight.",
                            "target_lang_translations": {
                                "ru": "Мы решили поесть <w>тайской кухни</w> вместо итальянской сегодня вечером.",
                                "zh": "我们决定今晚吃<w>泰国菜</w>，而不是意大利菜。"
                            }
                        },
                        {
                            "text": "If you like spicy food, you will love <w>Thai</w>.",
                            "target_lang_translations": {
                                "ru": "Если вам нравится острая еда, вам понравится <w>тайская кухня</w>.",
                                "zh": "如果你喜欢吃辣，你一定会爱上<w>泰国菜</w>。"
                            }
                        }
                    ],
