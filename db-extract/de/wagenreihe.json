                "senses": [
                    {
                        "sense_id": "a967da4c-8b68-36a2-aa81-2b61700716f7",
                        "entry_id": "73e793f4-8dc9-3169-8206-1d45e5bb68bc",
                        "glosses": [
                            "Gesamtheit mehrerer, aufeinander folgender oder nebeneinander befindlicher Wagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91929bb3-4dbf-4248-b958-562a9263fcd4",
                                "sense_id": "a967da4c-8b68-36a2-aa81-2b61700716f7",
                                "text": "„Gunther begegnete der Wagenreihe, die von der Kirche her auf der Straße entlengkam.“"
                            },
                            {
                                "example_id": "77f92402-3dac-405d-8f92-a5bf5e5f9d13",
                                "sense_id": "a967da4c-8b68-36a2-aa81-2b61700716f7",
                                "text": "„Und nun sahen beide wieder der Wagenreihe nach und horchten auf das Echo, das das Gerassel und Geklapper in den Bergen wachrief und fast so klang, als ob immer neue Züge vom Hexentanzplatz her herunterkämen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
