                {
                    "sense_id": "5a88084d-50e0-3fd1-a983-de2b762ba029",
                    "sense_definition": "Otwarty i dostępny dla klientów lub interesantów (o sklepie, urzędzie, lokalu usługowym).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "open_business",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten sklep spożywczy jest <w>czynny</w> przez całą dobę.",
                            "target_lang_translations": {
                                "ru": "Этот продуктовый магазин <w>открыт</w> круглосуточно.",
                                "en": "This grocery store is <w>open</w> 24 hours a day."
                            }
                        },
                        {
                            "text": "W niedzielę basen jest <w>czynny</w> tylko do godziny piętnastej.",
                            "target_lang_translations": {
                                "ru": "В воскресенье бассейн <w>работает</w> только до пятнадцати часов.",
                                "en": "On Sunday, the swimming pool is <w>open</w> only until three p.m."
                            }
                        }
                    ],
                    "synonyms": [
                        "otwarty"
                    ],
                    "antonyms": [
                        "zamknięty",
                        "nieczynny"
                    ],
                    "common_phrases": [
                        "czynny całą dobę",
                        "sklep czynny",
                        "czynne do odwołania"
                    ],
                    "target_lang_definitions": {
