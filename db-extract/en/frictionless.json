{
    "word": "frictionless",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6b6fbec6-f7d8-30e1-b7c0-64aa0bcd69e7",
                "word": "frictionless",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7f957846-b722-3b0a-aeb3-33c2116aa35f",
                        "entry_id": "6b6fbec6-f7d8-30e1-b7c0-64aa0bcd69e7",
                        "glosses": [
                            "Of or pertaining to lack of friction."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f98f2173-1ad2-46d5-82ba-04e26fc96ff0",
                                "sense_id": "7f957846-b722-3b0a-aeb3-33c2116aa35f",
                                "text": "It would last many years because of its frictionless bearings."
                            },
                            {
                                "example_id": "f7b03ef9-6b82-491f-8748-c65a86ee26dd",
                                "sense_id": "7f957846-b722-3b0a-aeb3-33c2116aa35f",
                                "text": "A hard border is a real possibility, and a frictionless border is almost an oxymoron."
                            },
                            {
                                "example_id": "e7f98d1f-ef37-4cb4-98cc-84be8162b8d7",
                                "sense_id": "7f957846-b722-3b0a-aeb3-33c2116aa35f",
                                "text": "In the decade ahead, the story must be one of increasingly frictionless travel."
                            },
                            {
                                "example_id": "dd143339-b395-437d-a81f-7cbd0e7654ba",
                                "sense_id": "7f957846-b722-3b0a-aeb3-33c2116aa35f",
                                "text": "To her, adding AI into relationships “presupposes inadequacy” in them, and offers a sterile alternative: always saying the right thing, back and forth, frictionless forever."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2607b1b-7a9d-30b0-9acc-e7bef4a56586",
                        "entry_id": "6b6fbec6-f7d8-30e1-b7c0-64aa0bcd69e7",
                        "glosses": [
                            "Of a transaction or trade, without tariffs and non-tariff barriers."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "0d66bffd-5d4b-4010-9892-f46005d929f1",
                                "sense_id": "b2607b1b-7a9d-30b0-9acc-e7bef4a56586",
                                "text": "\"There can be no frictionless trade outside of the customs union and the single market,\" said Donald Tusk, president of the council of all 28 EU member states."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4f5ac1d-1c58-4fa7-885f-4d3b65b9dbb2",
                        "source_entry_id": "6b6fbec6-f7d8-30e1-b7c0-64aa0bcd69e7",
                        "source_sense_description": "of or pertaining to lack of friction",
                        "target_lang_word": "reibungslos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reibungslos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc196948-dd84-336b-8fb0-ed3bc50b3509",
                                        "entry_id": "9acf4fa3-7433-3e4c-a4f4-eb6083972fcb",
                                        "glosses": [
                                            "störungsfrei, ohne Schwierigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91af8cdd-66b2-4dc3-b504-71232d3fe6e4",
                                                "sense_id": "bc196948-dd84-336b-8fb0-ed3bc50b3509",
                                                "text": "Die Verhandlungen verliefen reibungslos; schon nach wenigen Stunden präsentierten die parteien gutgelaunt ihren Kompromiss."
                                            },
                                            {
                                                "example_id": "a0538383-6cc3-4f3f-9498-eadfc578733c",
                                                "sense_id": "bc196948-dd84-336b-8fb0-ed3bc50b3509",
                                                "text": "Um einen reibungslosen Betrieb zu gewährleisten sind alle Mitarbeiter zu einer pünktlichen Arbeitsweise gehalten."
                                            },
                                            {
                                                "example_id": "3b8d7f64-1360-4529-a9d3-56df1e55045b",
                                                "sense_id": "bc196948-dd84-336b-8fb0-ed3bc50b3509",
                                                "text": "„Freilich, in Straußens Kalkül, so heißt es, wäre Carstens stets nur ein Bewerber oder Regierungschef, von dem sich der spätere Übergang zu einem Kandidaten oder Kanzler Strauß am reibungslosesten vollziehen ließe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
