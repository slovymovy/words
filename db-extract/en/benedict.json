                                                "example_id": "a8eaf0a8-c970-484f-9329-bd5640b32e00",
                                                "sense_id": "055aba05-2c95-3cc8-a447-a69fba055eb6",
                                                "text": "« La vie de Morgan ne vaut pas grand-chose si rien ne change », a plaidé Benoît Coussy, l’avocat de Rowan, le frère de la victime."
                                            }
