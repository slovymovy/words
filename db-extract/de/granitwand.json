                "senses": [
                    {
                        "sense_id": "19c29a46-1fbc-335d-93e9-e82ab91c14b9",
                        "entry_id": "bc0f1d13-9e36-371a-bbc5-6a0115017584",
                        "glosses": [
                            "Wand aus Granit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef2fa5ec-f504-49e5-b4c8-5d6ef28903a9",
                                "sense_id": "19c29a46-1fbc-335d-93e9-e82ab91c14b9",
                                "text": "„Die Höhle war tief; wesentlich tiefer, als irgendjemand außer Randolph vermutet hätte, denn der Junge hatte einen Spalt im hintersten schwarzen Winkel entdeckt, der in eine noch eindrucksvollere Grotte führte - ein Ort wie eine gespenstische Grabkammer, deren Granitwände merkwürdigerweise den Eindruck erweckten, von Menschenhand geschaffen zu sein.“"
                            },
                            {
                                "example_id": "ad938dcd-4a12-4a68-8815-e7637f9a899d",
                                "sense_id": "19c29a46-1fbc-335d-93e9-e82ab91c14b9",
                                "text": "„Er schob die dicht verwobenen Schlingpflanzen und Farne beiseite - und ihm blieb für einen Moment die Luft weg, als er das schwere Eisentor sah, das in eine schmale Öffnung in der Granitwand eingebaut war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
