                    "sense_definition": "verouderde gebiedende wijs meervoud van <w>lessen</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lessen_conjugation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Lest</w> allen uw dorst bij deze frisse bron in het bos.",
                            "target_lang_translations": {
