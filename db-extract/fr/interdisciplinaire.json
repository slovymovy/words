        "fr-extract.jsonl": [
            {
                "entry_id": "ac722b7d-a5b1-3118-ab33-bc09e4efb60b",
                "word": "interdisciplinaire",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d1aea130-a52f-4853-8fbe-68f1452003a0",
                        "entry_id": "ac722b7d-a5b1-3118-ab33-bc09e4efb60b",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "interdisciplinaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "29dbc81d-d4a0-3f65-af58-1d309a6ea79d",
                        "entry_id": "ac722b7d-a5b1-3118-ab33-bc09e4efb60b",
                        "glosses": [
                            "Qui met en relation plusieurs disciplines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eedd23d-ffd4-4719-9afd-43cb7bc5bd93",
                                "sense_id": "29dbc81d-d4a0-3f65-af58-1d309a6ea79d",
                                "text": "De fait, il est peu de domaines plus interdisciplinaires que les études de genre. C’est ainsi que l’Institut Émilie du Châtelet, fondé en 2006 sous l’impulsion du Conseil régional d’Île-de-France pour développer ce champ en finançant des thèses, a pu associer des chercheuses (et aussi des chercheurs) de toutes ces disciplines, et bien d’autres encore, y compris du côté des sciences de la nature (biologie cellulaire, paléoanthropologie, neurobiologie…)."
                            },
                            {
                                "example_id": "af4d5256-4e5c-4176-b025-c31dddd2a253",
                                "sense_id": "29dbc81d-d4a0-3f65-af58-1d309a6ea79d",
                                "text": "Il faudrait aussi une représentation interdisciplinaire avec des spécialistes du développement de l'enfant, des accidentologues, des ingénieurs, des urbanistes, des cliniciens, des sociologues et d'autres encore."
                            },
                            {
                                "example_id": "30f91e0f-5a50-4c08-a6ef-97665d4d5f38",
                                "sense_id": "29dbc81d-d4a0-3f65-af58-1d309a6ea79d",
                                "text": "Les commentaires … distinguent des thèmes pouvant se prêter à des ouvertures interdisciplinaires, en concertation avec les professeurs d'autres disciplines scientifiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c5757ca-9e66-42e4-96ba-1f0c2edb6891",
                        "source_entry_id": "ac722b7d-a5b1-3118-ab33-bc09e4efb60b",
                        "source_sense_id": "29dbc81d-d4a0-3f65-af58-1d309a6ea79d",
                        "target_lang_word": "interdisciplinary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interdisciplinary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6da5075-46b5-3eb8-901d-055244b97e53",
                                        "entry_id": "6d3b0769-6f75-3189-a1c0-cdd5703cccee",
                                        "glosses": [
                                            "Of or pertaining to multiple distinct academic disciplines or fields of study."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "188363cb-a32b-464e-ad75-18185b230d43",
                                                "sense_id": "a6da5075-46b5-3eb8-901d-055244b97e53",
                                                "text": "Near-synonyms: crossdisciplinary, multidisciplinary, pluridisciplinary, transdisciplinary"
                                            },
                                            {
                                                "example_id": "f1cc4449-42bc-4c1b-b04a-b1d4f775c00a",
                                                "sense_id": "a6da5075-46b5-3eb8-901d-055244b97e53",
                                                "text": "This journal is interdisciplinary: it has articles on everything from biology to electrical engineering."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0267817-dd6c-3a26-802b-e2b3b96b1401",
                                        "entry_id": "6d3b0769-6f75-3189-a1c0-cdd5703cccee",
                                        "glosses": [
                                            "Of or pertaining to a linkage between multiple distinct academic disciplines or fields of study."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17599fa7-49c2-4c40-b51a-c7b756da07df",
                                                "sense_id": "d0267817-dd6c-3a26-802b-e2b3b96b1401",
                                                "text": "The interdisciplinary co-operation at this university is very impressive."
                                            },
                                            {
                                                "example_id": "7d386389-081a-464a-bece-920cd1793671",
                                                "sense_id": "d0267817-dd6c-3a26-802b-e2b3b96b1401",
                                                "text": "This was a very generous way of describing the swarm of cables, kit-bashed thaumatic cores, Noogenic foci and para-technological inverters, all surrounded by an astoundingly complex cognitohazardous sigil and multiple ontological anchors. This, simultaneously, simplified the interdisciplinary effort that had swelled in a miniscule amount of time, and undercut the sheer conceptual impact this could leave in all of their respective fields."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fc3f3f0-22b1-44b9-b489-d9d478d6f490",
