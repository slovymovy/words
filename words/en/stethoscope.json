{
    "word_family": [
        "stethoscopic",
        "stethoscopically",
        "stethoscopist",
        "stethoscopy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12377930-3877-3f86-8e1e-1eb0489845c2",
                    "sense_definition": "A medical instrument used for listening to sounds produced within the body, especially the heart or lungs.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor placed the <w>stethoscope</w> on my chest to listen to my heart.",
                            "target_lang_translations": {
                                "ru": "Врач приложил <w>стетоскоп</w> к моей груди, чтобы послушать сердце."
                            }
                        },
                        {
                            "text": "She wore a <w>stethoscope</w> around her neck as she walked through the clinic.",
                            "target_lang_translations": {
                                "ru": "Проходя по клинике, она несла на шее <w>стетоскоп</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "listen with a stethoscope"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинский прибор, используемый для выслушивания звуков внутренних органов, особенно сердца или лёгких."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стетоскоп",
                                "target_lang_sense_clarification": "медицинский инструмент"
                            },
                            {
                                "target_lang_word": "фонендоскоп",
                                "target_lang_sense_clarification": "медицинский инструмент с мембраной"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8b360d8b-bb9e-36a9-9753-db3c1a99c582",
                    "sense_definition": "To examine or listen to a patient's internal sounds using a stethoscope.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The physician carefully <w>stethoscoped</w> the patient to check for irregular lung sounds.",
                            "target_lang_translations": {
                                "ru": "Врач внимательно <w>выслушал стетоскопом</w> пациента, чтобы проверить наличие хрипов в лёгких."
                            }
                        },
                        {
                            "text": "After the nurse finished taking vitals, the doctor decided to <w>stethoscope</w> his chest.",
                            "target_lang_translations": {
                                "ru": "После того как медсестра закончила измерять основные показатели, врач решил <w>прослушать стетоскопом</w> его грудную клетку."
                            }
                        }
                    ],
                    "synonyms": [
                        "auscultate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обследовать или выслушивать пациента с помощью стетоскопа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выслушивать стетоскопом",
                                "target_lang_sense_clarification": "проводить аускультацию прибором"
                            },
                            {
                                "target_lang_word": "прослушивать стетоскопом",
                                "target_lang_sense_clarification": "осматривать больного прибором"
                            },
                            {
                                "target_lang_word": "аускультировать",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}