                    {
                        "sense_id": "ea80227c-c58b-3cc7-b812-92c3c5f2dfa4",
                        "entry_id": "f08011ee-b101-30b8-be04-14ea79b61edd",
                        "glosses": [
                            "Adjectif numéral ordinal correspondant au nombre 21. Qui est au rang dont le numéro est vingt-et-un (21)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ae9dc3a-f137-4bed-8591-b54a5128b4af",
                                "sense_id": "ea80227c-c58b-3cc7-b812-92c3c5f2dfa4",
                                "text": "C’est la vingt-et-unième fois que j’écoute ce morceau, je l’adore."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b2f31d3-dbfd-443f-a00f-d81963c32f2a",
                        "source_entry_id": "f08011ee-b101-30b8-be04-14ea79b61edd",
                        "source_sense_id": "ea80227c-c58b-3cc7-b812-92c3c5f2dfa4",
                        "target_lang_word": "einundzwanzigste",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einundzwanzigste",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b6b8f6f-cfaf-30be-ade7-be503fd286be",
                                        "entry_id": "00090557-fab0-3558-8d43-a2ce17e5fb3f",
                                        "glosses": [
                                            "nach dem oder der zwanzigsten kommend; in einer Reihenfolge an Stelle einundzwanzig"
                                        ],
                                        "tags": [
                                            "Ordnungszahl"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e86d4b98-bf1f-48d5-be62-211a54ee4fa5",
                                                "sense_id": "3b6b8f6f-cfaf-30be-ade7-be503fd286be",
                                                "text": "„Das einundzwanzigste Kapitel beschreibt den Abschied von Malta und danach sechs Jahre Mühsal.“"
                                            },
                                            {
                                                "example_id": "2da7f09f-e58e-4cab-b54f-30be67eeb335",
                                                "sense_id": "3b6b8f6f-cfaf-30be-ade7-be503fd286be",
                                                "text": "„Der derzeit amtierende, einundzwanzigste Prince of Wales ist Prinz Charles, der Sohn von Königin Elisabeth II.“"
                                            },
                                            {
                                                "example_id": "9032aa1d-a688-4bb5-83c5-a8fe2e20aa05",
                                                "sense_id": "3b6b8f6f-cfaf-30be-ade7-be503fd286be",
                                                "text": "„Bei der Annahme durch ein Ehepaar muß ein Ehegatte das fünfundzwanzigste Lebensjahr, der andere Ehegatte das einundzwanzigste Lebensjahr vollendet haben.“"
                                            },
                                            {
                                                "example_id": "311fc3f3-e355-4d9b-95ef-27c273920e45",
                                                "sense_id": "3b6b8f6f-cfaf-30be-ade7-be503fd286be",
                                                "text": "„Die beiden mittleren Messwerte dieser geordneten Reihe sind der zwanzigste (5.8) und der einundzwanzigste (6.2) Wert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
