                        "glosses": [
                            "Ort, an dem eine Lehre, eine Ausbildung stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56859d50-9ae8-470f-a4d4-32c12d1cb0cf",
                                "sense_id": "f86a7b2f-bd93-316d-92d4-07a2632490e4",
                                "text": "Der Lehrort, an dem die Lehre stattfindet, befindet sich in der Nähe."
                            },
                            {
                                "example_id": "49bb516a-9a01-41c2-9e43-aa0af0b683ed",
                                "sense_id": "f86a7b2f-bd93-316d-92d4-07a2632490e4",
                                "text": "„Die Werkstatt für Demokratie ist ein Lern- und Lehrort, in dem jeder/jede nachvollziehen und erfahren kann, was Demokratie bedeutet und wie diese praktisch gelebt und umgesetzt werden kann.“"
                            }
                        ],
