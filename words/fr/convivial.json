                        "cadre convivial",
                        "moment convivial"
                    ]
                },
                {
                    "sense_id": "b0c92a13-a8dc-35b0-b55d-9d7e92df1afe",
                    "sense_definition": "Facile, pratique et intuitif à utiliser, en particulier pour un système informatique ou un outil.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'application mobile propose une interface particulièrement <w>conviviale</w> pour les nouveaux utilisateurs."
                        },
                        {
                            "text": "Ce logiciel de gestion a été conçu pour être à la fois moderne et <w>convivial</w>."
