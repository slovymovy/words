                "senses": [
                    {
                        "sense_id": "8f7de098-687a-349a-9acc-2db8cf0c67d6",
                        "entry_id": "196ad443-6916-3e78-8284-2a06e1f51d53",
                        "glosses": [
                            "żona"
                        ],
                        "tags": [
                            "endearing"
                        ],
                        "examples": [
                            {
                                "example_id": "5be506ea-a6e9-4a3e-bf5a-1150b4944687",
                                "sense_id": "8f7de098-687a-349a-9acc-2db8cf0c67d6",
                                "text": "Obaczym żonkę grzeczną, hożą i bogatą / I ręką powinszujem waszmości kosmatą"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06b32f3a-ccec-40a9-b27f-77cd3150c77f",
                        "source_entry_id": "196ad443-6916-3e78-8284-2a06e1f51d53",
                        "source_sense_id": "8f7de098-687a-349a-9acc-2db8cf0c67d6",
                        "target_lang_word": "жёнушка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "жёнушка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "31868f11-d368-3e3b-a6e1-2c8bc6d79e1c",
                                        "entry_id": "73a15a1b-bab8-365a-a534-f82e619546d6",
                                        "glosses": [
                                            "уменьш.-ласк. к жена"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c27d05d-94e4-4c6b-be72-9cab556ced43",
                                                "sense_id": "31868f11-d368-3e3b-a6e1-2c8bc6d79e1c",
                                                "text": "Дорогая моя, любимая жёнушка, Душа моя, милая моя, как я по тебе уже соскучился и как мечтаю о том времени, когда наконец обниму тебя."
                                            },
                                            {
                                                "example_id": "b2b05ed3-2b21-4894-93d2-8e24dc046267",
                                                "sense_id": "31868f11-d368-3e3b-a6e1-2c8bc6d79e1c",
                                                "text": "Эй, вправду, пора бы тебе хорошую жёнушку взять, ты же, кажись, мотоват, а мотоват да не женат, себе же в наклад."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
