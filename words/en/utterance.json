    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "16ea735c-1c52-3868-9f09-b4d54c44c9fe",
                    "sense_definition": "Something that is spoken or written, such as a word, phrase, or sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The linguist recorded every <w>utterance</w> made by the child during the play session.",
