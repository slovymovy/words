                ],
                "senses": [
                    {
                        "sense_id": "ba30256d-8ab3-3a2d-a49e-98b8393307f1",
                        "entry_id": "992795ad-6feb-3cf3-b278-2dcbfbf6ae85",
                        "glosses": [
                            "Eigenschaft eines Materials, nicht elastig/eher brüchig zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68c35e56-e9df-408a-87fb-15d39fc5d61f",
                                "sense_id": "ba30256d-8ab3-3a2d-a49e-98b8393307f1",
                                "text": "„Erblickt ein Schürzenjäger ein Mädchen oder eine Frau, die sich einer gewissen Wohlgestalt erfreut, so stellt er ihr auf alle erdenkliche Art und Weise nach, um ihr die Sprödigkeit zu nehmen und sie sich geneigt zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "564154b7-d891-3220-8e81-31a607647f71",
                        "entry_id": "992795ad-6feb-3cf3-b278-2dcbfbf6ae85",
                        "glosses": [
                            "Eigenschaft einer Haltung, eher abweisend/wenig zugänglich zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "722e49e8-92cb-42f3-8e0b-efd16fe276e9",
                                "sense_id": "564154b7-d891-3220-8e81-31a607647f71",
                                "text": "„Gewiß, ich weiß, hinter dieser Sprödigkeit nach außen und hinter der Schnoddrigkeit, hinter diesem allzeit kampfbereiten Wesen steckt eine Weichheit, die unter keinen Umständen gezeigt werden soll.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "044fa9d1-4c5c-41f6-82e3-dd218f03e38b",
                        "source_entry_id": "992795ad-6feb-3cf3-b278-2dcbfbf6ae85",
                        "source_sense_id": "ba30256d-8ab3-3a2d-a49e-98b8393307f1",
                        "source_sense_description": "Eigenschaft eines Materials, nicht elastig/eher brüchig zu sein",
                        "target_lang_word": "brittleness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brittleness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1552243-18d6-32ce-a33a-e05622a7ad38",
                                        "entry_id": "02e30e1f-91b4-3a1c-a690-c56cd2c0da2f",
                                        "glosses": [
                                            "The state of being brittle (in various senses)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aac126a-f441-4257-8f9c-4a2581d441bf",
                                                "sense_id": "c1552243-18d6-32ce-a33a-e05622a7ad38",
                                                "text": "[David] Riesman did his best, in prefaces to two subsequent editions of the book (at great length in 1961, and, with some brittleness about having to do it once more, in 1969), to correct this reading—to insist that he never meant to suggest that Americans now were any more conformist than they ever had been, or that there's even such a thing as social structure without conformist consensus."
                                            },
                                            {
                                                "example_id": "9f72871b-2ed2-4450-9ccd-4c6392e9cb1d",
                                                "sense_id": "c1552243-18d6-32ce-a33a-e05622a7ad38",
                                                "text": "These vignettes often have the flavor of case studies, with interlocking themes related to the brittleness of the body and the complicated work of mourning."
                                            },
                                            {
                                                "example_id": "2413edf9-9c54-4e8e-9c2c-4ee685cb81a0",
                                                "sense_id": "c1552243-18d6-32ce-a33a-e05622a7ad38",
                                                "text": "In Scotland, the Tay [bridge] fell (in part) as textbook testament to the brittleness of cast iron."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90615c8f-a531-4ae8-b1d5-c139f68d47c1",
                        "source_entry_id": "992795ad-6feb-3cf3-b278-2dcbfbf6ae85",
                        "source_sense_id": "ba30256d-8ab3-3a2d-a49e-98b8393307f1",
                        "source_sense_description": "Eigenschaft eines Materials, nicht elastig/eher brüchig zu sein",
                        "target_lang_word": "fragilidade",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fragilidade",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "593b98a0-5d23-3151-8559-ce7ae945e7e1",
                                        "entry_id": "2bebb1ff-d954-3a39-9167-51ff6d3164ef",
                                        "glosses": [
                                            "qualidade daquele ou de aquilo que é frágil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cd8c060-753f-4d6d-82c1-b7d9a9090f0f",
                                                "sense_id": "593b98a0-5d23-3151-8559-ce7ae945e7e1",
                                                "text": "O sucesso da triangulação Garcia-Amorim-Guimarães na imposição desse viés sugere grande fragilidade institucional do Itamaraty quanto a qualquer ambição de ter influência efetiva na formulação da política externa."
                                            }
