                "senses": [
                    {
                        "sense_id": "a21e3a5f-da90-3dd7-8906-6423aaf0b2b6",
                        "entry_id": "9a00aeaf-41fe-37d1-9b3f-658c8c763b04",
                        "glosses": [
                            "Gebäude, in dem die/eine Abteilung der Gestapo ihren Sitz hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "670b0ee6-9530-40f6-ab57-3e793dbb1c21",
                                "sense_id": "a21e3a5f-da90-3dd7-8906-6423aaf0b2b6",
                                "text": "„Vor dem Gestapo-Gebäude in der Bředovská-Straße protestierte eine riesige Menschenmenge gegen den Gestapo-Terror.“"
                            },
                            {
                                "example_id": "5ab63ecf-7db7-46ab-9418-f075873912d9",
                                "sense_id": "a21e3a5f-da90-3dd7-8906-6423aaf0b2b6",
                                "text": "„Zwischen den Resten der ehemaligen Gestapo-Gebäude und des Prinz-Albrecht-Palais in Berlin befindet sich die neue Dauerausstellung »Topographie des Terrors«.“"
                            },
                            {
                                "example_id": "58e90485-2e5b-47e0-b9fc-7f9f2e5a4062",
                                "sense_id": "a21e3a5f-da90-3dd7-8906-6423aaf0b2b6",
                                "text": "„Das Gestapo-Gebäude wurde von Bewohnern als „Schreckenshaus“ (Skrekkens hus) bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
