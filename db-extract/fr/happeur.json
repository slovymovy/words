                        "glosses": [
                            "Sorte de biblorhapte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8ade4cb-0635-4386-8af8-02b63320fa32",
                                "sense_id": "4e8e8a30-278e-3cf1-b72b-a077bb2839a8",
                                "text": "« M. Hemmerling (W.), Rue de la Braie, 20, à Bruxelles» Outillage, machines-outils, classeurs, happeurs, sous-mains automatiques."
                            },
                            {
                                "example_id": "15b6ceff-aacd-4a91-966c-91456f63762c",
                                "sense_id": "4e8e8a30-278e-3cf1-b72b-a077bb2839a8",
                                "text": "Benjamin prit place dans la bulle, à côté du pilote, ajusta son casque de vol et régla le laryngophone, pendant que le second maître, un happeur gainé de plastique transparent à la main, finissait d'égrener sa check-list avant le départ."
                            }
                        ]
                    }
