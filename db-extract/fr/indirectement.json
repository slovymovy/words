        "fr-extract.jsonl": [
            {
                "entry_id": "5aac3d23-b70e-3697-ad82-245787cedc01",
                "word": "indirectement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9a881773-f168-3932-b8bb-021eb4daec37",
                        "entry_id": "5aac3d23-b70e-3697-ad82-245787cedc01",
                        "glosses": [
                            "D’une manière indirecte ou détournée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f577a176-1133-4fea-b224-7ee085498320",
                                "sense_id": "9a881773-f168-3932-b8bb-021eb4daec37",
                                "text": "S’il est vrai que Dieu ait créé le mal, soit directement, soit indirectement par un sous-Dieu, d’où vient qu’il en frappe le Juste, et qu’il comble de ses bienfaits l’Injuste ? !"
                            },
                            {
                                "example_id": "6cf0be41-85ac-409a-aaac-d4dfbaae09bc",
                                "sense_id": "9a881773-f168-3932-b8bb-021eb4daec37",
                                "text": "Le succès des hommes de Cro-Magnon a entraîné directement ou indirectement la disparition des Néanderthaliens."
                            },
                            {
                                "example_id": "1d720a12-b796-4f24-b2d9-5751ae7f45bc",
                                "sense_id": "9a881773-f168-3932-b8bb-021eb4daec37",
                                "text": "Il y a en notre âme une opération, et c’est celle de l’entendement, qui, précisément et en elle-même, n’est point attachée au corps, encore qu’elle en dépende indirectement, en tant qu’elle se sert des sensations et des images sensibles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28b73041-bff1-421d-ba45-9c242cc697b5",
                        "source_entry_id": "5aac3d23-b70e-3697-ad82-245787cedc01",
                        "source_sense_id": "9a881773-f168-3932-b8bb-021eb4daec37",
                        "target_lang_word": "in a roundabout way",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "66a48411-d204-4896-8caa-1204e88e95e4",
                        "source_entry_id": "5aac3d23-b70e-3697-ad82-245787cedc01",
                        "source_sense_id": "9a881773-f168-3932-b8bb-021eb4daec37",
                        "target_lang_word": "indirectly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indirectly",
