                "senses": [
                    {
                        "sense_id": "2f555fe8-7b78-3289-a221-a79ed41eee67",
                        "entry_id": "57d62ff2-b9a9-3471-9e69-1cef2e125199",
                        "glosses": [
                            "akustisch wahrnehmbarer, unspezifischer Vorgang; hörbares Ereignis durch die Lüftung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "092f0e19-a4c8-4446-b24c-1157fcf55973",
                                "sense_id": "2f555fe8-7b78-3289-a221-a79ed41eee67",
                                "text": "„Eventuell stört das entstehende Lüftungsgeräusch in der Einschlafphase.“"
                            },
                            {
                                "example_id": "6f84cad0-50cc-4908-8595-582f9720e2ff",
                                "sense_id": "2f555fe8-7b78-3289-a221-a79ed41eee67",
                                "text": "„Ein deutlich hörbares Lüftungsgeräusch wird von ihnen als Nutzer sicherlich nicht akzeptiert.“"
                            },
                            {
                                "example_id": "e3cdde15-7a85-4e17-8eb0-d8f4578ab29d",
                                "sense_id": "2f555fe8-7b78-3289-a221-a79ed41eee67",
                                "text": "„Der Angabe einiger Kunden zufolge, ist das Lüftungsgeräusch nicht störend.“"
                            },
                            {
                                "example_id": "99da836b-c1a5-44c5-874d-424a4f9a0062",
                                "sense_id": "2f555fe8-7b78-3289-a221-a79ed41eee67",
                                "text": "„Bei wichtigen Präsentationen sorgt der Eco-Modus für ein noch leiseres Lüftungsgeräusch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
