            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fdc92980-3821-3449-ab0a-a953ed3b45da",
                    "sense_definition": "Сердитый, испытывающий сильное чувство гнева или раздражения.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotion_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Папа пришёл с работы уставший и <w>злой</w>.",
                            "target_lang_translations": {
                                "en": "Dad came home from work tired and <w>angry</w>.",
                                "tr": "Babam işten yorgun ve <w>kızgın</w> geldi."
                            }
                        },
                        {
                            "text": "Почему ты такой <w>злой</w> сегодня утром?",
                            "target_lang_translations": {
                                "en": "Why are you so <w>angry</w> this morning?",
                                "tr": "Bu sabah neden bu kadar <w>öfkelisin</w>?"
                            }
                        }
                    ],
                    "synonyms": [
                        "сердитый",
                        "раздражённый"
                    ],
                    "antonyms": [
                        "добрый"
                    ],
                    "common_phrases": [
                        "злой на всех",
                        "злой как чёрт",
                        "быть злым"
                    ],
                    "target_lang_definitions": {
                        "en": "Angry, experiencing a strong feeling of anger or irritation.",
                        "tr": "Kızgın, güçlü bir öfke veya sinirlilik hissi yaşayan."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "angry",
                                "target_lang_sense_clarification": "most common and neutral term"
                            },
                            {
                                "target_lang_word": "mad",
                                "target_lang_sense_clarification": "informal, very common in spoken English"
                            },
                            {
                                "target_lang_word": "cross",
                                "target_lang_sense_clarification": "annoyed or mildly angry"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kızgın",
                                "target_lang_sense_clarification": "öfkeli, sinirli"
                            },
                            {
                                "target_lang_word": "öfkeli",
                                "target_lang_sense_clarification": "hiddetli, sinirlenmiş"
                            },
                            {
                                "target_lang_word": "sinirli",
                                "target_lang_sense_clarification": "gergin ve kızgın"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fafdd05-0363-3249-ae0f-a388d7067066",
                    "sense_definition": "Имеющий дурной характер, желающий зла другим; противоположный доброму.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "character_trait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этой сказке живёт <w>злая</w> колдунья.",
                            "target_lang_translations": {
                                "en": "An <w>evil</w> witch lives in this fairy tale.",
                                "tr": "Bu masalda <w>kötü kalpli</w> bir cadı yaşıyor."
                            }
                        },
                        {
                            "text": "Он <w>злой</w> человек, и у него совсем нет друзей.",
                            "target_lang_translations": {
                                "en": "He is a <w>mean</w> person, and he has no friends at all.",
                                "tr": "O <w>kötü</w> bir insan ve hiç arkadaşı yok."
                            }
                        }
                    ],
                    "synonyms": [
                        "недобрый",
                        "дурной",
                        "порочный",
                        "злобный",
                        "жестокий"
                    ],
                    "antonyms": [
                        "добрый"
                    ],
                    "common_phrases": [
                        "злой человек",
                        "злой дух",
                        "злой гений",
                        "самый злой"
                    ],
                    "target_lang_definitions": {
                        "en": "Having a bad character, wishing harm to others; the opposite of kind.",
                        "tr": "Kötü karakterli, başkalarına kötülük dileyen; iyinin karşıtı."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "evil",
                                "target_lang_sense_clarification": "morally bad, often used in fairy tales or for villains"
                            },
                            {
                                "target_lang_word": "wicked",
                                "target_lang_sense_clarification": "morally wrong or mischievous"
                            },
                            {
                                "target_lang_word": "mean",
                                "target_lang_sense_clarification": "unkind, unpleasant (very common for people)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kötü",
                                "target_lang_sense_clarification": "iyi karşıtı, fena"
                            },
                            {
                                "target_lang_word": "kötü kalpli",
                                "target_lang_sense_clarification": "merhametsiz, kötülük düşünen"
                            },
                            {
                                "target_lang_word": "zalim",
                                "target_lang_sense_clarification": "acımasız, haksızlık eden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "572d7554-6307-31b9-b275-92a2c93c7859",
                    "sense_definition": "Агрессивный, свирепый, готовый напасть или укусить (обычно о животных).",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Во дворе дома сидит большая <w>злая</w> собака.",
                            "target_lang_translations": {
                                "en": "A big <w>vicious</w> dog is sitting in the courtyard.",
                                "tr": "Evin bahçesinde büyük, <w>saldırgan</w> bir köpek oturuyor."
                            }
                        },
                        {
                            "text": "Осторожно, здесь очень <w>злой</w> сторожевой пёс.",
