                {
                    "sense_id": "65fa7272-a0e1-385c-87b9-a90385f9e165",
                    "sense_definition": "The result of good social upbringing or manners.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her polite behavior at the dinner table showed her excellent early <w>training</w>.",
                            "target_lang_translations": {
                                "ru": "Ее вежливое поведение за столом свидетельствовало о ее прекрасном раннем <w>воспитании</w>.",
                                "tr": "Yemek masasındaki kibar davranışları, erken yaşta aldığı mükemmel <w>terbiyeyi</w> gösteriyordu.",
                                "zh": "她在餐桌上彬彬有礼的表现显示出她从小受过良好的<w>教养</w>。"
                            }
                        },
                        {
                            "text": "The child's rudeness suggested a complete lack of <w>training</w> at home.",
                            "target_lang_translations": {
                                "ru": "Грубость ребенка говорила о полном отсутствии <w>воспитания</w> дома.",
                                "tr": "Çocuğun kabalığı, evde tam bir <w>terbiye</w> eksikliği olduğunu gösteriyordu.",
                                "zh": "这孩子粗鲁无礼，说明家里完全缺乏<w>家教</w>。"
                            }
                        }
