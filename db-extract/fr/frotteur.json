                        "entry_id": "c092cb05-dba5-3e19-a4bb-4c0516c1d426",
                        "glosses": [
                            "Qui frotte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1146c16e-4d6a-42c2-adc5-8dc7ac81bb8b",
                                "sense_id": "bdcbf6a9-2195-3e46-9f55-8a3822cd79aa",
                                "text": "[…] ; l'autre par une triple dérivation aboutissant à une large plaque métallique terminée par un balai frotteur, dans le genre de ceux des collecteurs de dynamos."
                            },
                            {
                                "example_id": "7fc0c22a-037d-42f2-a314-ccf7cf464435",
                                "sense_id": "bdcbf6a9-2195-3e46-9f55-8a3822cd79aa",
                                "text": "Elles venaient près de moi (…) bien gentilles, bien frotteuses à s’appuyer sur moi, à me faire sentir le bâillé des corsages, à rire."
                            }
                        ]
                    }
                ],
