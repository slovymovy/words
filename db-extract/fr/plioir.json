            {
                "entry_id": "d1f3106e-3b1f-32e9-abd9-f8ad0e465e66",
                "word": "plioir",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0086ac3a-cc6f-430d-9210-272383cec8f2",
                        "entry_id": "d1f3106e-3b1f-32e9-abd9-f8ad0e465e66",
                        "tags": [
                            "plural"
                        ],
                        "form": "plioirs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bec63f1d-a982-3481-ae6c-038150c2b08a",
                        "entry_id": "d1f3106e-3b1f-32e9-abd9-f8ad0e465e66",
                        "glosses": [
                            "Petit instrument de bois, d’ivoire ou d’autre matière, plat, tranchant des deux côtés, et dont on se sert pour plier et pour couper du papier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf06277a-627e-4e18-8d1b-3bbb6ea1c0c0",
                                "sense_id": "bec63f1d-a982-3481-ae6c-038150c2b08a",
                                "text": "Le plioir est un outil permettant de marquer le papier ou le carton fin afin de faciliter son pliage. Utile en reliure, cartonnage, ou encore en origami. Les plioirs en os disposent d’une très bonne finition, et sont à l’épreuve du temps."
                            },
                            {
                                "example_id": "9c2a6bf1-bca0-4570-87b1-9c280eb9fd91",
                                "sense_id": "bec63f1d-a982-3481-ae6c-038150c2b08a",
                                "text": "Ce Plioir en plastique vous permettra de plier droit tous cartons et papiers créatifs, sans faute ! Autrement dit, il permet de former une rainure sur le papier et le carton pour plier proprement avec plus de facilité ou de lisser un collage."
                            }
                        ]
                    },
                    {
                        "sense_id": "df78c79d-24b6-36f6-9ce1-f760dba02f6e",
                        "entry_id": "d1f3106e-3b1f-32e9-abd9-f8ad0e465e66",
                        "glosses": [
                            "Lame de bois mince qui sert à plier les étoffes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6bdf71af-7cc1-3cc3-991b-14390ebe9943",
                        "entry_id": "d1f3106e-3b1f-32e9-abd9-f8ad0e465e66",
                        "glosses": [
                            "Planchette de bois autour de laquelle les dentellières enroulaient leur dentelle au fur et à mesure de sa création, pour que celle-ci ne se froisse pas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a8d8623-fe29-4b1b-a995-fa7601297ca4",
                                "sense_id": "6bdf71af-7cc1-3cc3-991b-14390ebe9943",
                                "text": "Les plioirs à dentelles se trouvent principalement en Auvergne et en Haute Loire."
                            }
                        ]
                    },
                    {
                        "sense_id": "3fecdcb8-8d96-336b-ae7a-dc5966d61139",
                        "entry_id": "d1f3106e-3b1f-32e9-abd9-f8ad0e465e66",
                        "glosses": [
                            "Plaquette ou planchette sur laquelle on enroule une ligne de pêche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40ba9134-885e-497e-9ced-eb5aa54c398a",
                                "sense_id": "3fecdcb8-8d96-336b-ae7a-dc5966d61139",
                                "text": "Lorsque vous pêchez au coup, vous rangez vos lignes sur des plioirs en plastiques, que l'on trouve dans le commerce."
                            }
                        ]
                    }
                ],
