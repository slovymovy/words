                        "cross_references": [
                            {
                                "target_word": "abarticulaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7105f363-46a4-31ec-86f2-37784c966295",
                                        "entry_id": "19dd080e-dbd1-31d0-a055-00675899f817",
                                        "glosses": [
                                            "Relatif aux tissus qui entourent une articulation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f667a20c-1d18-4056-8374-2ac0b62d5f87",
                                                "sense_id": "7105f363-46a4-31ec-86f2-37784c966295",
                                                "text": "Nous réunissons sous la dénomination de rhumatisme abarticulaire les diverses affections du rhumatisme, accidentel ou constitutionnel, qui n'ont pas pour siége essentiel, primaire ou primitif, le système articulaire, mais bien les divers éléments, tissus ou organes de l'économie, soit au dehors, rhumatisme abarticulaire externe, soit au dedans, rhumatisme abarticulaire interne."
                                            },
                                            {
                                                "example_id": "5142647b-76b9-493a-890f-6e2bd47b4342",
                                                "sense_id": "7105f363-46a4-31ec-86f2-37784c966295",
                                                "text": "La goutte abarticulaire est celle qui s'installe ailleurs que sur les articulations. La goutte abarticulaire peut être aiguë, paroxystique, ou bien larvée. La goutte abarticulaire paroxystique est celle qui fait le mieux ses preuves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21aecb68-7604-3e17-a373-f98dc8b35013",
                                        "entry_id": "19dd080e-dbd1-31d0-a055-00675899f817",
                                        "glosses": [
                                            "Qui est en dehors de l'articulation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
