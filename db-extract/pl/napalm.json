                "translations": [
                    {
                        "translation_id": "270ab702-64d1-4af0-9eb9-9c1f19d2b7f7",
                        "source_entry_id": "fec3e3cd-59e2-3168-beb2-188936944550",
                        "source_sense_id": "e2ce6461-9560-3229-a9ed-d86e366fb763",
