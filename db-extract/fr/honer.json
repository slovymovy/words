                "senses": [
                    {
                        "sense_id": "d6d87633-44eb-3583-ae9b-a40d91e186f4",
                        "entry_id": "21f95d20-b694-361b-a485-fb1aed267d2c",
                        "glosses": [
                            "Pratiquer un usinage des parois du cylindre d’un moteur pour favoriser l'étanchéité avec le piston et améliorer l’adhérence de l’huile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f6ead3e-9210-4695-8421-c7892ece59ad",
                                "sense_id": "d6d87633-44eb-3583-ae9b-a40d91e186f4",
                                "text": "Et bien pour l'instant j'ai fini le démontage moteur, j'ai mesuré les alésages hier, je vais faire honer et je pourrai remonter le moteur"
                            },
                            {
                                "example_id": "cb836b26-a21c-4eec-a337-4c395507c025",
                                "sense_id": "d6d87633-44eb-3583-ae9b-a40d91e186f4",
                                "text": "Abrasifs, limes et outils d'ébavurage, outils à roder et à honer."
                            },
                            {
                                "example_id": "c62ba33f-f2d9-4bbf-aa07-3876c6846e45",
                                "sense_id": "d6d87633-44eb-3583-ae9b-a40d91e186f4",
                                "text": "Une foreuse à colonne ou une perceuse à vitesse variable est le moteur idéal pour utiliser une brosse à honer."
                            }
                        ]
                    }
