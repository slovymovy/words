                                            {
                                                "example_id": "ef0c801e-d7d0-4cf4-b49c-ea6a8a7ffb91",
                                                "sense_id": "a7fb1db8-794b-3ffa-bbf8-cb1fe4e25b0f",
                                                "text": "„Dubai ist eine ultramoderne Stadt mit 2,6 Millionen Einwohnern.“"
                                            }
                                        ],
