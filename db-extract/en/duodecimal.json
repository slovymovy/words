                                        "sense_id": "373869a5-2972-3e93-b7f2-ef662b7434ac",
                                        "entry_id": "361cb2bf-6b78-30be-ab38-7423fac28225",
                                        "glosses": [
                                            "十二を底として、十二の累乗で桁を進める記数法。十二種類の数字として、0から9までの十個のアラビア数字と、AとBの二つのラテン文字を通常用いる。十をA、十一をB、十二を10、十二分の一を0.1と表す。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16bf53a9-e5eb-4d15-b423-9258a215d084",
                                                "sense_id": "373869a5-2972-3e93-b7f2-ef662b7434ac",
                                                "text": "十進法で720と書かれる数は十二進法では500と書かれる。"
                                            },
                                            {
                                                "example_id": "0d8985c2-9ed7-4f7e-ab71-77ecb81e5f48",
                                                "sense_id": "373869a5-2972-3e93-b7f2-ef662b7434ac",
                                                "text": "十二進法の小数を用いると、一ヶ月を0.1年、十ヶ月を0.A年と表せる。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
