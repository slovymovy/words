                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud noise <w>startled</w> the birds in the trees.",
                            "target_lang_translations": {
