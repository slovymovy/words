    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "053adbab-ea51-357a-a86b-247941a19c64",
                    "sense_definition": "Rendre plus frais, abaisser la température ou procurer une sensation de fraîcheur.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fraicheur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En plein été, nous ouvrons les fenêtres pour <w>rafraîchir</w> les pièces de la maison."
                        },
                        {
                            "text": "Cette limonade glacée nous <w>rafraîchit</w> agréablement après une longue marche au soleil."
                        }
                    ],
                    "synonyms": [
                        "refroidir",
                        "désaltérer"
                    ],
                    "common_phrases": [
                        "rafraîchir l'atmosphère"
                    ]
                },
                {
                    "sense_id": "149f10dc-bcf3-32bd-ae8f-86076cddc29e",
                    "sense_definition": "Recharger ou actualiser l'affichage d'un écran ou d'une page sur un support numérique.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si le contenu ne s'affiche pas correctement, vous devez <w>rafraîchir</w> la page."
                        },
                        {
                            "text": "Il <w>rafraîchit</w> son navigateur pour vérifier les nouveaux messages reçus."
                        }
                    ],
                    "synonyms": [
                        "actualiser",
                        "recharger"
                    ],
                    "common_phrases": [
                        "rafraîchir la page",
                        "rafraîchir l'écran"
                    ]
                },
                {
                    "sense_id": "e1a4aff9-9c68-33c0-af46-b3605b60d71e",
                    "sense_definition": "Devenir plus frais, en parlant du temps qu'il fait ou d'une température.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fraicheur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès que le soleil disparaît derrière la montagne, l'air commence à <w>rafraîchir</w>."
                        },
                        {
                            "text": "Le temps se <w>rafraîchit</w> nettement avec l'arrivée de l'automne."
                        }
                    ],
                    "synonyms": [
                        "refroidir"
                    ],
                    "common_phrases": [
                        "le temps se rafraîchit"
                    ]
                },
                {
                    "sense_id": "f9d00076-5c8a-31fb-b9c1-7aca508b4749",
                    "sense_definition": "Remettre en bon état, rénover légèrement un lieu ou un objet usé par le temps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "renovation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont décidé de <w>rafraîchir</w> la peinture du salon avant de vendre l'appartement."
                        },
                        {
                            "text": "Cet artisan sait comment <w>rafraîchir</w> un tableau ancien sans abîmer les couleurs d'origine."
                        }
                    ],
                    "synonyms": [
                        "rénover",
                        "restaurer"
                    ],
                    "antonyms": [
                        "défraichir"
                    ],
                    "common_phrases": [
                        "rafraîchir la peinture",
                        "rafraîchir une pièce"
                    ]
                },
                {
                    "sense_id": "f0c38b09-2988-33bd-b171-f72d88b66135",
                    "sense_definition": "Couper ou égaliser légèrement la pointe ou l'extrémité de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "coupe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle est allée chez le coiffeur pour seulement faire <w>rafraîchir</w> ses pointes abîmées."
                        },
                        {
                            "text": "Le jardinier <w>rafraîchit</w> les bordures du massif avant la venue des invités."
                        }
                    ],
                    "synonyms": [
                        "égaliser",
                        "épointer"
                    ],
                    "common_phrases": [
                        "rafraîchir les pointes",
                        "rafraîchir les cheveux"
                    ]
                }
            ]
        }
    ]
}