                    {
                        "sense_id": "86658062-8b63-3fc2-9b10-72884725cd96",
                        "entry_id": "a6f96766-5e17-3aa4-9f1b-80e94b3a2b55",
                        "glosses": [
                            "A process in the manufacture of felt in which the animal pelt is treated with a solution of mercury salts, such as mercuric nitrate."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5227d56d-ab19-45a8-a9d7-0b7cd7cdafef",
                                "sense_id": "86658062-8b63-3fc2-9b10-72884725cd96",
                                "text": "The present commonly used method for application of the carroting solution to the furs is, as indicated above, the brushing of the fur with the solution while the fur is on the pelt, with subsequent drying usually performed at an elevated temperature."
                            },
                            {
                                "example_id": "7f4a2fed-b4cf-4b6a-93e5-8748a852c098",
                                "sense_id": "86658062-8b63-3fc2-9b10-72884725cd96",
                                "text": "In a now-classic 2002 article, they warn museum professionals that the remnants of mercury from the carroting process still remain a threat."
                            }
                        ]
                    }
                ],
