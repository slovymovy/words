                        ],
                        "form": "инса́йдами"
                    },
                    {
                        "form_id": "013f7322-c3f2-4b6c-bde7-e493beebcfbf",
                        "entry_id": "f0a87b0a-373c-337f-a375-14d0fb99cb25",
                        "tags": [
                            "singular",
