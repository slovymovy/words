                "senses": [
                    {
                        "sense_id": "26e79ada-930b-38f9-b6df-1a1fe57fbca2",
                        "entry_id": "3894ec20-e56e-32d1-a6c5-b9e342cdd82a",
                        "glosses": [
                            "Bruder eines Ehepartners von einem eigenen Geschwister"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d74aeea4-5f24-49f9-8c16-c18975e1ff6e",
                                "sense_id": "26e79ada-930b-38f9-b6df-1a1fe57fbca2",
                                "text": "Das ist mein Schwippschwager, also der Bruder vom Mann Michael meiner Schwester Beate."
                            },
                            {
                                "example_id": "ff437576-04ff-431d-891f-475422104d71",
                                "sense_id": "26e79ada-930b-38f9-b6df-1a1fe57fbca2",
                                "text": "„Und wenn der Cousin gleichzeitig Onkel, Bruder und Schwippschwager ist, muss man sich auch noch viel weniger Geburtstage merken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "05f5cf09-0f02-3124-9025-50c4049180e2",
                        "entry_id": "3894ec20-e56e-32d1-a6c5-b9e342cdd82a",
                        "glosses": [
                            "Ehemann eines Geschwisters des eigenen Ehepartners"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "86b9178d-262d-4908-af19-e4d21f50e94f",
                                "sense_id": "05f5cf09-0f02-3124-9025-50c4049180e2",
                                "text": "„Und wenn der Cousin gleichzeitig Onkel, Bruder und Schwippschwager ist, muss man sich auch noch viel weniger Geburtstage merken.“"
                            },
                            {
                                "example_id": "714a8277-2481-44af-88a8-b8c8dc777b91",
                                "sense_id": "05f5cf09-0f02-3124-9025-50c4049180e2",
                                "text": "Das ist mein Schwippschwager, also er ist mit der Schwester von Thomas, meinem Mann, verheiratet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
