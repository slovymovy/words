                    {
                        "translation_id": "9ad2df90-14d2-40ba-8051-3b6e46ec9f34",
                        "source_entry_id": "65d01435-ff28-31df-8016-467730aa0629",
                        "source_sense_id": "32817dbb-95bd-3ab9-a179-07bd98816a05",
