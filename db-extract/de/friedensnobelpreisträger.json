                    {
                        "sense_id": "214cbd47-d6cf-3b78-86e0-a48812f58d5c",
                        "entry_id": "bb69334f-5dfd-3cb7-a0c2-9752f35feae5",
                        "glosses": [
                            "Person, die für ihre Verdienste um den Weltfrieden mit dem Friedensnobelpreis ausgezeichnet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0770fe59-7bcb-4dff-a68b-9bea8d9528bd",
                                "sense_id": "214cbd47-d6cf-3b78-86e0-a48812f58d5c",
                                "text": "Der ehemalige Bundeskanzler Willy Brandt ist der bisher letzte deutsche Friedensnobelpreisträger."
                            },
                            {
                                "example_id": "0ff16cc9-2596-44db-933f-046e35008ca7",
                                "sense_id": "214cbd47-d6cf-3b78-86e0-a48812f58d5c",
                                "text": "„Der zweite Abwesende war Bruno Kaletzki, der Friedensnobelpreisträger des Vorjahrs.“"
                            },
                            {
                                "example_id": "82f051c2-9a33-4f32-b3c5-b85d912702f3",
                                "sense_id": "214cbd47-d6cf-3b78-86e0-a48812f58d5c",
                                "text": "„Kein amerikanischer Präsident vorher und nachher hat so viel im Ausland interveniert wie Wilson, der Friedensnobelpreisträger von 1919.“"
                            }
                        ],
