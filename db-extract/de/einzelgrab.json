                "senses": [
                    {
                        "sense_id": "dc033c68-b1c9-3cdf-af21-5a83b5aae973",
                        "entry_id": "d226d4d4-8536-3e63-8c9e-553e321af99d",
                        "glosses": [
                            "Grab, in dem nur eine einzige Person bestattet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2622bf4-2dfa-467e-9d3a-cbc308a225ee",
                                "sense_id": "dc033c68-b1c9-3cdf-af21-5a83b5aae973",
                                "text": "„Seit der späten Hallstattzeit tauchen neben Einzelgräbern immer wieder Gräber auf, in denen zwei oder mehrere Personen beigesetzt wurden.“"
                            },
                            {
                                "example_id": "8bcdec65-d4db-4464-9dd0-adf2999cc708",
                                "sense_id": "dc033c68-b1c9-3cdf-af21-5a83b5aae973",
                                "text": "„Mit Beginn der Bronzezeit erfolgt der Wechsel zu Einzelgräbern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ca1bd9db-28a6-35b4-a0f0-d1b0bb64e729",
                        "entry_id": "d226d4d4-8536-3e63-8c9e-553e321af99d",
                        "glosses": [
                            "Grab, das alleine für sich liegt und nicht im Verbund mit anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b3b1763-e6af-45c2-b145-6111e5e3310d",
                                "sense_id": "ca1bd9db-28a6-35b4-a0f0-d1b0bb64e729",
                                "text": "„Nun folgt ein Einzelgrab, darauf wieder 24 Schritte weit einige Gräber nebeneinander.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
