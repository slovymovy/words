                        "source_sense_id": "a3eef975-d046-31bf-ab01-e02f8b950a6c",
                        "target_lang_word": "hilfreich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hilfreich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7818ff5-d075-38a5-8f31-0b069cde85db",
                                        "entry_id": "a1579535-daec-301b-a38c-c0eb1b3aab88",
                                        "glosses": [
                                            "helfend, unterstützend; Hilfe bietend"
                                        ],
                                        "tags": [
                                            "von Personen",
                                            "von Sachen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72c34bd5-0cc7-47da-bb9a-7e6f7380aebc",
                                                "sense_id": "b7818ff5-d075-38a5-8f31-0b069cde85db",
                                                "text": "Die Beschreibung der Aussprache jedes Wortes ist sehr hilfreich für Ausländer."
                                            },
                                            {
                                                "example_id": "358f1105-9eea-4219-89df-56aa637f903e",
                                                "sense_id": "b7818ff5-d075-38a5-8f31-0b069cde85db",
                                                "text": "„Besonders hilfreich wäre es für den Ministerpräsidenten, hinterher in den Medien als Sieger dargestellt zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7310d7a-9fa8-4367-80f4-d9eeca48cd24",
                        "source_entry_id": "88073d4b-fb70-3713-8480-79da2f5795da",
                        "source_sense_id": "a3eef975-d046-31bf-ab01-e02f8b950a6c",
                        "target_lang_word": "hilfsbereit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hilfsbereit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b399519-7c25-33b0-83b9-b139cfe78d7c",
                                        "entry_id": "196213df-ee04-3206-a288-a6e662aa9f71",
                                        "glosses": [
                                            "bereit, jemandem zu helfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a87a6cae-edb1-4f75-94ad-d44b52ff98da",
                                                "sense_id": "6b399519-7c25-33b0-83b9-b139cfe78d7c",
                                                "text": "Als ein Fahrgast den richtigen Bahnsteig suchte, war die Bahnangestellte sehr hilfsbereit."
                                            },
                                            {
                                                "example_id": "6290cf0e-d04d-40b8-97a6-72d08eca880a",
                                                "sense_id": "6b399519-7c25-33b0-83b9-b139cfe78d7c",
                                                "text": "Maik kann sich glücklich schätzen, dass er so hilfsbereite Kollegen hat."
                                            },
                                            {
                                                "example_id": "6c9db2d3-1140-4a3a-9cdb-4bbdd73b3eeb",
                                                "sense_id": "6b399519-7c25-33b0-83b9-b139cfe78d7c",
                                                "text": "„Trifft das noch zu im Zeitalter der Weltraumfahrt? Dieses Wort ist eine maßlose Übertreibung, ebenso wie sein Synonym Astronautik. Es gibt eine Reihe von Vergleichen, die das anschaulich machen. Einer mag genügen: Wenn jemand am Alpenrand, etwa bei Grainau unweit Garmisch, in 900 m Höhe über dem Meeresspiegel steht und zum Gipfel der Zugspitze (2000 m über ihm) hinaufblickt, und wenn er seinen Hals reckt, um dort oben etwas zu erkennen, und wenn ihm dann ein hilfsbereiter Freund ein Blatt von 0,2 mm Stärke unter die Schuhe schiebt, »damit du etwas näher dran bist und besser sehen kannst«, so hat sich dieser Jemand damit dem Zugspitzgipfel nur um ein Zehnmillionstel der gegebenen Distanz genähert (1 km = 1 Million mm). Ein »Astronaut«, der den Mond betritt, hat mit der Reise von der Erde bis dorthin von der Entfernung, die uns vom sonnennächsten Fixstern trennt, noch weniger, nämlich 1 Hundertmillionstel, zurückgelegt. Andere Fixsterne sind millionen- und milliardenmal weiter entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5edfd0c8-a07d-4b08-9199-a691eb07f821",
                        "source_entry_id": "88073d4b-fb70-3713-8480-79da2f5795da",
                        "source_sense_id": "a3eef975-d046-31bf-ab01-e02f8b950a6c",
                        "target_lang_word": "freundlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "freundlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7251d5b0-e63d-370c-8e99-a80a1276a99b",
                                        "entry_id": "917428f3-f0fb-3206-8883-86c50a4e4b48",
                                        "glosses": [
                                            "in der Begegnung mit anderen Menschen, Dingen, Ereignissen positiv eingestellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7127f632-47b7-44b4-b91d-8f5f46046f05",
                                                "sense_id": "7251d5b0-e63d-370c-8e99-a80a1276a99b",
                                                "text": "Der Verkäufer ist freundlich."
                                            },
                                            {
                                                "example_id": "53e971df-62f4-498f-aa63-e8553b2d9194",
                                                "sense_id": "7251d5b0-e63d-370c-8e99-a80a1276a99b",
                                                "text": "„Er ist ein sehr freundlicher und äußerst hilfsbereiter Mitbürger.“"
                                            },
                                            {
                                                "example_id": "498b9730-a1d1-4224-83db-5cef52b70464",
                                                "sense_id": "7251d5b0-e63d-370c-8e99-a80a1276a99b",
                                                "text": "„Kinder im Kindergarten, und nicht nur diese, brauchen und wünschen sich einen freundlichen und zugewandten Umgang.“"
                                            },
                                            {
                                                "example_id": "3ca951a0-35da-45bb-b067-d5a54f21ac39",
                                                "sense_id": "7251d5b0-e63d-370c-8e99-a80a1276a99b",
                                                "text": "„Die Empfangsdame war jüngeren Alters, machte einen freundlichen und intelligenten Eindruck auf mich. Ihre lebhaften Augen blickten mich durch eine feine Brille hindurch interessiert an.“"
                                            },
                                            {
                                                "example_id": "f87c2f36-17c2-4984-b89d-e60799b4d034",
                                                "sense_id": "7251d5b0-e63d-370c-8e99-a80a1276a99b",
                                                "text": "„Damals fast eine kleine Provokation dagegen das dritte Standbild: Lässig und freundlich schaut der alte Moltke zu uns herunter -- mit übergeschlagenen Beinen, ohne Heldenpose, ohne den Mantel der Geschichte.“"
                                            },
                                            {
                                                "example_id": "982de5e5-b368-4ed4-a796-2a8770abf624",
                                                "sense_id": "7251d5b0-e63d-370c-8e99-a80a1276a99b",
                                                "text": "„Unvorstellbar dass an einem so freundlichen Tag an einem so freundlichen Ort ein Unheil geschehen konnte. Doch es geschah - und nichts würde danach mehr so sein wie zuvor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bd7cfa88-44e1-3e7a-b71c-d9bea6ff7383",
                                        "entry_id": "917428f3-f0fb-3206-8883-86c50a4e4b48",
                                        "glosses": [
                                            "sonnig, angenehm warm"
                                        ],
                                        "tags": [
                                            "Wetter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "189ad66b-b74f-48d6-8b4f-2201b52b9335",
                                                "sense_id": "bd7cfa88-44e1-3e7a-b71c-d9bea6ff7383",
                                                "text": "„Unvorstellbar dass an einem so freundlichen Tag an einem so freundlichen Ort ein Unheil geschehen konnte. Doch es geschah - und nichts würde danach mehr so sein wie zuvor.“"
                                            },
                                            {
                                                "example_id": "c3174f2c-8307-4bf8-b7cd-2f558859130b",
                                                "sense_id": "bd7cfa88-44e1-3e7a-b71c-d9bea6ff7383",
                                                "text": "Der morgige Tag soll freundlich werden."
                                            },
                                            {
                                                "example_id": "fa6275cf-4487-453c-abef-9261addc6281",
                                                "sense_id": "bd7cfa88-44e1-3e7a-b71c-d9bea6ff7383",
                                                "text": "„Als er am Fuße Südamerikas vor Anker gegangen war und das Wetter freundlich blieb, entschloss sich FitzRoy zu einer mutigen Expedition mit dem Walboot zur Insel Hoorn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
