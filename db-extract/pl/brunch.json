                "senses": [
                    {
                        "sense_id": "c8207864-e888-3420-bb3b-ef6d77edad8b",
                        "entry_id": "89d779ea-d241-3442-8d43-a0307df5e09d",
                        "glosses": [
                            "posiłek będący połączeniem śniadania i obiadu, jadany późnym rankiem lub wczesnym przedpołudniem, pierwotnie w niedzielę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "650d6c2d-1df7-49f4-9bc7-b9a06b250d4a",
                                "sense_id": "c8207864-e888-3420-bb3b-ef6d77edad8b",
                                "text": "Goszcząc u Jadzi w Stanach, czasem zamawialiśmy typowy brunch w pobliskiej restauracji nad zatoką."
                            },
                            {
                                "example_id": "a8314db8-709a-4573-a990-c4582b6ffc2b",
                                "sense_id": "c8207864-e888-3420-bb3b-ef6d77edad8b",
                                "text": "Czym różni się drugie śniadanie od brunchu?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76eee10f-7175-4492-be13-764119c9fe32",
                        "source_entry_id": "89d779ea-d241-3442-8d43-a0307df5e09d",
                        "source_sense_id": "c8207864-e888-3420-bb3b-ef6d77edad8b",
                        "target_lang_word": "brunch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brunch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb42df4c-4afa-3306-b07b-70d8b75484df",
                                        "entry_id": "ff1294da-03ff-39fd-811f-bb6de71cfe15",
                                        "glosses": [
                                            "A meal eaten later in the day than breakfast and earlier than lunch, and often consisting of typical foods from both of those meals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d2e612d-480e-4ea1-b5f9-15999bb0862a",
                                                "sense_id": "fb42df4c-4afa-3306-b07b-70d8b75484df",
                                                "text": "I normally have brunch at the café next to work."
                                            },
                                            {
                                                "example_id": "c39d9d59-1107-4efa-8ebb-4fd321ae1f09",
                                                "sense_id": "fb42df4c-4afa-3306-b07b-70d8b75484df",
                                                "text": "Let's do brunch sometime at the salad bar!"
                                            },
                                            {
                                                "example_id": "9647e91b-e619-4854-88f2-acc4d2690591",
                                                "sense_id": "fb42df4c-4afa-3306-b07b-70d8b75484df",
                                                "text": "Feeling a bit peckish, Sandra made herself some brunch with the leftovers in her fridge."
                                            },
                                            {
                                                "example_id": "1cf49ca2-6d69-4e57-a562-f1ef8505e3c7",
                                                "sense_id": "fb42df4c-4afa-3306-b07b-70d8b75484df",
                                                "text": "I discovered a meal between breakfast and brunch."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brunch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e40de2fc-27f9-3eb0-bb39-9eb2f7110ea6",
                                        "entry_id": "81fe700a-5b49-3bab-8790-518bb34fc982",
                                        "glosses": [
                                            "To eat brunch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a67bdaaa-5e68-4dc1-80dd-a36764375e72",
                        "source_entry_id": "89d779ea-d241-3442-8d43-a0307df5e09d",
                        "source_sense_id": "c8207864-e888-3420-bb3b-ef6d77edad8b",
                        "target_lang_word": "brunch",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brunch",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4fda193d-6258-358c-9c4d-b706c974e1e6",
                                        "entry_id": "7d65791f-5f05-30a8-b567-e4f3ef66af00",
                                        "glosses": [
                                            "Repas tardif du matin, associant les aliments du petit déjeuner (pain, gâteaux…) à des aliments pris habituellement au déjeuner (viandes, salades…)."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f9bb009-e2f5-49f7-a5e5-a960061ba36d",
                                                "sense_id": "4fda193d-6258-358c-9c4d-b706c974e1e6",
                                                "text": "Cela commençait par des brunches en plein air, sur les pelouses des fraternités, avec des tentes de toiles striées de vert et blanc, dressées au sommet des pentes qui, à l’arrière des grandes demeures, dominaient les vallons voisins."
                                            },
                                            {
                                                "example_id": "822b1fdd-3018-41cb-b149-a4c387204a84",
                                                "sense_id": "4fda193d-6258-358c-9c4d-b706c974e1e6",
                                                "text": "Chloé rappela à son petit frère qu’un brunch, c’était un « super grand » petit-déjeuner, où on mangeait beaucoup parce qu’on ne remangeait plus à midi."
                                            },
                                            {
                                                "example_id": "53cec6ed-f98f-4d89-9ead-1668606d3790",
                                                "sense_id": "4fda193d-6258-358c-9c4d-b706c974e1e6",
                                                "text": "Le samedi suivant, Hortense et Hubert recevaient pour le brunch. « Un petit brunch à l'ancienne », avait écrit Hubert dans son SMS, une dizaine de personnes. Le rituel du brunch, habituellement donné le dimanche, était en réalité une institution fort récente. Personne ne faisait de brunch dans leur enfance."
                                            },
                                            {
                                                "example_id": "6bbf25d4-c3e3-43c9-a6eb-a4c9a1d5568f",
                                                "sense_id": "4fda193d-6258-358c-9c4d-b706c974e1e6",
                                                "text": "[…], tous ces branchés collet monté qui ne pensaient qu'à se regarder dans le miroir, miroir mon beau miroir, faire leur footing, footing mon beau footing, et se rendre le dimanche à des brunchs, brunchs nos beaux brunchs, où ils parlaient de leur nouveau tatouage bio, […]."
                                            },
                                            {
                                                "example_id": "8f35a9bc-2e22-4928-94c3-1b9253e15ef1",
                                                "sense_id": "4fda193d-6258-358c-9c4d-b706c974e1e6",
                                                "text": "Bien sûr, tout commence plus tard, le muscat du dimanche ne fait plus chanter, les brunchs essaient d’effacer les heures dangereuses du début d’après-midi, quand on se disputait pour la politique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
