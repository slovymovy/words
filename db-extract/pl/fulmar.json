                ],
                "translations": [
                    {
                        "translation_id": "83109124-dd7e-4aaa-b5dc-2e5574399b81",
                        "source_entry_id": "4d466ffd-79eb-3a40-96e6-0172b2b85b02",
                        "source_sense_id": "cd05f6f3-83d8-3560-8796-70db5201db76",
                        "target_lang_word": "fulmar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fulmar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8cbbcaf6-dc77-3fa2-a361-dfcc372fa7bb",
                                        "entry_id": "3a570145-4d7c-388d-a9d2-b487285a11c3",
                                        "glosses": [
                                            "Either of two species of pelagic seabird in the genus Fulmarus, Fulmarus glacialis and F. glacialoides, which breed on cliffs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17c598ce-bd77-49d4-b8f1-fea31422efd4",
                                                "sense_id": "8cbbcaf6-dc77-3fa2-a361-dfcc372fa7bb",
                                                "text": "In the southern districts, the Inuit hunted fulmars with bird darts from kayaks (Helms 1926). The Nipisat people may have hunted fulmar and great shearwater, probably using similar methods."
                                            },
                                            {
                                                "example_id": "364cbf81-ec93-48db-bdf0-19d3c4800735",
                                                "sense_id": "8cbbcaf6-dc77-3fa2-a361-dfcc372fa7bb",
                                                "text": "In particular, fulmars have the distinctive trait of vomiting half-digested fish oil when approached on the nest and should be given a wide berth wherever possible."
                                            },
                                            {
                                                "example_id": "7a3e386c-04a6-49ce-bfb4-7440fa4389fa",
                                                "sense_id": "8cbbcaf6-dc77-3fa2-a361-dfcc372fa7bb",
                                                "text": "And why oh why is it always bloody fulmars following us about? Have they got nothing better to do, these silly lickspittle fulmars, than to ape every petty twist and turn of our hollow peregrinations? I'm sick of fulmars."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "522e31b5-010e-4563-836f-b150b1859b9c",
                        "source_entry_id": "4d466ffd-79eb-3a40-96e6-0172b2b85b02",
                        "source_sense_id": "cd05f6f3-83d8-3560-8796-70db5201db76",
