                ],
                "senses": [
                    {
                        "sense_id": "a6e4f489-4bf6-3aac-9303-a270f850ce9e",
                        "entry_id": "de95e87c-e336-39b3-85cc-fd6dbea9843e",
                        "glosses": [
                            "Posaune, die anstatt eines Zuges zur Änderung der Tonhöhe drei oder vier Ventile besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "073a6c82-1c9c-49a0-a79f-7cc77eee252c",
                                "sense_id": "a6e4f489-4bf6-3aac-9303-a270f850ce9e",
                                "text": "„Die Ventilposaune hat statt des Zuges im unteren Teil drei Ventile, ähnlich der Trompete.“"
                            },
                            {
                                "example_id": "86124491-f3cd-4960-824a-b47dc56fe774",
                                "sense_id": "a6e4f489-4bf6-3aac-9303-a270f850ce9e",
                                "text": "„Die höchste Oktave ist vom Gebrauche ausgeschlossen, da diese Ventilposaune die Baßstimme übernimmt.“"
                            },
                            {
                                "example_id": "86b826e0-48cc-4baa-b1da-411c315f07ec",
                                "sense_id": "a6e4f489-4bf6-3aac-9303-a270f850ce9e",
                                "text": "„Die Zugposaune nimmt es bei geschickter Behandlung mit der Ventilposaune an Fertigkeit auf und übertrifft sie an Ton.“"
                            },
                            {
                                "example_id": "e048fc76-9098-48a8-9d30-be139d521ed3",
                                "sense_id": "a6e4f489-4bf6-3aac-9303-a270f850ce9e",
                                "text": "„Und von unten aus dem Kellerloch dröhnt die übende Ventilposaune in langgezogenen, grässlichen, dumpfen Klagetönen, wie die Angst eines lebendig Begrabenen.“"
                            },
                            {
                                "example_id": "138cd2f1-0b82-493a-9012-73b2cd12e0d0",
                                "sense_id": "a6e4f489-4bf6-3aac-9303-a270f850ce9e",
                                "text": "„Die Melodiegruppe, bestehend aus Tenorsaxophon und Ventilposaune, ergibt einen tiefen, volltönenden, sehr stark verschmelzenden Klang.“"
                            },
                            {
                                "example_id": "471e9f66-f3c6-443a-ad00-9bf3ebd3906a",
                                "sense_id": "a6e4f489-4bf6-3aac-9303-a270f850ce9e",
                                "text": "„Bis in die 1880er wurde die alte Ventilposaune verwendet (für die noch Brahms in seiner Zweiten geschrieben hatte), bis sie der moderneren Zugposaune wich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
