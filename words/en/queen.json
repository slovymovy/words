                    "common_phrases": [
                        "prom queen",
                        "homecoming queen",
                        "may queen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Девушка или женщина, выбранная для председательства на определенном фестивале или мероприятии.",
                        "zh": "在特定节日或活动中被选出作为代表的女性。"
                    },
                    "translations": {
