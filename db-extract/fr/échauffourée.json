                                        "sense_id": "02bed939-797c-3099-be25-84da1e704f45",
                                        "entry_id": "6577e845-864f-3265-858c-8b3b82af9889",
                                        "glosses": [
                                            "A brief battle between small groups, usually part of a longer or larger battle or war."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2643b16a-6172-40d5-b390-7923148f0eb0",
                                                "sense_id": "02bed939-797c-3099-be25-84da1e704f45",
                                                "text": "On 2 March, Chinese border guards with the help of regular PLA forces skillfully ambushed Strelnikov's unit on the ice near Chen Pao, killing him and 30 Soviets in the subsequent skirmish."
                                            },
                                            {
                                                "example_id": "ce21b10d-84e6-43ab-80b6-4ac587cca09f",
                                                "sense_id": "02bed939-797c-3099-be25-84da1e704f45",
                                                "text": "The walls are slitted with embrasures through which bowmen could fire, indicating that the belfry also served as a stronghold during border skirmishes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6279d4d-3c36-3f80-a0d1-058498fa95d3",
                                        "entry_id": "6577e845-864f-3265-858c-8b3b82af9889",
                                        "glosses": [
                                            "Any minor dispute."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64c49f50-992b-4728-9bf4-ca601ffb1f9a",
                                                "sense_id": "b6279d4d-3c36-3f80-a0d1-058498fa95d3",
                                                "text": "Three people were arrested after a skirmish in a bar."
                                            },
                                            {
                                                "example_id": "2dc778bb-c64c-4afc-89bb-c0a95b8636a7",
                                                "sense_id": "b6279d4d-3c36-3f80-a0d1-058498fa95d3",
                                                "text": "Fires which have heretofore been one‐alarm skirmishes are now multialarm small wars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5390ec15-2f52-3d7e-942c-5f24b7cb3097",
                                        "entry_id": "6577e845-864f-3265-858c-8b3b82af9889",
