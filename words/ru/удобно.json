                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это время <w>удобно</w> для всех участников собрания.",
                            "target_lang_translations": {
                                "en": "This time is <w>convenient</w> for all meeting participants.",
                                "de": "Diese Zeit ist für alle Teilnehmer der Versammlung <w>günstig</w>."
                            }
                        },
                        {
                            "text": "Место для лагеря было выбрано <w>удобно</w> и красиво.",
                            "target_lang_translations": {
                                "en": "The campsite was chosen <w>conveniently</w> and beautifully.",
                                "de": "Der Platz für das Lager war <w>praktisch</w> und schön ausgewählt."
                            }
                        }
                    ],
