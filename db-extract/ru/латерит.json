                        "source_sense_id": "bbcd48cc-a1fd-32de-ac76-2874ddec466a",
                        "target_lang_word": "laterite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laterite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85c786d5-99c4-3644-93a3-998326f6f459",
                                        "entry_id": "a4019d27-1d9c-37ac-80f6-bda163ab2af2",
                                        "glosses": [
                                            "A red hard or gravel-like soil or subsoil formed in the tropics that has been leached of soluble minerals leaving insoluble iron and aluminium oxides and hydroxides; used to make bricks and roads."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8146ff14-6907-4dee-bad6-ea2700a1888e",
                                                "sense_id": "85c786d5-99c4-3644-93a3-998326f6f459",
                                                "text": "Although the track is ballasted, it does not prevent clouds of reddish dust from the laterite soil blowing about when the train is in motion; after a journey with the windows open a bath is a necessity!"
                                            },
                                            {
                                                "example_id": "1b85da0c-89e4-4992-b654-bac20876212f",
                                                "sense_id": "85c786d5-99c4-3644-93a3-998326f6f459",
                                                "text": "Constant tropical rain makes a mush of hard old lavas. The end product is a brick red soil called laterite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
