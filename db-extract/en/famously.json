                        "entry_id": "1e667733-20fd-3006-8350-694e3e26f072",
                        "glosses": [
                            "Indicates that the act, state, or occurrence described by the sentence is famous In such a manner as to become famous or produce something that would become famous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3232785f-3159-43a4-83d8-4478ab09e707",
                                "sense_id": "a1fefd7a-eef7-357f-ae57-d27deaae3258",
                                "text": "President Roosevelt famously said \"the only thing we have to fear is fear itself.\""
                            },
                            {
                                "example_id": "fc3bb7d9-a000-4207-99ed-20a86cdad1d3",
                                "sense_id": "a1fefd7a-eef7-357f-ae57-d27deaae3258",
                                "text": "But even as religion was on the rise, the word \"God\" declined dramatically over the course of the eighteenth century. The word is famously absent from the Constitution, but it was also relatively absent from the printed texts of the decade in which the Constitution was drafted and adopted, and more broadly from the revolutionary period overall."
                            }
                        ]
                    },
                    {
                        "sense_id": "9cbba163-297f-3b48-956f-695a0d145c73",
                        "entry_id": "1e667733-20fd-3006-8350-694e3e26f072",
                        "glosses": [
                            "Really well, having great rapport."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
