                "senses": [
                    {
                        "sense_id": "2496ec16-ff37-350c-a70b-c5517fafcef2",
                        "entry_id": "abf90401-3bc1-3368-9b1f-5eacf16f5a49",
                        "glosses": [
                            "Ort (Gebäude, Raum, …), an dem Akten aufbewahrt und gelagert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ca2624a-c2dd-42df-9e30-425047c67adf",
                                "sense_id": "2496ec16-ff37-350c-a70b-c5517fafcef2",
                                "text": "„Auch dessen weitere wichtige Komponenten wie das Aktenarchiv, die Dokumente sowie die Informationen über den Besuch und die medizinischen Maßnahmen sollen den Arbeitsablauf und die Behandlung des Patienten unterstützen.“"
                            },
                            {
                                "example_id": "bc981050-1573-42d1-b5eb-6c5de86fc9f7",
                                "sense_id": "2496ec16-ff37-350c-a70b-c5517fafcef2",
                                "text": "„Als sie den Kardinal nicht fanden (er hielt sich im Aktenarchiv versteckt), versuchten sie, Innitzers engsten Mitarbeiter, den Weihbischof Jakob Weinbacher, aus dem Fenster zu stürzen.“"
                            },
                            {
                                "example_id": "4af3b547-1c35-4d71-a0fa-c80d8bcb05b2",
                                "sense_id": "2496ec16-ff37-350c-a70b-c5517fafcef2",
                                "text": "„Außerdem haben die Flammen das Aktenarchiv für die Erhebung von Zweitwohnungssteuern und für die Kurabgaben teilweise vernichtet oder beschädigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
