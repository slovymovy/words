{
    "word_family": [
        "negotiate",
        "negotiation",
        "negotiator"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "de65d51a-e806-3141-b9c1-e78780e64ada",
                    "sense_definition": "Open to discussion or bargaining to reach an agreement.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "negotiation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The final price of the car is <w>negotiable</w> depending on how quickly you can pay.",
                            "target_lang_translations": {
                                "cs": "Konečná cena auta je <w>smluvní</w> v závislosti na tom, jak rychle dokážete zaplatit.",
                                "zh": "汽车的最终价格是<w>可商量的</w>，取决于你能多快付款。"
                            }
                        },
                        {
                            "text": "Our company policy on remote work is <w>negotiable</w> for senior employees.",
                            "target_lang_translations": {
                                "cs": "Naše firemní politika ohledně práce na dálku je pro vedoucí pracovníky <w>k jednání</w>.",
                                "zh": "我们公司针对高级员工的远程办公政策是<w>可协商的</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flexible",
                        "open"
                    ],
                    "antonyms": [
                        "non-negotiable"
                    ],
                    "common_phrases": [
                        "price is negotiable",
                        "terms are negotiable"
                    ],
                    "target_lang_definitions": {
                        "cs": "Otevřený k diskuzi nebo vyjednávání za účelem dosažení dohody.",
                        "zh": "可通过协商或讨论达成一致的；可商量的、可协商的。"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "smluvní",
                                "target_lang_sense_clarification": "o ceně nebo podmínkách, které lze dohodnout"
                            },
                            {
                                "target_lang_word": "k jednání",
                                "target_lang_sense_clarification": "o věcech, o kterých lze diskutovat"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可协商的",
                                "target_lang_sense_clarification": "条件、条款等可经商量确定的"
                            },
                            {
                                "target_lang_word": "可商量的",
                                "target_lang_sense_clarification": "价格或要求等可以讨论调整的"
                            },
                            {
                                "target_lang_word": "面议",
                                "target_lang_sense_clarification": "常用于薪资或价格，指当面商讨"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e48302a6-c977-35d7-9493-ec02bc190b4a",
                    "sense_definition": "Capable of being legally transferred to another person in exchange for money.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A check is a <w>negotiable</w> instrument that can be cashed at a bank.",
                            "target_lang_translations": {
                                "cs": "Šek je <w>převoditelný</w> nástroj, který lze proplatit v bance.",
                                "zh": "支票是一种可以在银行兑现的<w>可流通</w>票据。"
                            }
                        },
                        {
                            "text": "The bond is a <w>negotiable</w> asset that can be sold on the open market.",
                            "target_lang_translations": {
                                "cs": "Dluhopis je <w>obchodovatelné</w> aktivum, které lze prodat na volném trhu.",
                                "zh": "这种债券是一种可以在公开市场上出售的<w>可转让</w>资产。"
                            }
                        }
                    ],
                    "synonyms": [
                        "transferable"
                    ],
                    "common_phrases": [
                        "negotiable instrument"
                    ],
                    "target_lang_definitions": {
                        "cs": "Právně převoditelný na jinou osobu výměnou za peníze.",
                        "zh": "（证券、票据等）可转让的、可流通的。"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "převoditelný",
                                "target_lang_sense_clarification": "o cenných papírech nebo finančních nástrojích"
                            },
                            {
                                "target_lang_word": "obchodovatelný",
                                "target_lang_sense_clarification": "o aktivech, se kterými lze volně nakládat"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可转让的",
                                "target_lang_sense_clarification": "票据或证券可合法过户的"
                            },
                            {
                                "target_lang_word": "可流通的",
                                "target_lang_sense_clarification": "可在市场上流通交易的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e6efc1f-ccaf-35d3-aaac-1cdf24478cde",
                    "sense_definition": "Able to be traveled across or through.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain path was barely <w>negotiable</w> after the heavy snowstorm.",
                            "target_lang_translations": {
                                "cs": "Horská cesta byla po silné sněhové bouři sotva <w>schůdná</w>.",
                                "zh": "大暴雪过后，这条山路几乎无法<w>通行</w>。"
                            }
                        },
                        {
                            "text": "The river remains <w>negotiable</w> by small boats even during the dry season.",
                            "target_lang_translations": {
                                "cs": "Řeka zůstává pro malé lodě <w>průjezdná</w> i během období sucha.",
                                "zh": "即使在枯水期，这条河流对小型船只来说仍然是<w>可通航的</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "navigable",
                        "passable"
                    ],
                    "target_lang_definitions": {
                        "cs": "Schopný být překonán nebo projet (o cestě či terénu).",
                        "zh": "（道路、河流或障碍）可通行的、可穿越的。"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "průjezdný",
                                "target_lang_sense_clarification": "o cestě nebo vodní hladině"
                            },
                            {
                                "target_lang_word": "schůdný",
                                "target_lang_sense_clarification": "o cestě, kterou lze projít"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可通行的",
                                "target_lang_sense_clarification": "道路或河流能够让人或交通工具通过"
                            },
                            {
                                "target_lang_word": "可穿越的",
                                "target_lang_sense_clarification": "地势或障碍能够通过"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9d6975f7-0bdd-3ae6-9bd2-b7c1f750a0e8",
                    "sense_definition": "A factor or term that can be changed or adjusted through discussion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "negotiation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We listed our requirements, separating the <w>negotiables</w> from the essential demands.",
                            "target_lang_translations": {
                                "cs": "Sepsali jsme naše požadavky a oddělili <w>předměty jednání</w> od těch zásadních.",
                                "zh": "我们列出了自身的要求，将<w>可协商的事项</w>与基本诉求区分开来。"
                            }
                        },
                        {
                            "text": "Identify your <w>negotiables</w> early to make the contract process smoother.",
                            "target_lang_translations": {
                                "cs": "Identifikujte své <w>volitelné položky</w> včas, aby byl proces uzavírání smlouvy hladší.",
                                "zh": "尽早明确你的<w>可商榷条件</w>，以使合同签署过程更加顺利。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Faktor nebo podmínka, kterou lze změnit nebo upravit diskuzí.",
                        "zh": "可商量的事项；可协商的条件。"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "předmět jednání",
                                "target_lang_sense_clarification": "věc, o které lze vyjednávat"
                            },
                            {
                                "target_lang_word": "volitelná položka",
                                "target_lang_sense_clarification": "podmínka, která není pevně daná"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可协商的事项",
                                "target_lang_sense_clarification": "谈判中有商量余地的条件或要点"
                            },
                            {
                                "target_lang_word": "可商榷的条件",
                                "target_lang_sense_clarification": "非刚性、可调整的条款"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}