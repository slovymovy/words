                    {
                        "sense_id": "b3fc341d-f6c3-357f-b6ee-c39704d93e1c",
                        "entry_id": "9c126da3-993b-3604-9629-11b764ce4164",
                        "glosses": [
                            "Being medical treatment that does not involve surgery, such as use of drugs or physical therapy."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8d5f2f0f-7108-4e6b-9ca3-b4d6ec90cbd7",
                                "sense_id": "b3fc341d-f6c3-357f-b6ee-c39704d93e1c",
                                "text": "He desperately tried anything to treat his cancer while avoiding surgery; every nonsurgical technique under the sun: chemotherapy, radiation, weird diets..."
                            },
                            {
                                "example_id": "6f3ae77e-a818-4c8a-bd34-f285e0b3021e",
                                "sense_id": "b3fc341d-f6c3-357f-b6ee-c39704d93e1c",
                                "text": "Gone is the era of the cookie-cutter, ski jump nose. Today’s cosmetic doctors are approaching rhinoplasties with a more artistic, individualized approach, using new surgical and nonsurgical techniques to refine rather than revamp one of the most prominent features of the face."
                            }
                        ]
                    }
