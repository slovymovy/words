                            {
                                "example_id": "ab8a1d2f-9a54-425d-967f-735ac06bfa87",
                                "sense_id": "ee9cd48d-05d5-37dc-ac4d-a7a38e7c19b4",
                                "text": "De KNVB heeft oud-international Dyanne Bito benoemd tot bondsridder. De 34-jarige voetbalster speelde 146 interlands voor Oranje, waarin ze zes doelpunten maakte. Bito zette vorig jaar, na het WK in Canada, een punt achter haar interlandloopbaan."
                            },
                            {
                                "example_id": "43847dce-f50b-4de6-b8e2-f3464b78d8c1",
                                "sense_id": "ee9cd48d-05d5-37dc-ac4d-a7a38e7c19b4",
                                "text": "In de periode 1998-2000 was Mathieu bondscoach van de Nederlandse dames. Onder zijn leiding werd de ploeg in 1998 zevende op het WK in Japan en vijfde het jaar daarop bij het EK in Italië. Vanwege zijn verdiensten voor het Nederlandse volleybal werd Mathieu in 2009 benoemd tot bondsridder."
                            },
                            {
                                "example_id": "4e3df50d-b174-466c-a522-539289112f53",
                                "sense_id": "ee9cd48d-05d5-37dc-ac4d-a7a38e7c19b4",
                                "text": "De KNVB heeft vijf oud-internationals benoemd tot bondsridder."
                            }
                        ]
