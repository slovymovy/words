            {
                "entry_id": "57d0ff0d-6f63-3c95-be71-fcce39c35c10",
                "word": "mica",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fa5566d1-538f-4d9c-a6a0-a6cebd10f604",
                        "entry_id": "57d0ff0d-6f63-3c95-be71-fcce39c35c10",
                        "tags": [
                            "plural"
                        ],
                        "form": "micas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d3af11af-18a2-33b6-9d17-dbab2258b4b5",
                        "entry_id": "57d0ff0d-6f63-3c95-be71-fcce39c35c10",
                        "glosses": [
                            "Minéral du groupe des silicates, sous groupe des phyllosilicates, comprenant de nombreuses espèces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91e44519-4b1f-4c13-a890-75a10d7d238b",
                                "sense_id": "d3af11af-18a2-33b6-9d17-dbab2258b4b5",
                                "text": "[…]; et entre ce dernier chemin et la source minérale, de la syénite, diorite et felsite gris-bleuâtre, contenant des grains de mica, sont recouvertes par du grès meulier et du calcaire carbonifère."
                            },
                            {
                                "example_id": "ff125537-740e-4a74-a5dc-012548f9a7f5",
                                "sense_id": "d3af11af-18a2-33b6-9d17-dbab2258b4b5",
                                "text": "[…] ; l'abondance fréquente du mica donne à la roche une texture feuilletée et la rend plus délitable ; […]."
                            },
                            {
                                "example_id": "c5a045cc-6cea-478d-a354-12649e541e3f",
                                "sense_id": "d3af11af-18a2-33b6-9d17-dbab2258b4b5",
                                "text": "Le poil étant focussé (1) avec le coulant à moitié tiré, en rentrant celui-ci, le poil se défocusse, mais le foyer (focus) de l’objectif s’allonge ce qui va nous permettre de baisser tout le système en nous servant de la crémaillère jusqu’à ce que nous apercevions les diatomées que nous avons placées sans ordre sur la lame de mica."
                            },
                            {
                                "example_id": "0bc10e41-0b9d-4782-a436-b6cf76a4e71a",
                                "sense_id": "d3af11af-18a2-33b6-9d17-dbab2258b4b5",
                                "text": "On lui avait donné une paire de lunettes de coureur cycliste en mica avec du velours autour."
                            },
                            {
                                "example_id": "c94c5498-7cfe-49c7-b502-cb87b4b2a2e8",
                                "sense_id": "d3af11af-18a2-33b6-9d17-dbab2258b4b5",
                                "text": "Avec ses vitres-miroirs éteintes, la masse compacte du centre commercial semble couverte de mica noir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38e5a5da-3625-4b7f-9c1c-6f3546c795ae",
                        "source_entry_id": "57d0ff0d-6f63-3c95-be71-fcce39c35c10",
                        "source_sense_id": "d3af11af-18a2-33b6-9d17-dbab2258b4b5",
                        "target_lang_word": "Glimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52e1e8d4-94e2-347e-8c04-1a8e0a4a8063",
                                        "entry_id": "6e02cdaa-98b2-3601-8d75-8a4ad48ab028",
                                        "glosses": [
                                            "schimmerndes Mineral aus einer Gruppe der Schichtsilikate"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6c61dcc-5fa6-4769-bff2-887024e85e36",
                                                "sense_id": "52e1e8d4-94e2-347e-8c04-1a8e0a4a8063",
                                                "text": "Mit der Spitzhacke schlug er den Glimmer aus dem Fels."
                                            },
                                            {
                                                "example_id": "271e60a4-65ee-4dc3-a383-8d3bbb6b6bfc",
                                                "sense_id": "52e1e8d4-94e2-347e-8c04-1a8e0a4a8063",
                                                "text": "Glimmer finden sich überall auf der Welt."
                                            },
                                            {
                                                "example_id": "a732a02f-670b-4417-b87e-1168c4fa78ce",
                                                "sense_id": "52e1e8d4-94e2-347e-8c04-1a8e0a4a8063",
                                                "text": "„Kaiser dieser Welt hatten sich hier im Glimmer von Kristallen, Quarz und Achat den Segen abgeholt, um ihre Macht auf den Schlachtfeldern zu festigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cdb51ec8-93e2-3d5d-b71f-4cadbe640d67",
                                        "entry_id": "6e02cdaa-98b2-3601-8d75-8a4ad48ab028",
                                        "glosses": [
                                            "etwas, das glänzt oder schimmert"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "121bd761-94fa-4c41-a2f8-2b2acb7932df",
                                                "sense_id": "cdb51ec8-93e2-3d5d-b71f-4cadbe640d67",
                                                "text": "„Du bist eher der romantische Typ und nicht wirklich Fan von Glitter und Glimmer? Dann greif zu Pastellfarben.“"
                                            },
                                            {
                                                "example_id": "df0dc5b6-a11f-4c1e-8475-aada81201533",
                                                "sense_id": "cdb51ec8-93e2-3d5d-b71f-4cadbe640d67",
                                                "text": "„Janoschs Traum blieb für immer die »Rummelbudenkultur« mit Glimmer, Glitzer, Katzengold, Pink und Rot.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "daad67f3-30eb-42f3-af2e-eb28f5512dbc",
                        "source_entry_id": "57d0ff0d-6f63-3c95-be71-fcce39c35c10",
