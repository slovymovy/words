                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a351d3da-9269-3b15-8c65-94abaa6a7cf7",
                                        "entry_id": "644f78ed-55eb-3f59-bf7a-a43d4d68c3c9",
                                        "glosses": [
                                            "наречие к сырой; с большим количеством влаги, воды"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fda522cf-6091-4c95-bf0c-461e1ea543c6",
                                                "sense_id": "a351d3da-9269-3b15-8c65-94abaa6a7cf7",
                                                "text": "Я спросил — не замерз ли он? Ведь сыро, роса."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47ba7857-1fc1-3fe9-aee6-38725d4aae89",
                                        "entry_id": "644f78ed-55eb-3f59-bf7a-a43d4d68c3c9",
                                        "glosses": [
                                            "об ощущении сырости, испытываемой кем-либо"
                                        ],
                                        "tags": [
                                            "в знач. сказуемого"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "974439cc-3d92-4bb1-9b42-467c04d68e0e",
                                                "sense_id": "47ba7857-1fc1-3fe9-aee6-38725d4aae89",
                                                "text": "Когда в развалинах становилось очень уж сыро и холодно, шли отогреваться на лестницу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3e8ed52-b968-38e7-9d1f-04cf1a1b62b8",
                                        "entry_id": "644f78ed-55eb-3f59-bf7a-a43d4d68c3c9",
                                        "glosses": [
                                            "о наличии или избытке влаги, влажности где-либо"
                                        ],
                                        "tags": [
                                            "в знач. сказуемого"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90d9a7cf-d3ca-4ca2-83eb-96ac39223e4c",
                                                "sense_id": "f3e8ed52-b968-38e7-9d1f-04cf1a1b62b8",
                                                "text": "У Младшего в штанах вдруг сыро стало."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea3bfdd8-36b2-3395-afd4-29cdc5fb2b51",
                                        "entry_id": "644f78ed-55eb-3f59-bf7a-a43d4d68c3c9",
                                        "glosses": [
                                            "перен. оценка чего-либо как не доведённого до совершенства, завершения"
                                        ],
                                        "tags": [
                                            "в знач. сказуемого"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f160022f-e900-4c6d-8025-bb970c78a35b",
                                                "sense_id": "ea3bfdd8-36b2-3395-afd4-29cdc5fb2b51",
                                                "text": "Все вечно в процессе рождения — и как-то слишком сыро для жизни."
                                            }
                                        ]
                                    }
                                ]
                            },
