                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b93cea04-56cb-4ed4-ac36-26100523b436",
                        "source_entry_id": "d7039cc6-3ebb-305d-b8e7-08dfac24751c",
                        "source_sense_description": "trade unionist",
                        "target_lang_word": "syndicaliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "syndicaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8533e054-f904-3ff2-befa-cdcd0be25490",
                                        "entry_id": "380c87c1-de36-31c8-936b-9776e2cc4987",
                                        "glosses": [
                                            "Relatif ou favorable au syndicalisme."
                                        ],
                                        "tags": [
                                            "Syndicalisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f45fb8c-e990-47fc-949c-52f590adceb6",
                                                "sense_id": "8533e054-f904-3ff2-befa-cdcd0be25490",
                                                "text": "La tête du cortège, c'était nous, c'est-à-dire Germinal, la jeunesse syndicaliste derrière son drapeau noir. C'est ici qu'étaient groupés les éléments les plus ardemment révolutionnaires de la jeunesse du pays."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "syndicaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "14d28e91-8ef3-3a71-830b-fb7e10e49d8d",
                                        "entry_id": "277759ae-5ff4-377f-ae17-bdf8389f8848",
                                        "glosses": [
                                            "Partisan du syndicalisme."
                                        ],
                                        "tags": [
                                            "Syndicalisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dda4d3d0-4b35-47a6-a898-20523762b8ea",
                                                "sense_id": "14d28e91-8ef3-3a71-830b-fb7e10e49d8d",
                                                "text": "À ceux qui accusent les syndicalistes d'être d'obtus et de grossiers personnages, nous avons le droit de demander compte de la décadence économique à laquelle ils travaillent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f47249a-c793-3012-bd16-21aef48da1e9",
                                        "entry_id": "277759ae-5ff4-377f-ae17-bdf8389f8848",
                                        "glosses": [
                                            "Membre d’un syndicat."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1080fee6-89c6-47e6-be4f-e7dcf0321330",
                                                "sense_id": "0f47249a-c793-3012-bd16-21aef48da1e9",
                                                "text": "L’internationalisme sentimental d’avant 1914 n'a pas résisté au choc des nations. Dans tous les pays en guerre, socialistes et syndicalistes, dans leur grande majorité, ont participé à la défense nationale."
                                            },
                                            {
                                                "example_id": "f9826360-1497-4cb2-a9dd-bd2672544952",
                                                "sense_id": "0f47249a-c793-3012-bd16-21aef48da1e9",
                                                "text": "Selon lui, \"une série de syndicalistes risquent le licenciement\"."
                                            },
                                            {
                                                "example_id": "241da0ef-ec86-4571-b2ef-95fe88cb1a74",
                                                "sense_id": "0f47249a-c793-3012-bd16-21aef48da1e9",
                                                "text": "Il y eut aussi un petit courant « pacifiste » en France même, le courant zimmerwaldien, rassemblant des socialistes et des syndicalistes qui rejetaient, pour une part d'entre eux, l'idée révolutionnaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "674bd8cb-82d0-4f65-8b6e-6b43822e6050",
                        "source_entry_id": "d7039cc6-3ebb-305d-b8e7-08dfac24751c",
                        "source_sense_description": "trade unionist",
                        "target_lang_word": "Gewerkschaftler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gewerkschaftler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "926cf64d-5df7-3d73-9139-6e93e9f8a145",
                                        "entry_id": "a8352257-863c-3170-a60c-a3e511081fc5",
                                        "glosses": [
                                            "(männliche^☆) Person, die Mitglied einer Gewerkschaft ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf475d0a-48e8-42de-a374-9ab79f27a727",
                                                "sense_id": "926cf64d-5df7-3d73-9139-6e93e9f8a145",
                                                "text": "Die Gewerkschaftler trafen sich zu einer Betriebsversammlung."
                                            },
                                            {
                                                "example_id": "7c479688-a04a-4ad9-a84c-099bb96c1be8",
                                                "sense_id": "926cf64d-5df7-3d73-9139-6e93e9f8a145",
                                                "text": "„Im Jahre 1960 wurde der Gewerkschaftler zum hauptamtlichen Kreisvorsitzenden des DGB für den Kreis Bremervörde gewählt.“"
                                            },
                                            {
                                                "example_id": "2d29cfe8-61b2-452f-9772-7042656ab505",
                                                "sense_id": "926cf64d-5df7-3d73-9139-6e93e9f8a145",
                                                "text": "„In einer konzertierten Aktion wollen sie nicht nur auf die miserable Situation der Menschen auf dem Arbeitsmarkt, sondern auch gegen die vermeintliche Aussichtslosigkeit antreten: Betriebsratsmitglieder, Gewerkschaftler und kirchliche Mitarbeiter und Mitarbeiterinnen sowie Engagierte in der Arbeitslosenarbeit in der Heinsberger und Mönchengladbacher Region.“"
                                            },
                                            {
                                                "example_id": "38d057d6-44e3-4c67-98ae-3bb8bf00ce94",
                                                "sense_id": "926cf64d-5df7-3d73-9139-6e93e9f8a145",
                                                "text": "„Schon deshalb sparten die Gewerkschaftler nicht mit kämpferischen Worten.“"
                                            },
                                            {
                                                "example_id": "0287b011-16c8-47ca-9500-adb914345b2f",
                                                "sense_id": "926cf64d-5df7-3d73-9139-6e93e9f8a145",
                                                "text": "„Doch nicht nur technische Entwicklungen treiben die Gewerkschaftler um.“"
                                            },
                                            {
                                                "example_id": "560f9c28-a24a-4686-a057-7f8887225392",
                                                "sense_id": "926cf64d-5df7-3d73-9139-6e93e9f8a145",
                                                "text": "„Zu den tausenden Verhafteten gehören nach wie vor viele Gewerkschaftler und politisch Linke.“"
                                            },
                                            {
                                                "example_id": "19f9df70-5772-4ff9-97be-4ee9ddaf12c8",
                                                "sense_id": "926cf64d-5df7-3d73-9139-6e93e9f8a145",
                                                "text": "„Sozialdemokraten und Gewerkschaftler müssen sich entscheiden, und das bald.“"
                                            },
                                            {
                                                "example_id": "bc547656-2af9-4078-b422-d4fcfee97300",
                                                "sense_id": "926cf64d-5df7-3d73-9139-6e93e9f8a145",
                                                "text": "„Mit dem Angebot will die Bahn die Gewerkschaftler zu neuen Verhandlungen bewegen.“"
                                            },
                                            {
                                                "example_id": "1656a5fc-24bf-40a1-b46e-4038322b7f0e",
                                                "sense_id": "926cf64d-5df7-3d73-9139-6e93e9f8a145",
                                                "text": "„Dem Gewerkschaftler sei berichtet worden, dass Vorgesetzte über die bevorstehende Versammlung am Montag informiert hätten.“"
                                            },
                                            {
                                                "example_id": "32241882-aa43-436f-a2eb-c60a947a7b5c",
                                                "sense_id": "926cf64d-5df7-3d73-9139-6e93e9f8a145",
                                                "text": "„Der Kontrabass-Musiker der Mecklenburgischen Staatskapelle und Gewerkschaftler fordert aber eben dies.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e59cb4c1-ee6e-4748-9ab8-c328272c00c8",
                        "source_entry_id": "d7039cc6-3ebb-305d-b8e7-08dfac24751c",
                        "source_sense_description": "trade unionist",
                        "target_lang_word": "Gewerkschafter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gewerkschafter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7990ea67-45d7-3abc-bc2f-f268d4c87de9",
                                        "entry_id": "93504ec6-c971-385c-b22c-e0a0f90c63b7",
                                        "glosses": [
                                            "(männliche^☆) Person, die Mitglied einer Gewerkschaft ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee00a780-587e-46d8-b7e6-0c7fa15cb5a4",
                                                "sense_id": "7990ea67-45d7-3abc-bc2f-f268d4c87de9",
                                                "text": "„Häuselmann / Klemm kommen zu dem Schluß, daß etwa ein Akademiker als Mandatsträger die Interessen der Arbeitnehmer genauso vertreten könne wie umgekehrt ein Gewerkschafter die Belange von Akademikern: entscheidend dürfe allein die politische Grundhaltung sein.“"
                                            },
                                            {
                                                "example_id": "5a731cfe-889d-4a43-99ee-2e3cc0761578",
                                                "sense_id": "7990ea67-45d7-3abc-bc2f-f268d4c87de9",
                                                "text": "Die Gewerkschafter werden dazu angehalten, sich am Streik zu beteiligen."
                                            },
                                            {
                                                "example_id": "1275df5c-fa26-4d85-bd7b-c78ddb71336e",
                                                "sense_id": "7990ea67-45d7-3abc-bc2f-f268d4c87de9",
                                                "text": "„Die Telephonverbindungen mit dem Norden sind zwar gekappt, doch über Internet tauschen seine Aktivisten, Akademiker und Gewerkschafter ungestört Grußbotschaften aus.“"
                                            },
                                            {
                                                "example_id": "4cce015b-fb15-4753-96dc-b48f103928a6",
                                                "sense_id": "7990ea67-45d7-3abc-bc2f-f268d4c87de9",
                                                "text": "„Das war die Auffassung einer Oppositionsgruppe unter dem Gewerkschafter Josef Zinner, der eine England-Gruppe von Vertrauensmännern der Gewerkschaften ins Leben gerufen hatte.“"
                                            },
                                            {
                                                "example_id": "672c97b6-ccdb-4d9e-8992-6efb1b1e217e",
                                                "sense_id": "7990ea67-45d7-3abc-bc2f-f268d4c87de9",
                                                "text": "„Doch zum Jahreswechsel warnen Ökonomen, Juristen und Gewerkschafter vor den Spätfolgen.“"
                                            },
                                            {
                                                "example_id": "0613ecad-66f6-43cb-8570-078f3dadd12a",
                                                "sense_id": "7990ea67-45d7-3abc-bc2f-f268d4c87de9",
                                                "text": "„1963 berief ihn die IG Metall als hauptamtlichen Gewerkschafter und beauftragte ihn mit der Zusammenführung der Verwaltungsstellen Bad Kreuznach und Idar-Oberstein.“"
                                            },
                                            {
                                                "example_id": "78e6fc11-b0ea-4fc5-abd2-ca162f81f0f8",
                                                "sense_id": "7990ea67-45d7-3abc-bc2f-f268d4c87de9",
                                                "text": "„SP-Insider berichten allerdings, dass auch Bettina Stadlbauer, Vorsitzende der Sozialdemokratischen Gewerkschafter in Linz und als Vizechefin der Linzer SP eine Stellvertreterin von Klaus Luger, die Aktion nicht gutgeheißen habe.“"
                                            },
                                            {
                                                "example_id": "ecf94582-f65a-4184-a929-8a475b99b3e9",
                                                "sense_id": "7990ea67-45d7-3abc-bc2f-f268d4c87de9",
                                                "text": "„Kein Mensch regte sich auf, als ein Dutzend Gewerkschafter die Halle durchquerten.“"
                                            },
                                            {
                                                "example_id": "befa5575-ed76-4639-b716-bff76d1f2968",
                                                "sense_id": "7990ea67-45d7-3abc-bc2f-f268d4c87de9",
                                                "text": "„Dass diese jetzt Gegenstand von Ermittlungen sind, findet der Gewerkschafter grundsätzlich begrüßenswert.“"
                                            },
                                            {
                                                "example_id": "85cb23a2-3c2f-4a9a-961a-b3d749ae4329",
                                                "sense_id": "7990ea67-45d7-3abc-bc2f-f268d4c87de9",
                                                "text": "„Seit 2016 fand in Gütersloh kein derartiger Empfang mehr für Gewerkschafter, Betriebs- und Personalräte sowie auch Jugendvertretungen in Betrieben statt.“"
                                            },
                                            {
                                                "example_id": "20604c5c-0cc3-4cd5-83e5-df0739d813fb",
                                                "sense_id": "7990ea67-45d7-3abc-bc2f-f268d4c87de9",
                                                "text": "„Es war – so das Schreiben – eine Zeit, in der ‚Tausende von Menschen im Exil starben, gefoltert und ermordet wurden; Frauen ihr Leben lang als minderjährig galten und aus moralischen Gründen verurteilt und in psychiatrische Kliniken eingewiesen wurden; Homosexuelle inhaftiert und gefoltert sowie Tausende von Aktivisten und Gewerkschaftern gewaltsam unterdrückt wurden‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
