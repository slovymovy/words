                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "equality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55cbd877-3d88-3250-b898-fd2e6405251e",
                                        "entry_id": "40910835-d299-372a-9d06-12b1df341d9e",
                                        "glosses": [
                                            "The fact of being equal."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e2633ac-0eb1-4a03-9f7d-346964717162",
                                                "sense_id": "55cbd877-3d88-3250-b898-fd2e6405251e",
                                                "text": "The most powerful of these general ideas which have shaped political development in recent times is of course the ideal of material equality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d5423eb-7db4-383b-8484-9bc843ff4b13",
                                        "entry_id": "40910835-d299-372a-9d06-12b1df341d9e",
                                        "glosses": [
                                            "The fact of being equal, of having the same value."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00484ebf-6e46-3c2e-92bb-9cc280720df7",
                                        "entry_id": "40910835-d299-372a-9d06-12b1df341d9e",
                                        "glosses": [
                                            "The equal treatment of people irrespective of social or cultural differences."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9d7d907-d615-4ab0-938d-77762e800858",
                                                "sense_id": "00484ebf-6e46-3c2e-92bb-9cc280720df7",
                                                "text": "Jefferson was talking about the equality of natural human rights. You have freedom, and I have freedom. You and I have equal rights to freedom."
                                            },
                                            {
                                                "example_id": "26e29fdf-12f5-4aa1-97da-41b3bcc4e2a3",
                                                "sense_id": "00484ebf-6e46-3c2e-92bb-9cc280720df7",
                                                "text": "I think somebody asked me the other day when I was holding a conference over here at the library if a woman could be President of the United States. Well I said they've taken over everything else in the world, why not that? [Laughter] And that wouldn't surprise me if it doesn't happen one of these days because the country believes in equality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
