                                        "entry_id": "8078b8b9-b692-383a-b12f-a067454e6780",
                                        "glosses": [
                                            "Unité de mesure de longueur du Système international (SI), valant 10⁻⁹ mètre, et dont le symbole est nm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "221d104f-7346-4a74-873d-8b036295aaaf",
                                                "sense_id": "5daa1902-4e0c-37bf-9238-9f66fef74e23",
                                                "text": "Il y a un milliard de nanomètres dans un mètre."
                                            },
                                            {
                                                "example_id": "f48363a7-04b3-434e-b109-20fa89758192",
                                                "sense_id": "5daa1902-4e0c-37bf-9238-9f66fef74e23",
                                                "text": "Les particules élémentaires qui entrent en jeu à cette échelle de mesure ont des dimensions qui sont bien dessous du nanomètre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
