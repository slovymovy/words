                "senses": [
                    {
                        "sense_id": "6085ee87-310d-34b8-bdb8-e7648638f6fc",
                        "entry_id": "c6e3e73a-5fa7-3a9c-8cf2-0572d956dfe6",
                        "glosses": [
                            "od prosię"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "37e5b2c6-cfd3-4a95-b19b-7c88a8b29ec6",
                                "sense_id": "6085ee87-310d-34b8-bdb8-e7648638f6fc",
                                "text": "Dziedziczka przygarnęła pod swoje skrzydła małą wietnamską świnkę i ponoć prosiątko stało się jej oczkiem w głowie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2eb32939-2c0b-4b71-8a89-d267003e18a4",
                        "source_entry_id": "c6e3e73a-5fa7-3a9c-8cf2-0572d956dfe6",
                        "source_sense_id": "6085ee87-310d-34b8-bdb8-e7648638f6fc",
                        "target_lang_word": "Ferkelchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ferkelchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b706b22-b5fa-33e3-9764-e476afec40c5",
                                        "entry_id": "2cb6a508-c8fb-3b0f-85ff-b0d921206f35",
                                        "glosses": [
                                            "kleines Ferkel"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01a8dfb6-92ed-42aa-8d94-9df576ae8178",
                                                "sense_id": "2b706b22-b5fa-33e3-9764-e476afec40c5",
                                                "text": "Ich sah ein Ferkelchen auf dem Bauernhof meines Großonkels herumlaufen."
                                            },
                                            {
                                                "example_id": "9c683827-409f-4ab3-b397-a923cf3e7f07",
                                                "sense_id": "2b706b22-b5fa-33e3-9764-e476afec40c5",
                                                "text": "„Mit vielen schönen Bildern von Zuchtbullen und süßen Ferkelchen will die Grüne Woche in Berlin die Verbraucher von einer gesunden Landwirtschaft überzeugen.“"
                                            },
                                            {
                                                "example_id": "4baf9e5c-c2f0-4d5d-8e1a-20e85b694961",
                                                "sense_id": "2b706b22-b5fa-33e3-9764-e476afec40c5",
                                                "text": "„Heimlicher Hauptdarsteller ist übrigens Ferkelchen, das Hausschwein der von Tausendschlags.“"
                                            },
                                            {
                                                "example_id": "1955b97c-6148-41b2-8b45-4b4454feb9e8",
                                                "sense_id": "2b706b22-b5fa-33e3-9764-e476afec40c5",
                                                "text": "„Die Prinzessin, die doch gar zu gern das Ferkelchen gehabt hätte, ließ dem Jungen seinen Willen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
