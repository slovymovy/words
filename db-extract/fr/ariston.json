                            {
                                "example_id": "35982f72-8116-4ddb-a76e-6f36c0935109",
                                "sense_id": "7b46944f-bca6-3fab-84f5-2b71a2406b26",
                                "text": "Directeur Europe du groupe Ariston qui comprenait les marques Ariston, Scholtès et Indesit, j’ai dû mettre en œuvre plusieurs plans sociaux à l’usine de Thioville."
                            },
                            {
                                "example_id": "471433b0-ce82-46ad-92fe-9a6cd91cd59e",
                                "sense_id": "7b46944f-bca6-3fab-84f5-2b71a2406b26",
                                "text": "Ainsi, le groupe Merloni vend sous les marques Indesit, Ariston et Scholtès."
                            },
                            {
                                "example_id": "f758cbab-02ca-4159-af60-e5afd40797fb",
                                "sense_id": "7b46944f-bca6-3fab-84f5-2b71a2406b26",
                                "text": "Elle distribue les marques Indesit, Hotpoint-Ariston, Scholtès, Whirlpool et KitchenAid."
                            }
                        ]
