                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6782552-8b96-459b-ac44-73828800f66d",
                                                "sense_id": "67963a05-2813-3f4a-8d5d-c609cbaa5176",
                                                "text": "An dieser Sache ist etwas faul."
                                            },
                                            {
                                                "example_id": "481b0dc6-5dd2-420a-b76a-1b432dae9fd6",
                                                "sense_id": "67963a05-2813-3f4a-8d5d-c609cbaa5176",
                                                "text": "Es wurden faule Immobilienkredite vergeben."
                                            },
                                            {
                                                "example_id": "6ca6ad28-57ee-41cd-9124-c3c2709ea23c",
                                                "sense_id": "67963a05-2813-3f4a-8d5d-c609cbaa5176",
                                                "text": "Dass er krank sein soll, das ist doch nur eine faule Ausrede. In Wirklichkeit renoviert er sein Haus!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
