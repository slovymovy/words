                "translations": [
                    {
                        "translation_id": "ac23973f-f568-4326-b0fe-8a78a08f782c",
                        "source_entry_id": "429f2e15-dd2b-3a23-ad99-f61834075068",
                        "source_sense_id": "cb8b3d49-1d14-35e8-8917-42bed40ff90a",
                        "target_lang_word": "kunstvoll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kunstvoll",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "beb5d9e3-f79f-3ad0-ab79-fb5e6791c8c5",
                                        "entry_id": "056ff592-a343-3d58-86a6-d8a2a00fc9f0",
                                        "glosses": [
                                            "mit erheblichen (handwerklichen, künstlerischen, technischen) Fertigkeiten hergestellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d2018ba-dc33-4bec-9504-4f6043d9f31b",
                                                "sense_id": "beb5d9e3-f79f-3ad0-ab79-fb5e6791c8c5",
                                                "text": "„Goldschmied/-in: Manchmal entwerfen sie kunstvolles Geschmeide, oft erledigen sie Reparaturen oder arbeiten Schmuckstücke um.“"
                                            },
                                            {
                                                "example_id": "bb17c255-f295-4ee1-9f31-1907ff32b9ce",
                                                "sense_id": "beb5d9e3-f79f-3ad0-ab79-fb5e6791c8c5",
                                                "text": "„Goldlöffel – Tee für 24 Damen: Zu welchem festlichen Anlass ist dieses kunstvoll verzierte Boulle-Kästchen mit goldenen Teelöffeln, Zuckerzange, Teeschaufel und Sieb wohl verschenkt worden?“"
                                            },
                                            {
                                                "example_id": "37de7ecb-a661-4c43-ba70-93922aee2332",
                                                "sense_id": "beb5d9e3-f79f-3ad0-ab79-fb5e6791c8c5",
                                                "text": "„Hafner und Bossierer verhalfen der oberfränkischen Stadt Creußen im 17. und 18. Jahrhundert zu Weltruhm. Fürsten und Geistliche schätzten ihre kunstvoll gestalteten Krüge.“"
                                            },
                                            {
                                                "example_id": "482dbcfe-8ce1-40a2-8ec5-e4fb690ab0a3",
                                                "sense_id": "beb5d9e3-f79f-3ad0-ab79-fb5e6791c8c5",
                                                "text": "„«The Assassin» ist ein kunstvoll verfilmter Martial-Arts-Film.“"
                                            },
                                            {
                                                "example_id": "5da4ee1d-2ce6-44d5-a567-ac54687499cf",
                                                "sense_id": "beb5d9e3-f79f-3ad0-ab79-fb5e6791c8c5",
                                                "text": "„Humor, Qualitätsjournalismus und kunstvolle Titelblätter: «The New Yorker» zählt zu den angesehensten Zeitschriften in den USA – und nicht nur dort.“"
                                            },
                                            {
                                                "example_id": "0c5142a3-44b7-4169-b9d8-3034c38737e1",
                                                "sense_id": "beb5d9e3-f79f-3ad0-ab79-fb5e6791c8c5",
                                                "text": "„Das Bild ist effektvoll gestaltet, die einzelnen Szenen wirken wie Theaterkulissen und sind kunstvoll ins Licht gesetzt.“"
                                            },
                                            {
                                                "example_id": "fa5d0637-e017-45ef-81a3-5803247d7c35",
                                                "sense_id": "beb5d9e3-f79f-3ad0-ab79-fb5e6791c8c5",
                                                "text": "„Vier Personen, ein Wochenende und ein Haus am See: Aus mehreren Perspektiven setzt Miku Sophie Kühmel kunstvoll eine Geschichte über Sehnsucht, Liebe und Beziehungen zusammen.“"
                                            },
                                            {
                                                "example_id": "163d43a8-4fb0-4836-8bd4-56d5c8d74518",
                                                "sense_id": "beb5d9e3-f79f-3ad0-ab79-fb5e6791c8c5",
                                                "text": "„Die Kleidung der Gauchos ist hier im Norden sehr traditionell, über den weiten Hosen, den bombachas, werden bunte Stofftücher kunstvoll mit Lederriemen befestigt, die Sporen tragen viele Gauchos an den nackten Füßen.“"
                                            },
                                            {
                                                "example_id": "e28ab7b5-fb61-4212-a69c-c3a575b5896e",
                                                "sense_id": "beb5d9e3-f79f-3ad0-ab79-fb5e6791c8c5",
                                                "text": "„Essen ist so eine Sache. Für die einen ist \"schnell\" dabei das wichtigste Kriterium, für die anderen \"viel\". Für dritte aber soll es besonders sein, raffiniert, kunstvoll - Sternenküche eben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98fcf089-f003-475c-a659-b573ade11d8e",
                        "source_entry_id": "429f2e15-dd2b-3a23-ad99-f61834075068",
