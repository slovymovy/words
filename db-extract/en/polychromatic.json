                                            "Malerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ab75b20-a56b-4707-94fd-4254216ec57b",
                                                "sense_id": "86864907-5eaa-3692-bc9c-8a85b146b2b9",
                                                "text": "„Eine besonders markante Neuerung ist die Entwicklung der polychromen Malerei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
