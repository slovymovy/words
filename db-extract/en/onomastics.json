                        "target_lang_word": "Onomatologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c87a2646-975b-4795-af30-fcbc4256f6f8",
                        "source_entry_id": "36e92e57-070f-3ce4-a314-bea618fac363",
                        "source_sense_id": "66b7c6a6-0414-30b8-a0a2-12c83146880e",
                        "source_sense_description": "branch of lexicology devoted to the study of names",
                        "target_lang_word": "Onomasiologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Onomasiologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a4fe3c4-0dcc-3e32-9b66-6b018acc5638",
                                        "entry_id": "3feacf09-eb2f-3be9-b1e2-cc54aa4e8cba",
                                        "glosses": [
                                            "Forschungsrichtung der Semantik, die danach fragt, welche Bezeichnungen für bestimmte Sachverhalte, Gegenstände etc. in einer Sprache oder einem Dialekt verwendet werden. Man geht also von den zu bezeichnenden Sachverhalten aus und fragt nach den Ausdrücken dafür."
                                        ],
                                        "tags": [
                                            "speziell Semantik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24c408cb-1146-4c8f-adcf-4811020a1885",
                                                "sense_id": "2a4fe3c4-0dcc-3e32-9b66-6b018acc5638",
                                                "text": "Die Onomasiologie fragt z.B. danach, welche Bezeichnungen für die \"Kartoffel\" in verschiedenen Regionen Deutschlands verwendet werden."
                                            },
                                            {
                                                "example_id": "907f648b-d8cb-4da7-acf2-53dc730ae7e8",
                                                "sense_id": "2a4fe3c4-0dcc-3e32-9b66-6b018acc5638",
                                                "text": "„Onomasiologie und Semasiologie untersuchen die lexikalischen Einheiten und Beziehungen sowohl unter synchronischem als auch unter diachronischem Aspekt, also sowohl den Zustand als auch die Veränderungen des Systems der Benennungen und der Wortbedeutungen.“"
                                            },
                                            {
                                                "example_id": "8014dd56-5871-43ac-980e-4b7f6666e847",
                                                "sense_id": "2a4fe3c4-0dcc-3e32-9b66-6b018acc5638",
                                                "text": "„Im Bereich der Wortsemantik wird dieser Komplementarität durch die Unterscheidung von Onomasiologie (Bezeichnungslehre) und Semasiologie (Bedeutungslehre) Rechnung getragen.“"
                                            },
                                            {
                                                "example_id": "4cd80061-2388-4779-b5a9-c87f138f7e08",
                                                "sense_id": "2a4fe3c4-0dcc-3e32-9b66-6b018acc5638",
                                                "text": "„Die Darstellungsfunktion des Wortschatzes ist am differenziertesten von der Semasiologie und Onomasiologie beschrieben worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0b6f253-b23d-45fd-bf47-61bb5e70edb5",
                        "source_entry_id": "36e92e57-070f-3ce4-a314-bea618fac363",
                        "source_sense_id": "66b7c6a6-0414-30b8-a0a2-12c83146880e",
                        "source_sense_description": "branch of lexicology devoted to the study of names",
                        "target_lang_word": "Namenforschung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Namenforschung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c32aa37c-e30f-3a87-bbcf-65cc8a7263da",
                                        "entry_id": "6f293d46-4ef5-3723-94f2-2676798d595a",
                                        "glosses": [
                                            "linguistische Disziplin, die sich der Erforschung von Eigennamen widmet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a5c5397-e358-4c0c-8c5b-b089f7616bb7",
                                                "sense_id": "c32aa37c-e30f-3a87-bbcf-65cc8a7263da",
                                                "text": "Die Namenforschung erforscht die Entwicklung, Etymologie und Verbreitung von Eigennamen."
                                            },
                                            {
                                                "example_id": "bcd55a6d-a4b2-462a-8444-960fc52a5f1e",
                                                "sense_id": "c32aa37c-e30f-3a87-bbcf-65cc8a7263da",
                                                "text": "„Die Namenforschung der Staaten der Erde ist zweifellos noch nicht abgeschlossen.“"
                                            },
                                            {
                                                "example_id": "5c6edc99-0cff-4373-9650-ca380366d891",
                                                "sense_id": "c32aa37c-e30f-3a87-bbcf-65cc8a7263da",
                                                "text": "„Als traditionelle Orte der Namenforschung im deutschsprachigen Raum sind Lüneburg, Heidelberg, Mainz und Wiesbaden sowie mit Statistiken auch Zentren in Österreich und der Schweiz zu nennen.“"
                                            },
                                            {
                                                "example_id": "15a8366f-d98f-43ab-aafe-3830edc59d61",
                                                "sense_id": "c32aa37c-e30f-3a87-bbcf-65cc8a7263da",
                                                "text": "„Ein Kosename, in der Namenforschung auch als Hypokoristikum bezeichnet, wird oft formal mit einem Kurznamen beziehungsweise einer Kurzform gleichgesetzt.“"
                                            },
                                            {
                                                "example_id": "c5843056-ef60-4b17-9a2a-61a87a749a49",
                                                "sense_id": "c32aa37c-e30f-3a87-bbcf-65cc8a7263da",
                                                "text": "„Bandnamen haben in der Namenforschung bisher keine Beachtung gefunden, obwohl sie sowohl von der kultursemantischen als auch der formal-strukturellen Seite her interessant sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
