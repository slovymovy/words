    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "856daccb-fb96-35e9-bb4f-02aea132d2ab",
                    "sense_definition": "Keerpunt of overgang naar een geheel nieuwe periode of toestand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verandering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De val van de Berlijnse Muur bracht een historische <w>wende</w> in Europa teweeg.",
                            "target_lang_translations": {
                                "en": "The fall of the Berlin Wall brought about a historic <w>turning point</w> in Europe."
                            }
                        },
                        {
                            "text": "Na jaren van economische crisis hoopte het volk vurig op een politieke <w>wende</w>.",
                            "target_lang_translations": {
                                "en": "After years of economic crisis, the people fervently hoped for a political <w>turnaround</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wending",
                        "omslag"
                    ],
                    "common_phrases": [
                        "historische wende",
                        "politieke wende"
                    ],
                    "target_lang_definitions": {
                        "en": "A turning point or transition to a completely new era, situation, or state of affairs."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turning point",
                                "target_lang_sense_clarification": "historical or political change"
                            },
                            {
                                "target_lang_word": "watershed moment",
                                "target_lang_sense_clarification": "major historical event"
                            },
                            {
                                "target_lang_word": "turnaround",
                                "target_lang_sense_clarification": "shift in political or social course"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b627fbeb-56f9-32a0-9f73-c6467a727666",
                    "sense_definition": "Het maken van een draai of verandering van richting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het schip maakte een scherpe <w>wende</w> om de naderende rotsen te ontwijken.",
                            "target_lang_translations": {
                                "en": "The ship made a sharp <w>turn</w> to avoid the approaching rocks."
                            }
                        },
                        {
                            "text": "Met een sierlijke <w>wende</w> zette de danser zijn beweging over de vloer voort.",
                            "target_lang_translations": {
                                "en": "With a graceful <w>pirouette</w>, the dancer continued his movement across the floor."
                            }
                        }
                    ],
                    "synonyms": [
                        "draai",
                        "wending",
                        "omdraai"
                    ],
                    "common_phrases": [
                        "scherpe wende"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "weinig frequent in modern dagelijks taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A turn or physical change of direction."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turn",
                                "target_lang_sense_clarification": "change of physical direction"
                            },
                            {
                                "target_lang_word": "tack",
                                "target_lang_sense_clarification": "in sailing"
                            },
                            {
                                "target_lang_word": "pirouette",
                                "target_lang_sense_clarification": "in dance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd628bec-32a1-31cc-9b1b-edd36a5ede00",
                    "sense_definition": "Strook aan de uiteinden van een akker waar de ploeg telkens gekeerd werd en die als laatste dwars geploegd is.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer liet de trekker langzaam stilstaan op de brede <w>wende</w> van het veld.",
                            "target_lang_translations": {
                                "en": "The farmer slowly brought the tractor to a stop on the wide <w>headland</w> of the field."
                            }
                        },
                        {
                            "text": "Aan het einde van het seizoen ploegde hij ook de <w>wende</w> zorgvuldig om.",
                            "target_lang_translations": {
                                "en": "At the end of the season, he also carefully plowed the <w>headland</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A strip of land at the edge of a field where a plow or machinery turns around; a headland."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "headland",
                                "target_lang_sense_clarification": "agricultural strip for turning a plow"
                            },
                            {
                                "target_lang_word": "turnpike",
                                "target_lang_sense_clarification": "edge of a plowed field"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f021d4f5-188f-3189-9840-549822eeaa95",
                    "sense_definition": "Enkelvoud verleden tijd van <w>wennen</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammaticale_vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>wende</w> maar langzaam aan het koude en regenachtige klimaat.",
                            "target_lang_translations": {
                                "en": "She <w>got used</w> only slowly to the cold and rainy climate."
                            }
                        },
                        {
                            "text": "Hij <w>wende</w> snel aan zijn nieuwe collega's en de werksfeer op kantoor.",
                            "target_lang_translations": {
                                "en": "He quickly <w>became accustomed</w> to his new colleagues and the atmosphere at the office."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Singular past tense of 'wennen': became accustomed to or got used to."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "used to",
                                "target_lang_sense_clarification": "past tense: got used to"
                            },
                            {
                                "target_lang_word": "accustomed to",
                                "target_lang_sense_clarification": "past tense: grew accustomed to"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2f85fb2-cfd6-3fde-a44c-15a97e1c71c3",
                    "sense_definition": "Aanvoegende wijs van <w>wenden</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammaticale_vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voor meer informatie over de aanvraag <w>wende</w> men zich tot de receptie.",
                            "target_lang_translations": {
                                "en": "For more information about the application, one <w>should turn</w> to the reception desk."
                            }
                        },
                        {
                            "text": "Wie klachten heeft over de behandeling, <w>wende</w> zich schriftelijk tot het bestuur.",
                            "target_lang_translations": {
                                "en": "Anyone with complaints about the treatment <w>should apply</w> in writing to the board."
                            }
                        }
                    ],
                    "common_phrases": [
