                        "glosses": [
                            "voltooid deelwoord van bekken"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "ce51c28d-4bfb-4fdb-ae14-83bbe8e17108",
                                "sense_id": "22e43841-459c-373e-bc8e-7aa7fbd8b7d1",
                                "text": "Kyra: „Als een jongen terugkomt van stappen en hij heeft met vier meisjes gebekt, dan wordt hij de hemel in geprezen. Meisjes worden instant geslutshamed. Wij hebben met vrienden afgesproken om dat niet te doen.”"
                            },
                            {
                                "example_id": "f557e7bd-ef67-4111-b8f4-4f2c1bf211fc",
                                "sense_id": "22e43841-459c-373e-bc8e-7aa7fbd8b7d1",
                                "text": "Ik heb niets tegen Nederlandstalige liedjes, maar ik krijg ze eenvoudigweg niet gebekt, hoe vaak ik dat ook heb geprobeerd."
                            }
                        ]
                    }
                ],
