                "senses": [
                    {
                        "sense_id": "62bf885d-11de-3168-908b-88ad07294d60",
                        "entry_id": "b332a7d6-9981-3a56-8b9b-a12b1659c6c0",
                        "glosses": [
                            "guter, angenehmer Klang/Ton"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02abf06b-32ab-49ab-9c49-73ed5ef950a5",
                                "sense_id": "62bf885d-11de-3168-908b-88ad07294d60",
                                "text": "„Dann sah er sie auf der Bühne stehen, ruhig, ihres Erfolges sicher, und es war ihm, als vernähme er den Wohllaut ihrer Stimme.“"
                            },
                            {
                                "example_id": "6eb3da93-5778-4fff-927a-0d9c48d34c96",
                                "sense_id": "62bf885d-11de-3168-908b-88ad07294d60",
                                "text": "„Mit anderen Worten: Anita Cerquetti hatte eine Stradivari in der Kehle, die beglückenden Wohllaut verströmte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dec1d560-f887-45b1-9f49-46b62bd4857d",
                        "source_entry_id": "b332a7d6-9981-3a56-8b9b-a12b1659c6c0",
                        "source_sense_id": "62bf885d-11de-3168-908b-88ad07294d60",
                        "source_sense_description": "guter, angenehmer Klang/Ton",
                        "target_lang_word": "melody",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "melody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1059406-5f6a-3fab-bf85-35caa949b713",
                                        "entry_id": "6f8d40c1-c0f1-31c1-a813-adfab1237191",
                                        "glosses": [
                                            "A sequence of notes that makes up a musical phrase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "019290de-c045-4d6e-894f-3dd35abf6554",
                                                "sense_id": "d1059406-5f6a-3fab-bf85-35caa949b713",
                                                "text": "Alyssa likes to sing melodies while playing the drums."
                                            },
                                            {
                                                "example_id": "575538b8-cfda-4e89-aa43-0d6b4cb86ae5",
                                                "sense_id": "d1059406-5f6a-3fab-bf85-35caa949b713",
                                                "text": "There is a melody upon the Earth as though ten thousand streams all sang together for their homes that they had forsaken in the hills."
                                            },
                                            {
                                                "example_id": "dec551b4-70ae-42f2-84d3-67bebfb07fbf",
                                                "sense_id": "d1059406-5f6a-3fab-bf85-35caa949b713",
                                                "text": "Slowly she turned round and faced towards a neat white bungalow, set some way back from the path behind a low hedge of golden privet. No light showed, but someone there was playing the piano. The strange elusiveness of the soft, insistent melody seemed to draw her forward."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11e8a032-41f4-499c-a211-c7896fd99ce9",
                        "source_entry_id": "b332a7d6-9981-3a56-8b9b-a12b1659c6c0",
                        "source_sense_id": "62bf885d-11de-3168-908b-88ad07294d60",
                        "source_sense_description": "guter, angenehmer Klang/Ton",
                        "target_lang_word": "euphonie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "euphonie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92e29a2c-db09-387b-bb78-da1e17479782",
                                        "entry_id": "029fb9c8-a0e0-3a7c-b8a4-068f3628d188",
                                        "glosses": [
                                            "Ce qui rend la prononciation plus douce et plus coulante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c241ab6-baa8-46fc-bbe4-64a97aca52e8",
                                                "sense_id": "92e29a2c-db09-387b-bb78-da1e17479782",
                                                "text": "Admettre, ainsi que le veulent certains volapükistes, qu'il y a des principes d’euphonie ou d’harmonie, qui doivent guider l'élèves dans le choix des tournures ou dans la construction des phrases, ce serait oublier qu’Orientaux et Occidentaux établissent l’euphonie grammaticale sur des bases complétement différentes, et confier les destinées de la langue aux caprices des esprits irréfléchis."
                                            },
                                            {
                                                "example_id": "83bb2be7-ec31-4b58-a2a0-11bf225ac7da",
                                                "sense_id": "92e29a2c-db09-387b-bb78-da1e17479782",
                                                "text": "Sensible à la seule euphonie, leur maître les nommait Black et Bianca."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21dfa19d-7fc5-3cd6-9a51-e02aad63301c",
                                        "entry_id": "029fb9c8-a0e0-3a7c-b8a4-068f3628d188",
                                        "glosses": [
                                            "Harmonie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acc7ce2c-ca12-4356-9f7f-86cde8c9087d",
                                                "sense_id": "21dfa19d-7fc5-3cd6-9a51-e02aad63301c",
                                                "text": "Quel plaisir de se retremper dans l’euphonie multisonore des cordes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
