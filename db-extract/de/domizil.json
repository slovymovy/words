                    }
                ],
                "senses": [
                    {
                        "sense_id": "c3fc79b7-5f64-3bc8-889e-693105910d65",
                        "entry_id": "0180ba1c-06c6-370d-806a-edfcc930627a",
                        "glosses": [
                            "Wohnsitz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67b96925-77af-42ea-9c19-f8561e6b34d3",
                                "sense_id": "c3fc79b7-5f64-3bc8-889e-693105910d65",
                                "text": "Sein Domizil liegt am Meer."
                            },
                            {
                                "example_id": "0a39915f-8602-48c8-b9b6-e937388522ba",
                                "sense_id": "c3fc79b7-5f64-3bc8-889e-693105910d65",
                                "text": "„Auf der Suche nach meinem neuen Domizil begann ich, in die nähere Umgebung Jerichos zu fahren und dort, unter den einzelnen in die Landschaft gestreuten Häusern, Ausschau zu halten.“"
                            },
                            {
                                "example_id": "7fbfffc0-4255-496c-83cf-6ee267e5d77a",
                                "sense_id": "c3fc79b7-5f64-3bc8-889e-693105910d65",
                                "text": "„Wir erreichten unser neues Domizil bei Nacht.“"
                            },
                            {
                                "example_id": "05a645dd-e19a-4013-9b30-61a14f9b1e73",
                                "sense_id": "c3fc79b7-5f64-3bc8-889e-693105910d65",
                                "text": "„Vielleicht benutzte sie dieses Domizil für Begegnungen solcher Art.“"
                            },
                            {
                                "example_id": "9c1b3cef-dd5b-444f-907c-171a62358092",
                                "sense_id": "c3fc79b7-5f64-3bc8-889e-693105910d65",
                                "text": "„Serana bewohnte die beiden großen Hinterzimmer eines vormals großherrschaftlichen Domizils, in dessen zwei kleinen Vorderräumen Frau Michelsen logierte, eine jugendliche Witwe, die ihren Unterhalt mit Schneidern verdiente.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9ec48f97-a8c7-3229-9f2a-82b53d29d73a",
                        "entry_id": "0180ba1c-06c6-370d-806a-edfcc930627a",
