                ],
                "translations": [
                    {
                        "translation_id": "08f8409a-71b9-4e1c-9c92-dcb00505cf83",
                        "source_entry_id": "39c26bb2-1dec-3f25-89b2-edcd60c4afa2",
                        "source_sense_id": "7aa75996-078e-3f64-bd87-7b411346b358",
                        "target_lang_word": "little angel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "31142e55-b942-44f2-a728-9cf2ed7e8643",
                        "source_entry_id": "39c26bb2-1dec-3f25-89b2-edcd60c4afa2",
                        "source_sense_id": "7aa75996-078e-3f64-bd87-7b411346b358",
                        "target_lang_word": "Engelchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Engelchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56be3bd0-a99d-3a9e-a65c-2eee56fe9779",
                                        "entry_id": "402b6ab5-4f87-3d6e-854a-03c711098340",
                                        "glosses": [
                                            "kleiner Engel"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1872c26-c2bb-434b-88e9-463b63b826b3",
                                                "sense_id": "56be3bd0-a99d-3a9e-a65c-2eee56fe9779",
                                                "text": "Keine Engelchen sind stupsnäsiger als die seinen, keine Madonnen lächeln so gottesmutterheilig zugleich, und die griechische Philosophie wird für uns immer wie die Schule von Athen aussehen."
                                            },
                                            {
                                                "example_id": "abe8b149-ebcb-43b5-9037-707420af6dcf",
                                                "sense_id": "56be3bd0-a99d-3a9e-a65c-2eee56fe9779",
                                                "text": "Trotzdem leben gipserne Engelchen und Marien noch in allen Souvenirbuden der Christenheit weiter, aber der Stil frommer Bilder ist in den letzten Jahrzehnten gründlich von sentimentalem Tand befreit."
                                            },
                                            {
                                                "example_id": "d63f1605-a4f5-4b79-925b-17f3d2150929",
                                                "sense_id": "56be3bd0-a99d-3a9e-a65c-2eee56fe9779",
                                                "text": "Miry ist ein kleines, süßes Engelchen mit strahlenden, rehbraunen Augen, Löckchen so hell wie das Tageslicht im Sommer und mit einem ansteckenden, kristallinen Lachen."
                                            },
                                            {
                                                "example_id": "59d6c28d-133e-4a58-8c4c-a66d506b3b16",
                                                "sense_id": "56be3bd0-a99d-3a9e-a65c-2eee56fe9779",
                                                "text": "Doch auch der heilige Petrus konnte das verschwundene Engelchen nicht finden."
                                            },
                                            {
                                                "example_id": "281bcad6-2612-4fa6-8f8c-f01e920a880a",
                                                "sense_id": "56be3bd0-a99d-3a9e-a65c-2eee56fe9779",
                                                "text": "Geena Davis kam als Engelchen mit Federbesatz zur Premiere."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
