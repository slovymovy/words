                    },
                    {
                        "translation_id": "d232e536-7eb5-4fd6-8ac1-702a02061331",
                        "source_entry_id": "5752bd04-ccff-3333-a9ff-d346fd1228ba",
                        "source_sense_description": "исследование",
                        "target_lang_word": "diagnostic",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diagnostic",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8085dc8b-07ef-384a-b1b3-b4d2aad3613b",
                                        "entry_id": "ed7ec72d-bf19-34bb-925c-06bb75cc5d0e",
                                        "glosses": [
                                            "Partie de la médecine qui a pour objet la distinction des maladies, l'identification d’une maladie à partir de symptômes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "980ccd76-27bc-4f1b-8449-681cbe66b472",
                                                "sense_id": "8085dc8b-07ef-384a-b1b3-b4d2aad3613b",
                                                "text": "Il rappelle aux gens qui ne se sentent pas interpellés par la gravité de la situation que «tous les diagnostics seront touchés», que ce soit des «traumas, des arrêts cardiaques, ou une défaillance d’organe»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f189986-1d1a-3013-82d2-069046da859e",
                                        "entry_id": "ed7ec72d-bf19-34bb-925c-06bb75cc5d0e",
                                        "glosses": [
                                            "Conclusion de cette identification : avis médical sur la nature de la maladie à l’origine des symptômes observés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9427e9f-5e5f-4a1d-a532-26fbf54c2f2e",
                                                "sense_id": "3f189986-1d1a-3013-82d2-069046da859e",
                                                "text": "À la fin d'août 1897, 4 jours après des rapports avec une femme suspecte, il se forma chez le malade deux petites ulcérations dans le sillon rétroglandulaire qui selon le diagnostic du médecin local, présentait toutes les propriétés des chancres mous ; […]."
                                            },
                                            {
                                                "example_id": "6712c16d-8d69-4274-a6b6-9b72589d5819",
                                                "sense_id": "3f189986-1d1a-3013-82d2-069046da859e",
                                                "text": "Le diagnostic d’otacariose est confirmé par la mise en évidence d’otodectes dans le cérumen grâce aux examens otoscopique et microscopique."
                                            },
                                            {
                                                "example_id": "fd06d5cc-5d12-482f-984d-9001458181ec",
                                                "sense_id": "3f189986-1d1a-3013-82d2-069046da859e",
                                                "text": "L’échographie cardiaque transthoracique (présence de valves remaniées ou/et de végétations) et les hémocultures confirment le diagnostic évoqué par la clinique : streptococcémies, staphylococcémies, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04aab324-9c37-3400-b669-9455a69f1940",
                                        "entry_id": "ed7ec72d-bf19-34bb-925c-06bb75cc5d0e",
                                        "glosses": [
                                            "Conclusion d'une étude technique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ba15cb8-eec8-4165-b5dd-7e919f5ca332",
                                                "sense_id": "04aab324-9c37-3400-b669-9455a69f1940",
                                                "text": "Son diagnostic était que le mal dont souffrait la société islamique contemporaine était la modernité, dans laquelle les lois et la domination de l'homme ont remplacé celles de Dieu."
                                            },
                                            {
                                                "example_id": "ad7948a8-de0e-4597-a9f1-4493feff7d2f",
                                                "sense_id": "04aab324-9c37-3400-b669-9455a69f1940",
                                                "text": "Ce rapport rassemble des éléments de diagnostic portant sur le partage de la valeur ajoutée, le partage des profits et les écarts de rémunérations en France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36a118c3-7052-3cd1-85af-404361b489db",
                                        "entry_id": "ed7ec72d-bf19-34bb-925c-06bb75cc5d0e",
                                        "glosses": [
                                            "Les étapes, le processus, utilisé pour déterminer la cause, l'origine, d'une situation, d'un évènement, d'un problème."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
