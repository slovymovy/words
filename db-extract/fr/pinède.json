                                    {
                                        "sense_id": "58ef2c58-ed47-3737-ad91-f58a7117bf2b",
                                        "entry_id": "cdb96923-7acb-36d4-940a-6548cb767793",
                                        "glosses": [
                                            "An arboretum, or part of an arboretum or garden, devoted to growing conifers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b778fbea-3168-41cd-96a1-fe870bc22d17",
                                                "sense_id": "58ef2c58-ed47-3737-ad91-f58a7117bf2b",
                                                "text": "In the arrangement, of course, I should expect to see every hardy tree which could be collected in any part of the globe; and I even anticipate revelling in quercetums, fraxinetums, salicetums, pinetums, aceretums, &c."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69a6d407-e35a-3cac-a485-7c41498c442c",
                                        "entry_id": "cdb96923-7acb-36d4-940a-6548cb767793",
                                        "glosses": [
                                            "A book that scientifically describes conifers."
                                        ],
