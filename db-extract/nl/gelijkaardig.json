                "senses": [
                    {
                        "sense_id": "97712964-5e8d-31bb-8f0e-5746b12b2c08",
                        "entry_id": "c06a6713-3362-3b87-9711-ac8dfa75a5fe",
                        "glosses": [
                            "vele overeenkomsten vertonend"
                        ],
                        "tags": [
                            "Flanders"
                        ],
                        "examples": [
                            {
                                "example_id": "3f4a01c3-5f69-4b65-99b0-45e0495ddd63",
                                "sense_id": "97712964-5e8d-31bb-8f0e-5746b12b2c08",
                                "text": "Binnen een straal van vijf kilometer werden gelijkaardige verschijnselen opgemerkt."
                            },
                            {
                                "example_id": "b21aa3e7-89a3-4abf-8ad7-fa014d4ecb4b",
                                "sense_id": "97712964-5e8d-31bb-8f0e-5746b12b2c08",
                                "text": "John Kelly is niet de enige voormalige hooggeplaatste medewerker van Trump die gelijkaardige uitspraken doet. Eerder al heeft Mark Milley, de toenmalige stafchef van het Amerikaanse leger, Trump \"een fascist tot in de kern\" genoemd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d15d698-c8bc-4398-a3d3-8ae0bca6f8fe",
                        "source_entry_id": "c06a6713-3362-3b87-9711-ac8dfa75a5fe",
                        "source_sense_id": "97712964-5e8d-31bb-8f0e-5746b12b2c08",
                        "source_sense_description": "vele overeenkomsten vertonend",
                        "target_lang_word": "ähnlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ähnlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "abd5bbc0-945e-3a5b-8721-1fc2e5040920",
                                        "entry_id": "b8eaf1b0-af04-35b8-bf72-57b0ef765a7f",
                                        "glosses": [
                                            "in manchem übereinstimmend, teilweise analog"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e89c700c-8805-42ef-8bba-31c93f42d118",
                                                "sense_id": "abd5bbc0-945e-3a5b-8721-1fc2e5040920",
                                                "text": "Vater und Sohn sind sich sehr ähnlich."
                                            },
                                            {
                                                "example_id": "684d9d85-eda4-4f19-a7d3-60d74a7e23fb",
                                                "sense_id": "abd5bbc0-945e-3a5b-8721-1fc2e5040920",
                                                "text": "Dein Kind sieht dir sehr ähnlich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e8c2d326-2a4c-33b5-8e65-46aee298e95d",
                                        "entry_id": "b8eaf1b0-af04-35b8-bf72-57b0ef765a7f",
                                        "glosses": [
                                            "wie [1] in der Funktion einer Präposition mit dem Dativ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6db5ec1-b007-42b5-bb32-b6fbbb5cc1c3",
                                                "sense_id": "e8c2d326-2a4c-33b5-8e65-46aee298e95d",
                                                "text": "„Die Form ist entweder ein Torus (Ring ähnlich einem Bagel) oder – seltener – ein abgeflachter Ballen, der häufig Schokolade oder eine andere süße Füllung enthält.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e0445e0-4d22-4c8d-8e74-47986b996867",
                        "source_entry_id": "c06a6713-3362-3b87-9711-ac8dfa75a5fe",
                        "source_sense_id": "97712964-5e8d-31bb-8f0e-5746b12b2c08",
                        "source_sense_description": "vele overeenkomsten vertonend",
                        "target_lang_word": "similar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "similar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e74a715-61df-3492-91fc-38a1a4155ce4",
                                        "entry_id": "055e83e7-861e-3594-ba65-5810cbdbb41f",
                                        "glosses": [
                                            "Having traits or characteristics in common; alike, allied, comparable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e78f6c17-26db-48e4-a362-c7c3cff8d48b",
                                                "sense_id": "3e74a715-61df-3492-91fc-38a1a4155ce4",
                                                "text": "My new car is quite similar to my old one, except it has a bit more space in the back."
                                            },
                                            {
                                                "example_id": "9a02467b-da94-488b-8b71-639efc782c4a",
                                                "sense_id": "3e74a715-61df-3492-91fc-38a1a4155ce4",
                                                "text": "So this was my future home, I thought! Certainly it made a brave picture. I had seen similar ones fired-in on many a Heidelberg stein. Backed by towering hills,[…]a sky of palest Gobelin flecked with fat, fleecy little clouds, it in truth looked a dear little city; the city of one's dreams."
                                            },
                                            {
                                                "example_id": "4adb58f7-a47a-4b33-bef3-a8d26aedf8f9",
                                                "sense_id": "3e74a715-61df-3492-91fc-38a1a4155ce4",
                                                "text": "Similar studies of rats have employed four different intracranial resorbable, slow sustained release systems—surgical foam, a thermal gel depot, a microcapsule or biodegradable polymer beads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52970ca7-a704-35b4-9865-26dfd8cec10c",
                                        "entry_id": "055e83e7-861e-3594-ba65-5810cbdbb41f",
                                        "glosses": [
                                            "Having the same shape, in particular, having corresponding angles equal and corresponding line segments proportional."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88345891-8709-3cbd-bf0f-6dbc1ecd1d19",
                                        "entry_id": "055e83e7-861e-3594-ba65-5810cbdbb41f",
                                        "glosses": [
                                            "Of two square matrices; being such that a conjugation sends one matrix to the other."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "similar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29f9018c-be9b-3268-a753-5ef338e3f573",
                                        "entry_id": "a9ea351f-3986-3ae0-8a50-b7470797427a",
