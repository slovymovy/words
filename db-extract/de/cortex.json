                                                "text": "Le cortex cérébral."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaf18331-0768-3655-932f-0e4570fa6db2",
                                        "entry_id": "fab48757-b8ab-3546-bffc-32de26ff49aa",
                                        "glosses": [
                                            "Cortex cérébral."
