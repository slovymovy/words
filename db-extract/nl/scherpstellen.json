        "nl-extract.jsonl": [
            {
                "entry_id": "7311a84f-74ca-3ea4-a692-370aeea731d8",
                "word": "scherpstellen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b17eee4d-c206-3622-b467-7c87ec581029",
                        "entry_id": "7311a84f-74ca-3ea4-a692-370aeea731d8",
                        "glosses": [
                            "zo instellen dat dat een scherp beeld ontstaat."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f13a0b78-b695-45ff-bcd1-ad75d0ef815b",
                                "sense_id": "b17eee4d-c206-3622-b467-7c87ec581029",
                                "text": "Eerst kon hij zijn blik nergens op scherpstellen en zag hij niets."
                            },
                            {
                                "example_id": "9b34fb05-c73d-4c4b-bf40-92dd7703fb0a",
                                "sense_id": "b17eee4d-c206-3622-b467-7c87ec581029",
                                "text": "Bij het scherpstellen zag Fossey een ster in Messier 82 die hij zich niet kon herinneren van eerdere observaties. Een vergelijking met recente afbeeldingen van het sterrenstelsel bevestigde zijn voorgevoel: ze hadden een nieuwe ster ontdekt."
                            },
                            {
                                "example_id": "27caba90-0641-42ca-8127-01ce323887fc",
                                "sense_id": "b17eee4d-c206-3622-b467-7c87ec581029",
                                "text": "In 1993 kreeg de telescoop een soort \"bril\" aangemeten door astronauten, waardoor scherpstellen weer mogelijk werd. Sindsdien maakte het apparaat duizenden foto's van het universum."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31e46e21-06ca-432f-aa81-64de75bd327b",
                        "source_entry_id": "7311a84f-74ca-3ea4-a692-370aeea731d8",
                        "source_sense_id": "b17eee4d-c206-3622-b467-7c87ec581029",
