                        "target_lang_word": "Bräutigam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bräutigam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d87bff4-6376-3cac-8fe4-760a4a22bef5",
                                        "entry_id": "94872872-03cb-358d-98d7-96cf619c9f04",
                                        "glosses": [
                                            "zukünftiger männlicher Ehepartner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e40c355-95ab-4fd2-8243-44bf25be07e4",
                                                "sense_id": "4d87bff4-6376-3cac-8fe4-760a4a22bef5",
                                                "text": "Der Bräutigam feiert heute seinen Junggesellenabschied."
                                            },
                                            {
                                                "example_id": "255d5ba7-4473-410e-80bc-d484f0e1bbed",
                                                "sense_id": "4d87bff4-6376-3cac-8fe4-760a4a22bef5",
                                                "text": "„Während er bei der Marine diente, verließen die Frauen der Nachbarschaft das Haus, um ihn in seiner weißen Marineuniform mit den Offiziersabzeichen zu bewundern und sich einen solchen Bräutigam für ihre Töchter zu wünschen.“"
                                            },
                                            {
                                                "example_id": "6f6961fd-31e1-4ad3-88dc-ae692f50e4d9",
                                                "sense_id": "4d87bff4-6376-3cac-8fe4-760a4a22bef5",
                                                "text": "„Von diesem Tage an verkehrte Andrej als Bräutigam im Rostowschen Hause.“"
                                            },
                                            {
                                                "example_id": "4d91d52e-ad77-4842-ae1f-c41617b6cc7a",
                                                "sense_id": "4d87bff4-6376-3cac-8fe4-760a4a22bef5",
                                                "text": "„Angelicas Bräutigam zog aus seiner Tasche ein Sonett, eine Frucht seines Genies, das er zu meinem Preis und Ruhm gedichtet hatte, und wollte es vorlesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b90d94a7-9397-4bb2-b700-968bbf66d290",
