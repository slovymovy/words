        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b64211f6-29b6-3790-85d5-5406ab55a2b0",
                "word": "recallable",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f8bcea65-e8a9-36d3-b207-e0758f10921c",
                        "entry_id": "b64211f6-29b6-3790-85d5-5406ab55a2b0",
                        "glosses": [
                            "Capable of being recalled (retrieved from one's memory)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2e7d2ddc-493b-4a94-8ccb-003446eb0f80",
                                "sense_id": "f8bcea65-e8a9-36d3-b207-e0758f10921c",
                                "text": "The number of recallable words from the list was much smaller after 24 hours."
                            },
                            {
                                "example_id": "d8defdd0-dae1-454d-aef1-11c1c8041973",
                                "sense_id": "f8bcea65-e8a9-36d3-b207-e0758f10921c",
                                "text": "Her first recallable recollection was of an old deserted chateau-like house in a strange, French-like country, which she dimly imagined to be somewhere beyond the sea."
                            }
                        ]
                    },
                    {
                        "sense_id": "404a2756-5e46-3260-8baf-95acc2642ef8",
                        "entry_id": "b64211f6-29b6-3790-85d5-5406ab55a2b0",
                        "glosses": [
                            "Capable of being recalled (brought back from service etc.)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db7e7651-d945-41b7-acb1-ae38693b808b",
                        "source_entry_id": "b64211f6-29b6-3790-85d5-5406ab55a2b0",
                        "source_sense_description": "Capable of being retrieved from one's memory",
                        "target_lang_word": "rappelable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rappelable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b9e2752-c720-38d7-bc8c-f2312b6f8e2e",
                                        "entry_id": "feba5947-de7d-34ef-aa24-905b1e25d2a4",
                                        "glosses": [
                                            "Qui peut être rappelé, à quoi on peut de nouveau faire appel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "542decbf-d6c5-460d-90c1-37d566957db5",
                                                "sense_id": "8b9e2752-c720-38d7-bc8c-f2312b6f8e2e",
                                                "text": "Ces deux causes de réserve obligée, billet remboursable à vue et dépôt promptement rappelable, n'existent pas dans les banques allemandes : la première point du tout, la seconde dans une très-faible mesure seulement."
                                            },
                                            {
                                                "example_id": "63b96065-5bcf-4321-95fa-f9e10bd874f5",
                                                "sense_id": "8b9e2752-c720-38d7-bc8c-f2312b6f8e2e",
                                                "text": "[..] dans presque toutes les banques, dans celles surtout qui bonifient un intérêt aux déposants, une certaine partie seulement des fonds est immédiatement rappelable ; pour les sommes supérieures, il faut un avis préalable, dont le délai varie suivant l’importance du retrait ; …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ffaba01-027c-3514-9c30-8b6e78cb1ea1",
                                        "entry_id": "feba5947-de7d-34ef-aa24-905b1e25d2a4",
                                        "glosses": [
                                            "Que l’on peut rappeler à servir."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ff51b1d-6dbb-4044-a752-d9dbd35f2261",
                                                "sense_id": "6ffaba01-027c-3514-9c30-8b6e78cb1ea1",
                                                "text": "La Défense a du personnel en réserve, maintenu à domicile, rappelable en cas d’urgence."
                                            },
                                            {
                                                "example_id": "bbb8aa30-b8f1-4ac1-87f2-e7b10a47ff98",
                                                "sense_id": "6ffaba01-027c-3514-9c30-8b6e78cb1ea1",
                                                "text": "… \"nous travaillons en mode dégradé eu égard aux gardes d’enfants, aux personnels en maladie ou en réserve opérationnelle, explique la commissaire. La réserve opérationnelle de fonctionnaires appelés à rester chez eux durant une période permet de préserver les policiers de l'épidémie et de conserver une force rappelable en cas de besoin\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff9d7643-0dc2-324e-8977-b3368d955b6a",
                                        "entry_id": "feba5947-de7d-34ef-aa24-905b1e25d2a4",
                                        "glosses": [
                                            "Que l’on peut rappeler à la mémoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deda1994-e834-48b0-ba60-17b60881df6b",
                                                "sense_id": "ff9d7643-0dc2-324e-8977-b3368d955b6a",
                                                "text": "Certaines de ces traces, rappelables directement à la conscience, sous-tendent la mémoire et l’apprentissage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
