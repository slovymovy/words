                        "source_sense_id": "7ddf7ca0-bf4f-34d5-a7e5-7566fe0aff5e",
                        "target_lang_word": "Unglück",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unglück",
