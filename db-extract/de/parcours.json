                            {
                                "example_id": "bf7f7b9e-8518-4f5a-9811-4ac22b36f1b5",
                                "sense_id": "b36a3519-17cd-3745-ba13-7414a5e01322",
                                "text": "Damit konnte sie als eine der wenigen diesen schwierigen Parcours ohne Fehler durchreiten."
                            },
                            {
                                "example_id": "4e30feb1-ee8f-483e-976b-157603070bff",
                                "sense_id": "b36a3519-17cd-3745-ba13-7414a5e01322",
