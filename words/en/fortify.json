{
    "word_family": [
        "fortification",
        "fortress",
        "fortitude",
        "fort"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7f665491-3fc2-3f7d-8dc5-a2dca9d929dd",
                    "sense_definition": "To strengthen a place or position against attack, typically by building defensive works such as walls or forts.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "military_defence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army worked through the night to <w>fortify</w> the border post against expected attacks.",
                            "target_lang_translations": {
                                "tr": "Ordu, beklenen saldırılara karşı sınır karakolunu <w>tahkim etmek</w> için gece boyunca çalıştı.",
                                "zh": "军队连夜工作，<w>加固</w>边境哨所，以防备预料中的袭击。"
                            }
                        },
                        {
                            "text": "The soldiers decided to <w>fortify</w> the position before nightfall.",
                            "target_lang_translations": {
                                "tr": "Askerler gece çökmeden önce mevziyi <w>güçlendirmeye</w> karar verdi.",
                                "zh": "士兵们决定在天黑前<w>加固</w>阵地。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fort"
                    ],
                    "common_phrases": [
                        "fortify the position",
                        "fortify the border",
                        "fortify the town"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir yeri veya mevziyi sur veya kale gibi savunma yapıları inşa ederek saldırılara karşı güçlendirmek, tahkim etmek.",
                        "zh": "通过修建城墙、堡垒等防御设施来加强某地或某个位置的防御，使其更能抵御攻击。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tahkim etmek",
                                "target_lang_sense_clarification": "askeri veya fiziksel alanda savunmayı güçlendirmek"
                            },
                            {
                                "target_lang_word": "güçlendirmek",
                                "target_lang_sense_clarification": "savunma açısından sağlamlaştırmak"
                            },
                            {
                                "target_lang_word": "müstahkem kılmak",
                                "target_lang_sense_clarification": "korunaklı hale getirmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加固",
                                "target_lang_sense_clarification": "指加固地点、阵地或边境等防御目标"
                            },
                            {
                                "target_lang_word": "设防",
                                "target_lang_sense_clarification": "指布置或建立防御措施"
                            },
                            {
                                "target_lang_word": "构筑防御工事",
                                "target_lang_sense_clarification": "强调修建工事来增强防御"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d0af87e-15ad-3ba7-8a06-6cc2561fe374",
                    "sense_definition": "To make someone or something stronger physically, mentally, or emotionally.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "strengthen_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A good night's sleep will help <w>fortify</w> yourself for the busy day ahead.",
                            "target_lang_translations": {
                                "tr": "İyi bir gece uykusu, önündeki yoğun güne kendini <w>hazırlamona ve güç toplamana</w> yardımcı olacaktır.",
                                "zh": "睡个好觉能帮助你为接下来忙碌的一天<w>养精蓄锐</w>。"
                            }
                        },
                        {
                            "text": "He took a deep breath to <w>fortify</w> his resolve before giving the speech.",
                            "target_lang_translations": {
                                "tr": "Konuşmayı yapmadan önce kararlılığını <w>pekiştirmek</w> için derin bir nefes aldı.",
                                "zh": "他深吸了一口气，好在演讲前<w>坚定</w>自己的决心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strengthen",
                        "invigorate"
                    ],
                    "antonyms": [
                        "weaken"
                    ],
                    "common_phrases": [
                        "fortify oneself",
                        "fortify resolve"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birini veya bir şeyi fiziksel, zihinsel veya duygusal olarak daha güçlü kılmak, güç toplamasını sağlamak.",
                        "zh": "使某人或某物在身体、精神或情感上变得更强。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "güçlendirmek",
                                "target_lang_sense_clarification": "fiziksel veya ruhsal dayanıklılığı artırmak"
                            },
                            {
                                "target_lang_word": "kuvvetlendirmek",
                                "target_lang_sense_clarification": "bedensel veya zihinsel olarak daha güçlü hale getirmek"
                            },
                            {
                                "target_lang_word": "pekiştirmek",
                                "target_lang_sense_clarification": "kararlılığı veya iradeyi sağlamlaştırmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "增强",
                                "target_lang_sense_clarification": "使人在身体、精神或情绪上更强"
                            },
                            {
                                "target_lang_word": "坚定",
                                "target_lang_sense_clarification": "多用于意志、决心、信念等"
                            },
                            {
                                "target_lang_word": "养精蓄锐",
                                "target_lang_sense_clarification": "为任务或困难做好更充分的身心准备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5c33e6e-d247-34a4-aeea-480f2c1ca4c8",
                    "sense_definition": "To add vitamins, minerals, or other nutrients to food or drink to increase its nutritional value.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "enrichment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many food companies <w>fortify</w> breakfast cereals with extra iron and vitamins.",
                            "target_lang_translations": {
                                "tr": "Birçok gıda şirketi kahvaltılık gevrekleri ekstra demir ve vitaminlerle <w>zenginleştirir</w>.",
                                "zh": "许多食品公司会用额外的铁和维生素来<w>强化</w>早餐麦片。"
                            }
                        },
                        {
                            "text": "It is common practice to <w>fortify</w> milk with vitamin D.",
                            "target_lang_translations": {
                                "tr": "Sütü D vitamini ile <w>takviye etmek</w> yaygın bir uygulamadır.",
                                "zh": "用维生素D<w>强化</w>牛奶是很常见的做法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enrich"
                    ],
                    "common_phrases": [
                        "fortify food",
                        "fortify with vitamins",
                        "fortify with calcium"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yiyecek veya içeceklerin besin değerini artırmak amacıyla içlerine vitamin, mineral veya diğer besin maddelerini eklemek.",
                        "zh": "在食物或饮料中加入维生素、矿物质或其他营养成分，以提高其营养价值。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "zenginleştirmek",
                                "target_lang_sense_clarification": "gıdaları vitamin ve minerallerle takviye etmek"
                            },
                            {
                                "target_lang_word": "takviye etmek",
                                "target_lang_sense_clarification": "besin öğeleri eklemek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "强化",
                                "target_lang_sense_clarification": "食品领域常用，指添加营养成分以提高营养价值"
                            },
                            {
                                "target_lang_word": "添加营养素",
                                "target_lang_sense_clarification": "强调加入维生素、矿物质等营养素"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81bbf41a-7fb9-3002-868b-7034811c5ed0",
                    "sense_definition": "To add alcohol, usually spirits, to wine to increase its strength.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "enrichment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Winemakers often <w>fortify</w> wine with brandy to produce drinks like port or sherry.",
                            "target_lang_translations": {
                                "tr": "Şarap üreticileri, port veya şeri gibi içkiler üretmek için şarabı genellikle konyakla <w>sertleştirirler</w>.",
                                "zh": "酿酒师常常往葡萄酒里加入白兰地来<w>加烈</w>，制成波特酒或雪利酒等饮品。"
                            }
                        },
                        {
                            "text": "They prefer to <w>fortify</w> wine during the fermentation process.",
                            "target_lang_translations": {
                                "tr": "Fermentasyon sürecinde şarabı <w>alkolle takviye etmeyi</w> tercih ediyorlar.",
                                "zh": "他们更喜欢在发酵过程中给葡萄酒<w>加烈</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fortify wine"
                    ],
                    "target_lang_definitions": {
                        "tr": "Şarabın alkol oranını artırmak amacıyla içine genellikle yüksek alkollü distile içki (konyak vb.) eklemek.",
                        "zh": "通常指在葡萄酒中加入烈酒，以提高其酒精度。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "alkolle sertleştirmek",
                                "target_lang_sense_clarification": "şarabın alkol oranını artırmak"
                            },
                            {
                                "target_lang_word": "alkol ekleyerek kuvvetlendirmek",
                                "target_lang_sense_clarification": "yüksek alkollü içki katarak zenginleştirmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加烈",
                                "target_lang_sense_clarification": "葡萄酒术语，指加入烈酒提高酒精度"
                            },
                            {
                                "target_lang_word": "添加烈酒",
                                "target_lang_sense_clarification": "强调向葡萄酒中加入白兰地等蒸馏酒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7a3fe14-4b84-330a-a05e-47d807bd7187",
                    "sense_definition": "To support or strengthen an argument, statement, or belief with evidence or facts.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "strengthen_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She collected statistical data to <w>fortify</w> her argument in the debate.",
                            "target_lang_translations": {
                                "tr": "Münazaradaki argümanını <w>güçlendirmek</w> için istatistiksel veriler topladı.",
                                "zh": "她收集了统计数据来<w>加强</w>自己在辩论中的论点。"
                            }
                        },
                        {
                            "text": "New evidence came to light to <w>fortify</w> their claim.",
                            "target_lang_translations": {
                                "tr": "İddialarını <w>destekleyecek</w> yeni kanıtlar ortaya çıktı.",
                                "zh": "新的证据浮现出来，足以<w>佐证</w>他们的说法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "corroborate",
                        "confirm",
                        "bolster"
                    ],
                    "antonyms": [
                        "undermine"
                    ],
                    "common_phrases": [
                        "fortify an argument",
                        "fortify a claim"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir iddiayı, fikri veya argümanı kanıt ve gerçeklerle desteklemek, güçlendirmek.",
                        "zh": "用证据或事实来支持、加强某个论点、陈述或信念。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "desteklemek",
                                "target_lang_sense_clarification": "argümanı kanıtlarla sağlamlaştırmak"
                            },
                            {
                                "target_lang_word": "güçlendirmek",
                                "target_lang_sense_clarification": "görüş veya iddiaya geçerlilik kazandırmak"
                            },
                            {
                                "target_lang_word": "pekiştirmek",
                                "target_lang_sense_clarification": "düşünce veya inancı sağlam kılmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "佐证",
                                "target_lang_sense_clarification": "用证据或事实支持某个说法或主张"
                            },
                            {
                                "target_lang_word": "加强",
                                "target_lang_sense_clarification": "使论点、说法或信念更有力"
                            },
                            {
                                "target_lang_word": "巩固",
                                "target_lang_sense_clarification": "强调让观点更稳固、更有说服力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67d54d1a-3594-3a17-812d-961f15baaa46",
                    "sense_definition": "To construct defensive structures or set up defenses.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military_defence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army chose to <w>fortify</w> along the river before advancing further.",
                            "target_lang_translations": {
                                "tr": "Ordu daha fazla ilerlemeden önce nehir boyunca <w>tahkimat yapmayı</w> seçti.",
                                "zh": "军队选择在继续推进之前沿河<w>设防</w>。"
                            }
                        },
                        {
                            "text": "They decided to <w>fortify</w> against potential attacks.",
                            "target_lang_translations": {
                                "tr": "Olası saldırılara karşı <w>savunma önlemleri almaya</w> karar verdiler.",
                                "zh": "他们决定针对可能的袭击<w>设防</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fortify against"
                    ],
                    "target_lang_definitions": {
                        "tr": "Savunma yapıları inşa etmek veya savunma önlemleri almak.",
                        "zh": "修建防御设施或部署防御措施。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tahkimat yapmak",
                                "target_lang_sense_clarification": "savunma mevzileri hazırlamak"
                            },
                            {
                                "target_lang_word": "savunma hattı kurmak",
                                "target_lang_sense_clarification": "korunma önlemleri oluşturmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "设防",
                                "target_lang_sense_clarification": "建立或布置防御措施"
                            },
                            {
                                "target_lang_word": "构筑防御工事",
                                "target_lang_sense_clarification": "强调修建防御设施或阵地"
                            },
                            {
                                "target_lang_word": "布防",
                                "target_lang_sense_clarification": "军事语境下布置防线或防御力量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84b020f3-3d76-37a5-88d3-e98cc7f533e1",
                    "sense_definition": "To become stronger or increase in force.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "strengthen_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Over time, the root systems of the plants <w>fortify</w> and spread through the soil.",
                            "target_lang_translations": {
                                "tr": "Zamanla bitkilerin kök sistemleri <w>güçlenir</w> ve toprağa yayılır.",
                                "zh": "随着时间推移，植物的根系会逐渐<w>强壮起来</w>，并向土壤中蔓延。"
                            }
                        },
                        {
                            "text": "As their bond grew, their shared trust began to <w>fortify</w> rapidly.",
                            "target_lang_translations": {
                                "tr": "Aralarındaki bağ büyüdükçe, karşılıklı güvenleri hızla <w>sağlamlaşmaya</w> başladı.",
                                "zh": "随着他们之间的纽带加深，他们共有的信任也开始迅速<w>稳固起来</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strengthen"
                    ],
                    "antonyms": [
                        "weaken"
                    ],
                    "target_lang_definitions": {
                        "tr": "Zamanla daha güçlü hale gelmek veya etkisi artmak.",
                        "zh": "变得更强，或力量、作用随时间而增强。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "güçlenmek",
                                "target_lang_sense_clarification": "kendiliğinden daha kuvvetli hale gelmek"
                            },
                            {
                                "target_lang_word": "sağlamlaşmak",
                                "target_lang_sense_clarification": "bağların veya yapıların kuvvet kazanması"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "增强",
                                "target_lang_sense_clarification": "逐渐变得更强、更有力"
                            },
                            {
                                "target_lang_word": "稳固起来",
                                "target_lang_sense_clarification": "用于关系、结构、力量等逐渐稳定变强"
                            },
                            {
                                "target_lang_word": "强壮起来",
                                "target_lang_sense_clarification": "用于生物体、根系等逐渐变强"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}