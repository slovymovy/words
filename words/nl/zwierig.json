                    "sense_id": "25f81f12-b863-3d90-ba63-e9204021189b",
                    "sense_definition": "Elegant, sierlijk en met een vlotte, soepele beweging of stijl.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "elegantie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij maakte een <w>zwierige</w> beweging met haar hand om iedereen te begroeten.",
                            "target_lang_translations": {
                                "en": "She made a <w>graceful</w> gesture with her hand to greet everyone.",
                                "ru": "Она сделала <w>грациозный</w> жест рукой, приветствуя всех."
                            }
                        },
                        {
                            "text": "De danseres droeg een <w>zwierige</w> jurk die prachtig meeboog tijdens de wals.",
                            "target_lang_translations": {
                                "en": "The dancer wore a <w>flowing</w> dress that swayed beautifully during the waltz.",
                                "ru": "На танцовщице было <w>летящее</w> платье, красиво развевавшееся во время вальса."
                            }
                        }
