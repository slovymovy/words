                "senses": [
                    {
                        "sense_id": "d67c0204-81ce-3824-ae38-495acd4ab999",
                        "entry_id": "7c303e0f-ebf5-3e1c-93ad-401df80e4332",
                        "glosses": [
                            "Verbleib in einer Klinik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cfefd5b-55e1-43cd-ba88-9d2530d9e15f",
                                "sense_id": "d67c0204-81ce-3824-ae38-495acd4ab999",
                                "text": "„Bereits nach ihrem ersten Kollaps und kurzem Klinikaufenthalt in Berlin sei sie hergekommen; Meixner sei eine Koryphäe auf dem Feld psychosomatisch bedingter Krankheiten.“"
                            },
                            {
                                "example_id": "4eb0028d-2d0c-4e9a-92a1-f2feb1b388d0",
                                "sense_id": "d67c0204-81ce-3824-ae38-495acd4ab999",
                                "text": "„So hat er bei unzähligen Klinikaufenthalten auch immer seine beiden Schwestern angegeben, niemals Ehefrau und Kinder, das ist aktenkundig.“"
                            },
                            {
                                "example_id": "189c9263-b923-4f17-819d-a5516d954122",
                                "sense_id": "d67c0204-81ce-3824-ae38-495acd4ab999",
                                "text": "„Als er diese Zeilen schreibt, liegt bereits ein weiterer Herzanfall hinter ihm, der ihn Anfang 1965 bei einem Besuch in Mailand getroffen und einen vierwöchigen Klinikaufenthalt nach sich gezogen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
