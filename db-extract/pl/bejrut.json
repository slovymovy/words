                                "target_senses": [
                                    {
                                        "sense_id": "99e7eafe-7790-36f6-bf14-9c26a7ac1587",
                                        "entry_id": "b11e7eb4-e8d4-3434-b9f3-1b25f9a5e728",
                                        "glosses": [
                                            "Ville et capitale du Liban."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bb412af-b50b-42c0-855f-eeb7d2e19e82",
                                                "sense_id": "99e7eafe-7790-36f6-bf14-9c26a7ac1587",
                                                "text": "Il avait notamment une vénération pour Marcel Cerdan auquel il s'était identifié. Ce dernier avait été élevé à Casablanca, lui à Beyrouth, tous deux étaient poids welters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9147d717-bf2b-3579-9853-ee85b268a7c6",
                                        "entry_id": "b11e7eb4-e8d4-3434-b9f3-1b25f9a5e728",
                                        "glosses": [
                                            "Le gouvernement libanais."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "891dfce6-1e28-3e80-985b-bbff9bbc8b86",
                                        "entry_id": "b11e7eb4-e8d4-3434-b9f3-1b25f9a5e728",
                                        "glosses": [
                                            "Le chaos."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "note": "Généralement urbain, en référence à la guerre du Liban (1975-1990). Son utilisation est jugée méprisante et anachronique par les Libanais",
                                        "examples": [
                                            {
                                                "example_id": "f147a403-6ada-4d15-8eae-6e94afd810b7",
                                                "sense_id": "891dfce6-1e28-3e80-985b-bbff9bbc8b86",
                                                "text": "Arrivé sur ce rondpoint en contrebas du périphérique, face au stade Charléty, « c’est Beyrouth », selon un policier. Des véhicules incendiés fument encore, d’autres sont abandonnés au milieu de la chaussée. Des douilles jonchent le sol."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2118de4-2b6f-4f69-91e5-ce5012767717",
                        "source_entry_id": "4e6dd96e-f322-30f1-8655-869f630d044f",
