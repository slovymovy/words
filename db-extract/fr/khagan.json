                        "sense_id": "964b8aac-01d1-3e61-b3d9-f8908da5d483",
                        "entry_id": "4ef454ba-e246-307e-a9ce-2d8a52a02d11",
                        "glosses": [
                            "Empereur turc ou mongol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4193c610-ddfd-47b5-8790-dfed6a344908",
                                "sense_id": "964b8aac-01d1-3e61-b3d9-f8908da5d483",
                                "text": "Le khagan employa toutes ses forces pour réduire les Ogor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "408a0f75-c5ef-4104-be8a-c35ebe8c29ba",
                        "source_entry_id": "4ef454ba-e246-307e-a9ce-2d8a52a02d11",
                        "source_sense_id": "964b8aac-01d1-3e61-b3d9-f8908da5d483",
                        "target_lang_word": "Khagan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Khagan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd791d48-8bec-3f84-8483-0a83d0bf2e30",
                                        "entry_id": "ddec7891-77f1-3e86-8bf4-19556758c808",
                                        "glosses": [
                                            "sehr hoher Titel für Herrscher in manchen Völkern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9251acb-5ee4-452e-b952-9b9f2007f8e6",
                                                "sense_id": "bd791d48-8bec-3f84-8483-0a83d0bf2e30",
                                                "text": "„Er stieß weit nach Osten vor, plünderte und zerstörte seinerseits den Ring, nahm die Unterwerfung des Khagans entgegen und trieb die Scharen der Awaren, die sich nicht beugen wollten, zur Flucht über die Theiß nach Osten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed6c68d3-7c1b-4d90-bd33-d27646d4d42c",
                        "source_entry_id": "4ef454ba-e246-307e-a9ce-2d8a52a02d11",
                        "source_sense_id": "964b8aac-01d1-3e61-b3d9-f8908da5d483",
                        "target_lang_word": "khagan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "khagan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb442cb1-785f-37be-ae50-77983f52f792",
                                        "entry_id": "182ac4b1-938c-3900-8351-40ac17305a34",
                                        "glosses": [
                                            "A khan of khans, a ruler of a khaganate; (the holder of) an imperial rank used among certain Turkic and Mongolian peoples, equal in status to an emperor."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aded96de-2f2c-4de0-b901-a421310afe40",
                                                "sense_id": "cb442cb1-785f-37be-ae50-77983f52f792",
                                                "text": "As early as the year 740 A.D., one of the Khazar kaghans had turned to Constantinople for a missionary versed in Christian law."
                                            },
                                            {
                                                "example_id": "d21ffee8-b605-4319-ace6-b32be1d5af22",
                                                "sense_id": "cb442cb1-785f-37be-ae50-77983f52f792",
                                                "text": "\"A kagan is the father, the mother and the lover of all his people. Nobody would lift a hand against him,\" said Hanukkah."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0156b3a-2603-46d5-ad65-016daa83f5e2",
                        "source_entry_id": "4ef454ba-e246-307e-a9ce-2d8a52a02d11",
                        "source_sense_id": "964b8aac-01d1-3e61-b3d9-f8908da5d483",
