            {
                "entry_id": "eecd219a-275e-3ab7-822b-95bd248e02b7",
                "word": "whoreson",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "03e1051a-4ffb-45ed-a298-7378444e622e",
                        "entry_id": "eecd219a-275e-3ab7-822b-95bd248e02b7",
                        "tags": [
                            "plural"
                        ],
                        "form": "whoresons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b0aa03d-7584-322f-983a-8a45e4af308a",
                        "entry_id": "eecd219a-275e-3ab7-822b-95bd248e02b7",
                        "glosses": [
                            "An illegitimate or misbegotten child born of unwed parents."
                        ],
                        "tags": [
                            "archaic",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "b12b5cdb-9ada-477b-ba2d-b224bff85c06",
                                "sense_id": "5b0aa03d-7584-322f-983a-8a45e4af308a",
                                "text": "Ah, you whoreſon loggerhead, you were borne to do me ſhame."
                            },
                            {
                                "example_id": "7015e7bc-f403-4acf-8d22-b5a6654f97f8",
                                "sense_id": "5b0aa03d-7584-322f-983a-8a45e4af308a",
                                "text": "Though this knave came something saucily to the world before he was sent for, yet was his mother fair, there was good sport at his making, and the whoreson must be acknowledged."
                            }
                        ]
                    },
                    {
                        "sense_id": "65c093a5-cec3-3541-8458-70fe0e3da962",
                        "entry_id": "eecd219a-275e-3ab7-822b-95bd248e02b7",
                        "glosses": [
                            "The son of a whore."
                        ],
                        "tags": [
                            "derogatory",
                            "literally",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "47b71e2b-7cb4-416d-bd4a-cea625b57fb2",
                                "sense_id": "65c093a5-cec3-3541-8458-70fe0e3da962",
                                "text": "Ploughing whoreson!"
                            },
                            {
                                "example_id": "ae163242-c8cd-4f4e-8377-a97e41a1eda8",
                                "sense_id": "65c093a5-cec3-3541-8458-70fe0e3da962",
                                "text": "Thou whoreson zed! Thou unnecessary letter!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d79cec2-84df-4994-9e54-67c0787ce562",
                        "source_entry_id": "eecd219a-275e-3ab7-822b-95bd248e02b7",
                        "source_sense_description": "illegitimate child",
                        "target_lang_word": "Hurensohn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hurensohn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b31e4b5b-78aa-35cb-872b-5b7c32defd6e",
                                        "entry_id": "bb6b8a7f-19c8-3120-8e06-9e3982301ca5",
                                        "glosses": [
                                            "männlicher Nachkomme einer Prostituierten; uneheliches Kind"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "impolite"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4be3924b-9a85-4d5c-acb5-bd9d248d4e8d",
                                                "sense_id": "b31e4b5b-78aa-35cb-872b-5b7c32defd6e",
                                                "text": "„Die Einstellung der USA lautete damals: ‚Er ist ein Hurensohn. Aber er ist unser Hurensohn!’“ (Ex-US-Präsident Franklin D. Roosevelt über Nicaraguas Diktator Somoza)"
                                            },
                                            {
                                                "example_id": "68473584-0428-4f68-bacc-afbac22633f6",
                                                "sense_id": "b31e4b5b-78aa-35cb-872b-5b7c32defd6e",
                                                "text": "„Lasst mich los, ihr sollt mich loslassen, ihr Hurensöhne!“"
                                            },
                                            {
                                                "example_id": "2ecd5b64-7fa4-420c-ac34-461262ab26a6",
                                                "sense_id": "b31e4b5b-78aa-35cb-872b-5b7c32defd6e",
                                                "text": "„Der Hurensohn hat mehr Einfluss, als wir gedacht hatten.“"
                                            },
                                            {
                                                "example_id": "0989e09b-508d-4bed-a10a-1fbb2f5e75fd",
                                                "sense_id": "b31e4b5b-78aa-35cb-872b-5b7c32defd6e",
                                                "text": "„Und eines Tages werde ich dem Hurensohn den Gnadenschuss verpassen.“"
                                            },
                                            {
                                                "example_id": "20b94fd2-a5d0-4591-be96-10b87c8823c3",
                                                "sense_id": "b31e4b5b-78aa-35cb-872b-5b7c32defd6e",
                                                "text": "„›Ich habe kein Geld.‹ Das war gelogen, aber Court hatte nicht vor, diesem Hurensohn Bargeld in den Rachen zu werfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0ebc91d-e10a-4ca5-af70-a2bde6cc792f",
                        "source_entry_id": "eecd219a-275e-3ab7-822b-95bd248e02b7",
                        "source_sense_description": "illegitimate child",
                        "target_lang_word": "су́кин сын",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "су́кин сын",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ebd5f822-0eac-3aa3-84ca-2f89edce053b",
                                        "entry_id": "5dd743ca-0589-33a6-b9eb-523b12e19ad2",
                                        "glosses": [
                                            "груб.-прост., бран. дурной человек; негодяй, мерзавец, проходимец (также используется в качестве шутливого выражения восхищения)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5064ce20-344c-4e71-90ac-b40eab841ce7",
                                                "sense_id": "ebd5f822-0eac-3aa3-84ca-2f89edce053b",
                                                "text": "— Чуть тронешь свою бабу, — за хвост тебя, сукиного сына, да в собачий ящик!"
                                            },
                                            {
                                                "example_id": "779cf445-4519-4976-8fe1-28dda0d38f8a",
                                                "sense_id": "ebd5f822-0eac-3aa3-84ca-2f89edce053b",
                                                "text": "— Даёт какой-то сукин сын червонец, я ему сдачи — четыре пятьдесят…"
                                            },
                                            {
                                                "example_id": "fb2c0b6f-2d49-46a0-87b6-1ddaedbf79de",
                                                "sense_id": "ebd5f822-0eac-3aa3-84ca-2f89edce053b",
                                                "text": "[Старик, муж] Встал бы ты у меня в пять утра / да поработал / сукин сын / допоздна / пока солнце не сядет!"
                                            },
                                            {
                                                "example_id": "926cf9ba-7b89-403e-96c1-5b99e30885df",
                                                "sense_id": "ebd5f822-0eac-3aa3-84ca-2f89edce053b",
                                                "text": "— Ну, люблю я тебя, как сукиного сына, честное слово, — говорил Красников в судорогах пьяной любви к ближнему."
                                            },
                                            {
                                                "example_id": "8236706c-18a4-4be0-87a4-87ba74d7b380",
                                                "sense_id": "ebd5f822-0eac-3aa3-84ca-2f89edce053b",
                                                "text": "Хорошо известно также письмо Вяземскому в день окончания; но из него мы помним только это «ай да Пушкин, ай да сукин сын», а надо представить картину во всей её полноте, как это было, пройдя по строчкам письма: «Трагедия моя кончена; я перечёл её в слух, один, и бил в ладоши и кричал, ай-да Пушкин, ай-да сукин сын!»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
