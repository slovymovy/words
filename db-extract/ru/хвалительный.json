                                                "example_id": "8e818145-f238-4faf-a7c4-4ef73615cb2a",
                                                "sense_id": "c22ae10b-4332-35fc-92c0-898776e36eec",
                                                "text": "Discours élogieux."
                                            },
                                            {
                                                "example_id": "ce4c68e1-7aad-4034-9dff-04c70df5e52c",
                                                "sense_id": "c22ae10b-4332-35fc-92c0-898776e36eec",
                                                "text": "Parler de quelqu’un en termes élogieux."
                                            },
