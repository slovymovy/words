                                        "examples": [
                                            {
                                                "example_id": "d420d231-3d11-4561-bcc7-eab204fe56d5",
                                                "sense_id": "09d09fd2-fb8a-3ad3-a39d-28cd08c28c90",
                                                "text": "Lancée le 14 septembre 2001 au Japon, la console GameCube a connu un relatif échec commercial."
                                            },
                                            {
                                                "example_id": "9eed3e04-4148-42b6-a34a-3092eeef3fd1",
                                                "sense_id": "09d09fd2-fb8a-3ad3-a39d-28cd08c28c90",
                                                "text": "La GameCube est une console de salon Nintendo sortie en 2001/2002."
                                            },
                                            {
                                                "example_id": "68176c49-0dc1-43d8-b494-f2b68ff1f24f",
                                                "sense_id": "09d09fd2-fb8a-3ad3-a39d-28cd08c28c90",
                                                "text": "Au Space World 2000, Nintendo dévoile au monde la GameCube, et débute une aventure compliquée."
                                            }
