                "senses": [
                    {
                        "sense_id": "741448d1-66cc-3f86-a7c9-5df050f395c9",
                        "entry_id": "c737ca8c-769f-3101-bc71-ce44ea797ae6",
                        "glosses": [
                            "Gegenstand, der Sprengstoff enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71ad25a8-dbeb-434c-be15-1493080cd338",
                                "sense_id": "741448d1-66cc-3f86-a7c9-5df050f395c9",
                                "text": "„Die Polizei hat einen 24-Jährigen vorläufig festgenommen, der in seiner Wohnung in Tegel illegal Sprengkörper gebastelt hat.“"
                            },
                            {
                                "example_id": "a55bea15-dc91-4abf-a63b-aae1c09789d7",
                                "sense_id": "741448d1-66cc-3f86-a7c9-5df050f395c9",
                                "text": "„Stattdessen wartete der Mechanismus des Sprengkörpers Jahrzehnte, um eine Explosion auszulösen.“"
                            },
                            {
                                "example_id": "ad418413-b0fa-4642-8e32-fae4656a73d9",
                                "sense_id": "741448d1-66cc-3f86-a7c9-5df050f395c9",
                                "text": "„Bei dem neu entdeckten Sprengkörper handelte es sich um eine US-amerikanische 250 Kilo-Fliegerbombe mit Aufschlagzünder, die innerhalb von drei Stunden geborgen und abtransportiert werden konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
