                "translations": [
                    {
                        "translation_id": "b419d040-c58b-4692-8757-0434c7e3cdf2",
                        "source_entry_id": "85932e3b-f62a-342a-a342-82df770c5785",
                        "source_sense_id": "c114f631-f4db-3bef-9737-5a9a865cfbf3",
