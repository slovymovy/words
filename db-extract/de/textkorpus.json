                        ],
                        "form": "das Textkorpus"
                    },
                    {
                        "form_id": "2e1033bc-cde0-4e9d-9280-036d39fcd012",
                        "entry_id": "b2ee7cad-a555-3416-b30c-cf6dfc42e2d6",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Textkorpora"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4794cfb1-dd6b-3e40-977f-b0fa5dfe209b",
                        "entry_id": "b2ee7cad-a555-3416-b30c-cf6dfc42e2d6",
                        "glosses": [
                            "Sammlung von Texten als Gegenstand sprachwissenschaftlicher Analyse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "831d7378-4f54-4aa3-a609-2c5488003ef4",
                                "sense_id": "4794cfb1-dd6b-3e40-977f-b0fa5dfe209b",
                                "text": "Um repräsentative Sprachuntersuchungen durchführen zu können, benötigt man ein Textkorpus."
                            },
                            {
                                "example_id": "24bf0fb2-0b6c-4894-9b8e-47201bd300e1",
                                "sense_id": "4794cfb1-dd6b-3e40-977f-b0fa5dfe209b",
                                "text": "Statt von einem Textkorpus ist in vielen Fällen einfach nur von einem „Korpus“ die Rede."
                            },
                            {
                                "example_id": "1282896f-95af-4ad7-b162-c8dc639e8821",
                                "sense_id": "4794cfb1-dd6b-3e40-977f-b0fa5dfe209b",
                                "text": "„Textkorpora, wie jene zur Südtirolterminologie, die in jahrelanger Kleinarbeit von Forschern der Korpuslinguistik erarbeitet werden, sind in den meisten Fällen jedem online zugänglich.“"
                            },
                            {
                                "example_id": "5abe729f-1534-4141-8524-5acf9898f43f",
                                "sense_id": "4794cfb1-dd6b-3e40-977f-b0fa5dfe209b",
                                "text": "„Neben der Befragung und dem Experiment gibt es aber noch eine dritte Möglichkeit, linguistische Fragestellungen empirisch zu untersuchen: die Arbeit mit einem Textkorpus.“"
                            },
                            {
                                "example_id": "bcb3bcb5-22fa-473b-b670-ea5d1bc7a2a6",
                                "sense_id": "4794cfb1-dd6b-3e40-977f-b0fa5dfe209b",
                                "text": "„Diese Probleme lassen sich einfach dadurch vermeiden, dass Lexikografen sich ihre Beispiele nicht selbst ausdenken, sondern sie aus einem wohlsortierten Textkorpus herausziehen und Autor samt Textstelle möglichst genau nachweisen.“"
                            },
                            {
                                "example_id": "88b2947e-f9e1-49cc-a671-ba21bf9b6ff4",
                                "sense_id": "4794cfb1-dd6b-3e40-977f-b0fa5dfe209b",
                                "text": "„Die Auswahl von Texten und ihre Zusammenstellung in einem Textkorpus ist ebenso wie die theoretische Verankerung des Analysevorhabens ein methodischer Vorgang, der in hohem Maße Einfluß auf die Ergebnisse hat.“"
                            },
                            {
                                "example_id": "451f7fd6-b0f6-41b9-85f5-68396ecdbb72",
                                "sense_id": "4794cfb1-dd6b-3e40-977f-b0fa5dfe209b",
                                "text": "„Zur Beantwortung solcher Fragen werden umfangreiche Textkorpora aus dem Beginn des 20. Jahrhunderts und aus der Zeit des Übergangs zum 21. Jahrhundert ausgewertet.“"
                            },
                            {
                                "example_id": "d4a414f6-5af6-4e02-ae05-a82721447669",
                                "sense_id": "4794cfb1-dd6b-3e40-977f-b0fa5dfe209b",
                                "text": "„Man kann das Modell auch auf Textkorpora anwenden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c252e43c-3b32-4f94-b0b7-07f488b88188",
                        "source_entry_id": "b2ee7cad-a555-3416-b30c-cf6dfc42e2d6",
                        "source_sense_id": "4794cfb1-dd6b-3e40-977f-b0fa5dfe209b",
                        "source_sense_description": "Linguistik: Sammlung von Texten als Gegenstand sprachwissenschaftlicher Analyse",
                        "target_lang_word": "text corpus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9ae8ba78-3e04-445e-9a6d-fe5bdf3ce9a6",
                        "source_entry_id": "b2ee7cad-a555-3416-b30c-cf6dfc42e2d6",
                        "source_sense_id": "4794cfb1-dd6b-3e40-977f-b0fa5dfe209b",
                        "source_sense_description": "Linguistik: Sammlung von Texten als Gegenstand sprachwissenschaftlicher Analyse",
                        "target_lang_word": "corpus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corpus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae14f1e4-9b5c-379a-963d-6b9693bf0d2e",
                                        "entry_id": "02ce7534-e01c-3dbf-bce1-23b34e7ba321",
                                        "glosses": [
                                            "A collection of written or spoken texts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03a38517-d81f-45c8-b360-40895cf6d849",
                                                "sense_id": "ae14f1e4-9b5c-379a-963d-6b9693bf0d2e",
                                                "text": "No one suggests that Browning intended to mean vagina when he wrote “owls and bats, / Cowls and twats,” because the context does not allow for it, nor does the greater context of the Browning corpus."
                                            },
                                            {
                                                "example_id": "85f42877-8557-4a88-87f4-86f43ba36bfc",
                                                "sense_id": "ae14f1e4-9b5c-379a-963d-6b9693bf0d2e",
                                                "text": "A corpus approach is a useful methodology for observing, describing and interpreting the stylistic features of language in literary and non-literary texts."
                                            },
                                            {
                                                "example_id": "92c36f49-2873-43b8-8b2a-0de3576c7634",
                                                "sense_id": "ae14f1e4-9b5c-379a-963d-6b9693bf0d2e",
                                                "text": "Today, computer databases and corpora infinitely increase the ease of this type of research, but the collecting process remains essentially the same."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e459374-f6ab-330f-8418-f2708fb292af",
                                        "entry_id": "02ce7534-e01c-3dbf-bce1-23b34e7ba321",
                                        "glosses": [
                                            "A collection of written or spoken texts.",
                                            "Such a collection in form of an electronic database used for linguistic analyses."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08112034-7e56-4ca5-b012-8adde40a9832",
                                                "sense_id": "0e459374-f6ab-330f-8418-f2708fb292af",
                                                "text": "Text corpora are being used in most current lexicographic projects. Applied linguistic research is another field where text corpora are welcome as an inexhaustible source of empirical information, a polygon for testing various linguistic tools – spell-checkers, OCRs, machine translation systems, NLP systems, etc."
                                            },
                                            {
                                                "example_id": "bebfe87a-7c87-4d9b-ac75-cdde3bc14985",
                                                "sense_id": "0e459374-f6ab-330f-8418-f2708fb292af",
                                                "text": "Comparable corpora are made up of texts in different languages that may be related in various ways, but are not translations of each other. They may have nothing in common at all, or be on the same subject, of the same genre, or from the same chronological period, etc."
                                            },
                                            {
                                                "example_id": "6f721614-23a9-4f33-8c2b-a4120d82167c",
                                                "sense_id": "0e459374-f6ab-330f-8418-f2708fb292af",
                                                "text": "The Lancaster/IBM Spoken English Corpus began in September 1984 as part of a research project into the automatic assignment of intonation […] The original design of the corpus was determined by the need to provide data for research into speech synthesis. As a result, unlike most other corpora currently being used in the computational linguistics field, the SEC exists in several forms. […] However, whatever the original motivation for compiling a corpus, it quickly becomes an object of interest in its own right. New users find it valuable for applications for which it was not designed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c70ef059-2afb-3f09-b02b-62da3aa90e41",
                                        "entry_id": "02ce7534-e01c-3dbf-bce1-23b34e7ba321",
                                        "glosses": [
                                            "A structure of a special character or function in the animal body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d0098ae-da59-430b-a4e1-f485eccde18c",
                                                "sense_id": "c70ef059-2afb-3f09-b02b-62da3aa90e41",
                                                "text": "the corpus of the uterus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b862bf0f-db67-32f6-b26f-460a865a44fc",
                                        "entry_id": "02ce7534-e01c-3dbf-bce1-23b34e7ba321",
                                        "glosses": [
                                            "A collection or body of objects with similar characteristics."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c1517d2-3822-481f-bb70-c12a3b3adae9",
                                                "sense_id": "b862bf0f-db67-32f6-b26f-460a865a44fc",
                                                "text": "About a hundred years ago in Germany, the publishing of corpuses of the ancient Greek coinages was started. […] The significance of those, and some other corpuses is exclusive, because they allowed an enormous amount of numismatic material kept in museum and private collections all over the world, to be studied and systematized."
                                            },
                                            {
                                                "example_id": "2474989b-8ba0-41ee-9caa-229deaae3838",
                                                "sense_id": "b862bf0f-db67-32f6-b26f-460a865a44fc",
                                                "text": "An assessment in 1991 proposed publication of the results of this work in three stages: […] secondly, a corpus of the Roman pottery to present the type series and to discuss the fabrics and forms recovered, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b6d409b-babc-3606-a498-92caf97dbeb3",
                                        "entry_id": "02ce7534-e01c-3dbf-bce1-23b34e7ba321",
                                        "glosses": [
                                            "The body of a man or animal."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34b23da8-e78e-4c07-bb6c-f161712b8172",
                        "source_entry_id": "b2ee7cad-a555-3416-b30c-cf6dfc42e2d6",
                        "source_sense_id": "4794cfb1-dd6b-3e40-977f-b0fa5dfe209b",
                        "source_sense_description": "Linguistik: Sammlung von Texten als Gegenstand sprachwissenschaftlicher Analyse",
                        "target_lang_word": "corpus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corpus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d3f77cc-f70c-366e-9254-f9bcf5f0839d",
                                        "entry_id": "dc8219cb-173b-360f-90f0-23c7da116ae3",
                                        "glosses": [
                                            "Recueil de pièces, de documents concernant une même matière, les mêmes règles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a8cd9e2-992f-41a9-9fa6-b390f601a38e",
                                                "sense_id": "8d3f77cc-f70c-366e-9254-f9bcf5f0839d",
                                                "text": "L’essentiel du corpus sociobiologique analysé par Jacques Ruelland se situe entre 1975 et 1985, même si son ouvrage est paru en 2004, et l’analyse se concentre sur les écrits de la première heure d’Edward Wilson."
                                            },
                                            {
                                                "example_id": "92c4df25-1ccb-4192-b1dd-7683061052b9",
                                                "sense_id": "8d3f77cc-f70c-366e-9254-f9bcf5f0839d",
                                                "text": "Caleb Finch et Stanley Burnstein, historien à la California State University de Los Angeles, ont étudié un corpus d’écrits médicaux anciens d’Hippocrate et de ses disciples."
                                            },
                                            {
                                                "example_id": "a0da3b6a-9b51-4f74-a786-d06cf2543b43",
                                                "sense_id": "8d3f77cc-f70c-366e-9254-f9bcf5f0839d",
                                                "text": "Pour cette raison, nous allons étudier le corpus des croyances celtes, après avoir examiné les indices anciens et les preuves archéologiques de l'existence d'une même religion sur le territoire gaulois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84f0fc19-0d43-3991-8f00-5630e00052de",
                                        "entry_id": "dc8219cb-173b-360f-90f0-23c7da116ae3",
                                        "glosses": [
                                            "Agrégat de textes qui tendent à prendre l’aspect d’un tout cohérent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3cfea8e2-021d-30eb-8c24-68cf2b222b5a",
                                        "entry_id": "dc8219cb-173b-360f-90f0-23c7da116ae3",
                                        "glosses": [
                                            "Ensemble de l’œuvre d’un écrivain ou d’un peintre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f047829b-2ca9-40ec-8a6c-7469cc352120",
                                                "sense_id": "3cfea8e2-021d-30eb-8c24-68cf2b222b5a",
                                                "text": "Peintre très aimé, Velasquez est aussi un peintre rare. Son corpus se limite à 110 tableaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8519abd7-27b1-38d5-8f58-17f0d57855f7",
                                        "entry_id": "dc8219cb-173b-360f-90f0-23c7da116ae3",
                                        "glosses": [
                                            "Exercice matériel du droit."
                                        ],
                                        "tags": [
                                            "Droit de propriété"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5d2dd18-5053-3401-b0a2-d77716887f08",
                                        "entry_id": "dc8219cb-173b-360f-90f0-23c7da116ae3",
                                        "glosses": [
                                            "Ensemble fini d’énoncés constituant le support d’une étude linguistique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4d2ab01-59fe-4600-b285-8cb39eb2fc3b",
                                                "sense_id": "e5d2dd18-5053-3401-b0a2-d77716887f08",
                                                "text": "Le logogramme sumérien pouvant être polysémique, le corpus des signes permet donc d’écrire plusieurs milliers de mots."
                                            },
                                            {
                                                "example_id": "1ae1785c-e2bd-46fd-9dfb-ecd65c12e718",
                                                "sense_id": "e5d2dd18-5053-3401-b0a2-d77716887f08",
                                                "text": "Chercher les occurrences d’un mot dans un corpus. — Constituer un corpus afin d’étudier un fait linguistique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
