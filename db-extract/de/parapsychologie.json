                        ],
                        "form": "der Parapsychologie"
                    },
                    {
                        "form_id": "b3a4fefa-80fa-4885-8c9a-622f0876d536",
                        "entry_id": "65d826c2-6e97-3adb-83e2-be7a96770129",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Parapsychologie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "083522b7-c38c-32d6-8323-92e5979f2c38",
                        "entry_id": "65d826c2-6e97-3adb-83e2-be7a96770129",
                        "glosses": [
                            "Wissenschaft, die versucht, okkulte Vorgänge und übersinnliche Fähigkeiten des Menschen zu erforschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c6c588e-ac5c-4f96-901b-7a120e54914e",
                                "sense_id": "083522b7-c38c-32d6-8323-92e5979f2c38",
                                "text": "„Er verglich den Spott, der die Pioniere der Parapsychologie traf, mit dem Hohngelächter, das in der Geschichte der Wissenschaften immer dann erscholl, wenn ein Ketzer zu neuen Ufern vorzustoßen versuchte.“"
                            },
                            {
                                "example_id": "57d62608-04eb-45b1-877f-c3d146580a17",
                                "sense_id": "083522b7-c38c-32d6-8323-92e5979f2c38",
                                "text": "„In den Jahrzehnten, die mittlerweile vergangen sind, hat die Parapsychologie innerhalb der akademischen Forschung an Boden gewonnen.“"
                            },
                            {
                                "example_id": "b0e6569e-1e2a-4c95-a212-9de11c308614",
                                "sense_id": "083522b7-c38c-32d6-8323-92e5979f2c38",
                                "text": "„An dieser Einstellung lag es, dass die Parapsychologie nicht die Anerkennung fand, die sie verdient hatte, und sie war auch der Grund dafür, dass die Beschäftigung mit den Unterirdischen eher etwas mit Schauerromanen als mit Wissenschaft zu tun hatte.“"
                            },
                            {
                                "example_id": "19b83aaa-e0cb-4f91-b951-ae4c3cf05cd2",
                                "sense_id": "083522b7-c38c-32d6-8323-92e5979f2c38",
                                "text": "„Abgesehen davon, daß Busch als Sammler von Märchen und Sagen auch viele Geistergeschichten kennengelernt hatte, gibt es genügend Anzeichen, daß er sich gelegentlich für solche Phänomene interessierte, die man heute mit entwaffnender Schlichtheit als Parapsychologie bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
