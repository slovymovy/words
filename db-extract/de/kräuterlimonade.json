                ],
                "senses": [
                    {
                        "sense_id": "237ab1d0-3bf7-3e87-9d90-bb538195d091",
                        "entry_id": "bc9278cb-891a-3414-aa24-932caaa1016b",
                        "glosses": [
                            "zuckerhaltiges Erfrischungsgetränk mit Kräutergeschmack"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "940cdb0e-8ec6-4622-82c1-a2d7e0b972b2",
                                "sense_id": "237ab1d0-3bf7-3e87-9d90-bb538195d091",
                                "text": "„Stattdessen waren wir wie Fremde, die Flasche Kräuterlimonade wie ein Abgrund zwischen uns.“"
                            },
                            {
                                "example_id": "19164c30-3754-4791-87e7-de4a72b6fe59",
                                "sense_id": "237ab1d0-3bf7-3e87-9d90-bb538195d091",
                                "text": "„Noch schnell ein paar Fotos mit dem Gipfelkreuz, dann geht es wieder hinab zur Eisenkappler Hütte – dort gibt es dann endlich Brettljause und Kräuterlimonade.“"
                            },
                            {
                                "example_id": "54f2407a-fa68-43c2-b293-61a0ebf9ea29",
                                "sense_id": "237ab1d0-3bf7-3e87-9d90-bb538195d091",
                                "text": "„Ihr ganz großer Zukunfts-Traum ist ein besonderer Kräuter-Imbiss direkt am Geiseltalsee mit einem Angebot von Kräuterlimonade über Kräuterspeisen bis zu Kräuterschnäpsen.“"
                            },
                            {
                                "example_id": "4d3beee0-4fe6-4cfd-906b-b64dd29de6b2",
                                "sense_id": "237ab1d0-3bf7-3e87-9d90-bb538195d091",
                                "text": "„Nur die Kräuterlimonade, die Oma Karin selbst aus Pfefferminze, Salbei, Limonadenkraut, Zitronenmelisse und Waldmeister braut, die ignoriert er standhaft.“"
                            },
                            {
                                "example_id": "f9305ca8-f7b6-45f1-93f5-a567d33a03c9",
                                "sense_id": "237ab1d0-3bf7-3e87-9d90-bb538195d091",
                                "text": "„Hier wird je nach Zusätzen nach Limonaden mit Fruchtsaft, Essenzlimonaden (enthalten Aromen) oder Kräuterlimonaden unterschieden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
