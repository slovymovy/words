                "senses": [
                    {
                        "sense_id": "c3697f37-0778-3c4f-85d4-b6fb54173e66",
                        "entry_id": "e7d800bc-2cae-38b8-894c-5b21b8804601",
                        "glosses": [
                            "Ionisation von Atomen oder Molekülen durch Bestrahlung mit Licht"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "f6aab888-6d3d-4426-b73d-38da123d7c2f",
                                "sense_id": "c3697f37-0778-3c4f-85d4-b6fb54173e66",
                                "text": "„Gegenstand der vorliegenden Arbeit ist die Photoionisation von mehrfach bis hochgeladenen Ionen durch den Einsatz einer Elektronenstrahl-Ionenfalle am Elektronen-Speicherring für Synchrotronstrahlung BESSY II.“"
                            },
                            {
                                "example_id": "a89b88cc-287f-4ad7-81b9-05e0b84cc52a",
                                "sense_id": "c3697f37-0778-3c4f-85d4-b6fb54173e66",
                                "text": "„Die Deutung des Photoeffekts mit Hilfe der Lichtquantenhypothese gelang Einstein 1905. Noch heute spielt die Photoionisation eine bedeutende Rolle […].“"
                            },
                            {
                                "example_id": "0f2655e0-8aee-491a-b6d3-1c85411faf34",
                                "sense_id": "c3697f37-0778-3c4f-85d4-b6fb54173e66",
                                "text": "„Der Prozess der Photoionisation basiert auf dem effektiven Zusammenwirken von UV-Licht und einem Katalysator.“"
                            },
                            {
                                "example_id": "2155c01a-abc4-4293-9140-2f62c910f25f",
                                "sense_id": "c3697f37-0778-3c4f-85d4-b6fb54173e66",
                                "text": "„Wir untersuchen die Struktur, Photochemie, Photoionisation und dissoziative Photoionisation von Kationen im Vakuum-Ultravioletten (VUV) Spektralbereich mittels Synchrotronstrahlung.“"
                            },
                            {
                                "example_id": "c309ccf9-0da3-4bd7-934d-849fcfb492b7",
                                "sense_id": "c3697f37-0778-3c4f-85d4-b6fb54173e66",
                                "text": "„Photoionisation, bezeichnet die Ionisation eines Atoms oder Moleküls durch Absorption elektromagnetischer Strahlung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
