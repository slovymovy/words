                        "glosses": [
                            "Cas grammatical exprimant le bénéficiaire d’une action ou d’une situation. Le français n’a pas de forme spécifique du bénéfactif, et le bénéfactif se forme souvent avec la préposition pour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6dad40c-23b9-4371-a0c4-a6dc2edf3947",
                                "sense_id": "ee098bd3-cc48-3d11-82e4-60833fac1422",
                                "text": "Cependant, le bénéfactif, à l’encontre du datif, a tendance à être remplacé par la préposition pou «pour»."
                            }
                        ]
                    }
