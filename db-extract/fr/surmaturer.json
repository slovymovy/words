                "senses": [
                    {
                        "sense_id": "69af2c03-8d85-3945-a5ac-0a697a258537",
                        "entry_id": "258a67b6-b2b0-3bc8-a576-e86d7b1eb6a6",
                        "glosses": [
                            "Maturer au-delà du degré normal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49e4f4f2-f240-46e2-9127-c104345eaf66",
                                "sense_id": "69af2c03-8d85-3945-a5ac-0a697a258537",
                                "text": "Je ne veux pas des trieurs car ils avaient une SB56 avec les tous premiers trieurs socma, et effectivement, les pétioles passent dans les grilles, quand la vendange commence à surmaturer, elle reste coincée dans les mailles et ça égrapille les grapillons."
                            },
                            {
                                "example_id": "4e790591-a134-4f06-a76b-b1229e98c753",
                                "sense_id": "69af2c03-8d85-3945-a5ac-0a697a258537",
                                "text": "Laisser bien mûrir les coings, mieux vaut trop mûrs que pas assez. Certains laissent même les fruits surmaturer."
                            },
                            {
                                "example_id": "83ea586f-68db-4954-83cd-ba56939b2218",
                                "sense_id": "69af2c03-8d85-3945-a5ac-0a697a258537",
                                "text": "Début août, une seconde période caniculaire est venue « surmaturer » une partie de la récolte."
                            }
                        ]
                    }
