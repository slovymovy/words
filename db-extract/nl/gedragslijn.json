                        "cross_references": [
                            {
                                "target_word": "policy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7043c6d0-c94b-346b-830b-1a0190386455",
                                        "entry_id": "be75b6b9-fe0f-320f-850e-bd53e971e728",
                                        "glosses": [
                                            "A principle of behaviour, conduct which an entity (government, organization, etc.) applies or seeks to follow, especially as formally expressed by an authoritative body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42321975-6053-41f8-b6e2-a6b99cef070f",
                                                "sense_id": "7043c6d0-c94b-346b-830b-1a0190386455",
                                                "text": "The Communist Party has a policy of returning power to the workers."
                                            },
                                            {
                                                "example_id": "eebd6cb8-4c3c-4bb5-b157-a30a72e55322",
                                                "sense_id": "7043c6d0-c94b-346b-830b-1a0190386455",
                                                "text": "It's company policy that all mobile phones are forbidden in meetings."
                                            },
                                            {
                                                "example_id": "2582b2fc-1bb1-4795-a082-624f2008bf68",
                                                "sense_id": "7043c6d0-c94b-346b-830b-1a0190386455",
                                                "text": "Federal policy is constructed in complex ways, involving legislation, regulation, and lobbying."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8a67d92-0ac2-3732-8287-d50aa0793c66",
                                        "entry_id": "be75b6b9-fe0f-320f-850e-bd53e971e728",
                                        "glosses": [
                                            "A document describing such a policy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5e125dd-8b1d-49bc-ad7d-a4dd3da665e4",
                                                "sense_id": "e8a67d92-0ac2-3732-8287-d50aa0793c66",
                                                "text": "Please print extra copies of this policy and post them where it will be easy for everyone to see."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da6ccd45-d3c2-3b14-8bc6-8e2d834e0b59",
                                        "entry_id": "be75b6b9-fe0f-320f-850e-bd53e971e728",
                                        "glosses": [
                                            "Wise, advantageous, or politic conduct; prudence, formerly also with connotations of craftiness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ef92a56-8ebd-411d-bf1b-fd86b582d8d3",
                                                "sense_id": "da6ccd45-d3c2-3b14-8bc6-8e2d834e0b59",
                                                "text": "[H]e [Richard I of England] was diſcovered in an inne in Auſtria, becauſe he diſguiſed his perſon not his expenſes; ſo that the very policie of an hoſteſſe, finding his purſe ſo farre above his clothes, did detect him: […]"
                                            },
                                            {
                                                "example_id": "ed542034-b3d4-4eb7-8665-d75f68bc8648",
                                                "sense_id": "da6ccd45-d3c2-3b14-8bc6-8e2d834e0b59",
                                                "text": "These bitter accusations might have been suppressed, had I with greater policy concealed my struggles, and flattered you into the belief of my being impelled by unqualified, unalloyed inclination; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "859504cb-e853-3704-ade9-8f0cc757d1b5",
                                        "entry_id": "be75b6b9-fe0f-320f-850e-bd53e971e728",
                                        "glosses": [
                                            "Specifically, political shrewdness or (formerly) cunning; statecraft."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fc8f089-0e4c-4910-86e3-02b35f24c5ae",
                                                "sense_id": "859504cb-e853-3704-ade9-8f0cc757d1b5",
                                                "text": "I, 'policie? that's their profession,\nAnd not simplicity, as they suggest."
                                            },
                                            {
                                                "example_id": "87a34e25-f436-4076-b85e-fb915e130506",
                                                "sense_id": "859504cb-e853-3704-ade9-8f0cc757d1b5",
                                                "text": "Whether he believed himself a god, or only took on the attributes of divinity from motives of policy, is a question for the psychologist, since the historical evidence is indecisive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "564354fd-2428-3607-a76f-0e4b83e8d4da",
                                        "entry_id": "be75b6b9-fe0f-320f-850e-bd53e971e728",
                                        "glosses": [
                                            "The grounds of a large country house."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0751cad4-9443-414b-a6db-265bbdf51253",
                                                "sense_id": "564354fd-2428-3607-a76f-0e4b83e8d4da",
                                                "text": "1775, Samuel Johnson, A Journey to the Western Islands of Scotland section on Aberbrothick\nNow and then about a gentleman’s house stands a small plantation, which in Scotch is called a policy, but of these there are few, and those few all very young."
                                            },
                                            {
                                                "example_id": "f9e65021-be85-4cc4-9337-4df4bb643457",
                                                "sense_id": "564354fd-2428-3607-a76f-0e4b83e8d4da",
                                                "text": "There was but one thing happened worth narrating; and that is the visit I had of Robin Oig, one of the sons of the notorious Rob Roy. He was sought upon all sides on a charge of carrying a young woman from Balfron and marrying her (as was alleged) by force; yet he stepped about Balquhidder like a gentleman in his own walled policy."
                                            },
                                            {
                                                "example_id": "cb7e6467-04c7-4952-a4f1-bb8a92f3c37d",
                                                "sense_id": "564354fd-2428-3607-a76f-0e4b83e8d4da",
                                                "text": "Next morning was so splendid that as he walked through the policies towards the mansion house despair itself was lulled."
                                            },
                                            {
                                                "example_id": "46617286-a796-4f3c-9762-ccfbd5284d0b",
                                                "sense_id": "564354fd-2428-3607-a76f-0e4b83e8d4da",
                                                "text": "The house and its policies (grounds) lie between what were once two or three separate hamlets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3576fccd-b09a-30c6-a1ef-48227ecfd075",
                                        "entry_id": "be75b6b9-fe0f-320f-850e-bd53e971e728",
                                        "glosses": [
                                            "The art of governance; political science."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2834cc79-1ea7-4f64-8c65-e785c2019a89",
                                                "sense_id": "3576fccd-b09a-30c6-a1ef-48227ecfd075",
                                                "text": "Liſt his diſcourse of Warre; and you ſhall heare / A fearefull Battaile rendred you in Muſique. / Turne him to any Cauſe of Pollicy, / The Gordian Knot of it he will vnlooſe, / Familiar as his Garter: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ad8bdb2-fd98-3436-b860-c73a1b51da18",
                                        "entry_id": "be75b6b9-fe0f-320f-850e-bd53e971e728",
                                        "glosses": [
                                            "A state; a polity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f349d2b-d4fc-38b6-8245-010a0ebfd66d",
                                        "entry_id": "be75b6b9-fe0f-320f-850e-bd53e971e728",
                                        "glosses": [
                                            "A set political system; civil administration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4f92a0e-e79e-3a43-b9cc-ecc16e0d3d2f",
                                        "entry_id": "be75b6b9-fe0f-320f-850e-bd53e971e728",
                                        "glosses": [
                                            "A trick; a stratagem."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c819806-c203-4217-bd88-7e2996ba1ae1",
                                                "sense_id": "a4f92a0e-e79e-3a43-b9cc-ecc16e0d3d2f",
                                                "text": "Tis pollicie and ſtratageme muſt doo / That you affect, and ſo muſt you reſolue, / That vvhat you cannot as you vvould atchiue, / You muſt perforce accompliſh as you may: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "557856dc-9b47-3a6c-a946-e48cfefded26",
                                        "entry_id": "be75b6b9-fe0f-320f-850e-bd53e971e728",
                                        "glosses": [
                                            "Motive; object; inducement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a04aedf8-3023-4664-8451-488f4d4afced",
                                                "sense_id": "557856dc-9b47-3a6c-a946-e48cfefded26",
                                                "text": "I pray you (said he) honest men, what such right have you in me, as not to suffer me to doe with my self what I list? and what pollicie have you to bestow a benefite where it is counted an injury?",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            }
                                        ]
                                    }
                                ]
                            },
