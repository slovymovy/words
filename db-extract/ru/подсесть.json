                "senses": [
                    {
                        "sense_id": "d067c1ce-0777-34c6-9777-b0cccc1b9f71",
                        "entry_id": "a4fe81b2-44fd-394e-b278-3098b5771341",
                        "glosses": [
                            "to take a seat, to sit down"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fda1c19b-05a9-4ef6-b57e-a6f066942932",
                                "sense_id": "d067c1ce-0777-34c6-9777-b0cccc1b9f71",
                                "text": "Она́ ре́зво подсе́ла к Алёше на дива́н, с ним ря́дом, и гляде́ла на него́ реши́тельно с восхище́нием.",
                                "translation": "She gaily sat down beside Alyosha on the sofa, looking at him with positive delight.",
                                "english": "She gaily sat down beside Alyosha on the sofa, looking at him with positive delight."
                            }
                        ]
                    },
                    {
                        "sense_id": "012c558b-64f1-34fb-9a36-e95fb6d102b5",
                        "entry_id": "a4fe81b2-44fd-394e-b278-3098b5771341",
                        "glosses": [
                            "to get hooked on, to get addicted to"
                        ],
                        "tags": [
