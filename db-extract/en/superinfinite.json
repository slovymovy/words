                "senses": [
                    {
                        "sense_id": "4fe8b1d8-e7da-34a9-981b-a3b04ea8b745",
                        "entry_id": "04051aac-6c96-370d-8dea-cc356a5a1411",
                        "glosses": [
                            "Absolutely infinite; being beyond what is conventionally infinite."
                        ],
                        "tags": [
                            "not-comparable",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d2737605-74cb-4f37-881f-b5cf3acfe2fe",
                                "sense_id": "4fe8b1d8-e7da-34a9-981b-a3b04ea8b745",
                                "text": "He contemplates His own superexcellent, superinfinite Being. And contemplating, He conceives it, one simple, everlasting, infinite act."
                            },
                            {
                                "example_id": "d9a76168-ec55-41db-bb27-58e06c82ccdd",
                                "sense_id": "4fe8b1d8-e7da-34a9-981b-a3b04ea8b745",
                                "text": "The pseudo-genius, with his eccentricities, neurotic expression, and irresponsibility, is a vastly different product, and gives color to the contention of some alienists that the relation between insanity and genius is close. The author of this volume admits that brilliant flights of genius are supernormal, perhaps superinfinite, but he declines to construe them as pathological."
                            },
                            {
                                "example_id": "2a0dba3e-daa0-4300-8ed6-4ca9b5e7c4a5",
                                "sense_id": "4fe8b1d8-e7da-34a9-981b-a3b04ea8b745",
                                "text": "Realization of the transcendence of the world gives birth to transcendent thinking. This thinking is a limitless one and gradually evelops all the superinfinite. Once appeared in BEING such intelligence is doomed to exist."
                            }
                        ]
                    }
                ],
