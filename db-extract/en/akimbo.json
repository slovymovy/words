                "entry_id": "2c509243-750f-377e-b29b-58b9d07b4a08",
                "word": "akimbo",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "311d92fc-3a83-3617-ae3e-5134e3dfe96c",
                        "entry_id": "2c509243-750f-377e-b29b-58b9d07b4a08",
                        "glosses": [
                            "With a crook or bend; with the hand on the hip and elbow turned outward."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a9b7ca00-7df1-418d-8860-278a487c9bf3",
                                "sense_id": "311d92fc-3a83-3617-ae3e-5134e3dfe96c",
                                "text": "\"Now, then, mister,\" said he, with his head cocked and his arms akimbo, \"what are you driving at? Let's have it straight, now.\""
                            },
                            {
                                "example_id": "6012fde2-2213-48a8-bb34-d00d72cb5903",
                                "sense_id": "311d92fc-3a83-3617-ae3e-5134e3dfe96c",
                                "text": "Girls take hold of the skirts; boys place the hands akimbo, bend forward from the waist, and bow."
                            },
                            {
                                "example_id": "73dc91cb-0caa-4d47-94b4-82c664fbbeec",
                                "sense_id": "311d92fc-3a83-3617-ae3e-5134e3dfe96c",
                                "text": "Men preferred one pose above all others, namely, the elbow akimbo."
                            }
                        ]
                    },
