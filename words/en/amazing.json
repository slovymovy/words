            "senses": [
                {
                    "sense_id": "c0bb95e1-2516-3e5b-945b-d7d59800fa1a",
                    "sense_definition": "Possessing uniquely wonderful qualities; very good.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "wonderful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The view from the top of the mountain was absolutely <w>amazing</w>.",
                            "target_lang_translations": {
                                "ru": "Вид с вершины горы был совершенно <w>потрясающим</w>."
                            }
                        },
                        {
                            "text": "She is an <w>amazing</w> person who always helps everyone in need.",
                            "target_lang_translations": {
                                "ru": "Она <w>удивительный</w> человек, который всегда помогает всем нуждающимся."
                            }
                        }
                    ],
                    "synonyms": [
                        "awesome",
                        "wonderful",
                        "fantastic"
                    ],
                    "antonyms": [
                        "terrible",
                        "awful"
                    ],
                    "common_phrases": [
                        "amazing person",
                        "amazing experience",
                        "absolutely amazing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий уникальными чудесными качествами; очень хороший."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удивительный",
                                "target_lang_sense_clarification": "вызывающий восхищение"
                            },
                            {
                                "target_lang_word": "потрясающий",
                                "target_lang_sense_clarification": "очень хороший, впечатляющий"
                            },
                            {
                                "target_lang_word": "восхитительный",
                                "target_lang_sense_clarification": "вызывающий восторг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71ef85b0-8e88-3342-be5d-25b3b55057ae",
                    "sense_definition": "Causing wonder and amazement; very surprising.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "surprising",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>amazing</w> how much technology has changed in just ten years.",
                            "target_lang_translations": {
                                "ru": "<w>Поразительно</w>, как сильно изменились технологии всего за десять лет."
                            }
                        },
                        {
                            "text": "The <w>amazing</w> discovery of the ancient ruins surprised the entire team of archaeologists.",
                            "target_lang_translations": {
                                "ru": "<w>Удивительное</w> открытие древних руин удивило всю команду археологов."
                            }
                        }
                    ],
                    "synonyms": [
                        "awesome",
                        "wonderful",
                        "incredible"
                    ],
                    "antonyms": [
                        "predictable",
                        "ordinary"
                    ],
                    "common_phrases": [
                        "amazing discovery",
                        "amazing amount",
                        "truly amazing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий удивление и изумление; крайне неожиданный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поразительный",
                                "target_lang_sense_clarification": "крайне удивительный"
                            },
                            {
                                "target_lang_word": "изумительный",
                                "target_lang_sense_clarification": "вызывающий сильное изумление"
                            },
                            {
                                "target_lang_word": "удивительный",
                                "target_lang_sense_clarification": "необычный, вызывающий вопросы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e09963fc-58f5-3385-aaa2-2cff0df7aaac",
