                    {
                        "form_id": "2d0b3c06-cb14-451c-bedf-7eda43af7cad",
                        "entry_id": "6db07bbf-abe4-3390-a1bd-7317a0d6ee67",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schmeicheleien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9e52b40-1afd-374b-83b7-b56ab46779f2",
                        "entry_id": "6db07bbf-abe4-3390-a1bd-7317a0d6ee67",
                        "glosses": [
                            "schmeichelnde Äußerung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b7698fd-e12d-4a81-a224-cc5f2a9cb712",
                                "sense_id": "c9e52b40-1afd-374b-83b7-b56ab46779f2",
                                "text": "Trotz seiner Schmeicheleien wollte sie nicht mit ihm zusammen sein."
                            },
                            {
                                "example_id": "e0358bf3-3495-405f-8e4a-43fb2c8e54a7",
                                "sense_id": "c9e52b40-1afd-374b-83b7-b56ab46779f2",
                                "text": "„Falls diese Bemerkung als Schmeichelei gemeint war, verstand Csoma sie nicht so.“"
                            },
                            {
                                "example_id": "7b3b9441-507b-473e-8b4b-59e111dca6fe",
                                "sense_id": "c9e52b40-1afd-374b-83b7-b56ab46779f2",
                                "text": "„Hugo war es ernst damit, auch wenn sich in diese Sätze eine elegante Schmeichelei mischt.“"
                            },
                            {
                                "example_id": "2c63ade4-7c71-4730-a9b6-0ba6490e0f90",
                                "sense_id": "c9e52b40-1afd-374b-83b7-b56ab46779f2",
                                "text": "„Dies war eine Fortsetzung von Johns Art, sie zu liebenkosen, das Echo seiner Schmeichelei.“"
                            },
                            {
                                "example_id": "9624defa-7b79-4f52-95a7-6609d2f50778",
                                "sense_id": "c9e52b40-1afd-374b-83b7-b56ab46779f2",
                                "text": "„Sie erzählte von den Schmeicheleien, die er ihr gesagt hatte; dann habe er geäussert, er wolle ins Ausland reisen, und sie gefragt, wo die Familie Rostow ihren Sommer verbringen würde, und sich dann nach Boris bei ihr erkundigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7ac06b8-a49a-4703-82ed-101c4dcc5e39",
                        "source_entry_id": "6db07bbf-abe4-3390-a1bd-7317a0d6ee67",
                        "source_sense_id": "c9e52b40-1afd-374b-83b7-b56ab46779f2",
                        "source_sense_description": "schmeichelnde Äußerung",
                        "target_lang_word": "flattery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flattery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04c62ca2-d196-3249-a5ae-3c3447923f27",
                                        "entry_id": "c93c72a2-d0c5-30f3-be86-06d0653e1695",
                                        "glosses": [
                                            "Excessive praise or approval, which is often insincere and sometimes contrived to win favour."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a8d1bc1-5cc1-41da-b2ec-d297228e1676",
                                                "sense_id": "04c62ca2-d196-3249-a5ae-3c3447923f27",
                                                "text": "Don't you know that some of his contributions here are pure flattery?"
                                            },
                                            {
                                                "example_id": "84e28d5a-21b2-41f9-8bff-62436510b88b",
                                                "sense_id": "04c62ca2-d196-3249-a5ae-3c3447923f27",
                                                "text": "That the young Mr. Churchills liked—but they did not like him coming round of an evening and drinking weak whisky-and-water while he held forth on railway debentures and corporation loans. Mr. Barrett, however, by fawning and flattery, seemed to be able to make not only Mrs. Churchill but everyone else do what he desired."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5d3e345-0dfa-343c-b973-8fbc2e092440",
                                        "entry_id": "c93c72a2-d0c5-30f3-be86-06d0653e1695",
                                        "glosses": [
                                            "An instance of excessive praise."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17822322-58a9-49da-8d1a-5e2a10403806",
                                                "sense_id": "c5d3e345-0dfa-343c-b973-8fbc2e092440",
                                                "text": "But I pitty the flatteries, and ſelfe-applauſes of a careleſſe and impenitent heart: This jollity hath in it much danger, and vvithout ſome change, death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d2a765b-7735-4b13-91f4-a385106a3030",
                        "source_entry_id": "6db07bbf-abe4-3390-a1bd-7317a0d6ee67",
                        "source_sense_id": "c9e52b40-1afd-374b-83b7-b56ab46779f2",
                        "source_sense_description": "schmeichelnde Äußerung",
                        "target_lang_word": "flatterie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flatterie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f61ce63-6035-3f52-9683-be3784436667",
                                        "entry_id": "28df39d7-40d7-3a83-abe4-e7923127fc29",
                                        "glosses": [
                                            "Louange fausse ou exagérée, donnée dans le dessein de plaire, de séduire, d’exploiter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a620e982-7519-4f84-86a6-478a2dcc652a",
                                                "sense_id": "0f61ce63-6035-3f52-9683-be3784436667",
                                                "text": "Le grand-père prit le marmot, il le baisa, le trouva délicieux et ravissant ; il lui parla le parler des nourrices, prophétisa que ce poupard deviendrait plus grand que lui, glissa des flatteries à l’adresse de son fils Hulot, et rendit l’enfant à la grosse Normande chargée de le tenir."
                                            },
                                            {
                                                "example_id": "dc683f9b-568a-4c6c-860a-e4af276fa02c",
                                                "sense_id": "0f61ce63-6035-3f52-9683-be3784436667",
                                                "text": "Malgré sa raison ferme et droite, le directeur général avait un faible qui se rencontre chez beaucoup d’hommes de mérite. Il aimait la louange, et même la flatterie ; (…)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
