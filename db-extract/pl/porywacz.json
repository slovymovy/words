                                        "sense_id": "9d65d999-5630-3740-ba86-f2776d502707",
                                        "entry_id": "909e8672-f18d-3c58-9113-912067d2026d",
                                        "glosses": [
                                            "jemand, der andere Menschen gegen ihren Willen an einen anderen Ort bringt, um dadurch ein Lösegeld zu erpressen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41196ba0-8603-414d-8475-296887babf4c",
                                                "sense_id": "9d65d999-5630-3740-ba86-f2776d502707",
                                                "text": "Die Entführer übermittelten den Angehörigen des Entführungsopfers ihre Lösegeldforderung."
                                            },
                                            {
                                                "example_id": "5b392af2-a79d-4b4d-aca1-f65a7b1b7939",
                                                "sense_id": "9d65d999-5630-3740-ba86-f2776d502707",
                                                "text": "„Erst am folgenden Mittag verteilen die Entführer ein paar Kolben Mais und Kochbananen aus einem Dorf, dessen Bewohner rechtzeitig geflohen sind.“"
                                            }
                                        ],
