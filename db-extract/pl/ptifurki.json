                    {
                        "sense_id": "e858aaec-a7a6-33cd-9c09-5b700e74f300",
                        "entry_id": "71a05f1a-6644-36ab-97d1-6693777e7293",
                        "glosses": [
                            "drobne kruche ciasteczka, często lukrowane lub nadziewane, podawane jako dodatek do herbaty lub kawy"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "54783ecc-2f89-4e1a-b1ca-cca437ca85c0",
                                "sense_id": "e858aaec-a7a6-33cd-9c09-5b700e74f300",
                                "text": "Wreszcie do kawy podano na dużej paterze kruche ptifurki nadziewane konfiturą i z wierzchu pokrywane kolorowymi pomadkami."
                            },
                            {
                                "example_id": "7ade05e4-12b4-4514-9ebc-816b9c57423f",
                                "sense_id": "e858aaec-a7a6-33cd-9c09-5b700e74f300",
                                "text": "Wewnątrz mówiło się po francusku i jadło ptifurki, lecz także turecką baklawę, rosyjskie pirożki, wiedeńskie strudle – przegląd najważniejszych w Rumunii wpływów kulturowych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
