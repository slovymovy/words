                                "target_senses": [
                                    {
                                        "sense_id": "efd8fcfd-878b-36ab-8bd5-cd8db6e6e4cd",
                                        "entry_id": "ce00d5c5-ef27-37f8-ae7f-cadb0c73e8a8",
                                        "glosses": [
                                            "systematisch (zum Beispiel nach dem Personennamen alphabetisch) geordnet niedergeschrieben"
                                        ],
                                        "tags": [
                                            "über biografische Daten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da87e889-bd9a-4d9d-9032-6016a1d08b0e",
                                                "sense_id": "efd8fcfd-878b-36ab-8bd5-cd8db6e6e4cd",
                                                "text": "Die Identifizierbarkeit der Fellsorten im Porträt ermöglicht die Kontrolle, ob die im Bild dargestellte Kleidung dem prosopografisch belegten sozialen Status des Porträtierten entspricht."
                                            },
                                            {
                                                "example_id": "3a1b8d5a-d7f5-4502-be0a-46db562e5c8b",
                                                "sense_id": "efd8fcfd-878b-36ab-8bd5-cd8db6e6e4cd",
                                                "text": "Auch die zwei übrigen Exkurse sind prosopografisch orientiert und demonstrieren die wichtige Rolle gebildeter Ordensbrüder im Leben der franziskanischen Provinz sowie in der damaligen Gesellschaft."
                                            },
                                            {
                                                "example_id": "39e7f586-7f88-4220-bcd5-e22cc4343c8b",
                                                "sense_id": "efd8fcfd-878b-36ab-8bd5-cd8db6e6e4cd",
                                                "text": "In den Details ist die Arbeit beeindruckend. Jede einzelne genannte Person wird prosopografisch erschlossen."
                                            },
                                            {
                                                "example_id": "6287b30a-1d2d-4d22-9ddb-50ffcb001919",
                                                "sense_id": "efd8fcfd-878b-36ab-8bd5-cd8db6e6e4cd",
                                                "text": "Um also die Spieler prosopografisch besser einordnen zu können, wurden oft auch deren Väter berücksichtigt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
