                "senses": [
                    {
                        "sense_id": "1db2562e-9988-3a91-82a0-31f0dfa4a222",
                        "entry_id": "6ae85e5a-b3f7-38de-9916-5bd63a6a916e",
                        "glosses": [
                            "Redresser (quelque chose qui était coudé)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7840e48c-bc97-4658-a3bb-609aaa443da0",
                                "sense_id": "1db2562e-9988-3a91-82a0-31f0dfa4a222",
                                "text": "Cette action va permettre de « découder » légèrement le conduit et ainsi permettre au produit de couler le plus loin possible."
                            },
                            {
                                "example_id": "86731eef-5a67-4325-bea5-fa28fe3ec8cc",
                                "sense_id": "1db2562e-9988-3a91-82a0-31f0dfa4a222",
                                "text": "Il est possible de glisser de toutes petites perles tel des Miyukis sur ces créoles, pour cela il suffit de découder à la pince plate l'extrémité de la créole."
                            },
                            {
                                "example_id": "9b09577d-7638-4c12-940a-c2fc75df3d7d",
                                "sense_id": "1db2562e-9988-3a91-82a0-31f0dfa4a222",
                                "text": "Pour faire simple regarde l'arrivée d'essence, la durite d'essence si elle est coudée faut la découder et regarde le robinet a la sortie du réservoir si il n'est pas bouché!!"
                            },
                            {
                                "example_id": "a3f81ee2-1554-451c-9308-c4064c49f2c9",
                                "sense_id": "1db2562e-9988-3a91-82a0-31f0dfa4a222",
                                "text": "Elles semblent droites, difficile de \"découder\" les antennes à mon avis !"
                            }
                        ]
                    }
                ],
