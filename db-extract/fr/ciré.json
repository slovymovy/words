            {
                "entry_id": "17e4cb79-3b81-3c11-8368-9f988ca2a9c5",
                "word": "ciré",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3c7d41e1-af69-4046-a068-45cb42605a32",
                        "entry_id": "17e4cb79-3b81-3c11-8368-9f988ca2a9c5",
                        "tags": [
                            "plural"
                        ],
                        "form": "cirés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f02364e9-b97c-3380-870d-340087502741",
                        "entry_id": "17e4cb79-3b81-3c11-8368-9f988ca2a9c5",
                        "glosses": [
                            "Manteau imperméable fait initialement de tissu huilé, à présent fait de tissu plastifié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f19e0b17-1adc-419e-99d4-750198a4da87",
                                "sense_id": "f02364e9-b97c-3380-870d-340087502741",
                                "text": "Habillés déjà en soldats du Gouvernement, ciré sur le dos, les hommes descendaient un à un dans la grande vedette balancée par les remous du Yang-Tsé."
                            },
                            {
                                "example_id": "39977600-e9d3-4a41-beb3-062c1fbe0ed1",
                                "sense_id": "f02364e9-b97c-3380-870d-340087502741",
                                "text": "Maëlys s'est pointée, elle avait laissé son ciré rouge qui lui allait si bien ; pourtant, il drachait sacrément, c'est fait pour ça, les cirés."
                            },
                            {
                                "example_id": "af15cd6b-2ff5-4c73-9a79-90c79dec099d",
                                "sense_id": "f02364e9-b97c-3380-870d-340087502741",
                                "text": "Dans l’entrée, des cirés jaunes pendaient à un portemanteau."
                            },
                            {
                                "example_id": "2037e247-40c6-44ec-815d-ca65011aa0c5",
                                "sense_id": "f02364e9-b97c-3380-870d-340087502741",
                                "text": "Une seule chose importait à présent. S’équiper pour la sortie. Sourd à la mauvaise humeur de Jonas, il trouva des bottes de caoutchouc, des cirés à capuches, des lunettes de plongée, des cannes de marche en aluminium."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3130adc-6f2e-4143-b67c-f07f07e2743f",
                        "source_entry_id": "17e4cb79-3b81-3c11-8368-9f988ca2a9c5",
                        "source_sense_id": "f02364e9-b97c-3380-870d-340087502741",
                        "target_lang_word": "Ölzeug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ölzeug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4b3bbeb-d047-3763-b939-dfa6e97dfe8b",
                                        "entry_id": "651b431c-3c2f-36de-b700-59244d7649f5",
                                        "glosses": [
                                            "wetterfeste Kleidung für Seeleute"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dafde74c-a4da-4460-b440-700939400937",
                                                "sense_id": "a4b3bbeb-d047-3763-b939-dfa6e97dfe8b",
                                                "text": "Der alte Seebär stand in seinem Ölzeug an Deck und bot dem Sturm und dem Regen die Stirn."
                                            },
                                            {
                                                "example_id": "6161d45f-420c-431a-aff1-228cb1107ed9",
                                                "sense_id": "a4b3bbeb-d047-3763-b939-dfa6e97dfe8b",
                                                "text": "„Auf der einen Seite des Fjordes lagern zwei Boote in einer Lagerhalle aus Wellblech, eingezwängt zwischen den Felsen, in der Bucht gegenüber liegt das hellgelbe Gerippe eines Zwergwals, an dem blaues Ölzeug zum Trocknen hängt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdb301f5-199f-4b40-820e-62e2746904a0",
                        "source_entry_id": "17e4cb79-3b81-3c11-8368-9f988ca2a9c5",
                        "source_sense_id": "f02364e9-b97c-3380-870d-340087502741",
                        "target_lang_word": "oilskin",
