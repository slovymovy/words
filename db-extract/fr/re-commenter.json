                "senses": [
                    {
                        "sense_id": "505b975b-06f7-3efc-aca1-6e26d8702ef1",
                        "entry_id": "a4327ef0-b891-32c4-928b-65786ea4bbbb",
                        "glosses": [
                            "Autre écriture, parfois rencontrée, de recommenter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "568b5335-03bc-4a8b-bcf9-2ddffbcc9412",
                                "sense_id": "505b975b-06f7-3efc-aca1-6e26d8702ef1",
                                "text": "On intronise également les compagnons du Dzi et juste après, on re-déguste, re-commente et re-découvre ce nectar si délicieux."
                            },
                            {
                                "example_id": "a9665d56-3dac-4d30-b325-38e61cdaf388",
                                "sense_id": "505b975b-06f7-3efc-aca1-6e26d8702ef1",
                                "text": "Puissions-nous, comme eux, redécouvrir avec des yeux purs et avec la même vertu d’émerveillement les poètes qu’il nous incombe de commenter et de re-commenter sans cesse."
                            }
                        ]
                    }
