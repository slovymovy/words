                ],
                "senses": [
                    {
                        "sense_id": "ddb53636-9e1c-3593-aede-d5140756e45b",
                        "entry_id": "ec31f5d2-4477-391b-8ffc-e82cb7270e36",
                        "glosses": [
                            "Travail de celui qui frotte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc1c78cd-68f0-49f5-b76d-453602038d1e",
                                "sense_id": "ddb53636-9e1c-3593-aede-d5140756e45b",
                                "text": "Le frottage d’un plancher."
                            },
                            {
                                "example_id": "8703aa00-2ee0-45b9-8329-e0f6ed73f98f",
                                "sense_id": "ddb53636-9e1c-3593-aede-d5140756e45b",
                                "text": "Le prix du frottage."
                            },
                            {
                                "example_id": "c8b5b923-9b8d-4878-a3ac-4ec4ee9c32b0",
                                "sense_id": "ddb53636-9e1c-3593-aede-d5140756e45b",
                                "text": "La commode avait résisté à plusieurs années de frottage."
                            },
                            {
                                "example_id": "ddeb425e-930e-4279-bfdd-4a808429a9aa",
                                "sense_id": "ddb53636-9e1c-3593-aede-d5140756e45b",
                                "text": "Un homme respectueux des traditions journalistiques, comme moi, se sent obligé d’y aller du classique frottage de sa boule de cristal."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6f7966b-f3ec-32e1-8523-1ddd8ec3e63d",
                        "entry_id": "ec31f5d2-4477-391b-8ffc-e82cb7270e36",
                        "glosses": [
                            "Action de frotter un parquet pour le faire briller"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "eb2fbfe1-e449-306a-9a63-10cd203c6453",
                        "entry_id": "ec31f5d2-4477-391b-8ffc-e82cb7270e36",
                        "glosses": [
                            "Transfert d’une image en relief en crayonnant délicatement un support papier ou autre placé dessus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1b81096-f192-4a0d-adfd-63ece6bb5f4b",
                                "sense_id": "eb2fbfe1-e449-306a-9a63-10cd203c6453",
                                "text": "L’image apparaît sous le support choisi par frottage."
                            },
                            {
                                "example_id": "bc45d360-8cb8-4b13-b1b8-3044b46f9baa",
                                "sense_id": "eb2fbfe1-e449-306a-9a63-10cd203c6453",
                                "text": "En 1925, Max Ernst invente le frottage : il laisse courir une mine de crayon à papier sur une feuille posée sur une surface quelconque."
                            }
                        ]
                    },
                    {
                        "sense_id": "519862b9-a990-3514-9b07-5df71e78fa75",
                        "entry_id": "ec31f5d2-4477-391b-8ffc-e82cb7270e36",
                        "glosses": [
                            "Acte sensuel impliquant les caresses, pouvant inclure ou non les organes sexuels. → voir frot"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "60d4b867-c8ea-323b-aa54-cc17f976136e",
                        "entry_id": "ec31f5d2-4477-391b-8ffc-e82cb7270e36",
                        "glosses": [
                            "Acte délictueux, pratiqué par les frotteurs, qui consiste, dans une foule (en particulier dans le métro) à frotter ses parties génitales contre une autre personne sans son consentement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7107d33-b479-4c84-bdeb-5a63f29258bb",
                                "sense_id": "60d4b867-c8ea-323b-aa54-cc17f976136e",
                                "text": "Dans le métro, des agressions sexuelles (frottage, mains baladeuses...) existent bel et bien. C'est tellement grave qu'il y a maintenant des rames de métro « réservées aux femmes » à Tokyo aux heures de pointe."
                            }
                        ]
                    }
