                        {
                            "text": "В деревне все знали, что <w>Домашка</w> обладает крутым нравом.",
                            "target_lang_translations": {
                                "en": "Everyone in the village knew that <w>Domashka</w> had a tough temperament."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
