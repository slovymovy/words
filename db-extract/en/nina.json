                                                "sense_id": "7f0ee1d5-4bab-3679-ba28-ad97831975f9",
                                                "text": "Nina hat im vergangenen Jahr geheiratet."
                                            },
                                            {
                                                "example_id": "06ed0b90-448c-4161-8551-1fb72762c3ff",
                                                "sense_id": "7f0ee1d5-4bab-3679-ba28-ad97831975f9",
                                                "text": "„Adam trug Egoismus und Mutlosigkeit zur Schau, Nina gab sich blasiert, desillusioniert und ausgesprochen verärgert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
