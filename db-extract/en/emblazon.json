                                                "example_id": "5b9d4c02-f03e-477c-850b-a9db0655a694",
                                                "sense_id": "e7855463-51d9-3e86-83d5-7b50f9ed7dca",
                                                "text": "Die Geheimzahl der EC-Karte sollte man sich besser einprägen als aufschreiben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "119f3910-7399-3ef6-8243-badfdeb1b0af",
                                        "entry_id": "f9967a7e-728a-3e42-bb53-3ae7716e9a9d",
