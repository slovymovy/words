                "senses": [
                    {
                        "sense_id": "db00180a-94ec-3221-ada7-ce28dcd8003b",
                        "entry_id": "bf9e4949-a706-3757-9636-b6582d4761c7",
                        "glosses": [
                            "Of or pertaining to a conchoid; that may be defined as a conchoid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9da05cc-d0b0-41db-9b01-35e65b6333a1",
                                "sense_id": "db00180a-94ec-3221-ada7-ce28dcd8003b",
                                "text": "c. 1695, Isaac Newton, 1976, D. T. Whiteside (editor), The Mathematical Papers of Isaac Newton, Volume 7: 1691-1695, page 621,\n[…] a conchoidal hyperbola with an oval at its convexity."
                            }
                        ]
                    },
                    {
                        "sense_id": "520cfad8-50cb-38bd-9737-90f654d76e45",
                        "entry_id": "bf9e4949-a706-3757-9636-b6582d4761c7",
                        "glosses": [
                            "Irregular, with planar, concentric curves, similar to those on a mussel shell."
                        ],
                        "tags": [
                            "of a fracture"
                        ],
                        "examples": [
                            {
                                "example_id": "b197492d-5efd-44e3-b18f-7d5cd49efb3c",
                                "sense_id": "520cfad8-50cb-38bd-9737-90f654d76e45",
                                "text": "1821, Coal, entry in Andrew Ure, A Dictionary of Chemistry on the Basis of Mr Nicholson's, unnumbered page,\nIt is distinguished by its splendent lustre and conchoidal fracture."
                            },
                            {
                                "example_id": "b57489a1-3efa-45a1-b633-b63e8a86e63a",
                                "sense_id": "520cfad8-50cb-38bd-9737-90f654d76e45",
                                "text": "Some flakes detached in a controlled manner have characteristics of conchoidal fracture."
                            },
                            {
                                "example_id": "894963d7-0784-4e6e-8ba4-154da4068aad",
                                "sense_id": "520cfad8-50cb-38bd-9737-90f654d76e45",
                                "text": "On one side of the radial edge, the conchoidal fractures form right angles, that is, form a perpendicular with the edge."
                            },
                            {
                                "example_id": "e184d56d-1089-426f-980f-978957cb3964",
                                "sense_id": "520cfad8-50cb-38bd-9737-90f654d76e45",
                                "text": "If grains derived from these rocks are unweathered after separation from the parent rock (a very rare occurrence), they may contain either conchoidal breakage patterns if grains are large, or upturned plates and flat upper and lower surfaces if small grains are considered."
                            }
                        ]
                    },
                    {
                        "sense_id": "c18876dd-f227-35fa-bb96-d1206a93e98a",
                        "entry_id": "bf9e4949-a706-3757-9636-b6582d4761c7",
                        "glosses": [
                            "That fractures with planar concentric curves (e.g., as flint, chert or obsidian)."
                        ],
                        "tags": [
                            "of a mineral"
                        ],
                        "examples": [
                            {
                                "example_id": "22179fcc-8e83-45c1-bca0-0437c05bf80f",
                                "sense_id": "c18876dd-f227-35fa-bb96-d1206a93e98a",
                                "text": "1821, Focus of Philosophy, Science and Art, Volume 1, Issues 1-4, page 74,\nThe customary transitions of pitchstone are, into Chalcedony, Chert, Semi-opal; also into a substance resembling conchoidal shining jasper, found in clay strata, entangled in trap, or volcanic rock; and lastly, into Trap."
                            }
                        ]
                    }
