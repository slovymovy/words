                        "entry_id": "6432e02e-1937-3f76-bfa0-b1931fc1517b",
                        "glosses": [
                            "Membre de l’ordre des chevaliers Porte-Glaive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf5b54e4-ca62-47fd-b302-2820a9250d4d",
                                "sense_id": "9961c96e-5fda-39ec-b9b7-e32ee176d300",
                                "text": "Les Habsbourg d’Autriche allaient devenir, contre les Turcs, les porte-glaive de l’Europe centrale."
                            }
                        ]
                    },
                    {
                        "sense_id": "b34b5fc3-f4b7-367d-b2fc-09987a26f597",
                        "entry_id": "6432e02e-1937-3f76-bfa0-b1931fc1517b",
                        "glosses": [
                            "Fourreau de cuir ou ceinturon qui porte le glaive, le sabre ou l’épée."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2ac521f6-8f2a-3522-be80-869a15b50b0d",
                        "entry_id": "6432e02e-1937-3f76-bfa0-b1931fc1517b",
                        "glosses": [
                            "Personne qui porte un glaive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15d57bcb-1d6e-4520-be8b-43893f62fa36",
                                "sense_id": "2ac521f6-8f2a-3522-be80-869a15b50b0d",
                                "text": "Si tu essaies de dire un mot à celle que tu conduis, voici mon porte-glaive qui te fendra la tête d’un coup d’épée"
                            }
                        ]
                    },
                    {
                        "sense_id": "3c9f8a98-b3a4-33e9-9957-8fb0ce969730",
                        "entry_id": "6432e02e-1937-3f76-bfa0-b1931fc1517b",
                        "glosses": [
                            "Xiphophore ou autre poisson dont la mâchoire supérieure a la forme d’une lame."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0965f01c-0637-4980-bc41-4078298d5ce2",
                                "sense_id": "3c9f8a98-b3a4-33e9-9957-8fb0ce969730",
                                "text": "il ne reculent jamais , ne se détournent jamais de leur route devant un autre poisson ; et par fois s’engagent des combats terribles, lorsque la baleine et le porte-glaive viennent à se rencontrer."
                            }
                        ]
                    }
