                "senses": [
                    {
                        "sense_id": "e782fa56-5023-30a2-abc1-043c2d18ce24",
                        "entry_id": "c2c18788-1581-3bc7-be47-95d7674fb61b",
                        "glosses": [
                            "dun puntig bamboe of houten stokje dat o.a. gebruikt wordt bij de bereiding van saté"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f0c62af-491d-4da3-b1ef-663a49da6421",
                                "sense_id": "e782fa56-5023-30a2-abc1-043c2d18ce24",
                                "text": "Doe wat suiker op een bordje, dop een satéstokje in het suikerwater en rol door de suiker zodat er al een laagje suiker aan het stokje blijft kleven.De stokjes moeten nu in de glazen met suikerwater maar ze mogen de bodem of de rand van het glas niet raken want dan zal de suiker niet kristalliseren. Met een wasspeld kan je de stokje in de juiste positie vastzetten."
                            },
                            {
                                "example_id": "ff10e990-f471-41c9-abfd-b3844ef52889",
                                "sense_id": "e782fa56-5023-30a2-abc1-043c2d18ce24",
                                "text": "Week de satéstokjes in water, zodat ze straks niet verbranden. Meng het gehakt met drie tenen knoflook, de rode peper, de koriander, de ras el hanout, de olie, het ei en het beschuit. Breng de boel op smaak met zout en peper, en draai er 8 worstjes van. Steek door elk worstje een satéstokje."
                            }
                        ]
                    }
                ],
