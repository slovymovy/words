    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "72d6b25b-15f7-3179-8687-9ecf81cfb8bf",
                    "sense_definition": "odnoszący się do sportu motocyklowego na torze sypkim, czyli do żużla",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W niedzielę cała rodzina poszła na stadion, aby obejrzeć mecz <w>żużlowy</w>.",
                            "target_lang_translations": {
                                "ru": "В воскресенье вся семья пошла на стадион, чтобы посмотреть <w>спидвейный</w> матч."
                            }
                        },
                        {
                            "text": "Mój starszy brat od wielu lat marzy o profesjonalnej karierze <w>żużlowej</w>.",
                            "target_lang_translations": {
                                "ru": "Мой старший брат много лет мечтает о профессиональной карьере <w>в спидвее</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mecz żużlowy",
                        "tor żużlowy",
                        "sport żużlowy"
                    ],
                    "target_lang_definitions": {
                        "ru": "относящийся к спидвею — мотогонкам по гаревой дорожке"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спидвейный",
                                "target_lang_sense_clarification": "связанный со спидвеем"
                            },
                            {
                                "target_lang_word": "гаревый",
                                "target_lang_sense_clarification": "о дорожке или треке для спидвея"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e4d17ec-3356-3c23-88c7-aae8d16dfa81",
                    "sense_definition": "zrobiony z żużlu, zawierający żużel lub wysypany żużlem",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "materiał",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Samochód powoli jechał po starej, <w>żużlowej</w> drodze prowadzącej do fabryki.",
                            "target_lang_translations": {
                                "ru": "Машина медленно ехала по старой, покрытой <w>шлаком</w> дороге, ведущей к фабрике."
                            }
                        },
                        {
                            "text": "Do budowy tych budynków gospodarczych wykorzystano tanie pustaki <w>żużlowe</w>.",
                            "target_lang_translations": {
                                "ru": "Для строительства этих хозяйственных построек использовали дешёвые <w>шлакоблоки</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "droga żużlowa",
                        "pustak żużlowy"
                    ],
                    "target_lang_definitions": {
                        "ru": "сделанный из шлака, содержащий шлак или посыпанный шлаком"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлаковый",
                                "target_lang_sense_clarification": "состоящий из шлака или содержащий шлак"
                            },
                            {
                                "target_lang_word": "гаревый",
                                "target_lang_sense_clarification": "посыпанный гарью или шлаком (о дороге)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}