                "senses": [
                    {
                        "sense_id": "b63ce856-cbfd-385f-9d5d-f04db239bcb4",
                        "entry_id": "a4ab9e27-34c2-3a79-a550-50513ad89726",
                        "glosses": [
                            "The state of being gentle."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "93a98d8c-0f14-413a-a88e-3ee5ca9b21fa",
                                "sense_id": "b63ce856-cbfd-385f-9d5d-f04db239bcb4",
                                "text": "[S]he [Sabrina, a water nymph] reviv'd, / And undervvent a quicke, immortall change / Made goddeſſe of the river; ſtill ſhe retaines / Her maiden gentleneſſe, […]",
                                "translation": "Comus",
                                "english": "Comus"
                            },
                            {
                                "example_id": "f2e19bb4-fd34-42e7-b61d-cec78593ff83",
                                "sense_id": "b63ce856-cbfd-385f-9d5d-f04db239bcb4",
                                "text": "Willie spends his bus money home playing a song to dance to on the jukebox in an effort to comfort Sam, and unlike Hally, who struck out at his old friend when his life began to go wrong, Sam does not pass down Hally's hatefulness, but instead treats Willie with the same gentleness he has shown toward him throughout the play."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29b6b27c-8c0f-4124-955c-6857132b4001",
                        "source_entry_id": "a4ab9e27-34c2-3a79-a550-50513ad89726",
                        "source_sense_id": "b63ce856-cbfd-385f-9d5d-f04db239bcb4",
                        "source_sense_description": "being gentle",
                        "target_lang_word": "minzaamheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minzaamheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "efa5b584-8226-3cf8-8890-464fc5e343a7",
                                        "entry_id": "99a08de6-e8e8-3e65-88a0-e7dc365e6522",
                                        "glosses": [
                                            "neerbuigende vriendelijkheid als karakter eigenschap"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "989ad2b2-9ba5-498e-9576-2a29318ae255",
                                                "sense_id": "efa5b584-8226-3cf8-8890-464fc5e343a7",
                                                "text": "Hé, Bondarenko, beste vriend, zei hij tegen de huzaar die in ijltempo op zijn paard kwam toegelopen. Laat hem uitlopen, vriend, zei hij met die kameraadschappelijke, vrolijke minzaamheid waarmee goedmoedige jongelieden zich tot iedereen richten als ze gelukkig zijn."
                                            },
                                            {
                                                "example_id": "38a11835-c6a0-43f0-a1a7-6afe7fa160d7",
                                                "sense_id": "efa5b584-8226-3cf8-8890-464fc5e343a7",
                                                "text": "Hij smaakt naar haring. De echte attractie is Theo Hiddema. De een na de ander wil met hem op de selfie, je kunt het Kamerlid gerust een toeristische trekpleister noemen. Hij ondergaat het in minzaamheid, de rol die hem zo goed ligt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caa16cb6-278f-3a9d-b8cb-aaf65d74912f",
                                        "entry_id": "99a08de6-e8e8-3e65-88a0-e7dc365e6522",
                                        "glosses": [
                                            "uiting van neerbuigende vriendelijkheid"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29bc67d9-b7f6-4ac7-9321-a16c04746768",
                        "source_entry_id": "a4ab9e27-34c2-3a79-a550-50513ad89726",
                        "source_sense_id": "b63ce856-cbfd-385f-9d5d-f04db239bcb4",
                        "source_sense_description": "being gentle",
                        "target_lang_word": "Sanftmut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sanftmut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7756e950-edfc-3536-af4d-d5ca324af943",
                                        "entry_id": "36ed2d09-f86b-3a64-bc7e-dd193ef660e0",
                                        "glosses": [
                                            "ausgeglichene, ruhige, geduldige und wohlwollende Gesinnung, die einen Menschen selbst bei Kränkungen nicht in Zorn geraten lässt, sondern ein besonnenes Verhalten hervorbringt, das die Mitmenschen positiv beeinflusst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51f3d293-ef80-4f87-9f9d-d0c79ca78e00",
                                                "sense_id": "7756e950-edfc-3536-af4d-d5ca324af943",
                                                "text": "Da haben wir nun aufs neue Gottes Wort, mit dem er uns anreizen und antreiben will zu rechten, edlen, hohen Werken, wie Sanftmut, Geduld und - zusammenfassend gesagt - Liebe und Wohltat unseren Feinden gegenüber."
                                            },
                                            {
                                                "example_id": "6e357b3b-042f-465d-82ec-1f05e5673d18",
                                                "sense_id": "7756e950-edfc-3536-af4d-d5ca324af943",
                                                "text": "Mit glimpflicher Art, mit Sanftmut und Güte richtet man öfter mehr aus als mit unmäßiger Schärfe."
                                            },
                                            {
                                                "example_id": "e80f1695-dee4-45c6-8d6d-a3379999b78f",
                                                "sense_id": "7756e950-edfc-3536-af4d-d5ca324af943",
                                                "text": "Aber zur Leitung eines Knaben braucht es Hörner und Zähne irgend welcher Art, und dergleichen besaß sie nicht, denn sie war die Milde und Sanftmut selbst."
                                            },
                                            {
                                                "example_id": "d0e6343c-567e-4459-92dd-dd2ea615d653",
                                                "sense_id": "7756e950-edfc-3536-af4d-d5ca324af943",
                                                "text": "Auf Bali liegen nach der zweiten Bombentragödie die Nerven blank. War die hinduistische Insel nach den Anschlägen vor drei Jahren noch in stiller Trauer versunken, so werden auf der \"Insel der Sanftmut\" jetzt auch Wut und Verbitterung laut."
                                            },
                                            {
                                                "example_id": "33614e3e-57b0-4fae-b0a8-a9a9d8686d9d",
                                                "sense_id": "7756e950-edfc-3536-af4d-d5ca324af943",
                                                "text": "Es ist leider wahr, daß Weisheit und Körperkraft, animalisches Begehren und sensible Sanftmut selten zusammengehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
