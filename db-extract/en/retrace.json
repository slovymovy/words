                    {
                        "sense_id": "609becaa-7fec-3fbd-a77e-e72413864dc2",
                        "entry_id": "9940aefa-c9c7-372d-b8cf-d293865b4316",
                        "glosses": [
                            "To trace (a line, etc. in drawing) again."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c1198263-1e46-3108-a17d-be16c59b7181",
                        "entry_id": "9940aefa-c9c7-372d-b8cf-d293865b4316",
                        "glosses": [
                            "To go back over something, usually in an attempt at rediscovery."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "64040c08-a6c9-4eaf-8d93-0fade74deaab",
                                "sense_id": "c1198263-1e46-3108-a17d-be16c59b7181",
                                "text": "He retraced his steps, and found his keys where he had dropped them."
                            },
                            {
                                "example_id": "d26158df-5d04-4d31-9fb5-20d8ac19a9d3",
                                "sense_id": "c1198263-1e46-3108-a17d-be16c59b7181",
                                "text": "Instead of retracing my route, I have elected to walk across Blackpool to the town's remaining large station, although even this has been greatly reduced in size."
                            }
                        ]
                    },
                    {
                        "sense_id": "f21274a5-f8df-3d3f-b014-c9fa75281f47",
                        "entry_id": "9940aefa-c9c7-372d-b8cf-d293865b4316",
                        "glosses": [
                            "To undergo retracement."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cdb7c67b-b78e-44bc-8b63-a640c280ce06",
                        "source_entry_id": "9940aefa-c9c7-372d-b8cf-d293865b4316",
                        "source_sense_description": "to trace again",
                        "target_lang_word": "nachvollziehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nachvollziehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "787ef987-cbdf-3269-830e-5338bb8246df",
                                        "entry_id": "32a78f91-50e0-3006-8f00-8ed1b4b7bd26",
                                        "glosses": [
                                            "Geschehenes oder von anderen Überlegtes selbst durchdenken, so dass man es verstehen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ca23f33-0d00-4bce-a412-277317da5a7e",
                                                "sense_id": "787ef987-cbdf-3269-830e-5338bb8246df",
                                                "text": "Es bedurfte längerer Überlegung, um seine Argumentation nachzuvollziehen."
                                            },
                                            {
                                                "example_id": "0b4e03f3-ea05-43ae-869b-cae26771f07e",
                                                "sense_id": "787ef987-cbdf-3269-830e-5338bb8246df",
                                                "text": "Niemand konnte wirklich nachvollziehen, was sich da tatsächlich abgespielt hatte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5556d17f-dd31-49da-898f-3f3e5ae64838",
                        "source_entry_id": "9940aefa-c9c7-372d-b8cf-d293865b4316",
                        "source_sense_description": "to trace again",
                        "target_lang_word": "zurückverfolgen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zurückverfolgen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "286e43e7-3835-3cea-855d-af2e0a0598fa",
                                        "entry_id": "53189b37-8f98-3aa6-8bf8-43b937209ae6",
                                        "glosses": [
                                            "nachvollziehen eines Sachverhaltes in Richtung seines Ursprunges"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ba794d1-169a-455e-abbe-5729f6041da6",
                                                "sense_id": "286e43e7-3835-3cea-855d-af2e0a0598fa",
                                                "text": "Meinhard I. (III.), Graf von Görz und Tirol, stammte aus einem Geschlechte, das sich […] bis in den Anfang des 12. Jahrhunderts zurückverfolgen läßt."
                                            },
                                            {
                                                "example_id": "01e5546c-d89e-4568-ab27-129af05bd0c1",
                                                "sense_id": "286e43e7-3835-3cea-855d-af2e0a0598fa",
                                                "text": "Die blank geschliffenen, brillanten Bronzebüsten der Jonghelinck und Leoni rufen römisch-imperiale Bezüge auf, so wie die Genealogen den Stammbaum bis zu Noah, die Trojaner oder Cäsar zurückverfolgen."
                                            },
                                            {
                                                "example_id": "6c7f76f6-d084-4bcb-9d7a-4d4959a6f6c2",
                                                "sense_id": "286e43e7-3835-3cea-855d-af2e0a0598fa",
                                                "text": "In einem einzigen Fall konnten Forscher die Leistungskraft eines Sportlers bis ins Erbgut zurückverfolgen."
                                            },
                                            {
                                                "example_id": "778aae1f-14db-43e0-8fc3-e5321ceba5d9",
                                                "sense_id": "286e43e7-3835-3cea-855d-af2e0a0598fa",
                                                "text": "„Der Begriff der Antinomie läßt sich bis zu Plutarch und Quintilian zurückverfolgen, hat aber erst bei Kant seine philosophisch relevante Ausprägung gewonnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
