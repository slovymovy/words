                                    {
                                        "sense_id": "08113aee-58dd-3631-b857-13bf0a513d7a",
                                        "entry_id": "c75776c8-9439-34e4-9a11-4482972c994d",
                                        "glosses": [
                                            "The temperature of the body of a person or animal, especially when used as a simple guide to health."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09079a54-fc13-45e5-957a-bee9fa10a630",
                                                "sense_id": "08113aee-58dd-3631-b857-13bf0a513d7a",
                                                "text": "The normal body temperature of a dog falls within the range of about 38°C to 39°C."
                                            },
                                            {
                                                "example_id": "3d6f959b-c399-4633-9b87-7931df364f60",
                                                "sense_id": "08113aee-58dd-3631-b857-13bf0a513d7a",
                                                "text": "Heatwaves are especially damaging to children, as they are less able to regulate their body temperature compared to adults, the statement said, adding that the more heatwaves children are exposed to, the greater the chance of health problems including chronic respiratory conditions, asthma, and cardiovascular diseases."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
