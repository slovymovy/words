                ],
                "senses": [
                    {
                        "sense_id": "7b0e50c3-06bd-3c8d-91d4-0ecebffa8b6f",
                        "entry_id": "92c9f741-78b8-3248-b2cf-a4f169dedbf1",
                        "glosses": [
                            "Brief, der dazu dient, eine Antwort zu geben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e9bda8a-8c2a-4ad7-a416-f87fb56bbad0",
                                "sense_id": "7b0e50c3-06bd-3c8d-91d4-0ecebffa8b6f",
                                "text": "„Natascha ging zum Schreibtisch, und nun schrieb sie, ohne auch nur einen Augenblick zu überlegen, jenen Antwortbrief an Prinzessin Marja, den sie in all diesen Vormittagsstunden nicht hatte zustande bringen können.“"
                            },
                            {
                                "example_id": "7d77ee10-72d8-49fa-b76e-aa1fb21bb9eb",
                                "sense_id": "7b0e50c3-06bd-3c8d-91d4-0ecebffa8b6f",
                                "text": "„Sylvia kehrte in das Hinterzimmer ihres eigenen Ladens zurück und verfasste mit einem Stift, der mit jedem Wort leichter wurde, einen Antwortbrief an Roth und seinen Anwalt, in dem sie erklärte, dass sie die Klage fallen ließ.“"
                            },
                            {
                                "example_id": "361372fa-419b-4bf1-9fc4-2987489edd17",
                                "sense_id": "7b0e50c3-06bd-3c8d-91d4-0ecebffa8b6f",
                                "text": "„Ihre Antwortbriefe sind nicht erhalten, Benn entledigt sich ihrer diskret, denn beide Frauen wissen nichts voneinander, ein dummer Zufall könnte sein Gebäude einstürzen lassen.“"
                            },
                            {
                                "example_id": "dead0712-31d2-4c07-995f-3117d3d3dba2",
                                "sense_id": "7b0e50c3-06bd-3c8d-91d4-0ecebffa8b6f",
                                "text": "„Halldór war offenbar so glücklich, auf sein erstes Schreiben eine Reaktion bekommen zu haben, dass ihm die Tränen gekommen waren und er gleich einen zweiten, langen Antwortbrief aufgesetzt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
