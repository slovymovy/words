                                        "sense_id": "75b5854e-1feb-3db4-8bca-c5e58df5e273",
                                        "entry_id": "6cfb4e64-d7df-3f79-90f3-e5c421f73abe",
                                        "glosses": [
                                            "指事情發生的頻率很高，次數頻繁"
                                        ],
                                        "tags": [],
