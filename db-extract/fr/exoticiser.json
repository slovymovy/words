                ],
                "senses": [
                    {
                        "sense_id": "464a8169-c927-3d40-9f56-ed72b2d075f5",
                        "entry_id": "d5450c24-ee30-3cb1-a6d7-e19e6f8135c0",
                        "glosses": [
                            "Donner un caractère exotique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a55ffdbb-2b5c-44d0-af83-a4a5c040b6a1",
                                "sense_id": "464a8169-c927-3d40-9f56-ed72b2d075f5",
                                "text": "Elle montre les gens dans leur propre beauté sans les exoticiser ou encore sans les montrer comme des êtres bizarres."
                            },
                            {
                                "example_id": "2d80a149-0d35-409b-a1e1-213f08379726",
                                "sense_id": "464a8169-c927-3d40-9f56-ed72b2d075f5",
                                "text": "Refuser « d’exoticiser » l’autre en voyage, c’est se voir accuser de rechercher la maison, de ne pas faire un voyage authentique."
                            },
                            {
                                "example_id": "3eb469e7-2ce4-46f7-9704-9484d5e9c64a",
                                "sense_id": "464a8169-c927-3d40-9f56-ed72b2d075f5",
                                "text": "Michael White avait une expression pour cela, il parlait d’ : « exoticiser le familier »."
                            }
                        ]
                    }
                ],
