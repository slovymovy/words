                        "sense_id": "d2d3f1af-5a77-3eaf-a218-39d0d6a2cef3",
                        "entry_id": "576d6efd-0023-3eed-bfd4-b792b5c6e137",
                        "glosses": [
                            "kleiner Behälter aus Plastik/Kunststoff mit Deckel zur Aufbewahrung von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9664ceda-9a97-4028-bca0-03aa39780a51",
                                "sense_id": "d2d3f1af-5a77-3eaf-a218-39d0d6a2cef3",
                                "text": "„Kleine Sachen kannst du auch in einer Kunststoffdose mit dicht verschließbarem Deckel aufbewahren.“"
                            },
                            {
                                "example_id": "2a2f1f9c-7aa8-4ed8-9249-49fd70e6d7df",
                                "sense_id": "d2d3f1af-5a77-3eaf-a218-39d0d6a2cef3",
                                "text": "„Mein Schwiegervater bat mich vor einiger Zeit darum, ihm eine luftdichte Kunststoffdose zu besorgen.“"
                            },
                            {
                                "example_id": "6acfbedc-095d-4cef-b005-82f44efbe581",
                                "sense_id": "d2d3f1af-5a77-3eaf-a218-39d0d6a2cef3",
                                "text": "„Auch ein verschließbarer Plastikbeutel oder eine mit feuchtem Haushaltspapier ausgelegte Kunststoffdose eignen sich.“"
                            }
                        ],
