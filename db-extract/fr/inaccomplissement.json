                        "sense_id": "429e996b-7582-34c0-b1df-dad56e6325b5",
                        "entry_id": "35222b55-a0b7-3ad8-a8a3-1f4a9819e3b7",
                        "glosses": [
                            "Manque d’accomplissement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86657405-9462-4736-a625-698ff3039fc0",
                                "sense_id": "429e996b-7582-34c0-b1df-dad56e6325b5",
                                "text": "J'ai dit que c'était un mot [banqueroute] qu'on osait à peine prononcer devant une chambre aussi honnête que celle-ci et dans un siècle aussi honnête que le nôtre ; mais j'ai soutenu qu'on marchait vers l'inaccomplissement des engagements."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc1e7280-8d52-47c4-a36d-c97f918151a2",
                        "source_entry_id": "35222b55-a0b7-3ad8-a8a3-1f4a9819e3b7",
                        "source_sense_id": "429e996b-7582-34c0-b1df-dad56e6325b5",
                        "target_lang_word": "Nichterfüllung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nichterfüllung",
