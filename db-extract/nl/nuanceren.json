                                        "examples": [
                                            {
                                                "example_id": "ec035701-2942-4ef7-bc16-228f51a1f944",
                                                "sense_id": "419c47a1-75b6-3b4f-864b-8e2d8ade365e",
                                                "text": "Man muss klar zwischen Skinhead und Neonazi differenzieren, denn nicht jeder Anhänger der Skinhead-Szene hängt braunem Gedankengut nach."
                                            }
