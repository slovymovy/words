                ],
                "senses": [
                    {
                        "sense_id": "0f5fbea8-4c2b-369d-8787-9900fed2e6e9",
                        "entry_id": "2ca2b8d7-f597-37dd-b907-80c28f41ac70",
                        "glosses": [
                            "Person oder Organisation, die aus den Umständen eines Krieges Vorteile zieht"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "af6f12e5-d5f2-4ac9-80f0-8fc52754dbbf",
                                "sense_id": "0f5fbea8-4c2b-369d-8787-9900fed2e6e9",
                                "text": "„Der erschien dem Grenadier mit seinem dunklen Anzug, dem Zigarrenetui in der Westentasche und dem Duft nach Pomade und gutem Tabak wie ein leibhaftiger Kriegsgewinnler.“"
                            },
                            {
                                "example_id": "317077bd-17b0-458f-8cd6-cb60226aa996",
                                "sense_id": "0f5fbea8-4c2b-369d-8787-9900fed2e6e9",
                                "text": "„Die anständig gebliebene Bevölkerung hat jedoch nichts von alledem vergessen, und jeder Täter, Mauschler und Schieber, Organisierer und Kriegsgewinnler bekam daher seinen passenden Spitznamen — wie zum Beispiel der »Schmuggler-Alwin« und »Goldbarren-Oberst« […].“"
                            },
                            {
                                "example_id": "29e4ac5a-e01b-4371-b694-e8839261af2d",
                                "sense_id": "0f5fbea8-4c2b-369d-8787-9900fed2e6e9",
                                "text": "„In die allgemeine Empörung über windige Geschäftsleute, Kriegsgewinnler und auf ihren persönlichen Vorteil bedachte Landwirte mischten sich daher rasch andere Vorurteile.“"
                            },
                            {
                                "example_id": "efe7b1b6-cfd0-411a-ac79-6a73599853bc",
                                "sense_id": "0f5fbea8-4c2b-369d-8787-9900fed2e6e9",
                                "text": "„Erich, der Lieblingssohn, gerät in schlechte Gesellschaft, wird Kriegsgewinnler, die Lieblingstochter Eva Geliebte eines Verbrechers, der sie auf den Strich schickt und auf jede nur erdenkliche Weise demütigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
