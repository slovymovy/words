                ],
                "senses": [
                    {
                        "sense_id": "280b51ef-df9c-3403-aafd-242fdbaa35d3",
                        "entry_id": "85cd59dc-8edc-342f-a8e9-b3ed92d52827",
                        "glosses": [
                            "neerslachtig en lusteloos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6efc02b4-26e0-499f-bca0-8f24fb34e35d",
                                "sense_id": "280b51ef-df9c-3403-aafd-242fdbaa35d3",
                                "text": "Die man is erg depressief na het overlijden van zijn vrouw en kinderen."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6946935-2b6a-376c-b1c2-74860b2e39e3",
                        "entry_id": "85cd59dc-8edc-342f-a8e9-b3ed92d52827",
                        "glosses": [
                            "aan een depressie lijdend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06153220-11ee-4722-933f-4b6057092081",
                                "sense_id": "d6946935-2b6a-376c-b1c2-74860b2e39e3",
                                "text": "Meer dan een derde promovendi UvA mogelijk klinisch depressief"
                            },
                            {
                                "example_id": "75725ae4-d964-4276-9575-d587aa398d71",
                                "sense_id": "d6946935-2b6a-376c-b1c2-74860b2e39e3",
                                "text": "Zodoende kwam Plinius weer uit mijn kast, een opgewekt verteld avonturenverhaal over een pinguïn die al op zijn derde depressief is."
                            }
                        ]
                    },
                    {
                        "sense_id": "48712ff7-166f-3642-973f-2c61efd0fa45",
                        "entry_id": "85cd59dc-8edc-342f-a8e9-b3ed92d52827",
                        "glosses": [
                            "te maken hebbend met een gebied van lage luchtdruk"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "276d0a2c-cce8-476f-ad4d-e8cbff16ecf0",
                        "source_entry_id": "85cd59dc-8edc-342f-a8e9-b3ed92d52827",
                        "target_lang_word": "dépressif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dépressif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8aa4c97-8721-3d4c-bd30-357074938224",
                                        "entry_id": "cdf6ff84-8ccf-34e1-ad52-2c7aa524f2b0",
                                        "glosses": [
                                            "Qui affaiblit, qui abat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97c77696-45c3-3b71-9a16-b2654b09724d",
                                        "entry_id": "cdf6ff84-8ccf-34e1-ad52-2c7aa524f2b0",
                                        "glosses": [
                                            "Qui présente les caractères de la dépression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bda1c9a7-6a5c-4372-b260-abbdf90afbeb",
                                                "sense_id": "97c77696-45c3-3b71-9a16-b2654b09724d",
                                                "text": "Le premier jour de cours notre professoresse, une Siennoise blonde d'une trentaine d'années, douce et au regard fuyant, un peu trop pressée, peut-être un rien dépressive, commença par nous demander de nous présenter en disant notre prénom, d'où nous venions et ce que nous avions pris ce matin-là pour le petit déjeuner."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dépressif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0da5a12f-dbf9-3876-9bdd-404b5d8aaaae",
                                        "entry_id": "c6c98624-4c06-36f1-94b3-d8f41da5544f",
                                        "glosses": [
                                            "Celui qui est atteint d’un état dépressif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "114c093b-0cb6-4a61-9303-70c263f66c95",
                                                "sense_id": "0da5a12f-dbf9-3876-9bdd-404b5d8aaaae",
                                                "text": "Un dépressif a une représentation négative de lui-même, du monde, de son avenir."
                                            },
                                            {
                                                "example_id": "030cf410-a661-407d-87fa-86867444694f",
                                                "sense_id": "0da5a12f-dbf9-3876-9bdd-404b5d8aaaae",
                                                "text": "Mais, si ce critère rorschachien est intéressant pour alerter le praticien qui travaille avec un dépressif sur un éventuel risque suicidaire pour son patient, il ne saurait servir de mesure d’un suicide à venir."
                                            },
                                            {
                                                "example_id": "119bbe87-1344-4683-af8d-466e98ae441b",
                                                "sense_id": "0da5a12f-dbf9-3876-9bdd-404b5d8aaaae",
                                                "text": "Les dépressifs qui souhaitent s’isoler, passer quelques mois dans les bois pour « faire le point avec eux-mêmes », ça ne doit pas manquer ; mais des gens qui acceptent sans sourciller de se couper d’Internet pour un temps indéfini, c’est qu’ils filent un bien mauvais coton."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "baa62a94-e722-4397-b666-21d03d986ef1",
                        "source_entry_id": "85cd59dc-8edc-342f-a8e9-b3ed92d52827",
                        "target_lang_word": "depresivo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "depresivo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e8376ab4-4c58-327d-aa2d-acbe2ab2c4aa",
                                        "entry_id": "2fad69b8-3e0d-3a1f-be01-51ea1dac4906",
                                        "glosses": [
                                            "Dicho de algo: Que deprime."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "31844ecd-2826-3914-8ca7-3b8c29bf0c7e",
                                        "entry_id": "2fad69b8-3e0d-3a1f-be01-51ea1dac4906",
                                        "glosses": [
                                            "Dicho de algo: Que se vincula con la depresión."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc7eb8ec-459c-4106-aa2c-f8808385f635",
                                                "sense_id": "31844ecd-2826-3914-8ca7-3b8c29bf0c7e",
                                                "text": "«Coincidían en un rasgo levemente depresivo»."
                                            },
                                            {
                                                "example_id": "fa5d699a-91c9-431c-84d0-10ff0e77150c",
                                                "sense_id": "31844ecd-2826-3914-8ca7-3b8c29bf0c7e",
                                                "text": "«Todavía no ha surgido el profeta de esta disciplina, aquel que explique convincentemente el porqué de los estados depresivos, la causa de las obsesiones y del miedo irracional; (…)»."
                                            },
                                            {
                                                "example_id": "2d58a16c-2be8-40c6-8974-7f7bcfd211ee",
                                                "sense_id": "31844ecd-2826-3914-8ca7-3b8c29bf0c7e",
                                                "text": "«Actividad biológica: está muy documentado el efecto de los alcaloides tropánicos, pues la escopolamina tiene efectos depresivos sobre el sistema nervioso central»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7926aa75-be48-35f6-83e4-fb70d1152e85",
                                        "entry_id": "2fad69b8-3e0d-3a1f-be01-51ea1dac4906",
                                        "glosses": [
                                            "Dicho de una persona: Que está atravesando por un episodio de depresión. Asimismo, se dice de su carácter: Débil, que es o está más propenso a padecerla."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05d3b819-1005-4699-9788-06cb7d9f21ae",
                                                "sense_id": "7926aa75-be48-35f6-83e4-fb70d1152e85",
                                                "text": "«Eso sin tener en cuenta que vuelve tarde a casa, está desquiciada, estresada, a veces depresiva, a veces histérica, y tan neurasténica que ya no aguanta a los niños, por no hablar del odio larvado que empieza a incubar contra su marido»."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
