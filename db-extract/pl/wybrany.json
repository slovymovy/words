                                    {
                                        "sense_id": "ea115905-92e3-3c93-bd1f-a4f415928dfe",
                                        "entry_id": "9cb4bfe2-8921-329b-873c-a961a9f67bf4",
                                        "glosses": [
                                            "fine; spruce; smart; precise; dainty"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edffdc6e-46c8-4e6c-89a0-3af595455f98",
                                                "sense_id": "ea115905-92e3-3c93-bd1f-a4f415928dfe",
                                                "text": "He is too / picked, too spruce, too affected, too odd, as it were, / too peregrinate, as I may call it."
                                            },
                                            {
                                                "example_id": "43ee017e-bfdf-4321-8828-c20cd976172d",
                                                "sense_id": "ea115905-92e3-3c93-bd1f-a4f415928dfe",
                                                "text": "Why then I suck my teeth and catechize / My picked man of countries:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf31b596-7ea6-3dc4-9678-05c03f3366e1",
                                        "entry_id": "9cb4bfe2-8921-329b-873c-a961a9f67bf4",
                                        "glosses": [
                                            "pointed; sharp"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6c7a35e-698f-4ded-be4d-37bd6deaf76b",
                                                "sense_id": "cf31b596-7ea6-3dc4-9678-05c03f3366e1",
                                                "text": "[…] an useful bow a skilful bowyer wrought, / Which picked and polished both the ends he hid with horns of gold."
                                            },
                                            {
                                                "example_id": "3374a4b0-81ed-439d-8ff1-e2dc4df096c7",
                                                "sense_id": "cf31b596-7ea6-3dc4-9678-05c03f3366e1",
                                                "text": "A very good way to take them, is to drive a stake into the ground about four foot high above the surface of the earth: Let the stake be made picked at the top, that the jay may not settle on it."
                                            }
                                        ]
                                    }
