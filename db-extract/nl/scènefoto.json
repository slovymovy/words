                        "examples": [
                            {
                                "example_id": "c059eff4-99ae-4441-a589-aec80682e644",
                                "sense_id": "b5df41c2-9ebd-3e12-b9c0-6c87800056ac",
                                "text": "De eerste scènefoto's van Scarlett Johansson in de tweede Ironman-film zijn uit. En we zien de actrice als roodharige heldin."
                            },
                            {
                                "example_id": "e73cd855-f1eb-4f9e-a843-ad183afceca4",
                                "sense_id": "b5df41c2-9ebd-3e12-b9c0-6c87800056ac",
                                "text": "De eerste kus die Luisa, gespeeld door Michelle Splietelhof, krijgt van Zorro smaakt zichtbaar naar meer. Dit zijn de eerste scènefoto’s van de musical over de gemaskerde held, die zondag in het Amsterdamse DeLaMar de première beleeft."
                            },
                            {
                                "example_id": "01001b6f-dbcc-4a0e-87d3-947a0b7b246d",
                                "sense_id": "b5df41c2-9ebd-3e12-b9c0-6c87800056ac",
                                "text": "De Nikon Theaterfotografieprijs 2016 is gewonnen door Erik Franssen voor zijn serie scènefoto’s van de jeugdtheatervoorstelling Oma mag ik mijn pop terug van Theater Gnaffel. Hij mocht de prijs gisteravond in de Stadsschouwburg Amsterdam in ontvangst nemen."
                            }
                        ]
                    }
