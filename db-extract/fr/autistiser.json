                "senses": [
                    {
                        "sense_id": "778c8fa0-f373-39d9-9ee2-50d2aa50e902",
                        "entry_id": "df8d86c5-8007-3bd9-98b0-3221c1bb3859",
                        "glosses": [
                            "Donner un caractère autistique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7200dfd5-9356-40fd-8ca9-f5b2a23eb13d",
                                "sense_id": "778c8fa0-f373-39d9-9ee2-50d2aa50e902",
                                "text": "Le deuil, la mort \"autistise\"…"
                            },
                            {
                                "example_id": "fdf764f1-2c71-4594-b96a-3f411829f292",
                                "sense_id": "778c8fa0-f373-39d9-9ee2-50d2aa50e902",
                                "text": "Mais l’auteur n’est pas dupe du fait que cet investissement de la théorie peut s’autistiser, s’obsessionnaliser ou encore se fétichiser dans un dogmatisme stérile, d’où une plaidoirie pour des modèles inachevés, incomplets constituant une imagerie d’accueil, une disposition à imaginer, aidant les patients à investir positivement leurs propres processus psychiques."
                            }
                        ]
                    }
