{
    "word_family": [
        "gawper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b3cd9f9-9c10-3737-9171-f7637c5b139e",
                    "sense_definition": "To stare in a rude, open-mouthed, or unintelligent manner.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "staring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not just stand there <w>gawping</w> at the accident while others try to help.",
                            "target_lang_translations": {
                                "zh": "别站在那儿对着事故现场<w>呆看</w>，别人都在帮忙呢。"
                            }
                        },
                        {
                            "text": "The tourists <w>gawped</w> at the famous monument with their mouths wide open.",
                            "target_lang_translations": {
                                "zh": "游客们张大嘴巴，对着那座著名纪念碑<w>傻看</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gawk",
                        "stare"
                    ],
                    "common_phrases": [
                        "stand gawping"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指无礼地、张着嘴或呆头呆脑地盯着看。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "呆看",
                                "target_lang_sense_clarification": "形容呆滞地盯着看。"
                            },
                            {
                                "target_lang_word": "傻看",
                                "target_lang_sense_clarification": "形容像傻瓜一样盯着看。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "32e0ad4c-4aab-367c-905a-89bf3822c7fc",
                    "sense_definition": "A long, rude, or vacant stare.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "staring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took a long <w>gawp</w> at the strange machine before deciding to touch it.",
                            "target_lang_translations": {
                                "zh": "他对着那台奇怪的机器<w>呆视</w>了半天，才决定去碰它。"
                            }
                        },
                        {
                            "text": "The crowd had a collective <w>gawp</w> at the celebrity walking down the street.",
                            "target_lang_translations": {
                                "zh": "人群对着走在街上的那位名人进行了一次集体<w>傻盯</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stare"
                    ],
                    "common_phrases": [
                        "have a gawp"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指无礼的、呆滞的长时间凝视。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "呆视",
                                "target_lang_sense_clarification": "指呆滞的凝视。"
                            },
                            {
                                "target_lang_word": "傻盯",
                                "target_lang_sense_clarification": "指无礼或愚笨的长时间注视。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}