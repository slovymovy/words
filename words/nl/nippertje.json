            "senses": [
                {
                    "sense_id": "f592396a-a480-3a31-8114-3c3a60b0b792",
                    "sense_definition": "het allerlaatste moment waarop iets nog net kan gebeuren",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We haalden de trein gelukkig nog net op het <w>nippertje</w>.",
                            "target_lang_translations": {
                                "en": "Fortunately, we caught the train just in the <w>nick of time</w>."
                            }
                        },
                        {
                            "text": "Het was een spannend moment, maar op het <w>nippertje</w> ging het doelpunt toch door.",
                            "target_lang_translations": {
                                "en": "It was a tense moment, but at the <w>last minute</w> the goal was allowed after all."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "op het nippertje"
                    ],
                    "target_lang_definitions": {
                        "en": "the very last moment at which something can still happen"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "the nick of time",
                                "target_lang_sense_clarification": "just before it is too late"
                            },
                            {
                                "target_lang_word": "the last minute",
                                "target_lang_sense_clarification": "at the latest possible time"
                            },
                            {
                                "target_lang_word": "the skin of one's teeth",
                                "target_lang_sense_clarification": "by a very narrow margin"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "199da164-0119-3c32-ac9e-cb3683cd4104",
                    "sense_definition": "een verkleinvorm van <w>nipper</w>, iemand die met zeer kleine slokjes drinkt",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kleine <w>nippertje</w> genoot zichtbaar van zijn eerste glaasje limonade.",
                            "target_lang_translations": {
                                "en": "The little <w>sipper</w> clearly enjoyed his first glass of lemonade."
                            }
                        },
                        {
                            "text": "Zij staat bekend als een echt <w>nippertje</w> en doet uren over één kopje thee.",
                            "target_lang_translations": {
                                "en": "She is known as a real <w>sipper</w> and takes hours to finish one cup of tea."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a diminutive form of 'nipper', referring to someone who drinks in very small sips"
                    },
                    "translations": {
