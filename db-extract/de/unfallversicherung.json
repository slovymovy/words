                ],
                "senses": [
                    {
                        "sense_id": "bc12d2c3-4271-34e4-a952-4215dbcb0a33",
                        "entry_id": "81bc876d-b978-318c-a84d-b467f8c9c2ef",
                        "glosses": [
                            "gesetzliche oder private Versicherung, die durch einen Unfall entstandene Schäden ausgleicht; im deutschen Sprachraum bei Arbeitnehmern als Pflichtversicherung ausgestaltet, die bei Arbeitsunfällen und Berufskrankheiten Krankenbehandlung und Lohnersatzleistungen erbringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d603e5a8-ac40-410f-a514-5eb92d80de76",
                                "sense_id": "bc12d2c3-4271-34e4-a952-4215dbcb0a33",
                                "text": "Die gewerblichen Berufsgenossenschaften sind Träger der gesetzlichen Unfallversicherung."
                            },
                            {
                                "example_id": "0921fc70-f16c-4e28-86a9-73f4731c23b2",
                                "sense_id": "bc12d2c3-4271-34e4-a952-4215dbcb0a33",
                                "text": "„Auch eine Unfallversicherung kann sinnvoll sein, für extravagante Hobbys wie Fallschirmspringen oder Extrembergsteigen sind allerdings Zusatzdeckungen erforderlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "be980ae3-c00d-37c2-a214-0e163c6d4d8d",
                        "entry_id": "81bc876d-b978-318c-a84d-b467f8c9c2ef",
                        "glosses": [
                            "Träger der Unfallversicherung: Einrichtung der gesetzlichen Sozialversicherung oder privates Versicherungsunternehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8be3d156-3855-42f2-9f1f-5add40773f8c",
                                "sense_id": "be980ae3-c00d-37c2-a214-0e163c6d4d8d",
                                "text": "„Eine Unfallversicherung zahlt bei Invalidität auch dann, wenn sie nicht gleichzeitig auch zu einer Berufsunfähigkeit führt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
