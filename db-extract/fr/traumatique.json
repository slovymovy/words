                "forms": [
                    {
                        "form_id": "a7d63b72-5be7-4c32-97af-b53e5f1f7cf1",
                        "entry_id": "e969d5cd-e57c-3156-84e0-bcaca6c91dee",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
