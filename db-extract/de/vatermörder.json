                        "tags": [],
                        "examples": [
                            {
                                "example_id": "512da06b-4e09-4fd9-a387-26fc870d4cde",
                                "sense_id": "efc5bb19-a03c-366f-95df-45a8aaf67806",
                                "text": "Ödipus wurde, ohne es zu wissen, zum Vatermörder."
                            },
                            {
                                "example_id": "432fc01d-42be-45d8-8756-db890b143a14",
                                "sense_id": "efc5bb19-a03c-366f-95df-45a8aaf67806",
                                "text": "„Er wusste, dass Sunkan die Tochter seines Vorgängers Pastor Krogh war, und genau wie andere auf der Insel Suduroy hatte er die Gerüchte über den Vatermörder von Sumba gehört.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1c1af3d9-1054-3164-bd68-db2c677f0af9",
                        "entry_id": "cadaafe1-19ca-3f7f-bea9-56f31195f6ad",
                        "glosses": [
                            "hoher Stehkragen an Herrenhemden (im 19. Jahrhundert in Mode)"
                        ],
                        "tags": [
                            "figurative",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "abc524a7-b200-4e72-9e38-7a45dcf28317",
                                "sense_id": "1c1af3d9-1054-3164-bd68-db2c677f0af9",
                                "text": "„Vatermörder werden heutzutage fast nur bei besonders festlichen Gelegenheiten in Verbindung mit einem Frack oder Smoking getragen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
