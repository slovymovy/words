                    },
                    {
                        "translation_id": "f354fa34-e23f-47a9-b234-fcc9d4016377",
                        "source_entry_id": "49987c63-0c3c-32a4-8808-2308b2b7a816",
                        "source_sense_id": "d4f94a54-d299-3030-a177-7009e8ff8034",
                        "source_sense_description": "een persoon op een doorgaans vriendelijke en vrijblijvende manier vragen om iets te doen",
                        "target_lang_word": "invite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "invite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cc0fd3d-4bad-3db4-8fb5-05e429bf491c",
                                        "entry_id": "58b77b47-d564-3b18-a92c-b45a8ccfabdf",
                                        "glosses": [
                                            "An invitation."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfd580bb-a530-45ec-b287-5a4c5b946496",
                                                "sense_id": "2cc0fd3d-4bad-3db4-8fb5-05e429bf491c",
                                                "text": "An open invite has been given to all UK workers to join in common cause with the union, as more than 40,000 RMT members at Network Rail and 13 train operating companies walked out on June 21 in the first of three 24-hour strikes over pay, conditions and job security."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "invite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d7393b7-e580-3e5e-905c-6a53b1b98123",
                                        "entry_id": "424cd790-eed2-369d-a9f9-4d0b8b52aa6b",
                                        "glosses": [
                                            "To ask for the presence or participation of someone or something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3376d9ff-33c1-4455-84a3-127b594e814c",
                                                "sense_id": "9d7393b7-e580-3e5e-905c-6a53b1b98123",
                                                "text": "We invited our friends round for dinner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a069eeb-5cdc-3176-b865-e40232a03748",
                                        "entry_id": "424cd790-eed2-369d-a9f9-4d0b8b52aa6b",
                                        "glosses": [
                                            "To request formally."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3aad3d1a-e365-4b53-b70d-4a1413518601",
                                                "sense_id": "0a069eeb-5cdc-3176-b865-e40232a03748",
                                                "text": "I invite you all to be seated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fcedb81-944e-37da-8a0d-e69851494125",
                                        "entry_id": "424cd790-eed2-369d-a9f9-4d0b8b52aa6b",
                                        "glosses": [
                                            "To encourage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fafea13-3763-473a-ba03-817e99dd19f9",
                                                "sense_id": "0fcedb81-944e-37da-8a0d-e69851494125",
                                                "text": "I always invite criticism of my definitions."
                                            },
                                            {
                                                "example_id": "1ff56555-7a8d-497d-8f7b-46d66e01e280",
                                                "sense_id": "0fcedb81-944e-37da-8a0d-e69851494125",
                                                "text": "Wearing that skimpy dress, you are bound to invite attention."
                                            },
                                            {
                                                "example_id": "342b1c2d-a334-4a97-a86b-063914326e5b",
                                                "sense_id": "0fcedb81-944e-37da-8a0d-e69851494125",
                                                "text": "The refusal to maintain such a navy would invite trouble, and if trouble came would insure disaster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "614fdba7-1579-3ee4-b07d-5f04f7688ccd",
                                        "entry_id": "424cd790-eed2-369d-a9f9-4d0b8b52aa6b",
                                        "glosses": [
                                            "To allure; to draw to; to tempt to come; to induce by pleasure or hope; to attract."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7361286b-817e-45a9-abe1-07ea151c7029",
                                                "sense_id": "614fdba7-1579-3ee4-b07d-5f04f7688ccd",
                                                "text": "to inveigle and invite th' unwary sense",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            },
                                            {
                                                "example_id": "09cc987b-f370-403c-980c-6c1ddb3058ce",
                                                "sense_id": "614fdba7-1579-3ee4-b07d-5f04f7688ccd",
                                                "text": "shady groves, that easy sleep invite"
                                            },
                                            {
                                                "example_id": "44803876-aa43-42f6-b189-6396c9c03cc0",
                                                "sense_id": "614fdba7-1579-3ee4-b07d-5f04f7688ccd",
                                                "text": "There no delusive hope invites despair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2d7618f-1d81-45c9-bd84-e40028479a1c",
                        "source_entry_id": "49987c63-0c3c-32a4-8808-2308b2b7a816",
                        "source_sense_id": "d4f94a54-d299-3030-a177-7009e8ff8034",
                        "source_sense_description": "een persoon op een doorgaans vriendelijke en vrijblijvende manier vragen om iets te doen",
                        "target_lang_word": "inviter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inviter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16851d0c-0020-3498-9941-d62ca30627b5",
                                        "entry_id": "932cf4ad-79d2-3d92-a892-f1e26c855c23",
                                        "glosses": [
                                            "Convier, prier de se trouver, de se rendre quelque part, d’assister à quelque cérémonie, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "498a1804-b604-4912-84ab-7787a2157fa3",
                                                "sense_id": "16851d0c-0020-3498-9941-d62ca30627b5",
                                                "text": "De son chef, il descendait à la cave, remontait litres et carafes, invitait les amis qui passaient, même le gros Zidore, et cela se terminait habituellement par une cuite générale, dans laquelle tous roulaient sous la table."
                                            },
                                            {
                                                "example_id": "a7e5fe08-7566-4f17-b1f3-433e763b48d0",
                                                "sense_id": "16851d0c-0020-3498-9941-d62ca30627b5",
                                                "text": "Est-ce toi qui lui as demandé s'il prenait du homard ou du carré d’agneau ? Non. Tu l’as invité à dîner et tu lui as fait servir quatre ou cinq plats, sans t'occuper un seul instant de ce qu'il pouvait ou non aimer, […]."
                                            },
                                            {
                                                "example_id": "6d5c6109-2238-4db9-9fb2-18b7468fe7aa",
                                                "sense_id": "16851d0c-0020-3498-9941-d62ca30627b5",
                                                "text": "Antoine fit une valse avec Charlotte, ce qui l'étourdit passablement car il en avait perdu l'habitude. La jeune espagnole, elle, fit tapisserie pendant un moment : les jeunes hommes du village n'osaient pas l’inviter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "703950c6-b80c-39f0-a122-250db30b58e9",
                                        "entry_id": "932cf4ad-79d2-3d92-a892-f1e26c855c23",
                                        "glosses": [
                                            "Engager, exciter à quelque chose."
                                        ],
                                        "tags": [
                                            "Plus généralement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1bb5b6f-14b6-473f-8ca4-cda3d3416c6b",
                                                "sense_id": "703950c6-b80c-39f0-a122-250db30b58e9",
                                                "text": "Elle le salua sans lui parler, une simple inclination, un signe de sa main l’invitèrent à s’asseoir […]"
                                            },
                                            {
                                                "example_id": "0f381327-3bcf-425f-a930-15fcfd87a82d",
                                                "sense_id": "703950c6-b80c-39f0-a122-250db30b58e9",
                                                "text": "Il faisait froid et pleuvait. Rattner et moi, empaquetés dans nos pardessus, nous l’invitions à remuer."
                                            },
                                            {
                                                "example_id": "c677796b-52e2-473d-b484-a85812d03deb",
                                                "sense_id": "703950c6-b80c-39f0-a122-250db30b58e9",
                                                "text": "Le beau temps nous invite à la promenade. — La raison, le devoir, l’honneur vous invitent à faire cette démarche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8ebac55-20c3-34c0-9675-25f20fe84937",
                                        "entry_id": "932cf4ad-79d2-3d92-a892-f1e26c855c23",
                                        "glosses": [
                                            "Enjoindre à quelqu’un de faire une chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd1c44ce-4bc6-40e8-99f9-e651f7a08918",
                                                "sense_id": "c8ebac55-20c3-34c0-9675-25f20fe84937",
                                                "text": "On l’invita à sortir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9de51e50-b976-3b08-bab1-04db9a38e377",
                                        "entry_id": "932cf4ad-79d2-3d92-a892-f1e26c855c23",
                                        "glosses": [
                                            "Venir sans y être convié"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75d72f50-d162-4eb5-a59d-0828d6a5533f",
                                                "sense_id": "9de51e50-b976-3b08-bab1-04db9a38e377",
                                                "text": "C’est lui-même qui s’est invité."
                                            },
                                            {
                                                "example_id": "18f137a1-ace0-4020-99b5-28c4ed4f0e25",
                                                "sense_id": "9de51e50-b976-3b08-bab1-04db9a38e377",
                                                "text": "Ils s’invitent tour à tour à de petites réunions de famille."
                                            },
                                            {
                                                "example_id": "f3e49bfc-9e14-47e5-82bd-ed568e8a85f4",
                                                "sense_id": "9de51e50-b976-3b08-bab1-04db9a38e377",
                                                "text": "Il y avait, ce matin-là, comme presque tous les jours, déjeuner intime chez les Duvillard, quelques amis qui s’invitaient plus qu’on ne les invitait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "873ab614-e449-3360-80c5-e163dbc362b3",
                                        "entry_id": "932cf4ad-79d2-3d92-a892-f1e26c855c23",
                                        "glosses": [
                                            "S'imposer comme matière de discussion, de débat dans un contexte donné; se dit d'un sujet, d'un enjeu."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ec9a6d8-5481-40e3-8ae8-742e74bfb542",
                                                "sense_id": "873ab614-e449-3360-80c5-e163dbc362b3",
                                                "text": "Le projet de terminal de conteneurs de Ray-Mont Logistiques, dans Hochelaga, s’invite dans la campagne fédérale. Alors que libéraux, bloquistes et néo-démocrates se feront encore cette année une chaude lutte dans le secteur, chaque candidat s’entend pour dire qu’il faudra au minimum développer le dossier autrement."
                                            }
                                        ]
