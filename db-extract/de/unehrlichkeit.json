                    {
                        "form_id": "272d6b1f-e161-44f8-9f8f-21793d322bc7",
                        "entry_id": "2408bf06-0191-382a-a1fe-d97113f7b79b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Unehrlichkeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fea80c5e-24b7-38f0-b864-7131af79fa14",
                        "entry_id": "2408bf06-0191-382a-a1fe-d97113f7b79b",
                        "glosses": [
                            "Neigung zu Diebstahl und/oder Lüge"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "70dfd679-1778-4a53-9f89-f6d7a0f04030",
                                "sense_id": "fea80c5e-24b7-38f0-b864-7131af79fa14",
                                "text": "Unehrlichkeit zerstört Vertrauen."
                            },
                            {
                                "example_id": "e73455d9-fada-46d6-a3e8-6314e10ed269",
                                "sense_id": "fea80c5e-24b7-38f0-b864-7131af79fa14",
                                "text": "„So viel Leid und Unglück, so viel Angst und Verwirrung kommen aus der Unehrlichkeit.“"
                            },
                            {
                                "example_id": "f1283a6d-b979-4cba-9c74-2b6329f8a678",
                                "sense_id": "fea80c5e-24b7-38f0-b864-7131af79fa14",
                                "text": "„Eine spezielle Form, sich zu öffnen, ist die Ehrlichkeit, denn Unehrlichkeit ist nichts anderes als ein Verbergen eines Teils von sich selbst, ein absichtliches Verbergen von Wissen, ein Vorspiegeln falscher Tatsachen.“"
                            },
                            {
                                "example_id": "bea1f83b-b5ea-4498-83ef-db22399f914b",
                                "sense_id": "fea80c5e-24b7-38f0-b864-7131af79fa14",
                                "text": "„Das Gegenteil von Ehrlichkeit ist die Unehrlichkeit, also die Lüge, die heute leider weit verbreitet ist.“"
                            },
                            {
                                "example_id": "c35727e9-61ea-4aec-ad5a-d5365027d2ed",
                                "sense_id": "fea80c5e-24b7-38f0-b864-7131af79fa14",
                                "text": "„Im konkreten Fall beklagt die Erzählerin die Unehrlichkeit der Erwachsenenwelt, welche die Wahrheit verschweigt und Dinge beschönigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "69075033-4860-38db-ab49-e094d84feb25",
                        "entry_id": "2408bf06-0191-382a-a1fe-d97113f7b79b",
                        "glosses": [
                            "die vom Mittelalter bis ins 19. Jahrhundert mit gewissen Gewerben und Stellungen verknüpfte Unfähigkeit, Ehrenämter und Standesrechte ein- beziehungsweise wahrzunehmen (was zum Beispiel uneheliche Kinder, Verbrecher, Dirnen, Wucherer, Henker, später auch Weber, Schäfer und Schinder betrifft)"
                        ],
                        "tags": [
                            "Plural selten",
                            "ursprünglich"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62f64c0f-5c69-404d-a149-70a41bc36942",
                        "source_entry_id": "2408bf06-0191-382a-a1fe-d97113f7b79b",
                        "source_sense_id": "fea80c5e-24b7-38f0-b864-7131af79fa14",
                        "source_sense_description": "Neigung zu Diebstahl und/oder Lüge",
                        "target_lang_word": "dishonesty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dishonesty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a3681b5-e11a-3e7f-9519-a9ced34fc7ea",
                                        "entry_id": "9e6f0a28-37ef-3791-a82b-8ae628d5c7f6",
                                        "glosses": [
                                            "The characteristic or condition of being dishonest."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57c35632-1b16-4be0-b2c2-00f8514b5cd1",
                                                "sense_id": "4a3681b5-e11a-3e7f-9519-a9ced34fc7ea",
                                                "text": "He added: \"We've always had spin, especially from Government. But this is not spin. This is dishonesty and so it's our rail media's urgent responsibility to call it out because non-specialist journalists across the country will report this and gradually these untruths will be accepted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44fabefc-4972-385c-8c88-5969c298a181",
                                        "entry_id": "9e6f0a28-37ef-3791-a82b-8ae628d5c7f6",
                                        "glosses": [
                                            "An act which is fraudulent or otherwise dishonest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "118ba350-c419-3698-b89e-bc352b96fa6b",
                                        "entry_id": "9e6f0a28-37ef-3791-a82b-8ae628d5c7f6",
                                        "glosses": [
                                            "Shamefulness, disgrace."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6965eca5-a99e-4685-b9eb-54d76a7886a2",
                                                "sense_id": "118ba350-c419-3698-b89e-bc352b96fa6b",
                                                "text": "His dishonesty appears in leaving his friend here in necessity and denying him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91f19bd1-07be-44dd-9dc4-d52fb16ed32e",
                        "source_entry_id": "2408bf06-0191-382a-a1fe-d97113f7b79b",
                        "source_sense_id": "fea80c5e-24b7-38f0-b864-7131af79fa14",
                        "source_sense_description": "Neigung zu Diebstahl und/oder Lüge",
                        "target_lang_word": "improbité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "improbité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc3a7511-9342-3d76-bf57-66e69947a19b",
                                        "entry_id": "fd271189-22c5-3905-b4ca-a4842fa3819f",
                                        "glosses": [
                                            "Défaut de probité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1df2ea1-9351-4f4c-918c-425c81208b64",
                                                "sense_id": "cc3a7511-9342-3d76-bf57-66e69947a19b",
                                                "text": "Ils croient la faveur chose toute naturelle, et aussi l’improbité ; on a copié effrontément dans le Centre ; mes collègues me disent que de tout temps le Midi s’est montré moins loyal dans les compositions que le Nord. — C’est une tradition en France ; sous l’ancienne monarchie, il fallait aller solliciter les juges."
                                            },
                                            {
                                                "example_id": "0a48e0a0-8af8-4518-9898-0e47c22eb502",
                                                "sense_id": "cc3a7511-9342-3d76-bf57-66e69947a19b",
                                                "text": "Et, chez cet homme instruit, affiné, dont la vie de mystère cachait peut-être des crimes, mais pas un acte d’improbité basse, on sentait un théoricien implacable, têtu, résolu à mettre le feu au monde, pour le triomphe de l’idée."
                                            },
                                            {
                                                "example_id": "4484ff2a-7d69-494c-8761-8c3e6645714b",
                                                "sense_id": "cc3a7511-9342-3d76-bf57-66e69947a19b",
                                                "text": "Dans le monde catholique règne donc une improbité générale, qui conduit les dévots à supposer que les relations économiques dépendent principalement des gens qui tiennent la caisse."
                                            },
                                            {
                                                "example_id": "1474b111-8092-422b-8598-6339b9b3ae31",
                                                "sense_id": "cc3a7511-9342-3d76-bf57-66e69947a19b",
                                                "text": "[…] : une grande banque catholique, l'Union Générale venait de sombrer dans la banqueroute. Cette déconfiture était due à des folles spéculations, aux fautes et même à l'improbité de ses dirigeants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38f10377-f4f9-463c-897c-1dfe544ef258",
                        "source_entry_id": "2408bf06-0191-382a-a1fe-d97113f7b79b",
                        "source_sense_id": "fea80c5e-24b7-38f0-b864-7131af79fa14",
                        "source_sense_description": "Neigung zu Diebstahl und/oder Lüge",
                        "target_lang_word": "insincérité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insincérité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc6e9f72-85e8-3134-9834-95d7c407b9bc",
                                        "entry_id": "a12fee1b-4a9a-39de-8e43-bec477936797",
                                        "glosses": [
                                            "Caractère de celui ou de ce qui n'est pas sincère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c18f0820-bd6d-4602-83e5-3e5f8586cf6c",
                                                "sense_id": "fc6e9f72-85e8-3134-9834-95d7c407b9bc",
                                                "text": "L’excuse de l’insincérité, s’il faut lui en trouver une, c’est que le masque semble quelquefois comme de lui-même recouvrir le visage."
                                            },
                                            {
                                                "example_id": "642333f7-c7b1-459d-ba3c-4255084bbd74",
                                                "sense_id": "fc6e9f72-85e8-3134-9834-95d7c407b9bc",
                                                "text": "J’ai toujours professé que le désir de demeurer constant avec soi-même comportait trop souvent un risque d’insincérité ; […]"
                                            },
                                            {
                                                "example_id": "e9fba149-e71d-4d03-86d3-e57d3ade4551",
                                                "sense_id": "fc6e9f72-85e8-3134-9834-95d7c407b9bc",
                                                "text": "La platitude de mon style soulignait déplorablement l’insincérité de mes émois."
                                            },
                                            {
                                                "example_id": "8b487901-21be-4efb-baec-919ff48b8c0b",
                                                "sense_id": "fc6e9f72-85e8-3134-9834-95d7c407b9bc",
                                                "text": "Jusque dans le bluff, je restais un fort en thème ; je tiens aujourd’hui mes batelages pour des exercices spirituels et mon insincérité pour la caricature d’une sincérité totale qui me frôlait sans cesse et m’échappait."
                                            },
                                            {
                                                "example_id": "bce7d2f4-450e-49d6-8ffa-c42cfe89e87f",
                                                "sense_id": "fc6e9f72-85e8-3134-9834-95d7c407b9bc",
                                                "text": "Il était presque arrivé chez lui, que, pas encore dégrisé de sa douleur et de la verve d’insincérité dont les intonations menteuses, la sonorité artificielle de sa propre voix lui versaient d’instant en instant plus abondamment l’ivresse, il continuait encore à pérorer tout haut dans le silence de la nuit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
