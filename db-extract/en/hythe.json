                "senses": [
                    {
                        "sense_id": "495cbec1-2aa1-33af-9ddf-fae03e91cbee",
                        "entry_id": "68041b23-8125-321f-a895-d5e73f5d2372",
                        "glosses": [
                            "A landing-place in a river; a harbour or small port."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "76107623-2e6e-42b3-883c-5ddca117b92a",
                                "sense_id": "495cbec1-2aa1-33af-9ddf-fae03e91cbee",
                                "text": "That morn to other hythe we made our way / finding the peoples that before we found, / by a broad River, and we gave it name / from the high hol'iday when to port we came."
                            },
                            {
                                "example_id": "79ac528a-6a81-4063-b62f-24b9d8495b9e",
                                "sense_id": "495cbec1-2aa1-33af-9ddf-fae03e91cbee",
                                "text": "On the bank of the Silverlode, at some distance up from the meeting of the streams, there was a hythe of white stones and white wood. By it were moored many boats and barges."
                            }
                        ]
                    }
