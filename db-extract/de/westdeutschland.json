                "senses": [
                    {
                        "sense_id": "249f2763-474c-3ce2-8499-fba8bbd5ebce",
                        "entry_id": "9d1107e7-be03-3ed8-a492-121611cbf70e",
                        "glosses": [
                            "westlicher Teil Deutschlands"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ec972a3-6fff-4efe-a32d-44ba6857472b",
                                "sense_id": "249f2763-474c-3ce2-8499-fba8bbd5ebce",
                                "text": "Stammen deine Eltern aus Westdeutschland?"
                            },
                            {
                                "example_id": "585d299b-f4b1-4cd1-9ab0-6a72e528734e",
                                "sense_id": "249f2763-474c-3ce2-8499-fba8bbd5ebce",
                                "text": "„Seit den 1970er Jahren nimmt die Wahlbeteiligung in Westdeutschland kontinuierlich ab, auch Ostdeutschland folgt nun diesem Trend.“"
                            },
                            {
                                "example_id": "b1b35654-6baf-4f08-8f3d-518632e1859d",
                                "sense_id": "249f2763-474c-3ce2-8499-fba8bbd5ebce",
                                "text": "„Stuttgart zum Beispiel ist nicht weit von der deutschen Universitätsstadt Tübingen entfernt, die eines der Bildungszentren in Westdeutschland und der französischen Zone ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "98c5c64d-b988-3a8a-9c62-904f6b841311",
                        "entry_id": "9d1107e7-be03-3ed8-a492-121611cbf70e",
                        "glosses": [
                            "Bezeichnung für das Gebiet der Bundesrepublik Deutschland bis 1990, beziehungsweise für die alten Bundesländer"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5060f4df-c128-4b3f-aba2-751ba2fa215b",
                                "sense_id": "98c5c64d-b988-3a8a-9c62-904f6b841311",
                                "text": "Merkel hatte in einem Interview dem Magazin Cicero gesagt, dass nun nach fast 20 Jahren der Ost-Förderung zusätzliche Investitionen gezielt nach Westdeutschland fließen sollten."
                            },
                            {
                                "example_id": "785a9fbb-5f3e-4e47-a9f4-4c81f7175eb1",
                                "sense_id": "98c5c64d-b988-3a8a-9c62-904f6b841311",
                                "text": "Während die Bundesregierung für Westdeutschland ein Rückgang der Wirtschaftsleistung um sechs Prozent erwartet, wird für den Osten nur ein Minus um fünf Prozent prognostiziert."
                            },
                            {
                                "example_id": "f48c3991-7e94-43d9-8046-fc32828b945e",
                                "sense_id": "98c5c64d-b988-3a8a-9c62-904f6b841311",
                                "text": "„Da sie in Westdeutschland wohnt, wird die Ausreise der Kinder allerdings noch einige Zeit in Anspruch nehmen.“"
                            },
                            {
                                "example_id": "8c7139e6-1af7-4943-bb62-d4bfde59e33b",
                                "sense_id": "98c5c64d-b988-3a8a-9c62-904f6b841311",
                                "text": "„Westdeutschland, die Bundesrepublik, war Fußballweltmeister, die DDR der Olympiasieger.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
