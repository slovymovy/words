                    "frequency": "Middle",
                    "semantic_group_id": "wieszak_tasiemka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mamo, urwał mi się <w>wieszak</w> od kurtki, mogłabyś go przyszyć?"
                        },
                        {
                            "text": "Ręcznik ma specjalny <w>wieszak</w>, dzięki któremu łatwo go powiesić."
