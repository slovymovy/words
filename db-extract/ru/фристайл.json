                "senses": [
                    {
                        "sense_id": "96c66a8e-0bdd-31be-9eb3-08fe04a7c863",
                        "entry_id": "37296003-f019-3ac6-a370-14a97b8e8a9f",
                        "glosses": [
                            "спорт. спортивная дисциплина (в различных видах спорта), в которой свободно выполняются элементы разной степени сложности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7d05388-97a7-4b88-9f57-2694081c15b7",
                                "sense_id": "96c66a8e-0bdd-31be-9eb3-08fe04a7c863",
                                "text": "Для организации судейства на соревнованиях по фристайлу привлекается не менее трёх судей (количество судей зависит от используемой системы судейства и формата соревнований), главный судья и руководитель службы статистики."
                            },
                            {
                                "example_id": "9f6bc849-b8fd-4912-9261-95284eb53aea",
                                "sense_id": "96c66a8e-0bdd-31be-9eb3-08fe04a7c863",
                                "text": "Ещё в одном новом виде спорта — фристайле — за нас выступят экс-белорусы Тимофей Сливец и его старшая сестра Ассоль."
                            }
                        ]
                    },
