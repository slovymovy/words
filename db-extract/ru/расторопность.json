                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lightness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57607f83-aef0-355a-a884-82f61fd50c87",
                                        "entry_id": "1a620645-2928-3c60-984f-6f7c0bb07463",
                                        "glosses": [
                                            "The state of having little (or less) weight, or little force."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "461240d4-1c6f-4e3e-b8fd-1249e0e31035",
                                                "sense_id": "57607f83-aef0-355a-a884-82f61fd50c87",
                                                "text": "The unique chassis design is largely the secret of the lightness of the locomotive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc5cb006-999b-3e77-b783-dd7837989054",
                                        "entry_id": "1a620645-2928-3c60-984f-6f7c0bb07463",
                                        "glosses": [
                                            "Agility of movement."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51c2c5d0-1280-3c8f-8057-9346828fe065",
                                        "entry_id": "1a620645-2928-3c60-984f-6f7c0bb07463",
                                        "glosses": [
                                            "Freedom from worry."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7a94d99-f0f8-43cf-96f5-8fc4ac2a9341",
                                                "sense_id": "51c2c5d0-1280-3c8f-8057-9346828fe065",
                                                "text": "In the lightness of my heart I sang catches of songs as my horse gayly bore me along the well-remembered road."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34fb85fc-917b-37b8-acbc-12667fcd7e5f",
                                        "entry_id": "1a620645-2928-3c60-984f-6f7c0bb07463",
                                        "glosses": [
                                            "Levity, frivolity; inconsistency."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a53823f-8f73-47b7-aa95-530a2d0110fa",
                                                "sense_id": "34fb85fc-917b-37b8-acbc-12667fcd7e5f",
                                                "text": "Seneca […] accounts it a filthy lightness in men, every day to lay new foundations of their life, but who doth otherwise?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2df225a-3b33-4a3f-adbd-e80f33643fdb",
                        "source_entry_id": "6f44b6fa-7ae9-34a1-932a-def32d765cb1",
                        "source_sense_id": "d95b1d79-1463-3d75-b810-ba3abf051a10",
                        "target_lang_word": "alacrity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alacrity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9375df45-fbd9-3ae8-ae64-41bd594c742f",
                                        "entry_id": "11c17f0d-e1f1-36b8-a44f-e48c80d6142e",
                                        "glosses": [
                                            "Eagerness; liveliness; enthusiasm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e97a375b-abdd-4b9f-b03c-40246169fe68",
                                                "sense_id": "9375df45-fbd9-3ae8-ae64-41bd594c742f",
                                                "text": "Besides, a wealthy man, well at ease, may pray to God quietly and merrily with alacrity and great quietness of mind, whereas he who lieth groaning in his grief cannot endure to pray nor can he hardly think upon anything but his pain."
                                            },
                                            {
                                                "example_id": "c28ea45e-c1fc-4903-bfd8-7f4c1c31ab50",
                                                "sense_id": "9375df45-fbd9-3ae8-ae64-41bd594c742f",
                                                "text": "I have not that alacrity of spirit / Nor cheer of mind that I was wont to have."
                                            },
                                            {
                                                "example_id": "dfb0cfc0-2378-40ea-bd38-af41c828442c",
                                                "sense_id": "9375df45-fbd9-3ae8-ae64-41bd594c742f",
                                                "text": "\"I'll get into the clothes this minute, if they're here,\" said Sam, with great alacrity."
                                            },
                                            {
                                                "example_id": "1fa0c88b-93dd-4b03-a50c-32c1e21bc68c",
                                                "sense_id": "9375df45-fbd9-3ae8-ae64-41bd594c742f",
                                                "text": "You have an overgrown alacrity\nFor saying nothing much and hearing less […]"
                                            },
                                            {
                                                "example_id": "04bc9594-512f-4c1c-a148-2d47ce60b6d5",
                                                "sense_id": "9375df45-fbd9-3ae8-ae64-41bd594c742f",
                                                "text": "This evening, however, he was struck by the beaming alacrity of the aide-de-camp's greeting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f37b3d6a-1a7a-3faf-aeb5-86e104e7e235",
                                        "entry_id": "11c17f0d-e1f1-36b8-a44f-e48c80d6142e",
                                        "glosses": [
                                            "Promptness; speed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88fd5672-6958-4451-a1d6-2cb65977e9a2",
                                                "sense_id": "f37b3d6a-1a7a-3faf-aeb5-86e104e7e235",
                                                "text": "Governments show thus how successfully men can be imposed on, even impose on themselves, for their own advantage. […] Yet this government never of itself furthered any enterprise, but by the alacrity with which it got out of its way."
                                            },
                                            {
                                                "example_id": "66a8aaf5-9aca-4d55-9bbc-f6d334c0a3ee",
                                                "sense_id": "f37b3d6a-1a7a-3faf-aeb5-86e104e7e235",
                                                "text": "He had a uniform jacket with one button off, and seeing a white man on the path, hoisted his weapon to his shoulder with alacrity."
                                            },
                                            {
                                                "example_id": "fec68568-756b-4dbd-b558-053f9ff3056c",
                                                "sense_id": "f37b3d6a-1a7a-3faf-aeb5-86e104e7e235",
                                                "text": "Not just that, but if the inlet of a turbopump impeller runs dry, it would overspeed with blinding alacrity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
