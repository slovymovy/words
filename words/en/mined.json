{
    "word_family": [
        "mine",
        "miner",
        "mining",
        "mineral"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b9a43c30-ec36-3527-b829-c6ad8bfec9e4",
                    "sense_definition": "Extracted from the earth or containing explosive devices.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extraction_and_explosives",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jewelry store sells both lab-grown and <w>mined</w> diamonds.",
                            "target_lang_translations": {
                                "cs": "Klenotnictví prodává jak laboratorně vypěstované, tak <w>vytěžené</w> diamanty."
                            }
                        },
                        {
                            "text": "The soldiers were warned to avoid the <w>mined</w> fields near the border.",
                            "target_lang_translations": {
                                "cs": "Vojáci byli varováni, aby se vyhnuli <w>zaminovaným</w> polím poblíž hranic."
                            }
                        }
                    ],
                    "antonyms": [
                        "unmined"
                    ],
                    "common_phrases": [
                        "heavily mined",
                        "mined diamonds"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vytěžený ze země nebo obsahující výbušná zařízení (miny)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vytěžený",
                                "target_lang_sense_clarification": "v kontextu surovin získaných ze země"
                            },
                            {
                                "target_lang_word": "zaminovaný",
                                "target_lang_sense_clarification": "v kontextu území obsahujícího výbušné miny"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e025df3b-b1b1-3042-8f1a-65e971cd2c93",
                    "sense_definition": "Simple past and past participle of <w>mine</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "extraction_and_explosives",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company <w>mined</w> coal in this region for over fifty years.",
                            "target_lang_translations": {
                                "cs": "Společnost v tomto regionu <w>těžila</w> uhlí více než padesát let."
                            }
                        },
                        {
                            "text": "The enemy had <w>mined</w> the harbor to prevent ships from entering.",
                            "target_lang_translations": {
                                "cs": "Nepřítel <w>zaminoval</w> přístav, aby zabránil vplutí lodí."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb mine."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Minulý čas a příčestí minulé slovesa těžit nebo klást miny."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "těžil",
                                "target_lang_sense_clarification": "minulý čas slovesa těžit suroviny"
                            },
                            {
                                "target_lang_word": "zaminoval",
                                "target_lang_sense_clarification": "minulý čas slovesa klást miny"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}