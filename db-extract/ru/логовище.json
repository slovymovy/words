                                        "entry_id": "37fa76a7-d5f0-31b1-b10d-587b99b9561c",
                                        "glosses": [
                                            "A small cavern or hollow place in the side of a hill, or among rocks; especially, a cave used by a wild animal for shelter or concealment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e74db37-752e-4fb9-bee1-01cca2713c79",
                                                "sense_id": "e73b7358-f339-346e-a9e9-e121153854d0",
                                                "text": "a den of robbers"
                                            },
                                            {
                                                "example_id": "81b3d126-1eb9-48dd-ada4-677639c1774d",
                                                "sense_id": "e73b7358-f339-346e-a9e9-e121153854d0",
                                                "text": "Daniel was put into the lions’ den."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2502bc7c-943a-3aff-b2d0-20bacde3e268",
                                        "entry_id": "37fa76a7-d5f0-31b1-b10d-587b99b9561c",
                                        "glosses": [
                                            "A squalid or wretched place; a haunt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b85a708-ab21-4c76-8af8-1e6f3573358c",
                                                "sense_id": "2502bc7c-943a-3aff-b2d0-20bacde3e268",
                                                "text": "Lying in a den in Bombay\nWith a slack jaw and not much to say"
                                            },
                                            {
                                                "example_id": "326a343a-b18f-4d0b-959f-94c055bfd90a",
                                                "sense_id": "2502bc7c-943a-3aff-b2d0-20bacde3e268",
                                                "text": "a den of vice"
                                            },
                                            {
                                                "example_id": "26bfb9ce-d305-4ef5-955a-b71de216cd39",
                                                "sense_id": "2502bc7c-943a-3aff-b2d0-20bacde3e268",
                                                "text": "an opium den; a gambling den"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3e1d9a8-2961-39ab-82fb-bdd33388c285",
                                        "entry_id": "37fa76a7-d5f0-31b1-b10d-587b99b9561c",
                                        "glosses": [
                                            "A comfortable room not used for formal entertaining."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "815d7717-522b-372c-bd5c-ab2e2b3992a3",
                                        "entry_id": "37fa76a7-d5f0-31b1-b10d-587b99b9561c",
                                        "glosses": [
                                            "Synonym of fort (“structure improvised from furniture, etc. for playing games.”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14f0c691-217e-4228-ba67-84785f6f178d",
                                                "sense_id": "815d7717-522b-372c-bd5c-ab2e2b3992a3",
                                                "text": "Our little girls love using bedsheets and other stuff around the house to make dens in the living room and pretending they're on adventures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e8a4879-5389-3918-8981-c399ab2798a2",
                                        "entry_id": "37fa76a7-d5f0-31b1-b10d-587b99b9561c",
                                        "glosses": [
                                            "A narrow glen; a ravine; a dell."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "UK",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc5d11fd-3c46-46ce-82d2-9de14738f74b",
                                                "sense_id": "2e8a4879-5389-3918-8981-c399ab2798a2",
                                                "text": "I have made several visits of late to the Den of Rubislaw"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcb19173-f9a4-3f45-9621-ac83b819df50",
                                        "entry_id": "37fa76a7-d5f0-31b1-b10d-587b99b9561c",
                                        "glosses": [
                                            "A group of Cub Scouts of the same age who work on projects together."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "den",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9007783f-4dee-30f1-a538-5f9ebc2508c6",
                                        "entry_id": "f805f720-ea6d-3fa1-b308-ac05294e0ba8",
                                        "glosses": [
                                            "To ensconce or hide oneself in (or as in) a den."
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a9781c9-6d08-3eb4-8730-c536de383875",
                                        "entry_id": "f805f720-ea6d-3fa1-b308-ac05294e0ba8",
                                        "glosses": [
                                            "Of an animal, to use as a den; to take up residence in."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bae9f657-0e4a-4177-be52-3e57f3569822",
                                                "sense_id": "3a9781c9-6d08-3eb4-8730-c536de383875",
                                                "text": "Although present in virtually all habitats, it preferred to den in caves, so its distribution, especially in cold, northern areas, may have been limited to limestone and other rocky regions where caves form."
                                            },
                                            {
                                                "example_id": "9643ae33-6317-425a-ae11-859fde91ca38",
                                                "sense_id": "3a9781c9-6d08-3eb4-8730-c536de383875",
                                                "text": "“Denning” – behaviour around making dens – has changed and bears are swimming long distances, but, says Aars, there is still enough sea ice in the spring for the bears to hunt successfully."
                                            }
                                        ]
                                    }
                                ]
                            },
