                        "glosses": [
                            "Défaire (ce qui était embobiné)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4325d60d-9864-4c84-a5f6-1a8a5746eed5",
                                "sense_id": "e365d526-fec3-3e0a-a94f-eba9668d9835",
                                "text": "La vie ne peut être passée qu'à se défaire, à crever les aliénations, à désembobiner les conditionnements, à désentortiller les méandres de tout ce qu'on a subi."
                            },
                            {
                                "example_id": "7bf48fa4-7df4-4daa-be96-1659646d6a8f",
                                "sense_id": "e365d526-fec3-3e0a-a94f-eba9668d9835",
                                "text": "Pour désembobiner celui-là, il faudra trois heures de travail avec un sécateur..."
                            }
                        ]
                    }
