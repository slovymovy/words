                        "glosses": [
                            "Of a form of bitter misanthropy relating to Timonism, like Timon of Athens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7175476-8607-4b9b-9f8a-a67f9a886ac7",
                                "sense_id": "8364e60a-7d8b-3e1a-8eec-cc4c211e24f5",
                                "text": "[About Timon's account of Pyrrho's views.] The second Timonian passage is usually taken to come from his prose work, Python."
                            },
                            {
                                "example_id": "d03fec7f-8a3c-48d0-ad54-0d750e5f922d",
                                "sense_id": "8364e60a-7d8b-3e1a-8eec-cc4c211e24f5",
                                "text": "Aristocles is not citing Timon—and how near he keeps to any Timonian text we cannot judge."
                            }
                        ]
                    }
