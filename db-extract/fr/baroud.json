                        "glosses": [
                            "Parade rituelle lors de certaines cérémonies au Maroc et en Algérie."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "86c4ec62-9235-3bb0-8ac4-8e9f69f335d7",
                        "entry_id": "c2f8b47c-0e24-3d19-b132-ee87262647d4",
                        "glosses": [
                            "(Argot) Combat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cef206d5-03f3-4ccf-8d8c-0c15277955cb",
                                "sense_id": "86c4ec62-9235-3bb0-8ac4-8e9f69f335d7",
                                "text": "Les seules troupes blanches qui, au Maroc, vont au baroud (à la bataille), sont les joyeux et la légion étrangère."
                            },
                            {
                                "example_id": "9b26ba9b-2de9-4d89-b0a8-a4bfd147e60d",
                                "sense_id": "86c4ec62-9235-3bb0-8ac4-8e9f69f335d7",
                                "text": "Voyons, mon petit pote, fais pas l'idiot. Je te dis qu'on nous a prévenus : il va y avoir du baroud un de ces jours."
                            },
                            {
                                "example_id": "75e97799-f621-4724-88c7-62e7c668abbb",
                                "sense_id": "86c4ec62-9235-3bb0-8ac4-8e9f69f335d7",
                                "text": "Quand j’pense que j’ai eu ma première permission en septembre 1915, après un an de baroud…"
                            },
                            {
                                "example_id": "4b74159d-eaeb-412f-ac7d-bb838a2708e2",
                                "sense_id": "86c4ec62-9235-3bb0-8ac4-8e9f69f335d7",
                                "text": "Le baroud parlementaire de la gauche"
                            }
                        ]
                    }
                ],
