                "senses": [
                    {
                        "sense_id": "e4ae1431-f2c4-3d32-96ec-bd221a4fe1d4",
                        "entry_id": "973d391d-b2d5-3084-b590-f29e12494a47",
                        "glosses": [
                            "Spott mit starkem Anteil an Schadenfreude; zynische Polemik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0b592ab-af3b-4a12-aef7-e1f6bb52a1a5",
                                "sense_id": "e4ae1431-f2c4-3d32-96ec-bd221a4fe1d4",
                                "text": "Du kannst dir deine Häme sparen!"
                            },
                            {
                                "example_id": "d50def5f-f14f-4237-8e36-09ba3ae93361",
                                "sense_id": "e4ae1431-f2c4-3d32-96ec-bd221a4fe1d4",
                                "text": "„Das Wort Häme (von ahd. ‚hamo’) bedeutet ursprünglich Angelhaken, Angelrute. Es hat mit dem ‚Hamen’ zu tun, einem Fangnetz mit Stiel […], das zum Fischefangen dient.“"
                            },
                            {
                                "example_id": "03158f89-3725-489e-bc9d-701aa8c23f52",
                                "sense_id": "e4ae1431-f2c4-3d32-96ec-bd221a4fe1d4",
                                "text": "„Neben dem rechtsextremistischen Gewaltpotenzial gehörten die Abgründe an Häme und Hass inmitten unserer Gesellschaft gegenüber denen, die in unserem Land Verantwortung übernähmen, zu den beklemmenden Erfahrungen der jüngsten Tage, sagte Schäuble.“"
                            },
                            {
                                "example_id": "18caf554-3900-479e-9f2c-e4bee949c4de",
                                "sense_id": "e4ae1431-f2c4-3d32-96ec-bd221a4fe1d4",
                                "text": "„Es wird in Deutschland mit viel Häme über ihn geschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5cfe58b-03ae-4c1e-8b20-33888454e126",
                        "source_entry_id": "973d391d-b2d5-3084-b590-f29e12494a47",
                        "source_sense_id": "e4ae1431-f2c4-3d32-96ec-bd221a4fe1d4",
                        "source_sense_description": "Spott mit starkem Anteil an Schadenfreude; zynische Polemik",
                        "target_lang_word": "moquerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moquerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f5432712-e485-3775-979c-c25cc140d503",
                                        "entry_id": "7664ac53-1526-3d4e-814b-d13a74dbc5fb",
                                        "glosses": [
                                            "Action de se moquer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1588ad4f-d2ae-423a-8ce7-d6cad0e9cd51",
                                                "sense_id": "f5432712-e485-3775-979c-c25cc140d503",
                                                "text": "Moquerie maligne, outrageuse."
                                            },
                                            {
                                                "example_id": "ab0980cd-503a-4060-9eb9-20cb002f2c70",
                                                "sense_id": "f5432712-e485-3775-979c-c25cc140d503",
                                                "text": "— Vous voulez vous moquer de moi ?\n— Jamais, mon garçon ; la moquerie peut avoir du bon pour réformer un caractère vicieux, mais lorsqu’elle s’adresse à l’ignorance, elle est une marque de sottise chez celui qui l’emploie."
                                            },
                                            {
                                                "example_id": "df06ec81-434b-4026-801d-a68fca5697ed",
                                                "sense_id": "f5432712-e485-3775-979c-c25cc140d503",
                                                "text": "Arthur, lui, refusait l'armée, non par nationalisme car il s'en moquait, la moquerie servant d'écran à son absence totale de moralité, mais par couardise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95022d1f-922a-3efb-8900-7c78dfbb5c85",
                                        "entry_id": "7664ac53-1526-3d4e-814b-d13a74dbc5fb",
                                        "glosses": [
                                            "Les paroles ou les actions par lesquelles on se moque."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac69a06c-bf13-44fd-b9c4-14a14137031d",
                                                "sense_id": "95022d1f-922a-3efb-8900-7c78dfbb5c85",
                                                "text": "Pour elle, pour la protéger contre les moqueries et les coups, il était toujours prêt à bousculer les railleurs."
                                            },
                                            {
                                                "example_id": "3e4b2b9d-0ae8-4658-8286-e3f61e0493f0",
                                                "sense_id": "95022d1f-922a-3efb-8900-7c78dfbb5c85",
                                                "text": "Les opposants à la réforme et leurs concerts de casseroles ont plutôt eu droit à des moqueries présidentielles du type «les casseroles, c’est pour faire la cuisine»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "341972f5-c60a-4fcc-9abc-8c408dcf09fa",
                        "source_entry_id": "973d391d-b2d5-3084-b590-f29e12494a47",
