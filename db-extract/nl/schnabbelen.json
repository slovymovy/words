                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "413bd604-3101-318d-aa4c-7f481bce0ad6",
                        "entry_id": "faf23e3b-7b25-3ea7-ae5f-b0dbec6edbf8",
                        "glosses": [
                            "extra geld verdienen met een bijbaantje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b048732c-e48f-47da-951f-211681228f5e",
                                "sense_id": "413bd604-3101-318d-aa4c-7f481bce0ad6",
                                "text": "Journalisten en presentatoren van de KRO-NCRV mogen niet langer schnabbelen voor commerciële partijen of de overheid als die bijbaantjes strijdig kunnen zijn met hun onafhankelijke journalistieke omroepwerk."
                            },
                            {
                                "example_id": "92f24741-a2f4-4d44-b571-54b2a802f3a0",
                                "sense_id": "413bd604-3101-318d-aa4c-7f481bce0ad6",
                                "text": "Het format van het zaterdagavondprogramma werd in januari aangepast nadat de kijkcijfers bleven dalen. ,,We zijn live begonnen. Dat is heel leuk, maar het is heel laat en op zaterdagavond schnabbelen heel veel bekende Nederlanders."
                            },
                            {
                                "example_id": "bd9d383e-4f7c-41ef-9a19-518b7fa5761a",
                                "sense_id": "413bd604-3101-318d-aa4c-7f481bce0ad6",
                                "text": "Als zijn It Takes 2-avontuur goed uitpakt, zou Jörgen Raymann overwegen om hier en daar te gaan schnabbelen. ,,Ik wil hierna het bejaardencircuit in en verjaardagen en bar mitswa's doen enzo\", zo zegt de presentator en theatermaker gekscherend."
                            }
                        ]
                    }
