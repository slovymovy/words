                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d72a013-2f81-4971-af42-97b975e92770",
                                "sense_id": "17bb5d46-6a92-3c94-a0ea-120e96797aa4",
                                "text": "Ik heb hem overal gezocht, maar ik kon hem niet vinden.",
                                "translation": "I've looked for him everywhere, but I couldn't find him.",
                                "english": "I've looked for him everywhere, but I couldn't find him."
                            },
                            {
                                "example_id": "dcaffa6f-bcf9-476f-a6a5-614dc1ac6af9",
                                "sense_id": "17bb5d46-6a92-3c94-a0ea-120e96797aa4",
                                "text": "Het is klein, dus had het overal verborgen kunnen zijn.",
                                "translation": "It is small, so it could have been hidden anywhere.",
                                "english": "It is small, so it could have been hidden anywhere."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8de0b3f-ecda-3286-b516-86ea570a52c1",
