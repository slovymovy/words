                ],
                "senses": [
                    {
                        "sense_id": "01cc3c71-83eb-368c-83d4-049359b94d05",
                        "entry_id": "2faf4ae9-652a-3d25-86c3-b7d1d849fe17",
                        "glosses": [
                            "Débarrasser des tiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2e74f0e-c9d4-4d8f-b6df-5a37e666a104",
                                "sense_id": "01cc3c71-83eb-368c-83d4-049359b94d05",
                                "text": "Comment l’amener en France, les formalités m’ont semblé bien trop lourdes et puis il aurait fallu le laver, l’épouiller, l’étiquer."
                            },
                            {
                                "example_id": "5c9b4acf-b0eb-4221-bfaf-a0360f85cbce",
                                "sense_id": "01cc3c71-83eb-368c-83d4-049359b94d05",
                                "text": "Il leur faut trouver une nuée de serviteurs pour étiquer et panser le bétail, le nourrir à la crèche avec des herbages, stimuler son appétit en y mêlant du sel, qu'il recherche avidement, le défendre du soleil sous une étable couverte, le conduire chaque jour, aux bonnes heures, à de bons pacages, sous la brise de mer moins accessible aux nuées d'insectes; veiller sans cesse pour le repas du jour, sans être très assuré de celui du lendemain."
                            },
                            {
                                "example_id": "0addbdf6-3fa9-4282-b0a4-21a07d7312e4",
                                "sense_id": "01cc3c71-83eb-368c-83d4-049359b94d05",
                                "text": "Il faut « s’étiquer »"
                            }
                        ]
                    }
                ],
