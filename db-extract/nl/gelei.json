                                        "entry_id": "dbe09700-0c0a-3cae-8199-40b05c8f791a",
                                        "glosses": [
                                            "Sustancia coloidal, sólida y transparente obtenida a partir de la cocción de algunas partes de los animales como tejido conjuntivo, huesos y cartílagos."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d112dc04-c307-392f-8400-aa51345590ed",
                                        "entry_id": "dbe09700-0c0a-3cae-8199-40b05c8f791a",
                                        "glosses": [
                                            "Alimento obtenido con una sustancia sólida, gelatinosa y transparente mezclada con zumo de frutas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c3f6571-6cfb-4b43-9936-ceabf5c5904e",
                                                "sense_id": "d112dc04-c307-392f-8400-aa51345590ed",
                                                "text": "Para preparar gelatina de fresa necesitamos las fresas, el azúcar y el licor de almendra amarga."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
