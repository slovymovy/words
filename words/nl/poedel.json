{
    "word_family": [
        "poedelen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c0881d95-c9a2-3d8c-b1f8-89f4058a5d6c",
                    "sense_definition": "Een hondenras met krullend haar.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "hondenras",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>poedel</w> staat bekend om zijn intelligente en vrolijke karakter.",
                            "target_lang_translations": {
                                "fr": "Le <w>caniche</w> est connu pour son caractère intelligent et joyeux."
                            }
                        },
                        {
                            "text": "Zij liet haar <w>poedel</w> uit in het park bij de vijver.",
                            "target_lang_translations": {
                                "fr": "Elle a sorti son <w>caniche</w> dans le parc près de l'étang."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Une race de chien au poil frisé."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "caniche",
                                "target_lang_sense_clarification": "Race de chien de compagnie à poil bouclé."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49dfa62e-1ed9-3f7b-ac0b-c689fb4a69c2",
                    "sense_definition": "Een mislukte poging of een schot dat het doel mist.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een pijnlijke <w>poedel</w> tijdens de beslissende wedstrijd.",
                            "target_lang_translations": {
                                "fr": "C'était un <w>raté</w> douloureux lors du match décisif."
                            }
                        },
                        {
                            "text": "Door die <w>poedel</w> verloor de speler de kans op de overwinning.",
                            "target_lang_translations": {
                                "fr": "À cause de ce <w>manqué</w>, le joueur a perdu la chance de gagner."
                            }
                        }
                    ],
                    "synonyms": [
                        "misser"
                    ],
                    "target_lang_definitions": {
                        "fr": "Une tentative ratée ou un tir qui manque sa cible."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "raté",
                                "target_lang_sense_clarification": "Échec ou action manquée."
                            },
                            {
                                "target_lang_word": "manqué",
                                "target_lang_sense_clarification": "Coup ou tir qui n'atteint pas son but."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d26c3f7b-46cd-3bf6-9594-a078d9765758",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>poedelen</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "zwemmen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>poedel</w> graag in het ondiepe water van het zwembad.",
                            "target_lang_translations": {
                                "fr": "J'aime <w>barboter</w> dans l'eau peu profonde de la piscine."
                            }
                        },
                        {
                            "text": "Elke zomer <w>poedel</w> ik met veel plezier in de zee.",
                            "target_lang_translations": {
                                "fr": "Chaque été, je <w>barbote</w> avec grand plaisir dans la mer."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Première personne du singulier du présent du verbe 'barboter' (jouer dans l'eau)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "barbote",
                                "target_lang_sense_clarification": "Jouer dans l'eau peu profonde."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eef0ae17-8386-3e10-ade9-02a4ec04d206",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>poedelen</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "zwemmen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Poedel</w> jij ook zo graag in het water?",
                            "target_lang_translations": {
                                "fr": "<w>Barbotes</w>-tu aussi avec autant de plaisir dans l'eau ?"
                            }
                        },
                        {
                            "text": "Waarom <w>poedel</w> jij altijd in de kleine vijver?",
                            "target_lang_translations": {
                                "fr": "Pourquoi <w>barbotes</w>-tu toujours dans le petit étang ?"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Deuxième personne du singulier du présent du verbe 'barboter'."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "barbotes",
                                "target_lang_sense_clarification": "Jouer dans l'eau peu profonde."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ec13c7f-c871-3b74-aca5-0583b88cf491",
                    "sense_definition": "Gebiedende wijs van <w>poedelen</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "zwemmen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Poedel</w> lekker in het water tijdens deze warme dag.",
                            "target_lang_translations": {
                                "fr": "<w>Barbote</w> tranquillement dans l'eau pendant cette journée chaude."
                            }
                        },
                        {
                            "text": "<w>Poedel</w> maar even in de tuin met de tuinslang.",
                            "target_lang_translations": {
                                "fr": "<w>Barbote</w> un peu dans le jardin avec le tuyau d'arrosage."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Impératif du verbe 'barboter'."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "barbote",
                                "target_lang_sense_clarification": "Jouer dans l'eau peu profonde."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}