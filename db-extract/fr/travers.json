                                "sense_id": "81044c89-3460-3160-bec5-fade2fd0ed54",
                                "text": "Au travers de l’ennemi",
                                "translation": "qua giữa quân địch"
                            },
                            {
                                "example_id": "bfd69945-56e8-4bf4-93e4-fb276b930b2d",
