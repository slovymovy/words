                "senses": [
                    {
                        "sense_id": "aa2fe8ea-6c03-30ff-bdab-e053fa0d1480",
                        "entry_id": "584a085c-576e-3cd6-8517-cc4018362505",
                        "glosses": [
                            "Petit tas de foin séché ou de blé coupé."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "58ea7612-1bb6-489a-a73b-c949e225f499",
                                "sense_id": "aa2fe8ea-6c03-30ff-bdab-e053fa0d1480",
                                "text": "Séchage en veillotte (en vailloche) On rencontre aussi chez nous des cultivateurs qui ont pris l'habitude de mettre leur foin en veillotte avant de l'engranger."
                            },
                            {
                                "example_id": "046e7b56-893f-4000-8429-87296d4e0c77",
                                "sense_id": "aa2fe8ea-6c03-30ff-bdab-e053fa0d1480",
                                "text": "Aussi, lorsque le repas du plus aisé se trouvait être un jeudi, les paysans ne manquaient pas de moissonner suffisamment de blé pour élever une veillotte."
                            }
                        ]
                    },
                    {
                        "sense_id": "33151d18-dd7c-343f-941c-72552eb4e2aa",
                        "entry_id": "584a085c-576e-3cd6-8517-cc4018362505",
                        "glosses": [
                            "Colchique d'automne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d1cdc3d-fb03-4d13-9089-0a00a196455d",
                                "sense_id": "33151d18-dd7c-343f-941c-72552eb4e2aa",
                                "text": "On donne ce nom aux fleurs du colchique. Voyez ail au loup, veillotte."
                            }
                        ]
                    }
