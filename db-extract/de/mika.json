                        ],
                        "form": "die Mikas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d138a8a4-6695-3112-be3f-403bbb3965fd",
                        "entry_id": "7b8c3251-6b17-3635-a3a1-00d17478ce39",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4269f598-5f58-421f-8251-b67e1687e553",
                                "sense_id": "d138a8a4-6695-3112-be3f-403bbb3965fd",
                                "text": "Frau Mika ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "58519e37-3e99-4e9f-9b74-bdc7d209cfb6",
                                "sense_id": "d138a8a4-6695-3112-be3f-403bbb3965fd",
                                "text": "Herr Mika wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3d7332cd-16aa-47b6-bc6b-d7c0a4cb9c16",
                                "sense_id": "d138a8a4-6695-3112-be3f-403bbb3965fd",
                                "text": "Die Mikas fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "2b9931fe-69c6-466c-b2ef-b00ac0a4213f",
                                "sense_id": "d138a8a4-6695-3112-be3f-403bbb3965fd",
                                "text": "Der Mika trägt nie die Schals, die die Mika ihm strickt."
                            },
                            {
                                "example_id": "1dad836a-8548-4789-9ca9-bf9546fdf1f4",
                                "sense_id": "d138a8a4-6695-3112-be3f-403bbb3965fd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mika kommt, geht der Herr Mika.“"
                            },
                            {
                                "example_id": "dca6fc44-b1b3-45fc-8772-5e814c9a20af",
                                "sense_id": "d138a8a4-6695-3112-be3f-403bbb3965fd",
                                "text": "Mika kommt und geht."
                            },
                            {
                                "example_id": "3c1f59ab-66f7-4750-b09d-ce68fe082d6e",
                                "sense_id": "d138a8a4-6695-3112-be3f-403bbb3965fd",
                                "text": "Mikas kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
