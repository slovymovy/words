                "senses": [
                    {
                        "sense_id": "ff0b1050-df7d-3ba9-b19b-997a61b4d0ca",
                        "entry_id": "654817ba-942c-3f99-ac21-d44d16980f76",
                        "glosses": [
                            "von einer Gemeinde zum Schutz der Felder angestellte Person"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "cb51d5bf-ad6c-4997-b650-867327f3fb14",
                                "sense_id": "ff0b1050-df7d-3ba9-b19b-997a61b4d0ca",
                                "text": "„Drei der vier Feldhüter sind am Ende zur Strecke gebracht, durch das mysteriöse Walten der Natur, durch eigene Ungeschicklichkeit oder die Boshaftigkeiten der Dörfler.“"
                            },
                            {
                                "example_id": "5a33a7e2-2071-4e47-9bb6-38459bd961ce",
                                "sense_id": "ff0b1050-df7d-3ba9-b19b-997a61b4d0ca",
                                "text": "„Aber dieser Acker wird scharf bewacht werden, damit keine gefährlichen politischen Früchte reifen, die Sicherheitsdienste sind die künftigen Feldhüter der Reformen.“"
                            },
                            {
                                "example_id": "e77596cd-1efa-4524-a23d-b19d807fb4b5",
                                "sense_id": "ff0b1050-df7d-3ba9-b19b-997a61b4d0ca",
                                "text": "„Der Feldhüter trieb die Neugierigen hinaus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
