                                "target_senses": [
                                    {
                                        "sense_id": "005406cd-76d1-364a-857b-b035e175c8f4",
                                        "entry_id": "971f0bf5-29ca-31ba-ad62-59d0d01246d4",
                                        "glosses": [
                                            "Information that was heard by one person about another that cannot be adequately substantiated."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1b969a7-d2f0-4141-a3b9-46c137bb67f0",
                                                "sense_id": "005406cd-76d1-364a-857b-b035e175c8f4",
                                                "text": "based on hearsay"
                                            },
                                            {
                                                "example_id": "8680d70b-1fcc-42be-8f09-807d180d08e9",
                                                "sense_id": "005406cd-76d1-364a-857b-b035e175c8f4",
                                                "text": "The story turned out to be nothing but hearsay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b93ca2e-299a-36e6-920e-470d98a94ee4",
                                        "entry_id": "971f0bf5-29ca-31ba-ad62-59d0d01246d4",
                                        "glosses": [
                                            "Evidence based on the reports of others, which is normally inadmissible because it was not made under oath, rather than on personal knowledge."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a87ae0b-5676-4814-bee3-715e2fcfabf8",
                                                "sense_id": "4b93ca2e-299a-36e6-920e-470d98a94ee4",
                                                "text": "dismiss hearsay"
                                            },
                                            {
                                                "example_id": "013dcba0-6e9a-47c6-8f67-92079e2a63c7",
                                                "sense_id": "4b93ca2e-299a-36e6-920e-470d98a94ee4",
                                                "text": "The judge ruled the testimony as mere hearsay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5652bd4f-29f2-3ac1-a91b-0b57aef81679",
                                        "entry_id": "971f0bf5-29ca-31ba-ad62-59d0d01246d4",
                                        "glosses": [
                                            "An out-of-court statement offered in court to prove the truth of the matter asserted (or the in-court testimony which recites such a statement), which is normally inadmissible (because it is not subject to cross-examination) unless it falls under one of a number of exceptions."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ddb36be-1aa8-46df-a1be-4b99b5845c66",
                        "source_entry_id": "dc63f91f-0407-309c-aba0-52f2f160fd4d",
                        "source_sense_id": "0ce245f5-68f9-3343-afd2-861c89d5af82",
                        "source_sense_description": "Äußerungen anderer als unsichere Quelle des Wissens",
                        "target_lang_word": "ouï-dire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ouï-dire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fce8db6-ee0a-33ed-aa1f-78afe2d2a781",
                                        "entry_id": "20639e6f-da8b-34ea-9103-1410f7d66aa2",
                                        "glosses": [
                                            "Ce qu’on n’a ni vu ni entendu soi-même et qu’on ne sait que par le rapport d’une autre personne ou par le bruit public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc56e22c-9c51-4a10-bffe-9c1535e31fd8",
                                                "sense_id": "2fce8db6-ee0a-33ed-aa1f-78afe2d2a781",
                                                "text": "Il semblait comparer la France si changeante et sitôt étudiée à un pays dont les mœurs et les sites ne lui étaient connus que par des ouï-dire contradictoires, ou par des livres, mal faits pour la plupart."
                                            },
                                            {
                                                "example_id": "19066a30-7311-476b-8127-ff5ae942a348",
                                                "sense_id": "2fce8db6-ee0a-33ed-aa1f-78afe2d2a781",
                                                "text": "Béhidjé-hanum ne m’est connue que par ouï-dire : les infidèles ne sont point admis dans sa demeure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83e7ce3d-77b1-33fd-8baa-c90818293b8a",
                                        "entry_id": "20639e6f-da8b-34ea-9103-1410f7d66aa2",
                                        "glosses": [
                                            "Témoignage de ce qu'un tiers a dit, offert en preuve de la vérité de la chose dite; souvent inadmissible comme preuve à moins de se placer dans l'une des exceptions reconnues à cette règle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
