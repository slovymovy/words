                        "form": "militanters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "64859521-46b4-3ead-a586-ec9413c02e67",
                        "entry_id": "e3f08bff-79b1-353e-aae2-7a608e6aae90",
                        "glosses": [
                            "strijdvaardig, strijdlustig, agressief, fanatiek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f24ef9a4-b5ac-4852-a7b3-15a68a5f3445",
                                "sense_id": "64859521-46b4-3ead-a586-ec9413c02e67",
                                "text": "De minachting voor de lezer spat ervan af. Alsof het allemaal militante vreemdelingenhaters zijn die zich slaafs laten informeren door de enige omroep die een beetje hetzelfde denkt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b5094b6-d1a5-4ec1-8818-3eb71a9763f5",
                        "source_entry_id": "e3f08bff-79b1-353e-aae2-7a608e6aae90",
                        "source_sense_id": "64859521-46b4-3ead-a586-ec9413c02e67",
                        "source_sense_description": "strijdvaardig, strijdlustig, aggressief, fanatiek",
                        "target_lang_word": "militant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "militant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9bd4233-f414-38ec-b7cd-1b7102bf29bd",
                                        "entry_id": "5834a7e7-97c0-3901-b028-482c931a551c",
                                        "glosses": [
                                            "Fighting or disposed to fight; belligerent, warlike."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "948a4a12-553e-4671-940b-ab39e3e77ac8",
                                                "sense_id": "c9bd4233-f414-38ec-b7cd-1b7102bf29bd",
                                                "text": "The upper tiers of the foreign ministry were quick to embrace a militant policy."
                                            },
                                            {
                                                "example_id": "ec59c770-7c2f-4eb5-b4a5-308c8ebda3ff",
                                                "sense_id": "c9bd4233-f414-38ec-b7cd-1b7102bf29bd",
                                                "text": "Senior members of Jemaah Islamiyah, the Southeast Asian militant network blamed for the deadly Bali bombings, have announced they are disbanding the group, according to a report by a Jakarta-based think tank on Thursday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60280292-e2e5-3f3a-a0bb-605217613366",
                                        "entry_id": "5834a7e7-97c0-3901-b028-482c931a551c",
                                        "glosses": [
                                            "Aggressively supporting of an idea, group, political or social cause, etc.; adamant, combative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdde2ef3-a60d-403a-9488-e083b66e872e",
                                                "sense_id": "60280292-e2e5-3f3a-a0bb-605217613366",
                                                "text": "The physiological state is not itself militant against erotic expression."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "militant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a07579f4-5076-3371-8ad9-912202f06dc0",
                                        "entry_id": "48e4a150-9158-30ee-8e90-071b08cfd341",
                                        "glosses": [
                                            "A soldier, a combatant."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93c9d50c-0c41-3baa-8947-b30a9a27ca5d",
                                        "entry_id": "48e4a150-9158-30ee-8e90-071b08cfd341",
                                        "glosses": [
                                            "An entrenched or aggressive adherent to a particular cause, now especially a member of a particular ideological faction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f954f887-cf4d-4c97-8600-656892813c34",
                                                "sense_id": "93c9d50c-0c41-3baa-8947-b30a9a27ca5d",
                                                "text": "[Jim Owles] lamented the declining influence of militant organizations and tactics, stating that militants \"help keep the rest of us honest,\" and prevent moderates from selling out."
                                            },
                                            {
                                                "example_id": "3011cf8f-0fd6-4dff-aa1e-ebc83f13cac0",
                                                "sense_id": "93c9d50c-0c41-3baa-8947-b30a9a27ca5d",
                                                "text": "Described by witnesses as a keen cricketer and pubgoer until contacts with Islamic militants radicalized him on a trip to Pakistan, he was ordered to serve at least 14 years for the plot, and for supplying militants in Afghanistan with money and equipment."
                                            },
                                            {
                                                "example_id": "71715176-9f93-4083-91a0-428c500b603d",
                                                "sense_id": "93c9d50c-0c41-3baa-8947-b30a9a27ca5d",
                                                "text": "Officials in Pakistan have confirmed that at least 250 schoolchildren between 12 and 18 years old and several teachers were taken hostage by at least seven militants inside a high school in Domail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b26cce8-4a28-30e2-9116-75b55d13d8b5",
                                        "entry_id": "48e4a150-9158-30ee-8e90-071b08cfd341",
                                        "glosses": [
                                            "someone who supports the Trotskyist political view expressed in the newspaper Militant."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
