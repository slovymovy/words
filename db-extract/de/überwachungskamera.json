                ],
                "senses": [
                    {
                        "sense_id": "7ba59014-8d34-3af6-bb02-24fbf602aa59",
                        "entry_id": "f8cf42d9-91f6-36d4-a953-04fbb7bbcb2e",
                        "glosses": [
                            "fest installierte, oft schwenkbare Videokamera zum Überwachen von öffentlichen Plätzen, Banken und Ähnlichem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a07b7554-12f0-46f0-9e47-5f3f0d5dbfd4",
                                "sense_id": "7ba59014-8d34-3af6-bb02-24fbf602aa59",
                                "text": "„Die Ermittler werteten die Aufzeichnungen der Überwachungskamera aus.“"
                            },
                            {
                                "example_id": "af2ea149-aa0c-46f2-a624-7ff2761dd43f",
                                "sense_id": "7ba59014-8d34-3af6-bb02-24fbf602aa59",
                                "text": "„Filmaufnahmen von Überwachungskameras dokumentierten dramatische Szenen: Die im türkischen Fernsehen ausgestrahlten Aufnahmen zeigten einen der Attentäter, der im Terminalgebäude zu Boden ging - offenbar getroffen vom Schuss eines Polizisten. Auf dem Boden liegend zündete der Attentäter einen Sprengsatz.“"
                            },
                            {
                                "example_id": "2a65d014-63c4-465d-a716-4f4e2955028f",
                                "sense_id": "7ba59014-8d34-3af6-bb02-24fbf602aa59",
                                "text": "„Aber mit Hilfe der Überwachungskameras und der DNA, die an den Handfesseln gefunden wurde, kommen die Ermittler Khedache und seiner Bande bald auf die Spur.“"
                            },
                            {
                                "example_id": "538a8a8a-8f63-4310-9130-e694bbab5ac0",
                                "sense_id": "7ba59014-8d34-3af6-bb02-24fbf602aa59",
                                "text": "„Eiríkurs Auto war auf keiner der Überwachungskameras in der Umgebung von Akranes zu sehen, weder am Samstagabend noch an dem Abend davor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a40b3e69-f3a9-46c9-aa09-5062033d7622",
                        "source_entry_id": "f8cf42d9-91f6-36d4-a953-04fbb7bbcb2e",
