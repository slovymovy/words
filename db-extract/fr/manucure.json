                    }
                ],
                "senses": [
                    {
                        "sense_id": "78513e59-7536-3678-a7e3-de04cf8c4c50",
                        "entry_id": "dbb4595f-4788-3424-a6b4-792c1d887d1a",
                        "glosses": [
                            "Celui, celle qui soigne les mains et spécialement les ongles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7234dc57-5b4a-4367-a6ac-ff4cc89b4e9a",
                                "sense_id": "78513e59-7536-3678-a7e3-de04cf8c4c50",
                                "text": "Comme il aurait donné toutes ses relations pour n’importe quelle personne qu’avait l’habitude de voir Odette, fût-ce une manucure ou une demoiselle de magasin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cf3c77e-38c6-4974-a7cc-00ebca7928ce",
                        "source_entry_id": "dbb4595f-4788-3424-a6b4-792c1d887d1a",
                        "source_sense_id": "78513e59-7536-3678-a7e3-de04cf8c4c50",
                        "target_lang_word": "Maniküre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maniküre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7aee340-e44c-3e9e-b5c2-5af949cd3f67",
                                        "entry_id": "05cfd155-75ab-36e2-a4f5-7c8690e690d6",
                                        "glosses": [
                                            "ohne Plural: (kosmetische) Pflege der Hand, der Fingernägel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63fdcfc0-800f-4084-b465-718fc08991ff",
                                                "sense_id": "d7aee340-e44c-3e9e-b5c2-5af949cd3f67",
                                                "text": "„Cremes, Pflegeprodukte oder Maniküre sind für moderne Männer längst kein Tabu mehr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "007bb0f8-4326-3fbd-9b85-3b726e252ddf",
                                        "entry_id": "05cfd155-75ab-36e2-a4f5-7c8690e690d6",
                                        "glosses": [
                                            "weibliche Person mit [1] einer entsprechenden Spezialausbildung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f47e51d-4e0c-4719-a684-99e887520fe8",
                                                "sense_id": "007bb0f8-4326-3fbd-9b85-3b726e252ddf",
                                                "text": "„Ich vergaß, die Namen der beiden Lehrjungen, der Maniküren und der Schuhputzer zu erwähnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3291a216-ecaa-4317-8d11-5a13b425f0d9",
                        "source_entry_id": "dbb4595f-4788-3424-a6b4-792c1d887d1a",
                        "source_sense_id": "78513e59-7536-3678-a7e3-de04cf8c4c50",
                        "target_lang_word": "manicurist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manicurist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a432d37c-4487-3013-9b31-92c3856a90d9",
                                        "entry_id": "dca2629d-ccf8-3b40-bdfe-09295fe82cc7",
                                        "glosses": [
                                            "A person who performs manicures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c6089cb-079e-4ac8-b77c-868fd1835e76",
                                                "sense_id": "a432d37c-4487-3013-9b31-92c3856a90d9",
                                                "text": "Ser Perth cut his words off with a sharp laugh. \"Maybe a man. But who said you were a man, Dave Hanson? Can't you even understand that? You're only half human. The other half is mandrake—a plant that is related to humanity through shapes and signs by magic. We make simulacra out of mandrakes—like the manicurist in the barber shop. And sometimes we use a mandrake root to capture the essence of a real man, in which case he's a mandrake-man, like you. Human? No. But a very good imitation, I must admit.\""
                                            },
                                            {
                                                "example_id": "2079542a-51f3-4fd9-89d1-6ea453ae21fa",
                                                "sense_id": "a432d37c-4487-3013-9b31-92c3856a90d9",
                                                "text": "Again and again, I watched as manicurists, bowed over a hand or a foot of a client, some young as seven, say, “I’m sorry. I’m sorry. I’m so, so sorry,” when they had done nothing wrong."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
