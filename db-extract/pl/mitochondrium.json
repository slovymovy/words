                        "sense_id": "a6cb3661-1642-3449-994b-ad259071c9d4",
                        "entry_id": "b79ec70d-6d19-3238-a2be-9fd8b46aad0c",
                        "glosses": [
                            "organellum odpowiadające za oddychanie komórkowe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3813372-996a-4012-a3c7-b23e2240db0a",
                                "sense_id": "a6cb3661-1642-3449-994b-ad259071c9d4",
                                "text": "Mitochondrialny DNA jest dziedziczone tylko po matce, ponieważ główka spermatozoidu nie zawiera mitochondriów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8238768-ca6b-4af3-bec7-403fff33314a",
                        "source_entry_id": "b79ec70d-6d19-3238-a2be-9fd8b46aad0c",
                        "source_sense_id": "a6cb3661-1642-3449-994b-ad259071c9d4",
                        "target_lang_word": "mitochondrion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mitochondrion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf8c77ba-411e-356e-85a9-7c5315760e0a",
                                        "entry_id": "a0a4537f-7bab-30d9-843b-680ce3a2ed4c",
                                        "glosses": [
                                            "A spherical or ovoid organelle found in the cytoplasm of eukaryotic cells and containing genetic material separate from that of the host; it is responsible for the conversion of food to usable energy in the form of ATP."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cd54463-8d7f-41a7-84dc-c5e8e1099487",
                                                "sense_id": "cf8c77ba-411e-356e-85a9-7c5315760e0a",
                                                "text": "The consideration of the mitochondrion in the spermatocytes I shall pass over, as it is not within the bounds of this paper; yet I hope to study the earlier generations of my material, and shall then compare the results."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12ed1928-666f-4736-971f-efda09f71f01",
                        "source_entry_id": "b79ec70d-6d19-3238-a2be-9fd8b46aad0c",
                        "source_sense_id": "a6cb3661-1642-3449-994b-ad259071c9d4",
                        "target_lang_word": "mitocondria",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mitocondria",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "14ceb665-21b2-3f56-8297-7dc4a16ef30a",
                                        "entry_id": "2568cc7a-45f0-36df-95c0-b55f1cd28686",
                                        "glosses": [
                                            "Organelo de las células eucariotas cuya función principal es realizar la respiración celular, proceso por el cual proporcionan energía a la célula."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "570e5be5-8ba6-479e-84e9-cc3232e35cc5",
                        "source_entry_id": "b79ec70d-6d19-3238-a2be-9fd8b46aad0c",
                        "source_sense_id": "a6cb3661-1642-3449-994b-ad259071c9d4",
                        "target_lang_word": "Mitochondrium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mitochondrium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e95d745e-a832-3b78-8f0a-703520cdfefd",
                                        "entry_id": "9af2edc8-2d43-399b-8940-c288617b7d95",
                                        "glosses": [
                                            "der Atmung und dem Stoffwechsel dienender Zellbestandteil der höheren Lebewesen (Eukaryoten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bdd4d9a-8f01-41e2-9f80-847e92071b22",
                                                "sense_id": "e95d745e-a832-3b78-8f0a-703520cdfefd",
                                                "text": "Das Mitochondrium ist von einer Doppelmembran umhüllt."
                                            },
                                            {
                                                "example_id": "fed95178-a7c6-4471-a775-e035915eb6f4",
                                                "sense_id": "e95d745e-a832-3b78-8f0a-703520cdfefd",
                                                "text": "Mitochondrien werden auch als »Kraftwerke« der Zelle bezeichnet."
                                            },
                                            {
                                                "example_id": "4a7fd9f4-daa7-445f-96b5-e67007641e2c",
                                                "sense_id": "e95d745e-a832-3b78-8f0a-703520cdfefd",
                                                "text": "Die Mitochondrien enthalten DNA."
                                            },
                                            {
                                                "example_id": "0499475f-2cd7-4515-a848-4dc91fdc1925",
                                                "sense_id": "e95d745e-a832-3b78-8f0a-703520cdfefd",
                                                "text": "„Urbauer und seine Kollegen analysierten insbesondere, welchen Einfluss die Mitochondrien auf die Funktion des Darmepithels haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
