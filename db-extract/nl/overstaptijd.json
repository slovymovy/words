                        "examples": [
                            {
                                "example_id": "6ee16803-a364-4cba-b094-725de27be51d",
                                "sense_id": "247dcc4d-30e1-3839-a12c-8cf8670482b2",
                                "text": "Hij bestudeert het vertrekbord: Malaysia Air naar Kuala Lumpur, vijf uur overstaptijd, dan door naar Australië."
                            },
                            {
                                "example_id": "e5a16960-8f70-4421-ac22-2f2f93fb699b",
                                "sense_id": "247dcc4d-30e1-3839-a12c-8cf8670482b2",
                                "text": "Ook op Facebook zijn de reacties overwegend negatief. Zo zegt Mathijs Kuip dat het grootste gedeelte van zijn reizen nu langer duurt. \"Ik heb minder rechtstreekse verbindingen, ik moet meer overstappen, ik heb kortere overstaptijden (dus mis meer aansluitingen), ik heb een oudere trein en trein tijden zijn niet meer mooi op het hele en halve uur. Al met al, is het niet best!\""
                            }
                        ]
