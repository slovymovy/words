                ],
                "senses": [
                    {
                        "sense_id": "1bc153d5-f37d-3afa-bace-234d654ae009",
                        "entry_id": "28970fc9-4b90-3e98-9552-8f904f7853ef",
                        "glosses": [
                            "изготовленный из веленя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bf065f3-957b-49b5-af38-7022097bc650",
                                "sense_id": "1bc153d5-f37d-3afa-bace-234d654ae009",
                                "text": "К веленевому листу была приклеена вырезка из газеты."
                            },
                            {
                                "example_id": "069adddf-a1f1-4f24-a893-d608272e215f",
                                "sense_id": "1bc153d5-f37d-3afa-bace-234d654ae009",
                                "text": "Плохая память у Парижа, // и, как сам бог теперь велел, // у буржуа на полках книжных // стоит веленевый Верлен."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "032cd7c1-3f1d-496f-bd26-f865c1d1c5c4",
                        "source_entry_id": "28970fc9-4b90-3e98-9552-8f904f7853ef",
                        "source_sense_id": "1bc153d5-f37d-3afa-bace-234d654ae009",
                        "target_lang_word": "vellum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vellum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a7a8c63-efd3-3b18-950b-6f80dd6765b7",
                                        "entry_id": "4a2e0299-74f6-3ae7-a6c8-5cce1759f199",
                                        "glosses": [
                                            "A type of parchment paper made from the skin of a lamb, baby goat, or calf."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d45d8ab0-24a3-4f8b-b2c1-87c7de7c72e8",
                                                "sense_id": "4a7a8c63-efd3-3b18-950b-6f80dd6765b7",
                                                "text": "Little, however, of the wall was seen, for it was nearly hidden by the arched book-cases; and the ponderous tomes, mostly bound in black or white vellum, long since grown dingy with age, contrasted forcibly with the gayer ornaments of their habitation."
                                            },
                                            {
                                                "example_id": "1ad26e09-6c72-4a5f-9c8b-0567ae56fbd5",
                                                "sense_id": "4a7a8c63-efd3-3b18-950b-6f80dd6765b7",
                                                "text": "From this list are purposely omitted books printed upon vellum, Books of Hours of the Virgin Mary, and illuminated books; for these are rarities within reach of the wealthy only."
                                            },
                                            {
                                                "example_id": "71152672-58a2-4b5d-a236-77704d57a5a8",
                                                "sense_id": "4a7a8c63-efd3-3b18-950b-6f80dd6765b7",
                                                "text": "The metaphor is apt, imagining one's spiritual life as a poem, an authored thing, and not preserved on vellum either, but open to revision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc60f177-5287-3b55-aa98-123c2182bcb1",
                                        "entry_id": "4a2e0299-74f6-3ae7-a6c8-5cce1759f199",
                                        "glosses": [
                                            "A writing paper of very high quality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2af89140-41a0-48b5-8651-19992b07c3ad",
                        "source_entry_id": "28970fc9-4b90-3e98-9552-8f904f7853ef",
                        "source_sense_id": "1bc153d5-f37d-3afa-bace-234d654ae009",
                        "target_lang_word": "vélin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vélin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "49642982-eb06-30db-bb9d-a27cb150724a",
                                        "entry_id": "4b63a24f-200f-3158-a21d-c47c6d7426b0",
                                        "glosses": [
                                            "Qui a la finesse du vélin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e18daa2a-fb41-4d2a-8152-7696799ef1d5",
                                                "sense_id": "49642982-eb06-30db-bb9d-a27cb150724a",
                                                "text": "papier vélin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vélin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "640c2d9e-d748-3326-bcac-819ced9b00a3",
                                        "entry_id": "e6fb7a47-ae33-307d-9423-8a8e01cfe3f0",
                                        "glosses": [
                                            "Parchemin de qualité supérieure, traditionnellement fait de peau de très jeune veau."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2df9c94-7d8b-4e41-bdfe-f822fe5f0a28",
                                                "sense_id": "640c2d9e-d748-3326-bcac-819ced9b00a3",
                                                "text": "Relier des livres en vélin."
                                            },
                                            {
                                                "example_id": "b810c9c1-7809-4469-929e-a4619e21dcb0",
                                                "sense_id": "640c2d9e-d748-3326-bcac-819ced9b00a3",
                                                "text": "Exemplaire sur vélin."
                                            },
                                            {
                                                "example_id": "7c844044-b2e6-434a-8ed8-4d94c1a4a4df",
                                                "sense_id": "640c2d9e-d748-3326-bcac-819ced9b00a3",
                                                "text": "Ces maroquins sont si plaisants à l’œil et ces vélins si doux au toucher ! Il n’est pas un seul de ces livres qui ne soit digne, par quelque mérite singulier, de l’estime d’un galant homme."
                                            },
                                            {
                                                "example_id": "ef3e8806-b628-461d-bd15-ebea56e21f58",
                                                "sense_id": "640c2d9e-d748-3326-bcac-819ced9b00a3",
                                                "text": "Rangés dans une crédence, quelques tomes montraient leurs dos de vélin ou de basane estampée d’or fin ; c’étaient des ouvrages de dévotion que n’ouvrait personne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44eaa3fc-5c3e-3198-be1c-3d5116848619",
                                        "entry_id": "e6fb7a47-ae33-307d-9423-8a8e01cfe3f0",
                                        "glosses": [
                                            "Papier de qualité supérieure, imitant la blancheur et l’uni de ce type de parchemin."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43072238-13b5-40c1-a53e-ba09f5d1b981",
                                                "sense_id": "44eaa3fc-5c3e-3198-be1c-3d5116848619",
                                                "text": "Écrire sur du vélin."
                                            },
                                            {
                                                "example_id": "138c819c-ac65-42f6-aca5-e80c6fd8173f",
                                                "sense_id": "44eaa3fc-5c3e-3198-be1c-3d5116848619",
                                                "text": "Peindre en miniature sur du vélin."
                                            },
                                            {
                                                "example_id": "c9faf355-f588-4050-a286-b28910efe862",
                                                "sense_id": "44eaa3fc-5c3e-3198-be1c-3d5116848619",
                                                "text": "De la morte elle-même, rien ne subsiste que sa photographie de petite fille promise, semblait-il, à un heureux avenir, et un gros carnet composé de feuilles de vélin relié de toile noire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c679a02-0d31-392a-9ce4-d87318dea274",
                                        "entry_id": "e6fb7a47-ae33-307d-9423-8a8e01cfe3f0",
                                        "glosses": [
                                            "Dentelle fine d’Alençon dite aussi point royal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "298e5164-546a-4ba5-b5ff-83bcf259828b",
                                                "sense_id": "9c679a02-0d31-392a-9ce4-d87318dea274",
                                                "text": "Vélin blanc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
