                    {
                        "sense_id": "20e19711-1570-3121-bc44-90058d3ef88d",
                        "entry_id": "d2b0d947-ba01-304a-b7ca-525c325a192b",
                        "glosses": [
                            "Einwohner aller Orte, die den Namen Hochheim tragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f4f1640-44dd-469c-8304-6c3279fd1c69",
                                "sense_id": "20e19711-1570-3121-bc44-90058d3ef88d",
                                "text": "Mein Wohnungsnachbar ist ein gebürtiger Hochheimer."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fac3fff1-d29a-33b0-932c-878328a7fd54",
                        "entry_id": "d2b0d947-ba01-304a-b7ca-525c325a192b",
                        "glosses": [
                            "Kurzbezeichnung für einen Rieslingwein, der aus Lagen der Stadt Hochheim am Taunusrand in Südhessen stammt; der Begriff „Hochheimer“ steht international stellvertretend für die Wertschätzung Rheingauer Rieslinge, seitdem Königin Victoria von England (1819 – 1901) 1850 Hochheim und seine Riesling-Lagen besucht und den dort gewonnenen Wein gekostet und im wahrsten Sinne des Wortes hoffähig gemacht hat. Königin Victoria wird der Satz zugeschrieben: „A good hock (ein guter Hofheimer) keeps off the doc.“ (Ein guter Hofheimer - Riesling - macht jeden Arzt überflüssig.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4a59104-9b2c-4e8f-8839-a5eb65fe4e52",
                                "sense_id": "fac3fff1-d29a-33b0-932c-878328a7fd54",
                                "text": "„Der Hochheimer ist ein wahrhaft historischer Tropfen. Zum einen zählte dieser berühmte Rheingau-Riesling bereits zu den Lieblingsweinen von Queen Victoria. Zum anderen ist eine Flasche 1706er Hochheimer der älteste Jahrgang in der Schatzkammer von Kloster Eberbach.“"
                            },
                            {
                                "example_id": "39f21e7b-ee87-4f00-a190-37fae806bd3e",
                                "sense_id": "fac3fff1-d29a-33b0-932c-878328a7fd54",
                                "text": "Ein guter Hochheimer macht jeden Arzt überflüssig."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
