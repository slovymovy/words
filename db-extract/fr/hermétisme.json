                "senses": [
                    {
                        "sense_id": "52458362-5c55-3241-97c2-b5360f31758d",
                        "entry_id": "55ae2227-93dd-37b6-90a3-3286322a5df2",
                        "glosses": [
                            "Terme désignant les doctrines philosophiques des alchimistes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0af59844-c931-421d-bb20-e00b52808bad",
                                "sense_id": "52458362-5c55-3241-97c2-b5360f31758d",
                                "text": "On étudiait tout ce qui nous tombait sous la main : …, le satanisme, l’hermétisme, l’orphisme..."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff94889a-d2b1-352c-8c8e-1a322598d4e1",
                        "entry_id": "55ae2227-93dd-37b6-90a3-3286322a5df2",
                        "glosses": [
                            "Caractère secret, fermé, rigoureux et inflexible d’une doctrine."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1e797397-5aad-49e3-b8c5-a379c47c2741",
                                "sense_id": "ff94889a-d2b1-352c-8c8e-1a322598d4e1",
                                "text": "La question cruciale sur laquelle doit se déterminer tout commentaire de Mallarmé est celle de l’hermétisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64635bac-ef3d-48e1-ad30-29570e405235",
                        "source_entry_id": "55ae2227-93dd-37b6-90a3-3286322a5df2",
                        "source_sense_id": "52458362-5c55-3241-97c2-b5360f31758d",
                        "source_sense_description": "Philisophie ésotérique rattachée au personnage mythique Hermès Trismégiste",
                        "target_lang_word": "Hermetik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
