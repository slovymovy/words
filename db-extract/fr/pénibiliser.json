                "senses": [
                    {
                        "sense_id": "3a74e564-994a-32bd-8c3b-2997ce87ce05",
                        "entry_id": "31651007-ebe8-3719-97db-7078e57b4a31",
                        "glosses": [
                            "Donner un caractère pénible à (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd404da6-9981-4bd1-a788-edf7c065c5c5",
                                "sense_id": "3a74e564-994a-32bd-8c3b-2997ce87ce05",
                                "text": "C'est à dire dans un environnement offrant une vraie plus-value utilisateur à acheter par rapport à pirater, ce qui est aujourd'hui exactement l'inverse : acheter ne peut que pénibiliser la chose, et dans le meilleur des cas n'offre strictement aucune plus value utilisateur, toujours histoires de fichiers backup synchro transfert ou liens \"à jamais\" à fabricant de machine, magasin en ligne, etc."
                            },
                            {
                                "example_id": "506e7087-772a-4a44-87a1-6d25d12d1b45",
                                "sense_id": "3a74e564-994a-32bd-8c3b-2997ce87ce05",
                                "text": "Je ne peux pas en dire beaucoup plus ici, sous peine de pénibiliser les lectures, me semble-t-il."
                            },
                            {
                                "example_id": "993f5859-9ec5-47f1-ab28-e1fce7af745c",
                                "sense_id": "3a74e564-994a-32bd-8c3b-2997ce87ce05",
                                "text": "Donc je vais sans doute venir vous pénibiliser la vie de guilde bientôt."
                            }
                        ]
                    }
                ],
