                ],
                "senses": [
                    {
                        "sense_id": "4ec6ef89-ba51-3884-b3e9-9a7a391b9e10",
                        "entry_id": "968ddc01-9d15-3406-ac41-8cd13bb45843",
                        "glosses": [
                            "so, dass es verbaut werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6292b391-d1dd-4c44-b772-ca5e044f9650",
                                "sense_id": "4ec6ef89-ba51-3884-b3e9-9a7a391b9e10",
                                "text": "„Die Ansicht, die hinter der inneren Baufluchtlinie in der Bauklasse I liegende Beschränkung »17 Prozent der Bauplätze verbaubar« sei iSd Art 18 B-VG inhaltlich unbestimmt, der Willensakt des Gemeinderates kläre nicht, wie die siebzehnprozentige Beschränkung zu ermitteln sei, wenn der Bauplatz über zwei Bauklassengebiete mit unterschiedlicher Bauflächenbeschränkung reiche, ist im Lichte des § 76 Abs 10 Wr BauO unrichtig.“"
                            },
                            {
                                "example_id": "8d1e12f4-10f6-44aa-bd0d-f972da6f7913",
                                "sense_id": "4ec6ef89-ba51-3884-b3e9-9a7a391b9e10",
                                "text": "„Diese Flächen gelten als verbaubar und werden nach ihrem Verkehrswert vergütet.“"
                            },
                            {
                                "example_id": "cae557a1-f585-4b53-9607-b30e7b13be6c",
                                "sense_id": "4ec6ef89-ba51-3884-b3e9-9a7a391b9e10",
                                "text": "„Super Baugrund - 40 % verbaubar“"
                            },
                            {
                                "example_id": "92bfdded-cce1-4c59-9868-d89c3ac33519",
                                "sense_id": "4ec6ef89-ba51-3884-b3e9-9a7a391b9e10",
                                "text": "„Zinshaus mit Erweiterungspotential – 100% des Grundstücks verbaubar.“"
                            },
                            {
                                "example_id": "ec1916c1-4442-4b57-9199-7f1f609f0c9c",
                                "sense_id": "4ec6ef89-ba51-3884-b3e9-9a7a391b9e10",
                                "text": "„Ihr Traumhaus in Vohburg wartet auf Sie!! Südlage nicht verbaubar!!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
