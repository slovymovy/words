                        "glosses": [
                            "Qui défend la polyxion contre les monoïstes."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "4d329138-8338-4c3b-8da9-37e120b36666",
                                "sense_id": "a8ecde9a-79e1-3cf2-9eb8-f7bb06d4cc63",
                                "text": "Et je terminerai en rappelant une sérieuse restriction au principe polyxionniste, suggestion du docteur Ruffier parue dans L’Auto (reprise par M. Ferlay) : moins on fait d’efforts, plus on perd l’habitude d'en faire."
                            }
                        ]
                    }
