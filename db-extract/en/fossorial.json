                        "sense_id": "e0d78d8b-ef57-393d-962b-b76fc621072a",
                        "entry_id": "ca057007-2996-3b4b-9818-a649b370000f",
                        "glosses": [
                            "Of, pertaining to, or adapted for digging or burrowing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53cceb1f-4421-4d8d-8764-7c9e2b97c02f",
                                "sense_id": "e0d78d8b-ef57-393d-962b-b76fc621072a",
                                "text": "The most specialized fossorial mammals (moles, marsupial mole) are subterranean, seeking food and shelter underground and rarely coming to the surface."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b77d950-5eb0-4269-881f-cf2c34b46ecf",
                        "source_entry_id": "ca057007-2996-3b4b-9818-a649b370000f",
                        "source_sense_id": "e0d78d8b-ef57-393d-962b-b76fc621072a",
                        "source_sense_description": "of, pertaining to, or adapted for digging or burrowing",
                        "target_lang_word": "fouisseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fouisseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eed8d4b5-2679-3392-b4cb-5b74e3c8865b",
                                        "entry_id": "c7ce7394-4848-3442-a1af-5c502af9a3cf",
                                        "glosses": [
                                            "Qui permet de fouir, de creuser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81bbe6cb-405a-43ec-a8b2-253b31bf2ee1",
                                                "sense_id": "eed8d4b5-2679-3392-b4cb-5b74e3c8865b",
                                                "text": "La taupe creuse ses galeries grâce à ses puissantes pattes fouisseuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb4bd335-bf93-3aa5-986a-302c69b1d376",
                                        "entry_id": "c7ce7394-4848-3442-a1af-5c502af9a3cf",
                                        "glosses": [
                                            "Qualifie les animaux qui fouissent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fouisseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bb7cd96-7d82-3bdc-9fe5-a4ee9bb953e2",
                                        "entry_id": "a218df28-eca9-374e-92c8-90f76b956365",
                                        "glosses": [
                                            "Animal capable de creuser le sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57e20932-68b9-4a15-959c-b414b440c07d",
                                                "sense_id": "6bb7cd96-7d82-3bdc-9fe5-a4ee9bb953e2",
                                                "text": "La courtilière et le grillon sont des fouisseurs au même titre que la taupe ou le blaireau."
                                            },
                                            {
                                                "example_id": "08a797cc-1348-4623-8b17-5099a2d3e7a7",
                                                "sense_id": "6bb7cd96-7d82-3bdc-9fe5-a4ee9bb953e2",
                                                "text": "Le campagnol terrestre (Arvicola terrestris) est un fouisseur qui creuse un réseau très ramifié de galeries, signalées çà et là par de petits monticules de terre fine (il creuse en effet à l’aide de ses dents), contrairement à la taupe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcd2e699-4d85-3e61-b131-082e0bd23101",
                                        "entry_id": "a218df28-eca9-374e-92c8-90f76b956365",
                                        "glosses": [
                                            "Personne qui cherche quelque chose, qui fouine."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d524365-e69d-460b-adeb-77d464641a32",
                                                "sense_id": "bcd2e699-4d85-3e61-b131-082e0bd23101",
                                                "text": "Le brouhaha est assourdissant : des bonimenteurs vantent les mérites de leurs produits, des fouisseurs au regard mystérieux attirent les chalands en proposant de découvrir les antiques richesses arrachées au sous-sol (…)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
