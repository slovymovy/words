{
    "word_family": [
        "play",
        "back",
        "player",
        "playable",
        "playability"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6545af59-378c-3783-911b-316afbfd0802",
                    "sense_definition": "The replaying of something previously recorded, especially sound or moving images.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "media reproduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The video quality during <w>playback</w> was much better than I expected.",
                            "target_lang_translations": {
                                "ru": "Качество видео при <w>воспроизведении</w> оказалось намного лучше, чем я ожидал."
                            }
                        },
                        {
                            "text": "You can adjust the <w>playback</w> speed to watch the tutorial more quickly.",
                            "target_lang_translations": {
                                "ru": "Вы можете настроить скорость <w>воспроизведения</w>, чтобы быстрее посмотреть обучающее видео."
                            }
                        }
                    ],
                    "synonyms": [
                        "replay",
                        "reproduction"
                    ],
                    "common_phrases": [
                        "playback speed",
                        "video playback",
                        "audio playback",
                        "instant playback"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повторное воспроизведение ранее записанного контента, особенно звука или видео."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воспроизведение",
                                "target_lang_sense_clarification": "процесс проигрывания аудио или видео"
                            },
                            {
                                "target_lang_word": "проигрывание",
                                "target_lang_sense_clarification": "действие по проигрыванию записи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f638dd03-6d20-33f2-a1e6-cb0f26e81743",
                    "sense_definition": "The act of lip-syncing to a pre-recorded track during a performance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer was accused of using <w>playback</w> during her live concert.",
                            "target_lang_translations": {
                                "ru": "Певицу обвинили в использовании <w>фонограммы</w> во время её живого концерта."
                            }
                        },
                        {
                            "text": "Many television shows prefer <w>playback</w> to avoid technical issues with live microphones.",
                            "target_lang_translations": {
                                "ru": "Многие телешоу предпочитают <w>фонограмму</w>, чтобы избежать технических проблем с живыми микрофонами."
                            }
                        }
                    ],
                    "synonyms": [
                        "lip-syncing"
                    ],
                    "antonyms": [
                        "live singing"
                    ],
                    "common_phrases": [
                        "use playback",
                        "sing to playback"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исполнение под фонограмму, когда артист имитирует пение или игру на инструменте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фонограмма",
                                "target_lang_sense_clarification": "запись, под которую выступает артист"
                            },
                            {
                                "target_lang_word": "плюс",
                                "target_lang_sense_clarification": "жарг. запись с голосом вокалиста"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}