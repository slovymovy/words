                                ]
                            },
                            {
                                "target_word": "Papuan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e10045cb-feea-3c14-a1f8-2deb7aae2868",
                                        "entry_id": "3ad422c2-d333-3b35-a1e4-931a3d6387e3",
