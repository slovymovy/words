                {
                    "sense_id": "0beb3753-b644-3f0f-a1f6-1b7a5e5ecf7e",
                    "sense_definition": "Een kenmerkende sfeer of uitstraling die ergens hangt (figuurlijk).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "atmosphere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hing een <w>parfum</w> van geheimzinnigheid in de oude bibliotheek.",
                            "target_lang_translations": {
                                "en": "An <w>air</w> of mystery hung in the old library.",
                                "ru": "В старой библиотеке витал <w>флёр</w> таинственности.",
                                "pl": "W starej bibliotece unosiła się <w>aura</w> tajemniczości.",
                                "de": "Es hing ein <w>Hauch</w> von Geheimnis in der alten Bibliothek.",
                                "fr": "Un <w>parfum</w> de mystère flottait dans la vieille bibliothèque.",
                                "it": "Nella vecchia biblioteca si respirava un'<w>aria</w> di mistero.",
                                "cs": "Ve staré knihovně se vznášel <w>nádech</w> tajemna.",
                                "tr": "Eski kütüphanede gizemli bir <w>hava</w> vardı.",
                                "es": "Había un <w>aire</w> de misterio en la antigua biblioteca.",
                                "zh": "古老的图书馆里弥漫着一种神秘的<w>气息</w>。"
                            }
                        },
                        {
                            "text": "Het <w>parfum</w> van de overwinning maakte het team euforisch.",
                            "target_lang_translations": {
                                "en": "The <w>scent</w> of victory made the team euphoric.",
                                "ru": "<w>Аромат</w> победы привел команду в эйфорию.",
                                "pl": "<w>Smak</w> zwycięstwa wprawił zespół w euforię.",
                                "de": "Der <w>Duft</w> des Sieges machte das Team euphorisch.",
                                "fr": "Le <w>parfum</w> de la victoire a rendu l'équipe euphorique.",
                                "it": "Il <w>profumo</w> della vittoria ha reso la squadra euforica.",
                                "cs": "<w>Vůně</w> vítězství naplnila tým euforií.",
                                "tr": "Zaferin <w>esintisi</w> takımı coşkulandırdı.",
                                "es": "El <w>aroma</w> de la victoria hizo que el equipo se sintiera eufórico.",
                                "zh": "胜利的<w>气息</w>让整个团队欣喜若狂。"
                            }
                        }
