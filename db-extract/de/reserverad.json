                "senses": [
                    {
                        "sense_id": "19abb8ca-e298-36b2-8544-e00a98229f07",
                        "entry_id": "59f84265-4aca-3c8f-8664-1266d5b6c1bb",
                        "glosses": [
                            "für einen Notfall vorrätig gehaltenes Fahrzeugrad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce1d67a6-c360-43d8-a1c5-900a0495f7bd",
                                "sense_id": "19abb8ca-e298-36b2-8544-e00a98229f07",
                                "text": "„Während der Wagen in der Werkstatt stand, hatten Verbündete seines Auftraggebers ihn heimlich in einem Hohlraum hinter den Sitzen versteckt und sein Gepäck dort, wo eigentlich das Reserverad hingehörte.“"
                            },
                            {
                                "example_id": "c72e5f3d-a3a0-4026-9acb-300c8beca6b1",
                                "sense_id": "19abb8ca-e298-36b2-8544-e00a98229f07",
                                "text": "„Schroder nimmt das Reserverad heraus.“"
                            },
                            {
                                "example_id": "4c835039-27df-4dad-a46b-31d517fb2889",
                                "sense_id": "19abb8ca-e298-36b2-8544-e00a98229f07",
                                "text": "„Unterwegs hat er kurz haltgemacht, um von der halben Million Dollar 100.000 abzuzweigen und diese zehn Geldbündel in der Kofferraummulde unter dem Reserverad zu verstecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
