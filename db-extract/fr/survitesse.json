                                "sense_id": "84582841-6843-3ec6-867e-19d702b024e7",
                                "text": "Le moteur est parti en survitesse."
                            },
                            {
                                "example_id": "edc73016-118e-4d77-b893-9d7e1e2acac1",
                                "sense_id": "84582841-6843-3ec6-867e-19d702b024e7",
                                "text": "La lecture des panneaux, et par extension l’alerte de survitesse, est très inégale selon les constructeurs."
                            },
                            {
                                "example_id": "ac506bf8-398d-4fef-a6ac-707dd2efdde9",
                                "sense_id": "84582841-6843-3ec6-867e-19d702b024e7",
                                "text": "Cela redonde la détection d’une survitesse par l’automate (dépassement d’un seuil par la vitesse donnée par le générateur d’impulsions)."
                            }
                        ]
                    },
                    {
