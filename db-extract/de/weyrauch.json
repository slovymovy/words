                ],
                "senses": [
                    {
                        "sense_id": "29da8ad4-8cec-3dfd-a2d0-9fc2952ff507",
                        "entry_id": "fc54f90e-c4d6-3084-83f3-c2afee1e084b",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95fe83c0-a271-4651-a9bb-37d12e28ade8",
                                "sense_id": "29da8ad4-8cec-3dfd-a2d0-9fc2952ff507",
                                "text": "An verregneten Herbsttagen ist Familie Weyrauchs liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "8de994d6-1d3b-499b-8ded-34ffad6aa13f",
                                "sense_id": "29da8ad4-8cec-3dfd-a2d0-9fc2952ff507",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Weyrauch das Schmücken von Weihnachtsbäumen."
                            },
                            {
                                "example_id": "fd88bbf3-5ac3-47ac-b965-7499ea94d9fa",
                                "sense_id": "29da8ad4-8cec-3dfd-a2d0-9fc2952ff507",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Weyrauch kommt, geht der Herr Weyrauch.“"
                            },
                            {
                                "example_id": "c6d90a95-1cfb-412e-8229-de9cf74d027b",
                                "sense_id": "29da8ad4-8cec-3dfd-a2d0-9fc2952ff507",
                                "text": "Weyrauch kommt und geht."
                            },
                            {
                                "example_id": "5fe6e8af-d14e-44f5-a5c8-ef0930ffe9a9",
                                "sense_id": "29da8ad4-8cec-3dfd-a2d0-9fc2952ff507",
                                "text": "Frau Weyrauch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "68fa75b2-5d15-4879-8496-3b571c4417f7",
                                "sense_id": "29da8ad4-8cec-3dfd-a2d0-9fc2952ff507",
                                "text": "Herr Weyrauch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "bfc2260a-4426-4188-a4ea-fee7520373a3",
                                "sense_id": "29da8ad4-8cec-3dfd-a2d0-9fc2952ff507",
                                "text": "Die Weyrauchs kommen heute aus Offenburg."
                            },
                            {
                                "example_id": "f2500c0e-f3cd-4618-a1b4-807c5d116815",
                                "sense_id": "29da8ad4-8cec-3dfd-a2d0-9fc2952ff507",
                                "text": "Der Weyrauch trägt nie die Schals, die die Weyrauch ihm strickt."
                            },
                            {
                                "example_id": "82a0590e-fa9d-4e18-90a0-4b508cd5953f",
                                "sense_id": "29da8ad4-8cec-3dfd-a2d0-9fc2952ff507",
                                "text": "Weyrauchs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
