{
    "word_family": [
        "nothing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "85a447b0-41c3-390f-8f73-00deb8e00bd2",
                    "sense_definition": "A state or space of total emptiness; a void.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emptiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stared into the vast <w>nothingness</w> of the desert night.",
                            "target_lang_translations": {
                                "es": "Se quedó mirando la inmensa <w>nada</w> de la noche en el desierto."
                            }
                        },
                        {
                            "text": "The thick fog swallowed the road until there was only grey <w>nothingness</w> ahead.",
                            "target_lang_translations": {
                                "es": "La espesa niebla se tragó la carretera hasta que solo quedó un <w>vacío</w> gris por delante."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stare into nothingness"
                    ],
                    "target_lang_definitions": {
                        "es": "Estado o espacio de vacío absoluto; un vacío."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "vacío",
                                "target_lang_sense_clarification": "espacio o estado sin nada"
                            },
                            {
                                "target_lang_word": "nada",
                                "target_lang_sense_clarification": "ausencia total de cosas"
                            },
                            {
                                "target_lang_word": "nihilidad",
                                "target_lang_sense_clarification": "vacío o nulidad, formal o literario"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cccb71e-2186-3df4-82f7-d53c9e84075d",
                    "sense_definition": "The state or condition of not existing; nonexistence.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "nonexistence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many ancient philosophers debated whether the universe arose out of absolute <w>nothingness</w>.",
                            "target_lang_translations": {
                                "es": "Muchos filósofos antiguos debatieron si el universo surgió de la <w>nada</w> absoluta."
                            }
                        },
                        {
                            "text": "All our hopes seemed to fade into <w>nothingness</w> after the project was cancelled.",
                            "target_lang_translations": {
                                "es": "Todas nuestras esperanzas parecieron desvanecerse en la <w>nada</w> tras cancelarse el proyecto."
                            }
                        }
                    ],
                    "synonyms": [
                        "nihility"
                    ],
                    "antonyms": [
                        "existence"
                    ],
                    "common_phrases": [
                        "fade into nothingness",
                        "pass into nothingness"
                    ],
                    "target_lang_definitions": {
                        "es": "Estado o condición de no existir; inexistencia."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "nada",
                                "target_lang_sense_clarification": "inexistencia o no ser"
                            },
                            {
                                "target_lang_word": "inexistencia",
                                "target_lang_sense_clarification": "condición de no existir"
                            },
                            {
                                "target_lang_word": "nihilidad",
                                "target_lang_sense_clarification": "estado de no existencia, filosófico"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb378461-7f06-317f-80b1-3ebe28234054",
                    "sense_definition": "The quality of having no value, meaning, or importance; insignificance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "insignificance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Looking up at the billions of stars, she felt the sheer <w>nothingness</w> of human problems.",
                            "target_lang_translations": {
                                "es": "Al mirar hacia los miles de millones de estrellas, sintió la absoluta <w>insignificancia</w> de los problemas humanos."
                            }
                        },
                        {
                            "text": "He struggled with a profound sense of his own <w>nothingness</w> in the grand scheme of things.",
                            "target_lang_translations": {
                                "es": "Luchaba con una profunda sensación de su propia <w>insignificancia</w> en el orden general de las cosas."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sense of nothingness"
                    ],
                    "target_lang_definitions": {
                        "es": "Cualidad de carecer de valor, significado o importancia; insignificancia."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "insignificancia",
                                "target_lang_sense_clarification": "falta de importancia o relevancia"
                            },
                            {
                                "target_lang_word": "nimiedad",
                                "target_lang_sense_clarification": "poca importancia"
                            },
                            {
                                "target_lang_word": "nihilidad",
                                "target_lang_sense_clarification": "cualidad de no valer o no ser nada"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}