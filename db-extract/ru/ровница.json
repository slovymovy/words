                    }
                ],
                "senses": [
                    {
                        "sense_id": "47e42739-053c-3868-be0b-3e7dac2a1d36",
                        "entry_id": "939283aa-eb7e-3d08-bf2b-37e48dc9dd6a",
                        "glosses": [
                            "текст. полуфабрикат прядильного производства, имеющий вид пушистого жгута или ленты из слабо скрученных нитей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17b0cbff-4c0d-4a29-bf0e-bb9314c055aa",
                                "sense_id": "47e42739-053c-3868-be0b-3e7dac2a1d36",
                                "text": "Кроме этого, за смену надо было подметать два раза пол, приносить корзиной цельные катушки с ровницей и два раза, подлезая под нитки и сгибаясь в три погибели, обтирать тряпкой налипший около веретён на каретке крахмал и в то же время другою рукой обтирать пух под цилиндрами, тянущими нитку."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b0f0d1a-c76c-4c3d-b378-cf55063a675c",
                        "source_entry_id": "939283aa-eb7e-3d08-bf2b-37e48dc9dd6a",
                        "source_sense_id": "47e42739-053c-3868-be0b-3e7dac2a1d36",
                        "target_lang_word": "rove",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rove",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7555f00f-654b-398b-9a2a-336d5e28d964",
                                        "entry_id": "7eec022d-6232-3bb4-97e2-d54368c4c78f",
                                        "glosses": [
                                            "To shoot with arrows (at)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ca4b304-93fb-4775-b705-38833b240a4c",
                                                "sense_id": "7555f00f-654b-398b-9a2a-336d5e28d964",
                                                "text": "And thou […] that with thy cruell dart / At that good knight so cunningly didst roue […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1ba3fe6-59bb-329a-ba0b-1b4036870e19",
                                        "entry_id": "7eec022d-6232-3bb4-97e2-d54368c4c78f",
                                        "glosses": [
                                            "To roam, or wander about at random, especially over a wide area."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac071633-f60d-4e03-bf1e-f91e9cbbf848",
                                                "sense_id": "b1ba3fe6-59bb-329a-ba0b-1b4036870e19",
                                                "text": "Now that he was in his prime, there was no simian in all the mighty forest through which he roved that dared contest his right to rule, nor did the other and larger animals molest him."
                                            },
                                            {
                                                "example_id": "c72691ea-6a82-4c04-8ad2-76f4ee1d0e8e",
                                                "sense_id": "b1ba3fe6-59bb-329a-ba0b-1b4036870e19",
                                                "text": "And a rovin’, a rovin’, a rovin’ I'll go / For a pair of brown eyes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75a835c3-a04b-31f4-aa10-b6435563bc1d",
                                        "entry_id": "7eec022d-6232-3bb4-97e2-d54368c4c78f",
                                        "glosses": [
                                            "To roam or wander through."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66639e72-07bf-48a9-ba32-4359fb521787",
                                                "sense_id": "75a835c3-a04b-31f4-aa10-b6435563bc1d",
                                                "text": "Roving the field, I chanced / A goodly tree far distant to behold."
                                            },
                                            {
                                                "example_id": "d3e5a9bf-9866-4a0c-8127-c98560a45102",
                                                "sense_id": "75a835c3-a04b-31f4-aa10-b6435563bc1d",
                                                "text": "The rein-deer, which in Scandinavia can scarcely exist to the south of the sixty-fifth parallel, descends, in consequence of the greater coldness of the climate, to the fiftieth degree, in Chinese Tartary, and often roves into a country of more southern latitude than any part of England."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1707e402-1676-3bda-b6e3-058c16f592a6",
                                        "entry_id": "7eec022d-6232-3bb4-97e2-d54368c4c78f",
                                        "glosses": [
                                            "To card wool or other fibres."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4faf8b0b-c1cc-4235-bf1a-f2afb2b9f20e",
                                                "sense_id": "1707e402-1676-3bda-b6e3-058c16f592a6",
                                                "text": "Although both [flax and wool] must be roved and spun upon similar principles, each requires peculiar modifications in its machinery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5676c272-579a-3918-82ea-bcd7106d7f7e",
                                        "entry_id": "7eec022d-6232-3bb4-97e2-d54368c4c78f",
                                        "glosses": [
                                            "To twist slightly; to bring together, as slivers of wool or cotton, and twist slightly before spinning."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08180e58-d830-316a-9ee9-8a01fd1b472d",
                                        "entry_id": "7eec022d-6232-3bb4-97e2-d54368c4c78f",
                                        "glosses": [
                                            "To draw through an eye or aperture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "257e1870-2aa7-3956-a281-de13d4e836c7",
                                        "entry_id": "7eec022d-6232-3bb4-97e2-d54368c4c78f",
                                        "glosses": [
                                            "To plough into ridges by turning the earth of two furrows together."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3bf2cf4f-886f-3848-8c30-765cc60d5ac1",
                                        "entry_id": "7eec022d-6232-3bb4-97e2-d54368c4c78f",
                                        "glosses": [
                                            "To practice robbery on the seas; to voyage about on the seas as a pirate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bdadc24-2bc8-4cb3-b8c3-3aad24d89204",
                                                "sense_id": "3bf2cf4f-886f-3848-8c30-765cc60d5ac1",
                                                "text": "pirates, roving up and downe the sea"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rove",
                                "target_lang_code": "en",
