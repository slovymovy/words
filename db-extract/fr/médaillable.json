                "senses": [
                    {
                        "sense_id": "b38e8aa0-36ad-39bc-b6c5-07e409321d46",
                        "entry_id": "73e00db3-b1d6-3375-b162-7823e608c556",
                        "glosses": [
                            "Qui peut obtenir une médaille lors d’une compétition sportive."
                        ],
                        "tags": [
                            "En parlant d’un sportif",
                            "d’une équipe",
                            "d’une nation"
                        ],
                        "examples": [
                            {
                                "example_id": "11bd605c-e4d1-4990-b085-d206ffde1f76",
                                "sense_id": "b38e8aa0-36ad-39bc-b6c5-07e409321d46",
                                "text": "La France en position de médaillable."
                            },
                            {
                                "example_id": "4d077c73-2e3f-49e3-83a8-6267faa6b955",
                                "sense_id": "b38e8aa0-36ad-39bc-b6c5-07e409321d46",
                                "text": "Note, les autres sont encore bien pires, parce que eux, pas seulement ils déconnent, mais en plus ils se croient missionnaires, guérisseurs d’écrouelles, médaillables, primables, inexprimables."
                            },
                            {
                                "example_id": "50ae6382-748f-4811-a46b-c9bc5b584f3c",
                                "sense_id": "b38e8aa0-36ad-39bc-b6c5-07e409321d46",
                                "text": "Mais même avec ses réserves, qui sont médaillables en demi-fond dames et dans les concours, la délégation de Moscou vise plus que dix médailles."
                            }
                        ]
                    },
                    {
                        "sense_id": "51ed9855-2062-328b-b04c-bf34ad98f304",
                        "entry_id": "73e00db3-b1d6-3375-b162-7823e608c556",
                        "glosses": [
                            "Qui peut faire l’objet d’une médaille."
                        ],
                        "tags": [
                            "En parlant d’un sport"
                        ],
                        "examples": [
                            {
                                "example_id": "ff7a322d-10da-43eb-bbcf-0708470312ff",
                                "sense_id": "51ed9855-2062-328b-b04c-bf34ad98f304",
                                "text": "Le Comité Olympique International inscrit le Softball comme sport médaillable aux Jeux Olympiques d’été."
                            }
                        ]
                    },
                    {
                        "sense_id": "5768cc57-6d92-3433-b72c-b4c214de2eb5",
                        "entry_id": "73e00db3-b1d6-3375-b162-7823e608c556",
                        "glosses": [
                            "Qui est susceptible de donner lieu à l’obtention d’une médaille dans une compétition sportive."
                        ],
                        "tags": [
                            "En parlant d’un résultat",
                            "d’une performance"
                        ],
                        "examples": [
                            {
                                "example_id": "0e081d50-05c0-4b6f-a5e9-9206679ef9d6",
                                "sense_id": "5768cc57-6d92-3433-b72c-b4c214de2eb5",
                                "text": "Son prédécesseur Renaud Lavillenie, ex-recordman du monde, est passé à un souffle d’une médaille de bronze. Sa première tentative à 5,94 mètres – la hauteur médaillable – a presque été la bonne, la barre semblant hésiter, rebondissant pour finalement tomber."
                            }
                        ]
                    }
