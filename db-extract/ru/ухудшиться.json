                        "form_id": "59587a94-ff60-4341-9ec3-c7a23e6fcd85",
                        "entry_id": "da09e8d2-e925-327d-8b99-390b09af1b9b",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "уху́дшившись"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "02b5b80e-454c-3cd5-a629-d286ab001c62",
                        "entry_id": "da09e8d2-e925-327d-8b99-390b09af1b9b",
                        "glosses": [
                            "стать более плохим"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "412b52fb-5e07-4297-b84c-45b66ea27553",
                                "sense_id": "02b5b80e-454c-3cd5-a629-d286ab001c62",
                                "text": "Португальская агрессия достигла кульминации в первой четверти XVI столетия. К 1517 г. положение захватчиков ухудшилось в результате смерти Фернандеса Атаиде, опытнейшего их военачальника."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91f5d1b5-c4e8-46df-b5d3-fd9c611b7d58",
                        "source_entry_id": "da09e8d2-e925-327d-8b99-390b09af1b9b",
                        "source_sense_id": "02b5b80e-454c-3cd5-a629-d286ab001c62",
                        "target_lang_word": "deteriorate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deteriorate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ccfeec79-1020-3ee7-9327-86911d42f4e0",
                                        "entry_id": "a62c182e-1423-3583-8317-cab981fb22d6",
                                        "glosses": [
                                            "To make worse; to make inferior in quality or value; to impair."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb43f705-f8b3-411c-ab7d-061ce317f3ed",
                                                "sense_id": "ccfeec79-1020-3ee7-9327-86911d42f4e0",
                                                "text": "to deteriorate the mind"
                                            },
                                            {
                                                "example_id": "e34944e7-31b8-4f73-a1f0-3d0b7313896d",
                                                "sense_id": "ccfeec79-1020-3ee7-9327-86911d42f4e0",
                                                "text": "The art of war, like every other art, ecclesiastical architecture alone excepted, was greatly deteriorated during those years of general degradation[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23d7ac90-a1af-361b-abab-146276ccf15c",
                                        "entry_id": "a62c182e-1423-3583-8317-cab981fb22d6",
                                        "glosses": [
                                            "To grow worse; to be impaired in quality; to degenerate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64171c39-995a-4b1c-a440-1b685002b9ab",
                                                "sense_id": "23d7ac90-a1af-361b-abab-146276ccf15c",
                                                "text": "During this fine run through Fife the weather had deteriorated rapidly, and as we passed Wormit and came onto the Tay Bridge heavy rain clouds were piled over the sea."
                                            },
                                            {
                                                "example_id": "6fb50aab-9c91-4353-9ee9-590fa48be566",
                                                "sense_id": "23d7ac90-a1af-361b-abab-146276ccf15c",
                                                "text": "It was turning into an abysmal afternoon for Newcastle and it deteriorated further when Tiote saw red for his challenge on Jon Ashton."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2b7e631-2ab6-46cd-8417-38b77aded415",
                        "source_entry_id": "da09e8d2-e925-327d-8b99-390b09af1b9b",
                        "source_sense_id": "02b5b80e-454c-3cd5-a629-d286ab001c62",
                        "target_lang_word": "worsen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "worsen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d03c5d6-41f3-3617-84ca-b03080c3944f",
                                        "entry_id": "629e7c92-ba00-3256-b3fc-dc905f45814b",
                                        "glosses": [
                                            "To make worse; to impair."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1158c1f4-1ce5-401c-b7e4-99e90d8eee65",
                                                "sense_id": "2d03c5d6-41f3-3617-84ca-b03080c3944f",
                                                "text": "Near-synonyms: aggravate, exacerbate; degrade, deteriorate; see also Thesaurus:aggravate"
                                            },
                                            {
                                                "example_id": "eed31fd6-4b49-4389-ab11-494a1a2c8e62",
                                                "sense_id": "2d03c5d6-41f3-3617-84ca-b03080c3944f",
                                                "text": "Global warming has worsened the weather."
                                            },
                                            {
                                                "example_id": "e0b5bce5-1727-42d8-847b-14f72f207fef",
                                                "sense_id": "2d03c5d6-41f3-3617-84ca-b03080c3944f",
                                                "text": "As for further retaliation: adding such fuel to the fire, as it were, will only worsen the already unpleasant state of affairs."
                                            },
                                            {
                                                "example_id": "d2ace07e-0cca-494a-b7c6-f134cf9d08a7",
                                                "sense_id": "2d03c5d6-41f3-3617-84ca-b03080c3944f",
                                                "text": "It is apparent that, in the particular point of which we have been conversing, their condition is greatly worsened."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92525fb3-6fd8-32ec-ac95-7ce25ad95c37",
                                        "entry_id": "629e7c92-ba00-3256-b3fc-dc905f45814b",
                                        "glosses": [
                                            "To become worse; to get worse."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "304befdd-e10d-48fe-96e6-3acf1a459cb8",
                                                "sense_id": "92525fb3-6fd8-32ec-ac95-7ce25ad95c37",
                                                "text": "The weather has worsened."
                                            },
                                            {
                                                "example_id": "754f156b-9e88-42b2-858d-575d8dc8c2de",
                                                "sense_id": "92525fb3-6fd8-32ec-ac95-7ce25ad95c37",
                                                "text": "During the day conditions worsened quickly—for example, a 2-6-0 on the Uckfield line suddenly encountered flood water high enough to enter its ashpan and extinguish its fire—until lock gates up-river at Barcombe gave way and a tidal wave rolled down the valley meeting head-on a spring tide rolling up from the coast."
                                            },
                                            {
                                                "example_id": "6bc3bc63-e241-439a-bff9-886ed24696a1",
                                                "sense_id": "92525fb3-6fd8-32ec-ac95-7ce25ad95c37",
                                                "text": "TPE's cancellation score worsened from 7.2% to 23.8% when adjusted to include pre-cancellations (P*-coded) owing to a shortage of train crew."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78c4be9e-a34d-3889-a4a2-631f7e83b98a",
                                        "entry_id": "629e7c92-ba00-3256-b3fc-dc905f45814b",
                                        "glosses": [
                                            "To get the better of; to worst."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
