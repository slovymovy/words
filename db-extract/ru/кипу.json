                                        "entry_id": "c904808f-f682-3b52-a277-51a9ebaebbb9",
                                        "glosses": [
                                            "Dans la civilisation inca, ensemble de fils de coton tressés, dont le nombre, les couleurs et les nœuds étaient porteurs de sens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54314ebc-3cda-420a-a936-2e4671ec7656",
                                                "sense_id": "aec6568f-a6bc-3755-bba3-747d1060f534",
                                                "text": "Le quipou, d’aspect si naïf, permet en effet des combinaisons plus complexes qu’on n’imagine."
                                            },
                                            {
                                                "example_id": "564069e1-ba97-4abd-a6a4-886e1581a3eb",
                                                "sense_id": "aec6568f-a6bc-3755-bba3-747d1060f534",
                                                "text": "Zia, l’amie d’Esteban, savait déchiffrer les quipous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
