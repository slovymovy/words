                "translations": [
                    {
                        "translation_id": "55097683-4abb-44fb-b1f8-4e5d20cb4719",
                        "source_entry_id": "f65cc767-ba19-3d83-bf9f-9aa95148437a",
                        "source_sense_id": "846d9c96-151c-39cc-b138-621bfa8a57eb",
                        "source_sense_description": "een lange huisjas",
                        "target_lang_word": "Morgenmantel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Morgenmantel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cad52a02-50ca-3966-91de-a110b19f098b",
                                        "entry_id": "156c2103-4f05-367c-904a-96d79957567c",
                                        "glosses": [
                                            "nach dem Aufstehen getragenes, bequemes einteiliges Bekleidungsstück"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e439ddf-c246-4e7b-bca4-d41902de9003",
                                                "sense_id": "cad52a02-50ca-3966-91de-a110b19f098b",
                                                "text": "„Sie trägt einen Morgenmantel.“"
                                            },
                                            {
                                                "example_id": "0a9c39cb-3c6a-40f1-bb20-3d3573e501a9",
                                                "sense_id": "cad52a02-50ca-3966-91de-a110b19f098b",
                                                "text": "„Einige Patienten waren hell gekleidet, einige von ihnen in weißen Morgenmänteln.“"
                                            },
                                            {
                                                "example_id": "384c2771-84f7-4ed8-8530-3d87efd45e48",
                                                "sense_id": "cad52a02-50ca-3966-91de-a110b19f098b",
                                                "text": "„Den Morgenmantel habe ich sofort bei meinem Schneider Wong in Auftrag gegeben.“"
                                            },
                                            {
                                                "example_id": "70be876d-a704-49c1-a3f3-059cf2ba4a12",
                                                "sense_id": "cad52a02-50ca-3966-91de-a110b19f098b",
                                                "text": "„Sie warf sich ihren rosa Morgenmantel aus gestepptem Acryl über und lief in Pantoffeln hinaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b604546-6986-4ce9-94ce-699b27065e1b",
                        "source_entry_id": "f65cc767-ba19-3d83-bf9f-9aa95148437a",
                        "source_sense_id": "846d9c96-151c-39cc-b138-621bfa8a57eb",
                        "source_sense_description": "een lange huisjas",
                        "target_lang_word": "Hausmantel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hausmantel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5632f796-8023-316e-9ce1-d7df5f8bb03a",
                                        "entry_id": "b9c65e92-2603-38b4-9578-56428924977c",
                                        "glosses": [
                                            "nur im Haus getragenes, bequemes Kleidungsstück für den ganzen Körper"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc1a7f58-9dec-4ce0-8fdf-5513a7ba60ae",
                                                "sense_id": "5632f796-8023-316e-9ce1-d7df5f8bb03a",
                                                "text": "„Dann legt sie in aller Ruhe, als wäre sie allein, ihre Kleidung ab und zieht einen Hausmantel an.“"
                                            },
                                            {
                                                "example_id": "e7eb8179-df79-4771-b0c0-34e171b8f46f",
                                                "sense_id": "5632f796-8023-316e-9ce1-d7df5f8bb03a",
                                                "text": "„Außerdem wählte sie einen schwarzen Hausmantel aus Seide, den sie zusammen mit dem Negligé an einen Haken im Badezimmer hängte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87fb0d90-884b-4f74-a7d2-5163e0a8f051",
                        "source_entry_id": "f65cc767-ba19-3d83-bf9f-9aa95148437a",
                        "source_sense_id": "846d9c96-151c-39cc-b138-621bfa8a57eb",
                        "source_sense_description": "een lange huisjas",
                        "target_lang_word": "dressing gown",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dressing gown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "769ffeba-555e-3553-82bb-7697f37e852c",
                                        "entry_id": "afc66330-bc75-3b60-bc8b-a128a941abd2",
                                        "glosses": [
                                            "An item of clothing often made from cotton or another absorbent material, in the form of a long open robe with a belt to tie it around the middle and fasten it securely; often worn over pyjamas."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d249491-07a0-4385-8660-4da57341b9fd",
                                                "sense_id": "769ffeba-555e-3553-82bb-7697f37e852c",
                                                "text": "After about ten minutes he got up, and, throwing on an elaborate dressing-gown of silk-embroidered cashmere wool, passed into the onyx-paved bathroom."
                                            },
                                            {
                                                "example_id": "edc87cb6-dbbd-4d90-bbc9-0aea47a90b3a",
                                                "sense_id": "769ffeba-555e-3553-82bb-7697f37e852c",
                                                "text": "I was feeling just as I had felt in the old Malvern House epoch when I used to sneak down to [the headmaster]'s study at dead of night in quest of the biscuits he kept there in a tin on his desk, and there came back to me the memory of the occasion when, not letting a twig snap beneath my feet, I had entered his sanctum in pyjamas and a dressing-gown, to find him seated in his chair, tucking into the biscuits himself. [...] She was looking more like Sherlock Holmes than ever. Slap a dressing-gown on her and give her a violin, and she could have walked straight into Baker Street and no questions asked."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7d51ed4-0ae6-4c01-8116-de967204b8ec",
                        "source_entry_id": "f65cc767-ba19-3d83-bf9f-9aa95148437a",
                        "source_sense_id": "846d9c96-151c-39cc-b138-621bfa8a57eb",
                        "source_sense_description": "een lange huisjas",
                        "target_lang_word": "robe de chambre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "robe de chambre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c81083f7-8c6f-3059-ac5a-95c5b9ca7fdc",
                                        "entry_id": "4b1b2dcb-6318-3a71-9954-2fd9c42c46c1",
                                        "glosses": [
                                            "Vêtement que l’on porte chez soi en déshabillé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c62bb8c-a0a8-41da-930c-da484fb8e189",
                                                "sense_id": "c81083f7-8c6f-3059-ac5a-95c5b9ca7fdc",
                                                "text": "On court se mettre en pantoufles et en robe de chambre pour popoter avec lui au coin du feu."
                                            },
                                            {
                                                "example_id": "203b4f19-53e4-4ba3-8310-9ee423f06f14",
                                                "sense_id": "c81083f7-8c6f-3059-ac5a-95c5b9ca7fdc",
                                                "text": "La vue du lit en désordre, du pyjama abandonné sur une chaise, d’une robe de chambre suspendue dans la salle de bain, l’émut pourtant."
                                            },
                                            {
                                                "example_id": "dd240f95-4a08-424f-9b2b-eac5e757686c",
                                                "sense_id": "c81083f7-8c6f-3059-ac5a-95c5b9ca7fdc",
                                                "text": "Laurence avait une amazone vert-bouteille pour se promener à cheval, une robe en étoffe commune à canezou orné de brandebourgs pour aller à pied, et chez elle une robe de chambre en soie."
                                            },
                                            {
                                                "example_id": "d889ce1c-5e56-4648-b983-3360578d1b80",
                                                "sense_id": "c81083f7-8c6f-3059-ac5a-95c5b9ca7fdc",
                                                "text": "Aussi svelte et bien coiffée, dans une robe de chambre bien moulante, que son aînée est foutue comme l’as de pique, dans son peignoir de bain en tissu-nounours, et peignée avec un clou, de surcroît."
                                            },
                                            {
                                                "example_id": "f1794008-2605-48e7-b0d1-bbcc7c49b32a",
                                                "sense_id": "c81083f7-8c6f-3059-ac5a-95c5b9ca7fdc",
                                                "text": "À la vue du plaid fleuri qui recouvre sa couche, et qu’elle a assorti aux rideaux et à sa robe de chambre, je réalise soudain le sens de l’expression « border l’insomniaque », de même que l’importance du Viagra dans une vie de couple."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
