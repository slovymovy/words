                                        "entry_id": "98f7d2b9-4f7e-32c7-ad45-b1cc3fae361f",
                                        "glosses": [
                                            "A sailing vessel or boat of any kind."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
