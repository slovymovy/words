{
    "word_family": [
        "riot",
        "rioter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "41e68dbd-c300-3467-9c06-87d73887d1b1",
                    "sense_definition": "A violent disturbance of the peace by a crowd.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disturbance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city was under curfew following the <w>rioting</w> in the downtown area.",
                            "target_lang_translations": {
                                "ru": "В городе был введен комендантский час после <w>беспорядков</w> в центре."
                            }
                        },
                        {
                            "text": "Police were deployed to control the <w>rioting</w> that broke out after the match.",
                            "target_lang_translations": {
                                "ru": "Полиция была направлена на подавление <w>беспорядков</w>, вспыхнувших после матча."
                            }
                        }
                    ],
                    "synonyms": [
                        "uprising",
                        "disturbance"
                    ],
                    "common_phrases": [
                        "widespread rioting",
                        "violent rioting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Насильственное нарушение общественного порядка толпой людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспорядки",
                                "target_lang_sense_clarification": "массовые нарушения общественного порядка"
                            },
                            {
                                "target_lang_word": "бунт",
                                "target_lang_sense_clarification": "стихийное проявление недовольства, часто сопровождающееся насилием"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6baf0195-7b4f-3c85-bf91-23b4c14287c7",
                    "sense_definition": "Present participle and gerund of <w>riot</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disturbance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protesters were <w>rioting</w> in the streets for several hours last night.",
                            "target_lang_translations": {
                                "ru": "Протестующие <w>бунтовали</w> на улицах в течение нескольких часов прошлой ночью."
                            }
                        },
                        {
                            "text": "He was arrested for <w>rioting</w> during the political demonstration.",
                            "target_lang_translations": {
                                "ru": "Он был арестован за <w>участие в беспорядках</w> во время политической демонстрации."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rioting in streets"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Участие в массовых беспорядках (причастие или герундий от глагола 'riot')."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "участие в беспорядках",
                                "target_lang_sense_clarification": "процесс совершения насильственных действий в составе толпы"
                            },
                            {
                                "target_lang_word": "бунтовать",
                                "target_lang_sense_clarification": "активно участвовать в массовом протесте с применением силы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}