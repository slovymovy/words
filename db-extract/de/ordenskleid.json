                "senses": [
                    {
                        "sense_id": "b4f9afba-3df8-3a25-953a-a6963bceb77a",
                        "entry_id": "e73aac31-83a9-347f-b76b-28001c9d740e",
                        "glosses": [
                            "Tracht, die von Mitgliedern eines geistlichen Ordens getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c1a4d2d-a3b6-4b6a-aea4-a51ae2133356",
                                "sense_id": "b4f9afba-3df8-3a25-953a-a6963bceb77a",
                                "text": "Das Ordenskleid der Zisterzienser ist weiß mit schwarzem Skapulier und Cingulum."
                            },
                            {
                                "example_id": "68d91446-2240-4599-b668-ebfe07c7aeda",
                                "sense_id": "b4f9afba-3df8-3a25-953a-a6963bceb77a",
                                "text": "Die Jesuiten tragen kein eigenes Ordenskleid."
                            },
                            {
                                "example_id": "70732658-ab65-4f6a-a103-8a0d17d03449",
                                "sense_id": "b4f9afba-3df8-3a25-953a-a6963bceb77a",
                                "text": "[Jesuiten:] „Wegen ihres innerweltlichen Engagements verzichten sie aber auf eine einheitliche Ordenskleidung.“"
                            },
                            {
                                "example_id": "d69ce3fb-7006-4661-8080-4bdeb96de599",
                                "sense_id": "b4f9afba-3df8-3a25-953a-a6963bceb77a",
                                "text": "[Generaloberin Schwester Edith-Maria der Waldbreitbacher Franziskanerinnen:] „Ordenskleider werden in ihrem Kloster kaum getragen, eine Pflicht gibt es nicht mehr.“"
                            },
                            {
                                "example_id": "b6acd252-3265-47d6-9f9a-291c8784d921",
                                "sense_id": "b4f9afba-3df8-3a25-953a-a6963bceb77a",
                                "text": "„Schwester Maria ist seit vier Jahren bei den Steyler Missionsschwestern und lebt in einer Art Kloster-WG in Bötzingen. Sie trägt kein Ordenskleid […].“"
                            },
                            {
                                "example_id": "22c54e29-7ed7-4dc3-bec9-2b0e3423517b",
                                "sense_id": "b4f9afba-3df8-3a25-953a-a6963bceb77a",
                                "text": "[In den Vereinigten Staaten haben die meisten Nonnen] „ihre Ordenskleider bereits nach dem Zweiten Vatikanischen Konzil vor fünfzig Jahren abgelegt, […].“"
                            },
                            {
                                "example_id": "7587e644-0464-4792-ac8f-d4f83951b89f",
                                "sense_id": "b4f9afba-3df8-3a25-953a-a6963bceb77a",
                                "text": "„Einmal aß sie bei dem Fürst Primas mit allen Stiftsdamen zu Mittag; sie war im schwarzen Ordenskleid mit langer Schleppe und weißem Kragen mit dem Ordenskreuz […].“"
                            },
                            {
                                "example_id": "d2d12316-6a38-423a-805e-191bffd893ef",
                                "sense_id": "b4f9afba-3df8-3a25-953a-a6963bceb77a",
                                "text": "„Schwester Jordana: […] Ich war in der Wüste und hatte mein Ordenskleid an und hatte Probleme, diese ganzen Stofflagen irgendwie zu sortieren, weil der Wüstenwind sie mir ins Gesicht blies und ich wirklich Mühe hatte, was zu sehen und mich bekleidet zu halten.“"
                            },
                            {
                                "example_id": "ef04d6cd-e72f-4fc0-a75f-c360866b9075",
                                "sense_id": "b4f9afba-3df8-3a25-953a-a6963bceb77a",
                                "text": "[Mutter Teresa:] „1948 tauschte sie zum ersten Mal ihr Ordenskleid mit dem dann für sie markanten weißen Sari mit den drei blauen Streifen.“"
                            },
                            {
                                "example_id": "0854e006-1bd8-4da0-85e9-f4d6722f7f16",
                                "sense_id": "b4f9afba-3df8-3a25-953a-a6963bceb77a",
                                "text": "[Teresa von Avila:] „Am 24. August 1562 errichtete Teresa mit Billigung des Bischofs von Avila das armselige Klösterchen San José und gab vier Postulantinnen das Ordenskleid.“"
                            },
                            {
                                "example_id": "51b2ff1f-10a2-450a-8e1a-b788b07a964f",
                                "sense_id": "b4f9afba-3df8-3a25-953a-a6963bceb77a",
                                "text": "„Obgleich ihre Eltern empört sind und ihr sogar kirchliche Mitarbeiter abraten, will sie um das Ordenskleid bitten, um als Novizin in die Klostergemeinschaft aufgenommen zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
