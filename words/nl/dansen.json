                {
                    "sense_id": "3fa88990-bde4-3a11-84d8-d40547c63b79",
                    "sense_definition": "Sierlijk en ritmisch bewegen, gewoonlijk op muziek",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement_music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mag ik met je <w>dansen</w>?",
                            "target_lang_translations": {
                                "ru": "Можно с тобой <w>потанцевать</w>?",
                                "en": "May I <w>dance</w> with you?",
                                "pl": "Czy mogę z tobą <w>zatańczyć</w>?",
                                "de": "Darf ich mit dir <w>tanzen</w>?",
                                "fr": "Puis-je <w>danser</w> avec toi ?",
                                "it": "Posso <w>ballare</w> con te?",
                                "cs": "Smím s tebou <w>tančit</w>?",
                                "tr": "Seninle <w>dans edebilir</w> miyim?",
                                "es": "¿Puedo <w>bailar</w> contigo?"
                            }
                        },
                        {
                            "text": "Er werd de hele avond <w>gedanst</w> op muziek uit de jaren dertig.",
                            "target_lang_translations": {
                                "ru": "Весь вечер <w>танцевали</w> под музыку тридцатых годов.",
                                "en": "People <w>danced</w> all evening to music from the thirties.",
                                "pl": "Przez cały wieczór <w>tańczono</w> do muzyki z lat trzydziestych.",
                                "de": "Es wurde den ganzen Abend zu Musik aus den dreißiger Jahren <w>getanzt</w>.",
                                "fr": "On a <w>dansé</w> toute la soirée sur de la musique des années trente.",
                                "it": "Si è <w>ballato</w> tutta la sera sulla musica degli anni trenta.",
                                "cs": "Celý večer se <w>tančilo</w> na hudbu ze třicátých let.",
                                "tr": "Bütün akşam otuzlu yılların müzikleriyle <w>dans edildi</w>.",
                                "es": "Se <w>bailó</w> toda la noche con música de los años treinta."
                            }
                        },
                        {
                            "text": "Ze <w>dansten</w> samen de tango.",
                            "target_lang_translations": {
                                "ru": "Они вместе <w>танцевали</w> танго.",
                                "en": "They <w>danced</w> the tango together.",
                                "pl": "Razem <w>tańczyli</w> tango.",
                                "de": "Sie <w>tanzten</w> zusammen den Tango.",
                                "fr": "Ils <w>dansaient</w> le tango ensemble.",
                                "it": "<w>Ballavano</w> il tango insieme.",
                                "cs": "Společně <w>tančili</w> tango.",
                                "tr": "Birlikte tango <w>yaptılar</w>.",
                                "es": "<w>Bailaron</w> el tango juntos."
                            }
                        }
                    ],
                    "synonyms": [
                        "swingen"
                    ],
                    "antonyms": [
                        "stilstaan"
                    ],
                    "common_phrases": [
                        "naar iemands pijpen dansen",
                        "de sterren van de hemel dansen",
                        "de tango dansen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ритмично двигаться, обычно под музыку",
                        "en": "To move gracefully and rhythmically, usually to music",
                        "pl": "Poruszać się z wdziękiem i rytmicznie, zazwyczaj do muzyki",
                        "de": "Sich anmutig und rhythmisch bewegen, gewöhnlich zu Musik",
                        "fr": "Bouger de manière gracieuse et rythmée, généralement sur de la musique",
                        "it": "Muoversi in modo aggraziato e ritmico, di solito a tempo di musica",
                        "cs": "Pohybovat se ladně a rytmicky, obvykle do hudby",
                        "tr": "Genellikle müzik eşliğinde, zarif ve ritmik bir şekilde hareket etmek",
                        "es": "Moverse de forma elegante y rítmica, generalmente con música"
                    },
                    "translations": {
