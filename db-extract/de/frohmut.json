                "senses": [
                    {
                        "sense_id": "0ed5b4c5-df0f-3323-afab-38431607c457",
                        "entry_id": "2e7b8f4f-803f-3056-af19-cbc088021c9a",
                        "glosses": [
                            "Stimmung, die von guter Laune geprägt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44891470-caec-48ea-9734-a0ba25051ec9",
                                "sense_id": "0ed5b4c5-df0f-3323-afab-38431607c457",
                                "text": "„Den Alten hatte er schon zum Tanz aufgespielt – und jetzt spielte er auch den Jungen, den Enkeln, mit dem Frohmut und fast mit dem Feuer der Jugend.“"
                            },
                            {
                                "example_id": "15145243-6b11-43d5-8686-8b328b8e4a3c",
                                "sense_id": "0ed5b4c5-df0f-3323-afab-38431607c457",
                                "text": "„Er war ein Mann, für den es nichts Halbes gab, ein Mann, der für uns beispielhaft ist, ein kühner, wagemutiger Mann mit einem Frohmut des Herzens, den wir nötig hatten und fortdauernd nötig haben werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
