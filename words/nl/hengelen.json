                    "semantic_group_id": "zoeken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij probeerde subtiel naar complimenten te <w>hengelen</w> tijdens het gesprek.",
                            "target_lang_translations": {
