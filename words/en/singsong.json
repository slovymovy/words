{
    "word_family": [
        "singsongy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c54b1f91-509e-3bf1-8d59-f9351943b2f2",
                    "sense_definition": "Having a rhythm that rises and falls, often in a repetitive or monotonous way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "rhythmic_tone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher spoke in a <w>singsong</w> voice that lulled the children to sleep.",
                            "target_lang_translations": {
                                "ru": "Учитель говорил <w>певучим</w> голосом, который убаюкивал детей.",
                                "pl": "Nauczyciel mówił <w>śpiewnym</w> głosem, który ukołysał dzieci do snu."
                            }
                        },
                        {
                            "text": "He mimicked her <w>singsong</w> tone to make fun of her complaint.",
                            "target_lang_translations": {
                                "ru": "Он передразнил её <w>распевный</w> тон, чтобы высмеять её жалобу.",
                                "pl": "Przedrzeźniał jej <w>śpiewny</w> ton, żeby wyśmiać jej skargę."
                            }
                        }
                    ],
                    "synonyms": [
                        "lilting",
                        "chanting",
                        "rhythmic"
                    ],
                    "antonyms": [
                        "monotone",
                        "flat"
                    ],
                    "common_phrases": [
                        "singsong voice",
                        "singsong tone",
                        "singsong accent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий ритм, который повышается и понижается, часто повторяющийся или монотонный.",
                        "pl": "Posiadający rytm, który wznosi się i opada, często w sposób powtarzalny lub monotonny."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "певучий",
                                "target_lang_sense_clarification": "о голосе или тоне, напоминающем пение"
                            },
                            {
                                "target_lang_word": "распевный",
                                "target_lang_sense_clarification": "о речи, произносимой с протягиванием гласных"
                            },
                            {
                                "target_lang_word": "монотонно-певучий",
                                "target_lang_sense_clarification": "однообразный, но с музыкальной интонацией"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "śpiewny",
                                "target_lang_sense_clarification": "o głosie lub tonie przypominającym śpiew"
                            },
                            {
                                "target_lang_word": "roześpiewany",
                                "target_lang_sense_clarification": "o sposobie mówienia z melodyjną intonacją"
                            },
                            {
                                "target_lang_word": "monotonnie śpiewny",
                                "target_lang_sense_clarification": "o jednostajnym, ale melodyjnym sposobie mówienia"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d013125-62ec-37b1-9f32-cec82121574e",
                    "sense_definition": "A rising and falling rhythm or tone of voice that is often repetitive.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "rhythmic_tone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She read the list of names in a bored <w>singsong</w>.",
                            "target_lang_translations": {
                                "ru": "Она зачитала список имен скучным <w>речитативом</w>.",
                                "pl": "Odczytała listę imion znudzonym, <w>śpiewnym tonem</w>."
                            }
                        },
                        {
                            "text": "His speech settled into a rhythmic <w>singsong</w> as he told the story.",
                            "target_lang_translations": {
                                "ru": "По мере того как он рассказывал историю, его речь превратилась в ритмичную <w>певучую декламацию</w>.",
                                "pl": "Jego mowa przeszła w rytmiczne <w>śpiewne recytowanie</w>, gdy opowiadał historię."
                            }
                        }
                    ],
                    "synonyms": [
                        "lilt",
                        "cadence"
                    ],
                    "antonyms": [
                        "monotone"
                    ],
                    "common_phrases": [
                        "speak in a singsong",
                        "familiar singsong"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повышающийся и понижающийся ритм или тон голоса, часто повторяющийся.",
                        "pl": "Wznoszący się i opadający rytm lub ton głosu, często powtarzalny."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "речитатив",
                                "target_lang_sense_clarification": "ритмичная, монотонная речь"
                            },
                            {
                                "target_lang_word": "певучая интонация",
                                "target_lang_sense_clarification": "манера говорить с изменением высоты тона"
                            },
                            {
                                "target_lang_word": "нараспев",
                                "target_lang_sense_clarification": "манера речи (используется как существительное в контексте)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "śpiewna intonacja",
                                "target_lang_sense_clarification": "sposób mówienia z wyraźną zmianą wysokości tonu"
                            },
                            {
                                "target_lang_word": "recytowanie",
                                "target_lang_sense_clarification": "rytmiczne, często monotonne wygłaszanie tekstu"
                            },
                            {
                                "target_lang_word": "śpiewny ton",
                                "target_lang_sense_clarification": "melodyjna maniera mówienia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c87979f3-811d-3881-8c2e-8dd121d5e7d6",
                    "sense_definition": "An informal occasion where a group of people sing songs together.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "singing_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We gathered around the piano for a <w>singsong</w> on Christmas Eve.",
                            "target_lang_translations": {
                                "ru": "В канун Рождества мы собрались вокруг пианино для <w>совместного пения</w>.",
                                "pl": "W Wigilię zebraliśmy się wokół pianina na <w>wspólne śpiewanie</w>."
                            }
                        },
                        {
                            "text": "They decided to have a <w>singsong</w> to lift everyone's spirits.",
                            "target_lang_translations": {
                                "ru": "Они решили устроить <w>совместное пение</w>, чтобы поднять всем настроение.",
                                "pl": "Postanowili urządzić <w>wspólne śpiewanie</w>, żeby poprawić wszystkim humor."
                            }
                        }
                    ],
                    "synonyms": [
                        "sing-along"
                    ],
                    "common_phrases": [
                        "have a singsong",
                        "family singsong"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальное мероприятие, на котором группа людей поет песни вместе.",
                        "pl": "Nieformalne spotkanie, podczas którego grupa ludzi wspólnie śpiewa piosenki."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совместное пение",
                                "target_lang_sense_clarification": "групповое исполнение песен"
                            },
                            {
                                "target_lang_word": "спевка",
                                "target_lang_sense_clarification": "разговорное, пение хором"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wspólne śpiewanie",
                                "target_lang_sense_clarification": "grupowe wykonywanie utworów muzycznych"
                            },
                            {
                                "target_lang_word": "śpiewogranie",
                                "target_lang_sense_clarification": "nieformalne, towarzyskie spotkanie przy śpiewie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "99a22661-b856-36d7-b0cb-d4c0ff5777a2",
                    "sense_definition": "To speak or recite something with a rising and falling rhythm.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "rhythmic_tone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children <w>singsonged</w> the alphabet while waiting for the bus.",
                            "target_lang_translations": {
                                "ru": "Ожидая автобус, дети <w>пропели</w> алфавит.",
                                "pl": "Dzieci <w>śpiewnie recytowały</w> alfabet, czekając na autobus."
                            }
                        },
                        {
                            "text": "She <w>singsonged</w> a greeting as she walked into the room.",
                            "target_lang_translations": {
                                "ru": "Войдя в комнату, она <w>пропела</w> приветствие.",
                                "pl": "Wchodząc do pokoju, <w>śpiewnie wyrecytowała</w> powitanie."
                            }
                        }
                    ],
                    "synonyms": [
                        "chant",
                        "intone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить или декламировать что-либо с повышающимся и понижающимся ритмом.",
                        "pl": "Mówić lub recytować coś z wznoszącym się i opadającym rytmem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "говорить нараспев",
                                "target_lang_sense_clarification": "произносить слова, растягивая звуки"
                            },
                            {
                                "target_lang_word": "пропеть",
                                "target_lang_sense_clarification": "сказать что-то в манере пения"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "mówić śpiewnie",
                                "target_lang_sense_clarification": "wypowiadać słowa z melodyjną intonacją"
                            },
                            {
                                "target_lang_word": "śpiewnie wymawiać",
                                "target_lang_sense_clarification": "recytować coś w sposób przypominający śpiew"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}