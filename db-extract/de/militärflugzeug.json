                "senses": [
                    {
                        "sense_id": "46d0288f-5b96-3386-bdb2-476716bdaa2a",
                        "entry_id": "ab3efc19-f946-3f0e-8b32-1ba93556ff42",
                        "glosses": [
                            "Flugzeug, das für militärische Einsätze vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a0af7f9-3d15-4213-8b46-49c3af6adf2a",
                                "sense_id": "46d0288f-5b96-3386-bdb2-476716bdaa2a",
                                "text": "Bei der Beschaffung von Militärflugzeugen kommt es oft zu Bestechungsskandalen."
                            },
                            {
                                "example_id": "f891c613-a2cd-42d0-8429-eb19fd592a46",
                                "sense_id": "46d0288f-5b96-3386-bdb2-476716bdaa2a",
                                "text": "„Ein russisches Militärflugzeug hat nach kanadischen Angaben eine kanadische Fregatte im Schwarzen Meer überflogen und mehrfach umkreist.“"
                            },
                            {
                                "example_id": "c91af11c-e62b-4735-b805-34618c293e30",
                                "sense_id": "46d0288f-5b96-3386-bdb2-476716bdaa2a",
                                "text": "„Die Bewaffneten wollten ukrainische Militärflugzeuge abschießen. Sie trafen ein internationales Passagierflugzeug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6e8d81c-338f-4e5e-8a2c-f912632b828e",
