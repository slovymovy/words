                    "sense_definition": "durch eine Öffnung, Lücke oder ein Gitter hindurch nach unten fallen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "räumliche Bewegung",
                    "name_type": "no",
                    "examples": [
