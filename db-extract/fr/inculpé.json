                                        "glosses": [
                                            "The person charged with an offense; the defendant in a criminal case."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6f72b5b-7c59-4d9e-bc4b-6b3b3807fe43",
                                                "sense_id": "aee84efc-f8a2-3167-8f24-77fbaef27cb6",
                                                "text": "The accused arrived at the Baoshan District Court in Shanghai in the morning and a tribunal officer told AFP that a verdict may be issued later on Monday, but it was up to the judge."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "accused",
