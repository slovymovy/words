                {
                    "sense_id": "3ce88e58-299f-3afc-8434-2d7082f54fb3",
                    "sense_definition": "Faire souffrir physiquement de manière continue, en parlant d'un mal ou d'une douleur.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "souffrance_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux marin était constamment <w>tourmenté</w> par des crises aiguës de rhumatisme.",
                            "target_lang_translations": {
                                "en": "The old sailor was constantly <w>plagued</w> by severe attacks of rheumatism.",
                                "ru": "Старого моряка постоянно <w>мучили</w> острые приступы ревматизма.",
                                "de": "Der alte Seemann wurde ständig von heftigen Rheumaanfällen <w>geplagt</w>.",
                                "es": "El viejo marinero estaba constantemente <w>aquejado</w> por crisis agudas de reumatismo.",
                                "zh": "这位老水手时常被剧烈的风湿发作<w>折磨</w>。"
                            }
                        },
                        {
                            "text": "La fièvre et la soif intense ont continué de le <w>tourmenter</w> toute la nuit.",
                            "target_lang_translations": {
                                "en": "The fever and the intense thirst kept <w>tormenting</w> him all night.",
                                "ru": "Жар и сильная жажда всю ночь продолжали <w>мучить</w> его.",
                                "de": "Das Fieber und der heftige Durst <w>quälten</w> ihn die ganze Nacht hindurch.",
                                "es": "La fiebre y la sed intensa lo siguieron <w>atormentando</w> toda la noche.",
                                "zh": "高烧和剧烈的口渴整夜都在<w>折磨</w>着他。"
                            }
                        }
                    ],
                    "common_phrases": [
