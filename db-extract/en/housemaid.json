        "de-extract.jsonl": [
            {
                "entry_id": "abe7c142-5556-345e-b09d-57a7782218f7",
                "word": "housemaid",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f8086d6f-4721-35fc-8c1d-01da16aa6f72",
                        "entry_id": "abe7c142-5556-345e-b09d-57a7782218f7",
                        "glosses": [
                            "Hausmädchen, Dienstmädchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "455495af-32ae-466f-acfb-2462da490cf4",
                                "sense_id": "f8086d6f-4721-35fc-8c1d-01da16aa6f72",
                                "text": "\"But I have never seen a Filipina housemaid (or any other nationality), for that matter) offering freely and directly her servivces to Lebanese employers on a freelance basis.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd4f5e4f-5945-45fd-8806-d5aa8da7733c",
                        "source_entry_id": "abe7c142-5556-345e-b09d-57a7782218f7",
                        "source_sense_id": "f8086d6f-4721-35fc-8c1d-01da16aa6f72",
                        "source_sense_description": "Hausmädchen, Dienstmädchen",
                        "target_lang_word": "Dienstmädchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dienstmädchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7949b810-dab1-3f6a-9045-f5bdd527abc1",
                                        "entry_id": "27bd1dbe-bb04-309d-8979-ac79df8da3f7",
                                        "glosses": [
                                            "weibliche Person, die zur Verrichtung von Haushaltsaufgaben angestellt ist"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6215cf1e-c966-4c12-9882-d2b7b98f6c45",
                                                "sense_id": "7949b810-dab1-3f6a-9045-f5bdd527abc1",
                                                "text": "Ich habe dem Dienstmädchen heute Abend frei gegeben."
                                            },
                                            {
                                                "example_id": "db8614ff-b704-4315-90ee-5f67a0d10867",
                                                "sense_id": "7949b810-dab1-3f6a-9045-f5bdd527abc1",
                                                "text": "Das Dienstmädchen macht seine Arbeit schlecht; wir sollten es entlassen."
                                            },
                                            {
                                                "example_id": "0cd0a948-fbd5-49ca-9aa3-70ec9565d2f9",
                                                "sense_id": "7949b810-dab1-3f6a-9045-f5bdd527abc1",
                                                "text": "„Dann teilten zwei Dienstmädchen Porzellantassen aus, die sie mit frischgekochtem Kaffee aus zwei großen Silberkannen füllten.“"
                                            },
                                            {
                                                "example_id": "bbcf6e7a-31d6-44e2-a0fa-7ed563053a4a",
                                                "sense_id": "7949b810-dab1-3f6a-9045-f5bdd527abc1",
                                                "text": "„Und so erhielten die Veteranen und Kriegsversehrten in diesem Jahrzehnt Gesellschaft von ehemaligen Verkäuferinnen, früheren Milchmädchen, einstigen Arbeiterinnen und entlassenen Dienstmädchen.“"
                                            },
                                            {
                                                "example_id": "ddeec3c1-0dc2-45d0-85e5-9417cd46f494",
                                                "sense_id": "7949b810-dab1-3f6a-9045-f5bdd527abc1",
                                                "text": "„Die von dem Dienstmädchen betreute Kleine liegt in ihrem Bettchen.“"
                                            },
                                            {
                                                "example_id": "eed88e4e-f255-4d92-8b63-64133792af6e",
                                                "sense_id": "7949b810-dab1-3f6a-9045-f5bdd527abc1",
                                                "text": "„Zeit ihres Lebens war sie bloß ein Dienstmädchen gewesen, erst auf dem Lande, dann hier in der Stadt.“"
                                            },
                                            {
                                                "example_id": "0a3a3417-6912-44ab-8f03-d835b0021b54",
                                                "sense_id": "7949b810-dab1-3f6a-9045-f5bdd527abc1",
                                                "text": "„Auch das Dienstmädchen summte bei der Arbeit gerne die aktuellen Schlager.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "462c44c1-e63e-4c8e-9204-ace0541ff96a",
                        "source_entry_id": "abe7c142-5556-345e-b09d-57a7782218f7",
                        "source_sense_id": "f8086d6f-4721-35fc-8c1d-01da16aa6f72",
                        "source_sense_description": "Hausmädchen, Dienstmädchen",
                        "target_lang_word": "Hausmädchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hausmädchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "316e1ad2-8228-3e07-a6fa-5c35ee49f8e4",
                                        "entry_id": "04d52abf-65bd-3b74-afdd-13447fe1645b",
                                        "glosses": [
                                            "weibliche Person, die zur Verrichtung von Haushaltsaufgaben angestellt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "148e3d9c-b5d1-4087-af87-b65076ce4725",
                                                "sense_id": "316e1ad2-8228-3e07-a6fa-5c35ee49f8e4",
                                                "text": "Sie soll als Hausmädchen einer reichen Familie die schwangere Mutter des Hauses entlasten."
                                            },
                                            {
                                                "example_id": "2919263a-0cd4-40dd-b3e1-bcde631b7f4f",
                                                "sense_id": "316e1ad2-8228-3e07-a6fa-5c35ee49f8e4",
                                                "text": "„Abends, in meiner Pension, kreischt das dicke Hausmädchen auf, sie hält mich für ein Gespenst, sie befühlt meinen Arm, sie überzeugt sich, daß er aus Fleisch und Blut ist.“"
                                            },
                                            {
                                                "example_id": "69ea6bb8-716a-4888-877a-646b95f1783a",
                                                "sense_id": "316e1ad2-8228-3e07-a6fa-5c35ee49f8e4",
                                                "text": "„Sonja steht dann auf, sitzt neben Eva am Tisch, wo das Hausmädchen ihnen Frühstück mit Wein serviert.“"
                                            },
                                            {
                                                "example_id": "5b89f9cb-bd25-4131-97dc-9fbaf5eb5a0d",
                                                "sense_id": "316e1ad2-8228-3e07-a6fa-5c35ee49f8e4",
                                                "text": "„Die vergoldeten kleinen Ringe, die Belle den Hausmädchen schenkte, kosteten Geld.“"
                                            },
                                            {
                                                "example_id": "7f499ee7-abf4-43c4-ba17-f0b43ee3b0ad",
                                                "sense_id": "316e1ad2-8228-3e07-a6fa-5c35ee49f8e4",
                                                "text": "„Da sie auch Diener und Hausmädchen mitgenommen hätten, stünden ihre Villen und Paläste leer.“"
                                            },
                                            {
                                                "example_id": "8c99cc8c-5169-4d3a-a4a3-722a0c6c5088",
                                                "sense_id": "316e1ad2-8228-3e07-a6fa-5c35ee49f8e4",
                                                "text": "„Des öfteren wird Klein-Erna als Hausmädchen engagiert, und so können viele wohlbekannte Dienstmädchenwitze unbedenklich auf sie übertragen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
