                ],
                "senses": [
                    {
                        "sense_id": "23bdfac5-3e05-3726-80e5-e77ea6319752",
                        "entry_id": "1dcca000-69a5-39db-9495-6726321edbed",
                        "glosses": [
                            "Gemeinsame Sicherheits- und Verteidigungspolitik"
                        ],
                        "tags": [
                            "Akronym",
                            "Europäische Union"
                        ],
                        "examples": [
                            {
                                "example_id": "76083c9c-d3f0-4490-8ec2-7cb79bc84493",
                                "sense_id": "23bdfac5-3e05-3726-80e5-e77ea6319752",
                                "text": "Die Gemeinsame Sicherheits- und Verteidigungspolitik der EU (GSVP) ist schrittweise zwischen 1999 und 2003 entstanden und wurde durch den Vertrag von Lissabon wesentlich erweitert."
                            },
                            {
                                "example_id": "cd5f5a0d-1fc7-4ea6-8781-2f6240e5e01f",
                                "sense_id": "23bdfac5-3e05-3726-80e5-e77ea6319752",
                                "text": "Überdies dient die GSVP der Vorbereitung einer möglichen künftigen gemeinsamen Verteidigung der EU."
                            },
                            {
                                "example_id": "bb618a56-b9aa-4c37-887f-07cfea4e5b7d",
                                "sense_id": "23bdfac5-3e05-3726-80e5-e77ea6319752",
                                "text": "Hintergrund war die Erkenntnis, dass das Einstimmigkeitsprinzip in der Gemeinsamen Sicherheits- und Verteidigungspolitik der EU (GSVP) immer wieder ehrgeizige Projekte ausbremst oder ganz verhindert."
                            },
                            {
                                "example_id": "92d7714c-8d76-49ff-a5eb-4d0e4c333002",
                                "sense_id": "23bdfac5-3e05-3726-80e5-e77ea6319752",
                                "text": "Dass die Zusammenarbeit nicht schon viel früher vereinbart wurde, hatte vor allem mit dem Widerstand Großbritanniens gegen einen Ausbau der GSVP zu tun."
                            },
                            {
                                "example_id": "b9c448fe-7c97-42fb-b20f-ed259e21473e",
                                "sense_id": "23bdfac5-3e05-3726-80e5-e77ea6319752",
                                "text": "Denn das Grundproblem der GSVP kann niemand aus der Welt schaffen: Die 27 Mitgliedsstaaten der EU haben sehr unterschiedliche Vorstellungen über ihre Sicherheitspolitik und ihre Souveränität in Fragen von Krieg und Frieden."
                            },
                            {
                                "example_id": "79bded6c-b298-4b13-8e78-fa13ad736c40",
                                "sense_id": "23bdfac5-3e05-3726-80e5-e77ea6319752",
                                "text": "Die Haltung der Schweiz gegenüber GASP und GSVP sollte der Bundesrat aber rasch klären."
                            },
                            {
                                "example_id": "7bb7480f-5581-420c-ba08-bf9badb908d0",
                                "sense_id": "23bdfac5-3e05-3726-80e5-e77ea6319752",
                                "text": "Um mehr Mitsprache in strategischen Fragen einfordern zu können, müsste die Schweiz aber erst bereit sein, im Bereich von GASP und GSVP die Pflichten und Kosten eines «Assoziierten» zu tragen: formelle Unterstützung von Deklarationen und Sanktionen sowie regelmässige Beiträge an EU-Friedensmissionen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
