                "senses": [
                    {
                        "sense_id": "55729310-bfb4-36b2-8cb7-a70681a81fe2",
                        "entry_id": "aa156aca-0f25-334a-9f5a-129dafe3e939",
                        "glosses": [
                            "Arrêter de circuler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86f0af8b-0e5f-4a31-b699-e69aed1e854a",
                                "sense_id": "55729310-bfb4-36b2-8cb7-a70681a81fe2",
                                "text": "Ca fait tellement longtemps que des rumeurs circulent et décirculent, je pense qu’on aurait su quelque chose."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7c04592-47e6-3a50-9ba1-9de0a81c40c3",
                        "entry_id": "aa156aca-0f25-334a-9f5a-129dafe3e939",
                        "glosses": [
                            "Faire sortir de la circulation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "746cd8fe-a0e1-42ca-bc28-af7896acefa8",
                                "sense_id": "b7c04592-47e6-3a50-9ba1-9de0a81c40c3",
                                "text": "Des millions de créateurs de YouTube ont été soudainement traités comme des déchets de gouttière – décirculés, démontés et déplatés."
                            },
                            {
                                "example_id": "618eb4c9-247f-43f2-8f9f-1dcdcd780d55",
                                "sense_id": "b7c04592-47e6-3a50-9ba1-9de0a81c40c3",
                                "text": "Les pièces de un cent n'ont pas été produites; ils ont été décirculés en 2003 alors que les pièces de 1 dollar étaient désormais bi-métalliques, ressemblant aux pièces en euros de couleur or et argent."
                            },
                            {
                                "example_id": "cf8c3584-a4d4-4fe6-bc80-a6235af6d172",
                                "sense_id": "b7c04592-47e6-3a50-9ba1-9de0a81c40c3",
                                "text": "La plupart de ces invitations peuvent être considérées comme du spam et j’aimerais, dans ce cas, décirculer l’expéditeur, mais je ne trouve pas les informations sur le destinataire de l’invitation (il semble que ce ne soit pas toujours la même personne que l’administrateur de l’événement)."
                            },
                            {
                                "example_id": "e8305956-0707-44ea-9fd8-0205fe38a020",
                                "sense_id": "b7c04592-47e6-3a50-9ba1-9de0a81c40c3",
                                "text": "les zens se décirculent espressément, ils ont peur ;"
                            }
                        ]
                    }
