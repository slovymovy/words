    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c158caf1-e956-3336-be31-998f199f1ce6",
                "word": "canonization",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "eab7281b-c90f-4263-ad7b-434ed1319d54",
                        "entry_id": "c158caf1-e956-3336-be31-998f199f1ce6",
                        "tags": [
                            "plural"
                        ],
                        "form": "canonizations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "652d3611-8583-31bd-a154-029f27bb014f",
                        "entry_id": "c158caf1-e956-3336-be31-998f199f1ce6",
                        "glosses": [
                            "The final process or decree (following beatification) by which the name of a deceased person is placed in the catalogue (canon) of saints and commended to perpetual veneration and invocation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "da482a0e-99ed-36a0-ba35-e659ffa3bb52",
                        "entry_id": "c158caf1-e956-3336-be31-998f199f1ce6",
                        "glosses": [
                            "The state of being canonized or sainted."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "06d2f56c-d13b-43cb-83ef-6cc82742b00a",
                                "sense_id": "da482a0e-99ed-36a0-ba35-e659ffa3bb52",
                                "text": "Following the attribution of two miracles, the next step is for the Pope to convene a meeting of cardinals to agree on Acutis’ sainthood and decide on a date for the canonization."
                            }
                        ]
                    },
                    {
                        "sense_id": "bbf5b6d4-6561-3ce2-a549-c47aa7ec7c73",
                        "entry_id": "c158caf1-e956-3336-be31-998f199f1ce6",
                        "glosses": [
                            "Introduction into a canon of artistic or literary works."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f353655-00dc-482c-b3cc-4d084b962daa",
                        "source_entry_id": "c158caf1-e956-3336-be31-998f199f1ce6",
                        "source_sense_description": "the final process or decree",
                        "target_lang_word": "canonisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canonisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ee768bf-e5b2-336a-9d9e-a98f5c5c18c8",
                                        "entry_id": "2a669013-de38-3df9-a4ba-bdd220f4ec26",
                                        "glosses": [
                                            "Acte officiel par lequel le Pape inscrit le récipiendaire sur le catalogue des saints, autorisant sa vénération."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55f8aa1d-a84d-4895-a110-37a4dc762426",
                                                "sense_id": "9ee768bf-e5b2-336a-9d9e-a98f5c5c18c8",
                                                "text": "Peut-on considérer comme des fous théomanes tant de saints personnages qui depuis Jésus-Christ ont ressuscité des morts? Tous ces miracles consignés dans les procédures de canonisation, quel nom faut-il donc leur donner? Comment l'Église s'est-elle donc si lourdement trompée ?"
                                            },
                                            {
                                                "example_id": "441bf31c-b011-46c0-8f61-012fd258798e",
                                                "sense_id": "9ee768bf-e5b2-336a-9d9e-a98f5c5c18c8",
                                                "text": "Après la canonisation de Clodoald, 130 ans plus tard, Novigentum sera rebaptisé Sanctus Clodoaldus en l’honneur de son fondateur."
                                            },
                                            {
                                                "example_id": "569197dc-9e10-40f3-a724-c14b3ed7a9c2",
                                                "sense_id": "9ee768bf-e5b2-336a-9d9e-a98f5c5c18c8",
                                                "text": "Les régions qui relevaient de la chrétienté latine médiévale réaffirment leur identité (en même temps que leur appartenance à l’Europe) en revendiquant (et obtenant) la canonisation de saints médiévaux « nationaux » : Agnès de Bohême, Jean de Dukla, Edwige et Cunégonde de Pologne, etc."
                                            },
                                            {
                                                "example_id": "f293ea44-0a0f-4b84-b9e4-bcfd5b631efe",
                                                "sense_id": "9ee768bf-e5b2-336a-9d9e-a98f5c5c18c8",
                                                "text": "Union européenne-Vatican, 1-0. A l’Euro des saints, Bruxelles a un but d’avance face à la curie romaine. Dans la capitale européenne, la «Saint Schuman» existe depuis belle lurette. […]. Le Vatican, lui, vient juste, le 19 juin 2021, de proclamer l’homme politique «vénérable», c’est-à-dire qu’il a franchi la première marche vers la canonisation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fe0cf4d-6eda-4ecf-ad36-aa6f66004b04",
