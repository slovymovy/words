    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b3318ab9-8fb3-34e6-bea0-1997c29c3114",
                    "sense_definition": "Mettre du temps à arriver ou être sur le point de venir.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "arriver_venir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dépêche-toi un peu, le train ne va pas <w>tarder</w> et nous risquons de le manquer."
                        },
                        {
                            "text": "Elle a promis de venir rapidement, mais je crains qu'elle ne <w>tarde</w> en route."
                        }
                    ],
                    "synonyms": [
                        "traîner",
                        "s'attarder"
                    ],
                    "common_phrases": [
                        "ne pas tarder"
                    ]
                },
                {
                    "sense_id": "b3c1865e-1622-307e-bb17-f13c738913dd",
                    "sense_definition": "Différer ou attendre avant de faire quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action_delai",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès que vous recevrez ce courrier, veuillez répondre sans <w>tarder</w> à notre invitation."
                        },
                        {
                            "text": "Le médecin ne doit pas <w>tarder</w> à intervenir pour éviter toute complication grave."
                        }
                    ],
                    "synonyms": [
                        "différer",
                        "hésiter"
                    ],
                    "antonyms": [
                        "hâter",
                        "précipiter"
                    ],
                    "common_phrases": [
                        "sans tarder"
                    ]
                },
                {
                    "sense_id": "099813d3-ce39-3588-a170-2cd9970342be",
                    "sense_definition": "Être impatient face à la réalisation d'un événement, employé à la forme impersonnelle avec de ou que.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "impatience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après ces longues semaines d'absence, il me <w>tardait</w> de retrouver enfin toute ma famille."
                        },
                        {
                            "text": "Il lui <w>tarde</w> que les examens se terminent pour enfin pouvoir partir en vacances."
                        }
                    ],
                    "common_phrases": [
                        "il me tarde"
                    ]
                }
            ]
        }
    ]
