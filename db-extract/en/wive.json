                "senses": [
                    {
                        "sense_id": "d9bcf68d-0e0f-369a-8e72-40b2ff2442a6",
                        "entry_id": "21840fa5-4eb2-3e3a-8431-cbbeb95a0b7e",
                        "glosses": [
                            "To marry (a woman)."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "21e8b1b4-940a-40c7-a715-600f686fcec7",
                                "sense_id": "d9bcf68d-0e0f-369a-8e72-40b2ff2442a6",
                                "text": "If he have the condition of a saint and the complexion of a devil, I had rather he should shrive me than wive me."
                            }
                        ]
                    },
                    {
                        "sense_id": "96ad5686-44cb-3c93-bfa0-ec45544a38ed",
                        "entry_id": "21840fa5-4eb2-3e3a-8431-cbbeb95a0b7e",
                        "glosses": [
                            "To provide (someone) with a wife."
                        ],
