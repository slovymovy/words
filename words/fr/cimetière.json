            "senses": [
                {
                    "sense_id": "3e304cde-bc5a-326e-a6f1-aeb4bf3648d6",
                    "sense_definition": "Lieu aménagé où l'on enterre les corps des personnes décédées.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "inhumation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque automne, elle va fleurir la tombe de ses grands-parents au <w>cimetière</w> du village."
                        },
                        {
                            "text": "Un grand mur de pierre entoure le vieux <w>cimetière</w> situé juste derrière l'église."
                        }
                    ],
                    "synonyms": [
                        "cimetoche"
                    ],
                    "common_phrases": [
                        "gardien de cimetière",
                        "cimetière militaire"
                    ]
                },
                {
                    "sense_id": "6afa2995-f771-339c-95ec-22195febab86",
                    "sense_definition": "Lieu servant de dépôt ou de décharge pour des objets encombrants hors d'usage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "depot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mécanicien cherche des pièces détachées dans un <w>cimetière</w> de voitures abandonnées."
                        },
                        {
                            "text": "Des dizaines d'embarcations rouillées finissent leurs jours dans ce <w>cimetière</w> de bateaux."
                        }
                    ],
                    "common_phrases": [
                        "cimetière de voitures",
                        "cimetière d'avions",
                        "cimetière de bateaux"
                    ]
                },
                {
                    "sense_id": "0e79ffb7-2694-335a-be5d-b8fba722f848",
                    "sense_definition": "Lieu ou état abstrait où disparaissent et tombent dans l'oubli des idées ou des sentiments.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "figuratif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette réforme ambitieuse a malheureusement fini au <w>cimetière</w> des projets oubliés."
                        },
                        {
                            "text": "Tous ses espoirs de jeunesse ont été ensevelis dans le <w>cimetière</w> des illusions perdues."
                        }
                    ]
                }
            ]
        }
