                        "glosses": [
                            "Fait d’inventorier, de dénombrer dans un inventaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd84a0c6-a0bb-4e1c-a802-b1b58c22e684",
                                "sense_id": "ecf7641b-ea70-3aa7-9db0-67c17e0367e6",
                                "text": "À mon retour d’une mission en Haïti où j’ai animé avec le soutien de l’UNESCO une université d’été sur l’inventorisation du patrimoine immatériel à l’Université d’État d’Haïti."
                            },
                            {
                                "example_id": "3da2b2c4-8a1d-4bf9-8fb9-37f89af85d9e",
                                "sense_id": "ecf7641b-ea70-3aa7-9db0-67c17e0367e6",
                                "text": "Lors de la perquisition à Belgrade, 169 objets au total ont été saisis parmi lesquels environ 120 enregistrements audio et vidéo, des dossiers médicaux, «en cours d’inventorisation par l’accusation», selon la même source."
                            }
                        ]
                    }
