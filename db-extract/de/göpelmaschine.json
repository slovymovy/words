                "senses": [
                    {
                        "sense_id": "7c939209-f1b4-3612-b041-89eb73988fb8",
                        "entry_id": "ae715a2b-20b4-3e5a-98d3-cfa58dc99d1d",
                        "glosses": [
                            "Antriebswerk für Maschinen, das von einem oder mehreren Menschen, Tieren oder einer Maschine bewegt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b9e2bf5-ef6f-4ccb-a3d2-05ebcc24c342",
                                "sense_id": "7c939209-f1b4-3612-b041-89eb73988fb8",
                                "text": "„Anton Millbacher entschied, die Göpelmaschine nicht zu betreiben, sondern das Getreide in der Scheune zu lagern und im Winter mit dem Flegel zu dreschen.“"
                            },
                            {
                                "example_id": "ad3be236-7379-4269-a6c3-7f7be7a69801",
                                "sense_id": "7c939209-f1b4-3612-b041-89eb73988fb8",
                                "text": "„Höhepunkt des Mühlentages war ohne Zweifel die Wiederinbetriebnahme der 150 Jahre alten Göpelmaschine.“"
                            },
                            {
                                "example_id": "eef7f7e0-a474-4797-a566-f5f665700a50",
                                "sense_id": "7c939209-f1b4-3612-b041-89eb73988fb8",
                                "text": "„Um die Wende zum 20. Jahrhundert gab es bereits einfache Dreschmaschinen (Göpelmaschine), die durch Zugtiere (Pferde), die im Kreise gehen mussten, betrieben wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
