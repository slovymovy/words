                    }
                ],
                "translations": [
                    {
                        "translation_id": "58144e75-faaa-4a89-a8c5-b640c5d2dd7d",
                        "source_entry_id": "0fae0de8-bd2d-3d84-9bbf-d2a8af581f92",
                        "target_lang_word": "consistory",
                        "target_lang_code": "en",
