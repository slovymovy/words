                    },
                    {
                        "translation_id": "16aa53a3-efbe-4e57-9a76-df840c68c9e1",
                        "source_entry_id": "66624699-8ddb-334a-8822-a506b05dc7b1",
                        "source_sense_id": "c1594258-ee43-3ba7-86d3-d439d6164004",
                        "target_lang_word": "решительно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "решительно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b1d34743-d95a-3d6f-96a2-60323507746d",
                                        "entry_id": "28c37afd-aded-3503-8e39-a2a4f50c77ee",
                                        "glosses": [
                                            "нареч. твёрдо и энергично, без колебаний"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5f57ab0-b39e-4fe6-9920-268e22680168",
                                                "sense_id": "b1d34743-d95a-3d6f-96a2-60323507746d",
                                                "text": "Тогда Андрей решительно потребовал от новгородцев, чтобы они вновь приняли изгнанного ими Святослава."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1baf45b-1109-33d9-af5f-9624780b34c1",
                                        "entry_id": "28c37afd-aded-3503-8e39-a2a4f50c77ee",
                                        "glosses": [
                                            "нареч., перен. вовсе, совершенно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c286b0f-2f7c-4b30-ba9f-d1d50827febd",
                                                "sense_id": "b1baf45b-1109-33d9-af5f-9624780b34c1",
                                                "text": "Бедняге хочется спать, и ему нет решительно никакого дела до судеб русской революции!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d54a0b17-3481-3500-86ae-d2fe72259691",
                                        "entry_id": "28c37afd-aded-3503-8e39-a2a4f50c77ee",
                                        "glosses": [
                                            "разг., вводн. или частица выражает усиление, подчеркивание, уверенность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6895c662-2d48-478f-adc4-850557a29c88",
                                                "sense_id": "d54a0b17-3481-3500-86ae-d2fe72259691",
                                                "text": "Решительно Канкрин глуп."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf7be98e-5e98-314a-939e-60178268376d",
                                        "entry_id": "28c37afd-aded-3503-8e39-a2a4f50c77ee",
                                        "glosses": [
                                            "устар. окончательно, бесповоротно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f59e386e-8572-478a-91ac-57fca6456344",
                                                "sense_id": "cf7be98e-5e98-314a-939e-60178268376d",
                                                "text": "Бирон после этого письма падет решительно."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6641f8da-99f8-4ca7-9d17-924804492332",
                        "source_entry_id": "66624699-8ddb-334a-8822-a506b05dc7b1",
                        "source_sense_id": "c1594258-ee43-3ba7-86d3-d439d6164004",
                        "target_lang_word": "категорически",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "категорически",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f62a50b5-4bd5-3e6c-835d-8b3d7a09be54",
                                        "entry_id": "4d158465-be70-3bd6-811b-5c2eb5a3f518",
                                        "glosses": [
                                            "не допуская иного толкования, иного понимания; категорично"
                                        ],
                                        "tags": [
                                            "об ответе, высказывании"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0075ad67-d21f-4129-b6f5-7d6f021b238f",
                                                "sense_id": "f62a50b5-4bd5-3e6c-835d-8b3d7a09be54",
                                                "text": "Иные и не высказывают категорически своих намерений, но так ведут весь рассказ, что он оказывается ясным и правильным олицетворением их мысли."
                                            },
                                            {
                                                "example_id": "f340f4a4-62d7-499f-a348-8d4cc83bfb88",
                                                "sense_id": "f62a50b5-4bd5-3e6c-835d-8b3d7a09be54",
                                                "text": "Пресловутая «декларация прав» много бы выиграла в своем историческом значении, если бы более категорически выставила общие для всех обязанности, кроме простого упоминания о покорности закону и суду."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60facb4f-b827-33c5-869e-9f823df8c57f",
                                        "entry_id": "4d158465-be70-3bd6-811b-5c2eb5a3f518",
                                        "glosses": [
                                            "не допуская возражений; решительно, категорично"
                                        ],
                                        "tags": [
                                            "о тоне высказывания"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e551a41-9802-40ee-bcd7-bbca40ce069a",
                                                "sense_id": "60facb4f-b827-33c5-869e-9f823df8c57f",
                                                "text": "Порфирий Владимирыч был очень доволен, что он в эту решительную минуту так категорически выразился. Он смотрел на Улитушку светло и уверенно, словно говорил: а ну-тка, опровергни теперь меня!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
