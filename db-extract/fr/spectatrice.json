                ],
                "senses": [
                    {
                        "sense_id": "8bfed662-bf81-3097-9738-9a615f9415d7",
                        "entry_id": "6da2e993-b4fd-39bf-b922-c15d59f1498a",
                        "glosses": [
                            "Celle qui est témoin oculaire d’un événement, d’une action, de quoi que ce soit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0050e37e-2958-43a9-a751-b5b3c11b4e9a",
                                "sense_id": "8bfed662-bf81-3097-9738-9a615f9415d7",
                                "text": "La coanimatrice arrive à ce moment, elle s’intègre au groupe comme spectatrice."
                            }
                        ]
                    },
                    {
                        "sense_id": "79ec53b0-fc12-3ba6-9fdc-5954bcbd025c",
                        "entry_id": "6da2e993-b4fd-39bf-b922-c15d59f1498a",
                        "glosses": [
                            "Celle qui assiste à un spectacle, à une représentation théâtrale, à un évènement sportif, à quelque exercice, à quelque grande cérémonie ou réjouissance publique."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "18d2f570-58dd-42e5-be4b-5c6356a3a86b",
                                "sense_id": "79ec53b0-fc12-3ba6-9fdc-5954bcbd025c",
                                "text": "Si l’on ne dit pas une femme Autrice, c’est qu’une femme qui fait un livre est une femme extraordinaire ; mais il est dans l’ordre qu’une femme aime les spectacles, la poésie, etc. comme il est dans l’ordre qu’elle soit Spectatrice."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0acae4f7-016b-4764-b287-db96cccb59f9",
                        "source_entry_id": "6da2e993-b4fd-39bf-b922-c15d59f1498a",
                        "source_sense_description": "Celle qui est témoin oculaire",
                        "target_lang_word": "наблюдательница",
