            "senses": [
                {
                    "sense_id": "4c74a335-3b62-3423-bde6-d2283ad3b52a",
                    "sense_definition": "Een gebouw dat dient als woning en werkplaats voor een boer.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude <w>boerderij</w> heeft een prachtig rieten dak en witte muren.",
                            "target_lang_translations": {
                                "en": "The old <w>farmhouse</w> has a beautiful thatched roof and white walls."
                            }
                        },
                        {
                            "text": "Zij wonen op een <w>boerderij</w> met veel ruimte voor de dieren.",
                            "target_lang_translations": {
                                "en": "They live on a <w>farm</w> with plenty of space for the animals."
                            }
                        }
                    ],
                    "synonyms": [
                        "boerenplaats"
                    ],
                    "common_phrases": [
                        "op een boerderij"
                    ],
                    "target_lang_definitions": {
                        "en": "A building that serves as a home and workplace for a farmer."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "farmhouse",
                                "target_lang_sense_clarification": "the residential building on a farm"
                            },
                            {
                                "target_lang_word": "farmstead",
                                "target_lang_sense_clarification": "a farm including its main buildings"
                            },
                            {
                                "target_lang_word": "farm",
                                "target_lang_sense_clarification": "the place where agricultural activities occur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39181813-6333-33a3-bcb8-4232433d54e3",
                    "sense_definition": "Het gehele agrarische bedrijf van een boer, inclusief het land en de veestapel.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De familie runt al generaties lang een grote <w>boerderij</w> in deze regio.",
                            "target_lang_translations": {
                                "en": "The family has been running a large <w>farm</w> in this region for generations."
                            }
                        },
                        {
                            "text": "Een <w>gemengde</w> <w>boerderij</w> heeft zowel akkerbouw als veeteelt.",
                            "target_lang_translations": {
                                "en": "A mixed <w>farm</w> has both arable farming and livestock."
                            }
                        }
                    ],
                    "synonyms": [
                        "plaats"
                    ],
                    "common_phrases": [
                        "gemengde boerderij"
                    ],
                    "target_lang_definitions": {
                        "en": "The entire agricultural business of a farmer, including the land and livestock."
                    },
                    "translations": {
