                "senses": [
                    {
                        "sense_id": "ba8a0b4b-4635-3b6a-b48c-621ea08809af",
                        "entry_id": "46b3ad85-2fa6-37c8-b32d-65972b583300",
                        "glosses": [
                            "Kraftstoffeinspritzung für Ottomotoren, die den Kraftstoff durch Einspritzdüsen entweder in das Saugrohr oder direkt in die Brennkammer des jeweiligen Zylinders einbringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca2c84ef-ff92-44d4-8dd5-65f58d87c66f",
                                "sense_id": "ba8a0b4b-4635-3b6a-b48c-621ea08809af",
                                "text": "„Inzwischen hat die Bullet eine Benzineinspritzung, natürlich einen E-Starter und vorne eine Scheibenbremse.“"
                            },
                            {
                                "example_id": "f2f89149-e831-4e38-badc-70b3f8377c93",
                                "sense_id": "ba8a0b4b-4635-3b6a-b48c-621ea08809af",
                                "text": "„Tatsächlich stammt das Triebwerk aus der legendären GSX-R 750-Baureihe von 2005, tritt also mit zwei obenliegenden Nockenwellen, Benzineinspritzung mit Doppeldrosselklappen-Technologie und einem sportlich gestuften Sechsganggetriebe an.“"
                            }
                        ],
