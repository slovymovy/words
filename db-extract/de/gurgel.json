                    {
                        "sense_id": "b2db967e-0a1f-3380-92b2-f177f48f7074",
                        "entry_id": "59bb5eee-2709-3f32-addf-b066e7940ff7",
                        "glosses": [
                            "Kehle, Vorderseite des Halses"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "8309b93c-b73e-410b-9973-c1119932e8a5",
                                "sense_id": "b2db967e-0a1f-3380-92b2-f177f48f7074",
                                "text": "Ich habe ein unangenehmes Kratzen in der Gurgel."
                            },
                            {
                                "example_id": "e06dace3-dae5-4ce2-a695-b235344d38d9",
                                "sense_id": "b2db967e-0a1f-3380-92b2-f177f48f7074",
                                "text": "„Ich hatte mich kaum fünfzig Schritte vom Hause entfernt, als de Pienne mich einholte und erklärte, bevor Madame d'Aché Klage gegen mich führe, müßten wir uns an einen einsamen Platz begeben, um uns die Gurgel abzuschneiden.“"
                            }
                        ],
