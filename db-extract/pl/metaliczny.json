                                "target_senses": [
                                    {
                                        "sense_id": "f0f6b8f2-de4a-3e60-9d3b-5106ed3d8a76",
                                        "entry_id": "084d29af-e7ac-3393-b820-d07ca3123994",
                                        "glosses": [
                                            "Of, relating to, or characteristic of metal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "085a7067-f578-3ccf-957c-c7c56e20e5a0",
                                        "entry_id": "084d29af-e7ac-3393-b820-d07ca3123994",
                                        "glosses": [
                                            "Made of or containing metal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a5d9845-83b6-44b5-923a-28b497aced70",
                                                "sense_id": "085a7067-f578-3ccf-957c-c7c56e20e5a0",
                                                "text": "[…] and, lo ! a palace towering ſeems, / With Parian pillars and metallic beams."
                                            },
                                            {
                                                "example_id": "4191a2bc-8a76-4eaf-bcf7-81b26a9bcbb9",
                                                "sense_id": "085a7067-f578-3ccf-957c-c7c56e20e5a0",
                                                "text": "These chemical distinctions then, to which we have referred, are quite independent of physical condition. For instance, amongst the most metallic of the metals is a gas."
                                            },
                                            {
                                                "example_id": "7d8f8d34-1760-4282-845a-9f31df6852d0",
                                                "sense_id": "085a7067-f578-3ccf-957c-c7c56e20e5a0",
                                                "text": "Assemblymember Bill Quirk (D-Hayward) has introduced a bill to address power outages caused by metallic film balloons when they come into contact with powerlines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebb23fd8-1a14-3657-9113-7d75ce0c74ce",
                                        "entry_id": "084d29af-e7ac-3393-b820-d07ca3123994",
                                        "glosses": [
                                            "Harsh, as if coming from two metals striking one another."
                                        ],
                                        "tags": [
                                            "of a sound"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d421b94-9e28-4e66-9c2e-d937030c1e1e",
                                                "sense_id": "ebb23fd8-1a14-3657-9113-7d75ce0c74ce",
                                                "text": "No sooner had these syllables passed my lips, than—as if a shield of brass had indeed, at the moment, fallen heavily upon a floor of silver—I became aware of a distinct, hollow, metallic and clangorous, yet apparently muffled reverberation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2c69022-ecbc-3a96-b6ae-8808adbeeb10",
                                        "entry_id": "084d29af-e7ac-3393-b820-d07ca3123994",
                                        "glosses": [
                                            "Having the appearance of being of polished metal."
                                        ],
                                        "tags": [
                                            "of a color"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "metallic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "922eae30-b0ee-36e8-870c-c335a6d49ee8",
                                        "entry_id": "c457f1e8-b93e-3f2e-9cea-380364847f75",
                                        "glosses": [
                                            "A metallic color."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0a24467-ec06-4862-887f-fed5ff73c975",
                                                "sense_id": "922eae30-b0ee-36e8-870c-c335a6d49ee8",
                                                "text": "As Robert Clergerie, whose unisex Popée shoe comes in an array of pastels and eye-popping metallics, explained the attraction, “It gives manhood to women.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
