                ],
                "senses": [
                    {
                        "sense_id": "33cd43b5-6d70-3526-8dd9-716a50f39690",
                        "entry_id": "803baa5b-c316-35a7-ac50-d44a8e1c7141",
                        "glosses": [
                            "rote Rebsorte, die sehr häufig in den Weinbaugebieten Württemberg und Burgenland (hier als Blaufränkisch) angebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2e6c73e-a0a7-4d3f-97f7-ea66b1621438",
                                "sense_id": "33cd43b5-6d70-3526-8dd9-716a50f39690",
                                "text": "„Im Jahr 2001 steht der Lemberger bereits auf fast 1.300 Hektar Rebfläche. Die Sorte wird nahezu ausschließlich von den Württemberger ‚Wengertern‘ angebaut. Dort erreicht sie einen Anteil an der Rebfläche von 10 Prozent.“"
                            },
                            {
                                "example_id": "d23e3b53-5636-46ea-9c2f-d8b0ddcaed41",
                                "sense_id": "33cd43b5-6d70-3526-8dd9-716a50f39690",
                                "text": "„Der Lemberger ist seinem Wesen nach eine edle, elegante Sorte, der von übermotivierten Winzern leider zu oft zu viel zugemutet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e9811528-d437-319e-bd90-981690c3ab44",
                        "entry_id": "803baa5b-c316-35a7-ac50-d44a8e1c7141",
                        "glosses": [
                            "Wein, der aus der Rebsorte Lemberger hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bd57fa9-8bc0-4e45-a57a-d7b892349e15",
                                "sense_id": "e9811528-d437-319e-bd90-981690c3ab44",
                                "text": "„Der Lemberger stellt höchste Ansprüche an Boden und Lage. Mit dem kräftigen Körper und seinem feinherbem Geschmack paßt der Lemberger besonders gut zu Lamm und Wild.“"
                            },
                            {
                                "example_id": "7b5c1787-662b-482a-ad64-e7498f437522",
                                "sense_id": "e9811528-d437-319e-bd90-981690c3ab44",
                                "text": "„Wohl kaum ein württembergischer Winzer und auch keine Genossenschaft verzichtet mittlerweile darauf, wenigstens einen Lemberger im Premiumsegment anzubieten.“"
                            },
                            {
                                "example_id": "27b2b886-1003-4b06-9261-9a25609f9885",
                                "sense_id": "e9811528-d437-319e-bd90-981690c3ab44",
                                "text": "„Der Lemberger ist ein perfekter Partner zu regionalen Gerichten wie Blutwurst mit Bratkartoffeln, Kasseler oder Schweinekotelett.“"
                            },
                            {
                                "example_id": "e2b3a247-24b7-42ac-b057-7979e9120f09",
                                "sense_id": "e9811528-d437-319e-bd90-981690c3ab44",
                                "text": "„Der perfekte Wein dazu ist der Lemberger, der in Österreich unter der Bezeichnung Blaufränkisch und in Ungarn als Kékfrankos bekannt ist.“"
                            },
                            {
                                "example_id": "a8170f02-be59-474d-91d4-444cbee2c16d",
                                "sense_id": "e9811528-d437-319e-bd90-981690c3ab44",
                                "text": "„»Sag mal, einen Lemberger hättest du nicht zufällig auch noch im Angebot?«, wandte er sich an Sepp, der gerade die Kunststoffkapsel vom Flaschenhals entfernt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0c39f265-0b08-30d3-a009-7c44a5793147",
                        "entry_id": "803baa5b-c316-35a7-ac50-d44a8e1c7141",
                        "glosses": [
                            "Einwohner der Stadt Lemberg (Lwiw)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fcfcc72-a7c0-424f-b4b2-bae1c0ba237f",
                                "sense_id": "0c39f265-0b08-30d3-a009-7c44a5793147",
                                "text": "„Sein Vater, ein gebürtiger Lemberger, zog nach Wien, um dort Architektur zu studieren.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
