                "senses": [
                    {
                        "sense_id": "78e7fdd0-3498-3501-8c97-942e0bf0ebd9",
                        "entry_id": "7548ed87-ba22-3188-a65d-e8a48a5d6cdc",
                        "glosses": [
                            "Arbeitsmaschine, die durch Umwandlung von Energie mechanische Kraft zum Antrieb des Ventilators erzeugt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b7cf9bb-a03a-429a-ab3c-b33614652d5f",
                                "sense_id": "78e7fdd0-3498-3501-8c97-942e0bf0ebd9",
                                "text": "„Ein Ventilatormotor zeigte seit einigen Jahren immer mehr Abnutzungserscheinungen, die sich am immer höheren Kohleverbrauch messen liessen.“"
                            },
                            {
                                "example_id": "630ff8f3-4baf-47bd-92f8-38735dba4d0f",
                                "sense_id": "78e7fdd0-3498-3501-8c97-942e0bf0ebd9",
                                "text": "„Universell einsetzbarer Ventilatormotor mit Außenring, gegenüber fast allen Fabrikaten der Spaltpol-Motoren mit 5 und 7 Watt Wellenleistung voll austauschbar.“"
                            },
                            {
                                "example_id": "eee513a7-f005-4ba3-9af7-655bd2cc5eb2",
                                "sense_id": "78e7fdd0-3498-3501-8c97-942e0bf0ebd9",
                                "text": "Zwei Belüftungsstufen lassen sich auch mit Serie/Parallel-Umschaltung der Ventilatormotoren erreichen."
                            },
                            {
                                "example_id": "b38347b8-1992-4398-9a99-ea23362e7c9d",
                                "sense_id": "78e7fdd0-3498-3501-8c97-942e0bf0ebd9",
                                "text": "Sie eignet sich besonders gut für kleine und kleinste Maschinen (Nähmaschinenmotoren, Ventilatormotoren)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
