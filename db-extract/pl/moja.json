                                        ]
                                    },
                                    {
                                        "sense_id": "2e4d12df-af04-318d-8262-74d845a5f115",
                                        "entry_id": "95e70e84-de7d-3328-9189-0178dd970c0e",
                                        "glosses": [
                                            "First-person singular possessive determiner. See Appendix:Possessive#English.",
                                            "In the possession of me."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6640ba3a-2cd9-4667-b6f5-36e1e8216c3f",
