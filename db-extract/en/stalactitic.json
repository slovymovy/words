                        "glosses": [
                            "Consisting of or resembling stalactites."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f321231-8e7d-40ca-b979-03452637cfa6",
                                "sense_id": "848eecf8-bf30-36d9-8147-a742da6be635",
                                "text": "Dr. MacCulloch describes calcareous concretions, found in banks of sand in Perthshire, which present a great variety of stalactitic forms, generally more or less complicated, and often exceedingly intricate and strange […]."
                            },
                            {
                                "example_id": "f3cc8161-2b2b-4281-9ec2-320ed9710949",
                                "sense_id": "848eecf8-bf30-36d9-8147-a742da6be635",
                                "text": "In this manner, much as in the case of the growth of stalactitic matter between the blocks of stone in the roofs of a cavern, large fragments of rock, known as \"horses,\" are often pushed out into the body of the vein."
                            },
                            {
                                "example_id": "0c3720c1-9ca6-43bf-b129-bd28b4ae559f",
                                "sense_id": "848eecf8-bf30-36d9-8147-a742da6be635",
                                "text": "From this point both the landscape and the rocky cauldron are visible, and the latter is seen to be the remainder of a stalactitic cavern, the roof of which has fallen in."
                            }
                        ]
                    }
                ],
