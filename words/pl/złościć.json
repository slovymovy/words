                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie ma sensu <w>złościć</w> się o rzeczy, na które nie mamy wpływu.",
                            "target_lang_translations": {
                                "en": "There is no point in <w>getting angry</w> over things we have no control over.",
                                "ru": "Нет смысла <w>злиться</w> из-за вещей, на которые мы не можем повлиять.",
                                "nl": "Het heeft geen zin om <w>je op te winden</w> over dingen waar we geen invloed op hebben.",
                                "de": "Es hat keinen Sinn, <w>sich</w> über Dinge zu <w>ärgern</w>, auf die wir keinen Einfluss haben.",
                                "fr": "Cela ne sert à rien de <w>s'énerver</w> pour des choses sur lesquelles nous n'avons aucun contrôle.",
                                "it": "Non ha senso <w>arrabbiarsi</w> per cose su cui non abbiamo controllo.",
                                "cs": "Nemá smysl se <w>zlobit</w> kvůli věcem, které nemůžeme ovlivnit.",
                                "tr": "Etki edemeyeceğimiz şeyler yüzünden <w>kızmanın</w> hiçbir anlamı yok.",
                                "es": "No tiene sentido <w>enfadarse</w> por cosas sobre las que no tenemos control.",
                                "zh": "为我们无法左右的事情<w>生气</w>是没有意义的。"
                            }
                        },
                        {
                            "text": "Dziecko zaczęło <w>złościć</w> się, gdy zabrano mu ulubioną zabawkę.",
                            "target_lang_translations": {
                                "en": "The child began to <w>throw a tantrum</w> when his favorite toy was taken away.",
                                "ru": "Ребёнок начал <w>сердиться</w>, когда у него забрали любимую игрушку.",
                                "nl": "Het kind begon <w>boos te worden</w> toen zijn favoriete speelgoed werd afgepakt.",
                                "de": "Das Kind fing an, <w>sich</w> zu <w>ärgern</w>, als man ihm sein Lieblingsspielzeug wegnahm.",
                                "fr": "L'enfant a commencé à <w>se mettre en colère</w> quand on lui a retiré son jouet préféré.",
                                "it": "Il bambino ha iniziato ad <w>arrabbiarsi</w> quando gli è stato tolto il suo giocattolo preferito.",
                                "cs": "Dítě se začalo <w>vztekat</w>, když mu vzali oblíbenou hračku.",
                                "tr": "En sevdiği oyuncağı elinden alınınca çocuk <w>öfkelenmeye</w> başladı.",
                                "es": "El niño empezó a <w>enojarse</w> cuando le quitaron su juguete favorito.",
                                "zh": "当最喜欢的玩具被拿走时，孩子开始<w>发脾气</w>了。"
                            }
                        }
