    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "112b0973-c307-374a-98e6-8db0cc9ef0e8",
                "word": "sandstorm",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "dc13118d-a604-4e0c-9d02-4b9675b131b0",
                        "entry_id": "112b0973-c307-374a-98e6-8db0cc9ef0e8",
                        "tags": [
                            "plural"
                        ],
                        "form": "sandstorms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "09194dd4-bd57-3556-b6ea-4d0d0dd4950a",
                        "entry_id": "112b0973-c307-374a-98e6-8db0cc9ef0e8",
                        "glosses": [
                            "A strong wind carrying clouds of sand and dust through the air."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef361614-4de7-4693-80f8-993c1e4fdc03",
                                "sense_id": "09194dd4-bd57-3556-b6ea-4d0d0dd4950a",
                                "text": "Near-synonyms: duststorm, duster (broadly synonymous), haboob"
                            },
                            {
                                "example_id": "fc58ce1c-1a70-4751-8fdf-89ef236f792f",
                                "sense_id": "09194dd4-bd57-3556-b6ea-4d0d0dd4950a",
                                "text": "There are few sights more appalling than a sandstorm in the desert, the \"Zauba'ah\" as the Arabs call it."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef5693bb-baea-48d7-8e9d-6bd4017c5699",
                        "source_entry_id": "112b0973-c307-374a-98e6-8db0cc9ef0e8",
                        "source_sense_id": "09194dd4-bd57-3556-b6ea-4d0d0dd4950a",
                        "source_sense_description": "strong wind carrying clouds of sand",
                        "target_lang_word": "písečná bouře",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "acf20715-f3fa-4aa2-999d-88aa69657730",
                        "source_entry_id": "112b0973-c307-374a-98e6-8db0cc9ef0e8",
                        "source_sense_id": "09194dd4-bd57-3556-b6ea-4d0d0dd4950a",
                        "source_sense_description": "strong wind carrying clouds of sand",
                        "target_lang_word": "zandstorm",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zandstorm",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f9dea82a-914d-34a3-9f89-bdc1f0aa3e83",
                                        "entry_id": "d1a006bc-7a70-382f-a87c-f31e363afabf",
                                        "glosses": [
                                            "een harde, droge wind die boven een woestijngebied een grote hoeveelheid zand en stof doet opwaaien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "359682ab-8431-490c-9695-a8983b50d3ff",
                                                "sense_id": "f9dea82a-914d-34a3-9f89-bdc1f0aa3e83",
                                                "text": "De zandstormen van de Sahara doen veel stof en zand in zee of in Europa belanden."
                                            },
                                            {
                                                "example_id": "c223706c-20e5-4a8e-b332-9200e2bc41f8",
                                                "sense_id": "f9dea82a-914d-34a3-9f89-bdc1f0aa3e83",
                                                "text": "Voor de achtste keer in een maand tijd is vandaag een zandstorm over Irak getrokken. Opnieuw kwam daardoor een deel van het dagelijks leven stil te liggen. In een groot deel van het land sloten luchthavens, universiteiten en overheidsdiensten noodgedwongen hun deuren. Ook schoolexamens zijn met een dag uitgesteld."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc8f0e45-617b-4d7e-aa0c-5e5dc28f5cf2",
                        "source_entry_id": "112b0973-c307-374a-98e6-8db0cc9ef0e8",
                        "source_sense_id": "09194dd4-bd57-3556-b6ea-4d0d0dd4950a",
                        "source_sense_description": "strong wind carrying clouds of sand",
                        "target_lang_word": "tempête de sable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tempête de sable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f5e665c5-de71-30c9-82d3-4b6c17cf28ab",
                                        "entry_id": "21b4abd1-9a7a-39f7-97a3-733ad504dc8d",
                                        "glosses": [
                                            "Phénomène météorologique produit par des vents violents provoquant la déflation et le transport des particules de sable dans l’atmosphère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e2910b6-f552-4175-bf16-11ce47726ab3",
                                                "sense_id": "f5e665c5-de71-30c9-82d3-4b6c17cf28ab",
                                                "text": "Trois cent cinquante vols annulés, des millions d’habitants en train de suffoquer et une Cité interdite comme effacée : Pékin essuie lundi 15 mars sa plus grosse tempête de sable depuis dix ans, réduisant la visibilité à quelques centaines de mètres et aggravant encore la pollution d’origine humaine."
                                            },
                                            {
                                                "example_id": "60d44b2d-d6bc-4286-9fac-bb4381fe491e",
                                                "sense_id": "f5e665c5-de71-30c9-82d3-4b6c17cf28ab",
                                                "text": "Des tempêtes de sable ont provoqué des hospitalisations, des fermetures d'école et des perturbations du trafic aérien dans plusieurs pays du Moyen-Orient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8105eb9f-6d63-44c6-9df0-a089b0bdc796",
                        "source_entry_id": "112b0973-c307-374a-98e6-8db0cc9ef0e8",
                        "source_sense_id": "09194dd4-bd57-3556-b6ea-4d0d0dd4950a",
                        "source_sense_description": "strong wind carrying clouds of sand",
                        "target_lang_word": "Sandsturm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sandsturm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "921afc2f-eda8-388d-bd6c-88afd417a602",
                                        "entry_id": "3963f94e-ad62-31d7-b42d-62e57c0a5846",
                                        "glosses": [
                                            "Sturm oder starker Wind, der Sand mit sich führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12e5ee92-3993-4864-ab93-3aa1ecbf022e",
                                                "sense_id": "921afc2f-eda8-388d-bd6c-88afd417a602",
                                                "text": "Einige Sandstürme transportieren bis zu 100 Millionen Tonnen Sand über zum Teil sehr große Entfernungen!"
                                            },
                                            {
                                                "example_id": "29041fee-59ff-4df8-a947-d66372297e87",
                                                "sense_id": "921afc2f-eda8-388d-bd6c-88afd417a602",
                                                "text": "„Ihr neues Haus war ein Zelt, das einem starken Sandsturm schwerlich trotzen konnte.“"
                                            },
                                            {
                                                "example_id": "58282dc7-3463-4757-a327-ed512d9997a2",
                                                "sense_id": "921afc2f-eda8-388d-bd6c-88afd417a602",
                                                "text": "„Am Ende des Tages war der Regen verebbt, doch der heftige Wind war nun in einen Sandsturm übergegangen – Hunderte von Leuten, die in Motorradbrillen Schlange standen, um Essen zu fassen, waren ein sonderbarer, aber amüsanter Anblick.“"
                                            },
                                            {
                                                "example_id": "535bf21a-3c5d-419f-8a7e-6517f459767f",
                                                "sense_id": "921afc2f-eda8-388d-bd6c-88afd417a602",
                                                "text": "„Ferris’ Rückflug von Abu Dhabi verzögerte sich wegen eines Sandsturms, und so war es schon nach Mitternacht, als er endlich auf dem Queen-Alia-Flughafen landete.“"
                                            },
                                            {
                                                "example_id": "5f1916f5-de68-45fb-8740-f8f32ef90bb2",
                                                "sense_id": "921afc2f-eda8-388d-bd6c-88afd417a602",
                                                "text": "„Sandstürme kommen im Frühling im Norden Chinas häufig vor, oft kommt der Sand aus der Wüste Gobi.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
