                                        "sense_id": "5cd73bd7-3b24-3ff1-9aac-91e641cff713",
                                        "entry_id": "6b8d19b2-1208-3be1-8ec3-3520c5a418b8",
                                        "glosses": [
                                            "Any imagined frightful object, especially one supposed to haunt the darkness; a bugbear."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aab13d08-88a1-4bd1-91c4-48fafb7ea090",
                                                "sense_id": "5cd73bd7-3b24-3ff1-9aac-91e641cff713",
                                                "text": "The very leaves on the horse-chesnuts[…]cling to the bough as if old poker was coming to take them away."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "988284a5-6cb3-4786-a66e-6915f879e0a4",
                        "source_entry_id": "1e010b99-13c8-3e38-be87-fc495ef5be27",
                        "source_sense_id": "1da17442-1ffc-3253-af1f-b0c59a2e2873",
                        "target_lang_word": "poker",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poker",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d68a2f5-d153-305e-b646-e26e1ae0d7e7",
                                        "entry_id": "08f29b1f-ad0e-3ea0-a36c-c9feca41742b",
                                        "glosses": [
                                            "Jeu de cartes où chaque joueur doit former la meilleure combinaison possible de cinq cartes, selon la hiérarchie des mains de poker."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17e7eae3-813e-410d-91b7-cd7d52348ffd",
                                                "sense_id": "9d68a2f5-d153-305e-b646-e26e1ae0d7e7",
                                                "text": "Quand elle avait chez elle de ces célébrités de la littérature et de la politique elle se contentait, comme la duchesse de Guermantes, de les faire jouer au poker. Ils aimaient souvent mieux cela que les grandes conversations à idées générales où les contraignait Mᵐᵉ de Villeparisis."
                                            },
                                            {
                                                "example_id": "5c659dd4-d7b5-4a17-a65a-ce86f1df90c6",
                                                "sense_id": "9d68a2f5-d153-305e-b646-e26e1ae0d7e7",
                                                "text": "Tout au plus mirent-ils dans leurs parties de poker – qu’ils découvraient alors et qui était en passe de devenir l’ultime refuge de leurs amitiés fatiguées – un acharnement qui, à certains instants, pouvait paraître suspect."
                                            },
                                            {
                                                "example_id": "2980cc1b-75c5-4d80-9411-40d4fa8a3c1d",
                                                "sense_id": "9d68a2f5-d153-305e-b646-e26e1ae0d7e7",
                                                "text": "Quand on joue au poker à ce niveau, ce n'est pas avec des perdreaux de l'année. Sans que cela suppose nécessairement des accointances avec le crime organisé."
                                            },
                                            {
                                                "example_id": "b0e4c8c2-bc51-411b-8220-7487ff8cba3c",
                                                "sense_id": "9d68a2f5-d153-305e-b646-e26e1ae0d7e7",
                                                "text": "Après, nous avons, en vrac, les addicts au poker, aux jeux en ligne, au tchat, à Facebook. Et, pour finir, les addicts… au chocolat. Oui, au chocolat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25793cf2-82e2-3e9b-918a-47edb849e3ab",
                                        "entry_id": "08f29b1f-ad0e-3ea0-a36c-c9feca41742b",
                                        "glosses": [
                                            "Carré, ensemble de quatre cartes ayant chacune la même valeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88a94ace-eaad-4ea4-ac8f-7b8586d1a145",
                                                "sense_id": "25793cf2-82e2-3e9b-918a-47edb849e3ab",
                                                "text": "Poker d'as."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poker",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f948926-5387-3b57-896d-8ef3046322c9",
                                        "entry_id": "3b353704-23a2-39d0-a38b-aa70b4361bc0",
                                        "glosses": [
                                            "Tisonnier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fa7684d-5201-4b64-b687-8959437e8056",
                                                "sense_id": "9f948926-5387-3b57-896d-8ef3046322c9",
                                                "text": "Un grand découragement le poigna ; le vide de sa vie murée lui apparut, et, tout en tisonnant le coke avec son poker, M. Folantin, penché en avant sur son fauteuil, le front sur le rebord de la cheminée, se mit à parcourir le chemin de croix de ses quarante ans, s’arrêtant, désespéré, à chaque station."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poker",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6e31b7c-e293-35f5-8d68-9a832efebb45",
                                        "entry_id": "43235aa4-b9d7-3176-b439-be94adcf63ce",
                                        "glosses": [
                                            "Se signaler à un autre membre de Facebook, sans lui envoyer de message particulier."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "245fafda-3e07-49ef-af8c-9d98a7c2fb82",
                                                "sense_id": "e6e31b7c-e293-35f5-8d68-9a832efebb45",
                                                "text": "Facebook ne sert pas qu’à «liker» et à «poker»."
                                            },
                                            {
                                                "example_id": "6362b67c-9ac0-4485-bbcc-a3d241656d60",
                                                "sense_id": "e6e31b7c-e293-35f5-8d68-9a832efebb45",
                                                "text": "En pokant un membre (ami ou pas), c’est comme si vous lui tapiez sur l’épaule pour lui dire coucou, je suis là."
                                            },
                                            {
                                                "example_id": "e1ff2e04-ad0f-4915-8495-60c34095ff97",
                                                "sense_id": "e6e31b7c-e293-35f5-8d68-9a832efebb45",
                                                "text": "On m’a poké je fais quoi ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb39fc74-092d-44b1-835c-49256f400f91",
                        "source_entry_id": "1e010b99-13c8-3e38-be87-fc495ef5be27",
                        "source_sense_id": "1da17442-1ffc-3253-af1f-b0c59a2e2873",
                        "target_lang_word": "Poker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Poker",
