                        "glosses": [
                            "Obstruer les conduits naturels."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "07f07f37-019f-4425-884c-ebdf1c9c4068",
                                "sense_id": "d2a944b4-1f27-3131-8d71-b837d184ff9f",
                                "text": "ensuite de quoi la circulation du sang étant retardée et ralentie, les plus grossières parties de ce sang, s’attachant les unes aux autres, pourraient facilement lui opiler la rate, en s’embarrassant et s’arrêtant dans ses pores; et les plus subtiles, retenant leur agitation, lui pourraient altérer le poumon, et causer une toux, qui à la longue serait fort à craindre."
                            }
                        ]
