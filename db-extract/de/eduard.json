                "senses": [
                    {
                        "sense_id": "f91e3643-e489-3c7a-9ce5-be769a1f5f7f",
                        "entry_id": "eab2ba2e-86e3-3ee2-a8b9-242fc93fcc13",
                        "glosses": [
                            "männlicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77e9363f-072b-4b7a-954b-9e897058d012",
                                "sense_id": "f91e3643-e489-3c7a-9ce5-be769a1f5f7f",
                                "text": "Schon viele Jahre studiert Eduard Medizin."
                            },
                            {
                                "example_id": "7660c2c9-7171-49e6-96de-48416c9cc56a",
                                "sense_id": "f91e3643-e489-3c7a-9ce5-be769a1f5f7f",
                                "text": "Seit einer bestandenen Seepferdchenprüfung liebt Eduard Schwimmbäder."
                            },
                            {
                                "example_id": "7714c727-05a4-4364-8b3d-fbfe7e1c0dde",
                                "sense_id": "f91e3643-e489-3c7a-9ce5-be769a1f5f7f",
                                "text": "Die ganze Firma fuhr ins Krankenhaus, um Eduard nach seiner Gallenoperation zum Geburtstag zu gratulieren."
                            },
                            {
                                "example_id": "6dd80b04-dd71-4908-8d25-c743f7723a76",
                                "sense_id": "f91e3643-e489-3c7a-9ce5-be769a1f5f7f",
                                "text": "Den schlauen Eduard hat der Chef jetzt zur Standortanalyse nach Sachsen geschickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc53eb72-db3e-47fa-bdca-6d5cbae27a5f",
                        "source_entry_id": "eab2ba2e-86e3-3ee2-a8b9-242fc93fcc13",
                        "source_sense_id": "f91e3643-e489-3c7a-9ce5-be769a1f5f7f",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Edward",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Edward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73c48691-3812-3f6f-aea3-13610c7942d3",
                                        "entry_id": "827c856f-25f4-3948-9a5e-725a2739cd5a",
                                        "glosses": [
                                            "A male given name from Old English."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ee615e3-3d65-4883-96c1-3a26ffb9f458",
                                                "sense_id": "73c48691-3812-3f6f-aea3-13610c7942d3",
                                                "text": "The Christian humility of King Edward the Confessour brought such credit to this name, that since that time it hath been most usual in all estates."
                                            },
                                            {
                                                "example_id": "65c70d7d-98bb-4f61-abd8-3b37b1689e7e",
                                                "sense_id": "73c48691-3812-3f6f-aea3-13610c7942d3",
                                                "text": "Heaven is my witness! that in the warmest transport of my wishes for the prosperity of my child, I never once wished to crown his head with more glory and honour than what George or Edward would have spread around it."
                                            },
                                            {
                                                "example_id": "623d78e9-1a28-4dc0-aad3-8b3d93a25084",
                                                "sense_id": "73c48691-3812-3f6f-aea3-13610c7942d3",
                                                "text": "There's a world of difference between the name Edward, which sounds rather regal and stuffy (Edwardian) and the name Eddie, which sounds like a guy on the bus."
                                            },
                                            {
                                                "example_id": "29072844-ccca-49f4-b690-7bafdd34d26a",
                                                "sense_id": "73c48691-3812-3f6f-aea3-13610c7942d3",
                                                "text": "The engineers are Akash Bobba, Edward Coristine, Luke Farritor, Gautier Cole Killian, Gavin Kliger, and Ethan Shaotran."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3adad8b9-2738-3613-bcc6-58147661063d",
                                        "entry_id": "827c856f-25f4-3948-9a5e-725a2739cd5a",
                                        "glosses": [
                                            "A surname. See also Edwards."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Edward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b96408b-30f1-32da-a20d-baa3011a4f10",
                                        "entry_id": "a840541c-3bea-3e0f-8108-1d25a296272a",
                                        "glosses": [
                                            "A gold coin produced in the reign of King Edward."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbcf2cec-2edd-4620-9972-a582644ff30f",
                                                "sense_id": "8b96408b-30f1-32da-a20d-baa3011a4f10",
                                                "text": "It is indeed the same golden Edward, with three holes in it, with which I presented my Mary on her birthday, in her eighteenth year, to buy a new suit for the holidays."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6dbab683-b575-477e-acd2-ca3e3a94f8d6",
                        "source_entry_id": "eab2ba2e-86e3-3ee2-a8b9-242fc93fcc13",
                        "source_sense_id": "f91e3643-e489-3c7a-9ce5-be769a1f5f7f",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Édouard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Édouard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b5bfd133-1b18-3150-b161-541d389cfe69",
                                        "entry_id": "77c1b983-f038-3f58-9821-34aa510e2323",
                                        "glosses": [
                                            "Prénom masculin français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6483fabe-c1fe-43fd-8711-ea133182ebd0",
                                                "sense_id": "b5bfd133-1b18-3150-b161-541d389cfe69",
                                                "text": "Édouard fume le cigare\nEt Léonard porte une barbe noire\nLéontine fait la cuisine\nMonsieur Gaston s’occupe du téléfon."
                                            },
                                            {
                                                "example_id": "b7d2b4a7-8de6-48f0-b33a-72d7aba331b7",
                                                "sense_id": "b5bfd133-1b18-3150-b161-541d389cfe69",
                                                "text": "L’idée de construire des pavillons à partir de terre crue, grâce à une impression 3D, a valu sa sélection à Édouard François."
                                            },
                                            {
                                                "example_id": "1e4fd899-e190-4938-bedf-f40b95e05710",
                                                "sense_id": "b5bfd133-1b18-3150-b161-541d389cfe69",
                                                "text": "Édouard boutonna son duffle-coat et traversa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b2a11a7-e74b-3f31-8604-43a824788f3d",
                                        "entry_id": "77c1b983-f038-3f58-9821-34aa510e2323",
                                        "glosses": [
                                            "Prénom francisé de plusieurs rois d’Angleterre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "befcb690-6452-44c7-b8e5-f9f7a5fdfcfa",
                                                "sense_id": "4b2a11a7-e74b-3f31-8604-43a824788f3d",
                                                "text": "Les cheveux sont blonds, - de ce blond familier aux filles de Normandie, qui a la couleur du blé mûr noirci par l'âpre chaleur solaire d'Août, et qui attend la faucille. Eux, ces cheveux mûrs aussi, mais pour une autre faucille, ne l'ont pas attendue longtemps ! Elle les porte courts, carrément coupés sur le front, avec deux lourdes touffes, sans frisure, tombant des deux côtés des joues, - à peu près comme les Enfants d'Édouard dans le célèbre tableau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
