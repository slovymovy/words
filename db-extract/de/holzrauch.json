                        "sense_id": "33e3bb7d-257e-3be6-aa23-c3b556b8da17",
                        "entry_id": "975aca20-aab7-308a-9776-e6969297e0ed",
                        "glosses": [
                            "Rauch, der beim Verbrennen von Holz entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac9e4591-5773-4ce2-93e5-50370c1b4864",
                                "sense_id": "33e3bb7d-257e-3be6-aa23-c3b556b8da17",
                                "text": "„Sie ließen die Jacketts und die Decke auf dem Boden vor dem Rücksitz liegen und gingen die Straße hinauf, um weitere Häuser zu durchsuchen. In der feuchten Luft Holzrauch.“"
                            },
                            {
                                "example_id": "16f4261a-c53b-4001-8372-f02ca07f4cc7",
                                "sense_id": "33e3bb7d-257e-3be6-aa23-c3b556b8da17",
                                "text": "„Zigarettenqualm und Holzrauch hingen in Nebelschichten über ihren Köpfen, als sie Novella dabei zusahen, wie sie sich auf der Bühne bewegte und ihnen erst eine Frontansicht, dann eine Seiten-, dann eine Rückansicht präsentierte.“"
                            }
                        ],
