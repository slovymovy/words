                    "synonyms": [
                        "fout",
                        "verkeerd"
                    ],
                    "antonyms": [
                        "juist",
                        "correct"
                    ],
                    "common_phrases": [
                        "faliekant verkeerd",
                        "faliekant mis"
                    ],
                    "target_lang_definitions": {
