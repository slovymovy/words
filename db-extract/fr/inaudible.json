                                                "sense_id": "0082a05d-6d08-3795-b111-951405f5dd6e",
                                                "text": "Dogs can hear this whistle, but for people it is inaudible."
                                            },
                                            {
                                                "example_id": "7b8eef64-ac89-4d9e-8671-41e029daebd3",
                                                "sense_id": "0082a05d-6d08-3795-b111-951405f5dd6e",
