                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7648de7-3148-4945-8f6b-eb6ddb6b7e37",
                        "source_entry_id": "99d47b67-78da-3cc1-a97d-1f83fa75f5cd",
                        "source_sense_id": "fe6bac54-7752-36e5-b878-ffcbeaa3801b",
                        "target_lang_word": "racist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "racist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f00501d8-c07a-316a-95e1-db59f88ab5eb",
                                        "entry_id": "e462ec93-227b-36cb-bd5e-e68235ef2622",
                                        "glosses": [
                                            "A person who believes in or supports racism; a person who believes that a particular race is superior to others, or who discriminates against other races."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45a5da13-292b-4df4-95ef-b10974a81e01",
                                                "sense_id": "f00501d8-c07a-316a-95e1-db59f88ab5eb",
                                                "text": "I don't blame racists, sexists, lookists, or any other “ists” for what they personify and perpetuate. They are mere hostages of their egos."
                                            },
                                            {
                                                "example_id": "493afcaa-2430-4940-a9bd-3931a6b7cfe5",
                                                "sense_id": "f00501d8-c07a-316a-95e1-db59f88ab5eb",
                                                "text": "Almost all the students I interviewed and worked with in group-facilitated discussions resisted being called a racist. This label was just too painful and for most students would not be accepted."
                                            },
                                            {
                                                "example_id": "7fa9c8e4-4f74-44b5-8746-80142e41908d",
                                                "sense_id": "f00501d8-c07a-316a-95e1-db59f88ab5eb",
                                                "text": "Narrators demonstrated resistance coping techniques through direct confrontation with aggressors, such as racists, sexists, homophobes, elitists, and misogynoirists."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "racist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35fe3d97-8268-37c2-94bd-1924d03f0e9a",
                                        "entry_id": "fb35a743-689d-3516-abd1-5482df2691fa",
                                        "glosses": [
                                            "Constituting, exhibiting, advocating, or pertaining to racism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d519d1e6-419b-4525-91d2-61b679abc5fd",
                                                "sense_id": "35fe3d97-8268-37c2-94bd-1924d03f0e9a",
                                                "text": "I'm pretty sure I'm flunking math because my teacher is racist against Latinos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bb444f2-a97c-35fe-beaa-e5ffd226ceb9",
                                        "entry_id": "fb35a743-689d-3516-abd1-5482df2691fa",
                                        "glosses": [
                                            "Discriminatory."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "colloquial",
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0048c5f0-bb8b-47ab-95e0-0582b8f3a36f",
                                                "sense_id": "2bb444f2-a97c-35fe-beaa-e5ffd226ceb9",
                                                "text": "The guy said the remark sarcastically, as if he was racist against homosexuals."
                                            },
                                            {
                                                "example_id": "6226ae69-231f-4afd-8696-61a80cb4e841",
                                                "sense_id": "2bb444f2-a97c-35fe-beaa-e5ffd226ceb9",
                                                "text": "They don't allow Muslims and gays to join the club? That's racist!"
                                            },
                                            {
                                                "example_id": "be94ce0a-9c96-450b-a79c-9a33d57a79b2",
                                                "sense_id": "2bb444f2-a97c-35fe-beaa-e5ffd226ceb9",
                                                "text": "Oh oh.. the term 'Neo-Nazi'.. just a few days ago, I heard a few girls sitting next to my table talking about this guy who was racist against females and call them 'femine-Nazi' (sp?)"
                                            },
                                            {
                                                "example_id": "15bc7670-e1df-4aa9-ac66-27740216bbfd",
                                                "sense_id": "2bb444f2-a97c-35fe-beaa-e5ffd226ceb9",
                                                "text": "Could it be the hate-filled content and the racist attitudes towards women and homosexuals?"
                                            },
                                            {
                                                "example_id": "c8139a3c-98c4-40f9-a284-8c53bef59847",
                                                "sense_id": "2bb444f2-a97c-35fe-beaa-e5ffd226ceb9",
                                                "text": "so you are racist against gay ppl? I didnt know cable co's hired racist ppl!"
                                            },
                                            {
                                                "example_id": "c685db49-7afd-4297-872e-e50c87d3981e",
                                                "sense_id": "2bb444f2-a97c-35fe-beaa-e5ffd226ceb9",
                                                "text": "People are racist against the sick and injured"
                                            },
                                            {
                                                "example_id": "9a9527ba-3d68-4c62-8a26-a7194c2e81db",
                                                "sense_id": "2bb444f2-a97c-35fe-beaa-e5ffd226ceb9",
                                                "text": "Amber went thoughtful. I wondered if she was racist against lesbian people."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
