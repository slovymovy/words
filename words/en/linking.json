                    "sense_definition": "Present participle and gerund of <w>link</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The yard manager is <w>linking</w> the sections of the train together.",
                            "target_lang_translations": {
                                "ru": "Начальник парка <w>сцепляет</w> секции поезда вместе.",
                                "es": "El jefe de patio está <w>acoplando</w> las secciones del tren entre sí.",
                                "fr": "Le chef de gare est en train d'<w>atteler</w> les wagons du train ensemble."
                            }
                        },
                        {
                            "text": "She is <w>linking</w> her phone to the car's audio system via Bluetooth.",
                            "target_lang_translations": {
                                "ru": "Она <w>подключает</w> свой телефон к аудиосистеме автомобиля через Bluetooth.",
                                "es": "Ella está <w>conectando</w> su teléfono al sistema de audio del coche por Bluetooth.",
                                "fr": "Elle est en train de <w>connecter</w> son téléphone au système audio de la voiture via Bluetooth."
                            }
                        }
                    ],
