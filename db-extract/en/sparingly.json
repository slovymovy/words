                                            {
                                                "example_id": "9a0fe3f3-700f-429f-8f7c-1fc3fea1ba6d",
                                                "sense_id": "bc3b625c-f74d-38fb-9923-50a97f9d1404",
                                                "text": "Zijn spaarzame manier van leven bracht hem tot aanzienlijke rijkdom."
