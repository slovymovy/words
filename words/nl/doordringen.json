{
    "word_family": [
        "doordringbaar",
        "doordringing",
        "doordringendheid"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "da0a74e3-5aea-383c-8f2a-13192daeaef7",
                    "sense_definition": "ergens met moeite binnenkomen of een weg vinden door een barrière",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fysieke beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het water <w>drong</w> langzaam door de oude muren van de kelder <w>door</w>.",
                            "target_lang_translations": {
                                "en": "The water slowly <w>seeped</w> through the old walls of the basement."
                            }
                        },
                        {
                            "text": "De soldaten probeerden tot het centrum van de stad <w>door te dringen</w>.",
                            "target_lang_translations": {
                                "en": "The soldiers tried to <w>penetrate</w> to the center of the city."
                            }
                        }
                    ],
                    "synonyms": [
                        "binnendringen",
                        "penetreren",
                        "doorsijpelen"
                    ],
                    "common_phrases": [
                        "tot de kern doordringen",
                        "diep doordringen"
                    ],
                    "target_lang_definitions": {
                        "en": "To enter somewhere with difficulty or find a way through a barrier"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to penetrate",
                                "target_lang_sense_clarification": "to pass through a surface or barrier"
                            },
                            {
                                "target_lang_word": "to seep through",
                                "target_lang_sense_clarification": "to slowly pass through small openings"
                            },
                            {
                                "target_lang_word": "to break through",
                                "target_lang_sense_clarification": "to force a way through an obstacle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6873c500-b13e-3287-a536-bc8feb64fc8b",
                    "sense_definition": "volledig begrepen worden of tot iemands bewustzijn komen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "begrip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>drong</w> eindelijk tot hem <w>door</w> dat hij de wedstrijd had gewonnen.",
                            "target_lang_translations": {
                                "en": "It finally <w>sank in</w> that he had won the match."
                            }
                        },
                        {
                            "text": "Ik moest de schokkende boodschap even rustig tot me laten <w>doordringen</w>.",
                            "target_lang_translations": {
                                "en": "I had to let the shocking message <w>sink in</w> for a moment."
                            }
                        }
                    ],
                    "synonyms": [
                        "dagen",
                        "beseffen",
                        "inzien"
                    ],
                    "common_phrases": [
                        "tot iemand doordringen",
                        "laten doordringen"
                    ],
                    "target_lang_definitions": {
                        "en": "To be fully understood or to reach someone's consciousness"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to sink in",
                                "target_lang_sense_clarification": "to be gradually understood or realized"
                            },
                            {
                                "target_lang_word": "to dawn on",
                                "target_lang_sense_clarification": "to suddenly become clear to someone"
                            },
                            {
                                "target_lang_word": "to register",
                                "target_lang_sense_clarification": "to be noticed or understood"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0817844-3bd4-37e2-96ab-5a0a53f42b5e",
                    "sense_definition": "iemand volledig overtuigen van de ernst of het belang van iets",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overtuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar <w>doordrong</w> de leerlingen van het belang van goede cijfers.",
                            "target_lang_translations": {
                                "en": "The teacher <w>impressed</w> the importance of good grades <w>upon</w> the students."
                            }
                        },
                        {
                            "text": "Ik <w>doordrong</w> hen van de noodzaak om direct actie te ondernemen.",
                            "target_lang_translations": {
                                "en": "I <w>convinced</w> them of the need to take immediate action."
                            }
                        }
                    ],
                    "synonyms": [
                        "overtuigen",
                        "doordringen van"
                    ],
                    "common_phrases": [
                        "iemand doordringen van"
                    ],
                    "target_lang_definitions": {
                        "en": "To fully convince someone of the seriousness or importance of something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to impress upon",
                                "target_lang_sense_clarification": "to emphasize the importance of something to someone"
                            },
                            {
                                "target_lang_word": "to instill",
                                "target_lang_sense_clarification": "to firmly establish an idea or attitude"
                            },
                            {
                                "target_lang_word": "to convince",
                                "target_lang_sense_clarification": "to make someone believe in the necessity of something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}