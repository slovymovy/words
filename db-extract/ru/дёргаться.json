                                        "glosses": [
                                            "S’agiter d’un mouvement vif et irrégulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "284fe387-7247-4208-a1c0-c71426444d5a",
                                                "sense_id": "945d06e2-a35d-3195-9af1-600fc9ee1397",
                                                "text": "De leur balcon qu'on atteignait par une échelle,, les musiciens déversaient sans répit sur la foule, des airs de valse, de java, de shimmy, de charleston et tout le monde se trémoussait."
                                            },
                                            {
                                                "example_id": "177e3956-c185-4fc8-b5f3-7300b6155d76",
                                                "sense_id": "945d06e2-a35d-3195-9af1-600fc9ee1397",
                                                "text": "Il se mit à se trémousser sur sa chaise, secoué d'un accès d'hilarité, des larmes dans les yeux, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "457bbdc1-3aa5-3c8f-9a70-9f8204c04c48",
                                        "entry_id": "2ac09847-612d-3251-9d28-11c745a5f61f",
                                        "glosses": [
                                            "Faire des démarches nombreuses, se donner beaucoup de mouvement pour faire réussir une affaire."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
