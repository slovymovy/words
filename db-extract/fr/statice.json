                "senses": [
                    {
                        "sense_id": "7ca22ca8-8361-3b0f-acb0-20434f4d1b5a",
                        "entry_id": "e02e53fc-473f-39e1-bbc3-390f744e4f67",
                        "glosses": [
                            "Plante du genre Limonium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc514b68-f4b6-4341-8aed-0509a9547413",
                                "sense_id": "7ca22ca8-8361-3b0f-acb0-20434f4d1b5a",
                                "text": "Grande statice, Limoniastrum monopetalum."
                            },
                            {
                                "example_id": "801143cb-f269-4756-a7d9-d51a49c0ceed",
                                "sense_id": "7ca22ca8-8361-3b0f-acb0-20434f4d1b5a",
                                "text": "Statice de l'ouest, Limonium binervosum."
                            },
                            {
                                "example_id": "0952b3e7-9d8c-4cd1-8f2a-78252bff0fbe",
                                "sense_id": "7ca22ca8-8361-3b0f-acb0-20434f4d1b5a",
                                "text": "Le statice à feuilles cordées (Limonium cordatum) est une espèce endémique du littoral provençal et ligure."
                            },
                            {
                                "example_id": "eb9b69b5-7095-4162-b281-7c84ecc3a48a",
                                "sense_id": "7ca22ca8-8361-3b0f-acb0-20434f4d1b5a",
                                "text": "Les inflorescences des statices sont recherchées pour la confection des bouquets secs."
                            },
                            {
                                "example_id": "da33da64-467c-4506-b605-98946c0b820e",
                                "sense_id": "7ca22ca8-8361-3b0f-acb0-20434f4d1b5a",
                                "text": "Son père, Jean-Gabriel, «important propriétaire terrien», est pharmacien, botaniste, chimiste - un savant enivré par l’idée de progrès et un «technicien agricole» inventif, qui brevette une charrue à voiles et met au point un procédé révolutionnaire de tannage des peaux avec diverses espèces de statices."
                            }
                        ]
                    }
