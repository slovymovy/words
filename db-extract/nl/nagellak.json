                        "entry_id": "e664a195-4cf0-3a23-af2a-787ca66038d6",
                        "glosses": [
                            "vernislak waarmee nagels met of zonder kleur gelakt kunnen worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ec880c0-08f6-40b8-bc93-fe031c1a0fc3",
                                "sense_id": "edb1dd8b-dbce-387b-92dc-6977ff9682c6",
                                "text": "Kijk je naar de ongeveer 500 patenten, dan zitten ze vooral in de zware chemie: moderne nagellak, haarverf en mascara zijn stuk voor stuk chemische hoogstandjes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8765cdf0-ab07-470b-97fd-da5ee5325029",
                        "source_entry_id": "e664a195-4cf0-3a23-af2a-787ca66038d6",
                        "source_sense_id": "edb1dd8b-dbce-387b-92dc-6977ff9682c6",
                        "source_sense_description": "schoonheidsmiddel",
                        "target_lang_word": "Nagellack",
