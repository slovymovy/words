                                            {
                                                "example_id": "001b3dba-01af-4878-8533-8b9f7e4a9f1d",
                                                "sense_id": "6cf6fa24-3b65-317f-9b15-62b74579c1cb",
                                                "text": "Auf die olivfarbene Grundierung des Panzers wird die etwas dunklere Tarnung gesetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bc06923-729e-4a9d-8c66-56dadecb0f89",
                        "source_entry_id": "20aa4d71-438d-334f-8db7-5e7665973fc9",
                        "source_sense_id": "29733fc1-4feb-385a-b993-9066204bdbe0",
                        "target_lang_word": "камуфляж",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "камуфляж",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7370ad6d-a9a6-33b4-9c9e-2791ba23fa19",
                                        "entry_id": "3de9a6c6-f833-3f98-8fb7-eeaea0124a55",
                                        "glosses": [
                                            "воен. распространённый вид маскировочной окраски предметов (одежды, вооружений, военной техники и т. п., реже сооружений), при котором используются пятна или полосы нескольких (обычно двух или трёх) цветов, искажающие внешний вид объектов вследствие слияния отдельных пятен (полос) с фоном, и таким образом затрудняющие обнаружение и опознавание маскируемых объектов визуально-оптическими и фотографическими средствами разведки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f10714d-31d5-4bce-9140-c9cf1217583a",
                                                "sense_id": "7370ad6d-a9a6-33b4-9c9e-2791ba23fa19",
                                                "text": "Пегие, в камуфляже, бока броневагонов были помяты в боях."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0daaeb25-58d1-3e43-90bd-442cea7c1694",
                                        "entry_id": "3de9a6c6-f833-3f98-8fb7-eeaea0124a55",
                                        "glosses": [
                                            "перен. действия, высказывания и т. п., служащие прикрытием истинного характера чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f461cbe7-df49-4f12-b8e9-c565ec0254cd",
                                                "sense_id": "0daaeb25-58d1-3e43-90bd-442cea7c1694",
                                                "text": "В этом свободном, очаровательном и маловразумительном потоке признаний Мятлев усмотрел некоторый камуфляж, которым владелец незабвенной Анеты пытался прикрыть расстройство чувств."
                                            },
                                            {
                                                "example_id": "a6a0bf7e-26fb-4b43-a0cb-92894d299a12",
                                                "sense_id": "0daaeb25-58d1-3e43-90bd-442cea7c1694",
                                                "text": "Ибо я на сто процентов убежден, что именно Орлов в 1937 году или около того в Мадриде велел ему сменить свою песню в «Тайме» с республиканской на франкистскую, для вящего камуфляжа."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db71e58f-aacf-3ae0-ab17-bfc1602616e2",
                                        "entry_id": "3de9a6c6-f833-3f98-8fb7-eeaea0124a55",
                                        "glosses": [
                                            "маскировочная форма одежды"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39dff87c-0f5b-4b45-8321-ad86400f6efb",
                                                "sense_id": "db71e58f-aacf-3ae0-ab17-bfc1602616e2",
                                                "text": "Дверь открылась сразу же. За ней стоял неизбежный амбал в камуфляже с черной резиновой палкой в руках"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "078ed5a2-0803-3f62-b762-22d51c754257",
                                        "entry_id": "3de9a6c6-f833-3f98-8fb7-eeaea0124a55",
                                        "glosses": [
                                            "биол. защитный окрас животных, появившийся в результате приспособления к окружающей среде"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fa0bdee-167c-408e-836d-d3204f483620",
                                                "sense_id": "078ed5a2-0803-3f62-b762-22d51c754257",
                                                "text": "Весь этот камуфляж нужен хамелеону, чтобы быть невидимым насекомым, за которыми он охотится, и врагам, от которых он прячется"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
