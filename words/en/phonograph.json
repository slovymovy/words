                    "frequency": "VeryLow",
                    "semantic_group_id": "symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student learned which <w>phonograph</w> stood for each distinct vowel sound in shorthand."
                        },
                        {
                            "text": "Each stroke in the system corresponds to a specific spoken <w>phonograph</w>."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Linguistics and shorthand writing terminology."
                        }
                    ]
                }
            ]
        },
