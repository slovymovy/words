                    }
                ],
                "senses": [
                    {
                        "sense_id": "767c0bbd-e7c3-3bef-9718-d30d68afaf0c",
                        "entry_id": "d2015be7-93ad-3ff5-af46-43e94273f8a6",
                        "glosses": [
                            "Recurrence of a woman's periods; menstruation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6f494976-ebf0-3d86-ac81-c032cad616f3",
                        "entry_id": "d2015be7-93ad-3ff5-af46-43e94273f8a6",
                        "glosses": [
                            "The quality of being periodic; tendency to recur at regular intervals."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d4ff2d13-2c3b-4da1-aa64-24e5e899553a",
                                "sense_id": "6f494976-ebf0-3d86-ac81-c032cad616f3",
                                "text": "The implications of this association of women and the moon would suggest that women were the first observers of the basic periodicity of nature, the periodicity upon which all later scientific observations were made."
                            },
                            {
                                "example_id": "c7f11cdc-7446-4288-8dd5-8982cfb10cd3",
                                "sense_id": "6f494976-ebf0-3d86-ac81-c032cad616f3",
                                "text": "A recent wavelet analysis of the turbidity data showed clear periodicities of turbidity in the three Pilbara datasets during both the baseline and dredge phases of the studies (Stark, unublished data) peaking semidiurnally associated with tides, diurnally associated with daily sea breezes and sometimes fortnightly associated with spring-neap cycles."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0737467-1327-3af3-bb80-9f1b418e2368",
                        "entry_id": "d2015be7-93ad-3ff5-af46-43e94273f8a6",
                        "glosses": [
                            "The quality of a function with a repeated set of values at regular intervals."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed459823-51e1-4427-8187-25647cef53e8",
                        "source_entry_id": "d2015be7-93ad-3ff5-af46-43e94273f8a6",
                        "source_sense_description": "property of being periodic",
                        "target_lang_word": "periodicita",
