                        "examples": [
                            {
                                "example_id": "3e783aad-93c9-4b74-b32e-845033603582",
                                "sense_id": "36ec96dd-b841-33cb-92d9-707515b9a080",
                                "text": "The Virgin strikes the globe, and from it issues infinite treasures. Mine delivers the key of human destinies and the sombre enigma of the Sphinx. All that in a few touches! A little colour,—and the mystery of the world is revealed! It is cyclopean,—it is genesiac. Human genius will never transcend it."
                            },
                            {
                                "example_id": "d09c8d45-9104-4575-8adb-a71f7259cd27",
                                "sense_id": "36ec96dd-b841-33cb-92d9-707515b9a080",
                                "text": "In Greece, the phallus was so pervasive as a genesiac symbol in every phase of daily life, that there were loaves baked in phallic form."
                            },
                            {
                                "example_id": "74c6030f-0d70-4bb4-a4ea-32f0f7e69c7d",
                                "sense_id": "36ec96dd-b841-33cb-92d9-707515b9a080",
                                "text": "The expansion of the universe is thought to have begun in a genesiac explosion (the “Big Bang”) about 20 billion years ago."
                            }
                        ]
                    }
