                                    {
                                        "sense_id": "4aa5601c-6868-3295-a9cb-e08f0be1be0f",
                                        "entry_id": "e47a4cb0-fb51-343a-85c1-47216a892c44",
                                        "glosses": [
                                            "Violent hatred leading to active opposition; active enmity; energetic dislike."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eeb79906-8d9b-402b-89d2-5b9912373791",
                                                "sense_id": "4aa5601c-6868-3295-a9cb-e08f0be1be0f",
                                                "text": "There was open animosity between the two rival teams."
                                            },
                                            {
                                                "example_id": "0db2148f-7c2b-4474-ba57-18c1ba35439c",
                                                "sense_id": "4aa5601c-6868-3295-a9cb-e08f0be1be0f",
                                                "text": "Despite years of conflict, she felt no animosity toward him."
                                            },
                                            {
                                                "example_id": "5c4a7c69-fd24-4ca7-a439-a97ceff0d877",
                                                "sense_id": "4aa5601c-6868-3295-a9cb-e08f0be1be0f",
                                                "text": "Political debates often stir up animosity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
