{
    "word_family": [
        "fuse",
        "fusion",
        "diffuse"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "575c0e31-c135-3456-a160-4b13aa4b71fe",
                    "sense_definition": "To make a situation less dangerous, tense, or hostile.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "calm_situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diplomat worked hard to <w>defuse</w> the growing tension between the two countries.",
                            "target_lang_translations": {
                                "ru": "Дипломат приложил много усилий, чтобы <w>разрядить</w> растущую напряженность между двумя странами."
                            }
                        },
                        {
                            "text": "He used humor to <w>defuse</w> the argument before it got out of control.",
                            "target_lang_translations": {
                                "ru": "Он использовал юмор, чтобы <w>разрядить</w> спор, пока тот не вышел из-под контроля."
                            }
                        }
                    ],
                    "synonyms": [
                        "de-escalate",
                        "calm",
                        "mitigate"
                    ],
                    "antonyms": [
                        "escalate",
                        "inflame"
                    ],
                    "common_phrases": [
                        "defuse a situation",
                        "defuse tension"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снизить напряженность, разрядить обстановку или предотвратить конфликт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрядить",
                                "target_lang_sense_clarification": "о ситуации, конфликте или напряженности"
                            },
                            {
                                "target_lang_word": "сгладить",
                                "target_lang_sense_clarification": "о противоречиях или конфликте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ac3169b-590e-39b4-8f01-3cdef9f55be2",
                    "sense_definition": "To remove the fuse from an explosive device to prevent it from detonating.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "calm_situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The expert was called in to <w>defuse</w> the bomb found in the city center.",
                            "target_lang_translations": {
                                "ru": "Специалиста вызвали, чтобы <w>разминировать</w> бомбу, найденную в центре города."
                            }
                        },
                        {
                            "text": "It takes nerves of steel to <w>defuse</w> a live explosive device.",
                            "target_lang_translations": {
                                "ru": "Нужны стальные нервы, чтобы <w>обезвредить</w> действующее взрывное устройство."
                            }
                        }
                    ],
                    "synonyms": [
                        "disarm"
                    ],
                    "common_phrases": [
                        "defuse a bomb"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обезвредить взрывное устройство, удалив из него взрыватель."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разминировать",
                                "target_lang_sense_clarification": "о бомбе или взрывном устройстве"
                            },
                            {
                                "target_lang_word": "обезвредить",
                                "target_lang_sense_clarification": "сделать устройство безопасным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cee7e2a7-8161-31bf-a3df-7dcfd111045c",
                    "sense_definition": "To make something shapeless or disordered.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strange mask served to <w>defuse</w> his features, making him unrecognizable.",
                            "target_lang_translations": {
                                "ru": "Странная маска <w>искажала</w> его черты лица, делая его неузнаваемым."
                            }
                        },
                        {
                            "text": "The chaotic design seemed to <w>defuse</w> the structure of the original sculpture.",
                            "target_lang_translations": {
                                "ru": "Хаотичный дизайн, казалось, <w>размывал</w> структуру оригинальной скульптуры."
                            }
                        }
                    ],
                    "synonyms": [
                        "disorder",
                        "deform"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо бесформенным, нарушать структуру или четкость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искажать",
                                "target_lang_sense_clarification": "о чертах лица или форме"
                            },
                            {
                                "target_lang_word": "размывать",
                                "target_lang_sense_clarification": "о структуре или очертаниях"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}