                                        "examples": [
                                            {
                                                "example_id": "d997bf6a-3ac7-430e-897b-bc30a19965f3",
                                                "sense_id": "59f00f11-a1f9-3393-9dde-eec09f7bee4e",
                                                "text": "La grande barre d’immeuble allongée au milieu d’un panorama de tours verticales, et recouverte d’un portrait géant du footballeur et enfant d’Aulnay-sous-Bois Moussa Sissoko, reste gravée dans les esprits des habitants."
                                            },
                                            {
                                                "example_id": "475be042-7bcf-4bbc-a88b-1909b593b917",
                                                "sense_id": "59f00f11-a1f9-3393-9dde-eec09f7bee4e",
                                                "text": "C’est un portrait fascinant que brosse Steve Achepio dans Le Marchand de sable, celui d’un homme (Moussa Mansaly) qui se laisse embrigader dans une organisation de marchands de sommeil, alors qu’il voulait aider des réfugiés."
                                            },
                                            {
                                                "example_id": "d1031876-35d9-49e8-af18-9ba5b246da81",
                                                "sense_id": "59f00f11-a1f9-3393-9dde-eec09f7bee4e",
                                                "text": "Enfin, en l’absence de Kingsley Coman blessé, c’est Moussa Diaby, plus habitué au groupe France qui a été appelée, au détriment notamment du jeune Bradley Barcola."
                                            }
                                        ]
                                    }
