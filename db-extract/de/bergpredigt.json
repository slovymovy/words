                        "form": "die Bergpredigt"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6215c60c-33c5-39bd-ac6e-9a831c7d189d",
                        "entry_id": "f35817e9-ef78-358e-b151-0c80504a0d45",
                        "glosses": [
                            "eine sehr bedeutende Rede Jesu Christi im Matthäusevangelium (Kapitel 5 bis 7)"
                        ],
                        "tags": [
                            "Bibel"
                        ],
                        "examples": [
                            {
                                "example_id": "5caab2a7-b9ea-43f6-a76e-f81eea933ac2",
                                "sense_id": "6215c60c-33c5-39bd-ac6e-9a831c7d189d",
                                "text": "Die Bergpredigt ist eine der bedeutsamsten Passagen des Neuen Testaments."
                            },
                            {
                                "example_id": "4e6a5145-24b6-403a-b716-b4d9d9c1a338",
                                "sense_id": "6215c60c-33c5-39bd-ac6e-9a831c7d189d",
                                "text": "„All diese Worte aus der Bergpredigt summieren sich zu der radikalsten sozialpolitischen Lehre, die jemals verkündet wurde.“"
                            },
                            {
                                "example_id": "75eb68ba-e689-459a-bbda-d60c18ad2b49",
                                "sense_id": "6215c60c-33c5-39bd-ac6e-9a831c7d189d",
                                "text": "„Ohne Zweifel stellt das, was er etwa in der Bergpredigt verkündet, den Menschen vor Herausforderungen – man denke nur an die Feindesliebe.“"
                            },
                            {
                                "example_id": "d292ce26-9642-4bd6-8eba-c5a92621cad4",
                                "sense_id": "6215c60c-33c5-39bd-ac6e-9a831c7d189d",
                                "text": "„In der Bergpredigt nimmt Jesus sich Zeitgenossen vor, die für ihre guten Taten belohnt werden wollen.“"
                            },
                            {
                                "example_id": "60d0e17a-756f-4519-aba3-e45117ca8414",
                                "sense_id": "6215c60c-33c5-39bd-ac6e-9a831c7d189d",
                                "text": "„In den sogenannten Seligpreisungen der Bergpredigt nennt Jesus die Armen, die Verfolgten, die Trauernden selig.“"
                            },
                            {
                                "example_id": "936e2646-4025-4366-b6a3-2bc7da729431",
                                "sense_id": "6215c60c-33c5-39bd-ac6e-9a831c7d189d",
                                "text": "„Jesus plädiert in der Bergpredigt (Mt 6,25-26) für eine Sorglosigkeit, die tief im Glauben begründet ist.“"
                            },
                            {
                                "example_id": "49b4b006-ffc4-477f-a082-e4294befd43e",
                                "sense_id": "6215c60c-33c5-39bd-ac6e-9a831c7d189d",
                                "text": "„Die Motivation für seinen Kampf gegen die Kriegswaffen-Industrie bezieht er aus seiner christlichen Erziehung: »Für mich ist die Bergpredigt bis heute sicherlich der prägende Text meines Lebens, der mich dazu geführt hat, Pazifist zu werden, diesen Weg konsequent zu beschreiten.«“"
                            },
                            {
                                "example_id": "a2ac55e4-0405-42be-b2a0-f7294f9c8976",
                                "sense_id": "6215c60c-33c5-39bd-ac6e-9a831c7d189d",
                                "text": "„Er setzte sich intensiv mit der Bergpredigt auseinander, nicht ohne Folgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
