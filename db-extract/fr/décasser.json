                "senses": [
                    {
                        "sense_id": "44c0e7af-d27f-3023-a866-7a69b7478b37",
                        "entry_id": "ed958658-c08f-3903-864e-47c4a7d8ec50",
                        "glosses": [
                            "Faire perdre son caractère cassé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c98fcf45-f06f-45c8-aace-57c8bdc50ba7",
                                "sense_id": "44c0e7af-d27f-3023-a866-7a69b7478b37",
                                "text": "Mes parents ne possédaient que quinze hectares mais, accroupis ou à genoux, en se relevant tout doucement à intervalles réguliers pour se décasser les reins et les genoux, sous une journée de juillet, quinze hectares, c’est long comme le Groenland, de bas en haut, de long en large ; ça n’en finit pas d’être long."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4629bcb-cd16-3a30-8b31-9f1882fbfa39",
                        "entry_id": "ed958658-c08f-3903-864e-47c4a7d8ec50",
                        "glosses": [
                            "Faire gagner de l’argent."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "c713d962-5870-4e2e-ae0a-345b2bfde4b2",
                                "sense_id": "d4629bcb-cd16-3a30-8b31-9f1882fbfa39",
                                "text": "La machine à quoi? — La Machine à orgueil. Le High Striker, si tu veux… Dans ton cas, ça peut aussi s’appeler une machine à décasser…"
                            }
                        ]
                    }
