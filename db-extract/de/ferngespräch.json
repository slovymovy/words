                ],
                "senses": [
                    {
                        "sense_id": "96d275c6-40e8-35df-96b5-69f74f26e20b",
                        "entry_id": "c1d975d3-23a2-301f-89dc-fe716fc34f20",
                        "glosses": [
                            "Telefonat zwischen zwei verschiedenen Ortsnetzen"
                        ],
                        "tags": [
                            "Telekommunikation",
                            "Telefonie"
                        ],
                        "examples": [
                            {
                                "example_id": "37000307-9dd3-4183-b55a-52493b210ccc",
                                "sense_id": "96d275c6-40e8-35df-96b5-69f74f26e20b",
                                "text": "Wenn es kein Ferngespräch ist, dürfen Sie mein Telefon benutzen."
                            },
                            {
                                "example_id": "96331851-933c-4cef-84b7-7adeaa827c84",
                                "sense_id": "96d275c6-40e8-35df-96b5-69f74f26e20b",
                                "text": "„Die Ferngespräche, die anfänglich erlaubt waren, hatten eine solche Überlastung der Leitungen und der öffentlichen Sprechstellen zur Folge, daß sie nach einigen Tagen gänzlich verboten und nachher streng auf die sogenannten dringlichen Fälle, wie Tod, Geburt und Hochzeit, beschränkt wurden.“"
                            },
                            {
                                "example_id": "0c642176-622a-45be-937c-8a00d687a432",
                                "sense_id": "96d275c6-40e8-35df-96b5-69f74f26e20b",
                                "text": "„Ich schrieb lange, hatte zuvor ein Ferngespräch mit M. angemeldet.“"
                            },
                            {
                                "example_id": "5ba5385d-0cc0-496a-beab-02d6eccbbf63",
                                "sense_id": "96d275c6-40e8-35df-96b5-69f74f26e20b",
                                "text": "„Fysst war dort aufgrund eines Ferngesprächs aus London, das jener am Morgen zuvor mit ihm geführt hatte.“"
                            },
                            {
                                "example_id": "f6219cd4-9936-43e6-a6be-8326e6478012",
                                "sense_id": "96d275c6-40e8-35df-96b5-69f74f26e20b",
                                "text": "„Ein intimer Ehezwist vor den Augen von zehn Millionen Fernsehfreunden wird durch ebenso viele Ferngespräche schon kurz nach der Sendung geschlichtet, eine fristlose Entlassung auf dem gleichen Wege rückgängig gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
