                                        "entry_id": "5e639d0e-2126-3145-85ce-232518756f90",
                                        "glosses": [
                                            "kleines Essgeschirr, in dem gekochte Eier serviert werden"
                                        ],
                                        "tags": [
                                            "Küche",
                                            "Haushalt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6611b5d9-df40-4cb2-ada3-69421d6f83c9",
                                                "sense_id": "b38b9eed-e3e7-3093-8c9b-975c8238471a",
                                                "text": "Das Ei wird mit dem runden oder spitzen Ende nach oben in den Eierbecher gestellt."
                                            },
                                            {
                                                "example_id": "fb3e6c1e-19bd-4035-9f13-ade50cf7f4fc",
                                                "sense_id": "b38b9eed-e3e7-3093-8c9b-975c8238471a",
                                                "text": "„Es war mal ein Eierbecher,",
                                                "translation": "anders als die Andern halt“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
