                        "glosses": [
                            "Gelée nouvelle qui survient après un dégel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be0eda28-df0a-42b9-bcf0-fb17cc9fcb17",
                                "sense_id": "0d64ae90-de0e-368e-86ba-25e7b3bc33d4",
                                "text": "Le regel fit beaucoup de mal au blé naissant."
                            },
                            {
                                "example_id": "ff3ce720-e64c-4362-b86e-82787bf6669c",
                                "sense_id": "0d64ae90-de0e-368e-86ba-25e7b3bc33d4",
                                "text": "J’en ai assez pris de l’hiver et de la solitude, et de la neige et des aurores boréales, et des soleils multipliés par cinq et dressés en croix sur l’auréole de leurs cercles parhéliques, et du feu d’artifice de la glace contractée et qui détonne sous le regel,"
                            }
                        ]
                    },
                    {
                        "sense_id": "26dcea5a-51a7-3f0f-8656-45d238a77d2a",
                        "entry_id": "d48ae129-b3a4-3298-bf2c-b8171ab0d092",
                        "glosses": [
                            "Congélation nouvelle, dans les glaciers, produite après une fusion temporaire, par suite de la modification des pressions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24f1cf4c-4a73-44b9-8f7e-b7b78ddff8f5",
                                "sense_id": "26dcea5a-51a7-3f0f-8656-45d238a77d2a",
                                "text": "Le regel produit l’avancement des glaciers."
                            }
                        ]
                    }
