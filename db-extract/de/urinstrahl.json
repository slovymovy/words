                ],
                "senses": [
                    {
                        "sense_id": "fab6a83b-a625-34f4-87f8-de170c30b34f",
                        "entry_id": "1243fd45-204f-386d-b2bb-914cc0ea3b12",
                        "glosses": [
                            "gebündelt austretender Urin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4ba27be-8111-40fa-8f79-eb7063ce3524",
                                "sense_id": "fab6a83b-a625-34f4-87f8-de170c30b34f",
                                "text": "„Sie hörte nicht auf. Stattdessen nahm die Kraft des Urinstrahls noch zu.“"
                            },
                            {
                                "example_id": "d221417b-c685-4304-b1e7-c0ec6388a91a",
                                "sense_id": "fab6a83b-a625-34f4-87f8-de170c30b34f",
                                "text": "„Plötzlich bemerkte sie, wie laut ihr Urinstrahl in der Stille des Hauses plätscherte.“"
                            },
                            {
                                "example_id": "f7145436-39d4-4a46-9ea5-c775a5b09aa5",
                                "sense_id": "fab6a83b-a625-34f4-87f8-de170c30b34f",
                                "text": "„Beide Männer hielten ihre Urinstrahlen für nicht weniger als eine Minute aufrecht, ohne dass diese abebbten.“"
                            },
                            {
                                "example_id": "665a60fe-df87-436c-8c85-f2820a1ccc3f",
                                "sense_id": "fab6a83b-a625-34f4-87f8-de170c30b34f",
                                "text": "„Dann schoss er zurück. Mit einem Urinstrahl.“"
                            },
                            {
                                "example_id": "9fc2d831-57df-4cd7-9b50-a81f2ba9bd71",
                                "sense_id": "fab6a83b-a625-34f4-87f8-de170c30b34f",
                                "text": "„Vor Entsetzen reißt dein Urinstrahl ab.“"
                            },
                            {
                                "example_id": "fccd56cc-0d9a-427b-b10f-74431f44b272",
                                "sense_id": "fab6a83b-a625-34f4-87f8-de170c30b34f",
                                "text": "„Aber in einem Anfall von Güte hatte sich offensichtlich doch jemand erbarmt, den Strom freizuschalten. Er floss durch meinen Urinstrahl und mein Blut direkt in mein Gehirn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
