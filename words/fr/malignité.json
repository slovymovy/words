                        "agir avec malignité"
                    ]
                },
                {
                    "sense_id": "bf86f163-35ad-3bfd-a5c0-a6e87460f0e8",
                    "sense_definition": "Caractère dangereux, nocif ou pernicieux d'une chose, particulièrement d'une affection médicale ou d'une tumeur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dangerosite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les médecins effectuent des analyses complémentaires pour évaluer le degré de <w>malignité</w> de la lésion."
                        },
                        {
                            "text": "La biopsie a finalement confirmé la <w>malignité</w> de la tumeur découverte lors de l'examen."
                        }
                    ],
                    "synonyms": [
                        "gravité",
                        "nocivité",
                        "dangerosité"
                    ],
                    "antonyms": [
                        "bénignité",
                        "innocuité"
                    ],
                    "common_phrases": [
                        "degré de malignité",
                        "malignité d'une tumeur"
                    ]
                },
                {
                    "sense_id": "4713735c-d97c-3585-9532-ae4116b4caca",
                    "sense_definition": "Tendance à plaisanter ou à railler gentiment aux dépens d'autrui, avec une pointe de malice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "malice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'écrivain croquait ses contemporains avec une subtile <w>malignité</w> dans chacune de ses chroniques."
