                                        "sense_id": "eb723562-1bcd-3f03-b0d1-8bf5075fe1a0",
                                        "entry_id": "1ac2893e-8bf7-345b-bc46-34bf88d29a0d",
                                        "glosses": [
                                            "iemand die een toneelstukken schrijft"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cefffb68-dcc8-4a85-9732-2a129d9300a3",
                                                "sense_id": "eb723562-1bcd-3f03-b0d1-8bf5075fe1a0",
                                                "text": "Hetzelfde gold voor de Scandinavische toneelschrijvers: Ibsen, Strindberg."
                                            },
                                            {
                                                "example_id": "2cd5e7da-5f6e-45b5-becd-c17926e71b38",
                                                "sense_id": "eb723562-1bcd-3f03-b0d1-8bf5075fe1a0",
                                                "text": "Zowel de Cubaanse als Spaanse autoriteiten lijken op de achtergrond stilzwijgend te hebben ingestemd met het vertrek van de oppositieleider naar Madrid. García, die toneelschrijver is, beschrijft de reis die hij en zijn vrouw naar Spanje maakten als een film. \"Waarover ik later nog eens zal vertellen. De Cubaanse politie is ook op het vliegveld nooit verschenen.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "068afcef-36de-465c-b8b6-c58805b5635c",
                        "source_entry_id": "74f8ebca-7b46-3080-8919-f43fb9f23451",
                        "source_sense_id": "bf77e20f-55df-3e1d-9669-01a4cd6351c6",
