    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3adfad1d-8918-3e7b-87ef-ebfec8cc9cd0",
                "word": "corporeality",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d672a823-791b-491e-a2ac-750fafaf7d06",
                        "entry_id": "3adfad1d-8918-3e7b-87ef-ebfec8cc9cd0",
                        "tags": [
                            "plural"
                        ],
                        "form": "corporealities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad1e773f-5b68-34ab-8cd5-97a506a1cfe2",
                        "entry_id": "3adfad1d-8918-3e7b-87ef-ebfec8cc9cd0",
                        "glosses": [
                            "The state of being or having a body (being corporal/corporeal); bodily existence."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2081e13e-24d5-4464-a2d0-dece6242c47e",
                                "sense_id": "ad1e773f-5b68-34ab-8cd5-97a506a1cfe2",
                                "text": "And so these spirits are in constant search for vessels to occupy, and insatiable in their pursuit of corporeality."
                            },
                            {
                                "example_id": "dbfc2068-c143-4ae3-a58c-8717ac3a0e0b",
                                "sense_id": "ad1e773f-5b68-34ab-8cd5-97a506a1cfe2",
                                "text": "See also: uncorporeal, spiritual, mystical, transcendence"
                            }
                        ]
                    },
                    {
                        "sense_id": "a741fd80-27c6-3313-8155-73127f7cd58c",
                        "entry_id": "3adfad1d-8918-3e7b-87ef-ebfec8cc9cd0",
                        "glosses": [
                            "Something having a corporeal existence."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfdd6ab4-3e36-4ff8-bcc6-9292b8808f10",
                        "source_entry_id": "3adfad1d-8918-3e7b-87ef-ebfec8cc9cd0",
                        "source_sense_description": "The state of being corporeal",
                        "target_lang_word": "corporéité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corporéité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8461861e-d5c4-3648-94ea-8c7dddcd06fa",
                                        "entry_id": "829e2bd5-3d0f-3273-a352-6f7245c46225",
                                        "glosses": [
                                            "Pour un humain, fait d'avoir un corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f17c2010-eb1d-42d0-b934-7ae00371cf7e",
                                                "sense_id": "8461861e-d5c4-3648-94ea-8c7dddcd06fa",
                                                "text": "L’homme est un être corporel; la corporéité n’est pas une partie de lui mais une dimension constitutive de son essence créée."
                                            },
                                            {
                                                "example_id": "5a6a39d5-d49b-4d7f-9888-8334a8f8acac",
                                                "sense_id": "8461861e-d5c4-3648-94ea-8c7dddcd06fa",
                                                "text": "L'importance de la doctrine monastique ne saurait être sous-estimée, puisqu'elle a transmis au monde chrétien – et, par l'entremise de celui-ci, à la modernité occidentale – les bases, parfois inconscientes et donc méconnues, de notre conception de la corporéité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6146e55c-0ed3-3ce5-9645-da4d3fc50c7f",
                                        "entry_id": "829e2bd5-3d0f-3273-a352-6f7245c46225",
                                        "glosses": [
                                            "Idée et perception de son propre corps."
                                        ],
                                        "tags": [
                                            "information à préciser ou à vérifier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed45877c-253c-4b7b-a01f-08a980f3275f",
                                                "sense_id": "6146e55c-0ed3-3ce5-9645-da4d3fc50c7f",
                                                "text": "On peut donc dissocier conceptuellement actes du corps, corporalité, et actes de l’esprit, corporéité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31ca7d1c-0222-3cb2-96a2-e022ad254c54",
                                        "entry_id": "829e2bd5-3d0f-3273-a352-6f7245c46225",
                                        "glosses": [
                                            "Dimension purement matérielle d'un objet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c960b36f-d0bc-4e35-b758-eae07d3750cb",
                                                "sense_id": "31ca7d1c-0222-3cb2-96a2-e022ad254c54",
                                                "text": "À titre de mesure de valeur, l’or n’est que de la monnaie idéale et de l’or idéal ; à titre de simple moyen de circulation il est de la monnaie symbolique et de l’or symbolique ; dans sa simple corporéité métallique l’or est de la monnaie ou la monnaie est de l’or réel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3cf8202-7143-4a8d-9483-35235316a3db",
                        "source_entry_id": "3adfad1d-8918-3e7b-87ef-ebfec8cc9cd0",
                        "source_sense_description": "The state of being corporeal",
                        "target_lang_word": "corporalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corporalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de0287ef-5f78-350c-bff3-31c5ecb765cd",
                                        "entry_id": "b71e570e-13d2-353d-a9f0-483872a7d999",
                                        "glosses": [
                                            "État corporel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b75f2cd-e6ba-47ee-9a7b-3594b0ed6a58",
                                                "sense_id": "de0287ef-5f78-350c-bff3-31c5ecb765cd",
                                                "text": "Déjà dans ses premiers écrits, Thomas nous dit que la notion de corporalité est susceptible d’une double considération."
                                            },
                                            {
                                                "example_id": "4bd80c2d-e956-4060-8914-52f4ec53b13d",
                                                "sense_id": "de0287ef-5f78-350c-bff3-31c5ecb765cd",
                                                "text": "À un moment donné, il fit valoir que certaines de ses hypothèses rappelaient en somme la théorie hylémorphique de saint Bonaventure, qui implique une certaine corporalité des âmes."
                                            },
                                            {
                                                "example_id": "a4c793ae-02ab-420f-8991-330ebbd95466",
                                                "sense_id": "de0287ef-5f78-350c-bff3-31c5ecb765cd",
                                                "text": "Les exercices psychocorporels ont pour but de vous faire vivre votre corporalité, d’élargir votre champ de conscience pour entrer dans une perception de plus en plus fine du corps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
