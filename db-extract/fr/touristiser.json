                "senses": [
                    {
                        "sense_id": "74b656d6-1269-3630-ac2b-2b907674ce93",
                        "entry_id": "543379d1-5782-3858-a79e-15fa2464125b",
                        "glosses": [
                            "Donner un caractère touristique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ca62401-8369-4e91-ac8c-e2c3e0d828ec",
                                "sense_id": "74b656d6-1269-3630-ac2b-2b907674ce93",
                                "text": "Au service du pseudo-contact sensible, quelqu'un vient même d’inventer le « vélo-d'eau » pour touristiser le marais poitevin."
                            },
                            {
                                "example_id": "8ecc97e7-4585-45ea-b683-00b8e3e7f3fb",
                                "sense_id": "74b656d6-1269-3630-ac2b-2b907674ce93",
                                "text": "un complexe hôtelier est en cours de construction rive gauche, ça risque malheureusement de 'touristiser' le site qui ne l'est pas encore trop pour l'instant."
                            },
                            {
                                "example_id": "bb6d2cbf-ea69-4f72-b5bb-0116b2fb581a",
                                "sense_id": "74b656d6-1269-3630-ac2b-2b907674ce93",
                                "text": "En fait, vous trouverez bien une ou deux cases à impluvium à \" touristiser \"."
                            },
                            {
                                "example_id": "91d8277b-def7-4755-92b6-a03a4eb8d32f",
                                "sense_id": "74b656d6-1269-3630-ac2b-2b907674ce93",
                                "text": "Koutouloufari est vraiment un joli village, mais ayant tendance à se \"touristiser\" un peu quand même ces derniers temps."
                            }
                        ]
                    },
                    {
                        "sense_id": "85926fc0-8d3b-3517-94b3-a98794362af5",
                        "entry_id": "543379d1-5782-3858-a79e-15fa2464125b",
                        "glosses": [
                            "Pratiquer le tourisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c5f1423-5fce-4b17-b5e1-7d70b55cd612",
                                "sense_id": "85926fc0-8d3b-3517-94b3-a98794362af5",
                                "text": "Arrivé au restaurant à l'état de glaçon ambulant il préféra, avec juste raison, « touristiser » l'après midi et rentrer en voiture."
                            }
                        ]
                    }
