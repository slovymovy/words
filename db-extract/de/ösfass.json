                                    {
                                        "sense_id": "8bf5d98d-088a-35b7-b28c-1632540dfbda",
                                        "entry_id": "1d0e4f1f-8814-3b5f-8cf9-566eef2c308f",
                                        "glosses": [
                                            "Pelle de bois creuse qui sert à vider l’eau qui entre dans un bateau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "856ccbbd-f654-4504-8131-3fe457b0b972",
                                                "sense_id": "8bf5d98d-088a-35b7-b28c-1632540dfbda",
                                                "text": "Empoignez-moi les écopes et videz-moi l’eau de la barque."
                                            },
                                            {
                                                "example_id": "a7405b6a-67b1-4a3b-af44-9252af710f6e",
                                                "sense_id": "8bf5d98d-088a-35b7-b28c-1632540dfbda",
                                                "text": "Fred a sauté ; il a, sous le banc où s’allongent les gaffes, saisi l’écope et pesant sur un bord, retrouvant le tour de bras, la cadence, il expédie de longues giclées sales."
                                            },
                                            {
                                                "example_id": "2252bef1-14bb-40db-9a5d-17a06fa8882a",
                                                "sense_id": "8bf5d98d-088a-35b7-b28c-1632540dfbda",
                                                "text": "Ce mémorable examen se déroulant en début de saison, les premières recettes tant attendues pour étancher une trésorerie fuyarde de fin d’hiver allaient me manquer comme manque l’étoupe et l’écope à un pitalugue hors d’usage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9287a717-caa7-3d4f-92fa-ad0e6e3f6d5d",
                                        "entry_id": "1d0e4f1f-8814-3b5f-8cf9-566eef2c308f",
                                        "glosses": [
                                            "Pelle creuse pour vidanger."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35e96a9a-727f-42bd-9348-74f1b446d12d",
                                                "sense_id": "9287a717-caa7-3d4f-92fa-ad0e6e3f6d5d",
                                                "text": "On les emploie […], après les avoir additionnées de deux à trois fois leur volume d’eau, ce qui en rend plus facile l’épandage à l’écope ou au tonneau."
                                            }
                                        ]
                                    }
                                ]
                            },
