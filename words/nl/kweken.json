                                "target_lang_sense_clarification": "о привычках или терпении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "048ed073-a4df-3c79-abcb-4e7ba2d04390",
                    "sense_definition": "het maken van een specifiek geluid door een vogel, zoals een eend",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De eenden in de vijver <w>kweken</w> luidruchtig als er iemand met brood aankomt.",
                            "target_lang_translations": {
                                "en": "The ducks in the pond <w>quack</w> loudly when someone approaches with bread.",
                                "ru": "Утки в пруду шумно <w>крякают</w>, когда кто-то подходит с хлебом."
                            }
                        },
                        {
                            "text": "In de verte hoorden we een vogel zachtjes <w>kweken</w> in het riet.",
                            "target_lang_translations": {
                                "en": "In the distance, we heard a bird <w>chirping</w> softly in the reeds.",
                                "ru": "Вдалеке мы слышали, как в камышах тихо <w>чирикает</w> птица."
                            }
                        }
