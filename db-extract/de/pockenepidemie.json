                "senses": [
                    {
                        "sense_id": "371f0b4b-d3b1-3941-ae9b-aeef4938c154",
                        "entry_id": "181b97fc-f08b-3df1-aa94-12a6ae3cf5b1",
                        "glosses": [
                            "lokal und zeitlich gehäuftes Auftreten von Pocken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc073db5-d120-4337-8e29-b754e41cee28",
                                "sense_id": "371f0b4b-d3b1-3941-ae9b-aeef4938c154",
                                "text": "„Schon seit den 1970er Jahren ist nämlich bekannt, dass - ähnlich wie im Falle von Moctezumas Nachfolger Cuitlahuac in Tenochtitlan - eine Pockenepidemie die Inkabevölkerung samt ihrem Herrscher Huayna Cápac (1493-1525) noch vor Ankunft der Spanier dezimiert hatte.“"
                            },
                            {
                                "example_id": "5235b53d-69c0-4ced-8ab3-b94a3fa47688",
                                "sense_id": "371f0b4b-d3b1-3941-ae9b-aeef4938c154",
                                "text": "„Hinzu kommt ein Element, das die jüngere Forschung betont hat: die Auswirkungen der von den Spaniern eingeschleppten epidemischen Krankheiten, vor allem der Pockenepidemien, auf die Indigenen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
