                "senses": [
                    {
                        "sense_id": "bb616cfa-0106-36db-a2d4-a2a8ffa1d876",
                        "entry_id": "a2f00f1a-72d8-372d-a0e1-2762f5014b8c",
                        "glosses": [
                            "Pfeife, mit der Opium geraucht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e643ddf-39a2-4d9d-9523-a30b14a712fc",
                                "sense_id": "bb616cfa-0106-36db-a2d4-a2a8ffa1d876",
                                "text": "„Das vietnamesische Mädchen macht die ganze Zeit nichts anderes, als die Opiumpfeife stopfen, sich Bilderbücher anschauen und zwitschern wie ein Vogel.“"
                            },
                            {
                                "example_id": "24b5fee2-000f-4399-ad44-a7adaa2fd6b8",
                                "sense_id": "bb616cfa-0106-36db-a2d4-a2a8ffa1d876",
                                "text": "„Der kweilo schob die Reisschale von sich weg und zeigte auf die Opiumpfeife.“"
                            },
                            {
                                "example_id": "2f169627-8e1c-4e19-84e6-9c943bb9fb49",
                                "sense_id": "bb616cfa-0106-36db-a2d4-a2a8ffa1d876",
                                "text": "„Er klang abwesend. Wahrscheinlich hatte er bereits die erste Opiumpfeife geraucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
