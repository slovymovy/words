                ],
                "senses": [
                    {
                        "sense_id": "c13ac9ed-4a14-30fe-b98c-ca289c332c03",
                        "entry_id": "dcc118be-d345-399c-81f6-fb1ec024123d",
                        "glosses": [
                            "Qui considère la vie comme étant au centre de toute chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "631d2cff-32b3-4fc3-a5b9-2e101cbf77cb",
                                "sense_id": "c13ac9ed-4a14-30fe-b98c-ca289c332c03",
                                "text": "Univers biocentrique, celui où la biologie est perçue comme la science centrale."
                            },
                            {
                                "example_id": "9864d259-1c8a-40a1-8f87-d04f95a09b55",
                                "sense_id": "c13ac9ed-4a14-30fe-b98c-ca289c332c03",
                                "text": "Le principe biocentrique provient d’une intuition que l’univers est organisé en fonction de la vie et propose une reformulation de nos valeurs culturelles qui a comme référence le respect pour la vie."
                            },
                            {
                                "example_id": "a0a5a8ba-065e-40b2-b995-ca7b9694d589",
                                "sense_id": "c13ac9ed-4a14-30fe-b98c-ca289c332c03",
                                "text": "« Si vous donnez la personnalité juridique à une personnalité non-humaine, c’est une petite révolution en soi qui signifie un certain changement dans l’aspect anthropocentrique ou biocentrique de la perception qu’on a du monde, de l'homme et de son environnement », raconte à ce sujet Marie-Angèle Hermitte, ancienne directrice de recherche au CNRS et pionnière du droit du vivant et du droit de l'environnement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
