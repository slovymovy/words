                                "example_id": "caa8255a-bfe1-40ae-81c5-f15076030c5d",
                                "sense_id": "fba0e1c7-b4b1-3489-84cc-ac4a3a89afb0",
                                "text": "„Es dauerte, bis er den Nachrichtenkanal gefunden hatte.“"
