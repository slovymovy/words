                ],
                "senses": [
                    {
                        "sense_id": "e1557e62-d720-33d9-8f97-7af870dd9a3f",
                        "entry_id": "528ba296-e33f-35f5-a623-385ce070af2a",
                        "glosses": [
                            "With aggression; savagely."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a0f076c-edba-4273-b4c3-318e14184759",
                                "sense_id": "e1557e62-d720-33d9-8f97-7af870dd9a3f",
                                "text": "After working hard for a couple of weeks he suddenly downed tools and truculently demanded thirty shillings."
                            },
                            {
                                "example_id": "14bb1067-9657-494a-b7d9-427410fd022d",
                                "sense_id": "e1557e62-d720-33d9-8f97-7af870dd9a3f",
                                "text": "Truculently they squared up to each other but kept just out of fighting distance?"
                            },
                            {
                                "example_id": "7ac59299-5360-4d6a-bc79-af7a3bd0a991",
                                "sense_id": "e1557e62-d720-33d9-8f97-7af870dd9a3f",
                                "text": "It was a casual sneer, obviously one of a long line. There was hatred behind it, but of a quiet, chronic type, nothing new or unduly virulent, and he was taken aback by the flicker of amazed incredulity that passed over the younger man's ravaged face. Toberman was disconcerted. ‘What's the matter?’ he demanded truculently."
                            },
                            {
                                "example_id": "97a414ce-d176-45a8-a972-e6cf501c7c18",
                                "sense_id": "e1557e62-d720-33d9-8f97-7af870dd9a3f",
                                "text": "`What's wrong with that?' he demanded truculently."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c7adacf-37c8-49b0-a6f3-2070af5598d9",
                        "source_entry_id": "528ba296-e33f-35f5-a623-385ce070af2a",
                        "source_sense_id": "e1557e62-d720-33d9-8f97-7af870dd9a3f",
                        "source_sense_description": "with aggression",
                        "target_lang_word": "woest",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "woest",
