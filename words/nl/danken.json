            "senses": [
                {
                    "sense_id": "bb94e3a2-87b7-397e-9e67-3c51a19df4eb",
                    "sense_definition": "erkentelijkheid aan iemand betonen of laten merken dat je blij bent met iets",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "erkentelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij <w>danken</w> u hartelijk voor uw aandacht tijdens deze presentatie.",
                            "target_lang_translations": {
                                "en": "We <w>thank</w> you sincerely for your attention during this presentation.",
                                "ru": "Мы искренне <w>благодарим</w> вас за внимание во время этой презентации."
                            }
                        },
                        {
                            "text": "Ze <w>danken</w> God in stilte voor het simpele gegeven dat hun kinderen leven.",
                            "target_lang_translations": {
                                "en": "They <w>thank</w> God in silence for the simple fact that their children are alive.",
                                "ru": "Они в тишине <w>благодарят</w> Бога за тот простой факт, что их дети живы."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedanken"
                    ],
                    "common_phrases": [
                        "iemand hartelijk danken",
                        "God danken",
                        "voor de moeite danken"
                    ],
                    "target_lang_definitions": {
                        "en": "to express gratitude to someone or show that you are pleased with something",
                        "ru": "выражать признательность кому-либо или показывать, что вы рады чему-либо"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thank",
                                "target_lang_sense_clarification": "to express gratitude"
                            },
                            {
                                "target_lang_word": "give thanks",
                                "target_lang_sense_clarification": "often in a religious or formal context"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "благодарить",
                                "target_lang_sense_clarification": "выражать благодарность"
                            },
                            {
                                "target_lang_word": "возносить благодарность",
                                "target_lang_sense_clarification": "часто в религиозном или торжественном контексте"
                            },
                            {
                                "target_lang_word": "говорить спасибо",
                                "target_lang_sense_clarification": "в разговорной речи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6f1a58c-71d1-33a7-8ab2-3c66944c8919",
                    "sense_definition": "iets aan een bepaalde oorzaak verschuldigd zijn",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oorzaak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft zijn succes vooral te <w>danken</w> aan zijn enorme doorzettingsvermogen.",
                            "target_lang_translations": {
                                "en": "He <w>owes</w> his success primarily to his enormous perseverance.",
                                "ru": "Своим успехом он прежде всего <w>обязан</w> своему огромному упорству."
                            }
                        },
                        {
                            "text": "Dat we nu nog op tijd zijn, hebben we aan jou te <w>danken</w>.",
                            "target_lang_translations": {
                                "en": "The fact that we are still on time is something we <w>have to thank</w> you for.",
                                "ru": "Тем, что мы еще успеваем вовремя, мы <w>обязаны</w> тебе."
                            }
                        }
                    ],
                    "synonyms": [
                        "toeschrijven"
                    ],
                    "common_phrases": [
                        "te danken aan"
                    ],
                    "target_lang_definitions": {
                        "en": "to owe something to a specific cause or person",
                        "ru": "быть обязанным чему-либо или кому-либо определенной причиной или результатом"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "owe to",
                                "target_lang_sense_clarification": "to be indebted to a cause"
                            },
                            {
                                "target_lang_word": "have to thank for",
                                "target_lang_sense_clarification": "to attribute a result to someone or something"
                            },
                            {
                                "target_lang_word": "attribute to",
                                "target_lang_sense_clarification": "to credit a cause"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "быть обязанным",
                                "target_lang_sense_clarification": "приписывать успех или результат причине"
                            },
                            {
                                "target_lang_word": "благодаря",
