        "fr-extract.jsonl": [
            {
                "entry_id": "da27f148-3df9-39dd-aef2-bfa34398c6b0",
                "word": "socialité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b5b51a22-dd70-4848-a70a-86ecd3127155",
                        "entry_id": "da27f148-3df9-39dd-aef2-bfa34398c6b0",
                        "tags": [
                            "plural"
                        ],
                        "form": "socialités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d1006318-3046-355e-b020-78794f3aa9b9",
                        "entry_id": "da27f148-3df9-39dd-aef2-bfa34398c6b0",
                        "glosses": [
                            "Nature sociale : fait de vivre dans des relations, en groupe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ea82f48-c999-48ee-9b6a-41c766be74a9",
                                "sense_id": "d1006318-3046-355e-b020-78794f3aa9b9",
                                "text": "Toutefois, ce serait injuste et aussi frivole que ces écrivains, (...) de ne pas remarquer qu’elles eurent leur côté estimable, et ne servirent pas médiocrement au progrès de la socialité."
                            },
                            {
                                "example_id": "d8fa364f-4dd2-4381-9167-7463b9c1b144",
                                "sense_id": "d1006318-3046-355e-b020-78794f3aa9b9",
                                "text": "Je mentionnerai enfin une étude à laquelle j’ai participé, qui a mis en évidence le coût de la socialité dans la population que nous suivons."
                            },
                            {
                                "example_id": "eba4cb25-c5aa-407d-be86-4415cb8686d3",
                                "sense_id": "d1006318-3046-355e-b020-78794f3aa9b9",
                                "text": "Les forêts de matsutakes résultent de réunions qui construisent et transforment les paysages. Cette partie du livre s’ouvre sur le phénomène des perturbations et, en tant que telles, elles marquent un début comme quand un acte s’ouvre sur une scène : les perturbations réalignent des possibilités de rencontres transformatrices. Des patchs de paysage émergent de ces perturbations. Ce qui revient à dire que la précarité se déroule dans une socialité plus qu’humaine."
                            },
                            {
                                "example_id": "92f69333-2e8d-41ce-8c73-356827f46c99",
                                "sense_id": "d1006318-3046-355e-b020-78794f3aa9b9",
                                "text": "L’individu, cependant, n’est pas né membre d’une société. Il est né avec certaines prédispositions à l’égard de la socialité, et il devient un membre de la société."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f3e67dc-5455-4c49-83e1-85790614cb47",
                        "source_entry_id": "da27f148-3df9-39dd-aef2-bfa34398c6b0",
                        "source_sense_id": "d1006318-3046-355e-b020-78794f3aa9b9",
                        "target_lang_word": "sociality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sociality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fac41844-542f-3294-8dd9-3367b6c97ce8",
                                        "entry_id": "53d6e9f7-dcd1-362d-a232-1772b3e27993",
                                        "glosses": [
                                            "The character of being social; sociability"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c02a41c6-05c8-4165-a2f9-ef386d2c450c",
                                                "sense_id": "fac41844-542f-3294-8dd9-3367b6c97ce8",
                                                "text": "Unless opinions favorable to democracy and to aristocracy, to property and to equality, to co-operation and to competition, to luxury and to abstinence, to sociality and individuality, to liberty and discipline, and all the other standing antagonisms of practical life, are expressed with equal freedom, and enforced and defended with equal talent and energy, there is no chance of both elements obtaining their due; one scale is sure to go up, and the other down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27763403-473e-3063-84e8-a5e7e58dae5b",
                                        "entry_id": "53d6e9f7-dcd1-362d-a232-1772b3e27993",
                                        "glosses": [
                                            "The quality of an animal kind of being social."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98bca517-0fa6-4e04-87bb-b099bf44057c",
                                                "sense_id": "27763403-473e-3063-84e8-a5e7e58dae5b",
                                                "text": "That the divine will is expressed by it, Cumberland, “not being so fortunate as to possess innate ideas,” tries to prove by a long inductive examination of the evidences of man's essential sociality exhibited in his physical and mental constitution."
                                            },
                                            {
                                                "example_id": "052f0076-33bf-43da-ac44-4871bdb56d95",
                                                "sense_id": "27763403-473e-3063-84e8-a5e7e58dae5b",
                                                "text": "To develop, from a fleeting instant of physical lust, a lifelong community encompassing the whole of the conjoint lives--that has been and is one of the greatest triumphs of sociality in the struggle against the persistent animality of our species."
                                            },
                                            {
                                                "example_id": "48f11f01-29e9-4c3b-aeee-8735b315c71e",
                                                "sense_id": "27763403-473e-3063-84e8-a5e7e58dae5b",
                                                "text": "To understand how sociality is programmed—that is, how friendships are programmatically organized and shaped, let us consider the ways in which the platform simulates existing notions of friendship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ad7f01d-3f25-389f-8e11-2cc12f8fcd7a",
                                        "entry_id": "53d6e9f7-dcd1-362d-a232-1772b3e27993",
                                        "glosses": [
                                            "Social events or entertainments; pleasantries."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "543933e6-fba7-45e5-a022-b2f6c819c1d5",
                                                "sense_id": "9ad7f01d-3f25-389f-8e11-2cc12f8fcd7a",
                                                "text": "[A]fterwards he had no leisure for the game, and no inclination for the socialities there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
