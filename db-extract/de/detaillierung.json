                "senses": [
                    {
                        "sense_id": "5311f5da-614d-3cc5-bc35-467f29ae10a3",
                        "entry_id": "cfe58542-3fd9-3157-af53-297f6842f780",
                        "glosses": [
                            "genauere/ausführlichere/umfangreichere Darstellung von etwas, Erklärung/Erläuterung im Detail"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "228cbfb2-4fb9-48cf-a329-3c2b45789307",
                                "sense_id": "5311f5da-614d-3cc5-bc35-467f29ae10a3",
                                "text": "„Die NGO bemängelte unter anderem die mangelnde Detaillierung der Kosten sowie fehlende Auskünfte über interne Kontrollen der Ausgaben.“"
                            },
                            {
                                "example_id": "e0f31e12-e254-481b-b3bc-1fcb0d6d3eb7",
                                "sense_id": "5311f5da-614d-3cc5-bc35-467f29ae10a3",
                                "text": "„Fortgeschrittene Modellbauer bedienen sich heute auch bei Herstellern, die sich auf zusätzliche Detaillierung spezialisiert haben.“"
                            },
                            {
                                "example_id": "475423d6-aaec-4b84-a805-fc41a04f723d",
                                "sense_id": "5311f5da-614d-3cc5-bc35-467f29ae10a3",
                                "text": "[Modellbau:] „Herausragend in der Baugröße H0 waren einige Schaustücke aus Holland, Frankreich und Deutschland, die nicht durch ihre Größe bestachen, sondern durch ihre perfekte, die Wirklichkeit beinahe schon übertreffende, Detaillierung.“"
                            },
                            {
                                "example_id": "da519b72-61b0-4d3a-928b-48b4af288956",
                                "sense_id": "5311f5da-614d-3cc5-bc35-467f29ae10a3",
                                "text": "[Autohändler:] „Es sei jetzt nicht die Zeit, über Umweltthemen in aller Detaillierung zu sprechen, jetzt gehe es um das Überleben einer Branche, sagt Marcel Guerry,“ […]."
                            },
                            {
                                "example_id": "73427a74-4bc2-4221-ae27-a6c88e97fa58",
                                "sense_id": "5311f5da-614d-3cc5-bc35-467f29ae10a3",
                                "text": "[Weissensteinstunnel/Schweiz, Untersuchung der Tunnelsohle:] „Die Ergebnisse werden eine Grundlage sein zur weiteren Detaillierung des Bauprojektes und für einen Entscheid über die Zukunft des Tunnels,“ […]."
                            },
                            {
                                "example_id": "01d03078-3847-4707-800e-d131df4ce022",
                                "sense_id": "5311f5da-614d-3cc5-bc35-467f29ae10a3",
                                "text": "„Die Berücksichtigung zusätzlicher Datengrundlagen wird eine höhere Detaillierung und Aktualität der Bodenzahlen ermöglichen.“"
                            },
                            {
                                "example_id": "5f5a875e-2835-4aba-85e7-ee375dd0899f",
                                "sense_id": "5311f5da-614d-3cc5-bc35-467f29ae10a3",
                                "text": "[In §9a des Umweltinformationsgesetzes (BGBl. Nr. 95/2015 und BGBl. I Nr. 164/2017)] „ist festgelegt, dass Freisetzungen von Schadstoffen aus diffusen Quellen in der bestverfügbaren räumlichen Detaillierung in das nationale PRTR aufgenommen werden müssen.“"
                            },
                            {
                                "example_id": "c5f4d4eb-7045-467d-a90d-801620cb67b7",
                                "sense_id": "5311f5da-614d-3cc5-bc35-467f29ae10a3",
                                "text": "„Durch die Detaillierung der energie- und CO2-intensiven Bereiche wird eine größere Genauigkeit bei diesen Schlüsselsektoren erreicht.“"
                            },
                            {
                                "example_id": "8256a06e-c3eb-44d3-b001-a205b8e865be",
                                "sense_id": "5311f5da-614d-3cc5-bc35-467f29ae10a3",
                                "text": "„»Vor genau einem Jahr haben wir unser Konzept präsentiert. Es ist, glaube ich, gut (aufgenommen worden), und seitdem arbeiten wir weiter und weiter an Gestaltung und Detaillierung,«“ […]."
                            },
                            {
                                "example_id": "b6617fc4-ae73-47fb-8c92-7273345e9e37",
                                "sense_id": "5311f5da-614d-3cc5-bc35-467f29ae10a3",
                                "text": "[U-Bahn-Linie 5 in Hamburg:] „Streckenverlauf, Lage der Haltestellen und Trassierung der U5 wurden in einem mehrstufigen Planungsverfahren erarbeitet, bei dem mit von Stufe zu Stufe zunehmender Detaillierung unterschiedliche Varianten für die genannten Aspekte geprüft und gegeneinander abgewogen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
