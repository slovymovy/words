                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52f6fda2-f7fc-4108-9970-e4e67ad3ff43",
                                                "sense_id": "2296abdb-34a2-38ef-9799-9acc37d692ee",
                                                "text": "Vom Teppichboden wurde eine Bahn zur Ansicht ausgerollt."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "0ff062c9-9a70-3c73-b25c-e33cf0b74fb7",
                                        "entry_id": "3bb52b5c-1b3c-385c-b10e-69a36888fc53",
                                        "glosses": [
                                            "ein glatter, flächiger Teil eines Werkzeugs, das mit dem Werkstoff in Berührung kommt, zum Beispiel die Fläche des Amboss' oder des Hammers"
                                        ],
                                        "tags": [
                                            "Handwerk"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04124c0f-f5e4-41a9-9b04-093701683967",
                                                "sense_id": "0ff062c9-9a70-3c73-b25c-e33cf0b74fb7",
                                                "text": "Die Bahn des Hammers war völlig verrostet."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "d3a4665d-60f8-3e61-b794-d87048073aa0",
                                        "entry_id": "3bb52b5c-1b3c-385c-b10e-69a36888fc53",
                                        "glosses": [
                                            "bestimmte strukturierte Verläufe im menschlichen Körper: siehe zum Beispiel Blutbahn, Nervenbahn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "455c4afd-9b87-4a4c-95a2-cc286cd3c720",
                                                "sense_id": "d3a4665d-60f8-3e61-b794-d87048073aa0",
                                                "text": "Die Bahnen der Nerven verlaufen nur annähernd identisch."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "131def63-de1a-3fda-8b9a-72c64f6374d6",
                                        "entry_id": "3bb52b5c-1b3c-385c-b10e-69a36888fc53",
