                                "en": "<w>Small</w> business is developing in the city.",
                                "es": "En la ciudad se están desarrollando las <w>pequeñas</w> empresas.",
                                "fr": "La <w>petite</w> entreprise se développe dans la ville."
                            }
                        },
                        {
                            "text": "Этот автобус слишком <w>малый</w> для перевозки всех пассажиров.",
                            "target_lang_translations": {
                                "en": "This bus is too <w>small</w> to transport all the passengers.",
                                "es": "Este autobús es demasiado <w>pequeño</w> para transportar a todos los pasajeros.",
                                "fr": "Cet autobus est trop <w>petit</w> pour transporter tous les passagers."
                            }
                        }
                    ],
                    "synonyms": [
                        "небольшой",
                        "незначительный"
                    ],
                    "antonyms": [
                        "большой",
                        "крупный"
                    ],
                    "common_phrases": [
                        "малый бизнес",
                        "малая родина",
                        "малый зал",
                        "малая скорость"
