                "senses": [
                    {
                        "sense_id": "6eb88cb5-1b1d-3f84-81e3-f057c1cfcd39",
                        "entry_id": "4e88e69f-b07d-3b6b-8b00-e8016390a837",
                        "glosses": [
                            "Person, die ein Bühnenstück als Zuschauer besucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e2efefb-9763-4eb1-a43c-672dcf558e66",
                                "sense_id": "6eb88cb5-1b1d-3f84-81e3-f057c1cfcd39",
                                "text": "„Es war eines jener schwankartigen Lustspiele, bei denen auch der unerfahrenste Theaterbesucher von der ersten Minute an weiß, daß das Liebespaar sich kriegen wird, so finster manchmal auch der Himmel dräuen mag.“"
                            },
                            {
                                "example_id": "69d04971-b27b-4ae3-8f85-c492a612eae3",
                                "sense_id": "6eb88cb5-1b1d-3f84-81e3-f057c1cfcd39",
                                "text": "„Sehr bald würde die Welle der Theaterbesucher anrollen.“"
                            },
                            {
                                "example_id": "cca58b1f-b885-4e26-8e76-8fa3a8def293",
                                "sense_id": "6eb88cb5-1b1d-3f84-81e3-f057c1cfcd39",
                                "text": "„De Sade war seit seinem Abschied aus der Armee ein eifriger Theaterbesucher geworden; man macht es sich zu billig, wollte man dieses Interesse nur auf hübsche Schauspielerinnen beziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
