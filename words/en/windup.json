                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завершение",
                                "target_lang_sense_clarification": "общий термин для окончания процесса"
                            },
                            {
                                "target_lang_word": "подведение итогов",
                                "target_lang_sense_clarification": "в контексте обсуждения результатов"
                            },
                            {
                                "target_lang_word": "финал",
                                "target_lang_sense_clarification": "заключительная стадия события"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d76eeb2a-428e-3a2f-bc58-6a1a8ea05b86",
                    "sense_definition": "Operated by a spring that must be turned or tightened manually.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child played happily with his small <w>windup</w> toy car.",
                            "target_lang_translations": {
                                "ru": "Ребенок с радостью играл со своей маленькой <w>заводной</w> машинкой."
                            }
                        },
                        {
                            "text": "She kept an old <w>windup</w> clock on her bedside table for many years.",
                            "target_lang_translations": {
                                "ru": "Она много лет держала на прикроватной тумбочке старые <w>заводные</w> часы."
                            }
