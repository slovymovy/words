                        "entry_id": "e658c614-3830-3f95-9c5c-1beda9434a34",
                        "glosses": [
                            "proces dat weinig met rechtspraak van doen heeft en waarbij de uitkomst (=schuldigverklaring van de verdachten) al bij voorbaat vaststaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf4c3e4e-37e1-4168-97ff-08679b3fde60",
                                "sense_id": "bf46862d-a661-3dfb-8a35-103afa9e1b05",
                                "text": "Zeer sprekende voorbeelden van showprocessen waren de Moskouse Processen in de Sovjet-Unie tijdens Stalins Grote Zuivering in de periode 1936-1938"
                            }
                        ]
                    }
                ],
