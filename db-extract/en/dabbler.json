                                        "entry_id": "b7a4e7bf-0021-3013-980a-aca24eac29d3",
                                        "glosses": [
                                            "jemand, der eine Tätigkeit ausübt, ohne dafür professionell ausgebildet worden zu sein"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6829c216-b6d4-4a57-bfde-c76ccbd79617",
                                                "sense_id": "d3842126-0bff-327a-88a5-3e8f612f5a74",
                                                "text": "Er war ein Dilettant in der Malerei."
                                            },
                                            {
                                                "example_id": "0e677f81-8e73-4084-98fd-bd705cb3a2cf",
                                                "sense_id": "d3842126-0bff-327a-88a5-3e8f612f5a74",
                                                "text": "„Hier kommt meine besondere Qualität als Dilettant ins Spiel: Ich bin Journalist, also das Gegenteil eines Fachmanns.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "70cda209-6af1-3cd6-b4c3-85efe9db202c",
                                        "entry_id": "b7a4e7bf-0021-3013-980a-aca24eac29d3",
                                        "glosses": [
                                            "jemand, der eine Tätigkeit ausübt, ohne sie zu beherrschen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83e7e8a7-555e-4a86-802a-99ca83343ba0",
                                                "sense_id": "70cda209-6af1-3cd6-b4c3-85efe9db202c",
                                                "text": "Mit Verlaub, aber der Umweltminister ist ein Dilettant!"
                                            },
                                            {
                                                "example_id": "8e3528a4-5757-4518-9550-c73ed9382f14",
                                                "sense_id": "70cda209-6af1-3cd6-b4c3-85efe9db202c",
                                                "text": "„Dilettanten ebenso wie Hochbegabte plagiierten Geoffrey, schmückten die Sage mit immer neuen Details aus: dem Schwert im Felsen, dem Königshof Camelot, dem Heiligen Gral.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
