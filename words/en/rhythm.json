{
    "word_family": [
        "rhythmic",
        "rhythmical",
        "rhythmically",
        "arrhythmia",
        "biorhythm",
        "polyrhythm"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f64a694-2483-310f-83e0-375471debb64",
                    "sense_definition": "A regular, repeated pattern of sounds, beats, or movements, especially in music.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "pattern_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tapped her foot to the <w>rhythm</w> of the song.",
                            "target_lang_translations": {
                                "ru": "Она отбивала ногой <w>ритм</w> песни.",
                                "zh": "她随着歌曲的<w>节奏</w>轻敲脚尖。",
                                "es": "Ella seguía el <w>ritmo</w> de la canción con el pie."
                            }
                        },
                        {
                            "text": "Dance to the <w>rhythm</w> of the music.",
                            "target_lang_translations": {
                                "ru": "Танцуй под <w>ритм</w> музыки.",
                                "zh": "随着音乐的<w>节奏</w>跳舞。",
                                "es": "Baila al <w>ritmo</w> de la música."
                            }
                        }
                    ],
                    "synonyms": [
                        "meter",
                        "metre",
                        "beat",
                        "tempo"
                    ],
                    "common_phrases": [
                        "steady rhythm",
                        "rhythm and blues",
                        "dance to the rhythm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Регулярный, повторяющийся узор звуков, ударов или движений, особенно в музыке.",
                        "zh": "指音乐、声音或动作中规律性、重复出现的模式。",
                        "es": "Un patrón regular y repetido de sonidos, golpes o movimientos, especialmente en la música."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ритм",
                                "target_lang_sense_clarification": "музыкальный узор"
                            },
                            {
                                "target_lang_word": "такт",
                                "target_lang_sense_clarification": "единица музыкального метра"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "节奏",
                                "target_lang_sense_clarification": "音乐或动作的规律性"
                            },
                            {
                                "target_lang_word": "节拍",
                                "target_lang_sense_clarification": "音乐中的拍子"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "ritmo",
                                "target_lang_sense_clarification": "patrón musical o sonoro"
                            },
                            {
                                "target_lang_word": "compás",
                                "target_lang_sense_clarification": "unidad de medida musical"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f92f55e-9f00-3fd2-9190-474be97a4019",
                    "sense_definition": "A regular pattern of changes or events in a process, activity, or natural cycle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pattern_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rhythm</w> of the seasons dominates agriculture and wildlife.",
                            "target_lang_translations": {
                                "ru": "<w>Ритм</w> смены времен года управляет сельским хозяйством и дикой природой.",
                                "zh": "季节更替的<w>节奏</w>主导着农业和野生动植物的生长。",
                                "es": "El <w>ritmo</w> de las estaciones domina la agricultura y la vida silvestre."
                            }
                        },
                        {
                            "text": "Once you get into the <w>rhythm</w> of the job, it will become easy.",
                            "target_lang_translations": {
                                "ru": "Как только вы войдете в рабочий <w>ритм</w>, дело пойдет легко.",
                                "zh": "一旦你适应了工作的<w>节奏</w>，一切都会变得简单。",
                                "es": "Una vez que le cojas el <w>ritmo</w> al trabajo, se volverá fácil."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rhythm of life",
                        "circadian rhythm",
                        "daily rhythm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Регулярная последовательность изменений или событий в процессе, деятельности или природном цикле.",
                        "zh": "指过程、活动或自然循环中规律性的变化或事件序列。",
                        "es": "Una secuencia regular de cambios o eventos en un proceso, actividad o ciclo natural."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ритм",
                                "target_lang_sense_clarification": "цикличность событий"
                            },
                            {
                                "target_lang_word": "размеренность",
                                "target_lang_sense_clarification": "плавное течение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "节奏",
                                "target_lang_sense_clarification": "事物发展的规律"
                            },
                            {
                                "target_lang_word": "规律",
                                "target_lang_sense_clarification": "事物变化的常态"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "ritmo",
                                "target_lang_sense_clarification": "ciclicidad de eventos"
                            },
                            {
                                "target_lang_word": "cadencia",
                                "target_lang_sense_clarification": "flujo o movimiento pausado"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9662d3f-0ccb-39f7-ac11-85200356d925",
                    "sense_definition": "A natural ability to feel, hear, and move to a musical beat.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That girl has got <w>rhythm</w>; watch her dance!",
                            "target_lang_translations": {
                                "ru": "У этой девушки есть <w>чувство ритма</w>, посмотри, как она танцует!",
                                "zh": "那个女孩很有<w>节奏感</w>，看她跳舞就知道了！",
                                "es": "Esa chica tiene <w>ritmo</w>; ¡mírala bailar!"
                            }
                        },
                        {
                            "text": "He tries to dance, but he has absolutely no <w>rhythm</w>.",
                            "target_lang_translations": {
                                "ru": "Он пытается танцевать, но у него совершенно нет <w>чувства ритма</w>.",
                                "zh": "他试着跳舞，但他完全没有<w>节奏感</w>。",
                                "es": "Él intenta bailar, pero no tiene nada de <w>ritmo</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "got rhythm",
                        "have rhythm",
                        "no rhythm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Природная способность чувствовать, слышать музыкальный такт и двигаться в соответствии с ним.",
                        "zh": "指对音乐节拍的感知能力以及随之运动的自然天赋。",
                        "es": "Capacidad natural para sentir, escuchar y moverse al compás de la música."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чувство ритма",
                                "target_lang_sense_clarification": "способность"
                            },
                            {
                                "target_lang_word": "ритмичность",
                                "target_lang_sense_clarification": "свойство движений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "节奏感",
                                "target_lang_sense_clarification": "对节奏的感知能力"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "sentido del ritmo",
                                "target_lang_sense_clarification": "habilidad natural"
                            },
                            {
                                "target_lang_word": "ritmo",
                                "target_lang_sense_clarification": "capacidad de seguir el compás"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61332187-f3de-3a24-becd-4962fafd3e2c",
                    "sense_definition": "The measured flow of words and phrases in verse, prose, or literature.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "pattern_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet used a specific <w>rhythm</w> to create a somber mood.",
                            "target_lang_translations": {
                                "ru": "Поэт использовал особый <w>ритм</w>, чтобы создать мрачное настроение.",
                                "zh": "诗人运用了一种特定的<w>韵律</w>来营造忧郁的氛围。",
                                "es": "El poeta utilizó un <w>ritmo</w> específico para crear un ambiente sombrío."
                            }
                        },
                        {
                            "text": "Iambic verse has a distinctive <w>rhythm</w> often found in poetry.",
                            "target_lang_translations": {
                                "ru": "Ямбический стих имеет характерный <w>ритм</w>, часто встречающийся в поэзии.",
                                "zh": "抑扬格诗行有一种在诗歌中常见的独特<w>韵律</w>。",
                                "es": "El verso yámbico tiene un <w>ritmo</w> distintivo que se encuentra a menudo en la poesía."
                            }
                        }
                    ],
                    "synonyms": [
                        "prosody",
                        "meter",
                        "metre"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Размеренное течение слов и фраз в стихах, прозе или литературе.",
                        "zh": "指诗歌、散文或文学作品中词句的韵律流动。",
                        "es": "El flujo medido de palabras y frases en versos, prosa o literatura."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ритм",
                                "target_lang_sense_clarification": "поэтический"
                            },
                            {
                                "target_lang_word": "размер",
                                "target_lang_sense_clarification": "стихотворный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "韵律",
                                "target_lang_sense_clarification": "文学作品的节奏感"
                            },
                            {
                                "target_lang_word": "节奏",
                                "target_lang_sense_clarification": "语言的起伏"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "ritmo",
                                "target_lang_sense_clarification": "en poesía o prosa"
                            },
                            {
                                "target_lang_word": "métrica",
                                "target_lang_sense_clarification": "estructura de los versos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb6e2e53-388b-3b03-89ad-3f73d6e58342",
                    "sense_definition": "The musical instruments in a band that provide the beat and underlying structure, such as drums and bass.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "instruments",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rhythm</w> provides a solid foundation for the melody.",
                            "target_lang_translations": {
                                "ru": "<w>Ритм-секция</w> обеспечивает прочную основу для мелодии.",
                                "zh": "<w>节奏部</w>为旋律提供了坚实的基础。",
                                "es": "La <w>sección rítmica</w> proporciona una base sólida para la melodía."
                            }
                        },
                        {
                            "text": "In this jazz ensemble, the <w>rhythm</w> is driven by the double bass.",
                            "target_lang_translations": {
                                "ru": "В этом джазовом ансамбле <w>ритм-секцию</w> ведет контрабас.",
                                "zh": "在这个爵士乐团中，<w>节奏部</w>由低音提琴驱动。",
                                "es": "En este conjunto de jazz, el <w>ritmo</w> lo marca el contrabajo."
                            }
                        }
                    ],
                    "synonyms": [
                        "rhythm section"
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкальные инструменты в группе, обеспечивающие бит и основную структуру, например, барабаны и бас.",
                        "zh": "指乐队中负责提供节拍和基础结构的乐器组，如鼓和贝斯。",
                        "es": "Los instrumentos musicales en una banda que proporcionan el pulso y la estructura subyacente, como la batería y el bajo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ритм-секция",
                                "target_lang_sense_clarification": "группа инструментов"
                            },
                            {
                                "target_lang_word": "аккомпанемент",
                                "target_lang_sense_clarification": "сопровождение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "节奏部",
                                "target_lang_sense_clarification": "乐队中的节奏乐器组"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "sección rítmica",
                                "target_lang_sense_clarification": "grupo de instrumentos"
                            },
                            {
                                "target_lang_word": "base rítmica",
                                "target_lang_sense_clarification": "acompañamiento"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e753ab54-6338-3471-9be1-de520dcb7ec2",
                    "sense_definition": "To give a specific rhythmic pattern or structure to something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our daily lives are <w>rhythmed</w> by the rising and setting of the sun.",
                            "target_lang_translations": {
                                "ru": "Наша повседневная жизнь <w>ритмизирована</w> восходом и заходом солнца.",
                                "zh": "我们的日常生活被太阳的升落所<w>节奏化</w>。",
                                "es": "Nuestras vidas diarias están <w>ritmadas</w> por la salida y la puesta del sol."
                            }
                        },
                        {
                            "text": "The poem is <w>rhythmed</w> to sound like the galloping of a horse.",
                            "target_lang_translations": {
                                "ru": "Стихотворение <w>ритмизировано</w> так, чтобы звучать как галоп лошади.",
                                "zh": "这首诗被<w>节奏化</w>处理，听起来就像马在奔跑。",
                                "es": "El poema está <w>ritmado</w> para sonar como el galope de un caballo."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать чему-либо определенный ритмический рисунок или структуру.",
                        "zh": "使某事物具有特定的节奏模式或结构。",
                        "es": "Dar un patrón o estructura rítmica específica a algo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ритмизировать",
                                "target_lang_sense_clarification": "организовывать ритмически"
                            },
                            {
                                "target_lang_word": "задавать ритм",
                                "target_lang_sense_clarification": "определять темп"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "节奏化",
                                "target_lang_sense_clarification": "赋予节奏感"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "ritmar",
                                "target_lang_sense_clarification": "dar ritmo"
                            },
                            {
                                "target_lang_word": "dar ritmo",
                                "target_lang_sense_clarification": "establecer una cadencia"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}