    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f3045798-1981-337b-a3ea-c6b4fd3492c9",
                    "sense_definition": "Deftig, deftig en indrukwekkend van uiterlijk of karakter.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indrukwekkend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>statige</w> herenhuizen aan de Amsterdamse grachten staan op de werelderfgoedlijst.",
                            "target_lang_translations": {
                                "en": "The <w>stately</w> mansions along the Amsterdam canals are on the World Heritage List."
                            }
                        },
                        {
                            "text": "Zij liep met een <w>statige</w> pas naar het podium om haar prijs in ontvangst te nemen.",
                            "target_lang_translations": {
                                "en": "She walked with a <w>stately</w> pace to the stage to receive her prize."
                            }
                        }
                    ],
                    "synonyms": [
                        "plechtig"
                    ],
                    "common_phrases": [
                        "statige herenhuizen",
                        "statige gebouwen"
                    ],
                    "target_lang_definitions": {
                        "en": "Dignified, grand, and impressive in appearance or character."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stately",
                                "target_lang_sense_clarification": "grand and impressive, especially of buildings or people"
                            },
                            {
                                "target_lang_word": "majestic",
                                "target_lang_sense_clarification": "having qualities of splendor or royalty"
                            },
                            {
                                "target_lang_word": "dignified",
                                "target_lang_sense_clarification": "showing a composed or serious manner that is worthy of respect"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34daf6e7-4878-3180-b016-4a124c4d77ff",
                    "sense_definition": "Plechtig, ceremonieel en ernstig van aard.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "plechtig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ceremonie werd geopend met een <w>statige</w> toespraak door de burgemeester.",
                            "target_lang_translations": {
                                "en": "The ceremony was opened with a <w>solemn</w> speech by the mayor."
                            }
                        },
                        {
                            "text": "De koning bewoog zich op een <w>statige</w> manier door de menigte.",
                            "target_lang_translations": {
                                "en": "The king moved through the crowd in a <w>stately</w> manner."
                            }
                        }
                    ],
                    "synonyms": [
                        "plechtig"
                    ],
                    "common_phrases": [
                        "statige muziek",
                        "statige ceremonie"
                    ],
                    "target_lang_definitions": {
                        "en": "Solemn, ceremonial, and serious in nature."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "solemn",
                                "target_lang_sense_clarification": "deeply serious, formal, or grave"
                            },
                            {
                                "target_lang_word": "ceremonious",
                                "target_lang_sense_clarification": "characterized by careful attention to formality or ritual"
                            },
                            {
                                "target_lang_word": "stately",
                                "target_lang_sense_clarification": "deliberate, unhurried, and dignified in movement or speech"
                            }
                        ]
                    }
                }
            ]
        }
    ]
