                            {
                                "example_id": "bd5388b2-dc1f-40d0-8e58-999c5c5e5fae",
                                "sense_id": "a28ce7ac-c40c-3679-ad7e-54c405cd3ed6",
                                "text": "Ze sprak op de onnadenkende wijze, die de jeugd eigen is."
                            },
                            {
                                "example_id": "99be238f-f68d-4d02-b2ec-78d226d035d0",
                                "sense_id": "a28ce7ac-c40c-3679-ad7e-54c405cd3ed6",
                                "text": "Je kwetst me met die onnadenkende opmerking."
                            },
                            {
                                "example_id": "d6e20c67-9624-463b-9c67-df7d1bca914e",
                                "sense_id": "a28ce7ac-c40c-3679-ad7e-54c405cd3ed6",
                                "text": "Hij is onnadenkend en onkritisch te werk gegaan"
                            }
