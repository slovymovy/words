                                    {
                                        "sense_id": "2b883406-7237-3f61-9c91-20c623bba7b2",
                                        "entry_id": "1df0a50f-4ac3-3f1c-8109-ea1cbdd21c3d",
                                        "glosses": [
                                            "Discipline qui étudie le devenir du principe actif d'un médicament dans l’organisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa577e6f-2243-4d1b-99a4-8444b1026390",
                                                "sense_id": "2b883406-7237-3f61-9c91-20c623bba7b2",
                                                "text": "La pharmacocinétique des médicaments est l’étude de leur absorption, de leur distribution, de leur métabolisme et de leur excrétion dans l’organisme."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pharmacocinétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "edb5904c-8b30-3336-a74c-f88b6e3f67fb",
                                        "entry_id": "caf732f7-b7ee-3387-9de9-8fff25a23129",
                                        "glosses": [
                                            "Qu a un rapport avec la discipline de pharmacocinétique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b446f349-317f-45f0-bfa9-b877add33568",
                                                "sense_id": "edb5904c-8b30-3336-a74c-f88b6e3f67fb",
                                                "text": "Les propriétés pharmacocinétiques des fluoroquinolones sont très intéressantes : très bonne diffusion extrasystèmiques, et intratissulaire … — (Christian Perronne, Maladies infectieuses, éditeurs Wolters Kluwer France, 1999)"
                                            },
                                            {
                                                "example_id": "05c99823-91f7-4d24-85bf-09c16a6f0ab5",
                                                "sense_id": "edb5904c-8b30-3336-a74c-f88b6e3f67fb",
                                                "text": "La réponse pharmacodynamique modifiée s’explique en partie par les modifications pharmacocinétiques, mais aussi par une altération de la réponse des organes cibles et de leurs récepteurs."
                                            }
                                        ]
                                    }
                                ]
                            }
