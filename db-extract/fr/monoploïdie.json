        "fr-extract.jsonl": [
            {
                "entry_id": "b4baa4e5-0d3b-3cd9-9e5f-6c0ecc6692f4",
                "word": "monoploïdie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f1ac94ef-02c7-3eda-a1d1-c2c82a410b79",
                        "entry_id": "b4baa4e5-0d3b-3cd9-9e5f-6c0ecc6692f4",
                        "glosses": [
                            "Fait d'être monoploïde. (en parlant généralement d'une cellule ou d'un organisme normalement diploïde, comme chez les abeilles, où les mâles sont monoploïdes, contrairement aux femelles)"
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "c056ecd5-5cea-4fb4-8e19-46f009f9c791",
                                "sense_id": "f1ac94ef-02c7-3eda-a1d1-c2c82a410b79",
                                "text": "On trouve parfois des individus porteurs d’un seul lot de chromosomes (monoploïdie) dans les espèces parthénogénétiques où l’animal se développe à partir du gamète femelle sans qu’il y ait fécondation."
                            },
                            {
                                "example_id": "565bdbcd-61ff-4637-8d41-7bdf25c98ae1",
                                "sense_id": "f1ac94ef-02c7-3eda-a1d1-c2c82a410b79",
                                "text": "La monoploïdie est fréquente chez les mâles des hyménoptères, comme les abeilles ou les fourmis, issus de la parthénogenèse."
                            },
                            {
                                "example_id": "d2d9b220-385b-4e81-8ebb-38acbf356754",
                                "sense_id": "f1ac94ef-02c7-3eda-a1d1-c2c82a410b79",
                                "text": "En laboratoire, la monoploïdie peut être induite chez certaines plantes pour faciliter la sélection de mutants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
