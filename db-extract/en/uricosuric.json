        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0433c4e4-d57c-3033-a098-9afdaac3e568",
                "word": "uricosuric",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7d1db23b-14dc-35f1-ae82-51d106dcb2aa",
                        "entry_id": "0433c4e4-d57c-3033-a098-9afdaac3e568",
                        "glosses": [
                            "Pertaining to gout suppressants that act directly on the renal tubule to increase the excretion of uric acid, thus reducing its concentrations in plasma."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9f989de3-4658-4b5c-9b63-9699f1a197f7",
                                "sense_id": "7d1db23b-14dc-35f1-ae82-51d106dcb2aa",
                                "text": "The relation of chemical constitution to the effect on the uric acid excretion, the uricosuric action, of cinchophen was first studied by Niccolaier and Dohrn (1908)."
                            },
                            {
                                "example_id": "22ecce9c-4e81-4e2c-9541-e0e21b40f33b",
                                "sense_id": "7d1db23b-14dc-35f1-ae82-51d106dcb2aa",
                                "text": "If the contention of Folin and Lyman and of Denis as to the identity of the uricosuric activity of cinchophen and the salicylates is correct, the same alterations in uric acid excretion should occur when the latter is administered after section of renal nerves as when cinchophen is given."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
