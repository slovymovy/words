    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0e372bda-15d3-3b35-8aa9-517f67336182",
                    "sense_definition": "Changement de lieu de travail ou d'affectation pour un salarié ou un fonctionnaire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "travail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cinq ans passés dans la capitale, il a demandé une <w>mutation</w> vers le sud de la France."
                        },
                        {
                            "text": "L'entreprise a rapidement accepté sa <w>mutation</w> dans une agence plus proche de son domicile."
                        }
                    ],
                    "synonyms": [
                        "transfert",
                        "affectation",
                        "déplacement"
                    ],
                    "common_phrases": [
                        "demande de mutation",
                        "obtenir une mutation"
                    ]
                },
                {
                    "sense_id": "c5bb9212-9229-3432-a164-4528873423f7",
                    "sense_definition": "Modification spontanée ou provoquée de la séquence génétique d'une cellule ou d'un organisme.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette <w>mutation</w> génétique permet à la bactérie de survivre aux antibiotiques les plus puissants."
                        },
                        {
                            "text": "Les biologistes étudient l'effet de chaque nouvelle <w>mutation</w> sur le comportement et la virulence du virus."
                        }
                    ],
                    "synonyms": [
                        "altération",
                        "variation"
                    ],
                    "common_phrases": [
                        "mutation génétique"
                    ]
                },
                {
                    "sense_id": "56a87cdd-8993-361c-9f4b-29bc347fa05f",
                    "sense_definition": "Transformation profonde et durable touchant une société, une structure ou un domaine d'activité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "changement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le secteur de l'automobile est en pleine <w>mutation</w> grâce à l'arrivée massive des véhicules électriques."
                        },
                        {
                            "text": "Cette ancienne ville industrielle a connu une profonde <w>mutation</w> au cours des vingt dernières années."
                        }
                    ],
                    "synonyms": [
                        "transformation",
                        "métamorphose",
                        "évolution"
                    ],
                    "antonyms": [
                        "stagnation",
                        "stabilité"
                    ],
                    "common_phrases": [
                        "pleine mutation",
                        "en mutation"
                    ]
                },
                {
                    "sense_id": "b4382eed-d2c5-34d8-b991-a96129bb3010",
                    "sense_definition": "Transfert légal de la propriété d'un bien immobilier ou d'un droit d'une personne à une autre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lors de l'achat d'un bien immobilier, l'acquéreur doit régler des droits de <w>mutation</w> au notaire."
                        },
                        {
                            "text": "Le document officiel constate la <w>mutation</w> du terrain en faveur du nouvel acquéreur."
                        }
                    ],
                    "synonyms": [
                        "transfert",
                        "cession"
                    ],
                    "common_phrases": [
                        "droits de mutation",
                        "mutation à titre onéreux"
                    ]
                },
                {
                    "sense_id": "8eeb1433-3051-3647-9699-1af10734267f",
                    "sense_definition": "Altération phonétique régulière d'une consonne sous l'influence du contexte syntaxique ou phonologique.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En breton, la <w>mutation</w> de la consonne initiale d'un nom dépend souvent du mot qui le précède."
                        },
                        {
                            "text": "Les spécialistes comparent les règles de <w>mutation</w> consonantique entre le gallois et d'autres langues celtiques."
                        }
                    ],
                    "common_phrases": [
                        "mutation consonantique"
                    ]
                }
            ]
        }
    ]
}