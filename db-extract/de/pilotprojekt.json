                                        "entry_id": "2ba1c8fc-7bc8-3c3d-9990-845baea612fb",
                                        "glosses": [
                                            "An experiment carried out to test a new idea or concept before full-scale introduction; a pilot study."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ad9a468-3257-4ab4-84ac-c31dcd53e1e3",
                                                "sense_id": "f43ca00b-a7a3-3bb1-9e2e-b50faf0cf527",
                                                "text": "After a pilot scheme, VT [Virgin Trains] introduced 275 [body] cameras from September 2018. Between April and September 2019, assaults on VT staff fell by 30% compared with the previous year."
                                            }
