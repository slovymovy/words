                                        "sense_id": "36a497d4-73d6-32b0-a491-2d2711e8cb33",
                                        "entry_id": "893a8e46-7805-392b-83ed-b163daed665e",
                                        "glosses": [
                                            "A person who plays any kind of game."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59c2775c-78cb-43c7-a6cc-b746221d3097",
                                                "sense_id": "36a497d4-73d6-32b0-a491-2d2711e8cb33",
                                                "text": "[…] any dice-player, carder, tennis player, or other unlawful gamer."
                                            },
                                            {
                                                "example_id": "e65fc1f2-c2e5-4c0a-a293-98a7862d5274",
                                                "sense_id": "36a497d4-73d6-32b0-a491-2d2711e8cb33",
                                                "text": "These dice are the gamers' weapons […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66f0b885-ccd7-3aab-a3ab-6e6443897c5f",
                                        "entry_id": "893a8e46-7805-392b-83ed-b163daed665e",
                                        "glosses": [
                                            "A person who plays any kind of game.",
                                            "A person whose hobby is video games."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50a16cd4-040b-4761-b78a-7b68db010b97",
                                                "sense_id": "66f0b885-ccd7-3aab-a3ab-6e6443897c5f",
                                                "text": "That the Parliament congratulates the online gamer, Harry Brewis, who is known by the handle HBomberGuy, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "536c2a67-40fe-3a87-af5f-1d4c603f895d",
                                        "entry_id": "893a8e46-7805-392b-83ed-b163daed665e",
                                        "glosses": [
                                            "A person who games the system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4341d189-1dc5-4b38-b72f-0cdc30cc7517",
                                                "sense_id": "536c2a67-40fe-3a87-af5f-1d4c603f895d",
                                                "text": "Near-synonym: gamesman"
                                            },
                                            {
                                                "example_id": "1f533023-6d29-4ef5-98fe-ee5250ba247e",
                                                "sense_id": "536c2a67-40fe-3a87-af5f-1d4c603f895d",
                                                "text": "[…] the real \"takers\" in this country are commercial gamers of the system who are only in it to swipe a fast buck from the common trust."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95bc0e9a-d74f-33e8-b7b9-48307a112d72",
                                        "entry_id": "893a8e46-7805-392b-83ed-b163daed665e",
                                        "glosses": [
                                            "A gambler."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5254be22-b78a-4312-8f4d-65274c4d9fca",
                                                "sense_id": "95bc0e9a-d74f-33e8-b7b9-48307a112d72",
                                                "text": "The gamer is farther from restoration even than the drunkard, because what he does he does in the light of sobriety and reason."
                                            }
                                        ]
                                    }
                                ]
