        "fr-extract.jsonl": [
            {
                "entry_id": "0e915661-6281-3303-9310-88be5c20a610",
                "word": "caquet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6af85813-3128-430f-bfa5-bc36c545e54a",
                        "entry_id": "0e915661-6281-3303-9310-88be5c20a610",
                        "tags": [
                            "plural"
                        ],
                        "form": "caquets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "470efaf1-c16c-30f4-805b-32698c0c9413",
                        "entry_id": "0e915661-6281-3303-9310-88be5c20a610",
                        "glosses": [
                            "Gloussement de la poule."
                        ],
                        "tags": [
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "31ae8e99-f9d8-4bc6-829c-612e2a118ed5",
                                "sense_id": "470efaf1-c16c-30f4-805b-32698c0c9413",
                                "text": "Au caquet des poules, au crottin des percherons succèdent les ronflements des moteurs, les irisations, sur les pavés, de l'huile minérale."
                            }
                        ]
                    },
                    {
                        "sense_id": "c33a9d0d-ea7b-33ad-9501-a7ba2a3cc9ff",
                        "entry_id": "0e915661-6281-3303-9310-88be5c20a610",
                        "glosses": [
                            "Gloussement de la poule.",
                            "Piaillerie."
                        ],
                        "tags": [
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "326a1bcb-c29e-4efa-8070-8f26cdbaeb6a",
                                "sense_id": "c33a9d0d-ea7b-33ad-9501-a7ba2a3cc9ff",
                                "text": "Dans une allée perpendiculaire à la première on entendait le caquet de mille oiseaux des îles."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d1e2d3b-0ce1-3a44-aa82-8899617f8bcc",
                        "entry_id": "0e915661-6281-3303-9310-88be5c20a610",
                        "glosses": [
                            "Babil indiscret."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "613bc662-64fc-40ea-985e-f20130090e1e",
                                "sense_id": "4d1e2d3b-0ce1-3a44-aa82-8899617f8bcc",
                                "text": "Caquet importun."
                            },
                            {
                                "example_id": "c5f171d0-0381-4d20-89de-9ef6c7f68345",
                                "sense_id": "4d1e2d3b-0ce1-3a44-aa82-8899617f8bcc",
                                "text": "Avoir bien du caquet."
                            },
                            {
                                "example_id": "946c5239-db7f-41eb-a558-0bed56b6eb5a",
                                "sense_id": "4d1e2d3b-0ce1-3a44-aa82-8899617f8bcc",
                                "text": "Elle a le caquet bien affilé."
                            },
                            {
                                "example_id": "f8e95637-0aa0-4d28-b49d-10359da87e68",
                                "sense_id": "4d1e2d3b-0ce1-3a44-aa82-8899617f8bcc",
                                "text": "Ainsi donc qu’à bon escient je donne droit au but, je ne voudraie opposer à ceux qui me mettraient en ny le caquet des femmes que le proverbe commun, qui porte que trois femmes feront un marché, voire une foire."
                            },
                            {
                                "example_id": "0744373c-4922-4f10-aec4-4781f4c0492c",
                                "sense_id": "4d1e2d3b-0ce1-3a44-aa82-8899617f8bcc",
                                "text": "Elle possédait le caquet et la coquetterie des filles entichées de balivernes."
                            },
                            {
                                "example_id": "97df06e6-06d1-4bef-949c-df558cb4df2b",
                                "sense_id": "4d1e2d3b-0ce1-3a44-aa82-8899617f8bcc",
                                "text": "MONTPELLIER – Nulle part la vraie Française hardie, caquet bon bec, mais pimpante, à jolie tournure, à démarche alerte et rythmée, n’apparaît mieux qu’ici."
                            },
                            {
                                "example_id": "8819890b-4d77-43ee-b05d-bc0c89e037c9",
                                "sense_id": "4d1e2d3b-0ce1-3a44-aa82-8899617f8bcc",
                                "text": "Les remarques que suscitait Montaigne étaient nombreuses et variées. Les névropathes sont grands lecteurs. Ils connaissent leur affaire, les phases par lesquelles ils doivent passer, les complications qui les menacent, les traitements que l’on peut essayer. Ils ergotent, et l’auteur des Essais est le roi des ergoteurs, puisqu’il mêle à ses bavardages délicieux jusqu`aux auteurs de l’Antiquité. Ces caquets d’un coliquard sublime avaient donc le plus grand succès."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fcc8367-b824-486e-b8ab-752bdab69803",
                        "source_entry_id": "0e915661-6281-3303-9310-88be5c20a610",
                        "source_sense_description": "(Sens propre) Gloussement de la poule.",
                        "target_lang_word": "Gegacker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegacker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c57629ca-4728-397a-9560-cac8fb7562c3",
                                        "entry_id": "b8075d35-59d2-3dc5-a47e-f1cd9307470b",
                                        "glosses": [
                                            "dauerndes Gackern der Hühner"
                                        ],
                                        "tags": [
                                            "Tierlaut"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18da75e1-a45c-4cc3-b08c-991e5d26b5d6",
                                                "sense_id": "c57629ca-4728-397a-9560-cac8fb7562c3",
                                                "text": "\"Vom Geflügelhof war das Gegacker der Hühner zu hören, hinter denen die Magd herlief, um ihnen den Hals abzuschneiden.\""
                                            },
                                            {
                                                "example_id": "39d7dbd9-f12a-4db5-9080-99fb5023caae",
                                                "sense_id": "c57629ca-4728-397a-9560-cac8fb7562c3",
                                                "text": "Hin und wieder döst ein streunender Hund in der Sonne, noch seltener flattern zwei, drei verloren wirkende Hühner mit lautem Gegacker vor dem seltenen Besuch davon."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e6389fc7-e077-36b4-b28f-ec58bc92d9a3",
                                        "entry_id": "b8075d35-59d2-3dc5-a47e-f1cd9307470b",
                                        "glosses": [
                                            "andauerndes Kichern"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8ee7eb0-0755-4352-9eeb-6b1181611c54",
                                                "sense_id": "e6389fc7-e077-36b4-b28f-ec58bc92d9a3",
                                                "text": "Die große Karl-Valentin-Renaissance setzte zu Beginn der sechziger Jahre ein – seine Filme und Tonaufnahmen heute wieder einmal zu erleben ist immer noch ein superbes Vergnügen, das in hilflosem Gegacker mündet."
                                            },
                                            {
                                                "example_id": "8e4a774b-4438-449f-9545-787dfac6f9ef",
                                                "sense_id": "e6389fc7-e077-36b4-b28f-ec58bc92d9a3",
                                                "text": "So kommt es vor, dass ein Mensch unter Freunden spontan mitlacht, noch ehe er einen Witz verstanden hat - das wilde Gegacker steckt ihn an."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a879e9a1-97be-34d8-b99f-2d433ccd74fb",
                                        "entry_id": "b8075d35-59d2-3dc5-a47e-f1cd9307470b",
                                        "glosses": [
                                            "dauerndes, oberflächliches Reden"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0a1ca55-8779-458a-ab8b-55c983c678fe",
                                                "sense_id": "a879e9a1-97be-34d8-b99f-2d433ccd74fb",
                                                "text": "Das herrschende Gegacker, das allgemeine Geschwätz, das die französische Schriftstellerin so trefflich kennzeichnet, ist ein Placebo."
                                            },
                                            {
                                                "example_id": "e8bd6a4a-224e-443e-ba1b-fbe41b62c230",
                                                "sense_id": "a879e9a1-97be-34d8-b99f-2d433ccd74fb",
                                                "text": "Eier auspusten und Eier malen, Eier verstecken und Eier suchen — mit viel Gegacker lädt die Reiseindustrie zum österlichen Kurzurlaub."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eba3a13e-1797-46d6-bcc0-1cad5b54969a",
                        "source_entry_id": "0e915661-6281-3303-9310-88be5c20a610",
                        "source_sense_description": "(Sens propre) Gloussement de la poule.",
                        "target_lang_word": "cackle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cackle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d460ddb0-d176-34de-8736-579dc6f47962",
                                        "entry_id": "fcfd7ac6-abb7-3935-9972-3957cda6805a",
                                        "glosses": [
                                            "The cry of a hen or goose, especially when laying an egg."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17a3d80b-b9c6-47ec-945c-645165cf461d",
                                                "sense_id": "d460ddb0-d176-34de-8736-579dc6f47962",
                                                "text": "I heard a grey hen cackling among the ling; I called and thought, \"If I could get a sight of you now, it would be your last cackle;\" just then I heard something moving behind me on the path."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60127db4-e837-32a0-b20b-56c029636201",
                                        "entry_id": "fcfd7ac6-abb7-3935-9972-3957cda6805a",
                                        "glosses": [
                                            "A laugh resembling the cry of a hen or goose."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "231e01ee-ba6f-36ae-b65b-b0752bdd3cad",
                                        "entry_id": "fcfd7ac6-abb7-3935-9972-3957cda6805a",
                                        "glosses": [
                                            "Futile or excessively noisy talk."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ae366cb-eca0-4068-b551-c57179635c8c",
                                                "sense_id": "231e01ee-ba6f-36ae-b65b-b0752bdd3cad",
                                                "text": "There's no time to waste on silly cackle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faccbb09-55d5-351a-8076-26466fffc2da",
                                        "entry_id": "fcfd7ac6-abb7-3935-9972-3957cda6805a",
                                        "glosses": [
                                            "A group of hyenas."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cackle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc1d8ee1-c33e-3090-bb8f-f397fa12f15d",
                                        "entry_id": "d0c5ad3a-ef06-3e62-bdf3-40329e7bef16",
                                        "glosses": [
                                            "To make a sharp, broken noise or cry, as a hen or goose does."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6af05597-1b58-412c-81e2-cdce2ad5895d",
                                                "sense_id": "dc1d8ee1-c33e-3090-bb8f-f397fa12f15d",
                                                "text": "When every goose is cackling."
                                            },
                                            {
                                                "example_id": "2ed0100f-8c84-43f3-b03d-d7aa8ec7d606",
                                                "sense_id": "dc1d8ee1-c33e-3090-bb8f-f397fa12f15d",
                                                "text": "I heard a grey hen cackling among the ling; I called and thought, \"If I could get a sight of you now, it would be your last cackle;\" just then I heard something moving behind me on the path."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34274cf1-0505-3505-91a1-01de488d8c3a",
                                        "entry_id": "d0c5ad3a-ef06-3e62-bdf3-40329e7bef16",
                                        "glosses": [
                                            "To laugh with a broken sound similar to a hen's cry."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b71f192-91d6-4dbc-ae2e-5ef05420958e",
                                                "sense_id": "34274cf1-0505-3505-91a1-01de488d8c3a",
                                                "text": "The witch cackled evilly."
                                            },
                                            {
                                                "example_id": "7bab737d-56a4-42d7-863a-bb779a2ed955",
                                                "sense_id": "34274cf1-0505-3505-91a1-01de488d8c3a",
                                                "text": "She was a fat, round little woman, richly apparelled in velvet and lace, […]; and the way she laughed, cackling like a hen, the way she talked to the waiters and the maid,[…]—all these unexpected phenomena impelled one to hysterical mirth, and made one class her with such immortally ludicrous types as Ally Sloper, the Widow Twankey, or Miss Moucher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bd3b366-062d-393b-810f-d421fe8a598a",
                                        "entry_id": "d0c5ad3a-ef06-3e62-bdf3-40329e7bef16",
                                        "glosses": [
                                            "To talk in a silly manner; to prattle."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45abaa56-c214-4758-9383-76558982e38d",
                                                "sense_id": "8bd3b366-062d-393b-810f-d421fe8a598a",
                                                "text": "It is also the business of a sensible government, not to cackle on its discoveries"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae7db354-b401-32c2-a635-43df0ceb200a",
                                        "entry_id": "d0c5ad3a-ef06-3e62-bdf3-40329e7bef16",
                                        "glosses": [
                                            "To pretend to rattle (dice) in one's hand while gripping them so that they maintain their orientation."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9422af8-3327-4226-b60d-eec6559a2316",
                                                "sense_id": "ae7db354-b401-32c2-a635-43df0ceb200a",
                                                "text": "Danny cackled the dice furiously in his cupped hand, then rolled them so they stopped inches from Slattery's hands. The result was the same as before – a seven."
                                            },
                                            {
                                                "example_id": "1eca3503-5549-4eb1-ab39-d1b4d5d28b48",
                                                "sense_id": "ae7db354-b401-32c2-a635-43df0ceb200a",
                                                "text": "[…] they spun all right, or so it seemed, and hit the wall all right, or so it seemed, but bottom line was this: The stirring of the dice was merely cackling, the cubes artfully framed so that the spots in the kid's fists showed 4‐4 up‐right and weren't really rattled but rather, held in control by the pinky, forefinger and thumb; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59e791d2-e7da-4462-9361-83b8aea92463",
