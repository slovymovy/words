{
    "word_family": [
        "tabulate",
        "tabulation",
        "tabulator"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f12f082e-e8cd-3055-a192-e9e7f11760e4",
                    "sense_definition": "A separate page or document open within a web browser or application, accessible via a clickable label at the top of the window.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing_ui",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have too many <w>tabs</w> open in my browser right now.",
                            "target_lang_translations": {
                                "ru": "У меня сейчас открыто слишком много <w>вкладок</w> в браузере.",
                                "zh": "我浏览器里现在打开了太多<w>标签页</w>。"
                            }
                        },
                        {
                            "text": "Right-click the link and select open in a new <w>tab</w>.",
                            "target_lang_translations": {
                                "ru": "Щелкните правой кнопкой мыши по ссылке и выберите \"открыть в новой <w>вкладке</w>\".",
                                "zh": "右键点击链接，选择在新的<w>标签页</w>中打开。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "new tab",
                        "close a tab",
                        "switch tabs"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная страница или документ, открытый в веб-браузере или приложении, доступный через кликабельный ярлык в верхней части окна.",
                        "zh": "在网页浏览器或应用程序中打开的独立页面或文档，可通过窗口顶部的可点击标签进行访问。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вкладка",
                                "target_lang_sense_clarification": "в браузере или интерфейсе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "标签页",
                                "target_lang_sense_clarification": "浏览器或软件界面中的页面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52cef80b-7142-38bd-9ee6-c874065372e2",
                    "sense_definition": "A key on a computer keyboard used to advance the cursor to the next field or to insert a specific amount of space.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing_hardware",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Press <w>tab</w> to move to the next box in the form.",
                            "target_lang_translations": {
                                "ru": "Нажмите <w>Tab</w>, чтобы перейти к следующему полю формы.",
                                "zh": "按下<w>Tab键</w>以跳转到表格的下一个输入框。"
                            }
                        },
                        {
                            "text": "The <w>tab</w> key is usually located on the far left of the keyboard.",
                            "target_lang_translations": {
                                "ru": "Клавиша <w>Tab</w> обычно находится в крайней левой части клавиатуры.",
                                "zh": "<w>Tab键</w>通常位于键盘的最左侧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tabulator"
                    ],
                    "common_phrases": [
                        "tab key",
                        "hit tab"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Клавиша на клавиатуре компьютера, используемая для перемещения курсора к следующему полю или вставки отступа.",
                        "zh": "计算机键盘上的一个按键，用于将光标移动到下一个字段或插入特定数量的空格。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клавиша Tab",
                                "target_lang_sense_clarification": "кнопка на клавиатуре"
                            },
                            {
                                "target_lang_word": "табуляция",
                                "target_lang_sense_clarification": "функция или символ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "Tab键",
                                "target_lang_sense_clarification": "键盘上的制表键"
                            },
                            {
                                "target_lang_word": "制表符",
                                "target_lang_sense_clarification": "指代该键产生的空格符号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4fc5ca6-4594-3b73-885b-36c3c10e3c50",
                    "sense_definition": "A small flap or strip of material attached to something for holding, manipulation, identification, or opening.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pull the metal <w>tab</w> to open the soda can.",
                            "target_lang_translations": {
                                "ru": "Потяните за металлический <w>язычок</w>, чтобы открыть банку с газировкой.",
                                "zh": "拉动金属<w>拉环</w>即可打开汽水罐。"
                            }
                        },
                        {
                            "text": "Use the colored <w>tabs</w> to organize the different sections of your binder.",
                            "target_lang_translations": {
                                "ru": "Используйте цветные <w>закладки</w>, чтобы организовать различные разделы вашей папки.",
                                "zh": "使用彩色<w>标签</w>来整理活页夹的不同部分。"
                            }
                        }
                    ],
                    "antonyms": [
                        "slot"
                    ],
                    "common_phrases": [
                        "pull-tab",
                        "index tab"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой выступ или полоска материала, прикрепленная к предмету для удержания, манипуляции или открывания.",
                        "zh": "附着在物体上用于抓取、操作、识别或开启的小突起或条状物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "язычок",
                                "target_lang_sense_clarification": "на банке, обуви или молнии"
                            },
                            {
                                "target_lang_word": "закладка",
                                "target_lang_sense_clarification": "для книг или папок"
                            },
                            {
                                "target_lang_word": "петелька",
                                "target_lang_sense_clarification": "на одежде"
                            },
                            {
                                "target_lang_word": "ушко",
                                "target_lang_sense_clarification": "отверстие или петля"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉环",
                                "target_lang_sense_clarification": "用于开启罐头或拉链"
                            },
                            {
                                "target_lang_word": "标签",
                                "target_lang_sense_clarification": "用于分类或索引的纸片"
                            },
                            {
                                "target_lang_word": "书签",
                                "target_lang_sense_clarification": "用于标记书页"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d3a56eb-d378-3d9d-8606-3f31ab5a0355",
                    "sense_definition": "A running account of charges, especially at a bar or restaurant, to be paid later; also, the total bill.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He offered to pick up the <w>tab</w> for the entire dinner party.",
                            "target_lang_translations": {
                                "ru": "Он предложил оплатить <w>счёт</w> за весь ужин.",
                                "zh": "他主动提出为整个晚宴<w>买单</w>。"
                            }
                        },
                        {
                            "text": "Can you put these drinks on my <w>tab</w>, please?",
                            "target_lang_translations": {
                                "ru": "Можете записать эти напитки на мой <w>счёт</w>, пожалуйста?",
                                "zh": "请问能把这些饮料记在我的<w>账单</w>上吗？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pick up the tab",
                        "put on my tab",
                        "run a tab"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Текущий счет расходов (особенно в баре или ресторане), который оплачивается позже; общий счет.",
                        "zh": "在酒吧或餐厅等场所的挂账，即稍后支付的消费总额。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "счёт",
                                "target_lang_sense_clarification": "в ресторане или баре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "账单",
                                "target_lang_sense_clarification": "餐饮消费的结算单"
                            },
                            {
                                "target_lang_word": "挂账",
                                "target_lang_sense_clarification": "记在名下稍后支付"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "322ef266-310c-3e36-9997-64f8caff8aaa",
                    "sense_definition": "A simplified form of musical notation indicating instrument fingering rather than pitch; short for <w>tablature</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I learned to play the song by reading guitar <w>tabs</w> online.",
                            "target_lang_translations": {
                                "ru": "Я научился играть эту песню, читая гитарные <w>табулатуры</w> в интернете.",
                                "zh": "我是通过在网上看<w>吉他谱</w>学会弹这首歌的。"
                            }
                        },
                        {
                            "text": "Do you have the <w>tab</w> for this solo?",
                            "target_lang_translations": {
                                "ru": "У тебя есть <w>табулатура</w> для этого соло?",
                                "zh": "你有这段独奏的<w>吉他谱</w>吗？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "guitar tab",
                        "read tabs"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short for tablature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Упрощенная форма музыкальной записи, указывающая аппликатуру инструмента, а не высоту звука.",
                        "zh": "一种简化的乐谱形式，用于指示乐器指法而非音高，是tablature的缩写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "табулатура",
                                "target_lang_sense_clarification": "музыкальная нотация"
                            },
                            {
                                "target_lang_word": "табы",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吉他谱",
                                "target_lang_sense_clarification": "指法记谱法"
                            },
                            {
                                "target_lang_word": "六线谱",
                                "target_lang_sense_clarification": "吉他常用的指法谱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f70132a0-483e-345f-a252-90f0f6011d03",
                    "sense_definition": "A tablet containing an illicit drug.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "drugs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police found several <w>tabs</w> of acid in the suspect's pocket.",
                            "target_lang_translations": {
                                "ru": "Полиция нашла несколько <w>марок</w> кислоты в кармане подозреваемого.",
                                "zh": "警方在嫌疑人的口袋里发现了好几<w>药片</w>状的迷幻药。"
                            }
                        },
                        {
                            "text": "He admitted to taking a <w>tab</w> at the party last night.",
                            "target_lang_translations": {
                                "ru": "Он признался, что принял <w>таблетку</w> на вечеринке прошлой ночью.",
                                "zh": "他承认昨晚在派对上吃了一<w>药片</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Таблетка или кусочек бумаги, содержащие наркотическое вещество.",
                        "zh": "含有违禁药物的药片或纸片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "марка",
                                "target_lang_sense_clarification": "сленг, обычно ЛСД"
                            },
                            {
                                "target_lang_word": "таблетка",
                                "target_lang_sense_clarification": "общая форма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "药片",
                                "target_lang_sense_clarification": "指代毒品药丸"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "36009357-20b1-3593-a0af-09f7ebafed89",
                    "sense_definition": "To move the cursor or focus on a computer screen by pressing the Tab key.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can quickly <w>tab</w> through the fields to fill out the form.",
                            "target_lang_translations": {
                                "ru": "Вы можете быстро <w>переключаться</w> между полями, чтобы заполнить форму.",
                                "zh": "你可以快速<w>切换</w>输入框来填写表格。"
                            }
                        },
                        {
                            "text": "She <w>tabbed</w> over to the next column in the spreadsheet.",
                            "target_lang_translations": {
                                "ru": "Она <w>перешла</w> в следующий столбец таблицы.",
                                "zh": "她<w>跳至</w>了电子表格的下一列。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tab through",
                        "tab over"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перемещать курсор или фокус на экране компьютера нажатием клавиши Tab.",
                        "zh": "通过按下Tab键在计算机屏幕上移动光标或焦点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переключаться",
                                "target_lang_sense_clarification": "с помощью клавиши Tab"
                            },
                            {
                                "target_lang_word": "переходить",
                                "target_lang_sense_clarification": "навигация по полям"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "切换",
                                "target_lang_sense_clarification": "在输入框间移动"
                            },
                            {
                                "target_lang_word": "跳至",
                                "target_lang_sense_clarification": "移动到下一个位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f261bc4c-57f9-3685-9f44-b37ffbebca51",
                    "sense_definition": "To mark, label, or organize something using tabs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "organizing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The assistant <w>tabbed</w> the important pages for the director to sign.",
                            "target_lang_translations": {
                                "ru": "Ассистент <w>пометил закладками</w> важные страницы для подписи директора.",
                                "zh": "助理给重要的页面都<w>加标签</w>，以便主管签字。"
                            }
                        },
                        {
                            "text": "All the files were carefully <w>tabbed</w> alphabetically.",
                            "target_lang_translations": {
                                "ru": "Все файлы были тщательно <w>снабжены закладками</w> в алфавитном порядке.",
                                "zh": "所有的文件都按字母顺序仔细地<w>标记</w>好了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Помечать, маркировать или организовывать что-либо с помощью закладок.",
                        "zh": "使用标签对某物进行标记、分类或整理。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать закладки",
                                "target_lang_sense_clarification": "вставлять разделители"
                            },
                            {
                                "target_lang_word": "помечать",
                                "target_lang_sense_clarification": "маркировать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加标签",
                                "target_lang_sense_clarification": "贴上索引标签"
                            },
                            {
                                "target_lang_word": "标记",
                                "target_lang_sense_clarification": "做记号"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}