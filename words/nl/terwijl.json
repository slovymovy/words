                    "sense_id": "9668e4da-bd44-365c-ac99-6c089f653ef4",
                    "sense_definition": "Gedurende de tijd dat er iets anders gebeurt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temporal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Terwijl</w> hij telefoneerde, kookte de soep in de keuken over.",
                            "target_lang_translations": {
                                "en": "<w>While</w> he was on the phone, the soup in the kitchen boiled over.",
                                "ru": "<w>Пока</w> он говорил по телефону, суп на кухне убежал.",
                                "pl": "<w>Podczas gdy</w> rozmawiał przez telefon, zupa w kuchni wykipiała.",
                                "de": "<w>Während</w> er telefonierte, kochte die Suppe in der Küche über.",
                                "fr": "<w>Pendant qu'</w>il téléphonait, la soupe a débordé dans la cuisine.",
                                "it": "<w>Mentre</w> telefonava, la zuppa in cucina è traboccata.",
                                "cs": "<w>Zatímco</w> telefonoval, polévka v kuchyni překypěla.",
                                "tr": "O telefonla <w>konuşurken</w>, mutfaktaki çorba taştı.",
                                "es": "<w>Mientras</w> hablaba por teléfono, la sopa se derramó en la cocina al hervir."
                            }
                        },
                        {
                            "text": "Ik luister graag naar muziek <w>terwijl</w> ik mijn huiswerk maak.",
                            "target_lang_translations": {
                                "en": "I like listening to music <w>while</w> doing my homework.",
                                "ru": "Я люблю слушать музыку, <w>пока</w> делаю уроки.",
                                "pl": "Lubię słuchać muzyki, <w>gdy</w> odrabiam lekcje.",
                                "de": "Ich höre gerne Musik, <w>während</w> ich meine Hausaufgaben mache.",
                                "fr": "J'aime écouter de la musique <w>pendant que</w> je fais mes devoirs.",
                                "it": "Mi piace ascoltare la musica <w>mentre</w> faccio i compiti.",
                                "cs": "Rád poslouchám hudbu, <w>zatímco</w> si dělám úkoly.",
                                "tr": "Ödevimi <w>yaparken</w> müzik dinlemeyi severim.",
                                "es": "Me gusta escuchar música <w>mientras</w> hago mis deberes."
                            }
                        }
                    ],
                    "common_phrases": [
                        "terwijl ik wacht",
                        "terwijl hij sliep",
                        "terwijl we praten"
