{
    "word_family": [
        "grappler",
        "grappling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c8ad29ed-fb15-3387-ae4b-44a235502ed1",
                    "sense_definition": "To ponder and intensely evaluate a problem; to struggle to deal with.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "mental_struggle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government continues to <w>grapple</w> with the complex issue of rising inflation.",
                            "target_lang_translations": {
                                "ru": "Правительство продолжает <w>бороться</w> со сложной проблемой растущей инфляции."
                            }
                        },
                        {
                            "text": "Many students <w>grapple</w> with one's conscience when deciding whether to report a friend for cheating.",
                            "target_lang_translations": {
                                "ru": "Многие студенты <w>борются</w> со своей совестью, решая, стоит ли доносить на друга за списывание."
                            }
                        }
                    ],
                    "synonyms": [
                        "confront",
                        "tackle",
                        "wrestle"
                    ],
                    "antonyms": [
                        "ignore",
                        "avoid"
                    ],
                    "common_phrases": [
                        "grapple with one's conscience",
                        "grapple with a problem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обдумывать и интенсивно оценивать проблему; пытаться справиться с чем-то сложным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бороться",
                                "target_lang_sense_clarification": "с проблемой или трудностями"
                            },
                            {
                                "target_lang_word": "пытаться разрешить",
                                "target_lang_sense_clarification": "сложный вопрос"
                            },
                            {
                                "target_lang_word": "схлестнуться",
                                "target_lang_sense_clarification": "переносно с задачей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77584998-9914-3450-b426-62e97ba0a609",
                    "sense_definition": "To wrestle or tussle physically with someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_struggle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two athletes began to <w>grapple</w> on the mat during the final round of the match.",
                            "target_lang_translations": {
                                "ru": "Двое атлетов начали <w>бороться</w> на мате во время финального раунда поединка."
                            }
                        },
                        {
                            "text": "The security guard had to <w>grapple</w> with the intruder to prevent him from entering the building.",
                            "target_lang_translations": {
                                "ru": "Охраннику пришлось <w>схватиться</w> со злоумышленником, чтобы не дать ему войти в здание."
                            }
                        }
                    ],
                    "synonyms": [
                        "wrestle",
                        "scuffle",
                        "tussle"
                    ],
                    "common_phrases": [
                        "grapple on the floor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бороться или вступать в физическую схватку с кем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бороться",
                                "target_lang_sense_clarification": "физически"
                            },
                            {
                                "target_lang_word": "схватиться",
                                "target_lang_sense_clarification": "в рукопашной"
                            },
                            {
                                "target_lang_word": "сцепиться",
                                "target_lang_sense_clarification": "в драке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2119d184-bdc9-35cf-934a-9b28c2f69c0d",
                    "sense_definition": "To seize something and hold it firmly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_struggle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>grapple</w> the rope just before he slipped off the edge of the cliff.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>ухватиться</w> за веревку как раз перед тем, как он соскользнул с края обрыва."
                            }
                        },
                        {
                            "text": "The sailor tried to <w>grapple</w> the side of the boat as the waves grew stronger.",
                            "target_lang_translations": {
                                "ru": "Моряк пытался <w>вцепиться</w> в борт лодки, когда волны стали сильнее."
                            }
                        }
                    ],
                    "synonyms": [
                        "clutch",
                        "grasp",
                        "seize"
                    ],
                    "antonyms": [
                        "release",
                        "drop"
                    ],
                    "common_phrases": [
                        "grapple firmly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Схватить что-либо и крепко удерживать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схватить",
                                "target_lang_sense_clarification": "резко взять"
                            },
                            {
                                "target_lang_word": "ухватиться",
                                "target_lang_sense_clarification": "за что-то для опоры"
                            },
                            {
                                "target_lang_word": "вцепиться",
                                "target_lang_sense_clarification": "мертвой хваткой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ade7438-9559-34d9-a8c6-d138529e98b1",
                    "sense_definition": "To fasten or join something indissolubly, often using a hook or similar tool.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fastening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers <w>grappled</w> a rope ladder to the castle walls to begin their ascent.",
                            "target_lang_translations": {
                                "ru": "Солдаты <w>зацепили</w> веревочную лестницу за стены замка, чтобы начать восхождение."
                            }
                        },
                        {
                            "text": "You should <w>grapple</w> these principles to your soul with hoops of steel to never forget them.",
                            "target_lang_translations": {
                                "ru": "Тебе следует <w>приковать</w> эти принципы к своей душе стальными обручами, чтобы никогда не забывать их."
                            }
                        }
                    ],
                    "synonyms": [
                        "fasten",
                        "fix",
                        "secure"
                    ],
                    "antonyms": [
                        "detach",
                        "unfasten"
                    ],
                    "common_phrases": [
                        "grapple a rope"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скреплять или соединять что-либо неразрывно, часто используя крюк или подобный инструмент."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зацепить",
                                "target_lang_sense_clarification": "крюком или зацепом"
                            },
                            {
                                "target_lang_word": "скреплять",
                                "target_lang_sense_clarification": "прочно соединять"
                            },
                            {
                                "target_lang_word": "приковать",
                                "target_lang_sense_clarification": "переносно к душе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96116bab-d318-3062-a2bb-b9730f7f061d",
                    "sense_definition": "To climb up or down using a grapple and rope or by hand.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "climbing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The commando <w>grappled</w> up the side of the building in total silence.",
                            "target_lang_translations": {
                                "ru": "Коммандос в полной тишине <w>взобрался</w> по стене здания с помощью кошки."
                            }
                        },
                        {
                            "text": "He <w>grappled</w> down the cliff face using a specialized tactical hook.",
                            "target_lang_translations": {
                                "ru": "Он <w>спустился</w> по отвесной скале, используя специальный тактический крюк."
                            }
                        }
                    ],
                    "synonyms": [
                        "climb",
                        "scale"
                    ],
                    "antonyms": [
                        "descend"
                    ],
                    "common_phrases": [
                        "grapple up",
                        "grapple down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Забираться вверх или спускаться вниз, используя абордажную кошку и веревку или руками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карабкаться",
                                "target_lang_sense_clarification": "используя снаряжение или руки"
                            },
                            {
                                "target_lang_word": "взбираться",
                                "target_lang_sense_clarification": "на стену или скалу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb4fc702-a70a-3c66-abac-152aa16baf67",
                    "sense_definition": "To hook and raise something from underwater or a depth using a specialized tool.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "retrieval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew managed to <w>grapple</w> up the broken cable from the bottom of the ocean.",
                            "target_lang_translations": {
                                "ru": "Экипажу удалось <w>выловить</w> кошкой оборванный кабель со дна океана."
                            }
                        },
                        {
                            "text": "They spent the afternoon trying to <w>grapple</w> the lost net from the lake floor.",
                            "target_lang_translations": {
                                "ru": "Они провели весь день, пытаясь <w>подцепить</w> потерянную сеть со дна озера."
                            }
                        }
                    ],
                    "synonyms": [
                        "hook",
                        "retrieve"
                    ],
                    "common_phrases": [
                        "grapple up the cable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зацеплять и поднимать что-либо из-под воды или с глубины с помощью специального инструмента."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вылавливать",
                                "target_lang_sense_clarification": "кошкой с глубины"
                            },
                            {
                                "target_lang_word": "подцеплять",
                                "target_lang_sense_clarification": "крюком со дна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41ca126e-6a0b-3e84-ad80-63f9cafa9929",
                    "sense_definition": "To use a grapple tool to search for or attempt to catch something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "retrieval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The authorities spent several days <w>grappling</w> for illegal nets in the protected river.",
                            "target_lang_translations": {
                                "ru": "Власти провели несколько дней, <w>траля</w> заповедную реку в поисках незаконных сетей."
                            }
                        },
                        {
                            "text": "We were <w>grappling</w> for the anchor that had snapped off during the storm.",
                            "target_lang_translations": {
                                "ru": "Мы <w>искали кошкой</w> якорь, который оторвался во время шторма."
                            }
                        }
                    ],
                    "synonyms": [
                        "dredge",
                        "search"
                    ],
                    "common_phrases": [
                        "grapple for nets"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать кошку или багор для поиска или попытки поймать что-либо под водой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тралить",
                                "target_lang_sense_clarification": "искать кошкой на дне"
                            },
                            {
                                "target_lang_word": "прочесывать",
                                "target_lang_sense_clarification": "дно крюками"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5f40204f-440a-322b-9006-f460d943361f",
                    "sense_definition": "A close hand-to-hand struggle or fight.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_struggle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief was caught after a brief <w>grapple</w> with the store owner.",
                            "target_lang_translations": {
                                "ru": "Вор был пойман после короткой <w>схватки</w> с владельцем магазина."
                            }
                        },
                        {
                            "text": "The wrestling match ended in a fierce <w>grapple</w> that lasted several minutes.",
                            "target_lang_translations": {
                                "ru": "Борцовский поединок закончился яростной <w>борьбой</w>, длившейся несколько минут."
                            }
                        }
                    ],
                    "synonyms": [
                        "scuffle",
                        "struggle",
                        "tussle"
                    ],
                    "common_phrases": [
                        "brief grapple"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тесная рукопашная схватка или борьба."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схватка",
                                "target_lang_sense_clarification": "рукопашный бой"
                            },
                            {
                                "target_lang_word": "борьба",
                                "target_lang_sense_clarification": "физическое противостояние"
                            },
                            {
                                "target_lang_word": "потасовка",
                                "target_lang_sense_clarification": "небольшая драка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52dccb5c-3c91-3cf6-9613-82892f66b076",
                    "sense_definition": "A tool with claws or hooks used to catch, hold, or pull something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship used a heavy iron <w>grapple</w> to secure the enemy vessel before boarding.",
                            "target_lang_translations": {
                                "ru": "Корабль использовал тяжелую железную <w>кошку</w>, чтобы закрепить вражеское судно перед абордажем."
                            }
                        },
                        {
                            "text": "He threw the <w>grapple</w> over the wall to help the rest of the team climb up.",
                            "target_lang_translations": {
                                "ru": "Он забросил <w>крюк</w> на стену, чтобы помочь остальной команде подняться."
                            }
                        }
                    ],
                    "synonyms": [
                        "grapnel",
                        "grappling iron",
                        "hook"
                    ],
                    "common_phrases": [
                        "iron grapple"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент с когтями или крючьями, используемый для захвата, удержания или вытягивания чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кошка",
                                "target_lang_sense_clarification": "абордажный или альпинистский крюк"
                            },
                            {
                                "target_lang_word": "захват",
                                "target_lang_sense_clarification": "механическое устройство"
                            },
                            {
                                "target_lang_word": "багор",
                                "target_lang_sense_clarification": "крюк на шесте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efa2bb4c-b138-38c6-b286-eb814199fdd8",
                    "sense_definition": "A blend or combination of grape and apple flavors.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "flavors",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children enjoyed drinking the sweet <w>grapple</w> juice during the picnic.",
                            "target_lang_translations": {
                                "ru": "Детям понравилось пить сладкий <w>яблочно-виноградный</w> сок во время пикника."
                            }
                        },
                        {
                            "text": "She found a jar of <w>grapple</w> jelly on the top shelf of the pantry.",
                            "target_lang_translations": {
                                "ru": "Она нашла банку <w>виноградно-яблочного</w> желе на верхней полке кладовой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grapple juice",
                        "grapple jelly"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to describe flavor blends"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смесь или сочетание вкусов винограда и яблока."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "виноградно-яблочный вкус",
                                "target_lang_sense_clarification": "комбинированный аромат"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}