                        "entry_id": "007e5c08-e5c5-3ab2-a6b4-2a02b50f9f49",
                        "glosses": [
                            "A canopy, usually of glass, set as a shelter over a door opening onto a terrace or pavement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "123dd7ca-f744-4df2-8826-bf8efbcaf354",
                                "sense_id": "d5febf97-fbdd-300c-a5c6-07218a3831f9",
                                "text": "The house was a big elaborate limestone affair, evidently new. Winter sunshine sparkled on lace-hung casement, on glass marquise, and the burnished bronze foliations of grille and door."
                            }
                        ]
                    },
