                {
                    "sense_id": "d71591ab-e935-323f-af03-32304954b9ce",
                    "sense_definition": "A person who is always very kind and pleasant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is such a <w>sweetheart</w>: she never complains about me being late.",
                            "target_lang_translations": {
                                "ru": "Она такая <w>душка</w>: никогда не жалуется на то, что я опаздываю.",
                                "zh": "她真是个<w>大好人</w>，从不抱怨我迟到。"
                            }
                        },
                        {
                            "text": "He was a real <w>sweetheart</w> for helping me carry those heavy bags.",
                            "target_lang_translations": {
                                "ru": "Он был настоящей <w>душкой</w>, когда помог мне донести эти тяжелые сумки.",
                                "zh": "他真是个<w>好心人</w>，帮我提了那些沉重的袋子。"
                            }
                        }
                    ],
