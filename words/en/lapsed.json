{
    "word_family": [
        "lapse"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4bc4a22b-9c93-32ec-b848-699c7379d343",
                    "sense_definition": "No longer practicing a specific religion or having lost one's religious faith.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Although he was raised in a very strict home, he is now a <w>lapsed</w> Catholic.",
                            "target_lang_translations": {
                                "nl": "Hoewel hij heel streng is opgevoed, is hij nu een <w>afvallige</w> katholiek."
                            }
                        },
                        {
                            "text": "Many <w>lapsed</w> believers still celebrate traditional holidays with their families.",
                            "target_lang_translations": {
                                "nl": "Veel <w>niet-praktiserende</w> gelovigen vieren nog steeds traditionele feestdagen met hun familie."
                            }
                        }
                    ],
                    "synonyms": [
                        "nonpracticing"
                    ],
                    "antonyms": [
                        "practicing",
                        "devout"
                    ],
                    "common_phrases": [
                        "lapsed Catholic"
                    ],
                    "target_lang_definitions": {
                        "nl": "Niet langer een bepaalde godsdienst belijdend of het geloof hebbende verloren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "afvallig",
                                "target_lang_sense_clarification": "van geloof"
                            },
                            {
                                "target_lang_word": "niet-praktiserend",
                                "target_lang_sense_clarification": "geloof niet meer actief uitoefenend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92decd42-1cad-386e-b506-6ff1b51b1f05",
                    "sense_definition": "No longer following or supporting a secular belief, party, or practice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a <w>lapsed</w> member of the party, she rarely attended any of their rallies.",
                            "target_lang_translations": {
                                "nl": "Als <w>inactief</w> lid van de partij bezocht ze zelden hun bijeenkomsten."
                            }
                        },
                        {
                            "text": "He described himself as a <w>lapsed</w> vegetarian who occasionally ate seafood.",
                            "target_lang_translations": {
                                "nl": "Hij omschreef zichzelf als een <w>voormalig</w> vegetariër die af en toe zeevruchten at."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lapsed member"
                    ],
                    "target_lang_definitions": {
                        "nl": "Niet langer een seculiere overtuiging, partij of gewoonte volgend of aanhangend."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "voormalig",
                                "target_lang_sense_clarification": "vroeger lid of volger"
                            },
                            {
                                "target_lang_word": "inactief",
                                "target_lang_sense_clarification": "niet langer actief meedoend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a94d996-dc1f-326b-99c2-422b869e483a",
                    "sense_definition": "Having ceased, discontinued, or expired over time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cessation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company refused to honor the claim because it was made under a <w>lapsed</w> policy.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf weigerde de claim te honoreren omdat deze was ingediend onder een <w>vervallen</w> polis."
                            }
                        },
                        {
                            "text": "He tried to revive the <w>lapsed</w> tradition of holding an annual village fair.",
                            "target_lang_translations": {
                                "nl": "Hij probeerde de <w>in onbruik geraakte</w> traditie van een jaarlijkse dorpskermis nieuw leven in te blazen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lapsed policy",
                        "lapsed membership"
                    ],
                    "target_lang_definitions": {
                        "nl": "In de loop van de tijd gestopt, onderbroken of verlopen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verlopen",
                                "target_lang_sense_clarification": "geldigheid voorbij"
                            },
                            {
                                "target_lang_word": "vervallen",
                                "target_lang_sense_clarification": "niet langer van kracht"
                            },
                            {
                                "target_lang_word": "in onbruik geraakt",
                                "target_lang_sense_clarification": "van gewoontes en tradities"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "919aff31-4e4e-377c-ad7e-02ae56185638",
                    "sense_definition": "Having expired, terminated, or reverted to another authority because of non-renewal, non-claim, or the passage of time.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cessation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The property was treated as a <w>lapsed</w> claim and reverted to the local government.",
                            "target_lang_translations": {
                                "nl": "Het eigendom werd behandeld als een <w>vervallen</w> claim en viel terug aan de lokale overheid."
                            }
                        },
                        {
                            "text": "The rights were reassigned after remaining a <w>lapsed</w> legacy for over a century.",
                            "target_lang_translations": {
                                "nl": "De rechten werden opnieuw toegewezen nadat ze meer dan een eeuw een <w>vervallen</w> erfenis waren gebleven."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Wettelijk of officieel vervallen of teruggevallen aan een andere instantie door niet-verlenging of tijdverloop."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vervallen",
                                "target_lang_sense_clarification": "formeel of juridisch beëindigd"
                            },
                            {
                                "target_lang_word": "verjaard",
                                "target_lang_sense_clarification": "juridisch door tijdsverloop"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ce7872cc-e8c1-372e-abcb-aa90e96baef7",
                    "sense_definition": "simple past and past participle of <w>lapse</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After he forgot to pay the annual fee, his car insurance finally <w>lapsed</w>.",
                            "target_lang_translations": {
                                "nl": "Nadat hij vergat de jaarlijkse premie te betalen, <w>verviel</w> zijn autoverzekering uiteindelijk."
                            }
                        },
                        {
                            "text": "The room <w>lapsed</w> into complete silence as soon as the speaker stepped onto the stage.",
                            "target_lang_translations": {
                                "nl": "De zaal <w>verzonk</w> in volkomen stilte zodra de spreker het podium opstapte."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lapsed into silence"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "verleden tijd en voltooid deelwoord van lapse; verlopen, vervallen of vervallen in"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verviel",
                                "target_lang_sense_clarification": "verleden tijd van vervallen"
                            },
                            {
                                "target_lang_word": "verliep",
                                "target_lang_sense_clarification": "verleden tijd van verlopen"
                            },
                            {
                                "target_lang_word": "verzonk",
                                "target_lang_sense_clarification": "verleden tijd in 'lapsed into silence'"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}