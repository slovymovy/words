                "senses": [
                    {
                        "sense_id": "d9d81ee3-562f-3184-859e-fb813dd2f833",
                        "entry_id": "030049e5-863d-374d-9c28-d0076cff23a4",
                        "glosses": [
                            "deutsche Automarke des Herstellers Mercedes-Benz AG"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5fde2291-c920-3074-8963-6a208a776c1e",
                        "entry_id": "030049e5-863d-374d-9c28-d0076cff23a4",
                        "glosses": [
                            "Fahrzeug von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90778918-6a11-4001-b784-7e5cd4384014",
                                "sense_id": "5fde2291-c920-3074-8963-6a208a776c1e",
                                "text": "„Draußen rollte rechter Hand der silberne Mercedes in eine große, gut beleuchtete Garage, deren Tor sich schnell wieder hinter ihm schloss.“"
                            },
                            {
                                "example_id": "2f90e9c2-35d2-4ebc-9066-1a93a7adeb1c",
                                "sense_id": "5fde2291-c920-3074-8963-6a208a776c1e",
                                "text": "„Einzige Ausnahme ist ein schwarzer Mercedes mit drei Bronzesternen auf dem nummernlosen Kennzeichen und einer Flagge in einem kleinen Plastikschutz.“"
                            },
                            {
                                "example_id": "2511e007-7879-41c7-a961-ffd8bf43d556",
                                "sense_id": "5fde2291-c920-3074-8963-6a208a776c1e",
                                "text": "„Der Mercedes bremste vor einer großzügigen Granittreppe, die zum Präsidentenpalast hinaufführte.“"
                            },
                            {
                                "example_id": "efaa07db-8fa3-4269-a35c-d71c64b32d5b",
                                "sense_id": "5fde2291-c920-3074-8963-6a208a776c1e",
                                "text": "„Er war im Norden Bogotás in seinem von einem Chauffeur gesteuerten Mercedes unterwegs, als ihn sieben Kugeln aus einer Maschinenpistole trafen, die ein Ex-Strafgefangener von einem Motorrad aus auf ihn abfeuerte.“"
                            },
                            {
                                "example_id": "d60ad563-e1b2-4072-9ccf-c00f2609317e",
                                "sense_id": "5fde2291-c920-3074-8963-6a208a776c1e",
                                "text": "„Das war Jojo eines schönen Morgens auf der Fahrt durch Quezon City aufgefallen, und der Gedanke, dass er im Verkehrsgetümmel ein buntes Mosaik von Schnappschüssen zu sehen bekam, während sich die Leute auf der Straße mit ihrem eigenen Spiegelbild in den Scheiben des Mercedes begnügen mussten, hatte ihn auf Anhieb fasziniert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
