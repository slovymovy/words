                "senses": [
                    {
                        "sense_id": "3dc22349-462f-3271-a51c-71da6bcea986",
                        "entry_id": "2b289df8-9438-34d7-a286-87dfa0e47696",
                        "glosses": [
                            "hölzerner Trog, der unter anderem zum Kneten von Brotteigen, aber auch beim Schweineschlachten benutzt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae4320e0-dcdb-4af3-be45-122fbe9910e0",
                                "sense_id": "3dc22349-462f-3271-a51c-71da6bcea986",
                                "text": "Heutzutage sind echte alte Backtröge sehr teuer."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92003c4d-6809-4ba5-a739-ea1ffe838592",
                        "source_entry_id": "2b289df8-9438-34d7-a286-87dfa0e47696",
                        "source_sense_id": "3dc22349-462f-3271-a51c-71da6bcea986",
                        "source_sense_description": "Trog zum Kneten von Brotteigen",
                        "target_lang_word": "kneading trough",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kneading trough",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d0395f6-9e5d-38d9-8a4d-6325ec0830d1",
                                        "entry_id": "c695d6e9-e639-34de-87e1-5ff771c65a9d",
                                        "glosses": [
                                            "A (usually wooden) trough in which dough is kneaded before baking into bread."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f657fec2-437e-4d5e-92a3-c384e07eb15f",
                                                "sense_id": "9d0395f6-9e5d-38d9-8a4d-6325ec0830d1",
                                                "text": "And the people tooke their dough before it was leauened, their kneading troughes beeing bound vp in their clothes vpon their ſhoulders."
                                            },
                                            {
                                                "example_id": "cd488a43-ac5a-48a9-bd86-4105ea18df48",
                                                "sense_id": "9d0395f6-9e5d-38d9-8a4d-6325ec0830d1",
                                                "text": "I came to a room where I found nothing but an empty bed and a kneading-trough [translating Trog] with the lid fixed down."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90c3248b-233e-4b8c-83bf-2f8b602fe064",
                        "source_entry_id": "2b289df8-9438-34d7-a286-87dfa0e47696",
                        "source_sense_id": "3dc22349-462f-3271-a51c-71da6bcea986",
                        "source_sense_description": "Trog zum Kneten von Brotteigen",
                        "target_lang_word": "díže",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "díže",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "30156580-5f3c-354e-93e3-94cd31de4c2e",
                                        "entry_id": "a71c20bb-65ec-3317-8bf8-a656ab22d5a0",
                                        "glosses": [
                                            "dřevěná nádoba na míšení těsta"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99f870ea-8e3c-4d8d-8427-61e1d1e70d8f",
                                                "sense_id": "30156580-5f3c-354e-93e3-94cd31de4c2e",
                                                "text": "Chtěli se tedy sami přes řeku přeplavit. Ale nikdo jim nechtěl půjčit loďku. Byl tam však jakýsi pekař s díží. Povídá: „Já vám půjčim tu díži, můžete se v ní pustit na Dunaj, chcete-li.“ To řekl jen tak, aby je poškádlil. Jenže svatý rebe reb Šmelke se poškádlit nedal. Povídá: „Tak tedy dobře!“ Dal díži na vodu a s reb Mojšem Lejbel si stoupl do té díže. To se rozumí, že si v ní nesedli. Na to není v díži místa. Plavili se vestoje."
                                            },
                                            {
                                                "example_id": "c2cf37eb-6d6d-4ee8-88a5-8a67b7918e68",
                                                "sense_id": "30156580-5f3c-354e-93e3-94cd31de4c2e",
                                                "text": "Pluje milá díže s našimi světci, pluje mezi ledy, a jak se blíží druhé straně, tak tam rostou řady senzacechtivých Vídeňáků, kteří přihlížejí z břehu neobvyklému divadlu, statečně povykujíce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae1a90f5-7549-43c8-8ada-119e55173cb9",
                        "source_entry_id": "2b289df8-9438-34d7-a286-87dfa0e47696",
