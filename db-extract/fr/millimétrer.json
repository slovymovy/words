                ],
                "senses": [
                    {
                        "sense_id": "28cfe2e1-4a64-3500-bee2-f76d621f1585",
                        "entry_id": "9462e878-5acc-3584-9b7f-8093f16d7845",
                        "glosses": [
                            "Mesurer, ou préparer, au millimètre, avec une précision méticuleuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "955da77d-acb4-4303-98e7-89a25211a0cc",
                                "sense_id": "28cfe2e1-4a64-3500-bee2-f76d621f1585",
                                "text": "Jérôme découvrait les contraintes insensées d’un tournage de pub pour la télévision, cette implacable mécanique d’horlogerie qui, de l’écriture du premier story-board jusqu’au montage final, tenait d’une course contre la montre. Il fallait constamment faire et refaire, vérifier, calculer, millimétrer."
                            },
                            {
                                "example_id": "25df03dc-39cc-44d5-8fbd-9e2217ef0d9a",
                                "sense_id": "28cfe2e1-4a64-3500-bee2-f76d621f1585",
                                "text": "On poussait les chaufferies, on manœuvrait les fraises et les marteaux-pilons, on millimétrait les gorges et les pas de vis."
                            },
                            {
                                "example_id": "dfd11137-2fc4-46b1-b80a-6aff9f00b5ca",
                                "sense_id": "28cfe2e1-4a64-3500-bee2-f76d621f1585",
                                "text": "Le président du Mouvement pour la France (MPF) est soucieux de millimétrer sa parole. Pas question de heurter ses futurs alliés du comité de la majorité, […]"
                            }
                        ]
                    }
                ],
