                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "присоедини́в"
                    },
                    {
                        "form_id": "6f45dadd-0a6a-41a2-8e86-ebd448085cc2",
                        "entry_id": "276bd6ae-817b-3389-84a3-97b918190b1d",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "присоедини́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "290897a7-e96c-3504-b48f-6e6f359d781c",
                        "entry_id": "276bd6ae-817b-3389-84a3-97b918190b1d",
                        "glosses": [
                            "соединить, объединить с чем-либо, добавляя к чему-л."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "845ed1b5-5213-4f74-855b-ab8ce31e84a4",
                                "sense_id": "290897a7-e96c-3504-b48f-6e6f359d781c",
                                "text": "И Люба пишет: кроме отпуска, положенного для экзаменов, возьми ещё очередной отпуск, присоедини пару недель за свой счёт и приезжай в Ленинград на два месяца, я, Володя, и мои друзья подготовим тебя к экзаменам."
                            }
                        ]
                    },
                    {
                        "sense_id": "a79ad173-45b0-35bf-a796-c050d996be7d",
                        "entry_id": "276bd6ae-817b-3389-84a3-97b918190b1d",
                        "glosses": [
                            "включить в состав чего-л."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e659a5b-69dc-43cb-a28b-6aadfc9670e9",
                                "sense_id": "a79ad173-45b0-35bf-a796-c050d996be7d",
                                "text": "По морской линии в предках у него были: адмирал Сенявин, тот, который кильватерную колонну выдумал; адмирал Головнин, который кругосветку плавал, у японцев в плену сидел; адмирал Невельской, который присоединил незаконно Дальний Восток к Российской империи, за что был разжалован Нессельроде."
                            },
                            {
                                "example_id": "da85cbab-d1c0-473c-aba1-5c8e7cec2a30",
                                "sense_id": "a79ad173-45b0-35bf-a796-c050d996be7d",
                                "text": "В этом автобусе люди на полном серьёзе говорят о том, что Северодвинск вскоре могут присоединить к Москве и сделать его чем-то наподобие дополнительной её префектуры."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb262da6-8207-3c54-8bf6-1ca50a97b9e0",
                        "entry_id": "276bd6ae-817b-3389-84a3-97b918190b1d",
                        "glosses": [
                            "включить в число кого-л., причислить к кому-л"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad76db5a-0c11-4f9f-b7f1-bd7e182d868c",
                                "sense_id": "eb262da6-8207-3c54-8bf6-1ca50a97b9e0",
                                "text": "Сразу же утром, как только обнаружили налёт, немцы оцепили станцию, оцепили депо и задержали всех, кто работал ночью, а потом вообще арестовали всех деповских; произвели повальный обыск в домах железнодорожного посёлка, задержали подозрительных, присоединили к арестованным ― в общем, загребли человек сто, а может быть, и больше: пытались найти тех, кто помогал налёту, понимали, что без помощи деповских такой налёт невозможен, и помогал, конечно,не один, помогали многие, помогала организация ; таскали людей на допросы, мучили их и пытали, требуя выдачи участников и пособников."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7c4b589-bdc7-35ba-8f97-1f2d1aba8880",
                        "entry_id": "276bd6ae-817b-3389-84a3-97b918190b1d",
                        "glosses": [
                            "прикрепить, подключить (провода, шланги и т.п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfd65ac5-83f1-4232-b2c1-f2c50468c8c5",
                                "sense_id": "f7c4b589-bdc7-35ba-8f97-1f2d1aba8880",
                                "text": "Честно говоря, система у меня уже собрана, и остаётся только присоединить к ней кое-какие устройства камеры."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "322f933c-add9-4a48-9742-ecceb9fcffeb",
                        "source_entry_id": "276bd6ae-817b-3389-84a3-97b918190b1d",
