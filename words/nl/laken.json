                            },
                            {
                                "target_lang_word": "ручьи",
                                "target_lang_sense_clarification": "малые реки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "水道",
                                "target_lang_sense_clarification": "地理"
                            },
                            {
                                "target_lang_word": "溪流",
                                "target_lang_sense_clarification": "地理"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5ac815ad-a7ef-3cf2-aade-6643b3af5c0d",
                    "sense_definition": "Streng afkeuren of kritiek uiten op iemands gedrag of acties",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De commissie <w>laakte</w> het onprofessionele gedrag van de directeur.",
                            "target_lang_translations": {
                                "en": "The committee <w>censured</w> the director's unprofessional behavior.",
                                "ru": "Комиссия <w>осудила</w> непрофессиональное поведение директора.",
                                "zh": "委员会<w>谴责</w>了董事不专业的行为。"
                            }
                        },
                        {
                            "text": "Het is niet netjes om de inzet van anderen publiekelijk te <w>laken</w>.",
                            "target_lang_translations": {
                                "en": "It is not polite to publicly <w>criticize</w> the efforts of others.",
                                "ru": "Некрасиво публично <w>порицать</w> усилия других.",
                                "zh": "公开<w>指责</w>他人的付出是不礼貌的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "afkeuren",
                        "bekritiseren",
                        "veroordelen"
                    ],
                    "antonyms": [
                        "prijzen",
                        "loven"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To strictly disapprove of or express criticism of someone's behavior or actions",
                        "ru": "Строго осуждать или выражать критику в адрес чьего-либо поведения или действий",
                        "zh": "对某人的行为或举动表示严厉的反对或批评。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "censure",
                                "target_lang_sense_clarification": "formal criticism"
                            },
                            {
                                "target_lang_word": "condemn",
                                "target_lang_sense_clarification": "strong disapproval"
                            },
                            {
                                "target_lang_word": "rebuke",
                                "target_lang_sense_clarification": "reprimand"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "порицать",
                                "target_lang_sense_clarification": "формально критиковать"
                            },
                            {
                                "target_lang_word": "осуждать",
                                "target_lang_sense_clarification": "выражать неодобрение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "谴责",
                                "target_lang_sense_clarification": "正式批评"
                            },
                            {
                                "target_lang_word": "指责",
                                "target_lang_sense_clarification": "表示不满"
                            }
                        ]
                    }
                }
            ]
