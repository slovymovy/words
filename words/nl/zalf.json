{
    "word_family": [
        "zalven",
        "zalfje",
        "gezalfd",
        "zalving"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "650f88e6-2d19-3055-b28a-dd958b8e7b99",
                    "sense_definition": "Een smeerbare substantie die op de huid wordt aangebracht voor medische of verzorgende doeleinden.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medische verzorging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dokter adviseerde om deze <w>zalf</w> twee keer per dag op de wond te smeren.",
                            "target_lang_translations": {
                                "en": "The doctor advised to rub this <w>ointment</w> onto the wound twice a day."
                            }
                        },
                        {
                            "text": "Je moet een verzachtende <w>zalf</w> gebruiken om de irritatie van de huid te verminderen.",
                            "target_lang_translations": {
                                "en": "You should use a soothing <w>salve</w> to reduce the skin irritation."
                            }
                        }
                    ],
                    "common_phrases": [
                        "verzachtende zalf",
                        "zalf smeren"
                    ],
                    "target_lang_definitions": {
                        "en": "A spreadable substance applied to the skin for medical or care purposes."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ointment",
                                "target_lang_sense_clarification": "medical cream"
                            },
                            {
                                "target_lang_word": "salve",
                                "target_lang_sense_clarification": "healing or soothing ointment"
                            },
                            {
                                "target_lang_word": "cream",
                                "target_lang_sense_clarification": "general skin care substance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48a2361f-817e-31bf-afee-3edcd8047090",
                    "sense_definition": "Een welriekend olieachtig smeersel dat wordt gebruikt bij religieuze of ceremoniële plechtigheden.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de kroning werd de nieuwe koning ingewijd met een heilige <w>zalf</w>.",
                            "target_lang_translations": {
                                "en": "During the coronation, the new king was consecrated with a holy <w>ointment</w>."
                            }
                        },
                        {
                            "text": "De priester bereidde de <w>zalf</w> voor op de ceremoniële handeling in de kerk.",
                            "target_lang_translations": {
                                "en": "The priest prepared the <w>chrism</w> for the ceremonial act in the church."
                            }
                        }
                    ],
                    "common_phrases": [
                        "heilige zalf"
                    ],
                    "target_lang_definitions": {
                        "en": "A fragrant oily substance used in religious or ceremonial rites."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ointment",
                                "target_lang_sense_clarification": "ceremonial oil"
                            },
                            {
                                "target_lang_word": "chrism",
                                "target_lang_sense_clarification": "consecrated oil used in baptism or coronation"
                            },
                            {
                                "target_lang_word": "balm",
                                "target_lang_sense_clarification": "aromatic resinous substance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5085ba7e-6ec4-3365-b755-b04c9e49cfdb",
                    "sense_definition": "Een informele benaming voor mayonaise.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "voedsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doe mij maar een flinke klodder <w>zalf</w> bij mijn frietjes.",
                            "target_lang_translations": {
                                "en": "Give me a big dollop of <w>mayo</w> with my fries."
                            }
                        },
                        {
                            "text": "In sommige regio's noemen ze mayonaise gekscherend een witte <w>zalf</w>.",
                            "target_lang_translations": {
                                "en": "In some regions, they jokingly call mayonnaise a white <w>sauce</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "mayo",
                        "mayonaise"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informeel gebruikt voor mayonaise"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An informal name for mayonnaise."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mayo",
                                "target_lang_sense_clarification": "slang for mayonnaise"
                            },
                            {
                                "target_lang_word": "white sauce",
                                "target_lang_sense_clarification": "humorous reference to mayonnaise"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "92d6b627-c5ef-3249-8da0-99eb9ce0f378",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>zalven</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>zalf</w> de droge plekken op mijn armen elke ochtend met een crème.",
                            "target_lang_translations": {
                                "en": "I <w>anoint</w> the dry spots on my arms every morning with a cream."
                            }
                        },
                        {
                            "text": "Wanneer ik de patiënt help, <w>zalf</w> ik de huid heel voorzichtig.",
                            "target_lang_translations": {
                                "en": "When I help the patient, I <w>apply ointment</w> to the skin very carefully."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present indicative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first-person singular present tense of 'to anoint' or 'to apply ointment'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "anoint",
                                "target_lang_sense_clarification": "to apply oil or ointment"
                            },
                            {
                                "target_lang_word": "salve",
                                "target_lang_sense_clarification": "to apply a healing substance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ebe510e-2d39-3e9d-afb1-0e3f1791b884",
                    "sense_definition": "De gebiedende wijs van <w>zalven</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Zalf</w> de wond onmiddellijk nadat je deze hebt schoongemaakt met water.",
                            "target_lang_translations": {
                                "en": "<w>Salve</w> the wound immediately after you have cleaned it with water."
                            }
                        },
                        {
                            "text": "Als de huid rood wordt, <w>zalf</w> dan direct met de voorgeschreven medicatie.",
                            "target_lang_translations": {
                                "en": "If the skin turns red, <w>apply ointment</w> immediately with the prescribed medication."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The imperative form of 'to anoint' or 'to apply ointment'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "anoint",
                                "target_lang_sense_clarification": "command to apply oil"
                            },
                            {
                                "target_lang_word": "apply ointment",
                                "target_lang_sense_clarification": "command to put on cream"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}