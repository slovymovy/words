                        "examples": [
                            {
                                "example_id": "4068de85-5edf-4551-a424-83ff8eb06ea2",
                                "sense_id": "75a38dbb-5c84-313e-a19e-d8122e6805cf",
                                "text": "„Der Heimatstab Ausland in Kiel, Roonstraße 8, beziehungsweise ab August 1944 in Laboe, Kurhaus, koordinierte sämtliche Briefpost durch Blockadebrecher und U-Boote, den Kameradschaftsfunk der Kriegsmarine und die Rundfunkzusprüche.“"
                            },
                            {
                                "example_id": "ed5b32bb-c1d7-4bc7-8645-d658985faded",
                                "sense_id": "75a38dbb-5c84-313e-a19e-d8122e6805cf",
                                "text": "„Während der ganzen Zeit des Betriebes der Schantungbahn bis zur Stillegung infolge der Belagerung durch die Japaner waren die Bahnpostbeamten beauftragt auch von Stationen ohne deutsche Post Briefpost und Einschreiben anzunehmen.“"
                            }
                        ],
