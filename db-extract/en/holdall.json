                                        "entry_id": "167b1577-d741-3cea-91ae-8031fb57da7d",
                                        "glosses": [
                                            "сокр. от вещевой мешок; армейский заплечный мешок из прочной ткани для транспортировки личных вещей и инвентаря"
                                        ],
