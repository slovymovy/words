                "forms": [],
                "senses": [
                    {
                        "sense_id": "d2da14a5-0789-3a04-88a8-fff8565fc51b",
                        "entry_id": "414c9f5e-bdd5-3bcf-b453-9e150d8adc51",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4dee2f4-350e-453a-99cc-675e84d9d6b6",
                                "sense_id": "d2da14a5-0789-3a04-88a8-fff8565fc51b",
                                "text": "Quand j'ai couru chanter ma petite chanson pour Marinette\nLa belle, la traîtresse était allée à l'opéra\nAvec ma petite chanson, j'avais l'air d'un con, ma mère\nAvec ma petite chanson, j'avais l'air d'un con."
                            },
                            {
                                "example_id": "2d5f7145-af0d-4dcf-a5a3-8ea2ae62a6b7",
                                "sense_id": "d2da14a5-0789-3a04-88a8-fff8565fc51b",
                                "text": "Cent douze sélections chez les Bleues, entre 1994 et 2006, et 81 buts marqués, le CV de Marinette Pichon est costaud."
                            }
                        ]
                    },
                    {
                        "sense_id": "b288bdc5-5c0f-3dcf-b425-38f9d416f1d3",
                        "entry_id": "414c9f5e-bdd5-3bcf-b453-9e150d8adc51",
                        "glosses": [
                            "Diminutif affectueux pour différents prénoms féminins similaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "969a119d-5e0a-48c8-a2b1-826f3d3dc06b",
                                "sense_id": "b288bdc5-5c0f-3dcf-b425-38f9d416f1d3",
                                "text": "Je n’oublierai jamais l’étonnement que me causa ta sœur, Marie-Louise, que vous appeliez Marinette, ton aînée d’un an et qui avait l’air d'être ta cadette […]"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
