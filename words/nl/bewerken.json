                    "sense_definition": "iemand proberen te overtuigen of beïnvloeden om van mening te veranderen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beïnvloeding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politicus probeerde de studenten urenlang te <w>bewerken</w> voor zijn plannen.",
                            "target_lang_translations": {
                                "en": "The politician tried to <w>work on</w> the students for hours to support his plans."
                            }
                        },
                        {
                            "text": "Zij probeerde haar <w>mening bewerken</w> door constant op de voordelen te wijzen.",
                            "target_lang_translations": {
                                "en": "She tried to <w>influence her opinion</w> by constantly pointing out the benefits."
                            }
