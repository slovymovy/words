                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "20378df1-1cf3-4568-9445-38c50aecfcb3",
                        "source_entry_id": "a5f3f1ea-bbe0-32b1-bd32-1473135187bb",
                        "source_sense_id": "1538c1c1-7537-3cc0-a959-4f66049434b5",
                        "target_lang_word": "go berserk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "go berserk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fec93d26-ed37-39a2-88e0-2cb477a62937",
                                        "entry_id": "72bf3f3c-00e4-37e5-b57f-45f6f88e1cce",
                                        "glosses": [
                                            "To enter a wild and uncontrollable state."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc94ba22-e2eb-479d-a45a-584cb7ebd294",
                                                "sense_id": "fec93d26-ed37-39a2-88e0-2cb477a62937",
                                                "text": "The fans immediately went berserk as the singer walked onstage."
                                            },
                                            {
                                                "example_id": "4cbd47f1-1506-41c1-beeb-ba98ba72244f",
                                                "sense_id": "fec93d26-ed37-39a2-88e0-2cb477a62937",
                                                "text": "I watched the game in New York City's unofficial Redskins bar. When the game ended, we went berserk, performing a celebratory Fun Bunch and singing \"Hail to the Redskins!\""
                                            },
                                            {
                                                "example_id": "1ccf46d7-90d1-46b2-a0d9-99cbb6f54eee",
                                                "sense_id": "fec93d26-ed37-39a2-88e0-2cb477a62937",
                                                "text": "If someone sneaks my lunch again, I'm actually going to go berserk."
                                            },
                                            {
                                                "example_id": "b9f89ced-24be-4320-a75e-f343e6905b66",
                                                "sense_id": "fec93d26-ed37-39a2-88e0-2cb477a62937",
                                                "text": "Let's say I touch my own hand with my finger. My brain can perceive that signal and then cancel it out. But Novichok makes it not get cancelled out, so it feels like I'm touching my own hand a million times a second, and every cell in my body goes berserk, and the brain understands that this is the end."
                                            },
                                            {
                                                "example_id": "838c1446-a272-482f-ad7e-ca02c6edddca",
                                                "sense_id": "fec93d26-ed37-39a2-88e0-2cb477a62937",
                                                "text": "As we exited the observatory's parking lot, the truck's computer monitor started bleeping angrily. Before we reached the main road, we picked up 13 wireless signals. Within a half mile, we found 66 signals. Niday's gadgetry was going berserk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
