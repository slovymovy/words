                "senses": [
                    {
                        "sense_id": "2de86b80-031a-3f21-8fe1-4cf5354f4283",
                        "entry_id": "7f72b17a-bbbb-3a8f-bcc7-06bb4963d5ee",
                        "glosses": [
                            "Isoler un territoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28b8f6b3-a01c-4e59-a6b6-8ff12b92d481",
                                "sense_id": "2de86b80-031a-3f21-8fe1-4cf5354f4283",
                                "text": "Maintenant, le risque est grand, de nous voir bantoustaniser, d’être ceux à qui on jette les miettes de décisions qu’on a été contraint de prendre à notre place."
                            },
                            {
                                "example_id": "05144ca8-a632-4559-b19a-5f4c96498cdd",
                                "sense_id": "2de86b80-031a-3f21-8fe1-4cf5354f4283",
                                "text": "Israël, avec le soutien total et indéfectible des Etats-Unis, s’est entêté à bantoustaniser les territoires palestiniens"
                            }
                        ]
                    }
