                "senses": [
                    {
                        "sense_id": "84d769a2-ff52-394e-ae70-0d4b6fcb7b8f",
                        "entry_id": "6472d8fa-0174-302d-ba22-e97f2daacf6f",
                        "glosses": [
                            "Ausflug, Reise mit dem Fahrrad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c265f80-a6e2-43ae-8b19-a19b84b729a3",
                                "sense_id": "84d769a2-ff52-394e-ae70-0d4b6fcb7b8f",
                                "text": "Heute haben wir eine gemütliche Radtour zu einem idyllischen Biergarten unternommen."
                            },
                            {
                                "example_id": "7681e611-dd1d-4930-8559-f0337ebddbb9",
                                "sense_id": "84d769a2-ff52-394e-ae70-0d4b6fcb7b8f",
                                "text": "„Die Mutigen wagten eine Radtour entlang der Saale.“"
                            },
                            {
                                "example_id": "03ca9ac3-ca1c-4111-a7df-fde71cd613e1",
                                "sense_id": "84d769a2-ff52-394e-ae70-0d4b6fcb7b8f",
                                "text": "„Der Leser findet Anregungen für Wandern, Bergsteigen, Radtouren, Malen, Reiten, Golf, Motorfliegen, Segeln, Wasserski, Paddeln, Angeln, Sprachkurse, Kochen und Photographieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
