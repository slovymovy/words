                                            "собир. режиссёры"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "673ec55e-600b-4729-9f2e-fdd18502cdd1",
                                                "sense_id": "7c32d15f-196a-38b9-9562-4303f2673e75",
                                                "text": "Отсюда, кстати, и спорность тезиса про аудиторию «новой драмы», якобы ограниченную профессиональной публикой (критика, режиссура, продюсеры, актеры, студенты театральных вузов)."
                                            }
                                        ]
                                    }
