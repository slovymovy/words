                "translations": [
                    {
                        "translation_id": "37eb4439-94d3-49d6-9085-d2d3f6f89998",
                        "source_entry_id": "56348806-3f52-3b2a-ad17-f69ac713051d",
                        "source_sense_id": "133ef80f-3c94-3cc0-b3d8-221455002164",
                        "source_sense_description": "een rang onder de onderofficieren",
                        "target_lang_word": "Feldwebel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feldwebel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4fbde247-1e30-375d-b6e5-489be4ca5a2a",
                                        "entry_id": "78007df7-0b09-3ba8-bf44-5bdb96cd8098",
                                        "glosses": [
                                            "Unteroffiziersdienstgrad"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62f7d20f-1140-41e3-b0b5-40371d125648",
                                                "sense_id": "4fbde247-1e30-375d-b6e5-489be4ca5a2a",
                                                "text": "„Ihr Vater war dort als Feldwebel der Luftwaffe stationiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1e869a01-b627-3d20-83c5-02f29e97df7f",
                                        "entry_id": "78007df7-0b09-3ba8-bf44-5bdb96cd8098",
                                        "glosses": [
                                            "Unteroffiziersdienstgrad",
                                            "zwischen dem Stabsunteroffizier und Oberfeldwebel"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "5c16879d-4b67-318e-8c42-14a5ff4365d0",
                                        "entry_id": "78007df7-0b09-3ba8-bf44-5bdb96cd8098",
                                        "glosses": [
                                            "Unteroffiziersdienstgrad",
                                            "zwischen dem Unterfeldwebel und dem Oberfeldwebel"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "04c5117d-00d0-3ea0-a229-a95ae1f1d2d1",
                                        "entry_id": "78007df7-0b09-3ba8-bf44-5bdb96cd8098",
                                        "glosses": [
                                            "Unteroffizier im Range eines Feldwebels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f40d0f6-7fe9-4cdc-b92d-a2c3a9c176a9",
                                                "sense_id": "04c5117d-00d0-3ea0-a229-a95ae1f1d2d1",
                                                "text": "„An der Spitze der Kolonne trabt der dicke Feldwebel.“"
                                            },
                                            {
                                                "example_id": "526218db-8294-4150-8819-24f47b3d2bcd",
                                                "sense_id": "04c5117d-00d0-3ea0-a229-a95ae1f1d2d1",
                                                "text": "„Fabian kam mit dem Feldwebel und setzte sich dazu.“"
                                            },
                                            {
                                                "example_id": "cc885d1a-bf71-4ef8-98ac-c1d1cdd7a41e",
                                                "sense_id": "04c5117d-00d0-3ea0-a229-a95ae1f1d2d1",
                                                "text": "„Dieser Reisende heißt Wagner und ist ein ehemaliger Feldwebel von den Zweiundfünfzigern, die vor dem Kriege in Cottbus kaserniert waren.“"
                                            },
                                            {
                                                "example_id": "84e9cad1-85ba-4743-8207-0801c1c157c8",
                                                "sense_id": "04c5117d-00d0-3ea0-a229-a95ae1f1d2d1",
                                                "text": "„Ein deutscher Feldwebel stand draußen – und neben ihm zwei Riesenkerle in Uniformen des SD.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b1b00ec0-03b3-38bb-b19e-f3e2feea59d0",
                                        "entry_id": "78007df7-0b09-3ba8-bf44-5bdb96cd8098",
                                        "glosses": [
                                            "große Schaumkrone auf einem Bier"
                                        ],
                                        "tags": [
                                            "humorous",
                                            "regional"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1a40f207-36ef-32a1-8da6-976a6af7545b",
                                        "entry_id": "78007df7-0b09-3ba8-bf44-5bdb96cd8098",
                                        "glosses": [
                                            "energisch auftretende Frau"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c414372c-ea75-47bd-86fc-c4af962c724a",
                                                "sense_id": "1a40f207-36ef-32a1-8da6-976a6af7545b",
                                                "text": "Sie ist schon ein Feldwebel!"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
