                                    {
                                        "sense_id": "eee5f207-3491-3d34-ba07-6d89ff2c5fea",
                                        "entry_id": "e3f01fa4-8e3e-344e-879a-6f254f637381",
                                        "glosses": [
                                            "A ceremonial pointed knife or dagger, used especially in Wicca and other neopagan traditions and typically having a black handle with magical symbols on it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a16aed2-6640-4b14-97ab-40b6796c26ae",
                                                "sense_id": "eee5f207-3491-3d34-ba07-6d89ff2c5fea",
                                                "text": "She is moving with a regal gait, grasping the arthame, or magic knife."
                                            },
                                            {
                                                "example_id": "a6d3365b-0546-42e9-bcdf-d0d2dae969db",
                                                "sense_id": "eee5f207-3491-3d34-ba07-6d89ff2c5fea",
                                                "text": "Agia was quicker, making a cut at my neck with an athame before his weapon was free of the scabbard."
                                            },
                                            {
                                                "example_id": "a390df02-6af1-48fa-a4d6-f622ce5a3320",
                                                "sense_id": "eee5f207-3491-3d34-ba07-6d89ff2c5fea",
                                                "text": "The athame is a black-handled ritual knife—one of the most common distinguishing marks of the Neopagan Witch."
                                            },
                                            {
                                                "example_id": "a8b34de1-bb95-4b75-816e-e4049f39bc6a",
                                                "sense_id": "eee5f207-3491-3d34-ba07-6d89ff2c5fea",
                                                "text": "Tradition says an athame should never have drawn blood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
