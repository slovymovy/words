                    "frequency": "Middle",
                    "semantic_group_id": "repartition_temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La banque lui a proposé d'<w>étaler</w> le remboursement de son prêt sur plusieurs années."
