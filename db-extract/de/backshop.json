                        "glosses": [
                            "Laden, in dem man Backwaren kaufen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "722fab05-aee8-4dc2-9e7d-67af2081c1bc",
                                "sense_id": "9a4f6b26-bc60-3728-8726-6afcfdcb1afe",
                                "text": "Geh in den Backshop und kaufe fünf Brötchen!"
                            },
                            {
                                "example_id": "c7a5dc42-4aba-4001-a3c6-6d8a2ac9a787",
                                "sense_id": "9a4f6b26-bc60-3728-8726-6afcfdcb1afe",
                                "text": "Der Backshop ist gleich um die Ecke!"
                            },
                            {
                                "example_id": "1230356e-7e61-4e92-8406-b385c254ff30",
                                "sense_id": "9a4f6b26-bc60-3728-8726-6afcfdcb1afe",
                                "text": "Mein Vater verkauft Backwaren in seinem Backshop."
                            },
                            {
                                "example_id": "f4e6ad72-308b-4634-b536-0350ed977e35",
                                "sense_id": "9a4f6b26-bc60-3728-8726-6afcfdcb1afe",
                                "text": "Das Schild des Backshops ist gelb."
                            }
                        ],
                        "sense_index_json": "\"1\""
