                        "form": "dem Vegetarismus"
                    },
                    {
                        "form_id": "5a7900f0-8c4e-46b8-9f85-e19b3f0350e8",
                        "entry_id": "b18b012d-b537-3bc1-9cf3-1b1ddc9dccd9",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Vegetarismus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "72c23986-db99-31a1-8ad3-38e9cce5e004",
                        "entry_id": "b18b012d-b537-3bc1-9cf3-1b1ddc9dccd9",
                        "glosses": [
                            "Ernährungseinstellung, die einen Verzicht auf Fleisch und Fisch sowie gegebenenfalls weiterer tierischer Produkte bedingt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cebb0fdc-7684-48ca-b821-b25efa88fda7",
                                "sense_id": "72c23986-db99-31a1-8ad3-38e9cce5e004",
                                "text": "In Indien ist Vegetarismus sehr verbreitet."
                            },
                            {
                                "example_id": "524eb7c0-6fcd-4652-bc4e-13e855590b55",
                                "sense_id": "72c23986-db99-31a1-8ad3-38e9cce5e004",
                                "text": "„Es gab 1974 wesentlich mehr Vegetarier oder dem gelegentlichen Vegetarismus nicht abgeneigte Menschen, als er kannte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f64d8205-c1df-4a0a-9b34-e0496a8d4b4a",
                        "source_entry_id": "b18b012d-b537-3bc1-9cf3-1b1ddc9dccd9",
                        "source_sense_id": "72c23986-db99-31a1-8ad3-38e9cce5e004",
                        "target_lang_word": "vegetarianism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vegetarianism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4985df59-d7cf-3ded-b734-a9b44a50c99e",
                                        "entry_id": "e588b1a6-f1be-32cc-9ae7-be2c7e83f49c",
                                        "glosses": [
                                            "The practice of following a vegetarian diet."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5e54cfa-a82c-4dcd-b66a-e56e2c81fd39",
                                                "sense_id": "4985df59-d7cf-3ded-b734-a9b44a50c99e",
                                                "text": "Vegetarianism, he said, is an idea “that has three things going for it all at once—economics, health and compassion.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c84a1e63-0772-4a66-9ab5-a19ed70bf6d5",
                        "source_entry_id": "b18b012d-b537-3bc1-9cf3-1b1ddc9dccd9",
                        "source_sense_id": "72c23986-db99-31a1-8ad3-38e9cce5e004",
                        "target_lang_word": "végétarisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "végétarisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d11259ae-09dd-3651-befe-dbeb4c94268b",
                                        "entry_id": "14ab84c2-5522-30ba-9462-24ebecaea7db",
                                        "glosses": [
                                            "Système d’alimentation ne consommant pas les viandes et toute chair animale : poisson, fruits de mer, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23dcf271-e60b-41d2-80c5-9deae21c010b",
                                                "sense_id": "d11259ae-09dd-3651-befe-dbeb4c94268b",
                                                "text": "Comment se pose la question du végétarisme, du crudivorisme et de la macrobiotique pour les informateurs de la deuxième génération, c'est-à-dire ceux qui ont suivi un régime non carné ou macrobiotique pendant leur enfance ou dès leur naissance, […]."
                                            },
                                            {
                                                "example_id": "07c5325f-508b-4e9e-acb9-978c5a84bc59",
                                                "sense_id": "d11259ae-09dd-3651-befe-dbeb4c94268b",
                                                "text": "Dans une Inde gouvernée depuis 2014 par les nationalistes du BJP sous la houlette du Premier ministre Narendra Modi, l'idéologie du végétarisme –symbole de l'hindouisme pur– n'a rien d'étonnant et prend des formes violentes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a13606e-a46c-4ec6-85d7-3eda24ce39f0",
                        "source_entry_id": "b18b012d-b537-3bc1-9cf3-1b1ddc9dccd9",
                        "source_sense_id": "72c23986-db99-31a1-8ad3-38e9cce5e004",
                        "target_lang_word": "wegetarianizm",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wegetarianizm",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "bacc8164-9596-31dc-a90a-c08e1eceaffa",
                                        "entry_id": "1a353a0f-3417-331e-b398-4ecd2e799a3f",
                                        "glosses": [
                                            "sposób odżywiania się charakteryzujący się wyłączeniem z posiłków produktów mięsnych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e67db70-89e0-4690-b0c2-a3e313bb68f8",
                                                "sense_id": "bacc8164-9596-31dc-a90a-c08e1eceaffa",
                                                "text": "Badania naukowców z uniwersytetu w Southampton wykazały, że inteligentniejsze dzieci częściej decydują się na wegetarianizm w wieku dorosłym"
                                            },
                                            {
                                                "example_id": "b2b55098-f864-45e5-b0c0-b2f9c589d016",
                                                "sense_id": "bacc8164-9596-31dc-a90a-c08e1eceaffa",
                                                "text": "Sikhizm (…) również popiera prawa zwierząt i wegetarianizm. Guru Nanak uważał jedzenie mięsa za coś niewłaściwego, szczególnie dla tych, którzy podejmują medytację"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7a51b72-f1e4-481c-96f4-50fa08b0d561",
                        "source_entry_id": "b18b012d-b537-3bc1-9cf3-1b1ddc9dccd9",
                        "source_sense_id": "72c23986-db99-31a1-8ad3-38e9cce5e004",
                        "target_lang_word": "вегетарианство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вегетарианство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3be010ae-fa1c-3411-a3e9-ef1943d503c6",
                                        "entry_id": "fe1d31a5-969a-3124-93dd-8365a381e14b",
                                        "glosses": [
                                            "образ жизни, характеризующийся, в первую очередь, питанием, исключающим употребление мяса любых животных"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56e345b5-4216-4b0e-b546-0e7cdb8ecd6c",
                                                "sense_id": "3be010ae-fa1c-3411-a3e9-ef1943d503c6",
                                                "text": "«Вегетарианство ― первая ступень, на которую должен стать всякий человек, желающий начать новую, более чистую и осмысленную жизнь». 〈…〉 \"Лев Николаевич, ― говорю я, ― противники вегетарианства не хотят признавать этого, они бросают нам упрёки в том, что мы не достигаем своего идеала, что отказываемся от мясоедения, а между тем употребляем животные продукты в виде обуви и пр."
                                            },
                                            {
                                                "example_id": "40481828-21f4-4fd0-8024-b34d1260ddfa",
                                                "sense_id": "3be010ae-fa1c-3411-a3e9-ef1943d503c6",
                                                "text": "Он, не стесняясь, за обедом осуждал своего отца, говоря, что старик выжил из ума и всё его вегетарианство ― притворство, что он (когда никто не видит и не узнает) готов есть мясо."
                                            },
                                            {
                                                "example_id": "87525565-fb4e-4ccc-9015-b480c3e99d1c",
                                                "sense_id": "3be010ae-fa1c-3411-a3e9-ef1943d503c6",
                                                "text": "Многие, а в частности Ошо, утверждают что вегетарианство позволяет сделать дух лёгким и достичь быстрее аннутары-самьяк самбодхи."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a45f73a-56ca-4eb6-86f4-d7604cebc16a",
                        "source_entry_id": "b18b012d-b537-3bc1-9cf3-1b1ddc9dccd9",
                        "source_sense_id": "72c23986-db99-31a1-8ad3-38e9cce5e004",
