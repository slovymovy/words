    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e1c7c08c-a98a-3dcb-ab9d-4ca1ca620f5f",
                    "sense_definition": "Perdre l'équilibre de façon involontaire sur une surface lisse, humide ou glacée.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Faites très attention en marchant sur ce trottoir humide, vous pourriez <w>glisser</w>."
                        },
                        {
                            "text": "L'enfant a <w>glissé</w> sur le carrelage mouillé de la cuisine et est tombé."
                        }
                    ],
                    "synonyms": [
                        "déraper"
                    ],
                    "antonyms": [
                        "accrocher"
                    ],
                    "common_phrases": [
                        "glisser sur le verglas",
                        "glisser sur une plaque de verglas"
                    ]
                },
                {
                    "sense_id": "2c02ff2d-215b-3ee6-b20d-9bf2e902651d",
                    "sense_definition": "Se déplacer d'un mouvement continu et sans secousse sur une surface lisse.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les patineurs aiment <w>glisser</w> rapidement sur la glace de la patinoire."
                        },
                        {
                            "text": "La barque semblait <w>glisser</w> doucement sur les eaux calmes du lac."
                        }
                    ],
                    "synonyms": [
                        "coulisser",
                        "patiner"
                    ],
                    "antonyms": [
                        "buter"
                    ],
                    "common_phrases": [
                        "glisser sur la neige",
                        "glisser sur la glace"
                    ]
                },
                {
                    "sense_id": "418799f7-8cc3-3d66-929d-b237931f7777",
                    "sense_definition": "Introduire ou insérer adroitement et discrètement quelque chose quelque part.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "insertion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a discrètement <w>glissé</w> la lettre dans la poche de son manteau."
                        },
                        {
                            "text": "Le facteur a <w>glissé</w> le courrier important sous la porte d'entrée."
