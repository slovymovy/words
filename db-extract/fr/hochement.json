                        ],
                        "form": "hochements"
                    },
                    {
                        "form_id": "36cc629a-b2ff-4e12-a5b7-776c7b7f3093",
                        "entry_id": "6a9dcfc1-f614-38b8-9353-1a61f8b0a9b4",
                        "tags": [
                            "singular",
                            "plural"
                        ],
                        "form": "^((h aspiré))\\ɔʃ.mɑ̃\\"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5634d82e-c369-3d54-a1f1-c6be49b6ba75",
                        "entry_id": "6a9dcfc1-f614-38b8-9353-1a61f8b0a9b4",
                        "glosses": [
                            "Action de hocher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e353d97-7a72-49c7-af70-04522d9af6c8",
                                "sense_id": "5634d82e-c369-3d54-a1f1-c6be49b6ba75",
                                "text": "Je répondis : « Très volontiers !… » Mais déjà j’accompagnai mon approbation de ce hochement de tête condescendant que j’avais vu sur une photographie à la reine d’Angleterre relevant la vieille épouse du ministre des Transports qui lui faisait gauchement la révérence."
                            },
                            {
                                "example_id": "4884b623-9325-4d57-a726-3af30fcd564a",
                                "sense_id": "5634d82e-c369-3d54-a1f1-c6be49b6ba75",
                                "text": "On l’écoutera avec des hochements de tête : les Cantalous constituent vraiment une race à part — car, bien entendu, le porteur d’eau à la triche ne peut être que cantalou."
                            },
                            {
                                "example_id": "2259bb76-1af2-456d-b2d8-c981c7fab60d",
                                "sense_id": "5634d82e-c369-3d54-a1f1-c6be49b6ba75",
                                "text": "Chose dont il me gratifiait souvent d’un léger hochement de la tête."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e61933c-7df0-4c4f-bf71-385c7ba9c574",
                        "source_entry_id": "6a9dcfc1-f614-38b8-9353-1a61f8b0a9b4",
                        "source_sense_id": "5634d82e-c369-3d54-a1f1-c6be49b6ba75",
                        "target_lang_word": "nod",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nod",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9faf1c2-6a7e-310d-9548-7aeb474b1bf4",
                                        "entry_id": "e90ca759-53ad-3313-8b61-92c12ee23465",
                                        "glosses": [
                                            "To incline the head up and down, as to indicate agreement."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6979921e-9a5a-38b5-81c7-6508db361063",
                                        "entry_id": "e90ca759-53ad-3313-8b61-92c12ee23465",
                                        "glosses": [
                                            "To briefly incline the head downwards as a cursory greeting."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c0640c3-68d7-340e-a635-079299dfc0d8",
                                        "entry_id": "e90ca759-53ad-3313-8b61-92c12ee23465",
                                        "glosses": [
                                            "To sway, move up and down."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc185764-fcc0-41ee-8324-c39f97f62366",
                                                "sense_id": "3c0640c3-68d7-340e-a635-079299dfc0d8",
                                                "text": "By every wind that nods the mountain pine."
                                            },
                                            {
                                                "example_id": "07562fee-907f-4ff8-a5f4-4d60403d1bb2",
                                                "sense_id": "3c0640c3-68d7-340e-a635-079299dfc0d8",
                                                "text": "Frail snowdrops that together cling / and nod their helmets, smitten by the wing / of many a furious whirl-blast sweeping by."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e690abc-d2bc-31fa-a5b0-7d0f7afc672a",
                                        "entry_id": "e90ca759-53ad-3313-8b61-92c12ee23465",
                                        "glosses": [
                                            "To gradually fall asleep."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9669ea5a-c590-3f53-9639-3632440a522a",
                                        "entry_id": "e90ca759-53ad-3313-8b61-92c12ee23465",
                                        "glosses": [
                                            "To signify by a nod."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e436ad62-3ebc-440f-8496-d4a96bbc3850",
                                                "sense_id": "9669ea5a-c590-3f53-9639-3632440a522a",
                                                "text": "They nodded their assent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c5ad1d7-de7d-351f-a204-b114f979d145",
                                        "entry_id": "e90ca759-53ad-3313-8b61-92c12ee23465",
                                        "glosses": [
                                            "To make a mistake by being temporarily inattentive or tired"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cddc41e-a582-488c-b329-9cb0ca0bffad",
                                                "sense_id": "0c5ad1d7-de7d-351f-a204-b114f979d145",
                                                "text": "Even Homer nods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db52bcf6-b532-31e3-b09a-69556dd5250f",
                                        "entry_id": "e90ca759-53ad-3313-8b61-92c12ee23465",
                                        "glosses": [
                                            "To head; to strike the ball with one's head."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c4bfaa7-bb21-4536-a18d-30116ca1b252",
                                                "sense_id": "db52bcf6-b532-31e3-b09a-69556dd5250f",
                                                "text": "Jones nods the ball back to his goalkeeper."
                                            },
                                            {
                                                "example_id": "927e413c-5ffd-46af-918a-a14d5b580cdb",
                                                "sense_id": "db52bcf6-b532-31e3-b09a-69556dd5250f",
                                                "text": "With the hosts not able to find their passes - everything that went forward was too heavy or too short - Terry once again had to come to his side's rescue after Davies had brilliantly nodded into the path of Elmander, who followed up swiftly with a deflected shot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "937c457b-2866-3bda-94d7-cfa928b3de02",
                                        "entry_id": "e90ca759-53ad-3313-8b61-92c12ee23465",
                                        "glosses": [
                                            "To allude to something."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "261b8199-f465-44df-b08e-44eda5339382",
                                                "sense_id": "937c457b-2866-3bda-94d7-cfa928b3de02",
                                                "text": "Though the title nods to the Italian neo-realist classic Bicycle Thieves—and Cyril, much like the father and son in that movie, spends much of his time tracking down the oft-stolen possession—The Kid With A Bike isn’t about the bike as something essential to his livelihood, but as his sole connection to the freedom and play of childhood itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92f6a35b-b046-31f5-be1b-fd8815240c4b",
                                        "entry_id": "e90ca759-53ad-3313-8b61-92c12ee23465",
                                        "glosses": [
                                            "To fall asleep while under the influence of opiates."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nod",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8473b269-b8c2-361e-92e4-ae62f8f6b7f3",
                                        "entry_id": "b80d2eb4-b663-3098-814b-d33fd5efe768",
                                        "glosses": [
                                            "An instance of inclining the head up and down, as to indicate agreement, or as a cursory greeting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b05ca6d-0e77-3341-a391-b0a39f95f5ce",
                                        "entry_id": "b80d2eb4-b663-3098-814b-d33fd5efe768",
                                        "glosses": [
                                            "A reference or allusion to something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d1cd257-72fc-43a9-9900-e7ca5d0da882",
                                                "sense_id": "3b05ca6d-0e77-3341-a391-b0a39f95f5ce",
                                                "text": "Much like Mirror Mirror, Huntsman appears to borrow liberally from other fantasy films. Sometimes the nods are clever—Stewart’s first night in the forest, among hallucinatory fog that gives the trees faces and clutching hands, evokes Disney’s animated Snow White And The Seven Dwarfs from 1937."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20bf8c1d-6564-357a-a0db-2047a048baa2",
                                        "entry_id": "b80d2eb4-b663-3098-814b-d33fd5efe768",
                                        "glosses": [
                                            "A nomination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54d96700-3c10-4b4b-9498-c2f3c2f38c94",
                                                "sense_id": "20bf8c1d-6564-357a-a0db-2047a048baa2",
                                                "text": "For the fifth time in her career she received a Grammy nod, she has yet to win the award."
                                            },
                                            {
                                                "example_id": "6918eb85-15be-4b6e-a298-27071f2ff06b",
                                                "sense_id": "20bf8c1d-6564-357a-a0db-2047a048baa2",
                                                "text": "Allen Gregory DeLongpre: Really putting a damper on the ol' Tony nod."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edd0766c-3220-3571-b797-384e160ee2f9",
                                        "entry_id": "b80d2eb4-b663-3098-814b-d33fd5efe768",
                                        "glosses": [
                                            "Approval."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4624ebd0-36df-40d5-acd4-23d5149d14e4",
                                                "sense_id": "edd0766c-3220-3571-b797-384e160ee2f9",
                                                "text": "The plan is expected to get the nod from councillors at the next meeting."
                                            },
                                            {
                                                "example_id": "899b00e3-fd93-4c69-b149-b5130b088976",
                                                "sense_id": "edd0766c-3220-3571-b797-384e160ee2f9",
                                                "text": "Has the BRB received a secret nod from the Ministry to continue the LMR electrification from Weaver Junction to Glasgow?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2bde136-d2a1-3ed5-8694-a1ecda1f8ba4",
                                        "entry_id": "b80d2eb4-b663-3098-814b-d33fd5efe768",
                                        "glosses": [
                                            "A state of half-consciousness; stupor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33e34482-de54-42e1-aab0-6214afd4b031",
                                                "sense_id": "c2bde136-d2a1-3ed5-8694-a1ecda1f8ba4",
                                                "text": "Withered addicts drooped into chronic heroin nods."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
