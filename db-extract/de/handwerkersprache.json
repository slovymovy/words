                "senses": [
                    {
                        "sense_id": "a2e12ce1-ed51-3313-a419-30c67c516247",
                        "entry_id": "bbcf741b-daa6-3b9d-ae76-2c0828416cf1",
                        "glosses": [
                            "Sammelbegriff für die verschiedenen Berufssprachen der Handwerker"
                        ],
                        "tags": [
                            "Soziolinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "86d74352-04e8-4ca1-b87a-577c899cb29b",
                                "sense_id": "a2e12ce1-ed51-3313-a419-30c67c516247",
                                "text": "„Auch die Handwerkersprachen sind Fachsprachen.“"
                            },
                            {
                                "example_id": "55a4cb11-762b-4c63-906a-01c4e9bacbca",
                                "sense_id": "a2e12ce1-ed51-3313-a419-30c67c516247",
                                "text": "„Die jungen Industriearbeiter wurden, wie in der Handwerkszeit, von älteren Vorarbeitern und Meistern nur mündlich und in traditioneller Handwerkersprache angelernt.“"
                            },
                            {
                                "example_id": "6dd9bf24-a4df-4545-a628-4d2c1bb68aac",
                                "sense_id": "a2e12ce1-ed51-3313-a419-30c67c516247",
                                "text": "„Solche Wortschätze bauen sich ähnlich den Fachwortschätzen und Handwerkersprachen aus einem terminologischen Kern, der gruppenspezifischen Ausdrucksweise (Fachjargonismen, Terminoide) und der gruppenspezifischen Umgangssprache auf.“"
                            },
                            {
                                "example_id": "d748353f-016d-417f-8239-c01fceefbfec",
                                "sense_id": "a2e12ce1-ed51-3313-a419-30c67c516247",
                                "text": "„Neben diesen oft zitierten Paradebeispielen entwickelten sich aber auch zahlreiche Handwerkersprachen […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
