                ],
                "translations": [
                    {
                        "translation_id": "55fbde0f-699f-4924-8884-80061288f6f4",
                        "source_entry_id": "47120112-497f-31ed-838f-e9e77d51738b",
                        "source_sense_id": "dbf74a47-49dc-3b95-995a-85a6db1932d5",
                        "target_lang_word": "Weide",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weide",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a7b5da5-7644-3a54-b90a-f84f10b47ba5",
                                        "entry_id": "d637c21b-f855-32a0-a31c-d9c4f4b69271",
                                        "glosses": [
                                            "Laubgehölz aus der Gattung Salix"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1db3226b-1868-42d8-882b-3876dc2bec66",
                                                "sense_id": "6a7b5da5-7644-3a54-b90a-f84f10b47ba5",
                                                "text": "Weiden stehen häufig an Seeufern."
                                            },
                                            {
                                                "example_id": "d0676833-9749-4908-91b7-988397b8ae82",
                                                "sense_id": "6a7b5da5-7644-3a54-b90a-f84f10b47ba5",
                                                "text": "„Am Wege entlang stehen Pyramidenpappeln, Weiden und wilde Obstbäume; die Hügel sind niedrig; vor uns in weiter Ferne blaue Berge, aber auch diese scheinen niedrig.“"
                                            },
                                            {
                                                "example_id": "7f7b0595-d78c-4531-ae25-64def80c2b70",
                                                "sense_id": "6a7b5da5-7644-3a54-b90a-f84f10b47ba5",
                                                "text": "„Da war das Wasser, da war der Wind, die Weiden waren da und die Steine.“"
                                            },
                                            {
                                                "example_id": "3ae32e97-9016-4243-82dd-e5292d7f621f",
                                                "sense_id": "6a7b5da5-7644-3a54-b90a-f84f10b47ba5",
                                                "text": "„In dem schmalen Raum zwischen Plateau und blasser werdenden Sternen schien der Tag aus den Sümpfen zu steigen, schälte die schwarzen Silhouetten der Moorbirken, Weiden und Ebereschen aus dem blasser werdenden Nachblau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2f28194e-4061-3243-87f4-1a2c6d2fa8c9",
                                        "entry_id": "d637c21b-f855-32a0-a31c-d9c4f4b69271",
                                        "glosses": [
                                            "Holzart des Laubbaumes aus der Gattung Salix"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06d74ec1-4958-40b0-add5-b69b8df32322",
                                                "sense_id": "2f28194e-4061-3243-87f4-1a2c6d2fa8c9",
                                                "text": "Weide ist ein Weichholz."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Weide",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1aa8143c-53fa-353b-abc8-aa179bb7b7f7",
                                        "entry_id": "659c75eb-8def-3f69-825c-27226b227864",
                                        "glosses": [
                                            "Wiese, auf der man Vieh hält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80731f63-8e19-4da7-8009-187e83f934c7",
                                                "sense_id": "1aa8143c-53fa-353b-abc8-aa179bb7b7f7",
                                                "text": "Im Frühjahr werden die Kühe auf die Weide getrieben."
                                            },
                                            {
                                                "example_id": "8d4f8768-d8f3-4d9a-af9f-847906ff27d6",
                                                "sense_id": "1aa8143c-53fa-353b-abc8-aa179bb7b7f7",
                                                "text": "„Es gibt lange, ansteigende Weiden, die von Baumreihen begrenzt werden.“"
                                            },
                                            {
                                                "example_id": "39f9e576-6161-4ab5-a684-a0fc7ecdbdcb",
                                                "sense_id": "1aa8143c-53fa-353b-abc8-aa179bb7b7f7",
                                                "text": "„1540 war ein Jahr von außergewöhnlicher Trockenheit, und wie bei der Pest suchten die Menschen nach einer Erklärung dafür, warum der Regen ausblieb, die Weiden verdorrten und das Vieh verendete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "126718c8-5f71-4bcd-a876-aa2f933fb752",
