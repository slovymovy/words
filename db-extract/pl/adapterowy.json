                    {
                        "translation_id": "f8a33719-c3d6-4ba6-820c-90d6d754f423",
                        "source_entry_id": "03d13a55-1f4d-3ded-9e5e-250022108c18",
                        "source_sense_id": "9d1281ae-7f12-3b88-833d-3d085ce070f3",
                        "source_sense_description": "Musik: Grammophon-, Plattenspieler-, Platten-",
                        "target_lang_word": "Grammophon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grammophon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e7a33993-623a-3b4d-8c65-f4d763f528c4",
                                        "entry_id": "d5536ef1-eb97-31e3-9edb-de72d5043b1d",
                                        "glosses": [
                                            "Wiedergabegerät für Schallplatten mit Schalltrichter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4357fc7a-1351-4a56-ab10-252a4bdfac93",
                                                "sense_id": "e7a33993-623a-3b4d-8c65-f4d763f528c4",
                                                "text": "Ich liebe den Klang von Opas altem Grammophon."
                                            },
                                            {
                                                "example_id": "9eb42f01-fedf-4665-99e8-b8ff7388cbfe",
                                                "sense_id": "e7a33993-623a-3b4d-8c65-f4d763f528c4",
                                                "text": "„Irgendwo wurde Grammophon gespielt.“"
                                            },
                                            {
                                                "example_id": "6ca0fa53-6199-490c-adc2-865e295b9301",
                                                "sense_id": "e7a33993-623a-3b4d-8c65-f4d763f528c4",
                                                "text": "„Von seinem Taschengeld hatte sich Robert ein Grammophon gekauft, eins zum Aufziehen.“"
                                            },
                                            {
                                                "example_id": "5c9549a4-f98a-4bf2-8e06-8dfdc873e8bb",
                                                "sense_id": "e7a33993-623a-3b4d-8c65-f4d763f528c4",
                                                "text": "„Manchmal fällt aus einer Kneipe Lichtschein auf die Steine, über die er geht, ein Orchestrion lärmt mit Zimbeln und Schellen, ein Grammophon kreischt.“"
                                            },
                                            {
                                                "example_id": "79802e6f-cd34-4ae2-996e-e616ba7952b0",
                                                "sense_id": "e7a33993-623a-3b4d-8c65-f4d763f528c4",
                                                "text": "„Inzwischen ließ einer das Grammophon los.“"
                                            },
                                            {
                                                "example_id": "3ca3a4a3-52ae-49cc-923f-52ac6c74ad56",
                                                "sense_id": "e7a33993-623a-3b4d-8c65-f4d763f528c4",
                                                "text": "„Er hatte sich außerdem vor dem ersten Arbeitstag noch etwas ganz Außergewöhnliches gegönnt: ein portables Grammophon vom letzten Geld des elterlichen Erbes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6806fe7e-1dd7-4fa1-a08e-4465c1514c94",
                        "source_entry_id": "03d13a55-1f4d-3ded-9e5e-250022108c18",
                        "source_sense_id": "9d1281ae-7f12-3b88-833d-3d085ce070f3",
                        "source_sense_description": "Musik: Grammophon-, Plattenspieler-, Platten-",
                        "target_lang_word": "Plattenspieler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plattenspieler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b4118c9-d80d-3a11-8d30-b2f2a2fe13c5",
                                        "entry_id": "507c2cdd-117e-341e-b8e6-0c329e74a5be",
                                        "glosses": [
                                            "Schallplattenspieler; ein elektrisches Gerät zum Abspielen von Schallplatten"
                                        ],
                                        "tags": [
                                            "Kurzform"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccbbf9a9-8665-4cfc-bf74-882b4b2d4611",
                                                "sense_id": "3b4118c9-d80d-3a11-8d30-b2f2a2fe13c5",
                                                "text": "Er hat einen alten Plattenspieler auf dem Flohmarkt gekauft."
                                            },
                                            {
                                                "example_id": "883022a2-6f57-4cf9-8532-b95ef522d0c8",
                                                "sense_id": "3b4118c9-d80d-3a11-8d30-b2f2a2fe13c5",
                                                "text": "„Mit Mamas Erlaubnis hatte Renate den alten Plattenspieler bei sich im Zimmer angeschlossen und die Weihnachtsplatte aufgelegt: Musik für festliche Stunden.“"
                                            },
                                            {
                                                "example_id": "4878a605-a937-4ef2-b8b1-1ccc5d7b02a6",
                                                "sense_id": "3b4118c9-d80d-3a11-8d30-b2f2a2fe13c5",
                                                "text": "„Sabina glitt zu Boden, blieb nahe beim Plattenspieler sitzen.“"
                                            },
                                            {
                                                "example_id": "5d2422cc-c5bc-402e-bb04-7c63b51045c6",
                                                "sense_id": "3b4118c9-d80d-3a11-8d30-b2f2a2fe13c5",
                                                "text": "„Zur Feier des Tages wurde dann wie verrückt Charleston getanzt, der Plattenspieler spielte pausenlos, die Dielenbalken bogen sich, und das ganze Haus bebte.“"
                                            },
                                            {
                                                "example_id": "2d9d66fa-05f0-45a8-b2cf-fd18af0ac2e5",
                                                "sense_id": "3b4118c9-d80d-3a11-8d30-b2f2a2fe13c5",
                                                "text": "„Ein Plattenspieler ließ durch zwei Lautsprecher leicht kratzend nostalgische Unterhaltungsmusik hören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
