                    {
                        "sense_id": "8f78e3e6-1004-363a-9e6b-e9b3e8fcb94b",
                        "entry_id": "c88a4d7d-abee-3ab7-8d52-12b3efc29e48",
                        "glosses": [
                            "cecha tego, co amerykańskie; amerykański charakter czegoś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9445712b-c177-4cb7-a32d-7a6ccb35d432",
                                "sense_id": "8f78e3e6-1004-363a-9e6b-e9b3e8fcb94b",
                                "text": "O amerykańskości hotelu świadczą m.in. charakterystyczne muszle klozetowe specjalnie sprowadzone z Ameryki."
                            }
