                "senses": [
                    {
                        "sense_id": "b16f8e8f-3e57-36fd-8dd3-3469e2a762f8",
                        "entry_id": "a1351c86-817e-351d-9ead-8400549f12d0",
                        "glosses": [
                            "The characteristic of being bloodless."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "95d5d1d3-8553-48f1-8ba2-fc178b92144c",
                                "sense_id": "b16f8e8f-3e57-36fd-8dd3-3469e2a762f8",
                                "text": "The most striking lesson of the engagement is the extreme bloodiness of modern warfare under some conditions, and its bloodlessness under others."
                            },
                            {
                                "example_id": "b3a1f921-c228-4d45-97ca-c5bc47a68b08",
                                "sense_id": "b16f8e8f-3e57-36fd-8dd3-3469e2a762f8",
                                "text": "The feature that struck me most forcibly was the strange hue of their skin, a repulsive, unhealthy pallor, a seeming bloodlessness."
                            },
                            {
                                "example_id": "069a044a-a8e8-435b-8098-b61cb8c41402",
                                "sense_id": "b16f8e8f-3e57-36fd-8dd3-3469e2a762f8",
                                "text": "Her heart rebelled against the bloodlessness of his precision, but she had begun to watch him with a grudging admiration for a quality so alien to her own temperament."
                            }
                        ]
                    }
                ],
