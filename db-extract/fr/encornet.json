                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8d881c64-4f9c-45b9-b7c1-b766b0457964",
                        "entry_id": "51f21942-9d42-3c12-9192-897e46381e5c",
                        "tags": [
