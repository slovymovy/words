                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d3e3760-60fa-334c-a14d-991a2249fad8",
                                        "entry_id": "204bb58e-f3ce-3298-b2cb-6b4f8615ddd3",
                                        "glosses": [
                                            "Initialism of city engineering office."
                                        ],
                                        "tags": [
                                            "Philippines",
