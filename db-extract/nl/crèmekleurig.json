                "senses": [
                    {
                        "sense_id": "847d0af4-3aed-3b34-82dc-930d3ea84cf3",
                        "entry_id": "c723a14d-417f-3ec7-a5f3-4a10b41aae33",
                        "glosses": [
                            "met een geel-witte kleur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5af7618e-18aa-4911-a1fe-193057e43775",
                                "sense_id": "847d0af4-3aed-3b34-82dc-930d3ea84cf3",
                                "text": "Het crèmekleurig-zachtroze kapje, met een prijskaartje van 15 pond (16,60 euro), was op de website van het merk al snel uitverkocht."
                            },
                            {
                                "example_id": "a47084ae-a923-4784-8c8a-583353026d5b",
                                "sense_id": "847d0af4-3aed-3b34-82dc-930d3ea84cf3",
                                "text": "Zou ze de rosékleurige jurk aantrekken of toch liever de crèmekleurige rok met de lichtblauwe blouse?"
                            },
                            {
                                "example_id": "b2e2df2d-128e-432a-b4e3-4d57b94b45e7",
                                "sense_id": "847d0af4-3aed-3b34-82dc-930d3ea84cf3",
                                "text": "In het door Patrice van Helden ontworpen boeket waren onder meer jasmijn, lichtroze en crèmekleurige lathyrus, ivoren trosrozen, roze O’Hara-tuinrozen en wasbloem verwerkt."
                            }
                        ]
                    }
