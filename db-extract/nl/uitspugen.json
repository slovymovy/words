        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "8e5f05f7-7e18-3a55-94bf-a4153317820c",
                "word": "uitspugen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6efe39c0-2a19-3978-9173-008e9f321483",
                        "entry_id": "8e5f05f7-7e18-3a55-94bf-a4153317820c",
                        "glosses": [
                            "iets met kracht uit je mond laten gaan zonder je handen te gebruiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "570008b6-952f-4f47-a023-d94bd4d8e9cb",
                                "sense_id": "6efe39c0-2a19-3978-9173-008e9f321483",
                                "text": "Pink kreeg na haar uitvoering van het Amerikaanse volkslied bij de Super Bowl de nodige kritiek, omdat ze vlak voor het optreden haar kauwgom uitspuugde om het veld. Volgens de muzikante ligt het verhaal echter anders."
                            },
                            {
                                "example_id": "86f8a87f-bac4-4935-aaa4-d0affd8e129c",
                                "sense_id": "6efe39c0-2a19-3978-9173-008e9f321483",
                                "text": "Ik leerde hem kennen op een foodbeurs. We stonden allebei iets te proeven, ik wilde het uitspugen en hij zag dat. We schoten in de lach en raakten aan de praat over eten, wijn, reizen. Mijn vriendinnen lieten mij lekker kletsen; ze wisten dat ik al jaren zonder liefde zat en gunden me deze flirt. Maar het was meer dan een flirt. Veel meer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72f3d996-bc3d-40d5-828f-3151afbff833",
                        "source_entry_id": "8e5f05f7-7e18-3a55-94bf-a4153317820c",
                        "source_sense_id": "6efe39c0-2a19-3978-9173-008e9f321483",
                        "target_lang_word": "spit out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spit out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f15c7869-47bf-3ff9-8cad-31bf5b558c40",
                                        "entry_id": "9e596509-8c72-3184-a9e9-5932549261b8",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see spit, out."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "157f6874-9aaf-3bf1-ae34-a7ddb89dae4b",
                                        "entry_id": "9e596509-8c72-3184-a9e9-5932549261b8",
                                        "glosses": [
                                            "To say reluctantly (see also spit it out)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef1024a5-e12f-43cb-9bff-b9abb0c71568",
                                                "sense_id": "157f6874-9aaf-3bf1-ae34-a7ddb89dae4b",
                                                "text": "Well, you've obviously got something to say about their relationship, so just spit it out already!"
                                            },
                                            {
                                                "example_id": "83e68be4-ef78-421d-8d25-5492443850d9",
                                                "sense_id": "157f6874-9aaf-3bf1-ae34-a7ddb89dae4b",
                                                "text": "\"Hark ye, mistress,\" said the shepherd. \"I've had much on my tongue this many a day, but you haven't given me the chance to spit it out. I won't be put off any longer.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fac8878d-f001-3923-97ba-657ab6e1d9dc",
                                        "entry_id": "9e596509-8c72-3184-a9e9-5932549261b8",
                                        "glosses": [
                                            "To rap; to repeat verses passionately or intensely."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e3e4be0-b7dc-45f3-9de8-9d1f9cb2dd56",
                                                "sense_id": "fac8878d-f001-3923-97ba-657ab6e1d9dc",
                                                "text": "She spit the notes out so quickly, she might have given the fast talker in those Federal Express commercials a real run for his money."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68f2ee6a-8dac-3935-ab58-234ba501b0d2",
                                        "entry_id": "9e596509-8c72-3184-a9e9-5932549261b8",
                                        "glosses": [
                                            "To say scornfully."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81b5cfa6-2397-4705-b7b3-5fc244ba4eb9",
                                                "sense_id": "68f2ee6a-8dac-3935-ab58-234ba501b0d2",
                                                "text": "\"You will die now!\", he spat out."
                                            },
                                            {
                                                "example_id": "fe7c70b5-5a0e-485e-810f-9414241e700f",
                                                "sense_id": "68f2ee6a-8dac-3935-ab58-234ba501b0d2",
                                                "text": "But, crucially, the visual wit that made the original feel so bracingly fresh is maintained, not to mention its fondness for turning the Savile Row air blue – if you’ve ever hoped to witness Elton John spitting out four-letter words like a Gatling gun, all while wearing a remarkable feathered suit, then this might be the gonzo spy caper for you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5c3bea8-d857-3da0-abe9-de027ac10e1c",
                                        "entry_id": "9e596509-8c72-3184-a9e9-5932549261b8",
                                        "glosses": [
                                            "To eject."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8147422c-11a3-4c62-8386-b7a61ad16746",
                                                "sense_id": "f5c3bea8-d857-3da0-abe9-de027ac10e1c",
                                                "text": "My computer won't read this DVD. It just keeps spitting it out."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
