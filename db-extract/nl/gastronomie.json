                                                "example_id": "75383354-b430-4da8-b4a2-d11d7ca39a99",
                                                "sense_id": "e2886288-45e6-39ad-bc43-e6485a75e643",
                                                "text": "„Michalis nutzt die Sommersaison, um in der Gastronomie Geld zu verdienen.“"
                                            }
