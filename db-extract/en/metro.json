            {
                "entry_id": "5012965b-0da4-3a0e-8adc-2e164e32427b",
                "word": "metro",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "05654e13-2463-4f48-84cb-6a4ab3bb6368",
                        "entry_id": "5012965b-0da4-3a0e-8adc-2e164e32427b",
                        "tags": [
                            "plural"
                        ],
                        "form": "metros"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2fa7130f-1491-3b49-bf19-cbefd5e660ce",
                        "entry_id": "5012965b-0da4-3a0e-8adc-2e164e32427b",
                        "glosses": [
                            "A rapid transit rail transport system, or a train in such systems, generally underground and serving a metropolitan area."
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "ed99c787-d33a-48b8-8fc2-89cd44b8dac6",
                                "sense_id": "2fa7130f-1491-3b49-bf19-cbefd5e660ce",
                                "text": "He is going to the stadium by metro."
                            },
                            {
                                "example_id": "5c0afb58-b730-4d79-b19d-f02b2f55dfb0",
                                "sense_id": "2fa7130f-1491-3b49-bf19-cbefd5e660ce",
                                "text": "Recalling that Davide Lungo returned the van at the airport, Pizo descended the nearby stairs to the underground metro, and boarded the next metro stopping there."
                            },
                            {
                                "example_id": "a3873f49-da9d-47ef-8194-aee3fc1e3e00",
                                "sense_id": "2fa7130f-1491-3b49-bf19-cbefd5e660ce",
                                "text": "I hurry to the underground. ... I am waiting for the next metro; I'll take it."
                            },
                            {
                                "example_id": "be23214e-f23e-4b89-9633-10cb9b56f18c",
                                "sense_id": "2fa7130f-1491-3b49-bf19-cbefd5e660ce",
                                "text": "What we entered into here was well lit and had clean silver curvy walls that ended in nice automatic elevators that took you underground. The walls are not infested with graffiti and advertisements; they were clean and shiny. We waited on nice benches until the metro arrived."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a6db6eb-fb8c-37f1-ab79-6207121bac55",
                        "entry_id": "5012965b-0da4-3a0e-8adc-2e164e32427b",
                        "glosses": [
                            "An urban rapid transit rail transport system, normally with lighter track and light trains (i.e. an S-Bahn or similar), or a train in such systems."
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "223a11bd-6def-4f5c-844f-779c3024b6ca",
                                "sense_id": "4a6db6eb-fb8c-37f1-ab79-6207121bac55",
                                "text": "Informs how long the passenger has to wait for the next metro"
                            },
                            {
                                "example_id": "7117fb6c-ee7a-480a-a4fd-bbf758f8b313",
                                "sense_id": "4a6db6eb-fb8c-37f1-ab79-6207121bac55",
                                "text": "With the weather clear and warm for a change, I decided to catch the next metro to the outskirts of town by myself."
                            },
                            {
                                "example_id": "595cec59-9b56-4111-895a-e8f68e22b588",
                                "sense_id": "4a6db6eb-fb8c-37f1-ab79-6207121bac55",
                                "text": "I boarded the Yellow Line Metro, beaming with confidence. I got down at Rajiv Chowk to continue my journey towards Noida City Centre (NCC). The next metro arrived."
                            }
                        ]
                    }
                ],
