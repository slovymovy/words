                ],
                "senses": [
                    {
                        "sense_id": "1329c65b-69d2-3e55-a8b7-995a7b08d48c",
                        "entry_id": "963736c5-4084-3cf4-aabd-a7eedf9216c8",
                        "glosses": [
                            "in jemand gesetztes Vertrauen, ohne dessen Kompetenz oder Zuverlässigkeit überprüft zu haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e0af06e-d6ac-41aa-a3b0-9cd9e75067c9",
                                "sense_id": "1329c65b-69d2-3e55-a8b7-995a7b08d48c",
                                "text": "Joachim Gauck geht mit großem Vertrauensvorschuss der Bürger in die Wahl zum Bundespräsidenten."
                            },
                            {
                                "example_id": "1294dcdd-9829-4e5e-af00-659fa56ef607",
                                "sense_id": "1329c65b-69d2-3e55-a8b7-995a7b08d48c",
                                "text": "Bundespräsident Heinz Fischer hat in seiner Neujahrsansprache im ORF bei der Bevölkerung um einen Vertrauensvorschuss für die neue Bundesregierung geworben."
                            },
                            {
                                "example_id": "6d88da30-6087-4f88-aee7-01b837bb44dc",
                                "sense_id": "1329c65b-69d2-3e55-a8b7-995a7b08d48c",
                                "text": "\"Griechenlands Partner in Europa und der Welt haben dem Land einen sehr großen Vertrauensvorschuss gegeben, damit die Griechen weiterhin Mitglied des Euro-Währungsgebiets bleiben können.\""
                            },
                            {
                                "example_id": "1cbb837f-d2aa-413a-bfa6-cdf94caf78d7",
                                "sense_id": "1329c65b-69d2-3e55-a8b7-995a7b08d48c",
                                "text": "Dennoch sollten die Deutschen den USA mit Blick auf deren Geschichte einen \"Vertrauensvorschuss\" einräumen, sagte Obama nach einem Treffen mit Bundeskanzlerin Angela Merkel (CDU) am Montag in Washington."
                            },
                            {
                                "example_id": "8dc3f438-0ac9-4c35-915c-a1fc5a395440",
                                "sense_id": "1329c65b-69d2-3e55-a8b7-995a7b08d48c",
                                "text": "Der Iran muss hier also den Verhandlungspartnern genau den Vertrauensvorschuss einräumen, den er selbst fordert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f108d67-1a61-45f8-b358-a50ae808c9b9",
                        "source_entry_id": "963736c5-4084-3cf4-aabd-a7eedf9216c8",
                        "source_sense_id": "1329c65b-69d2-3e55-a8b7-995a7b08d48c",
                        "source_sense_description": "in jemand gesetztes Vertrauen, ohne dessen Kompetenz oder Zuverlässigkeit überprüft zu haben",
                        "target_lang_word": "leap of faith",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leap of faith",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8495c4a1-ba44-338b-b6ed-ef8970f140a5",
                                        "entry_id": "b9d2f2ef-da0f-3001-9cf2-1950e370ca48",
                                        "glosses": [
                                            "The act of believing in something despite lack of proof of its truth or existence, or the attempt of something without being sure of its possible outcome."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0156ba2a-8b13-4249-a9ba-efdaa5742959",
                                                "sense_id": "8495c4a1-ba44-338b-b6ed-ef8970f140a5",
                                                "text": "He took a leap of faith by publishing his first book independently."
                                            },
                                            {
                                                "example_id": "641eb2d0-d18c-4ba6-ad07-ad3b6b5d6aae",
                                                "sense_id": "8495c4a1-ba44-338b-b6ed-ef8970f140a5",
                                                "text": "Don't you want to take a leap of faith? Or become an old man, filled with regret, waiting to die alone?"
                                            },
                                            {
                                                "example_id": "9db236f5-ffd8-41ce-ae33-dd1f2248a097",
                                                "sense_id": "8495c4a1-ba44-338b-b6ed-ef8970f140a5",
                                                "text": "Considering that the GBR proposal is supported by DfT (which would lose considerable power) with the support of the Treasury (which will have to make a major leap of faith), those critics need to frame their complaints very carefully if we are to avoid yet worse problems."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
