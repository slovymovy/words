                        "entry_id": "594f0450-9b38-3ab3-bf3d-043e97c8ccc6",
                        "glosses": [
                            "The act or process of decarbonizing."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "1b893d98-5907-4da1-8f94-ef81600257f1",
                                "sense_id": "5a2a0323-2745-3504-bb38-f915c732139d",
                                "text": "But we spend over $5 trillion globally on fossil fuel subsidies and these would be freed up for this task of decarbonization if we forgo fossil fuel. So cost doesn’t have to be the big issue we think it is."
                            }
                        ]
                    },
                    {
                        "sense_id": "6511f99b-c5e0-3fce-b834-69522552b001",
                        "entry_id": "594f0450-9b38-3ab3-bf3d-043e97c8ccc6",
                        "glosses": [
                            "The process of arterialization of the blood by oxygenation and the removal of carbon dioxide in the lungs."
                        ],
