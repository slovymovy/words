                {
                    "sense_id": "5eab475b-0fc4-3c77-9d78-62586ce32241",
                    "sense_definition": "wychodzić skrycie, opuszczać miejsce niezauważenie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ucieczka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Goście zaczęli powoli <w>wymykać</w> się z przyjęcia przed północą.",
                            "target_lang_translations": {
                                "ru": "Гости начали потихоньку <w>ускользать</w> с вечеринки до полуночи."
                            }
                        },
                        {
                            "text": "Muszę <w>wymykać</w> się z domu po cichu, żeby nikogo nie obudzić.",
                            "target_lang_translations": {
                                "ru": "Мне приходится тихо <w>ускользать</w> из дома, чтобы никого не разбудить."
                            }
                        }
                    ],
                    "synonyms": [
                        "wymykać się",
                        "wyślizgiwać się"
                    ],
                    "common_phrases": [
                        "wymykać się po cichu"
                    ],
                    "target_lang_definitions": {
                        "ru": "незаметно уходить, покидать место тайком"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ускользать",
                                "target_lang_sense_clarification": "уходить незаметно, часто тайком"
                            },
                            {
                                "target_lang_word": "выскальзывать",
                                "target_lang_sense_clarification": "покидать место тихо и незаметно"
                            }
                        ]
                    }
                },
                {
