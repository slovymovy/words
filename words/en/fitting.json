{
    "word_family": [
        "fit",
        "fitness",
        "fitter"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "aa12be78-be02-3b6d-b4d7-292b298b2592",
                    "sense_definition": "Appropriate or suitable for a particular situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>fitting</w> end to a very long and difficult day.",
                            "target_lang_translations": {
                                "ru": "Это был <w>подходящий</w> финал для очень долгого и тяжелого дня."
                            }
                        },
                        {
                            "text": "The team gave their retiring coach a <w>fitting</w> tribute at the final game.",
                            "target_lang_translations": {
                                "ru": "На финальной игре команда отдала уходящему на пенсию тренеру <w>подобающие</w> почести."
                            }
                        }
                    ],
                    "synonyms": [
                        "appropriate",
                        "suitable",
                        "apt"
                    ],
                    "antonyms": [
                        "inappropriate",
                        "unsuitable"
                    ],
                    "common_phrases": [
                        "fitting tribute",
                        "fitting end"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подходящий, уместный или соответствующий определенной ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подходящий",
                                "target_lang_sense_clarification": "соответствующий ситуации или случаю"
                            },
                            {
                                "target_lang_word": "уместный",
                                "target_lang_sense_clarification": "своевременный, приличествующий"
                            },
                            {
                                "target_lang_word": "подобающий",
                                "target_lang_sense_clarification": "должный, подобающий положению или моменту"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "df13e823-7b21-38bc-8d38-ab33d98bc3eb",
                    "sense_definition": "A small, often standardized or detachable part of a machine or device.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic replaced the broken <w>fitting</w> to stop the machine from leaking.",
                            "target_lang_translations": {
                                "ru": "Механик заменил сломанную <w>деталь</w>, чтобы остановить протечку в машине."
                            }
                        },
                        {
                            "text": "Check all the <w>fittings</w> to ensure the equipment is assembled correctly.",
                            "target_lang_translations": {
                                "ru": "Проверьте все <w>соединительные элементы</w>, чтобы убедиться в правильности сборки оборудования."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая, часто стандартизированная или съемная деталь механизма либо устройства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деталь",
                                "target_lang_sense_clarification": "составная часть механизма"
                            },
                            {
                                "target_lang_word": "арматура",
                                "target_lang_sense_clarification": "вспомогательные части оборудования"
                            },
                            {
                                "target_lang_word": "фитинг",
                                "target_lang_sense_clarification": "монтажная или крепежная деталь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf759c77-85f6-3710-bfa9-485f854c5f7a",
                    "sense_definition": "A connector used to join sections of pipe together.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plumber tightened the pipe <w>fitting</w> to prevent water from dripping.",
                            "target_lang_translations": {
                                "ru": "Сантехник затянул трубный <w>фитинг</w>, чтобы вода перестала капать."
                            }
                        },
                        {
                            "text": "We need a new brass <w>fitting</w> to connect these two pipes.",
                            "target_lang_translations": {
                                "ru": "Нам нужен новый латунный <w>фитинг</w>, чтобы соединить эти две трубы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединительная деталь, используемая для состыковки труб."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фитинг",
                                "target_lang_sense_clarification": "соединительная часть трубопровода"
                            },
                            {
                                "target_lang_word": "соединитель",
                                "target_lang_sense_clarification": "элемент соединения труб"
                            },
                            {
                                "target_lang_word": "переходник",
                                "target_lang_sense_clarification": "деталь для соединения элементов трубопровода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7338e155-ad9b-3fdc-ac68-d5a8620699ad",
                    "sense_definition": "The act of trying on clothes to check or adjust how they fit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She went to the tailor for a final <w>fitting</w> of her wedding dress.",
                            "target_lang_translations": {
                                "ru": "Она пошла к портному на финальную <w>примерку</w> свадебного платья."
                            }
                        },
                        {
                            "text": "The suit needs one more <w>fitting</w> before it is ready to be worn.",
                            "target_lang_translations": {
                                "ru": "Костюму требуется ещё одна <w>примерка</w>, прежде чем его можно будет носить."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс надевания одежды для проверки или подгонки по фигуре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "примерка",
                                "target_lang_sense_clarification": "одежды у портного или в магазине"
                            },
                            {
                                "target_lang_word": "подгонка",
                                "target_lang_sense_clarification": "одежды по фигуре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c91bb5f-8a8b-3ddc-960b-2b331bee5f23",
                    "sense_definition": "A removable item in a building, such as furniture or carpets, that can be taken when moving.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "household",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The house is sold with all the light <w>fittings</w> included.",
                            "target_lang_translations": {
                                "ru": "Дом продается вместе со всеми осветительными <w>приборами</w>."
                            }
                        },
                        {
                            "text": "We need to remove the decorative <w>fittings</w> before we move to the new apartment.",
                            "target_lang_translations": {
                                "ru": "Нам нужно снять декоративные <w>элементы обстановки</w> перед переездом в новую квартиру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fixtures and fittings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Съемный предмет обстановки здания (например, светильник, ковер или мебель), который можно забрать при переезде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предмет обстановки",
                                "target_lang_sense_clarification": "съемное оснащение или элемент интерьера"
                            },
                            {
                                "target_lang_word": "фурнитура",
                                "target_lang_sense_clarification": "вспомогательные элементы интерьера"
                            },
                            {
                                "target_lang_word": "движимое имущество",
                                "target_lang_sense_clarification": "вещи в доме, не являющиеся недвижимостью"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bf7ed9f2-78fb-3e44-b5d1-aa0ba25f626b",
                    "sense_definition": "Preparing or getting ready to do something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "preparation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>fitting</w> to leave for the airport in about an hour.",
                            "target_lang_translations": {
                                "ru": "Я <w>собираюсь</w> выехать в аэропорт примерно через час."
                            }
                        },
                        {
                            "text": "They are <w>fitting</w> to start the project early next week.",
                            "target_lang_translations": {
                                "ru": "Они <w>готовятся</w> запустить проект в начале следующей недели."
                            }
                        }
                    ],
                    "synonyms": [
                        "fixing to"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in some Southern US dialects."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приготовление или готовность сделать что-либо (диалектное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собираться",
                                "target_lang_sense_clarification": "намереваться что-то сделать"
                            },
                            {
                                "target_lang_word": "готовиться",
                                "target_lang_sense_clarification": "подготавливаться к действию"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f761581a-9f09-3b33-8865-db905b98b6d5",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The research was conducted by a professor named <w>Fitting</w>.",
                            "target_lang_translations": {
                                "ru": "Исследование проводилось профессором по фамилии <w>Фиттинг</w>."
                            }
                        },
                        {
                            "text": "The <w>Fittings</w> family has lived in this town for many generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Фиттингов</w> живет в этом городе уже много поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Фиттинг",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}