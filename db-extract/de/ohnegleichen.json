                        "cross_references": []
                    },
                    {
                        "translation_id": "b0d3bb72-0a0d-425c-8353-060a39db9f7f",
                        "source_entry_id": "cdfb6bd0-ba42-33eb-ab2a-4212551b8a6b",
                        "source_sense_id": "00ba4e1e-89e8-37fa-b320-24d1ba971d92",
                        "source_sense_description": "bei Substantiven nachgestellt, gehoben: so geartet, dass es sich mit nichts vergleichen lässt",
                        "target_lang_word": "inégalable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inégalable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d32e945-7b3e-32d0-98df-ed653d0ba665",
                                        "entry_id": "449fd3c4-70e0-31cd-beab-b608f1e4c250",
                                        "glosses": [
                                            "Que l'on ne peut égaler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f612082c-969f-401a-a97d-c77d92ac65a7",
                                                "sense_id": "3d32e945-7b3e-32d0-98df-ed653d0ba665",
                                                "text": "Jusque là les phénomènes décrits par l’inégalable Abbesse restaient exacts."
                                            },
                                            {
                                                "example_id": "ae750eec-f00e-4894-b47d-3efb0df87052",
                                                "sense_id": "3d32e945-7b3e-32d0-98df-ed653d0ba665",
                                                "text": "On se serait cru chez un grand seigneur d’autrefois, n’eussent été l’allure vulgaire et les éclats de voix canailles qui attestent chez notre amphitryon un muflisme inégalable..."
                                            },
                                            {
                                                "example_id": "cc4c66f0-ac71-48c5-a260-2f338380b463",
                                                "sense_id": "3d32e945-7b3e-32d0-98df-ed653d0ba665",
                                                "text": "Colette Ledannois fut, comme toujours, inégalable dans le décryptement d’un manuscrit propre à décourager les meilleurs casseurs de code."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c1087bb-020e-4844-9126-f5f8b7aa0c95",
                        "source_entry_id": "cdfb6bd0-ba42-33eb-ab2a-4212551b8a6b",
                        "source_sense_id": "00ba4e1e-89e8-37fa-b320-24d1ba971d92",
