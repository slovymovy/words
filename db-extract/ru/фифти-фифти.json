                "pos": "adv",
                "lang_code": "ru",
                "forms": [
                    {
                        "form_id": "ac075bf0-283f-43e6-a920-0a61ed8674e4",
                        "entry_id": "a74f769b-561e-3368-bc7b-d97d90bfd5a2",
                        "tags": [
                            "canonical"
                        ],
                        "form": "фи́фти-фи́фти"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c45116ff-e3ba-3f05-bf5a-9757fca6824b",
                        "entry_id": "a74f769b-561e-3368-bc7b-d97d90bfd5a2",
                        "glosses": [
                            "fifty-fifty (equally split or involving equal likelihoods)"
                        ],
                        "tags": [
                            "colloquial",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "e7318e01-1a1f-43a6-a690-23b0b54f5ae5",
                                "sense_id": "c45116ff-e3ba-3f05-bf5a-9757fca6824b",
                                "text": "Мы де́лим фи́фти-фи́фти, то есть 50 проце́нтов твои́, 50 проце́нтов мои́.",
                                "translation": "We divide it fifty-fifty, so you get 50%, and I get 50%.",
                                "english": "We divide it fifty-fifty, so you get 50%, and I get 50%."
                            },
                            {
                                "example_id": "6ba42fcd-cfab-4f61-8e3b-1020e0202b6e",
                                "sense_id": "c45116ff-e3ba-3f05-bf5a-9757fca6824b",
                                "text": "Он мо́жет пройти́ их в пе́рвом ра́унде, но тут фи́фти-фи́фти.",
                                "translation": "He might get through them in the first round, but it's fifty-fifty.",
                                "english": "He might get through them in the first round, but it's fifty-fifty."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc37f157-60a4-3c94-8149-dafa2ddf9a0f",
                        "entry_id": "a74f769b-561e-3368-bc7b-d97d90bfd5a2",
                        "glosses": [
                            "not great, not very well, mediocre(ly), middling(ly)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "370ee598-66d0-4e13-89fa-d207770e1179",
                                "sense_id": "fc37f157-60a4-3c94-8149-dafa2ddf9a0f",
                                "text": "— Как ты? — Фи́фти-фи́фти.",
                                "translation": "— How are you? — Not the best.",
                                "english": "— How are you? — Not the best."
                            },
                            {
                                "example_id": "c57587e0-2db5-457b-8c2c-af24eb61b8ec",
                                "sense_id": "fc37f157-60a4-3c94-8149-dafa2ddf9a0f",
                                "text": "Они́ говоря́т по-англи́йски фи́фти-фи́фти.",
                                "translation": "They don't speak English very well.",
                                "english": "They don't speak English very well."
                            }
                        ]
                    },
                    {
                        "sense_id": "29eed6cf-c74f-3c44-9272-1bd4e4d14add",
                        "entry_id": "a74f769b-561e-3368-bc7b-d97d90bfd5a2",
                        "glosses": [
                            "kind of, sort of, to some extent, a little, not much, not particularly"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "637817ba-7f5e-4914-b791-57818b5dc9e2",
                                "sense_id": "29eed6cf-c74f-3c44-9272-1bd4e4d14add",
                                "text": "— Хо́чешь присоедини́ться? — Фи́фти-фи́фти.",
                                "translation": "— Do you want to join? — Maybe.",
                                "english": "— Do you want to join? — Maybe."
                            }
                        ]
                    }
                ],
