                                        "sense_id": "240e6dfe-2b29-3e46-ae0e-18a417477213",
                                        "entry_id": "f0eb8138-0d94-3616-b822-b6681441b549",
                                        "glosses": [
                                            "een (tijdelijk, armoedig) optrekje waar stro als een van de bouwmaterialen is gebruikt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab963631-8097-47a7-92cd-84b5775f435d",
                                                "sense_id": "240e6dfe-2b29-3e46-ae0e-18a417477213",
                                                "text": "Voor de kinderen is er van alles en nog wat te doen: spelen in de strohut of de speeltuin, hutten bouwen in het bos, mee op de trekker, ponyrijden, helpen in de moestuin, aardappels rooien op het land of pannenkoeken bakken."
                                            },
                                            {
                                                "example_id": "fc4b4518-821e-4cf8-98bf-296ab2387d4d",
                                                "sense_id": "240e6dfe-2b29-3e46-ae0e-18a417477213",
                                                "text": "De vloedgolf die op de aardbeving volgde, zou vooral de strohutten in de buurt van het strand vernield hebben."
                                            }
                                        ]
                                    }
                                ]
                            }
