                    "sense_id": "c3d8d1db-793b-3500-ae71-64ab1b6d5d50",
                    "sense_definition": "zorgen dat men niet achterblijft bij de voortgang van iets",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "voortgang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij is niet <w>bijgebleven</w> bij de snelle technologische ontwikkelingen van de laatste jaren.",
                            "target_lang_translations": {
                                "en": "He hasn't <w>kept up</w> with the rapid technological developments of recent years."
                            }
                        },
                        {
                            "text": "Het is belangrijk om goed <w>bij te blijven</w> met je huiswerk tijdens de vakantie.",
                            "target_lang_translations": {
                                "en": "It is important to <w>keep up</w> with your homework during the holidays."
                            }
                        }
                    ],
                    "synonyms": [
                        "bijhouden",
                        "volgen"
                    ],
                    "antonyms": [
                        "achterblijven"
                    ],
                    "common_phrases": [
                        "bij de tijd blijven",
                        "bij de les blijven",
                        "goed bijblijven"
                    ],
                    "target_lang_definitions": {
                        "en": "to ensure that one does not fall behind in the progress of something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "keep up",
                                "target_lang_sense_clarification": "to stay at the same level or pace as others"
                            },
                            {
                                "target_lang_word": "stay up to date",
                                "target_lang_sense_clarification": "to remain informed about current developments"
                            },
                            {
                                "target_lang_word": "keep pace",
                                "target_lang_sense_clarification": "to move or progress at the same speed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09f75359-77dd-3de0-bc6e-c14358d4bc16",
                    "sense_definition": "in iemands herinnering of geheugen aanwezig blijven",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "herinnering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die verschrikkelijke gebeurtenissen zijn hem zijn hele leven <w>bijgebleven</w>.",
                            "target_lang_translations": {
                                "en": "Those terrible events have <w>stuck with</w> him his whole life."
                            }
                        },
                        {
                            "text": "Sommige lessen van de basisschool zullen me altijd <w>bijblijven</w>.",
                            "target_lang_translations": {
                                "en": "Some lessons from primary school will always <w>stay with</w> me."
                            }
                        }
                    ],
                    "synonyms": [
                        "onthouden",
                        "heugen"
                    ],
                    "common_phrases": [
                        "altijd bijblijven",
                        "in het geheugen bijblijven"
                    ],
                    "target_lang_definitions": {
                        "en": "to remain present in someone's memory or mind"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stick with",
                                "target_lang_sense_clarification": "to be remembered clearly over time"
                            },
                            {
                                "target_lang_word": "stay with",
                                "target_lang_sense_clarification": "to remain in one's thoughts or memory"
                            },
                            {
                                "target_lang_word": "remain",
