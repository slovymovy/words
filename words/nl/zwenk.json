                            }
                        },
                        {
                            "text": "Wanneer ik op de fiets zit, <w>zwenk</w> ik soms snel uit voor obstakels.",
                            "target_lang_translations": {
                                "en": "When I am on my bicycle, I sometimes <w>swerve</w> quickly to avoid obstacles."
                            }
