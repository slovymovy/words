                "senses": [
                    {
                        "sense_id": "4fbeb601-97fa-330b-b249-06c3a3c3a8ba",
                        "entry_id": "7907ae40-1033-36ef-a0cb-19ee4b1f8f78",
                        "glosses": [
                            "специалист по изготовлению котлов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d4526c6-12b5-4857-b64a-1d40c98a1e73",
                                "sense_id": "4fbeb601-97fa-330b-b249-06c3a3c3a8ba",
                                "text": "Одна из самых сложных операций в работе котельщиков — сборка трубчатых пучков теплообменников."
                            }
                        ]
                    },
                    {
                        "sense_id": "13c3abd1-8fc7-3483-ae8b-e0fe62ec37de",
                        "entry_id": "7907ae40-1033-36ef-a0cb-19ee4b1f8f78",
                        "glosses": [
                            "специалист по обслуживанию и эксплуатации котлов, следящий за их нормальным функционированием"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12fbdee8-9323-432f-9688-cf137baf0c13",
                                "sense_id": "13c3abd1-8fc7-3483-ae8b-e0fe62ec37de",
                                "text": "❬…❭ Степан Артюхин — агент железнодорожной Чека, недавно ещё котельщик среднего ремонта."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
