                "senses": [
                    {
                        "sense_id": "82f4dfc7-d3ab-3021-ad26-a33daf696961",
                        "entry_id": "74b9a407-8b7f-3750-80df-e1e768800274",
                        "glosses": [
                            "het grootste tandwiel van de voor derailleur van een fiets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58ab8d08-8e57-4f6c-a05f-5288d65a8350",
                                "sense_id": "82f4dfc7-d3ab-3021-ad26-a33daf696961",
                                "text": "Een peloton dat alle dagen van start tot finish volle bak over de Franse wegen reed en bergop veelal op het buitenblad. Er werd veel over het wondermiddel epo gesproken. In 1997 besloot ik voor het eerst voor de Tour epo te gaan gebruiken (bij de Dopingautoriteit zal ik mijn hele verhaal vertellen). Dit was een stom besluit, maar in mijn ogen wel een beslissing die ik moest nemen. Ik had het gevoel dat ik op een splitsing stond. Epo nemen en grote koersen rijden of het zou heel moeilijk zijn om een behoorlijke prof te zijn. Het was een tweestrijd!"
                            },
                            {
                                "example_id": "943da6bf-65f4-445d-820e-a134a0921a49",
                                "sense_id": "82f4dfc7-d3ab-3021-ad26-a33daf696961",
                                "text": "Gilbert vertelde dat hij op de tiende en laatste beklimming van de Cauberg op het buitenblad reed, terwijl de meeste concurrenten op het binnenblad fietsten. \"Ik kreeg tien, twintig meter voorsprong en toen heb ik niet meer getwijfeld.\""
                            }
                        ]
                    }
