                        "entry_id": "57690ec9-3a24-3153-9a8b-071fc7d15ebd",
                        "tags": [
                            "participle",
                            "active",
                            "past"
                        ],
                        "form": "зали́пший"
                    },
                    {
                        "form_id": "7258ae2e-8c0f-4f0d-9cad-a1e12ae01f84",
                        "entry_id": "57690ec9-3a24-3153-9a8b-071fc7d15ebd",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "зали́пши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "09d8cd53-4690-3b48-8ab9-2495620d8a79",
                        "entry_id": "57690ec9-3a24-3153-9a8b-071fc7d15ebd",
                        "glosses": [
                            "разг. замазаться чем-либо липким"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1927b96b-bb43-4df7-8b28-51d68e2429c3",
                                "sense_id": "09d8cd53-4690-3b48-8ab9-2495620d8a79",
                                "text": "Раздеваясь, увидал, что кровью густо залипла ладонь."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f263345-02c9-3bec-b878-09e5d76c51f1",
                        "entry_id": "57690ec9-3a24-3153-9a8b-071fc7d15ebd",
                        "glosses": [
                            "разг. слипнуться, склеиться, слепиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a24fe515-85fa-4e15-a44c-6b41db4ada49",
                                "sense_id": "1f263345-02c9-3bec-b878-09e5d76c51f1",
                                "text": "На бороде Антона липко, с усов стекает, губы у меня залипли."
                            },
                            {
                                "example_id": "c665145f-4156-4cf3-bd70-0563050d6e6c",
                                "sense_id": "1f263345-02c9-3bec-b878-09e5d76c51f1",
                                "text": "Привалившись на бревнах около блиндажа, опять Сашка почувствовал, как сморила его усталость ― обмякло тело, залипли веки, зазевалось."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1c847cd-f518-3b84-a10d-8833239e7e49",
                        "entry_id": "57690ec9-3a24-3153-9a8b-071fc7d15ebd",
                        "glosses": [
                            "перен., разг. застыть в каком-либо положении; застрять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49bf6524-0ce9-4c8a-92bd-f8a7ececda8e",
                                "sense_id": "f1c847cd-f518-3b84-a10d-8833239e7e49",
                                "text": "…объезжать Волгоградский Саша не стала и теперь залипла между бензовозом и КамАЗом, гружённым углем."
                            },
                            {
                                "example_id": "2a301241-c770-4e05-8343-ef590b28f660",
                                "sense_id": "f1c847cd-f518-3b84-a10d-8833239e7e49",
                                "text": "Инициатива связана с выявленной более полугода назад неисправностью в нескольких моделях автомобилей Toyota: во время движения у машин могла «залипнуть» педаль акселератора."
                            },
                            {
                                "example_id": "66c3da37-6aff-41e3-904d-da2f9abb8cce",
                                "sense_id": "f1c847cd-f518-3b84-a10d-8833239e7e49",
                                "text": "Если кнопка «залипла» или замкнуло цепь, то на малых скоростях поправить ситуацию экипаж не мог…"
                            }
                        ]
                    },
                    {
                        "sense_id": "73b61467-ef46-31b8-8332-da7f4d1319d8",
                        "entry_id": "57690ec9-3a24-3153-9a8b-071fc7d15ebd",
                        "glosses": [
                            "перен., разг. страстно увлечься кем-либо, чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da288520-9445-4cb5-a221-127022a22a84",
                                "sense_id": "73b61467-ef46-31b8-8332-da7f4d1319d8",
                                "text": "На Петрова залипла совершенно лишняя в этой драме поэтесса Ковалёва, математичка из его же школы."
                            },
                            {
                                "example_id": "ee2bfbec-da53-44a1-b52b-f444674040ed",
                                "sense_id": "73b61467-ef46-31b8-8332-da7f4d1319d8",
                                "text": "Я коротко сообщил Бернару-Анри о своей находке, передал девичью мордашку на его маниту, и он мгновенно на нее залип, я это по дыханию понял."
                            }
                        ]
                    }
                ],
                "translations": [],
