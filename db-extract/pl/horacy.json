                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Horace",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60c431f0-f7eb-34c3-9514-7dcc5b93b240",
                                        "entry_id": "bbf0b0e3-d4b2-3da9-b689-66fe9b6f6096",
                                        "glosses": [
                                            "Nom des membres de la gens romaine patricienne Horatia."
                                        ],
                                        "tags": [
                                            "Ancient-Roman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd01bb05-d206-48c7-bef5-1af91dbe0851",
                                                "sense_id": "60c431f0-f7eb-34c3-9514-7dcc5b93b240",
                                                "text": "Le Serment des Horaces."
                                            },
                                            {
                                                "example_id": "b02e6565-53be-4339-8765-b93674ca1d30",
                                                "sense_id": "60c431f0-f7eb-34c3-9514-7dcc5b93b240",
                                                "text": "Le combat des Horaces et des Curiaces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d8a49fa-c4dc-3ae5-ba40-2354a9efc7c9",
                                        "entry_id": "bbf0b0e3-d4b2-3da9-b689-66fe9b6f6096",
                                        "glosses": [
                                            "Celui des trois Horaces survivant au combat légendaire mené contre les trois Curiaces au VIIᵉ siècle avant notre ère."
                                        ],
                                        "tags": [
                                            "Mythologie romaine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98473982-e7e6-4b60-82b6-24ab02edf219",
                                                "sense_id": "6d8a49fa-c4dc-3ae5-ba40-2354a9efc7c9",
                                                "text": "Comment ne pas partager la morne tristesse que laisse paraître Curiace, lorsqu’il apprend que le sort l’a désigné pour combattre contre Horace, le mari de sa sœur, le frère de sa fiancée ?"
                                            },
                                            {
                                                "example_id": "82a67e5f-5942-483d-8d6b-484571da089a",
                                                "sense_id": "6d8a49fa-c4dc-3ae5-ba40-2354a9efc7c9",
                                                "text": "Horace, chargé de son triple trophée, marchait à la tête des Romains"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "077848cb-3d5e-38c7-936f-996dce8139c6",
                                        "entry_id": "bbf0b0e3-d4b2-3da9-b689-66fe9b6f6096",
                                        "glosses": [
                                            "Quintus Horatius Flaccus, poète latin né en -65 et décédé en -8."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "069c17fc-0e5d-4c88-8ce1-11ff9c85aea6",
                                                "sense_id": "077848cb-3d5e-38c7-936f-996dce8139c6",
                                                "text": "Trissotin : Va, va restituer tous les honteux larcins\nQue réclament sur toi les Grecs et les Latins.\nVadius : Va, va-t'en faire amende honorable au Parnasse,\nD'avoir fait à tes vers estropier Horace."
                                            },
                                            {
                                                "example_id": "8010dcbe-8813-4f63-bea5-e384315d81e5",
                                                "sense_id": "077848cb-3d5e-38c7-936f-996dce8139c6",
                                                "text": "Lenglumé.– Moi, d’abord, j’ai le vin tendre… j’ai le falerne tendre !… comme dit Horace… Horatius !…\nMistingue.– Coclès…\nLenglumé.– Non… Flaccus ! Tu dois connaître ça, un prix de vers latins !\nMistingue.– Faiblement !… faiblement !…"
                                            },
                                            {
                                                "example_id": "48544fca-f00b-460d-be0e-d3d9a0ae4f4c",
                                                "sense_id": "077848cb-3d5e-38c7-936f-996dce8139c6",
                                                "text": "Lecture et écriture autorisent donc la maîtrise de la langue et l’exercice qui combine le mieux ces deux usus quotidiens, c’est la rétroversion, d’abord des textes cicéroniens puis plus tard des textes empruntés à Virgile et à Horace."
                                            }
                                        ]
                                    }
                                ]
                            },
