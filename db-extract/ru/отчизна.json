                    }
                ],
                "senses": [
                    {
                        "sense_id": "358ee47d-28f1-3fad-be6c-5fdb3414499c",
                        "entry_id": "591fd391-935a-37ba-9e87-158750ee6640",
                        "glosses": [
                            "поэт., высок. отечество, родина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "600186a5-7925-452c-8c7a-db9703373d30",
                                "sense_id": "358ee47d-28f1-3fad-be6c-5fdb3414499c",
                                "text": "— Скучно, государь — сказал я, — за границей: меня измучила тоска по отчизне, и я воротился месяцем прежде срока отпуска."
                            },
                            {
                                "example_id": "bbe04be4-4fcb-4bcb-8e1e-712586195f89",
                                "sense_id": "358ee47d-28f1-3fad-be6c-5fdb3414499c",
                                "text": "Люблю отчизну я, но странною любовью! // Не победит её рассудок мой. // Ни слава, купленная кровью, // Ни полный гордого доверия покой…"
                            },
                            {
                                "example_id": "948c4c02-9006-4349-b6bd-fd067b86caa9",
                                "sense_id": "358ee47d-28f1-3fad-be6c-5fdb3414499c",
                                "text": "Лишаемые отчизны, плакали; оставленные в ней, трепетали."
                            },
                            {
                                "example_id": "eef4d1a4-7d83-4d60-9750-5ad4539e2c0b",
                                "sense_id": "358ee47d-28f1-3fad-be6c-5fdb3414499c",
                                "text": "Кто сказал, что моя отчизна Украйна? Кто дал мне её в отчизны? Отчизна есть то, чего ищет душа наша, что милее для неё всего."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d113f70-245a-4315-828c-88e052393611",
                        "source_entry_id": "591fd391-935a-37ba-9e87-158750ee6640",
                        "source_sense_id": "358ee47d-28f1-3fad-be6c-5fdb3414499c",
