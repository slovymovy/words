                                        "entry_id": "1c827973-3ea5-376c-acdb-6ee86552834a",
                                        "glosses": [
                                            "D'une manière habile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42402c13-e6c8-4878-b8f0-eb7b94fc3d41",
                                                "sense_id": "d910be51-9783-3194-99a4-3bacda006ae1",
                                                "text": "Les femmes ne vont jamais dans les kayaks, mais elles manient assez habilement les « omayaks », sortes de grands canots pouvant porter de lourdes charges."
                                            },
                                            {
                                                "example_id": "701e2888-4700-41ba-8cdd-c4aee0c449cd",
                                                "sense_id": "d910be51-9783-3194-99a4-3bacda006ae1",
                                                "text": "Il s’est tiré habilement d’affaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc8f56ac-8e98-4810-b998-7b82156efc1a",
                        "source_entry_id": "efd8e86d-95d5-3a19-b213-de8d1c185151",
                        "source_sense_id": "778fbfe6-a39d-3181-874f-15369008874f",
