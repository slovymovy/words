                ],
                "senses": [
                    {
                        "sense_id": "e036f1ef-06aa-3c79-9ec8-2a1c1f9d5724",
                        "entry_id": "fb72e20b-1b26-3c39-b379-64ac375e43ce",
                        "glosses": [
                            "ein Naturphänomen, das beschrieben und direkt oder indirekt bewiesen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fb1d1d0-18c5-4ea6-8084-0573cdcd35bc",
                                "sense_id": "e036f1ef-06aa-3c79-9ec8-2a1c1f9d5724",
                                "text": "Es ist ein Naturgesetz, dass sich Licht nicht schneller als mit Lichtgeschwindigkeit ausbreiten kann."
                            },
                            {
                                "example_id": "542e830d-4fc2-4882-8bc1-6c949da4c73a",
                                "sense_id": "e036f1ef-06aa-3c79-9ec8-2a1c1f9d5724",
                                "text": "„Es ist wirklich kein Naturgesetz, dass im Alter alles schlimmer wird.“"
                            },
                            {
                                "example_id": "3dc3ecba-6038-43b6-9af9-d8b5e2198d90",
                                "sense_id": "e036f1ef-06aa-3c79-9ec8-2a1c1f9d5724",
                                "text": "„Es gelang durch sie, die Naturgesetze äußerst genau zu formulieren und ihnen durch die Prüfung an der Erfahrung auch einen hohen Grad an Sicherheit, an wissenschaftlicher Wahrheit zuzusprechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
