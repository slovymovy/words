                    {
                        "sense_id": "b754c024-1da2-3d46-8693-ffb972f8efb3",
                        "entry_id": "4df5c3c9-935d-30bb-9897-575a099b9a1f",
                        "glosses": [
                            "Nom donné à plusieurs espèces de corégones des lacs d’Amérique du Nord."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "68e886a9-9d08-49d7-bada-126b5df6f88b",
                                "sense_id": "b754c024-1da2-3d46-8693-ffb972f8efb3",
                                "text": "Les ciscos sont généralement de couleur argentée, mais de nombreuses espèces arborent des couleurs différentes."
                            },
                            {
                                "example_id": "a4b13b58-dda7-4463-bed5-e89e69b0cf54",
                                "sense_id": "b754c024-1da2-3d46-8693-ffb972f8efb3",
                                "text": "Donc, si jamais vous capturez un petit corégone, regardez-le attentivement car il pourrait bien s’agir d’un cisco."
                            },
                            {
                                "example_id": "aaf0020a-3900-4a1d-b33a-2937f4a20873",
                                "sense_id": "b754c024-1da2-3d46-8693-ffb972f8efb3",
                                "text": "Le cisco à mâchoires égales est très répandu au Canada, son aire de répartition englobant les Grands Lacs Laurentiens et tout le centre du Canada jusqu’aux Territoires du Nord-Ouest."
                            },
                            {
                                "example_id": "d6965b4c-eef5-47a9-884d-08d6c7a50b5f",
                                "sense_id": "b754c024-1da2-3d46-8693-ffb972f8efb3",
                                "text": "Deux espèces de ciscos, Coregonus nigripennus et C. johannae, vivaient dans Grands Lacs américains de Huron et de Michigan."
                            }
                        ]
                    }
                ],
