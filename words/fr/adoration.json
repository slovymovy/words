    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ec44ec59-9e75-3a86-a85b-c7b3cc795c2f",
                    "sense_definition": "Amour passionné ou attachement très vif envers une personne ou une chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "amour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune homme vouait une véritable <w>adoration</w> à sa grand-mère qui l'avait élevé."
                        },
                        {
                            "text": "Son <w>adoration</w> sans bornes pour ce groupe de musique surprenait tous ses amis."
                        }
                    ],
                    "synonyms": [
                        "culte",
                        "passion",
                        "vénération"
                    ],
                    "antonyms": [
                        "aversion",
                        "haine",
                        "mépris"
                    ],
                    "common_phrases": [
                        "adoration sans bornes",
                        "vouer une adoration"
                    ]
                },
                {
                    "sense_id": "a6a8c1cf-2747-3a3c-957a-2cd4249fa091",
                    "sense_definition": "Culte et hommage suprême rendus à Dieu ou à une divinité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fidèles se rassemblent chaque dimanche dans ce lieu d'<w>adoration</w> pour prier ensemble."
                        },
                        {
                            "text": "Dans cette tradition religieuse, l'<w>adoration</w> est réservée exclusivement à l'Être suprême."
                        }
                    ],
                    "synonyms": [
                        "ferveur",
                        "vénération"
                    ],
                    "antonyms": [
                        "blasphème",
                        "sacrilège"
                    ],
                    "common_phrases": [
                        "lieu d'adoration"
                    ]
                },
                {
                    "sense_id": "aac77908-9219-3c16-b79d-7dd849aa149a",
                    "sense_definition": "Prière ou hommage rendu au Saint-Sacrement dans la liturgie et la dévotion catholiques.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La paroisse organise une veillée d'<w>adoration</w> eucharistique tous les premiers vendredis du mois."
                        },
                        {
                            "text": "Plusieurs religieuses se relaient jour et nuit pour assurer l'<w>adoration</w> perpétuelle dans la chapelle."
                        }
                    ],
                    "common_phrases": [
                        "adoration eucharistique",
                        "adoration perpétuelle"
                    ]
                },
                {
                    "sense_id": "138e41a6-7b77-3102-96e7-fee642565dcc",
                    "sense_definition": "Cérémonie par laquelle les cardinaux rendent hommage au pape nouvellement élu.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la proclamation du scrutin, les cardinaux se sont avancés pour l'<w>adoration</w> du nouveau souverain pontife."
                        },
                        {
                            "text": "Ce rituel d'<w>adoration</w> suit immédiatement l'acceptation de la charge papale dans la chapelle Sixtine."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2ea7e440-8beb-3f3a-b9bb-37d4732ac441",
                    "sense_definition": "Prénom féminin d'inspiration religieuse, surtout attesté dans le monde hispanique.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Elle s'appelait <w>Adoration</w>, un prénom hérité de sa grand-mère originaire d'Andalousie."
                        },
                        {
                            "text": "Le registre de naissance mentionnait qu'<w>Adoration</w> avait vu le jour au début des années trente."
                        }
                    ]
                }
            ]
        }
    ]
