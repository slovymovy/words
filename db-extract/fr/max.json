            {
                "entry_id": "6b7efadb-bb7d-3e05-850f-fe318d4352a5",
                "word": "Max",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9cca09e9-9eb7-3c97-a3e8-5235115db138",
                        "entry_id": "6b7efadb-bb7d-3e05-850f-fe318d4352a5",
                        "glosses": [
                            "Prénom masculin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f30dd59-a77e-48f4-a5e8-168ff54ee0ae",
                                "sense_id": "9cca09e9-9eb7-3c97-a3e8-5235115db138",
                                "text": "Ses desseins à l’égard de cette enfant, qu’il décrassait, instruisait et formait avec des soins d’autant plus touchants qu’on le croyait incapable de tendresse, furent diversement interprétés par la caqueteuse bourgeoisie de la ville, dont les disettes accréditaient, comme à propos de la naissance de Max et d’Agathe, de fatales erreurs."
                            },
                            {
                                "example_id": "1c5c8da9-2041-4105-a789-039672d20770",
                                "sense_id": "9cca09e9-9eb7-3c97-a3e8-5235115db138",
                                "text": "Le téléphone sonna trois fois et Max parla longuement, en fumant."
                            },
                            {
                                "example_id": "4525c531-1322-4ef3-b87c-ed9014235afc",
                                "sense_id": "9cca09e9-9eb7-3c97-a3e8-5235115db138",
                                "text": "Laurel et Hardy, Charlot, Harold Lloyd, Fatty, Buster Keaton, Doublepatte et Patachon, Beaucitron, Max Linder, Fil-de-Fer, Félix-le-Chat qu’est du dessin animé…"
                            },
                            {
                                "example_id": "3e0cfb40-2647-4670-9a87-65d2d2ff55f4",
                                "sense_id": "9cca09e9-9eb7-3c97-a3e8-5235115db138",
                                "text": "Max Verstappen, parti 7ᵉ, a profité d’une fin de course passée sous le régime de la safety car, alors qu’il occupait la première place, pour l’emporter devant Charles Leclerc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "beb116b8-1002-483b-b585-c6c56c3ac148",
                        "source_entry_id": "6b7efadb-bb7d-3e05-850f-fe318d4352a5",
                        "source_sense_id": "9cca09e9-9eb7-3c97-a3e8-5235115db138",
                        "target_lang_word": "Max",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Max",
