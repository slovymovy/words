                        "glosses": [
                            "Nom vulgaire et spécifique du canard chipeau, dit encore ridenne et ridelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b7c21b5-8a34-4fc1-8fd4-0831a3b63f49",
                                "sense_id": "e4dcec91-d848-3614-887a-3848310029d0",
                                "text": "Les canards de surface peuvent être granivores (sarcelle, colvert, pilet), herbivores (siffleur, chipeau), planctophages (souchet)."
                            },
                            {
                                "example_id": "aba5b177-37eb-4c06-b66b-cca6f2b3f2fa",
                                "sense_id": "e4dcec91-d848-3614-887a-3848310029d0",
                                "text": "Les marécages naturels qui subsistent encore, ainsi que les réservoirs d'eau creusés par les éleveurs, créent autant de havres de paix pour les familles de colverts, de sarcelles, de chipeaux, de pilets, de siffleurs, de souchets, de fuligules à tête rouge et à tête noire, et même de quelques fuligules à dos blanc."
                            }
                        ]
                    }
