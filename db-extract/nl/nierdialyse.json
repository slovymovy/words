                        "examples": [
                            {
                                "example_id": "409c6290-f260-444a-8c68-cbd66e1302e3",
                                "sense_id": "360b5a2d-f60d-3a42-8677-318c9cc8697e",
                                "text": "De evacuatie van mensen met een medische urgentie van Sint-Maarten is afgerond. Dat had de hoogste prioriteit. Het ging bijvoorbeeld om patiënten die een nierdialyse nodig hadden, of mensen die net een operatie achter de rug hadden."
                            },
                            {
                                "example_id": "2c6205a4-66c2-42e3-836e-eb875cf11e3c",
                                "sense_id": "360b5a2d-f60d-3a42-8677-318c9cc8697e",
                                "text": "Pelé werd begin vorige week opgenomen met een infectie aan de urinewegen. Na enkele dagen werd hij overgeplaatst naar een gespecialiseerde afdeling (soort intensive care) waar hij van dichterbij kon worden opgevolgd. De drievoudige wereldkampioen onderging er onder meer een nierdialyse."
                            }
                        ]
