{
    "word_family": [
        "ambassadeur",
        "ambassadrice"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b0e2db9-40e7-3b41-aa87-b88dd307684e",
                    "sense_definition": "Bâtiment ou résidence officielle où sont installés les services d'un ambassadeur dans un pays étranger.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "diplomatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les manifestants se sont réunis pacifiquement devant l'<w>ambassade</w> pour faire entendre leurs revendications."
                        },
                        {
                            "text": "Nous devons nous rendre à l'<w>ambassade</w> demain matin afin de renouveler nos passeports."
                        }
                    ],
                    "synonyms": [
                        "chancellerie"
                    ]
                },
                {
                    "sense_id": "2dd756cb-df9f-3b70-aec0-bdc4d5e8d495",
                    "sense_definition": "Représentation diplomatique permanente d'un État auprès d'un autre État, ou ensemble du personnel qui la compose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "diplomatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>ambassade</w> du Canada a publié un communiqué officiel concernant les accords économiques bilatéraux."
                        },
                        {
                            "text": "Chaque membre de l'<w>ambassade</w> participe activement aux discussions entre les deux nations."
                        }
                    ],
                    "synonyms": [
                        "légation"
                    ],
                    "common_phrases": [
                        "attaché d'ambassade"
                    ]
                },
                {
                    "sense_id": "2ae9d67d-fd93-3b3d-8991-cd4799a66a0d",
                    "sense_definition": "Fonction, charge d'un ambassadeur ou durée de l'exercice de son mandat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "diplomatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le traité de paix a été signé pendant son <w>ambassade</w> dans la capitale espagnole."
                        },
                        {
                            "text": "Il a accompli des progrès considérables au cours de sa longue <w>ambassade</w> à Rome."
                        }
                    ]
                },
                {
                    "sense_id": "4d61eef2-b937-3122-91e6-f72d70ded3c2",
                    "sense_definition": "Mission extraordinaire ou députation temporaire envoyée auprès d'un souverain ou d'une autorité étrangère.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "diplomatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le roi a décidé d'envoyer une <w>ambassade</w> auprès de la cour voisine pour négocier une trêve."
                        },
                        {
                            "text": "Le souverain a reçu une <w>ambassade</w> prestigieuse venue d'Orient avec de précieux présents."
                        }
                    ],
                    "synonyms": [
                        "députation",
                        "délégation"
                    ],
                    "common_phrases": [
                        "envoyer une ambassade",
                        "recevoir une ambassade"
                    ]
                },
                {
                    "sense_id": "39389566-6025-3954-92c6-47f68acac07e",
                    "sense_definition": "Message ou démarche délicate que l'on effectue pour le compte d'autrui auprès de quelqu'un.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a refusé catégoriquement de se charger d'une telle <w>ambassade</w> auprès de son directeur."
                        },
                        {
                            "text": "Mon cousin est venu en <w>ambassade</w> pour tenter de réconcilier nos deux familles brouillées."
                        }
                    ],
                    "synonyms": [
                        "commission",
                        "message"
                    ],
                    "common_phrases": [
                        "aller en ambassade",
                        "se charger d'une ambassade"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "au sens figuré"
                        }
                    ]
                }
            ]
        }
    ]
