                "translations": [
                    {
                        "translation_id": "741b4b98-3d9f-43e6-81e9-751202b3764c",
                        "source_entry_id": "f729fc44-b06d-3ceb-8882-bcdef45a7ee3",
                        "source_sense_id": "87dcc489-cb7a-34eb-b214-3b92365563da",
                        "source_sense_description": "Fähigkeit, Zahlungsverpflichtungen zu entsprechen",
                        "target_lang_word": "liquidity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liquidity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80878125-9a0e-3ee4-8332-5a15a62c25c3",
                                        "entry_id": "7731afb8-e1f7-3829-9769-726434ed88d1",
                                        "glosses": [
                                            "The degree of which something is in high supply and demand, making it easily convertible to cash."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f4e6689-a863-3b18-8539-aa7f8502e62e",
                                        "entry_id": "7731afb8-e1f7-3829-9769-726434ed88d1",
                                        "glosses": [
                                            "The state or property of being liquid."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05e54e0b-fbd9-3fe1-868b-85e726064ccd",
                                        "entry_id": "7731afb8-e1f7-3829-9769-726434ed88d1",
                                        "glosses": [
                                            "An asset's property of being able to be sold without affecting its value; the degree to which it can be easily converted into cash."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef622479-3a7b-4291-9832-fb3aa0d70b1f",
                                                "sense_id": "05e54e0b-fbd9-3fe1-868b-85e726064ccd",
                                                "text": "Some stocks are traded so rarely that they lack liquidity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a56acc4-3147-3aa6-9630-89932dd05648",
                                        "entry_id": "7731afb8-e1f7-3829-9769-726434ed88d1",
                                        "glosses": [
                                            "Availability of cash over short term: ability to service short-term debt."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc3fcab4-c5ef-4541-8c01-fec823596481",
                                                "sense_id": "4a56acc4-3147-3aa6-9630-89932dd05648",
                                                "text": "This is often phrased in terms of whether they are facing liquidity or solvency problems; but I think it’s better phrased in terms of the possibility of self-fulfilling crises, a la Obstfeld."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87381013-613e-493d-9967-1e4db69d6740",
                        "source_entry_id": "f729fc44-b06d-3ceb-8882-bcdef45a7ee3",
                        "source_sense_id": "87dcc489-cb7a-34eb-b214-3b92365563da",
                        "source_sense_description": "Fähigkeit, Zahlungsverpflichtungen zu entsprechen",
                        "target_lang_word": "ρευστότητα",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ρευστότητα",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "7899b725-186e-3cdb-ae65-9d7b8571f10e",
                                        "entry_id": "e6898afd-2c7f-3aa4-9e5f-2149478cc7dd",
                                        "glosses": [
                                            "η ιδιότητα των ρευστών (υγρών και αερίων) σωμάτων να κινούνται και να μεταβάλλουν το σχήμα τους"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a12975dc-569f-3c9f-835b-bcfa5ccba91c",
                                        "entry_id": "e6898afd-2c7f-3aa4-9e5f-2149478cc7dd",
                                        "glosses": [
                                            "η ιδιότητα μιας κατάστασης που είναι ρευστή, ασταθής, που βρίσκεται σε διαρκή μεταβολή"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b54f9ca-0e6f-47db-be49-ef7dd4895a5a",
                                                "sense_id": "a12975dc-569f-3c9f-835b-bcfa5ccba91c",
                                                "text": "※ Εξετάζει επίσης τα ιστορικά συμφραζόμενα της πρόσληψης αυτών των αναγνωσμάτων, αναδεικνύοντας τους ανταγωνισμούς των διαφορετικών πολιτισμικών και διανοητικών παραδόσεων (επτανησιακή και φαναριώτικη παράδοση, κοραϊκή σκέψη), τους διαξιφισμούς για το γλωσσικό ζήτημα, τη ρευστότητα του λογοτεχνικού κανόνα αλλά και τον ρόλο του Κρητικού Ζητήματος στον καιρό της Μεγάλης Ιδέας.",
                                                "translation": "Σύνοψη του βιβλίου Από το λαϊκό ανάγνωσμα στην εθνική φιλολογία του Αλέξανδρου Κατσίγιαννη, Πανεπιστημιακές Εκδόσεις Κρήτης, 2025"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ecf4a22-9c9b-3169-9445-2d798ac1f38e",
                                        "entry_id": "e6898afd-2c7f-3aa4-9e5f-2149478cc7dd",
                                        "glosses": [
                                            "η ύπαρξη του αναγκαίου χρήματος σε μετρητά"
                                        ],
                                        "tags": [
                                            "οικονομία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30ccb851-180e-468e-8bec-d02ee9f7d1bf",
                                                "sense_id": "8ecf4a22-9c9b-3169-9445-2d798ac1f38e",
                                                "text": "※ Mε αμείωτο ρυθμό συνεχίστηκε και τον Ιούνιο η μείωση των χορηγήσεων σε επιχειρήσεις και νοικοκυριά, με αποτέλεσμα η αγορά να έχει στεγνώσει από ρευστότητα. (εφ. Ελευθεροτυπία, 25/7/2014)"
                                            },
                                            {
                                                "example_id": "40ee9080-c8a3-45b6-90e0-af1389ae7ef2",
                                                "sense_id": "8ecf4a22-9c9b-3169-9445-2d798ac1f38e",
                                                "text": "※ Η διαδικασία της ανακεφαλαιοποίησης και η σταθεροποίηση του ελληνικού τραπεζικού συστήματος αποτελούν βασική προϋπόθεση για την παροχή ρευστότητας στην πραγματική οικονομία και άρα και για την πολυπόθητη ανάκαμψη. (εφημερδία Το Βήμα, 31/8/2012)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10f91c3a-2587-380b-9217-ade2a34c806c",
                                        "entry_id": "e6898afd-2c7f-3aa4-9e5f-2149478cc7dd",
                                        "glosses": [
                                            "η αστάθεια"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0a7c4aa-a652-4bc4-b471-e70d2a731a49",
                                                "sense_id": "10f91c3a-2587-380b-9217-ade2a34c806c",
                                                "text": "※ μετά το Δεύτερο Παγκόσμιο Πόλεμο, οι μεγάλες ευρωπαϊκές δυνάμεις αντιμετώπησαν οικονομικά προβλήματα και ρευστότητα στις αποικίες"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
