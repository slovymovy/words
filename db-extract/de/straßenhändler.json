                ],
                "senses": [
                    {
                        "sense_id": "1c02e77d-ae25-3897-b062-1f1652d55304",
                        "entry_id": "052ea035-731f-3e02-84eb-f0700db72dd0",
                        "glosses": [
                            "Verkäufer, der seine Waren auf der Straße anbietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e2de3c8-c993-41f6-81ab-af85d52de838",
                                "sense_id": "1c02e77d-ae25-3897-b062-1f1652d55304",
                                "text": "Der Straßenhändler hatte nur Kleingeld in der Kasse."
                            },
                            {
                                "example_id": "b2f6e6ff-890e-44ed-a83a-2ffbaf6b9d04",
                                "sense_id": "1c02e77d-ae25-3897-b062-1f1652d55304",
                                "text": "„Manchmal glaubte sie, dass die Postboten ihre Briefe an Straßenhändler verkauften, damit diese die Mahlzeiten für ihre Kunden darin einpacken konnten.“"
                            },
                            {
                                "example_id": "fb8e7cf1-ccef-4216-8afa-82184337fe6e",
                                "sense_id": "1c02e77d-ae25-3897-b062-1f1652d55304",
                                "text": "„Straßenhändler, die sich mit zerschlissenen Golfschirmen vor der Sonne schützten, verkauften schwarze Bananen und gelbe Apfelsinen; an den Ständen neben ihnen wurden lautstark Telefonkarten gehandelt, Afrikas neuester, boomender Industriezweig.“"
                            },
                            {
                                "example_id": "fb9eb24f-bb97-49c7-95a4-69def445bc78",
                                "sense_id": "1c02e77d-ae25-3897-b062-1f1652d55304",
                                "text": "„Er bleibt bei einem Straßenhändler stehen und kauft einen Strauß Tuberosen.“"
                            },
                            {
                                "example_id": "6fd5d02e-963f-4041-b4d3-3edcbf5da2ad",
                                "sense_id": "1c02e77d-ae25-3897-b062-1f1652d55304",
                                "text": "„Zufällig kam ein Straßenhändler mit seiner Schelle des Weges.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d43b762-2384-4c3b-8d7b-002b3511e7f9",
                        "source_entry_id": "052ea035-731f-3e02-84eb-f0700db72dd0",
                        "source_sense_id": "1c02e77d-ae25-3897-b062-1f1652d55304",
                        "source_sense_description": "Verkäufer, der seine Waren auf der Straße anbietet",
                        "target_lang_word": "cheapjack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheapjack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44e1748f-d2e0-375c-bd40-a6442a5b6bae",
                                        "entry_id": "88392e80-a580-3619-8abf-e54ecee216f2",
                                        "glosses": [
                                            "A peddler, a travelling hawker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e387db9b-7763-42d1-928d-30e78ac6e0a5",
                                                "sense_id": "44e1748f-d2e0-375c-bd40-a6442a5b6bae",
                                                "text": "\"Why,\" rejoined Mrs Cadwallader, with a sharper note, \"you don't mean to say that you would like him to turn public man in that way—making a sort of political Cheap Jack of himself?\""
                                            },
                                            {
                                                "example_id": "c6259912-2d43-4cc8-8d3a-076d8ac2cf10",
                                                "sense_id": "44e1748f-d2e0-375c-bd40-a6442a5b6bae",
                                                "text": "On the day after the riot he came upon a score of people collected round a Cheap Jack in the market."
                                            },
                                            {
                                                "example_id": "7ca78ed1-b992-4aab-bc7a-2b1d91367769",
                                                "sense_id": "44e1748f-d2e0-375c-bd40-a6442a5b6bae",
                                                "text": "My mother and father was standing against the railings by the market, looking over at the fire-swallower and the cheap-jack and the Salvation Army down below; and the German Band was playing round the corner of the Commercial Arcade."
                                            },
                                            {
                                                "example_id": "1e8cabc5-4923-4a37-a1e9-4c1fe6be95f0",
                                                "sense_id": "44e1748f-d2e0-375c-bd40-a6442a5b6bae",
                                                "text": "I was much too timid and didn't have the cheap-jack’s boasting patter."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cheapjack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "491aa512-42e6-3a25-9e59-1739cbea60da",
                                        "entry_id": "3238946f-bd30-3ef1-8bc4-31aa76967328",
                                        "glosses": [
                                            "shabby"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1446998-0008-4431-9116-eb401232d98c",
                                                "sense_id": "491aa512-42e6-3a25-9e59-1739cbea60da",
                                                "text": "It was a drab, cheapjack little area, unambiguously removed from the public, and yet I had come to love it in a way I never could the rest of the monstruous edifice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc0c2f68-a3be-412d-833b-0d584a0da54a",
                        "source_entry_id": "052ea035-731f-3e02-84eb-f0700db72dd0",
                        "source_sense_id": "1c02e77d-ae25-3897-b062-1f1652d55304",
                        "source_sense_description": "Verkäufer, der seine Waren auf der Straße anbietet",
