                    {
                        "translation_id": "d0feff5e-f4d0-40d5-bdde-94ede390fac5",
                        "source_entry_id": "8b585274-f0e3-3568-8e32-9fee1d69fa6d",
                        "source_sense_id": "da3e2b94-a192-372f-9cf7-2727116b0161",
                        "source_sense_description": "Gastronomie, speziell Mexiko: Tamale",
                        "target_lang_word": "Tamale",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tamale",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "804b92e9-ba62-3668-bc0b-b8f7052860b1",
                                        "entry_id": "d3cf0779-a7d2-3c21-a010-0087aeb7e5f4",
                                        "glosses": [
                                            "aus Maismehl gebackener Fladen"
                                        ],
                                        "tags": [
                                            "Mexiko und Mittelamerika"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f983db38-3290-48e2-b1a2-11cce8d8073c",
                                                "sense_id": "804b92e9-ba62-3668-bc0b-b8f7052860b1",
                                                "text": "„Sofort standen sie von ihrem Außentisch in einem Café auf, warfen mit Tamale getränkte Pappteller in den Müll, gingen in den Juwelierladen auf der anderen Straßenseite und erschossen den Mann, den sie verfolgt hatten, zusammen mit seiner Frau und zwei Leibwächtern.“"
                                            },
                                            {
                                                "example_id": "1ab78ab2-d514-48fc-b71c-124a694f46f3",
                                                "sense_id": "804b92e9-ba62-3668-bc0b-b8f7052860b1",
                                                "text": "„Die Tamales waren mit dekorativen Mustern verziert wie etwa einer Muschel, umrahmt von roten Bohnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Tamale",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87c333ae-7cfa-3087-8292-8dc6b87e4b58",
                                        "entry_id": "419343d3-c1a8-3572-9b00-6ccf7068d392",
                                        "glosses": [
                                            "Stadt im Norden Ghanas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4a6c104-159e-4314-9db3-3b3308835118",
                                                "sense_id": "87c333ae-7cfa-3087-8292-8dc6b87e4b58",
                                                "text": "„Doch Lartey entschied, das Büro eines Assistant Superintendents zu nehmen, das gerade verfügbar war, weil der ASP einen Auftrag in Tamale bearbeitete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
