                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2fa6108f-6741-3f19-8114-598f0a18ee6f",
                                        "entry_id": "bad0561e-ce02-3ca4-b065-de123fb5b2a6",
                                        "glosses": [
                                            "Depósito o almacén para toneles de vino y otros licores."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41400c34-eb8b-4205-b8e8-4a7022ac675b",
                                                "sense_id": "2fa6108f-6741-3f19-8114-598f0a18ee6f",
                                                "text": "¿Qué es un destripaterrones bestial, que en presencia de un pueblo indocto, sube al púlpito con sus barbas de chivo, y se pone a gritar: '¡Los liberales son masones, cuidado! ¡los masones son herejes!' Y los barriles de aguardiente que entran a su atarazana cada día, ¿qué son? ¿masones?"
                                            }
                                        ],
