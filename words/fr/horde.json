                        "horde d'enfants"
                    ]
                },
                {
                    "sense_id": "0dcc61c6-ffa6-3749-8309-854329049d2d",
                    "sense_definition": "Troupe armée et indisciplinée qui se livre au pillage, à la violence ou à la dévastation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "troupe_violente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les habitants ont fui dans les collines pour échapper à cette <w>horde</w> sanguinaire."
                        },
                        {
                            "text": "Le village tout entier a été complètement détruit par une <w>horde</w> de pillards sans foi ni loi."
                        }
                    ],
                    "synonyms": [
                        "bande",
                        "meute",
                        "troupe"
                    ],
                    "common_phrases": [
                        "horde de pillards",
                        "horde sauvage"
                    ]
                },
                {
                    "sense_id": "828d21af-bc42-3164-90be-9cb35c5e35ff",
                    "sense_definition": "Tribu ou ensemble de populations nomades, en particulier dans les steppes d'Asie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "groupe_nomade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette puissante <w>horde</w> nomade parcourait les steppes infinies sous le commandement de chefs redoutables."
                        },
                        {
                            "text": "Les historiens étudient les routes empruntées par chaque <w>horde</w> mongole au Moyen Âge."
