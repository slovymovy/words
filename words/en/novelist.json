                },
                {
                    "sense_id": "6f7dd798-6332-3294-8208-0cfa2aa45b9a",
                    "sense_definition": "A person who introduces new ideas or innovations.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "innovator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a political <w>novelist</w>, he was always looking for ways to reform the system.",
                            "target_lang_translations": {
