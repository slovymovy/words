                "senses": [
                    {
                        "sense_id": "cedaa623-8df3-3686-a424-a03d74bb5ff7",
                        "entry_id": "3a78cc3d-7ab1-34e7-9128-f49204e17aa6",
                        "glosses": [
                            "Haute montagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "551ed024-207c-4c79-85a3-1c949469a2ce",
                                "sense_id": "cedaa623-8df3-3686-a424-a03d74bb5ff7",
                                "text": "In Hochgebirgen gibt es deutliche Zonierungen der Vegetation."
                            },
                            {
                                "example_id": "dc14be9c-5e5a-4db4-adb9-00345f6b9fad",
                                "sense_id": "cedaa623-8df3-3686-a424-a03d74bb5ff7",
                                "text": "In der Aussendung wird zudem vor einer zunehmenden Lawinengefahr im Hochgebirge gewarnt. Das frühwinterliche Wetter soll über das Wochenende hinaus anhalten.",
                                "translation": "Le communiqué avertit également d’un danger d'avalanche croissant en haute montagne. Le temps de début d'hiver va probablement se prolonger au-delà du week-end."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
