                        "examples": [
                            {
                                "example_id": "5cbc6756-0326-46a4-96b4-d1b288c9719c",
                                "sense_id": "f7c77c8e-33ee-39ad-bcc5-d7fdac3e18b0",
                                "text": "„Tōgō räumt in seinen Memoiren freimütig ein, dass die vorgesehene Notifizierung in der Form von einer Kriegserklärung abgewichen sei.“"
                            },
                            {
                                "example_id": "4a1a4fa2-fbfb-4796-ac50-4ddc33ded24b",
                                "sense_id": "f7c77c8e-33ee-39ad-bcc5-d7fdac3e18b0",
                                "text": "Der Botschafter tritt sein Amt mit der Notifizierung seiner Ankunft an."
                            }
                        ],
