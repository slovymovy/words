                        "entry_id": "f45f9125-87e7-359b-acb6-3a96180d37e0",
                        "glosses": [
                            "pomieszczenie klasztorne przeznaczone do spożywania posiłków"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d25f0dc5-c815-46a5-bc08-dde6e9a6bf78",
                                "sense_id": "936a4de9-eee9-364c-9444-52c5795a1ff6",
                                "text": "Po modlitwie wszyscy mnisi zbierali się w refektarzu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c0e55d6-eb6c-44c5-bf21-5df80e2c221e",
                        "source_entry_id": "f45f9125-87e7-359b-acb6-3a96180d37e0",
                        "source_sense_id": "936a4de9-eee9-364c-9444-52c5795a1ff6",
                        "target_lang_word": "refectory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refectory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c77ae3c-6ee2-3557-9856-5c74d189a0a7",
                                        "entry_id": "76342d62-00d2-33c4-b020-719c6d9eb929",
                                        "glosses": [
                                            "A dining hall, especially in an institution such as a college or monastery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59aba153-0164-4702-ac18-1aa67e5dcca6",
                                                "sense_id": "4c77ae3c-6ee2-3557-9856-5c74d189a0a7",
                                                "text": "They compare very well with similar cafes elsewhere and the quality, for example, is far better and the price cheaper than in my college refectory."
                                            },
                                            {
                                                "example_id": "6bb050e3-17fa-4e98-ba55-b24ba3dd183a",
                                                "sense_id": "4c77ae3c-6ee2-3557-9856-5c74d189a0a7",
                                                "text": "With a clattering of chairs, upended shell cases, benches, and ottomans, Pirate's mob gather at the shores of the great refectory table, a southern island well across a tropic or two from chill Croydon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c34efe3-356e-4f20-aafd-e117e7867fc5",
                        "source_entry_id": "f45f9125-87e7-359b-acb6-3a96180d37e0",
                        "source_sense_id": "936a4de9-eee9-364c-9444-52c5795a1ff6",
                        "target_lang_word": "refektář",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refektář",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "c34d4a94-00a3-3f8a-b756-8398928d78c3",
                                        "entry_id": "f50bd4b2-570f-3e3d-924a-5af81c8a6c60",
                                        "glosses": [
                                            "společná jídelna v klášterech nebo seminářích"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c909076a-e0ad-4898-9648-dba409685869",
                                                "sense_id": "c34d4a94-00a3-3f8a-b756-8398928d78c3",
                                                "text": "Refektářem se nazývala společná klášterní jídelna. Tato místnost sloužila konventu a byla umístěna hned vedle kuchyně kvůli snadnému dodávání jídla."
                                            },
                                            {
                                                "example_id": "d99e3649-f8d4-4964-bc15-a07c49ae2181",
                                                "sense_id": "c34d4a94-00a3-3f8a-b756-8398928d78c3",
                                                "text": "Šli spolu zpět do ambitu, kol „rajského dvora“ rovnou do refektáře, neboť hlubokým poledním tichem ozval se klášterní zvon, hlásaje dědině i lidem na polích polední klidu čas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4088ada1-1221-4f22-bf73-585d5b172e3a",
                        "source_entry_id": "f45f9125-87e7-359b-acb6-3a96180d37e0",
                        "source_sense_id": "936a4de9-eee9-364c-9444-52c5795a1ff6",
                        "target_lang_word": "réfectoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réfectoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa9ef723-e8de-33f4-a6b8-2ba3b72f9b37",
                                        "entry_id": "a22178aa-bc9b-3d17-9e8e-871e268ab1b0",
                                        "glosses": [
                                            "Lieu où l’on se réunit pour prendre les repas en commun, dans les communautés, dans les collèges, dans les hospices, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a657dea9-1ef5-44dd-8a40-3d9b9808a5c6",
                                                "sense_id": "fa9ef723-e8de-33f4-a6b8-2ba3b72f9b37",
                                                "text": "L’équipage en fut informé au réfectoire, où on servait les rations du soir."
                                            },
                                            {
                                                "example_id": "bdfb578f-ac3b-4c3b-82d6-3f361de0774c",
                                                "sense_id": "fa9ef723-e8de-33f4-a6b8-2ba3b72f9b37",
                                                "text": "Petite et misérable gargote de la rue Sainte-Geneviève où je me nourrissais jadis si mal que j'en ai, quand j'y pense, encore faim, je ne vous oublie pas, ni vous grand réfectoire des pauvres de la place des Deux-Ponts à Lyon, […]."
                                            },
                                            {
                                                "example_id": "b44a7a96-c78e-41d1-9831-152a735fd840",
                                                "sense_id": "fa9ef723-e8de-33f4-a6b8-2ba3b72f9b37",
                                                "text": "Nous n’avions pas encore de réfectoire sur notre train. Nous allions prendre nos repas dans une petite maison, près d’une petite gare."
                                            },
                                            {
                                                "example_id": "ca507302-d082-456b-89c4-cb25fa5b8d96",
                                                "sense_id": "fa9ef723-e8de-33f4-a6b8-2ba3b72f9b37",
                                                "text": "L'orphelinat me valut d’apprendre sous d’autres auspices qu’il n’y a pas d’alimentation neutre.(…). Le réfectoire remplaçait la cuisine et les fumets de la maison furent supplantés par les effluves gras et lourds des laboratoires de collectivité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc7e22bb-1988-4dc9-a369-c34d2c548390",
                        "source_entry_id": "f45f9125-87e7-359b-acb6-3a96180d37e0",
                        "source_sense_id": "936a4de9-eee9-364c-9444-52c5795a1ff6",
                        "target_lang_word": "refectorio",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refectorio",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "d09bfb2a-c38c-3c9c-86c7-bdba4e42936d",
                                        "entry_id": "2a4366b7-2010-350c-86b5-37bbcb2c2dd8",
                                        "glosses": [
                                            "Comedor donde comen los monjes de los monasterios. Está comunicado con la cocina; tiene, generalmente, forma rectangular, y se halla situado en la galería opuesta a la iglesia"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b665af31-92c6-40e0-87f8-0bc30028370d",
                        "source_entry_id": "f45f9125-87e7-359b-acb6-3a96180d37e0",
                        "source_sense_id": "936a4de9-eee9-364c-9444-52c5795a1ff6",
                        "target_lang_word": "Refektorium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Refektorium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "79e56359-beb8-3ad2-bbc9-d2851d83e78e",
                                        "entry_id": "98261c3e-4c66-349d-8845-1075fd5718ac",
                                        "glosses": [
                                            "Speisesaal im Kloster"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc71a32d-e986-47eb-969c-32a840d75c59",
                                                "sense_id": "79e56359-beb8-3ad2-bbc9-d2851d83e78e",
                                                "text": "„Das Refektorium war der gemeinsame Speisesaal im Kloster und wurde nur an Sonn- und Feiertagen benutzt, denn während der Woche erhielt der Chormönch die Mahlzeiten in seine einsame Zelle zugestellt.“"
                                            },
                                            {
                                                "example_id": "03edcb6d-5c29-4f42-8dd1-52c0d12b6adc",
                                                "sense_id": "79e56359-beb8-3ad2-bbc9-d2851d83e78e",
                                                "text": "„Der Raum, in den Robert sich gebannt sah, wirkte wie ein altes Refektorium.“"
                                            },
                                            {
                                                "example_id": "27985adc-d926-4e41-ac24-f4076427b236",
                                                "sense_id": "79e56359-beb8-3ad2-bbc9-d2851d83e78e",
                                                "text": "„Das ehemalige Refektorium des Klosters ließ sich leicht in einen Theatersaal verwandeln; was er vielleicht an Eleganz vermissen ließ, machte er wett durch seine Einzigartigkeit.“"
                                            },
                                            {
                                                "example_id": "7eff435b-72d1-46fe-af4a-a208788aeb07",
                                                "sense_id": "79e56359-beb8-3ad2-bbc9-d2851d83e78e",
                                                "text": "„Oder sie können sich in den Kreuzgang und ins Refektorium des Frankfurter Karmeliterklosters begeben und die Wandmalerei bewundern, die heute als größtes erhaltenes Werk ihrer Art aus dieser Zeit gilt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
