                        "examples": [
                            {
                                "example_id": "5d75c9ef-9ce3-4a43-9271-f5393d3a7f27",
                                "sense_id": "981520de-f345-337d-949c-37cab71c897c",
                                "text": "„Die Tür am Ende war mit einem Schnappschloss versehen - scheinbar von innen und außen, denn als ich die Klammer gelöst hatte, ließ sich die massive Tür trotzdem nicht öffnen.“"
                            },
                            {
                                "example_id": "9c67114e-b2cd-4b0f-918e-daac6bcd2a80",
                                "sense_id": "981520de-f345-337d-949c-37cab71c897c",
                                "text": "„Ich begrüße ihn, als es ihm endlich gelingt, das Schnappschloss aufzusperren.“"
                            }
                        ],
