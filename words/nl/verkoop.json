                    "sense_id": "e0884e76-91ef-3cfb-bc28-74e2b19ece57",
                    "sense_definition": "De handeling van het ruilen van goederen of diensten voor geld.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "handel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>verkoop</w> van het nieuwe product overtrof alle verwachtingen van het bedrijf.",
                            "target_lang_translations": {
                                "en": "The <w>sale</w> of the new product exceeded all of the company's expectations.",
                                "ru": "<w>Продажа</w> нового продукта превзошла все ожидания компании."
                            }
                        },
                        {
                            "text": "Tijdens de <w>verkoop</w> van het huis kwamen er veel potentiële kopers kijken.",
                            "target_lang_translations": {
