                    {
                        "sense_id": "57e0e77c-fb67-389b-8ef4-ff06d0ed9c15",
                        "entry_id": "3503deb0-1e22-376d-b19a-1f593d4e4bdd",
                        "glosses": [
                            "Brücke, deren Fahrbahn mit Ketten, Stahlseilen an Stützen oder Pfeilern aufgehängt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2be7accc-d8a1-422e-af1d-56003123845e",
                                "sense_id": "57e0e77c-fb67-389b-8ef4-ff06d0ed9c15",
                                "text": "Diese Hängebrücke bietet einen imposanten Ausblick."
                            },
                            {
                                "example_id": "884fca44-5dd0-4fc8-9c92-7934adf55035",
                                "sense_id": "57e0e77c-fb67-389b-8ef4-ff06d0ed9c15",
                                "text": "Die Verkabelung der Hängebrücke ist sehr stabil gebaut."
                            },
                            {
                                "example_id": "03db9265-e549-4e12-abff-fdf43df81f43",
                                "sense_id": "57e0e77c-fb67-389b-8ef4-ff06d0ed9c15",
                                "text": "„Einmal mußte er den reißenden Strom auf einer Hängebrücke mit einer Länge von siebzig Metern überqueren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
