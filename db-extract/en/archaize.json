                                            {
                                                "example_id": "18ec0db6-899a-442e-a811-bfd8f819069f",
                                                "sense_id": "5ea4634b-5272-3910-9213-8d8cc12deddf",
                                                "text": "„Oder hätte er sich etwa die berüchtigte Homer-Übersetzung von P.C. Boutens zum Vorbild nehmen sollen, der ebenfalls archaisierend übersetzt hat, aber sich in Wortbildung und Syntax viel kühner gebärdet?“"
                                            },
                                            {
                                                "example_id": "9613abf2-43d8-491b-b15f-b62d0f5ede0e",
                                                "sense_id": "5ea4634b-5272-3910-9213-8d8cc12deddf",
                                                "text": "„Im »Vorbericht« zu seiner Sammlung schrieb der Verfasser, daß er auch die Wortwahl bewußt archaisiert habe, weil es ihm darauf angekommen sei, die Sprache des Volkes und nicht die der gebildeten Schriftsteller nachzuahmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
