        "fr-extract.jsonl": [
            {
                "entry_id": "26c8620a-5d01-3df2-b16f-e93826e3a6fd",
                "word": "Dorothée",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7ebbb534-7b51-32c1-bb4a-332f512d8def",
                        "entry_id": "26c8620a-5d01-3df2-b16f-e93826e3a6fd",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e89583b-cb46-45c8-b730-f418882a319f",
                                "sense_id": "7ebbb534-7b51-32c1-bb4a-332f512d8def",
                                "text": "Certains jours, Marthe emportait son ouvrage chez la vieille Dorothée, sa voisine.\nUne vieille paysanne, affable, cérémonieuse, affectionnant les façons de parler révérencieuses, particulières aux paysans de bonne famille."
                            },
                            {
                                "example_id": "82c535fa-1038-4901-98d5-c6c09cc19a2b",
                                "sense_id": "7ebbb534-7b51-32c1-bb4a-332f512d8def",
                                "text": "Le village dormait. De la lumière aux vitres du Café de la route ; chez le maire ; chez Dorothée. Cette fille était matinale !"
                            },
                            {
                                "example_id": "e28bef98-387a-48a9-a4cd-f87e8f2f4385",
                                "sense_id": "7ebbb534-7b51-32c1-bb4a-332f512d8def",
                                "text": "La semaine dernière, quinze enfants du Ticket jeune (sept Taulésiens, accompagnés de Dorothée et Élodie, et huit jeunes Carantécois) ont participé à un camp de quatre jours et trois nuits, à Plouarzel."
                            }
                        ]
                    },
                    {
                        "sense_id": "61d63bef-42be-3f30-83fe-3e159ca2a380",
                        "entry_id": "26c8620a-5d01-3df2-b16f-e93826e3a6fd",
                        "glosses": [
                            "Nom masculin."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "27bd866b-f533-4248-a659-334380c2b3ec",
                                "sense_id": "61d63bef-42be-3f30-83fe-3e159ca2a380",
                                "text": "Dorothée de Gaza, né vers 500 et mort entre 565 et 580, est un père du désert palestinien, dont l'influence spirituelle a été considérable."
                            },
                            {
                                "example_id": "5daacacc-4ee1-4a72-b4cb-468a30e41a4c",
                                "sense_id": "61d63bef-42be-3f30-83fe-3e159ca2a380",
                                "text": "Au deuxième chapitre de ce texte, on trouve le récit de la rencontre avec Dorothée, un ascète de la région de Thèbes qui passe sa soixantième année dans une grotte …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca4e01bf-f700-4a0c-b3ac-bb5b3d7aa506",
                        "source_entry_id": "26c8620a-5d01-3df2-b16f-e93826e3a6fd",
                        "target_lang_word": "Dorothea",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dorothea",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4dc10f3b-e998-3ddc-a9ee-46f58bb89719",
                                        "entry_id": "14137e20-43b1-3cf4-8561-4a26a29500a7",
                                        "glosses": [
                                            "weiblicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "327ff076-5691-4d58-81dd-37c48b2c8160",
                                                "sense_id": "4dc10f3b-e998-3ddc-a9ee-46f58bb89719",
                                                "text": "Das erste Kind von Stefanie und Alexandros trägt den Namen Dorothea und lässt alle Herzen höherschlagen!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "520e5c2d-6621-481c-b3ec-7fe18708369c",
                        "source_entry_id": "26c8620a-5d01-3df2-b16f-e93826e3a6fd",
                        "target_lang_word": "Dorothy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dorothy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "365652e1-7d6d-3969-8768-0a3aabe1bad2",
                                        "entry_id": "4763f2de-2a58-36b8-81c1-8abba84d8685",
                                        "glosses": [
                                            "A female given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0890d4b9-964a-480b-90d3-e96fbf8cfdd5",
                                                "sense_id": "365652e1-7d6d-3969-8768-0a3aabe1bad2",
                                                "text": "Piſt[ol]. Then, to you miſtris Dorothy, I will charge you. / Doro[thy]. Charge me? I ſcorne you, ſcuruy companion: […]"
                                            },
                                            {
                                                "example_id": "03a8de37-1562-4535-be94-d9b233fc91df",
                                                "sense_id": "365652e1-7d6d-3969-8768-0a3aabe1bad2",
                                                "text": "\"My name is Dorothy,\" said the girl, \"and I am going to the Emerald City, to ask the great Oz to send me back to Kansas.\""
                                            },
                                            {
                                                "example_id": "183e4776-da2e-4d42-886a-9119bc6b97ea",
                                                "sense_id": "365652e1-7d6d-3969-8768-0a3aabe1bad2",
                                                "text": "Don't you think the world has gone steadily downhill ever since parents stopped naming their children Lucy and Dorothy and started naming them Samantha?"
                                            },
                                            {
                                                "example_id": "16850381-98e5-4d34-a58e-c42e16f3cf58",
                                                "sense_id": "365652e1-7d6d-3969-8768-0a3aabe1bad2",
                                                "text": "In recent years, Hillel chapters have also come under fire for withdrawing support from or further marginalizing queer Jewish student groups that participate in events co-sponsored by JVP, and for banning legendary civil rights activist Dorothy Zellner from speaking at campus chapters after she discussed her commitment to Palestinian human rights work in a speech at Harvard’s Hillel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
