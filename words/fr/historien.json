                    ]
                },
                {
                    "sense_id": "574a1d89-57d7-3232-91e4-a78c5de0881b",
                    "sense_definition": "Personne qui se contente de relater fidèlement les faits sans porter de jugement ni prendre parti.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "narrateur_neutre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En rapportant cette querelle, je me contente d'être un simple <w>historien</w> impartial."
                        },
                        {
                            "text": "Il refuse de juger les coupables et préfère rester <w>historien</w> de la situation."
