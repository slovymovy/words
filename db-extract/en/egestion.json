                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "416661dc-834a-4c1a-91fb-f496764b8482",
                                                "sense_id": "0e0f0dea-c5cd-35f1-964e-fe8d25d58231",
                                                "text": "L’éjection des gaz se fait par cette tuyère."
                                            },
                                            {
                                                "example_id": "29791d3f-10be-40e1-96c3-986eec1812bf",
                                                "sense_id": "0e0f0dea-c5cd-35f1-964e-fe8d25d58231",
                                                "text": "Nous avons vu que l’hypothalamus est le maître du ballet des hormones responsables de la lactation, et surtout de l’éjection du lait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
