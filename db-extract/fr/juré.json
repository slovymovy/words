                ],
                "senses": [
                    {
                        "sense_id": "2ca8b8f1-dba7-3fd8-bd39-9da3dc1f0c1e",
                        "entry_id": "9effec72-7045-33c0-a164-c8c0f1790830",
                        "glosses": [
                            "Chacun des citoyens choisis par le sort sur une liste annuelle pour faire partie du jury d’une cour d’assises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f43a92f-81a7-4eea-9b73-8cbd31ec94cf",
                                "sense_id": "2ca8b8f1-dba7-3fd8-bd39-9da3dc1f0c1e",
                                "text": "C’est cette toute puissance du président, en l’occurrence de la présidente Martine de Maximy, qui a étonné et sans doute choqué le juré nᵒ 3 Thierry Allègre."
                            },
                            {
                                "example_id": "810a6438-2b4e-4593-9ec6-4f2a2c8b432c",
                                "sense_id": "2ca8b8f1-dba7-3fd8-bd39-9da3dc1f0c1e",
                                "text": "D’après cela, je soutiens que si l’établissement des jurés est plus difficile au civil qu’au criminel, […], il n’en reste pas moins vrai que les jurés sont nécessaires à la liberté, et qu’il y a des rapports incontestables entre les jurés au civil et les jurés au criminel."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e8db3f5-9a82-3673-9abe-2e15c5aed559",
                        "entry_id": "9effec72-7045-33c0-a164-c8c0f1790830",
                        "glosses": [
                            "Membre d’un quelconque jury."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6abecd2a-9126-4a75-8f41-6f3eb729108d",
                        "source_entry_id": "9effec72-7045-33c0-a164-c8c0f1790830",
                        "source_sense_description": "Citoyen membre d'un jury d’une cour d’assises",
                        "target_lang_word": "juror",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "juror",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01bcb76e-86dc-3aa7-b4a8-9bb9502dda92",
                                        "entry_id": "7e32529a-857b-3d25-9afd-f690152c986f",
                                        "glosses": [
                                            "A member of a jury."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f1c988a-d53c-4cc4-85f6-1e213f6fb579",
                                                "sense_id": "01bcb76e-86dc-3aa7-b4a8-9bb9502dda92",
                                                "text": "While unfailingly courteous to the jury, he could be quite sharp with counsel and witnesses, and rattle his sabre at the press: his first reported words in the case were that any journalist thinking of interviewing a juror 'had better bring a toothbrush'."
                                            },
                                            {
                                                "example_id": "e74460b9-c26a-4572-853f-08c4d4583b2b",
                                                "sense_id": "01bcb76e-86dc-3aa7-b4a8-9bb9502dda92",
                                                "text": "The jurors listened carefully while Eidem portrayed Fern Sankey as an archconspirator who drove her husband into crime and was intimately involved in all major details of Charlie Boettcher's abduction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ff7c794-da4c-400e-a30b-993819ec3655",
                        "source_entry_id": "9effec72-7045-33c0-a164-c8c0f1790830",
