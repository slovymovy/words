                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7581b69a-97c0-499d-849f-67a812ced429",
                                "sense_id": "c4e9df3b-bf73-35ba-94d9-abf7fa7af83c",
                                "text": "Cameron was for closing the discussion as useless and ununderstandable."
                            },
                            {
                                "example_id": "4239e80a-c161-4011-b933-ed11364c467e",
                                "sense_id": "c4e9df3b-bf73-35ba-94d9-abf7fa7af83c",
                                "text": "But to report an item or sequence of behaviour as radically ununderstandable is to say that it is so inaccessible to any possible explanation[…]"
                            }
