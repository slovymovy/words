{
    "word_family": [
        "smite",
        "smiter"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e5a1ca98-fadb-3791-ab8d-340b577b58a9",
                    "sense_definition": "Deeply in love with someone or very attracted to them.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "infatuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was so <w>smitten</w> with her that he couldn't stop talking about her all evening.",
                            "target_lang_translations": {
                                "ru": "Он был так <w>по уши влюблен</w> в нее, что не мог перестать говорить о ней весь вечер."
                            }
                        },
                        {
                            "text": "The <w>smitten</w> man decided to propose only three months after they first met.",
                            "target_lang_translations": {
                                "ru": "<w>Очарованный</w> мужчина решил сделать предложение всего через три месяца после их первой встречи."
                            }
                        }
                    ],
                    "synonyms": [
                        "infatuated",
                        "enamored",
                        "besotted"
                    ],
                    "antonyms": [
                        "indifferent"
                    ],
                    "common_phrases": [
                        "smitten with",
                        "smitten man"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубоко влюбленный в кого-то или сильно очарованный кем-то."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по уши влюбленный",
                                "target_lang_sense_clarification": "о сильном чувстве"
                            },
                            {
                                "target_lang_word": "очарованный",
                                "target_lang_sense_clarification": "находящийся под обаянием"
                            },
                            {
                                "target_lang_word": "сраженный",
                                "target_lang_sense_clarification": "в переносном смысле, наповал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "817879c9-2cd1-3cc9-87f9-249670319886",
                    "sense_definition": "Very enthusiastic about or strongly affected by a particular interest or activity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "enthusiasm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a <w>smitten</w> enthusiast of classical music, she never missed a local symphony performance.",
                            "target_lang_translations": {
                                "ru": "Как <w>страстная</w> поклонница классической музыки, она никогда не пропускала выступления местного симфонического оркестра."
                            }
                        },
                        {
                            "text": "He became <w>smitten</w> with sailing after his first trip to the coast.",
                            "target_lang_translations": {
                                "ru": "Он <w>загорелся</w> парусным спортом после своей первой поездки на побережье."
                            }
                        }
                    ],
                    "synonyms": [
                        "captivated",
                        "enthralled"
                    ],
                    "common_phrases": [
                        "smitten enthusiast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень увлеченный чем-либо или находящийся под сильным впечатлением от какого-либо занятия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "захваченный",
                                "target_lang_sense_clarification": "полностью поглощенный интересом"
                            },
                            {
                                "target_lang_word": "пораженный",
                                "target_lang_sense_clarification": "находящийся под сильным впечатлением"
                            },
                            {
                                "target_lang_word": "увлеченный",
                                "target_lang_sense_clarification": "проявляющий большой интерес"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e3f72da-e2da-3485-8f60-c2d4c8c592bc",
                    "sense_definition": "Struck, hit, or severely affected by something harmful like a disease or disaster.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "afflicted",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The village was <w>smitten</w> by a sudden plague that left many families grieving.",
                            "target_lang_translations": {
                                "ru": "Деревня была <w>поражена</w> внезапной чумой, оставившей многие семьи в трауре."
                            }
                        },
                        {
                            "text": "The <w>smitten</w> man fell to the ground after the heavy blow to his chest.",
                            "target_lang_translations": {
                                "ru": "<w>Сраженный</w> мужчина упал на землю после сильного удара в грудь."
                            }
                        }
                    ],
                    "synonyms": [
                        "afflicted",
                        "stricken"
                    ],
                    "common_phrases": [
                        "smitten by disease"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often used in literary or biblical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пораженный, разбитый или серьезно пострадавший от чего-то вредного, например, болезни или бедствия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пораженный",
                                "target_lang_sense_clarification": "болезнью или недугом"
                            },
                            {
                                "target_lang_word": "сраженный",
                                "target_lang_sense_clarification": "ударом или болезнью"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dcda9e80-4e64-3b85-9a42-a02d27ee6b37",
                    "sense_definition": "past participle of <w>smite</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The enemy had been <w>smitten</w> by the hero's mighty sword.",
                            "target_lang_translations": {
                                "ru": "Враг был <w>сражен</w> могучим мечом героя."
                            }
                        },
                        {
                            "text": "In the ancient text, the city was <w>smitten</w> for its wickedness.",
                            "target_lang_translations": {
                                "ru": "В древнем тексте город был <w>покаран</w> за свое нечестие."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "the verb smite is rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола smite (поражать, сокрушать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сраженный",
                                "target_lang_sense_clarification": "в бою или божественной силой"
                            },
                            {
                                "target_lang_word": "покараемый",
                                "target_lang_sense_clarification": "в религиозном контексте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}