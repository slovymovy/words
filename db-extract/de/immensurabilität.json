                "senses": [
                    {
                        "sense_id": "819bfb32-d8e2-3959-a573-df29ce098aa9",
                        "entry_id": "43c4a417-a03f-3a5c-9bef-bcbc30b2818c",
                        "glosses": [
                            "Eigenschaft, schlecht oder gar nicht quantifizierbar, nicht messbar (mensurabel) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "138ff84b-403b-41d0-b0e6-dd804b71a86c",
                                "sense_id": "819bfb32-d8e2-3959-a573-df29ce098aa9",
                                "text": "„Nun kann man sich berechtigterweise fragen, wie die Gerichte diese Summen herleiten und der grundsätzlichen Schwierigkeit der Immensurabilität immaterieller Beeinträchtigungen begegnen.“"
                            },
                            {
                                "example_id": "aeb07d47-7189-4e63-bfe5-bedccadca61e",
                                "sense_id": "819bfb32-d8e2-3959-a573-df29ce098aa9",
                                "text": "„So entziehen sich Kompetenzen beispielsweise aufgrund ihrer Immensurabilität einer Identifikation und Bewertung mittels der traditionell in Unternehmen gebräuchlichen Erfassungssysteme und Bewertungsverfahren, etwa dem betrieblichen Rechnungswesen.“"
                            }
                        ],
