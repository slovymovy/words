                    {
                        "form_id": "8794d119-a601-4d28-a364-c909309bd3f7",
                        "entry_id": "c50ca7b1-6c14-3f23-aaed-8f7181b59098",
                        "tags": [
                            "orthographe traditionnelle"
                        ],
                        "form": "afro-descendant"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c61a317-246b-339b-9461-3efe87dec2ab",
                        "entry_id": "c50ca7b1-6c14-3f23-aaed-8f7181b59098",
                        "glosses": [
                            "Qui est d'ascendance africaine, de la diaspora africaine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9e7795d-7617-43ab-ad6c-2f413d6e2d8a",
                                "sense_id": "5c61a317-246b-339b-9461-3efe87dec2ab",
                                "text": "Être afrodescendant c’est une construction personnelle et sociale dont le but est la valorisation et le respect des éléments territoriaux, générationnels, historiques et culturels, qui nous légitiment comme héritiers d’un patrimoine inestimable, qui comme partie de notre diversité, nous permet de nous positionner comme des authentiques vénézuéliens, sujets de droit."
                            },
                            {
                                "example_id": "ffb8f522-bb5e-43e9-83f6-3c37990af4ab",
                                "sense_id": "5c61a317-246b-339b-9461-3efe87dec2ab",
                                "text": "Être afrodescendant au 21e siècle est un défi permanent, un combat de tous les instants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69128569-e2f0-437c-93a0-0098b739dbfc",
                        "source_entry_id": "c50ca7b1-6c14-3f23-aaed-8f7181b59098",
                        "source_sense_id": "5c61a317-246b-339b-9461-3efe87dec2ab",
                        "target_lang_word": "afrodescendiente",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afrodescendiente",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "d0e81d56-ad34-374a-a4d6-3f127193776d",
                                        "entry_id": "66b9b394-c859-343e-8332-40fdd9d8aea5",
                                        "glosses": [
                                            "Se dice de las personas y rasgos culturales que hacen parte de la diáspora africana, y especialmente a su presencia actual en el continente americano como consecuencia del tráfico de esclavos."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6079137d-6851-49e4-ae6e-defec44f1ff3",
                                                "sense_id": "d0e81d56-ad34-374a-a4d6-3f127193776d",
                                                "text": "(sustantivo): \"A partir de la década de los noventa, una corriente de autodefínición étnica toma fuerza en algunos países de Latinoamérica con población significativa de afrodescendientes\"."
                                            },
                                            {
                                                "example_id": "ddb21ffe-8d80-4fa0-b603-048af38d1723",
                                                "sense_id": "d0e81d56-ad34-374a-a4d6-3f127193776d",
                                                "text": "(adjetivo): \"Un concepto derivado de los gentilicios comenzados con afro-, más cercano en el tiempo, es afrodescendiente. Ese concepto fue gestado en la Conferencia Ciudadana contra el Racismo, la Xenofobia, la Intolerancia y la Discriminación\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
