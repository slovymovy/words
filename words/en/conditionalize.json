{
    "word_family": [
        "condition",
        "conditional"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "439fad9a-cf9a-3143-9653-ed529e382a86",
                    "sense_definition": "To make something dependent on specific requirements or circumstances.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "logic_and_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee decided to <w>conditionalize</w> the grant on the completion of the project report.",
                            "target_lang_translations": {
                                "de": "Das Komitee beschloss, die Bewilligung der Fördermittel an die Fertigstellung des Projektberichts zu <w>knüpfen</w>.",
                                "zh": "委员会决定将这笔拨款<w>附加条件</w>，即必须完成项目报告。"
                            }
                        },
                        {
                            "text": "You should not <w>conditionalize</w> your support based on such uncertain future events.",
                            "target_lang_translations": {
                                "de": "Du solltest deine Unterstützung nicht von solch ungewissen zukünftigen Ereignissen <w>abhängig machen</w>.",
                                "zh": "你不应该基于这些不确定的未来事件来<w>限定</w>你的支持。"
                            }
                        }
                    ],
                    "synonyms": [
                        "qualify",
                        "restrict"
                    ],
                    "antonyms": [
                        "unconditionalize"
                    ],
                    "common_phrases": [
                        "conditionalize support",
                        "conditionalize approval"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas von bestimmten Bedingungen oder Voraussetzungen abhängig machen.",
                        "zh": "使某事取决于特定的要求或情况。"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "an Bedingungen knüpfen",
                                "target_lang_sense_clarification": "etwas unter Vorbehalt stellen"
                            },
                            {
                                "target_lang_word": "konditionieren",
                                "target_lang_sense_clarification": "in einen bestimmten Zustand versetzen oder abhängig machen"
                            },
                            {
                                "target_lang_word": "einschränken",
                                "target_lang_sense_clarification": "durch Bedingungen begrenzen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "附加条件",
                                "target_lang_sense_clarification": "指在协议或支持中增加限制性条款。"
                            },
                            {
                                "target_lang_word": "限定",
                                "target_lang_sense_clarification": "指对某事物的范围或条件进行约束。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}