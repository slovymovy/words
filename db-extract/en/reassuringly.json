                        "examples": [
                            {
                                "example_id": "0247d953-3025-4178-b341-35548febf4cf",
                                "sense_id": "1bc5040f-47a2-3c11-b199-41cbf27af527",
                                "text": "In the very heart of the herd the din was terrific. It was almost dizzying in its effect. I paused and smiled reassuringly at Maud, for I had recovered my equanimity sooner than she."
                            },
                            {
                                "example_id": "3fbdf38b-6f3c-4359-9284-c84d6a886fd8",
                                "sense_id": "1bc5040f-47a2-3c11-b199-41cbf27af527",
                                "text": "She made several gulps and controlled her breath. She released her grip on Podson and stared at him without recognition. Podson went on patting her reassuringly, relieved from administering first aid to an attack of the vapours."
                            }
                        ]
                    }
