    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "65132e8c-3c9d-3aa3-a95f-d9756458b7bd",
                    "sense_definition": "A long written story about imaginary people and events, usually in the form of a book.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "literature_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to write a <w>novel</w> about her childhood experiences in the countryside.",
                            "target_lang_translations": {
                                "ru": "Она решила написать <w>роман</w> о своих детских впечатлениях в деревне.",
                                "zh": "她决定写一部关于她童年乡村经历的<w>小说</w>。"
                            }
                        },
                        {
                            "text": "I prefer reading a mystery <w>novel</w> rather than watching television in the evening.",
                            "target_lang_translations": {
                                "ru": "Вечером я предпочитаю читать детективный <w>роман</w>, чем смотреть телевизор.",
                                "zh": "晚上我更喜欢读推理<w>小说</w>，而不是看电视。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "write a novel",
                        "read a novel",
                        "best-selling novel",
                        "mystery novel",
                        "graphic novel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинное литературное произведение о вымышленных людях и событиях, обычно в форме книги.",
                        "zh": "一种关于虚构人物和事件的长篇书面故事，通常以书籍形式呈现。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роман",
                                "target_lang_sense_clarification": "литературный жанр"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小说",
                                "target_lang_sense_clarification": "文学体裁"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17adc446-98f4-3298-98b5-9db99aad32c4",
                    "sense_definition": "A new law or constitution established in ancient Rome.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "law_history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The emperor issued a <w>novel</w> to address the changing social conditions of the empire.",
                            "target_lang_translations": {
                                "ru": "Император издал <w>новеллу</w>, чтобы отреагировать на меняющиеся социальные условия империи.",
                                "zh": "皇帝颁布了一项<w>新法</w>以应对帝国不断变化的社会状况。"
                            }
                        },
                        {
                            "text": "Historians studied the <w>novel</w> to understand the legal reforms of that era.",
                            "target_lang_translations": {
                                "ru": "Историки изучали эту <w>новеллу</w>, чтобы понять правовые реформы той эпохи.",
                                "zh": "历史学家研究了这部<w>新法</w>，以了解那个时代的法律改革。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "ancient Rome"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "historical legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Новый закон или указ, изданный в Древнем Риме (дополнение к кодексу).",
                        "zh": "古罗马时期颁布的新法律或法令（作为法典的补充）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новелла",
                                "target_lang_sense_clarification": "юридический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新法",
                                "target_lang_sense_clarification": "法律术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d0a70fc-bdb5-3494-a035-574812847683",
                    "sense_definition": "A short tale or fable, especially one that is part of a larger collection.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "literature_2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bard entertained the court with a merry <w>novel</w> about a trickster.",
                            "target_lang_translations": {
                                "ru": "Бард развлекал двор веселой <w>новеллой</w> о плуте.",
                                "zh": "吟游诗人讲了一个关于骗子的风趣<w>故事</w>来娱乐宫廷。"
                            }
                        },
                        {
                            "text": "This collection contains a <w>novel</w> for every night of the week.",
