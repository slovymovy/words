                        "glosses": [
                            "The state or quality of being greathearted; courage or magnanimity."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2a1bad87-1aa6-4e4e-b386-9f878762b152",
                                "sense_id": "e40c2e5d-79cc-35ce-a4c0-51fb3e7e9bdd",
                                "text": "Miss Porter bears testimony, like every one else who knew him, to his greatheartedness no less than to his genius."
                            },
                            {
                                "example_id": "7be463cd-c405-47d0-b9c0-526600463b1d",
                                "sense_id": "e40c2e5d-79cc-35ce-a4c0-51fb3e7e9bdd",
                                "text": "That virtue is called bravery which contains greatheartedness and a lofty contempt of pain and death."
                            },
                            {
                                "example_id": "2db4a2d9-47a8-44af-a70a-76e46390181b",
                                "sense_id": "e40c2e5d-79cc-35ce-a4c0-51fb3e7e9bdd",
                                "text": "Luther speculates that Abraham, in his godly greatheartedness, must have learned of Lot's plight and taken him and his family in."
                            }
                        ]
                    }
