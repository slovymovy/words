                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encryption",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38742777-4eee-38b2-aa00-23befb9953a3",
                                        "entry_id": "8f7171d2-606e-3a63-b186-da6c49ae1977",
                                        "glosses": [
                                            "The process of obscuring information to make it unreadable without special knowledge, key files, or passwords."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a60279ce-6468-402e-8790-7f14e7412f5e",
                                                "sense_id": "38742777-4eee-38b2-aa00-23befb9953a3",
                                                "text": "Fully homomorphic encryption (FHE) is a new encryption technique that enables computing on data blindly, without decrypting it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88e928eb-1a01-39da-855d-2049b2b94290",
                                        "entry_id": "8f7171d2-606e-3a63-b186-da6c49ae1977",
                                        "glosses": [
                                            "A ciphertext, a cryptogram, an encrypted value. Usually used with the preposition \\\"of\\\" followed by the value that is hidden in it."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04ffd16d-4d37-4056-a871-c97145cd5fa2",
                                                "sense_id": "88e928eb-1a01-39da-855d-2049b2b94290",
                                                "text": "As ZT() can only test whether a single ciphertext is an encryption of zero, it cannot work when there are more than one ciphertext to test."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
