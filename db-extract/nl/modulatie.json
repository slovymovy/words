                        "sense_id": "8cb9ada0-12e4-3138-976f-c3cb25aa5032",
                        "entry_id": "0a4f6d85-70ed-3797-8eb8-36a4ea8b4bb5",
                        "glosses": [
                            "het omzetten van een analoog signaal naar een digitaal b.v. pulscodemodulatie, analoog-digitaal conversie"
                        ],
                        "tags": [],
