                        "glosses": [
                            "nietypowy i śmieszny jednocześnie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "077a5810-2e41-4b7c-82a9-1ad3524ad20d",
                                "sense_id": "e56b94a4-91c4-3463-b2a7-6704981edbc3",
                                "text": "Pisze książki dla młodzieży i dorosłych – od mrocznych i cudacznych po sek­sowne, prze­ra­ża­jące i pełne przy­gód"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5dae606e-e8b6-4092-b479-aabbf014c018",
                        "source_entry_id": "0cdf76ad-b9b4-3622-9763-39e6ebd78789",
                        "source_sense_id": "e56b94a4-91c4-3463-b2a7-6704981edbc3",
                        "target_lang_word": "freakish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "freakish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "673439d1-544b-3238-851a-0b3ab2b875dc",
                                        "entry_id": "74046d2a-e687-3d74-8971-8fdf090a034a",
                                        "glosses": [
                                            "Resembling a freak."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf540ebe-494a-3778-837b-0ba848711ba1",
                                        "entry_id": "74046d2a-e687-3d74-8971-8fdf090a034a",
                                        "glosses": [
                                            "Strange, unusual, abnormal or bizarre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96f5f19e-fbaa-4618-9e9c-acba33b39ee9",
                                                "sense_id": "cf540ebe-494a-3778-837b-0ba848711ba1",
                                                "text": "It was a realy freakish accident that claimed many lives."
                                            },
                                            {
                                                "example_id": "6beda3b2-b78e-4811-bce4-ee38ea1d5877",
                                                "sense_id": "cf540ebe-494a-3778-837b-0ba848711ba1",
                                                "text": "In all this series there is an almost freakish tendency toward the development of characters usually regarded as generic, as a result of which most of the genera have only one known species each."
                                            },
                                            {
                                                "example_id": "1b613592-0280-466a-9c11-0619153c3bd5",
                                                "sense_id": "cf540ebe-494a-3778-837b-0ba848711ba1",
                                                "text": "This was arguably a more emphatic win than that Old Trafford thrashing, without the freakish element and simply the result of City's vast superiority in all areas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4126e1a1-b531-38bc-9687-c72d134e012f",
                                        "entry_id": "74046d2a-e687-3d74-8971-8fdf090a034a",
                                        "glosses": [
                                            "Capricious, unpredictable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23cb48f6-7bea-4a70-a150-f9d75d128729",
                                                "sense_id": "4126e1a1-b531-38bc-9687-c72d134e012f",
                                                "text": "What freakish weather we are having lately in these parts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
