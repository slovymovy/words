                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3ee46ff-1796-402c-8303-1dcddd33a6a0",
                                                "sense_id": "a5d05629-7024-3b0e-8f94-81be360e9761",
                                                "text": "Privately held businesses may hold assets or have charges to their financial statements which are not core to their main business activity."
                                            },
                                            {
                                                "example_id": "14535c17-df07-4fd6-8f50-b705a319cba5",
                                                "sense_id": "a5d05629-7024-3b0e-8f94-81be360e9761",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers. Piling debt onto companies’ balance-sheets is only a small part of what leveraged buy-outs are about, they insist. Improving the workings of the businesses they take over is just as core to their calling, if not more so. Much of their pleading is public-relations bluster."
                                            },
                                            {
                                                "example_id": "9dfd204d-3624-466b-bbda-77fe5be7609c",
                                                "sense_id": "a5d05629-7024-3b0e-8f94-81be360e9761",
                                                "text": "These lists cover important vocabulary from eight core subjects that students need to master during secondary education: Biology, Chemistry, Economics, English, Geology, History, Mathematics, and Physics."
                                            }
                                        ]
                                    },
