                    },
                    {
                        "sense_id": "7b272d63-2803-36ad-853f-688c15509594",
                        "entry_id": "30decfaf-9bb6-33e2-8011-054be5faf378",
                        "glosses": [
                            "tłumiący wolność słowa"
                        ],
                        "tags": [
                            "literary",
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "21811d67-b213-458b-92ca-c64b840735f0",
                                "sense_id": "7b272d63-2803-36ad-853f-688c15509594",
                                "text": "Stąd skok na Krajową Radę, promowanie Radia Maryja i Telewizji Trwam, a w pakcie znajdziemy także kagańcowe ustawy dotyczące prasy"
                            },
                            {
                                "example_id": "26dbcf43-252f-4723-be43-a865ed97e295",
                                "sense_id": "7b272d63-2803-36ad-853f-688c15509594",
                                "text": "Druga ustawa, o zgromadzeniach i stowarzyszeniach, w przeciwieństwie do większości posunięć antypolskich była ogólnoniemiecka, nie zaś tylko pruska. Nazywano ją ustawą \"kagańcową\", zarządzała bowiem, że wszelkie zgromadzenia publiczne obradować mają wyłącznie po niemiecku"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
