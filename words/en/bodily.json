{
    "word_family": [
        "body",
        "embody",
        "embodiment",
        "disembody",
        "bodiless"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0b3c04ac-71f2-38d4-8271-64669f36f0ad",
                    "sense_definition": "Connected with or belonging to the human body.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "body_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The victim suffered grievous <w>bodily</w> harm during the violent attack.",
                            "target_lang_translations": {
                                "ru": "Жертва получила тяжкие <w>телесные</w> повреждения во время жестокого нападения.",
                                "nl": "Het slachtoffer liep tijdens de gewelddadige aanval ernstig <w>lichamelijk</w> letsel op."
                            }
                        },
                        {
                            "text": "Doctors monitor various <w>bodily</w> functions to ensure the patient is stable.",
                            "target_lang_translations": {
                                "ru": "Врачи контролируют различные <w>телесные</w> функции, чтобы убедиться, что состояние пациента стабильно.",
                                "nl": "Artsen controleren verschillende <w>lichamelijke</w> functies om te garanderen dat de patiënt stabiel is."
                            }
                        }
                    ],
                    "synonyms": [
                        "physical"
                    ],
                    "antonyms": [
                        "mental"
                    ],
                    "common_phrases": [
                        "bodily harm",
                        "bodily functions",
                        "bodily fluids",
                        "bodily injury"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный с человеческим телом или принадлежащий ему.",
                        "nl": "Verbonden met of behorend tot het menselijk lichaam."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "телесный",
                                "target_lang_sense_clarification": "относящийся к телу"
                            },
                            {
                                "target_lang_word": "физический",
                                "target_lang_sense_clarification": "относящийся к организму"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "lichamelijk",
                                "target_lang_sense_clarification": "met betrekking tot het lichaam"
                            },
                            {
                                "target_lang_word": "fysiek",
                                "target_lang_sense_clarification": "betrekking hebbend op het lichaam"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29748019-ac4c-3f15-b65b-ad2a1c2ab4a1",
                    "sense_definition": "Having a physical form or substance rather than a spiritual one.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "material_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many ancient religions depict spirits without any <w>bodily</w> form.",
                            "target_lang_translations": {
                                "ru": "Многие древние религии изображают духов без какой-либо <w>телесной</w> формы.",
                                "nl": "Veel oude religies beelden geesten af zonder enige <w>lichamelijke</w> vorm."
                            }
                        },
                        {
                            "text": "He believed that the soul exists independently of our <w>bodily</w> presence.",
                            "target_lang_translations": {
                                "ru": "Он верил, что душа существует независимо от нашего <w>телесного</w> присутствия.",
                                "nl": "Hij geloofde dat de ziel onafhankelijk van onze <w>fysieke</w> aanwezigheid bestaat."
                            }
                        }
                    ],
                    "synonyms": [
                        "corporeal",
                        "physical"
                    ],
                    "antonyms": [
                        "spiritual",
                        "incorporeal"
                    ],
                    "common_phrases": [
                        "bodily form",
                        "bodily presence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий физическую форму или материальную сущность, в отличие от духовной.",
                        "nl": "Een fysieke vorm of substantie hebbend in plaats van een spirituele."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "телесный",
                                "target_lang_sense_clarification": "материальный, не духовный"
                            },
                            {
                                "target_lang_word": "материальный",
                                "target_lang_sense_clarification": "вещественный"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "lichamelijk",
                                "target_lang_sense_clarification": "in fysieke vorm"
                            },
                            {
                                "target_lang_word": "stoffelijk",
                                "target_lang_sense_clarification": "materieel, niet spiritueel"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7b192bf1-9c4d-3210-8a15-0d32f81303e4",
                    "sense_definition": "In a way that involves the entire physical body being moved or lifted as a single mass.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "whole_body_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security guards picked the protester up and removed him <w>bodily</w> from the hall.",
                            "target_lang_translations": {
                                "ru": "Охранники подняли протестующего и <w>на руках</w> вынесли его из зала.",
                                "nl": "De beveiligers tilden de demonstrant op en verwijderden hem <w>in zijn geheel</w> uit de zaal."
                            }
                        },
                        {
                            "text": "She was too tired to walk, so her father carried her <w>bodily</w> up the stairs.",
                            "target_lang_translations": {
                                "ru": "Она слишком устала, чтобы идти, поэтому отец отнес ее <w>на руках</w> вверх по лестнице.",
                                "nl": "Ze was te moe om te lopen, dus droeg haar vader haar <w>in zijn geheel</w> de trap op."
                            }
                        }
                    ],
                    "common_phrases": [
                        "thrown bodily",
                        "lifted bodily",
                        "removed bodily",
                        "carried bodily"
                    ],
                    "target_lang_definitions": {
                        "ru": "Таким образом, когда все тело перемещается или поднимается как единое целое.",
                        "nl": "Op een manier waarbij het gehele fysieke lichaam als één massa wordt verplaatst of opgetild."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на руках",
                                "target_lang_sense_clarification": "при переноске человека"
                            },
                            {
                                "target_lang_word": "целиком",
                                "target_lang_sense_clarification": "всем телом"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "in zijn geheel",
                                "target_lang_sense_clarification": "het hele lichaam tegelijk"
                            },
                            {
                                "target_lang_word": "met man en macht",
                                "target_lang_sense_clarification": "fysiek verplaatst"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a3c1515-1db0-315f-a14a-ed263cac5d7b",
                    "sense_definition": "In physical form; actually present in the flesh.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "in_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Although he could not be there <w>bodily</w>, he attended the meeting via video call.",
                            "target_lang_translations": {
                                "ru": "Хотя он не мог присутствовать там <w>лично</w>, он участвовал в собрании по видеосвязи.",
                                "nl": "Hoewel hij er niet <w>persoonlijk</w> kon zijn, woonde hij de vergadering via een videogesprek bij."
                            }
                        },
                        {
                            "text": "The author describes a character who is transported <w>bodily</w> into a magical world.",
                            "target_lang_translations": {
                                "ru": "Автор описывает персонажа, который <w>физически</w> переносится в волшебный мир.",
                                "nl": "De auteur beschrijft een personage dat <w>fysiek</w> naar een magische wereld wordt getransporteerd."
                            }
                        }
                    ],
                    "common_phrases": [
                        "present bodily"
                    ],
                    "target_lang_definitions": {
                        "ru": "В физической форме; фактически присутствующий во плоти.",
                        "nl": "In fysieke vorm; daadwerkelijk aanwezig in levende lijve."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лично",
                                "target_lang_sense_clarification": "собственной персоной"
                            },
                            {
                                "target_lang_word": "физически",
                                "target_lang_sense_clarification": "в реальности"
                            },
                            {
                                "target_lang_word": "во плоти",
                                "target_lang_sense_clarification": "в живом виде"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "persoonlijk",
                                "target_lang_sense_clarification": "in eigen persoon"
                            },
                            {
                                "target_lang_word": "fysiek",
                                "target_lang_sense_clarification": "in werkelijkheid aanwezig"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b03ec09a-ab32-32f4-9b92-ff4c6313e14e",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Bodily</w> has lived in this town for over fifty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Бодили</w> живет в этом городе уже более пятидесяти лет.",
                                "nl": "Meneer <w>Bodily</w> woont al meer dan vijftig jaar in deze stad."
                            }
                        },
                        {
                            "text": "We are looking for a record of a Sarah <w>Bodily</w> in the archives.",
                            "target_lang_translations": {
                                "ru": "Мы ищем запись о Саре <w>Бодили</w> в архивах.",
                                "nl": "We zoeken in de archieven naar een vermelding van een Sarah <w>Bodily</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "nl": "Een achternaam."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бодили",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "Bodily",
                                "target_lang_sense_clarification": "achternaam"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}