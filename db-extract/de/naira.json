                "senses": [
                    {
                        "sense_id": "bc6f69bd-598f-30e2-8cae-79c0e1315bd4",
                        "entry_id": "42244e57-0efd-3282-a98f-7e68eefb90b1",
                        "glosses": [
                            "Währung von Nigeria"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efb975c5-a43d-483e-9d3c-7c38353a9dd7",
                                "sense_id": "bc6f69bd-598f-30e2-8cae-79c0e1315bd4",
                                "text": "„›Ich habe der Köchin genaue Anweisungen gegeben und sie dann mit zweihundert Naira belohnt, als sie fertig war.‹“"
                            },
                            {
                                "example_id": "1316b159-80e5-42f9-abed-34defdff7b5e",
                                "sense_id": "bc6f69bd-598f-30e2-8cae-79c0e1315bd4",
                                "text": "„Dafür bekam ich eintausend Naira im Monat und durfte im Büro schlafen.“"
                            },
                            {
                                "example_id": "37cff144-dc21-4dcd-97f8-588c9191e37b",
                                "sense_id": "bc6f69bd-598f-30e2-8cae-79c0e1315bd4",
                                "text": "„Manchmal kriegen wir, abhängig von Politiker und Demo, bis zu hundertfünfzig Naira.“"
                            },
                            {
                                "example_id": "9d4d7655-ec96-4b92-8aff-6283a543f4a6",
                                "sense_id": "bc6f69bd-598f-30e2-8cae-79c0e1315bd4",
                                "text": "„Ich hole dreitausend Naira aus meiner Geldbörse und hoffe, dass die Summe genügt und er sie rasch annimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
