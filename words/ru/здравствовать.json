    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "72d6baae-949d-3b31-9f7c-93f6285e3f6e",
                    "sense_definition": "в форме повелительного наклонения (здравствуй, здравствуйте): формула вежливого приветствия при встрече",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "greeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Здравствуйте</w>, проходите пожалуйста и присаживайтесь за свободный столик.",
                            "target_lang_translations": {
                                "en": "<w>Hello</w>, please come in and take a seat at an available table."
                            }
                        },
                        {
                            "text": "<w>Здравствуй</w>, дорогой друг, я очень рад снова тебя видеть!",
                            "target_lang_translations": {
                                "en": "<w>Hello</w>, dear friend, I am very glad to see you again!"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "in the imperative mood (здравствуй, здравствуйте): a standard polite greeting upon meeting"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hello",
                                "target_lang_sense_clarification": "standard polite greeting"
                            },
                            {
                                "target_lang_word": "good day",
                                "target_lang_sense_clarification": "formal greeting"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e219efd-cbaf-386d-bb2b-65b0eaf5b85c",
                    "sense_definition": "быть здоровым, благополучно жить и существовать",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state_of_being",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой пожилой дедушка до сих пор живёт и <w>здравствует</w> в деревне.",
                            "target_lang_translations": {
                                "en": "My elderly grandfather is still alive and <w>well</w> in the countryside."
                            }
                        },
                        {
                            "text": "Несмотря на все прошлые трудности, эта компания благополучно <w>здравствует</w>.",
                            "target_lang_translations": {
                                "en": "Despite all the past difficulties, this company is successfully <w>thriving</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "процветать"
                    ],
                    "antonyms": [
                        "болеть",
                        "недомогать",
                        "хворать"
                    ],
                    "common_phrases": [
                        "жить и здравствовать"
                    ],
                    "target_lang_definitions": {
                        "en": "to be healthy, well, and live or exist in good condition"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be well",
                                "target_lang_sense_clarification": "to enjoy good health and life"
                            },
                            {
                                "target_lang_word": "prosper",
                                "target_lang_sense_clarification": "to flourish or be successful"
                            },
                            {
                                "target_lang_word": "thrive",
                                "target_lang_sense_clarification": "to do well and continue existing successfully"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d05bd6a-de56-38a7-bb08-b98106feea32",
                    "sense_definition": "в составе восклицания «да здравствует»: пожелание долгих лет, победы, благополучия или славы",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "state_of_being",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На главной городской площади люди дружно кричали: «Да <w>здравствует</w> мир!»",
                            "target_lang_translations": {
                                "en": "In the main city square, people were chanting in unison: \"<w>Long live</w> peace!\""
                            }
                        },
                        {
                            "text": "Да <w>здравствует</w> свобода и справедливость для каждого человека на земле!",
                            "target_lang_translations": {
                                "en": "<w>Long live</w> freedom and justice for every person on earth!"
                            }
                        }
                    ],
                    "synonyms": [
                        "процветать"
                    ],
                    "common_phrases": [
                        "да здравствует"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "торжественный или лозунговый стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "as part of the exclamation «да здравствует»: expressing a wish for long life, victory, prosperity, or glory"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "long live",
                                "target_lang_sense_clarification": "in solemn acclamations, as part of 'да здравствует'"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}