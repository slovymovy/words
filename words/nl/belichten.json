{
    "word_family": [
        "belichting",
        "licht",
        "lichten"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1347e1e9-7889-3c8d-b8bc-d65541c122b4",
                    "sense_definition": "Licht schijnen op een object of oppervlak om het zichtbaar te maken.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verlichting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze moesten de gevel <w>belichten</w> om hun werk in het donker te kunnen doen.",
                            "target_lang_translations": {
                                "en": "They had to <w>illuminate</w> the facade to be able to do their work in the dark."
                            }
                        },
                        {
                            "text": "De felle schijnwerpers <w>belichten</w> het podium prachtig tijdens de voorstelling.",
                            "target_lang_translations": {
                                "en": "The bright spotlights <w>light up</w> the stage beautifully during the performance."
                            }
                        }
                    ],
                    "synonyms": [
                        "verlichten",
                        "beschijnen"
                    ],
                    "common_phrases": [
                        "het podium belichten",
                        "een gebouw belichten"
                    ],
                    "target_lang_definitions": {
                        "en": "To shine light on an object or surface to make it visible."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "illuminate",
                                "target_lang_sense_clarification": "to shine light on something"
                            },
                            {
                                "target_lang_word": "light up",
                                "target_lang_sense_clarification": "to make bright with light"
                            },
                            {
                                "target_lang_word": "light",
                                "target_lang_sense_clarification": "to provide light for"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea93c4a8-32b1-3ea6-91ef-6fdb686605f9",
                    "sense_definition": "Een bepaalde tijd licht laten vallen op een lichtgevoelige plaat of film om een beeld vast te leggen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fotografie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze foto is helaas te lang <w>belicht</w> en daardor veel te licht geworden.",
                            "target_lang_translations": {
                                "en": "Unfortunately, this photo was <w>exposed</w> for too long and has therefore become much too bright."
                            }
                        },
                        {
                            "text": "Je moet de film precies lang genoeg <w>belichten</w> voor een scherp resultaat.",
                            "target_lang_translations": {
                                "en": "You have to <w>expose</w> the film for exactly the right amount of time for a sharp result."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een foto belichten",
                        "te lang belicht"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische term in fotografie"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To allow light to fall on a light-sensitive plate or film for a certain amount of time to capture an image."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "expose",
                                "target_lang_sense_clarification": "photography"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9937e83-3a26-30b4-ba45-48a65bf51b55",
                    "sense_definition": "Een onderwerp van een bepaalde kant bekijken, toelichten of vanuit een specifiek perspectief uitleggen.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "uitleggen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten die zaak ook eens <w>belichten</w> vanuit het perspectief van de dader.",
                            "target_lang_translations": {
                                "en": "We should also <w>examine</w> that case from the perpetrator's perspective."
                            }
                        },
                        {
                            "text": "In dit rapport worden de economische gevolgen van de crisis uitgebreid <w>belicht</w>.",
                            "target_lang_translations": {
                                "en": "The economic consequences of the crisis are <w>highlighted</w> extensively in this report."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitlichten"
                    ],
                    "common_phrases": [
                        "een probleem belichten",
                        "vanuit een perspectief belichten"
                    ],
                    "target_lang_definitions": {
                        "en": "To view, clarify, or explain a subject from a specific perspective or side."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "highlight",
                                "target_lang_sense_clarification": "to draw attention to"
                            },
                            {
                                "target_lang_word": "shed light on",
                                "target_lang_sense_clarification": "to clarify or explain"
                            },
                            {
                                "target_lang_word": "illuminate",
                                "target_lang_sense_clarification": "figurative: to clarify"
                            },
                            {
                                "target_lang_word": "examine",
                                "target_lang_sense_clarification": "to look at from a certain angle"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}