                        "examples": [
                            {
                                "example_id": "37e8ff3b-40c0-4a6e-95b6-adf005e76e68",
                                "sense_id": "cab73711-c541-32fb-9458-89a58f12b6e4",
                                "text": "Auteur de Qatar, le Mondial de la honte (éd. Libertalia), le journaliste Nicolas Kssis-Martov se dit « contre la culpabilisation. En revanche, on aurait déjà dû demander à nos députés de regarder ça de près. Après tout, ils ont bien voté l’envoi de 200 policiers français au Qatar. »"
                            },
                            {
                                "example_id": "e46d4372-b664-4df3-8062-0ee478b4fbb9",
                                "sense_id": "cab73711-c541-32fb-9458-89a58f12b6e4",
                                "text": "Puisque le sentiment de culpabilité est propre à l’individu, pour que la culpabilisation soit efficace, elle doit être spécifiquement adressée à chaque individu."
                            }
                        ]
                    }
