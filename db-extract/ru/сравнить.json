                ],
                "senses": [
                    {
                        "sense_id": "5df55c19-ba22-3b6a-ae17-9bdc569cf30c",
                        "entry_id": "849ccd30-4ac6-32c4-8733-419bec7f9427",
                        "glosses": [
                            "выявить различия между двумя объектами, явлениями и т.п.; сопоставить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19a73d09-9a05-4608-b47c-3db85ae3f90c",
                                "sense_id": "5df55c19-ba22-3b6a-ae17-9bdc569cf30c",
                                "text": "Потом, когда исполнение и запись «Орлеанской девы» на Французском радио состоялись, я смогла сравнить её с той, первой нашей работой — и сравнение было не в нашу пользу."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8adb53c-f59e-3f33-a32f-6366717bb4ec",
                        "entry_id": "849ccd30-4ac6-32c4-8733-419bec7f9427",
                        "glosses": [
                            "приравнять: указать на высокую степень сходства вплоть до равносильности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "047f41f5-e69e-4b48-8168-e705c3a1d2e3",
                                "sense_id": "c8adb53c-f59e-3f33-a32f-6366717bb4ec",
                                "text": "Однако с ужасом незримой погибели ничто не сравнить."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27552930-593a-4dba-93ca-8bd489d7b11b",
                        "source_entry_id": "849ccd30-4ac6-32c4-8733-419bec7f9427",
                        "target_lang_word": "compare",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49e45eef-3c8c-310f-afc3-f17d33a9add4",
                                        "entry_id": "6e8ff181-ad60-3b80-abbf-6fe10c51d3ec",
                                        "glosses": [
                                            "To assess the similarities and differences between two or more things [\\\"to compare X with Y\\\"]. Having made the comparison of X with Y, one might have found it similar to Y or different from Y."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5984d178-e079-4b87-808e-453d4f6c57e0",
                                                "sense_id": "49e45eef-3c8c-310f-afc3-f17d33a9add4",
                                                "text": "Compare the tiger's coloration with that of the zebra."
                                            },
                                            {
                                                "example_id": "1be92c75-b310-4b99-bcf4-7ed8d98a1976",
                                                "sense_id": "49e45eef-3c8c-310f-afc3-f17d33a9add4",
                                                "text": "You can't compare my problems and yours."
                                            },
                                            {
                                                "example_id": "e4341dcf-0d3d-44a6-86a8-eb38a0aacd6d",
                                                "sense_id": "49e45eef-3c8c-310f-afc3-f17d33a9add4",
                                                "text": "Sophia broke down here. Even at this moment she was subconsciously comparing her rendering of the part of the forlorn bride with Miss Marie Lohr's."
                                            },
                                            {
                                                "example_id": "4485c8cc-9406-46f7-b866-b5520bb065d3",
                                                "sense_id": "49e45eef-3c8c-310f-afc3-f17d33a9add4",
                                                "text": "Bats host many high-profile viruses that can infect humans, including severe acute respiratory syndrome and Ebola. A recent study explored the ecological variables that may contribute to bats’ propensity to harbor such zoonotic diseases by comparing them with another order of common reservoir hosts: rodents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c18e199-bece-3624-8858-343261a6e478",
                                        "entry_id": "6e8ff181-ad60-3b80-abbf-6fe10c51d3ec",
                                        "glosses": [
                                            "To declare two things to be similar in some respect [\\\"to compare X to Y\\\"]."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ef00010-a834-4507-907d-582f8d6550df",
                                                "sense_id": "4c18e199-bece-3624-8858-343261a6e478",
                                                "text": "Astronomers have compared comets to dirty snowballs."
                                            },
                                            {
                                                "example_id": "a4e794ef-2cd8-4a4c-8f2e-dde0d6b33b68",
                                                "sense_id": "4c18e199-bece-3624-8858-343261a6e478",
                                                "text": "Solon compared the people unto the sea, and orators and counsellors to the winds; for that the sea would be calm and quiet if the winds did not trouble it."
                                            },
                                            {
                                                "example_id": "9f1514e6-de9b-4fe9-89d9-b82273ef5394",
                                                "sense_id": "4c18e199-bece-3624-8858-343261a6e478",
                                                "text": "And wordy attacks against slavery drew sneers from observers which were not altogether undeserved. The authors were compared to doctors who offered to a patient nothing more than invectives against the disease which consumed him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccf13e23-2af7-3432-9f0f-74a16ade2d36",
                                        "entry_id": "6e8ff181-ad60-3b80-abbf-6fe10c51d3ec",
                                        "glosses": [
                                            "To form the three degrees of comparison of (an adjective)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3252ddc8-05d5-4b18-9af7-97af06e75d46",
                                                "sense_id": "ccf13e23-2af7-3432-9f0f-74a16ade2d36",
                                                "text": "We compare \"good\" as \"good\", \"better\", \"best\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3c39e7e-1c33-32f0-a760-c4d8f8b42d02",
                                        "entry_id": "6e8ff181-ad60-3b80-abbf-6fe10c51d3ec",
                                        "glosses": [
                                            "To be similar (often used in the negative)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7eafe663-0151-4697-bb3c-e53edf8b6769",
                                                "sense_id": "f3c39e7e-1c33-32f0-a760-c4d8f8b42d02",
                                                "text": "A sapling and a fully-grown oak tree do not compare."
                                            },
                                            {
                                                "example_id": "afeb9bbe-a979-4913-a75f-35f4dfa84bf9",
                                                "sense_id": "f3c39e7e-1c33-32f0-a760-c4d8f8b42d02",
                                                "text": "Shall pack-horses[…]compare with Caesar's?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc0e8bbe-c936-3112-bb22-a6f0127a3f6b",
                                        "entry_id": "6e8ff181-ad60-3b80-abbf-6fe10c51d3ec",
                                        "glosses": [
                                            "To get; to obtain."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51ed1bbc-d0fc-4959-bc3f-f5e8ab62d62f",
                                                "sense_id": "dc0e8bbe-c936-3112-bb22-a6f0127a3f6b",
                                                "text": "To fill his bags, and richesse to compare."
                                            }
                                        ]
                                    }
                                ]
                            },
