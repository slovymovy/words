                ],
                "senses": [
                    {
                        "sense_id": "702b2643-6e64-340e-91de-7dd1f47d63e4",
                        "entry_id": "15efc2a8-9226-31c0-b0cb-c6c43655ecc9",
                        "glosses": [
                            "het verschijnsel dat de maan verduisterd raakt doordat ze in de schaduw van de aarde komt te staan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55d01ae1-f705-4f19-b5d9-80d0822782c2",
                                "sense_id": "702b2643-6e64-340e-91de-7dd1f47d63e4",
                                "text": "In Azië was er een maansverduistering zichtbaar."
                            },
                            {
                                "example_id": "13d0bae2-7499-48f1-9c00-1c9f395d4049",
                                "sense_id": "702b2643-6e64-340e-91de-7dd1f47d63e4",
                                "text": "Een maansverduistering komt voor als de aarde precies tussen de zon en de maan in komt."
                            },
                            {
                                "example_id": "bef423d7-6fdf-41d2-8aa8-e3f0889b7e39",
                                "sense_id": "702b2643-6e64-340e-91de-7dd1f47d63e4",
                                "text": "Wie vanochtend vroeg opstond, naar buiten keek en geen last had van bewolking, kon het begin van een totale maansverduistering zien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6dd13fe-5eee-4d9d-850b-7b4ffc62168f",
                        "source_entry_id": "15efc2a8-9226-31c0-b0cb-c6c43655ecc9",
                        "source_sense_id": "702b2643-6e64-340e-91de-7dd1f47d63e4",
                        "source_sense_description": "het verschijnsel dat de maan verduisterd raakt doordat ze in de schaduw...",
                        "target_lang_word": "Mondfinsternis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mondfinsternis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f96916a1-5e88-390f-9420-a79cb43a9a89",
                                        "entry_id": "a2ab20e4-c736-3af2-9e61-0e06f52c800b",
                                        "glosses": [
                                            "Ereignis, bei dem der Mond durch den Kernschatten der Erde wandert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88aa9ee8-eab6-41a1-a33a-f6d8322ec991",
                                                "sense_id": "f96916a1-5e88-390f-9420-a79cb43a9a89",
                                                "text": "„Sterngucker haben in der Nacht in weiten Teilen Deutschlands vergeblich im Freien, auf Straßen und Balkonen gefroren: Eine dicke Wolkendecke verdeckte den Blick auf die totale Mondfinsternis.“"
                                            },
                                            {
                                                "example_id": "d0e6e85e-a617-484b-ad2d-ce96838ec131",
                                                "sense_id": "f96916a1-5e88-390f-9420-a79cb43a9a89",
                                                "text": "„Der Mond zieht im Jahr 2015 zweimal durch den Kernschatten der Erde. Am 4. April gegen 12 Uhr Weltzeit kommt es zur ersten totalen Mondfinsternis.“"
                                            },
                                            {
                                                "example_id": "1afe933c-ff91-46ef-b937-a59e0a57cb69",
                                                "sense_id": "f96916a1-5e88-390f-9420-a79cb43a9a89",
                                                "text": "„Eine Mondfinsternis entsteht nur bei Vollmond, wenn die Erde zwischen Sonne und Mond steht.“"
                                            },
                                            {
                                                "example_id": "3ec7de58-3626-4eec-bbd6-c345fb5b31b4",
                                                "sense_id": "f96916a1-5e88-390f-9420-a79cb43a9a89",
                                                "text": "„Bei einer totalen Mondfinsternis durchläuft der Mond vollständig den Kernschatten der Erde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
