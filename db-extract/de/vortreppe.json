                "senses": [
                    {
                        "sense_id": "f434fe1c-8597-301f-9dba-4878dc92a41e",
                        "entry_id": "29b7e6a6-83d7-3ad3-aad7-1ebed960942a",
                        "glosses": [
                            "vor dem Eingang eines Gebäudes befindliche Treppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9aa99ec-beff-470f-b366-49fd9ba1da19",
                                "sense_id": "f434fe1c-8597-301f-9dba-4878dc92a41e",
                                "text": "„Nachdem man sich der Tafelordnung gemäß allseitig niedergelassen hatte und Tee gereicht worden war, ertönte von der Vortreppe Paukenschall, Streichmusik mit Flöten und Gesang.“"
                            },
                            {
                                "example_id": "e47f44f8-a15d-460a-9031-87344baa45b4",
                                "sense_id": "f434fe1c-8597-301f-9dba-4878dc92a41e",
                                "text": "„Ein Kind sitzt mit einem Stock in der Hand auf einer Vortreppe.“"
                            },
                            {
                                "example_id": "8799d63b-bcfe-4030-b329-6bafc74a9d4f",
                                "sense_id": "f434fe1c-8597-301f-9dba-4878dc92a41e",
                                "text": "„Er stolpert beinahe über eine Vortreppe, fängt sich aber im letzten Moment.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
