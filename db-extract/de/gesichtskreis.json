                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "e22c7a63-b067-4245-8f66-bcdd6b1a993e",
                                "sense_id": "c359e3fe-eeed-3927-af7a-62ccba4d29a4",
                                "text": "Ich hielt das nie lange aus und war stets die erste, die Mittel und Wege fand, aus ihrem Gesichtskreis zu verschwinden.",
                                "translation": "Memoirs of a Woman Socialist",
                                "english": "Memoirs of a Woman Socialist"
                            }
                        ]
                    },
                    {
                        "sense_id": "4642ccad-c731-3060-ab35-f66f06ec0b32",
                        "entry_id": "39750350-2a1e-33b9-abd0-1f72c04daf10",
                        "glosses": [
                            "horizon"
                        ],
                        "tags": [
                            "dated",
                            "masculine",
                            "strong"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e46fb0e6-44e5-3d05-8488-c74b089e908d",
                        "entry_id": "39750350-2a1e-33b9-abd0-1f72c04daf10",
                        "glosses": [
                            "knowledge, horizon"
                        ],
                        "tags": [
                            "figuratively",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "0d6fc4f2-561c-4490-8ff1-20246d18d38d",
                                "sense_id": "e46fb0e6-44e5-3d05-8488-c74b089e908d",
                                "text": "Sie hatte einen engen Gesichtskreis.",
                                "translation": "She had little knowledge.",
                                "english": "She had little knowledge."
                            },
                            {
                                "example_id": "41288071-5297-4afa-8570-ddb5006478be",
                                "sense_id": "e46fb0e6-44e5-3d05-8488-c74b089e908d",
                                "text": "Sie trat eine lange Reise an, um ihren Gesichtskreis zu erweitern.",
                                "translation": "She embarked on a long journey to broaden her horizons.",
                                "english": "She embarked on a long journey to broaden her horizons."
                            }
                        ]
                    }
