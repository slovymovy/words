                                "target_senses": [
                                    {
                                        "sense_id": "c54f6c60-9d30-3900-ace5-d046f4c7aa2d",
                                        "entry_id": "ec1faa4c-cff4-363a-8614-337daae50d3f",
                                        "glosses": [
                                            "Dépourvu de queue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd780b90-6843-44ef-bda9-c2af935f32a7",
                                                "sense_id": "c54f6c60-9d30-3900-ace5-d046f4c7aa2d",
                                                "text": "La grenouille et le crapaud sont des amphibiens anoures, contrairement à la salamandre."
                                            },
                                            {
                                                "example_id": "ab5097b2-f08e-45c8-8fb0-4c84ac3f8316",
                                                "sense_id": "c54f6c60-9d30-3900-ace5-d046f4c7aa2d",
                                                "text": "Ceux-ci n’ont d’ailleurs pas donné de descendance entre eux; la forme complètement anoure paraît donc stérile et rarement viable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anoure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea34d2fa-509c-314e-82fd-cccf99695325",
                                        "entry_id": "a7df63f7-e3e7-37fc-9405-2ad4d0e2aba1",
                                        "glosses": [
                                            "Animal sans queue. Se dit en particulier des amphibiens dépourvus de queue à l'âge adulte et possédant des membres postérieurs adaptés au saut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0e6be66-cc74-4a16-83be-08ff641d9e73",
                                                "sense_id": "ea34d2fa-509c-314e-82fd-cccf99695325",
                                                "text": "Salamandres et tritons ne sont pas des anoures mais des urodèles : les adultes conservent leur queue !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
