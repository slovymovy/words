            "pos": "noun",
            "senses": [
                {
                    "sense_id": "24bad844-e9df-3375-9036-662cdeecd728",
                    "sense_definition": "Podstawowa jednostka języka, ciąg dźwięków lub liter mający określone znaczenie.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "language_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie rozumiem tego <w>słowa</w>, czy możesz mi je wytłumaczyć?",
                            "target_lang_translations": {
                                "ru": "Я не понимаю этого <w>слова</w>, можешь мне его объяснить?"
                            }
                        },
                        {
                            "text": "W każdym języku istnieją <w>słowa</w>, których nie da się łatwo przetłumaczyć.",
                            "target_lang_translations": {
                                "ru": "В каждом языке есть <w>слова</w>, которые невозможно легко перевести."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyraz"
                    ],
                    "common_phrases": [
                        "trudne słowo",
                        "nowe słowo",
                        "pisać słowa"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основная единица языка, последовательность звуков или букв, имеющая определенное значение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слово",
                                "target_lang_sense_clarification": "единица языка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0dec988c-edc0-31b2-9c89-8a1021209802",
                    "sense_definition": "Zobowiązanie do zrobienia czegoś; obietnica lub zapewnienie o prawdzie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "promise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Daję ci <w>słowo</w>, że oddam te pieniądze w przyszłym tygodniu.",
                            "target_lang_translations": {
                                "ru": "Даю тебе <w>слово</w>, что верну эти деньги на следующей неделе."
                            }
                        },
                        {
                            "text": "On zawsze dotrzymuje <w>słowa</w>, więc możesz mu w pełni zaufać.",
                            "target_lang_translations": {
                                "ru": "Он всегда держит <w>слово</w>, так что ты можешь ему полностью доверять."
                            }
                        }
                    ],
                    "synonyms": [
                        "obietnica"
                    ],
                    "common_phrases": [
                        "dać słowo",
                        "dotrzymać słowa",
                        "złamać słowo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обязательство сделать что-либо; обещание или заверение в истинности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слово",
                                "target_lang_sense_clarification": "обещание"
                            },
                            {
                                "target_lang_word": "обещание",
                                "target_lang_sense_clarification": "обязательство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ba81348-db0a-31f5-9f97-24202258ef33",
                    "sense_definition": "Krótka wypowiedź ustna lub pisemna.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dyrektor skierował do nas kilka ciepłych <w>słów</w> na pożegnanie.",
                            "target_lang_translations": {
                                "ru": "Директор сказал нам несколько теплых <w>слов</w> на прощание."
                            }
                        },
                        {
                            "text": "Chciałbym powiedzieć parę <w>słów</w> na temat naszego nowego projektu.",
                            "target_lang_translations": {
                                "ru": "Я хотел бы сказать пару <w>слов</w> о нашем новом проекте."
                            }
                        }
                    ],
                    "synonyms": [
                        "wypowiedź"
                    ],
                    "common_phrases": [
                        "parę słów",
                        "kilka słów",
                        "zamienić słowo"
                    ],
                    "target_lang_definitions": {
