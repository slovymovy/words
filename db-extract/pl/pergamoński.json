                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pergamenisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d7d1a43-f51c-3c3f-bfd3-166875c653b0",
                                        "entry_id": "05a880b4-8f7e-318f-8ab3-56e346de04ef",
                                        "glosses": [
                                            "auf die antike Stadt Pergamon bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbceda2e-87a2-460d-a973-b48cda046e32",
                                                "sense_id": "2d7d1a43-f51c-3c3f-bfd3-166875c653b0",
                                                "text": "Der Pergamonaltar ist ein Beispiel pergamenischer Kunst."
                                            },
                                            {
                                                "example_id": "750717fb-e5d3-48ec-9736-3ad7ea4d188e",
                                                "sense_id": "2d7d1a43-f51c-3c3f-bfd3-166875c653b0",
                                                "text": "Attalos I. war ein pergamenischer Herrscher."
                                            },
                                            {
                                                "example_id": "87cb644d-6522-46d7-8863-4207b019b33b",
                                                "sense_id": "2d7d1a43-f51c-3c3f-bfd3-166875c653b0",
                                                "text": "„Der pergamenische König vertrieb auch Antiochos Hierax aus Kleinasien, den seleukidischen Prätendenten, dessen galatische Söldner gemeutert hatten.“"
                                            },
                                            {
                                                "example_id": "34536cec-b7ce-4e2e-8235-24c37e96a425",
                                                "sense_id": "2d7d1a43-f51c-3c3f-bfd3-166875c653b0",
                                                "text": "„Mehrfach weist Furtwängler ein pergamenisches Statuenmotiv in der pompeianischen Malerei nach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
