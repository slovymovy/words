                    {
                        "form_id": "4f67fe34-d79a-43d8-800b-6656b22d5076",
                        "entry_id": "815878c0-3b87-37f3-9662-bd5f63a93029",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Weingeiste"
                    },
                    {
                        "form_id": "8f531d4f-fba8-42b7-a01a-2ca953af079e",
                        "entry_id": "815878c0-3b87-37f3-9662-bd5f63a93029",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Weingeister"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "20b3f1b1-d340-3db3-84f1-22bfa5fba190",
                        "entry_id": "815878c0-3b87-37f3-9662-bd5f63a93029",
                        "glosses": [
                            "trinkbarer Alkohol"
                        ],
                        "tags": [
                            "archaic",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "0e9a1632-ada1-4a6a-8465-84bdea313c0f",
                                "sense_id": "20b3f1b1-d340-3db3-84f1-22bfa5fba190",
                                "text": "„Ich besitze zwei Embryonen in Weingeist aufbewahrt, deren Namen ich beizuschreiben vergessen habe, und nun bin ich ganz ausser Stand zu sagen, zu welcher Klasse sie gehören. Es können Eidechsen oder kleine Vögel oder sehr junge Säugthiere seyn […]“"
                            },
                            {
                                "example_id": "1640767d-9ba9-46e9-8c1b-c0abd1e0ab59",
                                "sense_id": "20b3f1b1-d340-3db3-84f1-22bfa5fba190",
                                "text": "„Wenn Hämmer zerbrechen, so können dieselben mit einem guten Leim wieder zusammen geleimt werden. Am besten ist es, wenn der Leim entweder mit Weingeist oder mit Essig angesetzt wird. Auch kann man etwas Hausenblasen darunter mischen.“"
                            },
                            {
                                "example_id": "b083b245-d523-4af1-8813-c4dcc4798355",
                                "sense_id": "20b3f1b1-d340-3db3-84f1-22bfa5fba190",
                                "text": "„Diese taten es: er röche nicht nach Weingeist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2bd8e9bb-26d5-3593-8294-6986ed0c791c",
                        "entry_id": "815878c0-3b87-37f3-9662-bd5f63a93029",
                        "glosses": [
                            "ein durch Destillation von Weintrauben hergestellter Branntwein (vgl. auch z. B. Himbeergeist, Melissengeist)"
                        ],
                        "tags": [
                            "Plural 1"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "171f4757-451b-3b89-b930-04411e215a83",
                        "entry_id": "815878c0-3b87-37f3-9662-bd5f63a93029",
                        "glosses": [
                            "ein Geist im Wein; ein Geist, der aus dem Wein kommt"
                        ],
                        "tags": [
                            "Plural 2"
                        ],
                        "examples": [
                            {
                                "example_id": "6fd86bef-92f2-4994-a4e5-b0597200d25e",
                                "sense_id": "171f4757-451b-3b89-b930-04411e215a83",
                                "text": "„Seid Ihr von den paar Tropfen schon betrunken, daß Ihr den Teufel heraufbeschwört? Wißt Ihr denn nicht, daß die Weingeister aufstehen diese Nacht und einander besuchen, wie immer am ersten September?“"
                            },
                            {
                                "example_id": "175a97ca-1bae-4ba0-9479-7cfe0c09a79c",
                                "sense_id": "171f4757-451b-3b89-b930-04411e215a83",
                                "text": "Ein Leben, das er nicht kannte, Stimmen, die er nie gehört, Regungen die er nie empfunden, wurden in diesem Augenblicke in ihm laut, schrien und wogten durcheinander, stiegen wie lustige Weingeister in seinen Kopf und machten ihn unfähig, irgend einen zusammenhängenden Gedanken zu denken."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "006ef76e-1f87-4afa-8901-934ccd5cc781",
                        "source_entry_id": "815878c0-3b87-37f3-9662-bd5f63a93029",
                        "source_sense_id": "20b3f1b1-d340-3db3-84f1-22bfa5fba190",
                        "source_sense_description": "veraltet, noch umgangssprachlich, ohne Plural: trinkbarer Alkohol",
                        "target_lang_word": "alcohol",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alcohol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aecf6387-3f0d-3399-b680-fb6b4b9f183a",
                                        "entry_id": "816dfba1-df4d-3b4e-b11d-6ec4d6432bd0",
                                        "glosses": [
                                            "Any of a class of organic compounds (such as ethanol) containing a hydroxyl functional group (-OH)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ccd2a1c-985e-37e0-b3f1-abc1dcf86d60",
                                        "entry_id": "816dfba1-df4d-3b4e-b11d-6ec4d6432bd0",
                                        "glosses": [
                                            "Ethanol."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "185c62b0-1dc2-4500-bcb9-a207fdf9dbe0",
                                                "sense_id": "8ccd2a1c-985e-37e0-b3f1-abc1dcf86d60",
                                                "text": "Our stomachs and livers have an enzyme known as alcohol dehydrogenase that breaks down ethanol to make it less toxic for our bodies, said Atlanta gastroenterologist Dr. Preston Stewart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17ce5dac-a7f3-30e6-8598-c455dbe64c5d",
                                        "entry_id": "816dfba1-df4d-3b4e-b11d-6ec4d6432bd0",
                                        "glosses": [
                                            "Beverages containing ethanol, collectively."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75fee638-a478-403d-8bb6-6583e51740b5",
                                                "sense_id": "17ce5dac-a7f3-30e6-8598-c455dbe64c5d",
                                                "text": "Risk is everywhere. From tabloid headlines insisting that coffee causes cancer (yesterday, of course, it cured it) to stern government warnings about alcohol and driving, the world is teeming with goblins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "992a1a25-511d-3c20-a660-5367a0f9136c",
                                        "entry_id": "816dfba1-df4d-3b4e-b11d-6ec4d6432bd0",
                                        "glosses": [
                                            "Any very fine powder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
