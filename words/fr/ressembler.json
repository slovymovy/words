{
    "word_family": [
        "ressemblance",
        "ressemblant",
        "dissemblable",
        "dissemblance",
        "semblable",
        "sembler",
        "semblant",
        "assembler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f1dd9b6c-8618-38d7-a774-424c05e588ba",
                    "sense_definition": "Avoir des traits ou des qualités en commun avec une personne ou une chose ; lui être semblable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "similitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne trouvez-vous pas qu'elles <w>ressemblent</w> à leur mère ?"
                        },
                        {
                            "text": "Ce petit chien <w>ressemble</w> à un ourson en peluche."
                        },
                        {
                            "text": "Ta nouvelle voiture <w>ressemble</w> beaucoup à celle de mon frère."
                        }
                    ],
                    "synonyms": [
                        "tenir de"
                    ],
                    "common_phrases": [
                        "ressembler à sa mère",
                        "ressembler beaucoup à",
                        "ressembler à s'y méprendre"
                    ]
                },
                {
                    "sense_id": "29877eb3-aa1d-3a55-b7c2-de352dd2e33b",
                    "sense_definition": "Avoir l'apparence ou le comportement de quelqu'un ou de quelque chose ; donner l'impression d'être semblable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "similitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette maison <w>ressemble</w> à un petit château de conte de fées."
                        },
                        {
                            "text": "Avec son manteau noir, il <w>ressemble</w> à un détective."
                        },
                        {
                            "text": "Ce nuage <w>ressemble</w> à un gros animal endormi."
                        }
                    ],
                    "synonyms": [
                        "avoir l'air de"
                    ],
                    "common_phrases": [
                        "ressembler à un château",
                        "ne ressembler à rien"
                    ]
                },
                {
                    "sense_id": "f6efade5-330b-3010-bbc9-8df2f07a3ebb",
                    "sense_definition": "Avoir du rapport, de la conformité avec quelqu'un ou quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "similitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'écuyer s'avance avec un grand couteau qui <w>ressemble</w> à un sabre."
                        },
                        {
                            "text": "Ce nouveau quartier <w>ressemble</w> beaucoup à celui où j'ai grandi."
                        },
                        {
                            "text": "À quoi <w>ressemblera</w> notre ville dans cinquante ans ?"
                        }
                    ],
                    "common_phrases": [
                        "ressembler à quoi",
                        "ressembler de près ou de loin"
                    ]
                },
                {
                    "sense_id": "30e94795-76b8-31da-9160-4b246659efac",
                    "sense_definition": "Être semblables l'un à l'autre (forme pronominale, se ressembler).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "similitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils se <w>ressemblent</w> beaucoup, presque comme deux gouttes d'eau."
                        },
                        {
                            "text": "Les deux sœurs ne se <w>ressemblent</w> pas du tout."
                        },
                        {
                            "text": "Nous nous <w>ressemblons</w> plus que tu ne le penses."
                        }
                    ],
                    "antonyms": [
                        "différer"
                    ],
                    "common_phrases": [
                        "se ressembler beaucoup",
                        "se ressembler comme deux gouttes d'eau",
                        "se ressembler trait pour trait"
                    ]
                },
                {
                    "sense_id": "08a10ae0-16b1-3f83-b5dd-b4eecaa864da",
                    "sense_definition": "Reproduire fidèlement l'apparence d'une personne ou d'un objet, en parlant d'une image, d'une copie ou d'un portrait.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "imitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce buste est plein de talent, mais il ne <w>ressemble</w> guère au modèle."
                        },
                        {
                            "text": "Cette copie ne <w>ressemble</w> pas à l'original."
                        },
                        {
                            "text": "Il faut qu'un portrait <w>ressemble</w> à la personne représentée."
                        }
                    ],
                    "common_phrases": [
                        "ressembler au modèle",
                        "ressembler à l'original"
                    ]
                },
                {
                    "sense_id": "5b7d59e7-9260-3e30-9ed5-4540743f837a",
                    "sense_definition": "Être conforme au caractère ou à la façon habituelle de penser et d'agir d'une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "caractere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Agir de cette façon ne me <w>ressemble</w> pas, ce n'est pas moi."
                        },
                        {
                            "text": "Cela lui <w>ressemble</w> bien d'arriver en retard à son propre mariage."
                        },
                        {
                            "text": "Une telle réaction ne <w>ressemble</w> pas à ma sœur, elle est si calme."
                        }
                    ],
                    "common_phrases": [
                        "cela me ressemble",
                        "ne pas ressembler à quelqu'un"
                    ]
                },
                {
                    "sense_id": "483fc4af-f244-3b85-85e8-e72942e419de",
                    "sense_definition": "Avoir un air de famille ou les mêmes penchants que quelqu'un.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "similitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet enfant <w>ressemble</w> à son grand-père, tant par le visage que par le caractère."
                        },
                        {
                            "text": "Les fils <w>ressemblent</w> souvent à leur père par leurs goûts et leurs manies."
                        },
                        {
                            "text": "Elle <w>ressemble</w> à sa tante, autant par l'allure que par les idées."
                        }
                    ],
                    "synonyms": [
                        "tenir de"
                    ],
                    "common_phrases": [
                        "ressembler à son père",
                        "ressembler à ses parents"
                    ]
                },
                {
                    "sense_id": "6b7d0522-5ff3-3d4f-b1af-f1b795d8fcac",
                    "sense_definition": "Dans des expressions négatives ou ironiques, être banal, ou au contraire original ou bizarre (ne ressembler à rien, ressembler à tout).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "originalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce tableau ne <w>ressemble</w> à rien de ce que j'ai vu auparavant."
                        },
                        {
                            "text": "Cette décoration ne <w>ressemble</w> à rien, je la trouve vraiment affreuse."
                        },
                        {
                            "text": "Ce film <w>ressemble</w> à tout ce qu'on a déjà vu mille fois."
                        }
                    ],
                    "common_phrases": [
                        "ne ressembler à rien",
                        "ressembler à tout"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "surtout dans les expressions figées « ne ressembler à rien » et « ressembler à tout »"
                        }
                    ]
                }
            ]
        }
    ]
}