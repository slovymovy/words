        "fr-extract.jsonl": [
            {
                "entry_id": "ef2fc06e-9bd6-3a49-b85d-536c66bc8f75",
                "word": "lazaret",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3081ff0d-0c99-4c19-a3f5-3601b364f01c",
                        "entry_id": "ef2fc06e-9bd6-3a49-b85d-536c66bc8f75",
                        "tags": [
                            "plural"
                        ],
                        "form": "lazarets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8cd32f54-8680-38bf-b54a-3f2d6c4bfdee",
                        "entry_id": "ef2fc06e-9bd6-3a49-b85d-536c66bc8f75",
                        "glosses": [
                            "Léproserie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "302a06c1-908c-48e7-a73d-107958059625",
                                "sense_id": "8cd32f54-8680-38bf-b54a-3f2d6c4bfdee",
                                "text": "Ainsi qu'ailleurs, par exemple au Mans et à Saint-Jacques de Paris, Reims construira un lazaret ou « bureau de santé » pour les pestiférés, et ce bureau sera tenu par les Capucins."
                            }
                        ]
                    },
                    {
                        "sense_id": "9bd90e42-cbfd-300d-a70f-7ebdfab25733",
                        "entry_id": "ef2fc06e-9bd6-3a49-b85d-536c66bc8f75",
                        "glosses": [
                            "Lieu où sont isolées les personnes en quarantaine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cb9d504-e690-4c18-8d34-a39a6f13a864",
                                "sense_id": "9bd90e42-cbfd-300d-a70f-7ebdfab25733",
                                "text": "Vers les quatre heures, nous étions en vue de Gibraltar, attendant que la santé (c’est ainsi que l’on appelle les agents du lazaret) voulût bien venir prendre nos papiers avec des pincettes, et voir si d’aventure nous n’apportions pas dans nos poches quelque fièvre jaune, quelque choléra bleu, ou quelque peste noire."
                            },
                            {
                                "example_id": "d0fdfcd5-e319-4b96-af57-d5348790ef2c",
                                "sense_id": "9bd90e42-cbfd-300d-a70f-7ebdfab25733",
                                "text": "Le Bû de la Rue était une sorte de lazaret ; on tenait Gilliatt en quarantaine."
                            },
                            {
                                "example_id": "8b840433-cfa5-4b68-a4de-b8c08245a7fc",
                                "sense_id": "9bd90e42-cbfd-300d-a70f-7ebdfab25733",
                                "text": "Pour un symptôme douteux on expédie le contagieux au lazaret d’isolement."
                            },
                            {
                                "example_id": "6013ef71-49e3-4659-9bfe-a134941b7349",
                                "sense_id": "9bd90e42-cbfd-300d-a70f-7ebdfab25733",
                                "text": "Le Makua, lui, il a été fouetté comme une vieille natte toute poussiéreuse. Sur la petite place du lazaret. Et en public. Pour faire un exemple, qu’ils ont dit…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "814164c9-3655-4c8b-bdd8-717d5f81c453",
                        "source_entry_id": "ef2fc06e-9bd6-3a49-b85d-536c66bc8f75",
                        "source_sense_id": "8cd32f54-8680-38bf-b54a-3f2d6c4bfdee",
                        "source_sense_description": "Bâtiment réservé à l’isolement de qui ou quoi est potentiellement contagieux",
                        "target_lang_word": "lazaretto",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lazaretto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c80c4fa3-afd5-3500-88c6-82c4496d5f1c",
                                        "entry_id": "3002b9c3-1507-3111-94f8-7e295989b2cc",
                                        "glosses": [
                                            "A place reserved for people with infectious diseases (especially leprosy or plague) to live on a long-term basis."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd80c1ca-e216-447b-92fa-aeda116126d5",
                                                "sense_id": "c80c4fa3-afd5-3500-88c6-82c4496d5f1c",
                                                "text": "For the plague, there is an houſe of many lodgeingꝭ [lodgeinges], two miles from Venice, called the Lazaretta, vnto the which all they of that houſe, wherin one hath been infected of the plague, are incontinẽtly ſent, and a lodgeyng ſufficiente appoincted for theim till the infection ceaſſe, that they may retourne."
                                            },
                                            {
                                                "example_id": "4017a885-f5de-4fc6-842d-56534ea72fd0",
                                                "sense_id": "c80c4fa3-afd5-3500-88c6-82c4496d5f1c",
                                                "text": "They are in their Method of Devotion, pious and charitable, their ſtately Temples, and Monaſteries demonſtrat the one, and their Lazarettos, or Houſes for the Poor do verify the other, ſpecially that of Monte de pietà, an Hoſpital of 60000."
                                            },
                                            {
                                                "example_id": "7df57c53-1006-4b04-8dd6-a1c9edff35d0",
                                                "sense_id": "c80c4fa3-afd5-3500-88c6-82c4496d5f1c",
                                                "text": "The Lazaretto is a vaſt Building, carrying in compaſs a thouſand and eight hundred yards. It ſtands near the Tovvn VValls, yet out of the Tovvn, and is to receive into it thoſe that are ſick of the Plague."
                                            },
                                            {
                                                "example_id": "04740a08-d452-46e4-8493-7201753a8395",
                                                "sense_id": "c80c4fa3-afd5-3500-88c6-82c4496d5f1c",
                                                "text": "It is planted with ſhady trees; and in the center is a building, vvhich ſerves for a hoſpital, or lazaretto, for perſons afflicted vvith the leproſy, or other incurable diſeaſes, vvho are ſent thither from Batavia."
                                            },
                                            {
                                                "example_id": "e0ba7563-09b0-47a7-b4d2-0a97e8be9394",
                                                "sense_id": "c80c4fa3-afd5-3500-88c6-82c4496d5f1c",
                                                "text": "[T]he dreary expanse of whitewashed walls, that at so small a cost might have been embellished by plaster-of-Paris friezes and large medallions, illustrating to the eye of the youthful student the most memorable glorifications of literature—these were bare as the walls of a poor-house or a lazaretto; […]"
                                            },
                                            {
                                                "example_id": "7347266c-abb5-40db-8a3f-859c1b479945",
                                                "sense_id": "c80c4fa3-afd5-3500-88c6-82c4496d5f1c",
                                                "text": "Miss Rossignol lived in the lazaretto / For Roman Catholic crones; she had white skin, / And underneath it, fine, old-fashioned bones; […]"
                                            },
                                            {
                                                "example_id": "e18550c9-222a-40aa-a133-cb94ecf96b12",
                                                "sense_id": "c80c4fa3-afd5-3500-88c6-82c4496d5f1c",
                                                "text": "And they led me to visit a suspended street recently opened over a bamboo grove, a shadow-theater under construction in the place of the municipal kennels, now moved to the pavilions of the former lazaretto, abolished when the last plague victims were cured, […]"
                                            },
                                            {
                                                "example_id": "0fa021ac-25aa-4cec-a39b-cc40c6cf75dc",
                                                "sense_id": "c80c4fa3-afd5-3500-88c6-82c4496d5f1c",
                                                "text": "Reader take pity on me, in the greatest of my sufferings. I can swear to you that all the bodily torments which are of necessity suffered in the lazaretti cannot compare even to the fleas, for they do not leave me even in the coldest depths of winter."
                                            },
                                            {
                                                "example_id": "a1a9462d-ec4a-4f90-a311-e33ac9473470",
                                                "sense_id": "c80c4fa3-afd5-3500-88c6-82c4496d5f1c",
                                                "text": "It is probable that from their inception the lazaretti did not house all plague victims. Wealthier victims were probably \"quarantined\" in their homes."
                                            },
                                            {
                                                "example_id": "5f4b5b7e-8127-4826-acc1-db3649d6155d",
                                                "sense_id": "c80c4fa3-afd5-3500-88c6-82c4496d5f1c",
                                                "text": "[T]he idea of an isolated, specialized treatment facility like the leprosarium for plague victims caught on. These buildings would be known as pest houses, lazar houses, or lazaretti (Italian, singular lazaretto; variously spelled in different languages), named, as were many leprosaria, for Lazarus, the poor man with sores in the Gospel parable whom the rich man ignored at the peril of his soul (e.g., Luke 16:19–31)."
                                            },
                                            {
                                                "example_id": "185d57c9-4eb0-442a-908b-525668493bb5",
                                                "sense_id": "c80c4fa3-afd5-3500-88c6-82c4496d5f1c",
                                                "text": "The lazaretti need to be kept clean and tidy and not left with dead bodies locked inside. Rubbish and filth must be regularly and immediately removed and the rooms perfumed daily or ‘even more than once a day’. He [Hieronimo Donzellini] then discussed in detail the types of perfumes and how to dispense them in the lazaretti. Finally, like [Giovanni Filippo] Ingrassia, he discussed the architectural organization and construction of the lazaretti, the need for different rooms to treat different types of patients."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d188e18e-6477-3d5c-8898-44aad62b49f4",
                                        "entry_id": "3002b9c3-1507-3111-94f8-7e295989b2cc",
                                        "glosses": [
                                            "A building such as a hospital, or occasionally a ship, used to temporarily isolate sick people to prevent the spread of infectious diseases; a quarantine."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a54af66-c0cf-4f06-9eaf-700d2bd0d5fc",
                                                "sense_id": "d188e18e-6477-3d5c-8898-44aad62b49f4",
                                                "text": "[H]ovv t'enquire, and be reſolu'd, / By preſent demonſtration, vvhether a ſhip, / Nevvly arriued from Soria, or from / Any ſuſpected part of all the leuant, / Be guilty of the plague: And, vvhere they vſe, / To lie out fortie, fifty daies, ſometimes, / About the Lazaretto, for their triall; […]"
                                            },
                                            {
                                                "example_id": "199436bf-7ecc-4bc8-8d68-b5ac879c6822",
                                                "sense_id": "d188e18e-6477-3d5c-8898-44aad62b49f4",
                                                "text": "It is here a cuſtome ſtrictly obſerued (as alſo elſevvhere vvithin the Streights belonging to the Chriſtians) not to ſuffer any to trafficke or come aſhore before they haue a Pratticke from the Signoirs of Health: vvhich vvill not be granted vntill forty dayes after their arriuall, […] Notvvithſtanding, they vpon requeſt vvill carry you to the Lazaretto (vvhich is in the nature of a Peſt-houſe) there to abide vntill the date be expired. But if any fall ſicke amongſt them in the meane ſeaſon, their Pratticke is accordingly prolonged. A great inconuenience to the Merchants, but at Venice intollerable: vvhere vvhen they haue Pratticke, they are enforced to vnlade at the Lazaretto."
                                            },
                                            {
                                                "example_id": "ff7a4cf6-a08c-4ffd-a0aa-22baaa8722e3",
                                                "sense_id": "d188e18e-6477-3d5c-8898-44aad62b49f4",
                                                "text": "If Lazarettoes were made here in England, that is, if Places were ſet apart and appointed for the Reception of infected Perſons and Goods, or of Perſons and Goods coming from infected Places; […] ſince Perſons and Goods in a Lazaretto muſt be as liable as otherwiſe to receive Infection; it follows, that whenever they are diſmiſs'd, tho they have got rid of their own, yet they muſt in all probability have received, and bring with them, ſome part of the new come Infection."
                                            },
                                            {
                                                "example_id": "d152cae9-a84f-4a22-b783-3c48b93778eb",
                                                "sense_id": "d188e18e-6477-3d5c-8898-44aad62b49f4",
                                                "text": "Theſe eſtabliſhments of Lazzarettos, under wiſe regulations, would have more than one good effect; for while they remove the great inquietude, which is occaſioned by our continual apprehenſions of the Plague, and ſave a populous kingdom, as well as other ſtates connected with us, (who are likewiſe endangered by the accidents of navigation and the imprudence of plunderers) they will ſecure the property of the trader from invaſion; […]"
                                            },
                                            {
                                                "example_id": "9901793a-23ad-400f-a785-15733209b67b",
                                                "sense_id": "d188e18e-6477-3d5c-8898-44aad62b49f4",
                                                "text": "Passengers may perform quarantine on board if they choose, but it is not advisable to do so if they arrive by a merchant ship, as in that case the term is longer than for a person who goes into the lazzaretto; the day he enters the lazzaretto is reckoned as one, and pratique is given at the earliest hour of the day when the period expires. […] The best lazzarettos are those of Malta, Leghorn, Marseilles, Ancona, and Trieste."
                                            },
                                            {
                                                "example_id": "c1737161-43ba-4385-8522-689c70a0d8a3",
                                                "sense_id": "d188e18e-6477-3d5c-8898-44aad62b49f4",
                                                "text": "It was the time of the plague at Messina. The English fleet had anchored there, and searched the felucca I was on. That subjected us to a quarantine of twenty-one days upon arriving at Genoa after a long and troublesome crossing. They gave the passengers the choice of undergoing it on board, or in the lazaretto in which they warned us that we would find only the four walls, because they had not yet had time to furnish it."
                                            },
                                            {
                                                "example_id": "a2ccbf5d-25a6-4304-bf29-72cefb4f3ab8",
                                                "sense_id": "d188e18e-6477-3d5c-8898-44aad62b49f4",
                                                "text": "By the middle of the eighteenth century when it was becoming easier, and safer, to visit the east, they were anxious to visit the Greek and Roman lands of Europe, Asia Minor and North Africa from which they had been deterred by the lure of Italy, fear of the plague and of having to spend quarantine in a noisome Levantine lazaretto."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b802e4a-24f2-3770-b234-bdb89b72edec",
                                        "entry_id": "3002b9c3-1507-3111-94f8-7e295989b2cc",
                                        "glosses": [
                                            "A place at the front of the tweendecks of a merchant ship where provisions are stored."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04f08f9b-7111-42b1-8e1e-c2aea3aa3ac7",
                                                "sense_id": "2b802e4a-24f2-3770-b234-bdb89b72edec",
                                                "text": "After a large quantity of proviſions had been hoiſted up to get out the powder, the ſmoke was ſtill found to aſcend from below; this circumſtance, […] convinced them that the fire muſt be in the lazaretto below, where ſome purſers beds were now recollected to have been very improperly ſtowed; […] no doubt was entertained that theſe beds had got wet and had taken fire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe18cedd-c1ab-40db-984c-b58ae3433110",
                        "source_entry_id": "ef2fc06e-9bd6-3a49-b85d-536c66bc8f75",
                        "source_sense_id": "8cd32f54-8680-38bf-b54a-3f2d6c4bfdee",
                        "source_sense_description": "Bâtiment réservé à l’isolement de qui ou quoi est potentiellement contagieux",
                        "target_lang_word": "lazaret",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lazaret",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6e03a86-a683-3857-b607-e1c9be0eaa16",
                                        "entry_id": "c82fc873-e236-35f7-901a-3e73aed17a98",
                                        "glosses": [
                                            "Synonym of lazaretto.",
                                            "A place reserved for people with infectious diseases (especially leprosy or plague) to live on a long-term basis."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b62a35ef-f159-479e-ad07-8b0d44ce0540",
                                                "sense_id": "b6e03a86-a683-3857-b607-e1c9be0eaa16",
                                                "text": "But the civilising was so complete that the survivors of the original inhabitants numbered seven, of whom two were dying of consumption in the Native Compound, three confined in the Native Lazaret with leprosy, the rest, a man and a woman, living in a gunyah at the remote end of Devilfish Bay, subsisting on what food they could get from the bush and the sea and what they could buy with the pennies the man earned by doing odd jobs and the woman by prostitution."
                                            },
                                            {
                                                "example_id": "66de086f-64e8-415b-8145-d252345e0b3d",
                                                "sense_id": "b6e03a86-a683-3857-b607-e1c9be0eaa16",
                                                "text": "I woke the next morning in a lazaret, a long, high-ceilinged room where we, the sick, the injured, lay upon narrow beds."
                                            },
                                            {
                                                "example_id": "e3694777-25f0-4237-88ef-0db9a074d652",
                                                "sense_id": "b6e03a86-a683-3857-b607-e1c9be0eaa16",
                                                "text": "The director was locked up in the same institution with his patients, and the institution was equally cut off, isolated on the outskirts of the city like an ancient lazaret with its lepers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3cabaef-58aa-3cfe-a7ad-c5d246ed1261",
                                        "entry_id": "c82fc873-e236-35f7-901a-3e73aed17a98",
                                        "glosses": [
                                            "Synonym of lazaretto.",
                                            "A building such as a hospital, or occasionally a ship, used to isolate sick people to prevent the spread of infectious diseases; a quarantine."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4758e492-d351-470a-b62b-c31afca3016f",
                                                "sense_id": "e3cabaef-58aa-3cfe-a7ad-c5d246ed1261",
                                                "text": "The liver is the lazaret of bile, / But very rarely executes its function"
                                            }
                                        ]
                                    },
                                    {
