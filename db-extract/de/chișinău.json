                "senses": [
                    {
                        "sense_id": "c140a58b-1961-350f-b87c-5b7b8659f8a0",
                        "entry_id": "51319c33-9c74-33b8-b0f8-1b039781a751",
                        "glosses": [
                            "Hauptstadt von Moldau; Stadt in Moldawien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "069af57a-e7c9-4760-a5f1-e4a55a73c68b",
                                "sense_id": "c140a58b-1961-350f-b87c-5b7b8659f8a0",
                                "text": "Chișinău hat ein kontinentales Klima."
                            },
                            {
                                "example_id": "1e8a3a43-422b-4186-ad40-e442aa99cf2c",
                                "sense_id": "c140a58b-1961-350f-b87c-5b7b8659f8a0",
                                "text": "Das Chișinău der 1990er Jahre machte auf mich einen ganz eigenen Eindruck."
                            },
                            {
                                "example_id": "774c4d3b-3313-4296-8ecb-83d96a11d287",
                                "sense_id": "c140a58b-1961-350f-b87c-5b7b8659f8a0",
                                "text": "„Die Strecke nach Chișinău war nicht ganz wie geplant verlaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85652123-bca7-40b0-8974-c173e3a1803f",
                        "source_entry_id": "51319c33-9c74-33b8-b0f8-1b039781a751",
                        "source_sense_id": "c140a58b-1961-350f-b87c-5b7b8659f8a0",
                        "source_sense_description": "Hauptstadt von Moldau; Stadt in Moldawien",
                        "target_lang_word": "Chisinau",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chisinau",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70f7f09f-421f-3e52-a4ea-59282d1f65f4",
                                        "entry_id": "498ec480-03ce-3467-96ac-eed518cbfc52",
                                        "glosses": [
                                            "Alternative spelling of Chișinău."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ac52c9a-1b92-411d-8bbd-630ec930a0e1",
                                                "sense_id": "70f7f09f-421f-3e52-a4ea-59282d1f65f4",
                                                "text": "Moreover, in the case of Moldova, Chisinau has been the sole engine of growth (in 1997, Chisinau grew by around 10 percent, fueled by a construction boom, while Moldova overall had just a 1.3 percent growth)."
                                            },
                                            {
                                                "example_id": "6c3552a2-2214-4441-a07d-7c8fdfc51798",
                                                "sense_id": "70f7f09f-421f-3e52-a4ea-59282d1f65f4",
                                                "text": "In addition, a consensus has not been reached over the legal status of Transnistria, and the authority of the Moldovan government in Chisinau has not yet been extended over the Transnistrian territory."
                                            },
                                            {
                                                "example_id": "ea290a5b-4d8a-4501-8fa7-2179cc6c5e5f",
                                                "sense_id": "70f7f09f-421f-3e52-a4ea-59282d1f65f4",
                                                "text": "In August, strikes broke out in the large factories of Chisinau and Transnistria, most of whose workforce was Russian, in protest at the language law."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f9b244b-a1d1-48fc-be37-5447299bb3e7",
                        "source_entry_id": "51319c33-9c74-33b8-b0f8-1b039781a751",
                        "source_sense_id": "c140a58b-1961-350f-b87c-5b7b8659f8a0",
                        "source_sense_description": "Hauptstadt von Moldau; Stadt in Moldawien",
                        "target_lang_word": "Chișinău",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chișinău",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a860433d-b9df-36a0-8a61-2d5977ac9658",
                                        "entry_id": "efe3517a-0f71-3841-b0e7-fa4408ccdd85",
                                        "glosses": [
                                            "Capitale de la Moldavie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a22ab4a-00f0-4df4-aa09-87554c20926f",
                                                "sense_id": "a860433d-b9df-36a0-8a61-2d5977ac9658",
                                                "text": "Emmanuel Macron et une cinquantaine de chefs d’État et de gouvernement se sont réunis jeudi, près de la capitale moldave, Chisinau, pour le deuxième sommet de la Communauté politique européenne."
                                            },
                                            {
                                                "example_id": "1c8b45d2-5d03-47c8-9bd4-7ef00a431ab7",
                                                "sense_id": "a860433d-b9df-36a0-8a61-2d5977ac9658",
                                                "text": "Il s’en est pris jeudi au chef d’État autrichien Alexander Van der Bellen qui voulait le caresser, à l’occasion de sa visite à Chisinau, pour appuyer la candidature à l’entrée dans l'Union européenne de ce pays frontalier de l’Ukraine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b680655-769a-3cb1-a00c-254711798320",
