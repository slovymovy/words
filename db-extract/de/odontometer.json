                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "3c64302c-041d-4f6e-b5d8-9bc150d6694c",
                                "sense_id": "81e480bd-af34-300e-9bff-e4e8ccd2c61c",
                                "text": "„Es gab Spezialwerkzeuge, für die ich immer eine Schwäche hatte, z.B. das Odontometer, mit dem man die Zähnung der Marken bestimte und dessen Zweck Außenstehende gar nicht erraten hätten.“"
