                ],
                "senses": [
                    {
                        "sense_id": "cc8c974c-4416-3c4e-88ba-920c59ecbafd",
                        "entry_id": "c88dc610-7faf-367c-95b8-daefb1f084e5",
                        "glosses": [
                            "hot soup given out to destitute people in Warsaw in the 1990s, sometimes personally by Jacek Kuroń"
                        ],
                        "tags": [
                            "feminine",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "14c9f958-52e1-465d-bc58-838503950602",
                                "sense_id": "cc8c974c-4416-3c4e-88ba-920c59ecbafd",
                                "text": "— Tylko gdzie masz w Radomiu darmową kuroniówkę?",
                                "translation": "But where do you have free hot soup in Radom?",
                                "english": "But where do you have free hot soup in Radom?"
                            },
                            {
                                "example_id": "6a614779-bc16-4cfa-8530-b42bc2fc152b",
                                "sense_id": "cc8c974c-4416-3c4e-88ba-920c59ecbafd",
                                "text": "Trzeba było szukać kompromisu między honorem i miską kuroniówki.",
                                "translation": "A compromise had to be found between honor and a hot meal.",
                                "english": "A compromise had to be found between honor and a hot meal."
                            },
                            {
                                "example_id": "44ff7159-8b62-4b95-948c-301c8cc233cd",
                                "sense_id": "cc8c974c-4416-3c4e-88ba-920c59ecbafd",
                                "text": "Przejmując resort po Kuroniu powiedział pan, że nic pan nie zmieni, ale do jego sławnej zupy „kuroniówki” będzie pan chciał dołożyć drugie danie.",
                                "translation": "Taking over Kuroń's ministry, you said that you won't change anything, but that you'd want to add a main course to his famous bowls of Kuroń soup.",
                                "english": "Taking over Kuroń's ministry, you said that you won't change anything, but that you'd want to add a main course to his famous bowls of Kuroń soup."
                            },
                            {
                                "example_id": "e7eb84c7-08ac-4807-a624-a2178574d94f",
                                "sense_id": "cc8c974c-4416-3c4e-88ba-920c59ecbafd",
                                "text": "Babcia już w koszmarach widziała, czym wybrukowane jest piekło. Nie będzie ratunku, tylko wspólny kocioł z kuroniówką i pornograficzne mikrofilmy.",
                                "translation": "Grandma saw true hell in her nightmares. There will be no rescue, only a common cauldron of Kuroń soup and pornographic microfilms.",
                                "english": "Grandma saw true hell in her nightmares. There will be no rescue, only a common cauldron of Kuroń soup and pornographic microfilms."
                            }
                        ]
                    },
                    {
                        "sense_id": "ccf935ab-6992-37f6-94a7-4194670d7392",
                        "entry_id": "c88dc610-7faf-367c-95b8-daefb1f084e5",
                        "glosses": [
                            "unemployment benefit"
                        ],
                        "tags": [
                            "feminine",
                            "historical",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "579e4723-431a-4a18-9e8f-487adb1cf2e0",
                                "sense_id": "ccf935ab-6992-37f6-94a7-4194670d7392",
                                "text": "Pani Ewo, czy było warto? Gdy byłam na „kuroniówce” i było mi wyjątkowo trudno, syn zadał mi to samo pytanie. Odpowiedziałam: tak, zdecydowanie warto było, bo jednak żyjemy w innej Polsce.",
                                "translation": "Miss Ewa, was it worth it? When I was on unemployment and I had an exceptionally difficult time, your son asked me the same question. I said it was worth it, because we're living in a different Poland, after all.",
                                "english": "Miss Ewa, was it worth it? When I was on unemployment and I had an exceptionally difficult time, your son asked me the same question. I said it was worth it, because we're living in a different Poland, after all."
                            },
                            {
                                "example_id": "cb4c9861-ddb6-4b6d-9d7a-86ae5bbcc3d4",
                                "sense_id": "ccf935ab-6992-37f6-94a7-4194670d7392",
                                "text": "Skończył kurs kreatywnego sprzątania szaletów publicznych, ale ponieważ nie ma w nich dostępu do sieci innej niż kanalizacyjna, poszedł na kuroniówkę, a na drugie wziął kredyt na komputer multimedialny z głośniczkami.",
                                "translation": "He finished a course on creative public restroom cleaning, but because there is no access to other networks in them other than the plumbing, he went on unemployment, and then took out a loan for a computer with speakers.",
                                "english": "He finished a course on creative public restroom cleaning, but because there is no access to other networks in them other than the plumbing, he went on unemployment, and then took out a loan for a computer with speakers."
                            },
                            {
                                "example_id": "a84c423a-7196-49c3-a562-66a1cf776c3a",
                                "sense_id": "ccf935ab-6992-37f6-94a7-4194670d7392",
                                "text": "Wyścig szczurów spod znaku „Solidarności” trwał, rekomunizował zakłady pracy, ludzi wyrzucał na kuroniówkę, stałem w kolejce za pracą, handlowałem na chodniku, czasopisma sprzedawałem przechodniom.",
                                "translation": "The rat race of \"Solidarity\" continued, recommunized the workplaces, and kicked people out onto unemployment, I stood in line for work, I traded on the sidewalk, and I sold magazines to passers-by.",
                                "english": "The rat race of \"Solidarity\" continued, recommunized the workplaces, and kicked people out onto unemployment, I stood in line for work, I traded on the sidewalk, and I sold magazines to passers-by."
                            }
                        ]
                    }
