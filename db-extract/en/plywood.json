                                "sense_id": "0cdd2e0f-7dfc-3b77-875f-894d9692c26a",
                                "text": "After the hurricane there was a severe regional shortage of plywood, especially exterior plywood."
                            }
                        ]
                    },
                    {
                        "sense_id": "5fd704d9-205d-3b4d-876d-f8de144d8311",
                        "entry_id": "5bee34cb-91ac-3abb-96d8-467acea914bf",
                        "glosses": [
                            "A specific grade or type of this construction material."
                        ],
                        "tags": [
                            "countable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "df63cfeb-d1eb-435f-bfa1-431b18fbd86b",
                                "sense_id": "5fd704d9-205d-3b4d-876d-f8de144d8311",
                                "text": "We stock exterior plywoods, interior plywoods, and furniture plywoods."
                            }
                        ]
                    }
