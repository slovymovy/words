                ],
                "senses": [
                    {
                        "sense_id": "dc448ec5-ec1f-3b51-8598-a126c2efcf43",
                        "entry_id": "231a5291-3496-3af3-9e7f-f343643ece55",
                        "glosses": [
                            "Schusswaffe ab 30 cm Gesamtlänge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "214496fb-d733-4894-80f8-d528bccfedfe",
                                "sense_id": "dc448ec5-ec1f-3b51-8598-a126c2efcf43",
                                "text": "„Und dann freut sich das Schießgewehr.“"
                            },
                            {
                                "example_id": "589112f0-671f-40e8-8a7e-619d5bb78254",
                                "sense_id": "dc448ec5-ec1f-3b51-8598-a126c2efcf43",
                                "text": "„Er saß so gut zu Pferde wie die Peerhobstler selber, und mit der Zeit lernte er auch mit dem Schießgewehr umzugehen wie ein gelernter Jäger, und manchen Braten brachte er aus dem Busche mit.“"
                            },
                            {
                                "example_id": "f3c34fe8-bc3e-49c8-a065-928d8e36198e",
                                "sense_id": "dc448ec5-ec1f-3b51-8598-a126c2efcf43",
                                "text": "„Der Assistent schloß das Fenster und legte sich wieder schlafen, und der Junker hatte kein Schießgewehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89c32dcc-152f-4ed6-b692-eb4b10e33a52",
                        "source_entry_id": "231a5291-3496-3af3-9e7f-f343643ece55",
                        "source_sense_id": "dc448ec5-ec1f-3b51-8598-a126c2efcf43",
                        "source_sense_description": "Gewehr",
                        "target_lang_word": "fusil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fusil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55df6eee-0b1c-372f-9726-50980dd08aa1",
                                        "entry_id": "b4127d83-c322-331d-aead-a2b74bf1a430",
                                        "glosses": [
                                            "Petite pièce d’acier avec laquelle on battait un silex pour en tirer du feu."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f621846-a171-42d6-a971-3ef3e61c9d72",
                                                "sense_id": "55df6eee-0b1c-372f-9726-50980dd08aa1",
                                                "text": "Vous savez (…) que l'école (…) est bâtie de bois et qu'il suffirait d'un fusil et d'un copeau pour la faire flamber comme un vrai feu de la Saint-Jean."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c194d2a-fad1-3533-afc7-ed0c94fca6d1",
                                        "entry_id": "b4127d83-c322-331d-aead-a2b74bf1a430",
                                        "glosses": [
                                            "Pièce d’acier qui couvrait le bassinet de certaines armes à feu, et contre laquelle donnait le silex qui était au chien."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e4a0f67-9509-49bc-98c9-262c49134a4c",
                                                "sense_id": "3c194d2a-fad1-3533-afc7-ed0c94fca6d1",
                                                "text": "Fusil d’arquebuse. — Fusil de pistolet."
                                            },
                                            {
                                                "example_id": "1a8c94a9-a485-4ff2-980a-6d0a6f71bb85",
                                                "sense_id": "3c194d2a-fad1-3533-afc7-ed0c94fca6d1",
                                                "text": "Arquebuse à fusil. — Pistolet à fusil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85d1d3d3-2946-3bb2-a394-36e95f817244",
                                        "entry_id": "b4127d83-c322-331d-aead-a2b74bf1a430",
                                        "glosses": [
                                            "Arme à feu portative qu’on tire en l’épaulant, et munie d’un mécanisme dont le mouvement de percussion enflamme la poudre renfermée dans le canon."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8800054d-41df-4ec5-83f8-a9c6105d8fe8",
                                                "sense_id": "85d1d3d3-2946-3bb2-a394-36e95f817244",
                                                "text": "Le feu des fusils Mauser commença ; ce fut un vacarme épouvantable dans lequel on percevait le ronflement des obus à la lydite, le crépitement des fusils Metford, les éclats des mitrailleuses boers et les sifflements des Mauser."
                                            },
                                            {
                                                "example_id": "8027a212-24ba-4596-828e-b12ecd7300e3",
                                                "sense_id": "85d1d3d3-2946-3bb2-a394-36e95f817244",
                                                "text": "Notre arsenal se compose du Winchester et du sabre d’ordonnance de notre cavalier d’escorte, d’un fusil de chasse à deux coups, un « idéal » de la manufacture de St-Étienne, […] et d’un bon revolver tirant des balles cal. 450 que je porte à la ceinture."
                                            },
                                            {
                                                "example_id": "16a6f456-31ab-44ed-bbe8-98f370913b23",
                                                "sense_id": "85d1d3d3-2946-3bb2-a394-36e95f817244",
                                                "text": "Jusqu’ici, il s’était promené avec son fusil sous le bras, plein d’un sentiment d’altière sécurité."
                                            },
                                            {
                                                "example_id": "0ef538cf-9347-47dc-a8c4-3d1c484df43d",
                                                "sense_id": "85d1d3d3-2946-3bb2-a394-36e95f817244",
                                                "text": "Notre chien de chasse suit mes promenades quand je prends un fusil et m’abandonne quand je me contente d’un revolver."
                                            },
                                            {
                                                "example_id": "13c75d32-4ed2-49c4-984e-71e7217d96d2",
                                                "sense_id": "85d1d3d3-2946-3bb2-a394-36e95f817244",
                                                "text": "Les chasseurs s’étaient précipités sur leurs fusils, mais je donnai l’ordre de les remettre au râtelier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d2d0fbf-42ba-39e0-ac0e-5794f60d9385",
                                        "entry_id": "b4127d83-c322-331d-aead-a2b74bf1a430",
                                        "glosses": [
                                            "Habile tireur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2abd2b3a-aa8b-4da7-9dac-9d34b75517ad",
                                                "sense_id": "8d2d0fbf-42ba-39e0-ac0e-5794f60d9385",
                                                "text": "Comme ils étaient, en ce temps-là, les deux seuls fusils de la commune, dès qu’un paysan avait repéré les lieux et heures de sortie d’un lièvre, […], il s’en venait annoncer la chose à l’un ou l’autre des deux compères."
                                            },
                                            {
                                                "example_id": "5981c5cf-d41c-4768-8110-3083cbb04b34",
                                                "sense_id": "8d2d0fbf-42ba-39e0-ac0e-5794f60d9385",
                                                "text": "Le Glaoui avait amené cinq cents cavaliers, les Rehamma autant et le Goundafi deux cents. Ces douze cents fusils formèrent le noyau le l’armée hafidiste."
                                            },
                                            {
                                                "example_id": "e3f6fbd4-05d0-4b31-8605-d702ca4b0aa3",
                                                "sense_id": "8d2d0fbf-42ba-39e0-ac0e-5794f60d9385",
                                                "text": "Et je passe pour un des bons fusils de l’Afrique Orientale."
                                            },
                                            {
                                                "example_id": "2bb8192e-7a0b-4f21-8e80-8b99cd5ad229",
                                                "sense_id": "8d2d0fbf-42ba-39e0-ac0e-5794f60d9385",
                                                "text": "Ce duc était, d’après eux, le premier fusil de France, et ce titre de « premier fusil de France », qu’ils énonçaient d’un ton respectueux, me causa, à moi, un haut-le-cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09c9c914-2bf8-37bf-81ed-56976fa281a4",
                                        "entry_id": "b4127d83-c322-331d-aead-a2b74bf1a430",
                                        "glosses": [
                                            "Aiguisoir à couteaux constitué d'une tige d'acier finement striée dans le sens de la longueur et emmanchée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b559d73-a12d-4945-9a92-b82f2751cc79",
                                                "sense_id": "09c9c914-2bf8-37bf-81ed-56976fa281a4",
                                                "text": "Les bras nus et croisés, son fusil encore pendant à son côté, les jambes écartées sous le tablier blanc, taché de sang, il balançait lentement la tête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07d583fb-0e80-3b7a-b92d-4d17737e2ee5",
                                        "entry_id": "b4127d83-c322-331d-aead-a2b74bf1a430",
                                        "glosses": [
                                            "Meuble représentant l’arme du même nom dans les armoiries. Il est généralement représenté en fasce, la bouche du canon à dextre. C’est un meuble entré récemment (XVIIIème siècle) dans les armoiries européennes. C’est souvent une référence à la chasse."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48480cdf-744b-4a23-9aa6-5cf05edfcc45",
                                                "sense_id": "07d583fb-0e80-3b7a-b92d-4d17737e2ee5",
                                                "text": "Écartelé, au premier d’or à quatre pals de gueules, au second d’azur à un Saint-Sauveur bénissant de sa dextre et tenant un globe dans sa senestre, le tout d’or, au troisième d’azur à une boussole d’argent, l’aiguille partie de même et de gueules, le gueules pointant vers le Sud indiqué par la capitale de sable S, au quatrième d’or à une entrée de mine au naturel ouverte de sable surmontée d’un fusil contourné aussi au naturel, qui est de la commune de Lamanère des Pyrénées-Orientales → voir illustration « armoiries avec un fusil »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b3959d1-700b-3513-92ee-48b400a1c1de",
                                        "entry_id": "b4127d83-c322-331d-aead-a2b74bf1a430",
                                        "glosses": [
                                            "Estomac."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
