                                "target_word": "Kurvimeter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce012984-841d-3dfa-b635-d81157e9cb7e",
                                        "entry_id": "845c0f5f-b816-31ab-a1ef-fc2bc3c5bc4b",
                                        "glosses": [
                                            "Hilfsmittel zum Bestimmen von Entfernungen auf Karten"
                                        ],
                                        "tags": [
                                            "Kartografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d62a26db-c7d2-49db-ae2e-0d8c32cf70be",
                                                "sense_id": "ce012984-841d-3dfa-b635-d81157e9cb7e",
                                                "text": "„Alle Längenbestimmungen wurden mit dem Kurvimeter, alle Flächenbestimmungen mit dem Planimeter ausgeführt. Den Messungen ist die topographische Karte des Königreichs Sachsen, Massstab 1 : 25 000, zu Grunde gelegt.“"
                                            },
                                            {
                                                "example_id": "0e6006fb-d82a-4c15-8bf7-b2ace0933ed6",
                                                "sense_id": "ce012984-841d-3dfa-b635-d81157e9cb7e",
                                                "text": "„Man messe mit dem Kurvimeter die Küstenlinie des Schwarzen Meeres nach der beigegebenen Karte in Kilometern aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ccbd7695-1405-3530-9b83-b8ef88b923e4",
                                        "entry_id": "845c0f5f-b816-31ab-a1ef-fc2bc3c5bc4b",
                                        "glosses": [
                                            "Hilfsmittel zum Messen der Bogenlänge von Kurven"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e6cf9c5-b21c-40be-8491-d8d80e762294",
                                                "sense_id": "ccbd7695-1405-3530-9b83-b8ef88b923e4",
                                                "text": "„Ein Kurvimeter, das sich besonders zur Ausmessung kurzer Kurvenstücke eignet, ist von Amsler unter Benutzung eines Pantographen gebaut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
