                        ],
                        "examples": [
                            {
                                "example_id": "6d90b372-a692-4910-bd30-cd7418db7cfd",
                                "sense_id": "dfb7de4c-84ef-3675-b5e2-1c05098f9428",
                                "text": "There are two woodworkings, the first being the idealized one, the woodworking of expectations, where everything turns out perfect. The spouse is pleased, each and every joint is of Krenovian perfection […]"
                            },
                            {
                                "example_id": "b36bcba2-1b5d-4926-9c8b-610185ebc881",
                                "sense_id": "dfb7de4c-84ef-3675-b5e2-1c05098f9428",
                                "text": "MDF and HDF – or medium-density fiberboard and high-density fiberboard – are two of the trendiest materials in woodworking these days."
                            }
                        ]
                    }
