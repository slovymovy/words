                "senses": [
                    {
                        "sense_id": "c21a4cf5-a13f-3cb4-a91e-145ae7453e77",
                        "entry_id": "47f45458-eb18-3a77-ae5e-33bc16035825",
                        "glosses": [
                            "Himmel in der Wüste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "362bb036-36db-4edf-8704-447b187d48ab",
                                "sense_id": "c21a4cf5-a13f-3cb4-a91e-145ae7453e77",
                                "text": "„Die Sterne waren zu Millionen über den klaren Wüstenhimmel ausgebreitet.“"
                            },
                            {
                                "example_id": "eecc93f7-5800-401a-a740-9a457c4025b4",
                                "sense_id": "c21a4cf5-a13f-3cb4-a91e-145ae7453e77",
                                "text": "„Und dabei hatten wir den Wüstenhimmel als grausam empfunden!“"
                            },
                            {
                                "example_id": "6e89cd87-c6db-4d5e-a84b-96f16e9a278e",
                                "sense_id": "c21a4cf5-a13f-3cb4-a91e-145ae7453e77",
                                "text": "„Schließlich gruben sie ein Loch in die Straße und setzten die Leichen in einem Gemeinschaftsgrab bei; die nackten Leiber, mit ihren Wunden den Opfern eines chirurgischen Experiments gleich, lagen in der Grube und starrten, während die Erdklumpen über sie fielen, blicklos zum Wüstenhimmel hinauf.“"
                            },
                            {
                                "example_id": "2d5024c2-4a66-4b93-a0af-fe134e08d00d",
                                "sense_id": "c21a4cf5-a13f-3cb4-a91e-145ae7453e77",
                                "text": "„Kontaktlinsen, blau wie der Wüstenhimmel, schwimmen auf ihren Augäpfeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
