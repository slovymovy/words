                "senses": [
                    {
                        "sense_id": "97a4618f-163c-328e-bc5c-939ee8d5a7d3",
                        "entry_id": "8e022f8a-fba6-3a4d-b210-9e4abbdd25e5",
                        "glosses": [
                            "człowiek, który w buddyzmie mahajana dąży do stanu buddy, kieruje się altruistyczną motywacją przynoszenia pożytku innym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f30d653-fc43-481d-9802-56d5749895c0",
                                "sense_id": "97a4618f-163c-328e-bc5c-939ee8d5a7d3",
                                "text": "Staniesz się bodhisattwą lub dzieckiem Buddy wyłącznie pod warunkiem, że wykażesz altruistyczną chęć osiągnięcia oświecenia. Bodhisattwowie nazywani są dziećmi umysłu Buddy, gdyż zrodzili się z właściwości strumienia jego umysłu"
                            },
                            {
                                "example_id": "209de9bc-1fbe-4693-baaf-c91f2509276d",
                                "sense_id": "97a4618f-163c-328e-bc5c-939ee8d5a7d3",
                                "text": "(…) powinnością bodhisattwy jest bodhicitta, nieustająca aktywność mieć na celu wyzwolenie wszystkich istot"
                            },
                            {
                                "example_id": "63a88644-9829-410f-895e-f67299a6b4aa",
                                "sense_id": "97a4618f-163c-328e-bc5c-939ee8d5a7d3",
                                "text": "Wśród przedstawień są posągi Buddy, bodhisattw oraz duże triadyczne stele, gdzie postaci Buddy, stojącemu na tle mandorli, po obu stronach towarzyszą bodhisattwy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eed4b173-d26e-4822-93eb-55188291efc0",
                        "source_entry_id": "8e022f8a-fba6-3a4d-b210-9e4abbdd25e5",
                        "source_sense_id": "97a4618f-163c-328e-bc5c-939ee8d5a7d3",
