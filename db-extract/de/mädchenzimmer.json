                    },
                    {
                        "translation_id": "db98c9e9-4e4a-474e-b577-49818f92c47f",
                        "source_entry_id": "cb4e24c3-c464-33f5-9fd1-dec4e59ec63a",
                        "source_sense_id": "0bf5c407-0e90-3e78-9a2d-721e7dd872dc",
                        "source_sense_description": "Zimmer für das Dienstmädchen",
                        "target_lang_word": "chambre de bonne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chambre de bonne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95681bbc-0b0a-37b8-af12-b776d6cb3c2c",
                                        "entry_id": "a24d97d2-4373-3833-8b74-0f18a87de2e7",
                                        "glosses": [
                                            "Chambre à coucher aménagée dans les derniers étages des immeubles bourgeois pour l’hébergement de la domesticité. Il n’y avait généralement qu’un point d’eau pour tout l’étage lequel n’était accessible que par l’escalier de service."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4285aaea-c8b2-3e4c-b5d4-cc39ec71ee58",
                                        "entry_id": "a24d97d2-4373-3833-8b74-0f18a87de2e7",
                                        "glosses": [
                                            "Appartement constitué d'une unique pièce d'une faible surface au sein d'un immeuble bourgeois, généralement situé au dernier étage, et initialement conçu pour servir de chambre à un domestique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c8eb5df-6ebc-4dc6-8bc3-2b83ca178cbd",
                                                "sense_id": "4285aaea-c8b2-3e4c-b5d4-cc39ec71ee58",
                                                "text": "Et se souvenant de leur chambre de bonne – un couloir sombre et étroit, surchauffé, aux odeurs tenaces – ils y vécurent d’abord dans une sorte d’ivresse, renouvelée chaque matin par le pépiement des oiseaux."
                                            },
                                            {
                                                "example_id": "bb6b7987-1577-4f80-b349-428579469583",
                                                "sense_id": "4285aaea-c8b2-3e4c-b5d4-cc39ec71ee58",
                                                "text": "Elle connaissait sa chambre, du genre chambre de bonne, au second étage de l’église luthérienne où il tenait l’orgue."
                                            },
                                            {
                                                "example_id": "24708f82-6ed1-453e-bd4e-7cb298e2a42e",
                                                "sense_id": "4285aaea-c8b2-3e4c-b5d4-cc39ec71ee58",
                                                "text": "Une chambre de bonne à Paris suffirait largement à mon bonheur."
                                            },
                                            {
                                                "example_id": "24944fed-788f-471c-97c2-336fe5cd7ebc",
                                                "sense_id": "4285aaea-c8b2-3e4c-b5d4-cc39ec71ee58",
                                                "text": "Le premier article que je rédigeai pour la revue dans ma chambre de bonne de la rue Alexandre-Cabanel me coûta sang et eau, j’y travaillai d’arrache-pied plusieurs semaines."
                                            },
                                            {
                                                "example_id": "c9064b38-912b-468d-8cb1-2c00b9da99a0",
                                                "sense_id": "4285aaea-c8b2-3e4c-b5d4-cc39ec71ee58",
                                                "text": "Quelques jours plus tard Lucile m’informa par téléphone qu’elle pensait s’installer dans une chambre de bonne dont elle refusa de me donner l’adresse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
