                        "канал"
                    ],
                    "common_phrases": [
                        "первая программа",
                        "по второй программе",
                        "переключить программу"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in spoken language instead of 'канал'"
                        }
