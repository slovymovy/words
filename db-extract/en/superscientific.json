                                "example_id": "37920775-0992-4f7a-9dd4-783aefb9b4d6",
                                "sense_id": "c4ba3c41-e214-31ea-af50-9759f8daaaf8",
                                "text": "It should be emphasized that highly improbable events occur in nature without the involvement of any kind of supernatural or superscientific phenomena."
                            }
