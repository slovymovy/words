{
    "word_family": [
        "roll",
        "roller-skate",
        "roller-coaster",
        "roller-blade",
        "unroll",
        "enroll"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9a3f5f6b-512a-38da-b854-efd41e62c247",
                    "sense_definition": "A cylindrical tool used for applying paint or ink to a surface.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a long <w>roller</w> to paint the high ceiling without a ladder.",
                            "target_lang_translations": {
                                "ru": "Он использовал длинный <w>валик</w>, чтобы покрасить высокий потолок без лестницы.",
                                "zh": "他用一个长柄<w>滚筒</w>在不用梯子的情况下粉刷了高高的天花板。"
                            }
                        },
                        {
                            "text": "Make sure to clean the <w>roller</w> thoroughly after using the paint <w>roller</w> so the paint doesn't dry.",
                            "target_lang_translations": {
                                "ru": "Обязательно тщательно очистите <w>валик</w> после использования малярного <w>валика</w>, чтобы краска не засохла.",
                                "zh": "使用完<w>滚筒</w>后一定要彻底清洗，以免油漆干结。"
                            }
                        }
                    ],
                    "synonyms": [
                        "paint roller",
                        "rolling paint brush",
                        "rolling brush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цилиндрический инструмент, используемый для нанесения краски или чернил на поверхность.",
                        "zh": "一种用于将油漆或墨水涂抹在表面上的圆柱形工具。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "валик",
                                "target_lang_sense_clarification": "малярный инструмент"
                            },
                            {
                                "target_lang_word": "малярный валик",
                                "target_lang_sense_clarification": "полное название инструмента"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滚筒",
                                "target_lang_sense_clarification": "涂刷工具"
                            },
                            {
                                "target_lang_word": "涂料滚筒",
                                "target_lang_sense_clarification": "专门用于油漆的工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa6d2162-7862-3168-9624-8b5aa78a9461",
                    "sense_definition": "A small cylindrical tube around which hair is wound to create curls.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beauty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She slept with a <w>roller</w> in her hair to have perfect curls the next morning.",
                            "target_lang_translations": {
                                "ru": "Она спала с <w>бигуди</w> в волосах, чтобы на следующее утро у нее были идеальные локоны.",
                                "zh": "她戴着<w>发卷</w>睡觉，以便第二天早上能有完美的卷发。"
                            }
                        },
                        {
                            "text": "The stylist carefully placed each hair <w>roller</w> to ensure the volume was even.",
                            "target_lang_translations": {
                                "ru": "Стилист аккуратно закрепил каждые <w>бигуди</w>, чтобы объем был равномерным.",
                                "zh": "造型师仔细地放置每一个<w>发卷</w>，以确保头发蓬松度均匀。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hair roller"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая цилиндрическая трубка, на которую накручивают волосы для создания локонов.",
                        "zh": "一种用来卷头发以制造卷发效果的小圆筒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бигуди",
                                "target_lang_sense_clarification": "для завивки волос"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发卷",
                                "target_lang_sense_clarification": "美发工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c86bbbc-1269-37f2-a84b-d11f05bcdc98",
                    "sense_definition": "A large, powerful wave that curls over and breaks on the shore.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "waves",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surfers waited for the massive <w>rollers</w> to come in from the Atlantic.",
                            "target_lang_translations": {
                                "ru": "Серферы ждали, когда с Атлантики придут массивные <w>валы</w>.",
                                "zh": "冲浪者们等待着从大西洋涌来的巨大<w>海浪</w>。"
                            }
                        },
                        {
                            "text": "Huge <w>rollers</w> crashed against the cliffs during the winter storm.",
                            "target_lang_translations": {
                                "ru": "Огромные <w>валы</w> разбивались о скалы во время зимнего шторма.",
                                "zh": "冬季风暴期间，巨大的<w>海浪</w>拍打着悬崖。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ocean roller"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая мощная волна, которая закручивается и разбивается о берег.",
                        "zh": "一种在岸边卷起并破碎的巨大而强劲的海浪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вал",
                                "target_lang_sense_clarification": "высокая морская волна"
                            },
                            {
                                "target_lang_word": "бурун",
                                "target_lang_sense_clarification": "пенящаяся волна"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巨浪",
                                "target_lang_sense_clarification": "大型海浪"
                            },
                            {
                                "target_lang_word": "卷浪",
                                "target_lang_sense_clarification": "翻卷的浪花"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18936de2-af0f-3cad-a25c-4e40338d37f9",
                    "sense_definition": "A rotating cylindrical part of a machine used to move, flatten, or apply pressure to something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "machinery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The paper moves through the printer via a series of rubber <w>rollers</w>.",
                            "target_lang_translations": {
                                "ru": "Бумага движется через принтер с помощью серии резиновых <w>роликов</w>.",
                                "zh": "纸张通过一系列橡胶<w>滚轴</w>在打印机中移动。"
                            }
                        },
                        {
                            "text": "The factory worker had to adjust the conveyor <w>roller</w> to keep the boxes moving smoothly.",
                            "target_lang_translations": {
                                "ru": "Заводскому рабочему пришлось отрегулировать <w>ролик</w> конвейера, чтобы коробки двигались плавно.",
                                "zh": "工厂工人必须调整传送带的<w>滚轴</w>，以保持箱子平稳移动。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "conveyor roller"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вращающаяся цилиндрическая деталь машины, используемая для перемещения, разглаживания или оказания давления.",
                        "zh": "机器中用于移动、压平或施加压力的旋转圆柱形部件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вал",
                                "target_lang_sense_clarification": "деталь механизма"
                            },
                            {
                                "target_lang_word": "ролик",
                                "target_lang_sense_clarification": "вращающийся цилиндр в технике"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滚轴",
                                "target_lang_sense_clarification": "机械部件"
                            },
                            {
                                "target_lang_word": "转轮",
                                "target_lang_sense_clarification": "旋转的圆柱体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e4204d7-f192-3335-8153-beef17257c18",
                    "sense_definition": "A small wheel, such as those found on a caster or a skate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wheels",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "One <w>roller</w> on my suitcase is stuck, making it hard to pull.",
                            "target_lang_translations": {
                                "ru": "Один <w>ролик</w> на моем чемодане заклинило, из-за чего его трудно везти.",
                                "zh": "我行李箱上的一个<w>轮子</w>卡住了，很难拉动。"
                            }
                        },
                        {
                            "text": "The office chair glides easily because each <w>roller</w> is well-oiled.",
                            "target_lang_translations": {
                                "ru": "Офисное кресло легко скользит, потому что каждое <w>колёсико</w> хорошо смазано.",
                                "zh": "办公椅滑动得很顺畅，因为每个<w>滑轮</w>都润滑得很好。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленькое колесо, например, на мебельной опоре или коньке.",
                        "zh": "一种小轮子，例如安装在脚轮或溜冰鞋上的那种。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ролик",
                                "target_lang_sense_clarification": "небольшое колесико"
                            },
                            {
                                "target_lang_word": "колёсико",
                                "target_lang_sense_clarification": "маленькое колесо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轮子",
                                "target_lang_sense_clarification": "小型滚动装置"
                            },
                            {
                                "target_lang_word": "滑轮",
                                "target_lang_sense_clarification": "用于滑动的轮子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d394316-eba5-3bcd-90e5-52b94d6e1ed1",
                    "sense_definition": "A list of names of people who worked on a film or television program, shown at the end.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I stayed until the end of the <w>roller</w> to see who the lead animator was.",
                            "target_lang_translations": {
                                "ru": "Я остался до конца <w>титров</w>, чтобы посмотреть, кто был ведущим аниматором.",
                                "zh": "我一直等到<w>演职员表</w>放完，才看到首席动画师是谁。"
                            }
                        },
                        {
                            "text": "The credits <w>roller</w> moved so fast that I couldn't read all the names.",
                            "target_lang_translations": {
                                "ru": "Бегущая строка <w>титров</w> двигалась так быстро, что я не успел прочитать все имена.",
                                "zh": "<w>滚动字幕</w>移动得太快，我没能读完所有的名字。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "credits roller"
                    ],
                    "target_lang_definitions": {
                        "ru": "Список имен людей, работавших над фильмом или телепрограммой, показываемый в конце.",
                        "zh": "电影或电视节目结尾处显示的演职员名单。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "титры",
                                "target_lang_sense_clarification": "бегущая строка в конце фильма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "演职员表",
                                "target_lang_sense_clarification": "电影结尾名单"
                            },
                            {
                                "target_lang_word": "滚动字幕",
                                "target_lang_sense_clarification": "屏幕上滚动的文字"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "863c9415-68ed-3e9f-9bf9-87020b062522",
                    "sense_definition": "A type of bird known for its bright plumage and the habit of tumbling in flight.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "birds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The European <w>roller</w> is easily recognized by its brilliant blue feathers.",
                            "target_lang_translations": {
                                "ru": "Обыкновенную <w>сизоворонку</w> легко узнать по ее ярко-голубым перьям.",
                                "zh": "欧洲<w>佛法僧</w>很容易辨认，因为它有鲜艳的蓝色羽毛。"
                            }
                        },
                        {
                            "text": "We spotted a <w>roller</w> perched on a branch during our safari.",
                            "target_lang_translations": {
                                "ru": "Во время сафари мы заметили <w>сизоворонку</w>, сидящую на ветке.",
                                "zh": "在游猎期间，我们发现一只<w>佛法僧</w>栖息在树枝上。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип птицы, известной своим ярким оперением и привычкой кувыркаться в полете.",
                        "zh": "一种以羽毛色彩鲜艳和飞行时翻滚习性而闻名的鸟类。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сизоворонка",
                                "target_lang_sense_clarification": "птица семейства ракшевых"
                            },
                            {
                                "target_lang_word": "турман",
                                "target_lang_sense_clarification": "порода голубей, кувыркающихся в полете"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "佛法僧",
                                "target_lang_sense_clarification": "鸟类名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4425507-8498-3d46-96e5-5a52be40a05c",
                    "sense_definition": "A colloquial term for a Rolls-Royce motorcar.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cars",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He arrived at the gala in a vintage <w>Roller</w> driven by a chauffeur.",
                            "target_lang_translations": {
                                "ru": "Он прибыл на гала-концерт на винтажном <w>Роллсе</w> с шофером.",
                                "zh": "他乘坐一辆由司机驾驶的复古<w>劳斯莱斯</w>抵达了晚会现场。"
                            }
                        },
                        {
                            "text": "Driving a <w>Roller</w> is a clear sign of immense wealth.",
                            "target_lang_translations": {
                                "ru": "Вождение <w>Роллса</w> — явный признак огромного богатства.",
                                "zh": "开<w>劳斯莱斯</w>是拥有巨额财富的明显标志。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "British slang for Rolls-Royce"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное название автомобиля марки Роллс-Ройс.",
                        "zh": "劳斯莱斯汽车的口语称呼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Роллс",
                                "target_lang_sense_clarification": "сленговое сокращение для Роллс-Ройса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "劳斯莱斯",
                                "target_lang_sense_clarification": "汽车品牌"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "438d188b-f00a-3422-851b-56bb232576dd",
                    "sense_definition": "To move or travel using <w>roller</w> skates.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kids <w>rollered</w> down the sidewalk all afternoon.",
                            "target_lang_translations": {
                                "ru": "Дети весь день <w>катались на роликах</w> по тротуару.",
                                "zh": "孩子们整个下午都在人行道上<w>滑轮滑</w>。"
                            }
                        },
                        {
                            "text": "She <w>rollered</w> into the park to meet her friends for a skate.",
                            "target_lang_translations": {
                                "ru": "Она <w>прикатила на роликах</w> в парк, чтобы встретиться с друзьями и покататься.",
                                "zh": "她<w>滑着轮滑</w>进入公园去见朋友们。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage for roller skating"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Передвигаться или путешествовать на роликовых коньках.",
                        "zh": "使用轮滑鞋移动或旅行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кататься на роликах",
                                "target_lang_sense_clarification": "процесс движения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑轮滑",
                                "target_lang_sense_clarification": "运动方式"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}