                        "entry_id": "273c37a6-484b-36d5-95ab-3b931e6c1378",
                        "glosses": [
                            "einen persönlichen Besuch abstatten, wegen einer Unterredung oder um ein Anliegen vorzubringen"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "c03632c9-c252-47f4-886f-c17fb11abee3",
                                "sense_id": "1ca3d42d-4dad-3f8b-9454-72681a925707",
                                "text": "Kaum ein Geschäftsmann oder Fabrikant dürfte sich finden, der auf ein bloßes Bewerbungsschreiben hin, ohne Vorsprache einen Anstellungsvertrag ausfertigen würde."
                            }
                        ],
                        "sense_index_json": "\"1\""
