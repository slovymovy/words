                "senses": [
                    {
                        "sense_id": "51587384-3c31-3158-b050-75436e05b2c7",
                        "entry_id": "ef97f183-0ae3-3936-b8d6-6eca5dd70694",
                        "glosses": [
                            "Capitale de la Croatie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72e1f4d3-2709-430b-9b9d-95abd26bfbef",
                                "sense_id": "51587384-3c31-3158-b050-75436e05b2c7",
                                "text": "Après la destruction de Dubrovnik par un tremblement de terre en 1667, le centre culturel du monde croate se déplace vers Zagreb, de dialecte kaïkavien."
                            },
                            {
                                "example_id": "afffb579-5941-43f2-84a5-7b99025a8e4a",
                                "sense_id": "51587384-3c31-3158-b050-75436e05b2c7",
                                "text": "Deux répliques de magnitude 4,8 et 4,7 ont secoué avant l'aube mercredi les environs de Sisak, au sud-est de Zagreb, selon l'Institut de géophysique américain (USGS)."
                            },
                            {
                                "example_id": "773564d5-85d8-4451-9ccd-18e0b84978e6",
                                "sense_id": "51587384-3c31-3158-b050-75436e05b2c7",
                                "text": "Les skieurs et skieuses alpins du groupe France étaient réunis cette semaine à Zagreb."
                            }
                        ]
                    },
                    {
                        "sense_id": "362049ca-0948-359a-b0ad-d76a83d545c5",
                        "entry_id": "ef97f183-0ae3-3936-b8d6-6eca5dd70694",
                        "glosses": [
                            "Gouvernement de la Croatie."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "72177b4c-39fa-468a-b322-0ab5a02016c0",
                                "sense_id": "362049ca-0948-359a-b0ad-d76a83d545c5",
                                "text": "Une ouverture aux vacanciers ne devrait pas tarder si Zagreb veut maintenir sa saison touristique."
                            }
                        ]
                    }
                ],
                "translations": [
