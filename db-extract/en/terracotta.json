                    {
                        "translation_id": "190a4808-5065-4384-b091-57cac4fda3e0",
                        "source_entry_id": "f4d8745f-ea59-330b-9a3b-a9cce70b1130",
                        "source_sense_description": "hard red-brown earthenware",
                        "target_lang_word": "terre cuite",
