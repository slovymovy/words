                    {
                        "translation_id": "59688786-25a0-4634-bb1e-a4f395b62785",
                        "source_entry_id": "86a14e11-1bd0-30bd-bff6-6f3cfda1d75b",
                        "source_sense_description": "a blowing or fusing together",
                        "target_lang_word": "соединение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "соединение",
