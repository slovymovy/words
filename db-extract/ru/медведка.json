                    {
                        "translation_id": "eb9196b0-1d8d-4c29-9c01-a1efd146d1ad",
                        "source_entry_id": "31d75695-b531-3959-a865-4458674f0cbe",
                        "source_sense_id": "2828413d-6183-3f5e-874d-93de72faae4b",
                        "target_lang_word": "courtilière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courtilière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9acf7af6-e86e-39c1-96fd-8926e3a45339",
                                        "entry_id": "9935fa3a-7724-3294-a45d-5ac1ddfe7a75",
                                        "glosses": [
                                            "Insecte qui vit sous terre et qui fait beaucoup de dégâts dans les jardins."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b82edb3d-8917-45c7-a773-3f1a2aeb7bf0",
                                                "sense_id": "9acf7af6-e86e-39c1-96fd-8926e3a45339",
                                                "text": "La courtilière est un des insectes les plus nuisibles à la culture maraîchère et particulièrement aux semis sous verre et aux couches appropriées à l’élève des primeurs."
                                            },
                                            {
                                                "example_id": "1f1d5929-e6f8-4dc8-8b92-ba192f6d3790",
                                                "sense_id": "9acf7af6-e86e-39c1-96fd-8926e3a45339",
                                                "text": "La nuit était vraiment très douce. Les grillons et les courtilières que la chaleur de ce jour de faux été avait revigorés faisaient entendre maintenant ce crissement métallique qui semble être l’enivrement de l’air lui-même."
                                            },
                                            {
                                                "example_id": "fba19f4a-4309-4141-ad2b-66a71e47da61",
                                                "sense_id": "9acf7af6-e86e-39c1-96fd-8926e3a45339",
                                                "text": "Ne lui avait-il pas affirmé successivement qu’il savait la manière de faire certains caramels au chocolat, d’économiser la moitié des bouchons au moment de la mise en bouteille d’une pièce de bordeaux, et de tuer les courtilières qui dévastaient nos laitues ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
