                ],
                "senses": [
                    {
                        "sense_id": "d5660e8d-8f45-3cbf-9ec0-e31efc2ffb22",
                        "entry_id": "b7d79c4d-9bfa-3dd1-a5fb-40b74a0e5ffc",
                        "glosses": [
                            "viele Millionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed8b54b2-6fa0-4f57-b09e-e02ad25aa650",
                                "sense_id": "d5660e8d-8f45-3cbf-9ec0-e31efc2ffb22",
                                "text": "„Der Markt wartet auf eine Vision, die zeigt, wie die Abermillionen Anwender die Gewinne langfristig steigern können.“"
                            },
                            {
                                "example_id": "ea5da2da-49ef-4d48-9fb5-bf27a3ee9bb7",
                                "sense_id": "d5660e8d-8f45-3cbf-9ec0-e31efc2ffb22",
                                "text": "„Druck und natürliche Radioaktivität halten den Kern der Erde heiß. Es wird Abermillionen Jahre dauern, bis diese Hitze schwindet.“"
                            },
                            {
                                "example_id": "524d954c-1afa-4d00-835b-339343b28e4a",
                                "sense_id": "d5660e8d-8f45-3cbf-9ec0-e31efc2ffb22",
                                "text": "„Das Mannwerden ihres Sohnes war für sie in jeder einzelnen Phase etwas so Ueberraschendes, als hätte sie nie davon gehört, dass Millionen und Abermillionen von Menschen auf eben diese Weise zu Männern geworden waren.“"
                            },
                            {
                                "example_id": "aebe50b5-c74f-43c6-a23e-c206c8f1d78e",
                                "sense_id": "d5660e8d-8f45-3cbf-9ec0-e31efc2ffb22",
                                "text": "„Das ist keine Seltenheit: Deutsche investieren jedes Jahr Abermillionen Euro Privatgelder in Hollywoodproduktionen, weil sie dies als Investition sehen und auf Gewinn hoffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
