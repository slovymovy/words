                        ],
                        "examples": [
                            {
                                "example_id": "3b1e772b-c11d-45de-a5a4-608f36e918d4",
                                "sense_id": "c051ce86-7bf8-36fb-a2b3-321f2d5fb42e",
                                "text": "Recently, the police station at Nei-Hu district arrested about ten Filipina domestics and nursing workers who ran away from their employers."
                            },
                            {
                                "example_id": "f40bebf3-d27a-41a7-85df-e92905e922aa",
                                "sense_id": "c051ce86-7bf8-36fb-a2b3-321f2d5fb42e",
                                "text": "Whether portrayed as masculine warriors, female seducers, or wayward mothers, Huk Amazons were regarded as extraordinary and unconventional Filipinas: communist guerrillas trained to fight as soldiers against the government and women who lived in the forests, fraternized with men, and had children outside marriage."
                            }
                        ]
