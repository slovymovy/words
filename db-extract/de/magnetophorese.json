                ],
                "senses": [
                    {
                        "sense_id": "756c8d2f-23cb-3d7f-be1a-b82bb31fa092",
                        "entry_id": "e3e8bddb-77ab-3081-8781-e27f0c71c860",
                        "glosses": [
                            "Auftrennung von Stoffgemischen in starken Magnetfeldern"
                        ],
                        "tags": [
                            "Naturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "dc50e6ff-6d8f-40a4-a302-9bc5a8bd23ac",
                                "sense_id": "756c8d2f-23cb-3d7f-be1a-b82bb31fa092",
                                "text": "„Auf Magnetophorese beruhende Geräte zur Blutanalyse könnten dann die zeitaufwendige Zentrifugation von Blutkörperchen ersetzen.“"
                            },
                            {
                                "example_id": "ed231094-689a-4637-89f9-7459edb8af73",
                                "sense_id": "756c8d2f-23cb-3d7f-be1a-b82bb31fa092",
                                "text": "„Das Grundprinzip der Magnetophorese besteht darin, mit Hilfe eines ferromagnetischen Drahtes innerhalb eines Mikrokanals ein starkes Magnetfeld zu erzeugen.“"
                            },
                            {
                                "example_id": "79ed4689-8fe1-42d6-8134-6ed41a9032b8",
                                "sense_id": "756c8d2f-23cb-3d7f-be1a-b82bb31fa092",
                                "text": "„Durch Magnetophorese gelingt es zum Beispiel, die sauerstoffarmen paramagnetischen roten Blutkörperchen von den sauerstoffreichen diamagnetischen zu trennen.“"
                            },
                            {
                                "example_id": "35514e19-8186-41c0-a661-25b42d873306",
                                "sense_id": "756c8d2f-23cb-3d7f-be1a-b82bb31fa092",
                                "text": "„Mit den Strömungssimulationswerkzeugen können gekoppelte elektrokinetische und magnetodynamische Simulationen einfacher erstellt werden, wie z. B. bei der Elektrophorese, Magnetophorese, Dielektrophorese, Elektroosmose und Electrowetting.“"
                            },
                            {
                                "example_id": "2b3d83cc-8870-4e67-a603-d25da5f2a255",
                                "sense_id": "756c8d2f-23cb-3d7f-be1a-b82bb31fa092",
                                "text": "„Insbesondere sind zur magnetbasierten Messung Verfahren bekannt, bei denen magnetisch markierte Zellen mittels Magnetophorese aus einer komplexen Zellsuspension, z.B. einer Blutprobe, aussortiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
