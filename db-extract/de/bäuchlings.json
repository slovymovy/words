        "de-extract.jsonl": [
            {
                "entry_id": "9f95046d-1e55-34e9-bf25-b7292dcc1942",
                "word": "bäuchlings",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5afb70aa-50fe-362f-afe4-c68cd813d0ef",
                        "entry_id": "9f95046d-1e55-34e9-bf25-b7292dcc1942",
                        "glosses": [
                            "auf dem Bauch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83439a5a-2647-47d6-8c0a-8b29f518a79b",
                                "sense_id": "5afb70aa-50fe-362f-afe4-c68cd813d0ef",
                                "text": "Er lag bäuchlings auf dem Bett."
                            },
                            {
                                "example_id": "f271b9ad-6084-4dce-822c-3cbd2283c52e",
                                "sense_id": "5afb70aa-50fe-362f-afe4-c68cd813d0ef",
                                "text": "„Ich habe keine Lust, sagte sie, bemüht, ihre Silhouette zu verflachen, und preßte sich bäuchlings auf die Matratze, während Andres Schatten an Größe gewann.“"
                            },
                            {
                                "example_id": "24d8a581-0816-4114-b92e-1c42c6e94115",
                                "sense_id": "5afb70aa-50fe-362f-afe4-c68cd813d0ef",
                                "text": "„Mit letzter Kraft hat er sich zurück zum Mökki geschleppt oder ist dort abgelegt worden - niemand vermag es zu sagen; bäuchlings liegend, mit zwei bedrohlich tiefen, noch immer blutenden Striemen auf dem Rücken, wie von den Pranken eines Bären.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b569a014-5ebc-3fbf-8379-f1c733b4c9b3",
                        "entry_id": "9f95046d-1e55-34e9-bf25-b7292dcc1942",
                        "glosses": [
                            "auf den Bauch, mit dem Bauch voran"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fc6967d-3bf6-4de6-93e9-851d9788e902",
                                "sense_id": "b569a014-5ebc-3fbf-8379-f1c733b4c9b3",
                                "text": "Donald ist bäuchlings ins Wasser gefallen."
                            },
                            {
                                "example_id": "305f2ce5-88be-429e-a6d6-1286409ecb8b",
                                "sense_id": "b569a014-5ebc-3fbf-8379-f1c733b4c9b3",
                                "text": "„[…]bei den Toten, die rücklings und bäuchlings gestürzt sind oder noch stürzen, bei den sich Windenden, die knien oder sitzen, bei den sinkenden Frauen, deren Stellung nur einen kurzen Moment ausdrückt;[…]“"
                            },
                            {
                                "example_id": "5b4ea9d8-bb20-4a5f-bd2a-fd99f8714758",
                                "sense_id": "b569a014-5ebc-3fbf-8379-f1c733b4c9b3",
                                "text": "„Danach hüllte er mich in einen flauschigen Bademantel, den er herbeigezaubert hatte, legte mich bäuchlings ins Bett und deckte mich zu.“"
                            },
                            {
                                "example_id": "2ab7ff42-80fb-4d6d-b4a9-4252b54ab1ef",
                                "sense_id": "b569a014-5ebc-3fbf-8379-f1c733b4c9b3",
                                "text": "„Stattdessen drehte er sich wieder um und richtete die Waffe auf Morton und Cidro, die sich beide bäuchlings auf den Boden geworfen hatten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "930756c9-d9c0-4544-bb3b-d6cf61fe4b9a",
                        "source_entry_id": "9f95046d-1e55-34e9-bf25-b7292dcc1942",
                        "source_sense_id": "5afb70aa-50fe-362f-afe4-c68cd813d0ef",
                        "source_sense_description": "auf dem Bauch",
                        "target_lang_word": "à plat ventre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à plat ventre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a49e20fd-e2a5-32af-b35c-464667e80c12",
                                        "entry_id": "017078fb-96f1-34ad-abe0-d18ebd204566",
                                        "glosses": [
                                            "Allongé à terre, avec le ventre contre le sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11fca016-1e7c-47df-91e4-9f3314c47876",
                                                "sense_id": "a49e20fd-e2a5-32af-b35c-464667e80c12",
                                                "text": "Il fallut sortir, ramper à plat ventre, péniblement, dans la nuit noire où le vent froid faisait fureur, sous un ciel d’encre."
                                            },
                                            {
                                                "example_id": "5613d627-7f59-4cc8-8032-6ef8b3957830",
                                                "sense_id": "a49e20fd-e2a5-32af-b35c-464667e80c12",
                                                "text": "Deux d’entre eux voulaient absolument qu’il s’agenouillât, les autres lui commandaient au contraire de se mettre à plat ventre."
                                            },
                                            {
                                                "example_id": "f6e3c9b9-082e-445c-b0ef-b5732557a4c9",
                                                "sense_id": "a49e20fd-e2a5-32af-b35c-464667e80c12",
                                                "text": "[…], je fis environ cent mètres à plat ventre, […], pour arriver à une charrue dont la silhouette m’avait fait grand’peur."
                                            },
                                            {
                                                "example_id": "d59a9a55-3e7c-4292-b29f-9a3dcfcc3202",
                                                "sense_id": "a49e20fd-e2a5-32af-b35c-464667e80c12",
                                                "text": "À plat ventre, près de la rampe, l’électricien vérifiait les ampoules sans s’occuper de la vedette."
                                            },
                                            {
                                                "example_id": "7f3131c3-b59e-4d47-834d-c0a4cba4a35d",
                                                "sense_id": "a49e20fd-e2a5-32af-b35c-464667e80c12",
                                                "text": "Nous rentrions de la chasse à la tombée de la nuit : installés (à plat ventre) devant le grand feu de bois résineux, nous faisions des parties de dames, de dominos, de jeu de l’oie – pendant que mon père jouait de la flûte – et parfois le loto réunissait toute la famille."
                                            },
                                            {
                                                "example_id": "bea95a91-c35d-457b-bacc-76bd4b0b0a91",
                                                "sense_id": "a49e20fd-e2a5-32af-b35c-464667e80c12",
                                                "text": "Il congédia Grazyna et, resté seul, il se mit à plat ventre pour inspecter précautionneusement le balcon et ne tarda pas à se rendre compte du sabotage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b78ae74-4456-341c-8e81-ff66f96d7fbb",
                                        "entry_id": "017078fb-96f1-34ad-abe0-d18ebd204566",
                                        "glosses": [
                                            "En état de soumission ou d’indignité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bc07112-0f79-4ceb-8a50-2425d43e3f72",
                                                "sense_id": "5b78ae74-4456-341c-8e81-ff66f96d7fbb",
                                                "text": "Il lui fallait pêcher sa croûte, n’importe comment, dans les poubelles, à plat ventre, dans la fange, dans la m… Tout d’ailleurs n’était que m… La société, la belle société, un vaste pot de m…, un gulf-stream de m…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
