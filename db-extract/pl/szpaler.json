                ],
                "translations": [
                    {
                        "translation_id": "6ed317fa-3755-47f1-a2a4-534af68f73d4",
                        "source_entry_id": "4a78ee25-a99a-3da0-abe3-5fd0a8bc6a65",
                        "source_sense_id": "b443890d-4022-3692-838f-373efba4f64c",
                        "target_lang_word": "Spalier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spalier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc06d53a-2292-3be4-9483-a3e5ed02992f",
                                        "entry_id": "1fbb90a7-4831-3b35-91e7-f9ebd3eae5b3",
                                        "glosses": [
                                            "Stützgebilde zum Aufziehen von Obstgehölzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "437e68c9-3063-4400-a0d5-df9fd090398d",
                                                "sense_id": "bc06d53a-2292-3be4-9483-a3e5ed02992f",
                                                "text": "In unserem Klima reifen Marillen nur an Spalieren."
                                            },
                                            {
                                                "example_id": "9464d41b-b637-4974-8bc0-8244f2dc2670",
                                                "sense_id": "bc06d53a-2292-3be4-9483-a3e5ed02992f",
                                                "text": "„Dennoch machten sie sich heißhungrig und in vollem Bewußtsein, etwas Verbotenes, Anstößiges zu tun, über die Spaliere her.“"
                                            },
                                            {
                                                "example_id": "f2833c7d-c0aa-4a14-9426-231a73d7ceca",
                                                "sense_id": "bc06d53a-2292-3be4-9483-a3e5ed02992f",
                                                "text": "„In der Ferne sah ich Jeans Gärtner mit einer Heckenschere in der Hand zwischen den Spalier stehenden Weinreben verschwinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e63acb4c-4670-3ed6-9235-1361624d6dc3",
                                        "entry_id": "1fbb90a7-4831-3b35-91e7-f9ebd3eae5b3",
                                        "glosses": [
                                            "Personengasse zum Geleit anderer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e61ed9e-e949-4614-9110-9003fd3bc512",
                                                "sense_id": "e63acb4c-4670-3ed6-9235-1361624d6dc3",
                                                "text": "Nach der Trauung ging das Brautpaar durch ein Spalier von Hochzeitsgästen."
                                            },
                                            {
                                                "example_id": "fe66dc21-d90e-4e7f-9ec7-c3f57fde85a4",
                                                "sense_id": "e63acb4c-4670-3ed6-9235-1361624d6dc3",
                                                "text": "„Ein Spalier ungeschickt salutierender Soldaten hatte Aufstellung genommen, ein Trompetensignal wehte durch den Himmel, eine Fahne blähte sich im Wind.“"
                                            },
                                            {
                                                "example_id": "19d4e779-981c-4125-9fe3-5a00be8b0f91",
                                                "sense_id": "e63acb4c-4670-3ed6-9235-1361624d6dc3",
                                                "text": "„Denn am Weg über den Gutshof, vor ihrem Quartier, haben sich die Franzosen zum Spalier aufgestellt.“"
                                            },
                                            {
                                                "example_id": "6fee878d-d0ff-474e-aa70-625bf8762a21",
                                                "sense_id": "e63acb4c-4670-3ed6-9235-1361624d6dc3",
                                                "text": "„Rasch bildete sich eine breite Gasse, und durch das Spalier der Edelleute betrat der Kaiser den Saal.“"
                                            },
                                            {
                                                "example_id": "39b43f13-4d1b-4a5a-b0a9-1a1b5352a064",
                                                "sense_id": "e63acb4c-4670-3ed6-9235-1361624d6dc3",
                                                "text": "„Durch ein Spalier von Schaulustigen begab ich mich in ein Café, um den bitteren Geschmack mit einer ungezuckerten Limonade hinunterzuspülen.“"
                                            },
                                            {
                                                "example_id": "101e6fa5-552a-4717-9c77-f870aef063f3",
                                                "sense_id": "e63acb4c-4670-3ed6-9235-1361624d6dc3",
                                                "text": "[Mord an Walther Rathenau 1922:] „Hunderttausende stehen Spalier als Rathenau in Berlin zu Grabe getragen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2aa884bc-1b7b-4598-a35c-68d3378bcc45",
                        "source_entry_id": "4a78ee25-a99a-3da0-abe3-5fd0a8bc6a65",
                        "source_sense_id": "b443890d-4022-3692-838f-373efba4f64c",
                        "target_lang_word": "шпалера",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шпалера",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2e371799-3ce9-395d-a6dd-c5f42ce36033",
                                        "entry_id": "88afe2d6-bd0b-39ff-a42f-415d6d4d9ab0",
                                        "glosses": [
                                            "безворсовый настенный ковёр или обивочная ткань ручной работы, обычно с сюжетными или пейзажными изображениями"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fab6ea5b-90e9-4e25-98bd-b6b8e157ea36",
                                                "sense_id": "2e371799-3ce9-395d-a6dd-c5f42ce36033",
                                                "text": "Несколько выцветшие нидерландские шпалеры ласкают глаз утончённостью рисунка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e554fd5f-b46e-32ee-af0f-d1319718c761",
                                        "entry_id": "88afe2d6-bd0b-39ff-a42f-415d6d4d9ab0",
                                        "glosses": [
                                            "устар., то же, что обои"
                                        ],
                                        "tags": [
                                            "обычно мн. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e9f2328-19d3-4629-80ce-65235ebca7fb",
                                                "sense_id": "e554fd5f-b46e-32ee-af0f-d1319718c761",
                                                "text": "Низенькая комнатка в два окна, оклеенная шпалерами, освещалась лампой, повешенной на стену."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7becfdb0-3843-35c7-952f-5929844927ba",
                                        "entry_id": "88afe2d6-bd0b-39ff-a42f-415d6d4d9ab0",
                                        "glosses": [
                                            "сад. система специальных решёток или натянутая на колья проволока, по которой вьётся растение или к которой привязываются ветви деревьев для придания им определённой формы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "850fb210-c48b-40d1-ad4e-8084f23c1bb4",
                                                "sense_id": "7becfdb0-3843-35c7-952f-5929844927ba",
                                                "text": "Дома крайне похожи друг на друга, а высокие шпалеры, увитые розами и другими вьющимися растениями, скрывали их стены."
                                            },
                                            {
                                                "example_id": "c047e250-4de9-4008-9c89-20e5db4b5ae9",
                                                "sense_id": "7becfdb0-3843-35c7-952f-5929844927ba",
                                                "text": "Грядовые межи были уставлены шпалерами, увитыми невиданными сортами лимонника, мальв, хмеля, гороха, омелы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d126fff2-4fb5-3ec2-bdea-332588b3612b",
                                        "entry_id": "88afe2d6-bd0b-39ff-a42f-415d6d4d9ab0",
                                        "glosses": [
                                            "сад. один из рядов подстриженных деревьев, кустов по сторонам дороги, дорожки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d31cb88b-4f8e-4ae5-9035-1ad56a8a2f21",
                                                "sense_id": "d126fff2-4fb5-3ec2-bdea-332588b3612b",
                                                "text": "Причём особенно привлекательны в этом смысле шпалеры из плодовых растений (яблони, вишни, сливы), которые весной обильно покрываются нежными цветками, а осенью с них собирают урожай."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09368912-1701-3ed4-a67b-f2e9ed201a9e",
                                        "entry_id": "88afe2d6-bd0b-39ff-a42f-415d6d4d9ab0",
                                        "glosses": [
                                            "ряд, шеренга людей (в т. ч. войск) по сторонам пути следования кого-либо, чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da43e909-c939-4800-a1d2-e9a0813e6ae1",
                                                "sense_id": "09368912-1701-3ed4-a67b-f2e9ed201a9e",
                                                "text": "У лорда Генри, конечно, был особняк с цветником из орхидей и шпалеры напудренных лакеев, но это неважно."
                                            },
                                            {
                                                "example_id": "4ff5a59d-5d72-4ec2-8282-c88c0880d03e",
                                                "sense_id": "09368912-1701-3ed4-a67b-f2e9ed201a9e",
                                                "text": "Школьников выстроили шпалерами во внутреннем дворе, и я выступал перед ними, как Ленин, только без броневика."
                                            },
                                            {
                                                "example_id": "ff61cb4f-0242-48fd-a14d-42043ab105d8",
                                                "sense_id": "09368912-1701-3ed4-a67b-f2e9ed201a9e",
                                                "text": "Людей гнали сквозь шпалеры вооружённой охраны, выстроенной по всему пути, в широко распахнутую пасть огромного тюремного люка."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "718efdd5-7635-4ab7-b40b-caf999b90740",
                        "source_entry_id": "4a78ee25-a99a-3da0-abe3-5fd0a8bc6a65",
                        "source_sense_id": "ea0a5ba9-7480-313d-a477-b1816f4648ba",
                        "target_lang_word": "Spalier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spalier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc06d53a-2292-3be4-9483-a3e5ed02992f",
                                        "entry_id": "1fbb90a7-4831-3b35-91e7-f9ebd3eae5b3",
                                        "glosses": [
                                            "Stützgebilde zum Aufziehen von Obstgehölzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "437e68c9-3063-4400-a0d5-df9fd090398d",
                                                "sense_id": "bc06d53a-2292-3be4-9483-a3e5ed02992f",
                                                "text": "In unserem Klima reifen Marillen nur an Spalieren."
                                            },
                                            {
                                                "example_id": "9464d41b-b637-4974-8bc0-8244f2dc2670",
                                                "sense_id": "bc06d53a-2292-3be4-9483-a3e5ed02992f",
                                                "text": "„Dennoch machten sie sich heißhungrig und in vollem Bewußtsein, etwas Verbotenes, Anstößiges zu tun, über die Spaliere her.“"
                                            },
                                            {
                                                "example_id": "f2833c7d-c0aa-4a14-9426-231a73d7ceca",
                                                "sense_id": "bc06d53a-2292-3be4-9483-a3e5ed02992f",
                                                "text": "„In der Ferne sah ich Jeans Gärtner mit einer Heckenschere in der Hand zwischen den Spalier stehenden Weinreben verschwinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e63acb4c-4670-3ed6-9235-1361624d6dc3",
                                        "entry_id": "1fbb90a7-4831-3b35-91e7-f9ebd3eae5b3",
                                        "glosses": [
                                            "Personengasse zum Geleit anderer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e61ed9e-e949-4614-9110-9003fd3bc512",
                                                "sense_id": "e63acb4c-4670-3ed6-9235-1361624d6dc3",
                                                "text": "Nach der Trauung ging das Brautpaar durch ein Spalier von Hochzeitsgästen."
                                            },
                                            {
                                                "example_id": "fe66dc21-d90e-4e7f-9ec7-c3f57fde85a4",
                                                "sense_id": "e63acb4c-4670-3ed6-9235-1361624d6dc3",
                                                "text": "„Ein Spalier ungeschickt salutierender Soldaten hatte Aufstellung genommen, ein Trompetensignal wehte durch den Himmel, eine Fahne blähte sich im Wind.“"
                                            },
                                            {
                                                "example_id": "19d4e779-981c-4125-9fe3-5a00be8b0f91",
                                                "sense_id": "e63acb4c-4670-3ed6-9235-1361624d6dc3",
                                                "text": "„Denn am Weg über den Gutshof, vor ihrem Quartier, haben sich die Franzosen zum Spalier aufgestellt.“"
                                            },
                                            {
                                                "example_id": "6fee878d-d0ff-474e-aa70-625bf8762a21",
                                                "sense_id": "e63acb4c-4670-3ed6-9235-1361624d6dc3",
                                                "text": "„Rasch bildete sich eine breite Gasse, und durch das Spalier der Edelleute betrat der Kaiser den Saal.“"
                                            },
                                            {
                                                "example_id": "39b43f13-4d1b-4a5a-b0a9-1a1b5352a064",
                                                "sense_id": "e63acb4c-4670-3ed6-9235-1361624d6dc3",
                                                "text": "„Durch ein Spalier von Schaulustigen begab ich mich in ein Café, um den bitteren Geschmack mit einer ungezuckerten Limonade hinunterzuspülen.“"
                                            },
                                            {
                                                "example_id": "101e6fa5-552a-4717-9c77-f870aef063f3",
                                                "sense_id": "e63acb4c-4670-3ed6-9235-1361624d6dc3",
                                                "text": "[Mord an Walther Rathenau 1922:] „Hunderttausende stehen Spalier als Rathenau in Berlin zu Grabe getragen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "927d2f4b-d236-4df0-8a8b-a395f4a99cb0",
                        "source_entry_id": "4a78ee25-a99a-3da0-abe3-5fd0a8bc6a65",
                        "source_sense_id": "ea0a5ba9-7480-313d-a477-b1816f4648ba",
                        "target_lang_word": "шпалера",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шпалера",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2e371799-3ce9-395d-a6dd-c5f42ce36033",
                                        "entry_id": "88afe2d6-bd0b-39ff-a42f-415d6d4d9ab0",
                                        "glosses": [
                                            "безворсовый настенный ковёр или обивочная ткань ручной работы, обычно с сюжетными или пейзажными изображениями"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fab6ea5b-90e9-4e25-98bd-b6b8e157ea36",
                                                "sense_id": "2e371799-3ce9-395d-a6dd-c5f42ce36033",
                                                "text": "Несколько выцветшие нидерландские шпалеры ласкают глаз утончённостью рисунка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e554fd5f-b46e-32ee-af0f-d1319718c761",
                                        "entry_id": "88afe2d6-bd0b-39ff-a42f-415d6d4d9ab0",
                                        "glosses": [
                                            "устар., то же, что обои"
                                        ],
                                        "tags": [
                                            "обычно мн. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e9f2328-19d3-4629-80ce-65235ebca7fb",
                                                "sense_id": "e554fd5f-b46e-32ee-af0f-d1319718c761",
                                                "text": "Низенькая комнатка в два окна, оклеенная шпалерами, освещалась лампой, повешенной на стену."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7becfdb0-3843-35c7-952f-5929844927ba",
                                        "entry_id": "88afe2d6-bd0b-39ff-a42f-415d6d4d9ab0",
                                        "glosses": [
                                            "сад. система специальных решёток или натянутая на колья проволока, по которой вьётся растение или к которой привязываются ветви деревьев для придания им определённой формы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "850fb210-c48b-40d1-ad4e-8084f23c1bb4",
                                                "sense_id": "7becfdb0-3843-35c7-952f-5929844927ba",
                                                "text": "Дома крайне похожи друг на друга, а высокие шпалеры, увитые розами и другими вьющимися растениями, скрывали их стены."
                                            },
                                            {
                                                "example_id": "c047e250-4de9-4008-9c89-20e5db4b5ae9",
                                                "sense_id": "7becfdb0-3843-35c7-952f-5929844927ba",
                                                "text": "Грядовые межи были уставлены шпалерами, увитыми невиданными сортами лимонника, мальв, хмеля, гороха, омелы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d126fff2-4fb5-3ec2-bdea-332588b3612b",
                                        "entry_id": "88afe2d6-bd0b-39ff-a42f-415d6d4d9ab0",
                                        "glosses": [
                                            "сад. один из рядов подстриженных деревьев, кустов по сторонам дороги, дорожки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d31cb88b-4f8e-4ae5-9035-1ad56a8a2f21",
                                                "sense_id": "d126fff2-4fb5-3ec2-bdea-332588b3612b",
                                                "text": "Причём особенно привлекательны в этом смысле шпалеры из плодовых растений (яблони, вишни, сливы), которые весной обильно покрываются нежными цветками, а осенью с них собирают урожай."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09368912-1701-3ed4-a67b-f2e9ed201a9e",
                                        "entry_id": "88afe2d6-bd0b-39ff-a42f-415d6d4d9ab0",
                                        "glosses": [
                                            "ряд, шеренга людей (в т. ч. войск) по сторонам пути следования кого-либо, чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da43e909-c939-4800-a1d2-e9a0813e6ae1",
                                                "sense_id": "09368912-1701-3ed4-a67b-f2e9ed201a9e",
                                                "text": "У лорда Генри, конечно, был особняк с цветником из орхидей и шпалеры напудренных лакеев, но это неважно."
                                            },
                                            {
                                                "example_id": "4ff5a59d-5d72-4ec2-8282-c88c0880d03e",
                                                "sense_id": "09368912-1701-3ed4-a67b-f2e9ed201a9e",
                                                "text": "Школьников выстроили шпалерами во внутреннем дворе, и я выступал перед ними, как Ленин, только без броневика."
                                            },
                                            {
                                                "example_id": "ff61cb4f-0242-48fd-a14d-42043ab105d8",
                                                "sense_id": "09368912-1701-3ed4-a67b-f2e9ed201a9e",
                                                "text": "Людей гнали сквозь шпалеры вооружённой охраны, выстроенной по всему пути, в широко распахнутую пасть огромного тюремного люка."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
