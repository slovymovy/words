                "senses": [
                    {
                        "sense_id": "f7e179d9-2d47-3fac-b921-76d26ab86e68",
                        "entry_id": "5c82761c-4267-32d4-8b0a-408cc51935d3",
                        "glosses": [
                            "eine für Eigengewichtsübungen (Calisthenics) ausgelegte Trainingsanlage, häufig im Freien (in einem Park oder auf einem Spielplatz)"
                        ],
                        "tags": [
                            "Calisthenics"
                        ],
                        "examples": [
                            {
                                "example_id": "916ec5c0-0b18-4979-a0be-3bc2f511d67a",
                                "sense_id": "f7e179d9-2d47-3fac-b921-76d26ab86e68",
                                "text": "„Konkret wird nun neben der Errichtung eines Pumptracks (speziell geschaffene Mountainbikestrecke) eine Calisthenics-Anlage (zum Krafttraining im Freien) sowie auf Initiative von Marco Haderer ein Volleyballplatz geplant.“"
                            },
                            {
                                "example_id": "a0eacc8b-eeb3-41c7-8a67-17710fa91ab3",
                                "sense_id": "f7e179d9-2d47-3fac-b921-76d26ab86e68",
                                "text": "„Der Barren bietet sich auch als sinnvolle Ergänzung einer Calisthenics-Anlage an – schon im antiken Griechenland wusste man die Vorteile dieses Eigengewichtsturnens für einen gestählten Körper zu nutzen.“"
                            },
                            {
                                "example_id": "7a1cc965-0c5d-40a0-a8f5-f2057f8d5b48",
                                "sense_id": "f7e179d9-2d47-3fac-b921-76d26ab86e68",
                                "text": "„Bei unserem ersten Besuch in 2020 war hier noch Baustelle - jetzt sind auch der Parcoursbereich, die Calisthenics-Anlage und ein Kletterfelsen fertig!“"
                            },
                            {
                                "example_id": "0d680378-5603-4d53-b153-26fa3689711d",
                                "sense_id": "f7e179d9-2d47-3fac-b921-76d26ab86e68",
                                "text": "„Im Kaltenkirchener Freizeitpark steht eine individuelle Calisthenics-Anlage unseres Partners CustomBars.“"
                            },
                            {
                                "example_id": "c24a61de-211f-4a5b-ba25-8f875d8b50af",
                                "sense_id": "f7e179d9-2d47-3fac-b921-76d26ab86e68",
                                "text": "„Ob Kletterdach, Balancierleiter oder Calisthenics-Anlage – der modernisierte Fitness-Parcours bietet Anfängern und erfahrenen Sportlern die passende Herausforderung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
