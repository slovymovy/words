                ],
                "senses": [
                    {
                        "sense_id": "f6e65dde-710e-3111-8b22-259dde48ec6c",
                        "entry_id": "9752c6ac-1d6a-3067-add6-51d203649cad",
                        "glosses": [
                            "de vrouwelijke huwelijkspartner"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "13d67262-1a04-4c3e-be63-e23fab95260a",
                                "sense_id": "f6e65dde-710e-3111-8b22-259dde48ec6c",
                                "text": "Helemaal aan top een miraculeuze Griekse mythe: op een dag krijgt de oppergod Zeus verschrikkelijke hoofdpijn. Hij blijkt zwanger van zijn gemalin Metis, een reuzin die hij heeft opgegeten omdat zij zijn macht bedreigde. Hermes, boodschapper der goden, haalt ijlings Hephaistos, smid van beroep en zoon van Zeus. Met een bijl splijt deze het hoofd van Zeus. Uit zijn gespleten hoofd wordt Athena geboren, godin der wijsheid, een al volwassen vrouw in volle wapenuitrusting."
                            },
                            {
                                "example_id": "8deaa3ef-8f9e-41c5-9ac2-27c078ff5021",
                                "sense_id": "f6e65dde-710e-3111-8b22-259dde48ec6c",
                                "text": "Heidelberg, de oudste hogeschool in Duitsland, viert morgen zijn vierhonderdste jubileum. Uit begeerte die bij te wonen, begaf ik mij met de hertogin, mijn geliefde gemalin, op reis."
                            },
                            {
                                "example_id": "33094375-2363-435f-b0d4-a7668eb037bb",
                                "sense_id": "f6e65dde-710e-3111-8b22-259dde48ec6c",
                                "text": "Op 29 mei verliet Napoleon Dresden, waar hij drie weken had doorgebracht, omringd door een hofhouding bestaande uit prinsen, hertogen, koningen en zelfs een keizer. Voor zijn vertrek begunstigde hij de prinsen, koningen en de keizer, die dat hadden verdiend, berispte hij de koningen en prinsen over wie hij niet helemaal tevreden was, schonk hij zijn eigen — dat wil zeggen van andere koningen afgenomen — parels en diamanten aan de Oostenrijkse keizerin,* en nadat hij — zoals zijn geschiedschrijver* ons vertelt—keizerin Marie Louise teder had omhelsd vertrok hij en zij bleef achter, diep bedroefd over de scheiding, die zij — deze Marie Louise, die zichzelf als zijn gemalin beschouwde, hoewel hij ook nog een vrouw in Parijs had* — nauwelijks scheen te kunnen verdragen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "101adcef-2c63-4805-9592-e2da7aa40a65",
                        "source_entry_id": "9752c6ac-1d6a-3067-add6-51d203649cad",
                        "source_sense_id": "f6e65dde-710e-3111-8b22-259dde48ec6c",
                        "source_sense_description": "echtgenote",
                        "target_lang_word": "spouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5190c9fc-4bd0-3bb8-a928-b14d5d418b55",
                                        "entry_id": "709c36ae-2fff-34ed-8e8c-680cb2a624cd",
                                        "glosses": [
                                            "A person in a marriage or marital relationship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c423fd4-ae5a-4953-a903-c3cc3962dc93",
                                                "sense_id": "5190c9fc-4bd0-3bb8-a928-b14d5d418b55",
                                                "text": "People should treat their spouses with respect."
                                            },
                                            {
                                                "example_id": "104a3365-1d69-4237-beba-f450d21d2e37",
                                                "sense_id": "5190c9fc-4bd0-3bb8-a928-b14d5d418b55",
                                                "text": "At last such grace I found, and meanes I wrought, / That I that Ladie to my spouse had wonne"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c02fd14d-9823-3814-a908-094e2d294892",
                                        "entry_id": "c6e01a25-ede6-362f-9cb5-f2837ba4e044",
                                        "glosses": [
                                            "To wed; to espouse."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8cdcc1c-bf43-4082-bcda-5f31a45692a4",
                                                "sense_id": "c02fd14d-9823-3814-a908-094e2d294892",
                                                "text": "Do you stand possess’d\nOf any proof against the honourableness\nOf Lady Auranthe, our new-spoused daughter?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
