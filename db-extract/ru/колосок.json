                "senses": [
                    {
                        "sense_id": "b4cb5b35-71cd-354a-b736-b41af7b50293",
                        "entry_id": "00c6d96d-e139-31a2-bc2a-06b931c0a8f5",
                        "glosses": [
                            "структурный элемент сложного соцветия (обычно сложного колоса) в некоторых семействах цветковых растений"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "595d5e5c-862b-437e-af7d-62ae9dd1e853",
                                "sense_id": "b4cb5b35-71cd-354a-b736-b41af7b50293",
                                "text": "Колоски собраны в метёлку; в колоске нижний цветок тычиночный, верхний — обоеполый."
                            },
                            {
                                "example_id": "951a369e-210a-49ad-88b2-11686e1d58bc",
                                "sense_id": "b4cb5b35-71cd-354a-b736-b41af7b50293",
                                "text": "Прямое комбайнирование с обмолотом колосков и оставлением высокой стерни."
                            }
                        ]
                    }
                ],
