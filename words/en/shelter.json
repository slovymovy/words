{
    "word_family": [
        "sheltered",
        "sheltering",
        "unsheltered"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "16371812-6835-3509-b6bc-8e4af428d897",
                    "sense_definition": "The basic human need for a place to live or stay that provides protection from the weather",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The charity provides food and <w>shelter</w> for people who have lost their homes in the flood.",
                            "target_lang_translations": {
                                "ru": "Благотворительная организация предоставляет еду и <w>кров</w> людям, потерявшим свои дома во время наводнения."
                            }
                        },
                        {
                            "text": "Human beings require food, water, and <w>shelter</w> to survive in any environment.",
                            "target_lang_translations": {
                                "ru": "Человеку необходимы еда, вода и <w>жильё</w>, чтобы выжить в любой среде."
                            }
                        }
                    ],
                    "synonyms": [
                        "home",
                        "housing"
                    ],
                    "common_phrases": [
                        "provide shelter",
                        "seek shelter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Базовая человеческая потребность в месте для жизни или пребывания, обеспечивающем защиту от непогоды"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кров",
                                "target_lang_sense_clarification": "крыша над головой"
                            },
                            {
                                "target_lang_word": "приют",
                                "target_lang_sense_clarification": "место, где можно поселиться"
                            },
                            {
                                "target_lang_word": "жильё",
                                "target_lang_sense_clarification": "место проживания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad57982f-8a4c-34e7-b5b9-745f4b0b3aa0",
                    "sense_definition": "A physical place or structure that protects people or animals from rain, wind, or danger",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We built a temporary <w>shelter</w> using branches and leaves to stay dry during the night.",
                            "target_lang_translations": {
                                "ru": "Мы построили временное <w>укрытие</w> из веток и листьев, чтобы не промокнуть ночью."
                            }
                        },
                        {
                            "text": "The hikers found a rock <w>shelter</w> where they could wait for the storm to pass.",
                            "target_lang_translations": {
                                "ru": "Пешие туристы нашли скальный <w>навес</w>, где они смогли переждать бурю."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rock shelter",
                        "temporary shelter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое место или сооружение, защищающее людей или животных от дождя, ветра или опасности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укрытие",
                                "target_lang_sense_clarification": "защитное место"
                            },
                            {
                                "target_lang_word": "убежище",
                                "target_lang_sense_clarification": "безопасное место"
                            },
                            {
                                "target_lang_word": "навес",
                                "target_lang_sense_clarification": "открытое сооружение для защиты от дождя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ab21062-cdab-3fc5-90e5-685ce87c9eff",
                    "sense_definition": "An institution or building that provides temporary housing for people in need, such as the homeless",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the cold winter night at a local homeless <w>shelter</w> downtown.",
                            "target_lang_translations": {
                                "ru": "Он провел холодную зимнюю ночь в местном <w>приюте</w> для бездомных в центре города."
                            }
                        },
                        {
                            "text": "The city is opening a new women's <w>shelter</w> to help those escaping domestic violence.",
                            "target_lang_translations": {
                                "ru": "Город открывает новый <w>кризисный центр</w> для женщин, чтобы помочь тем, кто спасается от домашнего насилия."
                            }
                        }
                    ],
                    "common_phrases": [
                        "homeless shelter",
                        "women's shelter",
                        "emergency shelter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Учреждение или здание, предоставляющее временное жилье нуждающимся, например, бездомным"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приют",
                                "target_lang_sense_clarification": "социальное учреждение"
                            },
                            {
                                "target_lang_word": "ночлежка",
                                "target_lang_sense_clarification": "место для ночлега бездомных"
                            },
                            {
                                "target_lang_word": "шелтер",
                                "target_lang_sense_clarification": "современный термин для кризисного центра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee7bff6b-4ed2-3ed8-ab5c-fc804e505106",
                    "sense_definition": "A place where lost, abandoned, or stray animals are cared for",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to adopt a puppy from the local animal <w>shelter</w> instead of buying one.",
                            "target_lang_translations": {
                                "ru": "Мы решили взять щенка из местного <w>приюта</w> для животных, а не покупать его."
                            }
                        },
                        {
                            "text": "The <w>shelter</w> is currently full and cannot take in any more cats this week.",
                            "target_lang_translations": {
                                "ru": "Этот <w>приют</w> сейчас переполнен и не может принять больше кошек на этой неделе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "animal shelter",
                        "dog shelter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, где заботятся о потерянных, брошенных или бродячих животных"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приют",
                                "target_lang_sense_clarification": "для животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3fa65fb-ce98-367c-82e1-cfcb7fce4b8c",
                    "sense_definition": "A small, open structure designed to provide cover for people waiting for transport",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I stood inside the bus <w>shelter</w> to stay out of the pouring rain while waiting for the number ten.",
                            "target_lang_translations": {
                                "ru": "Я стоял под <w>навесом</w> остановки, чтобы спрятаться от проливного дождя в ожидании десятого автобуса."
                            }
                        },
                        {
                            "text": "The vandals broke the glass panels of the waiting <w>shelter</w> at the train station.",
                            "target_lang_translations": {
                                "ru": "Вандалы разбили стеклянные панели <w>павильона</w> ожидания на железнодорожной станции."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bus shelter",
                        "waiting shelter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое открытое сооружение, предназначенное для защиты людей, ожидающих транспорт"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остановка",
                                "target_lang_sense_clarification": "крытый павильон"
                            },
                            {
                                "target_lang_word": "навес",
                                "target_lang_sense_clarification": "защитная конструкция"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "594a2550-7a3b-3885-a307-c5a3ab58d02f",
                    "sense_definition": "A reinforced, often underground structure for protection against bombs, storms, or other disasters",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family ran to the tornado <w>shelter</w> as soon as the sirens began to wail.",
                            "target_lang_translations": {
                                "ru": "Семья побежала в <w>убежище</w> от торнадо, как только завыли сирены."
                            }
                        },
                        {
                            "text": "During the war, many citizens spent their nights in an air-raid <w>shelter</w>.",
                            "target_lang_translations": {
                                "ru": "Во время войны многие горожане проводили ночи в <w>бомбоубежище</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "air-raid shelter",
                        "tornado shelter",
                        "fallout shelter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Укрепленное, часто подземное сооружение для защиты от бомб, штормов или других бедствий"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убежище",
                                "target_lang_sense_clarification": "защитное сооружение"
                            },
                            {
                                "target_lang_word": "бомбоубежище",
                                "target_lang_sense_clarification": "защита от авиаударов"
                            },
                            {
                                "target_lang_word": "бункер",
                                "target_lang_sense_clarification": "укрепленное подземное помещение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fef8802f-fca5-31e7-8b3c-e497b68fba78",
                    "sense_definition": "The state or condition of being protected from danger or bad weather",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trees offered some <w>shelter</w> from the scorching sun during our afternoon walk.",
                            "target_lang_translations": {
                                "ru": "Деревья давали некоторую <w>защиту</w> от палящего солнца во время нашей дневной прогулки."
                            }
                        },
                        {
                            "text": "They stood in the <w>shelter</w> of the doorway to avoid being seen by the guards.",
                            "target_lang_translations": {
                                "ru": "Они стояли в <w>укрытии</w> дверного проема, чтобы их не заметила охрана."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the shelter of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или условие защищенности от опасности или плохой погоды"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "защита",
                                "target_lang_sense_clarification": "состояние безопасности"
                            },
                            {
                                "target_lang_word": "укрытие",
                                "target_lang_sense_clarification": "нахождение в безопасном месте"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4e2e251b-80a2-3e05-92fd-9d00cb74163e",
                    "sense_definition": "To go into or stay in a place that provides protection from bad weather or danger",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "protecting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to <w>shelter</w> under a large oak tree when the sudden thunderstorm began.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось <w>укрыться</w> под большим дубом, когда началась внезапная гроза."
                            }
                        },
                        {
                            "text": "The sheep <w>sheltered</w> against the stone wall to escape the biting wind.",
                            "target_lang_translations": {
                                "ru": "Овцы <w>сгрудились</w> у каменной стены, спасаясь от пронизывающего ветра."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shelter from the rain",
                        "shelter under"
                    ],
                    "target_lang_definitions": {
                        "ru": "Укрыться или оставаться в месте, которое обеспечивает защиту от плохой погоды или опасности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укрыться",
                                "target_lang_sense_clarification": "спрятаться от непогоды"
                            },
                            {
                                "target_lang_word": "укрываться",
                                "target_lang_sense_clarification": "находиться в укрытии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56ff8699-c9af-3642-8c0a-d5c68255cd11",
                    "sense_definition": "To protect someone or something by providing a place to stay or by hiding them",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protecting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organization works to <w>shelter</w> refugees who are fleeing from the conflict in their home country.",
                            "target_lang_translations": {
                                "ru": "Организация работает над тем, чтобы <w>приютить</w> беженцев, спасающихся от конфликта в своей родной стране."
                            }
                        },
                        {
                            "text": "Parents often try to <w>shelter</w> their children from the harsh realities of the world.",
                            "target_lang_translations": {
                                "ru": "Родители часто стараются <w>оберегать</w> своих детей от суровых реалий мира."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "shelter someone from"
                    ],
                    "target_lang_definitions": {
                        "ru": "Защищать кого-либо или что-либо, предоставляя место для проживания или скрывая их"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приютить",
                                "target_lang_sense_clarification": "дать кров"
                            },
                            {
                                "target_lang_word": "укрывать",
                                "target_lang_sense_clarification": "прятать или защищать"
                            },
                            {
                                "target_lang_word": "оберегать",
                                "target_lang_sense_clarification": "защищать от трудностей"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}