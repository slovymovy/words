                "senses": [
                    {
                        "sense_id": "c987829a-bc48-3f9a-99bd-165e9e70789f",
                        "entry_id": "af142e14-fa2d-3a55-bd76-b1d019c8f56f",
                        "glosses": [
                            "een Spaanse versterkte wijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52b83088-d6a4-43b3-bcef-f53bee0c33a5",
                                "sense_id": "c987829a-bc48-3f9a-99bd-165e9e70789f",
                                "text": "In een begeleidend citaat vertelt Muskee dat ze dixieland speelden op VVD-feestjes voor mensen met een clubsjaal en glazen sherry in de hand - niet leuk, een beetje oubollig. Hij stapte spoedig over naar The Rocking Strings, dat Shadows-achtige rock & roll speelde, compleet met pakjes en pasjes. Ze hadden een heel talentvolle gitarist, Muskees vriend Eelco Gelling."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99e1da14-e20a-443a-9391-a05023419ee2",
                        "source_entry_id": "af142e14-fa2d-3a55-bd76-b1d019c8f56f",
                        "source_sense_id": "c987829a-bc48-3f9a-99bd-165e9e70789f",
                        "source_sense_description": "een Spaanse versterkte wijn",
                        "target_lang_word": "Sherry",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sherry",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33b137b7-43d7-3a62-867f-50a73837f004",
                                        "entry_id": "09267a8a-1d2f-3b2a-914b-bdb258e0bdc1",
                                        "glosses": [
                                            "gelblicher Likörwein aus Spanien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ebc3bcb-5d2e-4736-b87c-b095a3220e74",
                                                "sense_id": "33b137b7-43d7-3a62-867f-50a73837f004",
                                                "text": "„Er gehört zu den Lieblingsgetränken der Spanier, Holländer und Deutschen, die Engländer lieben ihn als Aperitif, aber auch Amerikaner und Japaner sind sich einig, dass ein guter Sherry zu den Genüssen dieser Welt gehört.“"
                                            },
                                            {
                                                "example_id": "89e94834-133b-4ad3-8dd9-fb28107af577",
                                                "sense_id": "33b137b7-43d7-3a62-867f-50a73837f004",
                                                "text": "„Der Kellner brachte einen Sherry für Peystre und ein Kännchen Kaffee für Lillian.“"
                                            },
                                            {
                                                "example_id": "f684061c-0ceb-44b1-9e4b-7e1d528a341e",
                                                "sense_id": "33b137b7-43d7-3a62-867f-50a73837f004",
                                                "text": "„Florin öffnete eine Flasche Sherry, die er am Morgen vom Keller heraufgebracht hatte und schenkte zuerst Nina, dann Mrs. Florin, dann dem Oberst, dann Adam und schließlich sich selbst ein Glas ein.“"
                                            },
                                            {
                                                "example_id": "d63150da-a3b8-487d-b912-b8726b850405",
                                                "sense_id": "33b137b7-43d7-3a62-867f-50a73837f004",
                                                "text": "„Wir sollten beschreiben, wie sie, eigentlich aus Versehen, ein Glas Sherry leerte, das Ólafur ihr gereicht hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e03a718c-33de-4f30-a4ad-34edca5c4ec6",
                        "source_entry_id": "af142e14-fa2d-3a55-bd76-b1d019c8f56f",
                        "source_sense_id": "c987829a-bc48-3f9a-99bd-165e9e70789f",
