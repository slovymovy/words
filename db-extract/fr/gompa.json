                        "tags": [],
                        "examples": [
                            {
                                "example_id": "968ada98-f826-4487-8ee8-f2364a34f894",
                                "sense_id": "c9053737-bf51-35e6-bc36-673e38eae604",
                                "text": "Ils ont sanctifié une partie du gompa pour en faire une chapelle à leur Dieu trine."
                            },
                            {
                                "example_id": "5e302212-690e-4d81-9f04-baa72a4c0fd8",
                                "sense_id": "c9053737-bf51-35e6-bc36-673e38eae604",
                                "text": "Elle visite les gompas, monastères tibétains, seule ou accompagnée. Lorsque le prince l’escorte, c’est tout un cérémonial d’apparat, de prosternations et de rituels qu’Alexandra observe de tous ses yeux, sans se départir de son ironie quand le moment s’y prête."
                            }
