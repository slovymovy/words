                ],
                "senses": [
                    {
                        "sense_id": "50ec146c-4def-3d27-907f-4436a07fa894",
                        "entry_id": "e2eb0e68-6652-3ee8-8206-5b698176d1c3",
                        "glosses": [
                            "een type wapen dat gebruikmaakt van de energie die is opgeslagen in de kernen van atomen om een ontploffing te veroorzaken."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2019756-abda-46ad-ae0f-d2f988e08294",
                                "sense_id": "50ec146c-4def-3d27-907f-4436a07fa894",
                                "text": "Er zijn twee typen kernwapens n.l. die gebaseerd zijn op kernsplitsing en die gebaseerd zijn op kernfusie."
                            },
                            {
                                "example_id": "341da571-62c2-413a-a86a-af7776d5d3c5",
                                "sense_id": "50ec146c-4def-3d27-907f-4436a07fa894",
                                "text": "Ooit twijfelde president Charles de Gaulle al aan de Amerikaanse garantie. Zijn land kon, vond hij, beter zelf kernwapens maken."
                            },
                            {
                                "example_id": "a2d1772b-629d-4c4f-aade-8d892c5423d1",
                                "sense_id": "50ec146c-4def-3d27-907f-4436a07fa894",
                                "text": "De met kernwapens uitgeruste Tupolev 16 van de Sovjet-Unie zou een spitsroedeloop met achthonderd jachtvliegtuigen niet overleven wanneer ze Zweden probeerden aan te vallen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "156d93e5-1d3c-4aac-af07-0510a49dd305",
                        "source_entry_id": "e2eb0e68-6652-3ee8-8206-5b698176d1c3",
                        "source_sense_id": "50ec146c-4def-3d27-907f-4436a07fa894",
                        "target_lang_word": "Kernwaffe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kernwaffe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b13f6fb-2470-3281-b574-a0ecf4cd14c1",
                                        "entry_id": "725dd75d-c481-3f86-a034-92e34d685f56",
                                        "glosses": [
                                            "Waffe, die ihre Explosionsenergie aus kernphysikalischen Prozessen (Kernfusion oder -spaltung) gewinnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "893544d9-fe6f-4d54-9aa4-737edd3922b0",
                                                "sense_id": "3b13f6fb-2470-3281-b574-a0ecf4cd14c1",
                                                "text": "\"In der Regel besteht sie aus einem normalen Sprengsatz, der bei seiner Explosion radioaktives Material verteilt. Da dabei jedoch keine Kernspaltung oder Kernfusion stattfindet, kann eine „schmutzige Bombe“ nicht als Kernwaffe bezeichnet werden.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f561302a-45c1-4383-a94b-c458532f45f6",
                        "source_entry_id": "e2eb0e68-6652-3ee8-8206-5b698176d1c3",
                        "source_sense_id": "50ec146c-4def-3d27-907f-4436a07fa894",
                        "target_lang_word": "nuclear weapon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nuclear weapon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46dd75c2-1bd3-3e8e-8ae9-829ed08eb2fc",
                                        "entry_id": "c7346d8b-c334-3eb1-bd8c-2e6e4fef5f4a",
                                        "glosses": [
                                            "A weapon that derives its energy from the nuclear reactions of either fission or fusion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9960c63f-c894-41dc-8be2-291e8b099986",
                                                "sense_id": "46dd75c2-1bd3-3e8e-8ae9-829ed08eb2fc",
                                                "text": "When Kissinger went to Moscow on March 24 for four days of talks aimed at setting the agenda for Summit III, he reported that Brezhnev seemed to be confronting some of the same problems as we were of military opposition to a permanent agreement to limit offensive nuclear weapons. Thus we knew from the outset that it would be very difficult to produce a major SALT breakthrough at Summit III."
                                            },
                                            {
                                                "example_id": "5870d788-9af9-4684-9393-e0df62c8d722",
                                                "sense_id": "46dd75c2-1bd3-3e8e-8ae9-829ed08eb2fc",
                                                "text": "Even if they managed to strike Japan, the United States or South Korea with nuclear weapons — a big if, given that they do not have a reliable delivery system — they could not save themselves from ultimate defeat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0159ff2b-39b4-4a9a-b3d9-e396309c9239",
                        "source_entry_id": "e2eb0e68-6652-3ee8-8206-5b698176d1c3",
                        "source_sense_id": "50ec146c-4def-3d27-907f-4436a07fa894",
                        "target_lang_word": "arme nucléaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arme nucléaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ae162297-b0d7-3c0f-9b5a-1be1060297fe",
                                        "entry_id": "a30e4aaa-419a-327c-b174-bc779bc0c726",
                                        "glosses": [
                                            "Arme de destruction massive utilisant l’énergie nucléaire, produite soit par fission ou par fusion."
                                        ],
                                        "tags": [
                                            "Nucléaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87217981-253b-40fa-9d88-56391e959138",
                                                "sense_id": "ae162297-b0d7-3c0f-9b5a-1be1060297fe",
                                                "text": "Les principaux problèmes auxquels il faudra faire face dans vingt ans sont clairement posés : la Corée du Nord et l’Iran auront-ils à cette date une arme nucléaire qui puisse être vectorisée ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9851e881-ddaa-46d0-98df-1468ff243a96",
                        "source_entry_id": "e2eb0e68-6652-3ee8-8206-5b698176d1c3",
