                "senses": [
                    {
                        "sense_id": "73e28b56-0028-3fb5-b3a1-9fce5d574c6f",
                        "entry_id": "d78523e7-53f6-33c2-a656-1eda8c3585bb",
                        "glosses": [
                            "moralisch freizügiger Lebensstil"
                        ],
                        "tags": [
                            "bildungsspr."
                        ],
                        "examples": [
                            {
                                "example_id": "a040a750-1bdb-420a-bcee-115469e4379c",
                                "sense_id": "73e28b56-0028-3fb5-b3a1-9fce5d574c6f",
                                "text": "Oftmals geht Libertinage mit Egoismus einher."
                            },
                            {
                                "example_id": "534c77f1-1fd2-4608-9962-7919818ff398",
                                "sense_id": "73e28b56-0028-3fb5-b3a1-9fce5d574c6f",
                                "text": "„Doch mit ihrer Beschneidung, deren Zeitpunkt die Familie festlegt, endet die Libertinage der Mädchen.“"
                            },
                            {
                                "example_id": "2c792cf1-5866-4adc-9d0e-c55d179cf53f",
                                "sense_id": "73e28b56-0028-3fb5-b3a1-9fce5d574c6f",
                                "text": "„Politik ließ sich, so fanden sie, mit Libertinage und Freigeisterei nicht machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
