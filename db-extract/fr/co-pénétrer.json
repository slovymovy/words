                        "glosses": [
                            "Se pénétrer mutuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7e8b060-bdfd-4e1c-adc9-9975e5724229",
                                "sense_id": "e3acdd07-6e1b-3a14-ba69-c041fc66a130",
                                "text": "Car aujourd’hui ne voyons nous pas constamment l’histoire des colonies et celle des métropoles se co-pénétrer à tel point qu’elles en arrivent à se confondre en une vie sociale unique."
                            },
                            {
                                "example_id": "776905a0-947c-48dc-b05e-9c461719846f",
                                "sense_id": "e3acdd07-6e1b-3a14-ba69-c041fc66a130",
                                "text": "Il semblerait qu’on ne puisse plus rien dire sur cette question ; et cependant, dans l’intérêt de nos convictions, nous devons à nous-même de le rappeler en toute circonstance ; nous devons nous en co-pénétrer afin de rester fidèle à notre belle tradition, afin de travailler efficacement à la grandeur et à la prospérité de l’Ordre."
                            }
                        ]
                    }
