                "senses": [
                    {
                        "sense_id": "14ae8db4-0b58-3521-b295-fa4728241c94",
                        "entry_id": "3ac88dea-0f7e-3221-abd7-7f733e13e90a",
                        "glosses": [
                            "Peupler en dessous de ce qui serait possible (ou de ce qui serait souhaitable)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e70ddb8-faee-419c-9287-e60cbdf3f3eb",
                                "sense_id": "14ae8db4-0b58-3521-b295-fa4728241c94",
                                "text": "Et y'a toujours la solution de sous-peupler légèrement."
                            },
                            {
                                "example_id": "00084b9e-3259-4040-b452-a2f26e7e29a4",
                                "sense_id": "14ae8db4-0b58-3521-b295-fa4728241c94",
                                "text": "Sous-peupler un bac est bien souvent la raison du succès."
                            },
                            {
                                "example_id": "275cfee2-623e-4439-af0a-90cea4746fdf",
                                "sense_id": "14ae8db4-0b58-3521-b295-fa4728241c94",
                                "text": "Vouloir sous-peupler davantage le continent africain est une erreur stratégique, au contraire il faut encourager la natalité mais en instaurant une politique éducative dans les familles pour une meilleure insertion des sociétés africaines dans le monde moderne."
                            }
                        ]
                    }
