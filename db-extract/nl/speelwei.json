                "senses": [
                    {
                        "sense_id": "066729fa-82d2-3a0e-a84d-5a3aca0a869f",
                        "entry_id": "de88f229-f8c5-3323-aa51-05c17a8d1922",
                        "glosses": [
                            "grasveld waarop men kan spelen of sporten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bef8da8-532f-4a3e-91cd-61c2b93a7d3d",
                                "sense_id": "066729fa-82d2-3a0e-a84d-5a3aca0a869f",
                                "text": "Toch weet de organisatie ook de jeugd te bereiken. Met de speelwei en het dierenparkje bijvoorbeeld. Vooral het doolhof is populair. Ook bij ouders trouwens. Her en der speuren kinderen met een flink stuk karton in hun handen naar antwoorden op vragen in de ”Bollenbozen Kwis”."
                            },
                            {
                                "example_id": "9a1c649e-bf78-433c-995e-ca8afe4a1ef2",
                                "sense_id": "066729fa-82d2-3a0e-a84d-5a3aca0a869f",
                                "text": "Naast mijn tuin is een speelwei van de Chiro en het lawaai van de spelende kinderen heeft de beestjes misschien afgeschrikt. Ook het stijgende aantal katten in de buurt maakt het voor hen minder aantrekkelijk om hier te landen."
                            },
                            {
                                "example_id": "999447e0-cd44-4680-b723-b725c215408d",
                                "sense_id": "066729fa-82d2-3a0e-a84d-5a3aca0a869f",
                                "text": "Deze plas heeft zowel voor natuur- als watersportliefhebbers veel te bieden. Er zijn diverse strandjes, speelweiden en kanoroutes. Het is een populair gebied en op steenworp afstand van Utrecht en Amsterdam."
                            }
                        ]
                    }
