            {
                "entry_id": "a42b070d-ed0a-302a-bb17-8aee784b846b",
                "word": "Berrichon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "caef0c1a-010a-4d87-8f4f-4b5c72e48e1f",
                        "entry_id": "a42b070d-ed0a-302a-bb17-8aee784b846b",
                        "tags": [
