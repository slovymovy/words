                    },
                    {
                        "translation_id": "ba8e1c6c-eb13-466c-950c-a2527f6a025c",
                        "source_entry_id": "a3c037fa-125e-304b-b81b-ec5f7d306d1b",
                        "source_sense_id": "8bed3c06-3e66-38b8-9a87-0361054b19a7",
                        "target_lang_word": "Phenobarbital",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Phenobarbital",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "693665a6-6797-3a1c-9290-6c9aed84edd2",
                                        "entry_id": "56a5ae12-26cb-33d8-97fe-c2a61d419e33",
                                        "glosses": [
                                            "Arzneistoff aus der Gruppe der Barbiturate, der zur Epilepsiebehandlung und Narkosevorbereitung eingesetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a25d21c-07f3-4d67-8a91-75ed704c040b",
                                                "sense_id": "693665a6-6797-3a1c-9290-6c9aed84edd2",
                                                "text": "„Sobald wir das Krankenhaus erreichten, packten sie mich in Eis und gaben mir intravenös massive Dosen von Phenobarbital, um die Anfälle in den Griff zu bekommen.“"
                                            },
                                            {
                                                "example_id": "43418e46-ca41-4134-85b3-7d28d0d25510",
                                                "sense_id": "693665a6-6797-3a1c-9290-6c9aed84edd2",
                                                "text": "„›Gehen Sie in ein Luxushotel in Portland‹, sage ich, ›bestellen sie eine Massage und lassen sich vom Zimmerservice eine Überdosis Phenobarbital bringen. So einfach ist das. Betrachten Sie es als Vergnügungsreise ...‹“"
                                            },
                                            {
                                                "example_id": "741a91a8-1ed3-4bc1-9780-3a5cd6504ce0",
                                                "sense_id": "693665a6-6797-3a1c-9290-6c9aed84edd2",
                                                "text": "„Um 22:43 schlief er tief und fest, nachdem er ungefähr 320 Milligramm Phenobarbital zu sich genommen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
