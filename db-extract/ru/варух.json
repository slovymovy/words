                                        "glosses": [
                                            "postać biblijna"
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98931980-815c-4183-a83f-02f205bbd042",
                                                "sense_id": "bc6ef581-8dbd-3eef-bbd5-382774306403",
                                                "text": "Wydaje się, że Jeremiasz, trzymany samotnie w więzieniu, wykorzystał wizytę Barucha, by powierzyć mu dokumenty prawne."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "eb849eb7-4c69-3188-92c3-f16819c6c2d4",
                                        "entry_id": "1b2a016a-4bc6-3c00-9d41-1d9e134780fb",
                                        "glosses": [
                                            "imię męskie"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b506c4de-d690-49e4-9f6f-c30a9a1b1b0e",
                                                "sense_id": "eb849eb7-4c69-3188-92c3-f16819c6c2d4",
                                                "text": "Baruch urodził się w Polsce, ale teraz mieszka w Izraelu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
