                                    },
                                    {
                                        "sense_id": "3c33aa0f-97c8-3db7-8bb9-b3d94e72d4c8",
                                        "entry_id": "a06c584d-82f0-3f23-b177-eaa1714a039f",
                                        "glosses": [
                                            "wenigzelliges Verbindungsgewebe zwischen Suspensor und Embryo, im reifen Samen ist sie meist nicht mehr zu erkennen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e39a5c7-243d-4e46-9bf4-14f12dd0f968",
                                                "sense_id": "3c33aa0f-97c8-3db7-8bb9-b3d94e72d4c8",
                                                "text": "„Gleichzeitig differenziert sich an der Anheftungsstelle des Embryos am Suspensor eine Zelle, die sogenannte Hypophyse, deren Abkömmlinge sich am Aufbau der Wurzel und der Wurzelhaube beteiligen.“"
                                            }
