                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "874d34f0-ca82-4e0e-9011-767956f72397",
                                "sense_id": "804efe8a-e757-3c88-b20d-60180df41c27",
                                "text": "Zielona rewolucja, z którą wiązało się m.in. wprowadzenie do krajów Trzeciego Świata wysokoplennych odmian roślin, prócz poprawy bytu tysięcy ludzi, miała także swoje negatywne następstwo — niszczenie gleb przez nadużywanie nawozów sztucznych i pestycydów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
