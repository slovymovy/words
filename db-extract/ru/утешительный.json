                                        "entry_id": "c7469354-0b45-3e68-a050-cbdf96318b41",
                                        "glosses": [
                                            "Qui console ; qui est propre à consoler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31da8907-70e7-4c3b-a894-ba6a8affe11d",
                                                "sense_id": "6943a690-20cf-3a1c-a13a-0098fb9347aa",
                                                "text": "La pauvre femme aimait d’ailleurs ces muets témoins de son bonheur qui, pour elle, avaient une éloquence quasi-consolante."
                                            },
                                            {
                                                "example_id": "37326933-091a-45d3-9b32-553b85c1310f",
                                                "sense_id": "6943a690-20cf-3a1c-a13a-0098fb9347aa",
                                                "text": "Puis l’oubli fit lentement son œuvre consolante."
                                            },
                                            {
                                                "example_id": "f4473a9e-8d37-4f74-9654-7d79d9b42d9b",
                                                "sense_id": "6943a690-20cf-3a1c-a13a-0098fb9347aa",
                                                "text": "Cette crypte reproduirait donc les passages les plus consolants et les plus héroïques du Saint-Livre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "consolant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84d238ca-5a8b-3f78-946e-ea21b3c086c3",
                                        "entry_id": "f4dc2f39-8f2e-3938-ba05-37a6bfc9c516",
                                        "glosses": [
                                            "Participe présent de consoler."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3211b121-57c4-4c84-8c5e-4d8891bd819c",
                                                "sense_id": "84d238ca-5a8b-3f78-946e-ea21b3c086c3",
                                                "text": "Oh ! jeune homme, est-ce donc la providence divine qui m’a fait désirer de secouer par un peu d’exercice à pied le sommeil dont sont saisis au matin tous les voyageurs, afin que je pusse, en vous consolant, obéir à ma mission ici-bas ?…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
