                                "target_senses": [
                                    {
                                        "sense_id": "feba72cb-ed4c-32ca-a7cc-25e98fd3e49c",
                                        "entry_id": "40381ed0-531e-3aa4-8b2f-8187aea093a5",
                                        "glosses": [
                                            "A specimen of the now extinct species Homo neanderthalensis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47eb0a40-fcf3-4549-8b07-fa7ca837409c",
                                                "sense_id": "feba72cb-ed4c-32ca-a7cc-25e98fd3e49c",
                                                "text": "These injuries may reflect the rigors of hunting with the Neanderthals' limited repertoire of weapons; the Neanderthals never seem to have developed projectiles, so they would have to have gotten more or less on top of their prey in order to kill them."
                                            }
                                        ]
                                    },
