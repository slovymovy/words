                    {
                        "sense_id": "0bdb086c-f7e6-3471-93bb-c8b16822c118",
                        "entry_id": "9ecc593b-791f-339a-965a-63e32c184f1d",
                        "glosses": [
                            "устар. с высоты, сверху"
