                        "entry_id": "1a0a1dea-314d-3061-8b55-401cf1fd1bce",
                        "glosses": [
                            "разг. употребляется как почтительно-фамильярное обращение к пожилой женщине"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ed109a77-eafe-3234-b9b7-00ef5efdd211",
                        "entry_id": "1a0a1dea-314d-3061-8b55-401cf1fd1bce",
                        "glosses": [
                            "уменьш.-ласк. к матка"
                        ],
                        "tags": [],
                        "examples": [
                            {
