                "senses": [
                    {
                        "sense_id": "ae010add-8e47-34c3-be03-a345384851f4",
                        "entry_id": "d5d6ea37-9ed2-3dcc-a5a7-0c746035c13a",
                        "glosses": [
                            "D'une manière optimale ; à son optimum."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "6a5f394c-c054-4287-bd58-defb38bd2743",
                                "sense_id": "ae010add-8e47-34c3-be03-a345384851f4",
                                "text": "Ce n'est pas parce qu'une matière a telle ou telle disposition qu'elle est unie à telle forme ; c'est l'inverse qui est vrai : pour que la forme soit telle, il importe que la matière soit optimalement disposée."
                            },
                            {
                                "example_id": "939908c3-bf22-4476-874a-e1d8ebfe8f6e",
                                "sense_id": "ae010add-8e47-34c3-be03-a345384851f4",
                                "text": "Une population est optimalement adaptée si, dans un contexte environnemental donné et constant, la fréquence la plus avantageuse du génotype le plus avantageux est stable et que la population se perpétue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6b9cfb6-5a8e-43b6-8039-03172f70b319",
                        "source_entry_id": "d5d6ea37-9ed2-3dcc-a5a7-0c746035c13a",
