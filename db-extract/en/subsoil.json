                    },
                    {
                        "translation_id": "359dbb21-a1d4-480e-aaef-259ffdda3651",
                        "source_entry_id": "f3bc623b-5306-36cb-87f5-f3b6b2184a45",
                        "source_sense_id": "c86ad629-0ca1-31c2-99ba-bd9d758e5a80",
                        "source_sense_description": "layer of earth below topsoil",
                        "target_lang_word": "матери́к",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "матери́к",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1148cea2-2a77-31cf-9b3b-3a44f3044e61",
                                        "entry_id": "4e3dffba-cbf2-3741-a967-b410c77fb2a4",
                                        "glosses": [
                                            "очень большой массив суши планеты, окруженный океанами"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "269525d4-e8ce-328d-8727-2a75043eb00f",
                                        "entry_id": "4e3dffba-cbf2-3741-a967-b410c77fb2a4",
                                        "glosses": [
                                            "суша — в противоположность морю"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76997430-d027-49a9-9c64-a7ee169ae0b6",
                                                "sense_id": "269525d4-e8ce-328d-8727-2a75043eb00f",
                                                "text": "По этой причине и дуют муссоны; зимой — с суши на море, а летом с моря на материк."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a670545-f8e7-3780-bba1-bbad3d9674f8",
                                        "entry_id": "4e3dffba-cbf2-3741-a967-b410c77fb2a4",
                                        "glosses": [
                                            "разг. континентальная часть государства по отношению к островным, полуостровным или отдалённым его регионам"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5af08509-a9bd-4527-8d38-c66ef301e4a7",
                                                "sense_id": "3a670545-f8e7-3780-bba1-bbad3d9674f8",
                                                "text": "Поделки из кремня, которого нет на Сахалине, они получали, очевидно, от соседей, с материка и ближайших островов;"
                                            },
                                            {
                                                "example_id": "600f7fd0-6465-4f30-863c-0f0b466f39ca",
                                                "sense_id": "3a670545-f8e7-3780-bba1-bbad3d9674f8",
                                                "text": "Лампы, пылающие в полночь, безумеющая бессонница штабов, Республика, кричащая в аппараты, гул стотысячных орд в степи; это развёрнутый, но не обрушенный ещё удар по скале, по последним армиям противника, сброшенного с материка на полуостров."
                                            },
                                            {
                                                "example_id": "8d2b98b3-2f2e-4572-8464-a016be57330d",
                                                "sense_id": "3a670545-f8e7-3780-bba1-bbad3d9674f8",
                                                "text": "Письма с материка и на материк шли по полгода, если вообще шли."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dccf83f9-51ab-3e2b-8c68-6f1ccc3c9548",
                                        "entry_id": "4e3dffba-cbf2-3741-a967-b410c77fb2a4",
                                        "glosses": [
                                            "континентальная часть Европы по отношению к Британским островам (Великобритании)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3296a9f-8dbc-48a2-8490-1ac3981e4b06",
                                                "sense_id": "dccf83f9-51ab-3e2b-8c68-6f1ccc3c9548",
                                                "text": "С конца XVIII века и в начале нашего на материк Европы вторглись ложно понятые тогда англо-саксонские конституционные идеи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9905126d-a0e6-355f-be04-63c922eb9835",
                                        "entry_id": "4e3dffba-cbf2-3741-a967-b410c77fb2a4",
                                        "glosses": [
                                            "устар. или рег. (сев.-русск., сибирск.) высокий берег какого-либо водоёма; незаливной берег с ненаносной почвой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ddfcdf9-a8c6-41e9-8692-82ed1eea64f2",
                                                "sense_id": "9905126d-a0e6-355f-be04-63c922eb9835",
                                                "text": "Погребли на тот материк по смородину."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61463061-4373-39d6-b6e9-d595141fc66f",
                                        "entry_id": "4e3dffba-cbf2-3741-a967-b410c77fb2a4",
                                        "glosses": [
                                            "устар. или рег. (карельск., уральск., сибирск.) возвышенность с твёрдым грунтом в болотистой местности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d146a310-846a-405d-a490-42ed25c92eaf",
                                                "sense_id": "61463061-4373-39d6-b6e9-d595141fc66f",
                                                "text": "Материк на горах, а здесь, скажем, водотопное место."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1965f8e1-2975-34f8-98d6-ba42810c5b98",
                                        "entry_id": "4e3dffba-cbf2-3741-a967-b410c77fb2a4",
                                        "glosses": [
                                            "устар. или рег. (южн.-уральск., моск.) грунт под чем-либо (снегом, водой); земляное основание строения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8240119f-47ce-4852-8e93-f7105e712c93",
                                                "sense_id": "1965f8e1-2975-34f8-98d6-ba42810c5b98",
                                                "text": "Здесь печка на полу, а там на материке."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aec66fc-209b-3415-8da4-89ee3a05af4b",
                                        "entry_id": "4e3dffba-cbf2-3741-a967-b410c77fb2a4",
                                        "glosses": [
                                            "устар. геол. материнская порода, подпочва"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4632b8cc-4328-3c13-82d9-427b7633618c",
                                        "entry_id": "4e3dffba-cbf2-3741-a967-b410c77fb2a4",
                                        "glosses": [
                                            "археол. слой почвы или горных пород непосредственно под культурным слоем, не содержащий следов человеческой деятельности"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb7f8269-6b04-3f28-9bc1-21ef2cd50ad3",
                                        "entry_id": "4e3dffba-cbf2-3741-a967-b410c77fb2a4",
                                        "glosses": [
                                            "устар. или рег. (сибирск., прииссык.) целина, непаханая земля"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6be27f5-05ce-4a40-885e-5f92dbe08478",
                                                "sense_id": "fb7f8269-6b04-3f28-9bc1-21ef2cd50ad3",
                                                "text": "Материк драли. Осьмуху в уповод одерёшь."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
