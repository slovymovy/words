                "senses": [
                    {
                        "sense_id": "b64c08ce-1455-3435-ac4c-f1b1a520d489",
                        "entry_id": "f62041a8-e9b6-3f5c-8611-aaffd9fccbdd",
                        "glosses": [
                            "Appearing to the eye or mind (distinguished from, and often opposed to, real or actual)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c1a7d3a-0676-4e89-9d5e-6bc7ce4b9a63",
                                "sense_id": "b64c08ce-1455-3435-ac4c-f1b1a520d489",
                                "text": "seeming friendship"
                            },
                            {
                                "example_id": "51e06e81-7c8a-49bc-95af-162305a9150f",
                                "sense_id": "b64c08ce-1455-3435-ac4c-f1b1a520d489",
                                "text": "O, good my lord, you have lost a friend / And I dare swear you borrow not that face / Of seeming sorrow—it is sure your own."
                            },
                            {
                                "example_id": "4e56806a-88d6-4f2a-8ab8-c77c6b38e07d",
                                "sense_id": "b64c08ce-1455-3435-ac4c-f1b1a520d489",
                                "text": "I'le hide my anger in a seeming calm,\nAnd what I have to do, consult the while,\nAnd mask my vengeance underneath a smile."
                            },
                            {
                                "example_id": "b9824e2a-f4ae-4e26-952a-2880c19328d3",
                                "sense_id": "b64c08ce-1455-3435-ac4c-f1b1a520d489",
                                "text": "Of all the English philosophers, I most reverence Bacon, that great and hardy genius: he it is who, undaunted by the seeming difficulties that oppose, prompts human curiosity to examine every part of nature;"
                            },
                            {
                                "example_id": "7511cf69-d7b7-4bc8-b042-cf6414bbce94",
                                "sense_id": "b64c08ce-1455-3435-ac4c-f1b1a520d489",
                                "text": "[…] she was overcome like the thirsty one who is drawn toward the seeming water in the desert […]"
                            },
                            {
                                "example_id": "a2e31e3d-fb66-4bd2-9834-759d53883a78",
                                "sense_id": "b64c08ce-1455-3435-ac4c-f1b1a520d489",
                                "text": "[…] though they marched in seeming peace, the hearts of all the army, from the highest to the lowest, were downcast, and with every mile that they went north foreboding of evil grew heavier on them."
                            },
                            {
                                "example_id": "f72f7473-33dd-4bec-aa3c-b87856f6c125",
                                "sense_id": "b64c08ce-1455-3435-ac4c-f1b1a520d489",
                                "text": "All the A.C.V. four-wheel diesel railbuses are now stored in seeming disrepair at Derby Friargate."
                            },
                            {
                                "example_id": "67d7039e-d5ec-41f6-a47c-aedd6266694b",
                                "sense_id": "b64c08ce-1455-3435-ac4c-f1b1a520d489",
                                "text": "Fields (or “camps”) enclosed by chest-high wire fences now contain thousands of ostriches in seeming harmony, sometimes spread out like feathered chess pieces, sometimes seated in clusters."
                            }
                        ]
                    }
                ],
