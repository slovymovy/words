        "fr-extract.jsonl": [
            {
                "entry_id": "7e78b46b-b574-36a9-9d18-7baf8b2c9952",
                "word": "glaciologie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5d31280d-f6e4-4f21-a8a3-ed69af96c213",
                        "entry_id": "7e78b46b-b574-36a9-9d18-7baf8b2c9952",
                        "tags": [
                            "plural"
                        ],
                        "form": "glaciologies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0089114e-318f-3ff0-b117-a954b98a9307",
                        "entry_id": "7e78b46b-b574-36a9-9d18-7baf8b2c9952",
                        "glosses": [
                            "Étude de la glace, des glaciers, de la banquise, des névés et des périodes de glaciation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae3bbd81-9906-41c3-8a1c-1c10277a67a1",
                                "sense_id": "0089114e-318f-3ff0-b117-a954b98a9307",
                                "text": "La glaciologie est née avec Saussure, géographe qui a observé les glaciers alpins à la fin du XVIIIᵉ siècle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c272a2b-446d-4f31-8e6f-cee2ae9c438d",
                        "source_entry_id": "7e78b46b-b574-36a9-9d18-7baf8b2c9952",
                        "source_sense_id": "0089114e-318f-3ff0-b117-a954b98a9307",
                        "target_lang_word": "glaciology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glaciology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64781811-95ff-3596-a512-f074546c9973",
                                        "entry_id": "3e656088-8feb-3711-864d-92373c01f591",
                                        "glosses": [
                                            "The study of ice and its effect on the landscape, especially the study of glaciers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed836e4c-ddaa-4232-ade6-f46edc795fff",
                                                "sense_id": "64781811-95ff-3596-a512-f074546c9973",
                                                "text": "From this high position in latitude, explorations (furthered for a time by the effective aid of their Esquimaux dogs) were perseveringly made, and rewarded by results of the most interesting nature in geography, hydrography, and glaciology."
                                            },
                                            {
                                                "example_id": "fb7c1cac-a63a-4467-b640-923a93c9b52c",
                                                "sense_id": "64781811-95ff-3596-a512-f074546c9973",
                                                "text": "Until now, aerial photography had been used in glaciology only for mapping the glacier surface and the surface velocity field; other, much more expensive, methods have been used to determine the bed and mass balance."
                                            },
                                            {
                                                "example_id": "a5ed974e-bd99-473c-8812-d8b79e6a1b3c",
                                                "sense_id": "64781811-95ff-3596-a512-f074546c9973",
                                                "text": "This general approach offers the possibility of reconstructing past glaciologies for a situation where (1) the outline of the glacier can be reconstructed, (2) the ELA [equilibrium line altitude] can be determined, (3) the area under the ELA can be measured, and (4) there is some information on the winter balance and ablation gradient of the former glacier."
                                            },
                                            {
                                                "example_id": "cc8bb633-417b-460b-88ab-19afe632093d",
                                                "sense_id": "64781811-95ff-3596-a512-f074546c9973",
                                                "text": "In order to understand and predict the actions of water in the climate system it is useful to think of the water as being part of a distinct system, sometimes called the hydrological cycle[…]. A complete understanding of this system would […] require excursions into geomorphology, pedology, botany, glaciology, oceanography and, if human structures are included as part of the Earth's surface, civil engineering."
                                            },
                                            {
                                                "example_id": "49295166-8c5e-470a-a715-3712b814f44f",
                                                "sense_id": "64781811-95ff-3596-a512-f074546c9973",
                                                "text": "I was leafing through deep-core glaciology results from Greenland's mid-rift when the telephone rang. It droned on forever before it finally quit and I could concentrate again. The Greenland data confirmed all the other studies: the earth suffered ninety thousand years of ice-age weather, then ten thousand years of warm, in a loop that repeated over and over, as far back as there was ice to record it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "156874b6-a54d-476f-8524-631e09f3f8ec",
                        "source_entry_id": "7e78b46b-b574-36a9-9d18-7baf8b2c9952",
                        "source_sense_id": "0089114e-318f-3ff0-b117-a954b98a9307",
                        "target_lang_word": "glaciologia",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glaciologia",
