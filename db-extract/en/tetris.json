                        "cross_references": [
                            {
                                "target_word": "Tetris",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a8588ba-b1a2-3a2b-880d-941bc8e79560",
                                        "entry_id": "29b7a730-c916-3422-8443-89275c1922ba",
                                        "glosses": [
                                            "Jeu vidéo de puzzle faisant défiler des blocs de formes diverses et consistant à les empiler pour former des lignes complètes qui disparaissent, alors que celles qui comportent au moins un trou restent."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6969a0b-b5af-436a-83f1-7159832a9ef8",
                                                "sense_id": "1a8588ba-b1a2-3a2b-880d-941bc8e79560",
                                                "text": "Pendant longtemps, le niveau 29 a été considéré comme la limite de Tetris, lorsque le jeu devient si rapide que l’humain n’arrive plus à réagir assez vite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "594111a2-33b9-3516-89a3-8a1f5493081c",
                                        "entry_id": "29b7a730-c916-3422-8443-89275c1922ba",
                                        "glosses": [
                                            "Ensemble de blocs empilés les uns sur les autres."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18fddab5-f9dd-4ce6-993d-46665f29762c",
                                                "sense_id": "594111a2-33b9-3516-89a3-8a1f5493081c",
                                                "text": "Des halls gigantesques sont jonchés d’énormes blocs de Tetris imbriqués, pour isoler la quinzaine de faisceaux de neutrons issus de la cible rotative émettrice. Elle est désormais enserrée dans un épais cocon de béton, pour confiner les rayonnements qui résulteront de son bombardement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
