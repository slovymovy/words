            {
                "entry_id": "207a7302-7bd1-3ccf-ae9d-2265c2b2a7a0",
                "word": "glycine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "643829b7-7ff5-46fd-a7bf-41e4eff4d906",
                        "entry_id": "207a7302-7bd1-3ccf-ae9d-2265c2b2a7a0",
                        "tags": [
                            "plural"
                        ],
                        "form": "glycines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e5014b88-96a8-3555-b392-be0b88faa04e",
                        "entry_id": "207a7302-7bd1-3ccf-ae9d-2265c2b2a7a0",
                        "glosses": [
                            "Acide aminé de formule NH₂-CH₂-COOH, le plus simple de tous les acides aminés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f17d0be1-9a83-4911-b6ba-7ad262fa4348",
                                "sense_id": "e5014b88-96a8-3555-b392-be0b88faa04e",
                                "text": "Des vingt acides aminés que l’on trouve dans les protéines naturelles, seule la glycine n’est pas chirale."
                            },
                            {
                                "example_id": "32fd0220-daff-4e96-97fa-ed880b1bc656",
                                "sense_id": "e5014b88-96a8-3555-b392-be0b88faa04e",
                                "text": "La glycine est aussi un neurotransmetteur inhibiteur mais qui agit plutôt au niveau de la moelle et du tronc cérébral."
                            },
                            {
                                "example_id": "c66363b5-a0cc-4b69-8b47-b8ed035062c3",
                                "sense_id": "e5014b88-96a8-3555-b392-be0b88faa04e",
                                "text": "La glycine, un acide aminé, se contente d’être plutôt sucrée, tandis que l’acide glutamique présent dans les coquillages, le thon et les anchois salé envahit la bouche d'une ribambelle de saveurs."
                            },
                            {
                                "example_id": "44b68172-7c7e-4320-9ad2-2667d684081c",
                                "sense_id": "e5014b88-96a8-3555-b392-be0b88faa04e",
                                "text": "Le trèfle, par exemple, excrète surtout des ions ammonium et de la glycine, promptement réabsorbés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "195f78d6-462f-4bc8-9367-16f21686d090",
                        "source_entry_id": "207a7302-7bd1-3ccf-ae9d-2265c2b2a7a0",
                        "source_sense_id": "e5014b88-96a8-3555-b392-be0b88faa04e",
                        "source_sense_description": "Acide aminé",
                        "target_lang_word": "Glycin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glycin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5bce5aae-d493-304c-8ed3-5792ede9b4de",
                                        "entry_id": "09624e1d-eca9-383d-8d21-26899222d33c",
                                        "glosses": [
                                            "einfachste Aminosäure, Bestandteil von Proteinen"
                                        ],
                                        "tags": [
                                            "organische Chemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98f03d18-b9ad-439d-8121-ac7b97b60da2",
                                                "sense_id": "5bce5aae-d493-304c-8ed3-5792ede9b4de",
                                                "text": "Glycin wird wegen seines süßen Geschmacks als Lebensmittelzusatzstoff eingesetzt."
                                            },
                                            {
                                                "example_id": "e455efb0-5aa6-4382-ba18-21592155eae9",
                                                "sense_id": "5bce5aae-d493-304c-8ed3-5792ede9b4de",
                                                "text": "Das Molekül des Glycins ist als einziges der Aminosäuren achiral."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
