                    "semantic_group_id": "computation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The programmer wrote a <w>recursive</w> function to traverse the complex directory tree."
                        },
                        {
                            "text": "Without a proper base case, a <w>recursive</w> call will cause an infinite loop."
                        }
                    ],
                    "antonyms": [
