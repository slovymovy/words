                ],
                "senses": [
                    {
                        "sense_id": "c9124d84-02f6-35cb-9137-860b2b1942cf",
                        "entry_id": "e1de2617-e548-36f4-b762-0cb584c3f1f0",
                        "glosses": [
                            "Donner un caractère belge (ou plus belge) à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfb41522-e630-4b5b-8859-898f231c55f9",
                                "sense_id": "c9124d84-02f6-35cb-9137-860b2b1942cf",
                                "text": "L’ultime semaine fut d’une tension insoutenable, ma mère essayant par tous les moyens de belgiciser notre demeure et nos dépendances."
                            },
                            {
                                "example_id": "48304150-b21b-40cb-b608-3b5064564d1b",
                                "sense_id": "c9124d84-02f6-35cb-9137-860b2b1942cf",
                                "text": "C'est un geste de générosité qui a inspiré un sympathique patron belge qui a voulu décliner le concept et le \"belgiciser\"."
                            },
                            {
                                "example_id": "ff440576-17a8-4920-9d92-fc448bfc8e08",
                                "sense_id": "c9124d84-02f6-35cb-9137-860b2b1942cf",
                                "text": "J'apprends à la radio, d'un chroniqueur matutinal, que l'Europe risque — à ses yeux — de se belgiciser."
                            }
                        ]
                    }
                ],
