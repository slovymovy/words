                "senses": [
                    {
                        "sense_id": "27abd70a-d518-3438-9d1b-50c1624d7eba",
                        "entry_id": "dafa9f51-ba6d-337f-b8b4-3a56a3ea05fb",
                        "glosses": [
                            "Bezug auf sich selbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6df2f200-971d-4813-93fa-5a8ff0fca658",
                                "sense_id": "27abd70a-d518-3438-9d1b-50c1624d7eba",
                                "text": "„Selbstbezüge laufen über Fremdbezüge und Fremdbezüge über Selbstbezüge: Eine Beobachtung muss sich, um anderes unterscheiden zu können, dabei selbst von diesem Anderen unterscheiden können.“"
                            },
                            {
                                "example_id": "9a5d115e-50f5-489d-9c46-016a04c7bad4",
                                "sense_id": "27abd70a-d518-3438-9d1b-50c1624d7eba",
                                "text": "„Sie [die völkerrechtliche Thesis] hat die Bedeutung, daß die Völker sich zunächst an und für sich in ihrer factischen Besonderheit und Selbstständigkeit setzen, mithin als geschichtliche Elemente mit sich selber anfangen. In diesem reinen Selbstbezuge oder in dieser factischen Absolutheit ist jedes Volk als solches souverän.“ (1842)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
