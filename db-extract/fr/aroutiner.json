                "senses": [
                    {
                        "sense_id": "e929dff1-5334-3a19-abaf-02edc5dca646",
                        "entry_id": "aefebe74-0a35-3db9-9f49-aab8bf36b659",
                        "glosses": [
                            "S'habituer tellement à quelque chose que ça devient routinier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "433ca25c-aa49-4e4f-bb5f-c36bdbcade8e",
                                "sense_id": "e929dff1-5334-3a19-abaf-02edc5dca646",
                                "text": "C’est-il pas un grand malheur, tout comme, d’être aroutiné comme ça dans c’te saloperie de métier !"
                            },
                            {
                                "example_id": "2a0e3863-ef74-42f2-b56c-70f8982e11b7",
                                "sense_id": "e929dff1-5334-3a19-abaf-02edc5dca646",
                                "text": "Ce qui prouve la nécessité pour un fabricant de savoir son métier à fond et d’être en mesure de changer ses méthodes de fabrication selon que la saison avance, au lieu de s’aroutiner et suivre toujours les mêmes règles du printemps à l’automne, comme il y en a tant qui le font."
                            }
                        ]
                    }
