                                        "sense_id": "0fb4070a-fc78-3861-a75d-3ef0b8b63aaa",
                                        "entry_id": "6215e6a2-bbf6-353f-ab4f-6ae2bba1a937",
                                        "glosses": [
                                            "present participle and gerund of scrimp"
                                        ],
                                        "tags": [
                                            "form-of",
