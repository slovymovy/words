                        "glosses": [
                            "Musicien composant ou interprétant des fugues."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b35476b9-f0cf-4a2d-b53e-f7cb02738864",
                                "sense_id": "63410f8b-444a-36cd-a000-c901c7ae2a93",
                                "text": "Un génie heureux et de études profondes avaient fait de Guillaume Friedmann Bach le plus grand organiste, le plus habile fuguiste et le plus savant musicien de l’Allemagne, après son père."
                            },
                            {
                                "example_id": "bd567270-feb1-44a1-9ae4-8a82b2f9bf0d",
                                "sense_id": "63410f8b-444a-36cd-a000-c901c7ae2a93",
                                "text": "Ne croyant pas encore être arrivée au but après ce succès, elle continua à travailler avec une nouvelle ardeur l’œuvre du grand fuguiste allemand qu’elle connaissait déjà, ainsi que les plus grandes compositions de Beethoven, son auteur de prédilection."
                            }
                        ]
                    }
