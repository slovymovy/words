                "senses": [
                    {
                        "sense_id": "ed459a31-9f91-347f-a619-ab02a575b709",
                        "entry_id": "ce9998e3-16e6-3311-9fe7-8f363e439f9d",
                        "glosses": [
                            "unter Mitwirkung von Bakterien erfolgende oxydative Abbau organischer Verbindungen, besonders von Eiweiß, zu einfachen Verbindungen wie Ammoniak, Kohlendioxid, Wasser, Nitraten und Sulfaten"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "1a0a9871-eed8-4200-bd49-75c9cb21ced6",
                                "sense_id": "ed459a31-9f91-347f-a619-ab02a575b709",
                                "text": "Aas beginnt bereits nach kurzer Zeit zu verwesen und geht somit in Verwesung über."
                            },
                            {
                                "example_id": "09c68c0b-dbf3-43c1-8e35-2ec312359796",
                                "sense_id": "ed459a31-9f91-347f-a619-ab02a575b709",
                                "text": "„Der junge Admiral, den man auf diese ungewöhnliche Weise zu konservieren gehofft hatte, um ihn in der väterlichen Familiengruft mit allen Ehren zu bestatten, war in völlige Verwesung übergegangen.“"
                            },
                            {
                                "example_id": "b79f1ab5-c022-4b2a-b1c6-2babb8bc1df2",
                                "sense_id": "ed459a31-9f91-347f-a619-ab02a575b709",
                                "text": "„Diese Metapher riecht nach Verwesung und ist geräuschlos.“"
                            },
                            {
                                "example_id": "64983d2d-5700-4961-81f5-1473d065782f",
                                "sense_id": "ed459a31-9f91-347f-a619-ab02a575b709",
                                "text": "„Im Raum stank es stechend nach Verwesung, nach Maden, und ich sah auch bald, warum.\""
                            },
                            {
                                "example_id": "c6270431-4c4d-45f5-bd28-9d46d0bc1b2c",
                                "sense_id": "ed459a31-9f91-347f-a619-ab02a575b709",
                                "text": "„Die konservierten Exponate waren in ihrer blockierten Verwesung wie gefangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fc0281cd-7d04-3516-9e39-077c1625153d",
                        "entry_id": "ce9998e3-16e6-3311-9fe7-8f363e439f9d",
                        "glosses": [
                            "das Verwesen; in Verwesung übergehen"
                        ],
