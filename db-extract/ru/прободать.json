                        "tags": [],
                        "examples": [
                            {
                                "example_id": "864cd01c-5c16-4e33-bdcc-38cb5f378a09",
                                "sense_id": "d26fd569-d912-3157-99ee-606c917b89d1",
                                "text": "Гораций сказал: Волк зубами грызёт, рогами бык прободает; Не природой ли то внушено?"
                            }
                        ]
                    },
                    {
                        "sense_id": "ac43ce6c-90fb-3e7b-ae34-cb3b186ec800",
                        "entry_id": "e07f3f49-890b-30e6-ad4e-534bfbf5ae0d",
                        "glosses": [
                            "устар. прокалывать, протыкать, пронзать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd7aa4d1-d798-497d-91e5-beb7e281213d",
                                "sense_id": "ac43ce6c-90fb-3e7b-ae34-cb3b186ec800",
                                "text": "Ужас последнего часа прободал мою душу, я видел то мгновение, что я существовать перестану."
                            }
                        ]
                    }
