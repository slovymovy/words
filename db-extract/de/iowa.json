                                "target_senses": [
                                    {
                                        "sense_id": "5137db09-5cec-3110-bc58-4b9244f9bd3d",
                                        "entry_id": "9196b3e7-2cc2-34fe-80ee-4fa5f1728c89",
                                        "glosses": [
                                            "A state in the Midwestern region of the United States. Capital and largest city: Des Moines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ed7560e-0200-4471-8889-b233a0885c46",
                                                "sense_id": "5137db09-5cec-3110-bc58-4b9244f9bd3d",
                                                "text": "His family, who live in West Des Moines, Iowa, have been left “devastated,” his owner Tracy Wolfe said in GWR press release. “He was just the best giant boy,” she added."
                                            },
                                            {
                                                "example_id": "aa5581b2-6dc4-4c21-a5ad-46c10f452b4e",
                                                "sense_id": "5137db09-5cec-3110-bc58-4b9244f9bd3d",
                                                "text": "I prefer to think of Iowa as I saw it through the eyes of a ten-year-old boy. Those were eyes filled with the wonders of Iowa’s streams and woods, of the mystery of growing crops."
                                            },
                                            {
                                                "example_id": "bb7e217e-f510-40d1-b673-5ac96f1ce038",
                                                "sense_id": "5137db09-5cec-3110-bc58-4b9244f9bd3d",
                                                "text": "When University of Iowa researchers surveyed first-responders in Cedar Rapids, their study published last year found no noticeable difference in response time when a road diet was in place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fde867d-e72b-3f06-9c1c-fc1350c6db3e",
                                        "entry_id": "9196b3e7-2cc2-34fe-80ee-4fa5f1728c89",
                                        "glosses": [
                                            "A tributary of the Mississippi River which flows through Iowa in a southeast direction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "538f92f6-51e4-3064-8a72-177e56cc1150",
                                        "entry_id": "9196b3e7-2cc2-34fe-80ee-4fa5f1728c89",
                                        "glosses": [
                                            "A town in Calcasieu Parish, Louisiana."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4ebe862-404c-38de-afed-04d8f318d928",
                                        "entry_id": "9196b3e7-2cc2-34fe-80ee-4fa5f1728c89",
