                ],
                "senses": [
                    {
                        "sense_id": "12d747a8-561c-3c54-93cc-3ccbf36f848e",
                        "entry_id": "7f998c31-a82a-3991-a4e6-31e7f58214d2",
                        "glosses": [
                            "Arbeitsunterbrechung, bei der das Außengelände einer Einrichtung zur Erholung bzw. zum Spielen genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78f975a9-f3ff-49a9-9226-ca8d482341e3",
                                "sense_id": "12d747a8-561c-3c54-93cc-3ccbf36f848e",
                                "text": "„Die beiden Siebtklässler waren am Vormittag während der Hofpause in Streit geraten.“"
                            },
                            {
                                "example_id": "7bde37af-bcd1-4655-a060-2bd74c473a08",
                                "sense_id": "12d747a8-561c-3c54-93cc-3ccbf36f848e",
                                "text": "„Man weiß, dass Wandertage sich wie verlängerte Hofpausen anfühlten.“"
                            },
                            {
                                "example_id": "a0e4db6e-1b98-4384-8340-5c4068ff8c24",
                                "sense_id": "12d747a8-561c-3c54-93cc-3ccbf36f848e",
                                "text": "„Zusammen mit einer anderen Freundin versuchte ich in der Hofpause, Freundschaft mit Sara zu schließen, eine meiner ersten Fragen an sie lautete: Hast du schon Brüste?“"
                            },
                            {
                                "example_id": "8f1e8d26-bc30-4743-bb0d-48087b366b44",
                                "sense_id": "12d747a8-561c-3c54-93cc-3ccbf36f848e",
                                "text": "„Um die Atmosphäre an einer Schule mitzubekommen, lohnt es sich, an einem gewöhnlichen Schultag eine Hofpause zu besuchen und die Schüler zu beobachten.“"
                            },
                            {
                                "example_id": "b63dc157-8290-4c11-9df8-b3fa3002e373",
                                "sense_id": "12d747a8-561c-3c54-93cc-3ccbf36f848e",
                                "text": "„Deshalb ist die große Hofpause auch nicht zum Essen, sondern zum Toben und Spielen gedacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
