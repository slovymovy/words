                        "glosses": [
                            "weibliche Person, die beruflich teuren Schmuck verkauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2ce7877-e345-448d-a4e3-479fd7d69444",
                                "sense_id": "7f393c90-afa3-33f8-94a7-919bac4d111c",
                                "text": "Die Juwelierin meinte, mein Ring sei eine Fälschung."
                            },
                            {
                                "example_id": "5657483c-28ed-4117-b99b-285a5ab89fc3",
                                "sense_id": "7f393c90-afa3-33f8-94a7-919bac4d111c",
                                "text": "„Die ungeheure Sammlung führt zugleich durch alle weiblichen Berufe, von der Blumenverkäuferin bis zur Juwelierin und Apothekerin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
