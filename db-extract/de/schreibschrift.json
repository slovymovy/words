                                    },
                                    {
                                        "sense_id": "8b1cfc8d-4bd6-3cfd-825b-ceb0a25a2d63",
                                        "entry_id": "2c61455e-5530-361a-b9b9-3fe535b91c17",
                                        "glosses": [
                                            "Having successive letters joined together."
                                        ],
                                        "tags": [
