                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d37d90f-909f-4042-a8a5-862c770c045b",
                                                "sense_id": "242c1f9c-54f7-3e83-a6c6-8d5fd82da5a2",
                                                "text": "I protest, in the sincerity of love."
                                            },
                                            {
                                                "example_id": "9eddbe56-73ca-4d9d-b772-9b47dbe595c5",
                                                "sense_id": "242c1f9c-54f7-3e83-a6c6-8d5fd82da5a2",
                                                "text": "If the shew of any thing be good for any thing, I am sure sincerity is better"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d81244d-0600-422b-9cee-aa3ea028e914",
