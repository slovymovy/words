                ],
                "senses": [
                    {
                        "sense_id": "3138754b-a009-3e25-8236-b5bd917f4d7a",
                        "entry_id": "0f9cc303-e8bc-39ec-aeaa-0b4831e5fcf6",
                        "glosses": [
                            "gemauerter Bildstock mit breitem rechteckigen Grundriss und giebelförmigem Dach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebb2ab71-5a7b-484f-8579-9a9d35ec8812",
                                "sense_id": "3138754b-a009-3e25-8236-b5bd917f4d7a",
                                "text": "„Beim Breitpfeiler endet die Unterkante der Öffnung deutlich oberhalb der Basis (Erdboden), ein Betreten ist nicht möglich.“"
                            },
                            {
                                "example_id": "a53a4100-4680-45aa-9c8a-80048bd0515c",
                                "sense_id": "3138754b-a009-3e25-8236-b5bd917f4d7a",
                                "text": "„Kreuzstöckl ist ein Breitpfeiler aus einem Stück mit 60cm hohem Sockel, in dem sich im oberen Teil ein Bild mit Christus am Kreuz befindet.“"
                            },
                            {
                                "example_id": "8d8a64de-b61d-41d8-b834-6ebf3c7bc308",
                                "sense_id": "3138754b-a009-3e25-8236-b5bd917f4d7a",
                                "text": "„Der Breitpfeiler ist typisch für die Bildstöcke im Münsterland.“"
                            },
                            {
                                "example_id": "cf71add5-8b67-464c-b947-a63fc1848ee8",
                                "sense_id": "3138754b-a009-3e25-8236-b5bd917f4d7a",
                                "text": "„Dieser Breitpfeiler mit tiefgezogener Nische zwischen zwei Linden steht an der Straße von Oberndorf nach Oberpfaffendorf.Dieses Schmuckstück wurde vom Raabser Wanderverein renoviert.“"
                            },
                            {
                                "example_id": "cb73507e-53bf-4242-89ce-20ac1ec9e119",
                                "sense_id": "3138754b-a009-3e25-8236-b5bd917f4d7a",
                                "text": "„1,90 x 0,80 x 0,54 m großer granitener Breitpfeiler mit einer Nische, auf dem Sockel 1792 (vermutlich 1727) und verschiedene nicht mehr entzifferbare Buchstaben“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
