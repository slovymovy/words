                "senses": [
                    {
                        "sense_id": "1c8370f9-d21f-30b9-bb7a-5fc3f829907b",
                        "entry_id": "5b5d6c6e-01b0-3128-979f-ace220863f7a",
                        "glosses": [
                            "Langue véhiculaire des élites urbaines de Norvège durant les dernières années de l’union entre les Royaumes du Danemark et de Norvège (1536-1814)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5bb70a7-202d-4bcb-a715-a292c6fdf241",
                                "sense_id": "1c8370f9-d21f-30b9-bb7a-5fc3f829907b",
                                "text": "Mais bien vite la dispute linguistique revêt en Norvège un caractère politique : le dano-norvégien, dit encore norvégien classique, est considéré comme nécessaire par les partis politiques conservateurs, tandis que le « nouveau norvégien », s’appuyant sur le monde paysan, est le moyen d’expression choisi et défendu par les mouvements coopératifs, syndicaux et généralement la « gauche »."
                            }
                        ]
                    }
