                    {
                        "translation_id": "7217616f-8e4a-4331-925a-67d43c99a426",
                        "source_entry_id": "a80f1563-fbec-30aa-b1c8-dba3ec968e5b",
                        "source_sense_id": "c622b30b-07b5-35cf-bc77-5897b8a61376",
                        "source_sense_description": "Hut aus weichem Material mit unfestem Kopfteil und gewellter Krempe",
                        "target_lang_word": "spook",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spook",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c4175db-27d2-30eb-8e40-c12af32ad32a",
                                        "entry_id": "e211a730-9514-3a19-b61e-c7bdf6ae926c",
                                        "glosses": [
                                            "A ghost or phantom."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21a92654-c217-4b03-ab71-fa4415c507c0",
                                                "sense_id": "7c4175db-27d2-30eb-8e40-c12af32ad32a",
                                                "text": "The building was haunted by a couple of spooks."
                                            },
                                            {
                                                "example_id": "8878f75d-e792-42f1-af13-17f712e12705",
                                                "sense_id": "7c4175db-27d2-30eb-8e40-c12af32ad32a",
                                                "text": "\"I'll say what I think, no more and no less, and I won't be scared by you or your spooks into altering my opinions.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37ca3acd-ba75-3a62-a1de-b644aec4bcea",
                                        "entry_id": "e211a730-9514-3a19-b61e-c7bdf6ae926c",
                                        "glosses": [
                                            "A hobgoblin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6071adee-cec2-32e6-94cc-4185032d6981",
                                        "entry_id": "e211a730-9514-3a19-b61e-c7bdf6ae926c",
                                        "glosses": [
                                            "A scare or fright."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd30eaec-efb0-4384-b984-c92f93a320f9",
                                                "sense_id": "6071adee-cec2-32e6-94cc-4185032d6981",
                                                "text": "The big spider gave me a spook."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "710a3391-5b39-3016-af2b-dd067b359a80",
                                        "entry_id": "e211a730-9514-3a19-b61e-c7bdf6ae926c",
                                        "glosses": [
                                            "An undercover agent, spy, or intelligence analyst."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd150d1a-1741-4d02-a34f-6822fc149f46",
                                                "sense_id": "710a3391-5b39-3016-af2b-dd067b359a80",
                                                "text": "From Ian Fleming to John Le Carre - authors have long been fascinated by the world of espionage. But, asks the BBC’s Gordon Corera, what do real life spooks make of fictional spies?"
                                            },
                                            {
                                                "example_id": "bc01fff8-6143-44a3-b0df-df8323073275",
                                                "sense_id": "710a3391-5b39-3016-af2b-dd067b359a80",
                                                "text": "The congressional study frets that Huawei’s and ZTE’s products could be used as Trojan horses by Chinese spooks."
                                            },
                                            {
                                                "example_id": "a3feaaec-4adf-48c4-8267-8104b2085cd2",
                                                "sense_id": "710a3391-5b39-3016-af2b-dd067b359a80",
                                                "text": "The hard right is on the march in Europe. The Alternative for Germany, a party declared extremist by domestic spooks, scored a record result in a national election in February."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5a3b819-b5e1-3808-9e86-2cdd5813d612",
                                        "entry_id": "e211a730-9514-3a19-b61e-c7bdf6ae926c",
                                        "glosses": [
                                            "A black person."
                                        ],
                                        "tags": [
                                            "dated",
                                            "ethnic",
                                            "offensive",
                                            "slang",
                                            "slur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a46a842-a4ac-45ec-a072-51d69a9ec0cc",
                                                "sense_id": "c5a3b819-b5e1-3808-9e86-2cdd5813d612",
                                                "text": "Some won't take spooks—hell, don't make no difference to me."
                                            },
                                            {
                                                "example_id": "c718c94e-cd7d-46da-9c48-059c24e69a45",
                                                "sense_id": "c5a3b819-b5e1-3808-9e86-2cdd5813d612",
                                                "text": "\"[…] Dryades Street and that whole uptown neighborhood is gonna be worth a fortune once the white people take it back from you spooks and develop it. […]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "846b91ae-7b04-34a6-a17c-911f0f5cf90e",
                                        "entry_id": "e211a730-9514-3a19-b61e-c7bdf6ae926c",
                                        "glosses": [
                                            "A metaphysical manifestation; an artificial distinction or construct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51e65c9e-c3ad-4fc6-bb36-afaaadb1abb4",
                                                "sense_id": "846b91ae-7b04-34a6-a17c-911f0f5cf90e",
                                                "text": "He who is infatuated with Man leaves persons out of account so far as that infatuation extends, and floats in an ideal, sacred interest. Man, you see, is not a person, but an ideal, a spook."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac9a42dc-baa0-35dc-85e6-57eb38d9c046",
                                        "entry_id": "e211a730-9514-3a19-b61e-c7bdf6ae926c",
                                        "glosses": [
                                            "A psychiatrist."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6da863e0-7f7a-4924-8bee-2a3e20af6eae",
                                                "sense_id": "ac9a42dc-baa0-35dc-85e6-57eb38d9c046",
                                                "text": "Commonly, the surgeons view nonsurgeons with disdain. The most disdain is directed toward the “shrinks” or the “spooks,” as the psychiatrists are called."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fc6d238-cf03-3af4-805d-2afac37d427e",
                                        "entry_id": "e211a730-9514-3a19-b61e-c7bdf6ae926c",
                                        "glosses": [
                                            "A player who engages in hole carding by attempting to glimpse the dealer's hole card when the dealer checks under an ace or a 10 to see if a blackjack is present."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "spook",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04c4d992-85b4-38bc-9b45-e62efad3d80e",
                                        "entry_id": "922d550f-aba0-38ac-a059-daa743dab414",
                                        "glosses": [
                                            "To frighten or make nervous (especially by startling)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "892a5875-e3ea-49d4-8d64-a8760ce3d111",
                                                "sense_id": "04c4d992-85b4-38bc-9b45-e62efad3d80e",
                                                "text": "The hunters were spooked when the black cat crossed their path. The movement in the bushes spooked the deer and they ran."
                                            },
                                            {
                                                "example_id": "8511cd38-6b8b-4f18-82ad-8cbb075dc9a6",
                                                "sense_id": "04c4d992-85b4-38bc-9b45-e62efad3d80e",
                                                "text": "As that was happening, an East Midlands train came through at 90mph. George [a Labrador] was spooked as the train went past him and ran backwards across the neighbouring slow lines and off towards the sidings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0a954fa-6335-3bb3-9aef-62a2a984d69c",
                                        "entry_id": "922d550f-aba0-38ac-a059-daa743dab414",
                                        "glosses": [
                                            "To become frightened (by something startling)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "777e63a9-2f4c-45b9-8ed2-94fca67cc876",
                                                "sense_id": "e0a954fa-6335-3bb3-9aef-62a2a984d69c",
                                                "text": "The deer spooked at the sound of the dogs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74a165a4-0ac7-3625-84df-750682b642e6",
                                        "entry_id": "922d550f-aba0-38ac-a059-daa743dab414",
                                        "glosses": [
                                            "To haunt."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "933ecd00-c991-4fd7-a51d-20e79ea54432",
