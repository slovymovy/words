                "senses": [
                    {
                        "sense_id": "29ef9966-289c-3256-974e-a90585acab71",
                        "entry_id": "c8db2f6c-8b88-3b28-9f40-762d4bc00f13",
                        "glosses": [
                            "Cesser de considérer comme une marchandise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0d38d0a-103f-44ca-abfe-2e235108a69b",
                                "sense_id": "29ef9966-289c-3256-974e-a90585acab71",
                                "text": "L'influence des salariés sur le centre se mesure à leur capacité de démarchandiser la force de travail."
                            },
                            {
                                "example_id": "e0379140-1b0e-4ffd-a994-66ed8104465b",
                                "sense_id": "29ef9966-289c-3256-974e-a90585acab71",
                                "text": "Mais à partir de la même opportunité historique, la classe Hacker peut réaliser que les moyens sont à portée de main pour démarchandiser l'information."
                            }
                        ]
                    },
                    {
                        "sense_id": "801e79b7-17ee-3587-a957-ac74824e6517",
