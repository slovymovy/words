{
    "word_family": [
        "contrivance",
        "contriver"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a61f0ebc-e09f-3218-ac44-d2d23003d4ae",
                    "sense_definition": "To manage to do something difficult or to invent a clever way to achieve a goal.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "invent_manage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She managed to <w>contrive</w> a way to finish the project before the deadline.",
                            "target_lang_translations": {
                                "cs": "Podařilo se jí <w>vymyslet</w> způsob, jak dokončit projekt před termínem."
                            }
                        },
                        {
                            "text": "They <w>contrive</w> to meet every week despite their busy schedules.",
                            "target_lang_translations": {
                                "cs": "I přes svůj nabitý program si každý týden <w>zařídí</w> schůzku."
                            }
                        }
                    ],
                    "synonyms": [
                        "plan",
                        "scheme"
                    ],
                    "common_phrases": [
                        "contrive to meet",
                        "contrive a way"
                    ],
                    "target_lang_definitions": {
                        "cs": "Dokázat něco obtížného nebo vymyslet chytrý způsob, jak dosáhnout cíle."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dokázat",
                                "target_lang_sense_clarification": "ve smyslu zvládnout něco obtížného"
                            },
                            {
                                "target_lang_word": "vymyslet",
                                "target_lang_sense_clarification": "vytvořit chytrý způsob řešení"
                            },
                            {
                                "target_lang_word": "zařídit",
                                "target_lang_sense_clarification": "podařit se něco uskutečnit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec986f61-2e55-35bd-b47d-c23297975aa5",
                    "sense_definition": "To create or design something, often using imagination or improvisation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "invent_manage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer had to <w>contrive</w> a new device to solve the mechanical failure.",
                            "target_lang_translations": {
                                "cs": "Inženýr musel <w>sestrojit</w> nové zařízení, aby vyřešil mechanickou závadu."
                            }
                        },
                        {
                            "text": "He <w>contrived</w> a clever solution using only the tools available in the shed.",
                            "target_lang_translations": {
                                "cs": "Vymyslel chytré řešení s použitím pouze nástrojů dostupných v kůlně."
                            }
                        }
                    ],
                    "synonyms": [
                        "plot",
                        "hatch"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vytvořit nebo navrhnout něco, často s využitím představivosti nebo improvizace."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sestrojit",
                                "target_lang_sense_clarification": "technické vytvoření zařízení"
                            },
                            {
                                "target_lang_word": "vynalézt",
                                "target_lang_sense_clarification": "přijít s novým řešením"
                            },
                            {
                                "target_lang_word": "vymyslet",
                                "target_lang_sense_clarification": "obecné kreativní vytvoření"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbb6a8f3-0221-3547-9f5e-fd1f747b2619",
                    "sense_definition": "To project or cast something, such as light or a shadow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old lantern <w>contrived</w> a faint glow across the dark room.",
                            "target_lang_translations": {
                                "cs": "Stará lucerna <w>vrhala</w> slabou záři napříč temnou místností."
                            }
                        },
                        {
                            "text": "The artist <w>contrived</w> a sharp shadow against the wall to create depth.",
                            "target_lang_translations": {
                                "cs": "Umělec <w>vytvořil</w> na zdi ostrý stín, aby dodal dílu hloubku."
                            }
                        }
                    ],
                    "synonyms": [
                        "cast about"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely historical or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Promítat nebo vrhat něco, například světlo nebo stín."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vrhat",
                                "target_lang_sense_clarification": "vrhat stín nebo světlo"
                            },
                            {
                                "target_lang_word": "promítat",
                                "target_lang_sense_clarification": "vytvářet obraz nebo světelný efekt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a71bb5d-8c76-3846-b448-5a4b2e418cef",
                    "sense_definition": "To spend or pass a period of time.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>contrived</w> the long winter months by reading by the fireplace.",
                            "target_lang_translations": {
                                "cs": "Dlouhé zimní měsíce <w>strávili</w> čtením u krbu."
                            }
                        },
                        {
                            "text": "He <w>contrived</w> his remaining days in quiet reflection.",
                            "target_lang_translations": {
                                "cs": "Své zbývající dny <w>strávil</w> v tichém rozjímání."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is no longer common in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Strávit nebo prožít určité časové období."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "strávit",
                                "target_lang_sense_clarification": "prožít čas"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}