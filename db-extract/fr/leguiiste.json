                        "glosses": [
                            "Relatif à Augusto Leguía et à sa politique en Équateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "142e8a48-fd87-4f0e-8bd9-ee206d48808b",
                                "sense_id": "ea0383aa-75c8-3ce8-9f8b-728614344d13",
                                "text": "Alors que l’idéologie « leguiiste » prônait l’intégration économique, l’idéologie de gauche aura succombé, de son côté, à la récupération de l’indigène à des fins d’intégration sociale."
                            },
                            {
                                "example_id": "572a4f88-8491-4920-b2de-ea9f9d4ebf63",
                                "sense_id": "ea0383aa-75c8-3ce8-9f8b-728614344d13",
                                "text": "Dans sa conclusion, l’auteur considère que l’expérience leguiiste a abouti à un éche total."
                            }
                        ]
                    }
                ],
