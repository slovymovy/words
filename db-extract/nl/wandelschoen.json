                "senses": [
                    {
                        "sense_id": "3dcebf6e-9b75-3900-82b9-4dee076e9714",
                        "entry_id": "c36d6b34-bf45-3f9b-a4fa-4a47662aadad",
                        "glosses": [
                            "schoeisel dat speciaal geschikt is om grote wandelingen mee te maken"
                        ],
                        "tags": [
                            "schoeisel"
                        ],
                        "examples": [
                            {
                                "example_id": "e3ce8cfa-b338-4eeb-82c2-2256f8b5a3eb",
                                "sense_id": "3dcebf6e-9b75-3900-82b9-4dee076e9714",
                                "text": "De juiste wandelschoen is een basisvereiste voor 'tredzekerheid' tijdens het wandelen."
                            }
                        ]
                    },
                    {
                        "sense_id": "9da8475e-e88f-3523-a9a3-2fbcde2c6047",
                        "entry_id": "c36d6b34-bf45-3f9b-a4fa-4a47662aadad",
                        "glosses": [
                            "licht, gemakkelijk zittend schoeisel met lage hakken, geschikt om op straat te wandelen"
                        ],
                        "tags": [
                            "schoeisel"
                        ],
                        "examples": [
                            {
                                "example_id": "7aaab73b-bede-44db-952b-0e6210122cd8",
                                "sense_id": "9da8475e-e88f-3523-a9a3-2fbcde2c6047",
                                "text": "Maar ook de „normale\" wandelschoen waarvan de hak slechts iets hoger ligt dan de zool, wordt door sommige experts in lichaamshouding en beweging als ongezond beschouwd."
                            },
                            {
                                "example_id": "7da836ca-e11a-4ba0-a8d8-b888ac071015",
                                "sense_id": "9da8475e-e88f-3523-a9a3-2fbcde2c6047",
                                "text": "Ze kreeg pijn doordat ze de hele dag op de cementvloer van de winkel liep en ze had het ene paar Engelse wandelschoenen na het andere geprobeerd zonder dat het hielp."
                            },
                            {
                                "example_id": "67edcd0f-ecaa-49e8-a2be-e77f6aa89434",
                                "sense_id": "9da8475e-e88f-3523-a9a3-2fbcde2c6047",
                                "text": "Gabardinebroek, tweed of lood en bruine wandelschoenen betekende een burger, zoals die op de balkons aan de Strandvâgen 'Bombardeer Hanoi'stonden te schreeuwen wanneer de demonstranten eronder voorbijliepen op weg naar de VS-ambassade."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f5dfceb-0f93-462a-85ee-fdc37fe705f8",
                        "source_entry_id": "c36d6b34-bf45-3f9b-a4fa-4a47662aadad",
                        "source_sense_id": "3dcebf6e-9b75-3900-82b9-4dee076e9714",
                        "source_sense_description": "een schoeisel dat speciaal geschikt is om grote wandelingen mee te maken",
                        "target_lang_word": "Bergschuh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bergschuh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ffe927c4-827d-312f-985b-f9f61d4de30f",
                                        "entry_id": "762a35fe-b2a7-3ee0-b98d-b20986c4db16",
                                        "glosses": [
                                            "robuster Schuh für Unternehmungen in den Bergen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c822b48-8e88-4e82-a251-381cdb65093c",
                                                "sense_id": "ffe927c4-827d-312f-985b-f9f61d4de30f",
                                                "text": "„Nie zuvor in seinem Leben hatte Thomas Lieven schwere Bergschuhe an den Füßen gehabt, nie in seinem Leben hatte er eine gefütterte Windjacke getragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62b1ba9f-570a-4cda-a2f6-e69b7f46ccd5",
                        "source_entry_id": "c36d6b34-bf45-3f9b-a4fa-4a47662aadad",
                        "source_sense_id": "3dcebf6e-9b75-3900-82b9-4dee076e9714",
                        "source_sense_description": "een schoeisel dat speciaal geschikt is om grote wandelingen mee te maken",
                        "target_lang_word": "Wanderschuh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wanderschuh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e04e490-46cb-3d62-a341-29be61618aaf",
                                        "entry_id": "03e8d8e0-54a7-394d-b4ca-70de46c12d66",
                                        "glosses": [
                                            "Schuh, der speziell für die sportliche Betätigung des Wanderns konzipiert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cc4a025-76c4-4cc9-8a29-81d174c1769c",
                                                "sense_id": "7e04e490-46cb-3d62-a341-29be61618aaf",
                                                "text": "Eine Tour durchs Gebirge sollte man nur in Wanderschuhen antreten."
                                            },
                                            {
                                                "example_id": "6f121b04-9a1f-4deb-b7fb-48a18cbe4636",
                                                "sense_id": "7e04e490-46cb-3d62-a341-29be61618aaf",
                                                "text": "„Wanderschuhe trägt in Island niemand, sondern alle unter vierzig tragen Sneaker.“"
                                            },
                                            {
                                                "example_id": "0e1160b0-936a-43b8-aa61-68983b4173f7",
                                                "sense_id": "7e04e490-46cb-3d62-a341-29be61618aaf",
                                                "text": "„Mit Wanderschuhen war ich noch nie geflogen.“"
                                            },
                                            {
                                                "example_id": "6dda6561-7dd3-4cad-b27d-872fb33a9b80",
                                                "sense_id": "7e04e490-46cb-3d62-a341-29be61618aaf",
                                                "text": "„Um sechs Uhr morgens gab sie es auf, packte sich warm ein und zog in ihren bequemen alten Wanderschuhen los, um einen Café Crème und ein Croissant zu sich zu nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
