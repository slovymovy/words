                                            {
                                                "example_id": "bc11fbc9-b1e9-467d-96ef-d652de7ec24f",
                                                "sense_id": "2b05c359-15b2-3bc8-9013-5dfdb4fd251a",
                                                "text": "Voordat een eitje bevrucht kan worden gaat het door verschillende stadia, waaronder één waarin het een oöcyt genoemd wordt."
                                            }
                                        ]
