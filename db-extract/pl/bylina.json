                                        "entry_id": "0cf376f0-adef-3c95-91ff-b46567a91894",
                                        "glosses": [
                                            "Se dit d’un mouvement musical vif et rapide"
                                        ],
                                        "tags": [
                                            "Italianisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6917b470-8fbe-41db-83b9-e3dc00d40235",
                                                "sense_id": "a6bb6a12-cbcf-30d0-b6f5-6b85d36e1d3d",
                                                "text": "Écouter un allegro vivace."
                                            },
                                            {
                                                "example_id": "46c4792b-ebe8-4383-b6c7-c66105922efb",
                                                "sense_id": "a6bb6a12-cbcf-30d0-b6f5-6b85d36e1d3d",
                                                "text": "Jeanne le plaint, fléchit, bémolise, repart dans le majeur, l’allegro vivace, le finale où toutes les lances fleurissent, où les ailes poussent à chacun et font de pauvres bougres l’assemblée des anges."
                                            }
                                        ]
                                    }
                                ]
                            },
