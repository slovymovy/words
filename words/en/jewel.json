                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гипохризопс",
                                "target_lang_sense_clarification": "биологическое название рода бабочек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "Hypochrysops属灰蝶",
                                "target_lang_sense_clarification": "指该属的灰蝶；无常用通行汉语名时可用学名"
                            },
