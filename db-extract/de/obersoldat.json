                "senses": [
                    {
                        "sense_id": "d012fde1-91cd-3f1e-adda-8e797b461a4f",
                        "entry_id": "402b9fc6-633f-3527-a1d9-d19968f925ed",
                        "glosses": [
                            "Rang zwischen dem Soldaten und dem Gefreiten, wurde in der Regel übersprungen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "ebc372b5-1ca7-44cd-8999-297ad8e32a4d",
                                "sense_id": "d012fde1-91cd-3f1e-adda-8e797b461a4f",
                                "text": "Der Rang des Obersoldaten wurde weder in der Bundeswehr noch in der Nationalen Volksarmee verwendet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1fb77714-2f9c-3603-8c1f-43fb768448e6",
                        "entry_id": "402b9fc6-633f-3527-a1d9-d19968f925ed",
                        "glosses": [
                            "Soldat im Range eines Obersoldaten"
                        ],
                        "tags": [
                            "Wehrmacht"
                        ],
                        "examples": [
                            {
                                "example_id": "d5c4e789-9fa9-486d-bfe2-945e4f905870",
                                "sense_id": "1fb77714-2f9c-3603-8c1f-43fb768448e6",
                                "text": "„‚Wenn Sie es tun‘, sagt der Obersoldat ganz langsam, ‚müssen alle sterben. Diese da‘, er zeigt auf die Sechs, ‚ich und auch Sie, Gefreiter Heydenreich.‘“"
                            },
                            {
                                "example_id": "2cbe688b-5ef9-4cf7-be84-13d13ad1dfff",
                                "sense_id": "1fb77714-2f9c-3603-8c1f-43fb768448e6",
                                "text": "„Als der Obersoldat seinen drei Kollegen zunickte, schnappten sie sich Wasserschläuche, die unten aus der Wand kamen.“"
                            },
                            {
                                "example_id": "13329e79-26c9-419c-8ccf-ff6a653efed1",
                                "sense_id": "1fb77714-2f9c-3603-8c1f-43fb768448e6",
                                "text": "„Beinernes, grinsendes Gestell, Obersoldat und Dichter, verwirrende Kombination von Eigenschaften.“"
                            },
                            {
                                "example_id": "211242ae-ef0e-446a-969d-5a5a1ae5fdb6",
                                "sense_id": "1fb77714-2f9c-3603-8c1f-43fb768448e6",
                                "text": "„Obersoldat ist er in meiner Einheit gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
