                "entry_id": "7401b11a-c88c-34dd-837b-1d948d84a9b6",
                "word": "greys",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e251f677-044d-3396-aa6b-9ed2d5532f05",
                        "entry_id": "7401b11a-c88c-34dd-837b-1d948d84a9b6",
                        "glosses": [
                            "Grey trousers and/or jackets worn by prisoners on relatively formal occasions."
                        ],
                        "tags": [
                            "UK",
                            "plural",
                            "plural-only",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f29f92a9-358d-4060-a467-6e4a45f5f1ab",
                                "sense_id": "e251f677-044d-3396-aa6b-9ed2d5532f05",
                                "text": "There was a clatter at the back of the gallery, a sharp word from a warder, and the men marched in in their prison greys, jackets too large, trousers too small."
                            },
                            {
                                "example_id": "332e5c61-55a1-4725-bf6f-48b1b9902845",
                                "sense_id": "e251f677-044d-3396-aa6b-9ed2d5532f05",
                                "text": "'No one told me that I had to be dressed in Greys not Blues! When I appeared before the BOV I was told that I could not go in and see them because I was improperly dressed.'"
                            },
                            {
                                "example_id": "ad29e41a-7510-417d-a894-31875e1d1305",
                                "sense_id": "e251f677-044d-3396-aa6b-9ed2d5532f05",
                                "text": "“Drop your trousers!” I loosened the clasp on my prison greys and my trouser dropped to my ankles."
                            }
                        ]
                    }
                ],
