                        "translation_id": "c06e7eb3-2ab2-4860-9312-3e5a779f3dfe",
                        "source_entry_id": "7ceb88d7-9823-3de9-96d4-3f88c2506f08",
                        "source_sense_id": "6253e161-6618-3ff4-895c-d18978d998fb",
                        "source_sense_description": "Bratpfanne",
                        "target_lang_word": "Bratpfanne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bratpfanne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9182605-3e9e-32b7-8f64-06785663fcd7",
                                        "entry_id": "79cd26ca-d8d1-3cf4-b382-a17a3ffd3e56",
                                        "glosses": [
                                            "Küchengerät zum Braten von Fisch, Fleisch, Kartoffeln, Nudeln, …"
                                        ],
                                        "tags": [
                                            "Haushalt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9ac7591-8feb-4b56-a755-bd50ee6626ae",
                                                "sense_id": "b9182605-3e9e-32b7-8f64-06785663fcd7",
                                                "text": "Unsere Bratpfanne muss mal gründlich gesäubert werden."
                                            },
                                            {
                                                "example_id": "50d07f64-d0a8-4c3a-853c-1d21009ee761",
                                                "sense_id": "b9182605-3e9e-32b7-8f64-06785663fcd7",
                                                "text": "„Keine fünf Minuten später brutzelte ich Speck und Rühreier in einer Bratpfanne, während er einen Eimer Wasser aus dem Kühlkasten holte und Tee zu kochen begann.“"
                                            },
                                            {
                                                "example_id": "6ea75d3f-1c76-4051-9889-58d4f2c4d039",
                                                "sense_id": "b9182605-3e9e-32b7-8f64-06785663fcd7",
                                                "text": "„Die mag zwar, an normalen Maßstäben gemessen, dürftig sein, jetzt aber haben Betten und Stühle, Kochtopf und Bratpfanne einen unschätzbaren Wert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
