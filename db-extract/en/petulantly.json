                        "entry_id": "df04fb3c-78f9-3175-b0b7-8260964aabf1",
                        "glosses": [
                            "In a petulant manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "463055e6-f937-4291-a753-87abb85e62cb",
                                "sense_id": "a2d7683b-96f5-3c21-90ea-4189f75b6baa",
                                "text": "`She loves the man, and he has been pleased to accept her love: where, then, is her sin?' `Truly, oh Holly, thou art foolish,' she answered, almost petulantly."
                            },
                            {
                                "example_id": "d3fa17af-9d8e-4933-afa9-34db489f5aa2",
                                "sense_id": "a2d7683b-96f5-3c21-90ea-4189f75b6baa",
                                "text": "A wayward hen, too proud to roost with the other hens on the village church, had come to our coconut palm and was cluck-clucking petulantly, for halfway up the tree she had spied us occupying her roost."
                            },
                            {
                                "example_id": "fca212f3-9be8-4846-917e-5f0560ee8e46",
                                "sense_id": "a2d7683b-96f5-3c21-90ea-4189f75b6baa",
                                "text": "Her tone was resentful, rejecting a burst of generous emotion on her behalf. She stood twisting and untwisting her bag, making the money jink petulantly, while her dark eyes and vermilion pout repudiated the painted replicas of herself tacked to the wall."
                            }
                        ]
                    }
