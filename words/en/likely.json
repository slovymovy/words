{
    "word_family": [
        "likelihood",
        "unlikely",
        "likeliness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "03f51730-e4dc-3867-b89e-c71663d9879d",
                    "sense_definition": "Having a good chance of happening or being true; probable or expected.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "probability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rain is <w>likely</w> later this afternoon.",
                            "target_lang_translations": {
                                "ru": "Во второй половине дня <w>вероятен</w> дождь.",
                                "tr": "Öğleden sonra yağmur yağması <w>muhtemel</w>."
                            }
                        },
                        {
                            "text": "He is <w>likely</w> to succeed at anything he tries.",
                            "target_lang_translations": {
                                "ru": "Он, <w>вероятно</w>, добьется успеха во всем, за что ни возьмется.",
                                "tr": "Denediği her şeyde başarılı olması <w>muhtemeldir</w>."
                            }
                        },
                        {
                            "text": "It is more <w>likely</w> to be tastier if you eat it fresh.",
                            "target_lang_translations": {
                                "ru": "Это, <w>вероятнее</w> всего, будет вкуснее, если съесть его свежим.",
                                "tr": "Taze yerseniz lezzetli olma ihtimali daha <w>yüksek</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "probable"
                    ],
                    "antonyms": [
                        "unlikely"
                    ],
                    "common_phrases": [
                        "highly likely",
                        "likely to",
                        "more likely than not",
                        "most likely"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий хорошие шансы произойти или оказаться правдой; вероятный или ожидаемый.",
                        "tr": "Gerçekleşme veya doğru olma olasılığı yüksek olan; muhtemel veya beklenen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вероятный",
                                "target_lang_sense_clarification": "возможный, ожидаемый"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "muhtemel",
                                "target_lang_sense_clarification": "olası, beklenen"
                            },
                            {
                                "target_lang_word": "olası",
                                "target_lang_sense_clarification": "gerçekleşme ihtimali olan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "142b9674-0998-367b-8d3b-90b9cb5b30be",
                    "sense_definition": "Seeming like truth; plausible or believable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That is not a very <w>likely</w> excuse for being late.",
                            "target_lang_translations": {
                                "ru": "Это не очень <w>правдоподобное</w> оправдание опоздания.",
                                "tr": "Geç kalmak için pek <w>inandırıcı</w> bir mazeret değil."
                            }
                        },
                        {
                            "text": "The police accepted his explanation as the most <w>likely</w> version of events.",
                            "target_lang_translations": {
                                "ru": "Полиция приняла его объяснение как наиболее <w>правдоподобную</w> версию событий.",
                                "tr": "Polis, onun açıklamasını olayların en <w>makul</w> versiyonu olarak kabul etti."
                            }
                        }
                    ],
                    "antonyms": [
                        "implausible"
                    ],
                    "common_phrases": [
                        "likely story"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кажущийся правдой; правдоподобный.",
                        "tr": "Gerçek gibi görünen; akla yatkın veya inanılır."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правдоподобный",
                                "target_lang_sense_clarification": "выглядящий истинным"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "inandırıcı",
                                "target_lang_sense_clarification": "gerçekmiş gibi duran"
                            },
                            {
                                "target_lang_word": "makul",
                                "target_lang_sense_clarification": "akla yatkın"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a27850e5-7d87-3788-b38a-5a6affe203c6",
                    "sense_definition": "Appropriate, suitable, or showing promise of success.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jones is a <w>likely</w> candidate for the management position.",
                            "target_lang_translations": {
                                "ru": "Джонс — <w>подходящий</w> кандидат на руководящую должность.",
                                "tr": "Jones, yöneticilik pozisyonu için <w>uygun</w> bir adaydır."
                            }
                        },
                        {
                            "text": "We found a <w>likely</w> spot near the river for our picnic.",
                            "target_lang_translations": {
                                "ru": "Мы нашли <w>подходящее</w> место у реки для пикника.",
                                "tr": "Pikniğimiz için nehrin yakınında <w>elverişli</w> bir yer bulduk."
                            }
                        }
                    ],
                    "common_phrases": [
                        "likely candidate",
                        "likely choice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подходящий, соответствующий требованиям или подающий надежды на успех.",
                        "tr": "Uygun, elverişli veya başarı vadeden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подходящий",
                                "target_lang_sense_clarification": "годный для определенной цели"
                            },
                            {
                                "target_lang_word": "многообещающий",
                                "target_lang_sense_clarification": "подающий надежды"
                            },
                            {
                                "target_lang_word": "перспективный",
                                "target_lang_sense_clarification": "имеющий хорошие перспективы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "uygun",
                                "target_lang_sense_clarification": "belirli bir amaç için elverişli"
                            },
                            {
                                "target_lang_word": "gözde",
                                "target_lang_sense_clarification": "başarı şansı yüksek olan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d52a59db-d25a-3d56-bde7-e0349bb9c799",
                    "sense_definition": "Attractive or pleasant in appearance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a <w>likely</w> young man with a charming smile.",
                            "target_lang_translations": {
                                "ru": "Это был <w>привлекательный</w> молодой человек с очаровательной улыбкой.",
                                "tr": "Büyüleyici bir gülümsemeye sahip, <w>hoş</w> bir genç adamdı."
                            }
                        },
                        {
                            "text": "I found a <w>likely</w> spot under a shady tree.",
