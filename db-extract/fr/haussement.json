                "entry_id": "ee8df9a8-0fea-31ff-bea4-9ef621b9f7a9",
                "word": "haussement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "81128bc5-12ac-4a62-ab04-70bdb38b2ef9",
                        "entry_id": "ee8df9a8-0fea-31ff-bea4-9ef621b9f7a9",
