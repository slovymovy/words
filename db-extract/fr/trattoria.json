                        "sense_id": "ab70f57a-6bfa-3132-af67-15cbc37c063e",
                        "entry_id": "43ef2cbd-1d15-3566-966f-d2307272324e",
                        "glosses": [
                            "Restaurant italien, simple et sans prétention."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1796b7a2-4c4c-40cf-b0c1-0f122d90eb1b",
                                "sense_id": "ab70f57a-6bfa-3132-af67-15cbc37c063e",
                                "text": "Les trattorias n’ont habituellement pas de carte écrite et les mets servis sont traditionnels et bon marché."
                            },
                            {
                                "example_id": "16ae0c1a-100c-4268-ad10-7d2cbcf13fdf",
                                "sense_id": "ab70f57a-6bfa-3132-af67-15cbc37c063e",
                                "text": "Au rez-de-chaussée de l’immeuble, il y avait une vieille trattoria qui fermait tard, et les voix des clients traversaient la fenêtre fermée."
                            }
                        ]
                    }
                ],
                "translations": [
