                ],
                "senses": [
                    {
                        "sense_id": "d7b145af-a97f-3c04-904c-d10169ffc024",
                        "entry_id": "8120a60e-5d51-38e2-85b3-4290fa8721fa",
                        "glosses": [
                            "(harte) Schicht aus Salz, die durch die Verdunstung von salzigem Wasser übrig geblieben ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e11d5cd-aa8e-4bba-9803-ae88a4965b8d",
                                "sense_id": "d7b145af-a97f-3c04-904c-d10169ffc024",
                                "text": "„So schnell setzen sich dicke Salzkrusten am Bug fest, daß Taucher sie einmal in der Woche mit der Axt abschlagen müssen.“"
                            },
                            {
                                "example_id": "1445a63a-3f6e-43e5-8118-0bb6ad51df70",
                                "sense_id": "d7b145af-a97f-3c04-904c-d10169ffc024",
                                "text": "„Gezeichnet hatte der Marathon auch die anderen: Das Gesicht von Corny (5:22:52) bedeckte flächendeckend eine weiße Salzkruste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "83664500-cf23-3b3f-a96d-9c5f6f711a34",
                        "entry_id": "8120a60e-5d51-38e2-85b3-4290fa8721fa",
                        "glosses": [
                            "aus grobem Salz, Wasser und Eiweiß hergestellte Masse, mit der Nahrungsmittel (vor allem ganze Fische und Geflügel) umhüllt werden, bevor sie im Backofen gegart werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc35dd39-9ab9-4cdb-8487-42f2b154dff4",
                                "sense_id": "83664500-cf23-3b3f-a96d-9c5f6f711a34",
                                "text": "„Das ergibt Speisen von puristischer Grandezza und ätherischer Finesse à la Carpaccio von Hummer und Stockfisch, Spaghetti mit Peperoncino, Wolfsbarsch in der Salzkruste, geschmortes Täubchen mit Pflaumen und Sellerie.“"
                            },
                            {
                                "example_id": "b3093603-dcd1-42ac-9112-ee825cd93254",
                                "sense_id": "83664500-cf23-3b3f-a96d-9c5f6f711a34",
                                "text": "„Lachs in der Salzkruste, das bedeutet oft, dass der Fisch, der darin mit Gräten und Haut, also im Ganzen, gegart wurde, heiß dampfend – und das bedeutet übergart – aus der Salzkruste gemeißelt wird.“"
                            },
                            {
                                "example_id": "9f21f539-c33c-4711-aa20-a88d8994a762",
                                "sense_id": "83664500-cf23-3b3f-a96d-9c5f6f711a34",
                                "text": "„Die Zubereitung ist typisch für die Kanaren: Man legt sie in einen Tontopf mit Deckel und gießt wenig sehr stark gesalzenes Wasser dazu, das sie beim Verdampfen mit einer Salzkruste ummantelt; kein bisschen vom Aroma geht verloren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
