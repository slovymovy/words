                                "target_senses": [
                                    {
                                        "sense_id": "d46e354b-4d66-3916-b2c9-2f903589328b",
                                        "entry_id": "57d02594-0f94-3d16-ba0c-2136a0806690",
                                        "glosses": [
                                            "Of or pertaining to Gilles Deleuze (1925–1995), French philosopher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16645a8f-3b61-4c6d-af82-8faacbb0dbac",
                                                "sense_id": "d46e354b-4d66-3916-b2c9-2f903589328b",
                                                "text": "I believe that these works will continue to revolve about us in enigmatic resonance with those of Klossowski, another major and excessive sign, and perhaps one day, this century will be known as Deleuzian."
                                            }
                                        ]
                                    }
