                    "sense_id": "f2d4c292-7b30-3efb-9668-9f0d016113bb",
                    "sense_definition": "Een zoogdier uit de familie van de varkens (Suidae), in het bijzonder het wilde zwijn.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens onze wandeling in het bos zagen we plotseling een wild <w>zwijn</w> tussen de bomen wegschieten.",
                            "target_lang_translations": {
                                "en": "During our walk in the forest, we suddenly saw a wild <w>boar</w> darting away between the trees."
                            }
                        },
                        {
                            "text": "Een geschoten <w>zwijn</w> roosterde je in zijn geheel aan een draaiend spit.",
                            "target_lang_translations": {
                                "en": "A shot <w>boar</w> was roasted whole on a rotating spit."
                            }
                        }
                    ],
                    "synonyms": [
                        "varken"
                    ],
                    "common_phrases": [
                        "wild zwijn"
