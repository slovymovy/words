                        "examples": [
                            {
                                "example_id": "5f7c14fb-1215-431b-9a41-e5185fbc6a61",
                                "sense_id": "146e0d9f-26f7-3d52-ab1f-e85da3efac6d",
                                "text": "Они перекрестились на образ, взяли благословение и просили отца выйти в садок побалакать промеж себя, чтобы во время этого балаканья не было никого лишнего, кому про то слушать не следует."
                            }
                        ]
                    }
