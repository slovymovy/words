    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b03a6bc0-ce89-302a-b248-2d5313985d6a",
                "word": "Gallipoli",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ce5a02ae-707c-3902-91f6-137822a3ab75",
                        "entry_id": "b03a6bc0-ce89-302a-b248-2d5313985d6a",
                        "glosses": [
                            "A peninsula in Turkey, north of the Dardanelles, between the Aegean and Marmara seas.",
                            "The Gallipoli Campaign (1915–1916) in World War I."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "c67d20b5-210a-4fc3-be6f-748e4670d414",
                                "sense_id": "ce5a02ae-707c-3902-91f6-137822a3ab75",
                                "text": "And anyway, it strikes me that the blasted English use Anzacs as fodder for the enemy guns, putting them into places where they don't want to waste their own precious tropps. Look at the way that saber-rattling [Winston] Churchill sent our men into something as useless as Gallipoli! Ten thousand killed out of fifty thousand! Twice as bad as decimation."
                            }
                        ]
                    },
                    {
                        "sense_id": "afd0fff8-e9b6-33b0-b85e-48e469df8f5c",
                        "entry_id": "b03a6bc0-ce89-302a-b248-2d5313985d6a",
                        "glosses": [
                            "A peninsula in Turkey, north of the Dardanelles, between the Aegean and Marmara seas.",
                            "Synonym of Gelibolu: a town and municipality of Turkey, located on the Gallipoli peninsula (sense 1)."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1dfa7b53-4775-34f4-b3f7-03646dc04033",
                        "entry_id": "b03a6bc0-ce89-302a-b248-2d5313985d6a",
                        "glosses": [
                            "A town in Lecce, Apulia, Italy."
                        ],
                        "tags": [
                            "also",
                            "attributive"
                        ],
                        "examples": [
                            {
                                "example_id": "957e6636-ee66-4fec-a1f6-4a29bad2d196",
                                "sense_id": "1dfa7b53-4775-34f4-b3f7-03646dc04033",
                                "text": "Gallipoli oil    Gallipoli soap"
                            }
                        ]
                    }
