                    {
                        "translation_id": "b441d17f-27f1-42c8-9cef-d067cb291fbc",
                        "source_entry_id": "faab7d24-c33b-3984-9ce4-3314e75b8704",
                        "source_sense_description": "act of replenishing",
                        "target_lang_word": "Auffüllung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auffüllung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4655195-5754-3075-b8ec-dbd490cdab99",
                                        "entry_id": "a337f579-85fc-3805-8bde-fe7323bc84e7",
                                        "glosses": [
                                            "Vorgang/Prozess, in dem eine Substanz in einen leeren/nicht ausreichend befüllten Behälter/Hohlraum gegeben wird, bis dieser (erneut) voll oder „voll genug“ ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10695a80-6303-4d62-a40d-47b68f34a9de",
                                                "sense_id": "e4655195-5754-3075-b8ec-dbd490cdab99",
                                                "text": "„Eine vorherige Auffüllung des Gelenkspaltes mit Kontrastmittel und eine Plazierung der Zugangswege […] waren bisher bei keinem unserer Patienten erforderlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5d3390df-02e3-36ad-a927-55e858466095",
                                        "entry_id": "a337f579-85fc-3805-8bde-fe7323bc84e7",
                                        "glosses": [
                                            "Hinzufügen einer bestimmten Menge, um gewünschten Stand (wieder) zu erreichen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1be1014-acf3-4399-a73c-a4e4207efea1",
                                                "sense_id": "5d3390df-02e3-36ad-a927-55e858466095",
                                                "text": "„Um etwas zu verschlüsseln, das nicht genau 128 Bit umfasst, müssen wir […] eine Auffüllung (Padding) […] verwenden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a0399288-62bc-3d28-96bb-b2538d6bbe9a",
                                        "entry_id": "a337f579-85fc-3805-8bde-fe7323bc84e7",
                                        "glosses": [
                                            "Angleichen einer Vertiefung an normales (Boden-)Niveau, indem Erde oder Ähnliches darin aufgehäuft wird"
                                        ],
                                        "tags": [
                                            "Erdarbeiten",
                                            "Bau",
                                            "Infrastruktur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa442360-b0dd-44a7-89f8-839130c2d177",
                                                "sense_id": "a0399288-62bc-3d28-96bb-b2538d6bbe9a",
                                                "text": "„Auf moorigen oder anmoorigen Böden dürfen grundsätzlich keine Auffüllungen durchgeführt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3a1d014c-fc51-36e2-8529-afb93ca818a2",
                                        "entry_id": "a337f579-85fc-3805-8bde-fe7323bc84e7",
                                        "glosses": [
                                            "das, was zugegeben/eingegossen/ergänzt wird/wurde; was die Sache „voll(ständig)“/„ausreichend“/„wie gewünscht“ macht"
                                        ],
                                        "tags": [
                                            "zu Bedeutungen [1–3]"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b7b57d6-e627-429e-8583-92368ab62f7e",
                                                "sense_id": "3a1d014c-fc51-36e2-8529-afb93ca818a2",
                                                "text": "„Unterhalb der Auffüllungen steht bis zur maximalen Endteufe von 6 m gewachsener Sand an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea85ac48-1663-4149-ac15-d588fa83218f",
                        "source_entry_id": "faab7d24-c33b-3984-9ce4-3314e75b8704",
