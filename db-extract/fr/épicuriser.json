                ],
                "senses": [
                    {
                        "sense_id": "a84291cc-ecaa-3b89-a9a8-08fcbf36ea09",
                        "entry_id": "ed9e6de0-7482-3d34-90de-676f798f0feb",
                        "glosses": [
                            "Donner un caractère rappelant Épicure à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d9027df-8969-4040-8e27-330247ca8ee0",
                                "sense_id": "a84291cc-ecaa-3b89-a9a8-08fcbf36ea09",
                                "text": "Le procédé de l’interprétation métamorphosante est sériel et réversible : le Spinoza et le Nietzsche de Deleuze ont été « épicurisés » au-delà de toute vraisemblance."
                            },
                            {
                                "example_id": "e86e01b7-39cb-465d-8230-14bb2194291a",
                                "sense_id": "a84291cc-ecaa-3b89-a9a8-08fcbf36ea09",
                                "text": "Danton en vient même à „épicuriser\" le Christ."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f8c5ef9-a7b5-3cbb-965a-b1b40df399ff",
                        "entry_id": "ed9e6de0-7482-3d34-90de-676f798f0feb",
                        "glosses": [
                            "Raisonner à la manière d’Épicure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1290cc31-639a-46f7-ae24-20987b8d0b28",
                                "sense_id": "5f8c5ef9-a7b5-3cbb-965a-b1b40df399ff",
                                "text": "La Barre étoit Parisien, et étoit venu épicuriser à Abbeville."
                            },
                            {
                                "example_id": "748c6927-ac9f-4a41-800c-8e2d6b7e5746",
                                "sense_id": "5f8c5ef9-a7b5-3cbb-965a-b1b40df399ff",
                                "text": "La vérité est que Montaigne ne « sénécise » que lorsque Sénèque « épicurise » : dès que Sénèque adopte une pensée propre au stoïcisme, Montaigne l’abandonne."
                            }
                        ]
                    }
