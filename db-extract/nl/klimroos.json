                        "source_entry_id": "52bbc505-a97c-3103-89ae-a479b3707eae",
                        "source_sense_id": "3fe3c03b-5f33-3614-992a-e4247bb0f1c7",
                        "source_sense_description": "groep van krachtig groeiende rozen, die met hun kruipende, lange, soepele takken 5-6 m hoog in bomen en tegen muren op kunnen klimmen",
