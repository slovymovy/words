                "senses": [
                    {
                        "sense_id": "e3a55105-b605-309a-b437-afa7aa3c9576",
                        "entry_id": "f0ffcbb3-9eb2-36e1-ba26-d7eb1eabfa67",
                        "glosses": [
                            "Angehöriger einer Gruppe von Stämmen der Kelten zwischen Bodensee und Inn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5ca7e89-79ca-457b-b94e-782a4f4eede6",
                                "sense_id": "e3a55105-b605-309a-b437-afa7aa3c9576",
                                "text": "„Als Teilstämme der Vindeliker werden uns dabei die Brigantier um Bregenz, die Estionen um Kempten, die Likatier am Lech und weiter östlich die Cattenaten, Cosuaneten und Rucinaten genannt.“"
                            },
                            {
                                "example_id": "26818e3f-e925-4a7b-9aed-15b6ff842bec",
                                "sense_id": "e3a55105-b605-309a-b437-afa7aa3c9576",
                                "text": "„Aus der Zeit der Eroberung kennen wir nun auch die Selbstbezeichnungen der hier lebenden Nationen oder »Stämme« – der Treverer in der Eifel, im Hunsrück und an der Mosel, der Nemeter in der Pfalz, der Helvetier in Baden und Schwaben, der Vindeliker und Boier in Bayern.“"
                            },
                            {
                                "example_id": "2b8091a8-3d4a-4a27-aba9-05d879f05293",
                                "sense_id": "e3a55105-b605-309a-b437-afa7aa3c9576",
                                "text": "„Der Leiter der Archäologischen Staatssammlung München weist darauf hin, dass in der Region um Manching eigentlich der Stamm der Vindeliker zu Hause war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
