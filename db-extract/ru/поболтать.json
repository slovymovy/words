                ],
                "senses": [
                    {
                        "sense_id": "a85a6151-69e2-3c1c-8063-c70b32acb9f3",
                        "entry_id": "090742d7-7f2b-3419-bc6f-6357e3479dc6",
                        "glosses": [
                            "разг. болтать некоторое время"
                        ],
                        "tags": [
                            "чем"
                        ],
                        "examples": [
                            {
                                "example_id": "690b879b-2a7b-45d5-9cdd-0b238726dd9c",
                                "sense_id": "a85a6151-69e2-3c1c-8063-c70b32acb9f3",
                                "text": "Я чуть не соскочил со стула от восторга, но только ногами немного поболтал как ребенок, который лакомится."
                            },
                            {
                                "example_id": "76cd6869-c4cc-4409-98fe-d4822d8ffde9",
                                "sense_id": "a85a6151-69e2-3c1c-8063-c70b32acb9f3",
                                "text": "Он поболтал в своём жбане ложкой, чтоб взбаламутить осевший на дно хрен, и стал пить не отрываясь."
                            }
                        ]
                    }
