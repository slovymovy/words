                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47980b1f-8ad3-4f31-9268-c8dd3d0b63b1",
                                                "sense_id": "a74de9d5-e6fb-33a4-a3d8-d42431a8f275",
                                                "text": "Frau Böhm ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "c6b5b593-e1af-4830-85ee-5da81fd323a3",
                                                "sense_id": "a74de9d5-e6fb-33a4-a3d8-d42431a8f275",
                                                "text": "Herr Böhm wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "f06c1ca4-696f-433b-95e6-8b6b74f394fc",
                                                "sense_id": "a74de9d5-e6fb-33a4-a3d8-d42431a8f275",
                                                "text": "Die Böhms kommen heute aus Darmstadt."
                                            },
                                            {
                                                "example_id": "00f15fe8-884e-4c12-be43-a1f7789ba07f",
                                                "sense_id": "a74de9d5-e6fb-33a4-a3d8-d42431a8f275",
                                                "text": "Der Böhm trägt nie die Schals, die die Böhm ihm strickt."
                                            },
                                            {
                                                "example_id": "e688c229-1325-4e3a-aa67-35da14ce7b71",
                                                "sense_id": "a74de9d5-e6fb-33a4-a3d8-d42431a8f275",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Böhm kommt, geht der Herr Böhm.“"
                                            },
                                            {
                                                "example_id": "4ff4f83a-aec7-4ea9-a1d0-40328d8a623f",
                                                "sense_id": "a74de9d5-e6fb-33a4-a3d8-d42431a8f275",
                                                "text": "Böhm kommt und geht."
                                            },
                                            {
                                                "example_id": "0bb0baef-acfc-440d-a6f5-bc4980633746",
                                                "sense_id": "a74de9d5-e6fb-33a4-a3d8-d42431a8f275",
                                                "text": "Böhms kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "d581cf9c-aed9-4d55-a7fe-6181668f36cb",
                                                "sense_id": "a74de9d5-e6fb-33a4-a3d8-d42431a8f275",
                                                "text": "An verregneten Herbsttagen ist Familie Böhms liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "c78716f6-7abb-42bf-a0ff-b3e2d98c629e",
                                                "sense_id": "a74de9d5-e6fb-33a4-a3d8-d42431a8f275",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Böhm das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
