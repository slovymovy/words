{
    "word_family": [
        "avalancheux"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "294eece5-5178-3b2e-83db-d7524db80dec",
                    "sense_definition": "Masse considérable de neige et de glace qui se détache brutalement du flanc d'une montagne et dévale la pente vers la vallée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "neige",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après les fortes chutes de neige, le risque d'<w>avalanche</w> reste très élevé en haute montagne."
                        },
                        {
                            "text": "Les secouristes ont rapidement retrouvé les skieurs pris au piège sous l'<w>avalanche</w>."
                        }
                    ],
                    "synonyms": [
                        "coulée de neige"
                    ],
                    "common_phrases": [
                        "risque d'avalanche",
                        "déclencher une avalanche"
                    ]
                },
                {
                    "sense_id": "49037024-4142-3347-9348-60d88fa0f3ec",
                    "sense_definition": "Grande quantité d'événements fâcheux ou de propos désagréables qui surviennent soudainement et en même temps.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a dû faire face à une véritable <w>avalanche</w> de critiques après sa décision controversée."
                        },
                        {
                            "text": "Elle ne s'attendait pas à recevoir une telle <w>avalanche</w> de reproches lors de cette réunion."
                        }
                    ],
                    "synonyms": [
                        "déluge",
                        "pluie"
                    ],
                    "common_phrases": [
                        "avalanche de reproches",
                        "avalanche de critiques"
                    ]
                },
                {
                    "sense_id": "bb73ddde-b782-3de5-bcc1-12895acc7374",
                    "sense_definition": "Arrivée ou accumulation massive, continue et soudaine d'un grand nombre de choses.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le service client a été submergé par une <w>avalanche</w> d'appels dès l'ouverture des lignes."
                        },
                        {
                            "text": "Pour son anniversaire, elle a reçu une <w>avalanche</w> de messages chaleureux de ses amis."
                        }
                    ],
                    "synonyms": [
                        "flot",
                        "déferlante"
                    ],
                    "common_phrases": [
                        "avalanche d'appels",
                        "avalanche de messages"
                    ]
                },
                {
                    "sense_id": "3348d081-aa2c-3a11-ae3e-e2782d045882",
                    "sense_definition": "Chute brutale et abondante d'une matière autre que la neige, telle que la roche, la boue ou des projectiles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une <w>avalanche</w> de pierres a subitement coupé la circulation sur cette petite route de montagne."
                        },
                        {
                            "text": "Les fortes pluies ont provoqué une violente <w>avalanche</w> de boue qui menace les maisons du village."
                        }
                    ],
                    "synonyms": [
                        "éboulement"
                    ],
                    "common_phrases": [
                        "avalanche de pierres",
                        "avalanche de boue"
                    ]
                }
            ]
        }
    ]
}