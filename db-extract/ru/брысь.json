        "ru-extract.jsonl": [
            {
                "entry_id": "26e03655-7369-3869-97fa-1cafaa31c948",
                "word": "брысь",
                "pos": "intj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4446cc9e-7c31-3586-bde9-1b516050ad47",
                        "entry_id": "26e03655-7369-3869-97fa-1cafaa31c948",
                        "glosses": [
                            "возглас, окрик, которым отгоняют кошку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "408a087f-3d1c-48e1-a74d-697bc055f0e9",
                                "sense_id": "4446cc9e-7c31-3586-bde9-1b516050ad47",
                                "text": "Кошка с любопытством следит за свесившимися концами лент, и не успела Федосья Петровна отойти, как чепчик уже лежит на полу, сдернутый бархатною лапкой. ― Брысь! ах ты, проклятая!"
                            },
                            {
                                "example_id": "cea5f581-a02c-4c08-9b26-9c61fa6e6080",
                                "sense_id": "4446cc9e-7c31-3586-bde9-1b516050ad47",
                                "text": "К сумкам тут же подошел огромный белый кот, принялся их обнюхивать. ― Брысь! ― прикрикнула на кота старуха."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9749b3c-f1d1-4914-acff-9b835618a440",
                        "source_entry_id": "26e03655-7369-3869-97fa-1cafaa31c948",
                        "source_sense_id": "4446cc9e-7c31-3586-bde9-1b516050ad47",
                        "target_lang_word": "shoo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7867acbd-424d-3cb8-b903-45370f0bc2ba",
                                        "entry_id": "e4646f74-864f-3f51-a7dd-93cef72101c1",
                                        "glosses": [
                                            "To induce someone or something to leave."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bab0bc32-1536-4e49-964f-ce1d44ecc191",
                                                "sense_id": "7867acbd-424d-3cb8-b903-45370f0bc2ba",
                                                "text": "Don't just shoo away mosquitoes, kill them!"
                                            },
                                            {
                                                "example_id": "73e661c2-7c41-4d48-85cd-7e357c04b4a9",
                                                "sense_id": "7867acbd-424d-3cb8-b903-45370f0bc2ba",
                                                "text": "See if you can shoo off the insurance salesmen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13803084-90ed-340f-afb0-ac55a9e3972b",
                                        "entry_id": "e4646f74-864f-3f51-a7dd-93cef72101c1",
                                        "glosses": [
                                            "To leave under inducement."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7529a046-0d48-4662-bcda-e850bd23c001",
                                                "sense_id": "13803084-90ed-340f-afb0-ac55a9e3972b",
                                                "text": "You kids had better shoo before your parents get a call."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5300b326-133a-334a-b012-282771e64890",
                                        "entry_id": "e4646f74-864f-3f51-a7dd-93cef72101c1",
                                        "glosses": [
                                            "To usher someone."
                                        ],
                                        "tags": [
                                            "informal",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9afe7ddf-b200-4486-8b45-41b0bc8c219f",
                                                "sense_id": "5300b326-133a-334a-b012-282771e64890",
                                                "text": "Shoo the visitor in."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "216143cb-107d-375a-b1dc-d46b7c1bfbbb",
                                        "entry_id": "db324f19-7197-3dac-8766-5030a7f5969d",
                                        "glosses": [
                                            "Go away! Clear off!"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b69a79df-6d5f-44f1-bcae-aa8921df3b6a",
                                                "sense_id": "216143cb-107d-375a-b1dc-d46b7c1bfbbb",
                                                "text": "Shoo, fly, don't bother me!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7c65c94-f2e4-300b-810a-f9ae31f79dc0",
                                        "entry_id": "1ecf2596-6a3b-37bf-978b-4ca7debccae9",
                                        "glosses": [
                                            "Alternative form of she."
                                        ],
                                        "tags": [
                                            "Yorkshire",
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b72fc7ab-abce-468a-b3d6-d9acbb7c6418",
                                                "sense_id": "d7c65c94-f2e4-300b-810a-f9ae31f79dc0",
                                                "text": "Hearken, hearken, shoo’s cursing on em!” muttered Joseph, towards whom I had been steering."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c66cb792-510c-4c26-8c90-39e48c38c0bd",
                        "source_entry_id": "26e03655-7369-3869-97fa-1cafaa31c948",
                        "source_sense_id": "4446cc9e-7c31-3586-bde9-1b516050ad47",
                        "target_lang_word": "oust",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oust",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b7f25e5-b44c-3ee9-9561-f76610b78d3e",
                                        "entry_id": "c05435d5-8dc9-3fa7-9642-0e384c36a31e",
                                        "glosses": [
                                            "Variante de ouste."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a1f7248-0f67-4610-aa84-68a8045e2ca6",
                                                "sense_id": "3b7f25e5-b44c-3ee9-9561-f76610b78d3e",
                                                "text": "– Voilà, barrez-vous, beatniks !\n– C’est ça ! Oust ! Bande de misérables ! ajoute Blondin, depuis le bar, pour faire bonne mesure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9a26ae2-7388-43e6-9465-97a9b31d9d48",
                        "source_entry_id": "26e03655-7369-3869-97fa-1cafaa31c948",
                        "source_sense_id": "4446cc9e-7c31-3586-bde9-1b516050ad47",
                        "target_lang_word": "ouste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ouste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d7e7a09-ebc7-3bd4-849a-34cfde7109a8",
                                        "entry_id": "f4fe82d2-223e-3359-8c4b-9350cb043f18",
                                        "glosses": [
                                            "Employée pour faire partir, pour chasser quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0c74d52-18af-4b04-84e6-25e8d1fcf180",
                                                "sense_id": "0d7e7a09-ebc7-3bd4-849a-34cfde7109a8",
                                                "text": "Allons, ouste ! Allez-vous-en !"
                                            },
                                            {
                                                "example_id": "e8c9b74b-d465-459a-85ed-d178bcb25b94",
                                                "sense_id": "0d7e7a09-ebc7-3bd4-849a-34cfde7109a8",
                                                "text": "– Allez, ouste, on vous appellera quand on aura besoin de vous ! avait-elle grogné."
                                            },
                                            {
                                                "example_id": "2a244c9e-87a2-4686-9643-09d83764d679",
                                                "sense_id": "0d7e7a09-ebc7-3bd4-849a-34cfde7109a8",
                                                "text": "Malivieri, tu peux rentrer chez toi. Allez ouste ! Rentre dans ta province !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70cdf0f5-2851-3c9e-8549-eddeb2a8d6a9",
                                        "entry_id": "f4fe82d2-223e-3359-8c4b-9350cb043f18",
                                        "glosses": [
                                            "Utilisée pour accélérer le mouvement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11e01686-5427-4b93-93d3-16f33a4328cd",
                                                "sense_id": "70cdf0f5-2851-3c9e-8549-eddeb2a8d6a9",
                                                "text": "Allez ouste ! Au lit !"
                                            },
                                            {
                                                "example_id": "dfa25dc2-ee07-4ddd-a5e2-cb25669ffcba",
                                                "sense_id": "70cdf0f5-2851-3c9e-8549-eddeb2a8d6a9",
                                                "text": "« Dis de ma part à Oneux de la mettre aux wagonets, et ouste ! plus vite que ça."
                                            },
                                            {
                                                "example_id": "87c03fe3-1baa-43e0-a741-171f1c4de94f",
                                                "sense_id": "70cdf0f5-2851-3c9e-8549-eddeb2a8d6a9",
                                                "text": "— Ouste ! partons !"
                                            },
                                            {
                                                "example_id": "f7fdaa2c-2cb5-49d2-bf5c-0210132888cf",
                                                "sense_id": "70cdf0f5-2851-3c9e-8549-eddeb2a8d6a9",
                                                "text": "— Qu’est-ce qui empêche Broudier de passer en tête avec toi ? Allons ! Ouste !"
                                            },
                                            {
                                                "example_id": "40efbc60-8fbb-49f9-bf1d-a831426e3ad9",
                                                "sense_id": "70cdf0f5-2851-3c9e-8549-eddeb2a8d6a9",
                                                "text": "— Dès qu’t’auras fini, Simon, presse-toi de t’habiller. On va sortir tous les deux, pour faire les courses… On ira d’abord chez Mollard, l’épicier. Je lui ai parlé de toi. Allez ! Ouste, paresseux…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
