                        "glosses": [
                            "Dérégler un faisceau qui avait fait l’objet d'une collimation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8515d8e-b8eb-49a4-b6cc-33de4fe1a079",
                                "sense_id": "6f27b3dc-642c-390c-9a00-8981a3c6caa7",
                                "text": "Cependant, si nous reprenons la description du chapite IV, nous pouvons affirmer qu’une collision a pour effet principal de décollimater un faisceau, car elle introduit une déflexion des particules."
                            },
                            {
                                "example_id": "48e22b55-8404-4670-b8ba-7836a0d5a133",
                                "sense_id": "6f27b3dc-642c-390c-9a00-8981a3c6caa7",
                                "text": "Limites de la densité des gaz de fond pour que le faisceau laser ne soit pas décollimaté de façon appréciable."
                            }
                        ]
                    }
