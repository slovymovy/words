                "forms": [],
                "senses": [
                    {
                        "sense_id": "097e29f9-94b7-3430-a886-c764d7c882f6",
                        "entry_id": "d88d2788-a49b-3ed2-83ca-2ed1dae201fe",
                        "glosses": [
                            "Région qui entoure le détroit de Magellan."
                        ],
                        "tags": [
                            "obsolete",
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "10812d6b-63ce-49ea-b0e6-221a41c1c5e4",
                                "sense_id": "097e29f9-94b7-3430-a886-c764d7c882f6",
                                "text": "Les habitants de la Magellanique s’appellent Patagons : ce sont des hommes d’une taille gigantesque, aussi féroces que robustes, et qui vivent dans les forêts sans lois comme sans religion."
                            },
                            {
                                "example_id": "16bc2f99-0fc2-4b45-86b0-7086c57258cb",
                                "sense_id": "097e29f9-94b7-3430-a886-c764d7c882f6",
                                "text": "Il y a en Magellanique deux nombreuses espèces d’animaux, la baleine et le lion marin, d’où on pourroit, à ce qu’il semble, tirer un grand profit."
                            }
                        ]
                    }
