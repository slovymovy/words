                "senses": [
                    {
                        "sense_id": "59a7b74d-ec13-3be1-b6a2-5549ac676443",
                        "entry_id": "5989a410-b2ea-3b0c-8375-6d922d8b5827",
                        "glosses": [
                            "mit Diamanten versehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd47e975-e8f7-4a76-a57c-758180e65015",
                                "sense_id": "59a7b74d-ec13-3be1-b6a2-5549ac676443",
                                "text": "„Seine diamantenbesetzte goldene Rolex schwenkend, führte Pablo, der nicht verhehlte, dass er eine Flotte von Flugzeugen und Hubschraubern sowie riesige Ländereien in aller Welt besaß, die Anfänge seines auf fünf Milliarden Dollar geschätzten Vermögens auf eine »Fahrradvermietung« zurück, die er seinen Angaben zufolge mit sechzehn Jahren eröffnet hatte.“"
                            },
                            {
                                "example_id": "17bf7e77-1de4-496e-a9b6-3fba92152fbb",
                                "sense_id": "59a7b74d-ec13-3be1-b6a2-5549ac676443",
                                "text": "„Mein Blick fällt auf den diamantenbesetzten Kamm in ihrem Haar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
