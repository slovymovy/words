                        "entry_id": "af7cc738-9bcd-3481-95f2-a861655860c1",
                        "glosses": [
                            "dwie konkretne istoty (dwoje ludzi lub człowiek i zwierzę), różniące się płcią; on i ona"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "364f8b0a-71d6-44b4-bf84-7c0c3ae798ed",
                                "sense_id": "1a1a0ce2-a153-3f81-89d8-7c96199a43a1",
                                "text": "Ukrywają oboje urazę, jaką wzajem do siebie czują, ale ja ją widzę"
                            },
                            {
                                "example_id": "4943acc7-1894-40a3-baa6-4085cf5f836d",
                                "sense_id": "1a1a0ce2-a153-3f81-89d8-7c96199a43a1",
                                "text": "Kobieta i kot. Oboje są groźni."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
