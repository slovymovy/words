                        "glosses": [
                            "Fidèle du zaydisme."
                        ],
                        "tags": [
                            "Chiisme"
                        ],
                        "examples": [
                            {
                                "example_id": "09f335ad-4fff-45d8-829c-ffac6155c3d0",
                                "sense_id": "a232627c-8b07-37c7-b9bf-d3664b72fd8c",
                                "text": "Les premiers à faire sécession sont les zaydistes, qui se séparent au VIIIᵉ siècle des partisans d'Ali après la mort du cinquième imam, Zayd. Ils représentent aujourd'hui une communauté d'une centaine de milliers de fidèles, implantés principalement au Yémen."
                            }
                        ]
