                "senses": [
                    {
                        "sense_id": "699f3727-fafc-3299-8a82-9ea390d0887b",
                        "entry_id": "dc073c4d-5fae-36b1-ab3d-9794d2369543",
                        "glosses": [
                            "mengsel van verschillende producten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85a3acf3-a498-40c3-b616-2a93768e8c35",
                                "sense_id": "699f3727-fafc-3299-8a82-9ea390d0887b",
                                "text": "Er zaten autosleutels in van vijf verschillende auto’s en een koffiekop van Good Morning America Blend met de kreet Does this day suck too? Een linkerschoen, een rode sok, een sjaaltje, de verpakking van een of andere ontbijtmix, parfum, een mondharmonica, afstandsbedieningen en een nummer van de TV Guide van december 1992."
                            },
                            {
                                "example_id": "1717079c-26f7-4ef9-a4a9-e390975aa304",
                                "sense_id": "699f3727-fafc-3299-8a82-9ea390d0887b",
                                "text": "Azijnverkoper Judith van Unen kon er geen chocolade van bakken, van de azijn uit de supermarkt die ze mocht proeven. Ze wist niet eens zeker of het wel van wijn was gemaakt. ,,Het is niet dat je zegt: heerlijk.” Een medewerker van een supermarktketen vermoedde dat de basis een ‘blend van de minst goede wijnen’ is, bekende hij aan de telefoon. ,,Het is een gok.”"
                            }
                        ]
                    }
