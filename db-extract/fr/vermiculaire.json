                        "glosses": [
                            "Qui ressemble à un ver ; qui en la forme ou l’aspect."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56b22d23-e378-489f-afd8-7550f9ad9a85",
                                "sense_id": "c8b39d66-6038-3485-9861-7a738614c2b0",
                                "text": "Un bâton à la main, Faugères guide sa méharée silencieuse. Derrière lui, étalées sur un kilomètre de large, les petites colonnes vermiculaires de la Compagnie suivent, minuscules pygmées répartis sur plusieurs hectares."
                            }
                        ]
                    }
