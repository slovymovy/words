                        "examples": [
                            {
                                "example_id": "a75b9d41-8ade-48f7-ae66-44708038c64b",
                                "sense_id": "b33c7ee3-d618-3320-b69e-117bf3893126",
                                "text": "„Man hat Heydrich nachgesagt, dass er als Planungschef der Judenvernichtung so fanatisch gewesen sei, weil er vergessen machen wollte, dass er eine jüdische Großmutter hatte.“"
                            },
                            {
                                "example_id": "39909168-c735-487e-9002-0b3c28e411b8",
                                "sense_id": "b33c7ee3-d618-3320-b69e-117bf3893126",
                                "text": "„Aus den zurückeroberten Gebieten im Osten dringen die ersten furchtbaren Nachrichten über die Judenvernichtung in die amerikanische Öffentlichkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
