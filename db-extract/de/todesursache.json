                ],
                "senses": [
                    {
                        "sense_id": "8f7526a6-2ce0-33c0-b987-bc1d9b6b2418",
                        "entry_id": "01068131-a8cc-3603-abb6-e07286356120",
                        "glosses": [
                            "Grund für den Eintritt eines Sterbevorgangs und des endgültigen Verlustes der Lebensfunktionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a6794dc-20c8-415e-96b2-8e0e4db7b6cf",
                                "sense_id": "8f7526a6-2ce0-33c0-b987-bc1d9b6b2418",
                                "text": "Der Rechtsmediziner konnte die Todesursache durch die Obduktion der Leiche feststellen."
                            },
                            {
                                "example_id": "9946f6b5-7134-41f3-b9fb-4b32459bb070",
                                "sense_id": "8f7526a6-2ce0-33c0-b987-bc1d9b6b2418",
                                "text": "„Wenn Darmkrebs entdeckt wird, ist er sehr häufig in einem späten Stadium und damit unheilbar. Diese Krankheit ist in der westlichen Welt, also auch in Deutschland, die zweithäufigste krebsbedingte Todesursache.“"
                            },
                            {
                                "example_id": "83e6c204-407d-451f-8bbe-a19a67043692",
                                "sense_id": "8f7526a6-2ce0-33c0-b987-bc1d9b6b2418",
                                "text": "„In den unterirdischen Kammern wurden nur Leichen aufbewahrt, deren Namen zwar bekannt, deren Todesursache aber man nach Paragraf hundertfünfundsiebzig der Strafprozessordnung noch feststellen musste.“"
                            },
                            {
                                "example_id": "5610afdc-cfa1-4d87-9069-9b94d2054671",
                                "sense_id": "8f7526a6-2ce0-33c0-b987-bc1d9b6b2418",
                                "text": "„Aber in diesem Lande, wo der Hunger die häufigste Todesursache in jedem Frühjahr ist, gibt es keinen noch so vornehmen Mann, der nicht irgendwie von der dem ganzen Volke anhaftenden Schwächung gezeichnet ist, wie überfüllt seine eigne Speisekammer mit Fässern voll Butter und Käse auch sein möge.“"
                            },
                            {
                                "example_id": "e3f5fa64-022e-43ba-8559-c0c080efb373",
                                "sense_id": "8f7526a6-2ce0-33c0-b987-bc1d9b6b2418",
                                "text": "„Jeder dritte Todesfall hierzulande geht auf das Konto einer Herz- oder Kreislauferkrankung: Herzinfarkte, Schlaganfälle, chronische Herzschwäche oder eben Herzstillstand. Weltweit sind diese Leiden seit Jahren die Todesursache Nummer eins.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
