                        "source_sense_id": "9921ab20-ba99-3a27-9936-82d029d76a67",
                        "target_lang_word": "calibration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calibration",
                                "target_lang_code": "en",
