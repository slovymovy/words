                "senses": [
                    {
                        "sense_id": "8d8cd899-3472-3cf5-867b-86f92b699350",
                        "entry_id": "28481399-ed58-34d8-8bed-b4762be00697",
                        "glosses": [
                            "to blow"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f996e9c-b0dd-49c9-b4fb-67e71177725c",
                                "sense_id": "8d8cd899-3472-3cf5-867b-86f92b699350",
                                "text": "— Вы ничего́ не говори́те, так что ж тут стоя́ть-то да́ром? — захрипе́л Заха́р, за неиме́нием друго́го го́лоса, кото́рый, по слова́м его́, он потеря́л на охо́те с соба́ками, когда́ е́здил с ста́рым ба́рином и когда́ ему́ ду́нуло бу́дто си́льным ве́тром в го́рло.",
                                "translation": "“You aren’t saying anything, so why should I stand here for nothing?” rasped Zakhar, because he did not have his other voice, which, according to him, he had lost hunting with the dogs, when he was riding with the old master and a strong wind blew in his throat.",
                                "english": "“You aren’t saying anything, so why should I stand here for nothing?” rasped Zakhar, because he did not have his other voice, which, according to him, he had lost hunting with the dogs, when he was riding with the old master and a strong wind blew in his throat."
                            }
                        ]
                    },
                    {
