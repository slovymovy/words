                "forms": [
                    {
                        "form_id": "e56dbb48-2b24-4cdf-8039-af481842dbd2",
                        "entry_id": "5a2525bf-f4fa-3b71-9d23-66d540a8f383",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "axillaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "62a6bbe1-518e-337c-8505-be7990030a99",
                        "entry_id": "5a2525bf-f4fa-3b71-9d23-66d540a8f383",
                        "glosses": [
                            "Qui a rapport à l’aisselle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0be4cee5-96e8-4cd8-a941-228f691d0456",
                                "sense_id": "62a6bbe1-518e-337c-8505-be7990030a99",
                                "text": "Elle n’a jamais su qu’à chaque retour l’odeur de sa pelisse en ventre-de-gris, pénétrée d’un parfum châtain clair, féminin, chaste, éloigné des basses séductions axillaires, m’ôtait la parole et jusqu’à l’effusion."
                            },
                            {
                                "example_id": "d0cd4bc4-e2db-4964-a252-1446c1b89f3c",
                                "sense_id": "62a6bbe1-518e-337c-8505-be7990030a99",
                                "text": "Le premier renforcement forme une gaine assez ferme pour le paquet vasculo-nerveux, le second est une lame qui unit la gaine vasculo-nerveuse à l’aponévrose clavi-pectorale et ferme ainsi comme un dôme l’espace axillaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "6aa808b9-6b12-3f18-9f61-5e65e746bce4",
                        "entry_id": "5a2525bf-f4fa-3b71-9d23-66d540a8f383",
                        "glosses": [
                            "Toute partie qui naît dans l’espèce d’aisselle formée par la tige et un rameau, ou par un rameau et une feuille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1878a08d-0998-4da8-b8c7-125ef4f4bd68",
                                "sense_id": "6aa808b9-6b12-3f18-9f61-5e65e746bce4",
                                "text": "Les fleurs sont axillaires et de couleur violette ou purpurine."
                            },
                            {
                                "example_id": "8f93904a-5aec-4ab5-bb7a-778505ac02b2",
                                "sense_id": "6aa808b9-6b12-3f18-9f61-5e65e746bce4",
                                "text": "Épines axillaires."
                            },
                            {
                                "example_id": "4c7b6dde-c88b-4486-9716-a3f1f152507a",
                                "sense_id": "6aa808b9-6b12-3f18-9f61-5e65e746bce4",
                                "text": "Feuilles axillaires. Celles qui sont immédiatement au-dessus du point où naît un rameau."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f9fd166-d6a8-467c-90d9-078ff7a35660",
