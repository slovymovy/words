                "senses": [
                    {
                        "sense_id": "7d20c02c-c178-3ae1-8e99-3d3c5b0a8a81",
                        "entry_id": "8c6fe10b-1494-3897-b2a5-49fb40e1b3d3",
                        "glosses": [
                            "atomarer Angriff mit dem Ziel, die Nuklearwaffen des Feindes zu vernichten, um so einem Vergeltungsschlag zu entgehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2307a6da-7b18-496e-95cf-e0ffcad043b4",
                                "sense_id": "7d20c02c-c178-3ae1-8e99-3d3c5b0a8a81",
                                "text": "„Im April 1962 wurden die amerikanischen Thor- und Jupiter-Atomraketen in der Türkei einsatzbereit gemacht. Weil sie wegen ihrer ungeschützten Aufstellung leicht angreifbar waren, konnten sie nur zu einem atomaren Erstschlag genutzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d2d39d7-69d7-4d92-86b7-0f70ee971c30",
                        "source_entry_id": "8c6fe10b-1494-3897-b2a5-49fb40e1b3d3",
                        "source_sense_id": "7d20c02c-c178-3ae1-8e99-3d3c5b0a8a81",
                        "source_sense_description": "atomarer Angriff mit dem Ziel, die Nuklearwaffen des Feindes zu vernichten",
                        "target_lang_word": "first strike",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "first strike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5c1d0f2-6a42-356a-98bd-78477a130ecc",
                                        "entry_id": "ae1917ee-f777-3c4a-a32b-f0423457c52e",
                                        "glosses": [
                                            "An attack (typically nuclear) launched without warning in the absence of a prior attack by one's opponent, with the intention of destroying one's opponent's ability to retaliate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d56c7b30-c045-4366-b720-7bacd8936a1b",
                                                "sense_id": "d5c1d0f2-6a42-356a-98bd-78477a130ecc",
                                                "text": "Near-synonym: decapitation strike"
                                            },
                                            {
                                                "example_id": "74a3b491-6975-46c8-ac26-be764e1c5902",
                                                "sense_id": "d5c1d0f2-6a42-356a-98bd-78477a130ecc",
                                                "text": "During the Cold War, both sides feared that the other was preparing to launch a first strike."
                                            },
                                            {
                                                "example_id": "e441ae7d-40b4-48be-bc64-454d2487de6d",
                                                "sense_id": "d5c1d0f2-6a42-356a-98bd-78477a130ecc",
                                                "text": "\"Where I come from 'proactive defense' is a euphemism for \"first strike.\" \"This is not that approach, Putzho. We have evolved to defend ourselves with a much subtler, gentler approach.\""
                                            },
                                            {
                                                "example_id": "8ed9fc3d-2303-4089-b2ae-882fceeef3b1",
                                                "sense_id": "d5c1d0f2-6a42-356a-98bd-78477a130ecc",
                                                "text": "In the end, the question proved to be academic. When SCP-3125 arrived, whether it knew ω-0 was there or not, it took no special action against it, and had no need to. Most of ω-0's members' anchors were Foundationers, or Foundation-adjacent. With those people's minds blown away in the first strike, the dense web of mutual memory which had held the Task Force together since its formation tore loose. More than half of the Task Force was cast into the void and died; the final, real death they had evaded for years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e968acea-8a9a-3ac5-8c27-72022ff9a4c9",
                                        "entry_id": "ae1917ee-f777-3c4a-a32b-f0423457c52e",
                                        "glosses": [
                                            "A first offense by a lawbreaker, as counted by a three-strikes law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9f59b77-7ecd-41bc-a163-c5abff5e901c",
                                                "sense_id": "e968acea-8a9a-3ac5-8c27-72022ff9a4c9",
                                                "text": "His first strike was when he stole a car to go for a joyride."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb1e39d5-4623-3d12-9526-1c6ec93d6c7f",
                                        "entry_id": "ae1917ee-f777-3c4a-a32b-f0423457c52e",
                                        "glosses": [
                                            "One of the first few coins struck from a new set of dies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "182cad4f-7cee-4613-a081-4703ca5eb5f8",
                                                "sense_id": "eb1e39d5-4623-3d12-9526-1c6ec93d6c7f",
                                                "text": "Collectors pay a premium for first strikes in order to get their hands on coins with the crispest possible detailing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
