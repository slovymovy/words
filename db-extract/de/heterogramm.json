                "senses": [
                    {
                        "sense_id": "84f082f9-2d25-30ff-af28-dea359736d02",
                        "entry_id": "f15e62ee-7075-370f-b53d-335aad31149b",
                        "glosses": [
                            "aus einer anderen Sprache (Quellsprache) übernommene Schreibweise eines Wortes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88dddcc5-9c0b-457a-b7de-1bd330681d16",
                                "sense_id": "84f082f9-2d25-30ff-af28-dea359736d02",
                                "text": "Heterogramme kommen vor allem bei entlehnten Abkürzungen vor, wie „etc.“ (lateinisch „et cetera“), das als Ersatz für die deutsche Entsprechung „und so weiter“ („usw.“) verwendet wird."
                            },
                            {
                                "example_id": "061eda41-4217-4cc3-bc93-4a4924c05af8",
                                "sense_id": "84f082f9-2d25-30ff-af28-dea359736d02",
                                "text": "Statt Zahlen auszuschreiben („zwei, drei, sieben“), benutzt man häufig die arabischen Ziffern („2, 3, 7“) als Heterogramme."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "20baf08a-56ea-370f-9478-1399a786a1cb",
                        "entry_id": "f15e62ee-7075-370f-b53d-335aad31149b",
                        "glosses": [
                            "Wort oder Satz, in dem jeder Buchstabe nur einmal vorkommt"
                        ],
                        "tags": [
                            "Literaturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "e24f8297-1f8e-48a0-90e1-65b292b7964f",
                                "sense_id": "20baf08a-56ea-370f-9478-1399a786a1cb",
                                "text": "Das Kunstwort „Heizölrückstoßabdämpfung“ ist das längste deutsche Heterogramm, es erscheint also kein Buchstabe mehr als einmal."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
