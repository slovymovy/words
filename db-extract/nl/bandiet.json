                                        "entry_id": "42bb4d99-2922-3017-9b4d-aed8b32fb7ad",
                                        "glosses": [
                                            "chi approfitta delle pause dopo le guerre, talvolta prima delle pacificazioni, per ottenere più o meno illegalmente ricchezze e beni apparentemente non considerati da altri, cioè le loro ambite vittime"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f5bc2e8-be57-4a6d-bf0f-5590f3e4b2a4",
                                                "sense_id": "df5b84f1-29ee-3779-9c3c-6cd6bbfd2863",
                                                "text": "\"Non dico che debbano esserci dei prezzi da capogiro ma ci sono parecchi banditi che si accorgono dei vantaggi qui presenti\""
                                            }
