                "senses": [
                    {
                        "sense_id": "f6d272b0-e407-3e3b-86bf-8a0717167ba4",
                        "entry_id": "7eb955c7-a5f2-3af3-aa61-ebf1f0065e28",
                        "glosses": [
                            "Spitze eines Stiefels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b920802f-2e63-4964-94e0-48fa594109b1",
                                "sense_id": "f6d272b0-e407-3e3b-86bf-8a0717167ba4",
                                "text": "„Dann ist Lampe erneut verschwunden, und Hamann starrt nur noch verstört auf seine Stiefelspitzen.“"
                            },
                            {
                                "example_id": "432d3c51-9122-434b-8cf8-ee260c6798da",
                                "sense_id": "f6d272b0-e407-3e3b-86bf-8a0717167ba4",
                                "text": "„Sachte stupste mich eine Stiefelspitze.“"
                            },
                            {
                                "example_id": "5cb7c86f-3618-4ae2-993f-44715b5510ef",
                                "sense_id": "f6d272b0-e407-3e3b-86bf-8a0717167ba4",
                                "text": "„Kutusow betrachtete seine Stiefelspitzen und sah sich dazwischen nach dem Hofe des Nachbarhauses um, als habe er von dort her etwas Unangenehmes zu erwarten, und tatsächlich kam, während Denissow noch redete, aus diesem Hause ein General mit einer Mappe unter dem Arm und ging über den Hof auf Kutusows Quartier zu.“"
                            },
                            {
                                "example_id": "e39324bd-d69e-4b4d-9aea-3e3c7ae3d88f",
                                "sense_id": "f6d272b0-e407-3e3b-86bf-8a0717167ba4",
                                "text": "„Mit der Stiefelspitze stieß er den Mann am Fuß an und musterte die umliegenden flachen Hügel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
