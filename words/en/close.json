                        "pl": "Doprowadzić coś do końca; skończyć lub sfinalizować."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрывать",
                                "target_lang_sense_clarification": "сделку, собрание"
                            },
                            {
                                "target_lang_word": "завершать",
                                "target_lang_sense_clarification": "дело, процесс"
                            },
                            {
                                "target_lang_word": "заканчивать",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "pl": [
