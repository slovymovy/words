                "senses": [
                    {
                        "sense_id": "b7f04b7d-b4f1-34d2-9edc-c747047b934d",
                        "entry_id": "b8fd0f76-ddd0-39b7-a426-ec6b7b931719",
                        "glosses": [
                            "Mettre en caractères italiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "472f2dab-e07a-4197-9302-8d4c2720725c",
                                "sense_id": "b7f04b7d-b4f1-34d2-9edc-c747047b934d",
                                "text": "A l'alinéa 2 italiser les mots et affiches."
                            },
                            {
                                "example_id": "133e6090-0907-4c31-b9bb-af88e1a15f31",
                                "sense_id": "b7f04b7d-b4f1-34d2-9edc-c747047b934d",
                                "text": "La terra incerta apparaissait sitôt franchies les limites des communes de Chasseneuil, de Migné ou de Nuret, elle guillemetait ou italisait aussi à l’oral, me faisant sentir, dans le ton, que la terra incerta était de mon vocabulaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7494b1f-a117-3012-85d6-26afaebe7b95",
                        "entry_id": "b8fd0f76-ddd0-39b7-a426-ec6b7b931719",
                        "glosses": [
                            "Donner un caractère italique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19d38fbb-8105-4a8e-a794-727443639a41",
                                "sense_id": "f7494b1f-a117-3012-85d6-26afaebe7b95",
                                "text": "Plus tard, ce faut le tour du paysage italique, ou italisé ; or s'il est un pays qui soit difficile à italiser, c'est la Suisse assurément."
                            }
                        ]
                    }
