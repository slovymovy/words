                    {
                        "form_id": "ef05fc27-d540-4f61-9417-8fb3192ec8c0",
                        "entry_id": "5149a039-e743-3af6-8a2b-aae19b8c9e06",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Rockzipfel"
                    },
                    {
                        "form_id": "a1e16f95-8974-47b1-86df-cd12900cedb3",
                        "entry_id": "5149a039-e743-3af6-8a2b-aae19b8c9e06",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Rockzipfel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3b13361a-746b-3026-b557-41b819cbfd7a",
                        "entry_id": "5149a039-e743-3af6-8a2b-aae19b8c9e06",
                        "glosses": [
                            "Fortsatz, Stoffende bei einem Rock"
                        ],
                        "tags": [
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "54bb5b06-80a5-4393-b00b-86a4959c0853",
                                "sense_id": "3b13361a-746b-3026-b557-41b819cbfd7a",
                                "text": "„Sein Atem fegte noch einige unpassende Wörter zusammen, dann schwieg er, erhob sich, klopfte sich den Staub ab und wischte sich die Tränen mit einem Rockzipfel trocken.“"
                            },
                            {
                                "example_id": "0a1bbdaa-c5af-43b7-8065-97239af87312",
                                "sense_id": "3b13361a-746b-3026-b557-41b819cbfd7a",
                                "text": "„Aber die kleine Hexe stolperte immer wieder über die Wurzeln und blieb mit dem Rockzipfel an den Zweigen hängen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d5dd5a56-2224-32b9-9fe2-b7fed7984aea",
                        "entry_id": "5149a039-e743-3af6-8a2b-aae19b8c9e06",
                        "glosses": [
                            "Schutz, Sicherheit und Geborgenheit, die eine Person (wie etwa die Mutter) bietet"
                        ],
                        "tags": [
                            "meist im übertragenen Sinne"
                        ],
                        "examples": [
                            {
                                "example_id": "934871ec-6b13-4982-be4c-6e2726d88445",
                                "sense_id": "d5dd5a56-2224-32b9-9fe2-b7fed7984aea",
                                "text": "„Mein wichtigster Halt in der Welt war der Rockzipfel meiner Mutter, er bedeutete für mich absolute Sicherheit und Schutz.“"
                            },
                            {
                                "example_id": "8f05d3a0-5e93-4c24-95b4-aaa45fbdf55b",
                                "sense_id": "d5dd5a56-2224-32b9-9fe2-b7fed7984aea",
                                "text": "„Jetzt siehst du, wie ich mich immer fühle, wenn du einem Rockzipfel nachläufst!“"
                            },
                            {
                                "example_id": "c2081c25-945c-49cc-8f7d-9fef2f45f35d",
                                "sense_id": "d5dd5a56-2224-32b9-9fe2-b7fed7984aea",
                                "text": "„Kinder, die am Rockzipfel der Mutter (oder der Großmutter) hängen, sich nicht von ihr trennen können und ihre Hand halten, wenn sie ins Sprechzimmer kommen.“"
                            },
                            {
                                "example_id": "a8dcfec6-dfe0-4bc3-a561-652e89f0d10c",
                                "sense_id": "d5dd5a56-2224-32b9-9fe2-b7fed7984aea",
                                "text": "„Die jungen Bonobos wetteifern am Rockzipfel ihrer Mütter um Positionen, und hochrangige Mütter verbessern ihre Aussicht auf eine große Enkelschar, indem sie den Söhnen Schützenhilfe leisten.“"
                            },
                            {
                                "example_id": "e4d267bd-700f-425b-a962-8fc40c78e591",
                                "sense_id": "d5dd5a56-2224-32b9-9fe2-b7fed7984aea",
                                "text": "„Schon als kleines Kind hatte sie stundenlang am Rockzipfel ihrer Oma gehangen, wenn sie zu Besuch in der alten Heimat ihres Vaters war, und hatte jeden Handgriff der Neapolitanerin in sich aufgesogen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
