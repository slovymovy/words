                "translations": [
                    {
                        "translation_id": "67d9b713-58fa-448e-880f-60f87b42d45d",
                        "source_entry_id": "6c70f5eb-47fb-3cba-8fd4-a2a01c0b7e73",
                        "source_sense_id": "a504a7f4-ffff-3f47-befc-d1f078f4e446",
                        "target_lang_word": "Jazzfan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jazzfan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7120bf76-1fb3-39cc-b8bb-981468db521e",
                                        "entry_id": "fa45965a-7651-3993-9ebe-fd21f0e154f0",
                                        "glosses": [
                                            "jemand, der ein Faible für Jazzmusik hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca7befee-cf36-453e-938c-2d0874b8f346",
                                                "sense_id": "7120bf76-1fb3-39cc-b8bb-981468db521e",
                                                "text": "„Rock interessierte mich sehr. Pop hingegen gar nicht. Rock war ein Gegenpol zu Pop. Ich war von Haus aus ein Jazzfan.“"
                                            },
                                            {
                                                "example_id": "ab535f33-d6d6-48f5-93d0-3fb91b6efb77",
                                                "sense_id": "7120bf76-1fb3-39cc-b8bb-981468db521e",
                                                "text": "„So nennt es Andreas Gfrerer, Jazzfan, Kunstfreund, Lokalpatriot und Besitzer der sechshundertfünfundsechzig Jahre alten „Blauen Gans“, Salzburgs ältestes Hotel, das an der Getreidegasse nur wenige Schritte von Mozarts Geburtshaus entfernt in Salzburgs touristischem Epizentrum residiert und das Gfrerer behutsam zu einem „Art Hotel“ modernisiert hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
