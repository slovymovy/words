                            "target_lang_translations": {
                                "ru": "Пани <w>Ягода</w> работает в нашем офисе."
                            }
                        },
                        {
                            "text": "Poznałem dzisiaj panią Annę <w>Jagodę</w>.",
                            "target_lang_translations": {
                                "ru": "Я познакомился сегодня с пани Анной <w>Ягодой</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
