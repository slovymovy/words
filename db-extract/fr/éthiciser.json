                "senses": [
                    {
                        "sense_id": "b483bad0-3ba2-3d29-9822-60f49f4b3ca7",
                        "entry_id": "22e36146-3431-3a33-99a0-4183d6a092af",
                        "glosses": [
                            "Donner un caractère éthique, ou plus éthique, à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9781b9d5-b50e-4204-873d-258ef5c7ab6b",
                                "sense_id": "b483bad0-3ba2-3d29-9822-60f49f4b3ca7",
                                "text": "Les barthiens de droite (au sens théologique du terme d’abord) privilégieront la subordination de l’éthique à la dogmatique, les barthiens de gauche auront tendance à éthiciser et même à politiser la doctrine;"
                            },
                            {
                                "example_id": "eb457ca2-df4b-42cf-a1e8-69bf64f4c060",
                                "sense_id": "b483bad0-3ba2-3d29-9822-60f49f4b3ca7",
                                "text": "La latitude est grande entre un «tout est possible» et un «il faut éthiciser»."
                            },
                            {
                                "example_id": "73560a64-4c83-4652-b1d5-531dd9ba4a45",
                                "sense_id": "b483bad0-3ba2-3d29-9822-60f49f4b3ca7",
                                "text": "Cinq ans après, j'ai choisi de revenir en philo pour « éthiciser » mes acquis."
                            }
                        ]
                    }
                ],
