                        ]
                    },
                    {
                        "translation_id": "3db85515-457d-4213-a595-e0badfad42f8",
                        "source_entry_id": "0d3268e2-f151-306c-b459-7a0dd8b475ce",
                        "source_sense_description": "peninsula — see also Crimean peninsula",
                        "target_lang_word": "Крым",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Крым",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1ce83e12-d4c2-3333-bb19-0c027deef373",
                                        "entry_id": "c5ac3704-3a3e-3938-aa8e-4bf56b379c0d",
                                        "glosses": [
                                            "геогр. полуостров на севере Чёрного моря, отделяющий от него Азовское"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a6183c8-bc5c-47fb-9771-afb0960f4bc1",
                                                "sense_id": "1ce83e12-d4c2-3333-bb19-0c027deef373",
                                                "text": "Кстати, недавно в «Московских ведомостях» нашёл статью о Крыме, о выселении из Крыма татар и о «запустении края»."
                                            },
                                            {
                                                "example_id": "7290e011-4f9d-458a-ae79-cf8716a61896",
                                                "sense_id": "1ce83e12-d4c2-3333-bb19-0c027deef373",
                                                "text": "Первая ссылка Пушкина выразилась в его командировке в распоряжение генерала Инзова и благодаря доброте и благородству последнего дала возможность Пушкину познакомиться с Крымом и Кавказом, с Украиной и Бессарабскими степями, создать «Кавказского пленника», «Бахчисарайский фонтан», «Братьев-разбойников» и задумать «Евгения Онегина»."
                                            },
                                            {
                                                "example_id": "4cbddfa4-8f21-4499-b89d-477cb87acf8f",
                                                "sense_id": "1ce83e12-d4c2-3333-bb19-0c027deef373",
                                                "text": "В начале девяностых годов я прожил месяца два в Крыму́."
                                            },
                                            {
                                                "example_id": "e0b7562c-5c75-44e4-b13e-100fd8f80c99",
                                                "sense_id": "1ce83e12-d4c2-3333-bb19-0c027deef373",
                                                "text": "Но моё предварительное представление о Крыме заставило меня увидеть его с гораздо большей зоркостью, чем если бы я приехал в Крым без всякого понятия о нём."
                                            },
                                            {
