                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a98b87f7-2997-47a7-8779-015caf674d9b",
                                                "sense_id": "bc16406a-9a8d-3a88-ad18-ddc6931e2d9e",
                                                "text": "This school is ranked in the first quartile."
                                            },
                                            {
                                                "example_id": "a41c681b-9413-4481-a9e5-2ae21c0f507d",
                                                "sense_id": "bc16406a-9a8d-3a88-ad18-ddc6931e2d9e",
                                                "text": "The Department for Transport's National Travel Survey shows that workers in the lowest income quartile are twice as likely to use public transport."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
