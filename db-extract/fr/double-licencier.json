                        "glosses": [
                            "Placer sous deux licences à la fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1919b0d2-bd5a-4f06-8f0e-e06d0d02671b",
                                "sense_id": "85dbdd8c-ebce-3ebc-9957-9bde18cafa1c",
                                "text": "Rien ne t’interdit, si tu es le seul et unique créateur du code (ou si tu es OK avec les autres créateurs) de double-licencier le code produit pour le framework."
                            },
                            {
                                "example_id": "bd9e5bde-126a-4330-9d3f-a1980dc2d8d8",
                                "sense_id": "85dbdd8c-ebce-3ebc-9957-9bde18cafa1c",
                                "text": "Mais, si je peux choisir de double-licencier \"ma\" prose, je ne peux pas faire ce que je veux avec la prose d’autrui :-)"
                            },
                            {
                                "example_id": "7e1c080b-320f-40b0-9a9f-7f74361fd0d1",
                                "sense_id": "85dbdd8c-ebce-3ebc-9957-9bde18cafa1c",
                                "text": "Toutes mes contributions passées et à venir sont double-licenciées comme suit : (...)"
                            }
                        ]
