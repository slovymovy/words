                                "example_id": "52991b75-5540-4bc1-b9fd-727fc1c3a5f5",
                                "sense_id": "6c87588a-bd6d-3e8e-af67-9c05484a9486",
                                "text": "„›Komm zurück‹, ruft Polly ihm nach, aber Zecke wird seine kleine Schwester nicht im Stich lassen, selbst wenn sie nur ein blutsaugender Klumpen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
