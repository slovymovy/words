                    {
                        "sense_id": "6e6e95c7-ba94-34d2-ac71-ea5a1228c13e",
                        "entry_id": "b4a6db1e-994b-3dc4-a047-f8630e8b1878",
                        "glosses": [
                            "lewkonia długopłatkowa"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "358cfbf3-7ce3-43a0-ac78-daf1719857f5",
                                "sense_id": "6e6e95c7-ba94-34d2-ac71-ea5a1228c13e",
                                "text": "Rosnące na rabatce pani Krysi maciejki, pięknie pachniały."
                            },
                            {
                                "example_id": "3e201cc1-11e4-463c-9a38-7a5bbeee1e94",
                                "sense_id": "6e6e95c7-ba94-34d2-ac71-ea5a1228c13e",
                                "text": "Choć każdy kwiat upiększa świat, konwalie, bratki, bzy, piwonie, też, maciejka w letni zmierzch, lecz gdzież jest kwiat bez ludzkich wad, co zawsze wierny jest: wśród trawy lśni, jak ja wierny ci."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
