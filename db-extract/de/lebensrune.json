                "senses": [
                    {
                        "sense_id": "9b51221b-2ca7-38c2-b241-348743b25397",
                        "entry_id": "8ddb6e9b-e477-3a98-a61e-678faa86f2b4",
                        "glosses": [
                            "The rune ᛉ (Algiz), symbolizing life according to Ariosophy."
                        ],
                        "tags": [
                            "Nazism",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "3d98e65c-ccdf-4d28-974a-892c87dfc6b5",
                                "sense_id": "9b51221b-2ca7-38c2-b241-348743b25397",
                                "text": "Ein Kamerad baute einen Dachdeckerbetrieb auf und wirbt mit der bei Neonazis beliebten Lebensrune für seine Firma."
                            },
                            {
                                "example_id": "9190b8e2-5ce8-4363-ba86-7f618ee6b892",
                                "sense_id": "9b51221b-2ca7-38c2-b241-348743b25397",
                                "text": "Der Grund für dieses Nichtdurchdringen, Nichtaufgefaßtwerden der positiven und negativen Lebensrune, wo doch das SS-Bild sich restlos durchsetzte, ist ohne weiteres anzugeben. […] Aber wenn sie nun doch durchgedrungen und während der Hitlerzeit alleinherrschend gewesen wären, diese Lebensrunen—wäre ich um die Begründung des Faktum in Verlegenheit gewesen?"
                            }
                        ]
                    }
