                "translations": [
                    {
                        "translation_id": "f3245240-97cd-43ee-80a5-3770dc15ceca",
                        "source_entry_id": "cfb5657b-f746-31e1-8377-1c6ea36f23fe",
                        "source_sense_id": "eee4e29b-eafb-3761-af8d-500cc2bb83cb",
                        "source_sense_description": "een dier dat in holen leeft",
                        "target_lang_word": "Höhlenbewohner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Höhlenbewohner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f09cb2a9-13e1-3a47-9234-aa118e393e86",
                                        "entry_id": "b22d3aa6-f15f-369b-b4fd-f5fd159027a1",
                                        "glosses": [
                                            "Person, die in einer (Wohn)höhle lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "497686f1-fd8f-40b1-a081-86dc4c448431",
                                                "sense_id": "f09cb2a9-13e1-3a47-9234-aa118e393e86",
                                                "text": "„Die Art, wie die Touristen sich umsahen, lachten und Fotos von den Höhlenbewohnern in ihren seltsam anmutenden Behausungen machten, hatte etwas Voyeuristisches an sich.“"
                                            },
                                            {
                                                "example_id": "7bd598ca-d97c-4761-9938-eedde0de03dd",
                                                "sense_id": "f09cb2a9-13e1-3a47-9234-aa118e393e86",
                                                "text": "„Nachdem das Feuer kräftig geschürt worden war, legten sich die Höhlenbewohner schlafen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "24e22450-014b-30f3-a8fc-99808e456cfa",
                                        "entry_id": "b22d3aa6-f15f-369b-b4fd-f5fd159027a1",
                                        "glosses": [
                                            "Tier, das in einer Höhle lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d64e0ff-3718-4360-9811-edc75585e490",
                                                "sense_id": "24e22450-014b-30f3-a8fc-99808e456cfa",
                                                "text": "„Unter den Fischen gehören die Welse zu den erfolgreichsten Höhlenkolonisatoren. Repräsentanten aus mindestens acht Familien sind Höhlenbewohner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "742c537a-25bf-4c4e-ac53-845a60ded00f",
                        "source_entry_id": "cfb5657b-f746-31e1-8377-1c6ea36f23fe",
