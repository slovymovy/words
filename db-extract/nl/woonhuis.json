                ],
                "senses": [
                    {
                        "sense_id": "a066a4da-ed12-31c9-99f1-9b591160aa44",
                        "entry_id": "afc72c1d-3f95-3267-911b-b4c701474155",
                        "glosses": [
                            "bouwwerk waarin mensen kunnen wonen"
                        ],
                        "tags": [
                            "wonen"
                        ],
                        "examples": [
                            {
                                "example_id": "94943070-83b6-4e47-8084-6f30e2e55e6d",
                                "sense_id": "a066a4da-ed12-31c9-99f1-9b591160aa44",
                                "text": "Een woonhuis moet voor de heffing van erfbelasting verplicht gewaardeerd worden op de WOZ-waarde."
                            },
                            {
                                "example_id": "2403c20e-b9c4-4bcf-85fe-5584ef1b1536",
                                "sense_id": "a066a4da-ed12-31c9-99f1-9b591160aa44",
                                "text": "Het paleis doet tegenwoordig dienst als raadhuis en op de plek van het woonhuis van Willem II ligt nu een plein. Daar stond ook een gedenknaald voor Willem II, maar die werd in de jaren 60 afgebroken om ruimte te maken voor een rondweg en een fontein. Omdat de koninklijke familie de grond nooit verkocht heeft, is dat nog steeds eigendom van de Oranjes. \"Dat zijn ze gewoon vergeten af te handelen\", zegt Peeters."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90332f73-979d-4381-b891-16cd258e2d14",
                        "source_entry_id": "afc72c1d-3f95-3267-911b-b4c701474155",
                        "source_sense_id": "a066a4da-ed12-31c9-99f1-9b591160aa44",
                        "source_sense_description": "Een huis, woning of (Vlaams) woonst is een bouwwerk waarin mensen kunnen wonen.",
                        "target_lang_word": "Wohnhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohnhaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "292aeed3-04af-3315-b6ca-d43d473b3969",
                                        "entry_id": "90d77b46-d27d-328a-8013-ea2c8eb7dde9",
                                        "glosses": [
                                            "Haus, das zum Bewohnen gedacht ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "053e1f0d-76df-4b48-9f80-2e1f97c731eb",
                                                "sense_id": "292aeed3-04af-3315-b6ca-d43d473b3969",
                                                "text": "Hier wird ein Wohnhaus gebaut."
                                            },
                                            {
                                                "example_id": "06574538-17d4-4376-b1f1-22a00ebdcd8f",
                                                "sense_id": "292aeed3-04af-3315-b6ca-d43d473b3969",
                                                "text": "„Bei der Explosion eines Wohnhauses in Stuhr bei Bremen ist am Freitag ein 59-jähriger Mann lebensgefährlich verletzt worden.“"
                                            },
                                            {
                                                "example_id": "8e86617e-859e-4a09-92b2-c9f8e8a33011",
                                                "sense_id": "292aeed3-04af-3315-b6ca-d43d473b3969",
                                                "text": "„Wir kamen an dem verlassenen Wohnhaus des Peace Corps vorbei.“"
                                            },
                                            {
                                                "example_id": "39944f71-69bb-4669-8563-ad8818653288",
                                                "sense_id": "292aeed3-04af-3315-b6ca-d43d473b3969",
                                                "text": "„Die Wohnhäuser werden jetzt höher und die Weingärten ringsherum größer.“"
                                            },
                                            {
                                                "example_id": "bb684493-d746-4721-971b-0d3294c5e4fc",
                                                "sense_id": "292aeed3-04af-3315-b6ca-d43d473b3969",
                                                "text": "„Ägyptische Wohnhäuser, einfachste Behausungen genauso wie Königspaläste, sind aus sonnengetrockneten Nilschlammziegeln gemauert, die einerseits ohne größere Kosten herzustellen sind und andererseits für das heiße, trockene Ägypten besonders günstige bauklimatische Eigenchaften aufweisen.“"
                                            },
                                            {
                                                "example_id": "2178a884-eec3-4138-8300-edec7cdad041",
                                                "sense_id": "292aeed3-04af-3315-b6ca-d43d473b3969",
                                                "text": "„Am 6.Februar wurde eine Handgranate auf sein Wohnhaus geworfen, ohne jedoch Schaden anzurichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
