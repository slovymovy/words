                        "entry_id": "7e37039e-7ab8-3efb-a564-0cc1efd4d5c7",
                        "glosses": [
                            "A bait for eels, consisting of a bundle of live worms."
                        ],
                        "tags": [
                            "East-Anglia"
                        ],
                        "examples": [
                            {
                                "example_id": "4242de07-9bd1-416f-8986-da29aa2c62c8",
                                "sense_id": "1f03f1c6-0bc6-3e62-92a8-9455ab41ce5d",
                                "text": "The worms were threaded onto the yarn until we had 4 or 5 feet of big juicy worms threaded through. We would coil it all up and put an old rusty nut at the centre and tie it on a bit of string on an old ash pole — this was the bab."
                            }
                        ]
                    }
