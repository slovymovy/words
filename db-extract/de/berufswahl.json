                "senses": [
                    {
                        "sense_id": "b5d9f668-96cc-3ea4-b9f6-d19b9ff33594",
                        "entry_id": "de980494-7d7a-344b-a971-99fbc9298dc4",
                        "glosses": [
                            "Entscheidung einer Person, welchen Beruf sie ergreifen möchte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e23a7e5-9ccd-4011-87cd-ee54f86a1b9b",
                                "sense_id": "b5d9f668-96cc-3ea4-b9f6-d19b9ff33594",
                                "text": "„Aber im letzten Jahr hatte sie sich in den Zeitungen informiert, über die Berufswahl nachgedacht, und vor allem mit ihren Freundinnen darüber geredet, dass es schwierig sein würde, Arbeit zu finden, wie viel Mühe man sich auch gab.“"
                            },
                            {
                                "example_id": "4053cf96-3c8a-4e09-be53-3a5b182b4c80",
                                "sense_id": "b5d9f668-96cc-3ea4-b9f6-d19b9ff33594",
                                "text": "„Er öffnete mir sein Herz und bat mich, seine Schwester zu überreden, daß sie seiner Berufswahl zustimme.“"
                            },
                            {
                                "example_id": "1d8448c3-0cc2-4206-965c-a1630d22bfdc",
                                "sense_id": "b5d9f668-96cc-3ea4-b9f6-d19b9ff33594",
                                "text": "„Um so erstaunlicher ist es, daß Vater Busch sich überhaupt dazu bringen konnte, der ihm vollkommen illusorisch erscheinenden Berufswahl des Sohnes schließlich zuzustimmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
