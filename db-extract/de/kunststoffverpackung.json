                                "example_id": "eefa2030-7402-4b18-899c-d40c7c125961",
                                "sense_id": "ef7a0275-f3b3-3dc8-bcdf-9886eebb6424",
                                "text": "„Er kramt eine leere Kunststoffverpackung für Taschentücher raus und bietet sie mir an.“"
                            },
                            {
                                "example_id": "bbfce6eb-ba30-4632-a880-d7e730089e98",
                                "sense_id": "ef7a0275-f3b3-3dc8-bcdf-9886eebb6424",
                                "text": "„Jetzt öffnete er vorsichtig die Kunststoffverpackung und holte einen Zettel heraus, den er auf den Tisch legte.“"
                            }
                        ],
