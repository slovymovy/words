                                        "sense_id": "1bc54799-9cf9-36fe-98a0-8ce103edcf77",
                                        "entry_id": "a3bcdaf8-83c8-32d1-b869-8850341e9960",
                                        "glosses": [
                                            "een crisis rondom de uitbraak van een coronavirus"
                                        ],
                                        "tags": [
                                            "maatschappij"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29da7564-fe4c-468a-a6ef-495f26c9198b",
                                                "sense_id": "1bc54799-9cf9-36fe-98a0-8ce103edcf77",
                                                "text": "De coronacrisis leidde tot een lockdown van Italië en Spanje."
                                            },
                                            {
                                                "example_id": "ade8f5a1-90a4-439b-bfe6-44c050ae21b8",
                                                "sense_id": "1bc54799-9cf9-36fe-98a0-8ce103edcf77",
                                                "text": "Een bloemenkweker uit het Gelderse Heumen zit met 300.000 gladiolen in zijn maag. De bloemen waren bedoeld voor deelnemers aan de Nijmeegse Vierdaagse, maar die is vanwege de coronacrisis afgelast."
                                            },
                                            {
                                                "example_id": "bd4cb90f-61aa-42b1-a1bc-0427c6a9c7f0",
                                                "sense_id": "1bc54799-9cf9-36fe-98a0-8ce103edcf77",
                                                "text": "Hij (Remkes) bestrijdt de veel gehoorde suggestie dat de coronacrisis het stikstofprobleem afgelopen maanden als het ware vanzelf heeft opgelost. “De abrupte afname van emissies van stikstofoxiden is naar verwachting tijdelijk en de ammoniakemissies van de landbouw zijn afgelopen maanden niet afgenomen,” aldus Remkes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
