            {
                "entry_id": "c580c817-2205-394c-9eaa-a8a6c20ebd78",
                "word": "cassie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9bc3d92f-8e8f-4841-a286-e1d030ad3577",
                        "entry_id": "c580c817-2205-394c-9eaa-a8a6c20ebd78",
                        "tags": [
                            "plural"
                        ],
                        "form": "cassies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3993a24f-ff08-30f2-8584-a7f9a34e7771",
                        "entry_id": "c580c817-2205-394c-9eaa-a8a6c20ebd78",
                        "glosses": [
                            "Variété de mimosa qu’on cultive dans le midi de la France pour ses fleurs jaunes très odorantes employées en parfumerie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df3cc9f8-95e4-47dd-b39b-08884dd1a481",
                                "sense_id": "3993a24f-ff08-30f2-8584-a7f9a34e7771",
                                "text": "Elle écartait sa mantille afin de montrer ses épaules et un gros bouquet de cassie qui sortait de sa chemise."
                            },
                            {
                                "example_id": "fe729ac9-70be-43c7-b232-1365f7d731e6",
                                "sense_id": "3993a24f-ff08-30f2-8584-a7f9a34e7771",
                                "text": "Il composa encore du thé en mélangeant de la cassie et de l’iris."
                            },
                            {
                                "example_id": "77941eb7-17e3-4685-82db-9f2f47ae7909",
                                "sense_id": "3993a24f-ff08-30f2-8584-a7f9a34e7771",
                                "text": "Mais Nane est insensible à ces nuances. Aussi ne lui parlerai-je point des petits ports hindous, où l’on respire le safran et le poisson salé ; ni du Maroc, empire fleuri, aromatisé de jonquille ; non plus que de cette île créole qui répandait au loin, sur la mer nocturne, l’âme des cassies et des gérofliers."
                            }
                        ]
                    },
                    {
                        "sense_id": "226bf18f-f66d-3b12-9063-5c22c811c846",
                        "entry_id": "c580c817-2205-394c-9eaa-a8a6c20ebd78",
                        "glosses": [
                            "Parfum extrait de la plante."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "11339fbe-1017-427c-8ee8-ea39bf4af805",
                                "sense_id": "226bf18f-f66d-3b12-9063-5c22c811c846",
                                "text": "Je vous (…) rapporterai de la cassie, si vous appréciez toujours ce parfum-là."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
