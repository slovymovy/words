                "senses": [
                    {
                        "sense_id": "ee0b801a-e3c8-36c0-8fb3-36f7b6de20b7",
                        "entry_id": "df248b4c-4695-3ad7-bff6-49d51a047b3b",
                        "glosses": [
                            "An early type of railway that used flanged rails rather than flanged wheels."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e50a03c2-131d-3a1f-a4c6-2f9590465dc4",
                        "entry_id": "df248b4c-4695-3ad7-bff6-49d51a047b3b",
                        "glosses": [
                            "The gap in road surfaces, running rails at rails at junctions, etc, that allows the wheel flange of a rail vehicle to pass."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3bfd871-8e0d-4eaa-9d0e-705e541a521a",
                                "sense_id": "e50a03c2-131d-3a1f-a4c6-2f9590465dc4",
                                "text": "The factors in determining the width of flangeways between check rails and the main rail are the thickness of the wheel flange and the clearance allowed […]"
                            },
                            {
                                "example_id": "4de50e00-5e73-4c5b-9da8-c8b813b7e958",
                                "sense_id": "e50a03c2-131d-3a1f-a4c6-2f9590465dc4",
                                "text": "The use of a high-temperature gas torch for melting the ice out of the check-rail flangeways, was found to be effective, although somewhat tedious; neglect of this precaution may cause derailment, [...]."
                            },
                            {
                                "example_id": "fa66282f-7ad2-4c11-b9d1-800954a0f621",
                                "sense_id": "e50a03c2-131d-3a1f-a4c6-2f9590465dc4",
                                "text": "Insure that ample flangeway is available between the open point of switch and the stock rail; this is controlled by flange width of crane wheels using the track system"
                            },
                            {
                                "example_id": "409787c9-33f2-49e8-97ee-85c1be986c38",
                                "sense_id": "e50a03c2-131d-3a1f-a4c6-2f9590465dc4",
                                "text": "Available at most hobby shops, this tool allows you to check track gauge, flangeway spacing and width, and many other dimensions."
                            }
                        ]
                    }
                ],
