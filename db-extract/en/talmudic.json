    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "db5ce45e-e44e-3a08-aa0f-bb7b6e88c779",
                "word": "Talmudic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b601a0f7-5ea8-3b79-9d4d-b3cb375d870d",
                        "entry_id": "db5ce45e-e44e-3a08-aa0f-bb7b6e88c779",
                        "glosses": [
                            "Of or relating to the Talmud."
                        ],
                        "tags": [
                            "Judaism",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b9487cef-4f93-4cac-8d17-7663a4fe6cf0",
                                "sense_id": "b601a0f7-5ea8-3b79-9d4d-b3cb375d870d",
                                "text": "Talmudic tradition (Shabbat 92a) connects them with a hekesh, teaching that both reached full stature: “Just as the mishkan was ten cubits tall, so too the altar was ten cubits tall.”"
                            },
                            {
                                "example_id": "aa414a73-379e-4e06-bd98-43613606b2f6",
                                "sense_id": "b601a0f7-5ea8-3b79-9d4d-b3cb375d870d",
                                "text": "Various textual analyses are provided by a criminologist, an anthropologist, a researcher in lexicometry and a Talmudic exegete."
                            }
                        ]
                    },
                    {
                        "sense_id": "af2b1718-273c-3a3e-bbad-53caecf7dc18",
                        "entry_id": "db5ce45e-e44e-3a08-aa0f-bb7b6e88c779",
                        "glosses": [
                            "Of or relating to the era of Jewish history, immediately following the destruction of the Second Temple, during which the Talmud was being compiled (c. 70–500 AD)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8a46ead3-be00-4aa6-a2c0-6ef21bd8f1c3",
                                "sense_id": "af2b1718-273c-3a3e-bbad-53caecf7dc18",
                                "text": "the Talmudic period"
                            },
                            {
                                "example_id": "1bbf1399-f332-419f-b5ce-bc77b93e1a88",
                                "sense_id": "af2b1718-273c-3a3e-bbad-53caecf7dc18",
                                "text": "post-Talmudic writers"
                            }
                        ]
                    },
                    {
                        "sense_id": "da83375e-8b1d-3c70-a4de-f407b5683093",
                        "entry_id": "db5ce45e-e44e-3a08-aa0f-bb7b6e88c779",
                        "glosses": [
                            "Making extremely fine distinctions in a manner reminiscent of the Talmud; hairsplitting."
                        ],
                        "tags": [
                            "broadly",
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21334cab-6915-4170-9bba-cb89a3fca439",
                        "source_entry_id": "db5ce45e-e44e-3a08-aa0f-bb7b6e88c779",
                        "source_sense_description": "related to the Talmud",
                        "target_lang_word": "talmudský",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "talmudský",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "df37ef20-14e9-3197-aee3-f5f0adce3a7a",
                                        "entry_id": "aeb16d53-bd8d-3c5a-bf85-bc37e801e860",
                                        "glosses": [
                                            "související s talmudem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e13cf003-aedb-42eb-9537-1816ca2d92e4",
                                                "sense_id": "df37ef20-14e9-3197-aee3-f5f0adce3a7a",
                                                "text": "Rabín a jeho dva přísedící, všichni tři znalci talmudského práva na slovo vzatí, vyslechli obě sporné strany, načež je vykázali ze síně, aby se poradili."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7ad16bf-4565-4258-9d9f-143b29d935ae",
                        "source_entry_id": "db5ce45e-e44e-3a08-aa0f-bb7b6e88c779",
                        "source_sense_description": "related to the Talmud",
                        "target_lang_word": "talmudický",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "talmudický",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "fbb9a9f5-01d3-3fd8-b1ca-7c4c0c371acc",
                                        "entry_id": "8156aeaa-d33a-3d3f-b8fd-1b819e5515fe",
                                        "glosses": [
                                            "týkající se talmudu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "879abc6a-2028-43a2-9294-638b1b90e478",
                                                "sense_id": "fbb9a9f5-01d3-3fd8-b1ca-7c4c0c371acc",
                                                "text": "Když nechápu některý z těch nemálo složitých problémů talmudických, obracím se k němu staršímu, aby mi jej vyložil."
                                            },
                                            {
                                                "example_id": "d261708b-2856-4b79-a097-54a8a6850137",
                                                "sense_id": "fbb9a9f5-01d3-3fd8-b1ca-7c4c0c371acc",
                                                "text": "Rabi Núsn Adler uměl všechny ty své přetěžké talmudické přednášky zpaměti a jen zpaměti svým žákům přednášel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a875d66-7ffe-47a4-aa25-1688e3efcd76",
                        "source_entry_id": "db5ce45e-e44e-3a08-aa0f-bb7b6e88c779",
                        "source_sense_description": "related to the Talmud",
                        "target_lang_word": "talmudique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "talmudique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "364984d0-dafc-3f74-bffa-fbbfb9cd8d06",
                                        "entry_id": "1554989c-ef16-33b2-864c-12854fc77831",
                                        "glosses": [
                                            "Relatif au Talmud."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63ea21fe-d384-421d-ab6d-dc32f853e718",
                                                "sense_id": "364984d0-dafc-3f74-bffa-fbbfb9cd8d06",
                                                "text": "En 1250, on voit encore les dominicains faire la chasse aux livres juifs. Tracasseries et saisies se multiplient. Aussi les écoles talmudiques se disloquent-elles."
                                            },
                                            {
                                                "example_id": "b1979ec5-773a-464a-b79f-eb9e20f6aa82",
                                                "sense_id": "364984d0-dafc-3f74-bffa-fbbfb9cd8d06",
                                                "text": "En attendant ce miracle, la population campe, patiente et résignée, sur les trottoirs, rêve devant les étalages de livres de prières, les mystères talmudiques, qui ressemblent sous le verre des vitrines à des tapis, les romans d’amour ou de sport en langue hébraïque, dont les caractères évoquent des dessins de grilles, des formes de guisarmes ou d’artichauts, des gardes de sabres."
                                            },
                                            {
                                                "example_id": "582b763e-1351-464e-8c38-22b44d180647",
                                                "sense_id": "364984d0-dafc-3f74-bffa-fbbfb9cd8d06",
                                                "text": "Alors que l'attente messianique est devenue au fil des siècles omniprésente dans la liturgie juive, on ne peut qu'être frappé du peu de place qu'elle occupe dans la littérature talmudique."
                                            },
                                            {
                                                "example_id": "8f7ade7c-efee-4ea9-9555-289befd3ceff",
                                                "sense_id": "364984d0-dafc-3f74-bffa-fbbfb9cd8d06",
                                                "text": "La magie talmudique a également exercé une influence sur les exorcismes antiques en établissant un lien de proximité entre les hommes et les êtres surnaturels, notamment grâce à l’invocation ritualisée des anges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69f219dc-911b-493a-b001-bc48125883dd",
                        "source_entry_id": "db5ce45e-e44e-3a08-aa0f-bb7b6e88c779",
                        "source_sense_description": "related to the Talmud",
                        "target_lang_word": "talmudisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "talmudisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "20f2f500-c5c3-3bfd-8ba6-04e7de2cc4a5",
                                        "entry_id": "e586a70d-ba92-3970-b769-9f12237b56dc",
                                        "glosses": [
                                            "sich auf den Talmud beziehend, ihm zugehörig; im Sinne des Talmuds"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b8f881a-f9f0-4cd4-86cf-268db3622d1c",
                                                "sense_id": "20f2f500-c5c3-3bfd-8ba6-04e7de2cc4a5",
                                                "text": "„Talmudischer als der Talmud braucht kein Orthodoxer zu sein.“"
                                            },
                                            {
                                                "example_id": "eb9a79ab-586b-46d6-897c-fb92efa73576",
                                                "sense_id": "20f2f500-c5c3-3bfd-8ba6-04e7de2cc4a5",
                                                "text": "„»Gestern, Herr Oberleutnant, sind Sie mehr gewesen als ich, jetzt sind wir vorläufig einmal gleich – aber morgen um die Zeit wird wieder einer von uns mehr sein, als der andere.« »Etwas talmudisch«, bemerkte Breitner.“"
                                            },
                                            {
                                                "example_id": "e5724a81-16b4-47c0-a0bf-63ccada45d61",
                                                "sense_id": "20f2f500-c5c3-3bfd-8ba6-04e7de2cc4a5",
                                                "text": "„Sie waren Juden nicht nur durch ihr Schicksal, sondern auch, wegen ihrer talmudisch geschulten Denkweise, ihrer Art, Fragen zu stellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
