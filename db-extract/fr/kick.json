                                "sense_id": "033d084e-85b4-3d93-9b3d-2105b5210c75",
                                "text": "Il regarda le plafond, prononça une petite prière, puis sauta de tout son poids sur le kick."
                            },
                            {
                                "example_id": "00ae62b9-7775-41d3-86f7-c1def211d0c1",
                                "sense_id": "033d084e-85b4-3d93-9b3d-2105b5210c75",
                                "text": "Michel rangea son téléphone, et s’arc-boutant de toutes ses forces sur le kick remit les gaz, démarrant dans une pétarade des années twist."
                            },
                            {
                                "example_id": "282f8b40-a6b9-4867-a1f4-251ba8832bbe",
                                "sense_id": "033d084e-85b4-3d93-9b3d-2105b5210c75",
                                "text": "Il fit jouer son tournevis dans le neiman puis empoigna le guidon pour briser la résistance d’un coup sec. Il n’avait plus qu’à actionner le kick."
                            }
                        ]
                    }
