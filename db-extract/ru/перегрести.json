                "senses": [
                    {
                        "sense_id": "c5f39fc9-3dc8-3563-b8ba-ad8074cef5b8",
                        "entry_id": "4e7ec4c0-d455-3839-8307-d24b1744e9f1",
                        "glosses": [
                            "гребя, сгребая, переместить куда-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a10802e-b9af-445f-a717-c13990aff2d0",
                                "sense_id": "c5f39fc9-3dc8-3563-b8ba-ad8074cef5b8",
                                "text": "Перегрести снег со двора на огород."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa2c482c-afd7-3ae2-b8a1-6102eb77db60",
                        "entry_id": "4e7ec4c0-d455-3839-8307-d24b1744e9f1",
                        "glosses": [
                            "сгрести всё, многое"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5a887a3-57e0-4bcd-8c74-bcd8c75ca22d",
                                "sense_id": "aa2c482c-afd7-3ae2-b8a1-6102eb77db60",
                                "text": "Перегрести все сено."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0e3cc71-96ec-39d3-aa28-72d9cedc9d73",
                        "entry_id": "4e7ec4c0-d455-3839-8307-d24b1744e9f1",
                        "glosses": [
                            "проявить преимущество над кем-либо в гребле"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46ae7c44-0491-48fc-8c2d-df46347d1aa2",
                                "sense_id": "b0e3cc71-96ec-39d3-aa28-72d9cedc9d73",
                                "text": "Мальчик влез в нее шаланду и сел грести рядом с дедушкой. Каждый из них работал одним веслом. Это было легко и весело: кто кого перегребет?"
                            }
                        ]
                    },
                    {
                        "sense_id": "ff5bb3f3-5d9d-31aa-8ba2-6ddea99295b0",
                        "entry_id": "4e7ec4c0-d455-3839-8307-d24b1744e9f1",
                        "glosses": [
                            "разг. выполнить в избыточном количестве"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8602bf05-e871-4719-a2c4-2509bb70686d",
                                "sense_id": "ff5bb3f3-5d9d-31aa-8ba2-6ddea99295b0",
                                "text": "Ты что это, Вадя, - спросил Щитовидов с тихой, неназойливой мужской озабоченностью, - намедни перегрёб на работе или, наоборот, недогрёб?"
                            }
                        ]
                    }
                ],
