                    },
                    {
                        "translation_id": "d6db8ca5-aaea-416d-93da-df86edd12606",
                        "source_entry_id": "5c46d275-2570-3f53-8566-7de4ede0edee",
                        "source_sense_id": "881976ab-ee54-34d0-a6ff-2b55a64507fa",
                        "source_sense_description": "jemand, der professionell Schrott kauft und verkauft",
                        "target_lang_word": "ferrailleur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ferrailleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d52f57f0-00fd-361c-9c5f-1ace9d6eb266",
                                        "entry_id": "2ebd7118-4762-3bb0-b328-6d19917fade9",
                                        "glosses": [
                                            "Celui qui se bat souvent à l’épée, qui en cherche les occasions."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10d115a3-b0c5-44e0-b1b5-7c06eaf9812e",
                                                "sense_id": "d52f57f0-00fd-361c-9c5f-1ace9d6eb266",
                                                "text": "Fi ! monsieur de Wardes, continua Raoul, il ne sied point d’être ainsi ferrailleur quand nous avons des édits contre les duels."
                                            },
                                            {
                                                "example_id": "aa7c4694-e36d-4b3a-bf7f-8037d4fb51aa",
                                                "sense_id": "d52f57f0-00fd-361c-9c5f-1ace9d6eb266",
                                                "text": "Un coup d'épée galamment donné à un certain Alphonse Leduc, professeur de guitare à Nantes, … me posa en ferrailleur et en duelliste. On me citait comme une fine lame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ff59baa-c979-3cb3-b5f1-6b7fe9ffc223",
                                        "entry_id": "2ebd7118-4762-3bb0-b328-6d19917fade9",
                                        "glosses": [
                                            "Celui qui aime la dispute, qui en cherche les occasions."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41862801-6a25-3514-90fe-0f83d353948f",
                                        "entry_id": "2ebd7118-4762-3bb0-b328-6d19917fade9",
                                        "glosses": [
                                            "Marchand de ferraille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7936da46-05c4-4ee6-96ae-d485cdf9913e",
                                                "sense_id": "41862801-6a25-3514-90fe-0f83d353948f",
                                                "text": "Pour peindre ce quartier, il suffira de dire que les propriétaires de certaines maisons habitées par des industriels sans industries, par de dangereux ferrailleurs, par des indigents livrés à des métiers périlleux, n’osent pas y réclamer leurs loyers, et ne trouvent pas d’huissiers qui veuillent expulser les locataires insolvables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aaf18e9-7047-38b8-ae16-051a9c0216d6",
                                        "entry_id": "2ebd7118-4762-3bb0-b328-6d19917fade9",
                                        "glosses": [
                                            "Entreprise de recyclage des métaux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
