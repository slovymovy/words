        "fr-extract.jsonl": [
            {
                "entry_id": "90d6d10b-2ab6-3230-98a8-d152b5a91127",
                "word": "radiochronologie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b090b51a-3af4-47b2-bc94-e5522ba40109",
                        "entry_id": "90d6d10b-2ab6-3230-98a8-d152b5a91127",
                        "tags": [
                            "plural"
                        ],
                        "form": "radiochronologies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c59449d4-4533-3498-8a95-84ebf30db07f",
                        "entry_id": "90d6d10b-2ab6-3230-98a8-d152b5a91127",
                        "glosses": [
                            "Méthode de datation exprimée en année utilisant la variation régulière au cours du temps de la proportion de radio-isotopes dans certains corps."
                        ],
                        "tags": [
                            "Chimie physique"
                        ],
                        "examples": [
                            {
                                "example_id": "34888b78-ce50-42d9-af39-f7cefa97b03f",
                                "sense_id": "c59449d4-4533-3498-8a95-84ebf30db07f",
                                "text": "Les échantillons du sol lunaire rapportés par les missions Luna et Apollo ont pu être datés précisément par les méthodes de la radiochronologie, et leurs âges ont été corrélés avec la densité des cratères présents dans les terrains échantillonnés."
                            },
                            {
                                "example_id": "8c355fba-62cd-4aff-9b4a-5427bc30ba38",
                                "sense_id": "c59449d4-4533-3498-8a95-84ebf30db07f",
                                "text": "La plus connue et la plus ancienne des méthodes de radiochronologie est celle du célèbre carbone-14 ou ¹⁴C, élaborée avant la dernière guerre, mais perfectionné après."
                            },
                            {
                                "example_id": "58a2da87-39be-4283-b5d5-47c0b5953725",
                                "sense_id": "c59449d4-4533-3498-8a95-84ebf30db07f",
                                "text": "Les avancées conjuguées de la radiochronologie, de la géochimie isotopique, de la cosmochimie (science des matériaux extraterrestres dont le développement s'est accéléré avec les programmes spatiaux) ont aidé à la reconstitution des premiers instants de la Terre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b88bfaf9-fbeb-4d2c-ab67-f3c8ea5e66c3",
                        "source_entry_id": "90d6d10b-2ab6-3230-98a8-d152b5a91127",
                        "source_sense_id": "c59449d4-4533-3498-8a95-84ebf30db07f",
                        "target_lang_word": "radiometric dating",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radiometric dating",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed8dba60-cbbf-35bf-baf2-bc57b4d2c83b",
                                        "entry_id": "a6fdc25b-f51a-3ff2-8667-c0b902c9a19f",
                                        "glosses": [
                                            "Synonym of radioactive dating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67ca7f91-9028-4353-9792-f594e559651c",
                                                "sense_id": "ed8dba60-cbbf-35bf-baf2-bc57b4d2c83b",
                                                "text": "Perhaps the most significant achievement of radiometric dating over the past two decades has been to provide an absolute calibration, in years, for the traditional sedimentary time scale."
                                            },
                                            {
                                                "example_id": "f2e19cc8-01cb-4215-a6c6-74b8396f1de9",
                                                "sense_id": "ed8dba60-cbbf-35bf-baf2-bc57b4d2c83b",
                                                "text": "Radiometric dating of Moon rocks and meteorites has enabled us to determine that the age of the Earth is approximately 4.6 billion years."
                                            },
                                            {
                                                "example_id": "5e85fdc0-9a1f-44af-9194-2bfe5c0ea852",
                                                "sense_id": "ed8dba60-cbbf-35bf-baf2-bc57b4d2c83b",
                                                "text": "For various reasons, we have discarded the radiometric datings obtained in minero-metallurgical regions of Huelva province:[…]."
                                            },
                                            {
                                                "example_id": "6cc0a5a0-4c8d-4d91-bc56-887f051f4ddf",
                                                "sense_id": "ed8dba60-cbbf-35bf-baf2-bc57b4d2c83b",
                                                "text": "The first is radiometric dating of meteorites and rocks from the surface of the moon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "463b8105-8310-4248-96e5-751415dd76d4",
                        "source_entry_id": "90d6d10b-2ab6-3230-98a8-d152b5a91127",
                        "source_sense_id": "c59449d4-4533-3498-8a95-84ebf30db07f",
