                                "sense_id": "2c6a305c-b1ff-3866-9b4e-7a14ad7ff54f",
                                "text": "Halibut prowadzi przydenny tryb życia."
                            },
                            {
                                "example_id": "9dfa71f7-fff5-4cce-8d46-8516c44d1eb3",
                                "sense_id": "2c6a305c-b1ff-3866-9b4e-7a14ad7ff54f",
                                "text": "Halibut jest rybą, która bardzo długo się smaży."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
