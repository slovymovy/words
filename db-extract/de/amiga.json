                "senses": [
                    {
                        "sense_id": "1f647d24-c2de-3a6a-9a18-e06221641b4e",
                        "entry_id": "9e3e014f-9391-3f91-9938-def6025ce636",
                        "glosses": [
                            "Heimcomputer, der Mitte der 1980er Jahre bis Mitte der 1990er Jahre ein beliebter Computer war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd8f639b-9c11-4a8a-8d65-4b507d29e729",
                                "sense_id": "1f647d24-c2de-3a6a-9a18-e06221641b4e",
                                "text": "Darf ich heute Amiga spielen?"
                            },
                            {
                                "example_id": "3286a863-f112-45f3-befb-76747373de42",
                                "sense_id": "1f647d24-c2de-3a6a-9a18-e06221641b4e",
                                "text": "„Vor 30 Jahren, am 23. Juli 1985, erblickte eine der Legenden der Heimcomputerära das Licht der Öffentlichkeit: der Commodore Amiga.“"
                            },
                            {
                                "example_id": "75fdd616-1296-4515-bba5-dce970fbac53",
                                "sense_id": "1f647d24-c2de-3a6a-9a18-e06221641b4e",
                                "text": "„Die Werke stammen von 1985, denn Commodore hatte diverse Künstler eingeladen, die grafischen Fähigkeiten des damals vorgestellten Amiga 1000 zu zeigen.“"
                            },
                            {
                                "example_id": "f027eb7e-ddba-44c0-90a9-6d82a86e173a",
                                "sense_id": "1f647d24-c2de-3a6a-9a18-e06221641b4e",
                                "text": "„In den 1980er Jahren entdeckt Andy Warhol den Commodore Amiga und experimentiert mit dem neuen Medium.“"
                            },
                            {
                                "example_id": "05b44d79-2786-4b89-84d9-131ee564672c",
                                "sense_id": "1f647d24-c2de-3a6a-9a18-e06221641b4e",
                                "text": "„Weil der Umstieg auf ein neues System zu teuer ist, wurde der Amiga 2000 bisher nicht ausgetauscht und verrichtet nun seit über 25 Jahren seinen Dienst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
