                ],
                "senses": [
                    {
                        "sense_id": "b3d58c63-592a-3319-b942-30250e37f762",
                        "entry_id": "58b3fcbb-a1ae-3186-bc6a-919c06e01b8f",
                        "glosses": [
                            "Art und Weise, wie die grammatischen und lexikalischen Einheiten und Regeln einer Sprache organisiert sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff1f2d0f-5bec-44a3-afee-07f93283b5a9",
                                "sense_id": "b3d58c63-592a-3319-b942-30250e37f762",
                                "text": "In der kontrastiven Linguistik und in der Sprachtypologie werden Vergleiche hinsichtlich der Sprachstrukturen durchgeführt."
                            },
                            {
                                "example_id": "d42777ca-5856-4463-b4cd-fd6d5bbde37a",
                                "sense_id": "b3d58c63-592a-3319-b942-30250e37f762",
                                "text": "„Die Sprachstruktur und allgemeiner, die Struktur »natürlicher« Zeichensysteme, wird unmittelbar von der Struktur vergangener kommunikativer Handlungen bestimmt…“"
                            },
                            {
                                "example_id": "cdd92eb3-05b0-419b-8e6f-eadba504f984",
                                "sense_id": "b3d58c63-592a-3319-b942-30250e37f762",
                                "text": "„Aber die Veränderungen der inneren Sprachstruktur konnten sie nicht aufhalten, und in dieser Hinsicht erscheinen uns die Jahre von 1870 bis 1950 als eine ausgesprochene Übergangszeit.“"
                            },
                            {
                                "example_id": "12bfa4dc-ad6b-4623-9b5a-82794862ba27",
                                "sense_id": "b3d58c63-592a-3319-b942-30250e37f762",
                                "text": "„Seine Leitlinie ist es, bemerkenswerte Veränderungen in Sprachstruktur, Sprachgebrauch und Sprachbewertungen zu zeigen, die sich in den letzten Jahrzehnten vollzogen haben oder derzeit (möglicherweise) ablaufen.“"
                            },
                            {
                                "example_id": "8e527569-f721-4903-9654-3fd19f6280eb",
                                "sense_id": "b3d58c63-592a-3319-b942-30250e37f762",
                                "text": "„Sprachkontakt führt immer zu Sprachvermischung und zu neuen Sprachstrukturen.“"
                            },
                            {
                                "example_id": "74feed9e-6e20-429c-a82d-685746693b79",
                                "sense_id": "b3d58c63-592a-3319-b942-30250e37f762",
                                "text": "„Es ist in der Linguistik nicht mehr strittig, dass Sprachstrukturen das Bewusstsein, die Wahrnehmung der Welt, beeinflussen und auch prägen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
