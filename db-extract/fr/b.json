                                                "example_id": "b0448de7-2cb1-4d46-93aa-dc862e58e551",
                                                "sense_id": "e04479b4-2710-3792-a513-bd830a190694",
                                                "text": "I mean, some little B put in a protest because apparently a pineapple isn't strictly a flower."
                                            }
