                    "sense_id": "e3426c1a-5fe5-33fc-b5bb-f118174c1d93",
                    "sense_definition": "een georganiseerd plan of een tijdsplanning voor het uitvoeren van taken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "planning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We liggen nog aardig op <w>schema</w> met de verbouwing van de keuken.",
                            "target_lang_translations": {
                                "en": "We are still pretty much on <w>schedule</w> with the kitchen renovation.",
                                "ru": "Мы все еще вполне укладываемся в <w>график</w> ремонта кухни."
                            }
                        },
                        {
                            "text": "Volgens het strakke <w>schema</w> moeten we over tien minuten vertrekken.",
                            "target_lang_translations": {
                                "en": "According to the tight <w>timetable</w>, we have to leave in ten minutes.",
                                "ru": "Согласно плотному <w>расписанию</w>, мы должны выехать через десять минут."
                            }
                        }
                    ],
                    "synonyms": [
                        "planning",
                        "rooster",
                        "programma"
                    ],
                    "common_phrases": [
                        "op schema liggen",
                        "volgens schema",
                        "strak schema"
