                                            {
                                                "example_id": "a1f6c469-4692-4464-8a03-bcf3d5418628",
                                                "sense_id": "bb9c363b-c30f-306c-b7cc-f405f4d1e456",
                                                "text": "„Dass er nunmehr eine Gefährtin gefunden hat, macht ihn nicht redsamer.“"
                                            },
                                            {
                                                "example_id": "963b03a9-5f3f-4dee-8130-7881487488f4",
                                                "sense_id": "bb9c363b-c30f-306c-b7cc-f405f4d1e456",
                                                "text": "„Arp findet in Marguerite Hagenbach eine neue Gefährtin, die er 1959 heiratet.“"
                                            },
                                            {
                                                "example_id": "f73016b5-14d3-4ecd-bf3e-f69cd7d4f6bc",
                                                "sense_id": "bb9c363b-c30f-306c-b7cc-f405f4d1e456",
                                                "text": "„Am 26. März hat er wohl ein Testament zugunsten Mischas diktiert, aber in Wirklichkeit hinterläßt er soviel Schulden, daß seine Gefährtin gezwungen ist, den Nachlaß abzulehnen.“"
                                            },
                                            {
                                                "example_id": "16a31746-52e9-4da5-ba6c-f49ff447b87f",
                                                "sense_id": "bb9c363b-c30f-306c-b7cc-f405f4d1e456",
                                                "text": "„Seine Briefe an die Geliebten, die Gefährtinnen, die Trösterinnen spiegeln vieles wider von seiner Sehnsucht nach Nähe und Gemeinsamkeit, seiner Neigung zur Eifersucht, seiner Hilfsbereitschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "32e60224-c963-3382-a451-f2d922e87a67",
                                        "entry_id": "217720eb-95c6-38a9-9428-59637b1d1980",
                                        "glosses": [
                                            "weibliche Person, die mit einer anderen zusammen etwas unternimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "993e2449-f566-473c-8aee-0388d11bccdf",
                                                "sense_id": "32e60224-c963-3382-a451-f2d922e87a67",
                                                "text": "„Da mir nichts von dem gefiel, was mir der Türke zeigte, sagte ich, ich würde gern etwas Hübsches kaufen, was auch seiner schönen Gefährtin gefalle.“"
                                            },
                                            {
                                                "example_id": "5aa0ec02-1257-4f97-aa31-cb99452856a1",
                                                "sense_id": "32e60224-c963-3382-a451-f2d922e87a67",
                                                "text": "„Und da stand meine Gefährtin und hielt getreulich aus vor allen den zauberischen Steinen.“"
                                            },
                                            {
                                                "example_id": "70e8f121-1ac1-4da7-9fc4-af19b7d6a74a",
                                                "sense_id": "32e60224-c963-3382-a451-f2d922e87a67",
                                                "text": "„Sie erblickten den jungen Herrn, die ältere überkam, wie man an ihrem Gesicht sah, ein grosser Schrecken, sie ergriff ihre jüngere Gefährtin an der Hand und versteckte sich mit ihr hinter einer Birke, ohne dass sie in der Eile gewagt hätte, die grünen Pflaumen aufzusammeln, die sie dabei verloren hatte.“"
                                            },
                                            {
                                                "example_id": "677e0a62-955c-4b9d-a8e3-2645044c50f9",
                                                "sense_id": "32e60224-c963-3382-a451-f2d922e87a67",
                                                "text": "„Unsere Gefährtin streichelte ihre dünne, verarbeitete Hand und sprach mit leiser Stimme einige Worte teilnehmenden Trostes, wie ihn gerade Frauen einander geben können, und das brachte in die blutleeren Wangen der anderen die Farbe zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
