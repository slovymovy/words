                "senses": [
                    {
                        "sense_id": "9e873b42-dbaa-3b7b-8682-df7e4876422b",
                        "entry_id": "e8d3b731-22c1-3c6a-87aa-6235de984fd9",
                        "glosses": [
                            "ein sich auf ein Substantiv oder Pronomen des übergeordneten Satzes beziehendes Pronomen; einleitendes Wort eines Relativsatzes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58a46723-432d-44e5-b844-8fb81d3a8b14",
                                "sense_id": "9e873b42-dbaa-3b7b-8682-df7e4876422b",
                                "text": "In dem Satz „Ein Junge, der zu spät kommt, verliert“ ist \"der\" ein Relativpronomen."
                            },
                            {
                                "example_id": "d735a184-6ca3-4cf1-bc5b-b3b12da87374",
                                "sense_id": "9e873b42-dbaa-3b7b-8682-df7e4876422b",
                                "text": "„Das Relativpronomen muß mit dem Bezugsnomen übereinstimmen.“"
                            },
                            {
                                "example_id": "6c053ffb-8611-4796-855d-c8e2a8cef782",
                                "sense_id": "9e873b42-dbaa-3b7b-8682-df7e4876422b",
                                "text": "„Zu den sinnlosen Pronomen gehören die Relativpronomen, »bezügliche Fürwörter« genannt, wie DER, DIE, DAS.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
