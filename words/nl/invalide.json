{
    "word_family": [
        "invaliditeit",
        "valide",
        "validiteit"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5e8b5f62-fad1-37fe-a098-cb6a7fe5a42e",
                    "sense_definition": "lichamelijk of geestelijk beperkt, waardoor men bepaalde handelingen niet volledig kan uitvoeren",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beperking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het ernstige ongeluk bleef de man voor de rest van zijn leven <w>invalide</w>.",
                            "target_lang_translations": {
                                "en": "After the serious accident, the man remained <w>disabled</w> for the rest of his life."
                            }
                        },
                        {
                            "text": "Zij helpt een <w>invalide</w> man met zijn dagelijkse boodschappen.",
                            "target_lang_translations": {
                                "en": "She helps a <w>disabled</w> man with his daily groceries."
                            }
                        }
                    ],
                    "synonyms": [
                        "gehandicapt",
                        "mindervalide",
                        "andersvalide",
                        "beperkt",
                        "behinderd"
                    ],
                    "antonyms": [
                        "valide"
                    ],
                    "common_phrases": [
                        "een invalide man",
                        "invalide geraakt"
                    ],
                    "target_lang_definitions": {
                        "en": "physically or mentally impaired, preventing one from fully performing certain actions"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disabled",
                                "target_lang_sense_clarification": "having a physical or mental disability"
                            },
                            {
                                "target_lang_word": "handicapped",
                                "target_lang_sense_clarification": "physically or mentally restricted in activity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbe6efa2-abde-3372-94e1-a65d819b5f1b",
                    "sense_definition": "niet meer geldig of niet van kracht",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ongeldigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zonder de juiste handtekening is dit contract juridisch gezien <w>invalide</w>.",
                            "target_lang_translations": {
                                "en": "Without the correct signature, this contract is legally <w>invalid</w>."
                            }
                        },
                        {
                            "text": "De code die u heeft ingevoerd is helaas <w>invalide</w>.",
                            "target_lang_translations": {
                                "en": "The code you entered is unfortunately <w>invalid</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "valide"
                    ],
                    "common_phrases": [
                        "een invalide code"
                    ],
                    "target_lang_definitions": {
                        "en": "no longer valid or not in force"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "invalid",
                                "target_lang_sense_clarification": "not legally or officially acceptable"
                            },
                            {
                                "target_lang_word": "void",
                                "target_lang_sense_clarification": "having no legal force"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "be17d519-5c2a-3225-a574-962daefa3a99",
                    "sense_definition": "iemand die door een lichamelijke of geestelijke beperking gehinderd wordt in het dagelijks functioneren",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beperking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze parkeerplaatsen zijn speciaal gereserveerd voor een <w>invalide</w>.",
                            "target_lang_translations": {
                                "en": "These parking spaces are specially reserved for a <w>disabled person</w>."
                            }
                        },
                        {
                            "text": "Als <w>invalide</w> heeft hij recht op extra ondersteuning van de gemeente.",
                            "target_lang_translations": {
                                "en": "As a <w>disabled person</w>, he is entitled to extra support from the municipality."
                            }
                        }
                    ],
                    "synonyms": [
                        "gehandicapte"
                    ],
                    "common_phrases": [
                        "parkeerplaats voor een invalide"
                    ],
                    "target_lang_definitions": {
                        "en": "someone who is hindered in daily functioning due to a physical or mental impairment"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disabled person",
                                "target_lang_sense_clarification": "an individual with a disability"
                            },
                            {
                                "target_lang_word": "invalid",
                                "target_lang_sense_clarification": "a person made weak or disabled by illness or injury"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}