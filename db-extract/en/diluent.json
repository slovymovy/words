                                        "examples": [
                                            {
                                                "example_id": "f2190580-739f-49a2-8741-24686bbec099",
                                                "sense_id": "87d6db9e-9dc1-35e2-8c12-0454b56f8b11",
                                                "text": "Schadstoffe der Industrie, die seit Hunderten von Jahren in die Atmosphäre abgegeben werden (Emission), hoffen auf die ungesühnte Verdünnung in Luft."
                                            },
                                            {
                                                "example_id": "f212b486-22df-47a2-88cd-f47a9c903338",
                                                "sense_id": "87d6db9e-9dc1-35e2-8c12-0454b56f8b11",
                                                "text": "Das Verklappen von chemischen Substanzen in den Weltmeeren ist die Verdünnung in Wasser und wird auch noch in 1000 Jahren ein Vergiftungsproblem darstellen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "67ab0b4c-92c5-36a5-a136-31f486af96c6",
                                        "entry_id": "dcbf4e03-3b50-3469-a1ce-3a80b3da36dc",
                                        "glosses": [
                                            "chemisches Mittel zum Verdünnen; besonders von Ölfarben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "115838c4-511b-4303-abb9-e4c622f77df9",
                                                "sense_id": "67ab0b4c-92c5-36a5-a136-31f486af96c6",
                                                "text": "Terpentin ist ein Verdünner, der bei Farben die Verdünnung zur Reinigung eines Pinsels ermöglicht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
