                "senses": [
                    {
                        "sense_id": "ebf7195d-0c0e-3f63-b79a-6e103e000012",
                        "entry_id": "98800018-beb2-3143-bdf5-1e079a0ff221",
                        "glosses": [
                            "Methode, um etwas abzubauen oder abbauen zu lassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74186bc5-f54f-4ed1-8b2e-ea4ae4c4966a",
                                "sense_id": "ebf7195d-0c0e-3f63-b79a-6e103e000012",
                                "text": "„Seit August 2016 arbeitet er an der Entwicklung umweltgerechter Abbaumethoden für Abfallprodukte, die bei der industriellen Verarbeitung von Kartoffeln entstehen – ein interessantes neues Gebiet, so der Syrer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0655464e-c7fb-3cc1-a9c8-1447a5976206",
                        "entry_id": "98800018-beb2-3143-bdf5-1e079a0ff221",
                        "glosses": [
                            "Technik, die dazu dient, eine Lagerstätte wirtschaftlich optimal und zielgerichtet auszubeuten beziehungsweise abzubauen"
                        ],
                        "tags": [
                            "Bergbau"
                        ],
                        "examples": [
                            {
                                "example_id": "067fc490-9bd6-4ae4-8037-618a64030d47",
                                "sense_id": "0655464e-c7fb-3cc1-a9c8-1447a5976206",
                                "text": "„Die Form der Lagerstätte (Flöz, Ganglagerstätte, massige Lagerstätte) sowie die Standfestigkeit von Nebengestein und Mineral sind entscheidend für die Wahl der Abbaumethode.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
