{
    "word_family": [
        "inchworm",
        "incher",
        "inchmeal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c44d4f62-270b-3acd-ac44-f0b66f1805de",
                    "sense_definition": "A unit of length in the imperial and US customary systems equal to 1/12 of a foot or 2.54 centimeters.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The screen of the new smartphone measures exactly six <w>inches</w> diagonally.",
                            "target_lang_translations": {
                                "ru": "Экран нового смартфона имеет размер ровно шесть <w>дюймов</w> по диагонали.",
                                "zh": "这部新智能手机的屏幕对角线长度正好是六<w>英寸</w>。"
                            }
                        },
                        {
                            "text": "You need to leave a half <w>inch</w> gap between the door and the floor.",
                            "target_lang_translations": {
                                "ru": "Нужно оставить зазор в пол-<w>дюйма</w> между дверью и полом.",
                                "zh": "门和地面之间要留出半<w>英寸</w>的缝隙。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "half inch",
                        "square inch",
                        "cubic inch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица измерения длины в английской и американской системах мер, равная 1/12 фута или 2,54 сантиметра.",
                        "zh": "长度单位，英制和美制常用计量系统中使用，等于一英尺的十二分之一或2.54厘米。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дюйм",
                                "target_lang_sense_clarification": "единица длины"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "英寸",
                                "target_lang_sense_clarification": "长度单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe88987a-cc1b-37d2-a636-e7ded7da1310",
                    "sense_definition": "A very small distance or amount.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "small_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car stopped just an <w>inch</w> away from the wall.",
                            "target_lang_translations": {
                                "ru": "Машина остановилась всего в <w>дюйме</w> от стены.",
                                "zh": "汽车在离墙只有<w>一点点</w>的地方停了下来。"
                            }
                        },
                        {
                            "text": "The security guard told the protesters not to move an <w>inch</w>.",
                            "target_lang_translations": {
                                "ru": "Охранник велел протестующим <w>не двигаться ни на шаг</w>.",
                                "zh": "保安告诉抗议者连<w>一步</w>也不要动。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "not move an inch",
                        "every inch",
                        "within an inch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень маленькое расстояние или количество.",
                        "zh": "极小的距离或数量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ни на шаг",
                                "target_lang_sense_clarification": "в устойчивых выражениях о движении"
                            },
                            {
                                "target_lang_word": "малейшее расстояние",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "дюйм",
                                "target_lang_sense_clarification": "в значении крошечного отрезка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一点点",
                                "target_lang_sense_clarification": "表示极小的距离"
                            },
                            {
                                "target_lang_word": "一步",
                                "target_lang_sense_clarification": "常用于否定表达，表示丝毫不"
                            },
                            {
                                "target_lang_word": "丝毫",
                                "target_lang_sense_clarification": "表示极少的量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6409988d-607c-38a2-81aa-e0c775fddabf",
                    "sense_definition": "A measurement of rainfall representing a depth of one inch on the ground.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city received an <w>inch</w> of rain in less than two hours.",
                            "target_lang_translations": {
                                "ru": "Менее чем за два часа в городе выпал <w>дюйм</w> осадков.",
                                "zh": "不到两个小时，这座城市的降雨量就达到了一<w>英寸</w>。"
                            }
                        },
                        {
                            "text": "Farmers are happy because an <w>inch</w> of rain fell during the night.",
                            "target_lang_translations": {
                                "ru": "Фермеры довольны, потому что за ночь выпал <w>дюйм</w> дождя.",
                                "zh": "农民们很高兴，因为夜里下了一<w>英寸</w>的雨。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "inch of rain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мера количества осадков, представляющая собой слой воды глубиной в один дюйм на поверхности земли.",
                        "zh": "降雨量的计量单位，表示地面上积水深度为一英寸。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дюйм",
                                "target_lang_sense_clarification": "осадков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "英寸",
                                "target_lang_sense_clarification": "用于表示降雨量的深度单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03319a67-203a-3d8c-bea2-2cad3b035236",
                    "sense_definition": "A small island or islet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boat navigated carefully between the rocky <w>inches</w> near the coast.",
                            "target_lang_translations": {
                                "ru": "Лодка осторожно лавировала между скалистыми <w>островками</w> у побережья.",
                                "zh": "小船在海岸附近那些岩石嶙峋的<w>小岛</w>之间小心穿行。"
                            }
                        },
                        {
                            "text": "Seabirds often nest on the small <w>inch</w> in the middle of the lake.",
                            "target_lang_translations": {
                                "ru": "Морские птицы часто гнездятся на маленьком <w>островке</w> посреди озера.",
                                "zh": "海鸟经常在湖中央那座<w>小岛</w>上筑巢。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly Scotland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой остров или островок (преимущественно в Шотландии).",
                        "zh": "小岛，岛屿的一种较小形式。主要见于苏格兰地区用法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "островок",
                                "target_lang_sense_clarification": "небольшой остров"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小岛",
                                "target_lang_sense_clarification": "小的岛屿"
                            },
                            {
                                "target_lang_word": "小屿",
                                "target_lang_sense_clarification": "较文雅说法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "57386d30-777e-3cfe-9e4c-03cf51fe7a78",
                    "sense_definition": "To move or advance very slowly and carefully in a specific direction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traffic was so heavy that we had to <w>inch</w> forward for miles.",
                            "target_lang_translations": {
                                "ru": "Движение было таким плотным, что нам пришлось миля за милей <w>медленно продвигаться</w> вперед.",
                                "zh": "交通太拥堵了，我们只好一路<w>缓慢前行</w>了好几英里。"
                            }
                        },
                        {
                            "text": "He had to <w>inch</w> along the narrow ledge to reach the window.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>осторожно пробираться</w> по узкому карнизу, чтобы добраться до окна.",
                                "zh": "为了到达窗边，他不得不沿着狭窄的岩架<w>慢慢挪动</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "inch forward",
                        "inch along",
                        "inch closer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или продвигаться очень медленно и осторожно в определенном направлении.",
                        "zh": "朝某个方向非常缓慢且小心地移动或前进。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медленно продвигаться",
                                "target_lang_sense_clarification": "движение по чуть-чуть"
                            },
                            {
                                "target_lang_word": "пробираться",
                                "target_lang_sense_clarification": "осторожное движение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缓慢前行",
                                "target_lang_sense_clarification": "一点一点地向前移动"
                            },
                            {
                                "target_lang_word": "慢慢挪动",
                                "target_lang_sense_clarification": "小心慢慢地移动"
                            },
                            {
                                "target_lang_word": "一点点移动",
                                "target_lang_sense_clarification": "一点点移动位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02803097-156b-3792-8ab7-165902c2255e",
                    "sense_definition": "To speak to someone in a cocky, cheeky, or insulting manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He started <w>inching</w> the waiter after his request was denied.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>дерзить</w> официанту после того, как его просьба была отклонена.",
                                "zh": "他的要求被拒绝后，他开始对服务员<w>出言不逊</w>。"
                            }
                        },
                        {
                            "text": "It is not professional to <w>inch</w> your colleagues during a meeting.",
                            "target_lang_translations": {
                                "ru": "Непрофессионально <w>оскорблять</w> своих коллег во время совещания.",
                                "zh": "开会时对同事<w>顶撞</w>是很不专业的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Hong Kong English"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговаривать с кем-либо дерзко, нахально или оскорбительно (сленг Гонконга).",
                        "zh": "以自大、无礼或侮辱性的方式对别人说话。属香港英语俚语用法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дерзить",
                                "target_lang_sense_clarification": "говорить нахально"
                            },
                            {
                                "target_lang_word": "оскорблять",
                                "target_lang_sense_clarification": "вести себя вызывающе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出言不逊",
                                "target_lang_sense_clarification": "说话无礼、冒犯他人"
                            },
                            {
                                "target_lang_word": "顶撞",
                                "target_lang_sense_clarification": "语气冲撞地回话"
                            },
                            {
                                "target_lang_word": "无礼地说话",
                                "target_lang_sense_clarification": "说话轻佻无礼"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "08e32dfb-3029-3ce5-9b1a-92be613a02e4",
                    "sense_definition": "Behaving in a cocky, arrogant, or cheeky way.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shop assistant was very <w>inch</w> and ignored our questions.",
                            "target_lang_translations": {
                                "ru": "Продавец был очень <w>дерзким</w> и игнорировал наши вопросы.",
                                "zh": "那个店员非常<w>傲慢无礼</w>，对我们的问题不予理会。"
                            }
                        },
                        {
                            "text": "Nobody likes him because he acts so <w>inch</w> whenever he wins a game.",
                            "target_lang_translations": {
                                "ru": "Никто его не любит, потому что он ведет себя так <w>высокомерно</w> каждый раз, когда выигрывает.",
                                "zh": "没人喜欢他，因为他每次赢了比赛都表现得很<w>嚣张</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inchy"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Hong Kong English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ведущий себя самоуверенно, высокомерно или дерзко (сленг Гонконга).",
                        "zh": "表现得自大、傲慢或无礼的。属香港英语俚语用法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дерзкий",
                                "target_lang_sense_clarification": "нахальный"
                            },
                            {
                                "target_lang_word": "высокомерный",
                                "target_lang_sense_clarification": "самоуверенный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "傲慢无礼",
                                "target_lang_sense_clarification": "态度自大且无礼"
                            },
                            {
                                "target_lang_word": "嚣张",
                                "target_lang_sense_clarification": "神气而让人反感"
                            },
                            {
                                "target_lang_word": "高傲",
                                "target_lang_sense_clarification": "高傲自负"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a7b7a44a-33a2-328a-ad2c-78dcf5ee3240",
                    "sense_definition": "A town located in County Wexford, Ireland.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They decided to stop in <w>Inch</w> while driving through County Wexford.",
                            "target_lang_translations": {
                                "ru": "Они решили остановиться в <w>Инче</w>, проезжая через графство Уэксфорд.",
                                "zh": "他们开车穿过韦克斯福德郡时，决定在<w>因奇</w>停一下。"
                            }
                        },
                        {
                            "text": "The historic church in <w>Inch</w> attracts many local visitors.",
                            "target_lang_translations": {
                                "ru": "Историческая церковь в <w>Инче</w> привлекает множество местных посетителей.",
                                "zh": "<w>因奇</w>那座历史悠久的教堂吸引了许多当地游客。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город, расположенный в графстве Уэксфорд, Ирландия.",
                        "zh": "爱尔兰韦克斯福德郡的一座城镇。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Инч",
                                "target_lang_sense_clarification": "название города"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "因奇",
                                "target_lang_sense_clarification": "爱尔兰韦克斯福德郡的城镇名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}