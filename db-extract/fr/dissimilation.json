                ],
                "senses": [
                    {
                        "sense_id": "9ab13b7c-584a-3ae5-81b3-d7bbe75f5010",
                        "entry_id": "4ea6fdba-7400-322c-af15-fed8b9c57a4b",
                        "glosses": [
                            "Différenciation phonétique de deux phonèmes similaires ou voisins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "721eaf61-6a8f-437f-b4e0-9d29f8ed90cb",
                                "sense_id": "9ab13b7c-584a-3ae5-81b3-d7bbe75f5010",
                                "text": "La dissimilation est le changement de consonnes internes et le plus fréquent est le passage de 'l' à 'r' ou inversement, comme dans les noms Bourven et Boulven."
                            },
                            {
                                "example_id": "04d35902-1d8b-417f-98c4-17d85900ad16",
                                "sense_id": "9ab13b7c-584a-3ae5-81b3-d7bbe75f5010",
                                "text": "Le toponyme « Auvergne » repose sur l'étymon Arvernia qui, avec une dissimilation à distance r…r / l…r a donné Alvernia puis, par contraction de al en au Auvergne, le e final subissant en parallèle une apocope."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7483716-6c6b-4270-99e8-b43689e2e033",
                        "source_entry_id": "4ea6fdba-7400-322c-af15-fed8b9c57a4b",
                        "source_sense_id": "9ab13b7c-584a-3ae5-81b3-d7bbe75f5010",
                        "target_lang_word": "Dissimilation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dissimilation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "211c7863-046b-312f-b079-5ba7de2a311a",
                                        "entry_id": "2a8a0ac2-83a7-3c8a-9f0c-fb072bf29fd8",
                                        "glosses": [
                                            "Abbau eines Energiespeichers in einem Organismus"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5d69fcb0-96cb-3207-9cbb-1208f071a69f",
                                        "entry_id": "2a8a0ac2-83a7-3c8a-9f0c-fb072bf29fd8",
                                        "glosses": [
                                            "Veränderung zweier oder mehrerer ähnlicher Laute innerhalb eines Wortes so, dass sie sich unähnlicher werden"
                                        ],
                                        "tags": [
                                            "Linguistik/Phonetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7b7e0af-764b-42f9-856a-72ae7f79b5f9",
                                                "sense_id": "5d69fcb0-96cb-3207-9cbb-1208f071a69f",
                                                "text": "„Der entgegengesetzte Vorgang, die Dissimilation, charakterisiert einen Lautwandel ebenfalls in syntagmatischer Weise.“"
                                            },
                                            {
                                                "example_id": "b17a7239-54f3-4d9e-9af7-9fb5a9554854",
                                                "sense_id": "5d69fcb0-96cb-3207-9cbb-1208f071a69f",
                                                "text": "Ein Beispiel für Dissimilation liegt vor, indem aus dem älteren Wort „klobelouch“ durch Ersetzung des ersten „l“ durch ein „n“ das neue „Knoblauch“ geworden ist."
                                            },
                                            {
                                                "example_id": "41c14abd-2b4f-43ea-bff4-1d227d28e4f5",
                                                "sense_id": "5d69fcb0-96cb-3207-9cbb-1208f071a69f",
                                                "text": "„Umgekehrt geht es bei der Dissimilation: Wenn zwei gleiche Laute nur durch wenige Laute getrennt sind, dann werden sie häufig unähnlich gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
