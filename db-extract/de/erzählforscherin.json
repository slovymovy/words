                "senses": [
                    {
                        "sense_id": "a70959e4-3563-35a3-8068-428006dcab25",
                        "entry_id": "e9a5a975-1219-3f6b-bf0d-796918fc1744",
                        "glosses": [
                            "weibliche Person, die sich wissenschaftlich mit Erzählforschung befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f11c685-f46b-4988-aa54-14835bd87dad",
                                "sense_id": "a70959e4-3563-35a3-8068-428006dcab25",
                                "text": "„Als Biografie- und Erzählforscherin interessieren mich alle Formen und Stationen, die auto-/biografische Materialien innerhalb wie nach der Lebenszeit von Individuen und Kollektiven erleben.“"
                            },
                            {
                                "example_id": "06bd5f5d-612e-4c27-9e80-3e0317dfdcb3",
                                "sense_id": "a70959e4-3563-35a3-8068-428006dcab25",
                                "text": "„Bereits 1994 plädierte die Erzählforscherin Linda Dégh dafür, neue Medien in die Erzählforschung einzubeziehen.“"
                            },
                            {
                                "example_id": "cf7c4659-ede6-4d23-9193-e51218d55224",
                                "sense_id": "a70959e4-3563-35a3-8068-428006dcab25",
                                "text": "„Die Erzählforscherin Hedwig Röckelein spricht hier von einem biografischen Konstrukt, das aus einzelnen narrativen Konstrukten zusammengesetzt ist.“"
                            },
                            {
                                "example_id": "732de4e6-8aa8-49f7-9f73-a40ef0fee5e2",
                                "sense_id": "a70959e4-3563-35a3-8068-428006dcab25",
                                "text": "„Die Erzählforscherin Katalin Horn beschreibt Unhelden als ‚Kontrastfiguren, die ihr Daseinsrecht einzig von ihrer Beziehung zu den Helden herleiten.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
