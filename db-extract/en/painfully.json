                "senses": [
                    {
                        "sense_id": "e084c094-154f-3d54-b4a5-c6200b55fb41",
                        "entry_id": "56941531-60b6-367c-9e41-961ad7129a37",
                        "glosses": [
                            "In a painful manner; as if in pain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b2875cf-5968-460c-b6d6-ae8b1f5cfbe2",
                                "sense_id": "e084c094-154f-3d54-b4a5-c6200b55fb41",
                                "text": "I limped painfully down the stairs."
                            },
                            {
                                "example_id": "7a66c2dc-3026-4caf-93ba-ae27d03b3165",
                                "sense_id": "e084c094-154f-3d54-b4a5-c6200b55fb41",
                                "text": "The unsufficiency and uncandidness of his answer became painfully apparent in the dead silence of the room."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4033bea-21c4-3fc1-9719-ae0ae84ab69e",
                        "entry_id": "56941531-60b6-367c-9e41-961ad7129a37",
                        "glosses": [
                            "Badly; poorly."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "ea5b10b5-4852-42b1-96f8-0634cfbf0c64",
                                "sense_id": "c4033bea-21c4-3fc1-9719-ae0ae84ab69e",
                                "text": "That was the most painfully sung rendition of “Fly Me to the Moon” that I’ve ever heard."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68717c70-6bd0-460b-bf2e-66909d96d4c1",
                        "source_entry_id": "56941531-60b6-367c-9e41-961ad7129a37",
                        "source_sense_description": "in a painful manner",
                        "target_lang_word": "douloureusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "douloureusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9efc86e1-2e83-372d-b09a-66656cd12eb7",
                                        "entry_id": "4b3a0636-5185-319c-8d03-39c3ef3c2dae",
                                        "glosses": [
                                            "Avec douleur physique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4a43481-820e-4a3f-9702-09f67b339244",
                                                "sense_id": "9efc86e1-2e83-372d-b09a-66656cd12eb7",
                                                "text": "Huguenin fit pénétrer son cheval au sein d'une épinaie. Le passage emprunté constituait une sorte d'étroit couloir dont on ne pouvait s'écarter sans se faire douloureusement griffer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96c5123e-3ab3-32e9-a6e6-e2fa5989d3f6",
                                        "entry_id": "4b3a0636-5185-319c-8d03-39c3ef3c2dae",
                                        "glosses": [
                                            "ou Avec un sentiment, une expression ou un ton de douleur."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "880c8765-9591-4883-ab01-d3f8d16a376a",
                                                "sense_id": "96c5123e-3ab3-32e9-a6e6-e2fa5989d3f6",
                                                "text": "Les angles de ses lèvres semblaient tirés, ses mâchoires étaient contractées, ses yeux, souvent douloureusement cernés."
                                            },
                                            {
                                                "example_id": "91af3236-6e0a-486e-a41b-b6df496e21a2",
                                                "sense_id": "96c5123e-3ab3-32e9-a6e6-e2fa5989d3f6",
                                                "text": "L’adolescent se tenait debout, son calot à la main. Il avait l'air songeur, préoccupé : une ride lui sillonnait douloureusement le front."
                                            },
                                            {
                                                "example_id": "7a212c9c-fb37-4013-9287-fc18d6838fc0",
                                                "sense_id": "96c5123e-3ab3-32e9-a6e6-e2fa5989d3f6",
                                                "text": "Et il se rappela douloureusement avoir entendu Mᵐᵉ Kroner prévenir que le petit-déjeuner serait servi tôt ce matin-là à cause du service religieux."
                                            },
                                            {
                                                "example_id": "a89747a0-7eb7-4adb-b769-3b3f675d5aa2",
                                                "sense_id": "96c5123e-3ab3-32e9-a6e6-e2fa5989d3f6",
                                                "text": "Rien n’est plus douloureusement calme qu’un crépuscule d’automne. Les rayons pâlissent dans l’air frissonnant, les arbres vieillis jettent leurs feuilles. La campagne, brûlée par les rayons ardents de l’été, sent la mort venir avec les premiers vents froids. Et il y a, dans les cieux, des souffles plaintifs de désespérance. La nuit descend de haut, apportant des linceuls dans son ombre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d013840c-6b13-4e11-8f16-dea0bc5c1cb7",
                        "source_entry_id": "56941531-60b6-367c-9e41-961ad7129a37",
                        "source_sense_description": "in a painful manner",
                        "target_lang_word": "péniblement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "péniblement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fd89339-84f7-36be-924b-b51f063c96d0",
                                        "entry_id": "325ea42b-a5da-3195-95e6-889147a56da9",
                                        "glosses": [
                                            "Avec peine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5c7f17e-612b-4d24-9d06-49075e5822a3",
                                                "sense_id": "9fd89339-84f7-36be-924b-b51f063c96d0",
                                                "text": "Péniblement, il se releva et regagna, en trébuchant, sa place."
                                            },
                                            {
                                                "example_id": "f01698ba-845b-443f-83bd-ae1415e42950",
                                                "sense_id": "9fd89339-84f7-36be-924b-b51f063c96d0",
                                                "text": "Quand Jacques parut, les malades se levèrent, quelques-uns péniblement, et saluèrent militairement, gauches."
                                            },
                                            {
                                                "example_id": "bd8d6a43-cd0b-42ad-9505-a5b2665b5284",
                                                "sense_id": "9fd89339-84f7-36be-924b-b51f063c96d0",
                                                "text": "Selon une autre version, Isaac aurait habité un port de mer où il gagnait péniblement sa vie comme arrimeur."
                                            },
                                            {
                                                "example_id": "ca5a1ea0-5ff8-40ac-8784-e94ccc7a30be",
                                                "sense_id": "9fd89339-84f7-36be-924b-b51f063c96d0",
                                                "text": "Quand tante Claire donnait le signal du départ, Vincent bougonnait que les femmes étaient des casseuses de veillée. Il finissait par se lever péniblement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88cd5fac-8c48-3494-a864-70d45f696cc0",
                                        "entry_id": "325ea42b-a5da-3195-95e6-889147a56da9",
                                        "glosses": [
                                            "Avec effort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e426394-aedb-4c8c-838b-aece60e48ad8",
                                                "sense_id": "88cd5fac-8c48-3494-a864-70d45f696cc0",
                                                "text": "Il parlait mal et péniblement notre langue,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebede1f4-d647-349c-b535-8a1402ae95c1",
                                        "entry_id": "325ea42b-a5da-3195-95e6-889147a56da9",
                                        "glosses": [
                                            "Avec difficulté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d825f20-aa9e-4587-bb58-8c2fae6e8b59",
                                                "sense_id": "ebede1f4-d647-349c-b535-8a1402ae95c1",
                                                "text": "[…] ; la cellulose, restant polymérisée à son degré maximum, ne se dissout alors que péniblement dans l'ammoniure de cuivre."
                                            },
                                            {
                                                "example_id": "a2ab21d7-a0f8-44cd-a770-a13425a10d0d",
                                                "sense_id": "ebede1f4-d647-349c-b535-8a1402ae95c1",
                                                "text": "La rue de Normandie est une de ces vieilles rues à chaussée fendue, où la ville de Paris n’a pas encore mis de bornes-fontaines, et dont le ruisseau noir roule péniblement les eaux ménagères de toutes les maisons, qui s’infiltrent sous les pavés et y produisent cette boue particulière à la ville de Paris."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0dccf4eb-cd50-4045-915f-5969ac45339b",
