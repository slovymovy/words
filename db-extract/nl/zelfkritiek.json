                    }
                ],
                "senses": [
                    {
                        "sense_id": "6c6329ed-727c-3857-beff-09dfef56a77f",
                        "entry_id": "dd3e4ce3-1734-3e16-8ed0-3652d1e52bf8",
                        "glosses": [
                            "beoordeling van het zelf, meestal gericht op dat wat verbeterd zou moeten worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04566415-d525-4787-976c-6666995cbf8a",
                                "sense_id": "6c6329ed-727c-3857-beff-09dfef56a77f",
                                "text": "Volgens analyticus en commentator Jan Mulder zou enige zelfkritiek de voetballers niet misstaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c99a0b70-cbef-420c-93bf-6abe54564fad",
                        "source_entry_id": "dd3e4ce3-1734-3e16-8ed0-3652d1e52bf8",
                        "source_sense_id": "6c6329ed-727c-3857-beff-09dfef56a77f",
                        "source_sense_description": "beoordeling van het zelf, meestal gericht op dat wat verbeterd zou moeten worden",
                        "target_lang_word": "Selbstkritik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstkritik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fdd06726-b0b0-33aa-88f5-db245d0a0ca8",
                                        "entry_id": "eaadda26-d91d-339a-a5a1-57de51a56fde",
                                        "glosses": [
                                            "das Suchen oder Finden eigener Schwächen oder Fehler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38b4705d-0892-4999-827c-eef31ab3125c",
                                                "sense_id": "fdd06726-b0b0-33aa-88f5-db245d0a0ca8",
                                                "text": "Zu viel Selbstkritik und zu viele Skrupel können einen Menschen lähmen."
                                            },
                                            {
                                                "example_id": "173c6913-ec30-46bd-a2ed-ecd06ded2a23",
                                                "sense_id": "fdd06726-b0b0-33aa-88f5-db245d0a0ca8",
                                                "text": "„Gabriel, zu Selbstkritik nur bedingt fähig, glaubt an eine Verschwörung gegen sich.“"
                                            },
                                            {
                                                "example_id": "97b3b73b-3a2c-45ad-b31c-b57c0b6f9445",
                                                "sense_id": "fdd06726-b0b0-33aa-88f5-db245d0a0ca8",
                                                "text": "„Während die Extrembergsteiger sowohl in ihren Veröffentlichungen als auch in ihren Auskünften bei meinen Befragungen eine große Offenheit und ein hohes Reflexionsniveau gegenüber diesen Problemstellungen beweisen, offenbart sich bei vielen anderen Risikogruppen noch ein erheblicher Nachholbedarf an Selbstkritik und Bereitschaft, das Gefahrenpotenzial der eigenen Sportart unvoreingenommen objektivieren zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e6dcc6a2-0de9-344b-9c9b-51f75914c2a5",
                                        "entry_id": "eaadda26-d91d-339a-a5a1-57de51a56fde",
                                        "glosses": [
                                            "das Äußern eigener Schwächen oder Fehler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91ca5454-0803-4911-89f1-f21d4eb3e312",
                                                "sense_id": "e6dcc6a2-0de9-344b-9c9b-51f75914c2a5",
                                                "text": "„Gabriel, zu Selbstkritik nur bedingt fähig, glaubt an eine Verschwörung gegen sich.“"
                                            },
                                            {
                                                "example_id": "16db729b-ea5e-4149-87fe-e19a0a4f7f72",
                                                "sense_id": "e6dcc6a2-0de9-344b-9c9b-51f75914c2a5",
                                                "text": "„Während die Extrembergsteiger sowohl in ihren Veröffentlichungen als auch in ihren Auskünften bei meinen Befragungen eine große Offenheit und ein hohes Reflexionsniveau gegenüber diesen Problemstellungen beweisen, offenbart sich bei vielen anderen Risikogruppen noch ein erheblicher Nachholbedarf an Selbstkritik und Bereitschaft, das Gefahrenpotenzial der eigenen Sportart unvoreingenommen objektivieren zu lassen.“"
                                            },
                                            {
                                                "example_id": "b74a51fb-ae0e-4701-aaba-9eef8db8e238",
                                                "sense_id": "e6dcc6a2-0de9-344b-9c9b-51f75914c2a5",
                                                "text": "„Die Selbstkritik hat viel für sich.“"
                                            },
                                            {
                                                "example_id": "8c66d861-2698-48c8-9058-71ab1af1c44b",
                                                "sense_id": "e6dcc6a2-0de9-344b-9c9b-51f75914c2a5",
                                                "text": "Im Kommunismus wurden Abweichler zu „Kritik und Selbstkritik“ gezwungen."
                                            },
                                            {
                                                "example_id": "b7f6deab-ac67-40a5-af83-84300df2f7fb",
                                                "sense_id": "e6dcc6a2-0de9-344b-9c9b-51f75914c2a5",
                                                "text": "„Von dieser Selbstkritik ist auch die ganze moderne jüdische Literatur durchprägt, die ernste wie die heitere, die schwermütige Ballade wie der lockere Witz.“"
                                            },
                                            {
                                                "example_id": "dec48dd4-2f7a-4253-a985-06f2beeb0129",
                                                "sense_id": "e6dcc6a2-0de9-344b-9c9b-51f75914c2a5",
                                                "text": "„Öffentlich geübteSelbstkritik, zumal im Eingang einer Neuauflage, ist Jüngers Sache nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
