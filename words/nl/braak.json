                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wasteland",
                                "target_lang_sense_clarification": "unused or barren land"
                            },
                            {
                                "target_lang_word": "fallow land",
                                "target_lang_sense_clarification": "land left uncultivated"
                            },
                            {
                                "target_lang_word": "vacant lot",
                                "target_lang_sense_clarification": "an empty plot of land in a city"
                            }
                        ]
                    }
                }
