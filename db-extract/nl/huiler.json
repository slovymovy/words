                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f3363a3-86b2-365e-a841-2efdfc75f631",
                                        "entry_id": "d256c55d-5cad-3b85-8064-3c1db8291cf3",
                                        "glosses": [
                                            "That which howls, especially an animal such as a wolf or a howler monkey."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "654a3a3d-fc9d-3ac6-aa49-8bf8e9446ba4",
                                        "entry_id": "d256c55d-5cad-3b85-8064-3c1db8291cf3",
                                        "glosses": [
                                            "A person hired to howl in mourning at a funeral."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a009ec97-2340-3523-8123-284644c1cd30",
                                        "entry_id": "d256c55d-5cad-3b85-8064-3c1db8291cf3",
                                        "glosses": [
                                            "A painfully obvious mistake."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9631c74-b9c9-4efe-8cc6-1b68400b8647",
                                                "sense_id": "a009ec97-2340-3523-8123-284644c1cd30",
                                                "text": "Given what we know about cognitive psychology, utility maximization is a ludicrous concept; equilibrium pretty foolish outside of financial markets; perfect competition a howler for most industries."
                                            },
                                            {
                                                "example_id": "5f50eed7-ef2f-4b8f-b7ef-66136631cad2",
                                                "sense_id": "a009ec97-2340-3523-8123-284644c1cd30",
                                                "text": "I should like to thank Jianmei Piao of the Stanford University Libraries for reading the entire translation and checking it against the Chinese. Jianmei caught some howlers for which I am very grateful."
                                            },
                                            {
                                                "example_id": "47d65b16-4d0c-4444-999d-225b5cb88507",
                                                "sense_id": "a009ec97-2340-3523-8123-284644c1cd30",
                                                "text": "A howler is a glaring mistake, a mistake that cries out to be noticed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b2700d8-df68-3160-8943-f9c5e7d9a22a",
                                        "entry_id": "d256c55d-5cad-3b85-8064-3c1db8291cf3",
                                        "glosses": [
                                            "A hilarious joke."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6afd844b-5633-3a2b-bf21-826d91a80628",
                                        "entry_id": "d256c55d-5cad-3b85-8064-3c1db8291cf3",
                                        "glosses": [
                                            "A bitterly cold day."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6449e4bb-e23c-3e96-9853-1c693eeda048",
                                        "entry_id": "d256c55d-5cad-3b85-8064-3c1db8291cf3",
                                        "glosses": [
                                            "A person who expresses aggression openly in the form of threats."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24ff1a6a-c101-49c7-9564-58dbcd3bfe2a",
                                                "sense_id": "6449e4bb-e23c-3e96-9853-1c693eeda048",
                                                "text": "Although their behavior does not have the same impact as hunters, howlers nevertheless distract the public figure and compel security and law enforcement […]"
                                            },
                                            {
                                                "example_id": "133285e8-d693-4d49-9581-5ab2b560b38a",
                                                "sense_id": "6449e4bb-e23c-3e96-9853-1c693eeda048",
                                                "text": "Hunters stalk their targets, make detailed plans, acquire and practice with weapons, and try to hurt or kill people. Howlers make bomb threats to schools, malls, churches, businesses, and government offices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "778d3f65-c52f-3046-ad27-7b3e0d6dadeb",
                                        "entry_id": "d256c55d-5cad-3b85-8064-3c1db8291cf3",
                                        "glosses": [
                                            "A heavy fall."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d01d7a1b-5c26-3c0e-b157-370b17624db1",
                                        "entry_id": "d256c55d-5cad-3b85-8064-3c1db8291cf3",
                                        "glosses": [
                                            "A serious accident (especially to come a howler or go a howler; compare come a cropper)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "941e4b07-0a49-4ed6-943e-842764ab3860",
                                                "sense_id": "d01d7a1b-5c26-3c0e-b157-370b17624db1",
                                                "text": "Our hansom came a howler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e3079ab-e9b8-3c81-bfea-13e2e8eb6eff",
                                        "entry_id": "d256c55d-5cad-3b85-8064-3c1db8291cf3",
                                        "glosses": [
                                            "A tremendous lie (especially an obvious one); a whopper."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2db7cb8a-b3ea-4e6a-a333-309d27f0131d",
                                                "sense_id": "0e3079ab-e9b8-3c81-bfea-13e2e8eb6eff",
                                                "text": "Trump has been trying to sell the howler that India offered a zero tariffs deal, when Modi isn’t even willing to take Trump’s repeated calls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d19873b-cb37-3052-9819-d96a607ae7d3",
                                        "entry_id": "d256c55d-5cad-3b85-8064-3c1db8291cf3",
                                        "glosses": [
                                            "A fashionably but extravagantly overdressed man, a \\\"howling swell\\\"."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9803d7f-85a9-3e43-95cd-20d29fe04e5d",
                                        "entry_id": "d256c55d-5cad-3b85-8064-3c1db8291cf3",
                                        "glosses": [
                                            "A 32-ounce ceramic, plastic, or stainless steel jug used to transport draft beer."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79684c29-628d-3bed-a9ab-f15471646cfc",
                                        "entry_id": "d256c55d-5cad-3b85-8064-3c1db8291cf3",
                                        "glosses": [
                                            "A small child."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc9a5977-b089-4862-b623-e19a37415ec5",
                                                "sense_id": "79684c29-628d-3bed-a9ab-f15471646cfc",
                                                "text": "I wanted Leesa to pick up her children, not Child Protective Services. After thirty minutes, I had the two howlers fed and settled down for naps."
                                            },
                                            {
                                                "example_id": "a9d27688-ca05-4d0d-84bf-897d52ef658a",
                                                "sense_id": "79684c29-628d-3bed-a9ab-f15471646cfc",
                                                "text": "What are we doing to our children? But the howlers seem okay, maybe even happy. This makes me feel a little better about the future."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
