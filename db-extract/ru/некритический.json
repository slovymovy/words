                        "target_lang_word": "uncritical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uncritical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "604326a8-8b53-335c-8a05-ee436a0d43ef",
                                        "entry_id": "e313eaf0-1389-3822-a7bc-0c0294200e39",
                                        "glosses": [
                                            "Lacking critique or critical examination; undiscriminating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33d76927-6a09-420c-a029-2142d534fc93",
                                                "sense_id": "604326a8-8b53-335c-8a05-ee436a0d43ef",
                                                "text": "an uncritical review"
                                            },
                                            {
                                                "example_id": "2a517d0f-5978-4285-ad0d-28e5364d7e47",
                                                "sense_id": "604326a8-8b53-335c-8a05-ee436a0d43ef",
                                                "text": "Let any competent judge read Hacket's Life of Archbishop Williams, and then these Sermons, and so measure the stultifying, nugifying effect of a blind and uncritical study of the Fathers […]"
                                            },
                                            {
                                                "example_id": "7e6f61d8-9e94-4a5a-9b2b-ff615ff1b0a8",
                                                "sense_id": "604326a8-8b53-335c-8a05-ee436a0d43ef",
                                                "text": "More importantly, the rehearsing of that information has been almost completely uncritical, indicating a lack of recourse to any further information about the term."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c952c682-524a-3119-903e-27ce0491ab88",
                                        "entry_id": "e313eaf0-1389-3822-a7bc-0c0294200e39",
                                        "glosses": [
                                            "Having a disregard for critical standards or procedures."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c6e996c-8b7a-3e26-aa1f-2ccfec8e458b",
                                        "entry_id": "e313eaf0-1389-3822-a7bc-0c0294200e39",
                                        "glosses": [
                                            "Slow to criticize."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c84d0003-1b66-4e39-b3e4-c0f0c072a359",
                                                "sense_id": "3c6e996c-8b7a-3e26-aa1f-2ccfec8e458b",
                                                "text": "uncritical to the point of tolerating incompetence, jeopardizing the business model"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
