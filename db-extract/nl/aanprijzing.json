                        "form_id": "664abfca-5a42-4968-b18d-0b8c50c8edab",
                        "entry_id": "911d2670-4c2f-3e07-bf19-5dbc66da59ba",
                        "tags": [
                            "plural"
                        ],
                        "form": "aanprijzingen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6861922a-fc76-3852-934a-4078d6c1fe6e",
                        "entry_id": "911d2670-4c2f-3e07-bf19-5dbc66da59ba",
                        "glosses": [
                            "het zeggen dat iets goed is en dat je het anderen aanbeveelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d6eb8ff-8748-46a4-a613-52c8c9df14dc",
                                "sense_id": "6861922a-fc76-3852-934a-4078d6c1fe6e",
                                "text": "Aanprijzingen op voeding als ’rijk aan vezels en vitamine D’ terwijl het product barst van de suiker moeten worden verboden. De Europese consumentenorganisatie BEUC roept Brussel op EU-wetgeving te maken die een einde maakt aan misleidende gezondheids- en voedingsclaims."
                            },
                            {
                                "example_id": "b5ae2328-7a7a-43f6-8f4a-2f3c3e6f01f3",
                                "sense_id": "6861922a-fc76-3852-934a-4078d6c1fe6e",
                                "text": "Een ‘waargebeurd familieverhaal’: met deze aanprijzing afficheert Theater Utrecht de voorstelling Casino Nonstop, het ‘avondvullende’ debuut van de uit Noorwegen afkomstige regisseur Espen Hjort (1989)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ea3c922-906f-46a1-b6c0-87d6291cb7ac",
                        "source_entry_id": "911d2670-4c2f-3e07-bf19-5dbc66da59ba",
                        "source_sense_id": "6861922a-fc76-3852-934a-4078d6c1fe6e",
                        "target_lang_word": "recommendation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recommendation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c9dc049-b548-326e-8b06-f753edfc636b",
                                        "entry_id": "00da929c-76d9-3aee-96d9-ff25a76093c8",
                                        "glosses": [
                                            "An act of recommending."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93fe2c93-d6f3-3319-8e00-5773fb251e8c",
                                        "entry_id": "00da929c-76d9-3aee-96d9-ff25a76093c8",
                                        "glosses": [
                                            "That which is recommended."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8ee3f8a-f8d7-40f0-b551-58364c00f2f8",
                                                "sense_id": "93fe2c93-d6f3-3319-8e00-5773fb251e8c",
                                                "text": "Some of the recommendations made by the PTF to prevent the spread of Covid-19 as religious institutions and hotels open up include: managed access to markets and locations of economic activity to limit the risk of transmitting Covid-19, mandatory use of face masks and temperature checks in public places, and information campaigns on the dangers of the virus among others."
                                            },
                                            {
                                                "example_id": "e9c097c5-71fb-4ab1-8908-f0b27bc5cebd",
                                                "sense_id": "93fe2c93-d6f3-3319-8e00-5773fb251e8c",
                                                "text": "The US Centers and Disease Control and Prevention is considering recommending annual Covid-19 shots to those who are older or who have compromised immune function, rather than the current blanket recommendation for everyone 6 months of age and older."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40642cdd-d83b-300a-932b-5d402a740f21",
                                        "entry_id": "00da929c-76d9-3aee-96d9-ff25a76093c8",
                                        "glosses": [
                                            "A commendation or endorsement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8308f648-16b8-44ed-bf40-8e941be3c492",
                                                "sense_id": "40642cdd-d83b-300a-932b-5d402a740f21",
                                                "text": "Your next employer may require a recommendation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d523aa8-4668-3fd2-9da7-2356b6a0288a",
                                        "entry_id": "00da929c-76d9-3aee-96d9-ff25a76093c8",
                                        "glosses": [
                                            "A suggestion or proposal about the best course of action (with adpositions including \\\"about\\\" for the context and \\\"to\\\" for the course of action)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01d2f901-77a0-47b8-978c-d0aa2cf3b717",
                                                "sense_id": "1d523aa8-4668-3fd2-9da7-2356b6a0288a",
                                                "text": "He made a recommendation about what food to order."
                                            },
                                            {
                                                "example_id": "31b99e9c-db16-481e-8db8-314e856f4d66",
                                                "sense_id": "1d523aa8-4668-3fd2-9da7-2356b6a0288a",
                                                "text": "We followed the recommendation to order sushi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6600bdbe-5499-4a97-a7b9-c091b0a7f3c3",
                        "source_entry_id": "911d2670-4c2f-3e07-bf19-5dbc66da59ba",
                        "source_sense_id": "6861922a-fc76-3852-934a-4078d6c1fe6e",
                        "target_lang_word": "advice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "advice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffc2979e-1483-3197-8f40-0ebf955c54ec",
                                        "entry_id": "dd33717d-477e-3e32-8e9b-1458da5b87ed",
                                        "glosses": [
                                            "An opinion offered to guide behavior in an effort to be helpful."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8411aeac-027f-4a6f-86d4-1f3049eb6033",
                                                "sense_id": "ffc2979e-1483-3197-8f40-0ebf955c54ec",
                                                "text": "She was offered various pieces of advice on what to do."
                                            },
                                            {
                                                "example_id": "ccdf7c9d-a944-4e15-a37f-d7802a124b3a",
                                                "sense_id": "ffc2979e-1483-3197-8f40-0ebf955c54ec",
                                                "text": "My kids never listen to advice."
                                            },
                                            {
                                                "example_id": "7d51b040-f994-4478-8d56-ec27e03603c9",
                                                "sense_id": "ffc2979e-1483-3197-8f40-0ebf955c54ec",
                                                "text": "On the advice of her doctor, Mary cut down on her carbohydrates."
                                            },
                                            {
                                                "example_id": "ccaf3f2d-e0cd-432a-b6d7-e7d0c2dbfc83",
                                                "sense_id": "ffc2979e-1483-3197-8f40-0ebf955c54ec",
                                                "text": "I have some useful advice to give you."
                                            },
                                            {
                                                "example_id": "5b92a4d6-4939-41c9-a997-d7716dc01bda",
                                                "sense_id": "ffc2979e-1483-3197-8f40-0ebf955c54ec",
                                                "text": "Sushil never took the advice of his parents, but still became rich."
                                            },
                                            {
                                                "example_id": "15b5a43f-c3f6-41c6-94c5-28a96f87e115",
                                                "sense_id": "ffc2979e-1483-3197-8f40-0ebf955c54ec",
                                                "text": "We may give advice, but we can not give conduct."
                                            },
                                            {
                                                "example_id": "2046b3b9-0191-4856-90fc-1ec9ebda6a48",
                                                "sense_id": "ffc2979e-1483-3197-8f40-0ebf955c54ec",
                                                "text": "Everyone always asks what my advice is, and my advice is don’t overintellectualize your art."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b78b738d-c8e5-3de2-8026-53074bdb49c5",
                                        "entry_id": "dd33717d-477e-3e32-8e9b-1458da5b87ed",
                                        "glosses": [
                                            "Deliberate consideration; knowledge."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5a65fab-3cc6-490f-8d1f-e8bd8d2b5d0f",
                                                "sense_id": "b78b738d-c8e5-3de2-8026-53074bdb49c5",
                                                "text": "How shall I dote on her with more advice,\n That thus without advice begin to love her?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a68683bd-296e-3fbe-8964-d790c3616ee2",
                                        "entry_id": "dd33717d-477e-3e32-8e9b-1458da5b87ed",
                                        "glosses": [
                                            "Information or news given; intelligence"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b76174e-a198-4431-9289-7f50f3e00bfa",
                                                "sense_id": "a68683bd-296e-3fbe-8964-d790c3616ee2",
                                                "text": "late advices from France"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffff3db6-7337-3e0d-bd28-890e5f28ee33",
                                        "entry_id": "dd33717d-477e-3e32-8e9b-1458da5b87ed",
                                        "glosses": [
                                            "In language about financial transactions executed by formal documents, an advisory document."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a55ac1c8-2aba-4767-97e2-7bcc54ca3ac0",
                                                "sense_id": "ffff3db6-7337-3e0d-bd28-890e5f28ee33",
                                                "text": "An advice of an incoming settlement payment order may be given to an off-line receiving bank."
                                            },
                                            {
                                                "example_id": "7f0cf81f-0e0e-4c8e-b4a7-4daeb7279438",
                                                "sense_id": "ffff3db6-7337-3e0d-bd28-890e5f28ee33",
                                                "text": "(g) A Reserve Bank will issue to each depositor following any transaction affecting book-entry securities maintained for such depositor under this part a confirmation thereof in the form of an advice (serially numbered or otherwise) which shall describe the amount and maturity date thereof, and include pertinent transaction data."
                                            },
                                            {
                                                "example_id": "c969f61e-5e2b-407d-bd86-ec7d9f29a576",
                                                "sense_id": "ffff3db6-7337-3e0d-bd28-890e5f28ee33",
                                                "text": "However, an advice of an incoming settlement payment order will be given to an off-line receiving bank only when the receiving bank has notified the Reserve Bank in writing"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07c5bc97-d25e-3372-bba4-3a379b25f296",
                                        "entry_id": "dd33717d-477e-3e32-8e9b-1458da5b87ed",
                                        "glosses": [
                                            "In commercial language, information communicated by letter; used chiefly in reference to drafts or bills of exchange"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ab2e09d-c289-495d-b382-3751dff8f667",
                                                "sense_id": "07c5bc97-d25e-3372-bba4-3a379b25f296",
                                                "text": "a letter of advice"
                                            },
                                            {
                                                "example_id": "18890349-458b-4b91-8233-de9b691b889f",
                                                "sense_id": "07c5bc97-d25e-3372-bba4-3a379b25f296",
                                                "text": "the drawees acknowledged the receipt of the letter of advice of the nineteenth of December , and promised to honor the draft when presented"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "442b7c0c-f228-3b24-86c4-184a43768227",
                                        "entry_id": "dd33717d-477e-3e32-8e9b-1458da5b87ed",
                                        "glosses": [
                                            "A communication providing information, such as how an uncertain area of law might apply to possible future actions"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71ff2115-0e46-42da-b58b-4f3736d5cae4",
                                                "sense_id": "442b7c0c-f228-3b24-86c4-184a43768227",
                                                "text": "An advice issued by a Monitoring Committee could be applicable in a Dutch court"
                                            },
                                            {
                                                "example_id": "74f7a54e-0101-44eb-9bfd-57c003f0e1ab",
                                                "sense_id": "442b7c0c-f228-3b24-86c4-184a43768227",
                                                "text": "Any measure that is not a formal (binding) act within the meaning of article 189 EEC, such as for example an advice, is clearly outside the scope of the action."
                                            },
                                            {
                                                "example_id": "3182b420-7dec-4fd0-8ae2-a099aba110ff",
                                                "sense_id": "442b7c0c-f228-3b24-86c4-184a43768227",
                                                "text": "the question arises, whether an advice issued by a Monitoring Committee would actually be applicable in a Dutch court"
                                            },
                                            {
                                                "example_id": "bb0c0a8e-3dac-4c05-9513-be571a54cc19",
                                                "sense_id": "442b7c0c-f228-3b24-86c4-184a43768227",
                                                "text": "the Executive Director will determine which requests will be referred to chief counsel for preparation of an advice and which requests will be submitted directly to the Commission for an opinion."
                                            },
                                            {
                                                "example_id": "f160014e-a7c1-41e2-b7cb-09a43581a82d",
                                                "sense_id": "442b7c0c-f228-3b24-86c4-184a43768227",
                                                "text": "The central purpose of this chapter is, however, to explain how to write an advice or an opinion."
                                            },
                                            {
                                                "example_id": "5f572829-580a-484f-8dfe-ca57112e8fad",
                                                "sense_id": "442b7c0c-f228-3b24-86c4-184a43768227",
                                                "text": "Documents and submissions to the Commission relating to a request for an opinion or an appeal of an advice shall be made at least 7 days prior to the meeting of the Commission during which the appeal or opinion will be reviewed"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4df71b02-4aec-3e78-96ed-09c4d0011a54",
                                        "entry_id": "dd33717d-477e-3e32-8e9b-1458da5b87ed",
                                        "glosses": [
                                            "Counseling to perform a specific legal act."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3686d6c5-7d81-4ff8-8858-de5561bb4a74",
                                                "sense_id": "4df71b02-4aec-3e78-96ed-09c4d0011a54",
                                                "text": "An honest oath taken under advice of counsel, therefore, is not perjury"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c9de339-03d6-37b9-8e0f-7565166955d6",
                                        "entry_id": "dd33717d-477e-3e32-8e9b-1458da5b87ed",
                                        "glosses": [
                                            "Counseling to perform a specific illegal act."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed48ef4a-1fe3-3c76-88e0-e49547f26788",
                                        "entry_id": "dd33717d-477e-3e32-8e9b-1458da5b87ed",
                                        "glosses": [
                                            "In aspect-oriented programming, the code whose execution is triggered when a join point is reached."
                                        ],
