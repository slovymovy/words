                "senses": [
                    {
                        "sense_id": "c2501983-6ad7-37d5-85c8-fa5e2bf41d40",
                        "entry_id": "69e85193-c246-37fe-befa-334331657de5",
                        "glosses": [
                            "Besuch eines Bordells"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf7f276a-ae4d-4937-bc27-df065f55c6f4",
                                "sense_id": "c2501983-6ad7-37d5-85c8-fa5e2bf41d40",
                                "text": "„Ein Minderjähriger hat nach einem Bordellbesuch in Braunschweig die Polizei gerufen.“"
                            },
                            {
                                "example_id": "8f848f4e-9f34-4f58-bad5-f6959abb4c40",
                                "sense_id": "c2501983-6ad7-37d5-85c8-fa5e2bf41d40",
                                "text": "„Dr. Taza lud Michael ein, ihn bei seinen wöchentlichen Bordellbesuchen nach Palermo zu begleiten, doch Michael wollte nicht.“"
                            },
                            {
                                "example_id": "219792be-eaf5-42fa-82c0-52738842d98b",
                                "sense_id": "c2501983-6ad7-37d5-85c8-fa5e2bf41d40",
                                "text": "„Selbst seine Bordellbesuche dienen weniger der sexuellen Befriedigung als vielmehr der Flucht vor der Einsamkeit in seinen vielen, langen und durch den Alkoholgenuß seelisch noch stärker verdunkelten Nachtstunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
