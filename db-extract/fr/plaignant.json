                "senses": [
                    {
                        "sense_id": "a6508f5a-43a7-3c2d-871a-c974a9af28cd",
                        "entry_id": "f16450b4-5ab4-3004-8b5c-e9e1b17d8e41",
                        "glosses": [
                            "Celui qui se plaint en justice de quelque tort qu’on lui a fait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60951aa8-4b1c-4f5f-ac8d-1e342ae65376",
                                "sense_id": "a6508f5a-43a7-3c2d-871a-c974a9af28cd",
                                "text": "On laisse le plaignant clairement expliquer son lien familial (parent ou allié) avec le défunt."
                            },
                            {
                                "example_id": "8acbdf34-e7fb-4722-9d5f-16e4ed4532da",
                                "sense_id": "a6508f5a-43a7-3c2d-871a-c974a9af28cd",
                                "text": "Il n'incitait guère les plaignants à lui faire confiance, d'autant plus que ses plaidoiries émaillées de principes philosophiques et de maximes latinistes n'ayant rien à voir avec l'affaire restaient incompréhensives pour le vulgum pecus."
                            },
                            {
                                "example_id": "7966287c-3771-46b2-9833-4912d0e79a8c",
                                "sense_id": "a6508f5a-43a7-3c2d-871a-c974a9af28cd",
                                "text": "Pour chaque cas pénal ou civil à traiter, un certain nombre de jurés seraient tirés au sort sur l’ensemble des experts-jurés appartenant à la profession du ou des plaignants, et un nombre égal sur l’ensemble des individus relevant de la même profession que le ou les défendeurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8043495-f629-489d-a0bf-8b4d409846b0",
                        "source_entry_id": "f16450b4-5ab4-3004-8b5c-e9e1b17d8e41",
                        "source_sense_id": "a6508f5a-43a7-3c2d-871a-c974a9af28cd",
                        "target_lang_word": "Kläger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kläger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1b87f86-1043-3b71-9424-1beee3cfcf93",
                                        "entry_id": "0795e2b0-7598-3800-987a-98df3a3e8f13",
                                        "glosses": [
                                            "jemand, der vor Gericht eine Klage führt"
                                        ],
                                        "tags": [
                                            "Rechtssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08fb86c9-db51-441a-8d6e-818015a81437",
                                                "sense_id": "f1b87f86-1043-3b71-9424-1beee3cfcf93",
                                                "text": "Der Kläger muss noch den Kostenvorschuss einzahlen."
                                            },
                                            {
                                                "example_id": "58e871af-1c53-4c7a-b819-7f366be09eca",
                                                "sense_id": "f1b87f86-1043-3b71-9424-1beee3cfcf93",
                                                "text": "„Im folgenden Fall allerdings bekam der Kläger immerhin den Preis für den kuriosesten Gerichtsfall.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c53cb3bc-274f-3a6e-bc6d-f9e10a511b51",
                                        "entry_id": "0795e2b0-7598-3800-987a-98df3a3e8f13",
                                        "glosses": [
                                            "jemand, der über irgendetwas klagt oder um jemanden/etwas trauert"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbb9408d-b056-41bb-b48c-612c35cdaf6a",
                                                "sense_id": "c53cb3bc-274f-3a6e-bc6d-f9e10a511b51",
                                                "text": "Nach dem Tod des alten Ratsherren gingen tagelang die Kläger vor seinem Hause auf und ab."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d29030ae-1214-3d96-a777-cad2c6f30f65",
                                        "entry_id": "0795e2b0-7598-3800-987a-98df3a3e8f13",
                                        "glosses": [
                                            "Anwalt, der für den Kläger^([1]) tätig wird"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88399e0e-f6aa-4082-9c0b-480f8a1ec402",
                                                "sense_id": "d29030ae-1214-3d96-a777-cad2c6f30f65",
                                                "text": "Der Geschädigte selbst erschien nicht, aber sein Kläger war zugegen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b21b8c31-277b-33a0-8a5d-20a43339069a",
                                        "entry_id": "0795e2b0-7598-3800-987a-98df3a3e8f13",
                                        "glosses": [
                                            "Akkusativ"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "153ea352-280c-4431-9531-c95d8d3dc5de",
                                                "sense_id": "b21b8c31-277b-33a0-8a5d-20a43339069a",
                                                "text": "Der Nominativ ist der Nenner, der Genitiv Besitzer, Zeuger, der Dativ ist der Geber und der Akkusativ der Kläger."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
