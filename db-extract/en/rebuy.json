                                        "glosses": [
                                            "comprare nuovamente qualcosa che in precedenza già si possedeva ma di cui non si è più in possesso (ad es. perché venduto, ceduto, perso etc.)"
                                        ],
                                        "tags": [
                                            "diritto"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7aedc3dd-08b8-4b5e-b975-3bbe0da04f91",
                                                "sense_id": "205c54dd-8ebd-320f-88f6-4c04b9451d86",
                                                "text": "sono riuscito a ricomprare la vecchia casa dei miei genitori, che loro avevano dovuto vendere per pagare i debiti"
                                            },
                                            {
                                                "example_id": "70c4155e-fb12-4049-ad3e-5d79fa2fbeb6",
                                                "sense_id": "205c54dd-8ebd-320f-88f6-4c04b9451d86",
                                                "text": "mi hanno rubato il cellulare, l'ho dovuto ricomprare"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
