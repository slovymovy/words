                "senses": [
                    {
                        "sense_id": "b9aa43fc-98c9-369f-95e2-9221f0068468",
                        "entry_id": "01ca10b1-d490-34d4-a0d1-c891ce70bc36",
                        "glosses": [
                            "zusätzlicher Eintrag bei Texten in kleinerer Schrift als der Haupttext"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdd9e3df-c09f-4d59-8d3c-6be7857f6397",
                                "sense_id": "b9aa43fc-98c9-369f-95e2-9221f0068468",
                                "text": "„Es lohnt sich übrigens sehr, das Kleingedruckte in Anzeigen für neue Cremes zu lesen.“"
                            },
                            {
                                "example_id": "be18197c-072e-4bd4-bdc9-65007844909f",
                                "sense_id": "b9aa43fc-98c9-369f-95e2-9221f0068468",
                                "text": "„Es ist das Ensemble der Vorschriften, das Kleingedruckte, das von Pedanten des Kleingedruckten ausgeführt wird.“"
                            },
                            {
                                "example_id": "d6638d76-52e9-4f4b-906b-5c588cf3eb9f",
                                "sense_id": "b9aa43fc-98c9-369f-95e2-9221f0068468",
                                "text": "„Grenfeld studierte das Kleingedruckte.“"
                            },
                            {
                                "example_id": "cd4b8539-f73d-4672-98f9-e624d682142c",
                                "sense_id": "b9aa43fc-98c9-369f-95e2-9221f0068468",
                                "text": "„Leider hatte Hamann vergessen, das Kleingedruckte zu lesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4a6207a-95ea-47ac-a7b0-7e4876dd4c0f",
                        "source_entry_id": "01ca10b1-d490-34d4-a0d1-c891ce70bc36",
                        "source_sense_id": "b9aa43fc-98c9-369f-95e2-9221f0068468",
                        "source_sense_description": "zusätzlicher Eintrag bei Texten in kleinerer Schrift als der Haupttext",
                        "target_lang_word": "small print",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "small print",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58f8dfb7-e96a-306d-b773-3c4952bc2a52",
                                        "entry_id": "30be566f-a64e-3679-8c87-9448a37ffba0",
                                        "glosses": [
                                            "fine print"
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c4ed592-23ba-4fa4-9207-78a01fe48204",
                                                "sense_id": "58f8dfb7-e96a-306d-b773-3c4952bc2a52",
                                                "text": "This calculated coyness, it now seems, concealed quite a breakthrough. Presumably both sides needed a few more days to fine-tune the small print."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec4eb358-ee96-4f94-9734-a057f461e20d",
                        "source_entry_id": "01ca10b1-d490-34d4-a0d1-c891ce70bc36",
                        "source_sense_id": "b9aa43fc-98c9-369f-95e2-9221f0068468",
                        "source_sense_description": "zusätzlicher Eintrag bei Texten in kleinerer Schrift als der Haupttext",
                        "target_lang_word": "fine print",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fine print",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf26acd1-0d20-395a-b323-ba36bc98a644",
                                        "entry_id": "51ef29bd-16c0-35dc-8a5c-4359e791c624",
                                        "glosses": [
                                            "The details, restrictions, terms, or conditions, especially of a contract, often printed in very small type."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91edd862-5c2e-4ec4-a52f-9d44b40c2d4d",
                                                "sense_id": "bf26acd1-0d20-395a-b323-ba36bc98a644",
                                                "text": "Before signing up for such an offer, be sure to read the fine print carefully."
                                            },
                                            {
                                                "example_id": "c2afa58a-fc97-4e11-9f34-d6020328214d",
                                                "sense_id": "bf26acd1-0d20-395a-b323-ba36bc98a644",
                                                "text": "One of the biggest problems many investors face is that it can be hard to figure out what's important in the fine print. Even pros who are experienced at reading the footnotes face this problem."
                                            },
                                            {
                                                "example_id": "51ee7f92-ca68-4ce7-ba1b-3582fa8273e0",
                                                "sense_id": "bf26acd1-0d20-395a-b323-ba36bc98a644",
                                                "text": "Did I read the fine print? Of course not. Do I wish I would have? Well, maybe. Who knows, potentially the fine print would have touched on issues like refunds for rude, late or inconsiderate dates."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
