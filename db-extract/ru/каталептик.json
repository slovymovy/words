                                                "sense_id": "fb58508e-c142-3449-ab15-9dc59fd2a2ea",
                                                "text": "Methought I was immersed in a cataleptic trance of more than usual duration and profundity."
                                            },
                                            {
                                                "example_id": "f22a52bd-7e05-462b-9999-0f9b1a7218fc",
                                                "sense_id": "fb58508e-c142-3449-ab15-9dc59fd2a2ea",
                                                "text": "She keeps still, feigning cataleptic exhaustion."
                                            }
                                        ]
