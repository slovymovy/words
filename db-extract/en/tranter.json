                        "examples": [
                            {
                                "example_id": "386cf18b-cfc8-4e62-8cca-ae041beaf72f",
                                "sense_id": "5d95e27f-7730-389b-ad41-f05d468b164d",
                                "text": "Through the open doorway of a small inner room on the left hand, of a character between pantry and cellar, was Dick Dewy’s father, Reuben, by vocation a ‘tranter’, or irregular carrier."
                            },
                            {
                                "example_id": "3413798b-4440-4247-bf90-b3a010a861ae",
                                "sense_id": "5d95e27f-7730-389b-ad41-f05d468b164d",
                                "text": "1879, William Barnes, Poems of Rural Life in the Dorset Dialect, Dobbin Dead\nAn’ he met wi’ zome yew-twigs the men had a-cast\nVrom the yew-tree, in churchyard, the road that he past.\nHe wer pweison’d. (1.) O dear, ’tis a hard loss to bear,\nVor a tranter’s whole bread is a-lost wi’ his meäre;"
                            },
                            {
                                "example_id": "1cec01c8-97a1-4bda-9128-0fb5b91cd108",
                                "sense_id": "5d95e27f-7730-389b-ad41-f05d468b164d",
                                "text": "...the persons tenanting these few houses included two retired military officers, one old navy lieutenant, a small farmer and tranter, a relieving officer and registrar, and an old militiaman […]"
                            }
                        ]
