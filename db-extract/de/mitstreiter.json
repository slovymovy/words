                        ],
                        "form": "den Mitstreiter"
                    },
                    {
                        "form_id": "7ac16d47-bbbe-49fb-adc5-f04346783896",
                        "entry_id": "bb3bf955-d79f-3026-b389-163c1969afc7",
                        "tags": [
                            "accusative",
