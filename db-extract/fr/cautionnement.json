        "fr-extract.jsonl": [
            {
                "entry_id": "260b80bb-f643-3b6b-8cf9-a345cec3c345",
                "word": "cautionnement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1ec65c0e-4850-4908-8223-b04aba49d9ca",
                        "entry_id": "260b80bb-f643-3b6b-8cf9-a345cec3c345",
                        "tags": [
                            "plural"
                        ],
                        "form": "cautionnements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "08c67bf0-4aca-39ba-8286-79c7b7269d0b",
                        "entry_id": "260b80bb-f643-3b6b-8cf9-a345cec3c345",
                        "glosses": [
                            "Contrat par lequel la caution s’oblige."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fddda6c-7603-4a15-b5f1-7443826898ce",
                                "sense_id": "08c67bf0-4aca-39ba-8286-79c7b7269d0b",
                                "text": "Le cautionnement ne se présume point ; il doit être exprès, et on ne peut pas l'étendre au-delà des limites dans lesquelles il a été contracté."
                            },
                            {
                                "example_id": "b874f849-0aa2-42e0-a255-f2cc7eef4523",
                                "sense_id": "08c67bf0-4aca-39ba-8286-79c7b7269d0b",
                                "text": "Elle diffère du cautionnement, engagement accessoire, car il n’est pas nécessaire de prouver l’inexécution de l’obligation garantie pour obtenir son paiement."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef9fd3ac-26ba-35e2-b50b-4215355f11e1",
                        "entry_id": "260b80bb-f643-3b6b-8cf9-a345cec3c345",
                        "glosses": [
                            "Acte même qui constate l’existence de ce contrat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61780893-79fb-4c44-991b-b62d1592303d",
                                "sense_id": "ef9fd3ac-26ba-35e2-b50b-4215355f11e1",
                                "text": "Il s’est obligé pour un tel ; ce cautionnement lui coûtera cher. Signer un cautionnement."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e5e0561-55eb-3734-aaf4-d3f885024326",
                        "entry_id": "260b80bb-f643-3b6b-8cf9-a345cec3c345",
                        "glosses": [
                            "Gage ou somme que les lois obligent certaines personnes à déposer comme garantie de la responsabilité à laquelle elles sont soumises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be80880b-cc91-4fa4-bb8b-a1b3beebc391",
                                "sense_id": "0e5e0561-55eb-3734-aaf4-d3f885024326",
                                "text": "Supprimé en 1870, rétabli par l'Assemblée nationale, le cautionnement est de nouveau supprimé pour tous les journaux sans distinction, par la loi de 1881."
                            },
                            {
                                "example_id": "81143ea6-696d-49ea-bca2-3fa46474a8bb",
                                "sense_id": "0e5e0561-55eb-3734-aaf4-d3f885024326",
                                "text": "J'instituai le cautionnement mutuel. Supprimer les dépôts pécuniaires exigés des comptables pour garantie de leur gestion, les remplacer par des engagements assumés par une association mutuelle d’intéressés,[…], telle est l'idée très simple que je fis entrer dans la pratique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96128938-2f50-42f6-94ce-d39f76db3737",
                        "source_entry_id": "260b80bb-f643-3b6b-8cf9-a345cec3c345",
                        "target_lang_word": "Bürgschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bürgschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "829fef9c-b9c2-3092-8aca-cb25d0e8faf2",
                                        "entry_id": "d921a281-56f1-3e74-8c86-0a1feeace73f",
                                        "glosses": [
                                            "als akzessorische, persönliche Sicherheit für eine Forderung dienender einseitig verpflichtender Vertrag zwischen Gläubiger und Bürgen darüber, dass der Bürge sich gegenüber dem Gläubiger dazu verpflichtet, (subsidiär) für eine Verbindlichkeit des Schuldners einzustehen"
                                        ],
                                        "tags": [
                                            "Rechtssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "591232cb-1281-4ef0-b2b3-46aa8530c57f",
                                                "sense_id": "829fef9c-b9c2-3092-8aca-cb25d0e8faf2",
                                                "text": "Diese Forderung ist durch eine Bürgschaft gesichert."
                                            },
                                            {
                                                "example_id": "2579629e-b3e8-4c57-a05d-e0c2d0fab84f",
                                                "sense_id": "829fef9c-b9c2-3092-8aca-cb25d0e8faf2",
                                                "text": "„Die angeschlagene Reederei braucht dringend eine Bürgschaft - und die Bundesregierung will sie unbedingt gewähren, trotz Bedenken unter den Haushältern des Bundestags.“"
                                            },
                                            {
                                                "example_id": "5269fcbf-ae96-47d8-a7a9-4e90d59c4b33",
                                                "sense_id": "829fef9c-b9c2-3092-8aca-cb25d0e8faf2",
                                                "text": "Für den Kredit verlangte die Bank eine Bürgschaft."
                                            },
                                            {
                                                "example_id": "f850b9ef-632b-4623-8cac-bdebc4aa3d44",
                                                "sense_id": "829fef9c-b9c2-3092-8aca-cb25d0e8faf2",
                                                "text": "„Aber, wir wissen es aus dem BGB, dass eine Bürgschaft etwas Ehernes ist, das man bezahlen muss.“"
                                            },
                                            {
                                                "example_id": "0d0d86a6-8d9f-4c28-9fee-c9e9b30437a6",
                                                "sense_id": "829fef9c-b9c2-3092-8aca-cb25d0e8faf2",
                                                "text": "„In Grudshöfchen begann sie zu schreiben, und führte das auch fort, als die Familie Grudshöfchen wegen einer unvorsichtigen Bürgschaft verkaufen musste und ein neues Leben in Kukehnen begann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "94786d4e-d75c-32b5-9a5b-3e882e34b336",
                                        "entry_id": "d921a281-56f1-3e74-8c86-0a1feeace73f",
                                        "glosses": [
                                            "Betrag, über den eine Bürgschaft^([1]) geleistet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0b29667-2342-4663-a2b1-f213830aac9b",
                                                "sense_id": "94786d4e-d75c-32b5-9a5b-3e882e34b336",
                                                "text": "Ich musste für meine Schwester eine hohe Bürgschaft übernehmen."
                                            },
                                            {
                                                "example_id": "11bc9e33-a86c-48fb-bb62-110255fdad04",
                                                "sense_id": "94786d4e-d75c-32b5-9a5b-3e882e34b336",
                                                "text": "„An-tung konnte gegen Bürgschaft frei kommen.“"
                                            },
                                            {
                                                "example_id": "2a70d296-beac-4841-b2ad-8d03b7781d31",
                                                "sense_id": "94786d4e-d75c-32b5-9a5b-3e882e34b336",
                                                "text": "„Im Betrugsprozess gegen Donald Trump in New York hat der ehemalige US-Präsident eine Bürgschaft von 175 Millionen Dollar (etwa 160 Millionen Euro) hinterlegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a2dc53d4-596a-3509-a941-5f3b3bf03c1d",
                                        "entry_id": "d921a281-56f1-3e74-8c86-0a1feeace73f",
                                        "glosses": [
                                            "Garantie, Gewähr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5034d6e9-2bf0-4881-aa52-2d8f28ae3897",
                                                "sense_id": "a2dc53d4-596a-3509-a941-5f3b3bf03c1d",
                                                "text": "Diese Ähren sind eine Bürgschaft für eine gute Ernte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "049d966a-6468-4d3c-9b3a-95e944b44d17",
