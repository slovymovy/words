                    {
                        "translation_id": "6abc2fb5-c7d4-4f61-bfb8-1efbc9f3edcb",
                        "source_entry_id": "8f4cf8d1-b805-3d83-84bd-2a5b9ebd7951",
                        "source_sense_id": "985b6ecd-0230-38a0-b280-845cb004f478",
