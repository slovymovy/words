                "senses": [
                    {
                        "sense_id": "93d451ac-d8d1-3ab5-bdba-d79a194b719f",
                        "entry_id": "033811d3-4679-3825-8064-d2aef69379ff",
                        "glosses": [
                            "To place in a secure environment."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d113b395-5bb9-4f2e-9a55-8ae6a306352c",
                                "sense_id": "93d451ac-d8d1-3ab5-bdba-d79a194b719f",
                                "text": "She shall not see me, I will ensconce mee behinde the Arras."
                            },
                            {
                                "example_id": "345ab215-8965-46cc-b721-377d421f63dc",
                                "sense_id": "93d451ac-d8d1-3ab5-bdba-d79a194b719f",
                                "text": "They found the sharp new heap they were seeking, and ensconced themselves within the protection of three great elms that grew in a bunch within a few feet of the grave."
                            },
                            {
                                "example_id": "eda94e14-abc6-49ca-be33-3cd37963df47",
                                "sense_id": "93d451ac-d8d1-3ab5-bdba-d79a194b719f",
                                "text": "The film [Pretty Woman] grossed $464 million worldwide, ensconcing her [Julia Roberts] in the Hollywood A-list."
                            }
                        ]
                    },
                    {
                        "sense_id": "83b17f9d-e5ae-3af1-9410-203f223c9c15",
                        "entry_id": "033811d3-4679-3825-8064-d2aef69379ff",
                        "glosses": [
                            "To settle comfortably."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "05dc0f08-3047-4109-90d0-77f12021b321",
                                "sense_id": "83b17f9d-e5ae-3af1-9410-203f223c9c15",
                                "text": "So many invitations had been extended to this premiére that the train was pretty nearly full; [...] the press and other guests distributed themselves over the remaining accommodation, and I ensconced myself in a facing window seat in one of the compartments of the third-class brake next the tender."
                            },
                            {
                                "example_id": "63a321f6-f29c-4200-a6cd-f458e3dc6020",
                                "sense_id": "83b17f9d-e5ae-3af1-9410-203f223c9c15",
                                "text": "[…] Major was already ensconced on his bed of straw, under a lantern which hung from a beam."
                            }
                        ]
                    }
                ],
