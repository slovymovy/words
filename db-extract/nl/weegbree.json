                    {
                        "sense_id": "bf88aabe-390b-38e1-9770-8c1477b24ea3",
                        "entry_id": "ba953850-6850-3edf-9604-d63827af324e",
                        "glosses": [
                            "een geslacht Plantago uit de weegbreefamilie (Plantaginaceae). Het geslacht bestaat uit windbestuivers en heeft aarvormige bloeiwijzen. De bladeren zijn bij de meeste soorten parallelnervig, wat eerder een kenmerk is voor eenzaadlobbigen. Bij de meeste in West-Europa voorkomende soorten staan de bladeren in een bladrozet bij elkaar"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "694e864e-7259-4eb0-9614-6ca910de88c7",
                        "source_entry_id": "ba953850-6850-3edf-9604-d63827af324e",
                        "source_sense_id": "bf88aabe-390b-38e1-9770-8c1477b24ea3",
                        "target_lang_word": "Wegerich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wegerich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "448dc237-6d43-3228-9b0e-0a5d110b5e00",
                                        "entry_id": "3f8ed6ff-4ea3-39fb-b9b7-a8459a2d0967",
                                        "glosses": [
                                            "Pflanzengattung, deren Vertreter – niedrige, unscheinbare Pflanzen – unter anderem an Wegen und auf Trampelpfaden wachsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8a86f5b-4403-42a9-b924-01ad12c42d0e",
                                                "sense_id": "448dc237-6d43-3228-9b0e-0a5d110b5e00",
                                                "text": "Hier wächst Wegerich, da muss öfter mal jemand entlanggehen."
                                            },
                                            {
                                                "example_id": "e6b32b5b-563e-4bfd-9624-6474ad23629d",
                                                "sense_id": "448dc237-6d43-3228-9b0e-0a5d110b5e00",
                                                "text": "„Am Flussufer wucherte Wegerich, die Heilpflanze seiner Kinderzeit, deren Blätter auf Wunden und Geschwüre gelegt worden waren.“"
                                            },
                                            {
                                                "example_id": "9ae1dda2-1098-418d-a2f2-63f7af3ed46e",
                                                "sense_id": "448dc237-6d43-3228-9b0e-0a5d110b5e00",
                                                "text": "„Erst hatten sie mich angefaucht, wenn ich ihnen ihren Löwenzahn oder ihren Wegerich hingelegt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da2b4ae0-16da-4a0d-bf35-9e68698e7ed8",
                        "source_entry_id": "ba953850-6850-3edf-9604-d63827af324e",
                        "source_sense_id": "bf88aabe-390b-38e1-9770-8c1477b24ea3",
