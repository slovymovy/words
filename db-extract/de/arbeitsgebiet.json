                "senses": [
                    {
                        "sense_id": "c6ff8f4e-fbb2-3e6c-ab1e-55cc3272cdc7",
                        "entry_id": "b1f52f60-7dc9-3cd8-bc46-cafc42882423",
                        "glosses": [
                            "thematischer Bereich, in dem jemand (beruflich) tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b396896-8542-47d9-8573-cb60a03dbf8d",
                                "sense_id": "c6ff8f4e-fbb2-3e6c-ab1e-55cc3272cdc7",
                                "text": "„Euler war von 1974 bis 2009 Professor für Lernpsychologie in Kassel, die Stotterforschung ist eines seiner Arbeitsgebiete.“"
                            },
                            {
                                "example_id": "e83ec3c1-e65b-4443-a4ee-a8e51c393afa",
                                "sense_id": "c6ff8f4e-fbb2-3e6c-ab1e-55cc3272cdc7",
                                "text": "„In seinen Augen gab es kein Arbeitsgebiet, das nicht mit Schlechtigkeit und Trug durchsetzt war.“"
                            },
                            {
                                "example_id": "cc668992-5d95-4f39-96fe-3e691b568c4b",
                                "sense_id": "c6ff8f4e-fbb2-3e6c-ab1e-55cc3272cdc7",
                                "text": "„Kraepelin inaugurierte zudem mehrere spezielle Arbeitsgebiete der Psychiatrie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
