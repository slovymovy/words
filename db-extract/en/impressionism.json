                    {
                        "translation_id": "c1cf63b0-94e9-4263-a437-c401f72010a4",
                        "source_entry_id": "acf508bf-8989-340d-ae9d-cb0bd59d52de",
                        "source_sense_description": "movement in art",
                        "target_lang_word": "impressionisme",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impressionisme",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f03e0cd1-dcf2-32a0-9a06-1c3a8b1261ba",
                                        "entry_id": "d8254cbf-ea56-3590-aaa2-82d324ce0154",
                                        "glosses": [
                                            "in de 19e eeuw vanuit de Franse schilderkunst opgekomen stroming, waarbij niet realistisch wordt uitgebeeld maar volgens vage indrukken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb125ed9-d3d2-4f55-a629-c7df0f93b61e",
                                                "sense_id": "f03e0cd1-dcf2-32a0-9a06-1c3a8b1261ba",
                                                "text": "Het impressionisme ontwikkelde zich in de jaren zestig van de 19de eeuw in Frankrijk en wordt veelal beschouwd als het begin van de moderne schilderkunst."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d5d97da-3b36-434b-bc47-d31b25eb5290",
                        "source_entry_id": "acf508bf-8989-340d-ae9d-cb0bd59d52de",
                        "source_sense_description": "movement in art",
                        "target_lang_word": "impressionnisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impressionnisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3244120b-d950-3337-9eca-35aa0c30bb0d",
                                        "entry_id": "7bbf99c3-3696-3792-b8ab-c5ebdbdf4b52",
                                        "glosses": [
                                            "Mouvement artistique qui s’est proposé de traduire, non plus la réalité elle- même ni ses détails, mais une impression d’ensemble produite sur l’artiste (peintre ou musicien) par la réalité."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5798508-8211-4fe6-9431-0d4363c2db9c",
                                                "sense_id": "3244120b-d950-3337-9eca-35aa0c30bb0d",
                                                "text": "L’impressionnisme est une réaction contre le réalisme souvent excessif des disciples de Courbet mais aussi une tentative pour aller plus loin encore dans la représentation du réel, réel qui ne peut être appréhendé qu’à un moment particulier et non en général, puis qu’il dépend des états d’âme du spectateur et des éclairages, tous deux variables dans la journée."
                                            },
                                            {
                                                "example_id": "98ee0d0b-afe3-4664-b92f-d6b038dd90b0",
                                                "sense_id": "3244120b-d950-3337-9eca-35aa0c30bb0d",
                                                "text": "Dans le département de l’Eure, le musée des impressionnismes Giverny (Mdig) célèbre cette révolution picturale dont la ville est le berceau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4edc56ea-531b-3474-8a7b-8880b03fd228",
                                        "entry_id": "7bbf99c3-3696-3792-b8ab-c5ebdbdf4b52",
                                        "glosses": [
                                            "Genre littéraire qui a essayé de substituer des visions synthétiques aux analyses du réalisme."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72f87986-15de-40f2-aa2c-80463f803129",
                        "source_entry_id": "acf508bf-8989-340d-ae9d-cb0bd59d52de",
