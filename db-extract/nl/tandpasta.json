                    {
                        "translation_id": "9f9fa937-e78e-4539-8fee-a495f9aaa64c",
                        "source_entry_id": "52ad5c5c-c0bf-3138-bc51-eadeb8433f0b",
                        "source_sense_id": "f0da9f35-fb80-3a0d-b54b-8a5fe0a1c467",
                        "source_sense_description": "een poetsmiddel voor de tanden",
                        "target_lang_word": "Zahnpasta",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zahnpasta",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6f051a7-6f42-3afe-b36d-8a094879626a",
                                        "entry_id": "07698b3b-3491-3918-b4bb-dffe6d69a57d",
                                        "glosses": [
                                            "eine Paste zur Reinigung der Zähne mit Hilfe einer Zahnbürste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6520c77d-5b2a-4362-8f74-99daef20d622",
                                                "sense_id": "e6f051a7-6f42-3afe-b36d-8a094879626a",
                                                "text": "Es war einmal eine neue Zahnpasta-Tube, die glänzte so schön auf der Fensterbank, dass sich der alten Zahnbürste im Glas neben ihr vor Bewunderung die Borsten sträubten."
                                            },
                                            {
                                                "example_id": "f53b376c-1f96-4eae-bef3-70c36c2edffd",
                                                "sense_id": "e6f051a7-6f42-3afe-b36d-8a094879626a",
                                                "text": "Er litt gräßlich unter der Diät. Seine Seife, zwei Tuben Zahnpasta, ein Paar Glacéhandschuhe, vier Bleistifte, eine Schachtel Heftzwecken und zwei Flaschen Kopiertinte hatte er verstohlen hinuntergeschlungen."
                                            },
                                            {
                                                "example_id": "75cb2bd2-e5c3-4e0e-92df-6eb35b53ee85",
                                                "sense_id": "e6f051a7-6f42-3afe-b36d-8a094879626a",
                                                "text": "Dabei bemerkte ich, daß die Dame einen weißen Schnurrbart hatte, erzeugt durch den Schaum der Zahnpasta, und daß in ihren schweren Augensäcken noch viel Schlaf lag."
                                            },
                                            {
                                                "example_id": "8d8e22b5-f138-44a3-a2fd-53cf0ff9a7f8",
                                                "sense_id": "e6f051a7-6f42-3afe-b36d-8a094879626a",
                                                "text": "„Ich vermute, daß er sogar an den zweieinhalb Zentimetern Zahnpasta, die ich gelegentlich verbrauche, beteiligt ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08b92c19-b557-4709-9d19-a78aa503e1c3",
                        "source_entry_id": "52ad5c5c-c0bf-3138-bc51-eadeb8433f0b",
                        "source_sense_id": "f0da9f35-fb80-3a0d-b54b-8a5fe0a1c467",
                        "source_sense_description": "een poetsmiddel voor de tanden",
                        "target_lang_word": "Zahncreme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zahncreme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5d8d431-26d3-3a8b-a621-664a488becef",
                                        "entry_id": "ff163ee6-6a16-3e81-a3c9-e16a18805732",
                                        "glosses": [
                                            "cremeartige Substanz für die Zahnpflege"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6db5ec8b-aa9f-4e68-95f5-d3460a3e261e",
                                                "sense_id": "f5d8d431-26d3-3a8b-a621-664a488becef",
                                                "text": "„Um den Zuschauern die Spots für Zahncreme, Softdrinks oder Juwelierläden schmackhaft zu machen, werden drumherum Gesundheitstips, Musikshows und Spielfilme offeriert.“"
                                            },
                                            {
                                                "example_id": "770be5e8-84b0-4437-bb41-fdb585d21a05",
                                                "sense_id": "f5d8d431-26d3-3a8b-a621-664a488becef",
                                                "text": "„Weißende Zahncremes dürfen in der EU maximal 0,1 Prozent Wasserstoffperoxid enthalten.“"
                                            },
                                            {
                                                "example_id": "a321f1b2-0495-43e1-8200-0c811f077b8e",
                                                "sense_id": "f5d8d431-26d3-3a8b-a621-664a488becef",
                                                "text": "„Während laut einer EU-Verordnung das Bakterizid Triclosan in Hygieneartikeln wie Seifen verboten wurde, bleibt die Anwendung in Zahncremen weiter erlaubt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
