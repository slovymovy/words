                "senses": [
                    {
                        "sense_id": "732f2c4a-4fdd-3284-b1cc-43c549aaf13d",
                        "entry_id": "43370462-5871-3e05-bf46-cfbd8957a73b",
                        "glosses": [
                            "Fall/Sturz vom Fahrrad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc3b1a3a-e73f-47e0-9ea5-97b1654e3174",
                                "sense_id": "732f2c4a-4fdd-3284-b1cc-43c549aaf13d",
                                "text": "„Die Orthese stammte noch von einer Verstauchung nach einem Fahrradsturz ein paar Jahre zuvor, und Ende April ließ ich mir eine neue Orthese verordnen.“"
                            },
                            {
                                "example_id": "9c2f8898-b075-4dd0-8af9-411d3e9f9f50",
                                "sense_id": "732f2c4a-4fdd-3284-b1cc-43c549aaf13d",
                                "text": "„[…]; er kam nach einem Fahrradsturz in eine Klinik, um dort am Oberschenkel und Knie, das ihm erst zuvor künstlich eingesetzt wurde, operiert zu werden.“"
                            },
                            {
                                "example_id": "83076bf2-e872-4cb2-a0cc-6a09427ba530",
                                "sense_id": "732f2c4a-4fdd-3284-b1cc-43c549aaf13d",
                                "text": "„3 Wochen nach meinem Fahrradsturz, hatte ich einen ganz schlimmen Drehschwindelanfall.“"
                            },
                            {
                                "example_id": "2db71bf0-6028-47fe-9b75-bfebccd1eaa0",
                                "sense_id": "732f2c4a-4fdd-3284-b1cc-43c549aaf13d",
                                "text": "„Mit den Kindern können wir dafür danken, dass wir auf der Wanderung den Heimweg doch noch gefunden haben oder dass der Fahrradsturz nur Schürfungen hergerufen hat.“"
                            },
                            {
                                "example_id": "caa85764-137f-4433-8612-ece2cb3742ce",
                                "sense_id": "732f2c4a-4fdd-3284-b1cc-43c549aaf13d",
                                "text": "„Ursache der traumatischen Schulterluxationen sind meist Stürze, oft Fahrradstürze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
