                        "glosses": [
                            "A habitually dirty or untidy man or boy; the male equivalent of slattern, or slut."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "299eb6cf-f6a8-3994-9fba-0d382928d957",
                        "entry_id": "98594d85-e0e4-3097-be3c-62dbe85fa059",
                        "glosses": [
                            "A low, base, lewd person."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2d3e38f-7c6d-437c-98e2-c0033bd51ae9",
                                "sense_id": "299eb6cf-f6a8-3994-9fba-0d382928d957",
                                "text": "The follest slouen ondyr heuen, / Prowde, peuiche, lyddyr, and lewde, / Malapert, medyllar, nothyng well thewde, […]",
                                "translation": "The foullest sloven under heaven, / Proud, peevish, lither, and lewd, / Malapert, meddler, nothing well thewed, […]",
