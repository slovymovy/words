            {
                "entry_id": "f5c03ddb-fc2a-3e35-ba41-98bcebec92df",
                "word": "AfD",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "449dca56-9418-4deb-b7e8-05506677ac44",
                        "entry_id": "f5c03ddb-fc2a-3e35-ba41-98bcebec92df",
                        "tags": [
                            "plural"
                        ],
                        "form": "AfDs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c1c519da-a024-3456-99b5-f4a77089b7c6",
                        "entry_id": "f5c03ddb-fc2a-3e35-ba41-98bcebec92df",
                        "glosses": [
                            "Initialism of articles for deletion, a process on the English Wikipedia for deleting articles through discussion."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "countable",
                            "initialism",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b44847a3-b3cb-4758-b1bc-3dc1bed051bc",
                                "sense_id": "c1c519da-a024-3456-99b5-f4a77089b7c6",
                                "text": "When you nominate an article for deletion using the AfD process, you get to a point in the process where you have to give a reason."
                            },
                            {
                                "example_id": "a303cd22-17b4-478d-b660-5811c4e06eaf",
                                "sense_id": "c1c519da-a024-3456-99b5-f4a77089b7c6",
                                "text": "Anyone can discuss AfD nominations by simply going to the main AfD page and adding a signed comment with his or her opinion about whether to keep or delete the article being discussed"
                            },
                            {
                                "example_id": "1265e853-4e9d-4ae9-9948-f2a4901f160e",
                                "sense_id": "c1c519da-a024-3456-99b5-f4a77089b7c6",
                                "text": "After 7 days, AfD discussions are reviewed by an uninvolved user or administrator who attempts to determine the consensus."
                            },
                            {
                                "example_id": "e73a3e75-95ac-4d71-8bd4-26661504b5d7",
                                "sense_id": "c1c519da-a024-3456-99b5-f4a77089b7c6",
                                "text": "Intra-organizational social capital was measured with the variable Experienced Participant Early Intervention. This variable was created through the identification of the most active participants in the AfDs and whether they contributed within the first 48 hours of the deliberation."
                            }
                        ]
                    }
                ],
