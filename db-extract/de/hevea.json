                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f437b30-2b83-48c5-a18e-ca627dad03a7",
                                "sense_id": "4b969342-d030-3f29-9530-ba8953e837b0",
                                "text": "„Die Gauchos erzählten von den Heveen am Strom und den Kautschukzapfern, mit denen sie eine Prügelei gehabt hatten; von gespenstischen Indianern, die in den Wäldern verborgen sein sollten; von dem seltsamen Licht, das in mondlosen Nächten wie eine fahle Drohung über die Steppe ginge.“"
                            }
                        ],
