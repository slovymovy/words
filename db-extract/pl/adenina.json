                ],
                "senses": [
                    {
                        "sense_id": "3ddc347e-9d20-3933-9ef0-13ba9796309e",
                        "entry_id": "77a12644-8e5b-34b3-b04d-3a36fbd7c7e4",
                        "glosses": [
                            "związek organiczny, składnik nukleotydów tworzących kwasy nukleinowe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0217691-c8f0-41a5-8ca8-785f7e0fa0b3",
                                "sense_id": "3ddc347e-9d20-3933-9ef0-13ba9796309e",
                                "text": "W DNA adenina łączy się z tyminą, a w RNA – z uracylem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7413132-51fd-4fe4-a4c4-37204d64413b",
                        "source_entry_id": "77a12644-8e5b-34b3-b04d-3a36fbd7c7e4",
                        "source_sense_id": "3ddc347e-9d20-3933-9ef0-13ba9796309e",
                        "target_lang_word": "adenine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adenine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de299540-cc43-307f-bbf4-aadd4013d6dd",
                                        "entry_id": "6f7e8364-a55d-3446-8e38-c6414c7c0f2a",
                                        "glosses": [
                                            "A base, C₅H₅N₅, found in certain glands and tissues, which pairs with thymine in DNA and uracil in RNA."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a05278fb-78d3-4a56-bf97-aa55f6cc320d",
                                                "sense_id": "de299540-cc43-307f-bbf4-aadd4013d6dd",
                                                "text": "One of these labels is ethenoadenine, which is obtained by chemical modification of adenine."
                                            },
                                            {
                                                "example_id": "acdb7a46-0c42-4c71-8fbb-640c49c97299",
                                                "sense_id": "de299540-cc43-307f-bbf4-aadd4013d6dd",
                                                "text": "There are two genes in the adenine biosynthetic pathway of yeast (ADE1 and ADE2) that, apart from producing an absolute requirement for adenine when mutant, also produce a change in colony color."
                                            },
                                            {
                                                "example_id": "eb0924f6-109c-46da-8a04-ad3453694a6f",
                                                "sense_id": "de299540-cc43-307f-bbf4-aadd4013d6dd",
                                                "text": "The HCN pentamer, adenine (a constituent of DNA, RNA and many coenzymes), is one of the most abundant biochemical molecules."
                                            },
                                            {
                                                "example_id": "a9021e52-61a0-46f2-b632-2bcf683e34af",
                                                "sense_id": "de299540-cc43-307f-bbf4-aadd4013d6dd",
                                                "text": "Sinclair also takes 1 gram of NMN, or nicotinamide mononucleotide, which in the body turns into NAD+, or nicotinamide adenine dinucleotide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f54f16c-7826-465d-b101-7e3277ebdc55",
                        "source_entry_id": "77a12644-8e5b-34b3-b04d-3a36fbd7c7e4",
                        "source_sense_id": "3ddc347e-9d20-3933-9ef0-13ba9796309e",
                        "target_lang_word": "adénine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adénine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ade3353-750f-38c1-968f-20ae60ab142f",
                                        "entry_id": "2838d049-db48-3a00-94e5-1e21f3aef496",
                                        "glosses": [
                                            "Base azotée purique qu’on trouve dans l’ADN et l’ARN, constituée d'un squelette de purine avec un groupement amine."
                                        ],
                                        "tags": [
                                            "Biologie moléculaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97bf9383-ca1d-4f46-9838-32f454ea44dc",
                                                "sense_id": "4ade3353-750f-38c1-968f-20ae60ab142f",
                                                "text": "L’adénine se fixe à la thymine ou à l'uracile."
                                            },
                                            {
                                                "example_id": "e88abc06-90b2-4dda-8468-f78a8ddf42f2",
                                                "sense_id": "4ade3353-750f-38c1-968f-20ae60ab142f",
                                                "text": "Il existe quatre types principaux de nucléotides, correspondant aux quatre bases différentes qui caractérisent chacun d’eux: l’adénine, la thymine, la cytosine et la guanine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d3f2702-bc29-4442-ad11-e98a7eb08503",
                        "source_entry_id": "77a12644-8e5b-34b3-b04d-3a36fbd7c7e4",
                        "source_sense_id": "3ddc347e-9d20-3933-9ef0-13ba9796309e",
                        "target_lang_word": "Adenin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Adenin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cfafa70f-65ad-3b1a-90a3-c2264656f8ff",
                                        "entry_id": "ae5dbd60-c520-35c5-898a-7a0e8d808b5e",
                                        "glosses": [
                                            "in Pflanzen und Tieren weitverbreiteter Bestandteil der Nukleinsäure"
                                        ],
                                        "tags": [
                                            "Biochemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6089e43-a6d1-41bb-b179-df039644c537",
                                                "sense_id": "cfafa70f-65ad-3b1a-90a3-c2264656f8ff",
                                                "text": "In der DNA kommen vier Basen vor, Adenin (A), Cytosin (C), Guanin (G) und Thymin (T), von denen jeweils zwei komplementär sind: Cytosin und Guanin sowie Adenin und Thymin bilden untereinander Wasserstoffbrücken aus."
                                            },
                                            {
                                                "example_id": "adccf929-a6c5-411e-b554-bf09bea6d18d",
                                                "sense_id": "cfafa70f-65ad-3b1a-90a3-c2264656f8ff",
                                                "text": "Aus dem Baustein Adenin können vor allem Pflanzen und Pilze mit Hilfe von Enzymen eine Fülle von „Sekundärstoffen“ (Kossel) synthetisieren, die sie für soziale und außenpolitische Zwecke brauchen, zum Beispiel zum Anlocken oder Abschrecken von Tieren oder zum Abtöten von Bakterien."
                                            },
                                            {
                                                "example_id": "9c6384d9-911d-4226-901c-7c5bc04be170",
                                                "sense_id": "cfafa70f-65ad-3b1a-90a3-c2264656f8ff",
                                                "text": "Bei einem zu hohen Nahrungsangebot an Adeninen und verwandten Purinen kann die Harnsäure so hohe Konzentrationen erreichen, dass sie auskristallisiert und in Gelenken, der Niere und anderen Organen die Symptome der Gicht hervorruft."
                                            },
                                            {
                                                "example_id": "258c823d-5be1-4814-9093-738d0d50069d",
                                                "sense_id": "cfafa70f-65ad-3b1a-90a3-c2264656f8ff",
                                                "text": "Die Wissenschaftler konzentrierten sich speziell auf Reaktionen, die zur Bildung des DNA-Bausteins Adenin aus Hydrogencyanid führt, welches in interstellaren Wolken nicht selten ist. Im Resultat der Computersimulation trat in der Wolke in der Tat verstreut Adenin auf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
