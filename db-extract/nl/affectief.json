                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ce932fa-8cb7-4116-8a41-b7adc0e121f2",
                                                "sense_id": "d16f6e64-a37c-31db-b952-c88b168d76af",
                                                "text": "Il parle des choses de Dieu d’une manière très affective."
                                            },
                                            {
                                                "example_id": "d38f2b1a-9106-425b-8696-0d552b9d32e1",
                                                "sense_id": "d16f6e64-a37c-31db-b952-c88b168d76af",
                                                "text": "Saint Bernard est un des pères de l’église les plus affectifs."
                                            },
                                            {
                                                "example_id": "2b72a8aa-ae2a-45f5-a8ad-e00edc3b470a",
                                                "sense_id": "d16f6e64-a37c-31db-b952-c88b168d76af",
                                                "text": "On a imprimé des livres sous le titre de Théologie affective."
                                            },
                                            {
                                                "example_id": "7c446f09-2fde-44cb-8ee4-9d9afcf66376",
                                                "sense_id": "d16f6e64-a37c-31db-b952-c88b168d76af",
                                                "text": "Ainsi, les cadres qui manifestent un fort engagement affectif et qui sont donc plus mobilisés ne le sont pas pour des conditions matérielles."
                                            }
                                        ]
                                    }
                                ]
                            },
