                            {
                                "target_lang_word": "Национальная партия",
                                "target_lang_sense_clarification": "организация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新西兰国家党",
                                "target_lang_sense_clarification": "新西兰的政党名称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
